	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		
		Файл = Новый Файл(ИмяФайла);
		
		Результат = Файл.Существует();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъединитьПути(П1, П2, П3 = Неопределено, П4 = Неопределено)
	
	Результат = П1;
	
	РазделительПути = РазделительПути();
	
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(П2);
	ЧастиПути.Добавить(П3);
	ЧастиПути.Добавить(П4);
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> РазделительПути Тогда
			Результат = Результат + РазделительПути;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РазделительПути()
	
	СисИнфо = Новый СистемнаяИнформация;
	Если СравнитьВерсииЛок(СисИнфо.ВерсияПриложения, "8.3.3") < 0 Тогда
		
		Результат = "\";
		// BSLLS:DeprecatedFind-off
		Если Найти(СисИнфо.ТипПлатформы, "Linux") > 0 Тогда
		// BSLLS:DeprecatedFind-on
			Результат = "/";
		КонецЕсли;
		
	Иначе
		Результат = Вычислить("ПолучитьРазделительПути()");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СократитьДвойныеКавычки(Знач Значение)
	
	Пока СтрНачинаетсяСЛок(Значение, """") Цикл
		
		НачальныйНомер = 2;
		Значение = Сред(Значение, НачальныйНомер); 
		
	КонецЦикла;
	
	Пока СтрЗаканчиваетсяНаЛок(Значение, """") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции 

Функция ОписаниеТипа_Строка50()
	
	ДлинаСтроки50 = 50;
	
	Результат = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(ДлинаСтроки50));
	
	Возврат Результат;
	
КонецФункции

