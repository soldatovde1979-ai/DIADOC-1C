////////////////////////////////////////////////////////////////////////////////
// Программный интерфейс

// Возвращает идентификатор информационной базы
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазы() Экспорт
	
	Результат = ИдентификаторИнформационнойБазыБСП();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ВариантХранения = ВариантХранения();
		
		Результат = ИдентификаторИнформационнойБазыКонтур(ВариантХранения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы по умолчанию
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыНеОпределен() Экспорт
	
	Возврат Новый УникальныйИдентификатор("aacc64c0-e8d8-4ae7-b3f8-8300b2f70d2b");
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции

Функция ВариантХранения()
	
	Если ДоступенВариант_КонстантаКонтур() Тогда
		Результат = "Константа_ИдентификаторИБ";
	ИначеЕсли ДоступенВариант_РегистрДополнительныеСведения() Тогда
		Результат = "РегистрСведений_ДополнительныеСведения";
	ИначеЕсли ДоступенВариант_РегистрЗначенияСвойствОбъектов() Тогда
		Результат = "РегистрСведений_ЗначенияСвойствОбъектов";
	ИначеЕсли ДоступенВариант_Файл() Тогда
		Результат = "Файл";
	Иначе
		Результат = "null";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебный программный интерфейс

// Проверяет доступность константы КонтурИдентификаторИБ
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в константе
//
Функция ДоступенВариант_КонстантаКонтур() Экспорт
	
	ИмяКонстанты = "КонтурИдентификаторИБ";
	
	Результат = Метаданные.Константы.Найти(ИмяКонстанты) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступность регистра сведений ДополнительныеСведения
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в регистре
//
Функция ДоступенВариант_РегистрДополнительныеСведения() Экспорт
	
	ИмяРегистра = "ДополнительныеСведения";
	ИмяПВХ = "ДополнительныеРеквизитыИСведения";
	
	ЕстьРегистрДополнительныеСведения = Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено;
	ЕстьПланВидовХарактеристик = Метаданные.ПланыВидовХарактеристик.Найти(ИмяПВХ) <> Неопределено;
	ЕстьСправочникВалюты = Метаданные.Справочники.Найти("Валюты") <> Неопределено;
	ЕстьВладелецВалюты = (ЕстьСправочникВалюты И ЗначениеЗаполнено(ЗаписьСправочникаВалютыРуб()));
	ВалютаВладелецСвойства = (ЕстьПланВидовХарактеристик
		И ЕстьСправочникВалюты
		И ПроверитьВладельцаДополнительногоСвойства());
	
	Результат = (ЕстьРегистрДополнительныеСведения
		И ЕстьПланВидовХарактеристик
		И ЕстьВладелецВалюты
		И ВалютаВладелецСвойства);
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступность регистра сведений ЗначенияСвойствОбъектов
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в регистре
//
Функция ДоступенВариант_РегистрЗначенияСвойствОбъектов() Экспорт
	
	ИмяРегистра = "ЗначенияСвойствОбъектов";
	ИмяПВХСвойстваОбъектов = "СвойстваОбъектов";
	
	ЕстьРегистрЗначенияСвойствОбъектов = Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено;
	ЕстьПланВидовХарактеристик = Метаданные.ПланыВидовХарактеристик.Найти(ИмяПВХСвойстваОбъектов) <> Неопределено;
	ЕстьСправочникВалюты = Метаданные.Справочники.Найти("Валюты") <> Неопределено;
	ЕстьВладелецВалюты = (ЕстьСправочникВалюты И ЗначениеЗаполнено(ЗаписьСправочникаВалютыРуб()));
	ВалютаВладелецСвойства = (ЕстьПланВидовХарактеристик
		И ЕстьСправочникВалюты
		И ПроверитьВладельцаЗначенияСвойства());
	
	Результат = (ЕстьРегистрЗначенияСвойствОбъектов
		И ЕстьПланВидовХарактеристик
		И ЕстьВладелецВалюты
		И ВалютаВладелецСвойства);
	
	Возврат Результат;
	
КонецФункции

// Проверяет права на чтение и запись в каталоге информационной базы
// для хранения идентификатора ИБ
// 
// Возвращаемое значение:
//  Булево - Истина, если доступен вариант хранения идентификатора ИБ в файле
//
Функция ДоступенВариант_Файл() Экспорт
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	ЧислоСимволовПризнакИБ = 5;
	ЭтоФайловаяИнформационнаяБаза = (ВРег(Лев(СтрокаСоединения, ЧислоСимволовПризнакИБ)) = "FILE=");
	РазрешенаЗаписьВКаталог = РазрешенаЗаписьВКаталогИнформационнойБазы();
	
	Результат = (ЭтоФайловаяИнформационнаяБаза
		И РазрешенаЗаписьВКаталог);
	
	Возврат Результат;
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный методом БСП
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыБСП() Экспорт
	
	Попытка
		
		ИнтерфейсБСП = Вычислить("СтандартныеПодсистемыСервер");
		Результат = ИнтерфейсБСП.ИдентификаторИнформационнойБазы();
		
	Исключение
		
		Результат = "";
		
		ОписаниеОшибки_ = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		// BSLLS:UsageWriteLogEvent-off
		ЗаписьЖурналаРегистрации(
			"МетрикиКонтур",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ОписаниеОшибки_
		);
		// BSLLS:UsageWriteLogEvent-on
		
		Возврат Результат;
		
	КонецПопытки;
	
	Возврат Новый УникальныйИдентификатор(Результат);
	
КонецФункции

// Возвращает идентификатор информационной базы
// вычисленный бизнес-логикой библиотеки
//
// Параметры:
//  ВариантХранения - Строка - Вариант хранения идентификатора ИБ (см. метод ВариантХранения())
// 
// Возвращаемое значение:
//  УникальныйИдентификатор - Идентификатор информационной базы
//
Функция ИдентификаторИнформационнойБазыКонтур(ВариантХранения) Экспорт
	
	Если ВариантХранения = "Константа_ИдентификаторИБ" Тогда
		Результат = ИдентификаторИнформационнойБазыИзКонстанты();
	ИначеЕсли ВариантХранения = "РегистрСведений_ДополнительныеСведения" Тогда
		Результат = ИдентификаторИнформационнойБазыИзРегистраДополнительныеСведения();
	ИначеЕсли ВариантХранения = "РегистрСведений_ЗначенияСвойствОбъектов" Тогда
		Результат = ИдентификаторИнформационнойБазыИзРегистраЗначенияСвойствОбъектов();
	ИначеЕсли ВариантХранения = "Файл" Тогда
		Результат = ИдентификаторИнформационнойБазыИзФайла();
	Иначе
		Результат = ИдентификаторИнформационнойБазыНеОпределен();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзКонстанты()
	
	Результат = ПрочитатьКонстантуИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьКонстантуИдентификаторИнформационнойБазы();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзРегистраДополнительныеСведения()
	
	Результат = ПрочитатьДополнительноеСведениеИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьДополнительноеСведениеИдентификаторИнформационнойБазы();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзРегистраЗначенияСвойствОбъектов()
	
	Результат = ПрочитатьЗначениеСвойстваИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьЗначениеСвойстваИдентификаторИнформационнойБазы();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторИнформационнойБазыИзФайла()
	
	Результат = ПрочитатьФайлИдентификаторИнформационнойБазы();
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗаписатьФайлИдентификаторИнформационнойБазы();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Чтение идентификатора информационной базы

Функция ПрочитатьКонстантуИдентификаторИнформационнойБазы()
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Результат = Константы.КонтурИдентификаторИБ.Получить();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьДополнительноеСведениеИдентификаторИнформационнойБазы()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Объект КАК Объект,
	|	Т.Свойство.Наименование КАК ИмяСвойства,
	|	Т.Значение КАК ЗначениеСвойства
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Т
	|ГДЕ
	|	Т.Свойство = &Свойство
	|	И Т.Объект = &Объект";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Свойство", ДополнительноеСвойствоИдентификаторИБ());
	Запрос.УстановитьПараметр("Объект", ЗаписьСправочникаВалютыРуб());
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если ВыборкаЗапроса.Следующий() Тогда
		Результат = ВыборкаЗапроса.ЗначениеСвойства;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьЗначениеСвойстваИдентификаторИнформационнойБазы()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Объект КАК Объект,
	|	Т.Свойство.Наименование КАК ИмяСвойства,
	|	Т.Значение КАК ЗначениеСвойства
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Т
	|ГДЕ
	|	Т.Свойство = &Свойство
	|	И Т.Объект = &Объект";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Свойство", СвойствоОбъектаИдентификаторИБ());
	Запрос.УстановитьПараметр("Объект", ЗаписьСправочникаВалютыРуб());
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если ВыборкаЗапроса.Следующий() Тогда
		Результат = ВыборкаЗапроса.ЗначениеСвойства;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьФайлИдентификаторИнформационнойБазы()
	
	Результат = "";
	
	ПутьКФайлу = ПутьКФайлуKonturBaseId();
	
	Если НЕ ФайлСуществует(ПутьКФайлу) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТД = Новый ТекстовыйДокумент;
	ТД.Прочитать(ПутьКФайлу);
	
	Результат = СокрЛП(ТД.ПолучитьСтроку(1));
	
	Возврат Результат;
	
КонецФункции

// Запись идентификатора информационной базы

Функция ЗаписатьКонстантуИдентификаторИнформационнойБазы()
	
	Результат = НовыйИдентификаторИБ();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Константы.КонтурИдентификаторИБ.Установить(Результат);
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьДополнительноеСведениеИдентификаторИнформационнойБазы()
	
	Результат = НовыйИдентификаторИБ();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Запись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	Запись.Объект = ЗаписьСправочникаВалютыРуб();
	Запись.Свойство = ДополнительноеСвойствоИдентификаторИБ();
	Запись.Значение = Результат;
	
	Запись.Записать();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьЗначениеСвойстваИдентификаторИнформационнойБазы()
	
	Результат = НовыйИдентификаторИБ();
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Запись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	Запись.Объект = ЗаписьСправочникаВалютыРуб();
	Запись.Свойство = СвойствоОбъектаИдентификаторИБ();
	Запись.Значение = Результат;
	
	Запись.Записать();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьФайлИдентификаторИнформационнойБазы()
	
	ПутьКФайлу = ПутьКФайлуKonturBaseId();
	Результат = НовыйИдентификаторИБ();
	
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(Результат);
	ТД.Записать(ПутьКФайлу);
	
	Возврат Результат;
	
КонецФункции

// Ключевые объекты метрик

Функция НовыйИдентификаторИБ()
	
	Результат = Новый УникальныйИдентификатор;
	
	Возврат Результат;
	
КонецФункции

Функция ПутьКФайлуKonturBaseId()
	
	Результат = "";
	
	КаталогИБ = КаталогИнформационнойБазыЛок();
	ИмяФайлаИД = ИмяФайлаKonturBaseId();
	
	Результат = ОбъединитьПути(
		КаталогИБ,
		ИмяФайлаИД
	);
	
	Возврат Результат;
	
КонецФункции

Функция КаталогИнформационнойБазыЛок()
	
	СтрокаСоединенияИБ = СтрокаСоединенияИнформационнойБазы();
	Параметры = ПараметрыИзСтроки(СтрокаСоединенияИБ);
	
	Результат = Параметры.File;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяФайлаKonturBaseId()
	
	Возврат "KonturBaseId.txt";
	
КонецФункции

Функция ЗаписьСправочникаВалютыРуб()
	
	Результат = Справочники.Валюты.ПустаяСсылка();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Т
	|ГДЕ
	|	Т.Код В(&Код)
	|	И НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Код";
	
	КодыЗаписиСправочникаВалюты = Новый Массив;
	КодыЗаписиСправочникаВалюты.Добавить("643");
	КодыЗаписиСправочникаВалюты.Добавить("810");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Код", КодыЗаписиСправочникаВалюты);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

