		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО ВозвратнаяТара.Номенклатура = СпрНоменклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
		|		ПО СпрНоменклатура.БазоваяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
		|ГДЕ
		|	ВозвратнаяТара.Ссылка = &Ссылка";
		
		ЧастиЗапроса.Добавить(ТекстЗапроса_ОбъединитьВсе());
		ЧастиЗапроса.Добавить(ТекстЗапросаВозвратнаяТара);
		
