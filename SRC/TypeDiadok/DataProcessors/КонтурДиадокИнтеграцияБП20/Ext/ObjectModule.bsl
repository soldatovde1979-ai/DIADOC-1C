КонецФункции

Процедура УПД970_ПересчитатьЦенуВТабличнойЧасти(Items, Точность)
	
	Для Каждого Item Из Items Цикл
		
		Если НЕ ЗначениеЗаполнено(Item.Quantity) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ТипЗнч(Item.Price) = Тип("Число") Тогда
			Продолжить;
		КонецЕсли;
		
		РасчетнаяЦена = Окр(Item.SubtotalWithVatExcluded / Item.Quantity, Точность);
		ОтклонениеОтРасчетной = (РасчетнаяЦена - Item.Price) * Item.Quantity;
		
		Если Макс(ОтклонениеОтРасчетной, -ОтклонениеОтРасчетной) > 0.03 Тогда
			Item.Price = РасчетнаяЦена;
		Иначе
			Item.Price = Окр(Item.Price, Точность);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция УПД970_ТребуетсяПересчетВРубли(ДанныеШапки, ФункцияУПД)
	
	Результат = Ложь;
	
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ДанныеШапки.ВалютаДокумента <> ВалютаРеглУчета // Документ в иностранной валюте.
		И ЕстьУчетнаяПолитикаНаДатуДокумента(ДанныеШапки.Дата, ДанныеШапки.Организация) Тогда
		
		Если ДанныеШапки.РасчетыВУсловныхЕдиницах Тогда
			Результат = Истина; // Документ в у.е. всегда пересчитываем в рубли.
		Иначе
			Результат = (ФункцияУПД = ФункцияДокументаУПД_ДОП()); // Валютный Счет-фактуру в рубли пересчитывать не нужно.
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ПересчетВалюты_ПересчитатьСуммыСУчетомАвансов(Table, СуммаАвансов, ДатаДокумента)
	
	//1. Распределяем сумму регл пропорционально Сумме с НДС
	МассивРаспределения = Новый Массив;
	
	Для Каждого Item Из Table.Items Цикл
		МассивРаспределения.Добавить(Item.Subtotal);
	КонецЦикла;
	
	УчетНДС.РаспределитьСуммуПоСтолбцу(МассивРаспределения, СуммаАвансов, Table.Items, "СуммаРублевая");
	
	РасчетСуммыНДСПоСтавке = УчетНДС.РасчетНДСвРубляхПоСтавкеДокумента(ДатаДокумента);
	
	//2. Пересчитываем СуммаНДС и Сумму
	Для Каждого Item Из Table.Items Цикл
		
		Если РасчетСуммыНДСПоСтавке Тогда
			
			ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(Item.СлужебнаяИнформация.СтавкаНДС);
			
			Item.Vat = ?(ЗначениеСтавкиНДС = 0, 0, Окр(Item.СуммаРублевая * ЗначениеСтавкиНДС / (100 + ЗначениеСтавкиНДС), 2));
			Item.SubtotalWithVatExcluded = Item.СуммаРублевая - Item.Vat;
			
		Иначе
			
			МассивРаспределения.Очистить();
			МассивРаспределения.Добавить(Item.SubtotalWithVatExcluded);
			МассивРаспределения.Добавить(Item.Vat);
			
			МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьПропорционально(Item.СуммаРублевая, МассивРаспределения);
			
			Если МассивРаспределенныхСумм <> Неопределено Тогда
				Item.SubtotalWithVatExcluded = МассивРаспределенныхСумм[0];
				Item.Vat = МассивРаспределенныхСумм[1];
			КонецЕсли;
			
		КонецЕсли;
		
		Item.Subtotal = Item.SubtotalWithVatExcluded + Item.Vat;
		
		Item.Удалить("СуммаРублевая");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ПересчетВалюты_ПересчитатьИтоговыеСуммыУПД(Table)
	
	TotalWithVatExcluded = 0;
	Vat = 0;
	Total = 0;
	
	Для Каждого Item Из Table.Items Цикл
		TotalWithVatExcluded = TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
		Vat = Vat + Item.Vat;
		Total = Total + Item.Subtotal;
	КонецЦикла;
	
	Table.TotalWithVatExcluded = Окр(TotalWithVatExcluded, 2);
	Table.Vat = Окр(Vat, 2);
	Table.Total = Окр(Total, 2);
	
КонецПроцедуры

