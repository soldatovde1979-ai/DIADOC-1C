Процедура УПД970_ОчиститьСтрануПроисхожденияСПустымГТД(Item)
	
	CustomDeclarations = Item.CustomDeclarations;
	
	Для Сч = -CustomDeclarations.ВГраница() По 0 Цикл
		
		CustomDeclaration = CustomDeclarations[-Сч];
		
		Если НЕ ЗначениеЗаполнено(CustomDeclaration.DeclarationNumber) Тогда
			CustomDeclarations.Удалить(-Сч);
		КонецЕсли;
		
	КонецЦикла;
	
