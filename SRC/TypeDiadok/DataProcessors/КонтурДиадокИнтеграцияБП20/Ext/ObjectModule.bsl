Функция УПД970_ПолучитьОбстоятельстваФормированияУПД(ВидДоговора)
	
	Результат = Неопределено;
	
	ПолноеИмяВидаДоговораСКомитентомНаЗакупку = "Перечисление.ВидыДоговоровКонтрагентов.ЗначениеПеречисления.СКомитентомНаЗакупку";
	
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером Тогда
		Результат = "00005";
	ИначеЕсли Метаданные.НайтиПоПолномуИмени(ПолноеИмяВидаДоговораСКомитентомНаЗакупку) <> Неопределено
		И ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку Тогда
		Результат = "00007";
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция УПД970_ПолучитьОбстоятельстваФормированияСчетФактуры(ДанныеДокумента)
	
	Перем Результат;
	
	ЭтоКомиссионнаяТорговля = ЭтоВидДоговораНаКомиссионнуюТорговлю(ДанныеДокумента.ВидДоговора);
	
	ЭтоСчетФактураВыданныйНаАванс = Ложь;
	КодВидаОперации = "";
	
	Если ЭтоСчетФактураВыданный(ДанныеДокумента.Ссылка) Тогда
		ЭтоСчетФактураВыданныйНаАванс = ЭтоСчетФактураНаАванс(ДанныеДокумента.Ссылка);
		КодВидаОперации = ЗначениеРеквизитаОбъектаЛок(ДанныеДокумента.Ссылка, "КодВидаОперации");
	КонецЕсли;
	
	Если КодВидаОперации = "01" И ЭтоКомиссионнаяТорговля Тогда
		Результат = "1";	
	ИначеЕсли ЭтоСчетФактураВыданныйНаАванс Тогда
		Результат = "2";
	ИначеЕсли КодВидаОперации = "27" Тогда // Сводный комиссионный
		Результат = "3";
	ИначеЕсли КодВидаОперации = "06" Тогда // Налоговый агент
		Результат = "4";
	ИначеЕсли КодВидаОперации = "34" Тогда // НДСИНА
		Результат = "5";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВидАдресаЮрФизЛица(ЮрФизЛицо, ТипАдреса)
	
	Результат = Неопределено;
	
	ПринадлежностьАдреса = "";
	
	ТипОбъекта = ТипЗнч(ЮрФизЛицо);
	
	Если ТипОбъекта = Тип("СправочникСсылка.Организации") Тогда
		
		Если ЮрФизЛицо.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ПринадлежностьАдреса = "Организации";
		Иначе
			ПринадлежностьАдреса = "ФизЛица";
		КонецЕсли;
		
	ИначеЕсли ЭтоКонфигурацияБП()
		И ТипОбъекта = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		
		ПринадлежностьАдреса = "ПодразделенияОрганизации";
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ПринадлежностьАдреса = "Контрагента";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПринадлежностьАдреса) Тогда
		ИмяВидаКИ = ?(ТипАдреса = Перечисление_ВидыКонтактнойИнформации().ЮридическийАдрес, "ЮрАдрес", "ФактАдрес") + ПринадлежностьАдреса;
		Результат = Справочники.ВидыКонтактнойИнформации[ИмяВидаКИ];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоединитьЭлементыАдресногоОбъекта(Элемент1, Элемент2)

