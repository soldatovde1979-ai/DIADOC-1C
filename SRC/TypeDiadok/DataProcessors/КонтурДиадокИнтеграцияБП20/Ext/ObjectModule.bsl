Функция УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры_КА11(ДокументСсылка, СчетФактура, ФункцияДокумента)
	
	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанные_РеализацияТоваровУслуг(ДокументСсылка, ФункцияДокумента);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанные_КорректировкаРеализации(ДокументСсылка);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		Результат = УПД970_ИсходныеДанные_ОтчетКомитентуОПродажах(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		
		Результат = УПД970_ИсходныеДанные_ВозвратуТоваровПоставщику(ДокументСсылка, ФункцияДокумента);
		
	ИначеЕсли ЭтоПередачаОС(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанные_ПередачеОС(ДокументСсылка);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах") Тогда
		
		Результат = УПД970_ИсходныеДанные_ОтчетКомиссионераОПродажах(ДокументСсылка, СчетФактура);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = Ядро.Общее_ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТипЗнч(ДокументСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

