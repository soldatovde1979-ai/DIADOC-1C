		МодульУправленияКИ = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
		Результат = МодульУправленияКИ.ПолучитьПредставлениеАдреса(ЗаписьКИ);
		
	Иначе
		
		Результат = ЗаписьКИ.Представление;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

