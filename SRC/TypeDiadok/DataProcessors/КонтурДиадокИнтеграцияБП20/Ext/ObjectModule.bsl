// Заполняет модель данных электронного счета на оплату.
//
// Параметры:
//  МодельШапка - Структура - Контракт шапки неформализованного счета на оплату по форме ДД
//  			(см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату()
//  МодельТабличнаяЧасть - Структура - Контракт табличной части неформализованного счета на оплату по форме ДД
//  			(см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату()
//  ОснованиеЭлектронногоСчета	 - ЛюбаяСсылка	 - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанные(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета) Экспорт
	
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_СчетНаОплату(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоЗаказПокупателя_УПП13(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ЗаказПокупателя(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		
		ТекстОшибки = СтрШаблонЛок(ШаблонТекстаОшибки, ТипЗнч(ОснованиеЭлектронногоСчета));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_СчетНаОплату(МодельШапка,
	МодельТабличнаяЧасть,
	ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ОснованиеЭлектронногоСчета);
	Запрос.Текст = ТекстЗапроса_ДанныеДокумента_СчетНаОплату();
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	СчетаНаОплату_ЗаполнитьДанные_ПоУмолчанию(МодельШапка, МодельТабличнаяЧасть, ДанныеШапки, ДанныеТабличнойЧасти);
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи(МодельШапка,
	МодельТабличнаяЧасть,
	ОснованиеЭлектронногоСчета)
	
	Если ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_РеализацияТоваровУслуг(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_АктОбОказанииПроизводственныхУслуг(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли  ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
				
		СчетаНаОплату_ЗаполнитьДанные_КорректировкаРеализации(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.ПередачаОС") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ПередачаОС(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ОтчетКомитентуОПродажах(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.РеализацияУслугПоПереработке") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_РеализацияУслугПоПереработке(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа продажи: %1'");
			
		ТекстОшибки = СтрШаблонЛок(ШаблонТекстаОшибки, ТипЗнч(ОснованиеЭлектронногоСчета));
		
		ВызватьИсключение ТекстОшибки;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_РеализацияТоваровУслуг(МодельШапка,
	МодельТабличнаяЧасть,
	ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ОснованиеЭлектронногоСчета);
	
	МетаданныеРеализацияТоваровУслуг =  Метаданные.Документы.РеализацияТоваровУслуг;
	
	ЕстьАгентскиеУслуги = МетаданныеРеализацияТоваровУслуг.ТабличныеЧасти.Найти("АгентскиеУслуги") <> Неопределено;
	
	Если ЕстьАгентскиеУслуги Тогда
	
		Запрос.Текст = ТекстЗапроса_ДанныеДокумента_РеализацияТоваровУслуг_БП();
		
	Иначе
		
		Запрос.Текст = ТекстЗапроса_ДанныеДокумента_РеализацияТоваровУслуг_УПП();
	
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	СчетаНаОплату_ЗаполнитьДанные_ПоУмолчанию(МодельШапка, МодельТабличнаяЧасть, ДанныеШапки, ДанныеТабличнойЧасти);
	
КонецПроцедуры

