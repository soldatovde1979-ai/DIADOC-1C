	ДокументОснование = ДокументыОснования[0];
	ДанныеПоДокументуОснования = УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры(ДокументОснование, СчетФактура, ФункцияДокумента);
	
	ТаблицаДанныеШапкиОснования = ДанныеПоДокументуОснования.РезультатПоШапке.Выгрузить();
	ДанныеШапкиОснования = ТаблицаДанныеШапкиОснования[0];
	
	Контент = Контракт_ПротоСтруктураУПД970();
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ПолучитьОбстоятельстваФормированияДокумента(ДанныеШапки, ФункцияДокумента);
	
	Если ДанныеШапки.Исправление Тогда
		Контент.RevisionNumber = ДанныеШапки.НомерИсправления;
		Контент.RevisionDate = ДанныеШапки.Дата;
		
		Если ЗначениеЗаполнено(ДанныеШапки.НомерИсходногоДокумента) Тогда
			Контент.DocumentNumber = ДанныеШапки.НомерИсходногоДокумента;
		Иначе
			Контент.DocumentNumber = ДанныеШапки.НомерИсправляемогоКорректировочногоДокумента;
		КонецЕсли;
		
		ДобавитьИндексОбособленногоПодразделения(Контент.DocumentNumber, СчетФактура, ДанныеШапкиОснования.ПодразделениеОрганизации);
		
		Если ЗначениеЗаполнено(ДанныеШапки.ДатаИсходногоДокумента) Тогда
			Контент.DocumentDate = ДанныеШапки.ДатаИсходногоДокумента;
		Иначе
			Контент.DocumentDate = ДанныеШапки.ДатаИсправляемогоКорректировочногоДокумента;
		КонецЕсли;
		
	Иначе
		
		Контент.DocumentNumber = ПредставлениеНомераДляСФ(СчетФактура, ДанныеШапкиОснования.ПодразделениеОрганизации);
		Контент.DocumentDate = ДанныеШапки.Дата;
		
	КонецЕсли;
	
	УПД970_ЗаполнитьИдентификаторГосКонтракта(Контент, ДанныеШапки);
	
	УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(Контент, ДанныеПоДокументу.РезультатПоДокументамОплаты);
	
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокументаОснованияСчетаФактуры(
		Контент,
		ДанныеПоДокументуОснования,
		ДополнительныеПараметры);
		
	Для Индекс = 1 По ДокументыОснования.ВГраница() Цикл
		
		ДокументОснование = ДокументыОснования[Индекс];
		
		ДанныеПоДокументуОснования = УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры(ДокументОснование, СчетФактура, ФункцияДокумента);
	
		УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокументаОснованияСчетаФактуры(
			Контент,
			ДанныеПоДокументуОснования,
			ДополнительныеПараметры);
		
	КонецЦикла;	
		
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДокументыОснования, ФункцияДокумента);
		
	Если ЭтоКонфигурацияБП() Тогда
		УПД970_ЗаполнитьРеквизитыОснованияОтгрузкиТоваровПоСчетФактуре_БП20(Контент,
																			СчетФактура,
																			ДокументыОснования,
																			ДополнительныеПараметры);
	Иначе
		УПД970_ЗаполнитьРеквизитыОснованияОтгрузкиТоваровПоСчетФактуре_УПП13(Контент,
																			ДокументыОснования,
																			ДополнительныеПараметры);
	КонецЕсли;
	
	УПД970_ЗаполнитьВалютуДокумента(Контент, ДанныеШапкиОснования, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОПродавце(Контент, ТаблицаДанныеШапкиОснования);
	УПД970_ЗаполнитьСведенияОГрузоотправителе(Контент, ТаблицаДанныеШапкиОснования);

	УПД970_ЗаполнитьСведенияОПокупателе(Контент, ДанныеШапкиОснования, ДанныеШапки.КППКонтрагента);
	УПД970_ЗаполнитьСведенияОГрузополучателе(Контент, ДанныеШапкиОснования);
	
	Если ЭтоСчетФактураОтИмениПродавца_БП20(СчетФактура) Тогда
		УПД970_ЗаполнитьСоставителяДокументаПоДаннымАгента(Контент, СчетФактура);
	Иначе
		УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	КонецЕсли;
	
	УПД970_ЗаполнитьСведенияОСотруднике(Контент, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	УПД970_ЗаполнитьСведенияОМаркировке(Контент, СчетФактура);
	
	Если УПД970_ВДокументеТолькоУслуги(Контент.Table.Items) Тогда
		УПД970_ИзменитьСведенияОбУчастникахЭДОВДокументеУслуг(Контент);
	КонецЕсли;
	
	Возврат Контент;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавца_СчетФактураВыданныйНаАванс(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры)
	
	Перем Контент;
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеПоСчетФактураВыданныйНаАванс(ДокСсылка);
	
	ДанныеШапки = ДанныеПоДокументу.РезультатПоШапке.Выбрать();
	ДанныеШапки.Следующий();
	
	Контент = Контракт_ПротоСтруктураУПД970();
	
	Контент.Function = ФункцияДокумента;
	
	Контент.CircumFormatInvoice = УПД970_ПолучитьОбстоятельстваФормированияДокумента(ДанныеШапки, ФункцияДокумента);
	
	Контент.DocumentNumber = ПредставлениеНомера(ДокСсылка);
	Контент.DocumentDate = ДанныеШапки.Дата;
	
	УПД970_ЗаполнитьИдентификаторГосКонтракта(Контент, ДанныеШапки);
	
	УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(Контент, ДанныеПоДокументу.РезультатПоДокументамОплаты);
	
	УПД970_ЗаполнитьВалютуДокумента(Контент, ДанныеШапки, ФункцияДокумента);
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	
	СведенияОПоставщике = УПД970_ДанныеУчастникаЭДО(
		ДанныеШапки.Организация,
		ДанныеШапки.Дата,
		БанковскийСчет);
		
	СведенияОбАдресе = УПД970_СведенияОбЮридическомАдресе(ДанныеШапки.Организация);
	
	Seller = Контракт_ExtendedOrganizationInfo970();
	Контент.Sellers.Добавить(Seller);

	УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, СведенияОПоставщике, СведенияОбАдресе);
	
	СведенияОКонтрагенте = УПД970_ДанныеУчастникаЭДО(
		ДанныеШапки.Контрагент,
		ДанныеШапки.Дата);
		
	СведенияОбАдресе = УПД970_СведенияОбЮридическомАдресе(ДанныеШапки.Контрагент);
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	Контент.Buyers.Добавить(Buyer);

	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, СведенияОКонтрагенте, СведенияОбАдресе);
	
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	Table = Контракт_InvoiceTable970();
	Контент.Table = Table;
	
	ТочностьЦены = ДополнительныеПараметры.ТочностьЦены;
	
	НДСИсчисляетсяНалоговымАгентом = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	
	РезультатПоТабличнойЧасти = ДанныеПоДокументу.РезультатПоТабличнойЧасти;
	ИтогиПоТабличнойЧасти = РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ИтогиПоТабличнойЧасти.Следующий() Тогда
		
		ДанныеТабличнойЧасти = ИтогиПоТабличнойЧасти.Выбрать();
		Пока ДанныеТабличнойЧасти.Следующий() Цикл
			
			Item = Контракт_Item970();
			
			Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.Содержание) Тогда
				Номенклатура = ДанныеТабличнойЧасти.Содержание;
			ИначеЕсли ЗначениеЗаполнено(ДанныеТабличнойЧасти.ТоварПолноеНаименование) Тогда
				Номенклатура = ДанныеТабличнойЧасти.ТоварПолноеНаименование;
			ИначеЕсли ЗначениеЗаполнено(ДанныеТабличнойЧасти.ТоварНаименование) Тогда
				Номенклатура = ДанныеТабличнойЧасти.ТоварНаименование;
			Иначе
				Номенклатура = "Предварительная оплата";
			КонецЕсли;
			
			Item.Product = Номенклатура;
			Item.ItemMark = УПД970_ПризнакТовараИлиУслугиПоСтрокеДокумента(ДанныеТабличнойЧасти.ВидПоступления);
			
			Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.ТоварКод) Тогда
				Item.ItemVendorCode = ДанныеТабличнойЧасти.ТоварКод;
			КонецЕсли;
			
			Item.TaxRate = ПредставлениеСтавкиНДС(ДанныеТабличнойЧасти.СтавкаНДС, НДСИсчисляетсяНалоговымАгентом);
			
			Если НДСИсчисляетсяНалоговымАгентом Тогда
				Item.Vat = 0;
				Item.Subtotal = 0;
				Item.SubtotalWithVatExcluded = ДанныеТабличнойЧасти.Сумма;
			Иначе
				Item.Vat = ДанныеТабличнойЧасти.СуммаНДС;
				Item.Subtotal = ДанныеТабличнойЧасти.Сумма;
			КонецЕсли;
			
			Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(ДанныеТабличнойЧасти);
			
			Table.Items.Добавить(Item);
			
		КонецЦикла;
		
		Если Не НДСИсчисляетсяНалоговымАгентом Тогда
			Table.Vat = ИтогиПоТабличнойЧасти.СуммаНДС;
			Table.Total = ИтогиПоТабличнойЧасти.Сумма;
		Иначе
			Table.Total = 0;
			Table.TotalWithVatExcluded = ИтогиПоТабличнойЧасти.Сумма;
		КонецЕсли;
		
	КонецЕсли;
	
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	Возврат Контент;
	
КонецФункции

