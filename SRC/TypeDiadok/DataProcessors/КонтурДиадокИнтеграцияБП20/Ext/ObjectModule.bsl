Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейОтражениеНачисленияНДС()
	
	Результат =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДокШапка.ПрямаяЗаписьВКнигу
	|			ТОГДА ""Услуги""
	|		КОГДА Т.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			ТОГДА ""Услуги""
	|		ИНАЧЕ ""Товары""
	|	КОНЕЦ КАК ВидПоступления,
	|	1 КАК Порядок,
	|	Т.НомерСтроки КАК ИдентификаторСтроки,
	|	""ТоварыИУслуги"" КАК ИмяТабличнойЧасти,
	|	ВЫБОР
	|		КОГДА ДокШапка.ПрямаяЗаписьВКнигу
	|			ТОГДА Т.ВидЦенности
	|		ИНАЧЕ Т.Номенклатура
	|	КОНЕЦ КАК Товар,
	|	ВЫБОР
	|		КОГДА ДокШапка.ПрямаяЗаписьВКнигу
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(Т.ВидЦенности)
	|		ИНАЧЕ ВЫРАЗИТЬ(Т.Номенклатура.Наименование КАК СТРОКА(1000))
	|	КОНЕЦ КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА ДокШапка.ПрямаяЗаписьВКнигу
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(Т.ВидЦенности)
	|		КОГДА Т.Номенклатура ССЫЛКА Справочник.ОбъектыСтроительства
	|			ТОГДА ВЫРАЗИТЬ(Т.Номенклатура.Наименование КАК СТРОКА(1000))
	|		ИНАЧЕ ВЫРАЗИТЬ(Т.Номенклатура.НаименованиеПолное КАК СТРОКА(1000))
	|	КОНЕЦ КАК ТоварПолноеНаименование,
	|	Т.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(Т.ХарактеристикаНоменклатуры, """") КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(Т.СерияНоменклатуры, """") КАК СерияНоменклатуры,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.СерияНоменклатуры.НомерГТД КАК НомерГТД,
	|	Т.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СпрЕдиницыИзмерения.ЕдиницаПоКлассификатору КАК ЕдиницаИзмеренияЕдиницаПоКлассификатору,
	|	СпрЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	СпрЕдиницыИзмерения.Наименование КАК ЕдиницаИзмеренияНаименование,
	|	Т.Номенклатура.Артикул КАК ТоварАртикул,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Количество КАК Количество,
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура.Код КАК ТоварКод,
	|	Т.СерияНоменклатуры.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Т.СерияНоменклатуры.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	Т.СерияНоменклатуры.СтранаПроисхождения.УчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	ЛОЖЬ КАК ПрослеживаемыйКомплект
	|ИЗ
	|	Документ.ОтражениеРеализацииТоваровИУслугНДС.ТоварыИУслуги КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтражениеРеализацииТоваровИУслугНДС КАК ДокШапка
	|		ПО Т.Ссылка = ДокШапка.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК СпрЕдиницыИзмерения
	|		ПО Т.ЕдиницаИзмерения = СпрЕдиницыИзмерения.Ссылка
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС),
	|	СУММА(Количество)
	|ПО
	|	ОБЩИЕ";
	
	Возврат Результат;
	
КонецФункции

