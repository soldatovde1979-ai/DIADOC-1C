Процедура УПД970_ЗаполнитьСведенияОМаркировке(Контент, СсылкаНаОбъект)
	
	Попытка
		
		РаботаСМаркировкой.ЗаполнитьСведенияОМаркировке970(Контент);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		
		ПодробнаяОшибка = Ядро.Общее_ПодставитьПараметрыВСтроку(
			"Не удалось заполнить сведения о маркировке по причине:
			|%1",
			ПодробноеПредставлениеОшибки(Ошибка)
		);
		
		ЗаписьЖурналаРегистрации(
			"Диадок.РаботаСМаркировкой",
			УровеньЖурналаРегистрации.Ошибка,
			СсылкаНаОбъект.Метаданные(),
			СсылкаНаОбъект,
			ПодробнаяОшибка
		);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьCustomDeclaration(Item, НомерГТД, СтранаПроисхожденияКод, СтранаПроисхожденияУчастникЕАЭС)
	
	Если СтранаПроисхожденияКод = ОсновнаяСтрана().Код Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоКонфигурацияКА() Тогда
		
		Если Не ЗначениеЗаполнено(НомерГТД)
			И (Не ЗначениеЗаполнено(СтранаПроисхожденияКод)
			Или СтранаУчастникЕАЭС(СтранаПроисхожденияКод)) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(НомерГТД)
			И (Не ЗначениеЗаполнено(СтранаПроисхожденияКод)
			Или СтранаПроисхожденияУчастникЕАЭС) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	CustomDeclaration = Контракт_CustomDeclarations();
	CustomDeclaration.CountryCode = СтранаПроисхожденияКод;
	CustomDeclaration.DeclarationNumber = СокрЛП(НомерГТД);
	
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

