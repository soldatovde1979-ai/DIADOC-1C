КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_КорректировкаРеализации(МодельШапка,
	МодельТабличнаяЧасть,
	ОснованиеЭлектронногоСчета)
	
	МетаданныеКорректировкаРеализации = Метаданные.Документы.КорректировкаРеализации;
	
	ЕстьАгентскиеУслуги = МетаданныеКорректировкаРеализации.ТабличныеЧасти.Найти("АгентскиеУслуги") <> Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ОснованиеЭлектронногоСчета);
	
	Если ЕстьАгентскиеУслуги Тогда
		
		Запрос.Текст = ТекстЗапроса_ДанныеДокумента_КорректировкаРеализации_БП();
		
	Иначе
		
		Запрос.Текст = ТекстЗапроса_ДанныеДокумента_КорректировкаРеализации_УПП();
		
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Ссылка);
	ДатаДокумента = ДанныеШапки.Дата;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = Ложь;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = ДанныеШапки.ВалютаКод;
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если НЕ ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчет = БанковскийСчет;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			СтрокаТЧ.НаименованиеПолное,
			СтрокаТЧ.ХарактеристикаНоменклатуры,
			СтрокаТЧ.Содержание
		);
		
		НоваяСтрока.НоменклатураПредставление = НоменклатураПредставление;
		
		НоваяСтрока.НоменклатураАртикул = СтрокаТЧ.НоменклатураАртикул;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ПередачаОС(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ОснованиеЭлектронногоСчета);
	Запрос.Текст = ТекстЗапроса_ДанныеДокумента_ПередачаОС();
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	СчетаНаОплату_ЗаполнитьДанные_ПоУмолчанию(МодельШапка, МодельТабличнаяЧасть, ДанныеШапки, ДанныеТабличнойЧасти);
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ОтчетКомитентуОПродажах(МодельШапка,
	МодельТабличнаяЧасть,
	ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ОснованиеЭлектронногоСчета);
	Запрос.Текст = ТекстЗапроса_ДанныеДокумента_ОтчетКомитентуОПродажах();
	
	ДанныеШапки =  Запрос.Выполнить().Выгрузить()[0];
	
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Ссылка);
	ДатаДокумента = ДанныеШапки.Дата;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = ДанныеШапки.ВалютаКод;
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	Руководители = РегламентированнаяОтчетность.ОтветственныеЛицаОрганизаций(ДанныеШапки.Организация, ДанныеШапки.Дата);

	МодельШапка.РуководительФИО = Руководители.Руководитель;
	
	Если ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетОрганизации) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(ДанныеШапки.БанковскийСчетОрганизации);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
		
	НоваяСтрока = МодельТабличнаяЧасть.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеШапки);
	
	НоваяСтрока.НоменклатураПредставление = ДанныеШапки.НаименованиеПолное;
	
	СтавкаНДС = УчетНДС.ПолучитьСтавкуНДС(ДанныеШапки.СтавкаНДС);
	
	НоваяСтрока.СуммаНДС = УчетНДС.РассчитатьСуммуНДС(
		ДанныеШапки.Сумма,
		ДанныеШапки.УчитыватьНДС, 
		ДанныеШапки.СуммаВключаетНДС,
		СтавкаНДС
	);
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_РеализацияУслугПоПереработке(МодельШапка,
			МодельТабличнаяЧасть,
			ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ОснованиеЭлектронногоСчета);
	Запрос.Текст = ТекстЗапроса_ДанныеДокумента_РеализацияУслугПоПереработке();
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	СчетаНаОплату_ЗаполнитьДанные_ПоУмолчанию(МодельШапка, МодельТабличнаяЧасть, ДанныеШапки, ДанныеТабличнойЧасти);
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ПоУмолчанию(МодельШапка,
			МодельТабличнаяЧасть,
			ДанныеШапки,
			ДанныеТабличнойЧасти)
	
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Ссылка);
	ДатаДокумента = ДанныеШапки.Дата;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = Ложь;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = ДанныеШапки.ВалютаКод;
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	Руководители = РегламентированнаяОтчетность.ОтветственныеЛицаОрганизаций(ДанныеШапки.Организация, ДанныеШапки.Дата);

	МодельШапка.РуководительФИО = Руководители.Руководитель;

	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если НЕ ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчет = БанковскийСчет;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	МодульЦенообразование = ОбщийМодульПоИмениЛок("Ценообразование");
	
	Для Каждого СтрокаТЧ Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			СтрокаТЧ.НаименованиеПолное,
			СтрокаТЧ.ХарактеристикаНоменклатуры,
			СтрокаТЧ.Содержание
		);
		
		Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
			НоваяСтрока.СуммаСкидки = МодульЦенообразование.ПолучитьСуммуСкидки(СтрокаТЧ.Сумма, СтрокаТЧ.Скидка);
		КонецЕсли;
		
		НоваяСтрока.НоменклатураПредставление = НоменклатураПредставление;
		
		НоваяСтрока.НоменклатураАртикул = СтрокаТЧ.НоменклатураАртикул;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ЗаказПокупателя(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
