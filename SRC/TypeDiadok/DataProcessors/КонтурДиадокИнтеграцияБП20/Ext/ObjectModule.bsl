Процедура УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиКонтрагента_КА11(ДанныеУчастникаЭДО, Ссылка)
	
	СведенияОКонтрагенте = УПД970_СведенияОКонтрагенте_КА11(Ссылка);
	
	ЭтоИностраннаяОрганизация = СведенияОКонтрагенте.НеЯвляетсяРезидентом;
	
	Если Не ЭтоИностраннаяОрганизация Тогда
		
		СведенияОСтране = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Справочники.КлассификаторСтранМира.Россия, "Ссылка, Код, Наименование");
		
		ДанныеУчастникаЭДО.Страна = СведенияОСтране.Ссылка;
		ДанныеУчастникаЭДО.СтранаКод = СведенияОСтране.Код;
		ДанныеУчастникаЭДО.СтранаНаименование = СведенияОСтране.Наименование;
		
	КонецЕсли;
	
	ДанныеУчастникаЭДО.ЮрФизЛицо = СведенияОКонтрагенте.ЮрФизЛицо;
	ДанныеУчастникаЭДО.Наименование = СведенияОКонтрагенте.НаименованиеПолное;
	
	ДанныеУчастникаЭДО.ЭлектроннаяПочта = УПД970_АдресЭлектроннойПочты(Ссылка);
	
КонецПроцедуры

Функция УПД970_СведенияОКонтрагенте_КА11(Ссылка)
	
	РеквизитыКонтрагента = Новый Структура;
	РеквизитыКонтрагента.Вставить("ЮрФизЛицо", "ЮрФизЛицо");
	РеквизитыКонтрагента.Вставить("НаименованиеПолное", "НаименованиеПолное");
	РеквизитыКонтрагента.Вставить("НеЯвляетсяРезидентом", "НеЯвляетсяРезидентом");
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, РеквизитыКонтрагента);
	
	Возврат Результат;
	
КонецФункции

