Процедура УПД970_ЗаполнитьРеквизитыОснованияОтгрузкиТоваров(Контент, ДокументОснования, ДополнительныеПараметры)
	
	Если ЭтоКонфигурацияБП() Тогда
		
		ОснованиеОтгрузки = УПД970_ОснованиеОтгрузкиТоваровПоДокументу_БП20(ДокументОснования);
		РеквизитыОснования = УПД970_РеквизитыОснованияОтгрузкиТоваров_БП20(ОснованиеОтгрузки);
		
	Иначе
		
		ОснованиеОтгрузки = УПД970_ОснованиеОтгрузкиТоваровПоДокументу_УПП13(ДокументОснования);
		РеквизитыОснования = УПД970_РеквизитыОснованияОтгрузкиТоваров_УПП13(ОснованиеОтгрузки);
		
	КонецЕсли;
	
	РеквизитыОснованийОтгрузки = ЗначениеВМассивЛок(РеквизитыОснования);
	
	УПД970_ЗаполнитьСведенияОПередачеТоваров(Контент, РеквизитыОснованийОтгрузки, ДополнительныеПараметры);
	
КонецПроцедуры

Функция УПД970_ВДокументеЕстьТовары(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Имущество Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	МаксИндекс = СтрокиТаблицы.Количество() - 1;
	
	Для ТекИндекс = - МаксИндекс По 0 Цикл
		
		ItemMark = СтрокиТаблицы[ - ТекИндекс].ItemMark;
		
		Если ItemMark = ТипыНоменклатуры.Услуга
			ИЛИ ItemMark = ТипыНоменклатуры.Работа
			ИЛИ ItemMark = ТипыНоменклатуры.ИмущественныеПрава Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеТолькоУслуги(СтрокиТаблицы)
	
	Результат = Истина;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если НЕ СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Услуга Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
