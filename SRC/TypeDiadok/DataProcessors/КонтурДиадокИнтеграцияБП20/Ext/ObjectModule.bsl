// Типовой обработчик события "ПолучитьТаблицуИспользуемыхПакетов"
//
// Параметры:
//  ТЗ - ТаблицаЗначений - см. МенеджерИнтеграции.ПоставляемыеВидыПакетов
//
Процедура ЗаполнитьСписокПоставляемыхПакетов(ТЗ) Экспорт
	
	КатегорииПакетов = КатегорииПакетов();
	
	ОсновнойПакет			= КатегорииПакетов.ОсновнойПакет;
	КорректировочныйПакет	= КатегорииПакетов.КорректировочныйПакет;
	СчетФактураНаАванс		= КатегорииПакетов.СчетФактураНаАванс;
	СчетНаОплату			= КатегорииПакетов.СчетНаОплату;
	АктCверки				= КатегорииПакетов.АктCверки;
	БезКатегории			= КатегорииПакетов.БезКатегории;
	ВнутренниеПеремещения	= КатегорииПакетов.ВнутренниеПеремещения;
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_УПД",					"УПД",								"ID_УПД, ID_УПД_ДОП",								ОсновнойПакет);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ОсновнойПакет",		"СФ + ТОРГ12/Акт",					"ID_АктФормализованный, ID_ТОРГ12, ID_СчетФактура",	ОсновнойПакет);
	ДобавитьСтрокуТЗ(ТЗ, "ID_УПД_раздельно",		"УПД СЧФ + УПД ДОП",				"ID_УПД_СЧФ, ID_УПД_ДОП",							ОсновнойПакет);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_УКД",					"УКД",								"ID_УКД",											КорректировочныйПакет);
	ДобавитьСтрокуТЗ(ТЗ, "ID_УКД_раздельно",		"УКД КСЧФ + УКД ДИС",				"ID_УКД_КСЧФ, ID_УКД_ДИС",							КорректировочныйПакет);
	ДобавитьСтрокуТЗ(ТЗ, "ID_КСФ",					"КСФ",								"ID_КСФ",											КорректировочныйПакет);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_СФ_НаАванс",			"СФ (на аванс)",					"ID_СчетФактура",									СчетФактураНаАванс);
	ДобавитьСтрокуТЗ(ТЗ, "ID_УПД_НаАванс",			"УПД СЧФ (на аванс)",				"ID_УПД_СЧФ",										СчетФактураНаАванс);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_Счет",					"Счет (неформализованный)",			"ID_Счет",											СчетНаОплату);
	ДобавитьСтрокуТЗ(ТЗ, "ID_СчетФормализованный",	"Счет (Диадок)",					"ID_СчетФормализованный",							СчетНаОплату);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_АктСверки",			"Акт сверки",						"ID_АктСверки",										АктCверки);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИУПД",					"УПД (исправление)",				"ID_ИУПД",											БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИУПД_раздельно",		"УПД СЧФ + УПД ДОП (исправление)",	"ID_ИУПД_СЧФ, ID_УПД_ДОП",							БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИСФ",					"СФ (исправление)",					"ID_ИСФ",											БезКатегории);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИУКД",					"УКД (исправление)",				"ID_ИУКД",											БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИУКД_раздельно",		"УКД КСЧФ + УКД ДИС (исправление)",	"ID_ИУКД_КСЧФ, ID_ИУКД_ДИС",						БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИКСФ",					"КСФ (исправление)",				"ID_ИКСФ",											БезКатегории);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИУПД_НаАванс",			"УПД (исправление на аванс)",		"ID_ИУПД_СЧФ",										БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИСФ_НаАванс",			"СФ (исправление на аванс)",		"ID_ИСФ",											БезКатегории);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_ТОРГ12_Акт_БезНДС",	"ТОРГ12/Акт (без СФ)",				"ID_АктФормализованный, ID_ТОРГ12",					БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_УПД_БезНДС",			"УПД ДОП (без СФ)",					"ID_УПД_ДОП",										БезКатегории);
	ДобавитьСтрокуТЗ(ТЗ, "ID_ИУПД_БезНДС",			"УПД ДОП (исправление без СФ)",	"ID_ИУПД_ДОП",											БезКатегории);

	ДобавитьСтрокуТЗ(ТЗ, "ID_УКД_БезНДС",			"УКД ДИС (без СФ)",				"ID_УКД_ДИС",											БезКатегории);
	
	ДобавитьСтрокуТЗ(ТЗ, "ID_УПД_ВНУТР",			"УПД (перемещение)",				"ID_УПД_ВНУТР",										ВнутренниеПеремещения);
	
	ЗаполнитьНаименованияКатегорийПакетов(ТЗ);
	УстановитьПакетамПризнакВнутреннегоДО(ТЗ);
	
КонецПроцедуры

// Типовой обработчик события "ПодготовитьДанныеДляОтправкиВнутреннихДокументов"
//
// Параметры:
//  ВидПакетаID - Строка - идентификатор вида пакета
//  Запрос - Запрос - инициализированный запрос (с параметрами и менеджером временных таблиц)
// 
// Возвращаемое значение:
//  Массив из Строка - имена добавленных временных таблиц
//
Функция ВнутренниеДокументыСлужебный_ПодготовитьДанныеДляОтправки(ВидПакетаID, Запрос) Экспорт
	
	Результат = Новый Массив;
	
	Если ВидПакетаID <> "ID_УПД_ВНУТР" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ПеремещениеТоваров) Тогда
		ИмяВТ = ДобавитьТаблицу_ПеремещениеТоваров(Запрос);
		Результат.Добавить(ИмяВТ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Вызывается из МодульМенеджер.ЗначенияПолейМаршрутизацииПоПодразделениям.
// Переопределяет получение значений полей маршрутизации по документу 1С
//
// Параметры:
//	ПоляОтправителя		- Массив 			- значения полей маршрутизации в подразделение отправителя
//	ПоляПолучателя		- Массив 			- значения полей маршрутизации в подразделение получателя
//	Документ1С			- ДокументСсылка 	- документ пакета, для которого определяются значения полей
Процедура ЗаполнитьЗначенияПолейМаршрутизацииПоПодразделениям(ПоляОтправителя, ПоляПолучателя, Документ1С) Экспорт
	
	ТипСсылки = ТипЗнч(Документ1С);
	
	ЭтоСчетФактураВыданный = (ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный"));
	
	Если ЭтоСчетФактураВыданный Тогда
		
		ОснованияСФ = ДокументыОснованияСчетаФактуры(Документ1С);
		
		Если ОснованияСФ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ИсточникДанных = ОснованияСФ[0];
		
	Иначе
		ИсточникДанных = Документ1С;
	КонецЕсли;
	
	МетаданныеИсточникаДанных = ИсточникДанных.Метаданные(); 
	
	// ИМ БП 20 содержит интеграционную часть для конфигураций: "БухгалтерияПредприятия", "УправлениеПроизводственнымПредприятием",
	// "КомплекснаяАвтоматизация". В некоторых конфигурациях реквизит "Подразделение" может отсутствовать, либо иметь другое наименование
	ИмяРеквизитаПодразделение = "ПодразделениеОрганизации";
	ЕстьРеквизитПодразделение = ЕстьРеквизитОбъектаЛок(ИмяРеквизитаПодразделение, МетаданныеИсточникаДанных);
	
	Если Не ЕстьРеквизитПодразделение Тогда
		ИмяРеквизитаПодразделение = "Подразделение";
		ЕстьРеквизитПодразделение = ЕстьРеквизитОбъектаЛок(ИмяРеквизитаПодразделение, МетаданныеИсточникаДанных);
	КонецЕсли;
	
	ЕстьРеквизитОрганизация			= ЕстьРеквизитОбъектаЛок("Организация", МетаданныеИсточникаДанных);
	ЕстьРеквизитКонтрагент			= ЕстьРеквизитОбъектаЛок("Контрагент", МетаданныеИсточникаДанных);
	ЕстьРеквизитДоговорКонтрагента	= ЕстьРеквизитОбъектаЛок("ДоговорКонтрагента", МетаданныеИсточникаДанных);
	
	ИменаРеквизитов = Новый Массив;
	
	Если ЕстьРеквизитПодразделение Тогда
		ИменаРеквизитов.Добавить(ИмяРеквизитаПодразделение);
	КонецЕсли;
	
	ЕстьРеквизитСкладОтправитель = ЕстьРеквизитОбъектаЛок("СкладОтправитель", МетаданныеИсточникаДанных);
	Если ЕстьРеквизитСкладОтправитель Тогда
		ИменаРеквизитов.Добавить("СкладОтправитель");
	КонецЕсли;
	
	ЕстьРеквизитСкладПолучатель = ЕстьРеквизитОбъектаЛок("СкладПолучатель", МетаданныеИсточникаДанных);
	Если ЕстьРеквизитСкладПолучатель Тогда
		ИменаРеквизитов.Добавить("СкладПолучатель");
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация Тогда
		ИменаРеквизитов.Добавить("Организация");
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент Тогда
		ИменаРеквизитов.Добавить("Контрагент");
	КонецЕсли;
	
	Если ЕстьРеквизитДоговорКонтрагента Тогда
		ИменаРеквизитов.Добавить("ДоговорКонтрагента");
	КонецЕсли;
	
	ТребуемыеРеквизиты = Ядро.СоединитьСтроку(ИменаРеквизитов, ",");
	
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		Реквизиты = ЗначенияРеквизитовОбъектаЛок(ИсточникДанных, ТребуемыеРеквизиты);
	КонецЕсли;
	 
	// В коллекции ПоляОтправителя и ПоляПолучателя индекс элементов соответствует приоритету этих элементов.
	// Чем меньше индекс, тем выше приоритет.
	
	Если ЕстьРеквизитПодразделение И ЗначениеЗаполнено(Реквизиты[ИмяРеквизитаПодразделение]) Тогда
		ПоляОтправителя.Добавить(Реквизиты[ИмяРеквизитаПодразделение]);
	КонецЕсли;
	
	Если ЕстьРеквизитСкладОтправитель И ЗначениеЗаполнено(Реквизиты.СкладОтправитель) Тогда
		ПоляОтправителя.Добавить(Реквизиты.СкладОтправитель);
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация И ЗначениеЗаполнено(Реквизиты.Организация) Тогда
		ПоляОтправителя.Добавить(Реквизиты.Организация);
	КонецЕсли;
	
	Если ЕстьРеквизитСкладПолучатель И ЗначениеЗаполнено(Реквизиты.СкладПолучатель) Тогда
		ПоляПолучателя.Добавить(Реквизиты.СкладПолучатель);
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент И ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Контрагент);
	КонецЕсли;
	
	Если ЕстьРеквизитДоговорКонтрагента И ЗначениеЗаполнено(Реквизиты.ДоговорКонтрагента) Тогда
		ПоляПолучателя.Добавить(Реквизиты.ДоговорКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка - счет-фактура, основание которой нужно найти;
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на основания счета-фактуры.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Выборка = Ядро.Общее_ВыборкаДанныхОбъекта(СчетФактура, "ДокументыОснования", "ДокументОснование");
			
	Пока Выборка.Следующий() Цикл 
		
		ДокументОснование = Выборка.ДокументОснование;
		
		Если Результат.Найти(ДокументОснование) = Неопределено Тогда
			Результат.Добавить(ДокументОснование);
		КонецЕсли;
		
	КонецЦикла;
			
	Возврат Результат;
	
КонецФункции

