	|	ЕСТЬNULL(ТЧ.СерияНоменклатуры.НомерГТД, ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)) КАК НомерГТД,
	|	ЕСТЬNULL(ТЧ.СерияНоменклатуры.НомерГТД.Код, """") КАК ПолныйНомерГТД,
