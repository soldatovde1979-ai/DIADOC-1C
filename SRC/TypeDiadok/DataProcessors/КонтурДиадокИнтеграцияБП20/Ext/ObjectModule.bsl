Процедура ДополнитьКонтактнуюИнформациюДаннымиJson(КонтактнаяИнформация, ЗначениеJson, Тип)
	
	ИмяМодуля = "УправлениеКонтактнойИнформациейСлужебный";
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) <> Неопределено Тогда
		
		МодульУправлениеКонтактнойИнформациейСлужебный = ОбщийМодульПоИмениЛок(ИмяМодуля);
		
		ДанныеАдреса = Неопределено;
		
		Попытка
			ДанныеАдреса = МодульУправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(ЗначениеJson, Тип);
		Исключение
		КонецПопытки;
		
		Если ДанныеАдреса <> Неопределено Тогда
			
			Если  ДанныеАдреса.Свойство("addressType") И ДанныеАдреса.addressType = "ВСвободнойФорме" 
				И ДанныеАдреса.Свойство("Country") Тогда
				
				КонтактнаяИнформация.Поле1 = ДанныеАдреса.Country;	// Страна
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

