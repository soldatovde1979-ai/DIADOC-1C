Функция ЭтоСчетФактураНаАванс(ДокументСсылка)

	Результат = Ложь;
	
	Если ЭтоСчетФактураВыданный(ДокументСсылка) Тогда
		
		ВидСчетаФактуры = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "ВидСчетаФактуры");
		
		Результат = (ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАванс
					Или ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАвансКомитента);
		
		МетаданныеВидСчетаФактуры = Метаданные.Перечисления.ВидСчетаФактурыПолученного;
		Если МетаданныеВидСчетаФактуры.ЗначенияПеречисления.Найти("КорректировочныйНаАванс") <> Неопределено Тогда
			// отсутствует в КА 1.1.77 и ниже
			
			ИмяПредопределенногоЗначения = "Перечисление.ВидСчетаФактурыПолученного.КорректировочныйНаАванс";
			
			Результат = Результат Или ВидСчетаФактуры = ПредопределенноеЗначение(ИмяПредопределенногоЗначения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

