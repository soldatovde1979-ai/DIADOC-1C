	|	ДатаНомерДокументовОплаты.ДатаПлатежноРасчетногоДокумента КАК ДатаДокумента,
	|	ДатаНомерДокументовОплаты.НомерПлатежноРасчетногоДокумента КАК НомерДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДатаНомерДокументовОплаты КАК ДатаНомерДокументовОплаты
	|ГДЕ
	|	ДатаНомерДокументовОплаты.Ссылка = &Ссылка
	|	И ДатаНомерДокументовОплаты.ДатаПлатежноРасчетногоДокумента <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ДатаНомерДокументовОплаты.НомерПлатежноРасчетногоДокумента <> """"";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданный()

	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураВыданный.Ссылка КАК Ссылка,
	|	СчетФактураВыданный.Номер КАК Номер,
	|	СчетФактураВыданный.Дата КАК Дата,
	|	СчетФактураВыданный.Исправление КАК Исправление,
	|	СчетФактураВыданный.НомерИсправления КАК НомерИсправления,
	|	СчетФактураВыданный.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СчетФактураВыданный.КППКонтрагента КАК КППКонтрагента,
	|	СчетФактураВыданный.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	СчетФактураВыданный.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	СчетФактураВыданный.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	СчетФактураВыданный.НомерИсправляемогоКорректировочногоДокумента КАК НомерИсправляемогоКорректировочногоДокумента,
	|	СчетФактураВыданный.ДатаИсправляемогоКорректировочногоДокумента КАК ДатаИсправляемогоКорректировочногоДокумента,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО СчетФактураВыданный.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыДоговораПоДаннымШапкиДокумента(ДанныеШапки)

	Результат = Новый Структура;
	
	Результат.Вставить("Ссылка", ДанныеШапки.ДоговорКонтрагента);
	Результат.Вставить("Номер", ДанныеШапки.ДоговорДата);
	Результат.Вставить("Дата", ДанныеШапки.ДоговорНомер);
	Результат.Вставить("ВидДоговора", ДанныеШапки.ВидДоговора);
	Результат.Вставить("ВалютаВзаиморасчетов", ДанныеШапки.ВалютаВзаиморасчетов);
	Результат.Вставить("РасчетыВУсловныхЕдиницах", ДанныеШапки.РасчетыВУсловныхЕдиницах);
	Результат.Вставить("НДСИсчисляетсяНалоговымАгентом", ДанныеШапки.НДСИсчисляетсяНалоговымАгентом);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанные_ОтражениеНачисленияНДС(ДокСсылка)
	
	Запросы = Новый Массив;
	
	Запросы.Добавить(УПД970_ТекстЗапросаДанныхШапкиОтражениеНачисленияНДС());
	Запросы.Добавить(УПД970_ТекстЗапросаДанныхТабличныхЧастейОтражениеНачисленияНДС());
	
	Результат = УПД970_РезультатыЗапросовИсходныхДанныхДокумента(Запросы, ДокСсылка);
	
	Возврат Результат;
	
КонецФункции

//{ Функции и процедуры для УПП 1.3

Функция УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры_УПП13(ДокументСсылка, СчетФактура, ФункцияДокумента)

	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанные_РеализацияТоваровУслуг(ДокументСсылка, ФункцияДокумента);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанные_КорректировкаРеализации(ДокументСсылка);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		Результат = УПД970_ИсходныеДанные_ОтчетКомитентуОПродажах(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		
		Результат = УПД970_ИсходныеДанные_ВозвратуТоваровПоставщику(ДокументСсылка, ФункцияДокумента);
		
	ИначеЕсли ЭтоПередачаОС(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанные_ПередачеОС(ДокументСсылка);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанные_АктОбОказанииПроизводственныхУслуг(ДокументСсылка);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПоПереработке") Тогда
		
		Результат = УПД970_ИсходныеДанные_РеализацияУслугПоПереработке(ДокументСсылка);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах") Тогда
		
		Результат = УПД970_ИсходныеДанные_ОтчетКомиссионераОПродажах(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтражениеРеализацииТоваровИУслугНДС") Тогда
		
		Результат = УПД970_ИсходныеДанные_ОтражениеНачисленияНДС(ДокументСсылка);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = Ядро.Общее_ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТипЗнч(ДокументСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьРеквизитыОснованияОтгрузкиТоваровПоСчетФактуре_УПП13(Контент, ДокументыОснования, ДополнительныеПараметры)
	
	ОснованияОтгрузки = Новый Массив;
	Для Каждого ДокументОснования Из ДокументыОснования Цикл
		
		ОснованиеОтгрузки = УПД970_ОснованиеОтгрузкиТоваровПоДокументу_УПП13(ДокументОснования);
		Если ЗначениеЗаполнено(ОснованиеОтгрузки)
			И ОснованияОтгрузки.Найти(ОснованиеОтгрузки) = Неопределено Тогда
			ОснованияОтгрузки.Добавить(ОснованиеОтгрузки);
		КонецЕсли;
		
	КонецЦикла;
	
	РеквизитыОснованийОтгрузки = Новый Массив;
	Для Каждого ОснованиеОтгрузки Из ОснованияОтгрузки Цикл
		
		РеквизитыОснования = УПД970_РеквизитыОснованияОтгрузкиТоваров_УПП13(ОснованиеОтгрузки);
		РеквизитыОснованийОтгрузки.Добавить(РеквизитыОснования);
		
	КонецЦикла;
	
	УПД970_ЗаполнитьСведенияОПередачеТоваров(Контент, РеквизитыОснованийОтгрузки, ДополнительныеПараметры);

КонецПроцедуры

Функция УПД970_ТекстЗапросаДанныхШапкиРеализацииТоваровУслуг_УПП13()
	
	// ПодразделениеОрганизации появилось в УПП 1.3.221
	
	ИмяРеквизитаПодразделениеОрганизации = "ПодразделениеОрганизации";
	ЕстьПодразделениеОрганизации = ЕстьРеквизитОбъектаЛок(
		ИмяРеквизитаПодразделениеОрганизации,
		Метаданные.Документы.РеализацияТоваровУслуг
	);
	
	Результат =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Ссылка КАК Ссылка,
		|	Т.Дата КАК Дата,
		|	Т.ВалютаДокумента КАК ВалютаДокумента,
		|	Т.Организация КАК Организация,
		|	Т.Контрагент КАК Контрагент,
		|	Т.Грузоотправитель КАК Грузоотправитель,
		|	Т.Грузополучатель КАК Грузополучатель,
		|	Т.АдресДоставки КАК АдресДоставки,
		|	Т.Сделка КАК Сделка,
		|	Т.СуммаВключаетНДС КАК СуммаВключаетНДС,
		|	ВЫБОР
		|		КОГДА Т.БанковскийСчетОрганизации = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|			ТОГДА Т.Организация.ОсновнойБанковскийСчет
		|		ИНАЧЕ Т.БанковскийСчетОрганизации
		|	КОНЕЦ КАК БанковскийСчетОрганизации,
		|	Т.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ДоговорыКонтрагентов.Дата КАК ДоговорДата,
		|	ДоговорыКонтрагентов.Номер КАК ДоговорНомер,
		|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах, ЛОЖЬ) КАК РасчетыВУсловныхЕдиницах,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.ВалютаВзаиморасчетов, """") КАК ВалютаВзаиморасчетов,
		|	Т.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
		|	Т.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.РеализацияТоваровОблагаемыхНДСУПокупателя, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
		|	НЕОПРЕДЕЛЕНО КАК ПодразделениеОрганизации
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО Т.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
	
	Если ЕстьПодразделениеОрганизации Тогда
		
		Результат = СтрЗаменить(
				Результат,
				"НЕОПРЕДЕЛЕНО КАК ПодразделениеОрганизации",
				"Т.ПодразделениеОрганизации КАК ПодразделениеОрганизации");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейРеализацииТоваровУслуг_УПП13(ФункцияДокумента)
	
	ЧастиЗапроса = Новый Массив;
	
	ТекстЗапросаТоварыУслуги =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товары"" КАК ВидПоступления,
	|	1 КАК Порядок,
	|	&ТоварыИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Товары.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|			ТОГДА Товары.КодТНВЭД
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка)
	|	КОНЕЦ КАК ТоварКодТНВЭД,
	|	СпрНоменклатура.Код КАК ТоварКод,
	|	СпрНоменклатура.Артикул КАК ТоварАртикул,
	|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Товары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	&СтранаПроисхожденияСсылка КАК СтранаПроисхождения,
	|	&СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	&СтранаПроисхожденияУчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	&НомерГТД КАК НомерГТД,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Сумма КАК Сумма,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ЕстьНДС,
	|	&ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	&ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Товары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Товары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО Товары.СерияНоменклатуры = СерииНоменклатуры.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Услуги"",
	|	3 КАК Порядок,
	|	&УслугиИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""Услуги"" КАК ИмяТабличнойЧасти,
	|	Услуги.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(Услуги.Содержание КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	"""" КАК ТоварКодТНВЭД,
	|	СпрНоменклатура.Код КАК ТоварКод,
	|	СпрНоменклатура.Артикул ТоварАртикул,
	|	НЕОПРЕДЕЛЕНО КАК ХарактеристикаНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
	|	"""" КАК СтранаПроисхожденияКод,
	|	ЛОЖЬ КАК СтранаПроисхожденияУчастникЕАЭС,
	|	СпрНоменклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Представление КАК ЕдиницаИзмеренияНаименование,
	|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод,
	|	"""" КАК НомерГТД,
	|	Услуги.Количество КАК Количество,
	|	Услуги.Цена КАК Цена,
	|	Услуги.СтавкаНДС КАК СтавкаНДС,
	|	Услуги.СуммаНДС КАК СуммаНДС,
	|	Услуги.Сумма КАК Сумма,
	|	Услуги.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА Услуги.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ЕстьНДС,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	ЛОЖЬ КАК ПрослеживаемыйКомплект,
	|	Услуги.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Услуги.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	Услуги.Ссылка = &Ссылка";
	
	МетаданныеТовары = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Товары;
	МетаданныеУслуги = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Услуги;
	
	ВыражениеСтранаСсылка = "ЕСТЬNULL(Товары.СтранаПроисхождения, Товары.СерияНоменклатуры.СтранаПроисхождения)";
	ВыражениеСтранаКод = "ЕСТЬNULL(Товары.СтранаПроисхождения.Код, Товары.СерияНоменклатуры.СтранаПроисхождения.Код)";
	ВыражениеСтранаУчастникЕАЭС = "ЕСТЬNULL(Товары.СтранаПроисхождения.УчастникЕАЭС, Товары.СерияНоменклатуры.СтранаПроисхождения.УчастникЕАЭС)";
	
	Если Не ЕстьРеквизитОбъектаЛок("СтранаПроисхождения", МетаданныеТовары) Тогда // ниже 1.3.182
		ВыражениеСтранаСсылка = "ЕСТЬNULL(Товары.СерияНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка))";
		ВыражениеСтранаКод = "ЕСТЬNULL(Товары.СерияНоменклатуры.СтранаПроисхождения.Код, """")";
		ВыражениеСтранаУчастникЕАЭС = "ЕСТЬNULL(Товары.СерияНоменклатуры.СтранаПроисхождения.УчастникЕАЭС, ЛОЖЬ)";
	КонецЕсли;
	
	Если Не ЕстьРеквизитОбъектаЛок("УчастникЕАЭС", Метаданные.Справочники.КлассификаторСтранМира) Тогда // 1.3.145 и ниже
		ВыражениеСтранаУчастникЕАЭС = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеПрослеживаемыйКомплект = "Товары.ПрослеживаемыйКомплект";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйКомплект", МетаданныеТовары) Тогда
		ВыражениеПрослеживаемыйКомплект = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеПрослеживаемыйТовар = "Товары.ПрослеживаемыйТовар";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйТовар", МетаданныеТовары) Тогда
		ВыражениеПрослеживаемыйТовар = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеТоварыИдентификаторСтроки = "Товары.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеТовары) Тогда
		 // ИдентификаторСтроки в товарах появился с версии 1.3.182
		ВыражениеТоварыИдентификаторСтроки = """""";
	КонецЕсли;
	
	ВыражениеУслугиИдентификаторСтроки = "Услуги.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеУслуги) Тогда
		// ИдентификаторСтроки в услугах появился с версии 1.3.217
		ВыражениеУслугиИдентификаторСтроки = """""";
	КонецЕсли;
	
	ВыражениеНомерГТД = "ВЫБОР
	|		КОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер) = """"
	|			ТОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.Код, СпрНоменклатура.НомерГТД.Код)
	|		ИНАЧЕ ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер)
	|	КОНЕЦ";
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&СтранаПроисхожденияСсылка", ВыражениеСтранаСсылка);
	Замены.Добавить("&СтранаПроисхожденияКод", ВыражениеСтранаКод);
	Замены.Добавить("&СтранаПроисхожденияУчастникЕАЭС", ВыражениеСтранаУчастникЕАЭС);
	Замены.Добавить("&ПрослеживаемыйТовар", ВыражениеПрослеживаемыйТовар);
	Замены.Добавить("&ПрослеживаемыйКомплект", ВыражениеПрослеживаемыйКомплект);
	Замены.Добавить("&ТоварыИдентификаторСтроки", ВыражениеТоварыИдентификаторСтроки);
	Замены.Добавить("&УслугиИдентификаторСтроки", ВыражениеУслугиИдентификаторСтроки);
	Замены.Добавить("&НомерГТД", ВыражениеНомерГТД);
	
	Для Каждого Элемент Из Замены Цикл
		ТекстЗапросаТоварыУслуги = СтрЗаменить(ТекстЗапросаТоварыУслуги, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	ЧастиЗапроса.Добавить(ТекстЗапросаТоварыУслуги);
	
	ДобавитьВозвратнуюТару = (ФункцияДокумента = ФункцияДокументаУПД_ДОП());
	
	Если ДобавитьВозвратнуюТару Тогда
		
		ТекстЗапросаВозвратнаяТара =
		"ВЫБРАТЬ
		|	""ВозвратнаяТара"" КАК ВидПоступления,
		|	2 КАК Порядок,
		|	"""" КАК ИдентификаторСтроки,
		|	""ВозвратнаяТара"" КАК ИмяТабличнойЧасти,
		|	ВозвратнаяТара.Номенклатура КАК Товар,
		|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
		|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
		|	"""" КАК ТоварКодТНВЭД,
		|	СпрНоменклатура.Код КАК ТоварКод,
		|	СпрНоменклатура.Артикул КАК ТоварАртикул,
		|	НЕОПРЕДЕЛЕНО КАК ХарактеристикаНоменклатуры,
		|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
		|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
		|	"""" КАК СтранаПроисхожденияКод,
		|	ЛОЖЬ КАК СтранаПроисхожденияУчастникЕАЭС,
		|	СпрНоменклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Представление КАК ЕдиницаИзмеренияНаименование,
		|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод,
		|	"""" КАК НомерГТД,
		|	ВозвратнаяТара.Количество КАК Количество,
		|	ВозвратнаяТара.Цена КАК Цена,
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
		|	0 КАК СуммаНДС,
		|	ВозвратнаяТара.Сумма КАК Сумма,
		|	ВозвратнаяТара.НомерСтроки КАК НомерСтроки,
		|	0 КАК ЕстьНДС,
		|	ЛОЖЬ КАК ПрослеживаемыйТовар,
		|	ЛОЖЬ КАК ПрослеживаемыйКомплект,
		|	ВозвратнаяТара.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ВозвратнаяТара КАК ВозвратнаяТара
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО ВозвратнаяТара.Номенклатура = СпрНоменклатура.Ссылка
		|ГДЕ
		|	ВозвратнаяТара.Ссылка = &Ссылка";
		
		ЧастиЗапроса.Добавить(ТекстЗапроса_ОбъединитьВсе());
		ЧастиЗапроса.Добавить(ТекстЗапросаВозвратнаяТара);
		
	КонецЕсли;
	
	ТекстЗапросаИтоги = "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Количество),
	|	СУММА(СуммаНДС),
	|	СУММА(Сумма)
	|ПО
	|	ОБЩИЕ";
	
	ЧастиЗапроса.Добавить(ТекстЗапросаИтоги);
	
	Результат = Общее_СоединитьСтроку(ЧастиЗапроса, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхПрослеживаемостиРеализацииТоваровУслуг_УПП13()
	
	ОбъектМетаданных = Метаданные.Документы.РеализацияТоваровУслуг;
	Результат = УПД970_ТекстЗапросаСведенийОПрослеживаемостиОбщее_УПП13(ОбъектМетаданных);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиКорректировкиРеализации_УПП13()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Дата КАК Дата,
	|	Т.ВалютаДокумента КАК ВалютаДокумента,
	|	Т.Организация КАК Организация,
	|	Т.Контрагент КАК Контрагент,
	|	Т.Грузоотправитель КАК Грузоотправитель,
	|	Т.Грузополучатель КАК Грузополучатель,
	|	Т.АдресДоставки КАК АдресДоставки,
	|	Т.Сделка КАК Сделка,
	|	Т.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВЫБОР
	|		КОГДА Т.БанковскийСчетОрганизации = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА Т.Организация.ОсновнойБанковскийСчет
	|		ИНАЧЕ Т.БанковскийСчетОрганизации
	|	КОНЕЦ КАК БанковскийСчетОрганизации,
	|	Т.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыКонтрагентов.Дата КАК ДоговорДата,
	|	ДоговорыКонтрагентов.Номер КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах, ЛОЖЬ) КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВалютаВзаиморасчетов, """") КАК ВалютаВзаиморасчетов,
	|	Т.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	Т.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РеализацияТоваровОблагаемыхНДСУПокупателя, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Т.ПодразделениеОрганизации КАК ПодразделениеОрганизации
	|ИЗ
	|	Документ.КорректировкаРеализации КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО Т.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	Т.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейКорректировкиРеализации_УПП13()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товары"" КАК ВидПоступления,
	|	&ТоварыИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Товары.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|			ТОГДА Товары.КодТНВЭД
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка)
	|	КОНЕЦ КАК ТоварКодТНВЭД,
	|	СпрНоменклатура.Код КАК ТоварКод,
	|	СпрНоменклатура.Артикул КАК ТоварАртикул,
	|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Товары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	&СтранаПроисхожденияСсылка КАК СтранаПроисхождения,
	|	&СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	&СтранаПроисхожденияУчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	&НомерГТД КАК НомерГТД,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Сумма КАК Сумма,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ЕстьНДС,
	|	&ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	&ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Товары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМира
	|		ПО СпрНоменклатура.СтранаПроисхождения = КлассификаторСтранМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Товары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО Товары.СерияНоменклатуры = СерииНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираСерии
	|		ПО СерииНоменклатуры.СтранаПроисхождения = КлассификаторСтранМираСерии.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираТовары
	|		ПО Товары.СтранаПроисхождения = КлассификаторСтранМираТовары.Ссылка
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Услуги"",
	|	&УслугиИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""Услуги"" КАК ИмяТабличнойЧасти,
	|	Услуги.Номенклатура,
	|	ВЫРАЗИТЬ(Услуги.Содержание КАК СТРОКА(1000)),
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)),
	|	"""",
	|	СпрНоменклатура.Код,
	|	СпрНоменклатура.Артикул,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	"""",
	|	ЛОЖЬ,
	|	СпрНоменклатура.БазоваяЕдиницаИзмерения,
	|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Представление,
	|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Код,
	|	НЕОПРЕДЕЛЕНО,
	|	Услуги.Количество,
	|	Услуги.Цена,
	|	Услуги.СтавкаНДС,
	|	Услуги.СуммаНДС,
	|	Услуги.Сумма,
	|	Услуги.НомерСтроки,
	|	ВЫБОР
	|		КОГДА Услуги.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	Услуги.Ссылка
	|ИЗ
	|	Документ.КорректировкаРеализации.Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Услуги.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	Услуги.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидПоступления,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Количество),
	|	СУММА(СуммаНДС),
	|	СУММА(Сумма)
	|ПО
	|	ОБЩИЕ";
	
	МетаданныеТовары = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Товары;
	МетаданныеУслуги = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Услуги;
	
	ВыражениеПрослеживаемыйКомплект = "Товары.ПрослеживаемыйКомплект";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйКомплект", МетаданныеТовары) Тогда
		ВыражениеПрослеживаемыйКомплект = "ЛОЖЬ"; // 1.3.188 и ниже
	КонецЕсли;
	
	ВыражениеСтранаСсылка = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА СерииНоменклатуры.СтранаПроисхождения
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА Товары.СтранаПроисхождения
	|		ИНАЧЕ СпрНоменклатура.СтранаПроисхождения
	|	КОНЕЦ";
	ВыражениеСтранаКод = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираСерии.Код
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираТовары.Код
	|		ИНАЧЕ КлассификаторСтранМира.Код
	|	КОНЕЦ";
	ВыражениеСтранаУчастникЕАЭС = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираСерии.УчастникЕАЭС
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираТовары.УчастникЕАЭС
	|		ИНАЧЕ КлассификаторСтранМира.УчастникЕАЭС
	|	КОНЕЦ";
	
	Если Не ЕстьРеквизитОбъектаЛок("СтранаПроисхождения", МетаданныеТовары) Тогда // ниже 1.3.182
		ВыражениеСтранаСсылка = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения, СпрНоменклатура.СтранаПроисхождения)";
		ВыражениеСтранаКод = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения.Код, КлассификаторСтранМира.Код)";
		ВыражениеСтранаУчастникЕАЭС = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения.УчастникЕАЭС, КлассификаторСтранМира.УчастникЕАЭС)";
	КонецЕсли;
	
	Если Не ЕстьРеквизитОбъектаЛок("УчастникЕАЭС", Метаданные.Справочники.КлассификаторСтранМира) Тогда // 1.3.145 и ниже
		ВыражениеСтранаУчастникЕАЭС = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеПрослеживаемыйТовар = "Товары.ПрослеживаемыйТовар";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйТовар", МетаданныеТовары) Тогда
		// ПрослеживаемыйТовар в товарах появился с версии 1.3.182
		ВыражениеПрослеживаемыйТовар = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеТоварыИдентификаторСтроки = "Товары.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеТовары) Тогда
		// ИдентификаторСтроки в товарах появился с версии 1.3.182
		ВыражениеТоварыИдентификаторСтроки = """""";
	КонецЕсли;
	
	ВыражениеУслугиИдентификаторСтроки = "Услуги.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеУслуги) Тогда
		// ИдентификаторСтроки в услугах появился с версии 1.3.217
		ВыражениеУслугиИдентификаторСтроки = """""";
	КонецЕсли;
	
	ВыражениеНомерГТД = "ВЫБОР
	|		КОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер) = """"
	|			ТОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.Код, СпрНоменклатура.НомерГТД.Код)
	|		ИНАЧЕ ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер)
	|	КОНЕЦ";
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&ПрослеживаемыйКомплект", ВыражениеПрослеживаемыйКомплект);
	Замены.Добавить("&ПрослеживаемыйТовар", ВыражениеПрослеживаемыйТовар);
	Замены.Добавить("&СтранаПроисхожденияСсылка", ВыражениеСтранаСсылка);
	Замены.Добавить("&СтранаПроисхожденияКод", ВыражениеСтранаКод);
	Замены.Добавить("&СтранаПроисхожденияУчастникЕАЭС", ВыражениеСтранаУчастникЕАЭС);
	Замены.Добавить("&ТоварыИдентификаторСтроки", ВыражениеТоварыИдентификаторСтроки);
	Замены.Добавить("&УслугиИдентификаторСтроки", ВыражениеУслугиИдентификаторСтроки);
	Замены.Добавить("&НомерГТД", ВыражениеНомерГТД);
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхПрослеживаемостиКорректировкиРеализации_УПП13()
	
	ОбъектМетаданных = Метаданные.Документы.КорректировкаРеализации;
	
	Пустышка =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	0 КАК КоличествоПрослеживаемости,
	|	"""""""" КАК ИдентификаторСтроки,
	|	0 КАК Сумма,
	|	"""""""" КАК ЕдиницаИзмеренияКод,
	|	"""""""" КАК ЕдиницаИзмеренияНаименование,
	|	"""""""" КАК НомерРНПТ";
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(Пустышка);
	
	Замены = Новый СписокЗначений;
	
	МетаданныеТЧ = ОбъектМетаданных.ТабличныеЧасти.Найти("СведенияПрослеживаемости");
	
	Если МетаданныеТЧ <> Неопределено Тогда // 1.3.182 и выше
		
		ОсновнойЗапрос =
		"ВЫБРАТЬ
		|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	&ВыражениеСумма КАК Сумма,
		|	&ВыражениеЕдИзмКод КАК ЕдиницаИзмеренияКод,
		|	&ВыражениеЕдИзмНаименование КАК ЕдиницаИзмеренияНаименование,
		|	НомераГТД.Код КАК НомерРНПТ
		|ИЗ
		|	Документ.КорректировкаРеализации.СведенияПрослеживаемости КАК СведенияПрослеживаемости
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
		|		ПО СведенияПрослеживаемости.РНПТ = НомераГТД.Ссылка
		|ГДЕ
		|	СведенияПрослеживаемости.Ссылка = &Ссылка
		|	&ВыражениеЭтоСтрокаСИсходнымиРНПТ";
		
		ВыражениеСумма = "СведенияПрослеживаемости.Сумма";
		Если Не ЕстьРеквизитОбъектаЛок("Сумма", МетаданныеТЧ) Тогда // 1.3.188 и ниже
			ВыражениеСумма = "0";
		КонецЕсли;
		
		ВыражениеЕдИзмКод =
		"ВЫБОР
		|	КОГДА СведенияПрослеживаемости.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА СведенияПрослеживаемости.Номенклатура.БазоваяЕдиницаИзмерения.Код
		|	ИНАЧЕ ""796""
		|КОНЕЦ";
		
		ВыражениеЕдИзмНаименование =
		"ВЫБОР
		|	КОГДА СведенияПрослеживаемости.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА СведенияПрослеживаемости.Номенклатура.БазоваяЕдиницаИзмерения.Наименование
		|	ИНАЧЕ ""шт""
		|КОНЕЦ";
		
		Если Не ЕстьРеквизитОбъектаЛок("Номенклатура", МетаданныеТЧ) Тогда // 1.3.188 и ниже
			ВыражениеЕдИзмКод = """796""";
			ВыражениеЕдИзмНаименование = """шт""";
		КонецЕсли;
		
		ВыражениеЭтоСтрокаСИсходнымиРНПТ = "И НЕ СведенияПрослеживаемости.ЭтоСтрокаСИсходнымиРНПТ";
		
		Если НЕ ЕстьРеквизитОбъектаЛок("ЭтоСтрокаСИсходнымиРНПТ", МетаданныеТЧ) Тогда // 1.3.188 и ниже
			ВыражениеЭтоСтрокаСИсходнымиРНПТ = "";
		КонецЕсли;
		
		Замены.Добавить("&ВыражениеСумма", ВыражениеСумма);
		Замены.Добавить("&ВыражениеЕдИзмКод", ВыражениеЕдИзмКод);
		Замены.Добавить("&ВыражениеЕдИзмНаименование", ВыражениеЕдИзмНаименование);
		Замены.Добавить("&ВыражениеЭтоСтрокаСИсходнымиРНПТ", ВыражениеЭтоСтрокаСИсходнымиРНПТ);
		
		ЧастиЗапроса.Добавить(ОсновнойЗапрос);
		
	КонецЕсли;
	
	Результат = Общее_СоединитьСтроку(ЧастиЗапроса, ТекстЗапроса_ОбъединитьВсе());
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиВозвратаТоваровПоставщику_УПП13()

	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВозвратТоваровПоставщику.Ссылка КАК Ссылка,
	|	ВозвратТоваровПоставщику.Номер КАК Номер,
	|	ВозвратТоваровПоставщику.Дата КАК Дата,
	|	ВозвратТоваровПоставщику.Организация КАК Организация,
	|	ВозвратТоваровПоставщику.Сделка КАК Сделка,
	|	ВозвратТоваровПоставщику.Подразделение КАК Подразделение,
	|	ВозвратТоваровПоставщику.Контрагент КАК Контрагент,
	|	ВозвратТоваровПоставщику.ВалютаДокумента КАК ВалютаДокумента,
	|	ВозвратТоваровПоставщику.УчитыватьНДС КАК УчитыватьНДС,
	|	ВозвратТоваровПоставщику.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВозвратТоваровПоставщику.СуммаДокумента КАК СуммаДокумента,
	|	ВозвратТоваровПоставщику.Ответственный КАК Ответственный,
	|	ВозвратТоваровПоставщику.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
	|	ВозвратТоваровПоставщику.Грузоотправитель КАК Грузоотправитель,
	|	ВозвратТоваровПоставщику.Грузополучатель КАК Грузополучатель,
	|	НЕОПРЕДЕЛЕНО КАК АдресДоставки,
	|	Валюты.Код КАК ВалютаКод,
	|	Валюты.НаименованиеПолное КАК ВалютаНаименованиеПолное,
	|	ВозвратТоваровПоставщику.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыКонтрагентов.Дата КАК ДоговорДата,
	|	ДоговорыКонтрагентов.Номер КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах, ЛОЖЬ) КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВалютаВзаиморасчетов, """") КАК ВалютаВзаиморасчетов,
	|	ВозвратТоваровПоставщику.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	ВозвратТоваровПоставщику.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РеализацияТоваровОблагаемыхНДСУПокупателя, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	ВЫБОР
	|		КОГДА ВозвратТоваровПоставщику.БанковскийСчетОрганизации = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА Организации.ОсновнойБанковскийСчет
	|		ИНАЧЕ ВозвратТоваровПоставщику.БанковскийСчетОрганизации
	|	КОНЕЦ КАК БанковскийСчетОрганизации,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеОрганизации
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику КАК ВозвратТоваровПоставщику
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ВозвратТоваровПоставщику.ВалютаДокумента = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ВозвратТоваровПоставщику.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ВозвратТоваровПоставщику.Организация = Организации.Ссылка
	|ГДЕ
	|	ВозвратТоваровПоставщику.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейВозвратаТоваровПоставщику_УПП13(ФункцияДокумента)
	
	ЧастиЗапроса = Новый Массив;
	
	ТекстЗапросаТоварыОборудование =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товары"" КАК ВидПоступления,
	|	1 КАК Порядок,
	|	Товары.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	СпрНоменклатура.Код КАК ТоварКод,
	|	СпрНоменклатура.Артикул КАК ТоварАртикул,
	|	&СтранаПроисхожденияСсылка КАК СтранаПроисхождения,
	|	&СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	&СтранаПроисхожденияУчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.Сумма КАК Сумма,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Ссылка КАК Ссылка,
	|	&ТоварыИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	&ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	&ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Товары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	&НомерГТД КАК НомерГТД
	|
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Товары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМира
	|		ПО (СпрНоменклатура.СтранаПроисхождения = КлассификаторСтранМира.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Товары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО Товары.СерияНоменклатуры = СерииНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираСерии
	|		ПО СерииНоменклатуры.СтранаПроисхождения = КлассификаторСтранМираСерии.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираТовары
	|		ПО Товары.СтранаПроисхождения = КлассификаторСтранМираТовары.Ссылка
	|
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Оборудование"",
	|	2,
	|	Оборудование.Номенклатура,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)),
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)),
	|	СпрНоменклатура.Код,
	|	СпрНоменклатура.Артикул,
	|	НЕОПРЕДЕЛЕНО,
	|	"""",
	|	ЛОЖЬ,
	|	Оборудование.ЕдиницаИзмерения,
	|	Оборудование.Количество,
	|	Оборудование.Цена,
	|	Оборудование.СтавкаНДС,
	|	Оборудование.СуммаНДС,
	|	Оборудование.Сумма,
	|	Оборудование.НомерСтроки,
	|	Оборудование.Ссылка,
	|	НЕОПРЕДЕЛЕНО,
	|	""Оборудование"",
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	НЕОПРЕДЕЛЕНО,
	|	НЕОПРЕДЕЛЕНО,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код,
	|	""""
	|
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Оборудование КАК Оборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Оборудование.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Оборудование.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|
	|ГДЕ
	|	Оборудование.Ссылка = &Ссылка";
	
	МетаданныеТовары = Метаданные.Документы.ВозвратТоваровПоставщику.ТабличныеЧасти.Товары;
	
	ВыражениеПрослеживаемыйКомплект = "Товары.ПрослеживаемыйКомплект";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйКомплект", МетаданныеТовары) Тогда
		ВыражениеПрослеживаемыйКомплект = "ЛОЖЬ"; // 1.3.188 и ниже
	КонецЕсли;
	
	ВыражениеСтранаСсылка = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА СерииНоменклатуры.СтранаПроисхождения
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА Товары.СтранаПроисхождения
	|		ИНАЧЕ СпрНоменклатура.СтранаПроисхождения
	|	КОНЕЦ";
	ВыражениеСтранаКод = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираСерии.Код
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираТовары.Код
	|		ИНАЧЕ КлассификаторСтранМира.Код
	|	КОНЕЦ";
	ВыражениеСтранаУчастникЕАЭС = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираСерии.УчастникЕАЭС
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираТовары.УчастникЕАЭС
	|		ИНАЧЕ КлассификаторСтранМира.УчастникЕАЭС
	|	КОНЕЦ";
	
	Если Не ЕстьРеквизитОбъектаЛок("СтранаПроисхождения", МетаданныеТовары) Тогда // ниже 1.3.182
		ВыражениеСтранаСсылка = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения, СпрНоменклатура.СтранаПроисхождения)";
		ВыражениеСтранаКод = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения.Код, КлассификаторСтранМира.Код)";
		ВыражениеСтранаУчастникЕАЭС = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения.УчастникЕАЭС, КлассификаторСтранМира.УчастникЕАЭС)";
	КонецЕсли;
	
	Если Не ЕстьРеквизитОбъектаЛок("УчастникЕАЭС", Метаданные.Справочники.КлассификаторСтранМира) Тогда // 1.3.145 и ниже
		ВыражениеСтранаУчастникЕАЭС = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеПрослеживаемыйТовар = "Товары.ПрослеживаемыйТовар";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйТовар", МетаданныеТовары) Тогда
		// ПрослеживаемыйТовар в товарах появился с версии 1.3.182
		ВыражениеПрослеживаемыйТовар = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеТоварыИдентификаторСтроки = "Товары.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеТовары) Тогда
		// ИдентификаторСтроки в товарах появился с версии 1.3.182
		ВыражениеТоварыИдентификаторСтроки = """""";
	КонецЕсли;
	
	ВыражениеНомерГТД = "ВЫБОР
	|		КОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер) = """"
	|			ТОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.Код, СпрНоменклатура.НомерГТД.Код)
	|		ИНАЧЕ ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер)
	|	КОНЕЦ";
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&ПрослеживаемыйКомплект", ВыражениеПрослеживаемыйКомплект);
	Замены.Добавить("&СтранаПроисхожденияСсылка", ВыражениеСтранаСсылка);
	Замены.Добавить("&СтранаПроисхожденияКод", ВыражениеСтранаКод);
	Замены.Добавить("&СтранаПроисхожденияУчастникЕАЭС", ВыражениеСтранаУчастникЕАЭС);
	Замены.Добавить("&ПрослеживаемыйТовар", ВыражениеПрослеживаемыйТовар);
	Замены.Добавить("&ТоварыИдентификаторСтроки", ВыражениеТоварыИдентификаторСтроки);
	Замены.Добавить("&НомерГТД", ВыражениеНомерГТД);
	
	Для Каждого Элемент Из Замены Цикл
		ТекстЗапросаТоварыОборудование = СтрЗаменить(
			ТекстЗапросаТоварыОборудование,
			Элемент.Значение,
			Элемент.Представление);
	КонецЦикла;
	
	ЧастиЗапроса.Добавить(ТекстЗапросаТоварыОборудование);
	
	ДобавитьВозвратнуюТару = (ФункцияДокумента = ФункцияДокументаУПД_ДОП());
	
	Если ДобавитьВозвратнуюТару Тогда
		
		ТекстЗапросаВозвратнаяТара =
		"ВЫБРАТЬ
		|	""ВозвратнаяТара"" КАК ВидПоступления,
		|	3 КАК Порядок,
		|	ВозвратнаяТара.Номенклатура КАК Товар,
		|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
		|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
		|	СпрНоменклатура.Код КАК ТоварКод,
		|	СпрНоменклатура.Артикул КАК ТоварАртикул,
		|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
		|	"""" КАК СтранаПроисхожденияКод,
		|	ЛОЖЬ КАК СтранаПроисхожденияУчастникЕАЭС,
		|	НЕОПРЕДЕЛЕНО КАК ЕдиницаИзмерения,
		|	ВозвратнаяТара.Количество КАК Количество,
		|	ВозвратнаяТара.Цена КАК Цена,
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС) КАК СтавкаНДС,
		|	0 КАК СуммаНДС,
		|	ВозвратнаяТара.Сумма КАК Сумма,
		|	ВозвратнаяТара.НомерСтроки КАК НомерСтроки,
		|	ВозвратнаяТара.Ссылка КАК Ссылка,
		|	ВозвратнаяТара.НомерСтроки КАК ИдентификаторСтроки,
		|	""ВозвратнаяТара"" КАК ИмяТабличнойЧасти,
		|	ЛОЖЬ КАК ПрослеживаемыйТовар,
		|	ЛОЖЬ КАК ПрослеживаемыйКомплект,
		|	НЕОПРЕДЕЛЕНО КАК ХарактеристикаНоменклатуры,
		|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
		|	СпрНоменклатура.БазоваяЕдиницаИзмерения.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
		|	СпрНоменклатура.БазоваяЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод,
		|	"""" КАК НомерГТД
		|
		|ИЗ
		|	Документ.ВозвратТоваровПоставщику.ВозвратнаяТара КАК ВозвратнаяТара
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		|		ПО ВозвратнаяТара.Номенклатура = СпрНоменклатура.Ссылка
		|
		|ГДЕ
		|	ВозвратнаяТара.Ссылка = &Ссылка";
		
		ЧастиЗапроса.Добавить(ТекстЗапроса_ОбъединитьВсе());
		ЧастиЗапроса.Добавить(ТекстЗапросаВозвратнаяТара);
		
	КонецЕсли;
	
	ТекстЗапросаИтоги = "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Количество),
	|	СУММА(СуммаНДС),
	|	СУММА(Сумма)
	|ПО
	|	ОБЩИЕ";
	
	ЧастиЗапроса.Добавить(ТекстЗапросаИтоги);
	
	Результат = Общее_СоединитьСтроку(ЧастиЗапроса, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхПрослеживаемостиВозвратаТоваровПоставщику_УПП13()

	ОбъектМетаданных = Метаданные.Документы.ВозвратТоваровПоставщику;
	Результат = УПД970_ТекстЗапросаСведенийОПрослеживаемостиОбщее_УПП13(ОбъектМетаданных);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиПередачиОС_УПП13()

	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПередачаОС.Ссылка КАК Ссылка,
	|	ПередачаОС.Номер КАК Номер,
	|	ПередачаОС.Дата КАК Дата,
