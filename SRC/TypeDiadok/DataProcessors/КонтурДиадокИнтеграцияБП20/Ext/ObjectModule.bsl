	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионераОПродажах.Покупатели КАК ОтчетКомиссионераОПродажахПокупатели
	|		ПО ОтчетКомиссионераОПродажах.Ссылка = ОтчетКомиссионераОПродажахПокупатели.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ОтчетКомиссионераОПродажах.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ОтчетКомиссионераОПродажах.Организация = Организации.Ссылка
	|ГДЕ
	|	ОтчетКомиссионераОПродажах.Ссылка = &ДокСсылка
	|	И ОтчетКомиссионераОПродажахПокупатели.СчетФактура = &СчетФактура";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличнойЧастиОтчетаКомиссионераОПродажах_УПП13()

	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товары"" КАК ВидПоступления,
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	&ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Товары.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА Товары.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС0)
	|			ТОГДА Товары.КодТНВЭД
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка)
	|	КОНЕЦ КАК ТоварКодТНВЭД,
	|	СпрНоменклатура.Код КАК ТоварКод,
	|	СпрНоменклатура.Артикул КАК ТоварАртикул,
	|	&СтранаПроисхожденияСсылка КАК СтранаПроисхождения,
	|	&СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	&СтранаПроисхожденияУчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	&НомерГТД КАК НомерГТД,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма,
	|	Товары.СтавкаНДС КАК СтавкаНДС,
	|	Товары.СуммаНДС КАК СуммаНДС,
	|	Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	Товары.СерияНоменклатуры КАК СерияНоменклатуры,
	|	Товары.КодТНВЭД КАК КодТНВЭД,
	|	&ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	&ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект
	|ИЗ
	|	Документ.ОтчетКомиссионераОПродажах.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Товары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМира
	|		ПО СпрНоменклатура.СтранаПроисхождения = КлассификаторСтранМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираТовары
	|		ПО Товары.СтранаПроисхождения = КлассификаторСтранМираТовары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО Товары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|		ПО Товары.СерияНоменклатуры = СерииНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираСерии
	|		ПО СерииНоменклатуры.СтранаПроисхождения = КлассификаторСтранМираСерии.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионераОПродажах.Покупатели КАК Покупатели
	|		ПО Товары.Ссылка = Покупатели.Ссылка
	|			И Товары.КлючСтроки = Покупатели.КлючСтроки
	|ГДЕ
	|	Товары.Ссылка = &ДокСсылка
	|	И Покупатели.СчетФактура = &СчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидПоступления,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Количество),
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС)
	|ПО
	|	ОБЩИЕ";
	
	МетаданныеТовары = Метаданные.Документы.ОтчетКомиссионераОПродажах.ТабличныеЧасти.Товары;
	
	ВыражениеПрослеживаемыйКомплект = "Товары.ПрослеживаемыйКомплект";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйКомплект", МетаданныеТовары) Тогда
		ВыражениеПрослеживаемыйКомплект = "ЛОЖЬ"; // 1.3.194 и ниже
	КонецЕсли;
	
	ВыражениеПрослеживаемыйТовар = "Товары.ПрослеживаемыйТовар";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйТовар", МетаданныеТовары) Тогда
		// ПрослеживаемыйТовар в товарах появился с версии 1.3.182
		ВыражениеПрослеживаемыйТовар = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеИдентификаторСтроки = "Товары.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеТовары) Тогда
		 // ИдентификаторСтроки в товарах появился с версии 1.3.182
		ВыражениеИдентификаторСтроки = """""";
	КонецЕсли;
	
	ВыражениеСтранаСсылка = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА СерииНоменклатуры.СтранаПроисхождения
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА Товары.СтранаПроисхождения
	|		ИНАЧЕ СпрНоменклатура.СтранаПроисхождения
	|	КОНЕЦ";
	ВыражениеСтранаКод = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираСерии.Код
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираТовары.Код
	|		ИНАЧЕ КлассификаторСтранМира.Код
	|	КОНЕЦ";
	ВыражениеСтранаУчастникЕАЭС = "ВЫБОР
	|		КОГДА ЕСТЬNULL(СерииНоменклатуры.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираСерии.УчастникЕАЭС
	|		КОГДА Товары.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираТовары.УчастникЕАЭС
	|		ИНАЧЕ КлассификаторСтранМира.УчастникЕАЭС
	|	КОНЕЦ";
	
	Если Не ЕстьРеквизитОбъектаЛок("СтранаПроисхождения", МетаданныеТовары) Тогда // ниже 1.3.182
		ВыражениеСтранаСсылка = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения, СпрНоменклатура.СтранаПроисхождения)";
		ВыражениеСтранаКод = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения.Код, КлассификаторСтранМира.Код)";
		ВыражениеСтранаУчастникЕАЭС = "ЕСТЬNULL(СерияНоменклатуры.СтранаПроисхождения.УчастникЕАЭС, КлассификаторСтранМира.УчастникЕАЭС)";
	КонецЕсли;
	
	Если Не ЕстьРеквизитОбъектаЛок("УчастникЕАЭС", Метаданные.Справочники.КлассификаторСтранМира) Тогда // 1.3.145 и ниже
		ВыражениеСтранаУчастникЕАЭС = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеНомерГТД = "ВЫБОР
	|		КОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер) = """"
	|			ТОГДА  ЕСТЬNULL(СерииНоменклатуры.НомерГТД.Код, СпрНоменклатура.НомерГТД.Код)
	|		ИНАЧЕ ЕСТЬNULL(СерииНоменклатуры.НомерГТД.РегистрационныйНомер, СпрНоменклатура.НомерГТД.РегистрационныйНомер)
	|	КОНЕЦ";

	Замены = Новый СписокЗначений;
	Замены.Добавить("&ПрослеживаемыйКомплект", ВыражениеПрослеживаемыйКомплект);
	Замены.Добавить("&СтранаПроисхожденияСсылка", ВыражениеСтранаСсылка);
	Замены.Добавить("&СтранаПроисхожденияКод", ВыражениеСтранаКод);
	Замены.Добавить("&СтранаПроисхожденияУчастникЕАЭС", ВыражениеСтранаУчастникЕАЭС);
	Замены.Добавить("&ПрослеживаемыйТовар", ВыражениеПрослеживаемыйТовар);
	Замены.Добавить("&ИдентификаторСтроки", ВыражениеИдентификаторСтроки);
	Замены.Добавить("&НомерГТД", ВыражениеНомерГТД);
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция УПД970_ТекстЗапросаДанныхПрослеживаемостиОтчетаКомиссионераОПродажах_УПП13()

	Пустышка =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	0 КАК КоличествоПрослеживаемости,
	|	"""""""" КАК ИдентификаторСтроки,
	|	0 КАК Сумма,
	|	"""""""" КАК ЕдиницаИзмеренияКод,
	|	"""""""" КАК ЕдиницаИзмеренияНаименование,
	|	"""""""" КАК НомерРНПТ";
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(Пустышка);
	
	Замены = Новый СписокЗначений;
	
	МетаданныеТЧ = Метаданные.Документы.ОтчетКомиссионераОПродажах.ТабличныеЧасти.Найти("СведенияПрослеживаемости");
	
	Если МетаданныеТЧ <> Неопределено Тогда // 1.3.182 и выше
		
		ОсновнойЗапрос =
		"ВЫБРАТЬ
		|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	&ВыражениеСумма КАК Сумма,
		|	&ВыражениеЕдИзмКод КАК ЕдиницаИзмеренияКод,
		|	&ВыражениеЕдИзмНаименование КАК ЕдиницаИзмеренияНаименование,
		|	НомераГТД.Код КАК НомерРНПТ
		|ИЗ
		|	Документ.ОтчетКомиссионераОПродажах.СведенияПрослеживаемости КАК СведенияПрослеживаемости
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
		|		ПО СведенияПрослеживаемости.РНПТ = НомераГТД.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремИдентификаторыСтрока КАК ВремИдентификаторыСтрока
		|		ПО СведенияПрослеживаемости.ИдентификаторСтроки = ВремИдентификаторыСтрока.ИдентификаторСтроки
		|ГДЕ
		|	СведенияПрослеживаемости.Ссылка = &ДокСсылка";
		
		ВыражениеСумма = "СведенияПрослеживаемости.Сумма";
		Если Не ЕстьРеквизитОбъектаЛок("Сумма", МетаданныеТЧ) Тогда // 1.3.194 и ниже
			ВыражениеСумма = "0";
		КонецЕсли;
		
		ВыражениеЕдИзмКод =
		"ВЫБОР
		|	КОГДА СведенияПрослеживаемости.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА СведенияПрослеживаемости.Номенклатура.БазоваяЕдиницаИзмерения.Код
		|	ИНАЧЕ ""796""
		|КОНЕЦ";
		
		ВыражениеЕдИзмНаименование =
		"ВЫБОР
		|	КОГДА СведенияПрослеживаемости.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА СведенияПрослеживаемости.Номенклатура.БазоваяЕдиницаИзмерения.Наименование
		|	ИНАЧЕ ""шт""
		|КОНЕЦ";
		
		Если Не ЕстьРеквизитОбъектаЛок("Номенклатура", МетаданныеТЧ) Тогда // 1.3.194 и ниже
			ВыражениеЕдИзмКод = """796""";
			ВыражениеЕдИзмНаименование = """шт""";
		КонецЕсли;
		
		Замены.Добавить("&ВыражениеСумма", ВыражениеСумма);
		Замены.Добавить("&ВыражениеЕдИзмКод", ВыражениеЕдИзмКод);
		Замены.Добавить("&ВыражениеЕдИзмНаименование", ВыражениеЕдИзмНаименование);
		
		ЧастиЗапроса.Добавить(ОсновнойЗапрос);
		
	КонецЕсли;
	
	Результат = Общее_СоединитьСтроку(ЧастиЗапроса, ТекстЗапроса_ОбъединитьВсе());
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ТоварыИдентификаторСтроки
	|ПОМЕСТИТЬ ВремИдентификаторыСтрока
	|ИЗ
	|	Документ.ОтчетКомиссионераОПродажах.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионераОПродажах.Покупатели КАК Покупатели
	|		ПО Товары.Ссылка = Покупатели.Ссылка
	|			И Товары.КлючСтроки = Покупатели.КлючСтроки
	|ГДЕ
	|	Товары.Ссылка = &ДокСсылка
	|	И Покупатели.СчетФактура = &СчетФактура
	|;
	|" + Результат;
	
	МетаданныеТовары = Метаданные.Документы.ОтчетКомиссионераОПродажах.ТабличныеЧасти.Товары;
	
	ВыражениеТоварыИдентификаторСтроки = "Товары.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеТовары) Тогда
		// ИдентификаторСтроки в товарах появился с версии 1.3.182
		ВыражениеТоварыИдентификаторСтроки = """""";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&ТоварыИдентификаторСтроки", ВыражениеТоварыИдентификаторСтроки);
	
	Возврат Результат;

КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиПеремещенияТоваров_УПП13()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Организация.НаименованиеПолное КАК ОрганизацияПредставление,
	|	Шапка.Организация.ИНН КАК ОрганизацияИНН,
