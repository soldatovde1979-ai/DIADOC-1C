Процедура УПД970_АдаптироватьПоляСтруктурыАдресов(СведенияОбАдресе)
	
	Если ТипЗнч(СведенияОбАдресе.Страна) <> Тип("Строка") Тогда
		СведенияОбАдресе.Страна = НРег(XMLСтрока(СведенияОбАдресе.Страна));
	КонецЕсли;
	
	Если ТипЗнч(СведенияОбАдресе.ТипДома) <> Тип("Строка") Тогда
		СведенияОбАдресе.ТипДома = НРег(XMLСтрока(СведенияОбАдресе.ТипДома));
	КонецЕсли;
	
	Если ТипЗнч(СведенияОбАдресе.ТипКвартиры) <> Тип("Строка") Тогда
		СведенияОбАдресе.ТипКвартиры = НРег(XMLСтрока(СведенияОбАдресе.ТипКвартиры));
	КонецЕсли;
	
	Если ТипЗнч(СведенияОбАдресе.ТипКорпуса) <> Тип("Строка") Тогда
		СведенияОбАдресе.ТипКорпуса = НРег(XMLСтрока(СведенияОбАдресе.ТипКорпуса));
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ПолучитьАдресИзКонтактнойИнформации(Ссылка, ВидАдреса = Неопределено)
	
	Результат = Неопределено;
	
	РезультатЗапроса = УПД970_СведенияОбАдресеИзКонтактнойИнформацииОбъекта(Ссылка, ВидАдреса);

	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		
		Результат = НоваяЗаписьКонтактнойИнформации();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
		ЗаполнитьТипЗданияКорпусаПомещения(Результат);
		
		Если ЗначениеЗаполнено(Результат.Значение) Тогда
			ДополнитьКонтактнуюИнформациюДаннымиJson(Результат, Выборка.Значение, Выборка.Тип);
		КонецЕсли;
		
		УПД970_АдаптироватьПоляСтруктурыАдресов(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ПолучитьАдресИзПредставленияАдреса(Ссылка, ПредставлениеАдреса)
	
	Результат = Неопределено;
	
	РезультатЗапроса = УПД970_СведенияОбАдресеПоПредставлениюИзИБ(Ссылка, ПредставлениеАдреса);
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		
		Результат = НоваяЗаписьКонтактнойИнформации();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
		ЗаполнитьТипЗданияКорпусаПомещения(Результат);
		
		Если ЗначениеЗаполнено(Результат.Значение) Тогда
			ДополнитьКонтактнуюИнформациюДаннымиJson(Результат, Выборка.Значение, Выборка.Тип);
		КонецЕсли;
		
		УПД970_АдаптироватьПоляСтруктурыАдресов(Результат);
		
	КонецЕсли;
	
	Если Результат = Неопределено Тогда
		
		Результат = НоваяЗаписьКонтактнойИнформации();
		Результат.Представление = ПредставлениеАдреса;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДополнитьСведенияОбАдресеОсновнойСтраной(Результат)
	
	Если НЕ ЗначениеЗаполнено(Результат.КодСтраны)
		И НЕ ЗначениеЗаполнено(Результат.Страна) Тогда
		
		Результат.КодСтраны = ОсновнаяСтрана().Код;
		Результат.Страна = ОсновнаяСтрана().Наименование;
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_СведенияОбАдресеИзКонтактнойИнформацииОбъекта(Ссылка, ВидАдреса)
	
	Перем ВидКИ;
	
	ВладелецКИ = ХранилищеКонтактнойИнформацииОбъекта(Ссылка);
	
	Если ВидАдреса <> Неопределено Тогда
		ВидКИ = ВидАдресаЮрФизЛица(Ссылка, ВидАдреса);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ВладелецКИ);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("Вид", ВидКИ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И Т.Тип = &Тип
	|	И (Т.Вид = &Вид
	|		ИЛИ &Вид = НЕОПРЕДЕЛЕНО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Вид";
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат;

КонецФункции

Функция УПД970_АдресЭлектроннойПочты(Объект)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", Объект);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация
	|ГДЕ
	|	Объект = &Объект
	|	И Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И (НЕ Вид.ПометкаУдаления)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат = Выборка.Представление;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

