	|	ПередачаОС.СуммаДокумента КАК СуммаДокумента,
	|	ПередачаОС.Ответственный КАК Ответственный,
	|	ПередачаОС.НДСВключенВСтоимость КАК НДСВключенВСтоимость,
	|	Организации.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизации,
	|	ПередачаОС.Грузоотправитель КАК Грузоотправитель,
	|	ПередачаОС.Грузополучатель КАК Грузополучатель,
	|	ПередачаОС.АдресДоставки КАК АдресДоставки,
	|	Валюты.Код КАК ВалютаКод,
	|	Валюты.НаименованиеПолное КАК ВалютаНаименованиеПолное,
	|	ПередачаОС.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ДоговорыКонтрагентов.Дата КАК ДоговорДата,
	|	ДоговорыКонтрагентов.Номер КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах, ЛОЖЬ) КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВалютаВзаиморасчетов, """") КАК ВалютаВзаиморасчетов,
	|	ПередачаОС.КурсВзаиморасчетов КАК КурсВзаиморасчетов,
	|	ПередачаОС.КратностьВзаиморасчетов КАК КратностьВзаиморасчетов,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РеализацияТоваровОблагаемыхНДСУПокупателя, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	НЕОПРЕДЕЛЕНО КАК ПодразделениеОрганизации
	|ИЗ
	|	Документ.ПередачаОС КАК ПередачаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ПередачаОС.ВалютаДокумента = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ПередачаОС.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ПередачаОС.Организация = Организации.Ссылка
	|ГДЕ
	|	ПередачаОС.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличнойЧастиПередачиОС_УПП13()

	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товары"" КАК ВидПоступления,
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК Товар,
	|	ВЫРАЗИТЬ(СпрОсновныеСредства.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрОсновныеСредства.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	СпрОсновныеСредства.Код КАК ТоварКод,
	|	СпрОсновныеСредства.Код КАК ТоварАртикул,
	|	НЕОПРЕДЕЛЕНО КАК ЕдиницаИзмерения,
	|	"""" КАК ЕдиницаИзмеренияКод,
	|	"""" КАК ЕдиницаИзмеренияНаименование,
	|	0 КАК Количество,
	|	0 КАК Цена,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.СтавкаНДС КАК СтавкаНДС,
	|	ОсновныеСредства.СуммаНДС КАК СуммаНДС,
	|	ОсновныеСредства.КодТНВЭД КАК КодТНВЭД,
	|	&ОСИдентификаторСтроки КАК ИдентификаторСтроки,
	|	""ОС"" КАК ИмяТабличнойЧасти,
	|	&ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ЛОЖЬ КАК ПрослеживаемыйКомплект,
	|	ОсновныеСредства.СтранаПроисхождения КАК СтранаПроисхождения,
	|	КлассификаторСтранМира.Код КАК СтранаПроисхожденияКод,
	|	&СтранаПроисхожденияУчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	"""" КАК НомерГТД,
	|	НЕОПРЕДЕЛЕНО КАК ХарактеристикаНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры
	|ИЗ
	|	Документ.ПередачаОС.ОС КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК СпрОсновныеСредства
	|		ПО ОсновныеСредства.ОсновноеСредство = СпрОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМира
	|		ПО ОсновныеСредства.СтранаПроисхождения = КлассификаторСтранМира.Ссылка
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидПоступления,
	|	ОсновныеСредства.НомерСтроки
	|ИТОГИ
	|	СУММА(Количество),
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС)
	|ПО
	|	ОБЩИЕ";
	
	ВыражениеСтранаУчастникЕАЭС = "КлассификаторСтранМира.УчастникЕАЭС";
	Если Не ЕстьРеквизитОбъектаЛок("УчастникЕАЭС", Метаданные.Справочники.КлассификаторСтранМира) Тогда // 1.3.145 и ниже
		ВыражениеСтранаУчастникЕАЭС = "ЛОЖЬ";
	КонецЕсли;
	
	МетаданныеОсновныеСредства = Метаданные.Документы.ПередачаОС.ТабличныеЧасти.ОС;
	
	ВыражениеПрослеживаемыйТовар = "ОсновныеСредства.ПрослеживаемыйТовар";
	Если Не ЕстьРеквизитОбъектаЛок("ПрослеживаемыйТовар", МетаданныеОсновныеСредства) Тогда
		// ПрослеживаемыйТовар в товарах появился с версии 1.3.185
		ВыражениеПрослеживаемыйТовар = "ЛОЖЬ";
	КонецЕсли;
	
	ВыражениеТоварыИдентификаторСтроки = "ОсновныеСредства.ИдентификаторСтроки";
	Если Не ЕстьРеквизитОбъектаЛок("ИдентификаторСтроки", МетаданныеОсновныеСредства) Тогда
		// ИдентификаторСтроки в товарах появился с версии 1.3.185
		ВыражениеТоварыИдентификаторСтроки = """""";
	КонецЕсли;
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&СтранаПроисхожденияУчастникЕАЭС", ВыражениеСтранаУчастникЕАЭС);
	Замены.Добавить("&ПрослеживаемыйТовар", ВыражениеПрослеживаемыйТовар);
	Замены.Добавить("&ОСИдентификаторСтроки", ВыражениеТоварыИдентификаторСтроки);
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

