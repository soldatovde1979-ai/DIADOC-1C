Функция УПД970_СведенияОбАдресеПоПредставлениюИзИБ(Ссылка, ПредставлениеАдреса)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Запрос.УстановитьПараметр("Представление", ПредставлениеАдреса);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И ВЫРАЗИТЬ(Т.Представление КАК СТРОКА(&ДлинаСтроки)) = &Представление";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДлинаСтроки", Формат(СтрДлина(ПредставлениеАдреса), "ЧГ=0"));
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
