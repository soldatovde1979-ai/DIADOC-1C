Процедура УПД970_ЗаполнитьТаблицуТоваров(Контент, ДанныеПоДокументу, ДополнительныеПараметры)
	
	Table = Контракт_InvoiceTable970();
	Контент.Table = Table;
	
	ТочностьЦены = ДополнительныеПараметры.ТочностьЦены;
	ТочностьКоличества = ДополнительныеПараметры.ТочностьКоличества;
	ВсеСтрокиБезНДС = Истина;
	
	ДанныеШапки = ДанныеПоДокументу.РезультатПоШапке.Выбрать();
	ДанныеШапки.Следующий();
	
	СуммаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	НДСИсчисляетсяНалоговымАгентом = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	
	РезультатСведенияПрослеживаемости = Неопределено;
	
	Если ДанныеПоДокументу.Свойство("РезультатСведенияПрослеживаемости", РезультатСведенияПрослеживаемости) Тогда
		СведенияПрослеживаемости = РезультатСведенияПрослеживаемости.Выгрузить();
		СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
	КонецЕсли;
	
	РезультатПоТабличнойЧасти = ДанныеПоДокументу.РезультатПоТабличнойЧасти;
	ИтогиПоТабличнойЧасти = РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если НЕ ИтогиПоТабличнойЧасти.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяПересчетВРубли = УПД970_ТребуетсяПересчетВРубли(ДанныеШапки, Контент.Function);
	
	Если ТребуетсяПересчетВРубли Тогда
		
		ДанныеДляПересчета = Новый_ДанныеДляПересчетаВалюты(ДанныеШапки);
		
		СуммаАвансов = УПД970_ПересчетВалюты_СуммаАвансов(ДанныеДляПересчета);
		
		Курс = УПД970_КурсВзаиморасчетов(ДанныеШапки.КурсВзаиморасчетов, ДанныеШапки.ВалютаДокумента, ДанныеШапки.Дата);
		Кратность = УПД970_КратностьВзаиморасчетов(
			ДанныеШапки.КратностьВзаиморасчетов,
			ДанныеШапки.ВалютаДокумента,
			ДанныеШапки.Дата
		);
		
	КонецЕсли;
	
	ВыводитьАртикулВместоКодаТовара = УПД970_ВыводитьАртикулВместоКодаТовара();
	
	ДанныеТабличнойЧасти = ИтогиПоТабличнойЧасти.Выбрать();
	Пока ДанныеТабличнойЧасти.Следующий() Цикл
		
		Item = Контракт_Item970();
		
		ПараметрыЗаполненияСтрокиТаблицыТоваров = Новый_ПараметрыЗаполненияСтрокиТаблицыТоваров();
		ПараметрыЗаполненияСтрокиТаблицыТоваров.ТребуетсяПересчетВРубли = ТребуетсяПересчетВРубли;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.Курс = Курс;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.Кратность = Кратность;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.СуммаВключаетНДС = СуммаВключаетНДС;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.НДСИсчисляетсяНалоговымАгентом = НДСИсчисляетсяНалоговымАгентом;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.СуммаАвансов = СуммаАвансов;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.ТочностьКоличества = ТочностьКоличества;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.ВыводитьАртикулВместоКодаТовара = ВыводитьАртикулВместоКодаТовара;
		
		УПД970_ЗаполнитьСтрокуТаблицыТоваров(
			Item,
			ДанныеТабличнойЧасти,
			ПараметрыЗаполненияСтрокиТаблицыТоваров,
			ВсеСтрокиБезНДС);
		
		УПД970_ЗаполнитьCustomDeclaration(
			Item,
			ДанныеТабличнойЧасти.НомерГТД,
			ДанныеТабличнойЧасти.СтранаПроисхожденияКод,
			ДанныеТабличнойЧасти.СтранаПроисхожденияУчастникЕАЭС);
		
		Если ДанныеТабличнойЧасти.ПрослеживаемыйТовар Тогда
			УПД970_ЗаполнитьСведенияПрослеживаемости(Item, СведенияПрослеживаемости, ДанныеТабличнойЧасти);
			УПД970_УстановитьРегистрационныйНомерДляПрослеживаемогоТовара(Item.CustomDeclarations);
		КонецЕсли;
		
		УПД970_ОчиститьСтрануПроисхожденияСПустымГТД(Item);
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(ДанныеТабличнойЧасти);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	УПД970_ЗаполнитьИтогиПоТабличнойЧасти(
		Table,
		ИтогиПоТабличнойЧасти,
		ВсеСтрокиБезНДС,
		СуммаВключаетНДС,
		НДСИсчисляетсяНалоговымАгентом);
	
	Если ТребуетсяПересчетВРубли Тогда
		Если СуммаАвансов <> 0 Тогда
			УПД970_ПересчетВалюты_ПересчитатьСуммыСУчетомАвансов(Table, СуммаАвансов, ДанныеШапки.Дата);
		КонецЕсли;
		
		УПД970_ПересчетВалюты_ПересчитатьИтоговыеСуммыУПД(Table);
	КонецЕсли;
	
	УПД970_ПересчитатьЦенуВТабличнойЧасти(Table.Items, ТочностьЦены);
	
	Если УПД970_ВДокументеТолькоУслуги(Table.Items) Тогда
		УПД970_ИзменитьСведенияОбУчастникахЭДОВДокументеУслуг(Контент);
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьТаблицуТоваровПеремещенияТоваров(Контент, ДанныеПоДокументу, ДополнительныеПараметры)
	
	Table = Контракт_InvoiceTable970();
	Контент.Table = Table;
	
	РезультатТовары = ДанныеПоДокументу.РезультатПоТабличнойЧасти.Выгрузить();
	
	ТочностьКоличества = 3;
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	ДопКолонкаПФДокументов = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	
	ВсеСтрокиБезНДС = Истина;
	
	Для Каждого ДанныеТЧ Из РезультатТовары Цикл
		
		Item = Контракт_Item970();
		
		Item.Product = УПД970_ПредставлениеТовара(ДанныеТЧ);
		Item.ItemMark = ТипыНоменклатуры.Имущество;
		Item.ItemVendorCode = УПД970_КодТовара(ДанныеТЧ, ДопКолонкаПФДокументов);
		
		Если ЗначениеЗаполнено(ДанныеТЧ.ЕдиницаИзмеренияНаименование) Тогда
			Item.UnitName = СокрЛП(ДанныеТЧ.ЕдиницаИзмеренияНаименование);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеТЧ.ЕдиницаИзмеренияКод) Тогда
			Item.Unit = СокрЛП(ДанныеТЧ.ЕдиницаИзмеренияКод);
		КонецЕсли;
		
		Item.Quantity = 0;
		Если ЗначениеЗаполнено(ДанныеТЧ.Количество) Тогда
			Item.Quantity = Окр(ДанныеТЧ.Количество, ТочностьКоличества);
		КонецЕсли;
		
		Item.TaxRate = ПредставлениеСтавкиНДС(ДанныеТЧ.СтавкаНДС);
		Item.WithoutVat = XMLСтрока(ДанныеТЧ.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС);
		Если ДанныеТЧ.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
			ВсеСтрокиБезНДС = Ложь;
		КонецЕсли;
		
		УПД970_ЗаполнитьCustomDeclaration(
			Item,
			ДанныеТЧ.НомерГТД,
			ДанныеТЧ.СтранаПроисхожденияКод,
			ДанныеТЧ.СтранаПроисхожденияУчастникЕАЭС
		);
		
		УПД970_ОчиститьСтрануПроисхожденияСПустымГТД(Item);
		
		Item.Price = ДанныеТЧ.Цена;
		Item.Vat = 0;
		Item.Subtotal = ДанныеТЧ.Сумма;
		Item.SubtotalWithVatExcluded = Item.Subtotal - Item.Vat;
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(ДанныеТЧ);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.TotalNet = РезультатТовары.Итог("Количество");
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	Table.Vat = 0;
	Table.Total = РезультатТовары.Итог("Сумма");
	Table.TotalWithVatExcluded = Table.Total - Table.Vat;
	
КонецПроцедуры

Функция УПД970_ПредставлениеТовара(ДанныеСтроки)
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ТоварПолноеНаименование) Тогда
		НаименованиеТовара = ДанныеСтроки.ТоварПолноеНаименование;
	Иначе
		НаименованиеТовара = ДанныеСтроки.ТоварНаименование;
	КонецЕсли;
	
	Если ЭтоКонфигурацияБП() Тогда
		ПредставлениеХарактеристикиИСерии = "";
	Иначе
		ПредставлениеХарактеристикиИСерии = УПД970_ПредставлениеХарактеристикиИСерии(ДанныеСтроки);
	КонецЕсли;
	
	Результат = НаименованиеТовара + ПредставлениеХарактеристикиИСерии;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КодТовара(ДанныеСтроки, ДопКолонкаПФДокументов)
	
	Если ДопКолонкаПФДокументов = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
		Результат = ДанныеСтроки.ТоварАртикул;
	ИначеЕсли ДопКолонкаПФДокументов = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Код Тогда
		Результат = ДанныеСтроки.ТоварКод;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КурсВзаиморасчетов(КурсВзаиморасчетов, ВалютаДокумента, ДатаДокумента)
	
	Если КурсВзаиморасчетов = Неопределено Тогда
		ИнтерфейсКонфигурации = ОбщийМодульПоИмениЛок("МодульВалютногоУчета");
		Результат = ИнтерфейсКонфигурации.ПолучитьКурсВалюты(ВалютаДокумента, ДатаДокумента).Курс;
	Иначе
		Результат = КурсВзаиморасчетов;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КратностьВзаиморасчетов(КратностьВзаиморасчетов, ВалютаДокумента, ДатаДокумента)
	
	Если КратностьВзаиморасчетов = Неопределено Тогда
		ИнтерфейсКонфигурации = ОбщийМодульПоИмениЛок("МодульВалютногоУчета");
		Результат = ИнтерфейсКонфигурации.ПолучитьКурсВалюты(ВалютаДокумента, ДатаДокумента).Кратность;
	Иначе
		Результат = КратностьВзаиморасчетов;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСтрокуТаблицыТоваров(Item, ДанныеТабличнойЧасти, ПараметрыЗаполнения, ВсеСтрокиБезНДС)
	
	Сумма = ДанныеТабличнойЧасти.Сумма;
	СуммаНДС = ДанныеТабличнойЧасти.СуммаНДС;
	
	Если ПараметрыЗаполнения.СуммаВключаетНДС Тогда
		СуммаБезНДС = Сумма - СуммаНДС;
		СуммаВсего = Сумма;
	Иначе
		СуммаБезНДС = Сумма;
		СуммаВсего = Сумма + СуммаНДС;
	КонецЕсли;

	Если ПараметрыЗаполнения.ТребуетсяПересчетВРубли Тогда
		
		СуммаВсего = Окр(СуммаВсего * ПараметрыЗаполнения.Курс / ПараметрыЗаполнения.Кратность, 2);
		
		МодульОбщегоНазначения = ОбщийМодульПоИмениЛок("ОбщегоНазначения");

		МассивРаспределения = Новый Массив;
		МассивРаспределения.Добавить(СуммаБезНДС);
		МассивРаспределения.Добавить(СуммаНДС);
		МассивРаспределенныхСумм = МодульОбщегоНазначения.РаспределитьПропорционально(СуммаВсего, МассивРаспределения);
		Если МассивРаспределенныхСумм <> Неопределено Тогда
			СуммаБезНДС = МассивРаспределенныхСумм[0];
			СуммаНДС = МассивРаспределенныхСумм[1];
		КонецЕсли;

		Если ПараметрыЗаполнения.СуммаАвансов <> 0 Тогда
			Item.Вставить("СуммаРублевая");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.ТоварПолноеНаименование) Тогда
		НаименованиеТовара = ДанныеТабличнойЧасти.ТоварПолноеНаименование;
	Иначе
		НаименованиеТовара = ДанныеТабличнойЧасти.ТоварНаименование;
	КонецЕсли;
	
	Если ЭтоКонфигурацияБП() Тогда
		ПредставлениеХарактеристикиИСерии = "";
	Иначе
		ПредставлениеХарактеристикиИСерии = УПД970_ПредставлениеХарактеристикиИСерии(ДанныеТабличнойЧасти);
	КонецЕсли;
	
	Item.Product = НаименованиеТовара + ПредставлениеХарактеристикиИСерии;
	Item.ItemMark = УПД970_ПризнакТовараИлиУслугиПоСтрокеДокумента(ДанныеТабличнойЧасти.ВидПоступления);
	
	Если ПараметрыЗаполнения.ВыводитьАртикулВместоКодаТовара Тогда
		КодАртикулТовара = ДанныеТабличнойЧасти.ТоварАртикул;
	Иначе
		КодАртикулТовара = ДанныеТабличнойЧасти.ТоварКод;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодАртикулТовара) Тогда
		Item.ItemVendorCode = КодАртикулТовара;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.Количество) Тогда
		Item.Quantity = Окр(ДанныеТабличнойЧасти.Количество, ПараметрыЗаполнения.ТочностьКоличества);
	Иначе
		Item.Quantity = 0;
	КонецЕсли;
	
	Item.Price = ДанныеТабличнойЧасти.Цена;
	
	Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.ЕдиницаИзмерения) Тогда
		
		КодЕИ = СокрЛП(ДанныеТабличнойЧасти.ЕдиницаИзмеренияКод);
		ИмяЕИ = СокрЛП(ДанныеТабличнойЧасти.ЕдиницаИзмерения);
		
		Item.Unit = ГенерацияXML.XML_КодЕдиницыИзмерения(КодЕИ);
		Item.UnitName = ИмяЕИ;
			
	КонецЕсли;
	
	НДСИсчисляетсяНалоговымАгентом = ПараметрыЗаполнения.НДСИсчисляетсяНалоговымАгентом;
	
	Item.TaxRate = ПредставлениеСтавкиНДС(ДанныеТабличнойЧасти.СтавкаНДС, НДСИсчисляетсяНалоговымАгентом);
	
	ЭтоСтавкаБезНДС = (ДанныеТабличнойЧасти.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС);
	Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
	
	Если НЕ ЭтоСтавкаБезНДС Тогда
		ВсеСтрокиБезНДС = Ложь;
	КонецЕсли;
	
	Если НДСИсчисляетсяНалоговымАгентом Тогда
		Item.Vat = 0;
		Item.Subtotal = 0;
	Иначе
		Item.Vat = СуммаНДС;
		Item.Subtotal = СуммаВсего;
	КонецЕсли;
	
	Item.SubtotalWithVatExcluded = СуммаБезНДС;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияПрослеживаемости(Item, СведенияПрослеживаемости, ДанныеТабличнойЧасти)
	
	Отбор = Новый Структура("ИдентификаторСтроки", ДанныеТабличнойЧасти.ИдентификаторСтроки);
	СтрокиПрослеживаемости = СведенияПрослеживаемости.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаПрослеживаемости Из СтрокиПрослеживаемости Цикл
		
		ItemTracingInfo = Контракт_ItemTracingInfo970();
		
		ItemTracingInfo.RegNumberUnit = СокрЛП(СтрокаПрослеживаемости.НомерРНПТ);
		ItemTracingInfo.Quantity = СтрокаПрослеживаемости.КоличествоПрослеживаемости;
		
		Если ЗначениеЗаполнено(СтрокаПрослеживаемости.Сумма) Тогда
			ItemTracingInfo.SumWithoutVat = СтрокаПрослеживаемости.Сумма;
		Иначе
			ItemTracingInfo.SumWithoutVat = Item.SubtotalWithVatExcluded;
		КонецЕсли;
		
		ItemTracingInfo.Unit = СокрЛП(СтрокаПрослеживаемости.ЕдиницаИзмеренияКод);
		ItemTracingInfo.UnitName = СокрЛП(СтрокаПрослеживаемости.ЕдиницаИзмеренияНаименование);
		
		Item.ItemTracingInfos.Добавить(ItemTracingInfo);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьВалютуДокумента(Контент, ДанныеШапки, ФункцияУПД, НеТребуетсяПересчетВалюты = Ложь)
	
	ЭтоСФ = (ФункцияУПД <> ФункцияДокументаУПД_ДОП());
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВалютаУПД = ВалютаРеглУчета;
	
	Если ДанныеШапки.ВалютаДокумента <> ВалютаРеглУчета Тогда
		
		Если ДанныеШапки.РасчетыВУсловныхЕдиницах Тогда
			ВалютаУПД = ВалютаРеглУчета;
		Иначе
			Если ЭтоСФ ИЛИ НеТребуетсяПересчетВалюты Тогда
				ВалютаУПД = ДанныеШапки.ВалютаДокумента;
			Иначе
				ВалютаУПД = ВалютаРеглУчета;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВалютаУПД) Тогда
		Контент.Currency = СокрЛП(ВалютаУПД.Код);
	Иначе
		Контент.Currency = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьИтогиПоТабличнойЧасти(Table, ИтогиПоТабличнойЧасти, ВсеСтрокиБезНДС, СуммаВключаетНДС, НДСИсчисляетсяНалоговымАгентом)
	
	Table.TotalNet = ИтогиПоТабличнойЧасти.Количество;
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	
	Если СуммаВключаетНДС Тогда
		Table.TotalWithVatExcluded = ИтогиПоТабличнойЧасти.Сумма - ИтогиПоТабличнойЧасти.СуммаНДС;
	Иначе
		Table.TotalWithVatExcluded = ИтогиПоТабличнойЧасти.Сумма;
	КонецЕсли;
	
	Если Не НДСИсчисляетсяНалоговымАгентом Тогда
		
		Table.Vat = ИтогиПоТабличнойЧасти.СуммаНДС;
		
		Если СуммаВключаетНДС Тогда
			Table.Total = ИтогиПоТабличнойЧасти.Сумма;
		Иначе
			Table.Total = ИтогиПоТабличнойЧасти.Сумма + ИтогиПоТабличнойЧасти.СуммаНДС;
		КонецЕсли;
		
	Иначе
		
		Table.Total = 0;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокументаОснованияСчетаФактуры(Контент, ДанныеПоДокументу, ДополнительныеПараметры)
	
	ДанныеШапки = ДанныеПоДокументу.РезультатПоШапке.Выбрать();
	ДанныеШапки.Следующий();
	
	Если Контент.Table = Неопределено Тогда
		
		Table = Контракт_InvoiceTable970();
		Контент.Table = Table;
		ВсеСтрокиБезНДС = Истина;
		
	Иначе
		Table = Контент.Table;
		ВсеСтрокиБезНДС = XMLЗначение(Тип("Булево"), Table.WithoutVat);
	КонецЕсли;
	
	ТочностьЦены = ДополнительныеПараметры.ТочностьЦены;
	ТочностьКоличества = ДополнительныеПараметры.ТочностьКоличества;
	
	СуммаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	НДСИсчисляетсяНалоговымАгентом = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	
	РезультатСведенияПрослеживаемости = Неопределено;
	
	Если ДанныеПоДокументу.Свойство("РезультатСведенияПрослеживаемости", РезультатСведенияПрослеживаемости) Тогда
		СведенияПрослеживаемости = РезультатСведенияПрослеживаемости.Выгрузить();
		СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
	КонецЕсли;
	
	РезультатПоТабличнойЧасти = ДанныеПоДокументу.РезультатПоТабличнойЧасти;
	ИтогиПоТабличнойЧасти = РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если НЕ ИтогиПоТабличнойЧасти.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ТребуетсяПересчетВРубли = УПД970_ТребуетсяПересчетВРубли(ДанныеШапки, Контент.Function);
	
	Если ТребуетсяПересчетВРубли Тогда
		
		ДанныеДляПересчета = Новый_ДанныеДляПересчетаВалюты(ДанныеШапки);
		
		СуммаАвансов = УПД970_ПересчетВалюты_СуммаАвансов(ДанныеДляПересчета);
		
		Курс = УПД970_КурсВзаиморасчетов(ДанныеШапки.КурсВзаиморасчетов, ДанныеШапки.ВалютаДокумента, ДанныеШапки.Дата);
		Кратность = УПД970_КратностьВзаиморасчетов(
			ДанныеШапки.КратностьВзаиморасчетов,
			ДанныеШапки.ВалютаДокумента,
			ДанныеШапки.Дата
		);
		
	КонецЕсли;
	
	ВыводитьАртикулВместоКодаТовара = УПД970_ВыводитьАртикулВместоКодаТовара();
	
	ДанныеТабличнойЧасти = ИтогиПоТабличнойЧасти.Выбрать();
	Пока ДанныеТабличнойЧасти.Следующий() Цикл
		
		Item = Контракт_Item970();
		
		ПараметрыЗаполненияСтрокиТаблицыТоваров = Новый_ПараметрыЗаполненияСтрокиТаблицыТоваров();
		ПараметрыЗаполненияСтрокиТаблицыТоваров.ТребуетсяПересчетВРубли = ТребуетсяПересчетВРубли;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.Курс = Курс;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.Кратность = Кратность;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.СуммаВключаетНДС = СуммаВключаетНДС;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.НДСИсчисляетсяНалоговымАгентом = НДСИсчисляетсяНалоговымАгентом;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.СуммаАвансов = СуммаАвансов;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.ТочностьКоличества = ТочностьКоличества;
		ПараметрыЗаполненияСтрокиТаблицыТоваров.ВыводитьАртикулВместоКодаТовара = ВыводитьАртикулВместоКодаТовара;
		
		УПД970_ЗаполнитьСтрокуТаблицыТоваров(
			Item,
			ДанныеТабличнойЧасти,
			ПараметрыЗаполненияСтрокиТаблицыТоваров,
			ВсеСтрокиБезНДС);
		
		УПД970_ЗаполнитьCustomDeclaration(
			Item,
			ДанныеТабличнойЧасти.НомерГТД,
			ДанныеТабличнойЧасти.СтранаПроисхожденияКод,
			ДанныеТабличнойЧасти.СтранаПроисхожденияУчастникЕАЭС);
		
		Если ДанныеТабличнойЧасти.ПрослеживаемыйТовар Тогда
			УПД970_ЗаполнитьСведенияПрослеживаемости(Item, СведенияПрослеживаемости, ДанныеТабличнойЧасти);
			УПД970_УстановитьРегистрационныйНомерДляПрослеживаемогоТовара(Item.CustomDeclarations);
		КонецЕсли;
		
		УПД970_ОчиститьСтрануПроисхожденияСПустымГТД(Item);
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(ДанныеТабличнойЧасти);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.TotalNet = Table.TotalNet + ИтогиПоТабличнойЧасти.Количество;
	
	Если СуммаВключаетНДС Тогда
		СуммаИтогоБезНДС = ИтогиПоТабличнойЧасти.Сумма - ИтогиПоТабличнойЧасти.СуммаНДС;
	Иначе
		СуммаИтогоБезНДС = ИтогиПоТабличнойЧасти.Сумма;
	КонецЕсли;
	
	Table.TotalWithVatExcluded = Table.TotalWithVatExcluded + СуммаИтогоБезНДС;
	
	Если Не НДСИсчисляетсяНалоговымАгентом Тогда
		
		Table.Vat = Table.Vat + ИтогиПоТабличнойЧасти.СуммаНДС;
		
		Если СуммаВключаетНДС Тогда
			СуммаИтого = ИтогиПоТабличнойЧасти.Сумма;
		Иначе
			СуммаИтого = ИтогиПоТабличнойЧасти.Сумма + ИтогиПоТабличнойЧасти.СуммаНДС;
		КонецЕсли;
		
	Иначе
		
		СуммаИтого = 0;
		
	КонецЕсли;
	
	Table.Total = Table.Total + СуммаИтого;
	
	Если ТребуетсяПересчетВРубли Тогда
		
		Если СуммаАвансов <> 0 Тогда
			УПД970_ПересчетВалюты_ПересчитатьСуммыСУчетомАвансов(Table, СуммаАвансов, ДанныеШапки.Дата);
		КонецЕсли;
		
		УПД970_ПересчетВалюты_ПересчитатьИтоговыеСуммыУПД(Table);
		
	КонецЕсли;
	
	УПД970_ПересчитатьЦенуВТабличнойЧасти(Table.Items, ТочностьЦены);
	
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьExtendedOrganizationInfo(Content, ДанныеУчастникаЭДО, СведенияОбАдресе = Неопределено)
	
	Content.Type = УПД970_ExtendedOrganizationInfoType(ДанныеУчастникаЭДО);
	
	Content.Name = ДанныеУчастникаЭДО.Наименование;
	
	Content.Inn = ДанныеУчастникаЭДО.ИНН;
	Content.Kpp = ДанныеУчастникаЭДО.КПП;
	Content.Okpo = ДанныеУчастникаЭДО.КодПоОКПО;
	
	Content.IndividualEntityRegistrationCertificate = ДанныеУчастникаЭДО.Свидетельство;
	
	Content.IndividualEntityRegistrationNumber = ДанныеУчастникаЭДО.ОГРНИП;
	Content.IndividualEntityRegistrationDate = ДанныеУчастникаЭДО.ДатаОГРНИП;
	
	Content.LegalEntityId = ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации;
	
	Content.Country = ДанныеУчастникаЭДО.СтранаНаименование;
	Content.CountryCode = ДанныеУчастникаЭДО.СтранаКод;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Телефоны) Тогда
		Content.Phone.Добавить(ДанныеУчастникаЭДО.Телефоны);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.ЭлектроннаяПочта) Тогда
		Content.Email.Добавить(ДанныеУчастникаЭДО.ЭлектроннаяПочта);
	КонецЕсли;
	
	Content.BankName = ДанныеУчастникаЭДО.НаименованиеБанка;
	Content.BankAccountNumber = ДанныеУчастникаЭДО.НомерСчета;
	Content.CorrespondentAccount = ДанныеУчастникаЭДО.КоррСчет;
	Content.BankId = ДанныеУчастникаЭДО.БИК;
	
	Если ДанныеУчастникаЭДО.Адрес <> Неопределено Тогда
		Content.Address = УПД970_ЗаполненныйAddressInfo(ДанныеУчастникаЭДО.Адрес);
	Иначе
		Content.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
	КонецЕсли;
	
	Content.СлужебнаяИнформация.Ссылка = ДанныеУчастникаЭДО.Ссылка;
	
КонецПроцедуры

Функция УПД970_ExtendedOrganizationInfoType(ДанныеУчастникаЭДО)
	
	ТипЮрФизЛица = ДанныеУчастникаЭДО.ЮрФизЛицо;
	Страна = ДанныеУчастникаЭДО.Страна;
	
	СтранаРоссия = Справочники.КлассификаторСтранМира.Россия;
	
	ВидыЮрФизЛицПрото = ГенерацияXML_Перечисление_ВидыЮрФизЛиц();
	
	Если ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ФизЛицо
		И ДанныеУчастникаЭДО.НеЯвляетсяРезидентом = Ложь Тогда
		
		Результат = ВидыЮрФизЛицПрото.ИндивидуальныйПредприниматель;
		
	ИначеЕсли ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ЮрЛицо
		И ДанныеУчастникаЭДО.НеЯвляетсяРезидентом = Ложь Тогда
		
		Результат = ВидыЮрФизЛицПрото.ЮридическоеЛицо;
		
	ИначеЕсли ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ФизЛицо
		И ДанныеУчастникаЭДО.НеЯвляетсяРезидентом = Истина Тогда
		
		Результат = ВидыЮрФизЛицПрото.ИностранныйГражданин;
		
	ИначеЕсли ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ЮрЛицо
		И ДанныеУчастникаЭДО.НеЯвляетсяРезидентом = Истина Тогда
		
		Результат = ВидыЮрФизЛицПрото.ИностраннаяОрганизация;
		
	Иначе
		
		ТекстОшибки = НСтр("ru='Не удалось определить тип участника ЭДО.
				|Заполните корректные реквизиты участников ЭДО в базе 1С 
				|(организация, грузоотправитель, контрагент, грузополучатель)'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента)
	
	Результат = Контракт_DocumentShipments970();
	
	Результат.Name = НаименованиеДокумента;
	Результат.Number = НомерДокумента;
	Результат.Date = ДатаДокумента;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент)
	
	Контент.DocumentCreator = "";
	Контент.DocumentCreatorBase = "";
	
	Если Контент.Sellers.Количество() > 0 Тогда
		
		ПродавецИнфо = Контент.Sellers[0];
		Контент.DocumentCreator = НаименованиеИННКПП(ПродавецИнфо.Name, ПродавецИнфо.Inn, ПродавецИнфо.Kpp);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСоставителяДокументаПоДаннымАгента(Контент, СсылкаНаОбъект)
	
	Агент = ЗначениеРеквизитаОбъектаЛок(СсылкаНаОбъект, "Организация");
	РеквизитыАгента = УПД970_ДанныеУчастникаЭДО(Агент, Контент.DocumentDate);
	
	Контент.DocumentCreator = НаименованиеИННКПП(РеквизитыАгента.Наименование, РеквизитыАгента.ИНН, РеквизитыАгента.КПП);
	
	УПД970_ЗаполнитьСведенияОДокументеОснованияСоставителяФайла(Контент, СсылкаНаОбъект);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОДокументеОснованияСоставителяФайла(Контент, СсылкаНаОбъект)

	РеквизитыДоговора = Новый Структура;
	РеквизитыДоговора.Вставить("Номер", "ДоговорКонтрагента.Номер");
	РеквизитыДоговора.Вставить("Дата", "ДоговорКонтрагента.Дата");
	
	РеквизитыДоговора = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, РеквизитыДоговора);
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.Номер)
		И ЗначениеЗаполнено(РеквизитыДоговора.Дата) Тогда
		
		НаименованиеДокумент = "Договор";
		
		Контент.DocumentCreatorBase = Контракт_DocumentCreatorBase();
		
		Контент.DocumentCreatorBase.Name = НаименованиеДокумент;
		Контент.DocumentCreatorBase.Number = РеквизитыДоговора.Номер;
		Контент.DocumentCreatorBase.Date = РеквизитыДоговора.Дата;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, КоллекцияДокументов, ФункцияДокумента)
	
	ДокументыОтгрузки = УПД970_ДокументыОтгрузки(КоллекцияДокументов);
	
	СтрокиТаблицы = Контент.Table.Items;
	
	НаименованиеДокумента = УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента);
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФ() Тогда
		
		РеквизитыДокументовОтгрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДокументыОтгрузки, "Дата");
		
		Для Каждого КлючЗначение Из РеквизитыДокументовОтгрузки Цикл
			
			ДокументОтгрузки = КлючЗначение.Ключ;
			РеквизитыДокумента = КлючЗначение.Значение;
			
			НомерДокумента = ПредставлениеНомера(ДокументОтгрузки);
			ДатаДокумента = РеквизитыДокумента.Дата;
			
			DocumentShipment = УПД970_ЗаполненныйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента);
			Контент.DocumentShipments.Добавить(DocumentShipment);
		
		КонецЦикла;
		
	Иначе
		
		НомерДокумента = Контент.DocumentNumber;
		ДатаДокумента = Контент.DocumentDate;
		
		DocumentShipment = УПД970_ЗаполненныйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента);
		Контент.DocumentShipments.Добавить(DocumentShipment);
		
		Контент.DocumentName = НаименованиеДокумента;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ДокументыОтгрузки(ИсходныеДокументы)
	
	Результат = Новый Массив;
	
	Для Каждого ИсходныйДокумент Из ИсходныеДокументы Цикл
		
		ДокументОтгрузки = УПД970_ИсправляемыйДокументОтгрузки(ИсходныйДокумент);
		
		Результат.Добавить(ДокументОтгрузки);
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция УПД970_ИсправляемыйДокументОтгрузки(ИсходныйДокумент)
	
	Если ЗначениеЗаполнено(ИсходныйДокумент)
		И ТипЗнч(ИсходныйДокумент) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ДокументРеализации = ЗначениеРеквизитаОбъектаЛок(ИсходныйДокумент, "ДокументРеализации");
		Результат = УПД970_ИсправляемыйДокументОтгрузки(ДокументРеализации);
		
	Иначе
		
		Результат = ИсходныйДокумент;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента)
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФДОП() Тогда
		
		Результат = НаименованияДокументов.УПД;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументыОтгрузки) И ДокументыОтгрузки.Количество() > 1 Тогда
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		ЕстьУслуги = УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы);
		
		Если ЕстьТовары И НЕ ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Накладная;
			
		ИначеЕсли НЕ ЕстьТовары И ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Акт;
			
		Иначе
			Результат = НаименованияДокументов.Документ;
		КонецЕсли;
		
	Иначе
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		
		Если ЕстьТовары Тогда
			Результат = НаименованияДокументов.Накладная;
		Иначе
			Результат = НаименованияДокументов.Акт;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованияДокументовОтгрузки()
	
	Результат = Новый Структура;
	
	Результат.Вставить("УПД", "Универсальный передаточный документ");
	Результат.Вставить("Накладная", "Товарная накладная");
	Результат.Вставить("Акт", "Акт");
	Результат.Вставить("Документ", "Документ");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе)
	
	Перем Результат;
	
	Если НЕ ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыАдресов = ГенерацияXML.Перечисление_ВидыАдресов();
	
	Результат = Контракт_AddressInfo970();
	
	Если ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		
		Результат.AddressSAR = УПД970_ЗаполненныйAddressSAR(СведенияОбАдресе);
		Результат.Type = ВидыАдресов.АдресГАР;
		
	ИначеЕсли ЭтоАдминистративноТерриториальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		
		Результат.AddressRF = УПД970_ЗаполненныйAddressRF(СведенияОбАдресе);
		Результат.Type = ВидыАдресов.АдресРФ;
		
	Иначе
		
		Результат.AddressText = УПД970_ЗаполненныйAddressText(СведенияОбАдресе);
		Результат.Type = ВидыАдресов.АдресСтрокой;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressSAR(СведенияОбАдресе)
	
	КодыРегионов = ГенерацияXML.КодыРегионов();
	
	Результат = Контракт_AddressSARInfo();
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторДома) Тогда
		Результат.ID = СведенияОбАдресе.ИдентификаторДома;
	Иначе
		Результат.ID = СведенияОбАдресе.ИдентификаторАдресногоОбъекта;
	КонецЕсли;
	
	Результат.ZipCode = СведенияОбАдресе.Индекс;
	Результат.RegionCode = СведенияОбАдресе.КодРегиона;
	
	ПредставлениеРегиона = "";
	Если ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона) Тогда
		ПредставлениеРегиона = КодыРегионов.Получить(XMLЗначение(Тип("Число"), СведенияОбАдресе.КодРегиона));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПредставлениеРегиона) Тогда
		
		ЧастиРегиона = Новый Массив;
		ЧастиРегиона.Добавить(СокрЛП(СведенияОбАдресе.Регион));
		ЧастиРегиона.Добавить(НРег(СведенияОбАдресе.РегионТипПолный));
		
		ПредставлениеРегиона = Общее_СоединитьСтроку(ЧастиРегиона, " ");
		
	КонецЕсли;
	
	Результат.Region = ПредставлениеРегиона;
	Результат.Region = СокрЛП(СведенияОбАдресе.Регион + " " + НРег(СведенияОбАдресе.РегионТипПолный));
	
	MunicipalDistrictCode = СведенияОбАдресе.КодМуниципальногоРайона;
	Если НЕ ЗначениеЗаполнено(MunicipalDistrictCode) Тогда
		MunicipalDistrictCode = УПД970_КодМуниципальногоРайона(СведенияОбАдресе.МуниципальныйРайонСокращение);
	КонецЕсли;
	
	Результат.MunicipalDistrict = СведенияОбАдресе.МуниципальныйРайон;
	Результат.MunicipalDistrictCode = MunicipalDistrictCode;
	
	УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОНаселенномПункте(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОТерритории(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОУлице(Результат, СведенияОбАдресе);
	
	Результат.LandPlot = СведенияОбАдресе.НомерЗемельногоУчастка;
	
	УПД970_ЗаполнитьСведенияОЗданиях(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОПомещенииЗдания(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОПомещенииКвартиры(Результат, СведенияОбАдресе);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Поселение) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.Поселение;
		
		Если ЗначениеЗаполнено(СведенияОбАдресе.КодПоселения) Тогда
			AddressSAR.SettlementCode = СведенияОбАдресе.КодПоселения;
		ИначеЕсли СведенияОбАдресе.ПоселениеТипКраткий = "г.п." Тогда
			AddressSAR.SettlementCode = "1";
		Иначе
			AddressSAR.SettlementCode = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.ВнутригородскойРайон) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.ВнутригородскойРайон;
		AddressSAR.SettlementCode = "4";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОНаселенномПункте(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.НаселенныйПункт) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.НаселенныйПункт;
		AddressSAR.LocalityType = СведенияОбАдресе.НаселенныйПунктТипКраткий;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.Город) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.Город;
		AddressSAR.LocalityType = СведенияОбАдресе.ГородТипКраткий;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОТерритории(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Территория) Тогда
		AddressSAR.PlanningElement = СведенияОбАдресе.Территория;
		AddressSAR.PlanningElementType = СведенияОбАдресе.ТерриторияТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОУлице(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Улица) Тогда
		AddressSAR.StreetElement = СведенияОбАдресе.Улица;
		AddressSAR.StreetElementType = СведенияОбАдресе.УлицаТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОЗданиях(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание.Номер)
		И ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания) Тогда
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = СведенияОбАдресе.Здание.Номер;
		AddressObject.Type = СведенияОбАдресе.Здание.ТипЗдания;
		
	КонецЕсли;
	
	Для Каждого Корпус Из СведенияОбАдресе.Корпуса Цикл
		
		Если НЕ ЗначениеЗаполнено(Корпус.Номер)
			И НЕ ЗначениеЗаполнено(Корпус.ТипКорпуса) Тогда
			Продолжить;
		КонецЕсли;
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = Корпус.Номер;
		AddressObject.Type = Корпус.ТипКорпуса;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииЗдания(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	
	Для Каждого ТипПомещения Из ТипыПомещенийЗдания Цикл
		
		Для Каждого Элемент Из Помещения Цикл
			
			Если ВРЕГ(Элемент.ТипПомещения) = ВРЕГ(ТипПомещения) Тогда
				
				AddressSAR.House = Элемент.Номер;
				AddressSAR.HouseType = Элемент.ТипПомещения;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииКвартиры(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ПомещениеКвартиры = УПД970_ПолучитьПомещениеКвартиры(Помещения);
	
	Если ПомещениеКвартиры = Неопределено Тогда
		ПомещениеКвартиры = УПД970_ПолучитьНеклассифицированноеПомещение(Помещения);
	КонецЕсли;
	
	Если ПомещениеКвартиры <> Неопределено Тогда
		AddressSAR.Apartment = ПомещениеКвартиры.Номер;
		AddressSAR.ApartmentType = ПомещениеКвартиры.ТипПомещения;
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ПолучитьПомещениеКвартиры(СписокПомещений)

	ПомещениеКвартиры = Неопределено;
	
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();
	Для Каждого ИмяТипаПомещения Из ТипыПомещенийКвартиры Цикл
		
		ПомещениеКвартиры = Ядро.МассивСтруктур_Найти(СписокПомещений, ИмяТипаПомещения, "ТипПомещения");
		
		Если ПомещениеКвартиры <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПомещениеКвартиры;

КонецФункции

Функция УПД970_ПолучитьНеклассифицированноеПомещение(СписокПомещений)
	
	Результат = Неопределено;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();

	Для Каждого Помещение Из СписокПомещений Цикл
		
		ТипПомещения = Помещение.ТипПомещения;
		
		ЭтоПомещениеЗдания = (ТипыПомещенийЗдания.Найти(ТипПомещения) <> Неопределено);
		ЭтоПомещениеКвартиры = (ТипыПомещенийКвартиры.Найти(ТипПомещения) <> Неопределено);
		
		Если Не ЭтоПомещениеЗдания
			И Не ЭтоПомещениеКвартиры Тогда
			Результат = Помещение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressRF(СведенияОбАдресе)
	
	Результат = Контракт_AddressRFInfo();
	
	Результат.ZipCode = СведенияОбАдресе.Индекс;
	Результат.RegionCode = СведенияОбАдресе.КодРегиона;
	Результат.Region = СведенияОбАдресе.Регион;
	Результат.Territory = СокрЛП(СведенияОбАдресе.Район);
	Результат.City = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.Город, СведенияОбАдресе.ГородСокращение);
	Результат.Locality = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.НаселенныйПункт, СведенияОбАдресе.НаселенныйПунктСокращение);
	Результат.Street = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.Улица, СведенияОбАдресе.УлицаСокращение);
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание) Тогда 
		СведенияОбАдресе.Здание.Свойство("Номер", Результат.Building);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Корпуса) Тогда 
		СведенияОбАдресе.Корпуса[0].Свойство("Номер", Результат.Block);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Помещения) Тогда 
		СведенияОбАдресе.Помещения[0].Свойство("Номер", Результат.Apartment);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressText(СведенияОбАдресе)
	
	Результат = Контракт_AddressTextInfo();
	
	ПредставлениеАдреса = СведенияОбАдресе.Представление;
	Если СведенияОбАдресе.ТипАдреса = МуниципальныйАдрес()
		И ЗначениеЗаполнено(СведенияОбАдресе.МуниципальноеПредставление) Тогда
		
		ПредставлениеАдреса = СведенияОбАдресе.МуниципальноеПредставление;
		
	КонецЕсли;
	
	Результат.AddressText = ПредставлениеАдреса;
	Результат.CountryCode = СведенияОбАдресе.КодСтраны;
	Результат.Country = СведенияОбАдресе.Страна;

	Возврат Результат;
	
КонецФункции

Функция УПД970_КодМуниципальногоРайона(ТипМуниципальногоРайона)
	
	Результат = "";
	
	Если ВРег(ТипМуниципальногоРайона) = ВРег("м.р-н") Тогда
		
		Результат = "1";
		
	ИначеЕсли ВРег(ТипМуниципальногоРайона) = ВРег("г.о.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("ф.т.") Тогда
		
		Результат = "2";
		
	ИначеЕсли ВРег(ТипМуниципальногоРайона) = ВРег("вн.тер.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("вн.тер. г.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("вн.тер.г.") Тогда
		
		Результат = "3";
		
	ИначеЕсли ВРег(ТипМуниципальногоРайона) = ВРег("мун. окр.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("м.о.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("мун.окр.") Тогда
		
		Результат = "4";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОПередачеТоваров(Контент, ОснованияОтгрузки, ДополнительныеПараметры)
	
	TransferInfo = Контракт_TransferInfo970();
	Контент.TransferInfo = TransferInfo;
	
	TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	
	Если Контент.Function <> ФункцияДокументаУПД_СЧФ() Тогда
		TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Контент);
	КонецЕсли;
	
	УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры)
	
	Перем УказыватьОтсутствиеОснованияУПД;
	
	ДополнительныеПараметры.Свойство("УказыватьОтсутствиеОснованияУПД", УказыватьОтсутствиеОснованияУПД);
		
	Для Каждого РеквизитыОснования Из ОснованияОтгрузки Цикл
		
		РеквизитыЗаполнены = УПД970_РеквизитыОснованияЗаполнены(РеквизитыОснования);
		
		Если Не РеквизитыЗаполнены
			И УказыватьОтсутствиеОснованияУПД = Истина Тогда
			
			TransferInfo.TransferBases.Очистить();
			
			Прервать;
			
		Иначе
			
			TransferBase = Контракт_TransferBases970();
			
			TransferBase.Name = РеквизитыОснования.Наименование;
			TransferBase.Number = РеквизитыОснования.Номер;
			TransferBase.Date = РеквизитыОснования.Дата;
			TransferBase.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияTransferBases970(РеквизитыОснования.ОснованиеСсылка);
			
			TransferInfo.TransferBases.Добавить(TransferBase);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если TransferInfo.TransferBases.Количество() = 0 Тогда
		TransferInfo.WithoutTransferBase = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ЗаполненныйСлужебнаяИнформацияTransferBases970(ОснованиеСсылка)
	
	Результат = Контракт_СлужебнаяИнформацияTransferBases970();
	Результат.ОснованиеСсылка = ОснованиеСсылка;
	Результат.ПредставлениеВТекстеОшибки = "основании";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ПолучитьДатуОтгрузки(Content)
	
	Результат = Content.DocumentDate;
	
	Для Каждого DocumentShipment Из Content.DocumentShipments Цикл
		Результат = DocumentShipment.Date;
