Функция МожноСформироватьПередаточныйДокумент(Документ1С)
	
	ИсключаемыеТипы = Новый Массив;
	ИсключаемыеТипы.Добавить(Тип("ДокументСсылка.ОтчетКомиссионераОПродажах"));
	
	Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
		ИсключаемыеТипы.Добавить(Тип("ДокументСсылка.ОтражениеРеализацииТоваровИУслугНДС"));
	КонецЕсли;
	
	Если ЭтоКонфигурацияБП() Тогда
		ИсключаемыеТипы.Добавить(Тип("ДокументСсылка.ОказаниеУслуг"));
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(Документ1С);
	
	Результат = (ИсключаемыеТипы.Найти(ТипДокумента) = Неопределено);
	
	Возврат Результат;
	
