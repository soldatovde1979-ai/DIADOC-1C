Функция СведенияОбАдресеЛок(Адрес)

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("БезПредставлений", Ложь);
	ДопПараметры.Вставить("КодыАдреса", Истина);
	ДопПараметры.Вставить("КодыКЛАДР", Ложь);
	ДопПараметры.Вставить("ПолныеНаименованияСокращений", Ложь);
	ДопПараметры.Вставить("НаименованиеВключаетСокращение", Ложь);
	ДопПараметры.Вставить("ПроверитьАдрес", Ложь);
	
	МодульРаботыСАдресами = ОбщийМодульПоИмениЛок("РаботаСАдресами");

	Если ЭтоКонфигурацияБП() Тогда
		
		Результат = МодульРаботыСАдресами.СведенияОбАдресе(Адрес, ДопПараметры);
		
	Иначе // УПП 1.3
		
		Адреса = Новый Массив;
		Адреса.Добавить(Адрес);
		
		СведенияОбАдресах = МодульРаботыСАдресами.СведенияОбАдресахВВидеСтруктуры(Адреса, ДопПараметры);
		Результат = СведенияОбАдресах[0];
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеАдреса(ЗаписьКИ)
	
	Если ЕстьФункциональностьРаботаСАдресами()
