Функция НаименованиеИННКПП(Наименование, ИНН, КПП)
	
	Если ЗначениеЗаполнено(КПП) Тогда
		Результат = СтрШаблонЛок("%1, ИНН/КПП %2/%3", Наименование, ИНН, КПП);
	Иначе
		Результат = СтрШаблонЛок("%1, ИНН %2", Наименование, ИНН);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомераДляСФ(Документ, ПодразделениеОрганизации)
	
	Результат = ПредставлениеНомера(Документ);
	
	ДобавитьИндексОбособленногоПодразделения(Результат, Документ, ПодразделениеОрганизации);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьИндексОбособленногоПодразделения(НомерДокумента, Документ, ПодразделениеОрганизации)
	
	Если ЭтоКонфигурацияБП() Тогда
		
		ПодразделениеОрганизацииНаОбщемБалансе = ЗначениеЗаполнено(ПодразделениеОрганизации)
			И ЕстьРеквизитОбъектаЛок("ОбособленноеПодразделение", Метаданные.Справочники.ПодразделенияОрганизаций)
			И ПодразделениеОрганизации.ОбособленноеПодразделение;
		
	Иначе
		
		ПодразделениеОрганизацииНаОбщемБалансе = ЗначениеЗаполнено(ПодразделениеОрганизации)
			И ЗначениеЗаполнено(ПодразделениеОрганизации.КодПоОКТМО);
		
	КонецЕсли;
	
	ИмяРеквизитаЦифровогоИндекса = "ЦифровойИндексОбособленногоПодразделения";
	
	Если ПодразделениеОрганизацииНаОбщемБалансе Тогда
		
		Если НЕ ПодразделениеОрганизации.метаданные().реквизиты.найти(ИмяРеквизитаЦифровогоИндекса) = Неопределено Тогда
			ИндексОбособленногоПодразделения = ЗначениеРеквизитаОбъектаЛок(
				ПодразделениеОрганизации,
				ИмяРеквизитаЦифровогоИндекса);
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитОбъектаЛок(ИмяРеквизитаЦифровогоИндекса, Метаданные.Справочники.Организации) Тогда
		
		Организация = ЗначениеРеквизитаОбъектаЛок(Документ, "Организация");
		
		ИндексОбособленногоПодразделения = ЗначениеРеквизитаОбъектаЛок(
			Организация,
			ИмяРеквизитаЦифровогоИндекса);
		
	Иначе
		ИндексОбособленногоПодразделения = "";
	КонецЕсли;
	
	ЧастиНомера = Новый Массив;
	ЧастиНомера.Добавить(НомерДокумента);
	ЧастиНомера.Добавить(ИндексОбособленногоПодразделения);
	
	НомерДокумента = Общее_СоединитьСтроку(ЧастиНомера, "/");
	
КонецПроцедуры

