Функция ЭтоСчетФактураОтИмениПродавца_БП20(СсылкаНаОбъект)
	
	Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЭтоСчетФактураВыданный(СсылкаНаОбъект) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Ложь;
	
	ТребуемыеРеквизитыСФ = Новый Структура;
	ТребуемыеРеквизитыСФ.Вставить("Продавец");
	ТребуемыеРеквизитыСФ.Вставить("ДокументОснование");
	ЗначенияРеквизитовСФ = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, ТребуемыеРеквизитыСФ);
			
	Если ТипЗнч(ЗначенияРеквизитовСФ.ДокументОснование) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах")
		И ЗначениеЗаполнено(ЗначенияРеквизитовСФ.Продавец) Тогда
		
		ТребуемыеРеквизитыДок = Новый Структура;
		ТребуемыеРеквизитыДок.Вставить("ВидОперации", "ВидОперации");
		ЗначенияРеквизитовДок = ЗначенияРеквизитовОбъектаЛок(ЗначенияРеквизитовСФ.ДокументОснование, ТребуемыеРеквизитыДок);
		
		Если ЗначенияРеквизитовДок.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
			
			Результат = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

