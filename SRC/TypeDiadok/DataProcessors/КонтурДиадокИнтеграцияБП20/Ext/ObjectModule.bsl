// Проверяет, что в структуре адреса присутствуют поля, которых нет в структуре АдрРФ.
//
// Параметры:
//  СведенияОбАдресе - Структура - см. функцию СведенияОбАдресеЛок;
// 
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы одно заполненное поле, не соответстующее структуре АдрРФ.
//
Функция ЕстьНесоответствующиеСтруктуреАдрРФПоля(СведенияОбАдресе)
	
	Результат = Ложь;
	
	ПоляНеПоАдресРФ = Новый Массив;
	ПоляНеПоАдресРФ.Добавить("Округ");
	ПоляНеПоАдресРФ.Добавить("МуниципальныйРайон");
	ПоляНеПоАдресРФ.Добавить("Поселение");
	ПоляНеПоАдресРФ.Добавить("ВнутригородскойРайон");
	ПоляНеПоАдресРФ.Добавить("Территория");
	ПоляНеПоАдресРФ.Добавить("ДополнительнаяТерритория");
	ПоляНеПоАдресРФ.Добавить("ЭлементДополнительнойТерритории");
	ПоляНеПоАдресРФ.Добавить("НомерЗемельногоУчастка");
	
	Для Каждого ИмяПоля Из ПоляНеПоАдресРФ Цикл 
		
		ЗначениеПоля = СвойствоСтруктурыЛок(СведенияОбАдресе, ИмяПоля);
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда 
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает описания всех библиотек конфигурации, включая
// описание самой конфигурации.
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - Строка - имя подсистемы, например, "СтандартныеПодсистемы".
//   * Значение - Структура - описание подсистемы:
//     ** Имя - Строка - имя подсистемы.
//     ** Версия - Строка - версия подсистемы.
//     ** ЭтоКонфигурация - Булево - Истина, если данная подсистема является основной конфигурацией.
//     ** ИдентификаторИнтернетПоддержки - Строка - уникальное имя программы в сервисах интернет-поддержки.
//
Функция ОписанияПодсистемКонфигурации()
	
	МодульСтандартныеПодсистемыПовтИсп = ОбщийМодульПоИмениЛок("СтандартныеПодсистемыПовтИсп");
	Результат = МодульСтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам;
	Возврат Результат;
	
КонецФункции

