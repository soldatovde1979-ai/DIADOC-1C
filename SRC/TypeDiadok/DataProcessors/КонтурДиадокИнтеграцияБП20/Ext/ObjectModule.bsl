Функция УПД970_РезультатыЗапросовИсходныхДанныхДокумента(Запросы, ДокСсылка)
	
	СтрОбъединениеЗапросов = ТекстЗапроса_РазделительЗапросов();
	
	ТекстЗапроса = Общее_СоединитьСтроку(Запросы, СтрОбъединениеЗапросов);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	Результат.Вставить("РезультатПоШапке", РезультатыЗапроса[0]);
	Результат.Вставить("РезультатПоТабличнойЧасти", РезультатыЗапроса[1]);
	
	КоличествоЗапросовВПакетеСДанными = 3;
	
	Если РезультатыЗапроса.Количество() = КоличествоЗапросовВПакетеСДанными Тогда
		Результат.Вставить("РезультатСведенияПрослеживаемости", РезультатыЗапроса[2]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)

	Результат = Контракт_ДанныеУчастникаЭДО();
	
	МодульУправлениеКонтактнойИнформацией = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
	СведенияОЮрФизЛице = МодульУправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Ссылка, ДатаСведений, , БанковскийСчет);
	
	Результат.Ссылка = Ссылка;
	
	Результат.ИНН = СокрЛП(СведенияОЮрФизЛице.ИНН);
	Результат.КПП = СокрЛП(СведенияОЮрФизЛице.КПП);
	Результат.КодПоОКПО = СокрЛП(СведенияОЮрФизЛице.КодПоОКПО);
	
	Если ЗначениеЗаполнено(СведенияОЮрФизЛице.Банк) Тогда
		Результат.НаименованиеБанка = СведенияОЮрФизЛице.Банк.Наименование;
	Иначе
		Результат.НаименованиеБанка = "";
	КонецЕсли;
	
	Результат.НомерСчета = СокрЛП(СведенияОЮрФизЛице.НомерСчета);
	Результат.КоррСчет = СокрЛП(СведенияОЮрФизЛице.КоррСчет);
	Результат.БИК = СокрЛП(СведенияОЮрФизЛице.БИК);
	
	Результат.Телефоны = СведенияОЮрФизЛице.Телефоны;
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
		УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиОрганизации(Результат, Ссылка);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если ЭтоКонфигурацияКА() Тогда
			УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиКонтрагента_КА11(Результат, Ссылка);
		Иначе
			УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиКонтрагента(Результат, Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОПодразделенииОрганизации(Организация, ПодразделениеОрганизации, ДатаСведений)
	
	Результат = Контракт_ДанныеУчастникаЭДО();
	
	СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДО(Организация, ДатаСведений);
	АдресПодразделения = УПД970_СведенияОФактическомАдресе(ПодразделениеОрганизации);
	
	Результат.Ссылка = ПодразделениеОрганизации;
	Результат.Адрес = АдресПодразделения;
	
	// Реквизит НаименованиеПолное в ПодразделенииОрганизации появился с версии 1.3.217
	ИмяРеквизитаНаименование = "НаименованиеПолное";
	ЕстьРеквизитПолноеНаименование = ЕстьРеквизитОбъектаЛок(
		ИмяРеквизитаНаименование,
		ПодразделениеОрганизации.Метаданные()
	);
	
	Если ЕстьРеквизитПолноеНаименование Тогда
		
		ИменаРеквизитов = "КПП, НаименованиеПолное";
		РеквизитыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				ПодразделениеОрганизации,
				ИменаРеквизитов);
		
		Результат.Наименование = РеквизитыПодразделения.НаименованиеПолное;
		Результат.КПП = РеквизитыПодразделения.КПП;
		
	Иначе
		
		ИменаРеквизитов = "КПП, Наименование";
		РеквизитыПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				ПодразделениеОрганизации,
				ИменаРеквизитов);
		
		Результат.Наименование = РеквизитыПодразделения.Наименование;
		Результат.КПП = РеквизитыПодразделения.КПП;
		
	КонецЕсли;
	
	Результат.ИНН = СведенияОбОрганизации.ИНН;
	Результат.Страна = СведенияОбОрганизации.Страна;
	Результат.СтранаНаименование = СведенияОбОрганизации.СтранаНаименование;
	Результат.СтранаКод = СведенияОбОрганизации.СтранаКод;
	Результат.ЮрФизЛицо = СведенияОбОрганизации.ЮрФизЛицо;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиОрганизации(ДанныеУчастникаЭДО, Ссылка)
	
	СведенияОбОрганизации = УПД970_СведенияОбОрганизации(Ссылка);
	
	ЭтоИндивидуальныйПредприниматель = ЗначениеЗаполнено(СведенияОбОрганизации.ИндивидуальныйПредприниматель);
	ЭтоИностраннаяОрганизация = СведенияОбОрганизации.ИностраннаяОрганизация;
	
	Если Не ЗначениеЗаполнено(СведенияОбОрганизации.Страна)
		И Не ЭтоИностраннаяОрганизация Тогда
		
		СведенияОСтране = ЗначенияРеквизитовОбъектаЛок(
			Справочники.КлассификаторСтранМира.Россия, "Ссылка, Код, Наименование");
			
		СведенияОбОрганизации.Страна = СведенияОСтране.Ссылка;
		СведенияОбОрганизации.СтранаКод = СведенияОСтране.Код;
		СведенияОбОрганизации.СтранаНаименование = СведенияОСтране.Наименование;
		
	КонецЕсли;
	
	ДанныеУчастникаЭДО.ЮрФизЛицо = СведенияОбОрганизации.ЮрФизЛицо;

	Если ЭтоИндивидуальныйПредприниматель Тогда
		
		ДанныеУчастникаЭДО.Наименование = СведенияОбОрганизации.НаименованиеИП;
		
		ДанныеУчастникаЭДО.ОГРНИП = СведенияОбОрганизации.ОГРН;
		ДанныеУчастникаЭДО.ДатаОГРНИП = СведенияОбОрганизации.ДатаРегистрации;
		
	ИначеЕсли ЭтоИностраннаяОрганизация Тогда
		
		ДанныеУчастникаЭДО.Наименование = СведенияОбОрганизации.НаименованиеИнострОрганизации;
		
		ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации = СведенияОбОрганизации.КодВСтранеРегистрации;
		
	Иначе
		
		НаименованиеОрганизации = СведенияОбОрганизации.НаименованиеСокращенное;
		Если НЕ ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
			НаименованиеОрганизации = СведенияОбОрганизации.НаименованиеПолное;
		КонецЕсли;
		
		ДанныеУчастникаЭДО.Наименование = НаименованиеОрганизации;
		
	КонецЕсли;

	ДанныеУчастникаЭДО.Страна = СведенияОбОрганизации.Страна;
	ДанныеУчастникаЭДО.СтранаКод = СведенияОбОрганизации.СтранаКод;
	ДанныеУчастникаЭДО.СтранаНаименование = СведенияОбОрганизации.СтранаНаименование;
	
	Свидетельство = "";
	Если ЗначениеЗаполнено(СведенияОбОрганизации.СвидетельствоСерияНомер) Тогда
		Свидетельство = "свидетельство " + СведенияОбОрганизации.СвидетельствоСерияНомер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбОрганизации.СвидетельствоДатаВыдачи) Тогда
		Свидетельство = Свидетельство + " от " + Формат(СведенияОбОрганизации.СвидетельствоДатаВыдачи, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	ДанныеУчастникаЭДО.Свидетельство = Свидетельство;
	ДанныеУчастникаЭДО.ЭлектроннаяПочта = УПД970_АдресЭлектроннойПочты(Ссылка);
	
КонецПроцедуры

Функция УПД970_СведенияОбОрганизации(Ссылка)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.ЮрФизЛицо КАК ЮрФизЛицо,
	|	Т.НаименованиеПолное КАК НаименованиеПолное,
	|	Т.НаименованиеСокращенное КАК НаименованиеСокращенное,
	|	&СтранаРегистрацииСсылка КАК Страна,
	|	&СтранаРегистрацииКод КАК СтранаКод,
	|	&СтранаРегистрацииНаименование КАК СтранаНаименование,
	|	&НаименованиеИнострОрганизации КАК НаименованиеИнострОрганизации,
	|	&ИностраннаяОрганизация КАК ИностраннаяОрганизация,
	|	&КодВСтранеРегистрации КАК КодВСтранеРегистрации,
	|	Т.ИндивидуальныйПредприниматель КАК ИндивидуальныйПредприниматель,
	|	Т.ИндивидуальныйПредприниматель.Наименование КАК НаименованиеИП,
	|	Т.СвидетельствоСерияНомер КАК СвидетельствоСерияНомер,
	|	Т.СвидетельствоДатаВыдачи КАК СвидетельствоДатаВыдачи,
	|	Т.ОГРН КАК ОГРН,
	|	Т.ДатаРегистрации КАК ДатаРегистрации
	|ИЗ
	|	Справочник.Организации КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка";
	
	СтранаРегистрацииСсылка = "Т.СтранаРегистрации";
	СтранаРегистрацииКод = "ЕСТЬNULL(Т.СтранаРегистрации.Код, """")";
	СтранаРегистрацииНаименование = "ЕСТЬNULL(Т.СтранаРегистрации.Наименование, """")";
	ИностраннаяОрганизация = "Т.ИностраннаяОрганизация";
	КодВСтранеРегистрации = "Т.КодВСтранеРегистрации";
	НаименованиеИнострОрганизации = "Т.НаименованиеИнострОрганизации";
	
	ОбъектМД = Метаданные.Справочники.Организации;
	Если Не ЕстьРеквизитОбъектаЛок("СтранаРегистрации", ОбъектМД) Тогда
		СтранаРегистрацииСсылка = "ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)";
		СтранаРегистрацииКод = """""";
		СтранаРегистрацииНаименование = """""";
		ИностраннаяОрганизация = "ЛОЖЬ";
		КодВСтранеРегистрации = """""";
		НаименованиеИнострОрганизации = """""";
	КонецЕсли;
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&СтранаРегистрацииСсылка", СтранаРегистрацииСсылка);
	Замены.Добавить("&СтранаРегистрацииКод", СтранаРегистрацииКод);
	Замены.Добавить("&СтранаРегистрацииНаименование", СтранаРегистрацииНаименование);
	Замены.Добавить("&ИностраннаяОрганизация", ИностраннаяОрганизация);
	Замены.Добавить("&КодВСтранеРегистрации", КодВСтранеРегистрации);
	Замены.Добавить("&НаименованиеИнострОрганизации", НаименованиеИнострОрганизации);
	
	Для Каждого Элемент Из Замены Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Ошибка = СтрШаблонЛок("Не удалось прочитать данные организации (Ссылка = %1)", Ссылка);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЮрФизЛицо", Выборка.ЮрФизЛицо);
	Результат.Вставить("НаименованиеПолное", Выборка.НаименованиеПолное);
	Результат.Вставить("НаименованиеСокращенное", Выборка.НаименованиеСокращенное);
	Результат.Вставить("Страна", Выборка.Страна);
	Результат.Вставить("СтранаКод", Выборка.СтранаКод);
	Результат.Вставить("СтранаНаименование", Выборка.СтранаНаименование);
	Результат.Вставить("НаименованиеИнострОрганизации", Выборка.НаименованиеИнострОрганизации);
	Результат.Вставить("ИностраннаяОрганизация", Выборка.ИностраннаяОрганизация);
	Результат.Вставить("КодВСтранеРегистрации", Выборка.КодВСтранеРегистрации);
	Результат.Вставить("ИндивидуальныйПредприниматель", Выборка.ИндивидуальныйПредприниматель);
	Результат.Вставить("НаименованиеИП", Выборка.НаименованиеИП);
	Результат.Вставить("СвидетельствоСерияНомер", Выборка.СвидетельствоСерияНомер);
	Результат.Вставить("СвидетельствоДатаВыдачи", Выборка.СвидетельствоДатаВыдачи);
	Результат.Вставить("ОГРН", Выборка.ОГРН);
	Результат.Вставить("ДатаРегистрации", Выборка.ДатаРегистрации);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиКонтрагента(ДанныеУчастникаЭДО, Ссылка)
	
	СведенияОКонтрагенте = УПД970_СведенияОКонтрагенте(Ссылка);
	
	ЭтоИностраннаяОрганизация = СведенияОКонтрагенте.НеЯвляетсяРезидентом;
	
	Если Не ЗначениеЗаполнено(СведенияОКонтрагенте.Страна)
		И Не ЭтоИностраннаяОрганизация Тогда
		
		СведенияОСтране = ЗначенияРеквизитовОбъектаЛок(
			Справочники.КлассификаторСтранМира.Россия, "Ссылка, Код, Наименование");
		
		СведенияОКонтрагенте.Страна = СведенияОСтране.Ссылка;
		СведенияОКонтрагенте.СтранаКод = СведенияОСтране.Код;
		СведенияОКонтрагенте.СтранаНаименование = СведенияОСтране.Наименование;
		
	КонецЕсли;
	
	Если ЭтоИностраннаяОрганизация Тогда
		ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации = СведенияОКонтрагенте.РегистрационныйНомер;
	КонецЕсли;
	
	Если ЭтоКонфигурацияБП() Тогда
		Если НЕ ЭтоИностраннаяОрганизация Тогда
			ДанныеУчастникаЭДО.ОГРНИП = СведенияОКонтрагенте.РегистрационныйНомер;
		КонецЕсли;
	Иначе
		ДанныеУчастникаЭДО.ОГРНИП = СведенияОКонтрагенте.ОГРН;
	КонецЕсли;
	
	ДанныеУчастникаЭДО.ЮрФизЛицо = СведенияОКонтрагенте.ЮрФизЛицо;
	
	Если ЗначениеЗаполнено(СведенияОКонтрагенте.НаименованиеПолное) Тогда
		ДанныеУчастникаЭДО.Наименование = СведенияОКонтрагенте.НаименованиеПолное;
	Иначе 
		ДанныеУчастникаЭДО.Наименование = СведенияОКонтрагенте.Наименование;
	КонецЕсли;
	
	ДанныеУчастникаЭДО.Страна = СведенияОКонтрагенте.Страна;
	ДанныеУчастникаЭДО.СтранаКод = СведенияОКонтрагенте.СтранаКод;
	ДанныеУчастникаЭДО.СтранаНаименование = СведенияОКонтрагенте.СтранаНаименование;
	ДанныеУчастникаЭДО.НеЯвляетсяРезидентом = ЭтоИностраннаяОрганизация;
	ДанныеУчастникаЭДО.ЭлектроннаяПочта = УПД970_АдресЭлектроннойПочты(Ссылка);
	
КонецПроцедуры

Функция УПД970_СведенияОКонтрагенте(Ссылка)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.ЮрФизЛицо КАК ЮрФизЛицо,
	|	Т.НаименованиеПолное КАК НаименованиеПолное,
	|	Т.Наименование КАК Наименование,
	|	&СтранаРегистрацииСсылка КАК Страна,
	|	&СтранаРегистрацииКод КАК СтранаКод,
	|	&СтранаРегистрацииНаименование КАК СтранаНаименование,
	|	Т.НеЯвляетсяРезидентом КАК НеЯвляетсяРезидентом,
	|	&РегистрационныйНомер КАК РегистрационныйНомер,
	|	&ОГРН КАК ОГРН	
	|ИЗ
	|	Справочник.Контрагенты КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка";
	
	СтранаРегистрацииСсылка = "Т.СтранаРегистрации";
	СтранаРегистрацииКод = "ЕСТЬNULL(Т.СтранаРегистрации.Код, """")";
	СтранаРегистрацииНаименование = "ЕСТЬNULL(Т.СтранаРегистрации.Наименование, """")";
	РегистрационныйНомер = "Т.РегистрационныйНомер";
	
	ОбъектМД = Метаданные.Справочники.Контрагенты;
	Если Не ЕстьРеквизитОбъектаЛок("СтранаРегистрации", ОбъектМД) Тогда
		СтранаРегистрацииСсылка = "ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)";
		СтранаРегистрацииКод = """""";
		СтранаРегистрацииНаименование = """""";
		РегистрационныйНомер = """""";
	КонецЕсли;
	
	Если ЕстьРеквизитОбъектаЛок("ОГРН", ОбъектМД) Тогда
		ОГРН = "Т.ОГРН";
	ИначеЕсли ЕстьРеквизитОбъектаЛок("РегистрационныйНомер", ОбъектМД) Тогда
		ОГРН = "Т.РегистрационныйНомер";
	Иначе
		ОГРН = """""";
	КонецЕсли;
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&СтранаРегистрацииСсылка", СтранаРегистрацииСсылка);
	Замены.Добавить("&СтранаРегистрацииКод", СтранаРегистрацииКод);
	Замены.Добавить("&СтранаРегистрацииНаименование", СтранаРегистрацииНаименование);
	Замены.Добавить("&ОГРН", ОГРН);
	Замены.Добавить("&РегистрационныйНомер", РегистрационныйНомер);
	
	Для Каждого Элемент Из Замены Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Ошибка = СтрШаблонЛок("Не удалось прочитать данные контрагента (Ссылка = %1)", Ссылка);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ЮрФизЛицо", Выборка.ЮрФизЛицо);
	Результат.Вставить("НаименованиеПолное", Выборка.НаименованиеПолное);
	Результат.Вставить("НеЯвляетсяРезидентом", Выборка.НеЯвляетсяРезидентом);
	Результат.Вставить("Страна", Выборка.Страна);
	Результат.Вставить("СтранаКод", Выборка.СтранаКод);
	Результат.Вставить("СтранаНаименование", Выборка.СтранаНаименование);
	Результат.Вставить("РегистрационныйНомер", Выборка.РегистрационныйНомер);
	Результат.Вставить("ОГРН", Выборка.ОГРН);
	Результат.Вставить("Наименование", Выборка.Наименование);
	
	Возврат Результат;
	
КонецФункции

