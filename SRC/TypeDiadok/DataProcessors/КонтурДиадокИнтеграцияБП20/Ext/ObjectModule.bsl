Функция УПД970_ТекстЗапросаСведенийОПрослеживаемостиОбщее_УПП13(ОбъектМетаданных)
	
	Пустышка =
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	0 КАК КоличествоПрослеживаемости,
	|	"""""""" КАК ИдентификаторСтроки,
	|	0 КАК Сумма,
	|	"""""""" КАК ЕдиницаИзмеренияКод,
	|	"""""""" КАК ЕдиницаИзмеренияНаименование,
	|	"""""""" КАК НомерРНПТ";
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(Пустышка);
	
	Замены = Новый СписокЗначений;
	
	МетаданныеТЧ = ОбъектМетаданных.ТабличныеЧасти.Найти("СведенияПрослеживаемости");
	
	Если МетаданныеТЧ <> Неопределено Тогда // 1.3.182 и выше
		
		ОсновнойЗапрос =
		"ВЫБРАТЬ
		|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	&ВыражениеСумма КАК Сумма,
		|	&ВыражениеЕдИзмКод КАК ЕдиницаИзмеренияКод,
		|	&ВыражениеЕдИзмНаименование КАК ЕдиницаИзмеренияНаименование,
		|	НомераГТД.Код КАК НомерРНПТ
		|ИЗ
		|	&ПолноеИмяТаблицы КАК СведенияПрослеживаемости
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
		|		ПО СведенияПрослеживаемости.РНПТ = НомераГТД.Ссылка
		|ГДЕ
		|	СведенияПрослеживаемости.Ссылка = &Ссылка";
		
		ВыражениеСумма = "СведенияПрослеживаемости.Сумма";
		Если Не ЕстьРеквизитОбъектаЛок("Сумма", МетаданныеТЧ) Тогда // 1.3.188 и ниже
			ВыражениеСумма = "0";
		КонецЕсли;
		
		ВыражениеЕдИзмКод =
		"ВЫБОР
		|	КОГДА СведенияПрослеживаемости.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА СведенияПрослеживаемости.Номенклатура.БазоваяЕдиницаИзмерения.Код
		|	ИНАЧЕ ""796""
		|КОНЕЦ";
		
		ВыражениеЕдИзмНаименование =
		"ВЫБОР
		|	КОГДА СведенияПрослеживаемости.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА СведенияПрослеживаемости.Номенклатура.БазоваяЕдиницаИзмерения.Наименование
		|	ИНАЧЕ ""шт""
		|КОНЕЦ";
		
		Если Не ЕстьРеквизитОбъектаЛок("Номенклатура", МетаданныеТЧ) Тогда // 1.3.188 и ниже
			ВыражениеЕдИзмКод = """796""";
			ВыражениеЕдИзмНаименование = """шт""";
		КонецЕсли;
		
		Замены.Добавить("&ПолноеИмяТаблицы", ОбъектМетаданных.ПолноеИмя() + ".СведенияПрослеживаемости");
		Замены.Добавить("&ВыражениеСумма", ВыражениеСумма);
		Замены.Добавить("&ВыражениеЕдИзмКод", ВыражениеЕдИзмКод);
		Замены.Добавить("&ВыражениеЕдИзмНаименование", ВыражениеЕдИзмНаименование);
		
		ЧастиЗапроса.Добавить(ОсновнойЗапрос);
		
	КонецЕсли;
	
	Результат = Общее_СоединитьСтроку(ЧастиЗапроса, ТекстЗапроса_ОбъединитьВсе());
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияОтгрузкиТоваров_УПП13(ОснованиеОтгрузки)
	
	Если ЗначениеЗаполнено(ОснованиеОтгрузки) Тогда
		
		Если ЭтоЗаказПокупателя_УПП13(ОснованиеОтгрузки) Тогда
			Результат = УПД970_РеквизитыОснованияОтгрузкиТоваровПоЗаказу_УПП13(ОснованиеОтгрузки);
		Иначе
			Результат = УПД970_РеквизитыОснованияОтгрузкиТоваровПоДоговору(ОснованиеОтгрузки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияОтгрузкиТоваровПоЗаказу_УПП13(ДокументСсылка)
	
	ДатаЗаказа = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "Дата");
	
	Результат = УПД970_НовыйРеквизитыОснованияОтгрузки(
		"Заказ покупателя",
		ПредставлениеНомера(ДокументСсылка),
		ДатаЗаказа,
		ДокументСсылка);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОснованиеОтгрузкиТоваровПоДокументу_УПП13(ДокументСсылка)
	
	Сделка = Неопределено;
	ДоговорКонтрагента = Неопределено;
	
	Если ЕстьРеквизитОбъектаЛок("Сделка", ДокументСсылка.Метаданные()) Тогда
		Сделка = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "Сделка");
	КонецЕсли;
	
	ДоговорКонтрагента = ЗначениеРеквизитаОбъектаЛок(ДокументСсылка, "ДоговорКонтрагента");
	
	Если УПД970_ВедениеВзаиморасчетовПоЗаказам_УПП13(ДоговорКонтрагента)
		И ЗначениеЗаполнено(Сделка)
		И ЭтоЗаказПокупателя_УПП13(Сделка) Тогда
		
		Результат = Сделка;
		
	ИначеЕсли ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		
		Результат = ДоговорКонтрагента;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВедениеВзаиморасчетовПоЗаказам_УПП13(Договор)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		ВедениеВзаиморасчетов = ЗначениеРеквизитаОбъектаЛок(Договор, "ВедениеВзаиморасчетов");
		Результат = (ВедениеВзаиморасчетов = ПредопределенноеЗначение("Перечисление.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьИдентификаторГосКонтракта_УПП13(Контент, ДанныеШапки)
	
	Перем ИдентификаторГосКонтракта;
	
	Если ЭтоСчетФактураВыданный(ДанныеШапки.Ссылка) Тогда
		
		ИдентификаторГосКонтракта = ДанныеШапки.ИдентификаторГосКонтракта;
		
	Иначе
		
		РеквизитыДоговора = УПД970_РеквизитыДоговораПоДаннымШапкиДокумента(ДанныеШапки);
		
		Если МожноИспользоватьКонтракты_УПП13(РеквизитыДоговора) Тогда
			
			МодульОбщегоНазначения275 = ОбщийМодульПоИмениЛок("ОбщегоНазначения275КлиентСервер");
			Контракт = МодульОбщегоНазначения275.НайтиПодчиненныйКонтракт(ДанныеШапки.ДоговорКонтрагента);
			Если ЗначениеЗаполнено(Контракт) Тогда
				ИдентификаторГосКонтракта = Контракт.Код;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Контент.GovernmentContractInfo = ИдентификаторГосКонтракта;
	
КонецПроцедуры

Функция МожноИспользоватьКонтракты_УПП13(РеквизитыДоговора)
	
	_ВестиУчетПлатежейПоГосКонтрактам = глЗначениеПеременной("ВестиУчетПлатежейПоГосКонтрактам");
	_ВалютаРегламентированногоУчета = глЗначениеПеременной("ВалютаРегламентированногоУчета");
	
	Результат = _ВестиУчетПлатежейПоГосКонтрактам И
		(РеквизитыДоговора.ВалютаВзаиморасчетов = _ВалютаРегламентированногоУчета ИЛИ РеквизитыДоговора.РасчетыВУсловныхЕдиницах) И
		(РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком ИЛИ 
		 РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);

	Возврат Результат;

КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиОтражениеНачисленияНДС()
	
	Результат =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
