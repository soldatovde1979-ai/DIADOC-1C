	|	1 КАК Количество,
	|	ДанныеДокумента.Сумма КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ПередачаОС.ОС КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &ТекущийДокумент";

	ПсевдонимТаблицы = "ДанныеДокумента";
	
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(
		Результат,
		ПсевдонимТаблицы
	);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДанныеДокумента_ОтчетКомитентуОПродажах()
	
	Результат =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДанныеДокумента.ДоговорКонтрагента.УчетАгентскогоНДС, ЛОЖЬ) КАК УчетАгентскогоНДС,
	|	ДанныеДокумента.УслугаПоВознаграждению КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.УслугаПоВознаграждению = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ""Комиссионное вознаграждение""
	|		КОГДА ПОДСТРОКА(ДанныеДокумента.УслугаПоВознаграждению.НаименованиеПолное, 1, 10) = """"
	|			ТОГДА ДанныеДокумента.УслугаПоВознаграждению.Наименование
	|		ИНАЧЕ ДанныеДокумента.УслугаПоВознаграждению.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеПолное,
	|	ДанныеДокумента.УслугаПоВознаграждению.Артикул КАК НоменклатураАртикул,
	|	"""" КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.СуммаВознаграждения КАК Цена,
	|	1 КАК Количество,
	|	ДанныеДокумента.СуммаВознаграждения КАК Сумма,
	|	ДанныеДокумента.СтавкаНДСВознаграждения КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.СтавкаНДСВознаграждения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК УчитыватьНДС,
	|	&ПолеСуммаВключаетНДС КАК СуммаВключаетНДС 
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &ТекущийДокумент";
	
	ПолеСуммаВключаетНДС = "ИСТИНА";
	
	Если ЭтоКонфигурацияБП() Тогда
		ПолеСуммаВключаетНДС = "ДанныеДокумента.СуммаВключаетНДС";
	КонецЕсли;
	
	Результат = СтрЗаменить(
		Результат,
		"&ПолеСуммаВключаетНДС",
		ПолеСуммаВключаетНДС
	);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДанныеДокумента_РеализацияУслугПоПереработке()
	
	Результат =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДанныеДокумента.ДоговорКонтрагента.УчетАгентскогоНДС, ЛОЖЬ) КАК УчетАгентскогоНДС,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента,
	|	ДанныеДокумента.УчитыватьНДС КАК УчитыватьНДС
	|ИЗ
	|	Документ.РеализацияУслугПоПереработке КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &ТекущийДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НаименованиеПолное,
	|	"""" КАК ХарактеристикаНоменклатуры,
	|	0 КАК Скидка,
	|	ДанныеДокумента.Содержание КАК Содержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	ДанныеДокумента.Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.РеализацияУслугПоПереработке.Услуги КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &ТекущийДокумент";
	
	Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
		
		Результат = Результат + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2,
		|	ДанныеДокумента.НомерСтроки,
		|	ДанныеДокумента.Номенклатура,
		|	&ПолеНоменклатураНаименование,
		|	"""",
		|	NULL,
		|	"""",
		|	&ПолеНоменклатураАртикул,
		|	ДанныеДокумента.ЕдиницаИзмерения,
		|	ДанныеДокумента.Количество,
		|	ДанныеДокумента.Цена,
		|	ДанныеДокумента.СтавкаНДС,
		|	ДанныеДокумента.Сумма,
		|	ДанныеДокумента.СуммаНДС
		|ИЗ
		|	Документ.РеализацияУслугПоПереработке.Продукция КАК ДанныеДокумента
		|ГДЕ
		|	ДанныеДокумента.Ссылка = &ТекущийДокумент
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерТабличнойЧасти,
		|	НомерСтроки";
		
	КонецЕсли;	
	
	ПсевдонимТаблицы = "ДанныеДокумента";
	
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(
		Результат,
		ПсевдонимТаблицы
	);
	
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(
		Результат,
		ПсевдонимТаблицы
	);
		
	Возврат Результат;
	
КонецФункции

