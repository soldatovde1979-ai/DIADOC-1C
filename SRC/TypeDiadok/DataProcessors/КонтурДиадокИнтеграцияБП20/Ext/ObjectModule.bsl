Функция УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы)
	
	Результат = Контракт_СлужебнаяИнформацияСтроки();
	
	Результат.ЕдиницаИзмерения = СтрокаТаблицы.ЕдиницаИзмерения;
	Результат.Номенклатура = СтрокаТаблицы.Товар;
	Результат.СтранаПроисхождения = СтрокаТаблицы.СтранаПроисхождения;
	Результат.СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
	Результат.НомерГТД = СтрокаТаблицы.НомерГТД;
	Результат.ПрослеживаемыйТовар = СтрокаТаблицы.ПрослеживаемыйТовар;
	Результат.ДокументОтгрузки = СтрокаТаблицы.Ссылка;
	Результат.ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
	Результат.ПутьКИдентификаторуСтроки = СтрокаТаблицы.ИмяТабличнойЧасти;
	
	Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
		УПД970_ДополнитьСлужебнуюИнформациюItemДаннымиУПП13(Результат, СтрокаТаблицы);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДополнитьСлужебнуюИнформациюItemДаннымиУПП13(Результат, СтрокаТаблицы)
	
	Результат.Серия = СтрокаТаблицы["СерияНоменклатуры"];
	Результат.Характеристика = СтрокаТаблицы["ХарактеристикаНоменклатуры"];
	
КонецПроцедуры

Функция УПД970_ДокументыОснованияСчетФактураВыданный(ДокументСсылка)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Основания.ДокументОснование
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Основания
	|ГДЕ
	|	Основания.Ссылка = &Ссылка"
	);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОСведенияОбОрганизации(ДанныеШапки)
	
	ЭтоОПнаОтдельномБалансе = ЭтоОбособленноеПодразделениеНаОтдельномБалансе(ДанныеШапки.Организация);
	ЭтоОПнаОбщемБалансе = ЭтоОбособленноеПодразделениеНаОбщемБалансе(ДанныеШапки.ПодразделениеОрганизации);
	
	Если ЭтоОПнаОтдельномБалансе Тогда
		Организация = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Организация, "ГоловнаяОрганизация");
	Иначе
		Организация = ДанныеШапки.Организация;
	КонецЕсли;
	
	БанковскийСчетОрганизации = ДанныеШапки.БанковскийСчетОрганизации;
	
	СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Организация,
		ДанныеШапки.Дата,
		БанковскийСчетОрганизации);
		
	Если ЭтоОПнаОтдельномБалансе Тогда
			
		КПП = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Организация, "КПП");
		
	ИначеЕсли ЭтоОПнаОбщемБалансе Тогда
		
		КПП = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.ПодразделениеОрганизации, "КПП");
		
	Иначе
		
		КПП = СведенияОбОрганизации.КПП;
		
	КонецЕсли;
	
	СведенияОбОрганизации.КПП = КПП;
	
	Возврат СведенияОбОрганизации;
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОПродавце(Контент, ТаблицаДанныеШапки)
	
	// Продавец
	
	Для Каждого ДанныеШапки Из ТаблицаДанныеШапки Цикл
		
		СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДОСведенияОбОрганизации(ДанныеШапки);
		
		Seller = Контракт_ExtendedOrganizationInfo970();
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, СведенияОбОрганизации);
		Seller.СлужебнаяИнформация.Ссылка = СведенияОбОрганизации.Ссылка;
		
		Контент.Sellers.Добавить(Seller);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПокупателе(Контент, ДанныеШапки, КППКонтрагентаПоДокументу = Неопределено)

	// Покупатель
	ЭтоОПКонтрагентаНаОтдельномБалансе = ЭтоОбособленноеПодразделениеНаОтдельномБалансе(ДанныеШапки.Контрагент);
	
	Если ЭтоОПКонтрагентаНаОтдельномБалансе Тогда
		Контрагент = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Контрагент, "ГоловнойКонтрагент");
	Иначе
		Контрагент = ДанныеШапки.Контрагент;
	КонецЕсли;
	
	СведенияОКонтрагенте = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Контрагент,
		ДанныеШапки.Дата);
		
	Если ЗначениеЗаполнено(КППКонтрагентаПоДокументу) Тогда
		КППКонтрагента = КППКонтрагентаПоДокументу;
	ИначеЕсли ЭтоОПКонтрагентаНаОтдельномБалансе Тогда
		КППКонтрагента = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Контрагент, "КПП");
	Иначе
		КППКонтрагента = СведенияОКонтрагенте.КПП;
	КонецЕсли;
	
	СведенияОКонтрагенте.КПП = КППКонтрагента;
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	Контент.Buyers.Добавить(Buyer);
	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, СведенияОКонтрагенте);
	Buyer.СлужебнаяИнформация.Ссылка = СведенияОКонтрагенте.Ссылка;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГрузоотправителе(Контент, ТаблицаДанныеШапки)

	// Грузоотправитель
	Для Каждого ДанныеШапки Из ТаблицаДанныеШапки Цикл
		
		ЭтоОПнаОтдельномБалансе = ЭтоОбособленноеПодразделениеНаОтдельномБалансе(ДанныеШапки.Организация);
		ЭтоОПнаОбщемБалансе = ЭтоОбособленноеПодразделениеНаОбщемБалансе(ДанныеШапки.ПодразделениеОрганизации);
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
			
			СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
				ДанныеШапки.Грузоотправитель,
				ДанныеШапки.Дата);
				
		ИначеЕсли ЭтоОПнаОтдельномБалансе Тогда
			
			СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
				ДанныеШапки.Организация,
				ДанныеШапки.Дата);
			
		ИначеЕсли ЭтоОПнаОбщемБалансе Тогда
			
			СведенияОГрузоотправителе = УПД970_СведенияОПодразделенииОрганизации(
				ДанныеШапки.Организация,
				ДанныеШапки.ПодразделениеОрганизации,
				ДанныеШапки.Дата);
			
		ИначеЕсли ДанныеШапки.Грузоотправитель <> Неопределено Тогда
			
			СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОСведенияОбОрганизации(ДанныеШапки);
			
		Иначе
			
			СведенияОГрузоотправителе = Неопределено;
			
		КонецЕсли;
		
		Если СведенияОГрузоотправителе <> Неопределено Тогда
			
			Shipper = Контракт_Shipper970();
			Shipper.SameAsSeller = Ложь;
			
			СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДОСведенияОбОрганизации(ДанныеШапки);
			
			Если СведенияОГрузоотправителе.Ссылка = СведенияОбОрганизации.Ссылка Тогда
				
				Shipper.SameAsSeller = Истина;
				
			Иначе
				
				ShipperInfo = Контракт_ExtendedOrganizationInfo970();
				УПД970_ЗаполнитьExtendedOrganizationInfo(ShipperInfo, СведенияОГрузоотправителе);
				ShipperInfo.СлужебнаяИнформация.Ссылка = СведенияОГрузоотправителе.Ссылка;
				Shipper.OrganizationInfo = ShipperInfo;
				
			КонецЕсли;
			
			Контент.Shippers.Добавить(Shipper);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГрузополучателе(Контент, ДанныеШапки)

	// Грузополучатель
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		
		СведенияОГрузополучателе = УПД970_ДанныеГрузополучателя(
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата,
			ДанныеШапки.АдресДоставки);
		
	ИначеЕсли ДанныеШапки.Грузополучатель <> Неопределено Тогда
		
		СведенияОГрузополучателе = УПД970_ДанныеГрузополучателя(
			ДанныеШапки.Контрагент,
			ДанныеШапки.Дата,
			ДанныеШапки.АдресДоставки);
			
	Иначе
		
		СведенияОГрузополучателе = Неопределено;
		
	КонецЕсли;
	
	Если СведенияОГрузополучателе <> Неопределено Тогда
		
		Consignee = Контракт_ExtendedOrganizationInfo970();
		Контент.Consignees.Добавить(Consignee);

		УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, СведенияОГрузополучателе);
		
		Consignee.СлужебнаяИнформация.Ссылка = СведенияОГрузополучателе.Ссылка;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОбУчастникахЭДОВнутреннегоДО(Контент, ДанныеШапки)
	
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахВнутреннегоЭДО(ДанныеШапки);
	
	Seller = Контракт_ExtendedOrganizationInfo970();
	Контент.Sellers.Добавить(Seller);
	УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, СведенияОбУчастникахЭДО.Организация);
	Seller.СлужебнаяИнформация.Ссылка = СведенияОбУчастникахЭДО.Организация.Ссылка;
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	Контент.Buyers.Добавить(Buyer);
	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, СведенияОбУчастникахЭДО.Контрагент);
	Buyer.СлужебнаяИнформация.Ссылка = СведенияОбУчастникахЭДО.Контрагент.Ссылка;
	
	Shipper = Контракт_Shipper970();
	Shipper.SameAsSeller = Ложь;
	Контент.Shippers.Добавить(Shipper);
	ShipperInfo = Контракт_ExtendedOrganizationInfo970();
	Shipper.OrganizationInfo = ShipperInfo;
	УПД970_ЗаполнитьExtendedOrganizationInfo(ShipperInfo, СведенияОбУчастникахЭДО.Грузоотправитель);
	ShipperInfo.Department = ДанныеШапки.СкладОтправительПредставление;
	
	Consignee = Контракт_ExtendedOrganizationInfo970();
	Контент.Consignees.Добавить(Consignee);
	УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, СведенияОбУчастникахЭДО.Грузополучатель);
	Consignee.Department = ДанныеШапки.СкладПолучательПредставление;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(Контент, РезультатПоДокументамОплаты)
	
	ВыборкаПоДокументамОплаты = РезультатПоДокументамОплаты.Выбрать();
	Пока ВыборкаПоДокументамОплаты.Следующий() Цикл
		
		PaymentDocument = Контракт_PaymentDocumentInfo();
		
		PaymentDocument.Number = ВыборкаПоДокументамОплаты.НомерДокумента;
		PaymentDocument.Date = ВыборкаПоДокументамОплаты.ДатаДокумента;
		
		Контент.PaymentDocuments.Добавить(PaymentDocument);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьИдентификаторГосКонтракта(Контент, ДанныеШапки)

	Если ЭтоКонфигурацияБП() Тогда
		УПД970_ЗаполнитьИдентификаторГосКонтракта_БП20(Контент, ДанныеШапки)
	Иначе
		УПД970_ЗаполнитьИдентификаторГосКонтракта_УПП13(Контент, ДанныеШапки)
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_СведенияОбУчастникахВнутреннегоЭДО(ДанныеШапки)
	
	СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДО(ДанныеШапки.Организация, ДанныеШапки.Дата);
	
	ЭтоОбособленноеПодразделение = ЭтоОбособленноеПодразделениеНаОбщемБалансе(ДанныеШапки.ПодразделениеОтправитель);
	
	Если ЭтоОбособленноеПодразделение Тогда
		
		СведенияОГрузоотправителе = УПД970_СведенияОПодразделенииОрганизации(
			ДанныеШапки.Организация,
			ДанныеШапки.ПодразделениеОтправитель,
			ДанныеШапки.Дата
		);
		СведенияОГрузоотправителе.Адрес = УПД970_СведенияОбАдресеСклада(ДанныеШапки.ПодразделениеОтправитель);
		
	Иначе
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДО(
			ДанныеШапки.Организация,
			ДанныеШапки.Дата
		);
		Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
			СведенияОГрузоотправителе.Адрес = УПД970_СведенияОбАдресеСклада(ДанныеШапки.СкладОтправитель);
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтоОбособленноеПодразделение = ЭтоОбособленноеПодразделениеНаОбщемБалансе(ДанныеШапки.ПодразделениеПолучатель);
	
	Если ЭтоОбособленноеПодразделение Тогда
		
		СведенияОГрузополучателе = УПД970_СведенияОПодразделенииОрганизации(
			ДанныеШапки.Организация,
			ДанныеШапки.ПодразделениеПолучатель,
			ДанныеШапки.Дата
		);
		СведенияОГрузополучателе.Адрес = УПД970_СведенияОбАдресеСклада(ДанныеШапки.ПодразделениеПолучатель);
		
	Иначе
		
		СведенияОГрузополучателе = УПД970_ДанныеУчастникаЭДО(
			ДанныеШапки.Организация,
			ДанныеШапки.Дата
		);
		Если ЭтоКонфигурацияУПП() Или ЭтоКонфигурацияКА() Тогда
			СведенияОГрузополучателе.Адрес = УПД970_СведенияОбАдресеСклада(ДанныеШапки.СкладПолучатель);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = УПД970_Контракт_УчастникиЭДО();
	Результат.Организация = СведенияОбОрганизации;
	Результат.Контрагент = СведенияОбОрганизации;
	Результат.Грузоотправитель = СведенияОГрузоотправителе;
	Результат.Грузополучатель = СведенияОГрузополучателе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсЮрАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОбЮридическомАдресе(Ссылка);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсФактАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОФактическомАдресе(Ссылка);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеГрузополучателя(Ссылка, ДатаСведений, Знач АдресДоставки)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений);
	
	АдресДоставки = СокрЛП(АдресДоставки);
	
	Если ЗначениеЗаполнено(АдресДоставки) Тогда
		СведенияОбАдресе = УПД970_СведенияОбАдресеДоставки(Ссылка, АдресДоставки);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		СведенияОбАдресе = УПД970_СведенияОФактическомАдресе(Ссылка);
	КонецЕсли;
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_Контракт_УчастникиЭДО()

	Результат = Новый Структура;
	
	Результат.Вставить("Организация");
	Результат.Вставить("Контрагент");
	Результат.Вставить("Грузоотправитель");
	Результат.Вставить("Грузополучатель");

	Возврат Результат;
	
КонецФункции

Функция УПД970_ПредставлениеХарактеристикиИСерии(ДанныеТабличнойЧасти)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.ХарактеристикаНоменклатуры) Тогда
		Результат = " (" + стрЗаменить(ДанныеТабличнойЧасти.ХарактеристикаНоменклатуры, "<>", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.СерияНоменклатуры) Тогда
		
		ПредставлениеСерии = стрЗаменить(ДанныеТабличнойЧасти.СерияНоменклатуры, "<>", "");
		
		Результат = ?(стрДлина(Результат) = 0, " (", Результат + "; ") + ПредставлениеСерии;
		
	КонецЕсли;
	
	Результат = ?(Результат = "", "", Результат + ")");
	
