Функция СтрокаИсправленийСФ(Invoices)
	
	Результат = "";
	Разделитель = "";
	
	КоличествоИсправлений = 0;
	
	Для Каждого Invoice Из Invoices Цикл
		
		Для Каждого InvoiceRevision Из Invoice.InvoiceRevisions Цикл
			
			КоличествоИсправлений = КоличествоИсправлений + 1;
			
			Результат = Результат + Разделитель
			+ "№ " + InvoiceRevision.RevisionNumber
			+ " от " + ДатаСтрокой(InvoiceRevision.RevisionDate);
			
			Разделитель = ", ";
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если КоличествоИсправлений = 0 Тогда
		Результат = "исправления № - от - ";
	ИначеЕсли КоличествоИсправлений = 1 Тогда
		Результат = "исправления " + Результат;
	Иначе
		Результат = "исправлений " + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
