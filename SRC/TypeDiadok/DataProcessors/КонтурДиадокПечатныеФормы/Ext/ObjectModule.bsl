// Проверяет, что это ставка прямого налогообложения.
// Проверка основана на исключении особых случаев налогообложения: 
// НДС не облагается или НДС исчисляется налоговым агентом.
//
// Параметры:
//  TaxRate - Строка - значение ставки НДС.
// 
// Возвращаемое значение:
//  Булево - Истина, если это основная (20%), пониженная (10%) или нулевая (0%) ставка НДС.
//
Функция ЭтоПрямаяСтавкаНДС(Знач TaxRate)
	
	Результат = Истина;
	
	ПроверяемоеЗначение = НРег(TaxRate);
	СтавкаИсчНалАг = НРег("ИсчНалАг");
	СтавкаБезНДС = НРег(СтрокаБезНДС());
	
	Если ПроверяемоеЗначение = СтавкаБезНДС
		Или ПроверяемоеЗначение = СтавкаИсчНалАг Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьСтрокиСПрямымиСтавкамиНДС736(Контент736)
	
	Результат = Ложь;
	
	СтрокиУКД = Контент736.InvoiceCorrectionTable.Items;
	
	Для Каждого СтрокаТЧ Из СтрокиУКД Цикл
		
		СтавкаПослеИзменения = СтрокаТЧ.CorrectedValues.TaxRate;
		
		Если ЭтоПрямаяСтавкаНДС(СтавкаПослеИзменения) Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВСтрокахУКДЕстьУвеличениеУменьшение(ExtendedInvoiceCorrectionItems)
	
	ЕстьУвеличение = Ложь;
	ЕстьУменьшение = Ложь;
	
	Для Каждого ExtendedInvoiceCorrectionItem Из ExtendedInvoiceCorrectionItems Цикл
		
		Если (ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsInc.TotalWithVatExcluded) Или ExtendedInvoiceCorrectionItem.AmountsInc.TotalWithVatExcluded = 0)
			И (ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsInc.Vat) Или ExtendedInvoiceCorrectionItem.AmountsInc.Vat = 0) Тогда
			ЕстьУвеличение = Истина;
		КонецЕсли;
		
		Если (ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsDec.TotalWithVatExcluded) Или ExtendedInvoiceCorrectionItem.AmountsDec.TotalWithVatExcluded = 0) 
			И (ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsDec.Vat) Или ExtendedInvoiceCorrectionItem.AmountsDec.Vat = 0) Тогда
			ЕстьУменьшение = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("ЕстьУвеличение, ЕстьУменьшение", ЕстьУвеличение, ЕстьУменьшение);
	
