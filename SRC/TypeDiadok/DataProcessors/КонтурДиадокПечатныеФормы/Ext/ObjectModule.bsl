			Если ЗначениеЗаполнено(CustomDeclaration.CountryCode) ИЛИ ЗначениеЗаполнено(CustomDeclaration.DeclarationNumber) Тогда
				
				НаименованиеСтраны = НаименованиеСтраны(CustomDeclaration.CountryCode);
				
				Результат.Страны 	= Результат.Страны	  + Разделитель + СтрокаИлиДефис(НаименованиеСтраны);
				Результат.КодыСтран	= Результат.КодыСтран + Разделитель + СтрокаИлиДефис(CustomDeclaration.CountryCode);
				Результат.НомераТД	= Результат.НомераТД  + Разделитель + СтрокаИлиДефис(CustomDeclaration.DeclarationNumber);
				
				Разделитель = Символы.ПС;
				
			КонецЕсли;
			
