Процедура ПФ_Акт_УПД_ШапкаДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата  = ДатаСтрокой(Content.Date);
	
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.RevisionNumber);
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.RevisionDate);
	
	Таб.Вывести(Область);
	
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаЗаголовок");
	
	Исполнитель = Content.Seller.Name;
	Заказчик = Content.Buyer.Name;
	
	Область.Параметры.Заголовок = Исполнитель + " выполнил, " + Заказчик + " принял следующие работы (услуги)";
	
	Таб.Вывести(Область);
	
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferBases) Тогда
		Область = Параметры.Макет.ПолучитьОбласть("ШапкаОснования");
		Область.Параметры.Основания = СтрокаДокументыОснованияУПД(Content.TransferInfo.TransferBases);
		Таб.Вывести(Область);
	КонецЕсли;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_Акт_УПД_ШапкаТаблицы(Таб, Параметры)
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
КонецПроцедуры

Процедура ПФ_Акт_УПД_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.InvoiceTable.Items Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
