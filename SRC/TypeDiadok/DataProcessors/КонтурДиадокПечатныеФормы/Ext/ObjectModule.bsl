// Возвращает ключи сведений о таможенной декларации и стране происхождения.
//
// Возвращаемое значение:
//   Структура - Ключи сведений о ТД
//
Функция Перечисление_ИдентификаторыСведенийОСтранеПроисхождения()

	СведенияТД = Новый Структура;
	СведенияТД.Вставить("КодСтраны"				, "цифровой код страны происхождения");
	СведенияТД.Вставить("НаименованиеСтраны"	, "краткое наименование страны происхождения");
