КонецФункции

// Возвращает новую структуру с разделами,
// в которые могут быть помещены дополнительные сведения
// 
// Возвращаемое значение:
//  Структура - содержит поля, в которые можно поместить доп. сведения:
//   * head   - над шапкой документа
//   * top    - над табличной частью
//   * bottom - под табличной частью
//   * ground - в подвале документа
//
Функция НовыеДопСведенияПоРазделам()
	
	Результат = Новый Структура;
	Результат.Вставить("head"	, "");
	Результат.Вставить("top"	, "");
	Результат.Вставить("bottom"	, "");
	Результат.Вставить("ground"	, "");
	
	Возврат Результат;
	
КонецФункции

// Добавляет в параметры печатной формы свойство ДопСведения
//
// Параметры:
//  Параметры - Структура  - содержит поля:
//   * ПоказатьДопСведения - Булево - Истина, если доп. сведения
//                                    нужно отобразить в печатной форме
//  ИсходныеДанные - Строка, Массив - см. функцию ДопСведенияПоРазделам()
//
Процедура ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, ИсходныеДанные)
	
	Если Параметры.ПоказатьДопСведения
		И ЗначениеЗаполнено(ИсходныеДанные) Тогда
		
		СтруктураДопСведений = ДопСведенияПоРазделам(ИсходныеДанные);
	Иначе
		СтруктураДопСведений = НовыеДопСведенияПоРазделам();
	КонецЕсли;
	
	Параметры.Вставить("ДопСведения", СтруктураДопСведений);
	
КонецПроцедуры

// Соединяет коллекцию строк доп. сведений в одну строку
//
// Параметры:
//  ИсходныеДанные - Массив - содержит структуры с полями:
//                    * Key   - Строка - ключ дополнительных сведений
//                    * Value - Строка - значение дополнительных сведений
// 
// Возвращаемое значение:
//  Строка
//
Функция ДопСведенияСтрокой(ИсходныеДанные)
	
	Результат = "";
	
	Для Каждого Элемент Из ИсходныеДанные Цикл
		
		Ключ	 = Элемент.Key;
		Значение = Элемент.Value;
		
		Если Ключ = "_" Тогда
			Ключ = "";
		КонецЕсли;
		
		Результат = ДополнитьСтрокуДопСведений(Результат, Значение, Ключ);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разделяет коллекцию строк доп. сведений на разделы
//
// Параметры:
//  ИсходныеДанные - Строка - значение дополнительных сведений
//                 - Массив - содержит структуры с полями:
//                    * Key   - Строка - ключ дополнительных сведений
//                    * Value - Строка - значение дополнительных сведений
// 
// Возвращаемое значение:
//  Структура - см. функцию НовыеДопСведенияПоРазделам()
//
Функция ДопСведенияПоРазделам(ИсходныеДанные)
	
	Если ТипЗнч(ИсходныеДанные) = Тип("Строка") Тогда
		МассивДопСведений = ЗначениеВМассивKeyValue(ИсходныеДанные);
	Иначе
		МассивДопСведений = ИсходныеДанные;
	КонецЕсли;
	
	Результат = НовыеДопСведенияПоРазделам();
	
	Для Каждого Элемент Из МассивДопСведений Цикл
		
		Ключ	 = Элемент.Key;
		Значение = Элемент.Value;
		
		Если Ключ = "_" Тогда
			Ключ = "";
		КонецЕсли;
		
		СтруктураДопСведений = РазделитьСтрокуДопСведенийПоРазделам(Значение);
		
		Если ЗначениеЗаполнено(СтруктураДопСведений) Тогда
			ДополнитьРазделыДопСведений(Результат, СтруктураДопСведений, Ключ);
		Иначе
			Результат.top = ДополнитьСтрокуДопСведений(Результат.top, Значение, Ключ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разделяет строку дополнительных сведений на разделы
//
// Параметры:
//  СтрокаДопСведений - Строка - значение дополнительных сведений
// 
// Возвращаемое значение:
//  Структура - см. функцию НовыеДопСведенияПоРазделам()
//
Функция РазделитьСтрокуДопСведенийПоРазделам(СтрокаДопСведений)
	
	РазделыЗаполнены	 = Ложь;
	СтрокаДляПоиска		 = НРег(СтрокаДопСведений);
	СтруктураДопСведений = НовыеДопСведенияПоРазделам();
	
	Для Каждого Элемент Из СтруктураДопСведений Цикл
		
		Раздел = Элемент.Ключ;
		
		Тег = "<" + Раздел + ">";
		ПозНачало = Найти(СтрокаДляПоиска, Тег);
		
		Если ПозНачало > 0 Тогда
			ПозНачало = ПозНачало + СтрДлина(Тег);
		КонецЕсли;
		
		Тег = "</" + Раздел + ">";
		ПозКонец = Найти(СтрокаДляПоиска, Тег);
		
		Если ПозНачало > 0 И ПозКонец > 0 Тогда
			
			ДлинаСтроки = ПозКонец - ПозНачало;
			ЗначениеРаздела = Сред(СтрокаДопСведений, ПозНачало, ДлинаСтроки);
			ЗначениеРаздела = СокрЛП(ЗначениеРаздела);
			
			СтруктураДопСведений[Раздел] = СтруктураДопСведений[Раздел] + ЗначениеРаздела;
			
			РазделыЗаполнены = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РазделыЗаполнены Тогда
		Результат = СтруктураДопСведений;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополняет разделы доп. сведений приемника данными из разделов доп. сведений источника
//
// Параметры:
//  Приемник        - Структура - см. функцию НовыеДопСведенияПоРазделам()
//  Источник        - Структура - см. функцию НовыеДопСведенияПоРазделам()
//  КлючДопСведений - Строка    - ключ дополнительных сведений источника
//
Процедура ДополнитьРазделыДопСведений(Приемник, Источник, КлючДопСведений)
	
	Для каждого Элемент Из Приемник Цикл
		
		Раздел = Элемент.Ключ;
		ЗначениеПриемника = Приемник[Раздел];
		ЗначениеИсточника = Источник[Раздел];
		
		Если ЗначениеЗаполнено(ЗначениеИсточника) Тогда
			
			ЗначениеРаздела	 = ДополнитьСтрокуДопСведений(ЗначениеПриемника, ЗначениеИсточника, КлючДопСведений);
			Приемник[Раздел] = ЗначениеРаздела;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Дополняет строку доп. сведений новым ключем и значением
//
// Параметры:
//  СтрокаДопСведений - Строка - строка, в которую нужно добавить новые дополнительные сведения
//  Значение          - Строка - значение новых дополнительных сведений
//  Ключ              - Строка - ключ новых дополнительных сведений
// 
// Возвращаемое значение:
//  Строка
//
Функция ДополнитьСтрокуДопСведений(СтрокаДопСведений, Значение, Ключ)
	
	РазделительКлюча		 = "";
	РазделительДопСведений	 = "";
	
	Если ЗначениеЗаполнено(Ключ) Тогда
		РазделительКлюча = ": ";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
		РазделительДопСведений = ", ";
	КонецЕсли;
	
	Результат = СтрокаДопСведений + РазделительДопСведений + Ключ + РазделительКлюча + Значение;
	
	Возврат Результат;
	
КонецФункции

Функция ДопСведенияСтрокиУПД(Item)
	
	Результат = ДопСведенияСтрокой(Item.StructedAdditionalInfos);
	
	Если НЕ ЗначениеЗаполнено(Результат) И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Item, "AdditionalProperty") Тогда
		Результат = СокрЛП(Item.AdditionalProperty);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйТабличныйДокумент(ИмяПараметровПечати, _ОриентацияСтраницы = Неопределено)
	
	Если _ОриентацияСтраницы = Неопределено Тогда
		_ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	КонецЕсли;
	
	Результат = Новый ТабличныйДокумент;
	Результат.ОриентацияСтраницы  = _ОриентацияСтраницы;
	Результат.АвтоМасштаб		  = Истина;
	
	Если Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт Тогда
		
		Результат.ПолеСлева  = 10;
		Результат.ПолеСправа = 10;
		Результат.ПолеСверху = 15;
		Результат.ПолеСнизу  = 10;
		
	Иначе
		
		Результат.ПолеСлева  = 15;
		Результат.ПолеСправа = 10;
		Результат.ПолеСверху = 10;
		Результат.ПолеСнизу  = 10;
		
	КонецЕсли; 
	
	Результат.ИмяПараметровПечати = ИмяПараметровПечати;
	
	Возврат Результат;
	
КонецФункции

Функция ОбластьДопСведений(Макет, ИмяОбласти, ДопСведения)
	
	Область = Макет.ПолучитьОбласть(ИмяОбласти); 
	
	Область.Параметры.ДопСведения = ДопСведения;
	
	Возврат Область;
	
КонецФункции

Процедура ДобавитьДопСведения(Таб, Макет, ИмяОбласти, ДопСведения)
	
	Если ЗначениеЗаполнено(ДопСведения) Тогда
		
		Таб.Вывести(ОбластьДопСведений(Макет, ИмяОбласти, ДопСведения));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаЭлектроннойПодписи(Подпись)
	
	Результат = Подпись.SignDate;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Подпись.SignatureAuthenticityDate;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РасшифровкаРезультатаПроверкиПодписиОтправителя(СтатусПодписиОтправителя)
	
	Если СтатусПодписиОтправителя = "SenderSignatureUnchecked" Тогда
		Результат = "Идет доставка подписи";
	ИначеЕсли СтатусПодписиОтправителя = "SenderSignatureCheckedAndValid" Тогда
		Результат = "Соответствует файлу документа";
	Иначе
		Результат = "Не подтверждена";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Штамп_ЗаполнитьОбщиеРеквизиты(Область, МетаданныеДокумента)
	
	МеткаВремени = МетаданныеДокумента.Timestamp;
	Область.Параметры.ДатаОтправки  = ДатаСтрокой(МеткаВремени);
	Область.Параметры.ВремяОтправки = Формат(МеткаВремени, "ДФ=ЧЧ:мм:сс");
	
	ДлинаUUID = 36;
	ПолныйИдентификаторДокумента = МетаданныеДокумента.DocumentID;
	Область.Параметры.ИдентификаторДокумента = Прав(ПолныйИдентификаторДокумента, ДлинаUUID);
	
КонецПроцедуры

Процедура Штамп_ЗаполнитьСторонуОтправителя(Область, ПодписьОтправителя, МетаданныеДокумента)
	
	ДатаПодписи = ДатаЭлектроннойПодписи(ПодписьОтправителя);
	
	Область.Параметры.Отправитель = МетаданныеДокумента.SenderName;
	Область.Параметры.ОтправительПодписант = ПодписьОтправителя.Certificate.Name;
	Область.Параметры.ОтправительДолжность = ПодписьОтправителя.Certificate.JobTitle;
	Область.Параметры.ОтправительДатаПодписи = ДатаСтрокой(ДатаПодписи);
	
	Штамп_ЗаполнитьРезультатПроверкиПодписиОтправителя(Область, МетаданныеДокумента);
	
КонецПроцедуры

Процедура Штамп_ЗаполнитьРезультатПроверкиПодписиОтправителя(Область, МетаданныеДокумента)
	
	СтатусПодписиОтправителя = МетаданныеДокумента.SenderSignatureStatus;
	РасшифровкаРезультатаПроверки = РасшифровкаРезультатаПроверкиПодписиОтправителя(СтатусПодписиОтправителя);
	Область.Параметры.ОтправительПроверкаПодписи = РасшифровкаРезультатаПроверки;
	
КонецПроцедуры

Процедура Штамп_ЗаполнитьСторонуПолучателя(Область, ПодписьПолучателя, МетаданныеДокумента)
	
	Если Не ЗначениеЗаполнено(ПодписьПолучателя.Certificate.Name) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаПодписи = ДатаЭлектроннойПодписи(ПодписьПолучателя);
	
	Область.Параметры.Получатель = МетаданныеДокумента.RecipientName;
	Область.Параметры.ПолучательПодписант = ПодписьПолучателя.Certificate.Name;
	Область.Параметры.ПолучательДолжность = ПодписьПолучателя.Certificate.JobTitle;
	Область.Параметры.ПолучательДатаПодписи = ДатаСтрокой(ДатаПодписи);
	
	Штамп_ЗаполнитьРезультатПроверкиПодписиПолучателя(Область, ПодписьПолучателя);
	
КонецПроцедуры

Процедура Штамп_ЗаполнитьРезультатПроверкиПодписиПолучателя(Область, ПодписьПолучателя)
	
	Если ЗначениеЗаполнено(ПодписьПолучателя.SignatureAuthenticityDate) Тогда
		РасшифровкаРезультатаПроверки = "Соответствует файлу документа";
	Иначе
		РасшифровкаРезультатаПроверки = "Не подтверждена";
	КонецЕсли;
	
	Область.Параметры.ПолучательПроверкаПодписи = РасшифровкаРезультатаПроверки;
	
КонецПроцедуры

Процедура ДобавитьШтамп(Таб, ДанныеШтампа)
	
	Если Не ЗначениеЗаполнено(ДанныеШтампа) Тогда
		Возврат;
	КонецЕсли;
	
	ПодписьОтправителя = ДанныеШтампа.SenderSignature;
	
	Если Не ЗначениеЗаполнено(ПодписьОтправителя.Certificate.Name) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеШтампа.Свойство("ШтампБезПечати") И ДанныеШтампа.ШтампБезПечати = Истина Тогда
		Область = ПолучитьМакет("Штампы").ПолучитьОбласть("ШтампБезПечати");
	Иначе
		Область = ПолучитьМакет("Штампы").ПолучитьОбласть("Штамп");
	КонецЕсли;
	
	ПодписьПолучателя = ДанныеШтампа.RecipientSignature;
	МетаданныеДокумента = ДанныеШтампа.DocumentMetaData;
	
	Штамп_ЗаполнитьОбщиеРеквизиты(Область, МетаданныеДокумента);
	Штамп_ЗаполнитьСторонуОтправителя(Область, ПодписьОтправителя, МетаданныеДокумента);
