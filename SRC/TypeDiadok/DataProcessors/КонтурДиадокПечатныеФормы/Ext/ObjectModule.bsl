Функция СтрокаНаименованиеСтрокиНакладной(Item)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Item, "VendorCode")
		И ЗначениеЗаполнено(Item.VendorCode) Тогда
		Артикул = Item.VendorCode;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Item, "Article") 
		И ЗначениеЗаполнено(Item.Article) Тогда
		Артикул = Item.Article;
	Иначе
		Артикул = "";
	КонецЕсли;
	
	ЧастиНаименования = Новый Массив;
	
	ДополнитьМассивНепустымЗначением(ЧастиНаименования, Item.Product); // Наименование
	ДополнитьМассивНепустымЗначением(ЧастиНаименования, Item.Feature); // Характеристика
	ДополнитьМассивНепустымЗначением(ЧастиНаименования, Item.Sort); // Сорт
	ДополнитьМассивНепустымЗначением(ЧастиНаименования, Артикул); // Артикул
	
	Разделитель = ", ";
	Результат = СоединитьСтроку(ЧастиНаименования, Разделитель);
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаОснованиеНакладной(Name, Number, Date, Info = "")
	
	Результат = Name;
	
	СтрокаНомерДата = "";
	
	// НомОсн
	Если ЗначениеЗаполнено(Number) Тогда
		СтрокаНомерДата = СтрокаНомерДата + " № " + Number;
	КонецЕсли;
	
	// ДатаОсн
	Если ЗначениеЗаполнено(Date) Тогда
		СтрокаНомерДата = СтрокаНомерДата + " от " + ДатаСтрокой(Date);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаНомерДата) И Найти(Результат, СтрокаНомерДата) = 0 Тогда
		Результат = Результат + СтрокаНомерДата;
	КонецЕсли;
	
	// ДопСвОсн
	Если ЗначениеЗаполнено(Info) Тогда
		Результат = Результат + ", " + Info;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

