//{ Вспомогательные методы печатных форм

// Возвращает представление числа в указанном формате, число можно передавать строкой.
// Увеличивает точность формата под точность числа, увеличивая в форматной строке значение ключа ЧДЦ=.
//
// Важно! Для числа 0 метод Формат с пустой форматной строкой работает иначе чем преобразование к строке:
// 	Формат(0) = ""
// 	Строка(0) = "0"
//
Функция Число_В_Формат(ЧислоСтрока, Знач ФорматнаяСтрока = "", ПустоеЗначение = Неопределено)
	
	Попытка
		Значение = Число(ЧислоСтрока);
	Исключение
		Значение = ЧислоСтрока;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Значение) И ПустоеЗначение <> Неопределено Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	// Расточка точности форматной строки под точность значения,
	// для отображения значений большей точности чем в указанном формате.
	Если ЗначениеЗаполнено(ФорматнаяСтрока) И ТипЗнч(Значение) = Тип("Число") Тогда
		
		ПозицияЧДЦ = Найти(ФорматнаяСтрока, "ЧДЦ=");
		Если ПозицияЧДЦ > 0 Тогда
			
			ТочностьЗначения = СтрДлина(Сред(СтрЗаменить(Формат(Значение - Цел(Значение), "ЧГ=0"), СтрокаДефис(), ""), 3));
			Если ТочностьЗначения > 0 Тогда
				
				СтрокаЧДЦ = Сред(ФорматнаяСтрока, ПозицияЧДЦ, Найти(Сред(ФорматнаяСтрока, ПозицияЧДЦ), ";") - 1);
				ЗначениеЧДЦ = СтрЗаменить(СтрокаЧДЦ, "ЧДЦ=", "");
				
				Если ЗначениеЗаполнено(ЗначениеЧДЦ) И Число(ЗначениеЧДЦ) < ТочностьЗначения Тогда
					ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, СтрокаЧДЦ, "ЧДЦ=" + Формат(ТочностьЗначения, "ЧГ=0"));
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Формат(Значение, ФорматнаяСтрока);
	
КонецФункции

// Возвращает представление даты в указанном формате, дату можно передавать строкой.
//
// Важно! Для пустой даты метод Формат с пустой форматной строкой работает иначе чем преобразование к строке:
// 	Формат('00010101') = ""
// 	Строка('00010101') = "01.01.0001 0:00:00"
//
Функция Дата_В_Формат(ДатаСтрока, ФорматнаяСтрока = "", ПустоеЗначение = Неопределено)
	
	Если ПустаяСтрока(ДатаСтрока) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Попытка
		Значение = Дата(ДатаСтрока);
	Исключение
		Значение = ДатаСтрока;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Значение) И ПустоеЗначение <> Неопределено Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Возврат Формат(Значение, ФорматнаяСтрока);
	
КонецФункции

// Возвращает представление значения или представление пустого значения
//
// Параметры:
//  Значение       - Произвольный - значение, представление которого нужно получить
//  ПустоеЗначение - Строка       - представление пустого значения
//
// Возвращаемое значение:
//  Строка - представление значения или ПустоеЗначение
//
Функция СтрокаПустоеЗначение(Значение, ПустоеЗначение)
	
	Результат = "";
	
	Попытка
		Результат = Строка(Значение);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ПустоеЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

