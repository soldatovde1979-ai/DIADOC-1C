// Возвращает строку с постановлением редакции УПД в зависимости от даты
//
// Параметры:
//  ДатаРедакции - Дата - значение, представление которого нужно получить
//  БазовыйФормат - Строка - базовый формат документа
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокаРедакцииУПД(ДатаРедакции)
	
	Если ДатаРедакции >= ДатаРедакции1096() Тогда
		
		Результат =
		"(в ред. Постановления Правительства РФ от 16 августа 2024 г. № 1096)
		|(печатная форма может содержать дополнительные реквизиты)";
		
	ИначеЕсли ДатаРедакции >= ДатаРедакции534() Тогда
		
		Результат = 
		"(в ред. Постановления Правительства РФ от 2 апреля 2021 г. N 534)
		|(печатная форма может содержать дополнительные реквизиты)";
		
	ИначеЕсли ДатаРедакции >= ДатаРедакции981() Тогда
		
		Результат =
		"(в ред. Постановления Правительства РФ от 19.08.2017 №981)
		|(печатная форма может содержать дополнительные реквизиты)";
		
	ИначеЕсли ДатаРедакции >= ДатаРедакции625() Тогда
		
		Результат =
		"(в ред. Постановления Правительства РФ от 25.05.2017 №625)
		|(печатная форма может содержать дополнительные реквизиты)";
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

