		Область.Параметры.СуммаНДС = СтрокаСуммаНДС_970(Item.Vat, Item.WithoutVat, Item.TaxRate);
		
		Таб.Вывести(Область);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ПФ_Акт_УПД_970_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	Table = Параметры.Content.Table;
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокой(Table.TotalWithVatExcluded);
	Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Table.Total);
	Область.Параметры.СуммаНДС = ПодвалСуммаНДС_970(Table.Vat, Table.WithoutVat);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Акт_УПД_970_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Seller = ПервыйЭлементКоллекции(Content.Sellers);
	Buyer = ПервыйЭлементКоллекции(Content.Buyers);
	
	Если Content.Table.Total = Неопределено Тогда
		СуммаПрописью = СтрокаДефис();
	Иначе
		СуммаПрописью = СуммаПрописью(Content.Table.Total, Content.Currency);
	КонецЕсли;
	Область.Параметры.СуммаВсегоПрописью = СуммаПрописью;
	
	Если НЕ Значениезаполнено(Content.Table.Vat) Тогда
		СуммаНДСПрописью = СтрокаДефис();
	Иначе
		СуммаНДСПрописью = СуммаПрописью(Content.Table.Vat, Content.Currency);
	КонецЕсли;
	Область.Параметры.СуммаНДСПрописью = СуммаНДСПрописью;
	
	Область.Параметры.ИдентификаторГосконтракта	= Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта = НадписьИдентификаторГосконтракта(Content.DocumentDate);
	
	Область.Параметры.Продавец = Seller.Name;
	Область.Параметры.ПродавецИНН = СтрокаИлиДефис(Seller.Inn);
	Область.Параметры.ПродавецКПП = Seller.Kpp;
	Область.Параметры.ПродавецАдрес = СтрокаАдресТелефонЭлПочта_970(Seller);
	Область.Параметры.ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Seller);
	
	Подписи = СтрокиПодписей_970(Content.Signers);
	Область.Параметры.ПродавецПодписант	= Подписи.ФИО;
	Область.Параметры.ПродавецДолжность = Подписи.Должность;
	
	TransferInfo = Content.TransferInfo;
	Если ЗначениеЗаполнено(TransferInfo.TransferDate) Тогда
		ДатаПодписания = TransferInfo.TransferDate;
	Иначе
		ДатаПодписания = Content.DocumentDate;
	КонецЕсли;
	Область.Параметры.ПродавецДатаПодписания = Формат(ДатаПодписания, "ДФ='dd MMMM yyyy ""года""'");
	
	// Титул покупателя
	Если Параметры.Свойство("BuyerContent")
		И Параметры.BuyerContent <> Неопределено Тогда 
		
		BuyerContent = Параметры.BuyerContent;
		
		Область.Параметры.Покупатель = Buyer.Name;
		Область.Параметры.ПокупательИНН = СтрокаИлиДефис(Buyer.Inn);
		Область.Параметры.ПокупательКПП	= Buyer.Kpp;
		Область.Параметры.СодержаниеОперации = СтрокаСодержаниеОперации_970(BuyerContent);
		
		Employee = BuyerContent.Employee;
		Если ЗначениеЗаполнено(Employee.Surname) Тогда
			
			ФИО	= СтрокаФИО(Employee);
			Должность = Employee.EmployeePosition;
			
		Иначе
			
			ПодписиBuyer = СтрокиПодписей_970(BuyerContent.Signers);
			
			ФИО = ПодписиBuyer.ФИО;
			Должность = ПодписиBuyer.Должность;
			
		КонецЕсли;

		Область.Параметры.ПокупательПодписант = ФИО;
		Область.Параметры.ПокупательДолжность = Должность;
		
		Если ЗначениеЗаполнено(BuyerContent.AcceptanceDate) Тогда 
			ДатаПодписания = BuyerContent.AcceptanceDate;
		Иначе
			ДатаПодписания = Content.DocumentDate;
		КонецЕсли;
		
		Область.Параметры.ПокупательДатаПодписания = Формат(ДатаПодписания, "ДФ='dd MMMM yyyy ""года""'");
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_Акт_552(Параметры)
	
