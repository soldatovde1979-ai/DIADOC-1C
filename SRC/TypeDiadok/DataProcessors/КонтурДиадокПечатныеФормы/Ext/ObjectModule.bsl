	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_СФ1137_" + Параметры.ДатаРедакции);
	
	ПФ_СФ_УПД_ШапкаДокумента(Таб, Параметры);
	ПФ_СФ_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_СтрокиТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_ПодвалТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_СФ_УПД_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата	= ДатаСтрокой(Content.Date);
	
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.RevisionDate);
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.RevisionNumber);
	
	Область.Параметры.Продавец		= Content.Seller.Name;
	Область.Параметры.ПродавецАдрес = СтрокаИлиДефис(СтрокаАдрес(Content.Seller.Address));
	Область.Параметры.ПродавецИНН	= СтрокаИННКПП(Content.Seller);
	
	Область.Параметры.Грузоотправитель = ?(Content.Shipper.SameAsSeller = Истина, "он же", СтрокаНаименованиеАдрес(Content.Shipper.OrganizationInfo));
	Область.Параметры.Грузополучатель  = СтрокаНаименованиеАдрес(Content.Consignee);
	
	Область.Параметры.Покупатель	  = СтрокаИлиДефис(Content.Buyer.Name);
	Область.Параметры.ПокупательАдрес = СтрокаИлиДефис(СтрокаАдрес(Content.Buyer.Address));
	Область.Параметры.ПокупательИНН	  = СтрокаИННКПП(Content.Buyer);
	
	Область.Параметры.Валюта = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Таб.Вывести(Область);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции625() Тогда
		
		Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосконтракта");
		Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
		Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
		
		Таб.Вывести(Область);
		
	КонецЕсли;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_ШапкаТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	НадписьНомерТД = "";
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		НадписьНомерТД = "Регистрационный номер декларации на товары или регистрационный номер партии товара, подлежащего прослеживаемости";
	ИначеЕсли Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
		НадписьНомерТД = "Регистрационный номер таможенной декларации";
	Иначе
		НадписьНомерТД = "Номер таможенной декларации";
	КонецЕсли;
	
	Область.Параметры.НадписьНомерТД = НадписьНомерТД;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_СтрокиТаблицы(Таб, Параметры)
	
	Для каждого Item Из Параметры.Content.InvoiceTable.Items Цикл 
		
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаДефис();
		КонецЕсли;
		
		Область.Параметры.Наименование		  = СтрокаИлиДефис(Item.Product);
		Область.Параметры.ЕдиницаИзмерения 	  = СтрокаЕдиницаИзмерения(Item.UnitCode, Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.UnitCode);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена	      = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		Область.Параметры.СуммаВсего  = СуммаСтрокойИлиДефис(Item.SubTotal);
		Область.Параметры.СтавкаНДС   = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
		Область.Параметры.Акциз		  = СтрокаАкциз(Item.Excise, Item.TaxRate);
		
		Строки = СтрокиНомеровТД(Item.CustomDeclarations);
		Область.Параметры.Страна 	= Строки.Страны;
		Область.Параметры.СтранаКод = Строки.КодыСтран;
		Область.Параметры.НомерТД	= Строки.НомераТД;
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceTable.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Параметры.Content.InvoiceTable.Items) Тогда
		Область.Параметры.СуммаВсего = СтрокаДефис();
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceTable.Total);
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС(Параметры.Content.InvoiceTable.Vat);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	ПодписантыДокумента = СтрокиПодписей_ЮЛ_ФЛ(Параметры.Content.Signers);
	
	Область.Параметры.ПодписьЮЛ	  = ПодписантыДокумента.ЮЛ.Подпись;
	Область.Параметры.ПодписантЮЛ = ПодписантыДокумента.ЮЛ.ФИО;
	
	Область.Параметры.ПодписьФЛ	  = ПодписантыДокумента.ФЛ.Подпись;
	Область.Параметры.ПодписантФЛ = ПодписантыДокумента.ФЛ.ФИО;
	Область.Параметры.НомерСВ	  =	ПодписантыДокумента.ФЛ.НомерСВ;
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель = "Индивидуальный предприниматель" + ?(Параметры.ДатаРедакции >= ДатаРедакции981(), " или иное уполномоченное лицо", "");
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_СФ_УПД_820(Параметры)
	
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.DocumentDate, Параметры.Content.RevisionDate));
	Параметры.Вставить("ЕстьСведенияОПрослеживаемости", ЕстьСведенияОПрослеживаемости820(Параметры.Content));

	Если Параметры.ДатаРедакции = ДатаРедакции1096() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("СФ1137_1096_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("СФ1137_534"));	
		КонецЕсли;
		
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("СФ1137_534_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("СФ1137_534"));	
		КонецЕсли;
		
	Иначе
		Параметры.Вставить("Макет", ПолучитьМакет("СФ1137"));	
		
	КонецЕсли;

	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Если Параметры.ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_СФ1137_" + Параметры.ДатаРедакции);
	
	ПФ_СФ_УПД_820_ШапкаДокумента(Таб, Параметры);
	ПФ_СФ_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_820_СтрокиТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_820_ПодвалТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_СФ_УПД_820_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Seller		 = ПервыйЭлементКоллекции(Content.Sellers);
	Buyer		 = ПервыйЭлементКоллекции(Content.Buyers);
	Consignee	 = ПервыйЭлементКоллекции(Content.Consignees);
	Shipper		 = ПервыйЭлементКоллекции(Content.Shippers);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	
	Область.Параметры.Номер = Content.DocumentNumber;
	Область.Параметры.Дата	= ДатаСтрокой(Content.DocumentDate);
	
	Область.Параметры.ДатаИсправления  = СтрокаДатаИсправления_820(Content.RevisionDate, Content.HyphenRevisionDate);
	Область.Параметры.НомерИсправления = СтрокаНомерИсправления_820(Content.RevisionNumber, Content.HyphenRevisionNumber);
	
	Если Seller <> Неопределено Тогда
		Область.Параметры.Продавец		= Seller.Name;
		Область.Параметры.ПродавецАдрес = СтрокаИлиДефис(СтрокаАдрес(Seller.Address));
		Область.Параметры.ПродавецИНН	= СтрокаИННКПП_820(Seller);
	КонецЕсли;
	
	Если Shipper <> Неопределено Тогда
		Область.Параметры.Грузоотправитель = ?(Shipper.SameAsSeller = Истина, "он же", СтрокаНаименованиеАдрес(Shipper.OrganizationInfo));
	КонецЕсли;
	
	Если Consignee <> Неопределено Тогда
		Область.Параметры.Грузополучатель  = СтрокаНаименованиеАдрес(Consignee);
	КонецЕсли;
	
	Если Buyer <> Неопределено Тогда
		Область.Параметры.Покупатель	  = СтрокаИлиДефис(Buyer.Name);
		Область.Параметры.ПокупательАдрес = СтрокаИлиДефис(СтрокаАдрес(Buyer.Address));
		Область.Параметры.ПокупательИНН	  = СтрокаИННКПП_820(Buyer);
	КонецЕсли;
	
	Область.Параметры.Валюта = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Если Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузке(Content.DocumentShipments);
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции1096() Тогда
	    Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузкеВРедакции1096(Content.DocumentShipments);
	КонецЕсли;
	
	Если Область.Области.Найти("АвансовыеДокументы") <> Неопределено Тогда
		Область.УдалитьОбласть(Область.Область("АвансовыеДокументы"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции625() Тогда
		
		Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосконтракта");
		Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
		Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
		
		Таб.Вывести(Область);
		
	КонецЕсли;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_820_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.Table.Items Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) И КоличествоСтрокСПрослеживаемостью <= 1 Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
			Область.Параметры.НомерСтроки = НомерСтроки;
		КонецЕсли;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаИлиДефис(Item.ItemTypeCode);
		КонецЕсли;
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_СФ_Акт(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		
		Область.Параметры.ЕдиницаИзмерения	  = СтрокаЕдиницаИзмерения(Item.Unit, Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаКодЕдиницыИзмерения820(Item.Unit, Item.HyphenUnit);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена	      = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		
		Область.Параметры.СуммаВсего  = СтрокаСуммаВсего_820(Item.SubTotal, Item.HyphenSubtotal);
		Область.Параметры.СтавкаНДС   = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС_820(Item.Vat, Item.WithoutVat, Item.HyphenVat, Item.TaxRate);
		Область.Параметры.Акциз		  = СтрокаАкциз_820(Item.Excise);
		
		Строки = СтрокиНомеровТД_820(Item.CustomDeclarations);
		Область.Параметры.Страна 	= Строки.Страны;
		Область.Параметры.СтранаКод = Строки.КодыСтран;
		Область.Параметры.НомерТД	= Строки.НомераТД;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
			ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УПД(Область, Item, Строки.НомераТД, Параметры);
		КонецЕсли;
		
		Таб.Вывести(Область);
		
		Если Параметры.ДатаРедакции >= ДатаРедакции534() И КоличествоСтрокСПрослеживаемостью > 1 Тогда
			ЗаполнитьПараметрыПрослеживаемостиСтрок_УПД(Таб, Item, СтрокаДопСведений, НомераКолонок_СФ1137_534_Прослеж(Параметры), Параметры);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_820_ПодвалТаблицы(Таб, Параметры)
	
	Область	 = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	Table	 = Параметры.Content.Table;
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Table.TotalWithVatExcluded);
	Область.Параметры.СуммаВсего = ПодвалСуммаВсего_820(Table.Total, Table.HyphenTotal);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items) Тогда
		
		Область.Параметры.СуммаНДС = СтрокаДефис();
		
	Иначе
		
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС_820(Table.Vat, Table.WithoutVat, Table.HyphenVat);
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры


Функция ПФ_СФ_УПД_970(Параметры)
	
	ДатаРедакции = ДатаРедакцииСФ(Параметры.Content.DocumentDate, Параметры.Content.RevisionDate);
	ЕстьСведенияОПрослеживаемости = ЕстьСведенияОПрослеживаемости970(Параметры.Content);
	
	Если ЕстьСведенияОПрослеживаемости И ДатаРедакции = ДатаРедакции1096() Тогда
		Макет = ПолучитьМакет("СФ1137_1096_Прослеж");
	ИначеЕсли ЕстьСведенияОПрослеживаемости Тогда
		Макет = ПолучитьМакет("СФ1137_534_Прослеж");
	Иначе
		Макет = ПолучитьМакет("СФ1137_534");
	КонецЕсли;

	Параметры.Вставить("Макет", Макет);
	Параметры.Вставить("ДатаРедакции", ДатаРедакции);
	Параметры.Вставить("ЕстьСведенияОПрослеживаемости", ЕстьСведенияОПрослеживаемости);

	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Если ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_СФ1137_" + Параметры.ДатаРедакции);
	
	ПФ_СФ_УПД_970_ШапкаДокумента(Таб, Параметры);
	ПФ_СФ_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_970_СтрокиТаблицы(Таб, Параметры);
	ПФ_СФ_УПД_970_ПодвалТаблицы(Таб, Параметры);
	ПФ_СФ_970_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_СФ_УПД_970_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Sellers = Content.Sellers;
	Buyers = Content.Buyers;
	Consignees = Content.Consignees;
	Shippers = Content.Shippers;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	
	Область.Параметры.Номер = Content.DocumentNumber;
	Область.Параметры.Дата = ДатаСтрокой(Content.DocumentDate);
	
	Область.Параметры.ДатаИсправления = СтрокаДатаИсправления_970(Content.RevisionDate);
	Область.Параметры.НомерИсправления = СтрокаНомерИсправления_970(Content.RevisionNumber);
	
	ПФ_УПД_СФ_970_ШапкаДокумента_Продавцы(Область, Sellers);
	
	ПФ_УПД_СФ_970_ШапкаДокумента_Грузоотправители(Область, Shippers);
	
	ПФ_УПД_970_ШапкаДокумента_Грузополучатели(Область, Consignees);
	
	ПФ_УПД_СФ_970_ШапкаДокумента_Покупатели(Область, Buyers);
	
	Область.Параметры.Валюта = СтрокаПредставлениеВалюты_970(Content.CurrencyName, Content.Currency);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Если Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузке(Content.DocumentShipments);
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции1096() Тогда
	    Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузкеВРедакции1096(Content.DocumentShipments);
	КонецЕсли;
	
	Если Параметры.ДатаРедакции >= ДатаРедакции425() Тогда
		Область.Параметры.НадписьАвансовыеДокументы = НадписьАвансовыеДокументы();
		Область.Параметры.АвансовыеДокументы = СтрокаАвансовыеДокументы(Content.AccompanyingDocuments);
	Иначе
		Область.УдалитьОбласть(Область.Область("АвансовыеДокументы"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосконтракта");
	Область.Параметры.ИдентификаторГосконтракта	= Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_970_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаДопСведений) И КоличествоСтрокСПрослеживаемостью <= 1 Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_СФ_Акт(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		
		Если Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаИлиДефис(Item.ItemTypeCode);
		КонецЕсли;
		
		Область.Параметры.ЕдиницаИзмерения = СтрокаЕдиницаИзмерения_970(Item.UnitName);
		
		Если ЗначениеЗаполнено(Item.Unit) Тогда
			ЕдиницаИзмеренияКод = Item.Unit;
		Иначе
			ЕдиницаИзмеренияКод = СтрокаДефис();
		КонецЕсли;
		Область.Параметры.ЕдиницаИзмеренияКод = ЕдиницаИзмеренияКод;
		
		Область.Параметры.Количество = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Item.SubTotal);
		
		Область.Параметры.СтавкаНДС = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС = СтрокаСуммаНДС_970(Item.Vat, Item.WithoutVat, Item.TaxRate);
		Область.Параметры.Акциз = СтрокаАкциз_970(Item.Excise);
		
		Строки = СтрокиНомеровДТ_970(Item.CustomDeclarations);
		Область.Параметры.Страна = Строки.Страны;
		Область.Параметры.СтранаКод = Строки.КодыСтран;
		Область.Параметры.НомерТД = Строки.НомераДТ;
		
		ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УПД(Область, Item, Строки.НомераДТ, Параметры);

		Таб.Вывести(Область);
		
		Если КоличествоСтрокСПрослеживаемостью > 1 Тогда
			ЗаполнитьПараметрыПрослеживаемостиСтрок_УПД(Таб, Item, СтрокаДопСведений, НомераКолонок_СФ1137_534_Прослеж(Параметры), Параметры);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_СФ_УПД_970_ПодвалТаблицы(Таб, Параметры)

	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	ПФ_УПД_СФ_970_ЗаполнитьСуммыИтогоТаблицы(Область, Параметры);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_СФ_970_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Если Параметры.ДатаРедакции >= ДатаРедакции425() Тогда
		ПФ_УПД_СФ_970_ПодписьСоставителя425(Область, Параметры);
	Иначе
		ПФ_СФ_970_ПодписьСоставителя(Область, Параметры);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры

Процедура ПФ_СФ_970_ПодписьСоставителя(Область, Параметры)
	
	Подписанты = Параметры.Content.Signers;
	Если Подписанты.Количество() > 0 Тогда
		
		ПодписиПродавца = СтрокиПодписей_970(Подписанты);
		
		ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
		
		Seller = ПервыйЭлементКоллекции(Параметры.Content.Sellers);
		
		Если Seller.Type = ВидыЮрФизЛиц.ЮридическоеЛицо
			Или Seller.Type = ВидыЮрФизЛиц.ИностраннаяОрганизация Тогда
			Область.Параметры.ПодписьЮЛ = ПодписиПродавца.Подпись;
			Область.Параметры.ПодписантЮЛ = ПодписиПродавца.ФИО;
		Иначе
			Область.Параметры.ПодписьФЛ = ПодписиПродавца.Подпись;
			Область.Параметры.ПодписантФЛ = ПодписиПродавца.ФИО;
			Область.Параметры.НомерСВ = Seller.IndividualEntityRegistrationCertificate;
		КонецЕсли;
		
	КонецЕсли;
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель =
		"Индивидуальный предприниматель или иное уполномоченное лицо";
	
КонецПроцедуры

Функция ПФ_КСФ(Параметры)
	
	Параметры.Вставить("Макет"		 , ПолучитьМакет("КСФ1137"));
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.InvoiceCorrectionDate, Параметры.Content.InvoiceCorrectionRevisionDate));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.StructedAdditionalInfos);
	
	Если Параметры.ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_КСФ1137_" + Параметры.ДатаРедакции);
	
	ПФ_КСФ_ШапкаДокумента(Таб, Параметры);
	ПФ_КСФ_ШапкаТаблицы(Таб, Параметры);
	ПФ_КСФ_СтрокиТаблицы(Таб, Параметры);
	ПФ_КСФ_ПодвалТаблицы(Таб, Параметры);
	ПФ_КСФ_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_КСФ_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	
	Область.Параметры.Номер	= СтрокаИлиДефис(Content.InvoiceCorrectionNumber);
	Область.Параметры.Дата	= ДатаСтрокойИлиДефис(Content.InvoiceCorrectionDate);
	
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.InvoiceCorrectionRevisionNumber);
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.InvoiceCorrectionRevisionDate);
	
	Область.Параметры.Продавец		= Content.Seller.Name;
	Область.Параметры.ПродавецАдрес = СтрокаИлиДефис(СтрокаАдрес(Content.Seller.Address));
	Область.Параметры.ПродавецИНН	= СтрокаИННКПП(Content.Seller);
	
	Область.Параметры.Покупатель 	  = Content.Buyer.Name;
	Область.Параметры.ПокупательАдрес = СтрокаИлиДефис(СтрокаАдрес(Content.Buyer.Address));
	Область.Параметры.ПокупательИНН	  = СтрокаИННКПП(Content.Buyer);
	
	Область.Параметры.Валюта = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.СчетаФактуры = СтрокаСчетаФактурыКСФ(Content.OriginalInvoices);
	
	Таб.Вывести(Область);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции625() Тогда
		
		Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосконтракта");
		Область.Параметры.НадписьИдентификаторГосконтракта = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
		
		Таб.Вывести(Область);
		
	КонецЕсли;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_КСФ_ШапкаТаблицы(Таб, Параметры)
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
КонецПроцедуры

Процедура ПФ_КСФ_СтрокиТаблицы(Таб, Параметры)
	
	НомераКолонок = НомераКолонок_КСФ1137();
	НомераКолонокПодстрок = Неопределено;
	НомерКолонкиКодВидаТовара = НомерКолонки_КСФ1137_КодВидаТовара();
	
	Для Каждого Item Из Параметры.Content.Items Цикл 
		
		НомерПервойСтроки = Таб.ВысотаТаблицы + 1;
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаА");
		
		Если Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаДефис();
		КонецЕсли;
		
		Область.Параметры.Наименование = СтрокаИлиДефис(Item.Product);
		
		ПФ_КСФ_СтрокаТаблицыДоПосле(Таб, Область, Item.OriginalValues, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаБ");
		ПФ_КСФ_СтрокаТаблицыДоПосле(Таб, Область, Item.CorrectedValues, Параметры, "После");
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаВ");
		ПФ_КСФ_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаГ");
		ПФ_КСФ_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, "Уменьшение");
		
		ПФ_СтрокаДопСведений_КСФ_УКД(Таб, Item, НомерПервойСтроки, НомераКолонок, НомерКолонкиКодВидаТовара, Параметры);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_КСФ_СтрокаТаблицыДоПосле(Таб, Область, InvoiceItemFields, Параметры, Суффикс = "До")
	
	Область.Параметры["ЕдиницаИзмеренияКод" + Суффикс] = СтрокаИлиДефис(InvoiceItemFields.UnitCode);
	Область.Параметры["ЕдиницаИзмерения" + Суффикс] = СтрокаИлиДефис(НаименованиеЕдиницыИзмерения(InvoiceItemFields.UnitCode));
	Область.Параметры["Количество" + Суффикс] = КоличествоСтрокойИлиДефис(InvoiceItemFields.Quantity, Параметры.ФорматКоличества);
	Область.Параметры["Цена" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Price, Параметры.ФорматСуммы);
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.TotalWithVatExcluded);
	Область.Параметры["СтавкаНДС" + Суффикс] = СтрокаСтавкаНДС(InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаСуммаНДС(InvoiceItemFields.Vat, InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаВсего" + Суффикс] = Число_В_Формат(InvoiceItemFields.Total , ФорматСуммы(), "0");
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_КСФ_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, Суффикс = "Увеличение")
	
	AmountsDiff = ?(Суффикс = "Увеличение", Item.AmountsInc, Item.AmountsDec);
	
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(AmountsDiff.TotalWithVatExcluded);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаСумма(AmountsDiff.Vat, "ЧДЦ=2; ЧН=", СтрокаДефис());
	Область.Параметры["СуммаВсего" + Суффикс] = Число_В_Формат(AmountsDiff.Total, "ЧДЦ=2; ЧН=", "0");
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_СтрокаДопСведений_КСФ_УКД(Таб, Item, НомерПервойСтроки, НомераКолонок, НомерКолонкиКодВидаТовара, Параметры)
	
	СтрокаДопСведений = "";
	
	Если Параметры.ПоказатьДопСведения Тогда
		СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
		Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Таб.Вывести(Область);
	КонецЕсли;
	
	НомерПоследнейСтроки = Таб.ВысотаТаблицы;
	ОбъединитьЯчейкиКолонокТабличногоДокумента(Таб, НомерПервойСтроки, НомерПоследнейСтроки, НомераКолонок);
	
	Если Параметры.ПоказатьДопСведения И ЗначениеЗаполнено(СтрокаДопСведений) Тогда
