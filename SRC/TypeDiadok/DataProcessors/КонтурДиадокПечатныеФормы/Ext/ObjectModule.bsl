	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_Торг12_УПД_970_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Seller = ПервыйЭлементКоллекции(Content.Sellers);
	Buyer = ПервыйЭлементКоллекции(Content.Buyers);
	Consignee = ПервыйЭлементКоллекции(Content.Consignees);
	Shipper	= ПервыйЭлементКоллекции(Content.Shippers);
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("Колонтитул"));
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка1");
	
	Грузоотправитель = Seller;
	Если ЗначениеЗаполнено(Shipper) Тогда
		
		ОнЖе = (Shipper.SameAsSeller = Истина);
		Если Не ОнЖе И ЗначениеЗаполнено(Shipper.OrganizationInfo.Name) Тогда
			Грузоотправитель = Shipper.OrganizationInfo;
		КонецЕсли;
		
	КонецЕсли;
	
	Область.Параметры.Грузоотправитель = СтрокаПредставлениеКонтрагента_970(Грузоотправитель);
	Область.Параметры.Подразделение = Грузоотправитель.Department;
	Область.Параметры.ГрузоотправительПоОКПО = Грузоотправитель.Okpo;
	
	Если ЗначениеЗаполнено(Consignee) Тогда
		Область.Параметры.Грузополучатель = СтрокаПредставлениеКонтрагента_970(Consignee);
		Область.Параметры.ГрузополучательПоОКПО = Consignee.Okpo;
	КонецЕсли;
	
	Область.Параметры.Продавец = СтрокаПредставлениеКонтрагента_970(Seller);
	Область.Параметры.ПродавецПоОКПО = Seller.Okpo;
	
	Область.Параметры.Покупатель = СтрокаПредставлениеКонтрагента_970(Buyer);
	Область.Параметры.ПокупательПоОКПО = Buyer.Okpo;
	
	Если Content.TransferInfo.WithoutTransferBase = Истина Тогда
		Область.Параметры.Основание = СтрокаБезДокументаОснования();
	Иначе
		TransferBase = Content.TransferInfo.TransferBases[0]; 
		Область.Параметры.Основание = СтрокаДокументыОснованияУПД970(Content.TransferInfo.TransferBases);
		Область.Параметры.ОснованиеДата = ДатаСтрокой(TransferBase.Date);
		Область.Параметры.ОснованиеНомер = TransferBase.Number;
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
	Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосКонтракта");
	Область.Параметры.ИдентификаторГосконтракта	= Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта = НадписьИдентификаторГосконтракта(Content.DocumentDate);
	
	Таб.Вывести(Область);
	
	// Номер и дата документа, номер и дата транспортной накладной
	Область = Параметры.Макет.ПолучитьОбласть("Шапка2");
	
	Область.Параметры.Номер = Content.DocumentNumber;
	Область.Параметры.Дата = ДатаСтрокой(Content.DocumentDate);
	
	Область.Параметры.ВидОперации = Content.TransferInfo.OperationType;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_970_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для Каждого Item Из Параметры.Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_Торг12(Item);
		
		Область.Параметры.Код = СтрокаИлиДефис(Item.ItemVendorCode);
		Область.Параметры.ЕдиницаИзмерения = СтрокаЕдиницаИзмерения_970(Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.Unit);
		
		Область.Параметры.Количество = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = Число_В_Формат(Item.SubtotalWithVatExcluded, "ЧДЦ=2; ЧН=", СтрокаДефис());
		
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Item.SubTotal);
		Область.Параметры.СуммаНДС = СтрокаСуммаНДС_970(Item.Vat, Item.WithoutVat, Item.TaxRate);
		Область.Параметры.СтавкаНДС = СтрокаСтавкаНДС(Item.TaxRate);
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_970_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	Table = Параметры.Content.Table;
	
	Область.Параметры.Количество = КоличествоСтрокойИлиДефис(Table.TotalNet, Параметры.ФорматКоличества);
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Table.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items) Тогда
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Table.Total);
		Область.Параметры.СуммаНДС = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Table.Total);
		Область.Параметры.СуммаНДС = ПодвалСуммаНДС_970(Table.Vat, Table.WithoutVat);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_970_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	Table = Content.Table;
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалУПД");
	
	КоличествоСтрок = Table.Items.Количество();
	Область.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью = КоличествоЗаписейПрописью(КоличествоСтрок);
	
	Если ЗначениеЗаполнено(Table.Total) Тогда
		Сумма = ?(ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items), Table.TotalWithVatExcluded, Table.Total);
		Область.Параметры.СуммаПрописью = СуммаПрописью(Сумма, Content.Currency);
	Иначе
		Область.Параметры.СуммаПрописью = СтрокаДефис();	
	КонецЕсли;
	
	Область.Параметры.МассаНетто = КоличествоСтрокой(Table.TotalNet, Параметры.ФорматКоличества);
	
	ПодписиПродавца = СтрокиПодписей_970(Content.Signers);
	
	Область.Параметры.ПродавецПодписант	= ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецДолжность = ПодписиПродавца.Должность;
	
	TransferInfo = Content.TransferInfo;
	
	Работник = РаботникИлиИноеЛицо(TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник = СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(TransferInfo.TransferDate) Тогда
		ДатаОтпуска = TransferInfo.TransferDate;
	Иначе
		ДатаОтпуска = Content.DocumentDate;
	КонецЕсли;
	Область.Параметры.ДатаОтпуска = Формат(ДатаОтпуска, "ДФ='dd MMMM yyyy ""года""'");
	
	// Титул покупателя
	Если Параметры.Свойство("BuyerContent")
		И Параметры.BuyerContent <> Неопределено Тогда
		
		BuyerContent = Параметры.BuyerContent;
		
		Если ЗначениеЗаполнено(BuyerContent.AcceptanceDate) Тогда
			ДатаПолучения = BuyerContent.AcceptanceDate;
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
			ДатаПолучения = Content.TransferInfo.TransferDate;
		Иначе
			ДатаПолучения = Content.DocumentDate;
		КонецЕсли;
		
		Область.Параметры.ДатаПолучения	= Формат(ДатаПолучения, "ДФ='dd MMMM yyyy ""года""'");
		Область.Параметры.СодержаниеОперации = СтрокаСодержаниеОперации_970(BuyerContent);
		
		Работник = РаботникИлиИноеЛицо(BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ГрузПринялФИО = СтрокаФИО(Работник);
			Область.Параметры.ГрузПринялДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		ПодписиBuyer = СтрокиПодписей_970(BuyerContent.Signers);
		Область.Параметры.ГрузПолучилФИО = ПодписиBuyer.ФИО;
		Область.Параметры.ГрузПолучилДолжность = ПодписиBuyer.Должность;
		
	КонецЕсли;	
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


