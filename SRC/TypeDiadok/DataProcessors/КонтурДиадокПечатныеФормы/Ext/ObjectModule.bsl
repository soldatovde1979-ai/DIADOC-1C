Функция СтрокиПодписей_ЮЛ_ФЛ(Signers)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЮЛ", Новый Структура("ФИО, Подпись, Должность", "", "", ""));
	Результат.Вставить("ФЛ", Новый Структура("ФИО, Подпись, Должность, НомерСВ", "", "", "", ""));
	
	РазделительЮЛ = "";
	РазделительФЛ = "";
	
	Для Каждого Signer Из Signers Цикл
		
		Если Signer.SignerDetails.SignerType = "LegalEntity" Тогда
			
			Результат.ЮЛ.ФИО	   = Результат.ЮЛ.ФИО		+ РазделительЮЛ + СтрокаФИО(Signer.SignerDetails);
			Результат.ЮЛ.Подпись   = Результат.ЮЛ.Подпись	+ РазделительЮЛ + "Электронная подпись";
			Результат.ЮЛ.Должность = Результат.ЮЛ.Должность + РазделительЮЛ + Signer.SignerDetails.JobTitle;
			
			РазделительЮЛ = Символы.ПС;
			
		Иначе
			
			Результат.ФЛ.ФИО	   = Результат.ФЛ.ФИО		+ РазделительФЛ + СтрокаФИО(Signer.SignerDetails);
			Результат.ФЛ.Подпись   = Результат.ФЛ.Подпись	+ РазделительФЛ + "Электронная подпись";
			Результат.ФЛ.Должность = Результат.ФЛ.Должность + РазделительФЛ + Signer.SignerDetails.JobTitle;
			Результат.ФЛ.НомерСВ   = Результат.ФЛ.НомерСВ	+ РазделительФЛ + Signer.SignerDetails.RegistrationCertificate;
			
			РазделительФЛ = Символы.ПС;
			
		КонецЕсли;
		
