		Дерево.Строки.Удалить(Дерево.Строки.Найти("Международные единицы измерения, не включенные в ОКЕИ"));
		
		Результат = Дерево_В_Таблицу(Дерево, Ложь);
		Дерево = Неопределено;
		
		Результат.Колонки.КодЧисловой.Имя					  = "Код";
		Результат.Колонки.Наименование.Имя					  = "НаименованиеПолное";
		Результат.Колонки.УсловноеОбозначениеНациональное.Имя = "НаименованиеКраткое";
		
		Для каждого СтрокаТЗ Из Результат Цикл
			СтрокаТЗ.НаименованиеПолное	 = СтрЗаменить(СтрокаТЗ.НаименованиеПолное , Символы.ПС, "/");
			СтрокаТЗ.НаименованиеКраткое = СтрЗаменить(СтрокаТЗ.НаименованиеКраткое, Символы.ПС, "/");
		КонецЦикла;
		
		Результат.Индексы.Добавить("Код");
		
		ДополнитьТаблицуОКЕИ(Результат);
		
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "НаименованиеКраткое");
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "НаименованиеПолное");
		
		Кэш_Поместить("ОКЕИ", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает наименование единицы измерения по коду.
//
// Параметры:
//	 КодОКЕИ			- Строка - Код единицы измерения.
//	 ПолноеНаименование - Булево - (необязательное) Признак того, что нужно вернуть полное наименование.
//
// Возвращаемое значение:
//	 Строка	- Наименование единицы измерения, пример:
//   	шт	  - Краткое Наименование
//		Штука - Полное наименование
//
Функция НаименованиеЕдиницыИзмерения(КодОКЕИ, ПолноеНаименование = Ложь)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(КодОКЕИ) Тогда
		
		СтрокаОКЕИ = ПолучитьОКЕИ().Найти(СокрЛП(КодОКЕИ), "Код");
		
		Если СтрокаОКЕИ <> Неопределено Тогда
			
			Если ПолноеНаименование = Истина Тогда
				Результат = СтрокаОКЕИ.НаименованиеПолное;
			Иначе
				Результат = СтрокаОКЕИ.НаименованиеКраткое;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции		

// Возвращает наименование страны по коду.
//
// Параметры:
//	 КодСтраны		    - Строка - Код страны.
//	 ПолноеНаименование - Булево - (необязательное) Признак того, что нужно вернуть полное наименование.
//
// Возвращаемое значение:
//	 Строка	- Наименование страны, пример:
//   	РОССИЯ				 - Краткое Наименование
//		Российская Федерация - Полное наименование
//
Функция НаименованиеСтраны(КодСтраны, ПолноеНаименование = Ложь)
	
	Результат = "";
	
	СтрокаОКСМ = ПолучитьОКСМ().Найти(КодСтраны, "Код");
	
	Если СтрокаОКСМ <> Неопределено Тогда
		
		Если ПолноеНаименование = Истина Тогда
			Результат = СтрокаОКСМ.НаименованиеПолное;
		Иначе
			Результат = СтрокаОКСМ.НаименованиеКраткое;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает символьный код или наименование валюты по коду.
//
// Параметры:
//	 КодВалюты	  - Строка - Код валюты
//	 Наименование - Булево - (необязательное) Признак того, что нужно вернуть наименование валюты.
//
// Возвращаемое значение:
//	 Строка	- Наименование валюты, пример:
//   	RUB 			 - Символьный код валюты
//		Российский рубль - Наименование валюты
//
Функция НаименованиеВалюты(КодВалюты, Наименование = Ложь)
	
	Результат = "";
	
	СтрокаОКВ = ПолучитьОКВ().Найти(КодВалюты, "Код");
	
	Если СтрокаОКВ <> Неопределено Тогда
		
		Если Наименование = Истина Тогда
			Результат = СтрокаОКВ.Наименование;
		Иначе
			Результат = СтрокаОКВ.КодСимвольный;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает символьный код валюты по коду
//
// Параметры:
//  КодВалюты - Строка - Код валюты
//
// Возвращаемое значение:
//  Строка - Наименование валюты
//
Функция СимвольныйКодВалюты(КодВалюты)
	
	ВернутьНаименованиеВалюты = Ложь;
	
	Результат = НаименованиеВалюты(
		КодВалюты,
		ВернутьНаименованиеВалюты
	);
	
	Возврат Результат;
	
КонецФункции

// Возвращает параметры исчисления валюты по коду.
// Параметры исчисления есть только для RUB, EUR, USD.
//
// Параметры:
//	 КодВалюты - Строка - Код валюты.
//
// Возвращаемое значение:
//	 Строка	- Параметры исчисления валюты, пример: "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2 знака"
//
Функция ПараметрыИсчисленияВалюты(КодВалюты) Экспорт
	
	Результат = "";
	
	СтрокаОКВ = ПолучитьОКВ().Найти(КодВалюты, "Код");
	
	Если СтрокаОКВ <> Неопределено Тогда
		Результат = СтрокаОКВ.ПараметрыИсчисления;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает наименование региона России, по числовому коду.
//
// Параметры:
//	 КодРегиона - Число, Строка - Код региона.
//
Функция НаименованиеРегиона(КодРегиона) Экспорт
	
	КодРегионаЧислом = Привести_К_Числу(КодРегиона);
	Результат = КодыРегионов()[КодРегионаЧислом];
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтроковыйИндексВТаблицуЗначений(ТаблицаЗначений, ИмяКолонки)
	
	ИмяКолонкиИндекса = "Индекс_" + ИмяКолонки;
	
	ТаблицаЗначений.Колонки.Добавить(ИмяКолонкиИндекса, ТаблицаЗначений.Колонки[ИмяКолонки].ТипЗначения);
	
	Для Каждого Строка Из ТаблицаЗначений Цикл
		Строка[ИмяКолонкиИндекса] = Врег(СтрЗаменить(СтрЗаменить(Строка[ИмяКолонки], " ", ""), ".", ""));
	КонецЦикла;
	
	ТаблицаЗначений.Индексы.Добавить(ИмяКолонкиИндекса);
	
КонецПроцедуры

Процедура ДобавитьСтрокуВ_ОКСМ(ОКСМ, НаименованиеКраткое, КодАльфа2, КодАльфа3, Код, НаименованиеПолное)
	
	НоваяСтрока = ОКСМ.Добавить();
	НоваяСтрока.НаименованиеКраткое	= НаименованиеКраткое;
	НоваяСтрока.КодАльфа2			= КодАльфа2;
	НоваяСтрока.КодАльфа3			= КодАльфа3;
	НоваяСтрока.Код					= Код;
	НоваяСтрока.НаименованиеПолное	= НаименованиеПолное;
	
КонецПроцедуры

Процедура ДополнитьТаблицуОКЕИ(ОКЕИ)
	
	// Добавляем строку "Литр" с кратким наименованием "л".
	// Причем строка "л" будет основной, а строка "л (дм3)" - дополнительной.
	СтрокаТЗ = ОКЕИ.Найти("112", "Код");
	ЗаполнитьЗначенияСвойств(ОКЕИ.Добавить(), СтрокаТЗ);
	СтрокаТЗ.НаименованиеКраткое = "л";
	
	// Добавляем строку "Сутки" с кратким наименованием "сут".
	// Причем строка "сут" будет основной, а строка "сут/дн" - дополнительной.
	СтрокаТЗ = ОКЕИ.Найти("359", "Код");
	ЗаполнитьЗначенияСвойств(ОКЕИ.Добавить(), СтрокаТЗ);
	СтрокаТЗ.НаименованиеКраткое = "сут";
	
	// Добавляем строку "Тысяча штук" с кратким наименованием "тыс. шт".
	// Причем строка "тыс. шт" будет основной, а строка "тыс. шт/1000 шт" - дополнительной.
	СтрокаТЗ = ОКЕИ.Найти("798", "Код");
	ЗаполнитьЗначенияСвойств(ОКЕИ.Добавить(), СтрокаТЗ);
	СтрокаТЗ.НаименованиеКраткое = "тыс. шт";
	
	// Добавляем строку "Год" с кратким наименованием "г".
	// Причем строка "г" будет основной, а строка "г/лет" - дополнительной.
	СтрокаТЗ = ОКЕИ.Найти("366", "Код");
	ЗаполнитьЗначенияСвойств(ОКЕИ.Добавить(), СтрокаТЗ);
	СтрокаТЗ.НаименованиеКраткое = "г";
	
	// Добавляем строку "Километр" с кратким наименованием "км".
	// Причем строка "км" будет основной, а строка "км/1000 м" - дополнительной.
	СтрокаТЗ = ОКЕИ.Найти("008", "Код");
	ЗаполнитьЗначенияСвойств(ОКЕИ.Добавить(), СтрокаТЗ);
	СтрокаТЗ.НаименованиеКраткое = "км";
	
	// Добавляем строку "Тысяча кубических метров" с кратким наименованием "10^3 м3".
	// Причем строка "1000 м3" будет основной, а строка "10^3 м3" - дополнительной.
	СтрокаТЗ = ОКЕИ.Найти("114", "Код");
	ЗаполнитьЗначенияСвойств(ОКЕИ.Добавить(), СтрокаТЗ);
	СтрокаТЗ.НаименованиеКраткое = "10^3 м3";
	
КонецПроцедуры

