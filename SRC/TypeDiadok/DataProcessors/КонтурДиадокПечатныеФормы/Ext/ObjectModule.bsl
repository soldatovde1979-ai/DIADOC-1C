Функция ЕстьСведенияОИсправлении(Контент)
	
	Результат = Ложь;
	
	ИмяСвойства_НомерИсправления	= "RevisionNumber";
	ИмяСвойства_ДатаИсправления		= "RevisionDate";
	
	ЗаполненНомерИсправления = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Контент, ИмяСвойства_НомерИсправления)
								И ЗначениеЗаполнено(Контент[ИмяСвойства_НомерИсправления]);
								
	ЗаполненаДатаИсправления = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Контент, ИмяСвойства_ДатаИсправления)
								И ЗначениеЗаполнено(Контент[ИмяСвойства_ДатаИсправления]);
	
	Если ЗаполненНомерИсправления И ЗаполненаДатаИсправления Тогда
									
		Результат = Истина;							
			
	КонецЕсли;
	
	Возврат Результат;
	
