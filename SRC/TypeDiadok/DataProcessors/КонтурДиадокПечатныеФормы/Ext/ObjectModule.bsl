Процедура ПФ_АктСверки405_ПодписиДокумента(Таб, Макет, SenderContent, RecipientContent)
	
	Если ЗначениеЗаполнено(RecipientContent)
		И НЕ СвойствоСтруктуры(RecipientContent, "SignDisagreement", Неопределено) = Неопределено Тогда
		
		// Титул получателя
		
		ПФ_АктСверки405_ПодписиТитулаПолучателя(
			Таб,
			Макет,
			SenderContent,
			RecipientContent
		);
		
	Иначе
		
		// Титул отправителя
		
		ПФ_АктСверки405_ПодписиТитулаОтправителя(
			Таб,
			Макет,
			SenderContent
		);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_АктСверки405_ПодписиТитулаОтправителя(Таб, Макет, SenderContent)
	
	ПодписиСторон = Макет.ПолучитьОбласть("ПодписиСторон");
	
	ReconciliationAct = SenderContent.ReconciliationAct;
	
	Sender = ReconciliationAct.AdditionalInfoReconciliationAct.Sender;
	Recipient = ReconciliationAct.AdditionalInfoReconciliationAct.Recipient;
	
	СуммаЗадолженностиПоДаннымОтправителя = ReconciliationAct.ReconciliationActTable.BalanceDebitEnd - ReconciliationAct.ReconciliationActTable.BalanceAmountEnd;
	
	Если СуммаЗадолженностиПоДаннымОтправителя >= 0 Тогда
		ЗадолженностьПоДаннымОтправителя = Sender.Name
	Иначе
		ЗадолженностьПоДаннымОтправителя = Recipient.Name
	КонецЕсли;
	
	СуммаПоДаннымОтправителя = МодульЧисла(СуммаЗадолженностиПоДаннымОтправителя);
	
	ПодписиСторон.Параметры.НаимОргОтправителя = Sender.Name;
	ПодписиСторон.Параметры.ЗадолженностьОтправителя = ЗадолженностьПоДаннымОтправителя;
	ПодписиСторон.Параметры.СуммаПоДаннымОтправителя = СтрокаСумма(СуммаПоДаннымОтправителя, "ЧДЦ=2; ЧН=", "0");
	ПодписиСторон.Параметры.ДатаОкПерОтправителя = ДатаСтрокойИлиДефис(SenderContent.ReconcilationDateTo);
	ПодписиСторон.Параметры.ДолжнОтправителя = ReconciliationAct.Signer.JobTitle;
	ПодписиСторон.Параметры.ФИОПодписантаОтправителя = СтрокаФИО(ReconciliationAct.Signer.Official);
	
	Таб.Вывести(ПодписиСторон);
	
КонецПроцедуры

Процедура ПФ_АктСверки405_ПодписиТитулаПолучателя(Таб, Макет, SenderContent, RecipientContent)
	
	ПодписиСторон = Макет.ПолучитьОбласть("ПодписиСторон");
	
	// Даные отправителя
	
	ПФ_АктСверки405_ПодписьОтправителя(ПодписиСторон, SenderContent);
	
	// Даные получателя
	
	ПризнакРазногласий = RecipientContent.SignDisagreement;
	
	Если НРег(ПризнакРазногласий) = НРег("WithoutDisagreements") Тогда
		
		ПФ_АктСверки405_ПодписьПолучателяБезРазногласий(
			ПодписиСторон,
			SenderContent,
			RecipientContent
		);
		
	ИначеЕсли НРег(ПризнакРазногласий) = НРег("WithDisagreements") Тогда
		
		ПФ_АктСверки405_ПодписьПолучателяСРазногласиями(
			ПодписиСторон,
			SenderContent,
			RecipientContent
		);
		
	Иначе
		
		ШаблонОшибки = "Неожиданный результат разногласий: %1";
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			ШаблонОшибки,
			ПризнакРазногласий
		);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Таб.Вывести(ПодписиСторон);
	
КонецПроцедуры

Процедура ПФ_АктСверки405_ПодписьОтправителя(ОбластьМакета, SenderContent)
	
	SenderReconciliationAct = SenderContent.ReconciliationAct;
	
	Sender = SenderReconciliationAct.AdditionalInfoReconciliationAct.Sender;
	Recipient = SenderReconciliationAct.AdditionalInfoReconciliationAct.Recipient;
	
	СуммаЗадолженностиПоДаннымОтправителя = SenderReconciliationAct.ReconciliationActTable.BalanceDebitEnd - SenderReconciliationAct.ReconciliationActTable.BalanceAmountEnd;
	
	Если СуммаЗадолженностиПоДаннымОтправителя >= 0 Тогда
		ЗадолженностьПоДаннымОтправителя = Sender.Name
	Иначе
		ЗадолженностьПоДаннымОтправителя = Recipient.Name
	КонецЕсли;
	
	СуммаПоДаннымОтправителя = МодульЧисла(СуммаЗадолженностиПоДаннымОтправителя);
	
	ОбластьМакета.Параметры.НаимОргОтправителя = Sender.Name;
	ОбластьМакета.Параметры.ЗадолженностьОтправителя = ЗадолженностьПоДаннымОтправителя;
	ОбластьМакета.Параметры.СуммаПоДаннымОтправителя = СтрокаСумма(СуммаПоДаннымОтправителя, "ЧДЦ=2; ЧН=", "0");
	ОбластьМакета.Параметры.ДатаОкПерОтправителя = ДатаСтрокойИлиДефис(SenderContent.ReconcilationDateTo);
	ОбластьМакета.Параметры.ДолжнОтправителя = SenderReconciliationAct.Signer.JobTitle;
	ОбластьМакета.Параметры.ФИОПодписантаОтправителя = СтрокаФИО(SenderReconciliationAct.Signer.Official);
	
КонецПроцедуры

Процедура ПФ_АктСверки405_ПодписьПолучателяБезРазногласий(ОбластьМакета, SenderContent, RecipientContent)
	
	SenderReconciliationAct = SenderContent.ReconciliationAct;
	RecipientReconciliationAct = RecipientContent;
	
	Sender = SenderReconciliationAct.AdditionalInfoReconciliationAct.Sender;
	Recipient = SenderReconciliationAct.AdditionalInfoReconciliationAct.Recipient;
	
	СуммаЗадолженностиПоДаннымОтправителя = SenderReconciliationAct.ReconciliationActTable.BalanceDebitEnd - SenderReconciliationAct.ReconciliationActTable.BalanceAmountEnd;
	
	Если СуммаЗадолженностиПоДаннымОтправителя >= 0 Тогда
		ЗадолженностьПоДаннымОтправителя = Sender.Name
	Иначе
		ЗадолженностьПоДаннымОтправителя = Recipient.Name
	КонецЕсли;
	
	СуммаПоДаннымОтправителя = МодульЧисла(СуммаЗадолженностиПоДаннымОтправителя);
	
	Signer = СвойствоСтруктуры(RecipientReconciliationAct, "Signer");
	
	Если ЗначениеЗаполнено(Signer) Тогда
		ДолжнПолучателя = Signer.JobTitle;
		ФИОПодписантаПолучателя = СтрокаФИО(Signer.Official);
	Иначе
		ДолжнПолучателя = "";
		ФИОПодписантаПолучателя = "";
	КонецЕсли;
	
	ОбластьМакета.Параметры.НаимОргПолучателя = Recipient.Name;
	ОбластьМакета.Параметры.ЗадолженностьПолучателя = ЗадолженностьПоДаннымОтправителя;
	ОбластьМакета.Параметры.СуммаПоДаннымПолучателя = СтрокаСумма(СуммаПоДаннымОтправителя, "ЧДЦ=2; ЧН=", "0");
	ОбластьМакета.Параметры.ДатаОкПерПолучателя = ДатаСтрокойИлиДефис(SenderContent.ReconcilationDateTo);
	ОбластьМакета.Параметры.ДолжнПолучателя = ДолжнПолучателя;
	ОбластьМакета.Параметры.ФИОПодписантаПолучателя = ФИОПодписантаПолучателя;
	
КонецПроцедуры

Процедура ПФ_АктСверки405_ПодписьПолучателяСРазногласиями(ОбластьМакета, SenderContent, RecipientContent)
	
	SenderReconciliationAct = SenderContent.ReconciliationAct;
	RecipientReconciliationAct = RecipientContent.ReconciliationAct;
	
	Sender = SenderReconciliationAct.AdditionalInfoReconciliationAct.Sender;
	Recipient = SenderReconciliationAct.AdditionalInfoReconciliationAct.Recipient;
	
	СуммаЗадолженностиПоДаннымПолучателя = RecipientReconciliationAct.ReconciliationActTable.BalanceDebitEnd - RecipientReconciliationAct.ReconciliationActTable.BalanceAmountEnd;
	
	Если СуммаЗадолженностиПоДаннымПолучателя >= 0 Тогда
		ЗадолженностьПоДаннымПолучателя = Recipient.Name
	Иначе
		ЗадолженностьПоДаннымПолучателя = Sender.Name
	КонецЕсли;
	
	СуммаПоДаннымПолучателя = МодульЧисла(СуммаЗадолженностиПоДаннымПолучателя);
	
	Signer = СвойствоСтруктуры(RecipientReconciliationAct, "Signer");
	
	Если ЗначениеЗаполнено(Signer) Тогда
		ДолжнПолучателя = Signer.JobTitle;
		ФИОПодписантаПолучателя = СтрокаФИО(Signer.Official);
	Иначе
		ДолжнПолучателя = "";
		ФИОПодписантаПолучателя = "";
	КонецЕсли;
	
	ОбластьМакета.Параметры.НаимОргПолучателя = Recipient.Name;
	ОбластьМакета.Параметры.ЗадолженностьПолучателя = ЗадолженностьПоДаннымПолучателя;
	ОбластьМакета.Параметры.СуммаПоДаннымПолучателя = СтрокаСумма(СуммаПоДаннымПолучателя, "ЧДЦ=2; ЧН=", "0");
	ОбластьМакета.Параметры.ДатаОкПерПолучателя = ДатаСтрокойИлиДефис(SenderContent.ReconcilationDateTo);
	ОбластьМакета.Параметры.ДолжнПолучателя = ДолжнПолучателя;
	ОбластьМакета.Параметры.ФИОПодписантаПолучателя = ФИОПодписантаПолучателя;
	
КонецПроцедуры

Функция ПФ_СчетНаОплату_29(Параметры, ТипДокумента)
	
	Если НРег(ТипДокумента) = НРег(ТипСчетОфертаФНС29()) Тогда
		НазваниеДокумента = "Счет - оферта";
	Иначе
		НазваниеДокумента = "Счет на оплату";
	КонецЕсли;
	
	Параметры.Вставить("Макет", ПолучитьМакет("СчетНаОплату_29"));
	
	Таб = НовыйТабличныйДокумент("DD_СчетНаОплату_29");
	
	ПФ_СчетНаОплату_29_ШапкаДокумента(Таб, Параметры, НазваниеДокумента);
	ПФ_СчетНаОплату_29_ТабличнаяЧастьДокумента(Таб, Параметры);
	ПФ_СчетНаОплату_29_ПодвалТаблицы(Таб, Параметры);
	ПФ_СчетНаОплату_29_ПодвалДокумента(Таб, Параметры);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_СчетНаОплату_29_ШапкаДокумента(Таб, Параметры, НазваниеДокумента)
	
	Content = Параметры.Content;
	
	Если ЗначениеЗаполнено(Content.MoneyRecipient.Name) Тогда
		ПФ_СчетНаОплату_29_ШапкаДокумента_СведенияОБанке(Таб, Content.MoneyRecipient, Параметры.Макет);
	Иначе
		ПФ_СчетНаОплату_29_ШапкаДокумента_СведенияОБанке(Таб, Content.Seller, Параметры.Макет);
	КонецЕсли;
	
	ШаблонЗаголовкаДокумента = "%1 № %2 от %3 г.";
	
	ЗаголовокДокумента = Общее_ПодставитьПараметрыВСтроку(
		ШаблонЗаголовкаДокумента,
		НазваниеДокумента,
		Content.DocumentNumber,
		ДатаСтрокой(Content.DocumentDate)
	);
	
	ОбластьСчетаДокумент = Параметры.Макет.ПолучитьОбласть("ШапкаСчетаДокумент");
	ОбластьСчетаДокумент.Параметры.Заголовок = ЗаголовокДокумента;
	Таб.Вывести(ОбластьСчетаДокумент);

	ПФ_СчетНаОплату_29_ШапкаДокумента_СведенияУчастников(Таб, Content, Параметры.Макет);
	ПФ_СчетНаОплату_29_ШапкаДокумента_ОснованиеСчета(Таб, Content, Параметры.Макет);
	
	СтрокаДопСведений = "";
	Разделитель = "";
	
	Для Каждого AdditionalInfoId Из Content.AdditionalInfoId Цикл
		StructedAdditionalInfos = AdditionalInfoId.StructedAdditionalInfos;
		
		СтрокаДопСведений = СтрокаДопСведений + Разделитель + ДопСведенияСтрокой(StructedAdditionalInfos);
		Разделитель = ", ";
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
		ОбластьСчетаИныеСведения = Параметры.Макет.ПолучитьОбласть("ШапкаСчетаИныеСведения");
		ОбластьСчетаИныеСведения.Параметры.ИныеСведения = СтрокаДопСведений;
		Таб.Вывести(ОбластьСчетаИныеСведения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_ШапкаДокумента_СведенияОБанке(Таб, Контент, Макет)
	
	ОбластьСчетаБанк = Макет.ПолучитьОбласть("ШапкаСчетаБанк");
	ОбластьСчетаБанк.Параметры.БанкПолучателя = Контент.BankName;
	ОбластьСчетаБанк.Параметры.БИКБанкаПолучателя = Контент.BankId;
	ОбластьСчетаБанк.Параметры.СчетБанкаПолучателя = Контент.CorrespondentAccount;
	ОбластьСчетаБанк.Параметры.СчетПолучателя = Контент.BankAccountNumber;
	ОбластьСчетаБанк.Параметры.ИННПолучателя = Контент.Inn;
	ОбластьСчетаБанк.Параметры.КПППолучателя = Контент.Kpp;
	
	Если ЗначениеЗаполнено(Контент.ShortOrgName) Тогда
		ОбластьСчетаБанк.Параметры.Получатель = Контент.ShortOrgName;
	Иначе
		ОбластьСчетаБанк.Параметры.Получатель = Контент.Name;
	КонецЕсли;
	
	Таб.Вывести(ОбластьСчетаБанк);
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_ШапкаДокумента_СведенияУчастников(Таб, Контент, Макет)
	
	ОбластьСчетаПоставщик = Макет.ПолучитьОбласть("ШапкаСчетаПоставщик");
	ОбластьСчетаПоставщик.Параметры.Поставщик = ПФ_СчетНаОплату_29_СведенияУчастника(Контент.Seller);
	Таб.Вывести(ОбластьСчетаПоставщик);
	
	ОбластьСчетаПокупатель = Макет.ПолучитьОбласть("ШапкаСчетаПокупатель");
	ОбластьСчетаПокупатель.Параметры.Покупатель = ПФ_СчетНаОплату_29_СведенияУчастника(Контент.Buyer);
	Таб.Вывести(ОбластьСчетаПокупатель);
	
	Если ЗначениеЗаполнено(Контент.Payer.Type) Тогда
		ОбластьСчетаПлательщик = Макет.ПолучитьОбласть("ШапкаСчетаПлательщик");
		ОбластьСчетаПлательщик.Параметры.Плательщик = ПФ_СчетНаОплату_29_СведенияУчастника(Контент.Payer);
		Таб.Вывести(ОбластьСчетаПлательщик);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контент.Shipper.Type) Тогда
		ОбластьСчетаГрузоотправитель = Макет.ПолучитьОбласть("ШапкаСчетаГрузоотправитель");
		ОбластьСчетаГрузоотправитель.Параметры.Грузоотправитель = ПФ_СчетНаОплату_29_СведенияУчастника(Контент.Shipper);
		Таб.Вывести(ОбластьСчетаГрузоотправитель);
	КонецЕсли;
	Если ЗначениеЗаполнено(Контент.Consignee.Type) Тогда
		ОбластьСчетаГрузополучатель = Макет.ПолучитьОбласть("ШапкаСчетаГрузополучатель");
		ОбластьСчетаГрузополучатель.Параметры.Грузополучатель = ПФ_СчетНаОплату_29_СведенияУчастника(Контент.Consignee);
		Таб.Вывести(ОбластьСчетаГрузополучатель);
	КонецЕсли;
	
КонецПроцедуры

Функция ПФ_СчетНаОплату_29_СведенияУчастника(Контент)
	
	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить(Контент.Name);
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ЗначениеЗаполнено(Контент.Inn) Тогда
		ЧастиСтроки.Добавить("ИНН: " + Контент.Inn);
	ИначеЕсли ЗначениеЗаполнено(Контент.OrganizationOrPersonInfo) Тогда
		ЧастиСтроки.Добавить("Иные сведения: " + Контент.OrganizationOrPersonInfo);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	Если ЗначениеЗаполнено(Контент.Kpp) Тогда
		ЧастиСтроки.Добавить("КПП: " + Контент.Kpp);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контент.LegalEntityId) Тогда
		ЧастиСтроки.Добавить(Контент.LegalEntityId);
	КонецЕсли;
	
	ЧастиСтроки.Добавить(СтрокаАдрес_970(Контент.Address));
	ЧастиСтроки.Добавить(СтрокаКонтактныеДанные_970(Контент));
	
	Результат = СоединитьСтроку(ЧастиСтроки, ", ");
	
	Возврат Результат;
	
КонецФункции

Процедура ПФ_СчетНаОплату_29_ШапкаДокумента_ОснованиеСчета(Таб, Контент, Макет)
	
	Разделитель = "";
	СимволНПП = Символы.НПП;
	ОснованиеСчета = "";
	Для Каждого ProformaInvoiceBase Из Контент.ProformaInvoiceBases Цикл
		
		НаименованиеДокумента = ProformaInvoiceBase.ProformaInvoiceBaseDocument.DocumentName;
		Номер = ProformaInvoiceBase.ProformaInvoiceBaseDocument.DocumentNumber;
		Дата = ProformaInvoiceBase.ProformaInvoiceBaseDocument.DocumentDate;
		
		Если ЗначениеЗаполнено(НаименованиеДокумента) Тогда
			
			ОснованиеСчета = ОснованиеСчета + Разделитель + НаименованиеДокумента;
			ОснованиеСчета = ОснованиеСчета + " №" + СимволНПП + Номер;
			ОснованиеСчета = ОснованиеСчета + СимволНПП + "от" + СимволНПП + ДатаСтрокой(Дата);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ProformaInvoiceBase.OtherBase) Тогда
			ОснованиеСчета = ОснованиеСчета + Разделитель + ProformaInvoiceBase.OtherBase;
		КонецЕсли;
		
		Разделитель = "; ";
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ОснованиеСчета) Тогда
		ОснованиеСчета = СтрокаДефис();
	КонецЕсли;
	
	ОбластьСчетаОснование = Макет.ПолучитьОбласть("ШапкаСчетаОснование");
	ОбластьСчетаОснование.Параметры.Основание = ОснованиеСчета;
	Таб.Вывести(ОбластьСчетаОснование);
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_ТабличнаяЧастьДокумента(Таб, Параметры)
	
	Table = Параметры.Content.Table;
	
	ЕстьСкидка = ЗначениеЗаполнено(Параметры.Content.Table.TotalDiscountSum);
	
	Если ЕстьСкидка Тогда
		ОбластьШапкаТаблицы = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	Иначе
		ОбластьШапкаТаблицы = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицыБезСкидок");
	КонецЕсли;
	
	Таб.Вывести(ОбластьШапкаТаблицы);
	
	НомерСтроки = 0;
	
	Для Каждого Item Из Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ПФ_СчетНаОплату_29_СтрокаТабличнойЧасти(Таб, Item, Параметры, НомерСтроки, ЕстьСкидка);
		
	КонецЦикла;
	
	Подвал = Параметры.Макет.ПолучитьОбласть("Подвал");
	Таб.Вывести(Подвал);
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_СтрокаТабличнойЧасти(Таб, Контент, Параметры, НомерСтроки, ЕстьСкидка)
	
	СтрокаДопСведений = "";
	
	Если Параметры.ПоказатьДопСведения Тогда
		
		Разделитель = "";
		
		Для Каждого AdditionalInfoId Из Контент.AdditionalInfoId Цикл
			StructedAdditionalInfos = AdditionalInfoId.StructedAdditionalInfos;
			
			СтрокаДопСведений = СтрокаДопСведений + Разделитель + ДопСведенияСтрокой(StructedAdditionalInfos);
			Разделитель = ", ";
		КонецЦикла;
		
		Разделитель = ?(ЗначениеЗаполнено(СтрокаДопСведений), "; ", "");
		
		Если ЗначениеЗаполнено(Контент.AdditionalProperty) Тогда
			СтрокаДопСведений = СтрокаДопСведений + Разделитель + Контент.AdditionalProperty;
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьДопСведения = ЗначениеЗаполнено(СтрокаДопСведений);
	
	ИмяОбласти = "Строка";
	
	Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
		ИмяОбласти = ИмяОбласти + "ДопСведения";
	КонецЕсли;
	
	Если НЕ ЕстьСкидка Тогда
		ИмяОбласти = ИмяОбласти + "БезСкидок";
	КонецЕсли;
	
	ОбластьСтрока = Параметры.Макет.ПолучитьОбласть(ИмяОбласти);
	ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
	ОбластьСтрока.Параметры.Артикул = ПредставлениеКодТов_СчетНаОплату_29(Контент);
	ОбластьСтрока.Параметры.Товар = ПредставлениеНоменклатуры_СчетНаОплату_29(Контент);
	ОбластьСтрока.Параметры.Количество = КоличествоСтрокойИлиДефис(Контент.Quantity, Параметры.ФорматКоличества);
	ОбластьСтрока.Параметры.ЕдиницаИзмерения = СтрокаЕдиницаИзмерения_970(Контент.UnitName);
	ОбластьСтрока.Параметры.Цена = СуммаСтрокойИлиДефис(Контент.PriceWithoutDiscount, Параметры.ФорматСуммы);
	ОбластьСтрока.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Контент.SubtotalWithVatExcluded);
	ОбластьСтрока.Параметры.СуммаНДС = СтрокаСуммаНДС_970(Контент.Vat, Контент.WithoutVat, Контент.TaxRate);
	ОбластьСтрока.Параметры.Всего = СуммаСтрокойИлиДефис(Контент.SubTotal);
	
	Если ЗначениеЗаполнено(Контент.OtherTaxRate) Тогда
		ОбластьСтрока.Параметры.СтавкаНДС = СокрЛП(Контент.OtherTaxRate);
	Иначе
		ОбластьСтрока.Параметры.СтавкаНДС = СтрокаСтавкаНДС(Контент.TaxRate);
	КонецЕсли;
	
	Если ЕстьСкидка Тогда
		Если ЗначениеЗаполнено(Контент.DiscountPercent) Тогда
			Скидка = СуммаСтрокой(Контент.DiscountPercent) + "%";
		Иначе
			Скидка = СуммаСтрокойИлиДефис(Контент.DiscountSum);
		КонецЕсли;
		
		ОбластьСтрока.Параметры.Скидка = Скидка;
	КонецЕсли;
	
	Если ЕстьДопСведения Тогда
		ОбластьСтрока.Параметры.ДопСведения = СтрокаДопСведений;
	КонецЕсли;
	
	Таб.Вывести(ОбластьСтрока);
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_ПодвалТаблицы(Таб, Параметры)
	
	Table = Параметры.Content.Table;
	
	Если ЗначениеЗаполнено(Table.TotalDiscountSum) Тогда
		ОбластьПодвалСкидкаПоДокументу = Параметры.Макет.ПолучитьОбласть("ПодвалСкидкаПоДокументу");
		ОбластьПодвалСкидкаПоДокументу.Параметры.СуммаСкидки = Table.TotalDiscountSum;
		Таб.Вывести(ОбластьПодвалСкидкаПоДокументу);
	КонецЕсли;
	
	ОбластьПодвалИтого = Параметры.Макет.ПолучитьОбласть("ПодвалИтого");
	ОбластьПодвалИтого.Параметры.Всего = Table.TotalWithVatExcluded;
	Таб.Вывести(ОбластьПодвалИтого);
	
	Если Table.WithoutVat Тогда
		ЗаголовокНДС = "Без налога (НДС)";
		ВсегоНДС = "-";
	Иначе
		ЗаголовокНДС = "НДС:";
		ВсегоНДС = СуммаСтрокойИлиДефис(Table.Vat);
	КонецЕсли;
	
	ОбластьПодвалНДС = Параметры.Макет.ПолучитьОбласть("ПодвалНДС");
	ОбластьПодвалНДС.Параметры.НДС = ЗаголовокНДС;
	ОбластьПодвалНДС.Параметры.ВсегоНДС = ВсегоНДС;
	Таб.Вывести(ОбластьПодвалНДС);
	
	ПФ_СчетНаОплату_29_ПодвалТаблицы_ИтогоКОплате(Таб, Параметры.Content, Параметры.Макет);
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_ПодвалТаблицы_ИтогоКОплате(Таб, Контент, Макет)
	
	ИтогоКОплате = Контент.Table.Total;
	
	ОбластьПодвалИтогоКОплате = Макет.ПолучитьОбласть("ПодвалИтогоКОплате");
	ОбластьПодвалИтогоКОплате.Параметры.ИтогоКОплате = ИтогоКОплате;
	Таб.Вывести(ОбластьПодвалИтогоКОплате);
	
	Если ЗначениеЗаполнено(Контент.TotalItems) Тогда
		ВсегоПозиций = Контент.TotalItems;
	Иначе
		ВсегоПозиций = Контент.Table.Items.Количество();
	КонецЕсли;
	
	ШаблонИтоговойСтроки = НСтр("ru='Всего наименований %1, на сумму %2 %3'");
	
	Если Контент.IsConventionalUnit Тогда
		ВалютаДляСчета = Контент.ConventionalUnitDefinition;
		
		СуммаПрописью = ЧислоПрописью_УЕ(ИтогоКОплате, ВалютаДляСчета);
	Иначе
		
		ВалютаДляСчета = НаименованиеВалюты(Контент.Currency, Истина);
		
		ПараметрыИсчисленияВалюты = ПараметрыИсчисленияВалюты(Контент.Currency);
		
		Если ЗначениеЗаполнено(ПараметрыИсчисленияВалюты) Тогда
			СуммаПрописью = ЧислоПрописью_Обертка(ИтогоКОплате, ПараметрыИсчисленияВалюты);
		Иначе
			СуммаПрописью = ЧислоПрописью_Обертка(ИтогоКОплате, ПараметрыИсчисленияВалюты) + " " + ВалютаДляСчета;
		КонецЕсли;
	
	КонецЕсли;
	
	ИтоговаяСтрока = Общее_ПодставитьПараметрыВСтроку(
		ШаблонИтоговойСтроки,
		ВсегоПозиций,
		Формат(ИтогоКОплате, "ЧЦ=15; ЧДЦ=2"),
		ВалютаДляСчета
	);
	
	ОбластьПодвалСуммаПрописью = Макет.ПолучитьОбласть("ПодвалСуммаПрописью");
	ОбластьПодвалСуммаПрописью.Параметры.ИтоговаяСтрока = ИтоговаяСтрока;
	ОбластьПодвалСуммаПрописью.Параметры.СуммаПрописью = СуммаПрописью;
	Таб.Вывести(ОбластьПодвалСуммаПрописью);
	
КонецПроцедуры

Функция ЧислоПрописью_УЕ(Значение, ВалютаДляСчета)
	
	ФормСтрока = "Л = ru_RU; ДП = Истина";
	ПараметрыПредметаИсчисления = Общее_ПодставитьПараметрыВСтроку(
	"%1, %1, %1, N, , , , N, ",
	ВалютаДляСчета);
	
	Попытка
		Результат = ЧислоПрописью(Значение, ФормСтрока, ПараметрыПредметаИсчисления);
	Исключение
		Результат = Строка(Значение);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ПФ_СчетНаОплату_29_ПодвалДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	ProformaInvoiceAdditionalInfo = Content.ProformaInvoiceAdditionalInfo;
	
	ПФ_СчетНаОплату_29_ПодвалДокумента_ОплатитьДо(Таб, ProformaInvoiceAdditionalInfo, Параметры.Макет);
	
	Разделитель = Символы.ПС;
	
	УсловияОплаты = СоединитьСтроку(ProformaInvoiceAdditionalInfo.PaymentTerms, Разделитель);
	Если ЗначениеЗаполнено(УсловияОплаты) Тогда
		ОбластьПодвалУсловияОплаты = Параметры.Макет.ПолучитьОбласть("ПодвалУсловияОплаты");
		ОбластьПодвалУсловияОплаты.Параметры.УсловияОплаты = УсловияОплаты;
		Таб.Вывести(ОбластьПодвалУсловияОплаты);
	КонецЕсли;
	
	УсловияОказанияУслуги = СоединитьСтроку(ProformaInvoiceAdditionalInfo.ShipmentTerms, Разделитель);
	Если ЗначениеЗаполнено(УсловияОказанияУслуги) Тогда
		ОбластьПодвалУсловияОказанияУслуги = Параметры.Макет.ПолучитьОбласть("ПодвалУсловияОказанияУслуги");
		ОбластьПодвалУсловияОказанияУслуги.Параметры.УсловияОказанияУслуги = УсловияОказанияУслуги;
		Таб.Вывести(ОбластьПодвалУсловияОказанияУслуги);
	КонецЕсли;
	
	СтрокаДопСведений = "";
	Разделитель = "";
	
	Для Каждого AdditionalInfoId Из ProformaInvoiceAdditionalInfo.AdditionalInfoId Цикл
		StructedAdditionalInfos = AdditionalInfoId.StructedAdditionalInfos;
		
		СтрокаДопСведений = СтрокаДопСведений + Разделитель + ДопСведенияСтрокой(StructedAdditionalInfos);
		Разделитель = ", ";
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
		ОбластьПодвалДопСведения = Параметры.Макет.ПолучитьОбласть("ПодвалДопСведения");
		ОбластьПодвалДопСведения.Параметры.ДопСведения = СтрокаДопСведений;
		Таб.Вывести(ОбластьПодвалДопСведения);
	КонецЕсли;
	
	ОбластьПодвалСчета = Параметры.Макет.ПолучитьОбласть("ПодвалСчета");
	Таб.Вывести(ОбластьПодвалСчета);
	
	Для Каждого Signer Из Content.Signers Цикл
		ОбластьПодвалПодписант = Параметры.Макет.ПолучитьОбласть("ПодвалПодписант");
		ОбластьПодвалПодписант.Параметры.ДолжностьПодписанта = Signer.JobTitle;
		ОбластьПодвалПодписант.Параметры.ФИОПодписанта = СтрокаФИО(Signer);
		Таб.Вывести(ОбластьПодвалПодписант);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_СчетНаОплату_29_ПодвалДокумента_ОплатитьДо(Таб, Контент, Макет)
	
	Если ЗначениеЗаполнено(Контент.DateRestriction) Тогда
		ОплатитьДо = ДатаСтрокой(Контент.DateRestriction);
	ИначеЕсли ЗначениеЗаполнено(Контент.DateAndTimeRestriction) Тогда
		ОплатитьДоДата = Лев(Контент.DateAndTimeRestriction, 10);
		ОплатитьДоВремя = Сред(Контент.DateAndTimeRestriction, 12, 5);
		
		ОплатитьДо = ОплатитьДоВремя + " " + ОплатитьДоДата;
	Иначе
		ОплатитьДо = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОплатитьДо) Тогда
		ОбластьПодвалДатаОплаты = Макет.ПолучитьОбласть("ПодвалДатаОплаты");
		ОбластьПодвалДатаОплаты.Параметры.ОплатитьДо = ОплатитьДо;
		Таб.Вывести(ОбластьПодвалДатаОплаты);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает печатную форму счета на оплату по форме ДД
//
// Параметры: 
//  Данные - Структура - внутреннее представление сведений о счете на оплату (см. МенеджерИнтеграции.СчетаНаОплату_Данные)
// 
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция ПФ_СчетНаОплатуДиадок(Данные) Экспорт
	
	ДанныеШапки = Данные.Шапка;
	ДанныеТабличнойЧасти = Данные.ТабличнаяЧасть;
	
	Таб = НовыйТабличныйДокумент("DD_СчетНаОплату", ОриентацияСтраницы.Портрет);
	
	Макет = ПолучитьМакет("ПФ_MXL_СчетНаОплату");
	
	Сумма = ДанныеТабличнойЧасти.Итог("Сумма");
	СуммаНДС = ДанныеТабличнойЧасти.Итог("СуммаНДС");
	ВсегоНаименований = ДанныеТабличнойЧасти.Количество();
	
	СчетаНаОплату_ШапкаДокумента(Таб, Макет, ДанныеШапки);
	
	СчетНаОплату_ТабличнаяЧастьДокумента(Таб, Макет, ДанныеТабличнойЧасти);
	
	СчетаНаОплату_ПодвалДокумента(Таб, Макет, ДанныеШапки, Сумма, СуммаНДС, ВсегоНаименований);
	
	Возврат Таб;
	
КонецФункции

Процедура СчетаНаОплату_ШапкаДокумента(Таб, Макет, ДанныеШапки)
	
	ШапкаДанныеОтправителяПолучателя = Макет.ПолучитьОбласть("ШапкаСчета1");
	ШапкаДанныеОтправителяПолучателя.Параметры.БанкПолучателя = ДанныеШапки.ПродавецБанкПредставление;
	ШапкаДанныеОтправителяПолучателя.Параметры.БИКБанкаПолучателя = ДанныеШапки.ПродавецБанкБИК;
	ШапкаДанныеОтправителяПолучателя.Параметры.СчетБанкаПолучателя = ДанныеШапки.ПродавецБанковскийСчетКорСчет;
	ШапкаДанныеОтправителяПолучателя.Параметры.СчетПолучателя = ДанныеШапки.ПродавецБанковскийСчетНомер;
	ШапкаДанныеОтправителяПолучателя.Параметры.ИННПолучателя = ДанныеШапки.ПродавецИНН;
	ШапкаДанныеОтправителяПолучателя.Параметры.КПППолучателя = ДанныеШапки.ПродавецКПП;
	ШапкаДанныеОтправителяПолучателя.Параметры.Получатель = ДанныеШапки.ПродавецПредставление;
	Таб.Вывести(ШапкаДанныеОтправителяПолучателя);
	
	ШапкаДанныеСчетаНаОплату = Макет.ПолучитьОбласть("ШапкаСчета2");
	ШапкаДанныеСчетаНаОплату.Параметры.Заголовок = ДанныеШапки.Заголовок;
	Таб.Вывести(ШапкаДанныеСчетаНаОплату);
	
	ШапкаОписаниеОтправителя = Макет.ПолучитьОбласть("ШапкаСчета3");
	ШапкаОписаниеОтправителя.Параметры.Поставщик = ДанныеШапки.ПродавецОписание;
	Таб.Вывести(ШапкаОписаниеОтправителя);
	
	ШапкаОписаниеПолучателя = Макет.ПолучитьОбласть("ШапкаСчета4");
	ШапкаОписаниеПолучателя.Параметры.Покупатель = ДанныеШапки.ПокупательОписание;
	Таб.Вывести(ШапкаОписаниеПолучателя);
	
КонецПроцедуры

Процедура СчетНаОплату_ТабличнаяЧастьДокумента(Таб, Макет, ДанныеТабличнойЧасти)
	
	ИмяОбластиШапка = "ШапкаТаблицыБезСкидок";
	ИмяОбластиСтрока = "СтрокаБезСкидок";
	
	ЕстьСкидки = (ДанныеТабличнойЧасти.Итог("СуммаСкидки") <> 0);
	
	Если ЕстьСкидки Тогда
		ИмяОбластиШапка = "ШапкаТаблицы";
		ИмяОбластиСтрока = "Строка";
	КонецЕсли;
	
	ШапкаТаблицы = Макет.ПолучитьОбласть(ИмяОбластиШапка);
	СтрокаТаблицы = Макет.ПолучитьОбласть(ИмяОбластиСтрока);
	
	Таб.Вывести(ШапкаТаблицы);
	
	НомерСтроки = 1;
	
	Для Каждого СтрокаТабличнойЧасти Из ДанныеТабличнойЧасти Цикл
		
		СтрокаТаблицы.Параметры.Заполнить(СтрокаТабличнойЧасти);
		
		СтрокаТаблицы.Параметры.Товар = СтрокаТабличнойЧасти.НоменклатураПредставление;
		СтрокаТаблицы.Параметры.Артикул = СтрокаТабличнойЧасти.НоменклатураАртикул;
		СтрокаТаблицы.Параметры.НомерСтроки = НомерСтроки;
		
		НомерСтроки = НомерСтроки + 1;
		
		Таб.Вывести(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СчетаНаОплату_ПодвалДокумента(Таб, Макет, ДанныеШапки, Сумма, СуммаНДС, ВсегоНаименований)
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Таб.Вывести(Подвал);
	
	ПодвалИтого = Макет.ПолучитьОбласть("ПодвалИтого");
	ПодвалИтого.Параметры.Всего = Сумма;
	Таб.Вывести(ПодвалИтого);
	
	ПодвалНДС = Макет.ПолучитьОбласть("ПодвалНДС");
	
	Если ДанныеШапки.ОблагаетсяНДСУПокупателя Тогда
		
		ПодвалНДС.Параметры.НДС = "НДС исчисляется налоговым агентом";
		ПодвалНДС.Параметры.ВсегоНДС = "-";
		
	ИначеЕсли ДанныеШапки.УчитыватьНДС Тогда
		
		ПодвалНДС.Параметры.НДС = ?(ДанныеШапки.ЦенаВключаетНДС, "В том числе НДС:", "Сумма НДС:");
		ПодвалНДС.Параметры.ВсегоНДС = Формат(СуммаНДС, "ЧЦ=15; ЧДЦ=2");
		
	Иначе
		
		ПодвалНДС.Параметры.НДС = "Без налога (НДС)";
		ПодвалНДС.Параметры.ВсегоНДС = "-";
		
	КонецЕсли;
	
	Таб.Вывести(ПодвалНДС);
	
	СуммаИтого = Сумма + ?(ДанныеШапки.ЦенаВключаетНДС, 0, СуммаНДС);
	
	ПодвалИтого = Макет.ПолучитьОбласть("ПодвалИтогоКОплате");
	ПодвалИтого.Параметры.ИтогоКОплате = СуммаИтого;
	Таб.Вывести(ПодвалИтого);
	
	ШаблонИтоговойСтроки = НСтр("ru='Всего наименований %1, на сумму %2 %3'");
	
	ИтоговаяСтрока = Общее_ПодставитьПараметрыВСтроку(
		ШаблонИтоговойСтроки,
		ВсегоНаименований,
		Формат(СуммаИтого, "ЧЦ=15; ЧДЦ=2"),
		СокрП(ДанныеШапки.Валюта)
	);
	
	ПарПредмета = ПараметрыИсчисленияВалюты(ДанныеШапки.Валюта.Код);
	СуммаПрописью = ЧислоПрописью(СуммаИтого, , ПарПредмета);
	
	ПодвалСуммаПрописью = Макет.ПолучитьОбласть("ПодвалСуммаПрописью");
	ПодвалСуммаПрописью.Параметры.ИтоговаяСтрока = ИтоговаяСтрока;
	ПодвалСуммаПрописью.Параметры.СуммаПрописью = СуммаПрописью;
	Таб.Вывести(ПодвалСуммаПрописью);
	
	ПодвалСчета = Макет.ПолучитьОбласть("ПодвалСчета");
	ПодвалСчета.Параметры.ФИОРуководителя = ДанныеШапки.РуководительФИО;
	
	Таб.Вывести(ПодвалСчета);
	
КонецПроцедуры

// Возвращает печатную форму акта сверки взаиморасчетов по форме ДД
//
// Параметры:
//  Данные - Структура - внутреннее представление акта сверки взаиморасчетов (см. МенеджерИнтеграции.АктыСверок_Данные)
// 
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция ПФ_АктСверкиДиадок(Данные) Экспорт
	
	Таб = НовыйТабличныйДокумент("DD_АктСверкиВзаиморасчетов", ОриентацияСтраницы.Портрет);
	
	Макет = ПолучитьМакет("ПФ_MXL_АктСверкиВзаиморасчетов");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовок.Параметры.ЗаголовокАктаСверки = АктСверки_Подзаголовок(Данные.Шапка);
	ОбластьЗаголовок.Параметры.ЗаголовокТаблицы = АктСверки_СтороныСверки(Данные.Шапка);
	Таб.Вывести(ОбластьЗаголовок);
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("Шапка|Секция");
	
	ОбластьШапкаТаблицы.Параметры.Шапка = Общее_ПодставитьПараметрыВСтроку(
		"По данным %1, %2",
		Данные.Шапка.ОрганизацияПредставление,
		Данные.Шапка.ВалютаПредставление
	);
	Таб.Вывести(ОбластьШапкаТаблицы);
	
	ОбластьШапкаТаблицы.Параметры.Шапка = Общее_ПодставитьПараметрыВСтроку(
		"По данным %1, %2",
		Данные.Шапка.КонтрагентПредставление,
		Данные.Шапка.ВалютаПредставление
	);
	Таб.Присоединить(ОбластьШапкаТаблицы);
	
	ОстатокНач = Данные.Шапка.ОстатокНаНачало;
	
	СальдоНачДт = Макс(ОстатокНач, 0);
	СальдоНачКт = Макс(-ОстатокНач, 0);
	
	СтрокаСальдо = Макет.ПолучитьОбласть("Сальдо|Секция");
	СтрокаСальдо.Параметры.Дебет = СальдоНачДт;
	СтрокаСальдо.Параметры.Кредит = СальдоНачКт;
	Таб.Вывести(СтрокаСальдо);
	
	СтрокаСальдо.Параметры.Дебет = СальдоНачКт;
	СтрокаСальдо.Параметры.Кредит = СальдоНачДт;
	Таб.Присоединить(СтрокаСальдо);
	
	Если Данные.Шапка.ГруппироватьПоАналитике Тогда
		АктСверки_ВывестиДеталиПоГруппировкам(Таб, Макет, Данные);
	Иначе
		АктСверки_ВывестиДеталиБезГруппировок(Таб, Макет, Данные);
	КонецЕсли;
	
	ОрганизацияОборотДт = Данные.ДанныеОрганизации.Итог("Дебет");
	ОрганизацияОборотКт = Данные.ДанныеОрганизации.Итог("Кредит");
	
	ОрганизацияКонОст = ОстатокНач + ОрганизацияОборотДт - ОрганизацияОборотКт;
	
	Если ОрганизацияКонОст <= 0 Тогда
		
		ОрганизацияСальдоКонДт = 0;
		ОрганизацияСальдоКонКт = - ОрганизацияКонОст;
		
	Иначе
		
		ОрганизацияСальдоКонДт = ОрганизацияКонОст;
		ОрганизацияСальдоКонКт = 0;
		
	КонецЕсли;
	
	КонтрагентОборотДт = Данные.ДанныеКонтрагента.Итог("Дебет");
	КонтрагентОборотКт = Данные.ДанныеКонтрагента.Итог("Кредит");
	
	КонтрагентКонОст = ОстатокНач + КонтрагентОборотКт - КонтрагентОборотДт;
	
	Если КонтрагентКонОст <= 0 Тогда
		
		КонтрагентСальдоКонДт = - КонтрагентКонОст;
		КонтрагентСальдоКонКт = 0;
		
	Иначе
		
		КонтрагентСальдоКонДт = 0;
		КонтрагентСальдоКонКт = КонтрагентКонОст;
		
	КонецЕсли;
	
	ВалютаПредставление = Данные.Шапка.ВалютаПредставление;
	ВалютаКод = Данные.Шапка.ВалютаКод;
	
	ПодвалИтоги = Макет.ПолучитьОбласть("ПодвалИтоги|Секция");
	ПодвалИтоги.Параметры.ОборотыДт = ОрганизацияОборотДт;
	ПодвалИтоги.Параметры.ОборотыКт = ОрганизацияОборотКт;
	ПодвалИтоги.Параметры.Дебет  = ОрганизацияСальдоКонДт;
	ПодвалИтоги.Параметры.Кредит = ОрганизацияСальдоКонКт;
	ПодвалИтоги.Параметры.ПредставлениеОрганизации = "По данным " + Данные.Шапка.ОрганизацияПредставление;
	ПодвалИтоги.Параметры.РезультатыСверки = АктСверки_ПредставлениеРезультатов(Данные.Шапка, ОрганизацияКонОст);
	Таб.Вывести(ПодвалИтоги);
	
	Если Данные.Шапка.СверкаСогласована Тогда
		
		ПодвалИтоги.Параметры.ОборотыДт = КонтрагентОборотДт;
		ПодвалИтоги.Параметры.ОборотыКт = КонтрагентОборотКт;
		ПодвалИтоги.Параметры.Дебет  = КонтрагентСальдоКонДт;
		ПодвалИтоги.Параметры.Кредит = КонтрагентСальдоКонКт;
		ПодвалИтоги.Параметры.ПредставлениеОрганизации = "По данным " + Данные.Шапка.КонтрагентПредставление;
		ПодвалИтоги.Параметры.РезультатыСверки = АктСверки_ПредставлениеРезультатов(Данные.Шапка, КонтрагентКонОст);
		
	Иначе
		
		ПодвалИтоги.Параметры.ОборотыДт = "";
		ПодвалИтоги.Параметры.ОборотыКт = "";
		ПодвалИтоги.Параметры.Дебет  = "";
		ПодвалИтоги.Параметры.Кредит = "";
		ПодвалИтоги.Параметры.ПредставлениеОрганизации = "";
		ПодвалИтоги.Параметры.РезультатыСверки = "";
		
	КонецЕсли;
	Таб.Присоединить(ПодвалИтоги);
	
	СверкаСогласована = Данные.Шапка.СверкаСогласована;
	
	СуммаРасхождения = ОрганизацияКонОст - КонтрагентКонОст;
	
	Если СверкаСогласована И СуммаРасхождения <> 0 Тогда
		
		ПодвалРасхождение = Макет.ПолучитьОбласть("Расхождение");
		СуммаРасхождения = ?(СуммаРасхождения < 0, - СуммаРасхождения, СуммаРасхождения);
		
		ПодвалРасхождение.Параметры.Расхождение = Общее_ПодставитьПараметрыВСтроку(
			"В результате сверки выявлено расхождение информации о состоянии расчетов в размере %1",
			АктСверки_РазвернутоеПредставлениеСуммы(СуммаРасхождения, ВалютаПредставление, ВалютаКод)
		);
		
		Таб.Вывести(ПодвалРасхождение);
		
	КонецЕсли;
	
	ПодвалПодписи = Макет.ПолучитьОбласть("ПодвалПодпись|Секция");
	ПодвалПодписи.Параметры.ПредставлениеОрганизации = Данные.Шапка.ОрганизацияПредставление;
	ПодвалПодписи.Параметры.Должность = Данные.Шапка.ПредставительОрганизацииДолжность;
	ПодвалПодписи.Параметры.ФИО = Данные.Шапка.ПредставительОрганизацииФИО;
	Таб.Вывести(ПодвалПодписи);
	
	ПодвалПодписи.Параметры.ПредставлениеОрганизации = Данные.Шапка.КонтрагентПредставление;
	ПодвалПодписи.Параметры.Должность = Данные.Шапка.ПредставительКонтрагентаДолжность;
	ПодвалПодписи.Параметры.ФИО = Данные.Шапка.ПредставительКонтрагентаФИО;
	Таб.Присоединить(ПодвалПодписи);
	
	Возврат Таб;
	
КонецФункции

Процедура АктСверки_ВывестиДеталиБезГруппировок(Таб, Макет, Данные)
	
	СтрокаТаблицы = Макет.ПолучитьОбласть("Строка|Секция");
	ПустойШаблон = Новый Структура("Дата, ДокументПредставление, Дебет, Кредит");
	
	МаксИндекс = Макс(Данные.ДанныеОрганизации.Количество(), Данные.ДанныеКонтрагента.Количество()) - 1;
	
	Для Индекс = 0 По МаксИндекс Цикл
		
		ЗначенияЗаполнения = ПустойШаблон;
		Если Индекс < Данные.ДанныеОрганизации.Количество() Тогда
			ЗначенияЗаполнения = Данные.ДанныеОрганизации[Индекс];
		КонецЕсли;
		СтрокаТаблицы.Параметры.Заполнить(ЗначенияЗаполнения);
		Таб.Вывести(СтрокаТаблицы);
		
		ЗначенияЗаполнения = ПустойШаблон;
		Если Индекс < Данные.ДанныеКонтрагента.Количество() Тогда
			ЗначенияЗаполнения = Данные.ДанныеКонтрагента[Индекс];
		КонецЕсли;
		СтрокаТаблицы.Параметры.Заполнить(ЗначенияЗаполнения);
		Таб.Присоединить(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура АктСверки_ВывестиДеталиПоГруппировкам(Таб, Макет, Данные)
	
	СтрокаТаблицы = Макет.ПолучитьОбласть("Строка|Секция");
	СтрокаНачалоДоговора = Макет.получитьОбласть("ДоговорНачалоСекции|Секция");
	СтрокаКонецДоговора = Макет.получитьОбласть("ДоговорКонецСекции|Секция");
	ПустойШаблон = Новый Структура("Дата, ДокументПредставление, Дебет, Кредит");
	
	ПоляГруппировки = Новый Массив;
	
	ИмяКлючевогоПоля = "Аналитика";
	ТолькоУникальныеЗначения = Истина;
	
	АналитикаОрганизации = Данные.ДанныеОрганизации.ВыгрузитьКолонку(ИмяКлючевогоПоля);
	ДополнитьМассивЛокальная(ПоляГруппировки, АналитикаОрганизации, ТолькоУникальныеЗначения);
	
	АналитикаКонтрагента = Данные.ДанныеКонтрагента.ВыгрузитьКолонку(ИмяКлючевогоПоля);
	ДополнитьМассивЛокальная(ПоляГруппировки, АналитикаКонтрагента, ТолькоУникальныеЗначения);
	
	Для Каждого Аналитика Из ПоляГруппировки Цикл
		
		СтрокаНачалоДоговора.Параметры.Договор = Аналитика;
		Таб.Вывести(СтрокаНачалоДоговора);
		Таб.Присоединить(СтрокаНачалоДоговора);
		
		КлючевыеПоля = Новый Структура(ИмяКлючевогоПоля, Аналитика);
		
		ДанныеОрганизации = Данные.ДанныеОрганизации.НайтиСтроки(КлючевыеПоля);
		ДанныеКонтрагента = Данные.ДанныеКонтрагента.НайтиСтроки(КлючевыеПоля);
		
		МаксИндекс = Макс(ДанныеОрганизации.Количество(), ДанныеКонтрагента.Количество()) - 1;
		
		ОрганизацияОборотДт = 0;
		ОрганизацияОборотКт = 0;
		
		КонтрагентОборотДт = 0;
		КонтрагентОборотКт = 0;
		
		Для Индекс = 0 По МаксИндекс Цикл
			
			ЗначенияЗаполнения = ПустойШаблон;
			Если Индекс < ДанныеОрганизации.Количество() Тогда
				
				ЗначенияЗаполнения = ДанныеОрганизации[Индекс];
				ОрганизацияОборотДт = ОрганизацияОборотДт + ЗначенияЗаполнения.Дебет;
				ОрганизацияОборотКт = ОрганизацияОборотКт + ЗначенияЗаполнения.Кредит;
				
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.Заполнить(ЗначенияЗаполнения);
			Таб.Вывести(СтрокаТаблицы);
			
			ЗначенияЗаполнения = ПустойШаблон;
			
			Если Индекс < ДанныеКонтрагента.Количество() Тогда
				
				ЗначенияЗаполнения = ДанныеКонтрагента[Индекс];
				КонтрагентОборотДт = КонтрагентОборотДт + ЗначенияЗаполнения.Дебет;
				КонтрагентОборотКт = КонтрагентОборотКт + ЗначенияЗаполнения.Кредит;
				
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.Заполнить(ЗначенияЗаполнения);
			Таб.Присоединить(СтрокаТаблицы);
			
		КонецЦикла;
		
		СтрокаКонецДоговора.Параметры.Дебет = ОрганизацияОборотДт;
		СтрокаКонецДоговора.Параметры.Кредит = ОрганизацияОборотКт;
		Таб.Вывести(СтрокаКонецДоговора);
		
		СтрокаКонецДоговора.Параметры.Дебет = КонтрагентОборотДт;
		СтрокаКонецДоговора.Параметры.Кредит = КонтрагентОборотКт;
		Таб.Присоединить(СтрокаКонецДоговора);
		
	КонецЦикла;
	
КонецПроцедуры

Функция АктСверки_Подзаголовок(Шапка)
	
	ПериодСверки = ПредставлениеПериода(НачалоДня(Шапка.НачалоПериода), КонецДня(Шапка.КонецПериода), "ФП = Истина");
	Подзаголовок = Общее_ПодставитьПараметрыВСтроку(
		"взаимных расчетов за период: %1
		|между %2
		|и %3",
		ПериодСверки,
		Шапка.ОрганизацияПредставление,
		Шапка.КонтрагентПредставление
	);
	
	Если Шапка.СверкаПоДоговору Тогда
		Подзаголовок = Подзаголовок + Символы.ПС + "по договору " + Шапка.ДоговорПредставление;
	КонецЕсли;
	
	Возврат Подзаголовок;
	
КонецФункции

Функция АктСверки_СтороныСверки(Шапка)
	
	СторонаОрганизации = АктСверки_ПредставлениеСтороны(
		Шапка.ОрганизацияПредставление,
		Шапка.ПредставительОрганизацииФИО,
		Шапка.ПредставительОрганизацииДолжность
	);
	
	СторонаКонтрагента = АктСверки_ПредставлениеСтороны(
		Шапка.КонтрагентПредставление,
		Шапка.ПредставительКонтрагентаФИО,
		Шапка.ПредставительКонтрагентаДолжность
	);
	
	// BSLLS:LineLength-off
	Стороны = Общее_ПодставитьПараметрыВСтроку(
		"Мы, нижеподписавшиеся, представитель %1, с одной стороны, и %2, с другой стороны, составили настоящий акт сверки в том, что состояние взаимных расчетов по данным учета следующее:",
		СторонаОрганизации,
		СторонаКонтрагента
	);
	// BSLLS:LineLength-on
	
	Возврат Стороны;
	
КонецФункции

Функция АктСверки_ПредставлениеРезультатов(Шапка, ОрганизацияИтогСальдо)
	
	ЕстьЗадолженность = (ОрганизацияИтогСальдо <> 0);
	НаДату = Формат(Шапка.КонецПериода, "ДФ=dd.MM.yyyy");
	
	Если ЕстьЗадолженность Тогда
		
		Если ОрганизацияИтогСальдо > 0 Тогда
			Кредитор = Шапка.ОрганизацияПредставление;
			Сумма = ОрганизацияИтогСальдо;
		Иначе
			Кредитор = Шапка.КонтрагентПредставление;
			Сумма = -ОрганизацияИтогСальдо;
		КонецЕсли;
		
		ПредставлениеСуммы = АктСверки_РазвернутоеПредставлениеСуммы(Сумма, Шапка.ВалютаПредставление, Шапка.ВалютаКод);
		
		Результат = Общее_ПодставитьПараметрыВСтроку(
			"на %1 задолженность в пользу %2 %3",
			НаДату,
			Кредитор,
			ПредставлениеСуммы
		);
		
	Иначе
		
		Результат = Общее_ПодставитьПараметрыВСтроку(
			"на %1 задолженность отсутствует",
			НаДату
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки_ПредставлениеСтороны(Знач СторонаПредставление, Знач ПредставительФИО, Знач ПредставительДолжность)
	
	ЧастиПредставления = Новый Массив;
	ЧастиПредставления.Добавить(ПредставительДолжность);
	ЧастиПредставления.Добавить(СторонаПредставление);
	Если ЗначениеЗаполнено(ПредставительФИО) Тогда
		ЧастиПредставления.Добавить(ПредставительФИО);
	КонецЕсли;
	
	Результат = СоединитьСтроку(ЧастиПредставления, " ");
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки_РазвернутоеПредставлениеСуммы(Сумма, ВалютаПредставление, ВалютаКод)
	
	СуммаПрописью = СуммаПрописью(Сумма, ВалютаКод);
	
	Результат = Общее_ПодставитьПараметрыВСтроку(
		"%1 %2 (%3)",
		Формат(Сумма, "ЧДЦ=2"),
		ВалютаПредставление,
		СуммаПрописью
	);
	
	Возврат Результат;
	
КонецФункции

//{ Строковые представления полей

Функция СтрокиПодписей(Signers)
	
	Результат = Новый Структура("ФИО, Подпись, Должность, НомерСВ", "", "", "", "");
	Разделитель = "";
	
	Для Каждого Signer Из Signers Цикл
		
		Результат.ФИО	    = Результат.ФИО		  + Разделитель + СтрокаФИО(Signer.SignerDetails);
		Результат.Подпись   = Результат.Подпись	  + Разделитель + "Электронная подпись";
		Результат.Должность = Результат.Должность + Разделитель + Signer.SignerDetails.JobTitle;
		Результат.НомерСВ   = Результат.НомерСВ	  + Разделитель + Signer.SignerDetails.RegistrationCertificate;
		
		Разделитель = Символы.ПС;
		
		Прервать; // По аналогии с вэбом
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокиПодписей_970(СведенияОПодписантах)
	
	Результат = Новый Структура("ФИО, Подпись, Должность", "", "", "");
	Разделитель = "";
	
	Если СведенияОПодписантах.Количество() > 0 Тогда
		
