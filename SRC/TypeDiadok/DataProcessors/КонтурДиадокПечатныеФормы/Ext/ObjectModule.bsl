	Параметры.Вставить("Макет", ПолучитьМакет("ТОРГ12"));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Таб = НовыйТабличныйДокумент("DD_ТОРГ12");
	
	ПФ_Торг12_УПД_ШапкаДокумента(Таб, Параметры);
	ПФ_Торг12_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_Торг12_УПД_СтрокиТаблицы(Таб, Параметры);
	ПФ_Торг12_УПД_ПодвалТаблицы(Таб, Параметры);
	ПФ_Торг12_УПД_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_Торг12_УПД_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("Колонтитул"));
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка1");
	
	Если Content.Shipper.SameAsSeller = Ложь И ЗначениеЗаполнено(Content.Shipper.OrganizationInfo.Name) Тогда
		Грузоотправитель = Content.Shipper.OrganizationInfo;
	Иначе
		Грузоотправитель = Content.Seller;
	КонецЕсли;
	
	Область.Параметры.Грузоотправитель		 = СтрокаДанныеКонтрагента(Грузоотправитель);
	Область.Параметры.Подразделение 		 = Грузоотправитель.Department;
	Область.Параметры.ГрузоотправительПоОКПО = Грузоотправитель.Okpo;
	Область.Параметры.ВидДеятельностиПоОКДП	 = Грузоотправитель.Okdp;
	
	Область.Параметры.Грузополучатель		 = СтрокаДанныеКонтрагента(Content.Consignee);
	Область.Параметры.ГрузополучательПоОКПО	 = Content.Consignee.Okpo;
	
	Область.Параметры.Продавец		 = СтрокаДанныеКонтрагента(Content.Seller);
	Область.Параметры.ПродавецПоОКПО = Content.Seller.Okpo;
	
	Область.Параметры.Покупатель	   = СтрокаДанныеКонтрагента(Content.Buyer);
	Область.Параметры.ПокупательПоОКПО = Content.Buyer.Okpo;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferBases) Тогда
		TransferBase = Content.TransferInfo.TransferBases[0]; 
		Область.Параметры.Основание		 = СтрокаДокументыОснованияУПД(Content.TransferInfo.TransferBases);
		Область.Параметры.ОснованиеДата	 = ДатаСтрокой(TransferBase.DocumentDate);
		Область.Параметры.ОснованиеНомер = TransferBase.DocumentNumber;
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
	Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосКонтракта");
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Content.Date);
	
	Таб.Вывести(Область);
	
	// Номер и дата документа, номер и дата транспортной накладной
	Область = Параметры.Макет.ПолучитьОбласть("Шапка2");
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата	= ДатаСтрокой(Content.Date);
	
	Область.Параметры.ВидОперации = Content.TransferInfo.OperationType;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.Waybills) Тогда
		Waybill = Content.TransferInfo.Waybills[0];
		Область.Параметры.ТранспортнаяНакладнаяНомер = Waybill.DocumentNumber;
		Область.Параметры.ТранспортнаяНакладнаяДата	 = ДатаСтрокой(Waybill.DocumentDate);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_ШапкаТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Область.Параметры.Валюта = ПредставлениеВалютыТорг12(Параметры.Content.Currency);
	
	Таб.Вывести(Область);	
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для Каждого Item Из Параметры.Content.InvoiceTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = СтрокаИлиДефис(Item.Product);
		Область.Параметры.Код		   = СтрокаИлиДефис(Item.VendorCode);
		
		Область.Параметры.ЕдиницаИзмерения	  = СтрокаЕдиницаИзмерения(Item.UnitCode, Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.UnitCode);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = Число_В_Формат(Item.SubtotalWithVatExcluded, "ЧДЦ=2; ЧН=", СтрокаДефис());
		Область.Параметры.СуммаВсего  = СтрокаСуммаВсего(Item.SubTotal, Item.TaxRate, "ЧДЦ=2; ЧН=");
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Параметры.Content.InvoiceTable.TotalNet, Параметры.ФорматКоличества);
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceTable.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Параметры.Content.InvoiceTable.Items) Тогда
		Область.Параметры.СуммаВсего = СтрокаДефис();
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceTable.Total);
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС(Параметры.Content.InvoiceTable.Vat);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалУПД");
	
	Область.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью = КоличествоЗаписейПрописью(Content.InvoiceTable.Items.Количество());
	
	Сумма = ?(ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Content.InvoiceTable.Items), Content.InvoiceTable.TotalWithVatExcluded, Content.InvoiceTable.Total);
	Область.Параметры.СуммаПрописью = СуммаПрописью(Сумма, Content.Currency);
	Область.Параметры.МассаНетто = Content.InvoiceTable.TotalNet;
	
	Подписи = СтрокиПодписей(Content.Signers);
	Область.Параметры.ПродавецПодписант	= Подписи.ФИО;
	Область.Параметры.ПродавецДолжность = Подписи.Должность;
	
	Работник = РаботникИлиИноеЛицо(Content.TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник			= СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
		Область.Параметры.ДатаОтпуска = Формат(Content.TransferInfo.TransferDate, "ДФ='dd MMMM yyyy ""года""'");
	Иначе
		Область.Параметры.ДатаОтпуска = Формат(Content.Date, "ДФ='dd MMMM yyyy ""года""'");
	КонецЕсли;	
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) И ЗначениеЗаполнено(Параметры.BuyerContent.OperationContent) Тогда
		
		Если ЗначениеЗаполнено(Параметры.BuyerContent.AcceptanceDate) Тогда
			ДатаПолучения = Параметры.BuyerContent.AcceptanceDate;
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
			ДатаПолучения = Content.TransferInfo.TransferDate;
		Иначе
			ДатаПолучения = Content.Date;
		КонецЕсли;
		
		Область.Параметры.ДатаПолучения		 = Формат(ДатаПолучения, "ДФ='dd MMMM yyyy ""года""'");
		Область.Параметры.СодержаниеОперации = Параметры.BuyerContent.OperationContent;
		
		Работник = РаботникИлиИноеЛицо(Параметры.BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ГрузПринялФИО		  = СтрокаФИО(Работник);
			Область.Параметры.ГрузПринялДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		Подписи = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ГрузПолучилФИО	   = Подписи.ФИО;
		Область.Параметры.ГрузПолучилДолжность = Подписи.Должность;
		
	КонецЕсли;	
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_Торг12_УПД_820(Параметры)
	
	Параметры.Вставить("Макет", ПолучитьМакет("ТОРГ12"));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Таб = НовыйТабличныйДокумент("DD_ТОРГ12");
	
	ПФ_Торг12_УПД_820_ШапкаДокумента(Таб, Параметры);
	ПФ_Торг12_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_Торг12_УПД_820_СтрокиТаблицы(Таб, Параметры);
	ПФ_Торг12_УПД_820_ПодвалТаблицы(Таб, Параметры);
	ПФ_Торг12_УПД_820_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_Торг12_УПД_820_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Seller		 = ПервыйЭлементКоллекции(Content.Sellers);
	Buyer		 = ПервыйЭлементКоллекции(Content.Buyers);
	Consignee	 = ПервыйЭлементКоллекции(Content.Consignees);
	Shipper		 = ПервыйЭлементКоллекции(Content.Shippers);
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("Колонтитул"));
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка1");
	
	Если ЗначениеЗаполнено(Shipper) 
		И Shipper.SameAsSeller = Ложь 
		И ЗначениеЗаполнено(Shipper.OrganizationInfo.Name) Тогда
		
		Грузоотправитель = Shipper.OrganizationInfo;
	Иначе
		Грузоотправитель = Seller;
	КонецЕсли;
	
	Область.Параметры.Грузоотправитель		 = СтрокаДанныеКонтрагента_820(Грузоотправитель);
	Область.Параметры.Подразделение 		 = Грузоотправитель.Department;
	Область.Параметры.ГрузоотправительПоОКПО = Грузоотправитель.Okpo;
	Область.Параметры.ВидДеятельностиПоОКДП	 = Грузоотправитель.Okdp;
	
	Если ЗначениеЗаполнено(Consignee) Тогда
		Область.Параметры.Грузополучатель		 = СтрокаДанныеКонтрагента_820(Consignee);
		Область.Параметры.ГрузополучательПоОКПО	 = Consignee.Okpo;
	КонецЕсли;
	
	Область.Параметры.Продавец		 = СтрокаДанныеКонтрагента_820(Seller);
	Область.Параметры.ПродавецПоОКПО = Seller.Okpo;
	
	Область.Параметры.Покупатель	   = СтрокаДанныеКонтрагента_820(Buyer);
	Область.Параметры.ПокупательПоОКПО = Buyer.Okpo;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferBases) Тогда
		TransferBase = Content.TransferInfo.TransferBases[0]; 
		Область.Параметры.Основание		 = СтрокаДокументыОснованияУПД(Content.TransferInfo.TransferBases);
		Область.Параметры.ОснованиеДата	 = ДатаСтрокой(TransferBase.DocumentDate);
		Область.Параметры.ОснованиеНомер = TransferBase.DocumentNumber;
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
	Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосКонтракта");
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Content.DocumentDate);
	
	Таб.Вывести(Область);
	
	// Номер и дата документа, номер и дата транспортной накладной
	Область = Параметры.Макет.ПолучитьОбласть("Шапка2");
	
	Область.Параметры.Номер = Content.DocumentNumber;
	Область.Параметры.Дата	= ДатаСтрокой(Content.DocumentDate);
	
	Область.Параметры.ВидОперации = Content.TransferInfo.OperationType;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.Waybills) Тогда
		Waybill = Content.TransferInfo.Waybills[0];
		Область.Параметры.ТранспортнаяНакладнаяНомер = Waybill.DocumentNumber;
		Область.Параметры.ТранспортнаяНакладнаяДата	 = ДатаСтрокой(Waybill.DocumentDate);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_820_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для Каждого Item Из Параметры.Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_Торг12(Item);
		
		Область.Параметры.Код				  = СтрокаИлиДефис(Item.ItemVendorCode);
		Область.Параметры.ЕдиницаИзмерения	  = СтрокаЕдиницаИзмерения(Item.Unit, Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.Unit);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = Число_В_Формат(Item.SubtotalWithVatExcluded, "ЧДЦ=2; ЧН=", СтрокаДефис());
		
		Область.Параметры.СуммаВсего  = СтрокаСуммаВсего_820(Item.SubTotal, Item.HyphenSubtotal);
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС_820(Item.Vat, Item.WithoutVat, Item.HyphenVat, Item.TaxRate);
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_820_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	Table	= Параметры.Content.Table;
	
	Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Table.TotalNet, Параметры.ФорматКоличества);
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Table.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items) Тогда
		Область.Параметры.СуммаВсего = ПодвалСуммаВсего_820(Table.Total, Table.HyphenTotal);
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = ПодвалСуммаВсего_820(Table.Total, Table.HyphenTotal);
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС_820(Table.Vat, Table.WithoutVat, Table.HyphenVat);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_УПД_820_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	Table	= Content.Table;
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалУПД");
	
	КоличествоСтрок = Table.Items.Количество();
	Область.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью = КоличествоЗаписейПрописью(КоличествоСтрок);
	
	Если ЭтоИстина(Table.HyphenTotal) Тогда
		Область.Параметры.СуммаПрописью = СтрокаДефис();
	Иначе
		Сумма = ?(ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items), Table.TotalWithVatExcluded, Table.Total);
		Область.Параметры.СуммаПрописью = СуммаПрописью(Сумма, Content.Currency);
	КонецЕсли;
	
	Область.Параметры.МассаНетто = КоличествоСтрокой(Table.TotalNet, Параметры.ФорматКоличества);
	
	Подписи = СтрокиПодписей(Content.Signers);
	Область.Параметры.ПродавецПодписант	= Подписи.ФИО;
	Область.Параметры.ПродавецДолжность = Подписи.Должность;
	
	Работник = РаботникИлиИноеЛицо(Content.TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник			= СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
		Область.Параметры.ДатаОтпуска = Формат(Content.TransferInfo.TransferDate, "ДФ='dd MMMM yyyy ""года""'");
	Иначе
		Область.Параметры.ДатаОтпуска = Формат(Content.DocumentDate, "ДФ='dd MMMM yyyy ""года""'");
	КонецЕсли;	
	
	// Титул покупателя
	Если Параметры.Свойство("BuyerContent")
		И Параметры.BuyerContent <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(Параметры.BuyerContent.AcceptanceDate) Тогда
			ДатаПолучения = Параметры.BuyerContent.AcceptanceDate;
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
			ДатаПолучения = Content.TransferInfo.TransferDate;
		Иначе
			ДатаПолучения = Content.DocumentDate;
		КонецЕсли;
		
		Область.Параметры.ДатаПолучения			= Формат(ДатаПолучения, "ДФ='dd MMMM yyyy ""года""'");
		Область.Параметры.СодержаниеОперации	= СтрокаСодержаниеОперации(Параметры.BuyerContent);
		
		Работник = РаботникИлиИноеЛицо(Параметры.BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ГрузПринялФИО		  = СтрокаФИО(Работник);
			Область.Параметры.ГрузПринялДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		Подписи = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ГрузПолучилФИО	   = Подписи.ФИО;
		Область.Параметры.ГрузПолучилДолжность = Подписи.Должность;
		
	КонецЕсли;	
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_Торг12_УПД_970(Параметры)
	
