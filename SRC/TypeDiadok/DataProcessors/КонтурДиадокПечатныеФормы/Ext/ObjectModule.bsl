	Область.Параметры.Дата	= ДатаСтрокой(Content.DocumentDate);
	Область.Параметры.ВидОперации = Content.OperationType;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.Waybills) Тогда
		Waybill = Content.TransferInfo.Waybills[0];
		Область.Параметры.ТранспортнаяНакладнаяНомер = Waybill.DocumentNumber;
		Область.Параметры.ТранспортнаяНакладнаяДата	 = ДатаСтрокой(Waybill.DocumentDate);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаИсправление");
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.RevisionDate);
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.RevisionNumber);
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_551_ШапкаТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Область.Параметры.Валюта = ПредставлениеВалютыТорг12(Параметры.Content.Currency);
	
	Таб.Вывести(Область);	
	
КонецПроцедуры

Процедура ПФ_Торг12_551_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для Каждого Item Из Параметры.Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = СтрокаНаименованиеСтрокиНакладной(Item);
		Область.Параметры.Код		   = СтрокаИлиДефис(Item.ProductCode);
		
		Область.Параметры.ЕдиницаИзмерения	  = СтрокаЕдиницаИзмерения(Item.Unit, Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.Unit);
		Область.Параметры.ВидУпаковки		  = Item.PackageType;
		
		Область.Параметры.КоличествоВОдномМесте = Число_В_Формат(Item.QuantityInPack);
		Область.Параметры.КоличествоМест 		= Число_В_Формат(Item.Quantity);
		Область.Параметры.Масса					= КоличествоСтрокой(Item.Gross);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Net, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		
		Область.Параметры.СуммаБезНДС = Число_В_Формат(Item.SubtotalWithVatExcluded, "ЧДЦ=2; ЧН=", СтрокаДефис());
		Область.Параметры.СуммаВсего  = СтрокаСуммаВсего(Item.SubTotal, Item.TaxRate, "ЧДЦ=2; ЧН=");
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_Торг12_551_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.КоличествоМест = Число_В_Формат(Параметры.Content.Table.TotalQuantity);
	Область.Параметры.Масса			 = КоличествоСтрокой(Параметры.Content.Table.TotalGross);
	Область.Параметры.Количество	 = КоличествоСтрокой(Параметры.Content.Table.TotalNet, Параметры.ФорматКоличества);
	
	Область.Параметры.СуммаБезНДС	 = Число_В_Формат(Параметры.Content.Table.TotalWithVatExcluded, "ЧДЦ=2; ЧН=");
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Параметры.Content.Table.Items) Тогда
		Область.Параметры.СуммаВсего = СтрокаДефис();
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = Число_В_Формат(Параметры.Content.Table.Total			   	  , "ЧДЦ=2; ЧН=");
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС(Параметры.Content.Table.TotalVat);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_551_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалУПД");
	
	Область.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью = КоличествоЗаписейПрописью(Content.Table.Items.Количество());
	
	Сумма = ?(ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Content.Table.Items), Content.Table.TotalWithVatExcluded, Content.Table.Total);
	Область.Параметры.СуммаПрописью = СуммаПрописью(Сумма, Content.Currency);
	
	Область.Параметры.МассаНетто = Content.Table.TotalNet;
	Область.Параметры.МассаГруза = Content.Table.TotalGross;
	
	Область.Параметры.КоличествоПриложений = Content.TransferInfo.Attachment;
	
	Подписи = СтрокиПодписей(Content.Signers);
	Область.Параметры.ПродавецПодписант = Подписи.ФИО;
	Область.Параметры.ПродавецДолжность = Подписи.Должность;
	
	Работник = РаботникИлиИноеЛицо(Content.TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник			= СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Область.Параметры.ДатаОтпуска = Формат(Content.TransferInfo.TransferDate, "ДФ='dd MMMM yyyy ""года""'");
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) И ЗначениеЗаполнено(Параметры.BuyerContent.OperationContent) Тогда
		
		Подписи = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ГрузПринялФИО		  = Подписи.ФИО;
		Область.Параметры.ГрузПринялДолжность = Подписи.Должность;
		
		Работник = РаботникИлиИноеЛицо(Параметры.BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ГрузПолучилФИО	   = СтрокаФИО(Работник);
			Область.Параметры.ГрузПолучилДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		Область.Параметры.СодержаниеОперации = Параметры.BuyerContent.OperationContent;
		Область.Параметры.ДатаПолучения = Формат(Параметры.BuyerContent.AcceptanceDate, "ДФ='dd MMMM yyyy ""года""'");
		
	КонецЕсли;	
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_СФ(Параметры)
	
	Параметры.Вставить("Макет"		 , ПолучитьМакет("СФ1137"));
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.Date, Параметры.Content.InvoiceRevisionDate));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.StructedAdditionalInfos);
	
	Если Параметры.ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_СФ1137_" + Параметры.ДатаРедакции);
	
	ПФ_СФ_ШапкаДокумента(Таб, Параметры);
	ПФ_СФ_ШапкаТаблицы(Таб, Параметры);
	ПФ_СФ_СтрокиТаблицы(Таб, Параметры);
	ПФ_СФ_ПодвалТаблицы(Таб, Параметры);
	ПФ_СФ_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции	 

Процедура ПФ_СФ_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата  = ДатаСтрокой(Content.Date);
	
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.InvoiceRevisiondate);
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.InvoiceRevisionNumber);
	
	Область.Параметры.Продавец		= Content.Seller.Name;
	Область.Параметры.ПродавецАдрес	= СтрокаИлиДефис(СтрокаАдрес(Content.Seller.Address));
	Область.Параметры.ПродавецИНН	= СтрокаИННКПП(Content.Seller);
	
	Область.Параметры.Грузоотправитель = ?(Content.Shipper.SameAsSellerOrBuyer = Истина, "он же", СтрокаНаименованиеАдрес(Content.Shipper));
	Область.Параметры.Грузополучатель  = СтрокаНаименованиеАдрес(Content.Consignee);
	
	Область.Параметры.Покупатель	  = Content.Buyer.Name;
	Область.Параметры.ПокупательАдрес = СтрокаИлиДефис(СтрокаАдрес(Content.Buyer.Address));
	Область.Параметры.ПокупательИНН	  = СтрокаИННКПП(Content.Buyer);
	
	Область.Параметры.Валюта = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Таб.Вывести(Область);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции625() Тогда
		
		Область = Параметры.Макет.ПолучитьОбласть("ИдентификаторГосконтракта");
		Область.Параметры.НадписьИдентификаторГосконтракта = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
		
		Таб.Вывести(Область);
		
	КонецЕсли;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_СФ_ШапкаТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Область.Параметры.НадписьНомерТД = ?(Параметры.ДатаРедакции >= ДатаРедакции981(), "Регистрационный номер таможенной декларации", "Номер таможенной декларации");
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_СФ_СтрокиТаблицы(Таб, Параметры)
	
	Для каждого Item Из Параметры.Content.Items Цикл 
		
		СтрокаДопСведений = "";

		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокой(Item.StructedAdditionalInfos);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаДефис();
		КонецЕсли;
		
		Область.Параметры.Наименование 		  = СтрокаИлиДефис(Item.Product);
		Область.Параметры.ЕдиницаИзмерения    = СтрокаИлиДефис(НаименованиеЕдиницыИзмерения(Item.UnitCode));
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.UnitCode);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.TotalWithVatExcluded);
		Область.Параметры.СуммаВсего  = СуммаСтрокойИлиДефис(Item.Total);
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
		Область.Параметры.Акциз		  = СтрокаАкциз(Item.Excise, Item.TaxRate);
		
		Область.Параметры.Страна 	= СтрокаИлиДефис(НаименованиеСтраны(Item.CountriesOfOrigin));
		Область.Параметры.СтранаКод	= СтрокаИлиДефис(Item.CountriesOfOrigin);
		Область.Параметры.НомерТД 	= СтрокаИлиДефис(Item.CustomsDeclarationNumbers);
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_СФ_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Параметры.Content.Totals.TotalWithVatExcluded);
	Область.Параметры.СуммаВсего  = СуммаСтрокойИлиДефис(Параметры.Content.Totals.Total);
	Область.Параметры.СуммаНДС	  = ПодвалСуммаНДС(Параметры.Content.Totals.Vat);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_СФ_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Если Параметры.Content.Signer.IsSoleProprietor = Истина Тогда 
		Область.Параметры.ПодписьФЛ	  = "Электронная подпись";
		Область.Параметры.ПодписантФЛ = СтрокаФИО(Параметры.Content.Signer);
		Область.Параметры.НомерСВ	  =	Параметры.Content.Signer.SoleProprietorRegistrationCertificate;
	Иначе 
		Область.Параметры.ПодписьЮЛ	  = "Электронная подпись";
		Область.параметры.ПодписантЮЛ = СтрокаФИО(Параметры.Content.Signer);
	КонецЕсли;	
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель = "Индивидуальный предприниматель" + ?(Параметры.ДатаРедакции >= ДатаРедакции981(), " или иное уполномоченное лицо", "");
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_СФ_УПД(Параметры)
	
