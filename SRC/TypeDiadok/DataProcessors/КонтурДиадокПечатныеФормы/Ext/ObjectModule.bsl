// Возвращает функцию УПД/УКД в терминах Proto структуры Диадока FunctionType.
//
// Параметры:
//	 ФункцияУПД	- Строка - Функция УПД/УКД в формате ФНС или в формате Proto структуры Диадока FunctionType.
//
// Возвращаемое значение:
//	 Строка - ФункцияУПД в терминах Proto структуры Диадока FunctionType: Invoice, Basic, InvoiceAndBasic.
//			  http://api-docs.diadoc.ru/ru/latest/proto/utd/UniversalTransferDocumentSellerTitleInfo.html?highlight=functiontype
//
Функция ProtoFunctionType(ФункцияУПД)
	
	Если ФункцияУПД = ФункцияСЧФДОП()
		Или ФункцияУПД = ФункцияКСЧФДИС()
		Или ФункцияУПД = ПротофункцияInvoiceAndBasic() Тогда
		
		Результат = ПротофункцияInvoiceAndBasic();
		
	ИначеЕсли ФункцияУПД = ФункцияДОП()
		Или ФункцияУПД = ФункцияДИС()
		Или ФункцияУПД = ПротофункцияBasic() Тогда
		
		Результат = ПротофункцияBasic();
		
	ИначеЕсли ФункцияУПД = ФункцияСЧФ()
		Или ФункцияУПД = ФункцияКСЧФ()
		Или ФункцияУПД = ПротофункцияInvoice() Тогда
		
		Результат = ПротофункцияInvoice();
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

