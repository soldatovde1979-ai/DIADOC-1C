Функция ПФ_КСФ_УКД(Параметры)
	
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.Date, Параметры.Content.RevisionDate));
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		Параметры.Вставить("ИмяМакета", "КСФ1137_534");
	Иначе
		Параметры.Вставить("ИмяМакета", "КСФ1137");
	КонецЕсли;
	
	Параметры.Вставить("Макет", ПолучитьМакет(Параметры.ИмяМакета));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Если Параметры.ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_КСФ1137_" + Параметры.ДатаРедакции);
	
	ПФ_КСФ_УКД_ШапкаДокумента(Таб, Параметры);
	ПФ_КСФ_УКД_ШапкаТаблицы(Таб, Параметры);
	ПФ_КСФ_УКД_СтрокиТаблицы(Таб, Параметры);
	ПФ_КСФ_УКД_ПодвалТаблицы(Таб, Параметры);
	ПФ_КСФ_УКД_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

