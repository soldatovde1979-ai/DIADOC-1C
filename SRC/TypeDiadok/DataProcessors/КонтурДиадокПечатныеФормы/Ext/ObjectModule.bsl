Функция СтрокаДанныеКонтрагента(OrgInfo)
	
	Результат = "";
	Разделитель = "";
	
	// Наименование
	Если ЗначениеЗаполнено(OrgInfo.Name) Тогда
		Результат = Результат + Разделитель + OrgInfo.Name;
		Разделитель = ", ";
	КонецЕсли;
	
	// ИНН/КПП
	Если ЗначениеЗаполнено(OrgInfo.Inn) Тогда
		Если ЗначениеЗаполнено(OrgInfo.Kpp) Тогда
			Результат = Результат + Разделитель + "ИНН/КПП: " + OrgInfo.Inn + "/" + OrgInfo.Kpp;
			Разделитель = ", ";
		Иначе
			Результат = Результат + Разделитель + "ИНН: " + OrgInfo.Inn;
			Разделитель = ", ";
		КонецЕсли;
	КонецЕсли;
	
	// Адрес
	Адрес = СтрокаАдрес(OrgInfo.Address);
	Если ЗначениеЗаполнено(Адрес) Тогда
		Результат = Результат + Разделитель + Адрес;
		Разделитель = ", ";
	КонецЕсли;
	
	// Телефон
	Если ЗначениеЗаполнено(OrgInfo.Phone) Тогда
		Результат = Результат + Разделитель + OrgInfo.Phone;
		Разделитель = ", ";
	КонецЕсли;
	
	// Факс
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OrgInfo, "Fax") И ЗначениеЗаполнено(OrgInfo.Fax) Тогда
		Результат = Результат + Разделитель + "факс: " + OrgInfo.Fax;
		Разделитель = ", ";
	КонецЕсли;
	
	// Расчетный счет
	Если ЗначениеЗаполнено(OrgInfo.BankAccountNumber) Тогда
		Результат = Результат + Разделитель + "р/с: " + OrgInfo.BankAccountNumber;
		Разделитель = ", ";
	КонецЕсли;
	
	// Наименование банка
	Если ЗначениеЗаполнено(OrgInfo.BankName) Тогда
		Результат = Результат + Разделитель + "в банке " + OrgInfo.BankName;
		Разделитель = ", ";
	КонецЕсли;
	
	// БИК банка
	Если ЗначениеЗаполнено(OrgInfo.BankId) Тогда
		Результат = Результат + Разделитель + "БИК " + OrgInfo.BankId;
		Разделитель = ", ";
	КонецЕсли;
	
	// Кор. счет
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OrgInfo, "CorrespondentAccount") И ЗначениеЗаполнено(OrgInfo.CorrespondentAccount) Тогда
		Результат = Результат + Разделитель + "к/с: " + OrgInfo.CorrespondentAccount;
		Разделитель = ", ";
	КонецЕсли;
	
	Возврат Результат;
	
