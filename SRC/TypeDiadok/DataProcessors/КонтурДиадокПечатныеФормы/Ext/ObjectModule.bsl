			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки  = НомерСтроки;
		
		Область.Параметры.Наименование	   = Item.Product;
		Область.Параметры.ЕдиницаИзмерения = СтрокаЕдиницаИзмерения(Item.UnitCode, Item.UnitName);
		
		Область.Параметры.Количество   = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		   = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС  = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		Область.Параметры.СуммаВсего   = СуммаСтрокойИлиДефис(Item.Subtotal);
		Область.Параметры.СуммаНДС	   = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
		
