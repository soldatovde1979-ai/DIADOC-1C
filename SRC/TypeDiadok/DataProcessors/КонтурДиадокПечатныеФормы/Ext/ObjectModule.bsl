// Конструктор структуры с полями "Ключ" и "Значение".
//
// Параметры:
//  Ключ - Строка - значение поля "Ключ".
//  Значение - Строка - значение поля "Значение".
// 
// Возвращаемое значение:
//  Структура:
//    * Ключ - Строка
//    * Значение - Строка
//
Функция НовыйКлючЗначение(Ключ, Значение)
	
	Результат = Новый Структура;
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Значение", Значение);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьКлючЗначение(КлючиИЗначения, Ключ, Значение)
	
	Элемент = НовыйКлючЗначение(Ключ, Значение);
	КлючиИЗначения.Добавить(Элемент);
	
КонецПроцедуры

Функция Тест_ПредставлениеАдрРФ(AddressInfo) Экспорт
