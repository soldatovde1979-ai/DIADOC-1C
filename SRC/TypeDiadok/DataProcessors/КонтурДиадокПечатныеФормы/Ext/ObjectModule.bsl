Процедура ПФ_УПД_970_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();

		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) И КоличествоСтрокСПрослеживаемостью <= 1 Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;

		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Код = ПредставлениеКодТов(Item, Параметры.ВыводитьНаименованиеТовараСКодами);				
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_УПД_УКД(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		
		Область.Параметры.КодВТ = СтрокаИлиДефис(Item.ItemTypeCode);
		
		Область.Параметры.ЕдиницаИзмерения = СтрокаЕдиницаИзмерения_970(Item.UnitName);
		
		Если ЗначениеЗаполнено(Item.Unit) Тогда
			ЕдиницаИзмеренияКод = Item.Unit;
		Иначе
			ЕдиницаИзмеренияКод = СтрокаДефис();
		КонецЕсли;
		Область.Параметры.ЕдиницаИзмеренияКод = ЕдиницаИзмеренияКод;
		
		Область.Параметры.Количество = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Item.SubTotal);
		
		Область.Параметры.СтавкаНДС = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС = СтрокаСуммаНДС_970(Item.Vat, Item.WithoutVat, Item.TaxRate);
		Область.Параметры.Акциз = СтрокаАкциз_970(Item.Excise);
		
		Строки = СтрокиНомеровДТ_970(Item.CustomDeclarations);
		Область.Параметры.Страна = Строки.Страны;
		Область.Параметры.СтранаКод = Строки.КодыСтран;
		Область.Параметры.НомерТД = Строки.НомераДТ;
		
		ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УПД(Область, Item, Строки.НомераДТ, Параметры);
		
		Таб.Вывести(Область);

		Если КоличествоСтрокСПрослеживаемостью > 1 Тогда
			ЗаполнитьПараметрыПрослеживаемостиСтрок_УПД(Таб, Item, СтрокаДопСведений, НомераКолонок_УПД_534_Прослеж(Параметры), Параметры);
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_УПД_970_ПодвалТаблицы(Таб, Параметры)
	
	Если Параметры.ДатаРедакции >= ДатаРедакции425() Тогда
		
		Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицыЮЛФЛ");
		ПФ_УПД_СФ_970_ПодписьСоставителя425(Область, Параметры);
		
	Иначе
		
		Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
		ПФ_УПД_970_ПодписьСоставителя(Область, Параметры);
		
	КонецЕсли;
	
	ПФ_УПД_СФ_970_ЗаполнитьСуммыИтогоТаблицы(Область, Параметры);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_СФ_970_ЗаполнитьСуммыИтогоТаблицы(Область, Параметры)
	
	Table = Параметры.Content.Table;
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Table.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items) Тогда
		Область.Параметры.СуммаВсего = СтрокаДефис();
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Table.Total);
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС_970(Table.Vat, Table.WithoutVat);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_УПД_970_ПодписьСоставителя(Область, Параметры)
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись = Параметры.ПодписиПродавца.Подпись;
	
КонецПроцедуры

Процедура ПФ_УПД_СФ_970_ПодписьСоставителя425(Область, Параметры)
	
	Подписанты = Параметры.Content.Signers;
	Если Подписанты.Количество() > 0 Тогда
		
		ПодписиПродавца = СтрокиПодписей_970(Подписанты);
		
		ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
		
		Seller = ПервыйЭлементКоллекции(Параметры.Content.Sellers);
		
		Если Seller.Type = ВидыЮрФизЛиц.ЮридическоеЛицо
			Или Seller.Type = ВидыЮрФизЛиц.ИностраннаяОрганизация Тогда
			Область.Параметры.ПодписьЮЛ = ПодписиПродавца.Подпись;
			Область.Параметры.ПодписантЮЛ = ПодписиПродавца.ФИО;
		Иначе
			Область.Параметры.ПодписьФЛ = ПодписиПродавца.Подпись;
			Область.Параметры.ПодписантФЛ = ПодписиПродавца.ФИО;
			Область.Параметры.НомерСВ = ПФ_СтрокаНомерСВ_УПД_СФ(Seller.IndividualEntityRegistrationNumber,
				Seller.IndividualEntityRegistrationDate);
		КонецЕсли;
		
	КонецЕсли;
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель =
		"Индивидуальный предприниматель или иное уполномоченное лицо";
	
КонецПроцедуры

Функция ПФ_СтрокаНомерСВ_УПД_СФ(IndividualEntityRegistrationNumber, IndividualEntityRegistrationDate)
	
	ШаблонСтрокиНомерСВ = "ОГРНИП %1, дата регистрации %2";
	
	Результат = Общее_ПодставитьПараметрыВСтроку(
		ШаблонСтрокиНомерСВ,
		IndividualEntityRegistrationNumber,
		ДатаСтрокойИлиДефис(IndividualEntityRegistrationDate)
	);
	
	Возврат Результат;
	
КонецФункции

Процедура ПФ_УПД_970_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	TransferInfo = Content.TransferInfo;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Если TransferInfo.WithoutTransferBase = Истина Тогда
		Область.Параметры.Основания = СтрокаБезДокументаОснования();
	Иначе
		Область.Параметры.Основания = СтрокаДокументыОснованияУПД970(TransferInfo.TransferBases);
	КонецЕсли;
	
	Область.Параметры.ПродавецСоставитель  = Content.DocumentCreator;
	Область.Параметры.ПродавецИныеСведения = Параметры.ДопСведения.top;
	Область.Параметры.СведенияОТранспортировкеИГрузе = TransferInfo.TransferTextInfo;
	
	Работник = РаботникИлиИноеЛицо(TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник			= СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись 	= Параметры.ПодписиПродавца.Подпись;
	Область.Параметры.ПродавецДолжность = Параметры.ПодписиПродавца.Должность;
	
	Если ЗначениеЗаполнено(TransferInfo.TransferDate) Тогда
		ДатаОтпуска = TransferInfo.TransferDate;
	Иначе
		ДатаОтпуска = Content.DocumentDate;
	КонецЕсли;
	Область.Параметры.ДатаОтпуска = Формат(ДатаОтпуска, "ДФ='dd MMMM yyyy ""года""'");
	
	// Титул покупателя
	Если Параметры.Свойство("BuyerContent")
		И Параметры.BuyerContent <> Неопределено Тогда
		
		BuyerContent = Параметры.BuyerContent;
		
		Если ЗначениеЗаполнено(BuyerContent.AcceptanceDate) Тогда
			ДатаПолучения = BuyerContent.AcceptanceDate;
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
			ДатаПолучения = Content.TransferInfo.TransferDate;
		Иначе
			ДатаПолучения = Content.DocumentDate;
		КонецЕсли;
		
		Область.Параметры.ДатаПолучения	= Формат(ДатаПолучения, "ДФ='dd MMMM yyyy ""года""'");
		Область.Параметры.ПокупательСоставитель = BuyerContent.DocumentCreator;
		Область.Параметры.РезультатыПриемки	= СтрокаСодержаниеОперации_970(BuyerContent);
		
		Работник = РаботникИлиИноеЛицо(BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ПокупательРаботник = СтрокаФИО(Работник);
			Область.Параметры.ПокупательРаботникДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		ПодписиBuyer = СтрокиПодписей_970(BuyerContent.Signers);
		Область.Параметры.ПокупательПодписант = ПодписиBuyer.ФИО;
		Область.Параметры.ПокупательПодпись   = ПодписиBuyer.Подпись;
		Область.Параметры.ПокупательДолжность = ПодписиBuyer.Должность;
		
		ЕстьИнфПолФХЖ4 = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(BuyerContent.AdditionalInfoId, "StructedAdditionalInfos");
		Если ЕстьИнфПолФХЖ4 Тогда
			
			МассивИнфПолФХЖ4 = BuyerContent.AdditionalInfoId.StructedAdditionalInfos;
			Если ЗначениеЗаполнено(МассивИнфПолФХЖ4) Тогда
				СтрокаИнфПолФХЖ4 = ДопСведенияСтрокой(МассивИнфПолФХЖ4);
			    Область.Параметры.ПокупательИныеСведения = СтрокаИнфПолФХЖ4;
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	МассивИнфПолФХЖ3 = TransferInfo.AdditionalInfoId.StructedAdditionalInfos;
	
	Если ЗначениеЗаполнено(МассивИнфПолФХЖ3) Тогда
		
		ИнфПолФХЖ3 = ДопСведенияСтрокой(МассивИнфПолФХЖ3);
		
		Область.Параметры.ИнфПолФХЖ3 = ИнфПолФХЖ3;
		
	Иначе
		Область.УдалитьОбласть(Область.Область("ИнфПолФХЖ3"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры

Функция ПФ_УКД(Параметры)
	
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.Date, Параметры.Content.RevisionDate));
	Параметры.Вставить("ПодписиПродавца", СтрокиПодписей(Параметры.Content.Signers));
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		Параметры.Вставить("Макет", ПолучитьМакет("УКД_534"));
	Иначе
		Параметры.Вставить("Макет", ПолучитьМакет("УКД"));
	КонецЕсли;
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Если Параметры.ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_УКД_" + Параметры.ДатаРедакции);
	
	ПФ_УКД_ШапкаДокумента(Таб, Параметры);
	ПФ_УКД_ШапкаТаблицы(Таб, Параметры);
	ПФ_УКД_СтрокиТаблицы(Таб, Параметры);
	
	ПФ_УКД_ПодвалТаблицы(Таб, Параметры);
	ПФ_УКД_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_УКД_ШапкаДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	БазоваяФункция = ProtoFunctionType(Content.Function);
	Если БазоваяФункция <> ПротофункцияBasic() Тогда
		Область.Параметры.Постановление = СтрокаПостановлениеУПД_УКД(Истина);
		Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	КонецЕсли;
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата	= Дата_В_Формат(Content.Date, "ДФ=dd.MM.yyyy; ДП=-");
	
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.RevisionNumber);
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.RevisionDate);
	
	Область.Параметры.Продавец		   = Content.Seller.Name;
	Область.Параметры.ПродавецАдрес	   = СтрокаАдрес(Content.Seller.Address);
	Область.Параметры.ПродавецИНН	   = СтрокаИННКПП(Content.Seller);
	
	ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Seller);
	Если ПродавецБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПродавецБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПродавецБанковскиеРеквизиты = ПродавецБанковскиеРеквизиты;
	КонецЕсли;
	
	ПродавецКонтакты = СтрокаТелефонЭлПочта(Content.Seller);
	Если ЗначениеЗаполнено(ПродавецКонтакты) Тогда
		Область.Параметры.ПродавецКонтакты = ПродавецКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПродавецКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Область.Параметры.Покупатель		 = Content.Buyer.Name;
	Область.Параметры.ПокупательАдрес	 = СтрокаАдрес(Content.Buyer.Address);
	Область.Параметры.ПокупательИНН		 = СтрокаИННКПП(Content.Buyer);
	
	ПокупательБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Buyer);
	Если ПокупательБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПокупательБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПокупательБанковскиеРеквизиты = ПокупательБанковскиеРеквизиты;
	КонецЕсли;
	
	ПокупательКонтакты = СтрокаТелефонЭлПочта(Content.Buyer);
	Если ЗначениеЗаполнено(ПокупательКонтакты) Тогда
		Область.Параметры.ПокупательКонтакты = ПокупательКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПокупательКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Область.Параметры.Валюта		 = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.СтатусУКД		 = СтрокаСтатусУКД(Content.Function);
	Область.Параметры.СчетаФактуры	 = СтрокаСтрокаСчетаФактурыУКД(Content.Invoices);
	
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции, Истина);
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_УКД_ШапкаТаблицы(Таб, Параметры)
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
КонецПроцедуры

Процедура ПФ_УКД_СтрокиТаблицы(Таб, Параметры)
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		НомераКолонокДляПодстрок = НомераКолонок_УКД_534_Прослеж(Параметры, Истина);
		НомераКолонок = НомераКолонок_УКД_534_Прослеж(Параметры);
		НомерКолонкиКодВидаТовара = НомерКолонки_УКД_534_Прослеж_КодВидаТовара();
	Иначе
		НомераКолонокДляПодстрок = НомераКолонок_УКД();
		НомераКолонок = НомераКолонок_УКД();
		НомерКолонкиКодВидаТовара = НомерКолонки_УКД_КодВидаТовара();
	КонецЕсли;
	
	НомерСтроки = 0;
	ДатаДокумента = Параметры.ДатаРедакции;
	
	Для каждого Item Из Параметры.Content.InvoiceCorrectionTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		НомерПервойСтроки = Таб.ВысотаТаблицы + 1;
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаА");
		
		Если ДатаДокумента >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаДефис();
		КонецЕсли;
		
		ПФ_КСФУКД_ЗаполнитьНомерСтрокиТаблицы(
			Область,
			Item,
			ДатаДокумента,
			НомерСтроки
		);
		
		Область.Параметры.Код		   = СтрокаДефис();
		Область.Параметры.Наименование = СтрокаИлиДефис(Item.Product);
		
		ПФ_УКД_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаБ");
		ПФ_УКД_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры, "После");
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаВ");
		ПФ_УКД_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаГ");
		ПФ_УКД_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, Параметры, "Уменьшение");
		
		ПФ_СтрокаДопСведений_КСФ_УКД(Таб, Item, НомерПервойСтроки, НомераКолонок, НомерКолонкиКодВидаТовара, Параметры);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_УКД_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры, Суффикс = "До")
	
	InvoiceItemFields = ?(Суффикс = "До", Item.OriginalValues, Item.CorrectedValues);
	
	Область.Параметры["ЕдиницаИзмеренияКод" + Суффикс] = СтрокаИлиДефис(InvoiceItemFields.UnitCode);
	Область.Параметры["ЕдиницаИзмерения" + Суффикс] = СтрокаИлиДефис(НаименованиеЕдиницыИзмерения(InvoiceItemFields.UnitCode));
	Область.Параметры["Количество" + Суффикс] = КоличествоСтрокойИлиДефис(InvoiceItemFields.Quantity, Параметры.ФорматКоличества);
	Область.Параметры["Цена" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Price, Параметры.ФорматСуммы);
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.TotalWithVatExcluded);
	Область.Параметры["Акциз" + Суффикс] = СтрокаАкциз(InvoiceItemFields.Excise, InvoiceItemFields.TaxRate);
	Область.Параметры["СтавкаНДС" + Суффикс] = СтрокаСтавкаНДС(InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаСуммаНДС(InvoiceItemFields.Vat, InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаВсего" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Total);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УКД(Область, Item, СтрокаДефис(), Параметры);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УКД_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, Параметры, Суффикс = "Увеличение")
	
	AmountsDiff = ?(Суффикс = "Увеличение", Item.AmountsInc, Item.AmountsDec);
	
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(AmountsDiff.TotalWithVatExcluded);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаРазнСумНал(AmountsDiff.Vat, Item.CorrectedValues.TaxRate);
	Область.Параметры["СуммаВсего" + Суффикс] = СтрокаСтоим(AmountsDiff.Total, Item.CorrectedValues.TaxRate);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УКД(Область, Item, СтрокаХ(), Параметры);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УКД_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.СуммаБезНДСУвеличение = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded);
	Область.Параметры.СуммаБезНДСУменьшение = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded);
	
	ВоВсехСтрокахСтавкаНДСИсчНалАг = ВсеСтрокиУКДСодержатСтавкуНДС_ИсчНалАг(Параметры.Content.InvoiceCorrectionTable.Items);
	
	ЕстьСтавкаНДС = ЕстьСтрокиСПрямымиСтавкамиНДС736(Параметры.Content);
	
	ЭтоУвеличение = Привести_К_Числу(Параметры.Content.InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded) >= Привести_К_Числу(Параметры.Content.InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded);
	
	УвеличениеУменьшение = ВСтрокахУКДЕстьУвеличениеУменьшение(Параметры.Content.InvoiceCorrectionTable.Items);
	
	Область.Параметры.СуммаНДСУвеличение = СтрокаСумНДСУвелУм(Параметры.Content.InvoiceCorrectionTable.TotalsInc.Vat, ВоВсехСтрокахСтавкаНДСИсчНалАг, ЕстьСтавкаНДС, Не УвеличениеУменьшение.ЕстьУвеличение);
	Область.Параметры.СуммаНДСУменьшение = СтрокаСумНДСУвелУм(Параметры.Content.InvoiceCorrectionTable.TotalsDec.Vat, ВоВсехСтрокахСтавкаНДСИсчНалАг, ЕстьСтавкаНДС, Не УвеличениеУменьшение.ЕстьУменьшение);
	
	Область.Параметры.СуммаВсегоУвеличение = СтрокаВсегоУвелУм(Параметры.Content.InvoiceCorrectionTable.TotalsInc.Total, ВоВсехСтрокахСтавкаНДСИсчНалАг, Не ЭтоУвеличение);
	Область.Параметры.СуммаВсегоУменьшение = СтрокаВсегоУвелУм(Параметры.Content.InvoiceCorrectionTable.TotalsDec.Total, ВоВсехСтрокахСтавкаНДСИсчНалАг, ЭтоУвеличение);
	
	Область.Параметры.ПродавецПодписант	= Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись	= Параметры.ПодписиПродавца.Подпись;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УКД_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Область.Параметры.ПродавецПодписант	= Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись	= Параметры.ПодписиПродавца.Подпись;
	Область.Параметры.ПродавецДолжность = Параметры.ПодписиПродавца.Должность;
	
	Область.Параметры.ИныеСведения		 	 = Content.EventContent.CostChangeInfo;
	Область.Параметры.ПередаточныеДокументы  = Content.EventContent.TransferDocDetails;
	Область.Параметры.ОснованияКорректировки = СтрокаОснованияКорректировки(Content.EventContent.CorrectionBases);
	
	Область.Параметры.ПродавецСоставитель	  	 = Content.Creator;
	Область.Параметры.ПродавецСодержаниеОперации = Content.EventContent.OperationContent;
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) Тогда
		
		Область.Параметры.ПокупательСоставитель		   = Параметры.BuyerContent.Creator;
		Область.Параметры.ПокупательСодержаниеОперации = Параметры.BuyerContent.OperationContent;
		
		ПодписиBuyer = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ПокупательПодписант = ПодписиBuyer.ФИО;
		Область.Параметры.ПокупательПодпись	  = ПодписиBuyer.Подпись;
		Область.Параметры.ПокупательДолжность = ПодписиBuyer.Должность;
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры

Функция ЭтоИзвестнаяФункцияУКД(ЗначениеФункции)
	
	ВозможныеЗначения = Новый Массив;
	ВозможныеЗначения.Добавить(ФункцияКСЧФДИС());
	ВозможныеЗначения.Добавить(ФункцияКСЧФ());
	ВозможныеЗначения.Добавить(ФункцияДИС());
	ВозможныеЗначения.Добавить(ПротофункцияInvoiceAndBasic());
	ВозможныеЗначения.Добавить(ПротофункцияInvoice());
	ВозможныеЗначения.Добавить(ПротофункцияBasic());
	
	Результат = (ВозможныеЗначения.Найти(ЗначениеФункции) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ПФ_УКД_736(Параметры)
	
	ЗначениеФункции = Параметры.Content.Function;
	
	Если Не ЭтоИзвестнаяФункцияУКД(ЗначениеФункции) Тогда
		
		Если ЕстьСведенияОИсправлении(Параметры.Content) Тогда
			ТипДокумента = ТипУниверсальныйКорректировочныйДокументИсправление();
		Иначе
			ТипДокумента = ТипУниверсальныйКорректировочныйДокумент();
		КонецЕсли;
		ТипКонтента = КонтентИнформацияПродавца736();
		Таб = ПечатнаяФормаЗаглушка(ТипДокумента, ТипКонтента, ЗначениеФункции);
		
		Возврат Таб;
		
	КонецЕсли;
	
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.Date, Параметры.Content.RevisionDate));
	Параметры.Вставить("ПодписиПродавца", СтрокиПодписей(Параметры.Content.Signers));
	Параметры.Вставить("ЕстьСведенияОПрослеживаемости", ЕстьСведенияОПрослеживаемости736(Параметры.Content));
	
	Если Параметры.ДатаРедакции = ДатаРедакции1096()
		ИЛИ Параметры.ДатаРедакции = ДатаРедакции425() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("УКД_1096_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("УКД_534"));	
		КонецЕсли;
		
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("УКД_534_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("УКД_534"));	
		КонецЕсли;
		
	Иначе
		Параметры.Вставить("Макет", ПолучитьМакет("УКД"));	
		
	КонецЕсли;
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Таб = НовыйТабличныйДокумент("DD_УКД_" + Параметры.ДатаРедакции);
	
	ПФ_УКД_736_ШапкаДокумента(Таб, Параметры);
	ПФ_УКД_736_ШапкаТаблицы(Таб, Параметры);
	ПФ_УКД_736_СтрокиТаблицы(Таб, Параметры);
	
	ПФ_УКД_736_ПодвалТаблицы(Таб, Параметры);
	ПФ_УКД_736_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;	
КонецФункции

Процедура ПФ_УКД_736_ШапкаДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	БазоваяФункция = ProtoFunctionType(Content.Function);
	Если БазоваяФункция <> ПротофункцияBasic() Тогда
		Область.Параметры.Постановление = СтрокаПостановлениеУПД_УКД(Истина);
		Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	КонецЕсли;
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата	= Дата_В_Формат(Content.Date, "ДФ=dd.MM.yyyy; ДП=-");
	
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.RevisionNumber);
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.RevisionDate);
	
	Область.Параметры.Продавец		   = Content.Seller.Name;
	Область.Параметры.ПродавецАдрес	   = СтрокаАдрес_736(Content.Seller.Address);
	Область.Параметры.ПродавецИНН	   = СтрокаИННКПП(Content.Seller);
	
	ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Seller);
	Если ПродавецБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПродавецБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПродавецБанковскиеРеквизиты = ПродавецБанковскиеРеквизиты;
	КонецЕсли;
	
	ПродавецКонтакты = СтрокаТелефонЭлПочта(Content.Seller);
	Если ЗначениеЗаполнено(ПродавецКонтакты) Тогда
		Область.Параметры.ПродавецКонтакты = ПродавецКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПродавецКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Область.Параметры.Покупатель		 = Content.Buyer.Name;
	Область.Параметры.ПокупательАдрес	 = СтрокаАдрес_736(Content.Buyer.Address);
	Область.Параметры.ПокупательИНН		 = СтрокаИННКПП(Content.Buyer);
	
	ПокупательБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Buyer);
	Если ПокупательБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПокупательБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПокупательБанковскиеРеквизиты = ПокупательБанковскиеРеквизиты;
	КонецЕсли;
	
	ПокупательКонтакты = СтрокаТелефонЭлПочта(Content.Buyer);
	Если ЗначениеЗаполнено(ПокупательКонтакты) Тогда
		Область.Параметры.ПокупательКонтакты = ПокупательКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПокупательКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Область.Параметры.Валюта		 = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.СтатусУКД		 = СтрокаСтатусУКД(Content.Function);
	Область.Параметры.СчетаФактуры	 = СтрокаСтрокаСчетаФактурыУКД(Content.Invoices);
	
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции, Истина);
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_УКД_736_ШапкаТаблицы(Таб, Параметры)
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
КонецПроцедуры

Процедура ПФ_УКД_736_СтрокиТаблицы(Таб, Параметры)
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		НомераКолонокДляПодстрок = НомераКолонок_УКД_534_Прослеж(Параметры, Истина);
		НомераКолонок = НомераКолонок_УКД_534_Прослеж(Параметры);
		НомерКолонкиКодВидаТовара = НомерКолонки_УКД_534_Прослеж_КодВидаТовара();
	Иначе
		НомераКолонокДляПодстрок = НомераКолонок_УКД_534(Параметры, Истина);
		НомераКолонок = НомераКолонок_УКД_534(Параметры);
		НомерКолонкиКодВидаТовара = НомерКолонки_УКД_534_КодВидаТовара();
	КонецЕсли;
	
	НомерСтроки = 0;
	ДатаДокумента = Параметры.ДатаРедакции;
	
	Для каждого Item Из Параметры.Content.InvoiceCorrectionTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		НомерПервойСтроки = Таб.ВысотаТаблицы + 1;
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаА");
		
		Область.Параметры.КодВТ = СтрокаИлиДефис(Item.ItemTypeCode);
		
		ПФ_КСФУКД_ЗаполнитьНомерСтрокиТаблицы(
			Область,
			Item,
			ДатаДокумента,
			НомерСтроки
		);
		
		Область.Параметры.Код = ПредставлениеКодТов(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_УПД_УКД(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		
		ПФ_УКД_736_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаБ");
		ПФ_УКД_736_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры, "После");
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаВ");
		ПФ_УКД_736_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, НомераКолонокДляПодстрок, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаГ");
		ПФ_УКД_736_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, НомераКолонокДляПодстрок, Параметры, "Уменьшение");
		
		ПФ_СтрокаДопСведений_КСФ_УКД(Таб, Item, НомерПервойСтроки, НомераКолонок, НомерКолонкиКодВидаТовара, Параметры);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_УКД_736_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры, Суффикс = "До")
	
	InvoiceItemFields = ?(Суффикс = "До", Item.OriginalValues, Item.CorrectedValues);
	КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
	
	Область.Параметры["ЕдиницаИзмеренияКод" + Суффикс] = СтрокаИлиДефис(InvoiceItemFields.UnitCode);
	Область.Параметры["ЕдиницаИзмерения" + Суффикс] = СтрокаИлиДефис(InvoiceItemFields.UnitName);
	Область.Параметры["Количество" + Суффикс] = КоличествоСтрокойИлиДефис(InvoiceItemFields.Quantity, Параметры.ФорматКоличества);
	Область.Параметры["Цена" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Price, Параметры.ФорматСуммы);
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.TotalWithVatExcluded);
	Область.Параметры["Акциз" + Суффикс] = СтрокаАкциз(InvoiceItemFields.Excise, InvoiceItemFields.TaxRate);
	Область.Параметры["СтавкаНДС" + Суффикс] = СтрокаСтавкаНДС(InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаСуммаНДС_736(InvoiceItemFields.Vat, InvoiceItemFields.WithoutVat, InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаВсего" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Total);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		ЗаполнитьПараметрыСтраныПроисхождения_УКД(Область, Item);
		
		Если КоличествоСтрокСПрослеживаемостью > 0 Тогда
			ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УКД(Область, Item, СтрокаДефис(), Параметры);
		КонецЕсли;
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() И КоличествоСтрокСПрослеживаемостью > 1 Тогда
		ИмяОбласти = ?(Суффикс = "До", "СтрокаА", "СтрокаБ");
		ЗаполнитьПараметрыПрослеживаемостиСтрок_УКД(Таб, ИмяОбласти, Item, НомераКолонок_УКД_534_Прослеж(Параметры, Истина), Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_УКД_736_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, НомераКолонок, Параметры, Суффикс = "Увеличение")
	
	AmountsDiff = ?(Суффикс = "Увеличение", Item.AmountsInc, Item.AmountsDec);
	
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(AmountsDiff.TotalWithVatExcluded);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаРазнСумНал(AmountsDiff.Vat, Item.CorrectedValues.TaxRate);
	Область.Параметры["СуммаВсего" + Суффикс] = СтрокаСтоим(AmountsDiff.Total, Item.CorrectedValues.TaxRate);
	
	ПараметрыАкциз = Новый Структура;
	ПараметрыАкциз.Вставить("Акциз" + Суффикс, СуммаСтрокойИлиДефис(AmountsDiff.Excise));
	Область.Параметры.Заполнить(ПараметрыАкциз);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УКД(Область, Item, СтрокаХ(), Параметры);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
	Если Параметры.ДатаРедакции >= ДатаРедакции534() И КоличествоСтрокСПрослеживаемостью > 1 Тогда
		ИмяОбласти = ?(Суффикс = "Увеличение", "СтрокаВ", "СтрокаГ");
		ЗаполнитьПараметрыПрослеживаемостиСтрок_УКД(Таб, ИмяОбласти, Item, НомераКолонок, Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_УКД_736_ПодвалТаблицы(Таб, Параметры)
	
	Если Параметры.ДатаРедакции >= ДатаРедакции425() Тогда
		
		Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицыЮЛФЛ");
		ПФ_УКД_736_ПодписьСоставителя425(Область, Параметры);
		
	Иначе
		
		Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
		ПФ_УКД_736_ПодписьСоставителя(Область, Параметры);
		
	КонецЕсли;
	
	ПФ_УКД_736_ЗаполнитьСуммыИтогоТаблицы(Область, Параметры);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УКД_736_ПодписьСоставителя425(Область, Параметры)
	
	ПодписиПродавца = Параметры.ПодписиПродавца;
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	Seller = Параметры.Content.Seller;
	
	Если Seller.Type = ВидыЮрФизЛиц.ЮридическоеЛицо
		Или Seller.Type = ВидыЮрФизЛиц.ИностраннаяОрганизация Тогда
		
		Область.Параметры.ПодписьЮЛ = ПодписиПродавца.Подпись;
		Область.Параметры.ПодписантЮЛ = ПодписиПродавца.ФИО;
		
	Иначе
		
		Область.Параметры.ПодписьФЛ = ПодписиПродавца.Подпись;
		Область.Параметры.ПодписантФЛ = ПодписиПродавца.ФИО;
		Область.Параметры.НомерСВ = СтрокаНомерСВ425(Seller.IndividualEntityRegistrationCertificate);
		
	КонецЕсли;
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель =
		"Индивидуальный предприниматель или иное уполномоченное лицо";
	
КонецПроцедуры

Процедура ПФ_УКД_736_ПодписьСоставителя(Область, Параметры)
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись = Параметры.ПодписиПродавца.Подпись;
	
КонецПроцедуры

Процедура ПФ_УКД_736_ЗаполнитьСуммыИтогоТаблицы(Область, Параметры)
	
	TotalsInc = Параметры.Content.InvoiceCorrectionTable.TotalsInc;
	TotalsDec = Параметры.Content.InvoiceCorrectionTable.TotalsDec;
	
	Область.Параметры.СуммаБезНДСУвеличение = СуммаСтрокойИлиДефис(TotalsInc.TotalWithVatExcluded);
	Область.Параметры.СуммаБезНДСУменьшение = СуммаСтрокойИлиДефис(TotalsDec.TotalWithVatExcluded);
	
	ВоВсехСтрокахСтавкаНДСИсчНалАг = ВсеСтрокиУКДСодержатСтавкуНДС_ИсчНалАг(
		Параметры.Content.InvoiceCorrectionTable.Items
	);
	
	ЕстьСтавкаНДС = ЕстьСтрокиСПрямымиСтавкамиНДС736(Параметры.Content);
	ЭтоУвеличение = Привести_К_Числу(TotalsInc.TotalWithVatExcluded) >= Привести_К_Числу(TotalsDec.TotalWithVatExcluded);
	УвеличениеУменьшение = ВСтрокахУКДЕстьУвеличениеУменьшение(Параметры.Content.InvoiceCorrectionTable.Items);
	
	Область.Параметры.СуммаНДСУвеличение = СтрокаСумНДСУвелУм(
		TotalsInc.Vat,
		ВоВсехСтрокахСтавкаНДСИсчНалАг,
		ЕстьСтавкаНДС И Не ЭтоИстина(TotalsInc.WithoutVat),
		Не УвеличениеУменьшение.ЕстьУвеличение
	);
	Область.Параметры.СуммаНДСУменьшение = СтрокаСумНДСУвелУм(
		TotalsDec.Vat,
		ВоВсехСтрокахСтавкаНДСИсчНалАг,
		ЕстьСтавкаНДС И Не ЭтоИстина(TotalsDec.WithoutVat),
		Не УвеличениеУменьшение.ЕстьУменьшение
	);
	Область.Параметры.СуммаВсегоУвеличение = СтрокаВсегоУвелУм(
		TotalsInc.Total,
		ВоВсехСтрокахСтавкаНДСИсчНалАг,
		Не ЭтоУвеличение
	);
	Область.Параметры.СуммаВсегоУменьшение = СтрокаВсегоУвелУм(
		TotalsDec.Total,
		ВоВсехСтрокахСтавкаНДСИсчНалАг,
		ЭтоУвеличение
	);
	
КонецПроцедуры

Процедура ПФ_УКД_736_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Область.Параметры.ПродавецПодписант	= Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись	= Параметры.ПодписиПродавца.Подпись;
	Область.Параметры.ПродавецДолжность = Параметры.ПодписиПродавца.Должность;
	
	Область.Параметры.ИныеСведения		 	 = Content.EventContent.CostChangeInfo;
	Область.Параметры.ПередаточныеДокументы  = СтрокаПередаточныеДокументы_736(Content.EventContent.TransferDocDetails736);
	Область.Параметры.ОснованияКорректировки = СтрокаОснованияКорректировки_736(Content.EventContent.CorrectionBases);
	
	Область.Параметры.ПродавецСоставитель	  	 = Content.Creator;
	Область.Параметры.ПродавецСодержаниеОперации = Content.EventContent.OperationContent;
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) Тогда
		
		Область.Параметры.ПокупательСоставитель		   = Параметры.BuyerContent.Creator;
		Область.Параметры.ПокупательСодержаниеОперации = Параметры.BuyerContent.OperationContent;
		
		ПодписиBuyer = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ПокупательПодписант = ПодписиBuyer.ФИО;
		Область.Параметры.ПокупательПодпись	  = ПодписиBuyer.Подпись;
		Область.Параметры.ПокупательДолжность = ПодписиBuyer.Должность;
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры

Процедура ПФ_КСФУКД_ЗаполнитьНомерСтрокиТаблицы(Область, Item, ДатаДокумента, НомерПоПорядку)
	
	ЗначенияПараметров = Новый Структура;
	ЗначенияПараметров.Вставить("НомерСтроки", НомерПоПорядку);
	
	Если ДатаДокумента >= ДатаРедакции534() Тогда
		ЗначенияПараметров.НомерСтроки = Item.OriginalNumber;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Область.Параметры, ЗначенияПараметров);
	
КонецПроцедуры


Функция ПФ_АктСверки_405(Параметры)
	
	Таб = НовыйТабличныйДокумент("DD_АктСверки", ОриентацияСтраницы.Портрет);
	
	SenderContent = Параметры.Content;
	RecipientContent = Параметры.BuyerContent;
	SignDisagreement = СвойствоСтруктуры(RecipientContent, "SignDisagreement", "WithoutDisagreements");
	ЕстьРазногласия = НРег(SignDisagreement) = НРег("WithDisagreements");
	
	Если ЕстьРазногласия Тогда
		Макет = ПолучитьМакет("АктСверки_405_СРазногласиями");
	Иначе
		Макет = ПолучитьМакет("АктСверки_405_БезРазногласий");
	КонецЕсли;
	
	Параметры.Вставить("Макет", Макет);
	
	ПФ_АктСверки405_ШапкаДокумента(Таб, Макет, SenderContent);
	
	Если ЕстьРазногласия Тогда
		
		ПФ_АктСверки405_ТаблицаДокумента_СРазногласиями_ДанныеПолучателя(Таб, Макет, RecipientContent, SenderContent);
		
		Таб.Вывести(Макет.ПолучитьОбласть("Разделитель"));
		
		ПФ_АктСверки405_ТаблицаДокумента_СРазногласиями_ДанныеОтправителя(Таб, Макет, SenderContent);
		
	Иначе
		
		ПФ_АктСверки405_ТаблицаДокумента_БезРазногласий(Таб, Макет, SenderContent, RecipientContent);
		
	КонецЕсли;
	
	ПФ_АктСверки405_ПодписиДокумента(Таб, Макет, SenderContent, RecipientContent);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_АктСверки405_ШапкаДокумента(Таб, Макет, Content)
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	
	Отправитель = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Sender;
	Получатель = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Recipient;
	
	Шапка.Параметры.НомерДокумента = Content.ActNumber;
	Шапка.Параметры.ДатаНачПер = ДатаСтрокойИлиДефис(Content.ReconcilationDateFrom);
	Шапка.Параметры.ДатаОкПер = ДатаСтрокойИлиДефис(Content.ReconcilationDateTo);
	
	Шапка.Параметры.ДанныеОтправителя = АктСверки405_ПредставлениеСтороны(Отправитель);
	Шапка.Параметры.ДанныеПолучателя = АктСверки405_ПредставлениеСтороны(Получатель);
	
	Таб.Вывести(Шапка);
	
КонецПроцедуры


Процедура ПФ_АктСверки405_ТаблицаДокумента_СРазногласиями_ДанныеПолучателя(Таб, Макет, RecipientContent, SenderContent)
	
	SenderReconciliationAct = SenderContent.ReconciliationAct;
	
	ДанныеПолучателя = SenderReconciliationAct.AdditionalInfoReconciliationAct.Recipient.Name;
	Валюта = SenderReconciliationAct.AdditionalInfoReconciliationAct.Currency;
	НачалоПериодаСверки = SenderContent.ReconcilationDateFrom;
	ОкончаниеПериодаСверки = SenderContent.ReconcilationDateTo;
	RecipientReconciliationActTable = RecipientContent.ReconciliationAct.ReconciliationActTable;
	
	ПФ_АктСверки405_ШапкаТаблицы_СРазногласиями(
		Таб,
		Макет,
		ДанныеПолучателя,
		Валюта,
		НачалоПериодаСверки,
		RecipientReconciliationActTable
	);
	
	ContractInfo = RecipientReconciliationActTable.ContractInfo;
	
	Для Каждого Contract Из ContractInfo Цикл
		
		ПФ_АктСверки405_СтрокаДоговора_СРазногласиями(
			Таб,
			Макет,
			Contract,
			НачалоПериодаСверки,
			ОкончаниеПериодаСверки
		);
		
	КонецЦикла;
	
	ПФ_АктСверки405_ПодвалТаблицы(
		Таб,
		Макет,
		RecipientReconciliationActTable,
		ОкончаниеПериодаСверки
	);
	
КонецПроцедуры

