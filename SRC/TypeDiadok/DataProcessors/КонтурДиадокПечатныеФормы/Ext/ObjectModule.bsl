// Возвращает дату редакции счета-фактуры с учетом даты её исправления.
//
// Параметры:
//  ДатаДокумента - Дата - Дата счета-фактуры.
//  НеИспользуется_ДатаИсправления - Дата - (Не используется) Дата исправления счета-фактуры.
// 
// Возвращаемое значение:
//  Дата - Дата редакции или пустая дата, если редакции в этот период не было.
//
Функция ДатаРедакцииСФ(Знач ДатаДокумента, Знач НеИспользуется_ДатаИсправления = Неопределено)
	
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = '00010101';
	КонецЕсли;
	
	Если ДатаДокумента >= ДатаРедакции425() Тогда
		Результат = ДатаРедакции425();
	ИначеЕсли ДатаДокумента >= ДатаРедакции1096() Тогда
		Результат = ДатаРедакции1096();
	ИначеЕсли ДатаДокумента >= ДатаРедакции534() Тогда
		Результат = ДатаРедакции534();
	ИначеЕсли ДатаДокумента >= ДатаРедакции981() Тогда
		Результат = ДатаРедакции981();
	ИначеЕсли ДатаДокумента >= ДатаРедакции625() Тогда
		Результат = ДатаРедакции625();
	Иначе
		Результат = '00010101';
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

