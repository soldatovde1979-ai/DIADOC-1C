			КонецЕсли;
			
			Разделитель = ", ";
			
		КонецЦикла;
		
	Иначе
		
		Результат.Страны	= СтрокаДефис();
		Результат.КодыСтран	= СтрокаДефис();
		Результат.НомераТД	= СтрокаДефис();
		
	КонецЕсли;
	
