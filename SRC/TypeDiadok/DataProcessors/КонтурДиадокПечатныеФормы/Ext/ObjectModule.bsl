	ДатаДокумента = Параметры.ДатаРедакции;
	
	Для Каждого Item Из Параметры.Content.InvoiceCorrectionTable.Items Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		НомерПервойСтроки = Таб.ВысотаТаблицы + 1;
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаА");
		
		Область.Параметры.КодВТ = СтрокаИлиДефис(Item.ItemTypeCode);
		
		ПФ_КСФУКД_ЗаполнитьНомерСтрокиТаблицы(
			Область,
			Item,
			ДатаДокумента,
			НомерСтроки
		);
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_УПД_УКД(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		
		ПФ_КСФ_УКД_736_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаБ");
		ПФ_КСФ_УКД_736_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры, "После");
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаВ");
		ПФ_УКД_736_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, НомераКолонокПодстрок, Параметры);
		
		Область = Параметры.Макет.ПолучитьОбласть("СтрокаГ");
		ПФ_УКД_736_СтрокаТаблицыУвеличениеУменьшение(Таб, Область, Item, НомераКолонокПодстрок, Параметры, "Уменьшение");
		
		ПФ_СтрокаДопСведений_КСФ_УКД(Таб, Item, НомерПервойСтроки, НомераКолонок, НомерКолонкиКодВидаТовара, Параметры);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_КСФ_УКД_736_СтрокаТаблицыДоПосле(Таб, Область, Item, Параметры, Суффикс = "До")
	
	InvoiceItemFields = ?(Суффикс = "До", Item.OriginalValues, Item.CorrectedValues);
	КоличествоСтрокСПрослеживаемостью = 0;
	Если ЗначениеЗаполнено(Item.ItemTracingInfos) Тогда
		КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
	КонецЕсли;
	
	Область.Параметры["ЕдиницаИзмеренияКод" + Суффикс] = СтрокаИлиДефис(InvoiceItemFields.UnitCode);
	Область.Параметры["ЕдиницаИзмерения" + Суффикс] = СтрокаИлиДефис(НаименованиеЕдиницыИзмерения(InvoiceItemFields.UnitCode));
	Область.Параметры["Количество" + Суффикс] = КоличествоСтрокойИлиДефис(InvoiceItemFields.Quantity, Параметры.ФорматКоличества);
	Область.Параметры["Цена" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Price, Параметры.ФорматСуммы);
	Область.Параметры["СуммаБезНДС" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.TotalWithVatExcluded);
	Если Параметры.ИмяМакета <> "КСФ1137" Тогда
		Область.Параметры["Акциз" + Суффикс] = СтрокаАкциз(InvoiceItemFields.Excise, InvoiceItemFields.TaxRate);
	КонецЕсли;
	Область.Параметры["СтавкаНДС" + Суффикс] = СтрокаСтавкаНДС(InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаНДС" + Суффикс] = СтрокаСуммаНДС_736(InvoiceItemFields.Vat, InvoiceItemFields.WithoutVat, InvoiceItemFields.TaxRate);
	Область.Параметры["СуммаВсего" + Суффикс] = СуммаСтрокойИлиДефис(InvoiceItemFields.Total);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		ЗаполнитьПараметрыСтраныПроисхождения_УКД(Область, Item);
		
		Если КоличествоСтрокСПрослеживаемостью > 0 Тогда
			ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УКД(Область, Item, СтрокаДефис(), Параметры);
		КонецЕсли;
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() И КоличествоСтрокСПрослеживаемостью > 1 Тогда
		ИмяОбласти = ?(Суффикс = "До", "СтрокаА", "СтрокаБ");
		ЗаполнитьПараметрыПрослеживаемостиСтрок_УКД(Таб, ИмяОбласти, Item, НомераКолонок_КСФ1137_534_Прослеж(Истина), Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_КСФ_УКД_736_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	TotalsInc = Параметры.Content.InvoiceCorrectionTable.TotalsInc;
	TotalsDec = Параметры.Content.InvoiceCorrectionTable.TotalsDec;
	
	Область.Параметры.СуммаБезНДСУвеличение = СуммаСтрокойИлиДефис(TotalsInc.TotalWithVatExcluded);
	Область.Параметры.СуммаБезНДСУменьшение = СуммаСтрокойИлиДефис(TotalsDec.TotalWithVatExcluded);
	
	ВоВсехСтрокахСтавкаНДСИсчНалАг = ВсеСтрокиУКДСодержатСтавкуНДС_ИсчНалАг(Параметры.Content.InvoiceCorrectionTable.Items);
	
	ЕстьСтавкаНДС = ЕстьСтрокиСПрямымиСтавкамиНДС736(Параметры.Content);
	
	ЭтоУвеличение = Привести_К_Числу(TotalsInc.TotalWithVatExcluded) >= Привести_К_Числу(TotalsDec.TotalWithVatExcluded);
	
	УвеличениеУменьшение = ВСтрокахУКДЕстьУвеличениеУменьшение(Параметры.Content.InvoiceCorrectionTable.Items);
	
	Область.Параметры.СуммаНДСУвеличение = СтрокаСумНДСУвелУм(TotalsInc.Vat, ВоВсехСтрокахСтавкаНДСИсчНалАг, ЕстьСтавкаНДС И Не ЭтоИстина(TotalsInc.WithoutVat), Не УвеличениеУменьшение.ЕстьУвеличение);
	Область.Параметры.СуммаНДСУменьшение = СтрокаСумНДСУвелУм(TotalsDec.Vat, ВоВсехСтрокахСтавкаНДСИсчНалАг, ЕстьСтавкаНДС И Не ЭтоИстина(TotalsDec.WithoutVat), Не УвеличениеУменьшение.ЕстьУменьшение);
	
	Область.Параметры.СуммаВсегоУвеличение = СтрокаВсегоУвелУм(TotalsInc.Total, ВоВсехСтрокахСтавкаНДСИсчНалАг, Не ЭтоУвеличение);
	Область.Параметры.СуммаВсегоУменьшение = СтрокаВсегоУвелУм(TotalsDec.Total, ВоВсехСтрокахСтавкаНДСИсчНалАг, ЭтоУвеличение);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_КСФ_УКД_736_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Если Параметры.ДатаРедакции >= ДатаРедакции425() Тогда
		
		ПФ_КСФ_УКД_736_ПодписьСоставителя425(Область, Параметры);
		
	Иначе
		
		ПФ_КСФ_УКД_736_ПодписьСоставителя(Область, Параметры);
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры

Процедура ПФ_КСФ_УКД_736_ПодписьСоставителя425(Область, Параметры)
	
	Подписи = СтрокиПодписей_ЮЛ_ФЛ(Параметры.Content.Signers);
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	Seller = Параметры.Content.Seller;
	
	Если Seller.Type = ВидыЮрФизЛиц.ЮридическоеЛицо
		Или Seller.Type = ВидыЮрФизЛиц.ИностраннаяОрганизация Тогда
		
		Область.Параметры.ПодписьЮЛ = Подписи.ЮЛ.Подпись;
		Область.Параметры.ПодписантЮЛ = Подписи.ЮЛ.ФИО;
		
	Иначе
		
		Область.Параметры.ПодписьФЛ = Подписи.ФЛ.Подпись;
		Область.Параметры.ПодписантФЛ = Подписи.ФЛ.ФИО;
		Область.Параметры.НомерСВ = СтрокаНомерСВ425(Seller.IndividualEntityRegistrationCertificate);
		
	КонецЕсли;
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель =
		"Индивидуальный предприниматель или иное уполномоченное лицо";
	
КонецПроцедуры

Процедура ПФ_КСФ_УКД_736_ПодписьСоставителя(Область, Параметры)
	
	Подписи = СтрокиПодписей_ЮЛ_ФЛ(Параметры.Content.Signers);
	
	Область.Параметры.ПодписьЮЛ = Подписи.ЮЛ.Подпись;
	Область.Параметры.ПодписантЮЛ = Подписи.ЮЛ.ФИО;
	
	Область.Параметры.ПодписьФЛ = Подписи.ФЛ.Подпись;
	Область.Параметры.ПодписантФЛ = Подписи.ФЛ.ФИО;
	Область.Параметры.НомерСВ = Подписи.ФЛ.НомерСВ;
	
	Область.Параметры.НадписьИндивидуальныйПредприниматель =
		"Индивидуальный предприниматель"
		+ ?(Параметры.ДатаРедакции >= ДатаРедакции981(), " или иное уполномоченное лицо", "");
	
КонецПроцедуры

Функция ПФ_Акт(Параметры)
	
	Параметры.Вставить("Макет", ПолучитьМакет("Акт"));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfo);
	
	Таб = НовыйТабличныйДокумент("DD_Акт", ОриентацияСтраницы.Портрет);
	
	ПФ_Акт_ШапкаДокумента(Таб, Параметры);
	ПФ_Акт_Таблица(Таб, Параметры);
	ПФ_Акт_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб; 
	
КонецФункции

Процедура ПФ_Акт_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата	= Формат(Content.Date, "ДФ=dd.MM.yy");
	Область.Параметры.Заголовок = Content.Title;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
КонецПроцедуры

Процедура ПФ_Акт_Таблица(Таб, Параметры)
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
	СуммаБезНДС = 0;
	СуммаНДС	= 0;
	СуммаВсего  = 0;
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.Items Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		
		Если Параметры.ПоказатьДопСведения И ЗначениеЗаполнено(Item.AdditionalInfo) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", Item.AdditionalInfo);
		Иначе 
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;	
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = ?(ЗначениеЗаполнено(Item.Name), Item.Name, Item.Description);
		Область.Параметры.ЕдиницаИзмерения = ?(ЗначениеЗаполнено(Item.UnitName), Item.UnitName, СтрокаДефис());
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.TotalWithVatExcluded);
		Область.Параметры.СуммаНДС	  = СуммаСтрокойИлиДефис(Item.Vat);
		Область.Параметры.СуммаВсего  = СуммаСтрокойИлиДефис(Item.Total);
		
		Таб.Вывести(Область);
		
		СуммаБезНДС = СуммаБезНДС + ?(ЗначениеЗаполнено(Item.TotalWithVatExcluded), Item.TotalWithVatExcluded, 0);
		СуммаНДС	= СуммаНДС 	  + ?(ЗначениеЗаполнено(Item.Vat), Item.Vat, 0);
		СуммаВсего	= СуммаВсего  + ?(ЗначениеЗаполнено(Item.Total), Item.Total, 0);
		
	КонецЦикла;	
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	Область.Параметры.СуммаБезНДС	 = СуммаСтрокой(СуммаБезНДС);
	Область.Параметры.СуммаНДС		 = СуммаСтрокой(СуммаНДС);
	Область.Параметры.СуммаВсего	 = СуммаСтрокой(СуммаВсего);
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Акт_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Область.Параметры.Продавец	  	= Content.Seller.Name;
	Область.Параметры.ПродавецИНН 	= Content.Seller.Inn;
	Область.Параметры.ПродавецКПП 	= Content.Seller.Kpp;
	Область.Параметры.ПродавецАдрес = СтрокаАдресТелефонФакс(Content.Seller);
	Область.Параметры.ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Seller);
	
	Область.Параметры.ПродавецПодписант		 = СтрокаФИО(Content.Official);
	Область.Параметры.ПродавецДолжность		 = Content.Official.JobTitle;
	Область.Параметры.ПродавецДоверенность 	 = СтрокаДоверенность(Content.Attorney);
	Область.Параметры.ПродавецДатаПодписания = Формат(Content.SignatureDate, "ДФ='""Дата подписания: ""dd.MM.yy'");
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) Тогда
		
		Область.Параметры.ПокупательПодписант	   = СтрокаФИО(Параметры.BuyerContent.Signer);
		Область.Параметры.ПокупательДолжность	   = Параметры.BuyerContent.Signer.JobTitle;
		Область.Параметры.ПокупательДоверенность   = СтрокаДоверенность(Параметры.BuyerContent.Attorney);
		Область.Параметры.ПокупательДатаПодписания = Формат(Параметры.BuyerContent.SignatureDate, "ДФ='""Дата приема: ""dd.MM.yy'");
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_Акт_УПД(Параметры)
	
	Параметры.Вставить("Макет", ПолучитьМакет("АктУПД"));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
