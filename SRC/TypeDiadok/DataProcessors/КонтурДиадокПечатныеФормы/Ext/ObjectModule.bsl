Процедура ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УПД(Область, Item, НомерТД, Параметры)
	
	Если Item.ItemTracingInfos.Количество() = 0 Тогда
		ItemTracingInfo = Новый Структура;
		ItemTracingInfo.Вставить("RegNumberUnit", НомерТД);
		ItemTracingInfo.Вставить("Unit", СтрокаДефис());
		ItemTracingInfo.Вставить("UnitName", СтрокаДефис());
		ItemTracingInfo.Вставить("Quantity", СтрокаДефис());
		ItemTracingInfo.Вставить("SumWithoutVat", СтрокаДефис());
	Иначе
		ItemTracingInfo = Item.ItemTracingInfos[0];
	КонецЕсли;
	
	ЗаполнитьПараметрыПрослеживаемости_УПД(Область, ItemTracingInfo, Параметры);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПрослеживаемостиСтрок_УПД(Таб, Item, СтрокаДопСведений, НомераКолонок, Параметры)
	
	КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
	НомерПервойСтроки = Таб.ВысотаТаблицы;
	НомерПоследнейСтроки = НомерПервойСтроки + КоличествоСтрокСПрослеживаемостью - 1;
	
	Для сц = 1 По КоличествоСтрокСПрослеживаемостью - 1 Цикл
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) И сц = КоличествоСтрокСПрослеживаемостью - 1 Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		ItemTracingInfo = Item.ItemTracingInfos[сц];
		ЗаполнитьПараметрыПрослеживаемости_УПД(Область, ItemTracingInfo, Параметры);
		Таб.Вывести(Область);
		
	КонецЦикла;
	
	ОбъединитьЯчейкиКолонокТабличногоДокумента(Таб, НомерПервойСтроки, НомерПоследнейСтроки, НомераКолонок);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПрослеживаемости_УПД(Область, ItemTracingInfo, Параметры)
	
	ЗначенияПараметровОбласти = Новый Структура;
	ЗначенияПараметровОбласти.Вставить("НомерТД", ItemTracingInfo.RegNumberUnit);
	ЗначенияПараметровОбласти.Вставить("КоличествоПрослеж", ItemTracingInfo.Quantity);
	ЗначенияПараметровОбласти.Вставить("ЕдиницаИзмеренияПрослеж", ItemTracingInfo.UnitName);
	ЗначенияПараметровОбласти.Вставить("ЕдиницаИзмеренияПрослежКод", ItemTracingInfo.Unit);
	
	Если ItemTracingInfo.Свойство("SumWithoutVat") Тогда
		СтоимостьПрослеж = СуммаСтрокойИлиДефис(ItemTracingInfo.SumWithoutVat, "ЧДЦ=2");
	Иначе
		СтоимостьПрослеж = "";
	КонецЕсли;
	ЗначенияПараметровОбласти.Вставить("СтоимостьПрослеж", СтоимостьПрослеж);
	
	Область.Параметры.Заполнить(ЗначенияПараметровОбласти);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УКД(Область, Item, НомерТДПустоеЗначение, Параметры)
	
	КоллекцияСведПрослеж = Item.ItemTracingInfos;
	
	Если ЗначениеЗаполнено(КоллекцияСведПрослеж) Тогда
		
		ItemTracingInfo = КоллекцияСведПрослеж[0];
		
	Иначе
		
		QuantityDiff = Новый Структура;
		QuantityDiff.Вставить("OriginalQuantity", СтрокаДефис());
		QuantityDiff.Вставить("CorrectedQuantity", СтрокаДефис());
		QuantityDiff.Вставить("QuantityInc", СтрокаДефис());
		QuantityDiff.Вставить("QuantityDec", СтрокаДефис());
		
		ItemTracingInfo = Новый Структура;
		ItemTracingInfo.Вставить("RegNumberUnit", НомерТДПустоеЗначение);
		ItemTracingInfo.Вставить("QuantityDiff", QuantityDiff);
		
	КонецЕсли;
	
	ЗаполнитьПараметрыПрослеживаемости_УКД(Область, ItemTracingInfo, Параметры);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПрослеживаемостиСтрок_УКД(Таб, ИмяОбласти, Item, НомераКолонок, Параметры)
	
	КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
	НомерПервойСтроки = Таб.ВысотаТаблицы;
	НомерПоследнейСтроки = НомерПервойСтроки + КоличествоСтрокСПрослеживаемостью - 1;
	
	Для сц = 1 По КоличествоСтрокСПрослеживаемостью - 1 Цикл
		
		Область = Параметры.Макет.ПолучитьОбласть(ИмяОбласти);
		
		ItemTracingInfo = Item.ItemTracingInfos[сц];
		ЗаполнитьПараметрыПрослеживаемости_УКД(Область, ItemTracingInfo, Параметры);
		Таб.Вывести(Область);
		
	КонецЦикла;
	
	ОбъединитьЯчейкиКолонокТабличногоДокумента(Таб, НомерПервойСтроки, НомерПоследнейСтроки, НомераКолонок);
	
КонецПроцедуры

// Заполняет колонки 10, 10а и 11 табличного документа УКД_534 и КСФ1137_534
//
// Параметры:
//  Область	- ТабличныйДокумент - Область табличного документа формы УКД
//  Item	- Массив - Массив структур - сведений об импотных товарах из поля ИнфПолФХЖ2
//
Процедура ЗаполнитьПараметрыСтраныПроисхождения_УКД(Область, Item)
	
	КоллекцияИнфПолФХЖ2 = Item.StructedAdditionalInfos;
	
	КодыСтран			= Новый Массив;
	НаименованияСтран	= Новый Массив;
	НомераДеклараций	= Новый Массив;
	
	КлючИнфПолФХЖ2 = Перечисление_ИдентификаторыСведенийОСтранеПроисхождения();
	
	Для Каждого ИнфПолФХЖ2 Из КоллекцияИнфПолФХЖ2 Цикл
		
		Если НРег(ИнфПолФХЖ2.Key) = НРег(КлючИнфПолФХЖ2.КодСтраны) Тогда
			КодыСтран.Добавить(ИнфПолФХЖ2.Value);
		ИначеЕсли НРег(ИнфПолФХЖ2.Key) = НРег(КлючИнфПолФХЖ2.НаименованиеСтраны) Тогда
			НаименованияСтран.Добавить(ИнфПолФХЖ2.Value);
		ИначеЕсли НРег(ИнфПолФХЖ2.Key) = НРег(КлючИнфПолФХЖ2.НомерТД) Тогда
			НомераДеклараций.Добавить(ИнфПолФХЖ2.Value);
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеКодСтраны			= СоединитьСтроку(КодыСтран			, ", ");
	ЗначениеНаименованиеСтраны	= СоединитьСтроку(НаименованияСтран	, ", ");
	ЗначениеНомерТД				= СоединитьСтроку(НомераДеклараций	, ", ");
	
	Область.Параметры["КодСтраны"]			= СтрокаИлиДефис(ЗначениеКодСтраны);
	Область.Параметры["НаименованиеСтраны"]	= СтрокаИлиДефис(ЗначениеНаименованиеСтраны);
	Область.Параметры["НомерТД"]			= СтрокаИлиДефис(ЗначениеНомерТД);

КонецПроцедуры

Процедура ЗаполнитьПараметрыПрослеживаемости_УКД(Область, ItemTracingInfo, Параметры)
	
	ЗначенияПараметровОбласти = Новый Структура;
	ЗначенияПараметровОбласти.Вставить("НомерТД", ItemTracingInfo.RegNumberUnit);
	
	Unit = СвойствоСтруктуры(ItemTracingInfo, "Unit", СтрокаДефис());
	UnitName = ?(Unit = СтрокаДефис(), СтрокаДефис(), НаименованиеЕдиницыИзмерения(Unit));
	
	ЗначенияПараметровОбласти.Вставить("ЕдиницаИзмеренияПрослежКод", Unit);
	ЗначенияПараметровОбласти.Вставить("ЕдиницаИзмеренияПрослеж", UnitName);
	
	Если Не Область.Области.Найти("СтрокаА") = Неопределено Тогда
		
		КоличествоПрослежДо = СтрокаИлиДефис(ItemTracingInfo.QuantityDiff.OriginalQuantity);
		ЗначенияПараметровОбласти.Вставить("КоличествоПрослежДо", КоличествоПрослежДо);
		
	КонецЕсли;
	
	Если Не Область.Области.Найти("СтрокаБ") = Неопределено Тогда
		
		КоличествоПрослежПосле = СтрокаИлиДефис(ItemTracingInfo.QuantityDiff.CorrectedQuantity);
		ЗначенияПараметровОбласти.Вставить("КоличествоПрослежПосле", КоличествоПрослежПосле);
		
	КонецЕсли;
	
	Если Не Область.Области.Найти("СтрокаВ") = Неопределено Тогда
		
		КоличествоПрослежУвеличение = СтрокаИлиДефис(СвойствоСтруктуры(ItemTracingInfo.QuantityDiff, "QuantityInc"));
		ЗначенияПараметровОбласти.Вставить("КоличествоПрослежУвеличение", КоличествоПрослежУвеличение);
		
	КонецЕсли;
	
	Если Не Область.Области.Найти("СтрокаГ") = Неопределено Тогда
		
		КоличествоПрослежУменьшение = СтрокаИлиДефис(СвойствоСтруктуры(ItemTracingInfo.QuantityDiff, "QuantityDec"));
		ЗначенияПараметровОбласти.Вставить("КоличествоПрослежУменьшение", КоличествоПрослежУменьшение);
		
	КонецЕсли;
	
	Область.Параметры.Заполнить(ЗначенияПараметровОбласти);
	
КонецПроцедуры

Процедура ОбъединитьЯчейкиКолонокТабличногоДокумента(ТабличныйДокумент, НомерПервойСтроки, НомерПоследнейСтроки, НомераКолонок)
	
	Для Каждого Элемент Из НомераКолонок Цикл
		ОбластьОбъединения = ТабличныйДокумент.Область(НомерПервойСтроки, Элемент.НомерПервойКолонки,
													   НомерПоследнейСтроки, Элемент.НомерПоследнейКолонки);
		ОбластьОбъединения.Объединить();
	КонецЦикла;
	
КонецПроцедуры

