Процедура ПФ_Торг12_551_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("Колонтитул"));
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка1");
	
	Область.Параметры.Грузоотправитель		 = СтрокаДанныеКонтрагента(Content.Shipper);
	Область.Параметры.Подразделение 		 = Content.Shipper.Department;
	Область.Параметры.ГрузоотправительПоОКПО = Content.Shipper.Okpo;
	Область.Параметры.ВидДеятельностиПоОКДП	 = Content.Shipper.Okdp;
	
	Область.Параметры.Грузополучатель		= СтрокаДанныеКонтрагента(Content.Consignee);
	Область.Параметры.ГрузополучательПоОКПО = Content.Consignee.Okpo;
	
	Область.Параметры.Продавец		 = СтрокаДанныеКонтрагента(Content.Seller);
	Область.Параметры.ПродавецПоОКПО = Content.Seller.Okpo;
	
	Область.Параметры.Покупатель	   = СтрокаДанныеКонтрагента(Content.Buyer);
	Область.Параметры.ПокупательПоОКПО = Content.Buyer.Okpo;
	
	Если ЗначениеЗаполнено(Content.Grounds) Тогда
		Ground = Content.Grounds[0];
		Область.Параметры.Основание		 = СтрокаОснованиеНакладной(Ground.Name, Ground.Number, Ground.Date, Ground.Info);
		Область.Параметры.ОснованиеНомер = Ground.Number;
		Область.Параметры.ОснованиеДата  = ДатаСтрокой(Ground.Date);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
