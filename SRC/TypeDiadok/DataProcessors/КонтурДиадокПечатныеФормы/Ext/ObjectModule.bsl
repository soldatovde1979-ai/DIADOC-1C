		Результат = Результат + Разделитель + OrgInfo.Name;
		Разделитель = ", ";
	КонецЕсли;
	
	// ИНН/КПП
	ИННКПП = СтрокаИННКПП_820(OrgInfo);
	Если ЗначениеЗаполнено(OrgInfo.Kpp) Тогда 
		Результат = Результат + Разделитель + "ИНН/КПП: " + ИННКПП;
		Разделитель = ", ";
	Иначе
		Результат = Результат + Разделитель + "ИНН: " + ИННКПП;
		Разделитель = ", ";
	КонецЕсли;
	
	// Адрес
	Адрес = СтрокаАдрес(OrgInfo.Address);
	Если ЗначениеЗаполнено(Адрес) Тогда
		Результат = Результат + Разделитель + Адрес;
		Разделитель = ", ";
	КонецЕсли;
	
	// Телефон
	Если ЗначениеЗаполнено(OrgInfo.Phone) Тогда
		Результат = Результат + Разделитель + OrgInfo.Phone;
		Разделитель = ", ";
	КонецЕсли;
	
	// Факс
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OrgInfo, "Fax") И ЗначениеЗаполнено(OrgInfo.Fax) Тогда
		Результат = Результат + Разделитель + "факс: " + OrgInfo.Fax;
		Разделитель = ", ";
	КонецЕсли;
	
	// эл. почта 
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OrgInfo, "Email") И ЗначениеЗаполнено(OrgInfo.Email) Тогда
		Результат = Результат + Разделитель + OrgInfo.Email;
		Разделитель = ", ";
	КонецЕсли;
	
	// Расчетный счет
	Если ЗначениеЗаполнено(OrgInfo.BankAccountNumber) Тогда
		Результат = Результат + Разделитель + "р/с: " + OrgInfo.BankAccountNumber;
		Разделитель = ", ";
	КонецЕсли;
	
	// Наименование банка
	Если ЗначениеЗаполнено(OrgInfo.BankName) Тогда
		Результат = Результат + Разделитель + "в банке " + OrgInfo.BankName;
		Разделитель = ", ";
	КонецЕсли;
	
	// БИК банка
	Если ЗначениеЗаполнено(OrgInfo.BankId) Тогда
		Результат = Результат + Разделитель + "БИК " + OrgInfo.BankId;
		Разделитель = ", ";
	КонецЕсли;
	
	// Кор. счет
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OrgInfo, "CorrespondentAccount") И ЗначениеЗаполнено(OrgInfo.CorrespondentAccount) Тогда
		Результат = Результат + Разделитель + "к/с: " + OrgInfo.CorrespondentAccount;
		Разделитель = ", ";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 	

Функция СтрокаПредставлениеКонтрагента_970(OrgInfo)
	
	ДанныеКонтрагента = Новый Массив;
	Разделитель = ", ";
	
	ДанныеКонтрагента.Добавить(OrgInfo.Name);
	
	ИННКПП = СтрокаИННКПП_970(OrgInfo);
	Если ЗначениеЗаполнено(ИННКПП) Тогда
		Если ЗначениеЗаполнено(OrgInfo.Kpp) Тогда
			ДанныеКонтрагента.Добавить("ИНН/КПП: " + ИННКПП);
		Иначе
			ДанныеКонтрагента.Добавить("ИНН: " + ИННКПП);
		КонецЕсли;
	КонецЕсли;
	
	АдресИКонтакты = СтрокаАдресТелефонЭлПочта_970(OrgInfo);
	ДанныеКонтрагента.Добавить(АдресИКонтакты);
	
	БанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(OrgInfo);
	Если БанковскиеРеквизиты <> СтрокаДефис() Тогда
		ДанныеКонтрагента.Добавить(БанковскиеРеквизиты);
	КонецЕсли;
	
	Результат = СоединитьСтроку(ДанныеКонтрагента, Разделитель);
	
	Возврат Результат;
	
КонецФункции 	

Процедура ДополнитьМассивНепустымЗначением(Массив, Значение)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеАдрРФ(AddressInfo)
	
	ЧастиАдреса = Новый Массив;
	
	КодРегиона = AddressInfo.RegionCode;
	Регион = НаименованиеРегионаПоКоду(КодРегиона);
	
	Дом = "";
	Если ЗначениеЗаполнено(AddressInfo.Building) Тогда
		Дом = "дом № " + AddressInfo.Building;
	КонецЕсли;
	
	Корпус = "";
	Если ЗначениеЗаполнено(AddressInfo.Block) Тогда
		Корпус = "корпус " + AddressInfo.Block;
	КонецЕсли;
	
	Квартира = "";
	Если ЗначениеЗаполнено(AddressInfo.Apartment) Тогда
		Квартира = "кв " + AddressInfo.Apartment;
	КонецЕсли;
	
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, AddressInfo.ZipCode); // Индекс
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, Регион); // Регион
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, AddressInfo.Territory); // Район
	
	Если НЕ ЭтоГородФедеральногоЗначения(КодРегиона) Тогда
		ДополнитьМассивНепустымЗначением(ЧастиАдреса, AddressInfo.City); // Город
	КонецЕсли;
	
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, AddressInfo.Locality); // Населенный пункт
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, AddressInfo.Street); // Улица
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, Дом); // Дом
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, Корпус); // Корпус
	ДополнитьМассивНепустымЗначением(ЧастиАдреса, Квартира); // Квартира
	
	Разделитель = ", ";
	Результат = СоединитьСтроку(ЧастиАдреса, Разделитель);
	
	Возврат Результат;
	
КонецФункции

Функция ГородаРегионыФедеральногоЗначения()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("77", "г. Москва");
	Результат.Вставить("78", "г. Санкт-Петербург");
	Результат.Вставить("92", "г. Севастополь");
	Результат.Вставить("99", "иные территории, включая город и космодром Байконур");
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеРегионаПоКоду(КодСубъектаРФ)
	
	Регион = НаименованиеРегиона(КодСубъектаРФ);
	
	ГородаФедеральногоЗначения = ГородаРегионыФедеральногоЗначения();
	ГородФедеральногоЗначения = ГородаФедеральногоЗначения.Получить(СокрЛП(КодСубъектаРФ));
	
	Если ГородФедеральногоЗначения <> Неопределено Тогда
		Регион = ГородФедеральногоЗначения;
	КонецЕсли;
	
	Возврат Регион;
	
КонецФункции

Функция ЭтоГородФедеральногоЗначения(КодСубъектаРФ)
	
	ГородаФедеральногоЗначения = ГородаРегионыФедеральногоЗначения();
	РезультатГород = ГородаФедеральногоЗначения.Получить(СокрЛП(КодСубъектаРФ));
	
	Результат = РезультатГород <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеАдрИнф(AddressInfo)
	
	КодСтраны = СокрЛП(AddressInfo.CountryCode);
	
	НаименованиеСтраны = СвойствоСтруктуры(AddressInfo, "Country");
	Если Не ЗначениеЗаполнено(НаименованиеСтраны) Тогда
		НаименованиеСтраны = НаименованиеСтраны(КодСтраны);
	КонецЕсли;
	
	ТекстАдреса = AddressInfo.AddressText;
	
	ЧастиАдреса = Новый Массив;
	
	Если ЗначениеЗаполнено(НаименованиеСтраны) Тогда
		
		ТекстАдресаНеСодержитСтрану = Найти(ТекстАдреса, НаименованиеСтраны) = 0;
		
		Если ТекстАдресаНеСодержитСтрану Тогда
			ЧастиАдреса.Добавить(НаименованиеСтраны);
		КонецЕсли;
		
	Иначе
		ЧастиАдреса.Добавить(КодСтраны);
	КонецЕсли;
	
	ЧастиАдреса.Добавить(ТекстАдреса);
	
	Разделитель = ", ";
	Результат = СоединитьСтроку(ЧастиАдреса, Разделитель);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеАдрГАР(AddressInfo)
	
	ЧастиАдреса = Новый Массив;
	
	ЧастиАдреса.Добавить(AddressInfo.ZipCode);
	
	КодРегиона = AddressInfo.RegionCode;
	
	Если Не ЗначениеЗаполнено(AddressInfo.Region)
		И ЗначениеЗаполнено(КодРегиона) Тогда
		Регион = НаименованиеРегионаПоКоду(КодРегиона);
	Иначе
		Регион = AddressInfo.Region;
	КонецЕсли;
	
	ЧастиАдреса.Добавить(Регион);
	
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка");
	
	ВидМуниципальногоРайона = НаименованиеВидаМуниципальногоРайонаПоКоду(AddressInfo.MunicipalDistrictCode);
	МуниципальныйРайон = СоединитьЭлементыАдресногоОбъекта(ВидМуниципальногоРайона, AddressInfo.MunicipalDistrict);
	ЧастиАдреса.Добавить(МуниципальныйРайон);
	
	ВидПоселения = НаименованиеВидаПоселенияПоКоду(AddressInfo.SettlementCode);
	ГородПоселение = СоединитьЭлементыАдресногоОбъекта(ВидПоселения, AddressInfo.Settlement);
	ЧастиАдреса.Добавить(ГородПоселение);
	
	НаселенныйПункт = СоединитьЭлементыАдресногоОбъекта(AddressInfo.LocalityType, AddressInfo.Locality);
	ЧастиАдреса.Добавить(НаселенныйПункт);
	
	ЭлементПланировочнойСтруктуры = СоединитьЭлементыАдресногоОбъекта(AddressInfo.PlanningElementType, AddressInfo.PlanningElement);
	ЧастиАдреса.Добавить(ЭлементПланировочнойСтруктуры);
	
	ЭлементУличнойДорожнойСети = СоединитьЭлементыАдресногоОбъекта(AddressInfo.StreetElementType, AddressInfo.StreetElement);
	ЧастиАдреса.Добавить(ЭлементУличнойДорожнойСети);
	
	ЗемельныйУчасток = AddressInfo.LandPlot;
	ЧастиАдреса.Добавить(ЗемельныйУчасток);
	
	Для Каждого ЗданиеСооружение Из AddressInfo.Buildings Цикл
		ЭлЗданиеСооружение = СоединитьЭлементыАдресногоОбъекта(ЗданиеСооружение.Type, ЗданиеСооружение.Number);
		ЧастиАдреса.Добавить(ЭлЗданиеСооружение);
	КонецЦикла;
	
	ПомещениеВЗдании = СоединитьЭлементыАдресногоОбъекта(AddressInfo.HouseType, AddressInfo.House);
	ЧастиАдреса.Добавить(ПомещениеВЗдании);
	
	ПомещениеВКвартире = СоединитьЭлементыАдресногоОбъекта(AddressInfo.ApartmentType, AddressInfo.Apartment);
	ЧастиАдреса.Добавить(ПомещениеВКвартире);

	Разделитель = ", ";
	Результат = СоединитьСтроку(ЧастиАдреса, Разделитель);
	
	Возврат Результат;
	
КонецФункции

Функция СоединитьЭлементыАдресногоОбъекта(Элемент1, Элемент2)
	
	ЭлементыОбъекта = Новый Массив;
	ЭлементыОбъекта.Добавить(Элемент1);
	ЭлементыОбъекта.Добавить(Элемент2);
	
	Результат = СоединитьСтроку(ЭлементыОбъекта, " ");
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеКодГАР(AddressInfo)
	
	КодГар = СокрЛП(AddressInfo.AddressCode);
	Результат = "Код адреса: " + КодГар;
	
