Функция ПечатнаяФорма_ОшибкиФормирования(ПредставлениеДокумента, ТекстОшибки) Экспорт
	
	Таб = НовыйТабличныйДокумент("DD_ERRORS");
	
	Макет = ПолучитьМакет("ПФ_MXL_ОшибкиФормированияПечатнойФормы");
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.ПредставлениеДокумента = ПредставлениеДокумента;
	Таб.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ТехническаяИнформация");
	Область.Параметры.ТекстОшибки = ТекстОшибки;
	Таб.Вывести(Область);
	
	Возврат Таб;
	
КонецФункции

Функция ПечатнаяФормаЗаглушка(ТипДокумента, ТипКонтента, ФункцияДокумента = "")
	
	Таб = НовыйТабличныйДокумент("DD_UNDEFINED");
	
	Макет = ПолучитьМакет("ПФ_MXL_ПечатнаяФормаОтсутствует");
	
	ПФ_Заглушка_ВывестиЗаголовок(Таб, Макет);
	
	Детали = Новый Массив;
	
	ДобавитьКлючЗначение(Детали, "Тип контента", ТипКонтента);
	ДобавитьКлючЗначение(Детали, "Тип документа", ТипДокумента);
	
	Если ЗначениеЗаполнено(ФункцияДокумента) Тогда
		ДобавитьКлючЗначение(Детали, "Функция документа", ФункцияДокумента);
	КонецЕсли;
	
	Для Каждого Элемент Из Детали Цикл
		
		ПФ_Заглушка_ДобавитьТехническуюИнформацию(
			Таб,
			Макет,
			Элемент.Ключ,
			Элемент.Значение
		);
		
	КонецЦикла;
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_Заглушка_ВывестиЗаголовок(Таб, Макет)
	
	ТекстЗаголовка = "Просмотр печатной формы недоступен.";
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заголовок = ТекстЗаголовка;
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Заглушка_ДобавитьТехническуюИнформацию(Таб, Макет, ЗаголовокПараметра, ЗначениеПараметра)
	
	Область = Макет.ПолучитьОбласть("ТехническаяИнформация");
	
	Область.Параметры.ЗаголовокПараметра = ЗаголовокПараметра;
	Область.Параметры.ЗначениеПараметра = ЗначениеПараметра;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Функция ПечатнаяФорма970(Параметры, ТипДокумента)
	
	Если ТипДокумента = НРег(ТипСчетФактура())
		Или ТипДокумента = НРег(ТипСчетФактураИсправление()) Тогда
		
		Результат = ПФ_СФ_УПД_970(Параметры);
		
	ИначеЕсли ТипДокумента = НРег(ТипТоварнаяНакладная()) Тогда
		
		Результат = ПФ_Торг12_УПД_970(Параметры);
		
	ИначеЕсли ТипДокумента = НРег(ТипАктОбОказанииУслуг()) Тогда
		
		Результат = ПФ_Акт_УПД_970(Параметры);
		
	Иначе
		
		Результат = ПФ_УПД_970(Параметры);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

