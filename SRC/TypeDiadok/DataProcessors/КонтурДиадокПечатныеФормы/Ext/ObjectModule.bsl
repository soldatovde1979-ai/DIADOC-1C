Функция ПечатнаяФорма(Параметры, Знач ТипКонтента, Знач ТипДокумента)
	
	ТипКонтента	 = НРег(ТипКонтента);
	ТипДокумента = НРег(ТипДокумента);
	
	Если Параметры.ДокументЗашифрован Тогда
		
		Результат = ПолучитьМакет("НадписьДокументЗашифрован");
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавца970()) Тогда
		
		Результат = ПечатнаяФорма970(Параметры, ТипДокумента);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавца155()) Тогда
		
		Результат = ПечатнаяФорма155(Параметры, ТипДокумента);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавца820()) Тогда
		
		Результат = ПечатнаяФорма820(Параметры, ТипДокумента);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавца736()) Тогда
		
		БазовыйФормат = Неопределено;
		Параметры.Content.Свойство("FormatVersion", БазовыйФормат);
		
		Если БазовыйФормат = БазовыйФормат736() Тогда
			
			Результат = ПечатнаяФорма736(Параметры, ТипДокумента);
			
		Иначе
			
			Результат = ПечатнаяФорма189(Параметры, ТипДокумента);
			
		КонецЕсли;
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавца551()) Тогда
		
		Результат = ПФ_Торг12_551(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавца552()) Тогда
		
		Результат = ПФ_Акт_552(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавцаНакладная172()) Тогда
		
		Результат = ПФ_Торг12(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавцаАкт172()) Тогда
		
		Результат = ПФ_Акт(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавцаСФ93()) Тогда
		
		Результат = ПФ_СФ(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавцаКСФ93()) Тогда
		
		Результат = ПФ_КСФ(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияОтправителяАктСверки405()) Тогда
		
		Результат = ПФ_АктСверки_405(Параметры);
		
	ИначеЕсли ТипКонтента = НРег(КонтентИнформацияПродавцаСчетНаОплату29()) Тогда
		
		Результат = ПФ_СчетНаОплату_29(Параметры, ТипДокумента);
		
	Иначе
		
		Результат = ПечатнаяФормаЗаглушка(ТипДокумента, ТипКонтента);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПФ_Торг12(Параметры)
	
	Параметры.Вставить("Макет", ПолучитьМакет("ТОРГ12"));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfo);
	
	Таб = НовыйТабличныйДокумент("DD_ТОРГ12");
	
	ПФ_Торг12_ШапкаДокумента(Таб, Параметры);
	ПФ_Торг12_ШапкаТаблицы(Таб, Параметры);
	ПФ_Торг12_СтрокиТаблицы(Таб, Параметры);
	ПФ_Торг12_ПодвалТаблицы(Таб, Параметры);
	ПФ_Торг12_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_Торг12_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Таб.Вывести(Параметры.Макет.ПолучитьОбласть("Колонтитул"));
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	// Грузоотправитель, Грузополучатель, Продавец, Покупатель, Договор основание 
	Область = Параметры.Макет.ПолучитьОбласть("Шапка1");
	Область.Параметры.Грузоотправитель		 = СтрокаДанныеКонтрагента(Content.Shipper);
	Область.Параметры.подразделение			 = Content.ShipperDepartment;
	Область.Параметры.ГрузоотправительПоОКПО = Content.Shipper.Okpo;
	Область.Параметры.ВидДеятельностиПоОКДП	 = Content.ShipperOkdp;
	Область.Параметры.Грузополучатель		 = СтрокаДанныеКонтрагента(Content.Consignee);
	Область.Параметры.ГрузополучательПоОКПО	 = Content.Consignee.Okpo;
	
	Область.Параметры.Продавец 	   	 = СтрокаДанныеКонтрагента(Content.Seller);
	Область.Параметры.ПродавецПоОКПО = Content.Seller.Okpo;
	
	Область.Параметры.Покупатель	   = СтрокаДанныеКонтрагента(Content.Buyer);
	Область.Параметры.ПокупательПоОКПО = Content.Buyer.Okpo;
	
	Область.Параметры.Основание		 = СтрокаОснованиеНакладной(Content.GroundName, Content.GroundNumber, Content.GroundDate);
	Область.Параметры.ОснованиеДата  = ДатаСтрокой(Content.GroundDate);
	Область.Параметры.ОснованиеНомер = Content.GroundNumber;
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ШапкаДопСведения", Параметры.ДопСведения.top);
	
	// Номер и дата документа, номер и дата транспортной накладной, вид операции
	Область = Параметры.Макет.ПолучитьОбласть("Шапка2");
	
	Область.Параметры.Номер = Content.Number;
	Область.Параметры.Дата	= ДатаСтрокой(Content.Date);
	Область.Параметры.ВидОперации = Content.OperationCode;
	
	Область.Параметры.ТранспортнаяНакладнаяНомер = Content.WaybillNumber;
	Область.Параметры.ТранспортнаяНакладнаяДата	 = ДатаСтрокой(Content.WaybillDate);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_ШапкаТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Область.Параметры.Валюта = ПредставлениеВалютыТорг12("643");
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для Каждого Item Из Параметры.Content.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если Параметры.ПоказатьДопСведения И ЗначениеЗаполнено(Item.AdditionalInfo) Тогда 
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", Item.AdditionalInfo);
		Иначе 	
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = СтрокаНаименованиеСтрокиНакладной(Item);
		Область.Параметры.Код		   = Item.ProductCode;
		
		Область.Параметры.ЕдиницаИзмерения	  = Item.UnitName;
		Область.Параметры.ЕдиницаИзмеренияКод =	Item.UnitCode;
		Область.Параметры.ВидУпаковки		  = Item.ParcelType;
		
		Область.Параметры.КоличествоВОдномМесте = Число_В_Формат(Item.ParcelCapacity);
		Область.Параметры.КоличествоМест 		= Число_В_Формат(Item.ParcelsQuantity);
		Область.Параметры.Масса					= КоличествоСтрокой(Item.GrossQuantity);
		
		Область.Параметры.Количество  = КоличествоСтрокой(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокой(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = Число_В_Формат(Item.TotalWithVatExcluded, "ЧДЦ=2; ЧН=");
		Область.Параметры.СуммаНДС	  = Число_В_Формат(Item.Vat  , "ЧДЦ=2; ЧН=");
		Область.Параметры.СуммаВсего  = Число_В_Формат(Item.Total, "ЧДЦ=2; ЧН=");
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_Торг12_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.КоличествоМест = Число_В_Формат(Параметры.Content.Totals.ParcelsQuantity);
	Область.Параметры.Масса			 = КоличествоСтрокой(Параметры.Content.Totals.GrossQuantity);
	Область.Параметры.Количество	 = КоличествоСтрокой(Параметры.Content.Totals.Quantity, Параметры.ФорматКоличества);
	
	Область.Параметры.СуммаБезНДС	 = Число_В_Формат(Параметры.Content.Totals.TotalWithVatExcluded, "ЧДЦ=2; ЧН=");
	Область.Параметры.СуммаНДС		 = Число_В_Формат(Параметры.Content.Totals.Vat				   , "ЧДЦ=2; ЧН=");
	Область.Параметры.СуммаВсего	 = Число_В_Формат(Параметры.Content.Totals.Total			   , "ЧДЦ=2; ЧН=");
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Торг12_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Область.Параметры.КоличествоПорядковыхНомеровЗаписейПрописью = КоличествоЗаписейПрописью(Content.Items.Количество());
	
	Область.Параметры.ВсегоМестПрописью = Content.Commons.TotalParcelsQuantityInWords;
	Область.Параметры.СуммаПрописью 	= Content.Commons.TotalSumInWords;
	
	Область.Параметры.МассаНеттоПрописью = Content.Commons.TotalQuantityInWords;
	Область.Параметры.МассаНетто		 = Content.Commons.TotalQuantity;
	
	Область.Параметры.МассаГрузаПрописью = Content.Commons.TotalGrossQuantityInWords;
	Область.Параметры.МассаГруза		 = Content.Commons.TotalGrossQuantity;
	
	Область.Параметры.КоличествоПриложений = Число_В_Формат(Content.AttachmentSheetsQuantity);
	
	Область.Параметры.ГлавБух			= СтрокаФИО(Content.ChiefAccountant);
	Область.Параметры.ПродавецПодписант	= СтрокаФИО(Content.SupplyAllowedBy);
	Область.Параметры.ПродавецДолжность = Content.SupplyAllowedBy.JobTitle;
	
	Область.Параметры.ПродавецРаботник			= СтрокаФИО(Content.SupplyPerformedBy);
	Область.Параметры.ПродавецРаботникДолжность = Content.SupplyPerformedBy.JobTitle;
	
	Область.Параметры.ДатаОтпуска = Формат(Content.SupplyDate, "ДФ='dd MMMM yyyy ""года""'");
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) Тогда
		
		Область.Параметры.ПокупательДолжность  = Параметры.BuyerContent.Receiver.JobTitle;
		Область.Параметры.ПокупательПодписант  = СтрокаФИО(Параметры.BuyerContent.Receiver);
		
		Область.Параметры.ПокупательРаботник	   	  = СтрокаФИО(Параметры.BuyerContent.Accepter);
		Область.Параметры.ПокупательРаботникДолжность = Параметры.BuyerContent.Accepter.JobTitle;
		
		Область.Параметры.ДоверенностьНомер	   = Параметры.BuyerContent.Attorney.Number;
		Область.Параметры.ДоверенностьДата	   = ДатаСтрокой(Параметры.BuyerContent.Attorney.Date);
		
		Область.Параметры.ДоверенностьВыдана   = СтрокаДоверенностьВыдана(Параметры.BuyerContent.Attorney);
		Область.Параметры.ДоверенностьПолучена = СтрокаДоверенностьПолучена(Параметры.BuyerContent.Attorney);
		
		Область.Параметры.ДатаПолучения = Формат(Параметры.BuyerContent.ShipmentReceiptDate, "ДФ='dd MMMM yyyy ""года""'");
		
	КонецЕсли;	
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


