Функция СтрокаКодСодержанияОперации(ContentOperCode)
	
	НаимДокРасх	 = ContentOperCode.NameDiscrepDocument;
	ВидДокРасх	 = ContentOperCode.TypeDiscrepDocument;
	НомДокРасх	 = ContentOperCode.NumberDiscrepDocument;
	ДатаДокРасх	 = ContentOperCode.DateDiscrepDocument;
	
	Если Не ЗначениеЗаполнено(НаимДокРасх) Тогда
		
		Если ВидДокРасх = "2" Тогда
			НаимДокРасх = "Документ о приемке с расхождениями";
		ИначеЕсли ВидДокРасх = "3" Тогда
			НаимДокРасх = "Документ о расхождениях";
		Иначе
			Если ЗначениеЗаполнено(НомДокРасх)
				Или ЗначениеЗаполнено(ДатаДокРасх) Тогда
				НаимДокРасх = "Документ";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаимДокРасх) Тогда
		НаимДокРасх = ": " + НаимДокРасх;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомДокРасх) Тогда
		НомДокРасх = " №" + НомДокРасх;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаДокРасх) Тогда
		ДатаДокРасх = " от " + ДатаСтрокой(ДатаДокРасх);
	Иначе
		ДатаДокРасх = "";
	КонецЕсли;
	
	РезультатПриемки = РезультатПриемкиУПД(ContentOperCode.TotalCode);
	
	Результат = РезультатПриемки + НаимДокРасх + НомДокРасх + ДатаДокРасх;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаКодСодержанияОперации_970(ContentOperCode)
	
	ЧастиСтроки = Новый Массив;
	
	РезультатПриемки = РезультатПриемкиУПД(ContentOperCode.TotalCode);
	ЧастиСтроки.Добавить(РезультатПриемки);
	
	DiscrepDocument = ContentOperCode.DiscrepDocument;
	Если ЗначениеЗаполнено(DiscrepDocument.Name) Тогда
		ПредставлениеДокумента = ПредставлениеДокумента(DiscrepDocument.Name, DiscrepDocument.Number, DiscrepDocument.Date);
		ЧастиСтроки.Добавить(ПредставлениеДокумента);
	КонецЕсли;
			
	Результат = СоединитьСтроку(ЧастиСтроки, ": ");

	Возврат Результат;
	
КонецФункции

Функция РезультатПриемкиУПД(КодПриемки)
	
