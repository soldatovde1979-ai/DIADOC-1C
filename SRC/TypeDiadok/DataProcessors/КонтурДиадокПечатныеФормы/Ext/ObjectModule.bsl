		Если Не ЗначениеЗаполнено(КПП) Тогда
			КПП = СтрокаДефис();
		КонецЕсли;
		
		Результат = Общее_ПодставитьПараметрыВСтроку("%1/%2", ИНН, КПП);
		
	ИначеЕсли СведенияЮрФизЛица.Type = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		
		Результат = СведенияЮрФизЛица.Inn;
		
	ИначеЕсли СведенияЮрФизЛица.Type = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Если ЗначениеЗаполнено(СведенияЮрФизЛица.Inn) Тогда
			Результат = СведенияЮрФизЛица.Inn;
		Иначе
			Результат = СтрокаДефис();
		КонецЕсли;
		
	Иначе
		
		Результат = СтрокаДефис();
		
	КонецЕсли;
	
	Возврат Результат;
	
