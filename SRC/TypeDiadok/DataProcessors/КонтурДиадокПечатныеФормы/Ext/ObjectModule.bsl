// Возвращает представление коллекции OriginalInvoices, пример:
//  № 10 от 10.10.2017, с учетом исправления № 1 от 11.10.2017
//  № 15 от 10.10.2017, с учетом исправления № 1 от 12.10.2017
//
Функция СтрокаСчетаФактурыКСФ(OriginalInvoices)
	
	Результат = "";
	Разделитель = "";
	
	Для каждого OriginalInvoice Из OriginalInvoices Цикл
		
		Результат = Результат + Разделитель
		+ "№ " + СтрокаИлиДефис(OriginalInvoice.Number)
		+ " от " + ДатаСтрокойИлиДефис(OriginalInvoice.Date)
		+ ", с учетом исправления № " + СтрокаИлиДефис(OriginalInvoice.InvoiceRevisionNumber)
		+ " от " + ДатаСтрокойИлиДефис(OriginalInvoice.InvoiceRevisionDate);
		
		Разделитель = Символы.ПС;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = "№ - от -, с учетом исправления № - от -";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление коллекции Invoices, пример:
//  № 10 от 10.10.2017, с учетом исправлений № 1 от 11.10.2017, № 2 от 12.10.2017
//  № 15 от 10.10.2017, с учетом исправления № 1 от 12.10.2017
//
Функция СтрокаСтрокаСчетаФактурыУКД(Invoices)
	
	Результат = "";
	Разделитель = "";
	
	Для каждого Invoice Из Invoices Цикл
		
		СтрокаСчетаФактуры = "№ " + СтрокаИлиДефис(Invoice.InvoiceNumber) + " от " + ДатаСтрокойИлиДефис(Invoice.InvoiceDate);
		
		СтрокаИсправлений = "";
		
		Если Invoice.InvoiceRevisions.Количество() > 1 Тогда
			РазделительИсправлений = ", с учетом исправлений ";
		Иначе
			РазделительИсправлений = ", с учетом исправления ";
		КонецЕсли;
		
		Для каждого InvoiceRevision Из Invoice.InvoiceRevisions Цикл
			
			СтрокаИсправлений = СтрокаИсправлений + РазделительИсправлений
			+ " № " + СтрокаИлиДефис(InvoiceRevision.RevisionNumber)
			+ " от " + ДатаСтрокойИлиДефис(InvoiceRevision.RevisionDate);
			
			РазделительИсправлений = ", ";
			
		КонецЦикла; 
		
		Если НЕ ЗначениеЗаполнено(СтрокаИсправлений) Тогда
			СтрокаИсправлений = ", с учетом исправления № - от -";
		КонецЕсли;
		
		Результат = Результат + Разделитель + СтрокаСчетаФактуры + СтрокаИсправлений;
		Разделитель = Символы.ПС;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = "№ - от -, с учетом исправления № - от -";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

