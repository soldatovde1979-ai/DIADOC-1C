КонецПроцедуры

Процедура ПФ_Акт_552_СтрокиТаблицы(Таб, Параметры)
	
	WorkItems = Параметры.Content.Works;
	
	НомерСтроки = 0;
	
	Для Каждого WorkItem Из Workitems Цикл
		
		Для Каждого Item Из WorkItem.Items Цикл
			
			НомерСтроки = НомерСтроки + 1;
			СтрокаДопСведений = "";
			
			Если Параметры.ПоказатьДопСведения Тогда
				СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
				Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
			Иначе
				Область = Параметры.Макет.ПолучитьОбласть("Строка");
			КонецЕсли;
			
			Область.Параметры.НомерСтроки = НомерСтроки;
			
			Область.Параметры.Наименование 		= ?(ЗначениеЗаполнено(Item.Name), Item.Name, Item.Description);
			Область.Параметры.ЕдиницаИзмерения 	= СтрокаЕдиницаИзмерения(Item.UnitCode, Item.UnitName);
			
			Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
			Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
			Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
			Область.Параметры.СуммаВсего  = СуммаСтрокойИлиДефис(Item.Subtotal);
			Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
			
			Таб.Вывести(Область);
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_Акт_552_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	TotalWithVatExcluded = 0;
	Total = 0;
	TotalVat = 0;
	
	WorkItems = Параметры.Content.Works;
	
	Для Каждого WorkItem Из WorkItems Цикл
		
		TotalWithVatExcluded = TotalWithVatExcluded + ?(WorkItem.TotalWithVatExcluded = Неопределено, 0, WorkItem.TotalWithVatExcluded);
		
		Total = Total + WorkItem.Total;
		
		TotalVat = TotalVat + ?(WorkItem.TotalVat = Неопределено, 0, WorkItem.TotalVat);
		
	КонецЦикла;
	
	Область.Параметры.СуммаБезНДС	= СуммаСтрокой(TotalWithVatExcluded);
	Область.Параметры.СуммаВсего	= СуммаСтрокой(Total);
	Область.Параметры.СуммаНДС		= ПодвалСуммаНДС(TotalVat);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_Акт_552_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Total = 0;
	TotalVat = 0;
	
	WorkItems = Параметры.Content.Works;
	
	Для Каждого WorkItem Из WorkItems Цикл
		
		Total = Total + WorkItem.Total;
		
		TotalVat = TotalVat + ?(WorkItem.TotalVat = Неопределено, 0, WorkItem.TotalVat);
		
	КонецЦикла;
	
	Область.Параметры.СуммаВсегоПрописью = СуммаПрописью(Total, Content.Currency);
	Если ЗначениеЗаполнено(WorkItem.TotalVat) Тогда
		Область.Параметры.СуммаНДСПрописью = СуммаПрописью(TotalVat, Content.Currency);
	КонецЕсли;
	
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Content.DocumentDate);
	
	Область.Параметры.Продавец		= Content.Seller.Name;
	Область.Параметры.ПродавецИНН	= Content.Seller.Inn;
	Область.Параметры.ПродавецКПП	= Content.Seller.Kpp;
	Область.Параметры.ПродавецАдрес = СтрокаАдресТелефонЭлПочта(Content.Seller);
	Область.Параметры.ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Seller);
	
	Подписи = СтрокиПодписей(Content.Signers);
	Область.Параметры.ПродавецПодписант	= Подписи.ФИО;
	Область.Параметры.ПродавецДолжность = Подписи.Должность;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда 
		Область.Параметры.ПродавецДатаПодписания = Формат(Content.TransferInfo.TransferDate, "ДФ='dd MMMM yyyy ""года""'");
	Иначе
		Область.Параметры.ПродавецДатаПодписания = Формат(Content.DocumentDate, "ДФ='dd MMMM yyyy ""года""'");
	КонецЕсли;
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) И ЗначениеЗаполнено(Параметры.BuyerContent.OperationContent) Тогда 
		
		Область.Параметры.Покупатель	= Content.Buyer.Name;
		Область.Параметры.ПокупательИНН	= Content.Buyer.Inn;
		Область.Параметры.ПокупательКПП	= Content.Buyer.Kpp;
		
		Подписи = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ПокупательПодписант = Подписи.ФИО;
		Область.Параметры.ПокупательДолжность = Подписи.Должность;
		
		Область.Параметры.СодержаниеОперации = Параметры.BuyerContent.OperationContent;
		
		Если ЗначениеЗаполнено(Параметры.BuyerContent.AcceptanceDate) Тогда 
			Область.Параметры.ПокупательДатаПодписания = Формат(Параметры.BuyerContent.AcceptanceDate, "ДФ='dd MMMM yyyy ""года""'");
		Иначе
			Область.Параметры.ПокупательДатаПодписания = Формат(Параметры.Content.DocumentDate, "ДФ='dd MMMM yyyy ""года""'");
		КонецЕсли;
		
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_УПД(Параметры)
	
	Параметры.Вставить("Макет"		 , ПолучитьМакет("УПД"));
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.Date, Параметры.Content.RevisionDate));
	Параметры.Вставить("ПодписиПродавца", СтрокиПодписей(Параметры.Content.Signers));
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
	
	Если Параметры.ДатаРедакции < ДатаРедакции981() Тогда
		Параметры.Макет.УдалитьОбласть(Параметры.Макет.Область("КодВидаТовара"), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	КонецЕсли;
	
	Таб = НовыйТабличныйДокумент("DD_УПД_" + Параметры.ДатаРедакции);
	
	ПФ_УПД_ШапкаДокумента(Таб, Параметры);
	ПФ_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_УПД_СтрокиТаблицы(Таб, Параметры);
	
	ПФ_УПД_ПодвалТаблицы(Таб, Параметры);
	ПФ_УПД_ПодвалДокумента(Таб, Параметры);
	
	ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_УПД_ШапкаДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	БазоваяФункция = ProtoFunctionType(Content.Function);
	Если БазоваяФункция <> ПротофункцияBasic() Тогда
		Область.Параметры.Постановление = СтрокаПостановлениеУПД_УКД();
		Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	КонецЕсли;
	
	Область.Параметры.Дата  = ДатаСтрокой(Content.Date);
	Область.Параметры.Номер	= Content.Number;
	
	Область.Параметры.ДатаИсправления  = ДатаСтрокойИлиДефис(Content.RevisionDate);
	Область.Параметры.НомерИсправления = СтрокаИлиДефис(Content.RevisionNumber);
	
	Область.Параметры.Продавец		   = Content.Seller.Name;
	Область.Параметры.ПродавецАдрес	   = СтрокаИлиДефис(СтрокаАдрес(Content.Seller.Address));
	Область.Параметры.ПродавецИНН	   = СтрокаИННКПП(Content.Seller);
	
	ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Seller);
	Если ПродавецБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПродавецБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПродавецБанковскиеРеквизиты = ПродавецБанковскиеРеквизиты;
	КонецЕсли;
	
	ПродавецКонтакты = СтрокаТелефонЭлПочта(Content.Seller);
	Если ЗначениеЗаполнено(ПродавецКонтакты) Тогда
		Область.Параметры.ПродавецКонтакты = ПродавецКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПродавецКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Область.Параметры.Грузоотправитель = ?(Content.Shipper.SameAsSeller = Истина, "он же", СтрокаНаименованиеАдрес(Content.Shipper.OrganizationInfo));
	Область.Параметры.Грузополучатель  = СтрокаНаименованиеАдрес(Content.Consignee);
	
	Область.Параметры.Покупатель		 = Content.Buyer.Name;
	Область.Параметры.ПокупательАдрес	 = СтрокаИлиДефис(СтрокаАдрес(Content.Buyer.Address));
	Область.Параметры.ПокупательИНН		 = СтрокаИННКПП(Content.Buyer);
	
	ПокупательБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Content.Buyer);
	Если ПокупательБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПокупательБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПокупательБанковскиеРеквизиты = ПокупательБанковскиеРеквизиты;
	КонецЕсли;
	
	ПокупательКонтакты = СтрокаТелефонЭлПочта(Content.Buyer);
	Если ЗначениеЗаполнено(ПокупательКонтакты) Тогда
		Область.Параметры.ПокупательКонтакты = ПокупательКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПокупательКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Область.Параметры.Валюта					 = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.СтатусУПД					 = СтрокаСтатусУПД(Content.Function);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
	
	Область.УдалитьОбласть(Область.Область("ДокументыОбОтгрузке"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_ШапкаТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
		Область.Параметры.ЗаголовокНомерТД = "Регистрационный номер декларации на товары или регистрационный номер партии товара, подлежащего прослеживаемости";
	ИначеЕсли Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
		Область.Параметры.ЗаголовокНомерТД = "Регистрационный номер таможенной декларации";
	Иначе
		Область.Параметры.ЗаголовокНомерТД = "Номер таможенной декларации";
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.InvoiceTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции981() Тогда
			Область.Параметры.КодВТ = СтрокаДефис();
		КонецЕсли;
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Код		   = СтрокаИлиДефис(Item.VendorCode);
		Область.Параметры.Наименование = СтрокаИлиДефис(Item.Product);
		
		Область.Параметры.ЕдиницаИзмерения	  = СтрокаЕдиницаИзмерения(Item.UnitCode, Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаИлиДефис(Item.UnitCode);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		Область.Параметры.СуммаВсего  = СтрокаСуммаВсего(Item.SubTotal, Item.TaxRate, ФорматСуммы());
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС	  = СтрокаСуммаНДС(Item.Vat, Item.TaxRate);
		Область.Параметры.Акциз		  = СтрокаАкциз(Item.Excise, Item.TaxRate);
		
		Строки = СтрокиНомеровТД(Item.CustomDeclarations);
		Область.Параметры.Страна	= Строки.Страны;
		Область.Параметры.СтранаКод = Строки.КодыСтран;
		Область.Параметры.НомерТД	= Строки.НомераТД;
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_УПД_ПодвалТаблицы(Таб, Параметры)
	
	Область = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceTable.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Параметры.Content.InvoiceTable.Items) Тогда
		Область.Параметры.СуммаВсего = СтрокаДефис();
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе	
		Область.Параметры.СуммаВсего = СуммаСтрокойИлиДефис(Параметры.Content.InvoiceTable.Total);
		Область.Параметры.СуммаНДС   = ПодвалСуммаНДС(Параметры.Content.InvoiceTable.Vat);
	КонецЕсли;
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись 	= Параметры.ПодписиПродавца.Подпись;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Область.Параметры.Основания = СтрокаДокументыОснованияУПД(Content.TransferInfo.TransferBases);
	Область.Параметры.ПродавецСоставитель  = Content.Creator;
	Область.Параметры.ПродавецИныеСведения = Параметры.ДопСведения.top;
	Область.Параметры.СведенияОТранспортировкеИГрузе = Content.TransferInfo.TransferTextInfo;
	
	Работник = РаботникИлиИноеЛицо(Content.TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник			= СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись 	= Параметры.ПодписиПродавца.Подпись;
	Область.Параметры.ПродавецДолжность = Параметры.ПодписиПродавца.Должность;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
		Область.Параметры.ДатаОтпуска = Формат(Content.TransferInfo.TransferDate, "ДФ='dd MMMM yyyy ""года""'");
	Иначе
		Область.Параметры.ДатаОтпуска = Формат(Content.Date, "ДФ='dd MMMM yyyy ""года""'");
	КонецЕсли;
	
	// Титул покупателя
	Если ЗначениеЗаполнено(Параметры.BuyerContent) Тогда
		
		Если ЗначениеЗаполнено(Параметры.BuyerContent.AcceptanceDate) Тогда
			ДатаПолучения = Параметры.BuyerContent.AcceptanceDate;
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
			ДатаПолучения = Content.TransferInfo.TransferDate;
		Иначе
			ДатаПолучения = Content.Date;
		КонецЕсли;
		
		Область.Параметры.ДатаПолучения			= Формат(ДатаПолучения, "ДФ='dd MMMM yyyy ""года""'");
		Область.Параметры.РезультатыПриемки 	= Параметры.BuyerContent.OperationContent;
		Область.Параметры.ПокупательСоставитель = Параметры.BuyerContent.Creator;
		
		Работник = РаботникИлиИноеЛицо(Параметры.BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ПокупательРаботник		  = СтрокаФИО(Работник);
			Область.Параметры.ПокупательРаботникДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		ПодписиBuyer = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ПокупательПодписант = ПодписиBuyer.ФИО;
		Область.Параметры.ПокупательПодпись   = ПодписиBuyer.Подпись;
		Область.Параметры.ПокупательДолжность = ПодписиBuyer.Должность;
		
	КонецЕсли;
	
	МассивИнфПолФХЖ3 = Content.TransferInfo.AdditionalInfoId.StructedAdditionalInfos;
	
	Если ЗначениеЗаполнено(МассивИнфПолФХЖ3) Тогда
		
		ИнфПолФХЖ3 = ДопСведенияСтрокой(МассивИнфПолФХЖ3);
		
		Область.Параметры.ИнфПолФХЖ3 = ИнфПолФХЖ3;
		
	Иначе
		Область.УдалитьОбласть(Область.Область("ИнфПолФХЖ3"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры

Функция ЭтоИзвестнаяФункцияУПД(ЗначениеФункции)
	
	ВозможныеЗначения = Новый Массив;
	ВозможныеЗначения.Добавить(ФункцияСЧФДОП());
	ВозможныеЗначения.Добавить(ФункцияСЧФ());
	ВозможныеЗначения.Добавить(ФункцияДОП());
	ВозможныеЗначения.Добавить(ПротофункцияInvoiceAndBasic());
	ВозможныеЗначения.Добавить(ПротофункцияInvoice());
	ВозможныеЗначения.Добавить(ПротофункцияBasic());
	
	Результат = (ВозможныеЗначения.Найти(ЗначениеФункции) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ПФ_УПД_820(Параметры)
	
	ЗначениеФункции = Параметры.Content.Function;
	
	Если Не ЭтоИзвестнаяФункцияУПД(ЗначениеФункции) Тогда
		
		Если ЕстьСведенияОИсправлении(Параметры.Content) Тогда
			ТипДокумента = ТипУниверсальныйПередаточныйДокументИсправление();
		Иначе
			ТипДокумента = ТипУниверсальныйПередаточныйДокумент();
		КонецЕсли;
		ТипКонтента = КонтентИнформацияПродавца820();
		Таб = ПечатнаяФормаЗаглушка(ТипДокумента, ТипКонтента, ЗначениеФункции);
		
		Возврат Таб;
		
	КонецЕсли;
	
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.DocumentDate, Параметры.Content.RevisionDate));
	Параметры.Вставить("ПодписиПродавца", СтрокиПодписей(Параметры.Content.Signers));
	Параметры.Вставить("ЕстьСведенияОПрослеживаемости", ЕстьСведенияОПрослеживаемости820(Параметры.Content));
	
	Если Параметры.ДатаРедакции = ДатаРедакции1096() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_1096_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_534"));	
		КонецЕсли;
		
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_534_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_534"));	
		КонецЕсли;
		
	Иначе
		Параметры.Вставить("Макет", ПолучитьМакет("УПД"));	
		
	КонецЕсли;
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
			
	Таб = НовыйТабличныйДокумент("DD_УПД_" + Параметры.ДатаРедакции);
	
	ПФ_УПД_820_ШапкаДокумента(Таб, Параметры);
	ПФ_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_УПД_820_СтрокиТаблицы(Таб, Параметры);
	
	ПФ_УПД_820_ПодвалТаблицы(Таб, Параметры);
	ПФ_УПД_820_ПодвалДокумента(Таб, Параметры);
	
	Если Параметры.Свойство("ДанныеШтампа") Тогда
		ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	КонецЕсли;
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_УПД_820_ШапкаДокумента_Продавец(Область, Seller)
	
	Если Seller = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Область.Параметры.Продавец		   = Seller.Name;
	Область.Параметры.ПродавецАдрес	   = СтрокаИлиДефис(СтрокаАдрес(Seller.Address));
	Область.Параметры.ПродавецИНН	   = СтрокаИННКПП_820(Seller);
	
	ПродавецБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Seller);
	Если ПродавецБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПродавецБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПродавецБанковскиеРеквизиты = ПродавецБанковскиеРеквизиты;
	КонецЕсли;
	
	ПродавецКонтакты = СтрокаТелефонЭлПочта(Seller);
	Если ЗначениеЗаполнено(ПродавецКонтакты) Тогда
		Область.Параметры.ПродавецКонтакты = ПродавецКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПродавецКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_УПД_820_ШапкаДокумента_Покупатель(Область, Buyer)
	
	Если Buyer = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Область.Параметры.Покупатель		 = Buyer.Name;
	Область.Параметры.ПокупательАдрес	 = СтрокаИлиДефис(СтрокаАдрес(Buyer.Address));
	Область.Параметры.ПокупательИНН		 = СтрокаИННКПП_820(Buyer);
	
	ПокупательБанковскиеРеквизиты = СтрокаБанковскиеРеквизиты(Buyer);
	Если ПокупательБанковскиеРеквизиты = СтрокаДефис() Тогда
		Область.УдалитьОбласть(Область.Область("ПокупательБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	Иначе
		Область.Параметры.ПокупательБанковскиеРеквизиты = ПокупательБанковскиеРеквизиты;
	КонецЕсли;
	
	ПокупательКонтакты = СтрокаТелефонЭлПочта(Buyer);
	Если ЗначениеЗаполнено(ПокупательКонтакты) Тогда
		Область.Параметры.ПокупательКонтакты = ПокупательКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПокупательКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_УПД_820_ШапкаДокумента_Грузоотправитель(Область, Shipper)
	
	Если Shipper = Неопределено Тогда
		ПредставлениеГрузоотправителя = СтрокаДефис();
	ИначеЕсли Shipper.SameAsSeller = Истина Тогда
		ПредставлениеГрузоотправителя = "он же";
	Иначе
		ПредставлениеГрузоотправителя = СтрокаНаименованиеАдрес(Shipper.OrganizationInfo);
	КонецЕсли;
	
	Область.Параметры.Грузоотправитель = ПредставлениеГрузоотправителя;
	
КонецПроцедуры

Процедура ПФ_УПД_820_ШапкаДокумента_Грузополучатель(Область, Consignee)
	
	Если Consignee = Неопределено Тогда
		ПредставлениеГрузополучателя = СтрокаДефис();
	Иначе
		ПредставлениеГрузополучателя = СтрокаНаименованиеАдрес(Consignee);
	КонецЕсли;
	
	Область.Параметры.Грузополучатель = ПредставлениеГрузополучателя;
	
КонецПроцедуры

Процедура ПФ_УПД_820_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Seller		 = ПервыйЭлементКоллекции(Content.Sellers);
	Buyer		 = ПервыйЭлементКоллекции(Content.Buyers);
	Consignee	 = ПервыйЭлементКоллекции(Content.Consignees);
	Shipper		 = ПервыйЭлементКоллекции(Content.Shippers);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	БазоваяФункция = ProtoFunctionType(Content.Function);
	Если БазоваяФункция <> ПротофункцияBasic() Тогда
		Область.Параметры.Постановление = СтрокаПостановлениеУПД_УКД();
		Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	КонецЕсли;
	
	Область.Параметры.Дата  = ДатаСтрокой(Content.DocumentDate);
	Область.Параметры.Номер	= Content.DocumentNumber;
	
	Область.Параметры.ДатаИсправления  = СтрокаДатаИсправления_820(Content.RevisionDate, Content.HyphenRevisionDate);
	Область.Параметры.НомерИсправления = СтрокаНомерИсправления_820(Content.RevisionNumber, Content.HyphenRevisionNumber);
	
	ПФ_УПД_820_ШапкаДокумента_Продавец(Область, Seller);
	
	ПФ_УПД_820_ШапкаДокумента_Грузоотправитель(Область, Shipper);
	
	ПФ_УПД_820_ШапкаДокумента_Грузополучатель(Область, Consignee);
	
	ПФ_УПД_820_ШапкаДокумента_Покупатель(Область, Buyer);
	
	Область.Параметры.Валюта					 = СтрокаВалютаКод(Content.Currency);
	Область.Параметры.СтатусУПД					 = СтрокаСтатусУПД(Content.Function);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Область.Параметры.ИдентификаторГосконтракта			 = Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта	 = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
	
	Если Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузке(Content.DocumentShipments);
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции1096() Тогда
		Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузкеВРедакции1096(Content.DocumentShipments);
	Иначе
		Область.УдалитьОбласть(Область.Область("ДокументыОбОтгрузке"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Если Область.Области.Найти("АвансовыеДокументы") <> Неопределено Тогда
		Область.УдалитьОбласть(Область.Область("АвансовыеДокументы"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_820_СтрокиТаблицы(Таб, Параметры)
	
	НомерСтроки = 0;
	
	Для каждого Item Из Параметры.Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СтрокаДопСведений = "";
		
		КоличествоСтрокСПрослеживаемостью = Item.ItemTracingInfos.Количество();
		
		Если Параметры.ПоказатьДопСведения Тогда
			СтрокаДопСведений = ДопСведенияСтрокиУПД(Item);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДопСведений) И КоличествоСтрокСПрослеживаемостью <= 1 Тогда
			Область = ОбластьДопСведений(Параметры.Макет, "СтрокаДопСведения", СтрокаДопСведений);
		Иначе
			Область = Параметры.Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		
		Область.Параметры.КодВТ = СтрокаИлиДефис(Item.ItemTypeCode);
		
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		Область.Параметры.Наименование = ПредставлениеНоменклатуры_УПД_УКД(Item, Параметры.ВыводитьНаименованиеТовараСКодами);
		
		Область.Параметры.Код = ПредставлениеКодТов(Item, Параметры.ВыводитьНаименованиеТовараСКодами);				
		
		Область.Параметры.ЕдиницаИзмерения	  = СтрокаЕдиницаИзмерения(Item.Unit,	Item.UnitName);
		Область.Параметры.ЕдиницаИзмеренияКод = СтрокаКодЕдиницыИзмерения820(Item.Unit, Item.HyphenUnit);
		
		Область.Параметры.Количество  = КоличествоСтрокойИлиДефис(Item.Quantity, Параметры.ФорматКоличества);
		Область.Параметры.Цена		  = СуммаСтрокойИлиДефис(Item.Price, Параметры.ФорматСуммы);
		Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Item.SubtotalWithVatExcluded);
		
		Область.Параметры.СуммаВсего  = СтрокаСуммаВсего_820(Item.SubTotal, Item.HyphenSubtotal);
		Область.Параметры.СтавкаНДС	  = СтрокаСтавкаНДС(Item.TaxRate);
		Область.Параметры.СуммаНДС    = СтрокаСуммаНДС_820(Item.Vat, Item.WithoutVat, Item.HyphenVat, Item.TaxRate);
		Область.Параметры.Акциз		  = СтрокаАкциз_820(Item.Excise);
		
		Строки = СтрокиНомеровТД_820(Item.CustomDeclarations);
		Область.Параметры.Страна	= Строки.Страны;
		Область.Параметры.СтранаКод = Строки.КодыСтран;
		Область.Параметры.НомерТД	= Строки.НомераТД;
		
		Если Параметры.ДатаРедакции >= ДатаРедакции534() Тогда
			ЗаполнитьПараметрыПрослеживаемостиПервойСтроки_УПД(Область, Item, Строки.НомераТД, Параметры);
		КонецЕсли;
		
		Таб.Вывести(Область);
		
		Если Параметры.ДатаРедакции >= ДатаРедакции534() И КоличествоСтрокСПрослеживаемостью > 1 Тогда
			ЗаполнитьПараметрыПрослеживаемостиСтрок_УПД(Таб, Item, СтрокаДопСведений, НомераКолонок_УПД_534_Прослеж(Параметры), Параметры);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПФ_УПД_820_ПодвалТаблицы(Таб, Параметры)
	
	Область	 = Параметры.Макет.ПолучитьОбласть("ПодвалТаблицы");
	Table	 = Параметры.Content.Table;
	
	Область.Параметры.СуммаБезНДС = СуммаСтрокойИлиДефис(Table.TotalWithVatExcluded);
	
	Если ВсеСтрокиПротоТаблицыИмеютСтавкуНдсИсчНалАг(Table.Items) Тогда
		Область.Параметры.СуммаВсего = СтрокаДефис();
		Область.Параметры.СуммаНДС	 = СтрокаДефис();
	Иначе
		Область.Параметры.СуммаВсего = ПодвалСуммаВсего_820(Table.Total, Table.HyphenTotal);
		Область.Параметры.СуммаНДС	 = ПодвалСуммаНДС_820(Table.Vat, Table.WithoutVat, Table.HyphenVat);
	КонецЕсли;
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись 	= Параметры.ПодписиПродавца.Подпись;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_820_ПодвалДокумента(Таб, Параметры)
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.bottom);
	
	Content = Параметры.Content;
	
	Область = Параметры.Макет.ПолучитьОбласть("Подвал");
	
	Область.Параметры.Основания = СтрокаДокументыОснованияУПД(Content.TransferInfo.TransferBases);
	Область.Параметры.ПродавецСоставитель  = Content.DocumentCreator;
	Область.Параметры.ПродавецИныеСведения = Параметры.ДопСведения.top;
	Область.Параметры.СведенияОТранспортировкеИГрузе = Content.TransferInfo.TransferTextInfo;
	
	Работник = РаботникИлиИноеЛицо(Content.TransferInfo);
	Если Работник <> Неопределено Тогда
		Область.Параметры.ПродавецРаботник			= СтрокаФИО(Работник);
		Область.Параметры.ПродавецРаботникДолжность = Работник.EmployeePosition;
	КонецЕсли;
	
	Область.Параметры.ПродавецПодписант = Параметры.ПодписиПродавца.ФИО;
	Область.Параметры.ПродавецПодпись 	= Параметры.ПодписиПродавца.Подпись;
	Область.Параметры.ПродавецДолжность = Параметры.ПодписиПродавца.Должность;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
		Область.Параметры.ДатаОтпуска = Формат(Content.TransferInfo.TransferDate, "ДФ='dd MMMM yyyy ""года""'");
	Иначе
		Область.Параметры.ДатаОтпуска = Формат(Content.DocumentDate, "ДФ='dd MMMM yyyy ""года""'");
	КонецЕсли;
	
	// Титул покупателя
	Если Параметры.Свойство("BuyerContent")
		И Параметры.BuyerContent <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(Параметры.BuyerContent.AcceptanceDate) Тогда
			ДатаПолучения = Параметры.BuyerContent.AcceptanceDate;
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.TransferDate) Тогда
			ДатаПолучения = Content.TransferInfo.TransferDate;
		Иначе
			ДатаПолучения = Content.DocumentDate;
		КонецЕсли;
		
		Область.Параметры.ДатаПолучения			= Формат(ДатаПолучения, "ДФ='dd MMMM yyyy ""года""'");
		Область.Параметры.ПокупательСоставитель = Параметры.BuyerContent.DocumentCreator;
		Область.Параметры.РезультатыПриемки		= СтрокаСодержаниеОперации(Параметры.BuyerContent);
		
		Работник = РаботникИлиИноеЛицо(Параметры.BuyerContent);
		Если Работник <> Неопределено Тогда
			Область.Параметры.ПокупательРаботник		  = СтрокаФИО(Работник);
			Область.Параметры.ПокупательРаботникДолжность = Работник.EmployeePosition;
		КонецЕсли;
		
		ПодписиBuyer = СтрокиПодписей(Параметры.BuyerContent.Signers);
		Область.Параметры.ПокупательПодписант = ПодписиBuyer.ФИО;
		Область.Параметры.ПокупательПодпись   = ПодписиBuyer.Подпись;
		Область.Параметры.ПокупательДолжность = ПодписиBuyer.Должность;
		
	КонецЕсли;
	
	МассивИнфПолФХЖ3 = Content.TransferInfo.AdditionalInfoId.StructedAdditionalInfos;
	
	Если ЗначениеЗаполнено(МассивИнфПолФХЖ3) Тогда
		
		ИнфПолФХЖ3 = ДопСведенияСтрокой(МассивИнфПолФХЖ3);
		
		Область.Параметры.ИнфПолФХЖ3 = ИнфПолФХЖ3;
		
	Иначе
		Область.УдалитьОбласть(Область.Область("ИнфПолФХЖ3"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.ground);
	
КонецПроцедуры


Функция ПФ_УПД_970(Параметры)
	
	ЗначениеФункции = Параметры.Content.Function;
	
	Если Не ЭтоИзвестнаяФункцияУПД(ЗначениеФункции) Тогда
		
		Если ЕстьСведенияОИсправлении(Параметры.Content) Тогда
			ТипДокумента = ТипУниверсальныйПередаточныйДокументИсправление();
		Иначе
			ТипДокумента = ТипУниверсальныйПередаточныйДокумент();
		КонецЕсли;
		ТипКонтента = КонтентИнформацияПродавца970();
		Таб = ПечатнаяФормаЗаглушка(ТипДокумента, ТипКонтента, ЗначениеФункции);
		
		Возврат Таб;
		
	КонецЕсли;
	
	Параметры.Вставить("ДатаРедакции", ДатаРедакцииСФ(Параметры.Content.DocumentDate, Параметры.Content.RevisionDate));
	Параметры.Вставить("ПодписиПродавца", СтрокиПодписей_970(Параметры.Content.Signers));
	Параметры.Вставить("ЕстьСведенияОПрослеживаемости", ЕстьСведенияОПрослеживаемости970(Параметры.Content));
	
	Если Параметры.ДатаРедакции = ДатаРедакции1096()
		ИЛИ Параметры.ДатаРедакции = ДатаРедакции425() Тогда
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_1096_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_534"));	
		КонецЕсли;
		
	Иначе
		
		Если Параметры.ЕстьСведенияОПрослеживаемости Тогда
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_534_Прослеж"));	
		Иначе
			Параметры.Вставить("Макет", ПолучитьМакет("УПД_534"));	
		КонецЕсли;
		
	КонецЕсли;
	
	ДобавитьДопСведенияВПараметрыПечатнойФормы(Параметры, Параметры.Content.AdditionalInfoId.StructedAdditionalInfos);
			
	Таб = НовыйТабличныйДокумент("DD_УПД_" + Параметры.ДатаРедакции);
	
	ПФ_УПД_970_ШапкаДокумента(Таб, Параметры);
	ПФ_УПД_ШапкаТаблицы(Таб, Параметры);
	ПФ_УПД_970_СтрокиТаблицы(Таб, Параметры);
	
	ПФ_УПД_970_ПодвалТаблицы(Таб, Параметры);
	ПФ_УПД_970_ПодвалДокумента(Таб, Параметры);
	
	Если Параметры.Свойство("ДанныеШтампа") Тогда
		ДобавитьШтамп(Таб, Параметры.ДанныеШтампа);
	КонецЕсли;
	
	Возврат Таб;
	
КонецФункции

Процедура ПФ_УПД_970_ШапкаДокумента(Таб, Параметры)
	
	Content = Параметры.Content;
	
	Sellers = Content.Sellers;
	Buyers = Content.Buyers;
	Consignees = Content.Consignees;
	Shippers = Content.Shippers;
	
	ДобавитьДопСведения(Таб, Параметры.Макет, "ДопСведения", Параметры.ДопСведения.head);
	
	Область = Параметры.Макет.ПолучитьОбласть("Шапка");
	
	БазоваяФункция = ProtoFunctionType(Content.Function);
	Если БазоваяФункция <> ПротофункцияBasic() Тогда
		Область.Параметры.Постановление = СтрокаПостановлениеУПД_УКД();
		Область.Параметры.Редакция = СтрокаРедакцииУПД(Параметры.ДатаРедакции);
	КонецЕсли;
	
	ДатаДокумента = ДатаСтрокой(Content.DocumentDate);
	НомерДокумента = Content.DocumentNumber;
	
	Область.Параметры.Дата  = ДатаДокумента;
	Область.Параметры.Номер = НомерДокумента;
	
	Область.Параметры.ДатаИсправления  = СтрокаДатаИсправления_970(Content.RevisionDate);
	Область.Параметры.НомерИсправления = СтрокаНомерИсправления_970(Content.RevisionNumber);
	
	ПФ_УПД_970_ШапкаДокумента_Продавцы(Область, Sellers);
	
	ПФ_УПД_СФ_970_ШапкаДокумента_Грузоотправители(Область, Shippers);
	
	ПФ_УПД_970_ШапкаДокумента_Грузополучатели(Область, Consignees);
	
	ПФ_УПД_970_ШапкаДокумента_Покупатели(Область, Buyers);
	
	Область.Параметры.Валюта = СтрокаПредставлениеВалюты_970(Content.CurrencyName, Content.Currency);
	Область.Параметры.СтатусУПД	= СтрокаСтатусУПД(Content.Function);
	Область.Параметры.ПлатежноРасчетныеДокументы = СтрокаПРД(Content.PaymentDocuments);
	
	Область.Параметры.ИдентификаторГосконтракта	= Content.GovernmentContractInfo;
	Область.Параметры.НадписьИдентификаторГосконтракта = НадписьИдентификаторГосконтракта(Параметры.ДатаРедакции);
	
	Если Content.Function = ФункцияСЧФДОП() Тогда
		
		НаименованиеДокумента = Content.DocumentName;
		СтрокаДокументаОбОтгрузке = ПредставлениеДокумента(
			НаименованиеДокумента, 
			НомерДокумента, 
			ДатаДокумента);
			
		Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументаОбОтгрузке;
		
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции534() Тогда
		Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузке(Content.DocumentShipments);
	ИначеЕсли Параметры.ДатаРедакции = ДатаРедакции1096() Тогда
	    Область.Параметры.ДокументыОбОтгрузке = СтрокаДокументыОбОтгрузкеВРедакции1096(Content.DocumentShipments);
	КонецЕсли;
	
	Если Content.DocumentDate >= ДатаРедакции425() Тогда
		Область.Параметры.НадписьАвансовыеДокументы = НадписьАвансовыеДокументы();
		Область.Параметры.АвансовыеДокументы = СтрокаАвансовыеДокументы(Content.AccompanyingDocuments);
	Иначе
		Область.УдалитьОбласть(Область.Область("АвансовыеДокументы"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Таб.Вывести(Область);
	
КонецПроцедуры

Процедура ПФ_УПД_970_ШапкаДокумента_Продавцы(Область, Sellers)
	
	Если Sellers = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиПродавец = Новый Массив;
	ЧастиПродавецАдрес = Новый Массив;
	ЧастиПродавецИНН = Новый Массив;
	ЧастиПродавецБанковскиеРеквизиты = Новый Массив;
	ЧастиПродавецКонтакты = Новый Массив;
	
	Для Каждого Seller Из Sellers Цикл
		Если Seller = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЧастиПродавец.Добавить(Seller.Name);
		ЧастиПродавецАдрес.Добавить(СтрокаИлиДефис(СтрокаАдрес_970(Seller.Address)));
		ЧастиПродавецИНН.Добавить(СтрокаИННКПП_970(Seller));
		
		СтрокаБанковскиеРеквизитыЛок = СтрокаБанковскиеРеквизиты(Seller);
		Если Не СтрокаБанковскиеРеквизитыЛок = СтрокаДефис() Тогда
			ЧастиПродавецБанковскиеРеквизиты.Добавить(СтрокаБанковскиеРеквизитыЛок);
		КонецЕсли;
		
		ЧастиПродавецКонтакты.Добавить(СтрокаКонтактныеДанные_970(Seller));
		
	КонецЦикла;
	
	Область.Параметры.Продавец = СоединитьСтроку(ЧастиПродавец, ";");
	Область.Параметры.ПродавецАдрес = СоединитьСтроку(ЧастиПродавецАдрес, ";");
	Область.Параметры.ПродавецИНН = СоединитьСтроку(ЧастиПродавецИНН, ";");
	
	ПродавецБанковскиеРеквизиты = СоединитьСтроку(ЧастиПродавецБанковскиеРеквизиты, ";");
	
	Если ЗначениеЗаполнено(ПродавецБанковскиеРеквизиты) Тогда
		Область.Параметры.ПродавецБанковскиеРеквизиты = ПродавецБанковскиеРеквизиты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПродавецБанковскиеРеквизиты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	ПродавецКонтакты = СоединитьСтроку(ЧастиПродавецКонтакты, ";");
	
	Если ЗначениеЗаполнено(ПродавецКонтакты) Тогда
		Область.Параметры.ПродавецКонтакты = ПродавецКонтакты;
	Иначе
		Область.УдалитьОбласть(Область.Область("ПродавецКонтакты"), ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;

КонецПроцедуры

Процедура ПФ_УПД_970_ШапкаДокумента_Покупатели(Область, Buyers)
	
	Если Не ЗначениеЗаполнено(Buyers) Тогда
		Возврат;
	КонецЕсли;
	
	ПФ_УПД_СФ_970_ШапкаДокумента_Покупатели(Область, Buyers);
	
	БанковскиеРеквизитыПокупателей = Новый Массив;
	КонтактыПокупателей = Новый Массив;

	Для Каждого Buyer Из Buyers Цикл
		
		СтрокаБанковскиеРеквизитыЛок = СтрокаБанковскиеРеквизиты(Buyer);
		Если СтрокаБанковскиеРеквизитыЛок <> СтрокаДефис() Тогда
			БанковскиеРеквизитыПокупателей.Добавить(СтрокаБанковскиеРеквизитыЛок);
		КонецЕсли;
		
		КонтактыПокупателя = СтрокаКонтактныеДанные_970(Buyer);
		Если ЗначениеЗаполнено(КонтактыПокупателя) Тогда
			КонтактыПокупателей.Добавить(КонтактыПокупателя);
		КонецЕсли;
		
	КонецЦикла;
	
	Разделитель = "; ";
	
	Если ЗначениеЗаполнено(БанковскиеРеквизитыПокупателей) Тогда
		Область.Параметры.ПокупательБанковскиеРеквизиты = СоединитьСтроку(БанковскиеРеквизитыПокупателей, Разделитель);
	Иначе
		ОбластьБанковскихРеквизитов = Область.Область("ПокупательБанковскиеРеквизиты");
		Область.УдалитьОбласть(ОбластьБанковскихРеквизитов, ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтактыПокупателей) Тогда
		Область.Параметры.ПокупательКонтакты = СоединитьСтроку(КонтактыПокупателей, Разделитель);
	Иначе
		ОбластьКонтактов = Область.Область("ПокупательКонтакты");
		Область.УдалитьОбласть(ОбластьКонтактов, ТипСмещенияТабличногоДокумента.ПоВертикали);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПФ_УПД_СФ_970_ШапкаДокумента_Покупатели(Область, Buyers)
	
	Если Не ЗначениеЗаполнено(Buyers) Тогда
