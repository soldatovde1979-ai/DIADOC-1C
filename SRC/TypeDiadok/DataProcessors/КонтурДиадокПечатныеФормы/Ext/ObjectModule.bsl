// Возвращает печатную форму прото контента.
//
// Параметры:
//  ПротоКонтент  - Структура - титул продавца в прото формате;
//  ТипКонтента   - Строка    - идентификатор типа контента;
//  ТипДокумента  - Строка    - идентификатор типа документа;
//  ДопПараметры  - Структура - содержит свойства:
//    ДанныеШтампа        - Структура - (необязательный), данные для формирования штампа о подписях;
//    ПротоКонтентОтвета  - Структура - (необязательный), титул покупателя в прото формате;
//    ДокументЗашифрован  - Булево    - (Необязательный), если Истина, то возвращается надпись "Документ зашифрован";
//    ПоказатьДопСведения - Булево    - (Необязательный), если Истина, то в печатной форме отображаются доп. сведения;
//    ВыводитьНаименованиеТовараСКодами - Булево - (Необязательный): 
//    									  если Истина, то в печатной форме выводится наименование товара с кодами и характеристиками,
//                                        если Ложь, в наименование товара выводится только одно из заполненных значений
//
// Возвращаемое значение:
//   Табличный документ - печатная форма
//
Функция ПечатнаяФормаПротоКонтента(ПротоКонтент, ТипКонтента, ТипДокумента, ДопПараметры) Экспорт
	
	ДанныеШтампа			 = СвойствоСтруктуры(ДопПараметры, "ДанныеШтампа");	
	ПротоКонтентОтвета		 = СвойствоСтруктуры(ДопПараметры, "ПротоКонтентОтвета");
	ДокументЗашифрован		 = СвойствоСтруктуры(ДопПараметры, "ДокументЗашифрован"				, Ложь);
	ПоказатьДопСведения		 = СвойствоСтруктуры(ДопПараметры, "ПоказатьДопСведения"			, Ложь);
	
	ВыводитьНаименованиеТовараСКодами = СвойствоСтруктуры(ДопПараметры, "ВыводитьНаименованиеТовараСКодами", Истина);
	
	Параметры = Новый Структура;
	Параметры.Вставить("Content"				, ПротоКонтент);
	Параметры.Вставить("BuyerContent"			, ПротоКонтентОтвета);
	Параметры.Вставить("ДанныеШтампа"			, ДанныеШтампа);
	Параметры.Вставить("ПоказатьДопСведения"	, ПоказатьДопСведения);
	Параметры.Вставить("ДокументЗашифрован"		, ДокументЗашифрован);
	
	Параметры.Вставить("ВыводитьНаименованиеТовараСКодами", ВыводитьНаименованиеТовараСКодами);
	
	ДополнитьПараметрыФорматамиЦеныКоличества(Параметры, ДопПараметры);
	
	Результат = ПечатнаяФорма(Параметры, ТипКонтента, ТипДокумента);
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьПараметрыФорматамиЦеныКоличества(Параметры, ДопПараметры)
	
	ТочностьКоличества		 = СвойствоСтруктуры(ДопПараметры, "ТочностьКоличества"	, Неопределено);
	Если ЗначениеЗаполнено(ТочностьКоличества) Тогда
		ФорматКоличества	 = ФорматКоличества(ТочностьКоличества);
	Иначе
		ФорматКоличества	 = ФорматКоличества();
	КонецЕсли;
	
	ТочностьЦены			 = СвойствоСтруктуры(ДопПараметры, "ТочностьЦены"			, Неопределено);
	Если ЗначениеЗаполнено(ТочностьЦены) Тогда
		ФорматСуммы			 = ФорматСуммы(ТочностьЦены);
	Иначе
		ФорматСуммы			 = ФорматСуммы();
	КонецЕсли;

	Параметры.Вставить("ФорматКоличества"		, ФорматКоличества);
	Параметры.Вставить("ФорматСуммы"			, ФорматСуммы);

КонецПроцедуры


// Возвращает представление структуры адреса в прото формате.
//
// Параметры:
//  СтруктураАдреса - Структура - адрес в прото формате;
//
// Возвращаемое значение:
//   Строка - представление адреса
//
Функция ПредставлениеПротоСтруктурыАдреса(СтруктураАдреса) Экспорт
	
	Результат = СтрокаАдрес(СтруктураАдреса);
	
	Возврат Результат;
	
КонецФункции

