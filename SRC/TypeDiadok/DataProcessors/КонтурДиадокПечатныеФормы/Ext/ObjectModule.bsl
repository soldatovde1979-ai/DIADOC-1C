Функция КодыРегионов()
	
	Результат = Кэш_Прочитать("КодыРегионов");
	
	Если Результат = Неопределено Тогда
		
		Результат = Новый Соответствие;
		
		// Сериализуем через произвольный ОбъектXDTO для совместимости с 8.1
		ОбъектXDTO = XML_В_XDTO(ПолучитьМакет("КодыРегионов").ПолучитьТекст());
		
		Для Каждого СтрокаXDTO Из ОбъектXDTO.pair Цикл
			Результат.Вставить(СтрокаXDTO.Key, СтрокаXDTO.Value);
		КонецЦикла;
		
		Кэш_Поместить("КодыРегионов", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОКВ()
	
	Результат = Кэш_Прочитать("ОКВ");
	
	Если Результат = Неопределено Тогда
		
		Результат = Новый ТаблицаЗначений;
		
		// Сериализуем через произвольный ОбъектXDTO для совместимости с 8.1
		ОбъектXDTO = XML_В_XDTO(ПолучитьМакет("ОКВ").ПолучитьТекст());
		
		МассивКолонок = РазделитьСтрокуЛок(ОбъектXDTO.Columns);
		Для Каждого ИмяКолонки Из МассивКолонок Цикл
			
			Если ИмяКолонки = "RBCLoading" Тогда
				ТипКолонки = Новый ОписаниеТипов("Булево");
			Иначе
				ТипКолонки = Новый ОписаниеТипов("Строка");
			КонецЕсли;
			
			Результат.Колонки.Добавить(ИмяКолонки, ТипКолонки);
			
		КонецЦикла;
		
		Для Каждого СтрокаXDTO Из ОбъектXDTO.Item Цикл
			
			НоваяСтрока = Результат.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаXDTO, , "RBCLoading");
			
			НоваяСтрока.RBCLoading = НРег(СтрокаXDTO.RBCLoading) = "истина";
			
		КонецЦикла;
		
		Результат.Колонки.Code.Имя					= "Код";
		Результат.Колонки.CodeSymbol.Имя			= "КодСимвольный";
		Результат.Колонки.Name.Имя					= "Наименование";
		Результат.Колонки.Description.Имя			= "Описание";
		Результат.Колонки.RBCLoading.Имя			= "ЗагрузкаИзИнтернета";
		Результат.Колонки.NumerationItemOptions.Имя = "ПараметрыИсчисления";
		
		Результат.Индексы.Добавить("Код");
		
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "КодСимвольный");
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "Наименование");
		
		Кэш_Поместить("ОКВ", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
