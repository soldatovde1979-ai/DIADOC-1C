Функция СтрокаАдрес(AddressInfo)
	
	Если AddressInfo.IsForeign = Ложь И ЗначениеЗаполнено(AddressInfo.RegionCode) Тогда
		
		Результат = ПредставлениеАдрРФ(AddressInfo);
		
	ИначеЕсли ЗначениеЗаполнено(AddressInfo.AddressText) Тогда
		
		Результат = ПредставлениеАдрИнф(AddressInfo);
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаАдрес_970(AddressInfo)
	
	ВидыАдресов = Перечисление_ВидыАдресов();
	
	Если AddressInfo.Type = ВидыАдресов.АдресРФ Тогда
		
		Результат = ПредставлениеАдрРФ(AddressInfo.AddressRF);
		ДополнитьСтрокуАдресаРФИнымиСведениями(Результат, AddressInfo.AddressRF);
				
	ИначеЕсли AddressInfo.Type = ВидыАдресов.АдресГАР Тогда
		
		Результат = ПредставлениеАдрГАР(AddressInfo.AddressSAR);
		
	ИначеЕсли AddressInfo.Type = ВидыАдресов.АдресСтрокой Тогда
		
		Результат = ПредставлениеАдрИнф(AddressInfo.AddressText);
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьСтрокуАдресаРФИнымиСведениями(Результат, AddressRF)

	ИныеСведения = AddressRF.AdditionalInfo;
	
	Если ЗначениеЗаполнено(ИныеСведения) Тогда
		
		ЧастиСтроки = Новый Массив;
		ЧастиСтроки.Добавить(Результат);
		ЧастиСтроки.Добавить(ИныеСведения);
		
		Разделитель = ", ";
		Результат = СоединитьСтроку(ЧастиСтроки, Разделитель);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция СтрокаАдрес_736(AddressInfo)
	
	Если AddressInfo.IsForeign = Ложь И ЗначениеЗаполнено(AddressInfo.RegionCode) Тогда
		
		Результат = ПредставлениеАдрРФ(AddressInfo);
		
	ИначеЕсли ЗначениеЗаполнено(AddressInfo.AddressText) Тогда
		
		Результат = ПредставлениеАдрИнф(AddressInfo);
	
	ИначеЕсли ЗначениеЗаполнено(AddressInfo.AddressCode) Тогда
		
		Результат = ПредставлениеКодГАР(AddressInfo);
		
	Иначе
		
		Результат = "";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаПРД(PaymentDocuments)
	
	Результат = "";
	Разделитель = "";
	
	Для Каждого PaymentDocument Из PaymentDocuments Цикл
		
		Если ЗначениеЗаполнено(PaymentDocument.Number)
			ИЛИ ЗначениеЗаполнено(PaymentDocument.Date) Тогда
			
			Результат = Результат + Разделитель + "№ " + PaymentDocument.Number + " от " + ДатаСтрокой(PaymentDocument.Date);
			Разделитель = ", ";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = ?(ЗначениеЗаполнено(Результат), Результат, СтрокаДефис());
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаДокументыОбОтгрузке(DocumentShipments)
	
	Результат 	= "";
	Разделитель = "";
	СимволНПП 	= Символы.НПП;
	
	Для Каждого DocumentShipment Из DocumentShipments Цикл
		
		Номер 	= DocumentShipment.Number;
		Дата 	= DocumentShipment.Date;
		
		Если НЕ ЗначениеЗаполнено(Номер)
			И НЕ ЗначениеЗаполнено(Дата) Тогда
			Продолжить;				
		КонецЕсли;
		
		Результат = Результат + Разделитель + "№" + СимволНПП + Номер;
		
		Если ЗначениеЗаполнено(Дата) Тогда
			
			Результат = Результат + СимволНПП + "от" + СимволНПП + ДатаСтрокой(Дата);
			
		КонецЕсли;

		Разделитель = "; ";
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
	
		Результат = СтрокаДефис();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаДокументыОбОтгрузкеВРедакции1096(DocumentShipments)
	
	СимволНПП = Символы.НПП;
	
	ДокументыОбОтгрузке = Новый Массив;
	
	Для Каждого DocumentShipment Из DocumentShipments Цикл
		
		Наименование = DocumentShipment.Name;
		Номер = DocumentShipment.Number;
		Дата = DocumentShipment.Date;
		
		Если НЕ ЗначениеЗаполнено(Наименование)
			И НЕ ЗначениеЗаполнено(Номер) Тогда
			Продолжить;				
		КонецЕсли;
		
		ПредставлениеДокумента = ПредставлениеДокумента(Наименование, Номер, Дата);
		
		ДокументыОбОтгрузке.Добавить(ПредставлениеДокумента);
		
	КонецЦикла;
	
	Если ДокументыОбОтгрузке.Количество() = 0 Тогда
		Результат = СтрокаДефис();
	Иначе
		Результат = СоединитьСтроку(ДокументыОбОтгрузке, "; ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеДокумента(Наименование, Номер, Дата)
	
	СимволНПП = Символы.НПП;
	
	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить(Наименование);
	
	Если ЗначениеЗаполнено(Номер) Тогда
		ЧастиСтроки.Добавить("№" + СимволНПП + Номер);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		ЧастиСтроки.Добавить("от" + СимволНПП + ДатаСтрокой(Дата));
	КонецЕсли;
	
	Результат = СоединитьСтроку(ЧастиСтроки, СимволНПП);
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаАвансовыеДокументы(AccompanyingDocuments)
	
	Результат = СтрокаДефис();
	
	СопроводительныеДокументы = Новый Массив;
	
	Для Каждого Элемент Из AccompanyingDocuments Цикл
		
		Если Элемент.Name <> Конст_имяДокументаАСЧФ() Тогда
			Продолжить;
		КонецЕсли;
		
		ДопСведения = СвойствоСтруктуры(Элемент, "AdditionalInfo");
		
		ПредставлениеДокумента = ПредставлениеАвансовогоДокумента(Элемент.Number, Элемент.Date, ДопСведения);
		СопроводительныеДокументы.Добавить(ПредставлениеДокумента);
		
	КонецЦикла;
	
	Если СопроводительныеДокументы.Количество() > 0 Тогда
		Результат = СоединитьСтроку(СопроводительныеДокументы, "; ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Конст_ИмяДокументаАСЧФ()
	Возврат "АСЧФ";
КонецФункции

Функция ПредставлениеАвансовогоДокумента(Номер, Дата, ДопСведения)
	
	СимволНПП = Символы.НПП;
	
	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить("№" + СимволНПП + Номер);
	ЧастиСтроки.Добавить("от" + СимволНПП + ДатаСтрокой(Дата));
	
	Результат = СоединитьСтроку(ЧастиСтроки, СимволНПП);
	
	Если ЗначениеЗаполнено(ДопСведения) Тогда
		Результат = Результат + "," + СимволНПП + ДопСведения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаСтавкаНДС(TaxRate)
	
	Если НРег(TaxRate) = "исчналаг" Тогда
		Возврат "НДС исчисляется налоговым агентом";
	ИначеЕсли НРег(TaxRate) = НРег(СтрокаБезНДС()) Или НЕ ЗначениеЗаполнено(TaxRate) Тогда
		Возврат СтрокаБезНДС();
	Иначе
		Если Найти(TaxRate, "/") > 0 Тогда // Авансовые ставки: "20/120", "18/118", "10/110".
			Возврат СокрЛП(TaxRate);
		Иначе
			Возврат СокрЛП(TaxRate) + "%";
		КонецЕсли;			
	КонецЕсли;
	
КонецФункции

Функция СтрокаСуммаНДС(Vat, TaxRate)
	
	// Заполнение строк графы 8 счета-фактуры и аналогичных колонок КСФ.
	
	Если ЗначениеЗаполнено(Vat) Тогда
		// Если СуммаНДС отличается от нуля - выведем ее в любом случае, ошибочно это или нет.
		Результат = Число_В_Формат(Vat, "ЧДЦ=2; ЧН=");
	
	// Если СуммаНДС не заполнено (0 или Неопределено), то посмотрим на ставку НДС и интерпретируем ее.
	ИначеЕсли НРег(TaxRate) = "исчналаг" Тогда
		Результат = СтрокаДефис();
	ИначеЕсли НРег(TaxRate) = НРег(СтрокаБезНДС()) Тогда
		Результат = СтрокаБезНДС();
	ИначеЕсли НРег(TaxRate) = "0" Тогда
		Результат = "0";
	ИначеЕсли Vat = 0 Тогда
		// Если после этого СуммаНДС = 0, то ее надо указать именно как 0
		Результат = Число_В_Формат(Vat, "ЧДЦ=2; ЧН=");
	Иначе
		// Если СуммаНДС Неопределено, но при этом налоговая ставка не соответствует, то покажем это явно.
		Результат = "#ОШИБКА#";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

