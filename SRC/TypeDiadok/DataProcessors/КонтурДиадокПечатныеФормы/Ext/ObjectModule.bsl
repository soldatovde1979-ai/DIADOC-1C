	Если ЗначениеЗаполнено(CustomDeclarations) Тогда
		
		КодыСтран	= Новый Массив;
		НомераТД	= Новый Массив;
		
		Разделитель	= "";
		
		Для Каждого CustomDeclaration Из CustomDeclarations Цикл
			
			Если ЭтоИстина(CustomDeclaration.HyphenCountry) Тогда
				Страна		 = СтрокаДефис();
