Функция XML_В_XDTO(СтрокаXML)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	Возврат ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
КонецФункции

Функция XDTO_В_Таблицу(ОбъектXDTO)
	
	Таблица = Новый ТаблицаЗначений;
	
	СвойстваОбъектаXDTO = ОбъектXDTO.Свойства();
	
	Если СвойстваОбъектаXDTO.Получить("column") <> Неопределено Тогда
		Добавить_КолонкиXDTO_В_КоллекциюКолонок(ОбъектXDTO.column, Таблица.Колонки);
	КонецЕсли;
	
	Для Каждого СтрокаXDTO Из ОбъектXDTO.row Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		ИндексКолонки = -1;
		Для Каждого ЗначениеКолонки Из СтрокаXDTO.Value Цикл
			
			ИндексКолонки = ИндексКолонки + 1;
			
			Если ТипЗнч(ЗначениеКолонки) <> Тип("ОбъектXDTO") Тогда
				НоваяСтрока[ИндексКолонки] = ЗначениеКолонки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если СвойстваОбъектаXDTO.Получить("index") <> Неопределено Тогда
		Добавить_ИндексыXDTO_В_ИндексыКоллекции(ОбъектXDTO.index, Таблица.Индексы);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция XDTO_В_Дерево(ОбъектXDTO)
	
	Дерево = Новый ДеревоЗначений;
	
	Добавить_КолонкиXDTO_В_КоллекциюКолонок(ОбъектXDTO.column, Дерево.Колонки);
	
	Добавить_СписокXDTO_В_Дерево(ОбъектXDTO.row, Дерево.Строки);
	
	Возврат Дерево;
	
КонецФункции

Функция Дерево_В_Таблицу(Дерево, СИерархией)
	
	Таблица = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из Дерево.Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	ЗаполнитьТаблицуИзДерева(Таблица, Дерево, СИерархией);
	
	Возврат Таблица;
	
КонецФункции

// Проверяет, содержит ли описание типов XDTO тип "Число".
// Если в описании типов есть тип "Число", его квалификаторы
// возвращатся во втором параметре.
//
// Параметры:
//  ТипОбъектаXDTO - ОбъектXDTO - объект модели XDTO.
//  Квалификаторы - КвалификаторыЧисла - квалификаторы числа (возвращаемый параметр).
// 
// Возвращаемое значение:
//  Булево - Истина, есть тип "Число".
//
Функция ТипXDTOСодержитТипЧисло(ТипОбъектаXDTO, Квалификаторы)
	
	Результат = Ложь;
	
	СвойстваValueType = ТипОбъектаXDTO.Свойства();
	
	Если СвойстваValueType.Получить("NumberQualifiers") <> Неопределено
		И ТипОбъектаXDTO.NumberQualifiers <> Неопределено Тогда
		
		Результат = Истина;
		
		Квалификаторы = КвалификаторыЧислаИзXDTO(ТипОбъектаXDTO.NumberQualifiers);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает квалификаторы числа из квалификаторов числа объекта XDTO.
//
// Параметры:
//  КвалификаторЧислаXDTO - NumberQualifiers - описание допустимых значений числового типа.
// 
// Возвращаемое значение:
//  КвалификаторыЧисла.
//
Функция КвалификаторыЧислаИзXDTO(КвалификаторЧислаXDTO)
	
	РазрядностьЦелойЧасти = Число(КвалификаторЧислаXDTO.Digits);
	РазрядностьДробнойЧасти = Число(КвалификаторЧислаXDTO.FractionDigits);
	
	Если ТипЗнч(КвалификаторЧислаXDTO.AllowedSign) = Тип("ДопустимыйЗнак") Тогда
		_ДопустимыйЗнак = КвалификаторЧислаXDTO.AllowedSign;
	Иначе
		_ДопустимыйЗнак = ДопустимыйЗнак[КвалификаторЧислаXDTO.AllowedSign];
	КонецЕсли;
	
	Результат = Новый КвалификаторыЧисла(РазрядностьЦелойЧасти,
		РазрядностьДробнойЧасти,
		_ДопустимыйЗнак);
	
	Возврат Результат;
	
КонецФункции


// Проверяет, содержит ли описание типов XDTO тип "Строка".
// Если в описании типов есть тип "Строка", его квалификаторы
// возвращатся во втором параметре.
//
// Параметры:
//  ТипОбъектаXDTO - ОбъектXDTO - объект модели XDTO.
//  Квалификаторы - КвалификаторыСтроки - квалификаторы строки (возвращаемый параметр).
// 
// Возвращаемое значение:
//  Булево - Истина, если есть тип "Строка".
//
Функция ТипXDTOСодержитТипСтрока(ТипОбъектаXDTO, Квалификаторы)
	
	Результат = Ложь;
	
	СвойстваValueType = ТипОбъектаXDTO.Свойства();
	
	Если СвойстваValueType.Получить("StringQualifiers") <> Неопределено 
		И ТипОбъектаXDTO.StringQualifiers <> Неопределено Тогда
		
		Результат = Истина;
		
		Квалификаторы = КвалификаторыСтрокиИзXDTO(ТипОбъектаXDTO.StringQualifiers);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает квалификаторы строки из квалификаторов строки объекта XDTO.
//
// Параметры:
//  КвалификаторСтрокиXDTO - StringQualifiers - описание допустимых значений строкового типа.
// 
// Возвращаемое значение:
//  КвалификаторыСтроки.
//
Функция КвалификаторыСтрокиИзXDTO(КвалификаторСтрокиXDTO)
	
	Длина = Число(КвалификаторСтрокиXDTO.Length);
	
	Если ТипЗнч(КвалификаторСтрокиXDTO.AllowedLength) = Тип("ДопустимаяДлина") Тогда
		_ДопустимаяДлина = КвалификаторСтрокиXDTO.AllowedLength;
	Иначе
		_ДопустимаяДлина = ДопустимаяДлина[КвалификаторСтрокиXDTO.AllowedLength];
	КонецЕсли;
	
	Результат = Новый КвалификаторыСтроки(Длина, _ДопустимаяДлина);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, содержит ли описание типов XDTO тип "Дата".
// Если в описании типов есть тип "Дата", его квалификаторы
// возвращатся во втором параметре.
//
// Параметры:
//  ТипОбъектаXDTO - ОбъектXDTO - объект модели XDTO.
//  Квалификаторы - КвалификаторыДаты - квалификаторы даты (возвращаемый параметр).
// 
// Возвращаемое значение:
//  Булево - Истина, если есть тип "Дата".
//
Функция ТипXDTOСодержитТипДата(ТипОбъектаXDTO, Квалификаторы)
	
	Результат = Ложь;
	
	СвойстваValueType = ТипОбъектаXDTO.Свойства();
	
	Если СвойстваValueType.Получить("DateQualifiers") <> Неопределено 
		И ТипОбъектаXDTO.DateQualifiers <> Неопределено Тогда
		
		Результат = Истина;
		
		Квалификаторы = КвалификаторыДатыИзXDTO(ТипОбъектаXDTO.DateQualifiers);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает квалификаторы даты из квалификаторов даты объекта XDTO.
//
// Параметры:
//  КвалификаторДатыXDTO - DateQualifiers - описание допустимых значений типа "Дата".
// 
// Возвращаемое значение:
//  КвалификаторыДаты.
//
Функция КвалификаторыДатыИзXDTO(КвалификаторДатыXDTO)
	
	Если ТипЗнч(КвалификаторДатыXDTO.DateFractions) = Тип("ЧастиДаты") Тогда
		_ЧастиДаты = КвалификаторДатыXDTO.DateFractions;
	Иначе
		_ЧастиДаты = ЧастиДаты[КвалификаторДатыXDTO.DateFractions];
	КонецЕсли;
	
	Результат = Новый КвалификаторыДаты(_ЧастиДаты);
	
	Возврат Результат;
	
КонецФункции

Функция ТипXDTOСодержитТипБулево(ТипXDTO)
	
	Результат = Ложь;
	
	Если Найти(НРег(ТипXDTO.Type), "boolean") > 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеТиповПоТипуXDTO(ТипXDTO)
	
	МассивТипов = Новый Массив;
	КвалификаторыЧисла  = Неопределено;
	КвалификаторыСтроки = Неопределено;
	КвалификаторыДаты 	= Неопределено;
	
	Если ТипXDTOСодержитТипЧисло(ТипXDTO, КвалификаторыЧисла) Тогда
		МассивТипов.Добавить(Тип("Число"));
	КонецЕсли;
	
	Если ТипXDTOСодержитТипСтрока(ТипXDTO, КвалификаторыСтроки) Тогда
		МассивТипов.Добавить(Тип("Строка"));
	КонецЕсли;
	
	Если ТипXDTOСодержитТипДата(ТипXDTO, КвалификаторыДаты) Тогда
		МассивТипов.Добавить(Тип("Дата"));
	КонецЕсли;
	
	Если ТипXDTOСодержитТипБулево(ТипXDTO) Тогда
		МассивТипов.Добавить(Тип("Булево"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивТипов) Тогда
		
		Результат = Новый ОписаниеТипов(МассивТипов,
			КвалификаторыЧисла,
			КвалификаторыСтроки,
			КвалификаторыДаты);
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Добавить_КолонкиXDTO_В_КоллекциюКолонок(КолонкиXDTO, КоллекцияКолонок)
	
	Для Каждого КолонкаXDTO Из КолонкиXDTO Цикл
		
		ТипКолонкиXDTO = КолонкаXDTO.ValueType;
		ОписаниеТипаКолонки = ОписаниеТиповПоТипуXDTO(ТипКолонкиXDTO);
		
		КоллекцияКолонок.Добавить(КолонкаXDTO.Name, ОписаниеТипаКолонки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Добавить_ИндексыXDTO_В_ИндексыКоллекции(ИндексыXDTO, ИндексыКоллекции)
	
	Для Каждого ИндексXDTO Из ИндексыXDTO Цикл
		
		Если ТипЗнч(ИндексXDTO.column) = Тип("СписокXDTO") Тогда
			
			КолонкиИндекса = "";
			Разделитель = "";
			
			Для Каждого КолонкаИндекса Из ИндексXDTO.column Цикл
				КолонкиИндекса = КолонкиИндекса + Разделитель + КолонкаИндекса;
				Разделитель = ", ";
			КонецЦикла;
			
		Иначе
			КолонкиИндекса = ИндексXDTO.column;
		КонецЕсли;
		
		ИндексыКоллекции.Добавить(КолонкиИндекса);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Добавить_СписокXDTO_В_Дерево(СписокXDTO, СтрокиДерева)
	
	Для Каждого СтрокаXDTO Из СписокXDTO Цикл
		
		НоваяСтрока = СтрокиДерева.Добавить();
		
		ИндексКолонки = -1;
		Для Каждого ЗначениеКолонки Из СтрокаXDTO.Value Цикл
			
			ИндексКолонки = ИндексКолонки + 1;
			
			Если ТипЗнч(ЗначениеКолонки) <> Тип("ОбъектXDTO") Тогда
				НоваяСтрока[ИндексКолонки] = ЗначениеКолонки;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокаXDTO.Свойства().Получить("row") <> Неопределено Тогда
			
			Добавить_СписокXDTO_В_Дерево(СтрокаXDTO.row, НоваяСтрока.Строки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуИзДерева(Таблица, Дерево, СИерархией)
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Строки) Тогда
			
			Если СИерархией Тогда
				ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаДерева);
			КонецЕсли;
			
			ЗаполнитьТаблицуИзДерева(Таблица, СтрокаДерева, СИерархией);
			
		Иначе
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаДерева);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

