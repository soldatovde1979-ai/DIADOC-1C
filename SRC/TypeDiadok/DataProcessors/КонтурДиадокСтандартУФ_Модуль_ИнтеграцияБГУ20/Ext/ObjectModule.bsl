Функция ПолучитьВидКИ(ЮрФизЛицо, ЮрАдрес) Экспорт
	
	ВладелецКИ = ЮрФизЛицо;
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		ВладелецКИ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "ЮридическоеФизическоеЛицо");
	КонецЕсли;
	
	ТипВладельцаКИ = ТипЗнч(ВладелецКИ);
	
	Если ТипВладельцаКИ = Тип("СправочникСсылка.Организации") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресОрганизации", "ФактАдресОрганизации");
		
	ИначеЕсли ТипВладельцаКИ = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "АдресПоПропискеФизическиеЛица", "АдресМестаПроживанияФизическиеЛица");
		
	ИначеЕсли ТипВладельцаКИ = Тип("СправочникСсылка.ЮридическиеЛица") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮридическийАдресКонтрагенты", "ФактическийАдресКонтрагенты");
		
	Иначе 
		
		ВызватьИсключение НСтр("ru = 'Некорректный параметр функции ""ПолучитьВидКИ""'");
		
	КонецЕсли;
	
	Результат = Справочники.ВидыКонтактнойИнформации[ВидАдреса];
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьДанныеТЧ(Документы,
		ЭтоКСФ = Ложь, ВалютаРегламентированногоУчета = Неопределено,
		КолонкаКодаТовара = Неопределено, ФормированиеСФ = Неопределено, СчетФактура = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(КолонкаКодаТовара) Тогда 
		КолонкаКодаТовара = ИмяКолонкиКодТовара();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВалютаРегламентированногоУчета) Тогда 
		ВалютаРегламентированногоУчета = ВалютаРегламентированногоУчета();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		ДокументыИтератор = Новый СписокЗначений;
		ДокументыИтератор.Добавить(СчетФактура)
	ИначеЕсли ТипЗнч(Документы) = Тип("СписокЗначений") Тогда
		ДокументыИтератор = Документы;
	Иначе 
		ДокументыИтератор = Новый СписокЗначений;
		ДокументыИтератор.Добавить(Документы)
	КонецЕсли;
	
	Товары = ИнициализацияТаблицыСтрокТовары(ЭтоКСФ);
	
	Для Каждого Документ Из ДокументыИтератор Цикл
		
		СсылкаНаДокумент = Документ.Значение;
		ТипДокумента = ТипЗнч(СсылкаНаДокумент);
		ДокументОснование = СсылкаНаДокумент;
		
		Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			
			ТекстЗапроса = ТекстЗапросаТабличнаяЧастьСФ();
			ДокументОснование = СсылкаНаДокумент.ДокументОснование;
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
			
			ТекстЗапроса = ТекстЗапросаТабличнаяЧастьТорг12();
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
			
			ТекстЗапроса = ТекстЗапросаТабличнаяЧастьАкт();
			
		ИначеЕсли ТипДокумента = тип("ДокументСсылка.СчетНаоплату") Тогда
			
			ТекстЗапроса = ТекстЗапросаТабличнаяЧастьСчет();
			
		Иначе
			
			ТекстОшибки = СтрШаблон("Ошибка сбора контента по документу %1", Строка(СсылкаНаДокумент));
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
		ТоварыПоДокументу = Запрос.Выполнить().Выгрузить();
		
		Для Каждого стр Из ТоварыПоДокументу Цикл
			
			стр2 						= Товары.Добавить();
			стр2.Номенклатура 			= стр.Номенклатура;
			стр2.НоменклатураПредставление = стр.НоменклатураПредставление;
			Если ЗначениеЗаполнено(Стр.СодержаниеУслуги) Тогда
				стр2.НоменклатураПредставление = стр.СодержаниеУслуги;
			КонецЕсли;
			
			стр2.СтранаПроисхождения	= стр.СтранаПроисхождения;
			стр2.НомерГТД 				= стр.НомерГТД;
			стр2.Количество 			= стр.Количество;
			стр2.ЕдиницаИзмерения 		= стр.ЕдиницаИзмерения;
			стр2.СтавкаНДС 			= стр.СтавкаНДС;
			стр2.СуммаНДС 				= стр.СуммаНДС;
			стр2.СуммаБезНДС = стр.СуммаБезНДС;
			стр2.СуммаСНДС = стр.СуммаСНДС;
			стр2.Цена = стр.Цена;
			стр2.Сумма = ?(стр.ЦенаВключаетНДС, стр.СуммаСНДС, стр.СуммаБезНДС);
			Если стр.ЦенаВключаетНДС 
				И ЗначениеЗаполнено(стр2.Количество) Тогда
				стр2.Цена = стр2.СуммаБезНДС / стр2.Количество;
			КонецЕсли;
			стр2.ЭтоУслуга 			= стр.ЭтоУслуга; 
			
			стр2.КодНоменклатуры 		= СокрЛП(стр.КодНоменклатуры);
			стр2.КодЕдиницыИзмерения	= СокрЛП(стр.КодЕдиницыИзмерения);
			стр2.ВидУпаковки	 		= стр.ВидУпаковки;
			стр2.КоличествоВОдномМесте	= стр.КоличествоВОдномМесте;
			стр2.КоличествоМест		= стр.КоличествоМест;
			
			Если ЗначениеЗаполнено(Стр2.СтранаПроисхождения) Тогда
				Если (НЕ ЗначениеЗаполнено(Стр2.НомерГТД) ИЛИ ПустаяСтрока(Стр2.НомерГТД.Код)) И МетодСервера(,"СтранаЧленТС", Стр2.СтранаПроисхождения.Код) Тогда
					Стр2.СтранаПроисхождения= Справочники.СтраныМира.ПустаяСсылка();
				КонецЕсли;
			Иначе
				стр2.НомерГТД = Справочники.НомераГТД.ПустаяСсылка();
			КонецЕсли;
			
			стр2.ПризнакТоварРаботаУслуга = стр.ПризнакТоварРаботаУслуга;
			стр2.ДокументОтгрузки = ДокументОснование;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Товары;
	
КонецФункции

Функция ПолучитьБанковскийСчет(Док)
	
	Результат = Неопределено;
	
	ЕстьРеквизитыЛС = Док.Метаданные().Реквизиты.Найти("РеквизитыЛицевогоСчета") <> Неопределено;
	
	Если ЕстьРеквизитыЛС Тогда
		Результат = Док.РеквизитыЛицевогоСчета;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат)
		И ТипЗнч(Док) = Тип("ДокументСсылка.АктОбОказанииУслуг")
		И ЗначениеЗаполнено(Док.ДокументОснование)
		И ТипЗнч(Док.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		
		Результат = Док.ДокументОснование.РеквизитыЛицевогоСчета;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьБанковскийСчетКонтрагента(Док)
	
	Результат = Неопределено;
	
	ЕстьРеквизитыЛС = Док.Метаданные().Реквизиты.Найти("РасчетныйСчетКонтрагента") <> Неопределено;
	
	Если ЕстьРеквизитыЛС Тогда
		Результат = Док.РасчетныйСчетКонтрагента;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) И ЭтоНакладная(Док) Тогда 
		Результат = ПолучитьБанковскийСчетКонтрагентаПоДокументуОснования(Док);
	ИначеЕсли Не ЗначениеЗаполнено(Результат) И ЭтоСчетНаОплату(Док) Тогда
		Результат = ПолучитьБанковскийСчетКонтрагентаПоСчетуНаОплату(Док);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьБанковскийСчетКонтрагентаПоДокументуОснования(Док)
	
	Результат = Неопределено;
	
	ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Док, "ДокументОснование");
	Если ЭтоСчетНаОплату(ДокументОснование) Тогда
		Результат = ПолучитьБанковскийСчетКонтрагентаПоСчетуНаОплату(ДокументОснование);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьБанковскийСчетКонтрагентаПоСчетуНаОплату(СсылкаНаОбъект)
	
	Результат = Неопределено;
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "СчетПлательщика");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПолучитьПодразделениеИзДокумента(ДокСсылка)
	Возврат ?(ДокСсылка.Подразделение.ОбособленноеПодразделение, ДокСсылка.Подразделение.Наименование, "");
КонецФункции

Функция ПолучитьБанковскийСчетПоУмолчанию(ЮрФизЛицо)
	
	ЗапросПоБанковскимСчетам=	Новый Запрос;
	ЗапросПоБанковскимСчетам.Текст=	
	//{
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеИКазначейскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеИКазначейскиеСчета.Код КАК НомерСчета
		|ИЗ
		|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
		|ГДЕ
		|	БанковскиеИКазначейскиеСчета.Владелец = &Владелец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыЛицевыхСчетов.Ссылка,
		|	РеквизитыЛицевыхСчетов.Владелец.Код
		|ИЗ
		|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
		|ГДЕ
		|	РеквизитыЛицевыхСчетов.Владелец.Владелец = &Владелец";
	//}
	ЗапросПоБанковскимСчетам.УстановитьПараметр("Владелец", ЮрФизЛицо);
	
	РезультатЗапросаПоБанковскимСчетам=	ЗапросПоБанковскимСчетам.Выполнить();
	Если РезультатЗапросаПоБанковскимСчетам.Пустой() Тогда
		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
			БанковскийСчет= Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
		Иначе
			БанковскийСчет= Справочники.ЛицевыеСчета.ПустаяСсылка();
		КонецЕсли;
	Иначе	
		Выборка=	РезультатЗапросаПоБанковскимСчетам.Выбрать();
		Выборка.Следующий();
		БанковскийСчет= Выборка.Ссылка;
	КонецЕсли;
	
	Возврат БанковскийСчет;
	
КонецФункции

