	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|ГДЕ
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ,
	|	ВЫБОР
	|		КОГДА ВТ_Основная.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_КорректировочныйСчетФактура
	|		ИНАЧЕ &ВидыЭД_СчетФактура
	|	КОНЕЦ КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.ЭтоАванс КАК ЭтоАванс,
	|	ВТ_Основная.Организация,
	|	ВТ_Основная.Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта,
	|	ВТ_Основная.ID_,
	|	"""" 											КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен 	КАК Проведен,
	|	ВТ_Основная.Дата 		КАК Дата,
	|	ВТ_Основная.Номер 		КАК Номер,
	|	ВТ_Основная.СуммаНДСТовары,
	|	0 КАК СуммаНДСУслуги,
	|	""СчетФактураВыданный"" КАК Тип,
	|	ВТ_Основная.ФормироватьУПД      КАК ФормироватьУПД,
	|	ВТ_Основная.ДокументОснование   КАК ДокументОснование,
	|	ЕСТЬNULL(ИдентификаторДокументаОснованияВДиадок.Значение, """") КАК ДокументОснованиеID,
	|	ВТ_Основная.ОснованиеФормированияСчета
	|ПОМЕСТИТЬ СЧФ_Основная
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаОснованияВДиадок
	|		ПО (ВТ_Основная.ДокументОснование = ИдентификаторДокументаОснованияВДиадок.Объект)
	|			И (ИдентификаторДокументаОснованияВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоАванс", ТекстЗапроса_СчетФактура_ЭтоАванс());
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПодготовитьВТ_УПД_СЧФДОП(Запрос, МассивВременныхТаблиц, ТипыДокументов)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СЧФ_Основная.Документ
	|ПОМЕСТИТЬ ВТ_ПодходящиеСЧФ
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	СЧФ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|	И НЕ СЧФ_Основная.ЭтоКорректировка
	|
	|СГРУППИРОВАТЬ ПО
	|	СЧФ_Основная.Документ
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СЧФ_Основная.ID_ = СЧФ_Основная.ДокументОснованиеID
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// связь со счетом, когда счет как самостоятельный документ
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СЧФ_Основная.Документ КАК Документ,
	|	НакладнаяНаРеализациюТорг12.ДокументОснование КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_УПД_СЧФДОП
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	|			ПО СЧФ_Основная.ДокументОснование = НакладнаяНаРеализациюТорг12.Ссылка
	|				И НакладнаяНаРеализациюТорг12.ДокументОснование НЕ В (&ПустыеЗначенияДокументОснованиеРТУ)
	|ГДЕ
	|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|
	|	СЧФ_Основная.Документ,
	|	АктОбОказанииУслуг.ДокументОснование
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	|			ПО СЧФ_Основная.ДокументОснование = АктОбОказанииУслуг.Ссылка
	|				И АктОбОказанииУслуг.ДокументОснование НЕ В (&ПустыеЗначенияДокументОснованиеАкт)
	|ГДЕ
	|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
	|
	|ОБЪЕДИНИТЬ
	|
	// связь со счетом, когда счет на основании накладной и со счетом фактурой
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	СЧФ_Основная.ДокументОснование
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	СЧФ_Основная.ДокументОснование НЕ В (&ПустыеЗначенияДокументОснованиеСЧФ)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.Документ,
	|	&ВидыЭД_СчетФактура КАК ВидЭД,
	|	СЧФ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	СЧФ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	СЧФ_Основная.Организация,
	|	СЧФ_Основная.Контрагент,
	|	СЧФ_Основная.СуммаДокументаЗначение,
	|	СЧФ_Основная.СуммаНДСТовары,
	|	СЧФ_Основная.СуммаНДСУслуги,
	|	СЧФ_Основная.Валюта,
	|	СЧФ_Основная.Проведен,
	|	СЧФ_Основная.Дата,
	|	СЧФ_Основная.Номер,
	|	СЧФ_Основная.ID_,
	|	ВЫБОР 
	|		КОГДА СЧФ_Основная.ЭтоАванс
	|			ТОГДА &ФункцияЭД_СЧФ
	|		ИНАЧЕ &ФункцияЭД_СЧФДОП
	|	КОНЕЦ КАК ФункцияУПД,
	|	""СчетФактураВыданный"" КАК Тип,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	ЛОЖЬ КАК ЭтоСчет
	|ПОМЕСТИТЬ УПД_СЧФДОП
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
	|		ПО ВТ_ПодходящиеСЧФ.Документ = СЧФ_Основная.Документ
	|ГДЕ
	|	НЕ СЧФ_Основная.ЭтоАванс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.ДокументОснование
	|ПОМЕСТИТЬ УПД_СЧФДОП_ДокументыОснования
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
	|		ПО ВТ_ПодходящиеСЧФ.Документ = СЧФ_Основная.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПодходящиеСЧФ";
	
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснованиеРТУ"	, ПустыеЗначенияРеквизита("Документ.НакладнаяНаРеализациюТорг12.Реквизит.ДокументОснование"));
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснованиеАкт"	, ПустыеЗначенияРеквизита("Документ.АктОбОказанииУслуг.Реквизит.ДокументОснование"));
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснованиеСЧФ"	, ПустыеЗначенияРеквизита("Документ.СчетФактураВыданный.Реквизит.ДокументОснование"));
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ПустыеЗначенияДокументОснованиеРТУ");
	Запрос.Параметры.Удалить("ПустыеЗначенияДокументОснованиеАкт");
	Запрос.Параметры.Удалить("ПустыеЗначенияДокументОснованиеСЧФ");
	
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "5" Тогда
		МассивВременныхТаблиц.Добавить("УПД_СЧФДОП");
		МассивВременныхТаблиц.Добавить("Связь_УПД_СЧФДОП");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодготовитьВТ_СчетаФактуры(Запрос, МассивВременныхТаблиц, ТипыДокументов)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.Документ,
	|	ВЫБОР
	|		КОГДА СЧФ_Основная.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_КорректировочныйСчетФактура
	|		ИНАЧЕ &ВидыЭД_СчетФактура
	|	КОНЕЦ КАК ВидЭД,
	|	СЧФ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	СЧФ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	СЧФ_Основная.Организация,
	|	СЧФ_Основная.Контрагент,
	|	СЧФ_Основная.СуммаДокументаЗначение,
	|	СЧФ_Основная.СуммаНДСТовары,
	|	СЧФ_Основная.СуммаНДСУслуги,
	|	СЧФ_Основная.Валюта,
	|	СЧФ_Основная.Проведен,
	|	СЧФ_Основная.Дата,
	|	СЧФ_Основная.Номер,
	|	СЧФ_Основная.ID_,
	|	ВЫБОР
	|		КОГДА СЧФ_Основная.ФормироватьУПД В (&КлючНастройки_СЧФДОП, &КлючНастройки_СЧФ, &КлючНастройки_СЧФ_ДОП)
	|				И СЧФ_Основная.ЭтоКорректировка
	|			ТОГДА &ФункцияЭД_КСЧФ
	|		КОГДА СЧФ_Основная.ФормироватьУПД В (&КлючНастройки_СЧФДОП, &КлючНастройки_СЧФ, &КлючНастройки_СЧФ_ДОП)
	|			ТОГДА &ФункцияЭД_СЧФ
	|		ИНАЧЕ &ФункцияЭД_ПоУмолчанию
	|	КОНЕЦ КАК ФункцияУПД,
	|	""СчетФактураВыданный"" КАК Тип,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	ЛОЖЬ КАК ЭтоСчет
	|ПОМЕСТИТЬ СчетФактураВыданный
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПД_СЧФДОП КАК УПД_СЧФДОП
	|		ПО СЧФ_Основная.Документ = УПД_СЧФДОП.Документ
	|ГДЕ
	|	УПД_СЧФДОП.Документ ЕСТЬ NULL";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	МассивВременныхТаблиц.Добавить("СчетФактураВыданный");
	
КонецПроцедуры

Процедура ПодготовитьВТ_СчетНаОплату(Запрос, МассивВременныхТаблиц)
	
	ПодготовитьВТ_СчетНаОплату_СчетНаОплатуПокупателю(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_СчетНаОплату_РеализацияТоваровУслуг(Запрос, МассивВременныхТаблиц);
	
КонецПроцедуры

Процедура ПодготовитьВТ_СчетНаОплату_СчетНаОплатуПокупателю(Запрос, МассивВременныхТаблиц)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка 			КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	Документ.Организация 		КАК Организация,
	|	Документ.Контрагент 		КАК Контрагент,
	|	Документ.СуммаДокумента 	КАК СуммаДокументаЗначение,
	|	Документ.ВалютаДокумента	КАК Валюта,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") 	КАК ID,
	|	"""" 						КАК СостояниеОтправкиДополнительныхВПФ,
	|	Документ.Проведен 			КАК Проведен,
	|	Документ.Дата 				КАК Дата,
	|	Документ.Номер 				КАК Номер
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.СчетНаОплату КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификаторСчета)
	|ГДЕ
	|	НастройкиЭДО.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
	|	И ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	СУММА(ВложенныйЗапрос.СуммаНДСТовары) КАК СуммаНДСТовары,
	|	СУММА(ВложенныйЗапрос.СуммаНДСУслуги) КАК СуммаНДСУслуги
	|ПОМЕСТИТЬ СуммаНДСЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_Основная.Документ КАК Документ,
	|		Материалы.СуммаНДС 	 КАК СуммаНДСТовары,
	|		0					 КАК СуммаНДСУслуги
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплату.Материалы КАК Материалы
	|			ПО ВТ_Основная.Документ = Материалы.Ссылка
	|
	|  ОБЪЕДИНИТЬ ВСЕ
	|
	|  ВЫБРАТЬ
	|		ВТ_Основная.Документ КАК Документ,
	|		0					 КАК СуммаНДСТовары,
	|		Услуги.СуммаНДС 	 КАК СуммаНДСУслуги
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплату.Услуги КАК Услуги
	|			ПО ВТ_Основная.Документ = Услуги.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ	КАК Документ,
	|	ВТ_Основная.Документ	КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_СчетНаОплату_СчетНаОплату
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ,
	|	&ВидыЭД_СчетНаОплату КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.Организация,
	|	ВТ_Основная.Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта,
	|	ВТ_Основная.ID КАК ID_,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен 	КАК Проведен,
	|	ВТ_Основная.Дата 		КАК Дата,
	|	ВТ_Основная.Номер 		КАК Номер,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСТовары, 0) КАК СуммаНДСТовары,
