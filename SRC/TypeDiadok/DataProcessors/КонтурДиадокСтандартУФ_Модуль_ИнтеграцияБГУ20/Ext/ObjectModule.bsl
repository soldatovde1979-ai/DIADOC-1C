	|				КОГДА ТИПЗНАЧЕНИЯ(ИтоговыеДанные.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	|					ТОГДА ВЫБОР
	|							КОГДА ВЫРАЗИТЬ(ИтоговыеДанные.Номенклатура КАК Справочник.ОсновныеСредства).ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.Казна)
	|								ТОГДА ""ОС (имущество казны)""
	|							ИНАЧЕ ""ОС, НМА, НПА""
	|						КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ВидНоменклатуры
	|ПОМЕСТИТЬ ДанныеСЦенойИКодомВидаНоменклатуры
	|ИЗ
	|	ИтоговыеДанные КАК ИтоговыеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеСЦенойИКодомВидаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.Содержание КАК Содержание,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.Количество КАК Количество,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.Сумма КАК Сумма,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.СуммаНДС КАК СуммаНДС,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.Всего КАК Всего,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.Цена КАК Цена,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.КодВидаНоменклатуры КАК КодВидаНоменклатуры,
	|	ДанныеСЦенойИКодомВидаНоменклатуры.ВидНоменклатуры КАК ВидНоменклатуры
	|ИЗ
	|	ДанныеСЦенойИКодомВидаНоменклатуры КАК ДанныеСЦенойИКодомВидаНоменклатуры
	|ГДЕ
	|	&УсловиеНаКодВидаНоменклатуры";
	
	Если ЗначениеЗаполнено(ВидыНоменклатуры) Тогда
		ТекстУсловияНаКодВидаНоменклатуры = "ДанныеСЦенойИКодомВидаНоменклатуры.КодВидаНоменклатуры В(&ВидыНоменклатуры)";
	Иначе
		ТекстУсловияНаКодВидаНоменклатуры = "ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса
		, "&УсловиеНаКодВидаНоменклатуры"
		, ТекстУсловияНаКодВидаНоменклатуры);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	Запрос.УстановитьПараметр("ВидыНоменклатуры", ВидыНоменклатуры);
	Запрос.УстановитьПараметр("ТипыНоменклатурыУслуг", ТипыНоменклатурыУслуг);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

