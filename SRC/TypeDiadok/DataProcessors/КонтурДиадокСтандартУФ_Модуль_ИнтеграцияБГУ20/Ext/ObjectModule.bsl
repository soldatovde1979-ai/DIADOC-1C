// Вызывается из Модуль_ИнтеграцияУниверсальный.СсылкаОбъектаПоПолямПоиска.
//
// Параметры:
//  СсылкаНаОбъект		 - Произвольный - ссылка на искомый объект;
//  ПоляПоиска			 - Структура - содержит параметры поиска;
//  ОбъектМетаданных	 - ОбъектМетаданных - метаданные искомого объекта;
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события;
//
// Пример:
//
//  НаименованиеПолное = Неопределено;
//  Если ПоляПоиска.Свойство("НаименованиеПолное", НаименованиеПолное) 
//      И Не ЕстьРеквизитМетаданных(ОбъектМетаданных, "НаименованиеПолное") 
//      И ЕстьРеквизитМетаданных(ОбъектМетаданных, "ПолноеНаименование") Тогда
//          
//          ПоляПоиска.Удалить("НаименованиеПолное");
//          ПоляПоиска.Вставить("ПолноеНаименование", НаименованиеПолное);
//          
//  КонецЕсли;
//
Процедура ПриПолученииСсылкиПоПолямПоиска(СсылкаНаОбъект, ПоляПоиска, ОбъектМетаданных, СтандартнаяОбработка) Экспорт
	
	НаименованиеПолное = Неопределено;
	Если ПоляПоиска.Свойство("НаименованиеПолное", НаименованиеПолное) 
		И Не ЕстьРеквизитМетаданных(ОбъектМетаданных, "НаименованиеПолное") 
		И ЕстьРеквизитМетаданных(ОбъектМетаданных, "НаименованиеСокращенное") Тогда
		
		ПоляПоиска.Удалить("НаименованиеПолное");
		ПоляПоиска.Вставить("НаименованиеСокращенное", НаименованиеПолное);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.СчетаФактурыПоОснованию.
//
// Параметры:
//  НайденныеДокументы	 - Массив	 - Ссылки на найденные счета-фактуры;
//  ПараметрыРегистрации - Структура - см. Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактуры();
//  СтандартнаяОбработка - Булево	 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииСчетовФактурПоОснованию(НайденныеДокументы, ПараметрыРегистрации, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	СчетФактура = УчетНДС.НайтиПодчиненныйСчетФактуру(ПараметрыРегистрации.Ссылка, "СчетФактураПолученный");
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда 
		НайденныеДокументы.Добавить(СчетФактура);
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактурыПоОснованию.
//
// Параметры:
//  ПараметрыРегистрации - Структура	 - см. Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактуры();
//  ДокументОснование	 - ЛюбаяСсылка	 - документ, на основании которого необходимо получить параметры;
//  СтандартнаяОбработка - Булево		 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПодготовкеПараметровРегистрацииСчетаФактуры(ПараметрыРегистрации, ДокументОснование, СтандартнаяОбработка) Экспорт
	
	
	
КонецПроцедуры

#КонецОбласти

#Область СборПротоконтента

Процедура ЗаполнитьКонтентXmlUTD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ФункцияУПД = ПараметрыФормирования.ФункцияДокумента;
	
	ДанныеДляПечати = ПолучитьДанныеДляФормированияУПД(ДокСсылка, ФункцияУПД);
	ДанныеШапки     = ДанныеДляПечати.ДанныеШапки;
	ТаблицаТоваров  = ДанныеДляПечати.ТаблицаТоваров;
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber = ДатаНомер.НомерИсправления;
		Content.RevisionDate = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("СчетФактураСсылка") Тогда
		content.СчетФактураСсылка = ДанныеШапки.СчетФактураСсылка;
	КонецЕсли;
	
	БанковскийСчетПокупателя = СвойствоСтруктуры(ДанныеШапки, "БанковскийСчетКонтрагента");
	Заполнить_ExtendedOrganizationInfo(Content.Buyer, ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента, Истина, БанковскийСчетПокупателя);
	Если ПараметрыФормирования.Свойство("Получатель_FnsParticipantId") Тогда
		Content.Buyer.FnsParticipantId = ПараметрыФормирования.Получатель_FnsParticipantId;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ДанныеШапки.КонтрагентКПП;
	КонецЕсли;
	
	КППГрузоотправителя = "";
	
	Если ДанныеШапки.ЕстьТовары Тогда
	
		КППГрузоотправителя = ДанныеШапки.ГрузоотправительКПП;
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда 
			Заполнить_ExtendedOrganizationInfo(Content.Shipper.OrganizationInfo, ДанныеШапки.Грузоотправитель, ДатаНомер.ДатаДокумента, Ложь); 
			Content.Shipper.SameAsSeller = Ложь;
		Иначе 
			Content.Shipper.SameAsSeller = Истина;
		КонецЕсли;
		
		Грузополучатель = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
		Заполнить_ExtendedOrganizationInfo(Content.Consignee, Грузополучатель, ДатаНомер.ДатаДокумента, Ложь, , , ДанныеШапки.АдресДоставки);
		
	КонецЕсли;
	
	Заполнить_ExtendedOrganizationInfo(Content.Seller, ДанныеШапки.Организация, ДатаНомер.ДатаДокумента, Истина, ДанныеШапки.БанковскийСчетОрганизации, КППГрузоотправителя);
	
	Если ПараметрыФормирования.Свойство("Отправитель_FnsParticipantId") Тогда
		Content.Seller.FnsParticipantId = ПараметрыФормирования.Отправитель_FnsParticipantId;
	КонецЕсли;
					
	Content.Creator = Content.seller.name + ", ИНН/КПП " + МетодСервера(, "ПредставлениеИННКПП", Content.seller);
	Content.Function = ДанныеШапки.Функция;
	
	Если ДанныеШапки.Свойство("ДатаНомерДокументовОплаты") Тогда
		СтруктураPaymentDocuments= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_PaymentDocument");
		Для Каждого ПРД Из ДанныеШапки.ДатаНомерДокументовОплаты Цикл
			ЗаполненнаяСтруктураPaymentDocuments = СкопироватьСтруктуру(СтруктураPaymentDocuments);
			ЗаполненнаяСтруктураPaymentDocuments.Number = ПРД.НомерПлатежноРасчетногоДокумента;
			ЗаполненнаяСтруктураPaymentDocuments.Date = ПРД.ДатаПлатежноРасчетногоДокумента;
			content.PaymentDocuments.Добавить(ЗаполненнаяСтруктураPaymentDocuments);
		КонецЦикла;	
	КонецЕсли;
	
	Content.currency = ?(ЗначениеЗаполнено(ДанныеШапки.ВалютаДокумента), Строка(ДанныеШапки.ВалютаДокументаКод), "");
	Content.ВалютаСсылка = ДанныеШапки.ВалютаДокумента;
	
	ДанныеШапки.Свойство("ИдентификаторГосконтракта", Content.GovernmentContractInfo);
	
	МетодСервера(,"ЗаполнитьStructedAdditionalInfos", Content.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	СтруктураItems = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ExtendedInvoiceItem");
	СтруктураГТД = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CustomDeclaration");
	
	TotalNet = 0;
	Total 	 = 0;
	Vat 	 = 0;
	TotalWithVatExcluded = 0;
	
	СФНаАванс = ДанныеШапки.Свойство("СФНаАванс") И ДанныеШапки.СФНаАванс;
	ЕстьСтрокаСНДС = Ложь;
	
	Для каждого СтрокаТаблицы из ТаблицаТоваров Цикл 
		
		Item = СкопироватьСтруктуру(СтруктураItems);
		
		Item.Product 	 = СтрокаТаблицы.НоменклатураПредставление;
		Item.VendorCode = СтрокаТаблицы.КодНоменклатуры;
		Item.ItemMark   = СтрокаТаблицы.ПризнакТоварРаботаУслуга;
		
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
		
		Item.Subtotal 	 = СтрокаТаблицы.СуммаСНДС;
		Если Не СФНаАванс Тогда
			Item.SubtotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		КонецЕсли;
		
		Если Не МенеджерИнтеграции_ЭтоСтавкаБезНДС(СтрокаТаблицы.СтавкаНДС) Тогда
			Item.Vat = СтрокаТаблицы.СуммаНДС;
			ЕстьСтрокаСНДС = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			
			Item.Quantity 	 = ?(СФНаАванс И СтрокаТаблицы.Количество = 0, Неопределено, СтрокаТаблицы.Количество);	//для отображения прочерка в вэбе
			Item.Price 	 = Окр(СтрокаТаблицы.Цена, Точность);
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
				
				Item.UnitCode = МетодСервера(, "XML_КодЕдиницыИзмерения", СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
				Item.UnitName = Строка(СтрокаТаблицы.ЕдиницаИзмерения);
				Item.ЕдиницаИзмеренияССылка = СтрокаТаблицы.ЕдиницаИзмерения;
				
			КонецЕсли;
			
		КонецЕсли;
		
		TotalNet = TotalNet + ?(ЗначениеЗаполнено(СтрокаТаблицы.Количество), СтрокаТаблицы.Количество, 0);
		Total 	 = Total 	+ Item.Subtotal;
		Vat 	 = Vat 		+ СтрокаТаблицы.СуммаНДС;
		Если Не СФНаАванс Тогда
			TotalWithVatExcluded = TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СтранаПроисхождения) Или ЗначениеЗаполнено(СтрокаТаблицы.НомерГТД) И Не ПустаяСтрока(СтрокаТаблицы.НомерГТД.Код) Тогда
			ЗаполненнаяСтруктураГТД = СкопироватьСтруктуру(СтруктураГТД);
			ЗаполненнаяСтруктураГТД.CountryCode       = СтрокаТаблицы.СтранаПроисхождения.Код;
			ЗаполненнаяСтруктураГТД.DeclarationNumber = ?(ЗначениеЗаполнено(СтрокаТаблицы.НомерГТД), ?(ТипЗнч(СтрокаТаблицы.НомерГТД) = Тип("Строка"), СокрЛП(СтрокаТаблицы.НомерГТД), СокрЛП(СтрокаТаблицы.НомерГТД.Код)), "");
			Если Не (Не ЗначениеЗаполнено(строкаТаблицы.НомерГТД) И МетодСервера(, "СтранаЧленТС", строкаТаблицы.СтранаПроисхождения.Код)) Тогда
				ЗаполненнаяСтруктураГТД.СтранаПроисхожденияСсылка = СтрокаТаблицы.СтранаПроисхождения;
			Иначе
				ЗаполненнаяСтруктураГТД.СтранаПроисхожденияСсылка = Справочники.СтраныМира.ПустаяСсылка();
			КонецЕсли;
			Item.CustomDeclarations.Добавить(ЗаполненнаяСтруктураГТД);
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.InvoiceTable.items.добавить(Item);
		
	КонецЦикла;
	content.InvoiceTable.TotalNet = TotalNet;
	content.InvoiceTable.Total 	  = Total;
	content.InvoiceTable.Vat 	  = ?(ЕстьСтрокаСНДС, Vat, Неопределено);
	Если Не СФНаАванс Тогда
		content.InvoiceTable.TotalWithVatExcluded = TotalWithVatExcluded;
	КонецЕсли;
	
	content.TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	
	//TransferDate заполняем только если дата отгрузки не совпадает с датой счета-фактуры.
	Если ДанныеШапки.Свойство("ДатаОтгрузки") И НачалоДня(ДанныеШапки.ДатаОтгрузки) <> НачалоДня(ДатаНомер.ДатаДокумента) Тогда
		content.TransferInfo.TransferDate = ДанныеШапки.ДатаОтгрузки;
	КонецЕсли;
	
	ЗаполнитьСведенияОПередаче(Content, ДокСсылка, ФункцияУПД, ПараметрыФормирования);
	
	МетодСервера("Модуль_ИнтеграцияУниверсальный", "ЗаполнитьСведенияОЛицеПередавшемТовар"
		, Content
		, ДанныеШапки
		, ПараметрыФормирования);

	Если ДанныеШапки.Функция = "InvoiceAndBasic" Тогда
		content.Name = "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	ИначеЕсли ДанныеШапки.Функция = "Basic" Тогда
		content.Name = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	КонецЕсли;
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	ДобавитьДокументыОснованияВСлужебнуюИнформацию(Content);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlUCD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	// Для БГУ не реализовано
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlTorg12(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров	 = ПолучитьДанныеТЧ(ДокСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date = ДатаНомер.ДатаДокумента;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеШапки.Организация, ДатаНомер.ДатаДокумента, ДанныеШапки.БанковскийСчетОрганизации, Истина);
	
	Грузоотправитель = ?(Не ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель), ДанныеШапки.Организация, ДанныеШапки.Грузоотправитель);
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Shipper, Грузоотправитель, ДатаНомер.ДатаДокумента, , Ложь);
	
	Content.ShipperDepartment = ПолучитьПодразделениеИзДокумента(ДокСсылка);
	
	Грузополучатель = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Consignee, Грузополучатель, ДатаНомер.ДатаДокумента, , Ложь, , , ДанныеШапки.АдресДоставки);
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента, , Истина);
	
	НомерЗаказа = ПараметрыФормирования.НомерЗаказа;
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда 
		Content.GroundName =	"Заказ";
		Content.GroundNumber =	СокрЛП(НомерЗаказа);
	Иначе	
		СтруктураДоговора =		СтруктурированноеПредставлениеОснования(ДокСсылка);
		Content.GroundName =		СтруктураДоговора.GroundName;
		Content.GroundDate =		СтруктураДоговора.GroundDate;
		Content.GroundNumber =	СтруктураДоговора.GroundNumber;
	КонецЕсли;
	
	ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ИдКонтрагента = МетодСервера(,"Контрагент_2_CounteragentBoxID", ДанныеШапки.Контрагент);
	Если МетодСервера(,"НужноФормироватьДопИнфоПоШаблону", ИдКонтрагента) = Истина Тогда
		content.AdditionalInfo = МетодСервера(,"СформироватьСтрокуДопИнфоПоШаблону", ДопСведения);
	Иначе
		content.AdditionalInfo = ДопСведения;
	КонецЕсли;
	
	TotalParcelsQuantity 	= 0;
	TotalGrossQuantity 		= 0;
	TotalMassQuantity		= 0;
	TotalWithVatExcluded 	= 0;
	Total 					= 0;
	Vat 					= 0;
	
	СтруктураItems=	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_Torg12Item");
	ЕстьСтрокиСНДС = Ложь;
	
	Для каждого СтрокаТаблицы из ТаблицаТоваров Цикл 
		
		Item = СкопироватьСтруктуру(СтруктураItems);
		
		Item.Product =		СтрокаТаблицы.НоменклатураПредставление;
		Item.ProductCode =	СтрокаТаблицы.КодНоменклатуры;
		Item.UnitCode = 		МетодСервера(, "Item_UnitCode", СтрокаТаблицы.ЕдиницаИзмерения, СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
		Item.UnitName =		Строка(СтрокаТаблицы.ЕдиницаИзмерения);
		Item.Quantity =		СтрокаТаблицы.Количество;
		Item.TaxRate =		ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
		
		Если Не МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			ЕстьСтрокиСНДС = Истина;	
		КонецЕсли;
		
		Item.Vat=			СтрокаТаблицы.СуммаНДС;
		Item.Total = СтрокаТаблицы.СуммаСНДС;
		Item.TotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		Item.Price = Окр(СтрокаТаблицы.Цена, 2);
		
		Item.СсылкаНаЕИ= 	СтрокаТаблицы.ЕдиницаИзмерения;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КоличествоМест) Тогда
			Item.ParcelsQuantity =	СтрокаТаблицы.КоличествоМест;
			Item.ParcelCapacity =	СтрокаТаблицы.КоличествоВОдномМесте;
			Item.ParcelType =		?(ЗначениеЗаполнено(СтрокаТаблицы.ВидУпаковки), СтрокаТаблицы.ВидУпаковки.Наименование, "");
			Item.GrossQuantity =		СтрокаТаблицы.Масса;
			TotalGrossQuantity = 	TotalGrossQuantity + ?(ЗначениеЗаполнено(Item.GrossQuantity), Item.GrossQuantity, 0);
			TotalParcelsQuantity =	TotalParcelsQuantity + Item.ParcelsQuantity;
		КонецЕсли;	
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.items.Добавить(Item);
		
		TotalMassQuantity = 		TotalMassQuantity + Item.Quantity;
		TotalWithVatExcluded =	TotalWithVatExcluded + Item.TotalWithVatExcluded;
		Total = 					Total + Item.Total;
		Vat = 					Vat + Item.Vat;
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			Item.Vat = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Content.Totals.ParcelsQuantity 		= TotalParcelsQuantity;
	Content.Totals.GrossQuantity 		= TotalGrossQuantity;
	Content.Totals.Quantity 			= TotalMassQuantity;
	Content.Totals.TotalWithVatExcluded = TotalWithVatExcluded;
	Content.Totals.Total 				= Total;
	Content.Totals.Vat 					= ?(ЕстьСтрокиСНДС, Vat, Неопределено);
	
	Content.SupplyDate 					= Content.Date; 
	
	Content.commons.TotalSumInWords = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ДанныеШапки.СуммаДокумента, ДанныеШапки.ВалютаДокумента);
	Если ЗначениеЗаполнено(TotalParcelsQuantity) Тогда
		Content.commons.TotalParcelsQuantityInWords
			= СтрЗаменить(ЧислоПрописью(TotalParcelsQuantity, "ДП = Ложь"), "  00", "");
	КонецЕсли;	
	
	ФИОСогласователя = "";
	
	ДолжностьСогласователя = "";
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОСогласователя 		= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
			ДолжностьСогласователя 	= ПараметрыОтправкиНаСогласование.ДолжностьПодписанта;
		Иначе
			Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПолучателя) Тогда 
				ФИОСогласователя 	= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			КонецЕсли;
			ДолжностьСогласователя 	= ПараметрыОтправкиНаСогласование.ДолжностьПолучателя;
		КонецЕсли;
	КонецЕсли;	
					
	Если ФИОСогласователя = ""  Тогда
		ПараметрыПодписания = МетодСервера(,"ПолучитьПараметрыПодписанияТ12вДиадок", ДанныеШапки.Организация);
		
		Если ПараметрыПодписания.СпособПодписания = "4" Тогда
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyPerformedBy,	МетодСервера(,"ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyAllowedBy, 	МетодСервера(,"ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
			
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.ChiefAccountant,	МетодСервера(,"ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		ИначеЕсли параметрыПодписания.СпособПодписания = "2" Тогда 
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.ChiefAccountant,  МетодСервера(,"ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		ИначеЕсли параметрыПодписания.СпособПодписания = "3" Тогда
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyPerformedBy,  МетодСервера(,"ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		Иначе	
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyAllowedBy,  МетодСервера(,"ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		КонецЕсли;
		
	Иначе 
		МетодСервера(,"ЗаполнитьФИОПодписанта", Content.SupplyAllowedBy, ФИОСогласователя);
		Content.SupplyAllowedBy.JobTitle = СокрЛП(?(НЕ ПустаяСтрока(ДолжностьСогласователя), ДолжностьСогласователя, "_"));
	КонецЕсли;
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlAcceptanceCertificate(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров	 = ПолучитьДанныеТЧ(ДокСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date = ДатаНомер.ДатаДокумента;
	
	//поставщик: организация-продавец
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеШапки.Организация, ДатаНомер.ДатаДокумента, ДанныеШапки.БанковскийСчетОрганизации, Истина);
	
	ПредставлениеИсполнителя = СформироватьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Организация, ДатаНомер.ДатаДокумента);
	ПредставлениеЗаказчика   = СформироватьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента);
	
	СтруктураДоговора = СтруктурированноеПредставлениеОснования(ДокСсылка);
	
	НомерДоговора = ?(СтруктураДоговора.GroundNumber = "", "", " по договору № " + СтруктураДоговора.GroundNumber);
	ДатаДоговора = ?(СтруктураДоговора.GroundDate = Дата(1, 1, 1), "", " от " + Формат(СтруктураДоговора.GroundDate, "ДФ=dd.MM.yyyy"));
	ДатаДоговора = ?((СтруктураДоговора.GroundNumber = "" и СтруктураДоговора.GroundDate <> Дата(1, 1, 1)), " по договору " + ДатаДоговора, ДатаДоговора);
	
	текстАкта = "Мы, нижеподписавшиеся, представитель " + ПредставлениеИсполнителя + " (далее «Исполнитель»), с одной стороны, и представитель " + ПредставлениеЗаказчика + " (далее «Заказчик»), с другой стороны," +
	" составили настоящий акт о том, что «Исполнитель» выполнил, а  «Заказчик» принял следующие работы (услуги)" + НомерДоговора + ДатаДоговора + ":";
	
	content.Title  = текстАкта;
	
	ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ИдКонтрагента = МетодСервера(, "Контрагент_2_CounteragentBoxID", ДанныеШапки.Контрагент);
	Если МетодСервера(,"НужноФормироватьДопИнфоПоШаблону", ИдКонтрагента) = Истина Тогда
		content.AdditionalInfo = МетодСервера(, "СформироватьСтрокуДопИнфоПоШаблону", ДопСведения);
	Иначе
		content.AdditionalInfo = ДопСведения;
	КонецЕсли;
	
	content.SignatureDate=	content.Date;
	
	СтруктураItems= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AcceptanceCertificateItem");
	
	Для каждого СтрокаТаблицы из ТаблицаТоваров Цикл 
		
		Item= СкопироватьСтруктуру(СтруктураItems);
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) = Ложь
			ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.КодЕдиницыИзмерения) = Ложь Тогда
			Item.Description= СтрокаТаблицы.НоменклатураПредставление;
		Иначе
			Item.Name= СтрокаТаблицы.НоменклатураПредставление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			Item.UnitCode= МетодСервера(, "Item_UnitCode", СтрокаТаблицы.ЕдиницаИзмерения, СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
			Если Item.UnitCode = "" И ЗначениеЗаполнено(Item.Name) Тогда
				Item.Description= 	Item.Name;
				Item.Name= 			Неопределено;
			КонецЕсли;
		Иначе
			Item.UnitCode= "";
		КонецЕсли;
							
		Item.UnitName = Строка(СтрокаТаблицы.ЕдиницаИзмерения);
		Если ЗначениеЗаполнено(Item.Name) Тогда
			Item.Quantity = СтрокаТаблицы.Количество;
		КонецЕсли;
		Item.Vat=			СтрокаТаблицы.СуммаНДС;
		Item.Total = СтрокаТаблицы.СуммаСНДС;
		Item.TotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		Item.Price = Окр(СтрокаТаблицы.Цена, 2);
		Item.СсылкаНаЕИ= 	СтрокаТаблицы.ЕдиницаИзмерения;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.items.Добавить(Item);
		
	КонецЦикла;
	
	ПараметрыПодписания = МетодСервера(,"ПолучитьПараметрыПодписанияТ12вДиадок", ДанныеШапки.Организация);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ПараметрыПодписания.ФИОПодписанта 		= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
			ПараметрыПодписания.ДолжностьПодписанта = ПараметрыОтправкиНаСогласование.ДолжностьПодписанта;
		Иначе
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			ПараметрыПодписания.ФИОПодписанта 		= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			ПараметрыПодписания.ДолжностьПодписанта = ПараметрыОтправкиНаСогласование.ДолжностьПолучателя;
		КонецЕсли;
	КонецЕсли;
	
	МетодСервера(, "ЗаполнитьПодписантаДляXmlTorg12", content.Official, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", параметрыПодписания));
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентInvoice(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати = СформироватьДанныеДляПечати(ДокСсылка, Ложь);
	
	ДатаНомер = ДанныеДляПечати.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеДляПечати.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.InvoiceRevisionNumber = ДатаНомер.НомерИсправления;
		Content.InvoiceRevisionDate = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	СтруктураPaymentDocuments =	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_PaymentDocument");
	
	Для Каждого ПРД Из ДанныеДляПечати.ДатаНомерДокументовОплаты Цикл
		
		PaymentDocumentContent = СкопироватьСтруктуру(СтруктураPaymentDocuments);
		
		PaymentDocumentContent.Number = ПРД.НомерПлатежноРасчетногоДокумента;
		PaymentDocumentContent.date   = ПРД.ДатаПлатежноРасчетногоДокумента;
		
		Content.PaymentDocuments.Добавить(PaymentDocumentContent);
		
	КонецЦикла;
	
	Content.currency = ?(ЗначениеЗаполнено(ДанныеДляПечати.ВалютаДокумента), Строка(ДанныеДляПечати.ВалютаДокументаКод), "");
	Content.ВалютаСсылка = ДанныеДляПечати.ВалютаДокумента;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеДляПечати.Контрагент, ДатаНомер.ДатаДокумента, , Истина, Истина);
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КонтрагентКПП;
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеДляПечати.Организация, ДатаНомер.ДатаДокумента, , Истина, Истина, ДанныеДляПечати.ГрузоотправительКПП);
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель) Тогда  
		ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(Content.Shipper, ДанныеДляПечати.Грузоотправитель, ДатаНомер.ДатаДокумента);
		Content.Shipper.SameAsSellerOrBuyer = Ложь;
	Иначе 
		Content.Shipper.SameAsSellerOrBuyer = Истина;
	КонецЕсли;
	
	Грузополучатель = ?(ЗначениеЗаполнено(ДанныеДляПечати.Грузополучатель), ДанныеДляПечати.Грузополучатель, ДанныеДляПечати.Контрагент);
	ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(Content.Consignee, Грузополучатель, ДатаНомер.ДатаДокумента, ДанныеДляПечати.АдресДоставки);
	Content.Consignee.SameAsSellerOrBuyer = Ложь;
	
	МетодСервера(,"ЗаполнитьStructedAdditionalInfos", Content.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);

	СтруктураItemInvoice=	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItem");

	Vat= 0;
	TotalWithVatExcluded= 0;
	Total= 0;
	Для каждого Стр из ДанныеДляПечати.ТабличнаяЧасть Цикл
		
		Item= СкопироватьСтруктуру(СтруктураItemInvoice);
		
		Item.Product=	Стр.НоменклатураПредставление;
		
		Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Item.UnitCode= МетодСервера(, "Item_UnitCode", Стр.ЕдиницаИзмерения, СокрЛП(Стр.КодЕдиницыИзмерения));
		Иначе
			Item.UnitCode= "";
		КонецЕсли;
							
		Item.ЕдиницаИзмеренияСсылка= Стр.ЕдиницаИзмерения;
		Item.Quantity= 	?(ЗначениеЗаполнено(Стр.ЕдиницаИзмерения), Стр.Количество, 0);
		Если Не СчетФактуранаАванс(ДокСсылка) Тогда
			Item.TotalWithVatExcluded= Стр.СуммаБезНДС;
			Item.price= Строка(Окр(Стр.Цена, Точность));
		КонецЕсли;
		
		Если Не МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
			Item.Vat = Стр.СуммаНДС;
		КонецЕсли;
		
		Item.Total = Стр.СуммаСНДС;
		Item.TaxRate = ПредставлениеСтавкиНДС(Стр.СтавкаНДС);
		Item.CountriesOfOrigin= 		?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), Стр.СтранаПроисхождения.Код, "");
		Item.СтранаПроисхожденияСсылка= ?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), Стр.СтранаПроисхождения, Справочники.СтраныМира.ПустаяСсылка());
		Item.CustomsDeclarationNumbers= ?(ЗначениеЗаполнено(Стр.НомерГТД), ?(ТипЗнч(Стр.НомерГТД) = Тип("Строка"), СокрЛП(Стр.НомерГТД), СокрЛП(Стр.НомерГТД.Код)), "");
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, Стр);
		
		Content.items.Добавить(Item);
		
		Vat=					Vat 					+ Стр.СуммаНДС;
		TotalWithVatExcluded= 	TotalWithVatExcluded	+ Item.TotalWithVatExcluded;
		Total= 					Total 					+ Item.Total;
	КонецЦикла;	
	
	Content.Totals.Vat 					= Vat;
	Content.Totals.TotalWithVatExcluded = TotalWithVatExcluded;
	Content.Totals.Total 				= Total;
	
	стПодписант = МетодСервера(, "СформироватьПараметрыПодписанта", ПараметрыФормирования.ФИОПодписанта);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПодписанта;
		Иначе	
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПолучателя;
		КонецЕсли;
		
		ПодписантФамилия=				ВыделитьСлово(ФИОПолучателя);
		ПодписантИмя= 					ВыделитьСлово(ФИОПолучателя);
		ПодписантОтчество= 				ВыделитьСлово(ФИОПолучателя);
		
		стПодписант.ПодписантФамилия=	?(НЕ ПустаяСтрока(ПодписантФамилия), ПодписантФамилия, " ");
		стПодписант.ПодписантИмя= 		?(НЕ ПустаяСтрока(ПодписантИмя), ПодписантИмя, " ");
		стПодписант.ПодписантОтчество= 	?(НЕ ПустаяСтрока(ПодписантОтчество), ПодписантОтчество, "");
		
	КонецЕсли;
					
	Content.Signer.Surname 		= стПодписант.ПодписантФамилия;
	Content.Signer.FirstName 	= стПодписант.ПодписантИмя;
	Content.Signer.Patronymic 	= стПодписант.ПодписантОтчество;
	Content.Signer.Inn 			= Content.seller.inn;
	Content.Signer.IsSoleProprietor	= Content.seller.IsSoleProprietor;
	Content.Signer.SoleProprietorRegistrationCertificate = ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляПечати.Организация);
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеДляПечати);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентInvoiceCorrection(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати 	= СформироватьДанныеДляПечати(ДокСсылка, Истина);
	
	ДатаНомер = ДанныеДляПечати.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеДляПечати.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.InvoiceCorrectionNumber = ДатаНомер.НомерДокумента;
	Content.InvoiceCorrectionDate = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber = ДатаНомер.НомерИсправления;
		Content.RevisionDate = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	ДанныеОснований = ДатаНомер.ДатаНомерДокументовОснований;
	
	Если ЗначениеЗаполнено(ДанныеОснований) Тогда
		
		ДанныеОснования = ДанныеОснований[0];
		
		OriginalInvoices = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_OriginalInvoice");
		OriginalInvoices.Number	 = ДанныеОснования.НомерИсходногоДокумента;
		OriginalInvoices.Date	 = ДанныеОснования.ДатаИсходногоДокумента;
		
		Если ДанныеОснования.УчитыватьИсправлениеИсходногоДокумента Тогда
			OriginalInvoices.InvoiceRevisionNumber	 = ДанныеОснования.НомерИсправленияИсходногоДокумента;
			OriginalInvoices.InvoiceRevisionDate	 = ДанныеОснования.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
		
		Content.OriginalInvoices.Добавить(OriginalInvoices);
	
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеДляПечати.Контрагент, ДатаНомер.ДатаДокумента, , Истина, Истина);
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КонтрагентКПП;
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller,  ДанныеДляПечати.Организация, ДатаНомер.ДатаДокумента, , Истина, Истина, ДанныеДляПечати.ГрузоотправительКПП);
	
	content.currency = ?(ЗначениеЗаполнено(ДанныеДляПечати.ВалютаДокумента), Строка(ДанныеДляПечати.ВалютаДокументаКод), "");
	content.ВалютаСсылка = ДанныеДляПечати.ВалютаДокумента;
	
	МетодСервера(, "ЗаполнитьStructedAdditionalInfos", Content.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);

	СтруктураItemInvoiceCorrection= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceCorrectionItem");

	Для Каждого СтрокаДанных Из ДанныеДляпечати.ТабличнаяЧасть Цикл 
		
		Item= СкопироватьСтруктуру(СтруктураItemInvoiceCorrection);
		Item.AmountsDec= 		МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.AmountsInc= 		МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.OriginalValues= 	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		Item.CorrectedValues= 	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		
		Item.Product	= СтрокаДанных.НоменклатураПредставление;
		Item.VendorCode = СтрокаДанных.КодНоменклатуры;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения) Тогда
			Item.OriginalValues.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаДанных.ЕдиницаИзмеренияДоИзменения, СокрЛП(СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Код));
		Иначе
			Item.OriginalValues.UnitCode = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
			Item.CorrectedValues.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаДанных.ЕдиницаИзмерения, СокрЛП(СтрокаДанных.ЕдиницаИзмерения.Код));
		Иначе
			Item.CorrectedValues.UnitCode = "";	
		КонецЕсли;
							
		Item.OriginalValues.ЕдиницаИзмеренияСсылка = 	СтрокаДанных.ЕдиницаИзмеренияДоИзменения;
		Item.CorrectedValues.ЕдиницаИзмеренияСсылка = 	СтрокаДанных.ЕдиницаИзмерения;
		
		Item.OriginalValues.Quantity = 	СтрокаДанных.КоличествоДоИзменения;
		Item.CorrectedValues.Quantity = 	СтрокаДанных.Количество;
		
		Item.OriginalValues.TotalWithVatExcluded =	СтрокаДанных.СуммаДоИзменения - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДСДоИзменения, 0);
		Item.CorrectedValues.TotalWithVatExcluded =	СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);
		
		Item.OriginalValues.Price =		Строка(?(Item.OriginalValues.Quantity = 0, 0, Окр(Item.OriginalValues.TotalWithVatExcluded / Item.OriginalValues.Quantity, Точность)));
		Item.CorrectedValues.Price =  	Строка(?(Item.CorrectedValues.Quantity = 0, 0, Окр(Item.CorrectedValues.TotalWithVatExcluded / Item.CorrectedValues.Quantity, Точность)));
		
		СтавкаНДСДоИзменения = СтрокаДанных.СтавкаНДСДоИзменения;
		Если Не ЗначениеЗаполнено(СтавкаНДСДоИзменения) Тогда
			СтавкаНДСДоИзменения = СтрокаДанных.СтавкаНДС;
		КонецЕсли;
		
		Item.OriginalValues.TaxRate = ПредставлениеСтавкиНДС(СтавкаНДСДоИзменения);
		Item.CorrectedValues.TaxRate = ПредставлениеСтавкиНДС(СтрокаДанных.СтавкаНДС);
		
		
		Item.OriginalValues.Vat = 	СтрокаДанных.СуммаНДСДоИзменения;
		Item.CorrectedValues.Vat =	СтрокаДанных.СуммаНДС;
		
		Item.OriginalValues.Total =	СтрокаДанных.СуммаДоИзменения + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДСДоИзменения);
		Item.CorrectedValues.Total = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		
		Content.items.Добавить(Item);
		
	КонецЦикла;	  

	стПодписант = МетодСервера(, "СформироватьПараметрыПодписанта", ПараметрыФормирования.ФИОПодписанта);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПодписанта;
		Иначе
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПолучателя;
		КонецЕсли;
		
		ПодписантФамилия =				ВыделитьСлово(ФИОПолучателя);
		ПодписантИмя = 					ВыделитьСлово(ФИОПолучателя);
		ПодписантОтчество = 				ВыделитьСлово(ФИОПолучателя);
		стПодписант.ПодписантФамилия =	?(НЕ ПустаяСтрока(ПодписантФамилия), ПодписантФамилия, " ");
		стПодписант.ПодписантИмя = 		?(НЕ ПустаяСтрока(ПодписантИмя), ПодписантИмя, " ");
		стПодписант.ПодписантОтчество = 	?(НЕ ПустаяСтрока(ПодписантОтчество), ПодписантОтчество, "");
		
	КонецЕсли;	
					
	Content.Signer.Surname 		= стПодписант.ПодписантФамилия;
	Content.Signer.FirstName 	= стПодписант.ПодписантИмя;
	Content.Signer.Patronymic 	= стПодписант.ПодписантОтчество;
	Content.Signer.Inn 			= Content.seller.inn;
	Content.Signer.IsSoleProprietor	= Content.seller.IsSoleProprietor;
	Content.Signer.SoleProprietorRegistrationCertificate = ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляПечати.Организация);	
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеДляПечати);
	
КонецПроцедуры

