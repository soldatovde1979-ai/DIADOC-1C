Функция ЭтоСчетФактура(СсылкаНаОбъект)
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	Результат = (ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный"));
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьДокументыОснованияВСлужебнуюИнформацию(Контент)
	
	СсылкаНаОбъект = Контент.СлужебнаяИнформация.Ссылка;
	
	Если Не ЭтоСчетФактура(СсылкаНаОбъект)
		Или СчетФактураНаАванс(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыОснования = ВсеДокументыОснования(СсылкаНаОбъект);
	Контент.СлужебнаяИнформация.Вставить("ДокументыОснования", ДокументыОснования);
	
КонецПроцедуры

Функция ВсеДокументыОснования(СсылкаНаОбъект)
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ИмяДокумента = МетаданныеОбъекта.Имя;
	
	ИмяМетаданныхТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Результат = Новый Массив;
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ИмяМетаданныхТаблицыОснований) Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ПолноеИмяТаблицы = СтрЗаменить("Документ.%ИмяДокумента%.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.ДокументОснование);
		КонецЦикла;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ДокументОснование") Тогда
		
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		Результат.Добавить(Основание);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет реквизиты шапки счета-фактуры значениями реквизитов документа-основания.
// Для печати счета-фактуры многие реквизиты берутся из его документа-основания.
//
// Параметры:
//  ДанныеСчетаФактуры - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеСчетаФактуры)
	
	СсылкаНаОбъект = ДанныеСчетаФактуры.ОписаниеДокумента.Ссылка;
	
	Если Не ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеДокументаОснования = ДанныеШапки(СсылкаНаОбъект.ДокументОснование);
	
	КопируемыеРеквизиты = Новый Массив;
	КопируемыеРеквизиты.Добавить("Контрагент");
	КопируемыеРеквизиты.Добавить("Организация");
	КопируемыеРеквизиты.Добавить("Грузополучатель");
	КопируемыеРеквизиты.Добавить("Грузоотправитель");
	КопируемыеРеквизиты.Добавить("ВалютаДокумента");
	КопируемыеРеквизиты.Добавить("ВалютаДокументаКод");
	КопируемыеРеквизиты.Добавить("АдресДоставки");
	КопируемыеРеквизиты.Добавить("БанковскийСчетОрганизации");
	КопируемыеРеквизиты.Добавить("БанковскийСчетКонтрагента");
	
	Для Каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл 
		
		РеквизитОснования = ДанныеДокументаОснования[ИмяРеквизита];
		Если ЗначениеЗаполнено(РеквизитОснования) Тогда
			ДанныеСчетаФактуры.Вставить(ИмяРеквизита, РеквизитОснования);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаНаименованиеКонтрагента(ИмяПоляКонтрагент)
	
	ТекстЗапроса =	"ВЫБОР
					|	КОГДА %1.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
					|		ТОГДА %1.ЮридическоеФизическоеЛицо.НаименованиеПолное
					|	ИНАЧЕ %1.ЮридическоеФизическоеЛицо.Наименование
					|КОНЕЦ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%1", ИмяПоляКонтрагент);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьСведенияОЮрФизЛице(ЮрФизЛицо, БанковскийСчет = Неопределено)
	
	СтруктураСведений = Новый Структура(
	"Представление, ПолноеНаименование, СокращенноеНаименование, НаименованиеДляПечатныхФорм, ФИОПБОЮЛ,
	|КодПоОКПО, ИНН, КПП, Телефоны, ЮридическийАдрес, Банк, БИК, КоррСчет, НомерСчета, АдресБанка, Факс");
	
	Если НЕ ЗначениеЗаполнено(ЮрФизЛицо) Тогда
		Возврат СтруктураСведений;
	КонецЕсли;
	
	ЗапросПоОсновнымСведениям =	Новый Запрос;
	ЗапросПоОсновнымСведениям.Текст =
	//{
	"ВЫБРАТЬ
	|	Организации.Представление КАК Наименование,
	|	Организации.НаименованиеПолное КАК ПолноеНаименование,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КПП КАК КПП,
	|	Организации.КодОКПО КАК КодПоОКПО,
	|	Организации.НаименованиеСокращенное КАК СокращенноеНаименование,
	|	ВЫБОР
	|		КОГДА Организации.ИспользоватьВПлатежныхДокументахСокращенноеНаименование
	|			ТОГДА Организации.НаименованиеСокращенное
	|		ИНАЧЕ Организации.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеДляПечатныхФорм,
	|	Организации.НаименованиеПолное КАК ИндивидуальныйПредприниматель,
	|	Организации.СвидетельствоСерияНомер КАК СвидетельствоСерияНомер,
	|	Организации.СвидетельствоДатаВыдачи КАК СвидетельствоДатаВыдачи,
	|	Организации.Ссылка КАК ИсточникКонтактнойИнформации,
	|	ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации) КАК ВидыКонтактнойИнформацииЮрАдрес,
	|	ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресОрганизации) КАК ВидыКонтактнойИнформацииФактАдрес,
	|	ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации) КАК ВидыКонтактнойИнформацииТелефон,
	|	ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФаксОрганизации) КАК ВидыКонтактнойИнформацииФакс
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &ЮрФизЛицо
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагенты.Представление,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		ИНАЧЕ Контрагенты.Наименование
	|	КОНЕЦ,
	|	Контрагенты.ЮридическоеФизическоеЛицо.ИНН,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.КодОКПО
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	Контрагенты.НаименованиеСокращенное,
	|	Контрагенты.НаименованиеСокращенное,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	"""",
	|	"""",
	|	Контрагенты.ЮридическоеФизическоеЛицо.Ссылка,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагенты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица)
	|	КОНЕЦ,
	|	""""
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &ЮрФизЛицо";
	//}
	
	ЗапросПоОсновнымСведениям.УстановитьПараметр("ЮрФизЛицо",			ЮрФизЛицо);
	
	РезультатЗапросаПоОсновнымСвдениям =	ЗапросПоОсновнымСведениям.Выполнить();
	
	Если НЕ РезультатЗапросаПоОсновнымСвдениям.Пустой() Тогда
		
		Выборка =	РезультатЗапросаПоОсновнымСвдениям.Выбрать();
		Выборка.Следующий();
		
		Если НЕ ЗначениеЗаполнено(Выборка.ПолноеНаименование) Тогда
			СтруктураСведений.Вставить("ПолноеНаименование", 		СокрЛП(Выборка.Наименование));
		Иначе
			СтруктураСведений.Вставить("ПолноеНаименование",		СокрЛП(Выборка.ПолноеНаименование));
		КонецЕсли;
		
		СтруктураСведений.Вставить("СокращенноеНаименование", 		СокрЛП(Выборка.СокращенноеНаименование));
		СтруктураСведений.Вставить("НаименованиеДляПечатныхФорм", 	СокрЛП(Выборка.НаименованиеДляПечатныхФорм));
		СтруктураСведений.Вставить("Представление",	 				СокрЛП(Выборка.Наименование));
		СтруктураСведений.Вставить("ФИОПБОЮЛ", 						"");
		СтруктураСведений.Вставить("ИНН", 							Выборка.ИНН);
		СтруктураСведений.Вставить("КодПоОКПО", 					Выборка.КодПоОКПО);
		СтруктураСведений.Вставить("КПП", 							Выборка.КПП);
		
		Если НЕ ПустаяСтрока(Выборка.СвидетельствоСерияНомер) Тогда
			СтруктураСведений.Вставить("Свидетельство",	"свидетельство " + СокрЛП(Выборка.СвидетельствоСерияНомер) 
			+ " от " + Формат(Выборка.СвидетельствоДатаВыдачи, "ДЛФ=D"));
		Иначе
			СтруктураСведений.Вставить("Свидетельство",	"");
		КонецЕсли;
		
		Попытка
			ЮридическийАдрес =	УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(Выборка.ИсточникКонтактнойИнформации, Выборка.ВидыКонтактнойИнформацииЮрАдрес);
		Исключение
			ЮридическийАдрес =	УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.ИсточникКонтактнойИнформации, Выборка.ВидыКонтактнойИнформацииЮрАдрес);
		КонецПопытки;
		СтруктураСведений.Вставить("ЮридическийАдрес", ЮридическийАдрес);
		
		Попытка
			ФактическийАдрес =	УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(Выборка.ИсточникКонтактнойИнформации, Выборка.ВидыКонтактнойИнформацииФактАдрес);
		Исключение
			ФактическийАдрес =	УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.ИсточникКонтактнойИнформации, Выборка.ВидыКонтактнойИнформацииФактАдрес);
		КонецПопытки;
		СтруктураСведений.Вставить("ФактическийАдрес", ФактическийАдрес);
		
		Попытка
			Телефоны =			УправлениеКонтактнойИнформацией.ПолучитьКонтактнуюИнформацияОбъекта(Выборка.ИсточникКонтактнойИнформации, Выборка.ВидыКонтактнойИнформацииТелефон);
		Исключение
			Телефоны =			УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Выборка.ИсточникКонтактнойИнформации, Выборка.ВидыКонтактнойИнформацииТелефон);
		КонецПопытки;
		СтруктураСведений.Вставить("Телефоны", Телефоны);
		
		СтруктураСведений.Вставить("Факс", "");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет =	ПолучитьБанковскийСчетПоУмолчанию(ЮрФизЛицо);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		РеквизитыСчета = Новый Структура("Банк, БИК, КоррСчет, НомерСчета", "Банк", "БИК", "КоррСчет", "СчетНомер");
		Если ТипЗнч(БанковскийСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(БанковскийСчет, БанковскийСчет, РеквизитыСчета, Истина);
	    Иначе
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(БанковскийСчет.Владелец, БанковскийСчет, РеквизитыСчета, Истина);
		КонецЕсли;
	Иначе
		РеквизитыСчета = Новый Структура("Банк, БИК, КоррСчет, НомерСчета");
	КонецЕсли;
	
	СтруктураСведений.Вставить("БИК",			РеквизитыСчета.БИК);
	СтруктураСведений.Вставить("Банк",			РеквизитыСчета.Банк);
	СтруктураСведений.Вставить("КоррСчет",		РеквизитыСчета.КоррСчет);
	СтруктураСведений.Вставить("НомерСчета",	РеквизитыСчета.НомерСчета);
	
	Если МетодСервера(, "ЕстьРеквизитИлиСвойствоОбъектаЛок", ЮрФизЛицо, "СтранаРегистрации") Тогда
		СтруктураСведений.Вставить("СтранаРегистрации", ЮрФизЛицо.СтранаРегистрации);
	КонецЕсли;
	
	Возврат СтруктураСведений;
	
КонецФункции

// Параметры:
//  Организация		 - СправочникСсылка.Организации - организация, для которой необходимо получить 
//													  настройку модуля "ПодставлятьКППГрузоотправителя"
//  Грузоотправитель - СправочникСсылка.Организации или СправочникСсылка.Контрагенты
//
Функция КППГрузоотправителя(Организация, Грузоотправитель)
	
	Результат = "";
	
	ПодставлятьКППГрузоотправителя = МетодСервера(,	"ПолучитьЗначениеСвойства", Организация, 
	МетодСервера(, "ИдентификаторСвойстваПодставлятьКППГрузоотправителя"));
	
	Если ПодставлятьКППГрузоотправителя = Истина И ЗначениеЗаполнено(Грузоотправитель)
		И ТипЗнч(Грузоотправитель.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
		КППГрузоотправителя = ?(ЗначениеЗаполнено(Грузоотправитель.ЮридическоеФизическоеЛицо.КПП), Грузоотправитель.ЮридическоеФизическоеЛицо.КПП, "");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

