// См. метод "ПередФормированиемПечатнойФормыСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- см. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.СчетНаОплату");
							
	НовыйЭлементТаблицы = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета 	= "Счет";
	НовыйЭлементТаблицы.ИмяВРЕГ 	= ВРег(НовыйЭлементТаблицы.ИмяМакета);
	
КонецПроцедуры //ПередФормированиемПечатнойФормыСчетаНаОплату()

// См. метод "ПриЗаполненииМетыНеформализованногоСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  СчетНаОплату	- ДокументСсылка	- документ, на основании которого формируем печатную форму
//  Мета			- Структура			- см. метод "НовыйРезультатВизуализацииСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Мета) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	    "ВЫБРАТЬ
		| СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС,
		| МАКСИМУМ(ВложенныйЗапрос.ЕстьСтавкиСНДС) КАК ЕстьСтавкиСНДС
		|ИЗ(
		|ВЫБРАТЬ
		|	СУММА(ТабличнаяЧастьДокумента.СуммаНДС) КАК СуммаНДС,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТабличнаяЧастьДокумента.СтавкаНДС <> &Ставка_БезНДС
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьСтавкиСНДС
		|ИЗ
		|	Документ.СчетНаОплату.Услуги КАК ТабличнаяЧастьДокумента
		|ГДЕ
		|	ТабличнаяЧастьДокумента.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СУММА(ТабличнаяЧастьДокумента.СуммаНДС),
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТабличнаяЧастьДокумента.СтавкаНДС <> &Ставка_БезНДС
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ)
		|ИЗ
		|	Документ.СчетНаОплату.Материалы КАК ТабличнаяЧастьДокумента
		|ГДЕ
		|	ТабличнаяЧастьДокумента.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СУММА(ТабличнаяЧастьДокумента.СуммаНДС),
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТабличнаяЧастьДокумента.СтавкаНДС <> &Ставка_БезНДС
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ)
		|ИЗ
		|	Документ.СчетНаОплату.ОсновныеСредства КАК ТабличнаяЧастьДокумента
		|ГДЕ
		|	ТабличнаяЧастьДокумента.Ссылка = &Ссылка) КАК ВложенныйЗапрос";
	
	Запрос.УстановитьПараметр("Ссылка", СчетНаОплату);
	Запрос.УстановитьПараметр("Ставка_БезНДС", МенеджерИнтеграции_СтавкаБезНДС());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Мета.СуммаНДС 		= Выборка.СуммаНДС;
		Мета.ДокументБезНДС = НЕ Выборка.ЕстьСтавкиСНДС;
					
	КонецЕсли;
	
	Мета.Сумма = СчетНаОплату.СуммаДокумента;
			
КонецПроцедуры // ПриЗаполненииМетыНеформализованногоСчетаНаОплату()

