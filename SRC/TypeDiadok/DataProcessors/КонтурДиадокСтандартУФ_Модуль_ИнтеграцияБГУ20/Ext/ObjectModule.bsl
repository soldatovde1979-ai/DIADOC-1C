// Формирует структуру с данными, которые необходимы для визуализации ПФ счета на оплату. 
// Табличный документ формируется средствами Диадок
//
// Параметры:
//  ДокСсылка - ДокументСсылка	- документ, на основании которого формируем печатную форму 
// 
// Возвращаемое значение:
//   Структура
//
Функция РезультатВизуализацииСчетаНаОплатуСредствамиДиадок(ДокСсылка, ПараметрыОтправкиНаСогласование =  Неопределено, ФИОПодписанта = "") Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров	 = ПолучитьДанныеТЧ(ДокСсылка, , Неопределено, , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	Таб = Новый ТабличныйДокумент;
	
	Макет	= ОбработкаОбъект.ПолучитьМакет("СчетНаОплату");
	Шапка1	= Макет.ПолучитьОбласть("ШапкаСчета1");			
	
	СведенияОбОрганизации = РеквизитыЮрФизЛица(ДанныеШапки.Организация, , ДанныеШапки.БанковскийСчетОрганизации);
	Если ЗначениеЗаполнено(СведенияОбОрганизации.Банк) Тогда
		Шапка1.Параметры.БанкПолучателя 	 = СведенияОбОрганизации.Банк;
		Шапка1.Параметры.БИКБанкаПолучателя  = СведенияОбОрганизации.БИК;
		Шапка1.Параметры.СчетБанкаПолучателя = СведенияОбОрганизации.КоррСчет;
		Шапка1.Параметры.СчетПолучателя 	 = СведенияОбОрганизации.НомерСчета;
		Шапка1.Параметры.ИННПолучателя 		 = СведенияОбОрганизации.ИНН;
		Шапка1.Параметры.КПППолучателя 		 = СведенияОбОрганизации.КПП;
		Шапка1.Параметры.Получатель 		 = СведенияОбОрганизации.НаименованиеДляПечатныхФорм;
	КонецЕсли;	
	Таб.Вывести(Шапка1);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	
	Шапка2 = Макет.ПолучитьОбласть("ШапкаСчета2");
	Шапка2.Параметры.Заголовок = СтрШаблон("Счет на оплату № %1 от %2",
		ДатаНомер.НомерДокумента,
		Формат(ДатаНомер.ДатаДокумента, "ДФ=dd.MM.yyyy"));
	Таб.Вывести(Шапка2);
	
	ОписаниеОрганизации = ПолучитьОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,ИНН,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет");
	Шапка3 = Макет.ПолучитьОбласть("ШапкаСчета3");
	Шапка3.Параметры.Поставщик = ОписаниеОрганизации;
	Таб.Вывести(Шапка3);
	
	СведенияОбКонтрагенте = РеквизитыЮрФизЛица(ДанныеШапки.Контрагент, , ДанныеШапки.БанковскийСчетКонтрагента);
	
	ОписаниеКонтрагента = ПолучитьОписаниеОрганизации(СведенияОбКонтрагенте, "НаименованиеДляПечатныхФорм,ИНН,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет");
	Шапка4 =  Макет.ПолучитьОбласть("ШапкаСчета4");
	Шапка4.Параметры.Покупатель = ОписаниеКонтрагента;
	Таб.Вывести(Шапка4);
	
	ЕстьСтавкаБезНДС	= Ложь;
	
	ОбластьНомерСтроки 	= Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
	ОбластьКолонкаКодов = Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаКодов");
	ОбластьДанные 		= Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
	ОбластьСкидка		= Макет.ПолучитьОбласть("ШапкаТаблицы|Скидка");
	ОбластьСумма		= Макет.ПолучитьОбласть("ШапкаТаблицы|Сумма");
	
	Таб.Вывести(ОбластьНомерСтроки);
	Таб.Присоединить(ОбластьДанные);
	Таб.Присоединить(ОбластьСумма);
	
	ОбластьКолонкаТовар = Макет.Область("Товар");
	// Делаем по аналогии с типовым механизмом
	ОбластьКолонкаТовар.ШиринаКолонки = ОбластьКолонкаТовар.ШиринаКолонки + Макет.Область("КолонкаКодов").ШиринаКолонки + Макет.Область("Скидка").ШиринаКолонки;
						
	ОбластьНомерСтроки 	= Макет.ПолучитьОбласть("Строка|НомерСтроки");
	ОбластьКолонкаКодов = Макет.ПолучитьОбласть("Строка|КолонкаКодов");
	ОбластьДанные 		= Макет.ПолучитьОбласть("Строка|Данные");
	ОбластьСкидка		= Макет.ПолучитьОбласть("Строка|Скидка");
	ОбластьСумма		= Макет.ПолучитьОбласть("Строка|Сумма");
	
	СуммаВсего 			= 0;
	СуммаВсегоНДС 		= 0;
	НомерПП 			= 0;
				
	Для Каждого Стр Из ТаблицаТоваров Цикл
		
		НомерПП = НомерПП + 1;
		ОбластьНомерСтроки.Параметры.НомерСтроки = НомерПП;
		Таб.Вывести(ОбластьНомерСтроки);
		
		ПараметрыЗаполнения = Новый Структура("Товар, Количество, ЕдиницаИзмерения, Цена", Стр.НоменклатураПредставление, Стр.Количество, Строка(Стр.ЕдиницаИзмерения), Стр.Цена);
		ОбластьДанные.Параметры.Заполнить(ПараметрыЗаполнения);
		Таб.Присоединить(ОбластьДанные);
		
		ОбластьСумма.Параметры.Сумма = Стр.Сумма;
		Таб.Присоединить(ОбластьСумма);
						
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
			ЕстьСтавкаБезНДС = Истина;
		КонецЕсли;
		
		СуммаВсего		= СуммаВсего 		+ Стр.сумма;
		СуммаВсегоНДС	= СуммаВсегоНДС 	+ Стр.СуммаНДС;
				
	КонецЦикла;
	
	ЦенаВключаетНДС = ДанныеШапки.ЦенаВключаетНДС;
	СуммаВсегоСНДС 	= СуммаВсего + ?(ЦенаВключаетНДС, 0, СуммаВсегоНДС);
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Таб.Вывести(Подвал);
							
	ПодвалИтого = Макет.ПолучитьОбласть("ПодвалИтого");
	ПодвалИтого.Параметры.Всего = СуммаВсего; 
	Таб.Вывести(ПодвалИтого);
			
	ПодвалНДС = Макет.ПолучитьОбласть("ПодвалНДС");
	Если СуммаВсегоНДС <> 0 Тогда
		ПодвалНДС.Параметры.НДС = ?(ЦенаВключаетНДС, "В том числе НДС:", "Сумма НДС:");
		ПодвалНДС.Параметры.ВсегоНДС = Формат(СуммаВсегоНДС, "ЧЦ=15; ЧДЦ=2");
	Иначе
		ПодвалНДС.Параметры.НДС = "Без налога (НДС)";
		ПодвалНДС.Параметры.ВсегоНДС = "-";
	КонецЕсли;
	Таб.Вывести(ПодвалНДС);
	
	ПодвалИтого = Макет.ПолучитьОбласть("ПодвалИтогоКОплате");
	ПодвалИтого.Параметры.ИтогоКОплате = СуммаВсегоСНДС;
	Таб.Вывести(ПодвалИтого);
	
	ПодвалСуммаПрописью = Макет.ПолучитьОбласть("ПодвалСуммаПрописью");
	ПодвалСуммаПрописью.Параметры.ИтоговаяСтрока = "Всего наименований " + ТаблицаТоваров.Количество() 
													+ ", на сумму "+ Формат(СуммаВсегоСНДС,"ЧЦ=15; ЧДЦ=2") + " " + СокрП(ДанныеШапки.ВалютаДокумента);
	
    ПодвалСуммаПрописью.Параметры.СуммаПрописью = ЧислоПрописью(СуммаВсегоСНДС, , МетодСервера("ПечатныеФормы", "ПараметрыИсчисленияВалюты", ДанныеШапки.ВалютаДокументаКод));
	Таб.Вывести(ПодвалСуммаПрописью);
	
	ПодвалСчета = Макет.ПолучитьОбласть("ПодвалСчета");
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		ПодвалСчета.Параметры.ФИОРуководителя = ?(ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта), ПараметрыОтправкиНаСогласование.ФИОПодписанта,
												?(ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПолучателя), ПараметрыОтправкиНаСогласование.ФИОПолучателя, "_"));
	Иначе 	
		ПодвалСчета.Параметры.ФИОРуководителя = ФИОПодписанта;
	КонецЕсли;	
	Таб.Вывести(ПодвалСчета);
	
	Результат = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НовыйРезультатВизуализацииСчетаНаОплату");
	
	Результат.Таблица 			= Таб;
	Результат.СписокОшибок 		= "";
	Результат.ИмяФайла			= МетодСервера("Модуль_ИнтеграцияУниверсальный", "ИмяФайлаПечатнойФормы", "Счет №", ДатаНомер.НомерДокумента, ДатаНомер.ДатаДокумента);
	Результат.Дата				= ДатаНомер.ДатаДокумента;
	Результат.Номер				= ДатаНомер.НомерДокумента;
	Результат.Сумма				= СуммаВсегоСНДС;
	Результат.СуммаНДС			= СуммаВсегоНДС;
	Результат.ДокументБезНДС	= ?(ЕстьСтавкаБезНДС И СуммаВсегоНДС = 0, Истина, Ложь);
	
	Возврат Результат;	
	
КонецФункции //РезультатВизуализацииСчетаНаОплатуСредствамиДиадок()

Функция СформироватьМетуСчетаНаОплату(ДокументСсылка) Экспорт
	
	Шапка			 = ДанныеШапки(ДокументСсылка);
	ТабличнаяЧасть	 = ПолучитьДанныеТЧ(ДокументСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	СуммаНДС = ТабличнаяЧасть.Итог("СуммаНДС");
	
	МассивСтрокиБезНДС= ТабличнаяЧасть.НайтиСтроки(Новый Структура("СтавкаНДС", МенеджерИнтеграции_СтавкаБезНДС()));
	Если МассивСтрокиБезНДС.Количество() > 0 Тогда
		ЕстьСтавкаБезНДС= Истина;	
	Иначе 
		ЕстьСтавкаБезНДС= Ложь;
	КонецЕсли;
	
	МетаСчетаНаОплату =	Новый Структура;
	МетаСчетаНаОплату.Вставить("Дата", 		ДатаНомер.ДатаДокумента);
	МетаСчетаНаОплату.Вставить("Номер", 	ДатаНомер.НомерДокумента);
	МетаСчетаНаОплату.Вставить("Сумма", 	Шапка.СуммаДокумента);
	МетаСчетаНаОплату.Вставить("СуммаНДС", 	СуммаНДС);
	МетаСчетаНаОплату.Вставить("ДокументБезНДС", ?(ЕстьСтавкаБезНДС И СуммаНДС = 0, Истина, Ложь)); 
	
	Возврат МетаСчетаНаОплату;
	
КонецФункции

Функция СформироватьМетуАктаВыполненныхРабот(ДокументСсылка) Экспорт
	
	Шапка			 = ДанныеШапки(ДокументСсылка);
	ТабличнаяЧасть	 = ПолучитьДанныеТЧ(ДокументСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	ТабличнаяЧасть.Колонки.Добавить("СуммаБезНДС");
	
	ИтогСумма=			0;
	ИтогСуммаБезНДС=	0;
	ЕстьСтавкаБезНДС= Ложь;
	
	Для каждого Стр Из ТабличнаяЧасть Цикл
		
		СуммаСНДС=		Стр.СуммаСНДС;
		СуммаБезНДС= 	Стр.СуммаБезНДС;
		
		ИтогСумма=			ИтогСумма 		+ Стр.Сумма;
		ИтогСуммаБезНДС=	ИтогСуммаБезНДС + СуммаБезНДС;
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
			ЕстьСтавкаБезНДС= Истина;	
		КонецЕсли;
						
	КонецЦикла;
	
	МетаАктаВыполненныхРабот =	Новый Структура;
	МетаАктаВыполненныхРабот.Вставить("Дата", 	ДатаНомер.ДатаДокумента);
	МетаАктаВыполненныхРабот.Вставить("Номер", 	ДатаНомер.НомерДокумента);
	МетаАктаВыполненныхРабот.Вставить("Сумма", 	Шапка.СуммаДокумента);
	МетаАктаВыполненныхРабот.Вставить("СуммаНДС", ИтогСумма - ИтогСуммаБезНДС);
	МетаАктаВыполненныхРабот.Вставить("ДокументБезНДС", ?(ЕстьСтавкаБезНДС И (ИтогСумма - ИтогСуммаБезНДС) = 0, Истина, Ложь));
	
	Возврат МетаАктаВыполненныхРабот;
	
КонецФункции

Функция СтруктурированноеПредставлениеОснования(ДокСсылка)
	
	ДоговорКонтрагента = ДокСсылка.Договор;
	
	Ground = Новый Структура;
	Ground.Вставить("GroundName", "");
	Ground.Вставить("GroundNumber", "");
	Ground.Вставить("GroundDate", "");
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Ground.Вставить("GroundName", 	ДоговорКонтрагента.Наименование);
		Ground.Вставить("GroundNumber", ДоговорКонтрагента.НомерДоговора);
		Ground.Вставить("GroundDate", 	ДоговорКонтрагента.ДатаДоговора);
	КонецЕсли;
	
	Возврат  Ground;
	
КонецФункции

Функция СтруктурированноеПредставлениеОснованияУПД(ДокументСсылка)
	
	Результат = Новый Структура;
	Результат.Вставить("GroundName", 	"");
	Результат.Вставить("GroundNumber", 	"");
	Результат.Вставить("GroundDate", 	Дата(1, 1, 1));
	
	Результат.Вставить("ОснованиеСсылка");
	Результат.Вставить("ПредставлениеВТекстеОшибки"	, "основании");
	
	Договор	= Неопределено;
	
	Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(ДокументСсылка), "Договор") Тогда 
		Договор = ДокументСсылка.Договор;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) 
		И ТипЗнч(Договор) = Тип("СправочникСсылка.Договоры") Тогда
		
		Результат.GroundName		= "Договор"; 	
		Результат.GroundNumber		= Договор.НомерДоговора;
		Результат.GroundDate		= Договор.ДатаДоговора; 
		Результат.ОснованиеСсылка	= Договор;
		
	КонецЕсли;
	
	Возврат  Результат;
	
КонецФункции

Процедура ЗаполнитьСведенияОПередаче(Content, ДокументСсылка, ФункцияУПД, ДопПараметры)
	
	КоллекцияДокументНосительОснования	= Новый Массив;
	
	ДобавленныеОснования = Новый Массив;
				
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "СЧФ" Тогда
		// в этом случае параметр ДокументСсылка это Счет фактура выданный
		Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактураВыданный.ТабличнаяЧасть.ДокументыОснования") Тогда
			Для Каждого СтрокаТЧ Из ДокументСсылка.ДокументыОснования Цикл
				КоллекцияДокументНосительОснования.Добавить(СтрокаТЧ.ДокументОснование);	
			КонецЦикла;			
		Иначе
			Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(ДокументСсылка), "ДокументОснование") Тогда
				КоллекцияДокументНосительОснования.Добавить(ДокументСсылка.ДокументОснование);
			КонецЕсли;					
		КонецЕсли;
		
	Иначе
		// в этом случае параметр ДокументСсылка это документ реализации
		КоллекцияДокументНосительОснования.Добавить(ДокументСсылка);
	КонецЕсли;
	
	УказыватьОтсутствиеОснованияУПД = СвойствоСтруктуры(ДопПараметры, "УказыватьОтсутствиеОснованияУПД", Ложь);
	
	Для Каждого ДокументМассива Из КоллекцияДокументНосительОснования Цикл
		
		СтруктураОснования = СтруктурированноеПредставлениеОснованияУПД(ДокументМассива);
		
		Если ЗначениеЗаполнено(СтруктураОснования.GroundName) Тогда
			
			Если ДобавленныеОснования.Найти(СтруктураОснования.ОснованиеСсылка) = Неопределено Тогда
				
				ДобавленныеОснования.Добавить(СтруктураОснования.ОснованиеСсылка);
				
				TransferBase = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_TransferBase");
				Content.TransferInfo.TransferBases.Добавить(TransferBase);
				
				Если Не ЗначениеЗаполнено(СтруктураОснования.GroundDate) И УказыватьОтсутствиеОснованияУПД Тогда
					ЗаполнитьTransferBaseКакОтсутствует(TransferBase);
				Иначе
					ЗаполнитьTransferBaseПоДаннымОснования(TransferBase, СтруктураОснования);
				КонецЕсли;
				
				СлужебнаяИнформация = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НоваяСлужебнаяИнформацияОснованияПередачи");
				СлужебнаяИнформация.ОснованиеСсылка				= СтруктураОснования.ОснованиеСсылка;
				СлужебнаяИнформация.ПредставлениеВТекстеОшибки	= СтруктураОснования.ПредставлениеВТекстеОшибки;
				
				ДополнитьКонтентСтрокиОснованийПередачиСлужебнойИнформацией(TransferBase, СлужебнаяИнформация);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДобавленныеОснования.Количество() = 0 Тогда
		
		TransferBase = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_TransferBase");
		Content.TransferInfo.TransferBases.Добавить(TransferBase);
				
		ЗаполнитьTransferBaseКакОтсутствует(TransferBase);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьTransferBaseПоДаннымОснования(TransferBase, СтруктураОснования)
	
	TransferBase.DocumentName	= СтруктураОснования.GroundName;
	TransferBase.DocumentNumber	= СтруктураОснования.GroundNumber;
	TransferBase.DocumentDate	= СтруктураОснования.GroundDate;
	TransferBase.DocumentInfo	= "";
	
КонецПроцедуры

Процедура ЗаполнитьTransferBaseКакОтсутствует(TransferBase)
	
	TransferBase.DocumentName	= МетодСервера("Модуль_ИнтеграцияУниверсальный", "ДокументОснованиеОтгрузкиОтсутствует");
	TransferBase.DocumentNumber	= "";
	TransferBase.DocumentDate	= Дата(1, 1, 1);
	TransferBase.DocumentInfo	= "";

КонецПроцедуры

Процедура ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(OrganizationInfo, ЮрФизЛицо, ДатаДокумента, ПредставлениеАдреса = "")
	
	СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента);
	
	Если стрДлина(СведенияОбОрганизации.ИНН) <> 12 Тогда
		НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		ЭтоИП = Ложь;
	Иначе
		Если типЗнч(юрФизЛицо) = тип("СправочникСсылка.Организации") Тогда
			//для нашей организации - данные берем из нормализованного представления физлица
			НаименованиеОрганизации = юрФизЛицо.наименованиеПолное;
		Иначе
			НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		КонецЕсли;
		
		ЭтоИП = Истина;
		
	КонецЕсли;
	
	OrganizationInfo.Name = НаименованиеОрганизации;
	OrganizationInfo.IsSoleProprietor = ЭтоИП;
	OrganizationInfo.SameAsSellerOrBuyer = Ложь;
	OrganizationInfo.Ссылка = ЮрФизЛицо;
	
	ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address,
		СведенияОбОрганизации, ЮрФизЛицо, Ложь, ДатаДокумента, ПредставлениеАдреса);
	
КонецПроцедуры

Функция ПолучитьГоловноеЮрлицо(ЮрФизЛицо)
	
	ГоловноеЮрЛицо = "";

	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
		ГоловноеЮрЛицо = ЮрФизЛицо.ГоловнаяОрганизация;
	КонецЕсли;
	
	Возврат ГоловноеЮрЛицо;
КонецФункции	

Процедура ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(OrganizationInfo, ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации = Неопределено, ЮрАдрес, АдресДляСФ = Ложь, КППГрузоотправителя = "", ПредставлениеАдреса = "")

	ГоловноеЮрЛицо = "";
	
	Если АдресДляСФ = Истина Тогда
		ГоловноеЮрЛицо = ПолучитьГоловноеЮрлицо(ЮрФизЛицо);
		
		Если ЗначениеЗаполнено(ГоловноеЮрЛицо) Тогда
			СведенияОПодразделении 	= РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации);
			СведенияОбОрганизации	= РеквизитыЮрФизЛица(ГоловноеЮрЛицо, ДатаДокумента, БанковскийСчетОрганизации);
			СведенияОбОрганизации.КПП = СведенияОПодразделении.КПП;
		Иначе
			СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации);
		КонецЕсли;	
	Иначе
		СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации);
	КонецЕсли;

	если стрДлина(СведенияОбОрганизации.ИНН)<>12 Тогда 
		НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		ЭтоИП = Ложь;
	Иначе 
		Если типЗнч(юрФизЛицо) = тип("СправочникСсылка.Организации") Тогда 
			НаименованиеОрганизации  = юрФизЛицо.наименованиеПолное;
		Иначе 
			НаименованиеОрганизации  = СведенияОбОрганизации.ПолноеНаименование 
		КонецЕсли;	  
		ЭтоИП = Истина;
	КонецЕсли;
	
	OrganizationInfo.Name = НаименованиеОрганизации;
	OrganizationInfo.Inn  = СведенияОбОрганизации.ИНН;
	Если ЗначениеЗаполнено(КППГрузоотправителя) Тогда
		OrganizationInfo.Kpp  = КППГрузоотправителя;
	Иначе
		OrganizationInfo.Kpp  = СведенияОбОрганизации.КПП;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГоловноеЮрЛицо) Тогда
		ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address, СведенияОбОрганизации, ГоловноеЮрЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса);
	Иначе
		ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса);
	КонецЕсли;
	OrganizationInfo.IsSoleProprietor  =  ЭтоИП;

	Если АдресДляСФ = Ложь Тогда
		OrganizationInfo.Okpo  = СведенияОбОрганизации.КодПоОкпо;
		
		Если Найти(СведенияОбОрганизации.Телефоны, "факс:") > 0 Тогда
			телефон = СокрЛП(Лев(СведенияОбОрганизации.Телефоны, Найти(СведенияОбОрганизации.Телефоны, "факс:") - 1));
			Если прав(телефон, 1) = ","  Тогда
				телефон = Лев(телефон, стрДлина(телефон) - 1);
			КонецЕсли;
			факс = СокрЛП(прав(СведенияОбОрганизации.Телефоны, СтрДлина(СведенияОбОрганизации.Телефоны) - найти(СведенияОбОрганизации.Телефоны, "факс:") - 5));
		Иначе 
			Телефон = СведенияОбОрганизации.Телефоны;
			Факс = "";
		КонецЕсли;	
		OrganizationInfo.Phone = СократитьПредставлениеТелефона(Телефон);
		OrganizationInfo.Fax   = СократитьПредставлениеТелефона(Факс) ;
		OrganizationInfo.BankAccountNumber = ?(ЗначениеЗаполнено(СведенияОбОрганизации.НомерСчета),  СведенияОбОрганизации.НомерСчета, "") ;
		OrganizationInfo.BankName  =   ?(ЗначениеЗаполнено(СведенияОбОрганизации.Банк), СведенияОбОрганизации.Банк, "");
		OrganizationInfo.BankId =  ?(ЗначениеЗаполнено(СведенияОбОрганизации.БИК), СокрЛП(СведенияОбОрганизации.БИК), "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГоловноеЮрЛицо) Тогда
		OrganizationInfo.вставить("Ссылка", ГоловноеЮрЛицо);
	Иначе
		OrganizationInfo.вставить("Ссылка", ЮрФизЛицо);
	КонецЕсли;

КонецПроцедуры

Процедура Заполнить_ExtendedOrganizationInfo(ExtendedOrganizationInfo, ЮрФизЛицо, ДатаДокумента, ЭтоПродавецИлиПокупатель= Ложь, БанковскийСчет= Неопределено, КППГрузоотправителя = "", ПредставлениеАдреса = "")
	
	ГоловноеЮрЛицо = ПолучитьГоловноеЮрлицо(ЮрФизЛицо);
	
	Если ЗначениеЗаполнено(ГоловноеЮрЛицо) Тогда
		ИспользуемоеЮрФизЛицо = ГоловноеЮрЛицо;
		СведенияОПодразделении = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчет);
		СведенияОбОрганизации = РеквизитыЮрФизЛица(ИспользуемоеЮрФизЛицо, ДатаДокумента, БанковскийСчет);
		СведенияОбОрганизации.КПП = СведенияОПодразделении.КПП;
	Иначе
		ИспользуемоеЮрФизЛицо = ЮрФизЛицо;
		СведенияОбОрганизации = РеквизитыЮрФизЛица(ИспользуемоеЮрФизЛицо, ДатаДокумента, БанковскийСчет);
	КонецЕсли;	
	
	ЭтоОрганизация = ТипЗнч(ИспользуемоеЮрФизЛицо) = Тип("СправочникСсылка.Организации");
	ЭтоИП = СтрДлина(СведенияОбОрганизации.ИНН) = 12;
	
	Если Не ЭтоОрганизация И НЕ ЭтоПродавецИлиПокупатель Тогда
		// для грузополучателя будем указывать именно его полное наименование.
		СведенияОбОрганизации.ПолноеНаименование = ЮрФизЛицо.ЮридическоеФизическоеЛицо.Наименование;
	КонецЕсли;
	
	ExtendedOrganizationInfo.Name = СведенияОбОрганизации.ПолноеНаименование;
	ExtendedOrganizationInfo.Inn = СведенияОбОрганизации.ИНН;
	Если ЗначениеЗаполнено(КППГрузоотправителя) Тогда
		ExtendedOrganizationInfo.Kpp = КППГрузоотправителя;
	Иначе
		ExtendedOrganizationInfo.Kpp = СведенияОбОрганизации.КПП;
	КонецЕсли;
	ExtendedOrganizationInfo.Okpo = СведенияОбОрганизации.КодПоОкпо;
	ExtendedOrganizationInfo.CorrespondentAccount = СведенияОбОрганизации.КоррСчет;
	
	ExtendedOrganizationInfo.BankAccountNumber = СокрЛП(СведенияОбОрганизации.НомерСчета);
	ExtendedOrganizationInfo.BankId = СокрЛП(СведенияОбОрганизации.БИК);
	// в некоторых случаях Банк возвращается как ссылка на справочник и компонента игнорирует такое значение, теряя данные, поэтому значение Банк преобразовано к строке
	ExtendedOrganizationInfo.BankName = ?(ЗначениеЗаполнено(СведенияОбОрганизации.Банк), Строка(СведенияОбОрганизации.Банк), "");
	
	Если найти(СведенияОбОрганизации.Телефоны, "факс:") > 0 Тогда
		телефон = СокрЛП(Лев(СведенияОбОрганизации.Телефоны, Найти(СведенияОбОрганизации.Телефоны, "факс:") - 1));
		Если прав(телефон, 1) = "," Тогда
			телефон = Лев(телефон, стрДлина(телефон) - 1);
		КонецЕсли;
	Иначе
		Телефон = СведенияОбОрганизации.Телефоны;
	КонецЕсли;
	
	ExtendedOrganizationInfo.Phone = СократитьПредставлениеТелефона(Телефон);
	
	Если ЭтоОрганизация Тогда
		ExtendedOrganizationInfo.Okdp = ИспользуемоеЮрФизЛицо.КодОКВЭД;
	КонецЕсли;
	
	Если ЭтоИП Тогда
		ExtendedOrganizationInfo.Type = "IndividualEntity";
		ExtendedOrganizationInfo.IndividualEntityRegistrationCertificate = СведенияОбОрганизации.Свидетельство;
	Иначе
		ExtendedOrganizationInfo.Type = "LegalEntity";
	КонецЕсли;
	
	ExtendedOrganizationInfo.Email = ЮрФизЛицо_АдресЭлектроннойПочты(ИспользуемоеЮрФизЛицо, ДатаДокумента, ЭтоОрганизация);
	
	Если Не ЭтоОрганизация И НЕ ЭтоПродавецИлиПокупатель Тогда
		ЗаполнитьСтруктурированноеОписаниеАдреса(ExtendedOrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, ЭтоПродавецИлиПокупатель, ДатаДокумента, ПредставлениеАдреса);
	Иначе
		ЗаполнитьСтруктурированноеОписаниеАдреса(ExtendedOrganizationInfo.Address, СведенияОбОрганизации, ИспользуемоеЮрФизЛицо, ЭтоПродавецИлиПокупатель, ДатаДокумента, ПредставлениеАдреса);
	КонецЕсли;
	
	ExtendedOrganizationInfo.Вставить("Ссылка", ИспользуемоеЮрФизЛицо);
	
КонецПроцедуры

Функция ЮрФизЛицо_АдресЭлектроннойПочты(ЮрФизЛицо, ДатаДокумента, ЭтоОрганизация)
	
	ВидКИ = ?(ЭтоОрганизация
				, Справочники.ВидыКонтактнойИнформации.EmailОрганизации
				, Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты);
	
	Результат = ПредставлениеКонтактнойИнформацииОбъекта(ЮрФизЛицо, ВидКИ, , ДатаДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция сформироватьДанныеДляПечати(СсылкаНаОбъект, ЭтоКСФ)
	
	ВалютаРегламентированногоУчета  = ВалютаРегламентированногоУчета();

	ЭтоСФ = ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный");
	ЭтоСФНаАванс = СчетФактуранаАванс(СсылкаНаОбъект);

	//сформируем список документов-оснований
	СпДокументовОснований = Новый СписокЗначений;

	Если ЗначениеЗаполнено(СсылкаНаОбъект.ДокументОснование) Тогда 
		СпДокументовОснований.Добавить(СсылкаНаОбъект.ДокументОснование);
	КонецЕсли;
	
	ДанныеДляПечати		 = ДанныеШапки(СсылкаНаОбъект); // Шапку всегда заполняем по переданному объекту
	ДанныеТабличнойЧасти = ПолучитьДанныеТЧ(СпДокументовОснований, ЭтоКСФ,  ВалютаРегламентированногоУчета, , Истина, ?(ЭтоСФ, СсылкаНаОбъект, Неопределено));
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеДляПечати, ДанныеТабличнойЧасти);
	
	Если ДанныеДляПечати.ВалютаДокумента <> ВалютаРегламентированногоУчета ИЛИ ЭтоСФНаАванс Тогда
		//счета-фактуры в уе и на аванс - выставляются только в рублях
		ДанныеДляПечати.ВалютаДокумента		 = ВалютаРегламентированногоУчета;
		ДанныеДляПечати.ВалютаДокументаКод	 = ВалютаРегламентированногоУчета.Код;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляПечати.ВалютаДокумента) Тогда
		ДанныеДляПечати.ВалютаДокументаКод = "";
	КонецЕсли;
	
	ДанныеДляПечати.Вставить("ТабличнаяЧасть", ТаблицаЗначений_2_МассивСтруктур(ДанныеТабличнойЧасти));
	
	//формируем список ПРС
	Запрос = Новый запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПРС.ДатаДокумента КАК ДатаПлатежноРасчетногоДокумента,
	|	ПРС.НомерДокумента КАК НомерПлатежноРасчетногоДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК ПРС
	|ГДЕ
	|	ПРС.Ссылка = &Ссылка
	|	И ПРС.НомерДокумента <> """"
	|	И ПРС.ДатаДокумента <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("Ссылка", ссылкаНаОбъект);
	
	ТаблицаДатаНомерДокументовОплаты=	Запрос.Выполнить().Выгрузить();
	
	ДанныеДляПечати.Вставить("ДатаНомерДокументовОплаты", ТаблицаЗначений_2_МассивСтруктур(ТаблицаДатаНомерДокументовОплаты));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

