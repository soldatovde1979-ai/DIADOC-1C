	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетНаОплатуОтПоставщика
		, ВидыЭД.СчетНаОплату
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеМЗ
		, ВидыЭД.ТоварнаяНакладная
