Функция ТекстЗапросаТабличнаяЧастьСФ()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	&НоменклатураСсылка КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	НЕОПРЕДЕЛЕНО КАК Серия,
	|	&НоменклатураПредставление КАК НоменклатураПредставление,
	|	&НоменклатураКод КАК КодНоменклатуры,
	|	ТЧ.СодержаниеУслуги КАК СодержаниеУслуги,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Всего - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ТЧ.Всего КАК СуммаСНДС,
	|	&ТЧСТавкаНДС КАК СтавкаНДС,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ТЧ.Ссылка.СуммаВключаетНДС КАК ЦенаВключаетНДС,
	|	НЕОПРЕДЕЛЕНО КАК НомерГТД,
	|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
	|	ТЧ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТЧ.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|	НЕОПРЕДЕЛЕНО КАК ВидУпаковки,
	|	0 КАК КоличествоВОдномМесте,
	|	0 КАК КоличествоМест,
	|	&ЭтоУслуга КАК ЭтоУслуга,
	|	&ТипНоменклатуры КАК ПризнакТоварРаботаУслуга
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	НоменклатураПредставление =
	"ВЫБОР
	|	КОГДА ТЧ.НФА ССЫЛКА Справочник.Номенклатура
	|		ТОГДА ВЫРАЗИТЬ(ТЧ.НФА КАК Справочник.Номенклатура).НаименованиеПолное
	|	КОГДА ТЧ.НФА ССЫЛКА Справочник.ОсновныеСредства
	|		ТОГДА ВЫРАЗИТЬ(ТЧ.НФА КАК Справочник.ОсновныеСредства).НаименованиеПолное
	|	ИНАЧЕ ТЧ.НФА
	|КОНЕЦ";
	
	НоменклатураКод =
	"ВЫБОР
	|	КОГДА ТЧ.НФА ССЫЛКА Справочник.Номенклатура
	|		ТОГДА ВЫРАЗИТЬ(ТЧ.НФА КАК Справочник.Номенклатура).Код
	|	ИНАЧЕ НЕОПРЕДЕЛЕНО
	|КОНЕЦ";
	
	НоменклатураСсылка =
	"ВЫБОР
	|	КОГДА ТИПЗНАЧЕНИЯ(ТЧ.НФА) = ТИП(СТРОКА)
	|		ТОГДА НЕОПРЕДЕЛЕНО
	|	ИНАЧЕ ТЧ.НФА
	|КОНЕЦ";
	
	ЭтоУслуга =
	"ВЫБОР
	|	КОГДА ТЧ.Ссылка.ВидЦенности = ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	|			ИЛИ ТЧ.Ссылка.ВидЦенности = ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	|		ТОГДА ИСТИНА
	|	ИНАЧЕ ЛОЖЬ
	|КОНЕЦ";
	
	ТипНоменклатуры =
	"ВЫБОР
	|	КОГДА ТЧ.Ссылка.ВидЦенности = ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Услуги)
	|			ИЛИ ТЧ.Ссылка.ВидЦенности = ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	|		ТОГДА ""Service""
	|	ИНАЧЕ ""Property""
	|КОНЕЦ";
	
	ТЧСТавкаНДС =
	"ВЫБОР
	|	КОГДА ТЧ.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка)
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	ИНАЧЕ ТЧ.СтавкаНДС
	|КОНЕЦ";
	
	СписокЗамен = Новый Соответствие;
	СписокЗамен.Вставить("&НоменклатураСсылка", НоменклатураПредставление);
	СписокЗамен.Вставить("&НоменклатураПредставление", НоменклатураПредставление);
	СписокЗамен.Вставить("&НоменклатураКод", НоменклатураКод);
	СписокЗамен.Вставить("&ЭтоУслуга", ЭтоУслуга);
	СписокЗамен.Вставить("&ТипНоменклатуры", ТипНоменклатуры);
	СписокЗамен.Вставить("&ТЧСТавкаНДС", ТЧСТавкаНДС);
	
	Для Каждого Замена Из СписокЗамен Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Замена.Ключ, Замена.Значение);
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

