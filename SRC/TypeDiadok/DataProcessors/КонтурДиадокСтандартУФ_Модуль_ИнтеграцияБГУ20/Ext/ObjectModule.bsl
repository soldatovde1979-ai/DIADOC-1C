// Список возможных идентификаторов способов обработки входящих документов.
// 
// Возвращаемое значение:
//  Структура - см. тело функции.
//
Функция ИдентификаторыПравилОбработкиДокументов()
	
	ЗначенияПеречисления = Новый Массив;
	ЗначенияПеречисления.Добавить("ПоступлениеМЗ");
	ЗначенияПеречисления.Добавить("ПоступлениеУслугРабот");
	ЗначенияПеречисления.Добавить("ПоступлениеОС");
	ЗначенияПеречисления.Добавить("СчетФактураПолученный");
	ЗначенияПеречисления.Добавить("КорректировочныйСчетФактураПолученный");
	ЗначенияПеречисления.Добавить("АктСверкиВзаиморасчетов");
	
	Результат = Новый Структура;
	Для Каждого Элемент Из ЗначенияПеречисления Цикл
		Результат.Вставить(Элемент, Элемент);
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Возвращает структуру, реквизиты которой соответствуют
// документу "ЭлектронныйДокументПоставщика"
//
// Параметры:
//  ДанныеЭД - Структура - содержит данные электронного документа;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//     * Шапка - Структура - соответствует шапке документа "ЭлектронныйДокументПоставщика";
//     * СписокНоменклатуры - ТаблицаЗначений - соответствует табличной части "СписокНоменклатуры" документа "ЭлектронныйДокументПоставщика";
//
Функция СтруктураЭлектронногоДокументаПоставщика(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияЭлектронногоДокументаПоставщика();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД	 = ДанныеЭД.Шапка;
	ИтогиТЧ	 = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Участники сделки
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	
	// Валюта, сумма
	Шапка.Вставить("ВалютаДокумента", ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("СуммаДокумента"	, ИтогиТЧ.СуммаСНДС);
	Шапка.Вставить("СуммаВключаетНДС", ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Договор
	РеквизитыДоговора = Новый Структура;
	РеквизитыДоговора.Вставить("Организация", Шапка.Организация);
	РеквизитыДоговора.Вставить("Владелец", Шапка.Контрагент);
	РеквизитыДоговора.Вставить("ДатаДоговора", Неопределено);
	РеквизитыДоговора.Вставить("НомерДоговора", Неопределено);
	Шапка.Вставить("Договор", НайтиДоговорКонтрагента(РеквизитыДоговора));
	
	// Данные первичного документа
	Шапка.Вставить("ВидПервичногоДокумента", "Универсальный передаточный документ");
	Шапка.Вставить("ДатаПервичногоДокумента", ШапкаЭД.Дата);
	Шапка.Вставить("НомерПервичногоДокумента", ШапкаЭД.Номер);
	
	СписокНоменклатуры = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка().СписокНоменклатуры.ВыгрузитьКолонки();
	
	Если СписокНоменклатуры.Колонки.Найти("Содержание") = Неопределено Тогда 
		СписокНоменклатуры.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	КонецЕсли;	
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл
		
		ЭтоВозвратнаяТара = Ложь;
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		// TODO: Корректно заполнить (3 - услуги, 4 - ПО, 1ВТ - возвратная тара)
		ПризнакНоменклатуры = "1";
		
		НоваяСтрока = СписокНоменклатуры.Добавить();
		
		НоваяСтрока.Номенклатура			= НоменклатураИБ.Номенклатура;
		НоваяСтрока.Содержание				= НоменклатураКонтрагента.Наименование;
		НоваяСтрока.ПризнакНоменклатуры		= ПризнакНоменклатуры;
		НоваяСтрока.ИдентификаторПоставщика	= НоменклатураКонтрагента.Идентификатор;
		
		НоваяСтрока.ЕдиницаИзмерения	 = НоменклатураИБ.Упаковка;
		НоваяСтрока.ЕдиницаИзмеренияКод	 = НоменклатураКонтрагента.ЕдиницаИзмеренияКод;
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки);
		
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Всего		 = Стр.СуммаСНДС;
		
		Если ПараметрыЗаполнения.ЦенаВключаетНДС Тогда
			
			Если НоваяСтрока.Количество = 0 Тогда
				НоваяСтрока.Цена = 0;
			Иначе
				НоваяСтрока.Цена = НоваяСтрока.Всего / НоваяСтрока.Количество;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", Шапка);
	Результат.Вставить("СписокНоменклатуры", СписокНоменклатуры);
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру для заполнения счета-фактуры полученного.
//
// Параметры:
//  ДанныеЭД - Структура - содержит данные электронного документа;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//     * Шапка - Структура - значения для заполнения шапки СФ;
//     * СоставНФА - ТаблицаЗначений - соответствует табличной части "СоставНФА" документа "СчетФактураПолученный";
//
Функция СтруктураЗаполненияСчетаФактурыПолученного(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияСчетаФактуры();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД	 = ДанныеЭД.Шапка;
	ИтогиТЧ	 = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Даты, номера
	Шапка.Вставить("КодСпособаВыставления", 2);
	Шапка.Вставить("НомерПервичногоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаПервичногоДокумента", ШапкаЭД.Дата);
	Шапка.Вставить("ВидПервичногоДокумента", НСтр("ru = 'Счет-фактура'"));
	Шапка.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	// Участники сделки
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	
	// Валюта, сумма
	ВалютаРегл = ВалютаРегламентированногоУчета();
	Валюта = ШапкаЭД.Валюта.Ссылка;
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = ВалютаРегл;
	КонецЕсли;
	
	Шапка.Вставить("ВалютаДокумента", Валюта);
	Шапка.Вставить("СуммаДокумента"	, ИтогиТЧ.СуммаСНДС);
	Шапка.Вставить("СуммаНДС"		, ИтогиТЧ.СуммаНДС);
	
	Если Валюта <> ВалютаРегл Тогда
		Шапка.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	
	// Договор
	РеквизитыДоговора = Новый Структура;
	РеквизитыДоговора.Вставить("Организация", Шапка.Организация);
	РеквизитыДоговора.Вставить("Владелец", Шапка.Контрагент);
	РеквизитыДоговора.Вставить("ДатаДоговора", Неопределено);
	РеквизитыДоговора.Вставить("НомерДоговора", Неопределено);
	Шапка.Вставить("Договор", НайтиДоговорКонтрагента(РеквизитыДоговора));
	
	// Вид операции
	ЭтоАванс = ДанныеЭД.ЭтоАванс;
	
	Если ЭтоАванс Тогда 
		
		ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный;
		КодВидаОперации = "02";
		ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс;
		
	Иначе
		
		ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КодВидаОперации = "01";
		ВидЦенности = Перечисления.ВидыЦенностейНДС.Материалы; // TODO: или Услуги? 
		
	КонецЕсли;
	
	Шапка.Вставить("ПричинаНалогообложения", ПричинаНалогообложения);
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	Шапка.Вставить("ВидЦенности", ВидЦенности);
	
	// Документы-основания
	ДокументыОснованияСчетаФактуры = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ДокументыОснованияСчетаФактуры = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	
	ЭДПоставщика = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка();
	
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований = Документы.СчетФактураПолученный.ПустаяСсылка().ДокументыОснования.ВыгрузитьКолонки();
	
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ЭДПоставщика = ДокументОснования;
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаОснований.Свернуть("ДокументОснование");
	Шапка.Вставить("ДокументыОснования", ТаблицаОснований);
	Шапка.Вставить("ЭДПоставщика", ЭДПоставщика);
	
	// Табличная часть
	ТаблицаТоваров = Документы.СчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента	 = Стр.НоменклатураКонтрагента;
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.НФА = НоменклатураИБ.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
		НоваяСтрока.ИдентификаторПоставщика = НоменклатураКонтрагента.Идентификатор;
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки);
		
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Всего		 = Стр.СуммаСНДС;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", Шапка);
	Результат.Вставить("СоставНФА", ТаблицаТоваров);
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяЭлектронныйАктСверкиВзаиморасчетов()
	
	МинимальнаяВерсия = "2.0.90.00";
	ВерсияБГУ = ВерсияПодсистемыБГУ();
	Результат = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияБГУ, МинимальнаяВерсия) >= 0;
	
	Возврат Результат;
	
КонецФункции

Функция ДоговорПоСтрокеАктаСверки(ДанныеДокумента, РеквизитыДоговора)
	
	ВидДоговора = РеквизитыДоговора.Описание;
	ДоговорПоУмолчанию = Справочники.Договоры.ПустаяСсылка();
	СписокВидовДоговоров = Новый СписокЗначений;
	
	Если РеквизитыДоговора.Описание = "С покупателем" Тогда
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ИначеЕсли РеквизитыДоговора.Описание = "С поставщиком" Тогда
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Иначе
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Договоры.Ссылка
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.Организация = &Организация
	|	И Договоры.Контрагент = &Контрагент
	|	И Договоры.ВидДоговора В(&ВидДоговора)");
	
	Запрос.УстановитьПараметр("Организация", ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("Контрагент", ДанныеДокумента.Контрагент);
	Запрос.УстановитьПараметр("ВидДоговора", СписокВидовДоговоров);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат ДоговорПоУмолчанию;
		
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат ДоговорПоУмолчанию;
	
КонецФункции

Функция СтруктураЗаполненияАктаСверкиВзаиморасчетов(ДанныеЭД, ДополнительныеПараметры)
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	
	Шапка = Новый Структура;
	Шапка.Вставить("ЭтоЭлектронныйДокумент",  Истина);
	Шапка.Вставить("ЭтоДокументКонтрагента",  Истина);
	Шапка.Вставить("РазбитьПоДоговорам",      Истина);
	Шапка.Вставить("ДатаНачала",              ШапкаЭД.ДатаНачала);
	Шапка.Вставить("ДатаОкончания",           ШапкаЭД.ДатаОкончания);
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента",  ШапкаЭД.Дата);
	
	// Стороны сверки
	Организация = СсылкаНаУчастникаСделки(ШапкаЭД.Получатель);
	Контрагент = СсылкаНаУчастникаСделки(ШапкаЭД.Отправитель);
	Шапка.Вставить("Организация", Организация);
	Шапка.Вставить("Контрагент", Контрагент);
	
	// Валюта
	Шапка.Вставить("ВалютаДокумента", ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("ОстатокНаНачалоПоДаннымКонтрагента",
		ДанныеЭД.ТоварнаяЧасть.СальдоНачДебет - ДанныеЭД.ТоварнаяЧасть.СальдоНачКредит);
	
	ТаблицаПоДаннымКонтрагента = Новый ТаблицаЗначений;
	Для Каждого Реквизит Из Метаданные.Документы.АктСверкиВзаиморасчетов.ТабличныеЧасти.ПоДаннымКонтрагента.Реквизиты Цикл
		ТаблицаПоДаннымКонтрагента.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	// Табличная часть ПоДаннымКонтрагента
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.Договор = ДоговорПоСтрокеАктаСверки(Шапка, СтрокаДоговора);
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.Представление = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				СтрокаПоДаннымКонтрагента.НомерДокумента = СтрокаДокумента.Номер;
				СтрокаПоДаннымКонтрагента.ДатаДокумента = СтрокаДокумента.Дата;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеДляЗаполнения = Новый Структура();
	ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
	ДанныеДляЗаполнения.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

// Обработка заполнения поступления МЗ по данным электронного документа поставщика.
// См. Документы.ПоступлениеМЗ.МодульОбъекта.ЗаполнитьПоЭлектронномуДокументуПоставщика()
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъек.ПоступлениеМЗ - заполняемый объект;
//  ЭлектронныйДокументПоставщика - Структура - см. СтруктураЭлектронногоДокументаПоставщика;
//
Процедура ЗаполнитьПоступлениеМЗ(ДокументОбъект, ЭлектронныйДокументПоставщика)
	
	ДанныеЗаполнения = ЭлектронныйДокументПоставщика.Шапка;
	
	ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
	ДокументОбъект.Контрагент = ДанныеЗаполнения.Контрагент;
	ДокументОбъект.Договор = ДанныеЗаполнения.Договор;
	ДокументОбъект.ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	ДокументОбъект.СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
	ДокументОбъект.ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДокументОбъект.ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	ДокументОбъект.НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДокументОбъект.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика;
	ДокументОбъект.СчетУчета = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.00");
	ДокументОбъект.ПринятьНДСКВычету = Истина;
	
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеМЗ;
	СписокНоменклатуры = СписокДоступнойНоменклатурыЭДПоставщика(ЭлектронныйДокументПоставщика.СписокНоменклатуры, ТипДокументаУчета);
	
	ПараметрыОбработкиСтроки = ПараметрыУстановкиСчетаУчетаВСтроке(ДокументОбъект);
	
	Для Каждого СтрокаТЧ Из СписокНоменклатуры Цикл
		
		Если СтрокаТЧ.КодВидаНоменклатуры = 5 Тогда
			
			НоваяСтрока = ДокументОбъект.ВозвратнаяТара.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.ЦенаОприходования = СтрокаТЧ.Цена;
			
		Иначе//Если СтрокаТЧ.КодВидаНоменклатуры = 1 Тогда
			
			НоваяСтрока = ДокументОбъект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.КоличествоМест = 1;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения");
			
		КонецЕсли;
		
		ПараметрыОбработкиСтроки.Номенклатура = НоваяСтрока.Номенклатура;
		УстановитьДанныеСчетаУчетаВСтроке(НоваяСтрока, ПараметрыОбработкиСтроки);
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.Материалы.Итог("Всего");
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.УстановитьНовыйНомер();
	
КонецПроцедуры

// Обработка заполнения поступления услуг/работ по данным электронного документа поставщика.
// См. Документы.ПоступлениеУслугРабот.МодульОбъекта.ЗаполнитьПоЭлектронномуДокументуПоставщика()
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъек.ПоступлениеУслугРабот - заполняемый объект;
//  ЭлектронныйДокументПоставщика - Структура - см. СтруктураЭлектронногоДокументаПоставщика;
//
Процедура ЗаполнитьПоступлениеУслугРабот(ДокументОбъект, ЭлектронныйДокументПоставщика)
	
	ДанныеЗаполнения = ЭлектронныйДокументПоставщика.Шапка;
	
	ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
	ДокументОбъект.Контрагент = ДанныеЗаполнения.Контрагент;
	ДокументОбъект.Договор = ДанныеЗаполнения.Договор;
	ДокументОбъект.ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	ДокументОбъект.СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
	ДокументОбъект.ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДокументОбъект.ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	ДокументОбъект.НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДокументОбъект.ПринятьНДСКВычету = Истина;
	
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеУслугРабот;
	СписокНоменклатуры = СписокДоступнойНоменклатурыЭДПоставщика(ЭлектронныйДокументПоставщика.СписокНоменклатуры, ТипДокументаУчета);
	
	Для Каждого СтрокаТЧ Из СписокНоменклатуры Цикл
		
		НоваяСтрока = ДокументОбъект.УслугиИРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		НоваяСтрока.ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Номенклатура, "ЕдиницаИзмерения");
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.УслугиИРаботы.Итог("Всего");
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.УстановитьНовыйНомер();
	
КонецПроцедуры

// Обработка заполнения поступления МЗ по данным электронного документа поставщика.
// См. Документы.ПоступлениеМЗ.МодульОбъекта.ЗаполнитьПоЭлектронномуДокументуПоставщика()
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъек.ПоступлениеМЗ - заполняемый объект;
//  ЭлектронныйДокументПоставщика - Структура - см. СтруктураЭлектронногоДокументаПоставщика;
//
Процедура ЗаполнитьПоступлениеОС(ДокументОбъект, ЭлектронныйДокументПоставщика)
	
	ДанныеЗаполнения = ЭлектронныйДокументПоставщика.Шапка;
	
	ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
	ДокументОбъект.Контрагент = ДанныеЗаполнения.Контрагент;
	ДокументОбъект.Договор = ДанныеЗаполнения.Договор;
	ДокументОбъект.ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
	ДокументОбъект.СуммаВключаетНДС = ДанныеЗаполнения.СуммаВключаетНДС;
	ДокументОбъект.ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДокументОбъект.ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	ДокументОбъект.НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДокументОбъект.ПринятьНДСКВычету = Истина;
	
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПоступлениеОС;
	СписокНоменклатуры = СписокДоступнойНоменклатурыЭДПоставщика(ЭлектронныйДокументПоставщика.СписокНоменклатуры, ТипДокументаУчета);
	
	Для Каждого СтрокаТЧ Из СписокНоменклатуры Цикл
		
		ВидНФА = Перечисления.ВидыНФА.ОС;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура)
			И ТипЗнч(СтрокаТЧ.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Номенклатура, "ВидНФА");
		КонецЕсли;
		
		Если ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			СчетУчета = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("106.11");
		ИначеЕсли ВидНФА = Перечисления.ВидыНФА.НПА Тогда
			СчетУчета = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("106.32");
		Иначе
			СчетУчета = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("106.31");
		КонецЕсли;
		
		НоваяСтрока = ДокументОбъект.КапВложения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		НоваяСтрока.ВнеоборотныйАктив = СтрокаТЧ.Номенклатура;
		НоваяСтрока.КоличествоМест = 1;
		НоваяСтрока.Коэффициент = 1;
		НоваяСтрока.СчетУчета = СчетУчета;
		
	КонецЦикла;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.КапВложения.Итог("Всего");
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.УстановитьНовыйНомер();
	
КонецПроцедуры

// Обработка заполнения поступления услуг/работ по данным электронного документа поставщика.
// См. ЭлектронныеДокументыБГУ.НайтиСоздатьУПДСчетФактуру_2019()
//
// Параметры:
//  ДокументОбъект	 - ДокументОбъек.СчетФактураПолученный - заполняемый объект;
//  ДанныеДокумента	 - Структура - см. СтруктураЗаполненияСчетаФактурыПолученного()
//
Процедура ЗаполнитьСчетФактуруПолученный(ДокументОбъект, ДанныеДокумента)
	
	ДанныеЗаполненияШапки = ДанныеДокумента.Шапка;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
	ДокументОбъект.ДокументыОснования.Загрузить(ДанныеЗаполненияШапки.ДокументыОснования);
	ДокументОбъект.СоставНФА.Загрузить(ДанныеДокумента.СоставНФА);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.УстановитьНовыйНомер();
	
КонецПроцедуры

Процедура ЗаполнитьАктСверкиВзаиморасчетов(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	МенеджерОбъекта = Документы.АктСверкиВзаиморасчетов;
	
	ДокументОбъект.РазбитьПоДоговорам = Истина;
	ДокументОбъект.ПоДаннымКонтрагента.Загрузить(ДанныеДокумента.ПоДаннымКонтрагента);
	ДокументОбъект.СверкаСогласована = НЕ ДокументОбъект.ЕстьРасхождения;
	
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьСчетамиПоУмолчанию(ДокументОбъект);
	
КонецПроцедуры

