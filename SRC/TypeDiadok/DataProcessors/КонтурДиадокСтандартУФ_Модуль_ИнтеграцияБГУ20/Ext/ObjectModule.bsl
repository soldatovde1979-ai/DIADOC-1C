Функция ПолучитьОписаниеОрганизации(СведенияОбОрганизации, СписокСвойств = "НаименованиеДляПечатныхФорм, ИНН, Свидетельство, ЮридическийАдрес, Телефоны, НомерСчета, Банк, БИК, КоррСчет")
	
	СтрокаОписанияОрганизации = "";
	
	СоответствиеПараметров =	Новый Соответствие();
	
	СоответствиеПараметров.Вставить("ПолноеНаименование",			" ");
	СоответствиеПараметров.Вставить("СокращенноеНаименование",		" ");
	СоответствиеПараметров.Вставить("НаименованиеДляПечатныхФорм",	" ");
	СоответствиеПараметров.Вставить("ИНН",							" ИНН ");
	СоответствиеПараметров.Вставить("КПП",							" КПП ");
	СоответствиеПараметров.Вставить("Свидетельство",				" ");
	СоответствиеПараметров.Вставить("СвидетельствоДатаВыдачи",		" от ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес",				" ");
	СоответствиеПараметров.Вставить("Телефоны",						" тел.: ");
	СоответствиеПараметров.Вставить("Факс",							" факс: ");
	СоответствиеПараметров.Вставить("НомерСчета",					" р/с ");
	СоответствиеПараметров.Вставить("Банк",               			" в банке ");
	СоответствиеПараметров.Вставить("БИК",                			" БИК ");
	СоответствиеПараметров.Вставить("КоррСчет",           			" к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО",          			" Код по ОКПО ");
	
	СписокСвойств =		СписокСвойств + ?(Прав(СписокСвойств, 1) = ",", "", ",");
	ЧислоПараметров =	СтрЧислоВхождений(СписокСвойств, ",");
	Для Счетчик = 1 По ЧислоПараметров Цикл
		
		Запятая = Найти(СписокСвойств, ",");
		Если Запятая > 0 Тогда
			
			ИмяПараметра =	Лев(СписокСвойств, Запятая - 1);
			СписокСвойств =	Сред(СписокСвойств, Запятая + 1, СтрДлина(СписокСвойств));
			
			СтрокаДополнения =	"";
			СведенияОбОрганизации.Свойство(ИмяПараметра, СтрокаДополнения);
			
			Если ПустаяСтрока(СтрокаДополнения) Тогда
				Продолжить;
			КонецЕсли;
			
			Префикс = СоответствиеПараметров[ИмяПараметра];
			Если ЗначениеЗаполнено(СтрокаОписанияОрганизации) Тогда
				СтрокаОписанияОрганизации=	СтрокаОписанияОрганизации + ", ";
			КонецЕсли;
			
			СтрокаОписанияОрганизации=	СтрокаОписанияОрганизации + ?(ЗначениеЗаполнено(Префикс), Префикс, "")+ СтрокаДополнения;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаОписанияОрганизации =	СокрЛП(СтрокаОписанияОрганизации);
	Пока Найти(СтрокаОписанияОрганизации, "  ") > 0 Цикл
		СтрокаОписанияОрганизации =	СтрЗаменить(СтрокаОписанияОрганизации, "  ", " ");
	КонецЦикла;
	
	Возврат СтрокаОписанияОрганизации;
	
КонецФункции

