Функция ПолучитьСчетПоКоду(КодСчета) Экспорт
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(КодСчета) Тогда
		
		ТекущаяДатаСеанса = ТекущаяДатаСеанса();
		
		Попытка
			Результат = БухгалтерскийУчетКлиентСервер.СчетПоКоду(КодСчета, ТекущаяДатаСеанса);
		Исключение
			Результат = БухгалтерскийУчетПовтИсп.СчетПоКоду(КодСчета, ТекущаяДатаСеанса);
		КонецПопытки;
		
	КонецЕсли;
	
