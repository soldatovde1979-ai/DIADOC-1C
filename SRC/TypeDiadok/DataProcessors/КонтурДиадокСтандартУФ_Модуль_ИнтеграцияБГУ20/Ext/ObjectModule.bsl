	ВидДокумента = ОбъектМетаданных.Имя;
	
	Если ВРег(ВидДокумента) = ВРег("СчетФактураПолученный") Тогда
		
		ИменаПолей.Номер = "НомерПервичногоДокумента";
		ИменаПолей.Дата	 = "ДатаПервичногоДокумента";
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет таблицу правил обработки входящих электронных документов.
//
// Параметры:
//  ПравилаОбработки - ТаблицаЗначений - правила обработки документов (см. ПравилаОбработкиВходящихДокументов);
//
// Пример:
//	Если ПолучитьФункциональнуюОпцию("ВедетсяПроизводственнаяДеятельность") Тогда
//		
//		ДобавитьПравилоОбработкиДокументов(ПравилоОбработки
//			, "ПоступлениеВПереработку" // Описание правила задается в процедуре ПриПолученииПравилаОбработкиЭлектронногоДокумента
//			, "ТоварнаяНакладная" 		// Используется для накладных
//			, Ложь); 					// Для исправлений не используется, только для первичных документов
//		
//	КонецЕсли;
//
Процедура ЗаполнитьПравилаОбработкиВходящихДокументов(ПравилаОбработки) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхДокументов = Ложь;
	ДляИсправительныхДокументов = Истина;
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Поступление материальных запасов
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПоступлениеМЗ
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхИИсправительныхДокументов);
	
	// Поступление услуг, работ
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПоступлениеУслугРабот
		, ВидыЭД.АктОбОказанииУслуг
		, ДляПервичныхИИсправительныхДокументов);
	
	// Поступление ОС, НМА, НПА
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПоступлениеОС
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхИИсправительныхДокументов);
	
	// Счет-фактура
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.СчетФактураПолученный
		, ВидыЭД.СчетФактура
		, ДляПервичныхИИсправительныхДокументов);
	
	// Счет-фактура (корректировочный)
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.КорректировочныйСчетФактураПолученный
		, ВидыЭД.КорректировочныйСчетФактура
		, ДляПервичныхИИсправительныхДокументов);
		
	Если ИспользуетсяЭлектронныйАктСверкиВзаиморасчетов() Тогда
		
		// Акт сверки взаиморасчетов
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.АктСверкиВзаиморасчетов
			, ВидыЭД.АктСверки
			, ДляПервичныхИИсправительныхДокументов);
			
	КонецЕсли;
		
КонецПроцедуры

// Обработчик получения правила отражения электронного документа в учетной системе.
