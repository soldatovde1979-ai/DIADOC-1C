		, Неопределено);
		
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеУслугРабот
		, ВидыЭД.ТоварнаяНакладная
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеУслугРабот
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
