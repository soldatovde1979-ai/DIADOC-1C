// Возвращает прикладное значение ставки НДС по его строковому представлению
//
// Параметры:
//  ПредставлениеСтавки - Строка - Строковое представление ставки НДС
// 
// Возвращаемое значение:
//  СправочникСсылка, ПеречислениеСсылка - Прикладное значение ставки НДС
//
Функция ЗначениеСтавкиНДС(ПредставлениеСтавки) Экспорт
	
	Замены = Новый Соответствие;
	Замены.Вставить("ИсчНалАг", "НДС исчисляется налоговым агентом");
	
	ПредставлениеБЭД = Замены.Получить(ПредставлениеСтавки);
	Если Не ЗначениеЗаполнено(ПредставлениеБЭД) Тогда
		ПредставлениеБЭД = ПредставлениеСтавки;
	КонецЕсли;
	
	МодульБЭД = ОбщегоНазначения.ОбщийМодуль("ФорматыЭДОПовтИсп");
	
	Результат = МодульБЭД.СтавкаНДСИзПредставления(ПредставлениеБЭД);
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое представление ставки НДС по прикладному значению
//
// Параметры:
//  ЗначениеСтавки - СправочникСсылка, ПеречислениеСсылка - Прикладное значение ставки НДС
// 
// Возвращаемое значение:
//  Строка - Строковое представление ставки НДС для электронного документа
//
Функция ПредставлениеСтавкиНДС(ЗначениеСтавки) Экспорт
	
	МодульБЭД = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияЭДО");
	
	Результат = МодульБЭД.СтавкаНДСИзСоответствия(, ЗначениеСтавки);
	
	Возврат Результат;
	
КонецФункции

