Процедура ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность)
	
	Для Каждого ТекСтрокаТЧ Из ТабличнаяЧасть Цикл
		
		СуммаСНДС = ТекСтрокаТЧ.Сумма;
		Если Не ТекСтрокаТЧ.СуммаВключаетНДС Тогда
			СуммаСНДС = СуммаСНДС + ТекСтрокаТЧ.СуммаНДС;
		КонецЕсли;
		СуммаСНДС = Окр(СуммаСНДС * Курс / Кратность, 2);
		СуммаНДС = Окр(ТекСтрокаТЧ.СуммаНДС * Курс / Кратность, 2);
		Сумма = СуммаСНДС - СуммаНДС;
		
		ТекСтрокаТЧ.Сумма		= ?(ТекСтрокаТЧ.СуммаВключаетНДС, СуммаСНДС, Сумма);
		ТекСтрокаТЧ.СуммаНДС	= СуммаНДС;
		
	КонецЦикла;
	
КонецПроцедуры	

