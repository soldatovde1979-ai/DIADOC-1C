Процедура ПересчетВалюты_ПоПараметрам(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки, Пересчет = Истина)
	
	ДокументОбъект = ТекущееОснование.ПолучитьОбъект();
	
	Запрос = Новый Запрос;
	УниверсальныеМеханизмы.ОпределитьКурсыДокументаДляПечати(ДокументОбъект, Запрос);
	
	Курс      = Запрос.Параметры.Курс;
	Кратность = Запрос.Параметры.Кратность;
	
	ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность);
	
	Если Пересчет Тогда
		
		ПараметрыПересчета = УчетНДС.СтруктураПараметровДляПересчетаСуммВРубли();
		ПараметрыПересчета.СуммаАвансаВалИт     = Запрос.Параметры.СуммаАвансаВал;
		ПараметрыПересчета.СуммаАвансаРубИт     = Запрос.Параметры.СуммаАвансаРуб;
		ПараметрыПересчета.СуммаРеализацииВалИт = УчетНДС.ПолучитьСуммуДокументаСНДС(ТекущееОснование);
		ПараметрыПересчета.ВалютаВзаиморасчетов = ТекущееОснование.ВалютаДокумента;
		ПараметрыПересчета.КурсРеализации       = ЗаполнениеДокументов.КурсДокумента(ТекущееОснование, ПолучитьВалютуРегламентированногоУчета());
		ПараметрыПересчета.КратностьРеализации  = ЗаполнениеДокументов.КратностьДокумента(ТекущееОснование, ПолучитьВалютуРегламентированногоУчета());
		ПараметрыПересчета.СуммаВключаетНДС     = ДанныеШапки.СуммаВключаетНДС;
		ПараметрыПересчета.ЦенаВключаетНДС      = Ложь;
		ПараметрыПересчета.ДатаПересчета        = ДанныеШапки.Дата;
		УчетНДС.ПерезаполнитьСуммыПоУЕвРублях(ТабличнаяЧасть, ПараметрыПересчета);
		
	КонецЕсли;
	
	ПересчетВалюты_Округление(ТабличнаяЧасть, ДанныеШапки);	
	
КонецПроцедуры

Процедура ПересчетВалюты_Округление(ТабличнаяЧасть, ДанныеШапки)
	
	Если ДанныеШапки.Свойство("СуммаДокумента") Тогда 
		СуммаДокумента = ТабличнаяЧасть.Итог("Сумма") + ?(ДанныеШапки.СуммаВключаетНДС, 0, ТабличнаяЧасть.Итог("СуммаНДС"));
		ДанныеШапки.СуммаДокумента = Окр(СуммаДокумента, 2);
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("СуммаНДСДокумента") Тогда 
		СуммаНДСДокумента = ТабличнаяЧасть.Итог("СуммаНДС");
		ДанныеШапки.СуммаНДСДокумента = Окр(СуммаНДСДокумента, 2);
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("СуммаБезНДСДокумента") Тогда
		СуммаБезНДСДокумента = ДанныеШапки.СуммаДокумента - ДанныеШапки.СуммаНДСДокумента;
		ДанныеШапки.СуммаБезНДСДокумента = Окр(СуммаБезНДСДокумента, 2);
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТабличнаяЧасть Цикл
		ТекСтрока.Сумма = Окр(ТекСтрока.Сумма, 2);
		ТекСтрока.СуммаНДС = Окр(ТекСтрока.СуммаНДС, 2);
	КонецЦикла;
	
КонецПроцедуры

