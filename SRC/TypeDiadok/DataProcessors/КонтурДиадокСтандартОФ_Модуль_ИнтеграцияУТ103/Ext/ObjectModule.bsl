Функция СоздатьДокументПоступлениеТоваровУслуг(параметры, стВероятныеПоля, ЭДОбъект, ТабличнаяЧасть = Неопределено, СуммаВключаетНДС = Истина, видОперации, ЗаполнениеГТД = Ложь) Экспорт
	
	Если видОперации = "ВозвратОтПокупателя" Тогда 
		ДокОбъект = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	ИначеЕсли видОперации = "ПоступлениеДопРасходов" Тогда
		ДокОбъект = Документы.ПоступлениеДопРасходов.СоздатьДокумент();
	Иначе 	
		ДокОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
	КонецЕсли;
	
	ДокОбъектМетаданные = ДокОбъект.Метаданные(); 
	
	Если видОперации <> "ВозвратОтПокупателя" Тогда 
		ДокОбъект.ДатаВходящегоДокумента	= параметры.ДатаВходящегоДокумента;
		ДокОбъект.НомерВходящегоДокумента	= параметры.НомерВходящегоДокумента;
	КонецЕсли;
	
	Если Параметры.Свойство("Дата") И ЗначениеЗаполнено(Параметры.Дата) Тогда
		ДокОбъект.Дата = Параметры.Дата;
	КонецЕсли;
		
	ДокОбъект.ДоговорКонтрагента = параметры.ДоговорКонтрагента;
	Если ЗначениеЗаполнено(ДокОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов) Тогда
		ДокОбъект.ВалютаДокумента = ДокОбъект.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	Иначе
		ДокОбъект.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли;
	ДокОбъект.КратностьВзаиморасчетов	= 1;
	ДокОбъект.КурсВзаиморасчетов 		= 1;
	
	//заполним склад и подразделение
	Склад = Неопределено;
	Если ЕстьРеквизитМетаданных(ДокОбъектМетаданные, "СкладОрдер") Тогда
		ДокОбъект.ВидПоступления = перечисления.ВидыПоступленияТоваров.НаСклад;
		Если ЗначениеЗаполнено(параметры.Склад) Тогда
			ДокОбъект.СкладОрдер = параметры.Склад;
		Иначе
			Попытка
				ДокОбъект.СкладОрдер = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнойСклад");
			Исключение
			КонецПопытки;
		КонецЕсли;
		Склад = ДокОбъект.СкладОрдер;
	КонецЕсли;	
	
	Если ЕстьРеквизитМетаданных(ДокОбъектМетаданные, "Подразделение") Тогда 
		Если ЗначениеЗаполнено(параметры.Подразделение) Тогда
			ДокОбъект.Подразделение = параметры.Подразделение;
		Иначе
			Попытка
				ДокОбъект.Подразделение = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновноеПодразделение");
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;	
	// Заполнение возможных полей
	Если стВероятныеПоля.Организация = Неопределено Тогда
		Сообщить("Организация в системе Диадок: """ + ЭДОбъект.Organization.Name + """, ИНН/КПП: " + ЭДОбъект.Organization.Inn + "/" + ЭДОбъект.Organization.Kpp + " не ассоциирована с организацией в 1С");
	Иначе
		ДокОбъект.Организация = стВероятныеПоля.Организация;
	КонецЕсли;
	Если стВероятныеПоля.Контрагент = Неопределено Тогда
		Сообщить("Контрагент в системе Диадок: """ + ЭДОбъект.counterAgent.Name + """, ИНН/КПП: " + ЭДОбъект.counterAgent.Inn + "/" + ЭДОбъект.counterAgent.Kpp + " не ассоциирован с контрагентом в 1С");
	Иначе
		ДокОбъект.Контрагент = стВероятныеПоля.Контрагент;
		
		//Заполним договор
		мСтруктураПараметровДляПолученияДоговора = ЗаполнениеДокументов.ПолучитьСтруктуруПараметровДляПолученияДоговораПокупки();
		ЗаполнениеДокументов.ПриИзмененииЗначенияКонтрагента(ДокОбъект, мСтруктураПараметровДляПолученияДоговора);
	КонецЕсли;
	Если ВидОперации = "ПоступлениеДопРасходов"  Тогда
		ДокОбъект.Сумма 	= ?(СуммаВключаетНДС, ЭДОбъект.total, ЭДОбъект.total - ЭДОбъект.vat);
		ДокОбъект.СуммаНДС 	= ЭДОбъект.vat;
	Иначе
		
		Если ТабличнаяЧасть <> Неопределено Тогда
			
			ДатаПроверки = ?(ЗначениеЗаполнено(ДокОбъект.Дата), ДокОбъект.Дата, ТекущаяДата());
			ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров(ДатаПроверки);
			
			Для каждого СтрокаДанных Из ТабличнаяЧасть Цикл
				
				ЭтоТовар = СтрокаДанных.Тип = "Товар";
				
				Если ЭтоТовар Тогда
					
					СтрокаТЧ = ДокОбъект.Товары.Добавить();
					
					СтрокаТЧ.ЕдиницаИзмерения 	= СтрокаДанных.ЕдиницаИзмерения;
					СтрокаТЧ.Коэффициент		= СтрокаДанных.ЕдиницаИзмерения.Коэффициент;
					
					Если ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения) 
						И ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения.Коэффициент) Тогда
						
						СтрокаТЧ.Коэффициент = СтрокаТЧ.ЕдиницаИзмерения.Коэффициент;
					КонецЕсли;
					
					Если ТабличнаяЧасть.Колонки.Найти("Серия") <> Неопределено Тогда
						СтрокаТЧ.СерияНоменклатуры = СтрокаДанных.Серия;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Склад)
						Или ЕстьРеквизитМетаданных(ДокОбъектМетаданные.ТабличныеЧасти.Товары, "Склад") Тогда
						
						СтрокаТЧ.Склад = Склад;
					КонецЕсли;
										
				Иначе
					
					СтрокаТЧ = ДокОбъект.Услуги.Добавить();
					
					СтрокаТЧ.Содержание	= СтрокаДанных.НоменклатураИзЭД;
					СтрокаТЧ.Номенклатура	= СтрокаДанных.Номенклатура;
					
					Если НЕ ЗначениеЗаполнено(СтрокаТЧ.СтатьяЗатрат) Тогда
						СтрокаТЧ.СтатьяЗатрат = СтрокаТЧ.Номенклатура.СтатьяЗатрат;
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НоменклатурнаяГруппа) Тогда
						СтрокаТЧ.НоменклатурнаяГруппа = СтрокаТЧ.Номенклатура.НоменклатурнаяГруппаЗатрат;
					КонецЕсли;
					
					Если ЕстьРеквизитМетаданных(ДокОбъектМетаданные, "Подразделение") Тогда 
						СтрокаТЧ.Подразделение = ДокОбъект.Подразделение;
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаТЧ.Номенклатура 	= СтрокаДанных.Номенклатура;
				СтрокаТЧ.Количество 	= СтрокаДанных.Количество;
				СтрокаТЧ.Цена		 	= СтрокаДанных.Цена;
				СтрокаТЧ.Сумма 			= СтрокаДанных.Сумма;
				СтрокаТЧ.СуммаНДС 		= СтрокаДанных.СуммаНДС;
				СтрокаТЧ.СтавкаНДС	 	= СтрокаДанных.СтавкаНДС;
				
				Если ЭтоТовар Тогда
					
					СтранаПроисхождения = СтрокаДанных.СтранаПроисхождения;
					
					Параметры = Новый Структура;
					Параметры.Вставить("ИспользуетсяУчетПрослеживаемыхТоваров",	ИспользуетсяУчетПрослеживаемыхТоваров);
					Параметры.Вставить("СтранаПроисхождения",					СтранаПроисхождения);
					Параметры.Вставить("ДокументОбъект",						ДокОбъект);
					Параметры.Вставить("СтрокаДанных",							СтрокаДанных);
					Параметры.Вставить("СтрокаТЧ",								СтрокаТЧ);
					Параметры.Вставить("ЗаполнятьСуммуПрослеживаемости",		Ложь);
					
					ЗаполнитьСведенияОПрослеживаемости(Параметры);
					ЗаполнитьСтрануПроисхождения(СтрокаТЧ, СтранаПроисхождения);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(ДокОбъектМетаданные, "ОтражатьВБухгалтерскомУчете") Тогда
		ДокОбъект.ОтражатьВБухгалтерскомУчете =	УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "ОтражатьДокументыВБухгалтерскомУчете");
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(ДокОбъектМетаданные, "ОтражатьВУправленческомУчете") Тогда
		ДокОбъект.ОтражатьВУправленческомУчете = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "ОтражатьДокументыВУправленческомУчете");
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(ДокОбъектМетаданные, "ОтражатьВНалоговомУчете") Тогда
		ДокОбъект.ОтражатьВНалоговомУчете =	УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.ТекущийПользователь, "ОтражатьДокументыВНалоговомУчете");
	КонецЕсли;
	
	ДокОбъект.СуммаВключаетНДС	= СуммаВключаетНДС;
	ДокОбъект.УчитыватьНДС 		= Истина;
	
	Возврат ДокОбъект;
	
КонецФункции

Функция СоздатьДокументВозвратТоваровОтПокупателя(параметры, стВероятныеПоля, ЭДОбъект) Экспорт
	ДокОбъект = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	//ДокОбъект.ВидОперации = Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ПродажаКомиссия;
	
	ДокОбъект.КратностьВзаиморасчетов = 1;
	
	// Заполнение возможных полей
	Если стВероятныеПоля.Организация = Неопределено Тогда
		Сообщить("Организация в системе Диадок: """ + ЭДОбъект.Organization.Name + """, ИНН/КПП: " + ЭДОбъект.Organization.Inn + "/" + ЭДОбъект.Organization.Kpp + " не ассоциирована с организацией в 1С");
	Иначе
		ДокОбъект.Организация = стВероятныеПоля.Организация;
	КонецЕсли;
	Если стВероятныеПоля.Контрагент = Неопределено Тогда
		Сообщить("Контрагент в системе Диадок: """ + ЭДОбъект.counterAgent.Name + """, ИНН/КПП: " + ЭДОбъект.counterAgent.Inn + "/" + ЭДОбъект.counterAgent.Kpp + " не ассоциирован с контрагентом в 1С");
	Иначе
		ДокОбъект.Контрагент = стВероятныеПоля.Контрагент;
	КонецЕсли;
	
	мСписокВидовДоговоров = Новый СписокЗначений;
	мСписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	//Если ДокОбъект.ВидОперации <> Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.Оборудование Тогда
	//мСписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером);
	//КонецЕсли;
	СтруктураПараметровДляПолученияДоговора=	Новый Структура();
	СтруктураПараметровДляПолученияДоговора.Вставить("СписокДопустимыхВидовДоговоров", мСписокВидовДоговоров);
	
	ЗаполнениеДокументов.ПриИзмененииЗначенияКонтрагента(ДокОбъект, СтруктураПараметровДляПолученияДоговора);
	
	Возврат ДокОбъект;
КонецФункции

