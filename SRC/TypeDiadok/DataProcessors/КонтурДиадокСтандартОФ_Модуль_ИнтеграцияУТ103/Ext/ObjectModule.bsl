// Событие возникает перед выполнением запроса по шапке документа (см. ДанныеШапки).
// Позволяет переопределить выражения полей запроса для получения данных шапки.
//
// Параметры:
//  Реквизиты			 - Структура		 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение;
//  МетаданныеИсточника	 - ОбъектМетаданных	 - Метаданные документа-источника;
//  ВидЭД 				 - Строка			 - вид подгатавливаемого электронного документа (см. Перечисление_ВидыЭД());
//
// Пример:
//		Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Грузоотправитель") Тогда 
//			
//			Реквизиты.Грузоотправитель = 
//			"ВЫБОР
//			|	КОГДА Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
//			|		ТОГДА Организация
//			|	ИНАЧЕ Грузоотправитель
//			|КОНЕЦ";
//			
//		КонецЕсли;
//
Процедура ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеИсточника, ВидЭД) Экспорт
	
	Если Реквизиты.Свойство("БанковскийСчетОрганизации")
		И Не ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеИсточника, "БанковскийСчетОрганизации")
		И ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеИсточника, "СтруктурнаяЕдиница") Тогда
		
		Реквизиты.БанковскийСчетОрганизации = 
		"ВЫБОР 
		|	КОГДА СтруктурнаяЕдиница ССЫЛКА Справочник.БанковскиеСчета
		|		ТОГДА СтруктурнаяЕдиница
		|	ИНАЧЕ НЕОПРЕДЕЛЕНО
		|КОНЕЦ";
		
	КонецЕсли;
	
	Если Реквизиты.Свойство("ДополнительныеУсловия")
		И ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеИсточника, "УсловиеПродаж") Тогда
		Реквизиты.ДополнительныеУсловия = "ПРЕДСТАВЛЕНИЕ(УсловиеПродаж)";
	КонецЕсли;
	
КонецПроцедуры

