// Заполняет колонки "ДанныеПрослеживаемости" и "ПрослеживаемыйТовар" в строках таблицы товаров
// 
// Параметры:
// ТаблицаТоваров - ТаблицаЗначений - в данном параметре передается
// СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - владелец таблицы товаров
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоРеализации(ТаблицаТоваров, СсылкаНаОбъект)
	
	СтрокиТоваров			 = ТаблицаТоваров.НайтиСтроки(Новый Структура("ЭтоУслуга", Ложь)); 
	ИдентификаторыСтрок		 = ОсновнойМодуль.ВыгрузитьКолонку(СтрокиТоваров, "ИдентификаторСтроки");
	ОсновнойМодуль.УдалитьВсеВхожденияЗначенияИзМассива(ИдентификаторыСтрок, Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяЕИ"				 , Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Ссылка"					 , СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИдентификаторыСтрок"		 , ИдентификаторыСтрок);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТТаблицаПрослеживаемостиОснования
	|ИЗ
	|	&ИмяМетаданныхТаблицыПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка
	|	И СведенияПрослеживаемости.ИдентификаторСтроки В(&ИдентификаторыСтрок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(НомераГТД.Код, """") КАК НомерГТДРегистрационныйНомер,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПоРНПТ,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТСведенияПрослеживаемостиБезИЕ
	|ИЗ
	|	&ИмяМетаданныхТаблицыТоваров КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаПрослеживаемостиОснования КАК СведенияПрослеживаемости
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|			ПО СведенияПрослеживаемости.РНПТ = НомераГТД.Ссылка
	|		ПО ТаблицаТоваров.Ссылка = СведенияПрослеживаемости.Ссылка
	|			И ТаблицаТоваров.ИдентификаторСтроки = СведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТоваров.Ссылка = &Ссылка
	|	И ТаблицаТоваров.ИдентификаторСтроки В(&ИдентификаторыСтрок)
	|	И ТаблицаТоваров.ИдентификаторСтроки <> """"
	|	И ТаблицаТоваров.ПрослеживаемыйТовар = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерГТДРегистрационныйНомер КАК НомерГТДРегистрационныйНомер,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификаторЕдиницИзмерения.Ссылка, &ПустаяЕИ) = &ПустаяЕИ
	|			ТОГДА """"
	|		ИНАЧЕ КлассификаторЕдиницИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияПрослеживаемости,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификаторЕдиницИзмерения.Ссылка, &ПустаяЕИ) = &ПустаяЕИ
	|			ТОГДА """"
	|		ИНАЧЕ КлассификаторЕдиницИзмерения.Код
	|	КОНЕЦ КАК КодЕдиницыИзмеренияПрослеживаемости,
	|	ТаблицаТоваров.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ВТСведенияПрослеживаемостиБезИЕ КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|				ПО КлассификаторТНВЭД.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|			ПО СправочникНоменклатура.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|		ПО ТаблицаТоваров.Номенклатура = СправочникНоменклатура.Ссылка";
	
	ИмяДокумента = СсылкаНаОбъект.Метаданные().Имя;
	ИмяМетаданныхТаблицыТоваров = СтрЗаменить("Документ.%ИмяДокумента%.Товары", "%ИмяДокумента%", ИмяДокумента);
	ИмяМетаданныхТаблицыПрослеживаемости = СтрЗаменить("Документ.%ИмяДокумента%.СведенияПрослеживаемости", "%ИмяДокумента%", ИмяДокумента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяМетаданныхТаблицыТоваров"				, ИмяМетаданныхТаблицыТоваров);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяМетаданныхТаблицыПрослеживаемости"	, ИмяМетаданныхТаблицыПрослеживаемости);
	
	СведенияПрослеживаемости = Запрос.Выполнить().Выгрузить();
	СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
	
	Для Каждого СтрокаТЧ Из СтрокиТоваров Цикл
		
		СтрокиПрослеживаемости = СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтроки));
		
		Если СтрокиПрослеживаемости.Количество() > 0 Тогда
		
			СтрокаТЧ.ДанныеПрослеживаемости	 = Новый Массив;
			СтрокаТЧ.ПрослеживаемыйТовар	 = Истина;
			
			Для каждого СтрокаПрослеживаемости Из СтрокиПрослеживаемости Цикл
				
				ЭлементПрослеживаемости = ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").НовыеСвойстваЭлементаПрослеживаемости();
				ЗаполнитьЗначенияСвойств(ЭлементПрослеживаемости, СтрокаПрослеживаемости);
				СтрокаТЧ.ДанныеПрослеживаемости.Добавить(ЭлементПрослеживаемости);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет колонки "ДанныеПрослеживаемости" и "ПрослеживаемыйТовар" в строках таблицы товаров
// 
// Параметры:
// ТаблицаТоваров - ТаблицаЗначений - в данном параметре передается
// СсылкаНаОбъект - ДокументСсылка.КорректировкаРеализации - владелец таблицы товаров
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(ТаблицаТоваров, СсылкаНаОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.ИдентификаторСтроки,
	|	МАКСИМУМ(Товары.КодТНВЭД.ЕдиницаИзмерения) КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ЕдиницыИзмерения
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СУММА(СведенияПрослеживаемости.Количество) КАК Количество,
	|	СУММА(СведенияПрослеживаемости.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.Ссылка.ДокументРеализации КАК ДокументОснование,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.КорректировкаРеализации.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка
	|	И СведенияПрослеживаемости.ИдентификаторСтроки В(&ИдентификаторыСтрок)
	|
	|СГРУППИРОВАТЬ ПО
	|	СведенияПрослеживаемости.РНПТ,
	|	СведенияПрослеживаемости.Ссылка,
	|	СведенияПрослеживаемости.Ссылка.ДокументРеализации,
	|	СведенияПрослеживаемости.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СУММА(СведенияПрослеживаемости.Количество) КАК Количество,
	|	СУММА(СведенияПрослеживаемости.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ДанныеОснований
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &ДокументОснование
	|
	|СГРУППИРОВАТЬ ПО
	|	СведенияПрослеживаемости.Ссылка,
	|	СведенияПрослеживаемости.РНПТ,
	|	СведенияПрослеживаемости.ИдентификаторСтроки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СведенияПрослеживаемости.Ссылка,
	|	СведенияПрослеживаемости.РНПТ,
	|	СУММА(СведенияПрослеживаемости.Количество),
	|	СУММА(СведенияПрослеживаемости.КоличествоПрослеживаемости),
	|	СведенияПрослеживаемости.ИдентификаторСтроки
	|ИЗ
	|	Документ.КорректировкаРеализации.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &ДокументОснование
	|
	|СГРУППИРОВАТЬ ПО
	|	СведенияПрослеживаемости.Ссылка,
	|	СведенияПрослеживаемости.РНПТ,
	|	СведенияПрослеживаемости.ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ТаблицаДокумента.РНПТ, ДанныеОснований.РНПТ) КАК НомерГТДРегистрационныйНомер,
	|	ЕСТЬNULL(ТаблицаДокумента.Количество, 0) КАК КоличествоПослеИзменения,
	|	ЕСТЬNULL(ДанныеОснований.Количество, 0) КАК КоличествоДоИзменения,
	|	ЕСТЬNULL(ТаблицаДокумента.ИдентификаторСтроки, ДанныеОснований.ИдентификаторСтроки) КАК ИдентификаторСтроки
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеОснований КАК ДанныеОснований
	|		ПО ТаблицаДокумента.РНПТ = ДанныеОснований.РНПТ
	|			И ТаблицаДокумента.ДокументОснование = ДанныеОснований.Ссылка
	|			И ТаблицаДокумента.ИдентификаторСтроки = ДанныеОснований.ИдентификаторСтроки
	|ИТОГИ
	|	СУММА(КоличествоПослеИзменения),
	|	СУММА(КоличествоДоИзменения)
	|ПО
	|	ИдентификаторСтроки,
	|	НомерГТДРегистрационныйНомер";

	СтрокиТоваров			 = ТаблицаТоваров.НайтиСтроки(Новый Структура("ЭтоУслуга", Ложь)); 
	ИдентификаторыСтрок		 = ОсновнойМодуль.ВыгрузитьКолонку(СтрокиТоваров, "ИдентификаторСтроки");
	Запрос.УстановитьПараметр("Ссылка"				 , СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИдентификаторыСтрок"	 , ИдентификаторыСтрок);
	Запрос.УстановитьПараметр("ДокументОснование"	 , СсылкаНаОбъект.ДокументРеализации);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИдентификаторСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИдентификаторСтроки.Следующий() Цикл
		
		СтрокаТовара = ТаблицаТоваров.Найти(ВыборкаИдентификаторСтроки.ИдентификаторСтроки, "ИдентификаторСтроки");
		
		Если СтрокаТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовара.ДанныеПрослеживаемости		 = Новый Массив;
		СтрокаТовара.ПрослеживаемыйТовар		 = Истина;
		
		ВыборкаРегистрационныйНомер = ВыборкаИдентификаторСтроки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаРегистрационныйНомер.Следующий() Цикл

			СтрокаПрослеживаемости =  ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").НовыеСвойстваЭлементаПрослеживаемостиПоКорректировке();
			ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, ВыборкаРегистрационныйНомер);
			СтрокаПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости = СтрокаТовара.КодЕдиницыИзмерения;
			
			ЭтоУменьшение = СтрокаПрослеживаемости.КоличествоДоИзменения > СтрокаПрослеживаемости.КоличествоПослеИзменения; 
			Если ЭтоУменьшение Тогда
				КоличествоУменьшение = СтрокаПрослеживаемости.КоличествоДоИзменения - СтрокаПрослеживаемости.КоличествоПослеИзменения;
				СтрокаПрослеживаемости.КоличествоУменьшение = КоличествоУменьшение;
			КонецЕсли; 
			
			ЭтоУвеличение = СтрокаПрослеживаемости.КоличествоПослеИзменения > СтрокаПрослеживаемости.КоличествоДоИзменения;
			Если ЭтоУвеличение Тогда
				КоличествоУвеличение = СтрокаПрослеживаемости.КоличествоПослеИзменения - СтрокаПрослеживаемости.КоличествоДоИзменения;
				СтрокаПрослеживаемости.КоличествоУвеличение = КоличествоУвеличение;
			КонецЕсли; 
			
			СтрокаТовара.ДанныеПрослеживаемости.Добавить(СтрокаПрослеживаемости);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет СведенияОПрослеживаемости документа по данным строки товара электронного документа
//
// Параметры
//  Приемник				- ТабличнаяЧасть		- таблица СведенияОПрослеживаемости документа 1С
//  Источник				- Массив				- массив элементов СведПрослеж
//  СтрокаТовара			- СтрокаТабличнойЧасти 	- строка товара документа
//  ЗаполнятьСумму			- Булево				- признак необходимости заполнения суммы в сведениях прослеживаемости
//
Процедура ЗаполнитьСведенияОПрослеживаемостиДляСтрокиДокументаИБ_УПД(Приемник, Источник, СтрокаТовара, ЗаполнятьСумму)
	
	СтрокаТовара.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	СтрокаТовара.ПрослеживаемыйТовар = Истина;
	
	СведенияПрослеживаемостиИБ = Приемник.ВыгрузитьКолонки();
	
	ЕстьПолеСуммы = (СведенияПрослеживаемостиИБ.Колонки.Найти("Сумма") <> Неопределено);
	
	Для Каждого СтрокаПрослеживаемости Из Источник Цикл
		
		НомерТовара = СтрокаПрослеживаемости.НомТовПрослеж;
		
		НоваяСтрока = СведенияПрослеживаемостиИБ.Добавить();
		НоваяСтрока.ИдентификаторСтроки = СтрокаТовара.ИдентификаторСтроки;
		НоваяСтрока.РНПТ = НайтиСоздатьРНПТ(НомерТовара);
		НоваяСтрока.КоличествоПрослеживаемости = СтрокаПрослеживаемости.КолВЕдПрослеж;
		НоваяСтрока.Количество = Неопределено;
		
		Если ЕстьПолеСуммы И ЗаполнятьСумму Тогда
			НоваяСтрока.Сумма = СтрокаПрослеживаемости.СтТовБезНДСПрослеж;
		КонецЕсли;
		
	КонецЦикла;
	
	ПроизвестиРасчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемостиИБ, СтрокаТовара.Количество);
	
	ОсновнойМодуль.ДополнитьТаблицу(Приемник, СведенияПрослеживаемостиИБ);
	
КонецПроцедуры

// Заполняет СведенияОПрослеживаемости документа по данным строки товара электронного документа
//
// Параметры
//  Приемник				- ТабличнаяЧасть		- таблица СведенияОПрослеживаемости документа 1С
//  Источник				- Массив				- массив элементов СведПрослеж
//  Товары 					- ТаблицаЗначений	 	- таблица товаров документа
//
Процедура ЗаполнитьСведенияОПрослеживаемостиДляДокументаИБ_УКД(Приемник, Источник, Товары)

	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Приемник.ВыгрузитьКолонки();
	
	СведПрослежИБ = Приемник.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СведПрослежИБ", СведПрослежИБ);
	Запрос.УстановитьПараметр("СведПрослежЭД", Источник);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.Количество КАК Количество,
		|	СведПрослежИБ.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ СведПрослежИБ
		|ИЗ
		|	&СведПрослежИБ КАК СведПрослежИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежЭД.КоличествоУвеличение КАК КоличествоУвеличение,
		|	СведПрослежЭД.КоличествоУменьшение КАК КоличествоУменьшение,
		|	СведПрослежЭД.РНПТ КАК РНПТ,
		|	СведПрослежЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ СведПрослежЭД
		|ИЗ
		|	&СведПрослежЭД КАК СведПрослежЭД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.КоличествоПрослеживаемости - СведПрослежЭД.КоличествоУменьшение + СведПрослежЭД.КоличествоУвеличение КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ СкорректированныеСтрокиПоДаннымЭД
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СведПрослежЭД КАК СведПрослежЭД
		|		ПО СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки
		|			И СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ,
		|	СведПрослежИБ.КоличествоПрослеживаемости
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ СведПрослежЭД КАК СведПрослежЭД
		|		ПО СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки
		|			И СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ
		|ГДЕ
		|	СведПрослежЭД.ИдентификаторСтроки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежЭД.РНПТ КАК РНПТ,
		|	СведПрослежЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ НовыеСтрокиПоДаннымЭД
		|ИЗ
		|	СведПрослежЭД КАК СведПрослежЭД
		|		ЛЕВОЕ СОЕДИНЕНИЕ СведПрослежИБ КАК СведПрослежИБ
		|		ПО (СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки)
		|			И (СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ)
		|ГДЕ
		|	СведПрослежИБ.РНПТ ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СкорректированныеСтрокиПоДаннымЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СкорректированныеСтрокиПоДаннымЭД.РНПТ КАК РНПТ,
		|	0 КАК Количество,
		|	СкорректированныеСтрокиПоДаннымЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ИЗ
		|	СкорректированныеСтрокиПоДаннымЭД КАК СкорректированныеСтрокиПоДаннымЭД
		|ГДЕ
		|	СкорректированныеСтрокиПоДаннымЭД.КоличествоПрослеживаемости <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НовыеСтрокиПоДаннымЭД.ИдентификаторСтроки,
		|	НовыеСтрокиПоДаннымЭД.РНПТ,
		|	0,
		|	НовыеСтрокиПоДаннымЭД.КоличествоПрослеживаемости
		|ИЗ
		|	НовыеСтрокиПоДаннымЭД КАК НовыеСтрокиПоДаннымЭД
		|ИТОГИ ПО
		|	ИдентификаторСтроки";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИдентификаторСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИдентификаторСтроки.Следующий() Цикл
		
		СведенияПрослеживаемости = Результат.СкопироватьКолонки();
		
		Выборка = ВыборкаИдентификаторСтроки.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;
		
		СтрокиТоваров = Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаИдентификаторСтроки.ИдентификаторСтроки));
		Для каждого СтрокаТовара Из СтрокиТоваров Цикл
			СтрокаТовара.ПрослеживаемыйТовар = Истина;
		КонецЦикла;
		
		ПроизвестиРасчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, СтрокиТоваров[0].Количество);
		ОсновнойМодуль.ДополнитьТаблицу(Результат, СведенияПрослеживаемости);
		
	КонецЦикла;
	
	Приемник.Загрузить(Результат);
	
КонецПроцедуры

Процедура ПроизвестиРасчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, КоличествоТовара)
	
	// Обрабатываем по аналогии с типовой БП.
	// Возможные варианты:
	
	// 1. Учетное количество было заполнено из данных электронного документа. Рассчитывать не нужно.
	// Данный сценарий на текущий момент не поддерживается.
	Если СведенияПрослеживаемости.Итог("Количество") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоКоличествоПрослеживаемости = СведенияПрослеживаемости.Итог("КоличествоПрослеживаемости");
	
	// 2. Если общее количество прослеживаемости совпадает с количеством товара, то предполагаем, что единица измерения прослеживаемости совпадает
	// с учетной единицей измерения. В этом случае количество учетное приравниваем количеству прослеживаемости.
	Если ВсегоКоличествоПрослеживаемости = КоличествоТовара Тогда
		Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
			ЭлементКоллекции.Количество = ЭлементКоллекции.КоличествоПрослеживаемости;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	// 3. Требуется произвести пропорциональное распределение
	СведенияПрослеживаемости.Колонки.Добавить("Порядок");
	
	Порядок = 0;
	Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
		Порядок = Порядок + 1;
		ЭлементКоллекции.Порядок = Порядок;
	КонецЦикла;
	
	СведенияПрослеживаемости.Сортировать("КоличествоПрослеживаемости");
	Распределено = 0;
	Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
		Если СведенияПрослеживаемости.Индекс(ЭлементКоллекции) + 1 = СведенияПрослеживаемости.Количество() Тогда
			ЭлементКоллекции.Количество = КоличествоТовара - Распределено;
		Иначе 
			ЭлементКоллекции.Количество = ?(ВсегоКоличествоПрослеживаемости = 0, 0,
				ЭлементКоллекции.КоличествоПрослеживаемости * КоличествоТовара / ВсегоКоличествоПрослеживаемости);
			Распределено = Распределено + ЭлементКоллекции.Количество;
		КонецЕсли;
	КонецЦикла;
	
	СведенияПрослеживаемости.Сортировать("Порядок");
		
КонецПроцедуры

Функция НайтиСоздатьРНПТ(РегистрационныйНомер)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(РегистрационныйНомер) Тогда
		
		Результат = НайтиСсылкуНаОбъектПоРеквизиту(Метаданные.Справочники.НомераГТД, "РегистрационныйНомер", РегистрационныйНомер);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = НайтиСсылкуНаОбъектПоРеквизиту(Метаданные.Справочники.НомераГТД, "Код", РегистрационныйНомер);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			НовыйРНПТ = Справочники.НомераГТД.СоздатьЭлемент();
			НовыйРНПТ.Код = РегистрационныйНомер;
			НовыйРНПТ.РегистрационныйНомер = РегистрационныйНомер;
			НовыйРНПТ.Записать();
			Результат = НовыйРНПТ.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция НайтиСсылкуНаОбъектПоРеквизиту(ОбъектМетаданных, ИмяРеквизита, ЗначРеквизита)
	
	Результат = МенеджерИнтеграции().НайтиСсылкуНаОбъектПоРеквизиту(ОбъектМетаданных, ИмяРеквизита, ЗначРеквизита);
	
	Возврат Результат;
	
КонецФункции

