// Событие позволяет переопределить алгоритм вычисления вида контактной информации,
// соответствующего юр./физ. лицу и указанному типу контактной информации.
//
// Параметры:
//  ВидКИ - СправочникСсылка.ВидыКонтактнойИнформации - вид контактной информации;
//  ЮрФизЛицо - ЛюбаяСсылка	 - объект-владелец контактной информации;
//  ТипКИ - Строка - тип контактной информации (см. Перечисление_ВидыКИ);
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события;
//
// Пример:
//		
//		Если ТипКИ = Перечисление_ВидыКИ().ЮридическийАдрес Тогда
//			ВидКИ = Справочники.ВидыКонтактнойИнформации.АдресЮридический;
//		ИначеЕсли ТипКИ = Перечисление_ВидыКИ().ФактическийАдрес Тогда
//			ВидКИ = Справочники.ВидыКонтактнойИнформации.АдресФактический;
//		КонецЕсли;
//		
//		Если ЗначениеЗаполнено(ВидКИ) Тогда
//			СтандартнаяОбработка = Ложь;
//		КонецЕсли;
//
Процедура ПриПолученииВидаКонтактнойИнформации(ВидКИ, ЮрФизЛицо, ТипКИ, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
		ПринадлежностьАдреса = "Организации";
	ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		ПринадлежностьАдреса = "Контрагента";
	КонецЕсли;
	
	Если ТипКИ = Перечисление_ВидыКИ().ЮридическийАдрес Тогда
		ВидаАдреса = "ЮрАдрес";
	ИначеЕсли ТипКИ = Перечисление_ВидыКИ().ФактическийАдрес Тогда
		ВидаАдреса = "ФактАдрес";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидаАдреса) И ЗначениеЗаполнено(ПринадлежностьАдреса) Тогда
		ИмяВидаКИ	 = ВидаАдреса + ПринадлежностьАдреса;
		ВидКИ		 = Справочники.ВидыКонтактнойИнформации[ИмяВидаКИ];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидКИ) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

