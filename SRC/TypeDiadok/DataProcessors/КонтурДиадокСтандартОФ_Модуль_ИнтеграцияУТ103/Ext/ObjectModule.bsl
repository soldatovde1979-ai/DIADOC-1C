Процедура ПроверитьЗаполнитьОснованиеКорректировкиПоступления(ПараметрыСоздания, ШапкаЭД, ФорматЭД)
	
	Если ЗначениеЗаполнено(ПараметрыСоздания.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ФорматыЭД = МодульФорматыЭлектронныхДокументов();
	
	ТипыОснований = Новый Массив;
	
	Если ФорматыЭД.ЭтоУниверсальныйКорректировочныйДокумент(ФорматЭД)
		Или ФорматыЭД.ЭтоКорректировочныйСчетФактура(ФорматЭД) Тогда
		
		ТипыОснований.Добавить("СчетФактураПолученный");
		
	ИначеЕсли ФорматыЭД.ЭтоСоглашениеОбИзмененииСтоимости(ФорматЭД) Тогда
		
		ТипыОснований.Добавить("ПоступлениеТоваровУслуг");
		ТипыОснований.Добавить("ПоступлениеДопРасходов");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипыОснований) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ПараметрыСоздания.Организация;
	Контрагент = ПараметрыСоздания.Контрагент;
	НомерЭД = ШапкаЭД.Номер;
	ДатаЭД = ШапкаЭД.Дата;
	
	Для Каждого ВидДокумента Из ТипыОснований Цикл
		
		СсылкаНаОбъект = НайтиДокументПоРеквизитам(
			ВидДокумента,
			Организация,
			Контрагент,
			ДатаЭД,
			НомерЭД
		);
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			
			Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СсылкаНаОбъект = СсылкаНаОбъект.ДокументОснование;
			КонецЕсли;
			
			ПараметрыСоздания.ДокументОснование = СсылкаНаОбъект;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиДокументПоРеквизитам(ВидДокумента, Организация, Контрагент, ДатаВходящегоДокумента, НомерВходящегоДокумента)
	
	ШаблонЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Дата КАК Дата
	|ИЗ
	|	&ПолноеИмяТаблицы КАК Таблица
	|ГДЕ
	|	НЕ Таблица.ПометкаУдаления
	|	И Таблица.Организация = &Организация
	|	И Таблица.Контрагент = &Контрагент
	|	И Таблица.ДатаВходящегоДокумента = &ДатаДокумента
	|	И Таблица.НомерВходящегоДокумента = &НомерДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	ПолноеИмяТаблицы = "Документ." + ВидДокумента;
	ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаВходящегоДокумента);
	Запрос.УстановитьПараметр("НомерДокумента", НомерВходящегоДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

