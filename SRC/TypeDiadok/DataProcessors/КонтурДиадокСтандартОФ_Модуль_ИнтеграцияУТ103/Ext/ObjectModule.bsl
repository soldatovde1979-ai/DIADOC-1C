Процедура ЗаполнитьТабличнуюЧастьВозвратОтПокупателя(ДокументОбъект, ТабличнаяЧасть)

	ВладелецНоменклатуры = ДокументОбъект.Контрагент;
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров(ДокументОбъект.Дата);
	
	МетаданныеОбъекта = ДокументОбъект.Метаданные();
	
	Для Каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		НоменклатураИБ = СтрокаДанных.НоменклатураИнформационнойБазы;
		
		Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура	= НоменклатураИБ.Номенклатура;
			Характеристика	= НоменклатураИБ.Характеристика;
		Иначе
			Номенклатура	= Неопределено;
			Характеристика	= Неопределено;
		КонецЕсли;
		
		СтрокаТЧ = ДокументОбъект.Товары.Добавить();
		СтрокаТЧ.Номенклатура				= Номенклатура;
		СтрокаТЧ.ХарактеристикаНоменклатуры	= Характеристика;
		СтрокаТЧ.ЕдиницаИзмерения			= ЕдиницаИзмеренияНоменклатуры(Номенклатура, СтрокаДанных.КодЕдИзм);
		СтрокаТЧ.Коэффициент				= 1;
		
		Количество = СтрокаДанных.Количество;
		
		Если Не ЗначениеЗаполнено(Количество) Тогда
			Количество = 1;
		КонецЕсли;
		
		СтрокаТЧ.Количество = Количество;
		
		СтранаПроисхождения = НайтиСоздатьСтрануПроисхождения(СтрокаДанных.КодСтраны);
		
		Параметры = Новый Структура;
		Параметры.Вставить("ИспользуетсяУчетПрослеживаемыхТоваров",	ИспользуетсяУчетПрослеживаемыхТоваров);
		Параметры.Вставить("СтранаПроисхождения",					СтранаПроисхождения);
		Параметры.Вставить("ДокументОбъект",						ДокументОбъект);
		Параметры.Вставить("СтрокаДанных",							СтрокаДанных);
		Параметры.Вставить("СтрокаТЧ",								СтрокаТЧ);
		Параметры.Вставить("ЗаполнятьСуммуПрослеживаемости",		Истина);
		
		ЗаполнитьСведенияОПрослеживаемости(Параметры);
		
		ЗаполнитьСтрануПроисхождения(СтрокаТЧ, СтранаПроисхождения);
		
		Сумма	= СтрокаДанных.СуммаБезНДС;
		Цена	= СтрокаДанных.Цена;
		
		Если ДокументОбъект.СуммаВключаетНДС Тогда
			Сумма	= СтрокаДанных.СуммаСНДС;
			Цена	= Сумма / Количество;
		КонецЕсли;
		
		СтрокаТЧ.Цена		= Цена;
		СтрокаТЧ.Сумма		= Сумма;
		СтрокаТЧ.СуммаНДС	= СтрокаДанных.СуммаНДС;
		СтрокаТЧ.СтавкаНДС	= ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуКорректировкиПоступления(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	ЗаполнитьПоДокументуОснованию(ДокументОбъект, ПараметрыСоздания.ДокументОснование);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьВидКорректировки(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьКорректировкиПоступления(ДокументОбъект, ТабличнаяЧасть)
	
	ТабличныеЧастиДляЗаполнения = Новый Структура("Товары, Услуги", "Товары", "Услуги");

	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров(ДокументОбъект.Дата);
	Если ИспользуетсяУчетПрослеживаемыхТоваров Тогда
		
		ОписаниеЧисло	 = Новый ОписаниеТипов("Число");
		
		СведенияПрослеживаемости = ДокументОбъект.СведенияПрослеживаемости.ВыгрузитьКолонки();
		СведенияПрослеживаемости.Колонки.Добавить("КоличествоУвеличение", ОписаниеЧисло);
		СведенияПрослеживаемости.Колонки.Добавить("КоличествоУменьшение", ОписаниеЧисло);
		
	КонецЕсли;
	
	ВладелецНоменклатуры = ДокументОбъект.Контрагент;
	
	ОбработанныеСтроки = Новый Массив;
	
	Для Каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		НоменклатураНаименование = СтрокаДанных.Наименование;
		
		НоменклатураИБ = СтрокаДанных.НоменклатураИнформационнойБазы;
		
		Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура = НоменклатураИБ.Номенклатура;
			Характеристика= НоменклатураИБ.Характеристика;
		КонецЕсли;
		
		Если Характеристика = Неопределено Тогда
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		КонецЕсли; 
		
		Если Номенклатура = Неопределено Тогда
			Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;
		
		РеквизитыНоменклатуры	 = РеквизитыНоменклатурыИнформационнойБазы(Номенклатура);
		ЭтоУслуга				 = РеквизитыНоменклатуры.Услуга;
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("Номенклатура"					, Номенклатура);
		СтруктураЗаполнения.Вставить("Количество"					, СтрокаДанных.Количество);
		СтруктураЗаполнения.Вставить("КоличествоДоИзменения"		, СтрокаДанных.Количество_До);
		СтруктураЗаполнения.Вставить("Цена"							, СтрокаДанных.Цена);
		СтруктураЗаполнения.Вставить("ЦенаДоИзменения"				, СтрокаДанных.Цена_До);
		СтруктураЗаполнения.Вставить("Сумма"						, СтрокаДанных.СуммаБезНДС);
		СтруктураЗаполнения.Вставить("СуммаДоИзменения"				, СтрокаДанных.СуммаБезНДС_До);
		СтруктураЗаполнения.Вставить("СуммаНДС"						, СтрокаДанных.СуммаНДС);
		СтруктураЗаполнения.Вставить("СуммаНДСДоИзменения"			, СтрокаДанных.СуммаНДС_До);
		СтруктураЗаполнения.Вставить("СтавкаНДС"					, ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС_До));
		СтруктураЗаполнения.Вставить("СтавкаНДСДоИзменения"			, ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС_До));
		СтруктураЗаполнения.Вставить("Коэффициент"					, 1);
		
		ПоляПоиска = "Номенклатура, СтавкаНДС";
		
		Если ЭтоУслуга Тогда
			
			ИмяТЧ = "Услуги";
			СтруктураЗаполнения.Вставить("Содержание"				, НоменклатураНаименование);
			СтруктураЗаполнения.Вставить("СодержаниеДоИзменения"	, НоменклатураНаименование);
			
		Иначе
			
			ИмяТЧ = "Товары";
			ПоляПоиска = ПоляПоиска + ",ХарактеристикаНоменклатуры,ЕдиницаИзмерения";
			
			СтруктураЗаполнения.Вставить("ХарактеристикаНоменклатуры"	, Характеристика);
			СтруктураЗаполнения.Вставить("ЕдиницаИзмерения"				, ЕдиницаИзмеренияНоменклатуры(Номенклатура, СтрокаДанных.КодЕдИзм));
			
			Коэффициент = СтруктураЗаполнения.ЕдиницаИзмерения.Коэффициент;
			Если ЗначениеЗаполнено(Коэффициент) Тогда
				СтруктураЗаполнения.Коэффициент = Коэффициент;
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаТЧ = Неопределено;
		
		//Найдем исходную строку в документе корректировки
		СтруктураПоиска = Новый Структура(ПоляПоиска);
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтруктураЗаполнения);
		
		ТабличнаяЧастьДокумента = ДокументОбъект[ИмяТЧ];
		СтрокиДокумента = ТабличнаяЧастьДокумента.НайтиСтроки(СтруктураПоиска);
		Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
			
			Если ОбработанныеСтроки.Найти(СтрокаДокумента) = Неопределено Тогда
				СтрокаТЧ = СтрокаДокумента;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		// Такой строки в документе корректировки нет - добавляем.
		Если СтрокаТЧ = Неопределено Тогда
			СтрокаТЧ = ТабличнаяЧастьДокумента.Добавить();
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураЗаполнения);
		
		// Проослеживаемость
		Если ИспользуетсяУчетПрослеживаемыхТоваров
			И НЕ ЭтоУслуга Тогда
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
				СтрокаТЧ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
			
			Для Каждого СведПрослеж Из СтрокаДанных.СведенияПрослеживаемости Цикл
				
				СтрокаПрослеживаемости = СведенияПрослеживаемости.Добавить();
				СтрокаПрослеживаемости.РНПТ							= НайтиСоздатьРНПТ(СведПрослеж.НомТовПрослеж);
				СтрокаПрослеживаемости.КоличествоПрослеживаемости	= СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТПосле;
				СтрокаПрослеживаемости.КоличествоУвеличение			= СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТУвел;
				СтрокаПрослеживаемости.КоличествоУменьшение			= СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТУм;
				СтрокаПрослеживаемости.ИдентификаторСтроки			= СтрокаТЧ.ИдентификаторСтроки;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОбработанныеСтроки.Добавить(СтрокаТЧ);
		
	КонецЦикла;
	
	Если ИспользуетсяУчетПрослеживаемыхТоваров Тогда
		ЗаполнитьСведенияОПрослеживаемостиДляДокументаИБ_УКД(ДокументОбъект.СведенияПрослеживаемости, СведенияПрослеживаемости, ДокументОбъект.Товары);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуСчетаФактурыПолученного(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	ЗаполнитьПоДокументуОснованию(ДокументОбъект, ПараметрыСоздания.ДокументОснование);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьРеквизитыИсправленияВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьОбщиеРеквизитыСчетаФактуры(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеРеквизитыСчетаФактурыПолученного(ДокументОбъект, ДанныеЭД, ФорматЭД)

	ЭтоСчетФактураНаАванс	= ДанныеЭД.ЭтоАванс;
	Итоги					= ДанныеЭД.Итоги;

	ДокументОбъект.СуммаДокумента		= Итоги.СуммаВсего;
	ДокументОбъект.СуммаНДСДокумента	= Итоги.СуммаНДС;
	
	Если ЭтоСчетФактураНаАванс Тогда
		
		Для Каждого СтрокаСФ Из ДанныеЭД.ТабличнаяЧасть Цикл
			
			НоваяСтрокаАвансы = ДокументОбъект.Авансы.Добавить();
			
			НоваяСтрокаАвансы.Сумма		= СтрокаСФ.СуммаСНДС;
			НоваяСтрокаАвансы.СуммаНДС	= СтрокаСФ.СуммаНДС;
			НоваяСтрокаАвансы.СтавкаНДС	= ПолучитьСтавкуНДСДиадок(СтрокаСФ.СтавкаНДС);
			
		КонецЦикла;
		
		ДокументОбъект.КодВидаОперации = "02";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаАванс;
		
	Иначе
		
		ДокументОбъект.КодВидаОперации = "01";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаПоступление;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеРеквизитыКорректировочногоСчетаФактурыПолученного(ДокументОбъект, ДанныеЭД, ФорматЭД)

	ЭтоСчетФактураНаАванс	= ДанныеЭД.ЭтоАванс;	
	ИтогиУменьшение			= ДанныеЭД.ИтогиУменьшение;
	ИтогиУвеличение			= ДанныеЭД.ИтогиУвеличение;
	
	ДокументОбъект.СуммаУменьшение		= ИтогиУменьшение.СуммаВсего;
	ДокументОбъект.СуммаНДСУменьшение	= ИтогиУменьшение.СуммаНДС;
	
	ДокументОбъект.СуммаУвеличение		= ИтогиУвеличение.СуммаВсего;
	ДокументОбъект.СуммаНДСУвеличение	= ИтогиУвеличение.СуммаНДС;
	
	Если ЭтоСчетФактураНаАванс Тогда
		ДокументОбъект.КодВидаОперации = "02";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.КорректировочныйНаАванс;
	Иначе
		ДокументОбъект.КодВидаОперации = "01";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьОбщиеРеквизитыСчетаФактуры(ДокументОбъект)

	ДокументОбъект.КодСпособаПолучения = 2;
	
	Если ДокументОбъект.ДокументыОснования.Количество() = 0 Тогда
		ДокументОбъект.ДокументыОснования.Добавить().ДокументОснование = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьШапкуПоступленияДопРасходов(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	УстановитьПараметрыУчетаНДС(ДокументОбъект, ПараметрыСоздания.ЦенаВключаетНДС);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьДоговорСПоставщиком(ДокументОбъект);
	
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	
	УстановитьВидОперацииПоступленияДопРасходов(ДокументОбъект);
	УстановитьПараметрыОтраженияДокументаВУчете(ДокументОбъект);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьПодразделениеДокумента(ДокументОбъект);
	УстановитьВалютуДокумента(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьШапкуПоступленияДопРасходовПоТабличнойЧасти(ДокументОбъект, ТабличнаяЧастьЭД)
	
	Если Не ЗначениеЗаполнено(ТабличнаяЧастьЭД) Тогда
		Возврат;
	КонецЕсли;
	
	СуммаСНалогом = 0;
	СуммаНалога = 0;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Для Каждого СтрокаДанных Из ТабличнаяЧастьЭД Цикл
		
		СуммаСНалогом = СуммаСНалогом + ТипЧисло.ПривестиЗначение(СтрокаДанных.СуммаСНДС);
		СуммаНалога = СуммаНалога + ТипЧисло.ПривестиЗначение(СтрокаДанных.СуммаНДС);
		
	КонецЦикла;
	
	СуммаБезНалога = СуммаСНалогом - СуммаНалога;
	
	ПерваяСтрокаТЧ = ТабличнаяЧастьЭД[0];
	ДокументОбъект.СтавкаНДС = ПолучитьСтавкуНДСДиадок(ПерваяСтрокаТЧ.СтавкаНДС);
	ДокументОбъект.Содержание = ПерваяСтрокаТЧ.Наименование;
	ДокументОбъект.СуммаДокумента = СуммаСНалогом;
	ДокументОбъект.СуммаНДС = СуммаНалога;
	ДокументОбъект.Сумма = СуммаБезНалога;
	
	Если ДокументОбъект.СуммаВключаетНДС Тогда
		ДокументОбъект.Сумма = СуммаСНалогом;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуАктаСверкиВзаиморасчетов(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента, ИтогиТЧ)
	
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	
	УстановитьРеквизитыСверкиВзаиморасчетов(ДокументОбъект, РеквизитыЭлектронногоДокумента, ИтогиТЧ);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьАктаСверкиВзаиморасчетов(ДокументОбъект, ТабличнаяЧастьЭД)
	
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		
		ДоговорКонтрагента = ДоговорПоСтрокеАктаСверки(ДокументОбъект, СтрокаДоговора);
		
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ДокументОбъект.ПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.ДоговорКонтрагента = ДоговорКонтрагента;
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.Представление = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьРеквизитыСверкиВзаиморасчетов(ДокументОбъект, РеквизитыЭлектронногоДокумента, ИтогиТЧ)
	
	ДокументОбъект.ВалютаДокумента = ВалютаРегламентированногоУчета();
	ДокументОбъект.ОстатокНаНачало = ИтогиТЧ.СальдоНачДеб - ИтогиТЧ.СальдоНачКр;
	ДокументОбъект.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ДокументОбъект.СверкаСогласована = Ложь;
	
	ДокументОбъект.ДатаНачала = РеквизитыЭлектронногоДокумента.ДатаНачала;
	ДокументОбъект.Датаокончания = РеквизитыЭлектронногоДокумента.Датаокончания;
	
КонецПроцедуры

Функция ДоговорПоСтрокеАктаСверки(ДокументОбъект, ДанныеДоговора)
	
	Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Организация = ДокументОбъект.Организация;
	Контрагент = ДокументОбъект.Контрагент;
	НомерДоговора = ДанныеДоговора.Номер;
	ДатаДоговора = ДанныеДоговора.Дата;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДоговорПоСтрокеАктаСверки();
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Дата", ДатаДоговора);
	Запрос.УстановитьПараметр("Номер", НомерДоговора);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДоговорПоСтрокеАктаСверки()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТаблицаДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ТаблицаДоговорыКонтрагентов
	|ГДЕ
	|	ТаблицаДоговорыКонтрагентов.Организация = &Организация
	|	И ТаблицаДоговорыКонтрагентов.Владелец = &Контрагент
	|	И ТаблицаДоговорыКонтрагентов.Дата = &Дата
	|	И ТаблицаДоговорыКонтрагентов.Номер = &Номер
	|	И НЕ ТаблицаДоговорыКонтрагентов.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыНоменклатурыИнформационнойБазы(Номенклатура)
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Услуга");
	ТребуемыеРеквизиты.Вставить("СтатьяЗатрат");
	ТребуемыеРеквизиты.Вставить("НоменклатурнаяГруппа");
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ТребуемыеРеквизиты);
	Иначе
		Результат = ТребуемыеРеквизиты;
		Результат.Услуга = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕдиницаИзмеренияПоКлассификатору(КодЕИ)
	
	Результат = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(КодЕИ);
