// Заполняет список правил создания и заполнения документов учета.
//
// Параметры:
//  ПравилаСоздания - СписокЗначений - (возвращаемый параметр) идентификаторы правил создания и их представления.
//  ФорматЭД - Структура - см. ОсновнойМодуль.НовоеОписаниеФорматаЭлектронногоДокумента.
//  СтандартнаяОбработка - Булево - Ложь, если требуется отключить стандартную обработку заполнения правил.
//
Процедура ПриЗаполненииПравилСозданияДокументовУчета(ПравилаСоздания, ФорматЭД, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ФорматыЭД = МодульФорматыЭлектронныхДокументов();
	
	Если ФорматыЭД.ЭтоУниверсальныйПередаточныйДокумент(ФорматЭД)
		Или ФорматыЭД.ЭтоПередаточныйДокумент(ФорматЭД) Тогда
		
		Операция = ОперацияПоступлениеТоваровУслуг();
		Представление = "Поступление товаров и услуг";
		ПравилаСоздания.Добавить(Операция, Представление);
		
		Операция = ОперацияПоступлениеДопРасходов();
		Представление = "Поступление доп. расходов";
		ПравилаСоздания.Добавить(Операция, Представление);
		
		Операция = ОперацияВозвратОтПокупателя();
		Представление = "Возврат от покупателя";
		ПравилаСоздания.Добавить(Операция, Представление);
		
	ИначеЕсли ФорматыЭД.ЭтоУниверсальныйКорректировочныйДокумент(ФорматЭД)
		Или ФорматыЭД.ЭтоСоглашениеОбИзмененииСтоимости(ФорматЭД) Тогда
		
		Операция = ОперацияКорректировкаПоступления();
		Представление = "Корректировка поступления";
		ПравилаСоздания.Добавить(Операция, Представление);
		
	ИначеЕсли ФорматыЭД.ЭтоСчетФактура(ФорматЭД) Тогда
		
		Операция = ОперацияСчетФактураПолученный();
		Представление = "Счет-фактура полученный";
		ПравилаСоздания.Добавить(Операция, Представление);
		
	ИначеЕсли ФорматыЭД.ЭтоКорректировочныйСчетФактура(ФорматЭД) Тогда
		
		Операция = ОперацияКорректировочныйСчетФактураПолученный();
		Представление = "Счет-фактура полученный (корректировочный)";
		ПравилаСоздания.Добавить(Операция, Представление);
		
	Иначе
		
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработка создания и заполнения документа учета по указанному правилу.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - (возвращаемый параметр) Заполняемый объект.
//  ИдентификаторОпераци - Строка - идентификатор правила создания и заполнения документа учета.
//  ПараметрыСоздания - Структура - см. ОсновнойМодуль.ПараметрыСозданияДокументаИнформационнойБазы.
//  ДанныеЭД - Структура - разобранное содержимое электронного документа (см. ОсновнойМодуль.ДанныеЭлектронногоДокумента)
//  СтандартнаяОбработка - Булево - Ложь, если требуется отключить стандартную обработку заполнения объекта.
//
Процедура ПриСозданииДокументаУчета(ДокументОбъект, ИдентификаторОперации, ПараметрыСоздания, ДанныеЭД, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ФорматЭД = ДанныеЭД.Формат;
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТабличнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	Если ИдентификаторОперации = ОперацияПоступлениеТоваровУслуг() Тогда
		
		ДокументОбъект = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		ЗаполнитьШапкуПоступленияТоваровУслуг(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьТабличнуюЧастьПоступленияТоваровУслуг(ДокументОбъект, ТабличнаяЧастьЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияКорректировкаПоступления() Тогда
		
		ПроверитьЗаполнитьОснованиеКорректировкиПоступления(ПараметрыСоздания, ШапкаЭД, ФорматЭД);
		
		ДокументОбъект = Документы.КорректировкаПоступления.СоздатьДокумент();
		ЗаполнитьШапкуКорректировкиПоступления(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьТабличнуюЧастьКорректировкиПоступления(ДокументОбъект, ТабличнаяЧастьЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияСчетФактураПолученный() Тогда
		
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ЗаполнитьШапкуСчетаФактурыПолученного(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьОсновныеРеквизитыСчетаФактурыПолученного(ДокументОбъект, ДанныеЭД, ФорматЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияКорректировочныйСчетФактураПолученный() Тогда
		
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ЗаполнитьШапкуСчетаФактурыПолученного(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьОсновныеРеквизитыКорректировочногоСчетаФактурыПолученного(ДокументОбъект, ДанныеЭД, ФорматЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияПоступлениеДопРасходов() Тогда
		
		ДокументОбъект = Документы.ПоступлениеДопРасходов.СоздатьДокумент();
		ЗаполнитьШапкуПоступленияДопРасходов(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьШапкуПоступленияДопРасходовПоТабличнойЧасти(ДокументОбъект, ТабличнаяЧастьЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияВозвратОтПокупателя() Тогда
		
		ДокументОбъект = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
		ЗаполнитьШапкуВозвратОтПокупателя(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьТабличнуюЧастьВозвратОтПокупателя(ДокументОбъект, ТабличнаяЧастьЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияАктСверкиВзаиморасчетов() Тогда
		
		ДокументОбъект = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
		ЗаполнитьШапкуАктаСверкиВзаиморасчетов(ДокументОбъект, ПараметрыСоздания, ШапкаЭД, ИтогиЭД);
		ЗаполнитьТабличнуюЧастьАктаСверкиВзаиморасчетов(ДокументОбъект, ТабличнаяЧастьЭД);
		
	Иначе
		
		Ошибка = "Неизвестный идентификатор операции (%1)";
		Ошибка = СтрЗаменить(Ошибка, "%1", ИдентификаторОперации);
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
КонецПроцедуры

// Выполяется при чтении соответствия номенклатуры контрагента и номенклатуры информационной базы.
//
// Параметры:
//  Результат - Соответствие - (возвращаемый параметр) содержит элементы:
//    * Ключ - Строка - идентификатор номенклатуры контрагента;
//    * Значение - Структура - номенклатура информационной базы (см. НоваяНоменклатураИнформационнойБазы)
//  ВладелецНоменклатуры - ЛюбаяСсылка - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Массив из Строка - идентификаторы номенклатуры контрагентов.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриЧтенииСоответствияНоменклатуры(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ВладелецНоменклатуры) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Идентификатор Из ИдентификаторыНоменклатуры Цикл
		
		НоменклатураИБ = ПолучитьНоменклатуруИнформационнойБазы(ВладелецНоменклатуры, Идентификатор);
		
		Если НЕ ЗначениеЗаполнено(НоменклатураИБ) Тогда
			// Миграция данных из устаревшего хранилища по требованию
			НоменклатураИБ = ПеренестиСопоставлениеНоменклатуры_НоменклатураКонтрагентов(ВладелецНоменклатуры, Идентификатор);
		КонецЕсли;
		
		Результат.Вставить(Идентификатор, НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

// Выполяется при записи соответствия номенклатуры контрагента и номенклатуры информационной базы.
// Позволяет переопределить место хранения соответствия номенклатуры в текущей конфигурации.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - данные номенклатуры контрагента (см. НоваяНоменклатураКонтрагента)
//  НоменклатураИБ - Структура - данные о номенклатуре информационной базы (имеющиеся или требующие подбора).
//                               См. НоваяНоменклатураИнформационнойБазы.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриЗаписиСоответствияНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Номенклатура = НоменклатураИБ.Номенклатура;
	Характеристика = НоменклатураИБ.Характеристика;
	
	ВладелецНоменклатуры = НоменклатураКонтрагента.Владелец;
	ИдентификаторНоменклатуры = НоменклатураКонтрагента.Идентификатор;
	
	НачатьТранзакцию();
	
	Попытка
		
		// Удалить старые записи во избежание дублирования идентификаторов и номенклатуры
		УдалитьСопоставлениеНоменклатуры_НоменклатураКонтрагентов(ВладелецНоменклатуры, ИдентификаторНоменклатуры);
		ДобавитьСопоставлениеНоменклатуры(НоменклатураКонтрагента, Номенклатура, Характеристика);
		
		// Запись дублируется в устаревшее хранилище для обратной совместимости
		ДобавитьСопоставлениеНоменклатуры_НоменклатураКонтрагентов(НоменклатураКонтрагента, Номенклатура, Характеристика);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьОшибкуСопоставленияНоменклатуры(ИдентификаторНоменклатуры, ВладелецНоменклатуры, Ошибка);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальнаяЛогика.ЗаполнитьОбстФормСЧФ820.
//
// Параметры:
//  СчетФактура	- ДокументСсылка.СчетФактураВыданный	 - счет фактура на основании которой вычисляется ОбстФормСЧФ;
//
// Возвращаемое значение:
//  Строка - вычисленное значение ОбстФормСЧФ
//
Функция ПолучитьОбстоятельствоФормированияСчетФактуры(СчетФактура) Экспорт
	
	Результат		 	= Неопределено;
	ДоговорКонтрагента 	= Неопределено;
	
	Если ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(СчетФактура, "ДоговорКонтрагента", ДоговорКонтрагента)
		И ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		
		ВидДоговора = Неопределено; 
		
		Если ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДоговорКонтрагента, "ВидДоговора", ВидДоговора) Тогда
			
			Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером") Тогда
				
				Результат = "4";
				
			ИначеЕсли ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентом") Тогда
				
				Результат = "6";
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает ссылку на документ, на который оформлена корректировка.
//
// Параметры:
//  КорректировочныйДокумент - ЛюбаяСсылка - Корректировочный документ (корректировка реализации или корректировочный счет-фактура)
// 
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка на корректируемый документ.
//
Функция КорректируемыйДокумент(КорректировочныйДокумент) Экспорт
	
	ТипДокумента = ТипЗнч(КорректировочныйДокумент);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ИмяРеквизита = "ИсправляемыйСчетФактура";
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КорректировочныйДокумент, ИмяРеквизита);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ИмяРеквизита = "ИсправляемыйДокументРеализации";
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КорректировочныйДокумент, ИмяРеквизита);
		
	Иначе
		
		КонтекстПроверки = "ИнтеграционныйМодуль.КорректируемыйДокумент";
		ПараметрИмя = "КорректировочныйДокумент";
		ПараметрПредставление = Строка(КорректировочныйДокумент);
		Если КорректировочныйДокумент = Неопределено Тогда
			ПараметрПредставление = "Неопределено";
		КонецЕсли;
		
		Ошибка = ОсновнойМодуль.ПодставитьПараметрыВСтроку(
			"Недопустимое значение параметра %1 (передано значение: %2) в %3",
			ПараметрИмя,
			ПараметрПредставление,
			КонтекстПроверки
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

