Функция  ПолучитьПредставителяОрганизацииДляАктаСверки(ДокСсылка)
	
	Если ЗначениеЗаполнено(ДокСсылка.ПредставительОрганизации) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныеЛицаОрганизацииСрезПоследних.Должность
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизации.СрезПоследних(
		|		&КонДата,
		|		СтруктурнаяЕдиница = &Организация
		|			И ФизическоеЛицо = &ФизическоеЛицо) КАК ОтветственныеЛицаОрганизацииСрезПоследних";
		
		Запрос.УстановитьПараметр("Организация", ДокСсылка.Организация);
		Запрос.УстановитьПараметр("ФизическоеЛицо", ДокСсылка.ПредставительОрганизации);
		Запрос.УстановитьПараметр("КонДата", ДокСсылка.Дата);
		
		Попытка
			Рез = Запрос.Выполнить();
			Если Рез.Пустой() Тогда
				ДолжностьПредставителяОрганизации = "";
			Иначе
				Выборка = Рез.Выбрать();
				Выборка.Следующий();
				ДолжностьПредставителяОрганизации = СокрЛП(Выборка.Должность);
			КонецЕсли;
		Исключение
			ДолжностьПредставителяОрганизации = "";	
		КонецПопытки;
	Иначе
		ДолжностьПредставителяОрганизации = "";
	КонецЕсли;
	
	
	
	ПредставительОрганизации = Новый Структура;
	ПредставительОрганизации.Вставить("ФИО", сокрЛП(ДокСсылка.ПредставительОрганизации.Наименование));
	ПредставительОрганизации.Вставить("Должность", Строка(ДолжностьПредставителяОрганизации));
	
	Возврат ПредставительОрганизации;
КонецФункции

