//{ УПД970. Служебные процедуры и функции

Функция УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента)
	
	Результат = Неопределено;
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФ() Тогда
		
		Результат = УПД970_ОбстоятельстваФормированияСчетФактуры(ДанныеПоДокументу);
		
	Иначе
		
		Результат = УПД970_ОбстоятельстваФормированияУПД(ДанныеПоДокументу);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияУПД(ДанныеПоДокументу)
	
	Результат = Неопределено;
	
	Если ДанныеПоДокументу.ЭтоДоговорСКомиссионером Тогда
		Результат = "00005";
	КонецЕсли;
	
	Если ДанныеПоДокументу.ЭтоДоговорСКомитентом Тогда
		Результат = "00007";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияСчетФактуры(ДанныеПоДокументу)
	
	Перем Результат;
	
	ЭтоКомиссионнаяТорговля = (ДанныеПоДокументу.ЭтоДоговорСКомитентом Или ДанныеПоДокументу.ЭтоДоговорСКомиссионером);
	
	Если ДанныеПоДокументу.ЭтоСчетФактураНаАванс Тогда
		Результат = "2";
	ИначеЕсли ЭтоКомиссионнаяТорговля Тогда
		Результат = "1";
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияПередачиТоваровПоОснованиюСчетФактураВыданный(ДокументОснования)
	
	РеквизитыДокумента = "ДоговорВзаиморасчетов.НомерДоговора, ДоговорВзаиморасчетов.ДатаНачала";
	
	ЗначенияРеквизитовДокумента = ЗначенияРеквизитовОбъектаЛок(ДокументОснования, РеквизитыДокумента);
	
	Результат = УПД970_РеквизитыОснованияПередачиТоваров(
		ЗначенияРеквизитовДокумента.ДоговорВзаиморасчетовНомерДоговора,
		ЗначенияРеквизитовДокумента.ДоговорВзаиморасчетовДатаНачала
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияПередачиТоваров(НомерДоговора, ДатаДоговора)
	
	Результат = Новый Массив;
	
	РеквизитыОснования = Новый Структура;
	РеквизитыОснования.Вставить("Наименование", "Договор");
	РеквизитыОснования.Вставить("Номер", НомерДоговора);
	РеквизитыОснования.Вставить("Дата", ДатаДоговора);
	
	Результат.Добавить(РеквизитыОснования);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ОбновитьГрузополучателяПоДаннымСчетФактуры(СведенияОГрузополучателе, Грузополучатель, ДатаДокумента)
	
	Если НЕ ЗначениеЗаполнено(Грузополучатель) Тогда
		Возврат;
	КонецЕсли;
	
	СведенияОГрузополучателе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
		Грузополучатель,
		ДатаДокумента
	);
	
КонецПроцедуры

Функция УПД970_СведенияОбУчастникахЭДО(ДанныеШапки)
	
	// Продавец
	
	СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		ДанныеШапки.Организация,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации
	);
	
	ЭтоОПНаОбщемБалансе = ЗначениеЗаполнено(ДанныеШапки.ПодразделениеКПП);
	
	Если ЭтоОПНаОбщемБалансе Тогда
		КППОрганизации = ДанныеШапки.ПодразделениеКПП;
	Иначе
		КППОрганизации = СведенияОбОрганизации.КПП;
	КонецЕсли;
	
	СведенияОбОрганизации.КПП = КППОрганизации;
	
	// Покупатель
	Если ЗначениеЗаполнено(ДанныеШапки.ГоловнойКонтрагент) Тогда
		Контрагент = ДанныеШапки.ГоловнойКонтрагент;
	Иначе
		Контрагент = ДанныеШапки.Контрагент;
	КонецЕсли;
	
	СведенияОКонтрагенте = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Контрагент,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетКонтрагента
	);
	
	Если ЗначениеЗаполнено(ДанныеШапки.ГоловнойКонтрагент) Тогда
		СведенияОКонтрагенте.КПП = ДанныеШапки.КонтрагентКПП;
	КонецЕсли;
	
	// Грузоотправитель
	Если ЭтоОПНаОбщемБалансе Тогда
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДО(ДанныеШапки.Организация, ДанныеШапки.Дата);
		
		СведенияОГрузоотправителе.Ссылка = ДанныеШапки.Подразделение;
		СведенияОГрузоотправителе.Адрес = УПД970_СведенияОФактическомАдресе(ДанныеШапки.Подразделение, ДанныеШапки.Дата);
		СведенияОГрузоотправителе.Наименование = ДанныеШапки.ПодразделениеНаименование;
		СведенияОГрузоотправителе.КПП = ДанныеШапки.ПодразделениеКПП;
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата
		);
		
	Иначе
		
		СведенияОГрузоотправителе = Неопределено;
		
	КонецЕсли;
	
	// Грузополучатель
	СведенияОГрузополучателе = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		
		СведенияОГрузополучателе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата
		);
		
	КонецЕсли;
	
	Результат = УПД970_Контракт_УчастникиЭДО();
	Результат.Организация = СведенияОбОрганизации;
	Результат.Контрагент = СведенияОКонтрагенте;
	Результат.Грузоотправитель = СведенияОГрузоотправителе;
	Результат.Грузополучатель = СведенияОГрузополучателе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсЮрАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсФактАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_Контракт_ДанныеУчастникаЭДО();
	
	Результат.Ссылка = Ссылка;
	Результат.Наименование = ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("Наименование"));
	Результат.ИНН = СокрЛП(ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("ИНН")));
	Результат.КПП = ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("КПП"));
	Результат.КодПоОКПО = ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("ОКПО"));
	Результат.НаименованиеБанка = ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("Банк"));
	Результат.НомерСчета = ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("БанковскийСчет"));
	Результат.КоррСчет = СокрЛП(ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("КоррСчет")));
	Результат.БИК = СокрЛП(ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("БИК")));
	Результат.Телефоны = ПредставлениеРеквизитовУчастникаЭДО(Ссылка, Новый Структура("ТелефонРабочий"));
	
	ВидКИАдресЭлектроннойПочты = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий;
	
	Результат.ЭлектроннаяПочта = АдресЭлектроннойПочты(Ссылка, ВидКИАдресЭлектроннойПочты);
	
	ФормаСобственности = ЗначениеРеквизитаОбъектаЛок(Ссылка, "ФормаСобственности");
	
	Если ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо
		Или ФормаСобственности = Перечисления.ФормыСобственности.ОбособленноеПодразделение Тогда
		
		Результат.ЭтоЮрЛицо = Истина;
	Иначе
		Результат.ЭтоЮрЛицо = Ложь;
	КонецЕсли;
	
	Результат.ЭтоФизЛицо = (ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо);
	
	Если ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
		
		Результат.ОГРНИП = УПД970_СведенияОбОГРНИП(Ссылка);
		Результат.ДатаОГРНИП = ЗначениеРеквизитаОбъектаЛок(Ссылка, "ДатаРегистрации");
		
	КонецЕсли;
	
	Если Ссылка.Метаданные().Реквизиты.Найти("СтранаРегистрации") <> Неопределено Тогда
		СтранаРегистрации = ЗначениеРеквизитаОбъектаЛок(Ссылка, "СтранаРегистрации");
		
		ДанныеСтраны = ЗначенияРеквизитовОбъектаЛок(СтранаРегистрации, "Код, Наименование");
		
		Результат.СтранаКод = ДанныеСтраны.Код;
		Результат.СтранаНаименование = ДанныеСтраны.Наименование;
	Иначе
		Результат.СтранаКод = ОсновнаяСтрана().Код;
		Результат.СтранаНаименование = ОсновнаяСтрана().Наименование;
	КонецЕсли;
	
	Результат.Нерезидент = Ложь;
	Результат.Свидетельство = "";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений)
	
	ВидыКИ = Перечисление_ВидыКонтактнойИнформации();
	
	ПоляАдреса = УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидыКИ.ЮридическийАдрес, ДатаСведений);
	
	Если ПоляАдреса <> Неопределено Тогда
		
		Результат = УПД970_НовыйСведенияОбАдресе();
		
		УПД970_ЗаполнитьСведенияОбАдресеПоДаннымРегистра(Результат, ПоляАдреса);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений)
	
	ВидыКИ = Перечисление_ВидыКонтактнойИнформации();
	
	ПоляАдреса = УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидыКИ.ФактическийАдрес, ДатаСведений);
	
	Если ПоляАдреса <> Неопределено Тогда
		
		Результат = УПД970_НовыйСведенияОбАдресе();
		
		УПД970_ЗаполнитьСведенияОбАдресеПоДаннымРегистра(Результат, ПоляАдреса);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидАдреса, ДатаСведений)
	
	Результат = Неопределено;
	
	ВидКИ = ВидАдресаЮрФизЛица(Ссылка, ВидАдреса);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Запрос.УстановитьПараметр("Вид", ВидКИ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И Т.Вид = &Вид";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		
		Результат = НоваяЗаписьКонтактнойИнформации();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
		ЗаполнитьТипыАдресныхОбъектов(Результат);
		
		УПД970_АдаптироватьПоляСтруктурыАдресов(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОбАдресеПоДаннымРегистра(СведенияОбАдресе, ЗаписьКИ)
	
	СведенияОбАдресе.Представление = ЗаписьКИ.Представление;
	
	Индекс = Неопределено;
	КодСтраны = Неопределено;
	НаименованиеСтраны = Неопределено;
	
	Если Не Общее_ВСтрокеТолькоЦифры(ЗаписьКИ.Поле1) Тогда 
		НаименованиеСтраны = СокрП(ЗаписьКИ.Поле1);
		КодСтраны = ГенерацияXML.КодСтраны(НаименованиеСтраны);
	Иначе
		Индекс = СокрП(ЗаписьКИ.Поле1);
	КонецЕсли;
	
	СведенияОбАдресе.Регион = СокрЛП(ЗаписьКИ.Поле2);
	КодРегиона = УПД970_КодРегиона(СведенияОбАдресе.Регион);
	
	Если ЗначениеЗаполнено(КодРегиона) Тогда // Это структурированный адрес РФ
		
		СведенияОбАдресе.ТипАдреса = АдминистративноТерриториальныйАдрес();
		
		СведенияОбАдресе.Страна = ОсновнаяСтрана().Наименование;
		СведенияОбАдресе.Индекс = Индекс;
		СведенияОбАдресе.КодСтраны = ОсновнаяСтрана().Код;
		СведенияОбАдресе.КодРегиона = КодРегиона;
		СведенияОбАдресе.Район = ЗаписьКИ.Поле3;
		СведенияОбАдресе.Город = ЗаписьКИ.Поле4;
		СведенияОбАдресе.НаселенныйПункт = ЗаписьКИ.Поле5;
		СведенияОбАдресе.Улица = ЗаписьКИ.Поле6;
		
		СведенияОбАдресе.Здание.ТипЗдания = ЗаписьКИ.ТипДома;
		СведенияОбАдресе.Здание.Номер = ЗаписьКИ.Поле7;
		
		Если ЗначениеЗаполнено(ЗаписьКИ.Поле8) Тогда
			
			Корпус = Новый Структура;
			Корпус.Вставить("ТипКорпуса", ЗаписьКИ.ТипКорпуса);
			Корпус.Вставить("Номер", ЗаписьКИ.Поле8);
			
			СведенияОбАдресе.Корпуса.Добавить(Корпус);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаписьКИ.Поле9) Тогда
			
			Помещение = Новый Структура;
			Помещение.Вставить("ТипПомещения", ЗаписьКИ.ТипКвартиры);
			Помещение.Вставить("Номер", ЗаписьКИ.Поле9); 
			СведенияОбАдресе.Помещения.Добавить(Помещение);
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(КодСтраны) Тогда // Это иностранный или российский адрес в свободной форме
		
		СведенияОбАдресе.КодСтраны = КодСтраны;
		СведенияОбАдресе.Страна = НаименованиеСтраны;
		
	Иначе // Это российский адрес, который не удалось разложить в структуру
		
		СведенияОбАдресе.Страна = ОсновнаяСтрана().Наименование;
		СведенияОбАдресе.КодСтраны = ОсновнаяСтрана().Код;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_КодРегиона(Знач НаименованиеРегиона)
	
	Результат = "";
	
	НаименованиеРегиона = Врег(НаименованиеРегиона);
	
	КодыРегионов = ГенерацияXML.КодыРегионов();
	
	Для Каждого КодРегиона Из КодыРегионов Цикл
		
		Если Врег(КодРегиона.Значение) = НаименованиеРегиона Тогда
			Результат = КодРегиона.Ключ;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_АдаптироватьПоляСтруктурыАдресов(СведенияОбАдресе)
	
	ТипСтрока = Тип("Строка");
	
	Если ТипЗнч(СведенияОбАдресе.Страна) <> ТипСтрока Тогда
		СведенияОбАдресе.Страна = НРег(XMLСтрока(СведенияОбАдресе.Страна));
	КонецЕсли;
	
	Если ТипЗнч(СведенияОбАдресе.ТипДома) <> ТипСтрока Тогда
		СведенияОбАдресе.ТипДома = НРег(XMLСтрока(СведенияОбАдресе.ТипДома));
	КонецЕсли;
	
	Если ТипЗнч(СведенияОбАдресе.ТипКвартиры) <> ТипСтрока Тогда
		СведенияОбАдресе.ТипКвартиры = НРег(XMLСтрока(СведенияОбАдресе.ТипКвартиры));
	КонецЕсли;
	
	Если ТипЗнч(СведенияОбАдресе.ТипКорпуса) <> ТипСтрока Тогда
		СведенияОбАдресе.ТипКорпуса = НРег(XMLСтрока(СведенияОбАдресе.ТипКорпуса));
	КонецЕсли;
	
КонецПроцедуры

