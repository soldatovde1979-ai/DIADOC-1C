	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеШапки.Ссылка КАК Ссылка,
	|	ДанныеШапки.Дата КАК Дата,
	|	ДанныеШапки.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеШапки.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	ДанныеШапки.ВалютаДокумента.НаименованиеПолное КАК ВалютаДокументаНаименование,
	|	ДанныеШапки.Организация КАК Организация,
	|	ДанныеШапки.Организация.КПП КАК ОрганизацияКПП,
	|	ДанныеШапки.ПодразделениеКомпании КАК Подразделение,
	|	ЕСТЬNULL(Подразделения.Организация, НЕОПРЕДЕЛЕНО) КАК ГоловноеПодразделение,
	|	ЕСТЬNULL(Подразделения.КПП, """") КАК ПодразделениеКПП,
	|	ЕСТЬNULL(Подразделения.Наименование, """") КАК ПодразделениеНаименование,
	|	ДанныеШапки.Контрагент КАК Контрагент,
	|	Контрагенты.ГоловнойКонтрагент КАК ГоловнойКонтрагент,
	|	Контрагенты.КПП КАК КонтрагентКПП,
	|	ДанныеШапки.Организация КАК Грузоотправитель,
	|	ДанныеШапки.Контрагент КАК Грузополучатель,
	|	ДанныеШапки.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизации,
	|	Контрагенты.ОсновнойБанковскийСчет КАК БанковскийСчетКонтрагента,
	|	ДанныеШапки.ТипЦен.ЦенаВключаетНДС КАК СуммаВключаетНДС,
	|	"""" КАК ИдентификаторГосКонтракта,
	|	ДанныеШапки.ДоговорВзаиморасчетов КАК ДоговорКонтрагента,
	|	ДоговорыВзаиморасчетов.ДатаНачала КАК ДоговорДата,
	|	ДоговорыВзаиморасчетов.НомерДоговора КАК ДоговорНомер,
	|	ДоговорыВзаиморасчетов.ВидДоговора КАК ВидДоговора
	|ИЗ
	|	Документ.ОтчетКомиссионера КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодразделенияКомпании КАК Подразделения
	|		ПО ДанныеШапки.ПодразделениеКомпании = Подразделения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ДанныеШапки.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|		ПО ДанныеШапки.ДоговорВзаиморасчетов = ДоговорыВзаиморасчетов.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличныхДанныхДокументаОтчетКомиссионера()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабТовары.Ссылка КАК Ссылка,
	|	ТабТовары.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СпрНоменклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	|			ТОГДА ""Услуга""
	|		ИНАЧЕ ""Товар""
	|	КОНЕЦ КАК ТипНоменклатуры,
	|	ТабТовары.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК НоменклатураПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК НоменклатураНаименование,
	|	СпрНоменклатура.Артикул КАК КодНоменклатуры,
	|	ТабТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.Наименование, """") КАК ХарактеристикаНоменклатурыНаименование,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СправочникГТД.Страна, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА СправочникГТД.Страна
	|		КОГДА ТабТовары.ГТД <> ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(СпрНоменклатура.СтранаПроисхождения, НЕОПРЕДЕЛЕНО)
	|		КОГДА ЕСТЬNULL(КлассификаторСтранМира.НужнаГТД, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЕСТЬNULL(СпрНоменклатура.СтранаПроисхождения, НЕОПРЕДЕЛЕНО)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СправочникГТД.Страна, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираГТД.Код
	|		КОГДА ТабТовары.ГТД <> ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(КлассификаторСтранМира.Код, """")
	|		КОГДА ЕСТЬNULL(КлассификаторСтранМира.НужнаГТД, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЕСТЬNULL(КлассификаторСтранМира.Код, """")
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК СтранаПроисхожденияКод,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СправочникГТД.Страна, ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.КлассификаторСтранМира.ПустаяСсылка)
	|			ТОГДА КлассификаторСтранМираГТД.УчастникЕАЭС
	|		КОГДА ТабТовары.ГТД <> ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(КлассификаторСтранМира.УчастникЕАЭС, ЛОЖЬ)
	|		КОГДА ЕСТЬNULL(КлассификаторСтранМира.НужнаГТД, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ЕСТЬNULL(КлассификаторСтранМира.УчастникЕАЭС, ЛОЖЬ)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ТабТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(СправочникГТД.Наименование, """") КАК НомерГТД,
	|	ТабТовары.Количество КАК Количество,
	|	ТабТовары.Цена КАК Цена,
	|	ТабТовары.СтавкаНДС КАК СтавкаНДС,
	|	ТабТовары.СуммаНДС КАК СуммаНДС,
	|	ТабТовары.СуммаВсего - ТабТовары.СуммаНДС КАК СуммаБезНДС,
	|	ТабТовары.СуммаВсего КАК СуммаВсего,
	|	СпрНоменклатура.Прослеживаемый КАК ПрослеживаемыйТовар
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ТабТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТабТовары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО ТабТовары.ХарактеристикаНоменклатуры = СпрХарактеристикиНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМира
	|		ПО СпрНоменклатура.СтранаПроисхождения = КлассификаторСтранМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО ТабТовары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГТД КАК СправочникГТД
	|		ПО ТабТовары.ГТД = СправочникГТД.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираГТД
	|		ПО СправочникГТД.Страна = КлассификаторСтранМираГТД.Ссылка
	|ГДЕ
	|	ТабТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

