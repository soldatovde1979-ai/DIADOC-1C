// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка - счет-фактура, основание которой нужно найти;
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на основания счета-фактуры.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = Неопределено;
	Выборка = Ядро.Общее_ВыборкаДанныхОбъекта(СчетФактура, ИмяТабличнойЧасти, "ДокументОснование");
			
	Пока Выборка.Следующий() Цикл 
		
		ДокументОснование = Выборка.ДокументОснование;
		
		Если Результат.Найти(ДокументОснование) = Неопределено Тогда
			Результат.Добавить(ДокументОснование);
		КонецЕсли;
		
	КонецЦикла;
			
	Возврат Результат;
	
КонецФункции

// Процедура - При получении оснований документа учета
//
// Параметры:
//  КоллекцияОснований	 - Массив - Коллекция для заполнения документами основания
//  ДокументУчета		 - ДокументСсылка - Ссылка на документ учета по которому выбираются документы основания
//
Процедура ПриПолученииОснованийДокументаУчета(КоллекцияОснований, ДокументУчета) Экспорт
	
	Если НЕ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	КоллекцияОснований = ДокументыОснованияСчетаФактуры(ДокументУчета);

КонецПроцедуры

// Возвращает прикладное значение ставки НДС по его строковому представлению
//
// Параметры:
//  ПредставлениеСтавки - Строка - Строковое представление ставки НДС
// 
// Возвращаемое значение:
//  ПеречислениеСсылка - Прикладное значение ставки НДС
//
Функция ЗначениеСтавкиНДС(ПредставлениеСтавки) Экспорт
	
	Если СтрНайтиЛок("БЕЗ НДС", ВРег(ПредставлениеСтавки)) > 0 Тогда
		
		ЗначениеНДС = ПредставлениеСтавкиБезНДС();
		
	Иначе
		
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, "%", "");
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, " ", "");
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, "\", "/");
		
		Если СтрНайтиЛок("0", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "0";
		ИначеЕсли СтрНайтиЛок("5", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "5";
		ИначеЕсли СтрНайтиЛок("7", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "7";
		ИначеЕсли СтрНайтиЛок("10", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "10";
		ИначеЕсли СтрНайтиЛок("18", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "18";
		ИначеЕсли СтрНайтиЛок("20", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "20";
		ИначеЕсли СтрНайтиЛок("22", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "22";
		ИначеЕсли СтрНайтиЛок("10/110", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "10/110";
		ИначеЕсли СтрНайтиЛок("18/118", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "18/118";
		ИначеЕсли СтрНайтиЛок("20/120", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "20/120";
		ИначеЕсли СтрНайтиЛок("22/122", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "22/122";
		Иначе
			ЗначениеНДС = ПредставлениеСтавки;
		КонецЕсли;
		
	КонецЕсли;
	
	ПеречислениеСтавокНДС = СоответствиеСтавокНДСИзСправочника();
	
	Результат = ПеречислениеСтавокНДС.Получить(ЗначениеНДС);
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеСтавокНДСИзСправочника()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ставка КАК Ставка,
	|	Т.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Т.Наименование ПОДОБНО ""%/%""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК РасчетнаяСтавка
	|ИЗ
	|	Справочник.СтавкиНДС КАК Т
	|ГДЕ
	|	НЕ Т.Ссылка = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.РасчетнаяСтавка Тогда
			КлючСоответствия = Строка(ВыборкаДетальныеЗаписи.Ставка) + "/" + Строка(ВыборкаДетальныеЗаписи.Ставка + 100);
		Иначе
			КлючСоответствия = Строка(ВыборкаДетальныеЗаписи.Ставка);
		КонецЕсли;
		
		Результат.Вставить(КлючСоответствия, ВыборкаДетальныеЗаписи.Ссылка);
		
	КонецЦикла;
	
	Результат.Вставить(ПредставлениеСтавкиБезНДС(), Справочники.СтавкиНДС.БезНДС);
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое представление ставки НДС по прикладному значению
//
// Параметры:
//  ЗначениеСтавки - ПеречислениеСсылка - Прикладное значение ставки НДС
// 
// Возвращаемое значение:
//  Строка - Строковое представление ставки НДС для электронного документа
//
Функция ПредставлениеСтавкиНДС(ЗначениеСтавки) Экспорт
	
	Результат = "##";
	
	Если ЗначениеЗаполнено(ЗначениеСтавки) Тогда
		
		Если ЗначениеСтавки = Справочники.СтавкиНДС.БезНДС Тогда
			
			Результат = "без НДС";
			
		ИначеЕсли СтрНайтиЛок(ЗначениеСтавки.Наименование, "/") > 0 Тогда
			
			Результат = СтрШаблонЛок(
				"%1/%2",
				Формат(ЗначениеСтавки.Ставка, "ЧН=0"),
				Формат(ЗначениеСтавки.Ставка + 100, "ЧН=0")
			);
			
		Иначе
			
			Результат = Формат(ЗначениеСтавки.Ставка, "ЧН=0");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает виды документов из текущей конфигурации для поиска в модуле
// 
// Возвращаемое значение:
//  Массив - Предопределенные виды документов конфигурации для поиска в модуле
//
Функция ВидыПредопределенныхДокументовДляПоискаВМодуле() Экспорт
	
	ДокументыКонфигурации = Метаданные.Документы;
	
	Результат = Новый Массив;
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомиссионера);
	Результат.Добавить(ДокументыКонфигурации.КорректировкаРеализации);
	Результат.Добавить(ДокументыКонфигурации.РеализацияТоваров);
	Результат.Добавить(ДокументыКонфигурации.РеализацияАвтомобилей);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомитенту);
	Результат.Добавить(ДокументыКонфигурации.СчетФактураВыданный);
	Результат.Добавить(ДокументыКонфигурации.СчетНаОплату);
	Результат.Добавить(ДокументыКонфигурации.ЗаказНаряд);

	Возврат Результат;
	
КонецФункции

