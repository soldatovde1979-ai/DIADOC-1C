	|		ПО ТабТовары.ХарактеристикаНоменклатуры = СпрХарактеристикиНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМира
	|		ПО СпрНоменклатура.СтранаПроисхождения = КлассификаторСтранМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО ТабТовары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГТД КАК СправочникГТД
	|		ПО ТабТовары.ГТД = СправочникГТД.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторСтранМира КАК КлассификаторСтранМираГТД
	|		ПО СправочникГТД.Страна = КлассификаторСтранМираГТД.Ссылка
	|ГДЕ
	|	ТабТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаКодовМаркировкиДокументаВозвратПоставщику()
	
	Результат = УПД970_ТекстЗапросаКодовМаркировкиОбщее("ВозвратПоставщику");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаКодовМаркировкиОбщее(ТипДокумента)
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабКодыМаркировки.ИдентификаторТовара КАК ИдентификаторТовара,
	|	ТабКодыМаркировки.КодМаркировки КАК КодМаркировки,
	|	ТабТовары.Номенклатура КАК Номенклатура,
	|	ТабТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЛОЖЬ КАК Обработан
	|ИЗ
	|	Документ.РеализацияТоваров.КодыМаркировки КАК ТабКодыМаркировки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров.Товары КАК ТабТовары
	|		ПО ТабКодыМаркировки.Ссылка = ТабТовары.Ссылка
	|			И ТабКодыМаркировки.ИдентификаторТовара = ТабТовары.ИдентификаторТовара
	|ГДЕ
	|	ТабКодыМаркировки.Ссылка = &Ссылка";
	
	БазовыйТипДокумента = "РеализацияТоваров";
	Результат = СтрЗаменить(Результат, БазовыйТипДокумента, ТипДокумента);
	
	Возврат Результат;
	
КонецФункции

