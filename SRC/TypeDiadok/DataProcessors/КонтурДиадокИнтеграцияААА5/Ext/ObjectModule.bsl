Функция УПД970_ИсходныеДанныеПервичногоДокумента(
	ДокСсылка,
	ТекстЗапросаДанныхШапки,
	ТекстЗапросаТабличныхДанных,
	ТекстЗапросаКодовМаркировки)
	
	ЕстьДанныеКодовМаркировки = ЗначениеЗаполнено(ТекстЗапросаКодовМаркировки);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхШапки);
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныхДанных);
	
	Если ЕстьДанныеКодовМаркировки Тогда
		ТекстыЗапросов.Добавить(ТекстЗапросаКодовМаркировки);
	КонецЕсли;
	
	СтрОбъединениеЗапросов = ТекстЗапроса_РазделительЗапросов();
	
	ТекстЗапроса = СтрСоединитьЛок(ТекстыЗапросов, СтрОбъединениеЗапросов);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0];
	ТабличныеДанные = РезультатыЗапроса[1];
	
	Если ЕстьДанныеКодовМаркировки Тогда
		ДанныеКодовМаркировки = РезультатыЗапроса[2];
	Иначе
		ДанныеКодовМаркировки = Неопределено;
	КонецЕсли;
	
	Результат = УПД970_ОбработатьДанныеПервичногоДокумента(
		ДанныеШапки,
		ТабличныеДанные,
		ДанныеКодовМаркировки
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбработатьДанныеПервичногоДокумента(
	РезультатЗапросаПоШапке,
	РезультатЗапросаПоТаблицам,
	РезультатЗапросаПоКодамМаркировки)
	
	ДанныеШапкиТаблица = РезультатЗапросаПоШапке.Выгрузить();
	ДанныеШапки = Общее_СтрокаТаблицыЗначенийВСтруктуру(ДанныеШапкиТаблица[0]);
	
	ТабличныеДанные = РезультатЗапросаПоТаблицам.Выгрузить();
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомитентом);
	ЭтоДоговорСКомиссионером = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером);
	
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО(ДанныеШапки);
	
	Если УПД970_ВТабличныхДанныхДокументаНетТоваров(ТабличныеДанные) Тогда
		СведенияОбУчастникахЭДО.Грузоотправитель = Неопределено;
		СведенияОбУчастникахЭДО.Грузополучатель = Неопределено;
	КонецЕсли;
	
	Если РезультатЗапросаПоКодамМаркировки = Неопределено Тогда
		ДанныеКодовМаркировки = Неопределено;
	Иначе
		ДанныеКодовМаркировки = РезультатЗапросаПоКодамМаркировки.Выгрузить();
	КонецЕсли;
	
	ОтборПоИдентификатору = Истина;
	
	УПД970_ДобавитьДанныеКодовМаркировкиВТабличныеДанные(ТабличныеДанные, ДанныеКодовМаркировки, ОтборПоИдентификатору);
	
	ОснованияПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваров(
		ДанныеШапки.ДоговорНомер,
		ДанныеШапки.ДоговорДата
	);
	
	Результат = УПД970_Контракт_ДанныеПервичногоДокумента();
	
	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ТабличныеДанные = ТабличныеДанные;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.ЭтоДоговорСКомиссионером = ЭтоДоговорСКомиссионером;
	Результат.СведенияОбУчастникахЭДО = СведенияОбУчастникахЭДО;
	Результат.ОснованияПередачиТоваров = ОснованияПередачиТоваров;
	
	Возврат Результат;
	
КонецФункции

