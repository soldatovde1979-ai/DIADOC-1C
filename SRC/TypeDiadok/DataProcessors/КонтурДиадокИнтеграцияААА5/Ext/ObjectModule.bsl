Функция УПД970_ExtendedOrganizationInfoType(ДанныеУчастникаЭДО)
	
	ВидыЮрФизЛиц = ГенерацияXML_Перечисление_ВидыЮрФизЛиц();
	
	ЭтоРезидент = НЕ ДанныеУчастникаЭДО.Нерезидент;
	
	Если НЕ ДанныеУчастникаЭДО.ЭтоЮрЛицо
		И НЕ ДанныеУчастникаЭДО.ЭтоФизЛицо
		И ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель;
		
	ИначеЕсли ДанныеУчастникаЭДО.ЭтоЮрЛицо И ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ЮридическоеЛицо;
		
	ИначеЕсли НЕ ДанныеУчастникаЭДО.ЭтоЮрЛицо И ДанныеУчастникаЭДО.Нерезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ИностранныйГражданин;
		
	ИначеЕсли ДанныеУчастникаЭДО.ЭтоЮрЛицо
		И ДанныеУчастникаЭДО.Нерезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ИностраннаяОрганизация;
		
	ИначеЕсли ДанныеУчастникаЭДО.ЭтоФизЛицо Тогда
		
		Результат = ВидыЮрФизЛиц.ФизическоеЛицо;
		
	Иначе
		
		ТекстОшибки = НСтр("ru='Не удалось определить тип участника ЭДО.
				|Заполните корректные реквизиты участников ЭДО в базе 1С 
				|(организация, грузоотправитель, контрагент, грузополучатель)'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЦенаБезНДС(Item, ЦенаИзДокумента, Разрядность)
	
	ДопустимоеОтклонение = 0.03;
	
	Если Item.Quantity = 0 Тогда
		
		Результат = 0;
		
	Иначе
		
		Результат = Окр(Item.SubtotalWithVatExcluded / Item.Quantity, Разрядность);
		ОтклонениеВЦене = (Результат - ЦенаИзДокумента) * Item.Quantity;
		
		ОтклонениеВЦенеПоМодулю = Макс(ОтклонениеВЦене, -ОтклонениеВЦене);
		
		Если ОтклонениеВЦенеПоМодулю <= ДопустимоеОтклонение Тогда
			Результат = Окр(ЦенаИзДокумента, Разрядность);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДокументыОтгрузки(ИсходныеДокументы)
	
	Результат = Новый Массив;
	
	Для Каждого ИсходныйДокумент Из ИсходныеДокументы Цикл
		
		ДокументОтгрузки = УПД970_ИсправляемыйДокументОтгрузки(ИсходныйДокумент);
		
		Результат.Добавить(ДокументОтгрузки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсправляемыйДокументОтгрузки(ИсходныйДокумент)
	
	Если ТипЗнч(ИсходныйДокумент) = Тип("ДокументСсылка.КорректировкаРеализации")
		ИЛИ ТипЗнч(ИсходныйДокумент) = Тип("ДокументСсылка.КорректировкаРеализацииАвтомобилей") Тогда
		
		ДокументРеализации = ЗначениеРеквизитаОбъектаЛок(ИсходныйДокумент, "ДокументОснование");
		Результат = УПД970_ИсправляемыйДокументОтгрузки(ДокументРеализации);
		
	Иначе
		
		Результат = ИсходныйДокумент;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента)
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФДОП() Тогда
		
		Результат = НаименованияДокументов.УПД;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументыОтгрузки) И ДокументыОтгрузки.Количество() > 1 Тогда
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		ЕстьУслуги = УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы);
		
		Если ЕстьТовары И НЕ ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Накладная;
			
		ИначеЕсли НЕ ЕстьТовары И ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Акт;
			
		Иначе
			Результат = НаименованияДокументов.Документ;
		КонецЕсли;
		
	Иначе
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		
		Если ЕстьТовары Тогда
			Результат = НаименованияДокументов.Накладная;
		Иначе
			Результат = НаименованияДокументов.Акт;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеЕстьТовары(СтрокиТаблицы)
	
	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Имущество Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы)
	
	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	МаксИндекс = СтрокиТаблицы.Количество() - 1;
	
	Для ТекИндекс = - МаксИндекс По 0 Цикл
		
		ItemMark = СтрокиТаблицы[ - ТекИндекс].ItemMark;
		
		Если ItemMark = ТипыНоменклатуры.Услуга
			ИЛИ ItemMark = ТипыНоменклатуры.Работа
			ИЛИ ItemMark = ТипыНоменклатуры.ИмущественныеПрава Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияЗаполнены(РеквизитыОснования)
	
	ОбязательныеРеквизитыЗаполнены = (РеквизитыОснования <> Неопределено
		И ЗначениеЗаполнено(РеквизитыОснования.Наименование)
		И ЗначениеЗаполнено(РеквизитыОснования.Номер)
		И ЗначениеЗаполнено(РеквизитыОснования.Дата));
	
	Возврат ОбязательныеРеквизитыЗаполнены;
	
КонецФункции

Функция УПД970_СведенияОДокументахОплаты(ПлатежноРасчетныеДокументы) Экспорт
	
	Результат = Новый Массив;
	
	ПлатежноРасчетныеДокументыМассивом = Общее_РазделитьСтроку(ПлатежноРасчетныеДокументы, ";", Ложь);
	
	Для Каждого ПредставлениеПРД Из ПлатежноРасчетныеДокументыМассивом Цикл
		
		Если ПустаяСтрока(ПредставлениеПРД) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерДата = УПД970_ВыделитьНомерДатуИзСтроки(ПредставлениеПРД);
		
		ПлатежныйДокумент = Новый Структура;
		ПлатежныйДокумент.Вставить("НомерДокумента", НомерДата.Номер);
		ПлатежныйДокумент.Вставить("ДатаДокумента", НомерДата.Дата);
		
		Результат.Добавить(ПлатежныйДокумент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВыделитьНомерДатуИзСтроки(ИсходнаяСтрока)
	
	Подстроки = Общее_РазделитьСтроку(ИсходнаяСтрока, "№");
	СтрокаНомерДата = СокрЛП(Подстроки[Подстроки.ВГраница()]);
	
	Подстроки = Общее_РазделитьСтроку(СтрокаНомерДата, "от", Ложь);
	Номер = СокрЛП(Подстроки[0]);
	
	СтрокаДата = "";
	Если Подстроки.Количество() > 1 Тогда
		СтрокаДата = СокрЛП(Подстроки[1]);
	КонецЕсли;
	
	Подстроки =  Общее_РазделитьСтроку(СтрокаДата, ".");
	
	День = 1;
	Если Подстроки.Количество() > 0 Тогда
		День = СокрЛП(Подстроки[0]);
	КонецЕсли;
	
	Месяц = 1;
	Если Подстроки.Количество() > 1 Тогда
		Месяц = СокрЛП(Подстроки[1]);
	КонецЕсли;
	
	ВИсходнойСтрокеДвеЧасти = 2;
	Год = 1;
	Если Подстроки.Количество() > ВИсходнойСтрокеДвеЧасти Тогда
		Год = Подстроки[2];
		Год = СтрЗаменить(Год, "г.", "");
		Год = СтрЗаменить(Год, "г", "");
		Год = СокрЛП(Год);
	КонецЕсли;
	
	Попытка
		Дата = Дата(Год, Месяц, День);
	Исключение
		Дата = Дата(1, 1, 1);
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("Номер", Номер);
	Результат.Вставить("Дата", Дата);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДобавитьДанныеКодовМаркировкиВТабличныеДанные(
	ТабличныеДанные,
	ДанныеКодовМаркировки,
	ОтборПоИдентификатору)
	
	ТабличныеДанные.Колонки.Добавить("КодыМаркировки");
	
	Если НЕ ЗначениеЗаполнено(ДанныеКодовМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеСтроки Из ТабличныеДанные Цикл
		
		КодыМаркировки = Новый Массив;
		
		ОтборКодовМаркировки = УПД970_ОтборКодовМаркировки(ДанныеСтроки, ОтборПоИдентификатору);
		
		СтрокиКодов = ДанныеКодовМаркировки.НайтиСтроки(ОтборКодовМаркировки);
		
		Для Каждого СтрокаКода Из СтрокиКодов Цикл
			
			КодМаркировки = УПД970_КодМаркировкиБезСкобок(СтрокаКода.КодМаркировки);
			
			КодыМаркировки.Добавить(КодМаркировки);
			
			СтрокаКода.Обработан = Истина;
			
		КонецЦикла;
		
		ДанныеСтроки.КодыМаркировки = КодыМаркировки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция УПД970_ОтборКодовМаркировки(ДанныеСтроки, ОтборПоИдентификатору)
	
	Результат = Новый Структура;
	
	Если ОтборПоИдентификатору Тогда
		
		Результат.Вставить("ИдентификаторТовара", ДанныеСтроки.ИдентификаторТовара);
		
	Иначе
		
		Результат.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
		Результат.Вставить("ХарактеристикаНоменклатуры", ДанныеСтроки.ХарактеристикаНоменклатуры);
		Результат.Вставить("Обработан", Ложь);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КодМаркировкиБезСкобок(Штрихкод)
	
	Если Не СтрНачинаетсяСЛок(Штрихкод, "(") Тогда
		Возврат Штрихкод;
	КонецЕсли;
	
	Результат = СтрЗаменить(Штрихкод, "(01)", "01");
	Результат = СтрЗаменить(Результат, "(21)", "21");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеКодовМаркировкиДокументаОснованияСчетФактуры(ДокументОснование)
	
	МетаданныеДокумента = ДокументОснование.Метаданные();
	ЕстьТабличнаяЧастьКодыМаркировки = (МетаданныеДокумента.ТабличныеЧасти.Найти("КодыМаркировки") <> Неопределено);
	
	Если ЕстьТабличнаяЧастьКодыМаркировки Тогда
		
		ТекстЗапроса = УПД970_ТекстЗапросаКодовМаркировкиОбщее(МетаданныеДокумента.Имя);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НаименованиеНоменклатурыСчетФактурыНаАванс(СтрокаТаблицы)
	
