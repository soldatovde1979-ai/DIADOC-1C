//{		Получение сертификата

&НаКлиенте
Функция НайтиПоОтпечатку(ОтпечатокСертификата) Экспорт
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	Результат = ПолучитьДанныеСертификата(ОтпечатокСертификата, ПараметрыПоиска);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НачатьПоискПоОтпечатку(ОтпечатокСертификата, ОписаниеОповещения) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения", ОписаниеОповещения);
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата", ОтпечатокСертификата);
	
	ОповещениеЗавершения = НовыйОписаниеОповещения(
			"НачатьПоискПоОтпечатку_Завершение",
			ЭтаФорма,
			ДополнительныеПараметры);
	
	ОповещениеИнициализацияМенеджераЗавершение = НовыйОписаниеОповещения(
			"НачатьПоискПоОтпечатку_ИнициализацияМенеджера_Завершение",
			ЭтаФорма,
			ОповещениеЗавершения);
	
	НачатьИнициализациюМенеджераКриптографии(ОповещениеИнициализацияМенеджераЗавершение);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискПоОтпечатку_Завершение(СертификатыКриптографии, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОповещениеЗавершения = СвойствоСтруктуры(ДополнительныеПараметры, "ОповещениеЗавершения");
	ОтпечатокСертификата = СвойствоСтруктуры(ДополнительныеПараметры, "ОтпечатокСертификата");
	
	Если ТипЗнч(СертификатыКриптографии) = Тип("Массив") Тогда
		
		СертификатКриптографии = НайтиСертификатВМассивеПоОтпечатку(СертификатыКриптографии, ОтпечатокСертификата);
		
	Иначе
		
		СертификатКриптографии = СертификатыКриптографии;
		
	КонецЕсли;
	
	НачатьПолучениеОписанияСертификата(СертификатКриптографии, ОповещениеЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискПоОтпечатку_ИнициализацияМенеджера_Завершение(МенеджерКриптографии, ОписаниеОповещения) Экспорт
	
	Если ЗначениеЗаполнено(ПарольСертификата) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольСертификата;
	КонецЕсли;
	
	Оповещение = НовыйОписаниеОповещения(
			"НачатьПоискПоОтпечатку_ПолучениеХранилищаСертификатов_Завершение",
			ЭтаФорма,
			ОписаниеОповещения);
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	МенеджерКриптографии.НачатьПолучениеХранилищаСертификатов(
		Оповещение,
		ПараметрыПоиска.ТипХранилища,
		ПараметрыПоиска.РасположениеХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискПоОтпечатку_ПолучениеХранилищаСертификатов_Завершение(Хранилище, ОписаниеОповещения) Экспорт
	
	ОтпечатокСетификата = ОписаниеОповещения.ДополнительныеПараметры.ОтпечатокСертификата;
	
	Если ТипЗнч(ОтпечатокСетификата) = Тип("ДвоичныеДанные") Тогда
		Хранилище.НачатьПоискПоОтпечатку(ОписаниеОповещения, ОтпечатокСетификата);
	Иначе
		Хранилище.НачатьПолучениеВсех(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиПоСерийномуНомеру(СерийныйНомер) Экспорт
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(ПараметрыПоиска);
	
	Если ТипЗнч(СерийныйНомер) = Тип("ДвоичныеДанные") Тогда
		
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоСерийномуНомеру(СерийныйНомер);
		
	Иначе
		
		СертификатыКриптографии = ХранилищеСертификатовКриптографии.ПолучитьВсе();
		СертификатКриптографии = НайтиСертификатВМассивеСерийномуНомеру(СертификатыКриптографии, СерийныйНомер);
		
	КонецЕсли;
	
	Результат = Новый_ОписаниеСертификата(СертификатКриптографии);
	Результат.ДвоичныеДанные = СертификатКриптографии.Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НачатьПоискПоСерийномуНомеру(СерийныйНомер, ОписаниеОповещения) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения", ОписаниеОповещения);
	ДополнительныеПараметры.Вставить("СерийныйНомер", СерийныйНомер);
	
	ОповещениеЗавершения = НовыйОписаниеОповещения(
			"НачатьПоискПоСерийномуНомеру_Завершение",
			ЭтаФорма,
			ДополнительныеПараметры);
	
	ОповещениеИнициализацияМенеджераЗавершение = НовыйОписаниеОповещения(
			"НачатьПоискПоСерийномуНомеру_ИнициализацияМенеджера_Завершение",
			ЭтаФорма,
			ОповещениеЗавершения);
	
	НачатьИнициализациюМенеджераКриптографии(ОповещениеИнициализацияМенеджераЗавершение);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискПоСерийномуНомеру_Завершение(СертификатыКриптографии, ДополнительныеПараметры = Неопределено) Экспорт
	
	ОповещениеЗавершения = СвойствоСтруктуры(ДополнительныеПараметры, "ОповещениеЗавершения");
	СерийныйНомер = СвойствоСтруктуры(ДополнительныеПараметры, "СерийныйНомер");
	
	Если ТипЗнч(СертификатыКриптографии) = Тип("Массив") Тогда
		
		СертификатКриптографии = НайтиСертификатВМассивеСерийномуНомеру(СертификатыКриптографии, СерийныйНомер);
		
	Иначе
		
		СертификатКриптографии = СертификатыКриптографии;
		
	КонецЕсли;
	
	НачатьПолучениеОписанияСертификата(СертификатКриптографии, ОповещениеЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискПоСерийномуНомеру_ИнициализацияМенеджера_Завершение(МенеджерКриптографии, ОписаниеОповещения) Экспорт
	
	Если ЗначениеЗаполнено(ПарольСертификата) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольСертификата;
	КонецЕсли;
	
	Оповещение = НовыйОписаниеОповещения(
			"НачатьПоискПоСерийномуНомеру_ПолучениеХранилищаСертификатов_Завершение",
			ЭтаФорма,
			ОписаниеОповещения);
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	МенеджерКриптографии.НачатьПолучениеХранилищаСертификатов(
		Оповещение,
		ПараметрыПоиска.ТипХранилища,
		ПараметрыПоиска.РасположениеХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискПоСерийномуНомеру_ПолучениеХранилищаСертификатов_Завершение(Хранилище, ОписаниеОповещения) Экспорт
	
	СерийныйНомер = ОписаниеОповещения.ДополнительныеПараметры.СерийныйНомер;
	
	Если ТипЗнч(СерийныйНомер) = Тип("ДвоичныеДанные") Тогда
		Хранилище.НайтиПоСерийномуНомеру(ОписаниеОповещения, СерийныйНомер);
	Иначе
		Хранилище.НачатьПолучениеВсех(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

