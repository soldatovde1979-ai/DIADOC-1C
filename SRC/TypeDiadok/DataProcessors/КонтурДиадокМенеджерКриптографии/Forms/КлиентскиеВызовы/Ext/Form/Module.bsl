&НаКлиенте
Функция ЗашифроватьКонтент(ДвоичныеДанные, МассивСертификатов)
	
	СертификатыКриптографии = Новый Массив;
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	Для Каждого СертификатЭлемент Из МассивСертификатов Цикл
		
		Если ТипЗнч(СертификатЭлемент) = Тип("Структура") Тогда
			Сертификат = ПолучитьДанныеСертификата(СертификатЭлемент.ОтпечатокСертификата, ПараметрыПоиска);
			ДвоичныеДанныеСертификата = Сертификат.ДвоичныеДанные;
		ИначеЕсли ТипЗнч(СертификатЭлемент) = Тип("Строка") Тогда
			Сертификат = ПолучитьДанныеСертификата(СертификатЭлемент, ПараметрыПоиска);
			ДвоичныеДанныеСертификата = Сертификат.ДвоичныеДанные;
		ИначеЕсли ТипЗнч(СертификатЭлемент) = Тип("ДвоичныеДанные") Тогда
			ДвоичныеДанныеСертификата = СертификатЭлемент;
		КонецЕсли;
		
		СертификатКриптографии = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
		
		СертификатыКриптографии.Добавить(СертификатКриптографии);
		
	КонецЦикла;
	
	МенеджерКриптографии = ИнициализироватьМенеджерКриптографии();
	
	Результат = МенеджерКриптографии.Зашифровать(ДвоичныеДанные, СертификатыКриптографии);
	
	Возврат Результат;
	
КонецФункции

