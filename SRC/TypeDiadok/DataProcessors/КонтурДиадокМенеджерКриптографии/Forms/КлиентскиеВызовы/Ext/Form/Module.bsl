&НаКлиенте
Функция ИнициализироватьМенеджерКриптографии()
	
	ТипМодуляКриптографии = 80;
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить("");
	
	ПутиМодулейКриптографии = ПутиКМодулямКриптоПроLinux();
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПутьМодуляКриптографии = ПутиМодулейКриптографии.Получить(Строка(СистемнаяИнформация.ТипПлатформы));
	Если ПутьМодуляКриптографии = Неопределено Тогда
		ПутьМодуляКриптографии = "";
	КонецЕсли;
	ПараметрыКонструктора.Добавить(ПутьМодуляКриптографии);
	ПараметрыКонструктора.Добавить(ТипМодуляКриптографии);
	
	Если НЕ ПриложениеСтаршеВерсии("8.3.13") Тогда
		ПараметрыКонструктора.Добавить(Вычислить("ИспользованиеИнтерактивногоРежимаКриптографии.Использовать"));
	КонецЕсли;
	
	МенеджерКриптографии = Новый("МенеджерКриптографии", ПараметрыКонструктора);
	
	Если ЗначениеЗаполнено(ПарольСертификата) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольСертификата;
	КонецЕсли;
	
	Возврат МенеджерКриптографии;
	
КонецФункции

&НаКлиенте
Процедура НачатьИнициализациюМенеджераКриптографии(Знач ОписаниеОповещения)
	
	ТипМодуляКриптографии = 80;
	ПутиМодулейКриптографии = ПутиКМодулямКриптоПроLinux();
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ПутьМодуляКриптографии = ПутиМодулейКриптографии.Получить(Строка(СистемнаяИнформация.ТипПлатформы));
	Если ПутьМодуляКриптографии = Неопределено Тогда
		ПутьМодуляКриптографии = "";
	КонецЕсли;
	
	МенеджерКриптографии = Новый("МенеджерКриптографии");
	
	ИспользоватьИнтерактивноеПолучениеПароля = Истина;
	Если ЗначениеЗаполнено(ПарольСертификата) Тогда
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = ПарольСертификата;
		ИспользоватьИнтерактивноеПолучениеПароля = Ложь;
	КонецЕсли;
	
	Если ИспользоватьИнтерактивноеПолучениеПароля Тогда
		РежимВводаПароля = Вычислить("ИспользованиеИнтерактивногоРежимаКриптографии.Использовать");
	Иначе
		РежимВводаПароля = Вычислить("ИспользованиеИнтерактивногоРежимаКриптографии.НеИспользовать");
	КонецЕсли;
	
	МенеджерКриптографии.НачатьИнициализацию(
		ОписаниеОповещения,
		"",
		ПутьМодуляКриптографии,
		ТипМодуляКриптографии,
		РежимВводаПароля);
	
КонецПроцедуры

