&НаКлиенте
Функция ПолучитьСписокСертификатов(ПараметрыПоиска)
	
	ХранилищеСертификатовКриптографии = ПолучитьХранилищеСертификатов(ПараметрыПоиска);
	
	Если ПараметрыПоиска.Свойство("Отпечаток") Тогда
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоОтпечатку(ПараметрыПоиска.Отпечаток);
		Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатКриптографии, ПараметрыПоиска);
	КонецЕсли;
	
	Если ПараметрыПоиска.Свойство("СерийныйНомер") Тогда
		СерийныйНомерСертификата = Base64Значение(ПараметрыПоиска.СерийныйНомер);
		СертификатКриптографии = ХранилищеСертификатовКриптографии.НайтиПоСерийномуНомеру(СерийныйНомерСертификата);
		Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатКриптографии, ПараметрыПоиска);
	КонецЕсли;
	
	СертификатыКриптографии = ХранилищеСертификатовКриптографии.ПолучитьВсе();
	Возврат РазобратьОтвет_ПолучитьСписокСертификатов(СертификатыКриптографии, ПараметрыПоиска);
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов)
	
	Результат = Новый Массив;
	
	Для Каждого ТекСертификат Из СписокСертификатов Цикл
		
		Если ЭтоВалидныйСертификат(ТекСертификат) Тогда
			
			ОписаниеСертификата = ОписаниеСертификата(ТекСертификат);
			Результат.Добавить(ОписаниеСертификата);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ОписаниеСертификата(Сертификат) Экспорт
	
	Результат = Контракт_ОписаниеСертификата();
	
	СубъектСертификата = Сертификат.Субъект;
	
	Результат.Наименование = НаименованиеСертификата(СубъектСертификата);
	Результат.ДатаВыдачи = Сертификат.ДатаНачала;
	Результат.СрокДействия = Сертификат.ДатаОкончания;
	Результат.ОтпечатокСертификата = ВРег(Сертификат.Отпечаток);
	Результат.СерийныйНомер = Сертификат.СерийныйНомер;
	Результат.Издатель = Сертификат.Издатель.CN;
	Результат.ОрганизацияИздателя = СвойствоСтруктуры(Сертификат.Издатель, "O", "");
	Результат.Организация = СвойствоСтруктуры(СубъектСертификата, "O", "");
	Результат.ИНН = ИННСертификата(СубъектСертификата);
	Результат.КПП = КППСертификата(СубъектСертификата);
	Результат.Тип = ТипСертификата(СубъектСертификата);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Контракт_ОписаниеСертификата() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Наименование");
	Результат.Вставить("ДатаВыдачи");
	Результат.Вставить("СрокДействия");
	Результат.Вставить("ОтпечатокСертификата");
	Результат.Вставить("СерийныйНомер");
	Результат.Вставить("Издатель");
	Результат.Вставить("ОрганизацияИздателя");
	Результат.Вставить("Организация");
	Результат.Вставить("ИНН");
	Результат.Вставить("КПП");
	Результат.Вставить("Тип");
	Результат.Вставить("Ошибка");
	Результат.Вставить("ЭтоКЭП", Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НаименованиеСертификата(СубъектСертификата)
	
	Если ТипЗнч(СубъектСертификата) = Тип("Структура") Тогда
		
		Результат = НаименованиеСубъекта(СубъектСертификата);
		
	ИначеЕсли ТипЗнч(СубъектСертификата) = Тип("Массив") Тогда
		
		Для Каждого Субъект Из СубъектСертификата Цикл
			
			Результат = НаименованиеСубъекта(Субъект);
			
			Если ЗначениеЗаполнено(Результат) Тогда
				Прервать;
