&НаКлиенте
Функция Новый_ОписаниеСертификата(СертификатКриптографии)
	
	Результат = Новый Структура();
	
	Результат.Вставить("Отпечаток", HexСтрокаИзДвоичныхДанных(СертификатКриптографии.Отпечаток));
	Результат.Вставить("СерийныйНомер", HexСтрокаИзДвоичныхДанных(СертификатКриптографии.СерийныйНомер));
	Результат.Вставить("Издатель", Новый Структура(СертификатКриптографии.Издатель));
	
	Результат.Вставить("Субъект", Новый Структура(СертификатКриптографии.Субъект));
	
	Если СертификатКриптографии.Субъект.Свойство("OGRN") Тогда
		Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OGRN);
	ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_1") Тогда
		Результат.Субъект.Вставить("ОГРН", СертификатКриптографии.Субъект.OID1_2_643_100_1);
	КонецЕсли;
	
	Если СертификатКриптографии.Субъект.Свойство("OGRNIP") Тогда
		Результат.Субъект.Вставить("ОГРНИП", СертификатКриптографии.Субъект.OGRNIP);
	ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_5") Тогда
		Результат.Субъект.Вставить("ОГРНИП" , СертификатКриптографии.Субъект.OID1_2_643_100_5);
	КонецЕсли;
	
	Если СертификатКриптографии.Субъект.Свойство("SNILS") Тогда
		Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.SNILS);
	ИначеЕсли СертификатКриптографии.Субъект.Свойство("OID1_2_643_100_3") Тогда
		Результат.Субъект.Вставить("СНИЛС", СертификатКриптографии.Субъект.OID1_2_643_100_3);
	КонецЕсли;
	
	ЗаполнитьИНН(Результат.Субъект, СертификатКриптографии.Субъект);
	
	Результат.Вставить("ДатаНачала", СертификатКриптографии.ДатаНачала);
	Результат.Вставить("ДатаОкончания", СертификатКриптографии.ДатаОкончания);
	Результат.Вставить("РасширенныеСвойства", Новый Структура(СертификатКриптографии.РасширенныеСвойства));
	Результат.Вставить("ДвоичныеДанные", Неопределено);
	Результат.Вставить("АлгоритмКлюча", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьИНН(Свойства, Данные)
	
	ИННЮЛ = Неопределено;
	ИНН = Неопределено;
	
	Если Данные.Свойство("INN") Тогда
		ИНН = Данные.INN;
	ИначеЕсли Данные.Свойство("OID1_2_643_3_131_1_1") Тогда
		ИНН = Данные.OID1_2_643_3_131_1_1;
	КонецЕсли;
	
	Если Данные.Свойство("INNLE") Тогда
		ИННЮЛ = Данные.INNLE;
	ИначеЕсли Данные.Свойство("OID1_2_643_100_4")
			И СтрДлина(Данные.OID1_2_643_100_4) = 10 Тогда
		ИННЮЛ = Данные.OID1_2_643_100_4;
	ИначеЕсли Данные.Свойство("_1_2_643_100_4") Тогда
		ИННЮЛ = Данные._1_2_643_100_4;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИННЮЛ) Тогда
		Свойства.Вставить("ИННЮЛ", ИННЮЛ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		Свойства.Вставить("ИНН", ИНН);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция HexСтрокаИзДвоичныхДанных(ДвоичныеДанные)
	
	Если ПриложениеСтаршеВерсии("8.3.10") Тогда
		
		Результат = СтрЗаменить(Строка(ДвоичныеДанные), " ", "");
		
	Иначе
		
		Результат = Вычислить("ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные)");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПараметрыПоискаСертификатов()
	
	Результат = Новый Структура;
	Результат.Вставить("ТипХранилища", ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	Результат.Вставить("РасположениеХранилища", РасположениеХранилищаСертификатовКриптографии.ДанныеПользователяОС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НачатьПолучениеОписанияСертификата(СертификатКриптографии, ОписаниеОповещения)
	
	Результат = Новый_ОписаниеСертификата(СертификатКриптографии);
	
	ДопПарам = Новый Структура;
	ДопПарам.Вставить("ОписаниеСертификата", Результат);
	ДопПарам.Вставить("ОповещениеОЗавершении", ОписаниеОповещения);
	
	ОписаниеОповещенияОЗавершении = НовыйОписаниеОповещения(
			"ДополнитьОписаниеСертификатаЗавершение",
			ЭтаФорма,
			ДопПарам);
	
	СертификатКриптографии.НачатьВыгрузку(ОписаниеОповещенияОЗавершении);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьОписаниеСертификатаЗавершение(ДвоичныеДанные, ДополнительныеПараметры) Экспорт
	
	ОписаниеСертификата = ДополнительныеПараметры.ОписаниеСертификата;
	ОповещениеОЗавершении = ДополнительныеПараметры.ОповещениеОЗавершении;
	
	ОписаниеСертификата.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	ОписаниеСертификата.Вставить("АлгоритмКлюча", "");
	
	ВыполнитьОбработкуОповещенияПереопределенная(ОповещениеОЗавершении, ОписаниеСертификата);
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСертификатВМассивеПоОтпечатку(МассивСертификатов, ОтпечатокСертификата)
	
	Результат = Неопределено;
	
	Для Каждого Сертификат Из МассивСертификатов Цикл
		
		ТекущийОтпечаток = HexСтрокаИзДвоичныхДанных(Сертификат.Отпечаток);
		
		Если ВРЕГ(ТекущийОтпечаток) = ВРЕГ(ОтпечатокСертификата) Тогда
			
			Результат = Сертификат;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НайтиСертификатВМассивеСерийномуНомеру(МассивСертификатов, СерийныйНомер)
	
	Результат = Неопределено;
	
	Для Каждого Сертификат Из МассивСертификатов Цикл
		
		ТекущийОтпечаток = HexСтрокаИзДвоичныхДанных(Сертификат.СерийныйНомер);
		
		Если ВРЕГ(ТекущийОтпечаток) = ВРЕГ(СерийныйНомер) Тогда
			
			Результат = Сертификат;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Перечисление_ТипыСертификатовКЭП() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЮЛ", "ЮЛ");
	Результат.Вставить("ИП", "ИП");
	Результат.Вставить("ФЛ", "ФЛ");
	
	Возврат Результат;
	
КонецФункции


