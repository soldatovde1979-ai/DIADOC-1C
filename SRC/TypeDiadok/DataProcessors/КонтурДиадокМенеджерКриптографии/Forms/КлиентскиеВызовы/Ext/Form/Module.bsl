					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Результат.Добавить(Новый_ОписаниеСертификата(Ответ));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
