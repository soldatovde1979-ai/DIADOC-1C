&НаКлиенте
Функция КППСубъекта(Субъект)
	
	Результат = "";
	
	НеструктурированноеИмя = СвойствоСтруктуры(Субъект, "_1_2_840_113549_1_9_2");
	
	Если ЗначениеЗаполнено(НеструктурированноеИмя) Тогда
		
		ЭлементыЗначения = РазделитьСтрокуЛок(НеструктурированноеИмя, "-");
		
		Если ЭлементыЗначения.Количество() > 1 Тогда
			Результат = ЭлементыЗначения[1];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ТипСертификата(СубъектСертификата)
	
	ТипыСертификатовКЭП = Перечисление_ТипыСертификатовКЭП();
	
	ИННЮЛ = СвойствоСтруктуры(СубъектСертификата, "ИННЮЛ");
	ИНН = СвойствоСтруктуры(СубъектСертификата, "ИНН");
	ОГРН = СвойствоСтруктуры(СубъектСертификата, "ОГРН");
	ОГРНИП = СвойствоСтруктуры(СубъектСертификата, "ОГРНИП");
	
	Если Лев(ИНН, 2) = "00" Тогда
		ИНН = Сред(ИНН, 3);
	КонецЕсли;
	
	ПустойИННЮЛ = "0000000000";
	ПустойИННФЛ = "000000000000";
	ПустойОГРН = "0000000000000";
	ПустойОГРНИП = "000000000000000";
	
	ДлинаИННЮЛ = СтрДлина(ПустойИННЮЛ);
	ДлинаИННФЛ = СтрДлина(ПустойИННФЛ);
	ДлинаОГРН = СтрДлина(ПустойОГРН);
	ДлинаОГРНИП = СтрДлина(ПустойОГРНИП);
	
	ПрефиксНерезидента = "9909";
	
	Резидент = Лев(ИННЮЛ, СтрДлина(ПрефиксНерезидента)) <> ПрефиксНерезидента
		И Лев(ИНН, СтрДлина(ПрефиксНерезидента)) <> ПрефиксНерезидента;
	
	ЗаполненИННЮЛ = СтрДлина(ИННЮЛ) = ДлинаИННЮЛ
		И ИННЮЛ <> ПустойИННЮЛ;
	
	ЗаполненИНН = СтрДлина(ИНН) = ДлинаИННФЛ
		И ИНН <> ПустойИННФЛ;
	
	ЗаполненИНН_ЮЛ = СтрДлина(ИНН) = ДлинаИННЮЛ
		И ИНН <> ПустойИННЮЛ;
	
	ЗаполненОГРНИП = СтрДлина(ОГРНИП) = ДлинаОГРНИП
		И ОГРНИП <> ПустойОГРНИП;
	
	ЗаполненОГРН = СтрДлина(ОГРН) = ДлинаОГРН
		И ОГРН <> ПустойОГРН;
	
	ЗаполненОГРН = (Резидент И ЗаполненОГРН
			ИЛИ НЕ Резидент И НЕ ЗаполненОГРН)
		И НЕ ЗначениеЗаполнено(ОГРНИП);
	
	Если ЗаполненИННЮЛ
		И ЗаполненОГРН Тогда
		
		Результат = ТипыСертификатовКЭП.ЮЛ;
		
	ИначеЕсли НЕ ЗаполненИННЮЛ
		И ЗаполненИНН_ЮЛ
		И ЗаполненОГРН Тогда
		
		Результат = ТипыСертификатовКЭП.ЮЛ;
		
	ИначеЕсли НЕ ЗаполненИННЮЛ
		И ЗаполненИНН
		И ЗаполненОГРНИП
		И НЕ ЗаполненОГРН Тогда
		
		Результат = ТипыСертификатовКЭП.ИП;
		
	ИначеЕсли НЕ ЗаполненИННЮЛ
		И ЗаполненИНН
		И НЕ ЗаполненОГРНИП
		И НЕ ЗаполненОГРН Тогда
		
		Результат = ТипыСертификатовКЭП.ФЛ;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

