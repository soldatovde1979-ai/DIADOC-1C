Функция ПечатнаяФормаПрото(Прото, ФорматОтправки, ДопПараметры) Экспорт
	
	ТипДокумента = ФорматОтправки.ИмяТипа;
	ТипКонтента = ФорматОтправки.ТипКонтента;
	
	МодульПечатныеФормы = ПолучитьМодульПрог("ПечатныеФормы");
	Результат = МодульПечатныеФормы.ПечатнаяФормаПротоКонтента(Прото, ТипКонтента, ТипДокумента, ДопПараметры);
	
	Возврат Результат;
	
КонецФункции

// Формирует протоструктуру для отправки электронного документа в заданном формате.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ФорматОтправки	 - Структура - содержит свойства:
//    * ИмяТипа			 - Строка - имя типа документа (typeNameId);
//    * ФункцияДокумента - Строка - функция документа (Function);
//    * ВерсияФормата	 - Строка - версия формата контента (Version);
//  ДополнительныеПараметры - Структура - см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентФормализованногоДокумента(СсылкаНаДокумент, ФорматОтправки, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	ОписаниеФормата = ОписаниеФорматаЭлектронногоДокумента(ФорматОтправки.ИмяТипа
	, ФорматОтправки.ФункцияДокумента
	, ФорматОтправки.ВерсияФормата);
	
	БазовыеФорматы = БазовыеФорматы();
	БазовыйФормат = ОписаниеФормата.БазовыйФормат;
	
	ПараметрыФормирования.ФункцияДокумента = ФункцияУниверсальногоДокумента(ОписаниеФормата);
	
	Если БазовыйФормат = БазовыеФорматы.utd820 Тогда
		
		Результат = КонтентУПД820(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.utd Тогда
		
		Результат = КонтентУПД155(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.ucd736 Тогда
		
		Результат = КонтентУКД736(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.ucd Тогда
		
		Результат = КонтентУКД189(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.torg12 Тогда
		
		Результат = КонтентНакладной172(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.act Тогда
		
		Результат = КонтентАкта172(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.invoice Тогда
		
		Результат = КонтентСчетаФактуры93(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.invoicecor Тогда
		
		Результат = КонтентКорректировочногоСчетаФактуры93(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.proformainvoice Тогда
		
		Результат = КонтентФормализованногоСчета(СсылкаНаДокумент, ПараметрыФормирования);
		
	Иначе
		
		ТекстОшибки = ПодставитьПараметрыВСтроку("Формат отправки не поддерживается!
		|Тип документа: %1
		|Функция документа: %2
		|Версия документа: %3"
		, ОписаниеФормата.ИмяТипа
		, ОписаниеФормата.ФункцияДокумента
		, ОписаниеФормата.ВерсияФормата);
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации()
		, УровеньЖурналаРегистрации.Ошибка
		, СсылкаНаДокумент.Метаданные()
		, СсылкаНаДокумент
		, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ЗаполнитьСлужебнуюИнформациюШапки(Результат.СлужебнаяИнформация, СсылкаНаДокумент);
	
	Возврат Результат;
	
КонецФункции

// Создает структуру параметров для заполнения служебной информации о документе,
// которая будет передана в протоструктуру контента документа.
// 
// Возвращаемое значение:
//  Структура.
//
Функция НовыйСлужебнаяИнформацияШапки(СсылкаНаОбъект = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", СсылкаНаОбъект);
	Результат.Вставить("Организация");
	Результат.Вставить("Контрагент");
	
	Возврат Результат;
	
КонецФункции

// Дополняет структуру контента документа служебной информацией об источнике заполнения контента:
// ссылками на сам документ, контрагента, организацию и т.д.
//
// Параметры:
//  Контент - Структура - протоструктура с контентом электронного документа;
//  СсылкаНаОбъект - ЛюбаяСсылка - источник данных для формирования контента;
//
Процедура ЗаполнитьСлужебнуюИнформациюШапки(СлужебнаяИнформация, СсылкаНаОбъект)
	
	ТребуемыеРеквизиты = Новый Структура;
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "Организация") Тогда
		ТребуемыеРеквизиты.Вставить("Организация");
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "Контрагент") Тогда
		ТребуемыеРеквизиты.Вставить("Контрагент");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		
		ЗначенияРеквизитов = ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, ТребуемыеРеквизиты);
		ЗаполнитьЗначенияСвойств(СлужебнаяИнформация, ЗначенияРеквизитов);
		
	КонецЕсли;
	
	СлужебнаяИнформация.Ссылка = СсылкаНаОбъект;
	
КонецПроцедуры

Процедура ИнициализироватьСлужебныеПоляПрото(Контент)
	
	Контент.Вставить("ОшибкиВДанных", Новый Массив);
	Контент.Вставить(ИмяСвойстваСлужебнаяИнформация(), НовыйСлужебнаяИнформацияШапки());
	
КонецПроцедуры

// Возвращает информацию о стране происхождения товара в формате строки.
//
// Параметры:
//  КоллекцияСведений - Структура - Коллекция сведений о стране происхождения:
//      * СтранаПроисхождения - СправочникСсылка.СтраныМира - Страна происхождения товара.
//      * НомерГТД            - СправочникСсылка.НомераГТД - Номер грузовой таможенной декларации.
//
// Возвращаемое значение:
//   Строка - Сведения о стране происхождения товара для поля StructedAdditionalInfo в формате Ключ=Значение.
//
Функция СведенияОСтранеПроисхожденияСтрокой(КоллекцияСведений) Экспорт
	
	ПараметрыСтроки = Новый Массив;
	
	Если ЗначениеЗаполнено(КоллекцияСведений.СтранаПроисхождения) Тогда
		
		КодСтраныПроисхождения = ПривестиКЧислу(СокрЛП(КоллекцияСведений.СтранаПроисхождения.Код));
		
		ШаблонКодСтраныПроисхождения	= НСтр("ru = 'цифровой код страны происхождения=%1'");
		ПараметрКодСтраныПроисхождения	= ПодставитьПараметрыВСтроку(ШаблонКодСтраныПроисхождения, КодСтраныПроисхождения);
		
		ШаблонСтранаПроисхождения	= НСтр("ru = 'краткое наименование страны происхождения=%1'");
		ПараметрСтранаПроисхождения	= ПодставитьПараметрыВСтроку(ШаблонСтранаПроисхождения, КоллекцияСведений.СтранаПроисхождения);
		
		ПараметрыСтроки.Добавить(ПараметрКодСтраныПроисхождения);
		ПараметрыСтроки.Добавить(ПараметрСтранаПроисхождения);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоллекцияСведений.НомерГТД) Тогда
		
		ШаблонНомерГТД		= НСтр("ru = 'регистрационный номер декларации на товары=%1'");
		ПараметрНомерГТД	= ПодставитьПараметрыВСтроку(ШаблонНомерГТД, КоллекцияСведений.НомерГТД);
		
		ПараметрыСтроки.Добавить(ПараметрНомерГТД);
		
	КонецЕсли;
	
	СведенияОстранеПроисхождения = Преобразование_МассивВСтроку(ПараметрыСтроки, ";");
	
	Возврат СведенияОстранеПроисхождения;
	
КонецФункции

// Возвращает информацию о стране происхождения товара в виде структуры.
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - Строка табличной части Товары.
//
// Возвращаемое значение:
//   Структура - Сведения о стране происхождения товара для поля StructedAdditionalInfo:
//      * СтранаПроисхождения - СправочникСсылка.СтраныМира - Страна происхождения товара.
//      * НомерГТД            - СправочникСсылка.НомераГТД - Номер грузовой таможенной декларации.
//
Функция КоллекцияСведенийОСтранеПроисхождения(СтрокаДанных)
	
	Результат = Новый Структура;
	Результат.Вставить("СтранаПроисхождения"	, СтрокаДанных.СтранаПроисхождения);
	Результат.Вставить("НомерГТД"				, СтрокаДанных.НомерГТД);
	
	Возврат Результат;
	
КонецФункции

// Инициализирует структуру дополнительных параметров для методов сбора контента.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//    * ИспользоватьСервисКонтурМаркировка - Булево - Истина, если для получения сведений о маркировке следует
//                                                    использовать данные подсистемы Контур.Маркировка.
//    * УказыватьОтсутствиеОснованияУПД - Булево - Истина, если при незаполненном основании передачи
//                                                 товаров (услуг, работ) в поле GroundName следует
//                                                 в указывать строку, определенную форматом для пустого
//                                                 основания передачи (например, "Отсутствует" для 155@
//                                                 или "Без документа-основания" для 820@).
//    * ФункцияДокумента - Строка - функция документа для формирования XML. Обязательно для УПД/УКД.
//    * ДополнительныеСведенияСтрокой - Строка - (Устарел) Список доп. полей в формате "ИмяПоля = Значение".
//                                               Доп. поля указываются через точку с запятой.
//    * ПараметрыСогласования - Структура - Заполняется при передаче документа на согласование/подпись:
//       ** ФИОПодписанта - Строка - Фамилия, имя и отчетство подписанта;
//       ** ДолжностьПодписанта - Строка - должность подписанта;
//       ** ФИОПолучателя - Строка - Фамилия, имя и отчество получателя;
//       ** ДолжностьПолучателя - Строка - должность получателя;
//    * ОтправительИдентификаторЭДО - Строка - идентификатор участника ЭДО отправителя документа;
//    * ПолучательИдентификаторЭДО - Строка - идентификатор участника ЭДО получателя документа;
//    * ДанныеСотрудника - Структура - см. ДанныеКонтекстаДиадок(Организация, "ДанныеСотрудника");
//    * ТипДокумента - Строка - идентификатор типа документа (используется только для Актов в формате УПД);
//    * НомерЗаказа - Строка - используется только для накладной 172@;
//
Функция ДополнительныеПараметрыПолученияКонтента() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("УказыватьОтсутствиеОснованияУПД", Ложь);
	Результат.Вставить("ДополнительныеСведенияСтрокой", "");
	Результат.Вставить("ФункцияДокумента", Неопределено);
	Результат.Вставить("ПараметрыСогласования", Неопределено);
	Результат.Вставить("ОтправительИдентификаторЭДО", Неопределено);
	Результат.Вставить("ПолучательИдентификаторЭДО", Неопределено);
	Результат.Вставить("ДанныеСотрудника", Неопределено);
	Результат.Вставить("НомерЗаказа", Неопределено);
	Результат.Вставить("ТипДокумента", Неопределено);
	Результат.Вставить("ИспользоватьСервисКонтурМаркировка", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Инициализирует структуру с параметрами события ПМ "ПослеЗаполненияКонтента"
//
// Параметры:
//  Контент			 - Структура	 - протоконтент;
//  ТипКонтента		 - Строка		 - идентификатор типа контента (см. ТипыКонтента())
//  СсылкаНаДокумент - ЛюбаяСсылка	 - ссылка на документ информационной базы;
// 
// Возвращаемое значение:
//  Структура - см. тело функции.
//
Функция ПараметрыЗаполненияКонтентаДляПМ(Контент, ТипКонтента, СсылкаНаДокумент)
	
	Результат = Новый Структура;
	Результат.Вставить("Content", Контент);
	Результат.Вставить("ТипКонтента", ТипКонтента);
	Результат.Вставить("ДокументСсылка", СсылкаНаДокумент);
	
	// Необязательные параметры
	Результат.Вставить("ПараметрыОтправкиНаСогласование"); // Устарел, для совместимости со старыми ПМ
	Результат.Вставить("НомерЗаказа"); // Используется только для накладной 172@
	Результат.Вставить("ДопСведения");
	Результат.Вставить("DocumentType"); // Устарел, для совместимости с ПМ 1.4 или ниже.
	Результат.Вставить("Данные"); // Устарел, данные документа, по которым был заполнен контент
	
	Возврат Результат;
	
КонецФункции

// Программный интерфейс вызова события ПМ 
//
// Параметры:
//  Контент - Структура - протоструктура с описанием контента.
//  ТипКонтента - Строка - см. метод ТипыКонтента().
//  СсылкаНаДокумент - ЛюбаяСсылка - документ информационной базы, на основании которого собирается контент.
//  ПараметрыФормирования - Структура - см. ДополнительныеПараметрыПолученияКонтента.
//
Процедура ПМ_ПослеЗаполненияКонтента(Контент, ТипКонтента, СсылкаНаДокумент, ПараметрыФормирования) Экспорт
	
	ПараметрыПМ = ПараметрыЗаполненияКонтентаДляПМ(Контент, ТипКонтента, СсылкаНаДокумент);
	ПараметрыПМ.ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ПараметрыПМ.ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	ВсеТипыКонтента = ТипыКонтента();
	Если ТипКонтента = ВсеТипыКонтента.UtdSellerContent Тогда
		ПараметрыПМ.DocumentType = "UniversalTransferDocument";
	КонецЕсли;
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияКонтента", ПараметрыПМ);
	
КонецПроцедуры

// Формирует и заполняет структуру Utd820SellerContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ДополнительныеПараметры - Структура, Неопределено - см. функцию ДополнительныеПараметрыПолученияКонтента();
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентУПД820(СсылкаНаДокумент, ДополнительныеПараметры = Неопределено)
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	РежимСовместимости155и820 = КонстантаРежимСовместимостиФорматов155и820();
	
	Контент155 = Новый_UTDSellerContent();
	СтруктураДокумента = ДанныеДляФормированияУПД(СсылкаНаДокумент, ПараметрыФормирования);
	ЗаполнитьКонтентУПД155(Контент155, СтруктураДокумента, ПараметрыФормирования);
	
	Если РежимСовместимости155и820 Тогда
		
		ПараметрыПМ = ПараметрыЗаполненияКонтентаДляПМ(Контент155, ТипыКонтента().UtdSellerContent, СсылкаНаДокумент);
		ПараметрыПМ.DocumentType = "UniversalTransferDocument";
		ПараметрыПМ.Данные		 = СтруктураДокумента;
		ПараметрыПМ.ДопСведения	 = ДополнительныеПараметры.ДополнительныеСведенияСтрокой;
		ПараметрыПМ.ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияКонтента", ПараметрыПМ);
		
	КонецЕсли;
	
	Результат = Новый_Utd820SellerContent();
	ЗаполнитьКонтентУПД820ИзКонтентаУПД155(Результат, Контент155);
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции(); 
	
	МенеджерИнтеграции.ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку(Результат, СсылкаНаДокумент);
	
	ИспользоватьКМ = ПараметрыФормирования.ИспользоватьСервисКонтурМаркировка;
	МенеджерИнтеграции.ЗаполнитьСведенияОМаркировке(Результат, СсылкаНаДокумент, ИспользоватьКМ);
	
	МенеджерИнтеграции.ЗаполнитьСведенияПрослеживаемости(Результат);
	
	МенеджерИнтеграции.ЗаполнитьОбстФормСЧФ820(Результат, СсылкаНаДокумент, ПараметрыФормирования.ФункцияДокумента);
	
	Если Не РежимСовместимости155и820 Тогда
		
		ПараметрыПМ = ПараметрыЗаполненияКонтентаДляПМ(Результат, ТипыКонтента().Utd820SellerContent, СсылкаНаДокумент);
		ПараметрыПМ.ДопСведения = ДополнительныеПараметры.ДополнительныеСведенияСтрокой;
		ПараметрыПМ.ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
		ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияКонтента", ПараметрыПМ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

