	СтруктураДокумента = ДанныеДляФормированияТорг12(СсылкаНаДокумент, Истина, Ложь);
	ЗаполнитьКонтентАкта172(Результат, СтруктураДокумента, ПараметрыФормирования);
	
	ПараметрыПМ = ПараметрыЗаполненияКонтентаДляПМ(Результат, ТипыКонтента().AcceptanceCertificateSellerContent, СсылкаНаДокумент);
