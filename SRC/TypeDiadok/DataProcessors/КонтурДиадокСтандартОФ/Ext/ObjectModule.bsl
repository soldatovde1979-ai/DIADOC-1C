Процедура ЗаполнитьИтоговыеСуммыДокумента(ТабличнаяЧасть, ДанныеШапки)
	
	СуммаБезНДСДокумента = 0;
	СуммаНДСДокумента    = 0;
	СуммаДокумента       = 0;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		СуммаБезНДСДокумента = СуммаБезНДСДокумента + СтрокаТЧ.Сумма - ?(СтрокаТЧ.СуммаВключаетНДС, СтрокаТЧ.СуммаНДС, 0);
		СуммаНДСДокумента    = СуммаНДСДокумента + СтрокаТЧ.СуммаНДС;
		СуммаДокумента       = СуммаДокумента + СтрокаТЧ.Сумма + ?(СтрокаТЧ.СуммаВключаетНДС, 0, СтрокаТЧ.СуммаНДС);
	КонецЦикла;
	
	ДанныеШапки.СуммаБезНДСДокумента = Окр(СуммаБезНДСДокумента, 2);
	ДанныеШапки.СуммаНДСДокумента    = Окр(СуммаНДСДокумента, 2);
	ДанныеШапки.СуммаДокумента       = Окр(СуммаДокумента, 2);
	
КонецПроцедуры

Процедура ОчиститьСсылкиСтраныИГТДВСтрокеТабЧасти(СтрокаТЧ)
	
	Если  ЗначениеЗаполнено(СтрокаТЧ.СтранаПроисхождения)
		И ПустаяСтрока(Модуль_Интеграция.ПолучитьНомерГТД(СтрокаТЧ.НомерГТД))
		И СтранаЧленТС(СтрокаТЧ.СтранаПроисхождения.Код) Тогда
		
		Если СтранаРФ(СтрокаТЧ.СтранаПроисхождения.Код) Тогда
			СтрокаТЧ.СтранаПроисхождения = Справочники.КлассификаторСтранМира.ПустаяСсылка();
		КонецЕсли;
		
		СтрокаТЧ.НомерГТД = Модуль_Интеграция.ПустаяСсылкаНаНомерГТД();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных)
	
	СлужебнаяИнформация = Новый Структура;
	СлужебнаяИнформация.Вставить("Номенклатура");
	СлужебнаяИнформация.Вставить("Характеристика");
	СлужебнаяИнформация.Вставить("Серия");
	СлужебнаяИнформация.Вставить("НомерГТД");
	СлужебнаяИнформация.Вставить("Упаковка");
	СлужебнаяИнформация.Вставить("УпаковкаДоИзменения");
	СлужебнаяИнформация.Вставить("ЕдиницаИзмерения");
	СлужебнаяИнформация.Вставить("ЕдиницаИзмеренияДоИзменения");
	СлужебнаяИнформация.Вставить("СтранаПроисхождения");
	СлужебнаяИнформация.Вставить("ДанныеПрослеживаемости");
	СлужебнаяИнформация.Вставить("ПрослеживаемыйТовар");
	СлужебнаяИнформация.Вставить("ДокументОтгрузки");
	
	ЗаполнитьЗначенияСвойств(СлужебнаяИнформация, СтрокаДанных);
	
	НоменклатураСсылка = СтрокаДанных.Номенклатура;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаДанных, "НоменклатураСсылка") Тогда 
		НоменклатураСсылка = СтрокаДанных.НоменклатураСсылка;
	КонецЕсли;
	
	СлужебнаяИнформация.Номенклатура = НоменклатураСсылка;
	
	Item.СлужебнаяИнформация = СлужебнаяИнформация;
	
	// для обратной совместимости с ПМ
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "НоменклатураСсылка") Тогда 
		Item.НоменклатураСсылка = НоменклатураСсылка;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "ХарактеристикаСсылка") Тогда 
		Item.ХарактеристикаСсылка = СтрокаДанных.Характеристика;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "СерияСсылка") Тогда 
		Item.СерияСсылка = СтрокаДанных.Серия;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "ЕдиницаИзмеренияСсылка") Тогда 
		Item.ЕдиницаИзмеренияСсылка = СлужебнаяИнформация.ЕдиницаИзмерения;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "СсылкаНаЕИ") Тогда 
		Item.СсылкаНаЕИ = СлужебнаяИнформация.ЕдиницаИзмерения;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "OriginalValues") 
		И ЕстьРеквизитИлиСвойствоОбъектаЛок(Item.OriginalValues, "ЕдиницаИзмеренияСсылка") Тогда 
		Item.OriginalValues.ЕдиницаИзмеренияСсылка = СлужебнаяИнформация.ЕдиницаИзмеренияДоИзменения;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "CorrectedValues") 
		И ЕстьРеквизитИлиСвойствоОбъектаЛок(Item.CorrectedValues, "ЕдиницаИзмеренияСсылка") Тогда 
		Item.CorrectedValues.ЕдиницаИзмеренияСсылка = СлужебнаяИнформация.ЕдиницаИзмерения;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Item, "СтранаПроисхожденияСсылка") Тогда 
		Item.СтранаПроисхожденияСсылка = СлужебнаяИнформация.СтранаПроисхождения;
	КонецЕсли;
	
КонецПроцедуры

