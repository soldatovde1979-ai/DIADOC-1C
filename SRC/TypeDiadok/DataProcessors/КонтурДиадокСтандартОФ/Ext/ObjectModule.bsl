// Конструктор дополнительных параметров создания документа информационной базы.
// 
// Возвращаемое значение:
//  Структура:
//    * Формат - Структура - описание формата электронного документа.
//    * Контрагент - Произвольный - Ссылка на контрагента ИБ.
//    * Организация - Произвольный - Ссылка на организацию ИБ.
//    * ЦенаВключаетНДС - Булево - Истина, если нужно пересчитать цены и включить в них НДС.
//    * ДокументОснование - Произвольный - Ссылка на документ ИБ, который нужно использовать в качестве основания.
//
Функция ПараметрыСозданияДокументаИнформационнойБазы() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Формат");
	Результат.Вставить("Контрагент");
	Результат.Вставить("Организация");
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("ДокументОснование");
	Результат.Вставить("ИспользоватьКонтурМаркировку", КонстантаИспользоватьСервисКонтурМаркировка());
	
	Возврат Результат;

КонецФункции

// Создает новый экземпляр документа информационной базы и заполняет его
// по данным электронного документа. Созданный объект при этом не записывается.
// 
//
// Параметры:
//  Содержимое - ДвоичныеДанные - бинарные данные файла.
//             - ОбъектXDTO - объектная модель формализованного документа (ФНС).
//             - Строка - содержимое XML-файла.
//             - Строка - путь к файлу.
//  ИдентификаторОперации - Строка - Идентификатор правила создания и заполнения документа ИБ.
//  ДополнительныеПараметры - Структура - (Необязательный) дополнительные параметры заполнения документа ИБ.
// 
// Возвращаемое значение:
//  ДокументОбъект, СправочникОбъект - заполненный объект информационной базы.
//
// Пример 1:
//  ПараметрыСоздания = ПараметрыСозданияДокументаИнформационнойБазы();
//  ПараметрыСоздания.Контрагент = Документ.Отправитель.Организация;
//  ПараметрыСоздания.ЦенаВключаетНДС = Истина;
//  НовыйДокумент = НовыйДокументИнформационнойБазы(ФайлXML, "ПоступлениеТоваровУслуг", ПараметрыСоздания);
//
// Пример 2:
//  НовыйДокумент = НовыйДокументИнформационнойБазы("C:\temp\УПД 1.xml", "ПоступлениеТоваровУслуг_Оборудование");
//
// Пример 3:
//  ПараметрыСоздания = ПараметрыСозданияДокументаИнформационнойБазы();
//  ПараметрыСоздания.ДокументОснование = СсылкаНаПТУ;
//  ПараметрыСоздания.Формат = НовоеОписаниеФорматаЭлектронногоДокумента("Invoice", "default", "utd820_05_01_01_hyphen");
//  НовыйДокумент = НовыйДокументИнформационнойБазы(Utd820SellerContent, "СчетФактураПолученный", ПараметрыСоздания);
//
Функция НовыйДокументИнформационнойБазы(Содержимое, ИдентификаторОперации, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыСоздания = ПараметрыСозданияДокументаИнформационнойБазы();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыСоздания, ДополнительныеПараметры);
	КонецЕсли;
	
	ГенерацияXML = МодульГенерацияXML();
	ОбъектXDTO = ГенерацияXML.XML_В_ОбъектXDTO(Содержимое);
	
	ФорматЭД = ДополнительныеПараметры.Формат;
	ДанныеЭД = ДанныеЭлектронногоДокумента(ОбъектXDTO, ФорматЭД, ПараметрыСоздания.Контрагент);
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции();
	НовыйОбъект = МенеджерИнтеграции.НовыйДокументИнформационнойБазы(
		ИдентификаторОперации,
		ПараметрыСоздания,
		ДанныеЭД
	);
	
	Возврат НовыйОбъект;
	
КонецФункции

// Получает список правил для создания учетных документов
// на основании электронных документов в указанном формате.
//
// Параметры:
//  ФорматЭД - Структура - содержит свойства:
//    * ИмяТипа			 - Строка - имя типа документа (TypeNamedId);
//    * ФункцияДокумента - Строка - функция документа (Function);
//    * ВерсияФормата	 - Строка - версия формата контента (Version);
// 
// Возвращаемое значение:
//  СписокЗначений - идентификаторы правил создания и их пользовательские представления.
//
Функция ПравилаСозданияДокументовУчета(ФорматЭД) Экспорт
	
	Результат = Новый СписокЗначений;
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции();
	
	ОписаниеФормата = ПолноеОписаниеФорматаЭлектронногоДокумента(ФорматЭД);
	
	МенеджерИнтеграции.ЗаполнитьПравилаСозданияДокументовУчета(Результат, ФорматЭД);
	
	Возврат Результат;
	
КонецФункции

// Получает номенклатуру информационной базы, соответствующую идентификаторам номенклатуры контрагента.
//
// Параметры:
//  ВладелецНоменклатуры - ОпределяемыйТип.ВладелецНоменклатурыБЭД - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Строка, Массив из Строка - идентификаторы номенклатуры контрагента.
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//    * Ключ - Строка - идентификатор номенклатуры контрагента.
//    * Значение - Структура - номенклатура информационной базы (см. МенеджерИнтеграции.НоваяНоменклатураИнформационнойБазы)
//
Функция ПрочитатьСопоставлениеНоменклатуры(ВладелецНоменклатуры, ИдентификаторыНоменклатуры) Экспорт
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции();
	
	Результат = МенеджерИнтеграции.ПрочитатьСопоставлениеНоменклатуры(
		ВладелецНоменклатуры,
		ИдентификаторыНоменклатуры
	);
	
	Возврат Результат;
	
КонецФункции

// Записывает соответствие номенклатуры информационной базы с номенклатурой поставщика.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - сведения о номенклатуре контрагента (см. МенеджерИнтеграции.НоваяНоменклатураКонтрагента)
//  НоменклатураИБ - Структура - сведения о номенклатуре информационной базы (см. МенеджерИнтеграции.НоваяНоменклатураИнформационнойБазы)
//
Процедура ЗаписатьСопоставлениеНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ) Экспорт
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции();
	
	МенеджерИнтеграции.ЗаписатьСопоставлениеНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ);
	
КонецПроцедуры

// Ищет варианты сопоставления номенклатуры по номенклатуре контрагента.
