					КонецПопытки;
					ЗаполнитьContentПоСтруктуре(AdditionalInfo, стр, описаниеСтруктурыДанных + ".StructedAdditionalInfos");
				КонецЦикла;	
			ИначеЕсли Элемент.ключ = "TransferBases" Тогда
