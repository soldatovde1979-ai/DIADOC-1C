//{ ЗАПОЛНЕНИЕ

// Получает документ-основание произвольного документа.
// Если оснований несколько, берется только первое.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - произвольный документ, основание которого требуется получить.
// 
// Возвращаемое значение:
//  ДокументСсылка - документ-основание.
//
Функция ПервыйДокументОснование(СсылкаНаДокумент)
	
	Результат = Неопределено;
	
	МетаданныеДокумента	 = СсылкаНаДокумент.Метаданные();
	ИмяДокумента		 = МетаданныеДокумента.Имя;
	
	ПолноеИмяТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Если СуществуетОбъектМетаданных(ПолноеИмяТаблицыОснований) Тогда 
		
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.%ИмяДокумента%.ДокументыОснования КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяДокумента%", ИмяДокумента);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			Результат = Выборка.ДокументОснование;
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "ДокументОснование") Тогда 
		
		Результат = ЗначениеРеквизитаОбъекта(СсылкаНаДокумент, "ДокументОснование");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПересчитыватьВВалютуРегламентированногоУчета(ВалютаДокумента)
	
	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ВалютаДокумента) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	Если ИмяФормыПрикладногорешенияДляИнтеграцииДиадок() = "Модуль_ИнтеграцияАльфаАвто41" Тогда
		
		Модуль_ИнтеграцияАльфаАвто = ПолучитьМодульПрог("Модуль_ИнтеграцияАльфаАвто41");
		ВалютаРегл = Модуль_ИнтеграцияАльфаАвто.ПолучитьВалютуРегламентированногоУчета();
		
	Иначе
		
		ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
		
	КонецЕсли;
	
	Результат = ВалютаДокумента <> ВалютаРегл;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьКонтентУПД155(СтруктураКонтента, СтруктураДокумента, ДопПараметры)
	
	ДанныеШапки = СтруктураДокумента.ДанныеШапки;
	
	Если ДанныеШапки.Свойство("СчетФактураСсылка") Тогда
		СтруктураКонтента.СчетФактураСсылка = ДанныеШапки.СчетФактураСсылка;
	КонецЕсли;
	
	Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(СтруктураКонтента.Seller, ДанныеШапки.Организация,  ДанныеШапки.Дата, Истина, ДанныеШапки.БанковскийСчетОрганизации);
	
	СтруктураКонтента.Seller.FnsParticipantId = ДопПараметры.ОтправительИдентификаторЭДО;
	
	ЭтоИП = СтруктураКонтента.Seller.Type = "IndividualEntity";
	Если ЭтоИП 
		И ДанныеШапки.Свойство("ДатаНомерСвидетельстваОРегистрации") 
		И ЗначениеЗаполнено(ДанныеШапки.ДатаНомерСвидетельстваОРегистрации) Тогда
		
		СтруктураКонтента.Seller.IndividualEntityRegistrationCertificate = ДанныеШапки.ДатаНомерСвидетельстваОРегистрации;
		
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("КПППродавца") И ЗначениеЗаполнено(ДанныеШапки.КПППродавца) Тогда
		СтруктураКонтента.Seller.kpp = ДанныеШапки.КПППродавца;
	КонецЕсли;
	
	Если ДанныеШапки.СодержитТовары Тогда
		
		СтруктураКонтента.Shipper.SameAsSeller = НЕ ДанныеШапки.Свойство("Грузоотправитель") ИЛИ НЕ ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) ИЛИ НРег(ДанныеШапки.Грузоотправитель) = "он же";
		
		ГрузоотправительСсылка = ?(СтруктураКонтента.Shipper.SameAsSeller,  ДанныеШапки.Организация, ДанныеШапки.Грузоотправитель);
		Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(СтруктураКонтента.Shipper.OrganizationInfo, ГрузоотправительСсылка, ДанныеШапки.Дата, Ложь);
		
		ГрузополучательСсылка = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
		Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(СтруктураКонтента.Consignee,  ГрузополучательСсылка, ДанныеШапки.Дата, Ложь, , ДанныеШапки.АдресДоставки);
		
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("Агент") И ЗначениеЗаполнено(ДанныеШапки.Агент) Тогда
		
		ДанныеCreator = Новый_ExtendedOrganizationInfo();
		Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(ДанныеCreator, ДанныеШапки.Агент, ДанныеШапки.Дата, Истина);
		
		СтруктураКонтента.Creator = ДанныеCreator.Name + ", " + СформироватьПредставлениеИННКПП(ДанныеCreator.Inn, ДанныеCreator.Kpp);
		СтруктураКонтента.CreatorBase = Строка(ДанныеШапки.ДоговорАгента);
		
	Иначе
		СтруктураКонтента.Creator = СтруктураКонтента.Seller.Name + ", ИНН/КПП: " + ПредставлениеИННКПП(СтруктураКонтента.Seller);
	КонецЕсли;
	
	Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(СтруктураКонтента.Buyer, ДанныеШапки.Контрагент, ДанныеШапки.Дата, Истина);
	
	СтруктураКонтента.Buyer.FnsParticipantId = ДопПараметры.ПолучательИдентификаторЭДО;
	
	Если ДанныеШапки.Свойство("КПППокупателя") И ЗначениеЗаполнено(ДанныеШапки.КПППокупателя) Тогда
		СтруктураКонтента.Buyer.kpp = ДанныеШапки.КПППокупателя;
	КонецЕсли;
	
	СтруктураКонтента.Function	= ДанныеШапки.Функция;
	СтруктураКонтента.Number	= ДанныеШапки.Номер;
	СтруктураКонтента.Date		= ДанныеШапки.Дата;
	
	Если ДанныеШапки.Свойство("НомераДляСФ") Тогда
		Если ДанныеШапки.НомераДляСФ.ЭтоИСФ Тогда
			СтруктураКонтента.RevisionNumber 	= ДанныеШапки.НомераДляСФ.НомерИсправления;
			СтруктураКонтента.RevisionDate   	= ДанныеШапки.НомераДляСФ.ДатаИсправления;
			СтруктураКонтента.Number 			= ДанныеШапки.НомераДляСФ.НомерДокумента;
			СтруктураКонтента.Date   			= ДанныеШапки.НомераДляСФ.ДатаДокумента;
		Иначе
			СтруктураКонтента.Number	= ДанныеШапки.НомераДляСФ.НомерДокумента;
			СтруктураКонтента.Date		= ДанныеШапки.НомераДляСФ.ДатаДокумента;
		КонецЕсли;
	КонецЕсли;
	Если ДанныеШапки.Свойство("ДатаНомерДокументовОплаты") Тогда
		Для каждого ПРД Из ДанныеШапки.ДатаНомерДокументовОплаты Цикл 
			Стр = СтруктураКонтента.PaymentDocuments.Добавить();
			Стр.Number = ПРД.НомерПлатежноРасчетногоДокумента;
			Стр.Date   = ПРД.ДатаПлатежноРасчетногоДокумента;
		КонецЦикла;	
	КонецЕсли;
	
	СтруктураКонтента.Currency = ?(ПустаяСтрока(ДанныеШапки.ВалютаДокумента), "", СокрЛП(ДанныеШапки.ВалютаДокумента.Код));
	СтруктураКонтента.ВалютаСсылка =  ДанныеШапки.ВалютаДокумента;
	
	ДанныеШапки.Свойство("ИдентификаторГосконтракта", СтруктураКонтента.GovernmentContractInfo);
	
	СтруктураКонтента.AdditionalInfoId.Вставить("StructedAdditionalInfos", ДанныеШапки.ДопИнфо);
	Дополнить_StructedAdditionalInfos_ДопСведениями(СтруктураКонтента.AdditionalInfoId.StructedAdditionalInfos, ДопПараметры.ДополнительныеСведенияСтрокой);
	
	СФНаАванс = ДанныеШапки.Свойство("СФНаАванс") И ДанныеШапки.СФНаАванс;
	
	TotalNet = 0;
	Total 	 = 0;
	Vat 	 = 0;
	TotalWithVatExcluded = 0;
	
	ВсеСтроки_СтавкаНДС_БезНДС	 = Истина;
	ВсеСтроки_СтавкаНДС_ИсчНалАг = Истина;
	
	СтавкаНДС_БезНДС   = СтавкаНДС_БезНДС();
	СтавкаНДС_ИсчНалАг = СтавкаНДС_ИсчНалАг();
	
	Точность = ОбщиеПараметры.ТочностьЦены;
	
	Для Каждого СтрокаДанных Из СтруктураДокумента.ТабличнаяЧасть Цикл 
		
		Item = СтруктураКонтента.InvoiceTable.Items.Добавить();
		
		Item.Product	= СтрокаДанных.Номенклатура;
		Item.VendorCode	= СтрокаДанных.КодНоменклатуры;
		Item.ItemMark	= СтрокаДанных.ПризнакТРУ;
		Item.TaxRate 	= СтрокаДанных.СтавкаНДС;
		
		Если НРег(Item.TaxRate) <> НРег(СтавкаНДС_БезНДС) Тогда
			ВсеСтроки_СтавкаНДС_БезНДС = Ложь;
		КонецЕсли;	
		
		НДС_ИсчНалАг = Item.TaxRate = СтавкаНДС_ИсчНалАг;
		
		Если НЕ НДС_ИсчНалАг Тогда
			ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
		КонецЕсли;
		
		Если НДС_ИсчНалАг Тогда
			Item.SubtotalWithVatExcluded = СтрокаДанных.Сумма;
		ИначеЕсли НЕ СФНаАванс Тогда 	
			Item.SubtotalWithVatExcluded = СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);	
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(СтрокаДанных.Количество)
			И ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
			
			Item.Quantity = ?(СФНаАванс И СтрокаДанных.Количество = 0, Неопределено, СтрокаДанных.Количество); //для отображения прочерка в вэбе
			Item.UnitCode = XML_КодЕдиницыИзмерения(СтрокаДанных.КодЕдиницыИзмерения);
			Item.UnitName = СокрЛП(СтрокаДанных.ЕдиницаИзмерения);
			
			Если ТипЗнч(СтрокаДанных.Цена) = Тип("Число") Тогда
				
				РасчетнаяЦена = Окр(Item.SubtotalWithVatExcluded / Item.Quantity, Точность);
				ОтклонениеОтРасчетной = (РасчетнаяЦена - СтрокаДанных.Цена) * СтрокаДанных.Количество;
				
				Если СтрокаДанных.СуммаВключаетНДС ИЛИ Макс(ОтклонениеОтРасчетной, -ОтклонениеОтРасчетной) > 0.03 Тогда
					Item.Price = РасчетнаяЦена;	
				Иначе
					Item.Price = Окр(СтрокаДанных.Цена, Точность);
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			//не инициируем поля UnitCode, UnitName, Quantity, Price, чтобы в печатной форме ЭД были прочерки   
		КонецЕсли;
		
		Если НДС_ИсчНалАг Тогда
			Item.Vat 		= 0;
			Item.Subtotal	= 0;
		Иначе
			
			Если НРег(Item.TaxRate) = НРег(СтавкаНДС_БезНДС) Тогда
				Item.Vat = Неопределено;
			Иначе
				Item.Vat = СтрокаДанных.СуммаНДС;
			КонецЕсли;
			
			Item.Subtotal = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
			
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		
		Item.StructedAdditionalInfos	= СтрокаДанных.ДопИнфо;
		
		TotalNet = TotalNet + ПривестиКЧислу(Item.Quantity);
		Total 	 = Total + ПривестиКЧислу(Item.Subtotal);
		Vat 	 = Vat + ПривестиКЧислу(Item.Vat);
		
		Если НЕ СФНаАванс ИЛИ НДС_ИсчНалАг Тогда
			TotalWithVatExcluded = TotalWithVatExcluded + ПривестиКЧислу(Item.SubtotalWithVatExcluded);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.СтранаПроисхождения) Тогда
			
			ТЗ_ГТД = Новый_CustomDeclarations();
			
			СтрокаТЗ_ГТД = ТЗ_ГТД.Добавить();
			СтрокаТЗ_ГТД.CountryCode       = СокрЛП(СтрокаДанных.СтранаПроисхождения.Код);
			СтрокаТЗ_ГТД.DeclarationNumber = Модуль_Интеграция.ПолучитьНомерГТД(СтрокаДанных.НомерГТД);
			
			Item.CustomDeclarations = ТЗ_ГТД;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураКонтента.InvoiceTable.TotalNet = TotalNet;
	СтруктураКонтента.InvoiceTable.Total	= ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, 0, ДанныеШапки.СуммаДокумента);
	СтруктураКонтента.InvoiceTable.Vat		= ?(ВсеСтроки_СтавкаНДС_БезНДС, Неопределено, ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, 0, ДанныеШапки.СуммаНДСДокумента));
	
	Если НЕ СФНаАванс ИЛИ ВсеСтроки_СтавкаНДС_ИсчНалАг Тогда
		СтруктураКонтента.InvoiceTable.TotalWithVatExcluded = ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, TotalWithVatExcluded, ДанныеШапки.СуммаБезНДСДокумента);
	КонецЕсли;			
	
	СтруктураКонтента.TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	
	Если ДанныеШапки.Свойство("ДатаОтгрузки") Тогда
		СтруктураКонтента.TransferInfo.TransferDate = ДанныеШапки.ДатаОтгрузки;
	КонецЕсли;
	
	КоллекцияОснованияПередачи = ДанныеШапки.ОснованияПередачи;
	
	Для Каждого ЭлементКоллекции Из КоллекцияОснованияПередачи Цикл
		
		СтрокаТЗ_ОснПер = СтруктураКонтента.TransferInfo.TransferBases.Добавить();
		
		СтрокаТЗ_ОснПер.DocumentName 	= ЭлементКоллекции.DocumentName;
		СтрокаТЗ_ОснПер.DocumentNumber 	= ЭлементКоллекции.DocumentNumber;
		СтрокаТЗ_ОснПер.DocumentDate 	= ЭлементКоллекции.DocumentDate;
		СтрокаТЗ_ОснПер.DocumentInfo 	= ЭлементКоллекции.DocumentInfo;
		
		СтрокаТЗ_ОснПер.СлужебнаяИнформация = ЭлементКоллекции.СлужебнаяИнформация;
		
	КонецЦикла;
	
	Если ДанныеШапки.СодержитТовары И (ДанныеШапки.Функция = "InvoiceAndBasic" ИЛИ ДанныеШапки.Функция = "Basic")
		И ЗначениеЗаполнено(ДопПараметры.ДанныеСотрудника) И ЗначениеЗаполнено(ДопПараметры.ДанныеСотрудника.Должность) Тогда
		
		СтруктураКонтента.TransferInfo.Employee.EmployeePosition = ДопПараметры.ДанныеСотрудника.Должность;
		СтруктураКонтента.TransferInfo.Employee.Surname    		 = ДопПараметры.ДанныеСотрудника.Фамилия;
		СтруктураКонтента.TransferInfo.Employee.FirstName  		 = ДопПараметры.ДанныеСотрудника.Имя;
		СтруктураКонтента.TransferInfo.Employee.Patronymic 		 = ДопПараметры.ДанныеСотрудника.Отчество;
		
	КонецЕсли;
	
	Если ДанныеШапки.Функция = "InvoiceAndBasic" Тогда
		СтруктураКонтента.Name = "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	ИначеЕсли ДанныеШапки.Функция = "Basic" Тогда
		СтруктураКонтента.Name = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (Документ об оказании услуг)";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтентУПД820ИзКонтентаУПД155(СтруктураКонтента, Контент155)
	
	ЗаполнитьЗначенияСвойств(СтруктураКонтента, Контент155);
	
	// Наименование, дата и номер документа
	СтруктураКонтента.DocumentName	 = Контент155.Name;
	СтруктураКонтента.DocumentDate	 = Контент155.Date;
	СтруктураКонтента.DocumentNumber = Контент155.Number;
	
	// Составитель документа и его полномочия
	СтруктураКонтента.DocumentCreator		 = Контент155.Creator;
	СтруктураКонтента.DocumentCreatorBase	 = Контент155.CreatorBase;
	
	// Участники сделки
	Buyer		 = Новый_ExtendedOrganizationInfo820();
	Seller		 = Новый_ExtendedOrganizationInfo820();
	Consignee	 = Новый_ExtendedOrganizationInfo820();
	
	ЗаполнитьЗначенияСвойств(Buyer		, Контент155.Buyer);
	ЗаполнитьЗначенияСвойств(Seller		, Контент155.Seller);
	ЗаполнитьЗначенияСвойств(Consignee	, Контент155.Consignee);
	
	Если СтруктураЗаполнена(Consignee) Тогда
		Consignee.HyphenInn = НЕ ЗначениеЗаполнено(Consignee.Inn);
	КонецЕсли;
	
	Shipper = Новый_Shipper820();
	Shipper.SameAsSeller = Контент155.Shipper.SameAsSeller;
	ЗаполнитьЗначенияСвойств(Shipper.OrganizationInfo, Контент155.Shipper.OrganizationInfo);
	
	Если СтруктураЗаполнена(Shipper.OrganizationInfo) Тогда
		Shipper.OrganizationInfo.HyphenInn = НЕ ЗначениеЗаполнено(Shipper.OrganizationInfo.Inn);
	КонецЕсли;
	
	СтруктураКонтента.Buyers.Добавить(Buyer);
	СтруктураКонтента.Sellers.Добавить(Seller);
	СтруктураКонтента.Shippers.Добавить(Shipper);
	СтруктураКонтента.Consignees.Добавить(Consignee);
	
	// Основания передачи
	Для Каждого ОснПер Из СтруктураКонтента.TransferInfo.TransferBases Цикл
		
		Если ОснПер.DocumentName = "Отсутствует" Тогда
			ОснПер.DocumentName = "Без документа-основания";
		КонецЕсли;
		
	КонецЦикла;
	
	// Табличная часть
	ТабличнаяЧасть = СтруктураКонтента.Table;
	ЗаполнитьЗначенияСвойств(ТабличнаяЧасть, Контент155.InvoiceTable, , "Items");
	
	ВсеСтрокиБезНДС = Истина;
	
	Для Каждого Item155 Из Контент155.InvoiceTable.Items Цикл
		
		СтрокаТЧ = Новый_Utd820Item();
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Item155, , "CustomDeclarations");
		
		СтрокаТЧ.Unit			 = Item155.UnitCode;
		СтрокаТЧ.ItemVendorCode	 = Item155.VendorCode;
		СтрокаТЧ.ItemToRelease	 = Item155.ToRelease;
		СтрокаТЧ.WithoutVat		 = "false";
		
		Если ЗначениеЗаполнено(Item155.CustomDeclarations) Тогда
			Для каждого СтрокаТЗ Из Item155.CustomDeclarations Цикл
				CustomDeclaration = Новый_CustomDeclaration820();
				ЗаполнитьЗначенияСвойств(CustomDeclaration, СтрокаТЗ);
				СтрокаТЧ.CustomDeclarations.Добавить(CustomDeclaration);
			КонецЦикла;
		КонецЕсли;
		
		Если СтрокаТЧ.TaxRate = "без НДС" Тогда
			СтрокаТЧ.WithoutVat = "true";
		Иначе
			ВсеСтрокиБезНДС = Ложь;
		КонецЕсли;
		
		ТабличнаяЧасть.Items.Добавить(СтрокаТЧ);
		
	КонецЦикла;
	
	ТабличнаяЧасть.WithoutVat = ?(ВсеСтрокиБезНДС, "true", "false");
	
КонецПроцедуры

Процедура ЗаполнитьКонтентУКД(СтруктураКонтента, СтруктураДокумента, ДопПараметры)
	
	ДанныеШапки = СтруктураДокумента.ДанныеШапки;
	ВалютаДокумента = ДанныеШапки.ВалютаДокумента;
	
	Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(СтруктураКонтента.Seller, ДанныеШапки.Организация,  ДанныеШапки.Дата, Истина, ДанныеШапки.БанковскийСчетОрганизации);
	
	СтруктураКонтента.Seller.FnsParticipantId = ДопПараметры.ОтправительИдентификаторЭДО;
	
	Если ДанныеШапки.Свойство("КПППродавца") И ЗначениеЗаполнено(ДанныеШапки.КПППродавца) Тогда
		СтруктураКонтента.Seller.kpp = ДанныеШапки.КПППродавца;
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("Агент") И ЗначениеЗаполнено(ДанныеШапки.Агент) Тогда
		
		ДанныеCreator = Новый_ExtendedOrganizationInfo();
		Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(ДанныеCreator, ДанныеШапки.Агент, ДанныеШапки.Дата, Истина);
		
		СтруктураКонтента.Creator = ДанныеCreator.Name + ", " + СформироватьПредставлениеИННКПП(ДанныеCreator.Inn, ДанныеCreator.Kpp);
		СтруктураКонтента.CreatorBase = Строка(ДанныеШапки.ДоговорАгента);
		
	Иначе
		СтруктураКонтента.Creator = СтруктураКонтента.Seller.Name + ", ИНН/КПП: " + ПредставлениеИННКПП(СтруктураКонтента.Seller);
	КонецЕсли;
	
	Модуль_Интеграция.Заполнить_ExtendedOrganizationInfo(СтруктураКонтента.Buyer, ДанныеШапки.Контрагент, ДанныеШапки.Дата, Истина);
	
	СтруктураКонтента.Buyer.FnsParticipantId = ДопПараметры.ПолучательИдентификаторЭДО;
	
	Если ДанныеШапки.Свойство("КПППокупателя") И ЗначениеЗаполнено(ДанныеШапки.КПППокупателя) Тогда
		СтруктураКонтента.Buyer.kpp = ДанныеШапки.КПППокупателя;
	КонецЕсли;
	
	СтруктураКонтента.Function 	= ДанныеШапки.Функция;
	СтруктураКонтента.Number 	= ДанныеШапки.Номер;
	СтруктураКонтента.Date   	= ДанныеШапки.Дата;
	
	Если ДанныеШапки.Свойство("НомераДляКСФ") Тогда
		
		НомераДляКСФ = ДанныеШапки.НомераДляКСФ;
		
		Если НомераДляКСФ.ЭтоИКСФ Тогда
			СтруктураКонтента.Number 		 = НомераДляКСФ.НомерКСФ;
			СтруктураКонтента.Date  		 = НомераДляКСФ.ДатаКСФ;
			СтруктураКонтента.RevisionNumber = НомераДляКСФ.НомерИКСФ;
			СтруктураКонтента.RevisionDate   = НомераДляКСФ.ДатаИКСФ;
		Иначе
			СтруктураКонтента.Number	= НомераДляКСФ.НомерКСФ;
			СтруктураКонтента.Date		= НомераДляКСФ.ДатаКСФ;
		КонецЕсли;
		
		ЗаполнитьInvoiceForCorrectionInfo(СтруктураКонтента.Invoices, НомераДляКСФ);
		
	КонецЕсли;
	
	СтруктураКонтента.Currency = ?(ПустаяСтрока(ДанныеШапки.ВалютаДокумента), "", СокрЛП(ДанныеШапки.ВалютаДокумента.Код));
	СтруктураКонтента.ВалютаСсылка =  ДанныеШапки.ВалютаДокумента;
	
	ДанныеШапки.Свойство("ИдентификаторГосконтракта", СтруктураКонтента.GovernmentContractInfo);
	
	СтруктураКонтента.AdditionalInfoId.Вставить("StructedAdditionalInfos", ДанныеШапки.ДопИнфо);
	Дополнить_StructedAdditionalInfos_ДопСведениями(СтруктураКонтента.AdditionalInfoId.StructedAdditionalInfos, ДопПараметры.ДополнительныеСведенияСтрокой);
	
	ПересчитыватьВВалютуРегламентированногоУчета	= ПересчитыватьВВалютуРегламентированногоУчета(ВалютаДокумента);
	
	ЗаполнитьInvoiceCorrectionTable(СтруктураКонтента.InvoiceCorrectionTable, СтруктураДокумента.ТабличнаяЧасть, ПересчитыватьВВалютуРегламентированногоУчета);
	
	ЗаполнитьEventContent(СтруктураКонтента.EventContent, ДанныеШапки);
	
	Если ДанныеШапки.Функция = "InvoiceAndBasic" Тогда
		СтруктураКонтента.Name = "Корректировочный счет-фактура и документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	ИначеЕсли ДанныеШапки.Функция = "Basic" Тогда
		СтруктураКонтента.Name = "Документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьInvoiceForCorrectionInfo(Invoices, НомераДляКСФ)
	
	InvoiceForCorrectionInfo 		= Новый_InvoiceForCorrectionInfo();
	СтрокаInvoiceForCorrectionInfo 	= InvoiceForCorrectionInfo.Добавить();
	
	СтрокаInvoiceForCorrectionInfo.InvoiceDate		= НомераДляКСФ.ДатаИсходногоДокумента;
	СтрокаInvoiceForCorrectionInfo.InvoiceNumber	= НомераДляКСФ.НомерИсходногоДокумента;
	
	InvoiceRevisionInfo = Новый_InvoiceRevisionInfo();
	
	Если НомераДляКСФ.УчитыватьИсправлениеИсходногоДокумента Тогда 
		
		СтрокаInvoiceRevisionInfo 	= InvoiceRevisionInfo.Добавить();
		
		СтрокаInvoiceRevisionInfo.RevisionNumber	= Формат(НомераДляКСФ.НомерИсправленияИсходногоДокумента, "ЧДЦ=0; ЧГ=0");
		СтрокаInvoiceRevisionInfo.RevisionDate		= НомераДляКСФ.ДатаИсправленияИсходногоДокумента;
		
	КонецЕсли;
	
	СтрокаInvoiceForCorrectionInfo.InvoiceRevisions = InvoiceRevisionInfo;
	
	Invoices = InvoiceForCorrectionInfo;
	
КонецПроцедуры

Процедура ЗаполнитьInvoiceCorrectionTable(InvoiceCorrectionTable, ТаблицаТоваров, ПересчитыватьВВалютуРегламентированногоУчета)
	
	TotalsDec_Total 				= 0;
	TotalsDec_TotalWithVatExcluded 	= 0;
	TotalsDec_Vat 					= 0;
	
	TotalsInc_Total 				= 0;
	TotalsInc_TotalWithVatExcluded 	= 0;
	TotalsInc_Vat 					= 0;
	
	ЕстьУвеличение = Ложь;
	ЕстьУменьшение = Ложь;
	
	ВсеСтроки_СтавкаНДС_БезНДС	 = Истина;
	ВсеСтроки_СтавкаНДС_ИсчНалАг = Истина;
	
	СтавкаНДС_БезНДС   = СтавкаНДС_БезНДС();
	СтавкаНДС_ИсчНалАг = СтавкаНДС_ИсчНалАг();
	
	Точность = ОбщиеПараметры.ТочностьЦены;
	
	Для Каждого СтрокаДанных Из ТаблицаТоваров Цикл 
		
		Item = InvoiceCorrectionTable.Items.Добавить();
		
		Item.StructedAdditionalInfos = СтрокаДанных.ДопИнфо;
		
		Item.AmountsDec 		= Новый_AmountsDiff();
		Item.AmountsInc 		= Новый_AmountsDiff();
		Item.OriginalValues		= Новый_InvoiceItemFields();
		Item.CorrectedValues 	= Новый_InvoiceItemFields();
		
		Item.ItemTracingInfos	= Новый Массив;
		
		Item.Product		= СтрокаДанных.Номенклатура;
		Item.ItemVendorCode	= СтрокаДанных.КодНоменклатуры;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		
		Item.CorrectedValues.TaxRate = СтрокаДанных.СтавкаНДС;
		Если ЗначениеЗаполнено(СтрокаДанных.СтавкаНДСДоИзменения) Тогда
			Item.OriginalValues.TaxRate	 = СтрокаДанных.СтавкаНДСДоИзменения;
		Иначе
			Item.OriginalValues.TaxRate	 = СтрокаДанных.СтавкаНДС;							 
		КонецЕсли;								 
		
		Если НРег(Item.CorrectedValues.TaxRate) <> НРег(СтавкаНДС_БезНДС) Тогда
			ВсеСтроки_СтавкаНДС_БезНДС = Ложь;
		КонецЕсли;
		
		Если Item.CorrectedValues.TaxRate <> СтавкаНДС_ИсчНалАг Тогда
			ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
		КонецЕсли;
		
		Item.OriginalValues.TotalWithVatExcluded  = СтрокаДанных.СуммаДоИзменения - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДСДоИзменения, 0);
		Item.CorrectedValues.TotalWithVatExcluded = СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.суммаНДС, 0);
		
		Если  ЗначениеЗаполнено(СтрокаДанных.КоличествоДоИзменения) Тогда
			
			Item.OriginalValues.Quantity 	= СтрокаДанных.КоличествоДоИзменения;
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения) Тогда
				
				Item.OriginalValues.UnitCode	= XML_КодЕдиницыИзмерения(СтрокаДанных.КодЕдиницыИзмеренияДоИзменения);
				
				Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаДанных.ЕдиницаИзмеренияДоИзменения, "Наименование") Тогда
					Item.OriginalValues.UnitName = СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Наименование;
				Иначе
					Item.OriginalValues.UnitName = СокрЛП(СтрокаДанных.ЕдиницаИзмеренияДоИзменения);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ПересчитыватьВВалютуРегламентированногоУчета Тогда
				
				Item.OriginalValues.Price = ?(СтрокаДанных.СуммаВключаетНДС,
				Окр((СтрокаДанных.СуммаДоИзменения - СтрокаДанных.СуммаНДСДоИзменения) / СтрокаДанных.КоличествоДоИзменения, Точность),
				Окр(СтрокаДанных.СуммаДоИзменения / СтрокаДанных.КоличествоДоИзменения, Точность)
				);
				
			Иначе
				
				Item.OriginalValues.Price = ?(СтрокаДанных.СуммаВключаетНДС,
				Окр((СтрокаДанных.СуммаДоИзменения - СтрокаДанных.СуммаНДСДоИзменения) / СтрокаДанных.КоличествоДоИзменения, Точность),
				Окр(СтрокаДанных.ЦенаДоИзменения, Точность)
				);	
				
			КонецЕсли;
			
		Иначе
			// не инициируем поля UnitCode, UnitName, Quantity, Price, чтобы в печатной форме ЭД были прочерки   
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(СтрокаДанных.Количество) Тогда
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
				
				Item.CorrectedValues.UnitCode = XML_КодЕдиницыИзмерения(СтрокаДанных.КодЕдиницыИзмерения);
				
				Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаДанных.ЕдиницаИзмерения, "Наименование") Тогда
					Item.CorrectedValues.UnitName = СтрокаДанных.ЕдиницаИзмерения.Наименование;
				Иначе
					Item.CorrectedValues.UnitName = СокрЛП(СтрокаДанных.ЕдиницаИзмерения);
				КонецЕсли;
				
			КонецЕсли;
			
			// если до количество было, а теперь его не стало - заполняем 0, а не "-"!!!
			Если ЗначениеЗаполнено(СтрокаДанных.КоличествоДоИзменения) И Не ЗначениеЗаполнено(СтрокаДанных.Количество) Тогда
				Item.CorrectedValues.Quantity 	= 0;
			Иначе
				Item.CorrectedValues.Quantity 	= СтрокаДанных.Количество;
				
				Если ПересчитыватьВВалютуРегламентированногоУчета Тогда
					
					Item.CorrectedValues.Price  	= ?(СтрокаДанных.СуммаВключаетНДС, 
					Окр((СтрокаДанных.Сумма - СтрокаДанных.СуммаНДС) / СтрокаДанных.Количество, Точность),
					Окр(СтрокаДанных.Сумма / СтрокаДанных.Количество, Точность)
					);
					
				Иначе	
					
					Item.CorrectedValues.Price  	= ?(СтрокаДанных.СуммаВключаетНДС, 
					Окр((СтрокаДанных.Сумма - СтрокаДанных.СуммаНДС) / СтрокаДанных.Количество, Точность),
					Окр(СтрокаДанных.Цена, Точность)
					);
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			// не инициируем поля UnitCode, UnitName, Quantity, Price, чтобы в печатной форме ЭД были прочерки   
		КонецЕсли;
		
		// НДС и сумма с НДС до изменения
		Если Item.OriginalValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
			Item.OriginalValues.Vat = 0;
			Item.OriginalValues.Total = 0;
		Иначе
			
			Если НРег(Item.OriginalValues.TaxRate) = НРег(СтавкаНДС_БезНДС) Тогда
				Item.OriginalValues.Vat = Неопределено;
			Иначе
				Item.OriginalValues.Vat = СтрокаДанных.СуммаНДСДоИзменения;
			КонецЕсли;
			
			Item.OriginalValues.Total   = СтрокаДанных.СуммаДоИзменения + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДСДоИзменения);
			
		КонецЕсли;
		
		// НДС и сумма с НДС после изменения
		Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
			Item.CorrectedValues.Vat = 0;
			Item.CorrectedValues.Total = 0;
		Иначе
			
			Если НРег(Item.CorrectedValues.TaxRate) = НРег(СтавкаНДС_БезНДС) Тогда
				Item.CorrectedValues.Vat = Неопределено;
			Иначе
				Item.CorrectedValues.Vat = СтрокаДанных.СуммаНДС;
			КонецЕсли;
			
			Item.CorrectedValues.Total = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
			
		КонецЕсли;
		
		
		Если Item.CorrectedValues.TotalWithVatExcluded >= Item.OriginalValues.TotalWithVatExcluded Тогда
			
			// Увеличение
			ЕстьУвеличение = Истина;
			
			Item.AmountsDec.TotalWithVatExcluded = Неопределено;
			Item.AmountsDec.Vat 	= Неопределено;
			Item.AmountsDec.Total 	= Неопределено;
			
			Item.AmountsInc.TotalWithVatExcluded = Item.CorrectedValues.TotalWithVatExcluded - Item.OriginalValues.TotalWithVatExcluded;
			
			Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
				Item.AmountsInc.Vat 	= Неопределено;
				Item.AmountsInc.Total 	= Неопределено;
			Иначе
				
				Если НРег(Item.CorrectedValues.TaxRate) = НРег(СтавкаНДС_БезНДС) Тогда
					Item.AmountsInc.Vat = 0;
				Иначе
					Item.AmountsInc.Vat = ПривестиКЧислу(Item.CorrectedValues.Vat) - ПривестиКЧислу(Item.OriginalValues.Vat);
				КонецЕсли;
				
				Item.AmountsInc.Total = Item.CorrectedValues.Total - Item.OriginalValues.Total;
				
			КонецЕсли;
			
		Иначе
			
			// Уменьшение
			ЕстьУменьшение = Истина;
			
			Item.AmountsInc.TotalWithVatExcluded = Неопределено;
			Item.AmountsInc.Vat 	= Неопределено;
			Item.AmountsInc.Total 	= Неопределено;
			
			Item.AmountsDec.TotalWithVatExcluded = - Item.CorrectedValues.TotalWithVatExcluded + Item.OriginalValues.TotalWithVatExcluded;
			
			Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
				Item.AmountsDec.Vat 	= Неопределено;
				Item.AmountsDec.Total 	= Неопределено;
			Иначе
				
				Если НРег(Item.CorrectedValues.TaxRate) = НРег(СтавкаНДС_БезНДС) Тогда
					Item.AmountsDec.Vat = 0;
				Иначе
					Item.AmountsDec.Vat = - ПривестиКЧислу(Item.CorrectedValues.Vat) + ПривестиКЧислу(Item.OriginalValues.Vat);
				КонецЕсли;
				
				Item.AmountsDec.Total = -Item.CorrectedValues.Total + Item.OriginalValues.Total;
				
			КонецЕсли;
			
		КонецЕсли;
		
		TotalsDec_Total 				= TotalsDec_Total + ПривестиКЧислу(Item.AmountsDec.Total);
		TotalsDec_TotalWithVatExcluded 	= TotalsDec_TotalWithVatExcluded + ПривестиКЧислу(Item.AmountsDec.TotalWithVatExcluded);
		TotalsDec_Vat 					= TotalsDec_Vat + ПривестиКЧислу(Item.AmountsDec.Vat);
		
		TotalsInc_Total 				= TotalsInc_Total + ПривестиКЧислу(Item.AmountsInc.Total);
		TotalsInc_TotalWithVatExcluded 	= TotalsInc_TotalWithVatExcluded + ПривестиКЧислу(Item.AmountsInc.TotalWithVatExcluded);
		TotalsInc_Vat 					= TotalsInc_Vat + ПривестиКЧислу(Item.AmountsInc.Vat);
		
		Если НЕ СтрокаДанных.ЭтоУслуга Тогда
			
			СведенияОСтранеПроисхожденияТовара = КоллекцияСведенийОСтранеПроисхождения(СтрокаДанных);
			
			ДопИнформацияОСтранеПроисхождения = СведенияОСтранеПроисхожденияСтрокой(СведенияОСтранеПроисхожденияТовара);
			
			Дополнить_StructedAdditionalInfos_ДопСведениями(Item.StructedAdditionalInfos, ДопИнформацияОСтранеПроисхождения);
			
		КонецЕсли;
		
	КонецЦикла;	  
	
	Если ЕстьУвеличение Тогда
		InvoiceCorrectionTable.TotalsInc.Total 					= TotalsInc_Total; 
		InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded 	= TotalsInc_TotalWithVatExcluded; 
		Если ВсеСтроки_СтавкаНДС_БезНДС Тогда
			InvoiceCorrectionTable.TotalsInc.Vat = Неопределено;
		ИначеЕсли ВсеСтроки_СтавкаНДС_ИсчНалАг Тогда
			InvoiceCorrectionTable.TotalsInc.Vat = 0;
		Иначе
			InvoiceCorrectionTable.TotalsInc.Vat = TotalsInc_Vat;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьУменьшение Тогда
		InvoiceCorrectionTable.TotalsDec.Total					= TotalsDec_Total; 
		InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded 	= TotalsDec_TotalWithVatExcluded; 
		Если ВсеСтроки_СтавкаНДС_БезНДС Тогда
			InvoiceCorrectionTable.TotalsDec.Vat = Неопределено;
		ИначеЕсли ВсеСтроки_СтавкаНДС_ИсчНалАг Тогда
			InvoiceCorrectionTable.TotalsDec.Vat = 0;
		Иначе
			InvoiceCorrectionTable.TotalsDec.Vat = TotalsDec_Vat;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьEventContent(EventContent, ШапкаУКД)
	
	Для Каждого ПередаточныйДокумент Из ШапкаУКД.РеквизитыПередаточныхДокументов Цикл	
		
		Новый_BaseDocument = EventContent.TransferDocDetails736.Добавить();
		
		Новый_BaseDocument.BaseDocumentName 	= ПередаточныйДокумент.BaseDocumentName;
		Новый_BaseDocument.BaseDocumentNumber 	= ПередаточныйДокумент.BaseDocumentNumber;
		Новый_BaseDocument.BaseDocumentDate 	= ПередаточныйДокумент.BaseDocumentDate;
		
	КонецЦикла;
	
	Если ШапкаУКД.Свойство("ИныеСведенияОбИзмененииСтоимости") Тогда
		EventContent.CostChangeInfo = ШапкаУКД.ИныеСведенияОбИзмененииСтоимости;
	КонецЕсли;
	Если ШапкаУКД.Свойство("ДатаУведомления") Тогда
		EventContent.NotificationDate = ШапкаУКД.ДатаУведомления;
	КонецЕсли;
	
	EventContent.OperationContent = "Изменение стоимости товаров и услуг";
	
	ОснованияПередачи = ШапкаУКД.ОснованияПередачи;
	Если ОснованияПередачи.Количество() > 0 Тогда
		Для Каждого ОснованиеПередачи Из ОснованияПередачи Цикл
			СтрокаCorrectionBases = EventContent.CorrectionBases.Добавить();			
			ЗаполнитьЗначенияСвойств(СтрокаCorrectionBases, ОснованиеПередачи);
		КонецЦикла;
	Иначе
		СтрокаCorrectionBases = EventContent.CorrectionBases.Добавить();			
		СтрокаCorrectionBases.BaseDocumentName = ОснованиеПередачи_БезДокументаОснования();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтентНакладной172(Content, СтруктураДокумента, ДополнительныеПараметры)
	
	НомерЗаказа						 = ДополнительныеПараметры.НомерЗаказа;
	ПараметрыСогласования			 = ДополнительныеПараметры.ПараметрыСогласования;
	ДополнительныеСведенияСтрокой	 = ДополнительныеПараметры.ДополнительныеСведенияСтрокой;
	
	ДанныеШапки					 = СтруктураДокумента.ДанныеШапки;
	БанковскийСчетОрганизации	 = СтруктураДокумента.БанковскийСчетОрганизации;
	СтруктураДоговора			 = СтруктураДокумента.СтруктураДоговора;
	ТаблицаТоваров				 = СтруктураДокумента.ТаблицаТоваров;
	
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Seller, ДанныеШапки.Организация,  ДанныеШапки.Дата,  БанковскийСчетОрганизации , Истина);
	
	ГрузоотправительСсылка = ?((ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) = Ложь) Или (ДанныеШапки.Грузоотправитель = "он же"),  ДанныеШапки.Организация, ДанныеШапки.Грузоотправитель);
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Shipper, ГрузоотправительСсылка, ДанныеШапки.Дата, , Ложь);
	
	Content.ShipperDepartment =  ДанныеШапки.Подразделение;
	
	ГрузополучательСсылка = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Consignee,  ГрузополучательСсылка, ДанныеШапки.Дата, , Ложь, , ДанныеШапки.АдресДоставки);
	
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Buyer, ДанныеШапки.Контрагент, ДанныеШапки.Дата, , Истина);
	
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда 
		content.GroundName 		= "Заказ";
		content.GroundNumber 	= СокрЛП(НомерЗаказа);
	Иначе	
		content.GroundName 		= СтруктураДоговора.GroundName;
		content.GroundDate 		= СтруктураДоговора.GroundDate;
		content.GroundNumber 	= СтруктураДоговора.GroundNumber;
	КонецЕсли;	
	content.Number =  ДанныеШапки.Номер;
	content.Date   = ДанныеШапки.Дата;
	
	ИдКонтрагента = Модуль_Данные1С_СвязиОбъектов().Контрагент_2_CounteragentBoxID(ДанныеШапки.Контрагент);
	
	Если НужноФормироватьДопИнфоПоШаблону(ИдКонтрагента) = Истина Тогда
		content.AdditionalInfo = СформироватьСтрокуДопИнфоПоШаблону(ДополнительныеСведенияСтрокой);
	Иначе
		content.AdditionalInfo = СформироватьСтрокуДопИнфо(ДополнительныеСведенияСтрокой, ДанныеШапки.Допинфо);
	КонецЕсли;
	
	TotalParcelsQuantity 	= 0;
	TotalGrossQuantity 		= 0;
	TotalMassQuantity		= 0;			
	
	Точность = ОбщиеПараметры.ТочностьЦены;
	
	Для каждого строкаТаблицы Из ТаблицаТоваров Цикл 
		
		XmlTorg12ItemContent= content.items.добавить();
		
		XmlTorg12ItemContent.Product =  		СтрокаТаблицы.Номенклатура;
		XmlTorg12ItemContent.ProductCode =	СтрокаТаблицы.КодНоменклатуры;
		XmlTorg12ItemContent.UnitCode =		ItemContent_UnitCode(СтрокаТаблицы.ЕдиницаИзмерения, СтрокаТаблицы.КодЕдиницыИзмерения);
		XmlTorg12ItemContent.UnitName =		СтрокаТаблицы.ЕдиницаИзмерения.Наименование;
		XmlTorg12ItemContent.Quantity =  	СтрокаТаблицы.Количество;
		XmlTorg12ItemContent.TaxRate =		СтрокаТаблицы.СтавкаНДС;
		XmlTorg12ItemContent.Vat =			СтрокаТаблицы.СуммаНДС;
		XmlTorg12ItemContent.Total =			СтрокаТаблицы.Сумма + ?(СтрокаТаблицы.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
		XmlTorg12ItemContent.TotalWithVatExcluded= XmlTorg12ItemContent.Total - XmlTorg12ItemContent.Vat;
		
		РасчетнаяЦена = Окр(XmlTorg12ItemContent.TotalWithVatExcluded / ?(XmlTorg12ItemContent.Quantity = 0, 1, XmlTorg12ItemContent.Quantity), Точность);
		ОтклонениеОтРасчетной =  (РасчетнаяЦена-СтрокаТаблицы.Цена)*СтрокаТаблицы.Количество;
		
		Если (СтрокаТаблицы.СуммаВключаетНДС = Истина) Или (Макс(ОтклонениеОтРасчетной, -ОтклонениеОтРасчетной)>0.03) Тогда
			XmlTorg12ItemContent.Price = РасчетнаяЦена ;	
		Иначе
			XmlTorg12ItemContent.Price = СтрокаТаблицы.Цена;
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(XmlTorg12ItemContent, строкаТаблицы);
		
		XmlTorg12ItemContent.AdditionalInfo 		= строкаТаблицы.ДопИнфо;
		
		Если ЗначениеЗаполнено(строкаТаблицы.КоличествоМест) Тогда
			XmlTorg12ItemContent.ParcelsQuantity =  строкаТаблицы.КоличествоМест;
			XmlTorg12ItemContent.ParcelCapacity  =  строкаТаблицы.КоличествоВОдномМесте;
			XmlTorg12ItemContent.ParcelType      =  ?(ЗначениеЗаполнено(строкаТаблицы.ВидУпаковки), строкаТаблицы.ВидУпаковки.Наименование, "");
			XmlTorg12ItemContent.GrossQuantity   =  строкаТаблицы.Масса;
			TotalGrossQuantity      = TotalGrossQuantity + ?(ЗначениеЗаполнено(XmlTorg12ItemContent.GrossQuantity), XmlTorg12ItemContent.GrossQuantity, 0);
			TotalParcelsQuantity = TotalParcelsQuantity + XmlTorg12ItemContent.ParcelsQuantity;
		КонецЕсли;	
		
		TotalMassQuantity = TotalMassQuantity + XmlTorg12ItemContent.Quantity;
		
	КонецЦикла;
	content.Totals.ParcelsQuantity 			= TotalParcelsQuantity;
	content.Totals.GrossQuantity 			= TotalGrossQuantity;
	content.Totals.Quantity 				= TotalMassQuantity;
	
	content.Totals.TotalWithVatExcluded 	= ДанныеШапки.СуммаБезНДСДокумента;
	content.Totals.Total 					= ДанныеШапки.СуммаДокумента;
	content.Totals.Vat 						= ДанныеШапки.СуммаНДСДокумента;
	
	content.SupplyDate 						= content.Date; 
	
	Content.commons.TotalSumInWords =   Модуль_Интеграция.ПолучитьСуммуПрописьюДиадок(ДанныеШапки.СуммаДокумента,  ПолучитьВалютуРегламентированногоУчета() );
	Если ЗначениеЗаполнено(TotalParcelsQuantity) Тогда
		Content.commons.TotalParcelsQuantityInWords = стрзаменить(числоПрописью(TotalParcelsQuantity, "ДП = Ложь"), "  00", "");
	КонецЕсли;	
	
	Если Не ЗапущенКакВнешнийМодуль Тогда
		
		Если ПараметрыСогласования = Неопределено Тогда
			
			ПараметрыПодписания = Модуль_Данные1С_СвязиОбъектов().ПолучитьПараметрыПодписанияТ12вДиадок(ДанныеШапки.Организация);
		Иначе
			
			ПараметрыПодписания = Новый Структура;
			
			ПараметрыПодписания.Вставить("СпособПодписания", ОдинСАдаптер_НастройкиТекущегоПользователя_ПолучитьНастройку(Модуль_Данные1С_СвязиОбъектов().ИдентификаторСвойстваСпособПодписанияТ12()));
			
			Если ЗначениеЗаполнено(ПараметрыСогласования.ФИОПодписанта) Тогда
				ПараметрыПодписания.Вставить("ФИОПодписанта"	  , ПараметрыСогласования.ФИОПодписанта);
				ПараметрыПодписания.Вставить("ДолжностьПодписанта", ?(НЕ ПустаяСтрока(ПараметрыСогласования.ДолжностьПодписанта), ПараметрыСогласования.ДолжностьПодписанта, "_"));
			Иначе
				ПараметрыПодписания.Вставить("ФИОПодписанта"	  , ПараметрыСогласования.ФИОПолучателя);
				ПараметрыПодписания.Вставить("ДолжностьПодписанта", ?(НЕ ПустаяСтрока(ПараметрыСогласования.ДолжностьПолучателя), ПараметрыСогласования.ДолжностьПолучателя, "_"));
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыПодписания.СпособПодписания = "3" Или ПараметрыПодписания.СпособПодписания = "4" Тогда
			заполнитьПодписантаДляXmlTorg12(content.SupplyPerformedBy,  ПредставлениеВизирующего(ПараметрыПодписания));
		КонецЕсли;	
		Если (ПараметрыПодписания.СпособПодписания <> "2") И (ПараметрыПодписания.СпособПодписания <> "3") Тогда 
			заполнитьПодписантаДляXmlTorg12(content.SupplyAllowedBy,  ПредставлениеВизирующего(ПараметрыПодписания));
		КонецЕсли;
		Если ПараметрыПодписания.СпособПодписания = "2" Или ПараметрыПодписания.СпособПодписания = "4" Тогда 
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			заполнитьПодписантаДляXmlTorg12(content.ChiefAccountant,  ПредставлениеВизирующего(ПараметрыПодписания));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтентАкта172(Content, СтруктураДокумента, ДополнительныеПараметры)
	
	ПараметрыСогласования			 = ДополнительныеПараметры.ПараметрыСогласования;
	ДополнительныеСведенияСтрокой	 = ДополнительныеПараметры.ДополнительныеСведенияСтрокой;
	
	ДанныеШапки					 = СтруктураДокумента.ДанныеШапки;
	БанковскийСчетОрганизации	 = СтруктураДокумента.БанковскийСчетОрганизации;
	СтруктураДоговора			 = СтруктураДокумента.СтруктураДоговора;
	ТаблицаТоваров				 = СтруктураДокумента.ТаблицаТоваров;
	
	// поставщик: организация-продавец
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Seller, ДанныеШапки.Организация,  ДанныеШапки.Дата,  БанковскийСчетОрганизации, Истина);
	
	ПредставлениеИсполнителя = Модуль_Интеграция.ПолучитьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Организация, ДанныеШапки.Дата);
	ПредставлениеЗаказчика   = Модуль_Интеграция.ПолучитьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Контрагент, ДанныеШапки.Дата);
	
	
	НомерДоговора = ?(СтруктураДоговора.GroundNumber = "", "", " по договору № " + СтруктураДоговора.GroundNumber);
	ДатаДоговора = ?(СтруктураДоговора.GroundDate = Дата(1, 1, 1), "", " от " + Формат(СтруктураДоговора.GroundDate, "ДФ=dd.MM.yyyy"));
	ДатаДоговора =
		?((СтруктураДоговора.GroundNumber
			= "" И СтруктураДоговора.GroundDate <> Дата(1, 1, 1)), " по договору " + ДатаДоговора, ДатаДоговора);
	
	текстАкта =
		"Мы, нижеподписавшиеся, представитель " + ПредставлениеИсполнителя
		+ " (далее «Исполнитель»), с одной стороны, и представитель " + ПредставлениеЗаказчика + " (далее «Заказчик»), с другой стороны," +
		" составили настоящий акт о том, что «Исполнитель» выполнил, а  «Заказчик» принял следующие работы (услуги)"
		+ НомерДоговора + ДатаДоговора + ":";
	
	
	// прочие реквизиты шапки	
	content.Number = ДанныеШапки.Номер;
	content.Date   = ДанныеШапки.Дата;
	content.Title  = текстАкта;
	
	ИдКонтрагента = Модуль_Данные1С_СвязиОбъектов().Контрагент_2_CounteragentBoxID(ДанныеШапки.Контрагент);
	
	Если НужноФормироватьДопИнфоПоШаблону(ИдКонтрагента) = Истина Тогда
		content.AdditionalInfo = СформироватьСтрокуДопИнфоПоШаблону(ДополнительныеСведенияСтрокой);
	Иначе
		content.AdditionalInfo = СформироватьСтрокуДопИнфо(ДополнительныеСведенияСтрокой, ДанныеШапки.Допинфо);
	КонецЕсли;
	
	content.SignatureDate =	content.Date;
	
	Точность = ОбщиеПараметры.ТочностьЦены;
	
	Для каждого строкаТаблицы Из ТаблицаТоваров Цикл 
		Item = content.items.Добавить();
		Если (ЗначениеЗаполнено(строкаТаблицы.Количество) = Ложь)
			Или (ЗначениеЗаполнено(строкаТаблицы.КодЕдиницыИзмерения) = Ложь)
			Или (ЗначениеЗаполнено(строкаТаблицы.Сумма) = Ложь) Тогда
			Item.Description =  строкаТаблицы.Номенклатура;
		Иначе 
			Item.Name = СтрокаТаблицы.Номенклатура;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КодЕдиницыИзмерения) Тогда
			Item.UnitCode = ItemContent_UnitCode(СтрокаТаблицы.ЕдиницаИзмерения, СтрокаТаблицы.КодЕдиницыИзмерения);
			Если Item.UnitCode = "" И ЗначениеЗаполнено(Item.Name) Тогда
				Item.Description = 	Item.Name;
				Item.Name = 			Неопределено;	
			КонецЕсли;
		Иначе
			Item.UnitCode = "";
		КонецЕсли;
		
		Item.UnitName 	=  ?(ЗначениеЗаполнено(строкаТаблицы.ЕдиницаИзмерения), строкаТаблицы.ЕдиницаИзмерения.Наименование, "");
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			Item.Quantity = СтрокаТаблицы.Количество;
		КонецЕсли;
		
		Item.Vat 		=  строкаТаблицы.СуммаНДС;
		Item.Total 		=  строкаТаблицы.Сумма + ?(строкаТаблицы.СуммаВключаетНДС, 0, строкаТаблицы.СуммаНДС) ;
		Item.TotalWithVatExcluded = Item.Total - Item.Vat;
		Item.Price 		=  ?(НЕ ЗначениеЗаполнено(item.Quantity), Неопределено, Окр(item.TotalWithVatExcluded / item.Quantity, Точность));
		
		Если ЗначениеЗаполнено(item.Quantity) Тогда
			РасчетнаяЦена = Окр(item.TotalWithVatExcluded / item.Quantity, Точность);
			ОтклонениеОтРасчетной =  (РасчетнаяЦена - строкаТаблицы.Цена) * строкаТаблицы.Количество;
			Если (строкаТаблицы.СуммаВключаетНДС = Истина) Или (Макс(ОтклонениеОтРасчетной, -ОтклонениеОтРасчетной) > 0.03) Тогда
				item.price = РасчетнаяЦена;	
			Иначе
				item.price = строкаТаблицы.Цена;	
			КонецЕсли;
		Иначе 
			Item.Price   = Неопределено;
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, строкаТаблицы);
		
		Item.AdditionalInfo = строкаТаблицы.ДопИнфо;
		
		Если Item.Total = 0 Тогда
			Item.Total = Неопределено;
		КонецЕсли;
		Если  Item.TotalWithVatExcluded = 0 Тогда
			Item.TotalWithVatExcluded = Неопределено;
		КонецЕсли;
		Если  Item.Vat = 0 И СтрокаТаблицы.СтавкаНДС = "" Тогда
			Item.Vat = Неопределено;
		КонецЕсли;
		
		
	КонецЦикла;
	
	Если Не ЗапущенКакВнешнийМодуль Тогда
		Если ПараметрыСогласования <> Неопределено И ЗначениеЗаполнено(ПараметрыСогласования.ФИОПодписанта) Тогда
			ЗаполнитьФИОПодписанта(content.Official, ПараметрыСогласования.ФИОПодписанта);
			content.Official.JobTitle = СокрЛП(?(НЕ ПустаяСтрока(ПараметрыСогласования.ДолжностьПодписанта), ПараметрыСогласования.ДолжностьПодписанта, "_"));
		Иначе
			ПараметрыПодписания = Модуль_Данные1С_СвязиОбъектов().ПолучитьПараметрыПодписанияТ12вДиадок(ДанныеШапки.Организация);
			заполнитьПодписантаДляXmlTorg12(content.Official,  ПредставлениеВизирующего(параметрыПодписания));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтентФормализованногоСчета(Content, СтруктураДокумента, ДополнительныеПараметры)
	
	Шапка	 = СтруктураДокумента.Шапка;
	ДанныеТЧ = СтруктураДокумента.ДанныеТЧ;
	
	Content.DocumentDate	 = Шапка.Дата;
	Content.DocumentNumber	 = Шапка.НомерНаПечать;
	
	Content.Currency	 = Шапка.ВалютаДокументаКод;
	Content.CurrencyRate = Шапка.КурсДокумента;
	
	// Заполнение сведений о продавце и получателе платежа
	Продавец	 = Шапка.Организация;
	Получатель	 = Шапка.ПолучательПлатежа;
	Если Получатель = Продавец Тогда 
		Получатель = Неопределено;
	КонецЕсли;
	
	СчетПродавца	 = ?(ЗначениеЗаполнено(Получатель), Неопределено, Шапка.БанковскийСчетОрганизации);
	СчетПолучателя	 = Шапка.БанковскийСчетОрганизации;
	
	РеквизитыПродавца = РеквизитыЮрФизЛица(Продавец, Шапка.Дата, СчетПродавца);
	ПрочитатьСведенияОбАдресахЮрФизЛица(РеквизитыПродавца);
	ЗаполнитьИнформациюОбОрганизации(Content.Seller, РеквизитыПродавца);
	
	Если ЗначениеЗаполнено(Получатель) Тогда 
		РеквизитыПолучателя = РеквизитыЮрФизЛица(Получатель, Шапка.Дата, СчетПолучателя);
		ПрочитатьСведенияОбАдресахЮрФизЛица(РеквизитыПолучателя);
		ЗаполнитьИнформациюОбОрганизации(Content.Recipient, РеквизитыПолучателя);
	Иначе 
		Content.Recipient = Неопределено;
	КонецЕсли;
	
	// Заполнение сведений о покупателе и плательщике
	Покупатель = Шапка.Контрагент;
	Плательщик = Шапка.Плательщик;
	Если Плательщик = Покупатель Тогда 
		Плательщик = Неопределено;
	КонецЕсли;
	
	СчетПокупателя = ?(ЗначениеЗаполнено(Плательщик), Неопределено, Шапка.БанковскийСчетКонтрагента);
	СчетПлательщика = Шапка.БанковскийСчетКонтрагента;
	
	ПараметрыЗапросаКИ = ПараметрыПолученияКонтактнойИнформацииЮрФизЛица();
	ПараметрыЗапросаКИ.АдресДоставки = Шапка.АдресДоставки;
	
	РеквизитыПокупателя = РеквизитыЮрФизЛица(Покупатель, Шапка.Дата, СчетПокупателя);
	ПрочитатьСведенияОбАдресахЮрФизЛица(РеквизитыПокупателя, ПараметрыЗапросаКИ);
	ЗаполнитьИнформациюОбОрганизации(Content.Buyer, РеквизитыПокупателя, ПараметрыЗапросаКИ);
	
	Если ЗначениеЗаполнено(Плательщик) Тогда 
		РеквизитыПлательщика = РеквизитыЮрФизЛица(Плательщик, Шапка.Дата, СчетПлательщика);
		ПрочитатьСведенияОбАдресахЮрФизЛица(РеквизитыПлательщика);
		ЗаполнитьИнформациюОбОрганизации(Content.Payer, РеквизитыПлательщика);
	Иначе 
		Content.Payer = Неопределено;
	КонецЕсли;
	
	Договор = РеквизитыДоговора(Шапка);
	Если ЗначениеЗаполнено(Договор) Тогда 
		Content.Contract.Name	 = Договор.Представление;
		Content.Contract.Number	 = Договор.Номер;
		Content.Contract.Date	 = Договор.Дата;
	Иначе 
		Content.Contract = Неопределено;
	КонецЕсли;
	
	Content.GovernmentContractInfo = Шапка.ИдентификаторГосКонтракта;
	Content.PaymentPurpose = Шапка.НазначениеПлатежа;
	
	ИнфоПоля = Новый Структура;
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().ДополнительныеУсловия	, Шапка.ДополнительныеУсловия);
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().ДополнительнаяИнформация, Шапка.ДополнительнаяИнформация);
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().ИдентификаторПлатежа	, Шапка.ИдентификаторПлатежа);
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().СрокОплаты				, Шапка.СрокОплаты);
	
	Для Каждого Поле Из ИнфоПоля Цикл 
		Если ЗначениеЗаполнено(Поле.Значение) Тогда 
			ДополнитьМассивKeyValue(Content.StructedAdditionalInfos, Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьТаблицуСчетаНаОплату(Content.ProformaInvoiceTable, ДанныеТЧ);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентСчетаФактуры93(Content, ДанныеДляПечати, ДополнительныеПараметры)
	
	ДанныеСотрудника				 = ДополнительныеПараметры.ДанныеСотрудника;
	ПараметрыСогласования			 = ДополнительныеПараметры.ПараметрыСогласования;
	ДополнительныеСведенияСтрокой	 = ДополнительныеПараметры.ДополнительныеСведенияСтрокой;
	
	Content.Number 	= ДанныеДляПечати.НомераДляСФ.НомерДокумента;
	Content.Date 	= ДанныеДляПечати.НомераДляСФ.ДатаДокумента;
	Если ДанныеДляПечати.НомераДляСФ.ЭтоИСФ Тогда
		Content.InvoiceRevisionNumber 	= ДанныеДляПечати.НомераДляСФ.НомерИсправления;
		Content.InvoiceRevisionDate 	= ДанныеДляПечати.НомераДляСФ.ДатаИсправления;
	КонецЕсли;	
	
	Для каждого ПРД Из ДанныеДляПечати.ДатаНомерДокументовОплаты Цикл 
		Стр = content.PaymentDocuments.Добавить();
		Стр.Number = ПРД.НомерПлатежноРасчетногоДокумента;
		Стр.date   = ПРД.ДатаПлатежноРасчетногоДокумента;
	КонецЦикла;	
	
	content.currency 		= ?(ПустаяСтрока(ДанныеДляПечати.ВалютаДокумента), "", СокрЛП(ДанныеДляПечати.ВалютаДокумента.Код));
	content.ВалютаСсылка 	= ДанныеДляПечати.ВалютаДокумента;
	
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Buyer, ДанныеДляПечати.Контрагент, ДанныеДляПечати.Дата, , Истина, Истина);
	Если ЗначениеЗаполнено(ДанныеДляПечати.КПППокупателя) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КПППокупателя
	КонецЕсли;	
	
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Seller, ДанныеДляПечати.Организация, ДанныеДляПечати.Дата, , Истина, Истина);
	
	Попытка
		Если НЕ ДанныеДляПечати.Свойство("Поставщик") // Если есть свойство "Поставщик", значит Грузоотправитель уже обработан
			И ДанныеДляПечати.Организация <> Content.Seller.Ссылка Тогда
			
			//значит ДанныеДляПечати.Организация является подразделением Content.Seller.Ссылка 
			ДанныеДляПечати.Грузоотправитель = ДанныеДляПечати.Организация;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если ДанныеДляПечати.Грузоотправитель = "он же" Тогда 
		Content.Shipper.SameAsSellerOrBuyer = Истина;
	ИначеЕсли ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель) Тогда  
		Модуль_Интеграция.ЗаполнитьСтруктуруГрузоПолучателяОтправителя(Content.Shipper, ДанныеДляПечати.Грузоотправитель, ДанныеДляПечати.Дата); 
	Иначе 
		Content.Shipper.SameAsSellerOrBuyer = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.Грузополучатель) Тогда
		Модуль_Интеграция.ЗаполнитьСтруктуруГрузоПолучателяОтправителя(Content.Consignee, ДанныеДляПечати.Грузополучатель, ДанныеДляПечати.Дата, ДанныеДляПечати.АдресДоставки); 
		Если ЗначениеЗаполнено(ДанныеДляПечати.АдресДоставки) Тогда
			Модуль_Интеграция.ЗаполнитьСтруктуруАдреса(Content.Consignee.Address, ДанныеДляПечати.Контрагент, , ДанныеДляПечати.АдресДоставки);
		КонецЕсли;
	Иначе 
		Content.Consignee.SameAsSellerOrBuyer = Ложь;
	КонецЕсли;
	
	Content.StructedAdditionalInfos = ДанныеДляПечати.ДопИнфо;
	Дополнить_StructedAdditionalInfos_ДопСведениями(Content.StructedAdditionalInfos, ДополнительныеСведенияСтрокой);
	
	Точность = ОбщиеПараметры.ТочностьЦены;
	
	Для каждого Стр Из ДанныеДляПечати.ТабличнаяЧасть Цикл
		
		item = content.items.Добавить();
		
		item.Product = Стр.Номенклатура;
		
		Если Стр.Количество = 0 ИЛИ ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) = Ложь Тогда
			item.UnitCode 				= Неопределено;
			item.Quantity 				= Неопределено;
		Иначе
			
			Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
				item.UnitCode = ItemContent_UnitCode(Стр.ЕдиницаИзмерения, Стр.КодЕдиницыИзмерения);
			Иначе
				item.UnitCode = "";
			КонецЕсли;
			
			item.Quantity 				= Стр.Количество;
		КонецЕсли;
		
		Если ДанныеДляПечати.СФНаАванс = Ложь Тогда 
			
			item.TotalWithVatExcluded = Стр.Сумма - ?(Стр.СуммаВключаетНДС, Стр.суммаНДС, 0);
			
			Если ЗначениеЗаполнено(item.Quantity) Тогда
				
				РасчетнаяЦена = Окр(item.TotalWithVatExcluded / item.Quantity, Точность);
				ОтклонениеОтРасчетной = (РасчетнаяЦена - Стр.Цена) * Стр.Количество;
				Если Стр.СуммаВключаетНДС = Истина ИЛИ Макс(ОтклонениеОтРасчетной, -ОтклонениеОтРасчетной) > 0.03 Тогда
					item.price = РасчетнаяЦена;	
				Иначе
					item.price = Стр.Цена;	
				КонецЕсли;
				
			Иначе
				item.price = Неопределено;	
			КонецЕсли;
		КонецЕсли;	
		
		Item.Vat						= ?(Стр.СтавкаНДС = "без НДС", Неопределено, Стр.СуммаНДС);
		Item.Total						= Стр.Сумма + ?(Стр.СуммаВключаетНДС, 0, Стр.СуммаНДС);
		Item.TaxRate               		= Стр.СтавкаНДС;
		Item.CountriesOfOrigin  		= ?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), СокрЛП(Стр.СтранаПроисхождения.Код), "");
		Item.CustomsDeclarationNumbers 	= Модуль_Интеграция.ПолучитьНомерГТД(Стр.НомерГТД);
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, Стр);
		
	КонецЦикла;	
	
	Для каждого Item Из content.items Цикл
		Item.StructedAdditionalInfos = Новый Массив;
	КонецЦикла;
	
	//заполняем итоги
	Content.Totals.Total	= ДанныеДляПечати.СуммаДокумента;
	Content.Totals.Vat		= ДанныеДляПечати.СуммаНДСДокумента;
	Content.Totals.TotalWithVatExcluded = ДанныеДляПечати.СуммаБезНДСДокумента;
	
	Если Не ЗапущенКакВнешнийМодуль Тогда
		
		Если ПараметрыСогласования <> Неопределено И ЗначениеЗаполнено(ПараметрыСогласования.ФИОПодписанта) Тогда
			ЗаполнитьФИОПодписанта(Content.Signer, ПараметрыСогласования.ФИОПодписанта);
		Иначе
			Content.Signer.Surname 		= ДанныеСотрудника.Фамилия;
			Content.Signer.FirstName 	= ДанныеСотрудника.Имя;
			Content.Signer.Patronymic 	= ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		Content.Signer.Inn 										= Content.seller.inn;
		Content.Signer.IsSoleProprietor							= Content.seller.IsSoleProprietor;
		Content.Signer.SoleProprietorRegistrationCertificate 	= ДанныеДляПечати.ДатаНомерСвидетельстваОРегистрации;	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКонтентКорректировочногоСчетаФактуры93(Content, СтруктураДокумента, ДополнительныеПараметры)
	
	ДанныеСотрудника				 = ДополнительныеПараметры.ДанныеСотрудника;
	ПараметрыСогласования			 = ДополнительныеПараметры.ПараметрыСогласования;
	ДополнительныеСведенияСтрокой	 = ДополнительныеПараметры.ДополнительныеСведенияСтрокой;
	
	ДанныеДляПечати = СтруктураДокумента;
	
	Content.InvoiceCorrectionNumber = ДанныеДляПечати.НомераДляКСФ.НомерКСФ;
	Content.InvoiceCorrectionDate   = ДанныеДляПечати.НомераДляКСФ.ДатаКСФ;
	
	Если ДанныеДляПечати.НомераДляКСФ.ЭтоИКСФ = Истина Тогда 
		//это ксф с исправлением
		Content.InvoiceCorrectionRevisionNumber = ДанныеДляПечати.НомераДляКСФ.НомерИКСФ;
		Content.InvoiceCorrectionRevisionDate   = ДанныеДляПечати.НомераДляКСФ.ДатаИКСФ;
	КонецЕсли;
	
	//укажем данные на оригинальную счф
	OriginalInvoices = Новый Структура("Date, Number, InvoiceRevisionDate, InvoiceRevisionNumber");
	
	OriginalInvoices.Date	= ДанныеДляПечати.НомераДляКСФ.ДатаИсходногоДокумента;
	OriginalInvoices.Number = ДанныеДляПечати.НомераДляКСФ.НомерИсходногоДокумента;
	Если ДанныеДляПечати.НомераДляКСФ.УчитыватьИсправлениеИсходногоДокумента Тогда 
		OriginalInvoices.InvoiceRevisionNumber	= формат(ДанныеДляПечати.НомераДляКСФ.НомерИсправленияИсходногоДокумента, "ЧДЦ=0; ЧГ=0");
		OriginalInvoices.InvoiceRevisionDate	= ДанныеДляПечати.НомераДляКСФ.ДатаИсправленияИсходногоДокумента;
	КонецЕсли;
	
	Content.OriginalInvoices.Добавить(OriginalInvoices);			
	
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Buyer, ДанныеДляПечати.Контрагент, ДанныеДляПечати.Дата, , Истина, Истина);
	Если ЗначениеЗаполнено(ДанныеДляПечати.КПППокупателя) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КПППокупателя;
	КонецЕсли;	
	
	Модуль_Интеграция.ЗаполнитьСтруктурируЮрФизЛица(Content.Seller, ДанныеДляПечати.Организация, ДанныеДляПечати.Дата, , Истина, Истина);
	
	content.currency 		= ?(ПустаяСтрока(ДанныеДляПечати.ВалютаДокумента), "", СокрЛП(ДанныеДляПечати.ВалютаДокумента.Код));
	content.ВалютаСсылка 	= ДанныеДляПечати.ВалютаДокумента;
	
	Content.StructedAdditionalInfos = ДанныеДляПечати.ДопИнфо;
	Дополнить_StructedAdditionalInfos_ДопСведениями(Content.StructedAdditionalInfos, ДополнительныеСведенияСтрокой);
	
	Content.TotalsDec.Total 				= Неопределено;
	Content.TotalsDec.TotalWithVatExcluded 	= Неопределено;
	Content.TotalsDec.Vat 					= Неопределено;
	
	Content.TotalsInc.Total 				= Неопределено;
	Content.TotalsInc.TotalWithVatExcluded 	= Неопределено;
	Content.TotalsInc.Vat 					= Неопределено;
	
	Точность = ОбщиеПараметры.ТочностьЦены;
	
	Для Каждого СтрокаДанных Из ДанныеДляпечати.ТабличнаяЧасть Цикл 
		
		Item = content.items.Добавить();
		item.StructedAdditionalInfos = СтрокаДанных.ДопИнфо;
		Item.AmountsDec 			 = Новый_AmountsDiff();
		Item.AmountsInc 			 = Новый_AmountsDiff();
		Item.OriginalValues 		 = Новый_InvoiceItemFields();
		Item.CorrectedValues 		 = Новый_InvoiceItemFields();
		
		Item.Product = СтрокаДанных.Номенклатура;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		
		Если СтрокаДанных.количествоДоИзменения = 0 И СтрокаДанных.количество = 0 Тогда
			Item.OriginalValues.UnitCode  = "";
			Item.CorrectedValues.UnitCode = "";
		Иначе
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения) Тогда
				Item.OriginalValues.UnitCode = ItemContent_UnitCode(СтрокаДанных.ЕдиницаИзмеренияДоИзменения, СтрокаДанных.КодЕдиницыИзмеренияДоИзменения);
			Иначе
				Item.OriginalValues.UnitCode = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
				Item.CorrectedValues.UnitCode = ItemContent_UnitCode(СтрокаДанных.ЕдиницаИзмерения, СтрокаДанных.КодЕдиницыИзмерения);
			Иначе
				Item.CorrectedValues.UnitCode = "";
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаДанных.КоличествоДоИзменения <> 0 Тогда
			Item.OriginalValues.Quantity = ?(ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения), СтрокаДанных.КоличествоДоИзменения, Неопределено);
		Иначе
			Item.OriginalValues.Quantity = Неопределено;
		КонецЕсли;
		
		Если СтрокаДанных.Количество <> 0 Тогда
			Item.CorrectedValues.Quantity = ?(ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения), СтрокаДанных.Количество, Неопределено);
		ИначеЕсли  ЗначениеЗаполнено(Item.OriginalValues.Quantity) Тогда 
			//если до количество было, а теперь его не стало - заполняем 0 а не "-"!!!
			Item.CorrectedValues.Quantity = 0;
		Иначе	
			Item.CorrectedValues.Quantity = Неопределено;
		КонецЕсли;
		
		Item.OriginalValues.TotalWithVatExcluded  = СтрокаДанных.СуммаДоИзменения - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДСДоИзменения, 0);
		Item.CorrectedValues.TotalWithVatExcluded = СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.суммаНДС, 0);
		
		Item.OriginalValues.Price  = ?(НЕ ЗначениеЗаполнено(Item.OriginalValues.Quantity), Неопределено, Окр(Item.OriginalValues.TotalWithVatExcluded / Item.OriginalValues.Quantity, Точность));
		Item.CorrectedValues.Price = ?(НЕ ЗначениеЗаполнено(Item.CorrectedValues.Quantity), Неопределено, Окр(Item.CorrectedValues.TotalWithVatExcluded / Item.CorrectedValues.Quantity, Точность));
		
		Item.OriginalValues.TaxRate    = ?(ЗначениеЗаполнено(СтрокаДанных.СтавкаНДСДоИзменения) = Истина, СтрокаДанных.СтавкаНДСДоИзменения, СтрокаДанных.СтавкаНДС);
		Item.CorrectedValues.TaxRate   = СтрокаДанных.СтавкаНДС;
		
		
		Item.OriginalValues.Vat  = ?(Item.OriginalValues.TaxRate = "без НДС", Неопределено, СтрокаДанных.СуммаНДСДоИзменения);
		Item.CorrectedValues.Vat = ?(Item.CorrectedValues.TaxRate = "без НДС", Неопределено, СтрокаДанных.СуммаНДС);
		
		Item.OriginalValues.Total   = СтрокаДанных.СуммаДоИзменения + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДСДоИзменения);
		Item.CorrectedValues.Total  = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
		
		Если Item.OriginalValues.TotalWithVatExcluded < Item.CorrectedValues.TotalWithVatExcluded Тогда 
			Item.AmountsInc.TotalWithVatExcluded = Item.CorrectedValues.TotalWithVatExcluded - Item.OriginalValues.TotalWithVatExcluded;
			Item.AmountsDec.TotalWithVatExcluded = 0;
		Иначе 
			Item.AmountsInc.TotalWithVatExcluded = 0; 
			Item.AmountsDec.TotalWithVatExcluded = - Item.CorrectedValues.TotalWithVatExcluded + Item.OriginalValues.TotalWithVatExcluded
		КонецЕсли;
		
		СуммаНДСДо    = ?(Item.OriginalValues.Vat = Неопределено, 0, Item.OriginalValues.Vat);
		СуммаНДСПосле = ?(Item.CorrectedValues.Vat = Неопределено, 0, Item.CorrectedValues.Vat);
		
		Если Item.OriginalValues.Vat = Неопределено И Item.CorrectedValues.Vat = Неопределено Тогда 
			Item.AmountsInc.Vat = Неопределено;
			Item.AmountsDec.Vat = Неопределено; 
		ИначеЕсли СуммаНДСДо < СуммаНДСПосле Тогда 
			Item.AmountsInc.Vat = СуммаНДСПосле - СуммаНДСДо;
			Item.AmountsDec.Vat = 0; 
		Иначе 
			Item.AmountsInc.Vat = 0;
			Item.AmountsDec.Vat = - СуммаНДСПосле + СуммаНДСДо;
		КонецЕсли;
		
		Если Item.OriginalValues.Total < Item.CorrectedValues.Total Тогда 
			Item.AmountsInc.Total = Item.CorrectedValues.Total - Item.OriginalValues.Total;
			Item.AmountsDec.Total = 0;
		Иначе 
			Item.AmountsInc.Total = 0;
			Item.AmountsDec.Total = - Item.CorrectedValues.Total + Item.OriginalValues.Total;
		КонецЕсли;
		
		Если Item.AmountsDec.TotalWithVatExcluded <> 0 Тогда 
			Content.TotalsDec.TotalWithVatExcluded = ПривестиКЧислу(Content.TotalsDec.TotalWithVatExcluded) + Item.AmountsDec.TotalWithVatExcluded; 
		КонецЕсли;	
		Если ПривестиКЧислу(Item.AmountsDec.Vat) <> 0 Тогда
			Content.TotalsDec.Vat = ПривестиКЧислу(Content.TotalsDec.Vat) + Item.AmountsDec.Vat; 
		КонецЕсли;	
		Если Item.AmountsDec.Total <> 0 Тогда 
			Content.TotalsDec.Total	= ПривестиКЧислу(Content.TotalsDec.Total) + Item.AmountsDec.Total; 
		КонецЕсли;	
		
		Если Item.AmountsInc.TotalWithVatExcluded <> 0 Тогда 
			Content.TotalsInc.TotalWithVatExcluded = ПривестиКЧислу(Content.TotalsInc.TotalWithVatExcluded) + Item.AmountsInc.TotalWithVatExcluded; 
		КонецЕсли;	
		Если ПривестиКЧислу(Item.AmountsInc.Vat) <> 0 Тогда 
			Content.TotalsInc.Vat = ПривестиКЧислу(Content.TotalsInc.Vat)+ Item.AmountsInc.Vat; 
		КонецЕсли;	
		Если Item.AmountsInc.Total <> 0 Тогда 
			Content.TotalsInc.Total = ПривестиКЧислу(Content.TotalsInc.Total) + Item.AmountsInc.Total; 
		КонецЕсли;	
	КонецЦикла;
	
	Если Не ЗапущенКакВнешнийМодуль Тогда
		
		Если ПараметрыСогласования <> Неопределено И ЗначениеЗаполнено(ПараметрыСогласования.ФИОПодписанта) Тогда
			ЗаполнитьФИОПодписанта(Content.Signer, ПараметрыСогласования.ФИОПодписанта);
		Иначе
			Content.Signer.Surname 		= ДанныеСотрудника.Фамилия;
			Content.Signer.FirstName 	= ДанныеСотрудника.Имя;
			Content.Signer.Patronymic 	= ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		Content.Signer.Inn = Content.seller.inn;
		Content.Signer.IsSoleProprietor	= Content.seller.IsSoleProprietor;
		Content.Signer.SoleProprietorRegistrationCertificate = ДанныеДляПечати.ДатаНомерСвидетельстваОРегистрации;
		
	КонецЕсли;
	
КонецПроцедуры

