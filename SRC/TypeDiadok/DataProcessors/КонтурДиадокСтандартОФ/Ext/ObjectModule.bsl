// Возвращает COM-объект Document, соответствующий исходному документу, отправленному из ДокументСсылка.
// Возвращает Неопределено, если такой Document не найден.
Функция ПолучитьИсправляемыйDocument(ДокументСсылка)
	
	Результат = Неопределено;
	
	Докоснование =  Модуль_Интеграция.ПолучитьСФОснованиеДляИСФДиадок(ДокументССылка) ;
	Если НЕ ЗначениеЗаполнено(Докоснование) Тогда
		Возврат Результат; // "Отстутствует счет-фактура, который должен являться основанием данного документа.";
	КонецЕсли;
	
	docId =     Модуль_Данные1С_СвязиОбъектов().Документ_2_DocumentID(Докоснование);
	Если НЕ ЗначениеЗаполнено(DocId) Тогда 
		Возврат Результат; //"Первоначальный документ <a href=""СЧЕТФАКТУРАВЫДАННЫЙ:"+Докоснование.УникальныйИдентификатор()+"""a>"+ДокОснование+"</a> не передавался через Диадок"
	КонецЕсли;
	
	Organization = Модуль_РаботаССерверомДиадок.ПолучитьЯщикДиадокДляОрганизации(ДокументСсылка.Организация);
	Результат =  Organization.getDocumentById(docId);
	
	Возврат Результат;
	
КонецФункции	

