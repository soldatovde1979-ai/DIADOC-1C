Функция СформироватьОтветныйТитулДокумента(Document, ПротоКонтент) Экспорт
	
	ГенерацияXML = МодульГенерацияXML();
	
	ВсеБазовыеФорматы = БазовыеФорматы();
	
	ФорматЭД = ФорматЭлектронногоДокумента(Document);
	
	БазовыйФормат = ФорматЭД.БазовыйФормат;
	
	ТипКонтента = ФорматЭД.ТипКонтента;
	ТипКонтента = СтрЗаменить(ТипКонтента, "SellerContent", "BuyerContent");
	ТипКонтента = СтрЗаменить(ТипКонтента, "SenderTitle", "RecipientTitle");
	
	ФайлТитулаПродавца	 = Модуль_РаботаССерверомДиадок.ПолучитьФайлТитулаПродавца(Document);
	ФайлПодписиПродавца	 = Модуль_РаботаССерверомДиадок.ПолучитьФайлПодписиПродавца(Document);
	
	ПротоКонтентXDTO			 = ГенерацияXML.ПротоКонтент_В_ПротоКонтентXDTO(ПротоКонтент, ТипКонтента);
	ПараметрыФормированияФайла	 = ГенерацияXML.XML_ПараметрыФормированияФайла();
	
	Если БазовыйФормат = ВсеБазовыеФорматы.utd820 Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_УПД_820(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.utd Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_УПД_155(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.ucd736 Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_УКД_736(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.ucd Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_УКД(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.tovtorg Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_Торг_551(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.rezru Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_Акт_552(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.torg12 Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_Торг_172(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.act Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_Акт_172(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ПараметрыФормированияФайла);
		
	ИначеЕсли БазовыйФормат = ВсеБазовыеФорматы.torg2 Тогда
		
		ОбъектXDTO = ГенерацияXML.XML_ОтветныйТитул_Торг2(ПротоКонтентXDTO
		, ФайлТитулаПродавца, ФайлПодписиПродавца, ПараметрыФормированияФайла);
		
	Иначе
		
		ШаблонСтроки = НСтр("ru = 'Ошибка заполнения титула покупателя, неизвестный тип контента %1'");
		ТекстОшибки = ПодставитьПараметрыВСтроку(ШаблонСтроки, ТипКонтента);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Результат = ГенерацияXML.ОбъектXDTO_В_ДвоичныеДанные(ОбъектXDTO);
	
	Возврат Результат;
	
КонецФункции

Функция КэшПротоКонтентаДокумента(BoxID, DocumentId)
	
	МаксимальныйРазмерКэша = 100;
	
	КэшПротоКонтента = ЭДО_Кэш_Прочитать("КэшПротоКонтента");
	
	Если КэшПротоКонтента = Неопределено Тогда
		
		КэшПротоКонтента = Новый Структура;
		КэшПротоКонтента.Вставить("МассивКлючей", Новый Массив);
		КэшПротоКонтента.Вставить("Соответствие", Новый Соответствие);
		
		ЭДО_Кэш_Поместить("КэшПротоКонтента", КэшПротоКонтента);
		
	КонецЕсли;
	
	Ключ = BoxID + DocumentId;
	Результат = КэшПротоКонтента.Соответствие[Ключ];
	
	Если Результат = Неопределено Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("ПротоКонтент");
		Результат.Вставить("ПротоКонтентОтветногоТитула");
		
		Если КэшПротоКонтента.МассивКлючей.Количество() = МаксимальныйРазмерКэша Тогда
			КэшПротоКонтента.Соответствие.Удалить(КэшПротоКонтента.МассивКлючей[0]);
			КэшПротоКонтента.МассивКлючей.Удалить(0);
		КонецЕсли;
		
		КэшПротоКонтента.Соответствие.Вставить(Ключ, Результат);
		КэшПротоКонтента.МассивКлючей.Добавить(Ключ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

