//} ПУСТЫЕ СТРУКТУРЫ ДЛЯ ИНИЦИАЛИЗАЦИИ КОНТЕНТА

//{ ДАННЫЕ ДЛЯ ФОРМИРОВАНИЯ УПД/УКД

// Определяет значение параметра ФункцияУПД, используемого в
// методах заполнения контента. Алгоритм следующий:
//  - Пробуем определить результат по имени типа электронного документа (typeNamedId);
//  - В случае неудачи берем значение функции из формата отправки;
//  - Если результат не определен, возвращаем функцию по умолчанию;
//
// Параметры:
//  ФорматОтправки - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента;
// 
// Возвращаемое значение:
//  Строка - возможные значения указаны в перечислении ФункцииЭлектронныхДокументов;
//
Функция ФункцияУниверсальногоДокумента(ФорматОтправки)
	
	ТипыДокументов = ИдентификаторыТиповДокументов();
	ФункцииЭД = ФункцииЭлектронныхДокументов();
	
	ИмяТипа = ФорматОтправки.ИмяТипа;
	
	Если ИмяТипа = ТипыДокументов.Invoice
		Или ИмяТипа = ТипыДокументов.InvoiceRevision Тогда
		
		Результат = ФункцииЭД.СЧФ;
		
	ИначеЕсли ИмяТипа = ТипыДокументов.InvoiceCorrection
		Или ИмяТипа = ТипыДокументов.InvoiceCorrectionRevision Тогда
		
		Результат = ФункцииЭД.КСЧФ;
		
	ИначеЕсли ИмяТипа = ТипыДокументов.XmlTorg12
		Или ИмяТипа = ТипыДокументов.XmlAcceptanceCertificate Тогда
		
		Результат = ФункцииЭД.ДОП;
		
	Иначе
		
		Результат = ФорматОтправки.ФункцияДокумента;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ФункцииЭД.ПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляФормированияУПД(ДокСсылка, ДопПараметры) Экспорт 
	
	Если ДопПараметры.ФункцияДокумента = "СЧФДОП" ИЛИ ДопПараметры.ФункцияДокумента = "СЧФ" Тогда
		
		СчетФактура 	   = ДокСсылка;
		ДокументыОснования = Модуль_Интеграция.ПолучитьМассивСсылокРНКПоСчетуФактуреВыданному(ДокСсылка);
		
	Иначе
		
		СчетФактура = Неопределено;
		
		ДокументыОснования = Новый Массив;
		ДокументыОснования.Добавить(ДокСсылка);
		
	КонецЕсли;
	
	Накладная = ?(ДокументыОснования[0].Метаданные().Имя = "РеализацияОтгруженныхТоваров", ДокументыОснования[0].ДокументОтгрузки, ДокументыОснования[0]);
	
	ДанныеШапки = Модуль_Интеграция.ПолучитьСтруктуруШапки(Накладная, СчетФактура);
	
	ДанныеШапки.Вставить("Номер"					, Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(Накладная));
	ДанныеШапки.Вставить("Подразделение"			, Модуль_Интеграция.ПолучитьПодразделениеИзДокумента(Накладная));
	
	Если НЕ ДанныеШапки.Свойство("БанковскийСчетОрганизации") Тогда
		ДанныеШапки.Вставить("БанковскийСчетОрганизации", Модуль_Интеграция.ПолучитьБанковскийСчетПоДокументу(Накладная));
	КонецЕсли;
	
	ДанныеШапки.Вставить("Функция", ?(ДопПараметры.ФункцияДокумента = "СЧФДОП", "InvoiceAndBasic", ?(ДопПараметры.ФункцияДокумента = "СЧФ", "Invoice", "Basic")));
	
	Если ДопПараметры.ФункцияДокумента = "СЧФДОП" ИЛИ ДопПараметры.ФункцияДокумента = "ДОП" Тогда
		ДатаОтгрузки = Накладная.Дата;
		Если ДатаОтгрузки <> ДанныеШапки.Дата Тогда
			ДанныеШапки.Вставить("ДатаОтгрузки", ДатаОтгрузки);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеШапки.Вставить("СуммаДокумента"		, Неопределено);
	ДанныеШапки.Вставить("СуммаНДСДокумента"	, Неопределено);
	ДанныеШапки.Вставить("СуммаБезНДСДокумента"	, Неопределено);
	
	СвГосРегИП = Модуль_Интеграция.ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДокСсылка.Организация);
	ДанныеШапки.Вставить("ДатаНомерСвидетельстваОРегистрации", СвГосРегИП);
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		
		ДанныеШапки.Вставить("НомераДляСФ"						 , Модуль_Интеграция.ПолучитьНомераДляСФ(СчетФактура));
		ДанныеШапки.Вставить("СФНаАванс"						 , Модуль_Интеграция.ЭтоСчетФактуранаАванс(СчетФактура));
		ДанныеШапки.Вставить("КПППокупателя"						 , Модуль_Интеграция.ПолучитьКПППокупателя(СчетФактура));
		ДанныеШапки.Вставить("ДатаНомерДокументовОплаты"		 , Модуль_Интеграция.ПолучитьДатуНомерДокументовОплаты(СчетФактура));
		ДанныеШапки.Вставить("СчетФактура"						 , СчетФактура);
		
		ТабличнаяЧасть = ПолучитьТаблицуСФ(СчетФактура, ДокументыОснования, Ложь, Ложь, ДанныеШапки);
		
	Иначе
		
		Если ДопПараметры.ТипДокумента = "XmlAcceptanceCertificate" Тогда
			ДанныеШапки.Вставить("ЭтоАкт", Истина);
		КонецЕсли;
		
		ТабличнаяЧасть = ПолучитьДанныеТабличнойЧастиДляДокументаРеализации(Накладная, ДанныеШапки, Истина);
		
	КонецЕсли;
	
	ДанныеШапки.Вставить("КПППродавца", Модуль_Интеграция.ПолучитьКПППродавца(ДокСсылка));
	ДанныеШапки.Вставить("СодержитТовары", ТабличнаяЧасть.Найти(Ложь, "ЭтоУслуга") <> Неопределено);
	
	Если НЕ ДанныеШапки.СодержитТовары Тогда
		ДанныеШапки.Грузоотправитель = Неопределено;
		ДанныеШапки.Грузополучатель  = Неопределено;
	КонецЕсли;
	
	ЗаполнитьОснованияПередачи(ДанныеШапки, ДокументыОснования, ДопПараметры);
	
	ДанныеШапки.Вставить("НДСИсчисляетсяНалоговымАгентом",	НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокСсылка));
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		
		Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			СтрокаТЧ.СтавкаНДС	= СтавкаНДС_ИсчНалАг();
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьИтоговыеСуммыДокумента(ТабличнаяЧасть, ДанныеШапки);
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки"   , ДанныеШапки);
	Результат.Вставить("ТабличнаяЧасть", ТабличнаяЧасть);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьОснованияПередачи(ДанныеШапки, ДокументыОснования, ДопПараметры)
	
	ДанныеШапки.Вставить("ОснованияПередачи", Новый_TransferBases());
	
	УказыватьОтсутствиеОснованияУПД = ДопПараметры.УказыватьОтсутствиеОснованияУПД;
	
	ДобавленныеОснования = Новый Соответствие;
	Для Каждого ДокументОснование Из ДокументыОснования Цикл
		
		СтруктураОснования = Модуль_Интеграция.ПолучитьСтруктуруОснованияУПД(ДокументОснование, ДанныеШапки);
		
		Если Не ЗначениеЗаполнено(СтруктураОснования.GroundName) 
			Или ДобавленныеОснования[СтруктураОснования.Основание] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавленныеОснования.Вставить(СтруктураОснования.Основание, Истина);
		
		ДобавитьОснованиеПередачи(ДанныеШапки, СтруктураОснования, УказыватьОтсутствиеОснованияУПД);
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ДобавленныеОснования) Тогда
		ЗаполнитьОснованияПередачиПоДоговору(ДанныеШапки, УказыватьОтсутствиеОснованияУПД);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОснованияПередачиПоДоговору(ДанныеШапки, УказыватьОтсутствиеОснованияУПД)
	
	ЭтоУПД = Истина;
	Договор = СвойствоСтруктуры(ДанныеШапки, "ДоговорКонтрагента");
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции();
	СтруктураОснования = МенеджерИнтеграции.ПолучитьСтруктуруОснованияПоДоговору(Договор, ЭтоУПД);
	ДобавитьОснованиеПередачи(ДанныеШапки, СтруктураОснования, УказыватьОтсутствиеОснованияУПД);
	
КонецПроцедуры

Процедура ДобавитьОснованиеПередачи(ДанныеШапки, СтруктураОснования, УказыватьОтсутствиеОснованияУПД = Ложь)
	
	НоваяСтрока = ДанныеШапки.ОснованияПередачи.Добавить();
	
	Если Не ЗначениеЗаполнено(СтруктураОснования.GroundDate) И УказыватьОтсутствиеОснованияУПД Тогда
		НоваяСтрока.DocumentName   = "Отсутствует";
		НоваяСтрока.DocumentNumber = "";
		НоваяСтрока.DocumentDate   = Дата(1, 1, 1);
	Иначе
		НоваяСтрока.DocumentName   = СтруктураОснования.GroundName;
		НоваяСтрока.DocumentNumber = СокрЛП(СтруктураОснования.GroundNumber);
		НоваяСтрока.DocumentDate   = СтруктураОснования.GroundDate;
	КонецЕсли;
	
	СлужебнаяИнформация = Новый Структура;
	СлужебнаяИнформация.Вставить("ОснованиеСсылка");
	
	СлужебнаяИнформация.ОснованиеСсылка = СтруктураОснования.Основание;
	
	НоваяСтрока.СлужебнаяИнформация = СлужебнаяИнформация;
	
КонецПроцедуры

Функция ДанныеДляФормированияУКД(ДокСсылка, ДопПараметры) Экспорт 
	
	Если ДопПараметры.ФункцияДокумента = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияДокумента = "КСЧФ" Тогда
		СчетФактура 	   = ДокСсылка;
		ДокументыОснования = Модуль_Интеграция.ПолучитьМассивСсылокРНКПоСчетуФактуреВыданному(ДокСсылка);
	Иначе
		СчетФактура 		= Неопределено;
		ДокументыОснования 	= Новый Массив;
		ДокументыОснования.Добавить(ДокСсылка);
	КонецЕсли;
	
	Если ДокументыОснования[0].Метаданные().Имя = "РеализацияОтгруженныхТоваров" Тогда
		Накладная = ДокументыОснования[0].ДокументОтгрузки;
	Иначе
		Накладная = ДокументыОснования[0];
	КонецЕсли;
	
	ДанныеШапки = Модуль_Интеграция.ПолучитьСтруктуруШапки(Накладная, СчетФактура);
	
	ДанныеШапки.Вставить("НомераДляКСФ", Модуль_Интеграция.ПолучитьНомераДляКСФ(ДокСсылка));
	
	ДанныеШапки.Вставить("Номер", 			Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(Накладная));
	ДанныеШапки.Вставить("Подразделение", 	Модуль_Интеграция.ПолучитьПодразделениеИзДокумента(Накладная));
	
	Если НЕ ДанныеШапки.Свойство("БанковскийСчетОрганизации") Тогда
		ДанныеШапки.Вставить("БанковскийСчетОрганизации", Модуль_Интеграция.ПолучитьБанковскийСчетПоДокументу(Накладная));
	КонецЕсли;
	
	Если ДопПараметры.ФункцияДокумента = "КСЧФДИС" Тогда
		ФункцияДокумента = "InvoiceAndBasic";
	ИначеЕсли ДопПараметры.ФункцияДокумента = "КСЧФ" Тогда
		ФункцияДокумента = "Invoice";
	Иначе
		ФункцияДокумента = "Basic"; 	
	КонецЕсли;
	
	ДанныеШапки.Вставить("Функция", ФункцияДокумента);
	
	Если ДопПараметры.ФункцияДокумента = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияДокумента = "ДИС" Тогда
		ДатаУведомления = Накладная.Дата;
		Если ДатаУведомления <> ДанныеШапки.Дата Тогда
			ДанныеШапки.Вставить("ДатаУведомления", ДатаУведомления);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеШапки.Вставить("КПППродавца", Модуль_Интеграция.ПолучитьКПППродавца(ДокСсылка));
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		ДанныеШапки.Вставить("КПППокупателя", Модуль_Интеграция.ПолучитьКПППокупателя(СчетФактура)); 
	КонецЕсли;
	
	ТабличнаяЧасть = ПолучитьТаблицуСФ(СчетФактура, ДокументыОснования, Истина, ДопПараметры.ФункцияДокумента = "ДИС", ДанныеШапки);
	
	Если Накладная.Метаданные().Реквизиты.Найти("СопроводительныеДокументы") <> Неопределено Тогда
		ДанныеШапки.Вставить("ИныеСведенияОбИзмененииСтоимости", Накладная.СопроводительныеДокументы);
	КонецЕсли;
	
	ДанныеШапки.Вставить("ОснованияПередачи"		, Новый_CorrectionBases());
	
	РеквизитыПередаточныхДокументов		= Новый_BaseDocumentName();
	ДобавленныеПередаточныеДокументы	= Новый Соответствие;
	
	ТипПередаточногоДокумента = "УПД ";
	
	ДобавленныеОснования = Новый Соответствие;
	
	Для Каждого ДокументОснование Из ДокументыОснования Цикл
		
		Если ДанныеШапки.Свойство("ДоговорКонтрагента") Тогда
			МенеджерИнтеграции = МодульМенеджерИнтеграции();
			СтруктураОснования = МенеджерИнтеграции.ПолучитьСтруктуруОснованияПоДоговору(ДанныеШапки.ДоговорКонтрагента, Истина);
		Иначе
			СтруктураОснования = Модуль_Интеграция.ПолучитьСтруктуруОснования(ДокументОснование, Ложь, Истина);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураОснования.GroundDate) 
			И ЗначениеЗаполнено(СтруктураОснования.GroundName)
			И ДобавленныеОснования[СтруктураОснования.Основание] <> Истина Тогда
			
			ДобавленныеОснования.Вставить(СтруктураОснования.Основание, Истина);
			
			НоваяСтрока = ДанныеШапки.ОснованияПередачи.Добавить();
			НоваяСтрока.BaseDocumentName   = СтруктураОснования.GroundName;
			НоваяСтрока.BaseDocumentNumber = СокрЛП(СтруктураОснования.GroundNumber);
			НоваяСтрока.BaseDocumentDate   = СтруктураОснования.GroundDate;
			
		КонецЕсли;
		
		ИсправляемыйДокументРеализации = Модуль_Интеграция.ПолучитьИсправляемыйДокументРеализации(ДокументОснование);
		Если ДопПараметры.ФункцияДокумента = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияДокумента = "КСЧФ" Тогда 
			СФВыданный = Модуль_Интеграция.ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ИсправляемыйДокументРеализации);
			Если ЗначениеЗаполнено(СФВыданный) Тогда
				ПередаточныйДокумент = СФВыданный;
			Иначе
				ПередаточныйДокумент = ИсправляемыйДокументРеализации;
			КонецЕсли;
		Иначе
			ПередаточныйДокумент = ИсправляемыйДокументРеализации;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПередаточныйДокумент)
			Или ДобавленныеПередаточныеДокументы[ПередаточныйДокумент] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавленныеПередаточныеДокументы.Вставить(ПередаточныйДокумент, Истина);
		
		ЭлементBaseDocument = РеквизитыПередаточныхДокументов.Добавить();
		
		ЭлементBaseDocument.BaseDocumentName	= ТипПередаточногоДокумента;
		ЭлементBaseDocument.BaseDocumentNumber 	= Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(ПередаточныйДокумент);
		ЭлементBaseDocument.BaseDocumentDate 	= Формат(ПередаточныйДокумент.Дата, "ДФ=dd.MM.yyyy");
		
	КонецЦикла;
	
	ДанныеШапки.Вставить("РеквизитыПередаточныхДокументов", РеквизитыПередаточныхДокументов); 
	
	ДанныеШапки.Вставить("НДСИсчисляетсяНалоговымАгентом",	НДСПоДокументуИсчисляетсяНалоговымАгентом(ИсправляемыйДокументРеализации));
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		
		Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			
			СтрокаТЧ.СтавкаНДС				= СтавкаНДС_ИсчНалАг();
			СтрокаТЧ.СтавкаНДСДоИзменения	= СтавкаНДС_ИсчНалАг();
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", 		ДанныеШапки);
	Результат.Вставить("ТабличнаяЧасть", 	ТабличнаяЧасть);
	
	Возврат Результат;
	
КонецФункции 	

//} ДАННЫЕ ДЛЯ ФОРМИРОВАНИЯ УПД/УКД

//{ ПРОЧЕЕ

Функция СократитьПредставлениеТелефона(телефонСтрока) Экспорт
	
	Если (СтрДлина(телефонСтрока) <= 20) Или (Найти(ТелефонСтрока, ";") = 0) Тогда
		Возврат ТелефонСтрока
	КонецЕсли;
	
	НовыйТелефон = "";
	СтарыйТелефон = ТелефонСтрока;
	Пока найти(СтарыйТелефон, ";") > 0 Цикл
		Если (НовыйТелефон = "") Или (СтрДлина(НовыйТелефон) + найти(СтарыйТелефон, ";") <= 20) Тогда
			//добавим кусок
			НовыйТелефон = ?(НовыйТелефон = "", "",  НовыйТелефон + ";") + Лев(СтарыйТелефон, Найти(СтарыйТелефон, ";") - 1);
			СтарыйТелефон = Прав(СтарыйТелефон, СтрДлина(СтарыйТелефон) - Найти(СтарыйТелефон, ";"));
		Иначе 
			СтарыйТелефон = "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыйТелефон;
	
КонецФункции

Функция ПредставлениеТелефона(Знач Телефоны, ТипТелефона, Знач МаксимальнаяДлинаСтроки, Разделитель= ";") Экспорт
	
	ПозицияНачалаФакса = Найти(Телефоны, "факс:");
	
	Если ПозицияНачалаФакса > 0 Тогда
		
		Если ТипТелефона = "Телефон" Тогда
			Телефоны = Лев(Телефоны, ПозицияНачалаФакса - 1);
		ИначеЕсли ТипТелефона= "Факс" Тогда
			Телефоны = Сред(Телефоны, ПозицияНачалаФакса + 5);
		КонецЕсли;
		
	КонецЕсли;
	
	МассивПодстрок= Преобразование_СтрокуВМассивПодстрок(Телефоны, Разделитель, Истина, Истина);
	
	Результат =	  "";
	Разделитель1 = "";
	
	Для Каждого Подстрока Из МассивПодстрок Цикл
		
		МаксимальнаяДлинаСтроки= МаксимальнаяДлинаСтроки - СтрДлина(Подстрока);
		
		Если МаксимальнаяДлинаСтроки < 0 Тогда
			Прервать;
		КонецЕсли;
		
		Результат = Результат + Разделитель1 + Подстрока;
		
		Разделитель1 = Разделитель;
		
		Если МаксимальнаяДлинаСтроки = 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

