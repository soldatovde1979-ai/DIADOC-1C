// Заполняет сведения об участнике сделки.
//
// Параметры:
//  СведенияОбОрганизации	 - Структура - см. функцию Новый_ExtendedOrganizationInfo()
//  РеквизитыОрганизации	 - Структура - см. функцию РеквизитыЮрФизЛица()
//  ДополнительныеПараметры	 - Структура - (Необязательный) см. функцию ПараметрыЗаполненияИнформацииОбОрганизации()
//
Процедура ЗаполнитьИнформациюОбОрганизации(СведенияОбОрганизации, РеквизитыОрганизации, ДополнительныеПараметры = Неопределено)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияИнформацииОбОрганизации();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда 
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	// ОбщиеСвойства
	СведенияОбОрганизации.Name	 = РеквизитыОрганизации.НаименованиеДляПечатныхФорм;
	СведенияОбОрганизации.Inn	 = РеквизитыОрганизации.ИНН;
	СведенияОбОрганизации.Kpp	 = РеквизитыОрганизации.КПП;
	СведенияОбОрганизации.Okpo	 = РеквизитыОрганизации.КодПоОкпо;
	СведенияОбОрганизации.Phone	 = РеквизитыОрганизации.Телефоны;
	
	СведенияОбОрганизации.BankAccountNumber	 = РеквизитыОрганизации.НомерСчета;
	СведенияОбОрганизации.BankId			 = РеквизитыОрганизации.БИК;
	СведенияОбОрганизации.BankName			 = ?(ЗначениеЗаполнено(РеквизитыОрганизации.Банк), СокрЛП(РеквизитыОрганизации.Банк), Неопределено); // Банк может быть ссылкой
	
	// Адрес
	ИспользоватьЮридическийАдрес = (ПараметрыЗаполнения.ВидАдреса = Перечисление_ВидыКИ().ЮридическийАдрес);
	
	СведенияОбАдресе = ?(ИспользоватьЮридическийАдрес, РеквизитыОрганизации.ЮридическийАдресСтруктурой, РеквизитыОрганизации.ФактическийАдресСтруктурой);
	
	МенеджерИнтеграции = МодульМенеджерИнтеграции();
	МенеджерИнтеграции.Заполнить_AddressInfo(СведенияОбОрганизации.Address, СведенияОбАдресе);
	
	ОрганизацияИП = СтрДлина(РеквизитыОрганизации.ИНН) = 12;
	ТипОрганизации = ?(ОрганизацияИП, "IndividualEntity", "LegalEntity");
	
	// ExtendedOrganizationInfo
	Если СведенияОбОрганизации.Свойство("CorrespondentAccount") Тогда 
		СведенияОбОрганизации.CorrespondentAccount = РеквизитыОрганизации.КоррСчет;
	КонецЕсли;
	
	Если СведенияОбОрганизации.Свойство("Email") Тогда
		СведенияОбОрганизации.Email = РеквизитыОрганизации.Email;
	КонецЕсли;
	
	Если СведенияОбОрганизации.Свойство("Type") Тогда 
		СведенияОбОрганизации.Type = ТипОрганизации;
	КонецЕсли;
	
	// OrganizationInfo
	Если СведенияОбОрганизации.Свойство("IsSoleProprietor") Тогда 
		СведенияОбОрганизации.IsSoleProprietor = (ТипОрганизации = "IndividualEntity");
	КонецЕсли;
	
КонецПроцедуры

// Заполняет сведения таблицы счета на оплату.
//
// Параметры:
//  ТаблицаЭД	 - Структура		 - см. функцию Новый_ProformaInvoiceTable()
//  ДанныеТЧ	 - ТаблицаЗначений	 - см. функцию ДанныеТабличныхЧастей()
//
Процедура ЗаполнитьТаблицуСчетаНаОплату(ТаблицаЭД, ДанныеТЧ)
	
	// Итоги
	ТаблицаЭД.TotalWithVatExcluded	 = ДанныеТЧ.Итог("Сумма");
	ТаблицаЭД.TotalVat				 = ДанныеТЧ.Итог("СуммаНДС");
	ТаблицаЭД.Total					 = ДанныеТЧ.Итог("СуммаСНДС");
	ТаблицаЭД.GrandTotal			 = ТаблицаЭД.Total;
	
	// Строки таблицы
	Для Каждого СтрокаТЧ Из ДанныеТЧ Цикл 
		
		СтрокаЭД = ТаблицаЭД.Items.Добавить();
		
		СтрокаЭД.Product	 = СтрокаТЧ.НоменклатураПредставление;
		СтрокаЭД.Unit		 = СтрокаТЧ.ЕдиницаИзмеренияКод;
		СтрокаЭД.UnitName	 = Строка(СтрокаТЧ.ЕдиницаИзмерения);
		СтрокаЭД.Quantity	 = СтрокаТЧ.Количество;
		СтрокаЭД.Price		 = СтрокаТЧ.Цена;
		СтрокаЭД.TaxRate	 = СтрокаТЧ.СтавкаНДСПредставление;
		СтрокаЭД.Excise		 = Неопределено;
		СтрокаЭД.Vat		 = СтрокаТЧ.СуммаНДС;
		СтрокаЭД.Subtotal	 = СтрокаТЧ.СуммаСНДС;
		СтрокаЭД.SubtotalWithVatExcluded = СтрокаТЧ.Сумма;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(СтрокаЭД, СтрокаТЧ);
		
	КонецЦикла;
	
КонецПроцедуры

// Событие возникает перед выполнением запроса по шапке документа (см. ДанныеШапки).
// Позволяет переопределить выражения полей запроса для получения данных шапки.
//
// Параметры:
//  Реквизиты			 - Структура		 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение;
//  МетаданныеИсточника	 - ОбъектМетаданных	 - Метаданные документа-источника;
//  ВидЭД 				 - Строка			 - вид подгатавливаемого электронного документа (см. Перечисление_ВидыЭД());
//
// Пример:
//		Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Грузоотправитель") Тогда 
//			
//			Реквизиты.Грузоотправитель = 
//			"ВЫБОР
//			|	КОГДА Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
//			|		ТОГДА Организация
//			|	ИНАЧЕ Грузоотправитель
//			|КОНЕЦ";
//			
//		КонецЕсли;
//
Процедура ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеИсточника, ВидЭД)
	
	ВидыЭД = Перечисление_ВидыЭД();
	
	Если ВидЭД = ВидыЭД.СчетНаОплату Тогда 
		
		Реквизиты.Вставить("ПолучательПлатежа");
		Реквизиты.Вставить("Плательщик");
		Реквизиты.Вставить("СуммаСкидки");
		Реквизиты.Вставить("НазначениеПлатежа");
		Реквизиты.Вставить("ДополнительныеУсловия");
		Реквизиты.Вставить("ДополнительнаяИнформация");
		Реквизиты.Вставить("ИдентификаторПлатежа");
		Реквизиты.Вставить("СрокОплаты");
		
	КонецЕсли;
	
	Реквизиты.Договор = "ДоговорКонтрагента";
	Реквизиты.РасчетыВУсловныхЕдиницах = "ДоговорКонтрагента.РасчетыВУсловныхЕдиницах";
	Реквизиты.КурсДокумента = "КурсВзаиморасчетов";
	Реквизиты.КратностьДокумента = "КратностьВзаиморасчетов";
	Реквизиты.ЦенаВключаетНДС = "СуммаВключаетНДС";
	
	Модуль_Интеграция.ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеИсточника, ВидЭД);
	
КонецПроцедуры

