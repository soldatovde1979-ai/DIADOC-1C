// Конструктор коллекции, содержащей общепринятые реквизиты компании (юридического лица или индивидуального предпринимателя).
// 
// Возвращаемое значение:
// Структура - см. содержимое функции
//
Функция НовыйРеквизитыЮрФизЛица()
	
	Реквизиты = Новый Структура();
	Реквизиты.Вставить("Ссылка"); // Ссылка на компанию
	Реквизиты.Вставить("ЮридическоеФизическоеЛицо"); // ЮридическоеЛицо или ФизическоеЛицо
	// Наименования
	Реквизиты.Вставить("Представление",                      "");
	Реквизиты.Вставить("ПолноеНаименование",                 "");
	Реквизиты.Вставить("СокращенноеНаименование",            "");
	Реквизиты.Вставить("НаименованиеДляПечатныхФорм",        "");
	Реквизиты.Вставить("ФамилияИнициалыФизлица",             ""); // Фамилия И.О.
	Реквизиты.Вставить("ФИОФизлица",                         ""); // Фамилия Имя Отчество
	// Адреса и контактная информация
	Реквизиты.Вставить("ЮридическийАдрес",                   "");
	Реквизиты.Вставить("ЮридическийАдресСтруктурой",         "");
	Реквизиты.Вставить("ФактическийАдрес",                   ""); 
	Реквизиты.Вставить("ФактическийАдресСтруктурой",         "");
	Реквизиты.Вставить("ПочтовыйАдрес",                      ""); 
	Реквизиты.Вставить("Телефоны",                           ""); 
	Реквизиты.Вставить("Факс",                               ""); 
	Реквизиты.Вставить("Email",                              "");
	// Регистрационные данные
	Реквизиты.Вставить("ОГРН",                               ""); // Здесь же ОГРНИП для ИП, рег. номер для иностранных контрагентов
	Реквизиты.Вставить("ДатаРегистрации",                    "");
	Реквизиты.Вставить("КодПоОКПО",                          "");
	Реквизиты.Вставить("ИНН",                                "");
	Реквизиты.Вставить("КПП",                                ""); // Только для ЮЛ
	Реквизиты.Вставить("СвидетельствоСерияНомер",            "");           // Только для ИП
	Реквизиты.Вставить("СвидетельствоДатаВыдачи",            '0001-01-01'); // Только для ИП
	Реквизиты.Вставить("Свидетельство",                      ""); // Свидетельство строкой, только для ИП
	Реквизиты.Вставить("ДокументУдостоверяющийЛичность",     ""); // Только для физлица
	Реквизиты.Вставить("ИндивидуальныйПредприниматель",      Неопределено); // Только для организаций-ИП: ссылка на физ. лицо
	Реквизиты.Вставить("СтранаРегистрации",                  Неопределено);
	Реквизиты.Вставить("НалоговыйНомерВСтранеРегистрации",   "");
	// Банковские реквизиты
	Реквизиты.Вставить("НомерСчета",                         "");
	Реквизиты.Вставить("ТекстКорреспондента",                "");
	Реквизиты.Вставить("БИК",                                "");
	Реквизиты.Вставить("Банк",                               "");
	Реквизиты.Вставить("АдресБанка",                         "");
	Реквизиты.Вставить("КоррСчет",                           "");
	// Должностные лица юридического лица
	Реквизиты.Вставить("РуководительФИО"                   , "");
	Реквизиты.Вставить("ДолжностьРуководителяПредставление", "");
	
	Реквизиты.Вставить("ТипЮрФизЛица"					   , ""); // ЮридическоеЛицо, ФизическоеЛицо, ИностраннаяКомпания
	
	Возврат Реквизиты;
	
КонецФункции

// Предоставляет реквизиты компании (юридического лица или предпринимателя), например, для вывода в печатной форме.
//
// Параметры:
//  ЮрФизЛицо		 - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - компания, реквизиты которой нужно получить
//  Период			 - Дата - дата, на которую нужно получить значения периодических реквизитов
//  БанковскийСчет	 - СправочникСсылка.БанковскиеСчета - банковский счет, реквизиты которого нужно включить в реквизиты компании.
//                     Если не передан, будут включены реквизиты основного банковского счета.
// 
// Возвращаемое значение:
// см. НовыйРеквизитыКомпании() - коллекция общепринятых реквизитов компании.
//
Функция РеквизитыЮрФизЛица(ЮрФизЛицо, Период = '00010101', Знач БанковскийСчет = Неопределено)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Результат = НовыйРеквизитыЮрФизЛица();
	Результат.Ссылка = ЮрФизЛицо;
	
	СтандартнаяОбработка = Истина;
	ПриПолученииРеквизитовЮрФизЛица(Результат, ЮрФизЛицо, Период, БанковскийСчет, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		Буфер = Вычислить("УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(ЮрФизЛицо, Период,, БанковскийСчет)");
		ЗаполнитьЗначенияСвойств(Результат, Буфер);
				
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.НаименованиеДляПечатныхФорм) Тогда 
		Результат.НаименованиеДляПечатныхФорм = Результат.ПолноеНаименование;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор структуры дополнительных параметров процедуры ПрочитатьСведенияОбАдресахЮрФизЛица()
// 
// Возвращаемое значение:
//  Структура - содержит ключи:
//     * ПолучатьЮридическийАдрес	 - Булево - Истина, если требуется получить юридический адрес.
//     * ПолучатьФактическийАдрес	 - Булево - Истина, если требуется получить фактический адрес.
//     * АдресДоставки				 - Строка - строковое представление адреса. Если указано, 
//                                              будет выполнен поиск сведений о фактическом адресе
//                                              по переданному представлению.
//
Функция ПараметрыПолученияКонтактнойИнформацииЮрФизЛица()
	
	Результат = Новый Структура;
	Результат.Вставить("ПолучатьЮридическийАдрес", Истина);
	Результат.Вставить("ПолучатьФактическийАдрес", Истина);
	Результат.Вставить("АдресДоставки", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Дополняет реквизиты организации сведениями о контактной информации.
//
// Параметры:
//  РеквизитыОрганизации	 - Структура - см. функцию РеквизитыЮрФизЛица();
//  ДополнительныеПараметры	 - Структура - (Необязательный) параметры запроса контактной информации (см. ПараметрыПолученияКонтактнойИнформацииЮрФизЛица());
// 
Процедура ПрочитатьСведенияОбАдресахЮрФизЛица(РеквизитыОрганизации, ДополнительныеПараметры = Неопределено)
	
	ПараметрыЗапросаКИ = ПараметрыПолученияКонтактнойИнформацииЮрФизЛица();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда 
		ЗаполнитьЗначенияСвойств(ПараметрыЗапросаКИ, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ПараметрыЗапросаКИ.ПолучатьЮридическийАдрес
		И Не ЗначениеЗаполнено(РеквизитыОрганизации.ЮридическийАдресСтруктурой) Тогда
		МенеджерИнтеграции = МодульМенеджерИнтеграции();
		РеквизитыОрганизации.ЮридическийАдресСтруктурой = МенеджерИнтеграции.СведенияОбАдресе(РеквизитыОрганизации.Ссылка, Истина);
	КонецЕсли;
	
	Если ПараметрыЗапросаКИ.ПолучатьФактическийАдрес
		И Не ЗначениеЗаполнено(РеквизитыОрганизации.ФактическийАдресСтруктурой) Тогда
		МенеджерИнтеграции = МодульМенеджерИнтеграции();
		РеквизитыОрганизации.ФактическийАдресСтруктурой = МенеджерИнтеграции.СведенияОбАдресе(РеквизитыОрганизации.Ссылка, Ложь, ПараметрыЗапросаКИ.АдресДоставки);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структурированную информацию о договоре, соглашении или
// ином основании отгрузки/перехода прав собственности.
//
// Параметры:
//  Шапка - Структура - реквизиты шапки документа (см. ДанныеШапки)
// 
// Возвращаемое значение:
//  Неопределено - если не удалось получить реквизиты основания передачи.
//  Структура - содержит поля:
//     * Представление - Строка - представление основания (договора, соглашения);
//     * Номер - Строка - (необязательный) номер основания;
//     * Дата - Дата - (необязательный) дата основания;
//
Функция РеквизитыДоговора(Шапка)
	
	Результат = Новый Структура;
	Результат.Вставить("Представление");
	Результат.Вставить("Номер");
	Результат.Вставить("Дата");
	
	СтандартнаяОбработка = Истина;
	ПриПолученииРеквизитовДоговора(Результат, Шапка, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		Договор = Шапка.Договор;
		Если ЗначениеЗаполнено(Договор) Тогда 
			Результат.Представление = СокрЛП(Договор.Наименование);
			Результат.Номер = СокрЛП(Договор.Номер);
			Результат.Дата = Договор.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Представление) Тогда 
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор структуры дополнительных параметров процедуры ЗаполнитьИнформациюОбОрганизации()
// 
// Возвращаемое значение:
