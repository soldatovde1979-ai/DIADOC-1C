//
// Параметры:
//	ВерсияФормата	- Строка	- информация о версии XSD схемы, в соотвествии с которой сформирован документ
//	ДатаОтправки	- ДатаВремя	- дата и время отправки документа (в текущем часовом поясе)
//
// Возвращаемое значение:
//	Булево	- Истина, если формат документа устарел
Функция ЭтоУстаревшийФорматЭлектронногоДокумента(ВерсияФормата, ДатаОтправки = Неопределено) Экспорт
	
	Если ЭтоУПД_ВФормате155Приказа(ВерсияФормата) Тогда
		
		// с 01.01.2020 УПД в формате 155 приказа должен быть отправлен в формате 820 приказа
		Результат = НЕ ЗначениеЗаполнено(ДатаОтправки)
		ИЛИ ДатаОтправки >= ДатаПрекращенияДействияУПД155();
		
	ИначеЕсли ЭтоСФ_ВФормате93Приказа(ВерсияФормата) Тогда
		
		// с 01.07.2017 СФ в формате 93 приказа должен быть отправлен в формате УПД
		// с 14.04.2015 СФ в формате 93 приказа должен быть отправлен в версии 5.02
		Результат = НЕ ЗначениеЗаполнено(ДатаОтправки) 
		ИЛИ ДатаОтправки >= ДатаПрекращенияДействияСчетаФактуры93();
		
	Иначе
		Результат = Ложь;	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Признак того, что документ УПД в формате 155 приказа
//
// Параметры:
//	ВерсияФормата - Строка - версия вложения в терминах API (наример, utd820_05_01_01, tovtorg_05_01_04 и т.д.)
//
// Возвращаемое значение:
//	Булево - Истина, если документ УПД в формате 155 приказа
Функция ЭтоУПД_ВФормате155Приказа(ВерсияФормата) Экспорт
	
	БазовыеФорматы	= БазовыеФорматы();
	БазовыйФормат	= БазовыйФорматВерсииКонтента(ВерсияФормата);
	
	Результат = (БазовыйФормат = БазовыеФорматы.utd);
	
	Возврат Результат;
	
КонецФункции

// Признак того, что документ СФ в формате 93 приказа
//
// Параметры:
//	ВерсияФормата - Строка - версия вложения в терминах API (наример, utd820_05_01_01, tovtorg_05_01_04 и т.д.)
//
// Возвращаемое значение:
//	Булево - Истина, если документ СФ в формате 93 приказа
Функция ЭтоСФ_ВФормате93Приказа(ВерсияФормата) Экспорт
	
	БазовыеФорматы	= БазовыеФорматы();
	БазовыйФормат	= БазовыйФорматВерсииКонтента(ВерсияФормата);
	
	Результат = (	БазовыйФормат = БазовыеФорматы.invoice 
	Или БазовыйФормат = БазовыеФорматы.invoicecor	);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, установлены ли на текущий момент настройки по отправке документа в устаревшем формате
//
// Возвращаемое значение:
//	Булево	- Истина, если такие настройка установлены
Функция ЕстьНастройкаОтправкиВУстаревшемФормате() Экспорт
	
	Результат = Ложь;
	
	НастройкиОтправки = Модуль_Данные1С_СвязиОбъектов().НастройкиФорматаОтправкиПоОрганизациям();
	
	НастройкиОтправкиПоКонтрагентам = Модуль_Данные1С_СвязиОбъектов().НастройкиФорматаОтправкиПоКонтрагентам();
	Для каждого Элемент Из НастройкиОтправкиПоКонтрагентам Цикл
		НастройкиОтправки.Вставить(Элемент.Ключ, Элемент.Значение); 	
	КонецЦикла; 
	
	Для Каждого Элемент Из НастройкиОтправки Цикл
		
		КлючНастройки = Элемент.Значение;
		
		Если ЗначениеЗаполнено(КлючНастройки) И ЭтоНастройкаОтправкиВУстаревшемФормате(КлючНастройки) Тогда
			
			Результат = Истина;
			
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет содержит ли настройка возможность отправки документа в устаревшем формате
//
// Параметры:
//  КлючНастройки - Строка - значение настройки "ДиадокФормироватьУПД"
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка содержит возможность отправки докумета в устаревшем формате
//
Функция ЭтоНастройкаОтправкиВУстаревшемФормате(КлючНастройки) Экспорт
	
	Результат =		НастройкаВключаетОтправкуУКД189(КлючНастройки)
	ИЛИ НастройкаВключаетОтправкуУПД155(КлючНастройки)
	ИЛИ НастройкаВключаетОтправкуСчетаФактуры93(КлючНастройки);
	
	Возврат Результат;
	
КонецФункции

// Проверяет содержит ли настройка возможность отправки счета-фактуры 93@
//
// Параметры:
//  КлючНастройки - Строка - значение настройки "ДиадокФормироватьУПД"
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка содержит возможность отправки счета-фактуры 93@
//
Функция НастройкаВключаетОтправкуСчетаФактуры93(КлючНастройки)
	
	Результат = Ложь;
	
	Если 	КлючНастройки = "НЕТ"
		Или КлючНастройки = "ТОРГ12АКТ"
		Или КлючНастройки = "ДОП" Тогда
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет содержит ли настройка возможность отправки УПД 155@
//
// Параметры:
//  КлючНастройки - Строка - значение настройки "ДиадокФормироватьУПД"
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка содержит возможность отправки УПД 155@
//
Функция НастройкаВключаетОтправкуУПД155(КлючНастройки)
	
	Результат = Ложь;
	
	ЭтоНастройкаУПД155 = 	КлючНастройки = "СФ"
	Или КлючНастройки = "СЧФ"
	Или	КлючНастройки = "СЧФДОП"
	Или КлючНастройки = "СЧФ_ДОП"
	Или КлючНастройки = "СФТОРГ12АКТ";
	
	Если ЭтоНастройкаУПД155 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет содержит ли настройка возможность отправки УКД 189@
//
// Параметры:
//  КлючНастройки - Строка - значение настройки "ДиадокФормироватьУПД"
// 
// Возвращаемое значение:
//  Булево - Истина, если настройка содержит возможность отправки УКД 189@
//
Функция НастройкаВключаетОтправкуУКД189(КлючНастройки)
	
	Результат = Ложь;
	
	Если 	КлючНастройки = "СЧФДОП_820"
		Или КлючНастройки = "СЧФ_ДОП_820"
		Или КлючНастройки = "СФТОРГ12АКТ_820" Тогда
		
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьИдентификаторСервисаВзаиморасчеты(Идентификатор)
	
	Результат = Врег(Идентификатор) = "COACSU";	// отправлен из сервиса сверки
	
	Возврат Результат;
	
КонецФункции

// Признак того, что электронный документ(ЭД) это акт сверки, который был отправлен из сервиса Контур.Взаиморасчеты
//
// Параметры:
//	ИмяТипа				- Строка	- Имя типа электронного документа. См. метод "ФорматЭлектронногоДокумента"
//	CustomDocumentId	- Строка 	- Идентификатор документа, заданный внешней системой
//
// Возвращаемое значение:
// 	Булево - Истина, если ЭД это акт сверки, отправленный из сервиса Контур.Взаиморасчеты
Функция ЭтоАктСверкиИзСервисаВзаиморасчеты(ИмяТипа, CustomDocumentId) Экспорт
	
	Результат = ЭтоАктСверкиВзаиморасчетов(ИмяТипа)
	И ЕстьИдентификаторСервисаВзаиморасчеты(CustomDocumentId);
	
	Возврат Результат;
	
КонецФункции

// Признак того, что электронный документ(ЭД) является актом сверки взаиморасчетов
//
// Параметры:
//	ИмяТипа	- Строка	- Имя типа электронного документа. См. метод "ФорматЭлектронногоДокумента"
//
// Возвращаемое значение:
//	Булево - Истина, если ЭД является актом сверки
Функция ЭтоАктСверкиВзаиморасчетов(ИмяТипа)
	
	Результат = (ВРЕГ(ИмяТипа) = ВРЕГ("ReconciliationAct"));
	
	Возврат Результат;
	
КонецФункции


