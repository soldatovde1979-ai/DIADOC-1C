// Проверяет заполнение значений на всех уровнях структуры
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одно значение в структуре заполнено
Функция СтруктураКонтентаЗаполнена(СтруктураКонтента) Экспорт
	
	Результат = Ложь;
	
	Для каждого Элемент Из СтруктураКонтента Цикл
		
		Если ТипЗнч(Элемент.Значение) = Тип("Структура") Тогда 
			
			Результат = СтруктураКонтентаЗаполнена(Элемент.Значение);
			
		Иначе
			
			Результат = ЗначениеЗаполнено(Элемент.Значение) И Элемент.Значение <> Ложь;
			
		КонецЕсли;
		
		Если Результат = Истина Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

