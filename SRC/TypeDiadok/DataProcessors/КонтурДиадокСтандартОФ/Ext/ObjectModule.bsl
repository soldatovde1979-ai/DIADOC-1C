КонецФункции

Функция ДанныеЭлектронногоДокумента(ОбъектXDTO, ФорматЭД, Контрагент)
	
	ПротоСтруктура = ПротоСтруктураЭлектронногоДокумента(ОбъектXDTO);
	
	ФорматыЭД = МодульФорматыЭлектронныхДокументов();
	
	Если ФорматыЭД.ЭтоАктСверкиВзаиморасчетов(ФорматЭД) Тогда
		
		ТабличнаяЧастьПрото = ПротоСтруктура.ReconciliationAct.ReconciliationActTable;
		
		Шапка = ШапкаЭлектронногоДокумента405(ПротоСтруктура);
		ТабличнаяЧасть = ТабличнаяЧастьЭлектронногоДокумента405(ТабличнаяЧастьПрото);
		Итоги = ИтогиЭлектронногоДокумента405(ТабличнаяЧастьПрото);
		ЭтоАванс = Ложь;
		
	Иначе
		
		Шапка = ШапкаЭлектронногоДокумента(ПротоСтруктура);
		ТабличнаяЧасть = ТабличнаяЧастьЭлектронногоДокумента(ОбъектXDTO, Контрагент);
		Итоги = ИтогиЭлектронногоДокумента(ПротоСтруктура);
		ЭтоАванс = ЭтоЭлектронныйСчетФактураНаАванс(ТабличнаяЧасть);
		
	КонецЕсли;
	
	ИтогиУменьшение = ИтогиУменьшениеЭлектронногоДокумента(ПротоСтруктура);
	ИтогиУвеличение = ИтогиУвеличениеЭлектронногоДокумента(ПротоСтруктура);
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка",				Шапка);
	Результат.Вставить("ТабличнаяЧасть",	ТабличнаяЧасть);
	Результат.Вставить("Формат",			ФорматЭД);
	Результат.Вставить("Итоги",				Итоги);
	Результат.Вставить("ИтогиУменьшение",	ИтогиУменьшение);
	Результат.Вставить("ИтогиУвеличение",	ИтогиУвеличение);
	Результат.Вставить("ЭтоАванс",			ЭтоАванс);
	
	Возврат Результат;
	
КонецФункции

Функция НовыйРеквизитыШапкиЭлектронногоДокумента()
	
	Результат = Новый Структура;
	Результат.Вставить("Дата");
	Результат.Вставить("Номер");
	Результат.Вставить("ДатаИсправления");
	Результат.Вставить("НомерИсправления");
	Результат.Вставить("РеквизитыОснования");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРеквизитыОснования(ШапкаЭД, Прото)
	
	Перем Invoices;
	
	Если Не Прото.Свойство("Invoices", Invoices) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОснования = Новый Массив;
	
	Для Каждого Invoice Из Invoices Цикл
		
		Основание = Новый Структура;
		Основание.Вставить("Дата", Invoice.InvoiceDate);
		Основание.Вставить("Номер", Invoice.InvoiceNumber);
		
		РеквизитыОснования.Добавить(Основание);
		
	КонецЦикла;
	
	ШапкаЭД.РеквизитыОснования = РеквизитыОснования;
	
КонецПроцедуры

Функция НовыйИтогиТабличнойЧасти()
	
	Результат = Новый Структура;
	Результат.Вставить("Количество");
	Результат.Вставить("СуммаВсего");
	Результат.Вставить("СуммаБезНДС");
	Результат.Вставить("СуммаНДС");
	
	Возврат Результат;
	
КонецФункции

Функция ШапкаЭлектронногоДокумента(Прото)

	Если Прото.Свойство("DocumentDate") Тогда
		ДатаДокумента = Прото.DocumentDate;
	ИначеЕсли Прото.Свойство("Date") Тогда
		ДатаДокумента = Прото.Date;
	Иначе
		ДатаДокумента = Неопределено;
	КонецЕсли;
	
	Если Прото.Свойство("DocumentNumber") Тогда
		НомерДокумента = Прото.DocumentNumber;
	ИначеЕсли Прото.Свойство("Number") Тогда
		НомерДокумента = Прото.Number;
	Иначе
		НомерДокумента = Неопределено;
	КонецЕсли;
	
	ДатаИсправления = Неопределено;
	Если Прото.Свойство("RevisionDate") Тогда
		ДатаИсправления = Прото.RevisionDate;
	КонецЕсли;
	
	НомерИсправления = Неопределено;
	Если Прото.Свойство("RevisionNumber") Тогда
		НомерИсправления = Прото.RevisionNumber;
	КонецЕсли;
	
	Результат = НовыйРеквизитыШапкиЭлектронногоДокумента();
	Результат.Дата = ДатаДокумента;
	Результат.Номер = НомерДокумента;
	Результат.ДатаИсправления = ДатаИсправления;
	Результат.НомерИсправления = НомерИсправления;
	
	ЗаполнитьРеквизитыОснования(Результат, Прото);
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧастьЭлектронногоДокумента(ОбъектXDTO, Контрагент)
	
	ГенерацияXML = МодульГенерацияXML();
	
	Результат = ГенерацияXML.ЭДО_ПолучитьТабличнуюЧастьИзКонтентаXML(ОбъектXDTO);
	
	ЗаполнитьНоменклатуруИнформационнойБазы(Результат, Контрагент);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьНоменклатуруИнформационнойБазы(ТабличнаяЧасть, Контрагент)
	
	ТабличнаяЧасть.Колонки.Добавить("НоменклатураИнформационнойБазы");
	
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		
		СопоставлениеНоменклатуры = ПрочитатьСопоставлениеНоменклатуры(Контрагент, Строка.ИдентификаторНоменклатуры);
		
		НоменклатураИБ = СопоставлениеНоменклатуры.Получить(Строка.ИдентификаторНоменклатуры);
		
		Строка.НоменклатураИнформационнойБазы = НоменклатураИБ;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИтогиЭлектронногоДокумента(Прото)

	Количество	= 0;
	СуммаВсего	= 0;
	СуммаБезНДС	= 0;
	СуммаНДС	= 0;
	
	Если Прото.Свойство("Table") Тогда
		ИтогоПоДокументу = Прото.Table;
		
		Если ИтогоПоДокументу.Свойство("TotalNet") Тогда
			Количество = ИтогоПоДокументу.TotalNet;
		КонецЕсли;
		
		Если ИтогоПоДокументу.Свойство("Total") Тогда
			СуммаВсего = ИтогоПоДокументу.Total;
		КонецЕсли;
		
		Если ИтогоПоДокументу.Свойство("TotalWithVatExcluded") Тогда
			СуммаБезНДС = ИтогоПоДокументу.TotalWithVatExcluded;
		КонецЕсли;
		
		Если ИтогоПоДокументу.Свойство("Vat") Тогда
			СуммаНДС = ИтогоПоДокументу.Vat;
		КонецЕсли;
	КонецЕсли;
		
	Результат = НовыйИтогиТабличнойЧасти();
	Результат.Количество	= Количество;
	Результат.СуммаВсего	= СуммаВсего;
	Результат.СуммаБезНДС	= СуммаБезНДС;
	Результат.СуммаНДС		= СуммаНДС;
	
	Возврат Результат;

КонецФункции

