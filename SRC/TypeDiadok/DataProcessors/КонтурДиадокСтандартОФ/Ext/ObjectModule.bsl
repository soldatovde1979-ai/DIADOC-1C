// Инициализирует структуру ProformaInvoiceSellerContent.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//     * DocumentDate - Дата - Дата составления счета на оплату;
//     * DocumentNumber - Строка - Номер счета на оплату;
//     * Seller - Структура - Сведения о продавце, БанкРекв обязательны для СвПрод (см. Новый_ExtendedOrganizationInfo());
//     * Buyer - Структура - Сведения о покупателе (см. Новый_ExtendedOrganizationInfo());
//     * Recipient - Структура - (Необязательный) Сведения о получателе платежа (см. Новый_ExtendedOrganizationInfo());
//     * Payer - Структура - (Необязательный) Сведения о плательщике (см. Новый_ExtendedOrganizationInfo());
//     * Contract - Структура - (Необязательный) Договор (см. Новый_ContractInfo());
//     * Currency - Строка - (Необязательный) Код валюты по Общероссийскому классификатору валют;
//     * CurrencyRate - Число - (Необязательный) Курс валюты;
//     * GovernmentContractInfo - Строка - (Необязательный) Идентификатор государственного контракта;
//     * PaymentPurpose - Строка - (Необязательный) Назначение платежа;
//     * Signer - Структура - Сведения о лице, подписывающем файл счета на оплату в электронной форме (см. Новый_Signer());
//     * ProformaInvoiceTable - Структура - Сведения об отгруженных товарах (о выполненных работах, оказанных услугах), переданных имущественных правах (см. Новый_ProformaInvoiceTable());
//     * PersonalAccountInfo - Массив - Сведения по изменению лицевого счета;
//     * AdditionalInfo - Массив - Дополнительные сведения к документу, содержит структуры StructedAdditionalInfo (см. Новый_StructedAdditionalInfo());
//
Функция Новый_ProformaInvoiceSellerContent(ПолноеИмя = "", Конструкторы = Неопределено) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("DocumentDate");
	Результат.Вставить("DocumentNumber");
	Результат.Вставить("Seller");
	Результат.Вставить("Buyer");
	Результат.Вставить("Recipient");
	Результат.Вставить("Payer");
	Результат.Вставить("Contract");
	Результат.Вставить("Currency");
	Результат.Вставить("CurrencyRate");
	Результат.Вставить("GovernmentContractInfo");
	Результат.Вставить("PaymentPurpose");
	Результат.Вставить("Signer");
	Результат.Вставить("ProformaInvoiceTable");
	Результат.Вставить("PersonalAccountInfo");
	Результат.Вставить("StructedAdditionalInfos");
	
	// Участники сделки
	Результат.Seller	 = НовыйЭлементContent("Seller"		, "Новый_ExtendedOrganizationInfo"	, Конструкторы, ПолноеИмя);
	Результат.Buyer		 = НовыйЭлементContent("Buyer"		, "Новый_ExtendedOrganizationInfo"	, Конструкторы, ПолноеИмя);
	Результат.Recipient	 = НовыйЭлементContent("Recipient"	, "Новый_ExtendedOrganizationInfo"	, Конструкторы, ПолноеИмя);
	Результат.Payer		 = НовыйЭлементContent("Payer"		, "Новый_ExtendedOrganizationInfo"	, Конструкторы, ПолноеИмя);
	
	// Договор, соглашение
	Результат.Contract = НовыйЭлементContent("Contract", "Новый_ContractInfo", Конструкторы, ПолноеИмя);
	
	// Подписант
	Результат.Signer = НовыйЭлементContent("Signer", "Новый_Signer", Конструкторы, ПолноеИмя);
	
	// Табличная часть
	Результат.ProformaInvoiceTable = НовыйЭлементContent("ProformaInvoiceTable", "Новый_ProformaInvoiceTable", Конструкторы, ПолноеИмя);
	
	// Сведения о лицевых счетах
	Результат.PersonalAccountInfo = НовыйЭлементContent("PersonalAccountInfo", "Новый_StructedAdditionalInfos", Конструкторы, ПолноеИмя); // Как и StructuredAdditionalInfos представляет собой массив структур с ключами "Key" и "Value"
	
	// Дополнительная информация
	Результат.StructedAdditionalInfos = НовыйЭлементContent("StructedAdditionalInfos", "Новый_StructedAdditionalInfos", Конструкторы, ПолноеИмя);
	
	ИнициализироватьСлужебныеПоляПрото(Результат);
	
	Возврат Результат;
	
КонецФункции

// Инициализирует коллекцию строк табличной части объекта ProformaInvoiceSellerContent.
//
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//     * Product - Строка - Наименование товара (описание выполненных работ, оказанных услуг), имущественных прав;
//     * Unit - Строка - Код единицы измерения по Общероссийскому классификатору единиц измерения или «0000» (при отсутствии необходимой единицы измерения в ОКЕИ). 
//                       В случае указания значения 0000 наименование единицы измерения определяется пользователем;
//     * UnitName - Строка - (Необязательный) Наименование единицы измерения;
//     * Quantity - Число - (Необязательный) Количество (объем);
//     * Price - Число - (Необязательный) Цена (тариф) за единицу измерения;
//     * SubtotalWithVatExcluded - Число - (Необязательный) Стоимость товаров (работ, услуг), имущественных прав без налога - всего;
//     * TaxRate - Строка - Налоговая ставка;
//     * Excise - Строка - (Необязательный) Сумма акциза;
//     * Vat - Число - (Необязательный) Сумма налога, предъявляемая покупателю;
//     * Subtotal - Число - Стоимость товаров (работ, услуг), имущественных прав с налогом - всего;
//     * StructedAdditionalInfos - Массив - Дополнительные сведения к строке документа, содержит структуры StructedAdditionalInfo (см. Новый_StructedAdditionalInfo());
//
Функция Новый_ProformaInvoiceItems(ПолноеИмя = "", Конструкторы = Неопределено)
	
	ДобавитьКонструктор("StructedAdditionalInfos", "Новый_StructedAdditionalInfos", Конструкторы, ПолноеИмя);
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить("Product");
	ИменаКолонок.Добавить("Unit");
	ИменаКолонок.Добавить("UnitName");
	ИменаКолонок.Добавить("Quantity");
	ИменаКолонок.Добавить("Price");
	ИменаКолонок.Добавить("SubtotalWithVatExcluded");
	ИменаКолонок.Добавить("TaxRate");
	ИменаКолонок.Добавить("Excise");
	ИменаКолонок.Добавить("Vat");
	ИменаКолонок.Добавить("Subtotal");
	ИменаКолонок.Добавить("StructedAdditionalInfos");
	ИменаКолонок.Добавить(ИмяСвойстваСлужебнаяИнформация());
	
	ИменаКолонокСтрокой = Преобразование_МассивВСтроку(ИменаКолонок, ", ", Истина);
	
	Возврат НоваяТаблицаЗначений(ИменаКолонокСтрокой);
	
КонецФункции

// Инициализирует табличную часть объекта ProformaInvoiceSellerContent.
//
// Возвращаемое значение:
//  Структура содержит ключи:
//     * Items - Массив - содержит структуры ProformaInvoiceItem (см. Новый_ProformaInvoiceItem)
