	ПараметрыПМ.Данные		 = СтруктураДокумента;
	ПараметрыПМ.ДопСведения	 = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ПараметрыПМ.ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияКонтента", ПараметрыПМ);
	
	Возврат Результат;
	
КонецФункции

// Формирует и заполняет структуру InvoiceContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ДополнительныеПараметры - Структура, Неопределено - см. функцию ДополнительныеПараметрыПолученияКонтента();
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентСчетаФактуры93(СсылкаНаДокумент, ДополнительныеПараметры = Неопределено)
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	Результат = Новый_InvoiceContent();
	СтруктураДокумента = ДанныеДляФормированияСчетФактуры(СсылкаНаДокумент, Ложь);
	ЗаполнитьКонтентСчетаФактуры93(Результат, СтруктураДокумента, ПараметрыФормирования);
	
	Если ЗначениеЗаполнено(Результат.InvoiceRevisionNumber) Тогда
		ТипДокумента = "InvoiceRevision"; 
	Иначе
		ТипДокумента = "Invoice";
	КонецЕсли;
	
	ПараметрыПМ = ПараметрыЗаполненияКонтентаДляПМ(Результат, ТипыКонтента().InvoiceContent, СсылкаНаДокумент);
	ПараметрыПМ.DocumentType = ТипДокумента;
	ПараметрыПМ.Данные		 = СтруктураДокумента;
	ПараметрыПМ.ДопСведения	 = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ПараметрыПМ.ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияКонтента", ПараметрыПМ);
	
	Возврат Результат;
	
КонецФункции

// Формирует и заполняет структуру InvoiceCorrectionContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ДополнительныеПараметры - Структура, Неопределено - см. функцию ДополнительныеПараметрыПолученияКонтента();
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентКорректировочногоСчетаФактуры93(СсылкаНаДокумент, ДополнительныеПараметры = Неопределено)
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	Результат = Новый_InvoiceCorrectionContent();
	СтруктураДокумента = ДанныеДляФормированияСчетФактуры(СсылкаНаДокумент, Истина);
	ЗаполнитьКонтентКорректировочногоСчетаФактуры93(Результат, СтруктураДокумента, ПараметрыФормирования);
	
	ПараметрыПМ = ПараметрыЗаполненияКонтентаДляПМ(Результат, ТипыКонтента().InvoiceCorrectionContent, СсылкаНаДокумент);
	ПараметрыПМ.DocumentType = "InvoiceCorrection";
	ПараметрыПМ.Данные		 = СтруктураДокумента;
	ПараметрыПМ.ДопСведения	 = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ПараметрыПМ.ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияКонтента", ПараметрыПМ);
	
	Возврат Результат;
	
КонецФункции

// Формирует и заполняет структуру ProformaInvoiceSellerContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ДополнительныеПараметры - Структура, Неопределено - см. функцию ДополнительныеПараметрыПолученияКонтента();
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентФормализованногоСчета(СсылкаНаДокумент, ДополнительныеПараметры = Неопределено)
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	Результат = Новый_ProformaInvoiceSellerContent();
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("Шапка", ДанныеШапки(СсылкаНаДокумент, Перечисление_ВидыЭД().СчетНаОплату));
	СтруктураДокумента.Вставить("ДанныеТЧ", ДанныеТабличныхЧастей(СтруктураДокумента.Шапка));
	
	ЗаполнитьКонтентФормализованногоСчета(Результат, СтруктураДокумента, ПараметрыФормирования);
	
	Возврат Результат;
	
КонецФункции

