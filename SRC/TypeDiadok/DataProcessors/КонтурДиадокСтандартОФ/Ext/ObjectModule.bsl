// Универсальный метод для получения сведений по шапке документов.
// Состав полей и их значений может быть переопределен в интеграционном модуле 
// конфигурации или в подключаемом модуле с помощью событий:
//  - ПриПодготовкеЗапросаПоШапкеДокумента
//  - ПослеПолученияДанныхШапкиДокумента
//
// Параметры:
//  Ссылка - ДокументСсылка - документ, данные шапки которого нужно получить.
// 
// Возвращаемое значение:
//  Структура - реквизиты шапки документа:
//    * Ссылка							 - ДокументСсылка	 - ссылка на документ.
//    * Проведен						 - Булево			 - Истина, если документ проведен.
//    * Дата							 - Дата				 - дата документа.
//    * Номер							 - Строка			 - номер документа.
//    * НомерНаПечать					 - Строка			 - номер документа для вывода на печать (без префиксов и лидирующих нолей).
//    * ИмяМетаданных					 - Строка			 - имя вида документа.
//    * Представление					 - Строка			 - см. функцию ПредставлениеДокумента.
//    * ХозяйственнаяОперация			 - Ссылка			 - элемент перечисления или справочника "ХозяйственныеОперации"
//    * ВидОперации						 - Ссылка			 - вид операции документа.
//    * СуммаДокумента					 - Число			 - сумма документа с НДС.
//    * ЦенаВключаетНДС					 - Булево			 - Истина, если цены указаны с учетом НДС.
//    * ВалютаДокумента					 - СправочникСсылка	 - валюта документа.
//    * ВалютаДокументаКод				 - Строка			 - код валюты документа.
//    * КурсДокумента					 - Число			 - курс валюты документа.
//    * КратностьДокумента				 - Число			 - кратность валюты документа.
//    * РасчетыВУсловныхЕдиницах		 - Булево			 - Истина, если расчеты ведутся в условных единицах.
//    * ИдентификаторГосКонтракта		 - Строка			 - Идентификатор государственного контракта, договора (соглашения)
//    * Организация						 - СправочникСсылка	 - организация документа.
//    * БанковскийСчетОрганизации		 - СправочникСсылка	 - банковский счет организации документа.
//    * ЦифровойИндексОбособленногоПодразделения - Строка, Число - цифровой индекс обособленного подразделения.
//    * Грузоотправитель				 - СправочникСсылка	 - грузоотправитель.
//    * БанковскийСчетГрузоотправителя	 - СправочникСсылка	 - банковский счет грузоотправителя.
//    * Контрагент						 - СправочникСсылка	 - контрагент документа.
//    * БанковскийСчетКонтрагента		 - СправочникСсылка	 - банковский счет контрагента.
//    * Грузополучатель					 - СправочникСсылка	 - грузополучатель.
//    * БанковскийСчетГрузополучателя	 - СправочникСсылка	 - банковский счет грузополучателя.
//    * АдресДоставки					 - Строка			 - адрес доставки груза.
//
Функция ДанныеШапки(СсылкаНаОбъект, ВидЭД = Неопределено)
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда 
		
		ОписаниеОш = НСтр("ru = 'Не заполнено значение первого параметра <Ссылка>!'");
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	МетаданныеДокумента = СсылкаНаОбъект.Метаданные();
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Проведен");
	Реквизиты.Вставить("Дата");
	Реквизиты.Вставить("Номер");
	Реквизиты.Вставить("Организация");
	Реквизиты.Вставить("БанковскийСчетОрганизации");
	Реквизиты.Вставить("Контрагент");
	Реквизиты.Вставить("БанковскийСчетКонтрагента");
	Реквизиты.Вставить("Грузоотправитель");
	Реквизиты.Вставить("БанковскийСчетГрузоотправителя");
	Реквизиты.Вставить("Грузополучатель");
	Реквизиты.Вставить("БанковскийСчетГрузополучателя");
	Реквизиты.Вставить("ИдентификаторГосКонтракта");
	Реквизиты.Вставить("Договор");
	Реквизиты.Вставить("РасчетыВУсловныхЕдиницах");
	Реквизиты.Вставить("ВалютаДокумента");
	Реквизиты.Вставить("ВалютаДокументаКод");
	Реквизиты.Вставить("КурсДокумента");
	Реквизиты.Вставить("КратностьДокумента");
	Реквизиты.Вставить("ЦенаВключаетНДС");
	Реквизиты.Вставить("СуммаДокумента");
	
	Реквизиты.Вставить("АдресДоставки");
	Реквизиты.Вставить("СведенияОТранспортировкеИГрузе");
	
	Реквизиты.Вставить("ОбособленноеПодразделение");
	Реквизиты.Вставить("ЦифровойИндексОбособленногоПодразделения", "0");
	
	// Вызовем обработчик события, переопределенный в модуле интеграции
	ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеДокумента, ВидЭД);
	
	// Проверим существование всех необходимых реквизитов и заполним
	// выражения для полей с зарезервированными именами (ИмяПоляСсылка, ИмяПоляПредставление и т.д.)
	ЗаполнитьВыраженияПолейЗапроса(Реквизиты, МетаданныеДокумента);
	
	// Сформируем и выполним запрос по реквизитам
	Шапка = ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, Реквизиты);
	
	// Дополним итоговую структуру вспомогательными данными
	Шапка.Вставить("Ссылка"			, СсылкаНаОбъект);
	Шапка.Вставить("ВидЭД"			, ВидЭД);
	Шапка.Вставить("НомерНаПечать"	, НомерНаПечать(Шапка));
	Шапка.Вставить("ИмяМетаданных"	, МетаданныеДокумента.Имя);
	Шапка.Вставить("Представление"	, ПредставлениеДокумента(Шапка));
	
	// Вызовем обработчик события, переопределенный в модуле интеграции
	ПослеПолученияДанныхШапкиДокумента(Шапка);
	
	Возврат Шапка;
	
КонецФункции

// Универсальный метод для получения товарной части документа.
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит информацию о товарной части документа:
//     * ИмяТабличнойЧасти - Строка, Неопределено - имя табличной части документа;
//     * НомерСтроки - Число - номер строки документа;
//     * Номенклатура - СправочникСсылка - номенклатура документа;
//     * НоменклатураПредставление - Строка - представление номенклатуры;
//     * НоменклатураКод - Строка - код или артикул номенклатуры;
//     * ЭтоУслуга - Булево - Истина, если номенклатура является услугой;
//     * ПризнакТоварРаботаУслуга - Строка - тип номенклатуры в терминах сервиса {NotSpecified, Property, Job, Service, PropertyRights, Other};
//     * Характеристика - СправочникСсылка, Неопределено - характеристика номенклатуры;
//     * Серия - СправочникСсылка, Неопределено - серия номенклатуры;
//     * Упаковка - СправочникСсылка - упаковка (единица измерения) номенклатуры;
//     * ЕдиницаИзмерения - СправочникСсылка - единица измерения номенклатуры;
//     * ЕдиницаИзмеренияКод - Строка - код единицы измерения по ОКЕИ;
//     * ВидУпаковки - СправочникСсылка, Неопределено - (устарел, удалить);
//     * СтранаПроисхождения - СправочникСсылка, Неопределено - страна происхождения;
//     * СтранаПроисхожденияКод - Строка - код страны происхождения по ОКСМ;
//     * НомерГТД - СправочникСсылка, Неопределено - номер ГТД;
//     * КодТНВЭД - СправочникСсылка, Неопределено - код ТН ВЭД;
//     * СтавкаНДС - ПеречислениеСсылка, СправочникСсылка - ставка НДС;
//     * СтавкаНДСПредставление - Строка - представление ставки НДС (см. ПредставлениеСтавкиНДС);
//     * Количество - Число - количество упаковок;
//     * КоличествоВОдномМесте - Число - коэффициент упаковки;
//     * Цена - Число - цена за упаковку (без НДС и скидок/наценок);
//     * Сумма - Число - сумма без НДС;
//     * СуммаНДС - Число - сумма налога;
//     * СуммаСНДС - Число - сумма с учетом НДС;
//     * Масса - Число, Неопределено - масса;
//     * МассаНетто - Число, Неопределено - масса (нетто);
//
Функция ДанныеТабличныхЧастей(Шапка) 
	
	Если Не ЗначениеЗаполнено(Шапка) Тогда 
		
		ОписаниеОш = НСтр("ru = 'Не заполнено значение первого параметра <Данные шапки документа>!'");
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	ОписаниеСтрокиТЧ = НоваяСтрокаТоварнойЧасти();
	Результат = Новый ТаблицаЗначений;
	
	Для Каждого Элемент Из ОписаниеСтрокиТЧ Цикл 
		Результат.Колонки.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	СчетФактура	 = Неопределено;
	ЭтоКСФ		 = Ложь;
	ЭтоУКД_Дис	 = Ложь;
	
	ПромежуточныйРезультат = ТЧПолучитьДанныеЗапроса(Шапка.Ссылка, СчетФактура, ЭтоКСФ, ЭтоУКД_Дис);
	
	Счетчик = 0;
	
	Для Каждого СтрокаИсточник Из ПромежуточныйРезультат Цикл 
		
		Счетчик = Счетчик + 1;
		
		СтрокаПриемник = Результат.Добавить();
		СтрокаПриемник.НомерСтроки = Счетчик;
		СтрокаПриемник.ИмяТабличнойЧасти = "Неопределено";
		
		СтрокаПриемник.Номенклатура = СтрокаИсточник.НоменклатураСсылка;
		СтрокаПриемник.НоменклатураКод = СтрокаИсточник.КодНоменклатуры;
		СтрокаПриемник.НоменклатураПредставление = СтрокаИсточник.Номенклатура;
		
		СтрокаПриемник.ЕдиницаИзмерения		 = СтрокаИсточник.ЕдиницаИзмерения;
		СтрокаПриемник.ЕдиницаИзмеренияКод	 = СтрокаИсточник.КодЕдиницыИзмерения;
		
		Если ЗначениеЗаполнено(СтрокаИсточник.Характеристика) Тогда 
			СтрокаПриемник.Характеристика = СтрокаИсточник.Характеристика;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаИсточник.Серия) Тогда 
			СтрокаПриемник.Серия = СтрокаИсточник.Серия;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаИсточник.ВидУпаковки) Тогда 
			СтрокаПриемник.ВидУпаковки = СтрокаИсточник.ВидУпаковки;
		КонецЕсли;
		
		СтрокаПриемник.ЭтоУслуга = СтрокаИсточник.ЭтоУслуга;
		СтрокаПриемник.ПризнакТоварРаботаУслуга = ?(СтрокаПриемник.ЭтоУслуга, "Service", "Property");
		
		СтрокаПриемник.СтавкаНДС = СтрокаИсточник.СтавкаНДС;
		СтрокаПриемник.СтавкаНДСПредставление = Модуль_Интеграция.ПолучитьПредставлениеСтавкиНДС(СтрокаПриемник.СтавкаНДС, Истина);
		
		Если ЗначениеЗаполнено(СтрокаИсточник.НомерГТД) Тогда 
			СтрокаПриемник.НомерГТД = СтрокаИсточник.НомерГТД;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПриемник.СтранаПроисхождения) Тогда 
			СтрокаПриемник.СтранаПроисхождения		 = СтрокаИсточник.СтранаПроисхождения;
			СтрокаПриемник.СтранаПроисхожденияКод	 = СтрокаПриемник.СтранаПроисхождения.Код;
		КонецЕсли;
		
		СтрокаПриемник.Количество = СтрокаИсточник.Количество;
		СтрокаПриемник.КоличествоВОдномМесте = СтрокаИсточник.КоличествоВОдномМесте;
		СтрокаПриемник.КоличествоМест = СтрокаИсточник.КоличествоМест;
		СтрокаПриемник.Масса = СтрокаИсточник.Масса;
		
		СтрокаПриемник.СуммаНДС = СтрокаИсточник.СуммаНДС;
		Если Шапка.ЦенаВключаетНДС = Неопределено ИЛИ Шапка.ЦенаВключаетНДС Тогда 
			СтрокаПриемник.СуммаСНДС = СтрокаИсточник.Сумма;
			СтрокаПриемник.Цена		 = СтрокаПриемник.СуммаСНДС / ?(ЗначениеЗаполнено(СтрокаПриемник.Количество), СтрокаПриемник.Количество, 1);
		Иначе
			СтрокаПриемник.СуммаСНДС = СтрокаИсточник.Сумма + СтрокаИсточник.СуммаНДС;
			СтрокаПриемник.Цена		 = СтрокаИсточник.Цена;
		КонецЕсли;
		СтрокаПриемник.Сумма = СтрокаПриемник.СуммаСНДС - СтрокаПриемник.СуммаНДС;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает номер документа для вывода на печать; из номера удаляются префиксы и лидирующие нули.
//
// Параметры:
//  СсылкаИлиСтруктура - ДокументСсылка	 - документ, номер которого нужно получить.
//                     - Структура		 - структура с ключом "Номер".
// 
// Возвращаемое значение:
//  Строка - Номер на печать.
//
Функция НомерНаПечать(СсылкаИлиСтруктура)
	
	СсылкаНаОбъект = Неопределено;
	Если ТипЗнч(СсылкаИлиСтруктура) = Тип("Структура") Тогда 
		СсылкаНаОбъект = СсылкаИлиСтруктура.Ссылка;
	Иначе
		СсылкаНаОбъект = СсылкаИлиСтруктура;
	КонецЕсли;
	
	НомерОбъекта = Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(СсылкаНаОбъект);
	
	Возврат НомерОбъекта;
	
КонецФункции

// Возвращает пользовательское представление документа для отображения в интерфейсе и сообщениях.
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки
// 
// Возвращаемое значение:
//  Строка - представление документа в виде "<Представление вида документа> <Номер> от <Дата> (<Операция>)".
//
Функция ПредставлениеДокумента(Шапка)
	
	Результат = НСтр("ru = '%1 %2 от %3'");
	Результат = СтрЗаменить(Результат, "%1", Шапка.Ссылка.Метаданные().Представление());
	Результат = СтрЗаменить(Результат, "%2", Шапка.НомерНаПечать);
	Результат = СтрЗаменить(Результат, "%3", Формат(Шапка.Дата, "ДЛФ=D"));
	
	Возврат Результат;
	
КонецФункции

Функция НоваяСтрокаТоварнойЧасти()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИмяТабличнойЧасти");
	Результат.Вставить("НомерСтроки");
	
	Результат.Вставить("НоменклатураПредставление");
	
	Результат.Вставить("Номенклатура");
	Результат.Вставить("НоменклатураКод");
	Результат.Вставить("Характеристика");
	Результат.Вставить("Серия");
	
	Результат.Вставить("ЕдиницаИзмерения");
	Результат.Вставить("ЕдиницаИзмеренияКод");
	Результат.Вставить("ВидУпаковки");
	
	Результат.Вставить("ЭтоУслуга");
	Результат.Вставить("ПризнакТоварРаботаУслуга");
	
	Результат.Вставить("СтранаПроисхождения");
	Результат.Вставить("СтранаПроисхожденияКод");
	
	Результат.Вставить("НомерГТД");
	Результат.Вставить("КодТНВЭД");
	
	Результат.Вставить("СтавкаНДС");
	Результат.Вставить("СтавкаНДСПредставление");
	
	Результат.Вставить("Количество");
	Результат.Вставить("КоличествоВОдномМесте");
	Результат.Вставить("КоличествоМест");
	Результат.Вставить("Цена");
	Результат.Вставить("Сумма");
	Результат.Вставить("СуммаНДС");
	Результат.Вставить("СуммаСНДС");
	Результат.Вставить("Масса");
	Результат.Вставить("МассаНетто");
	
	Результат.Вставить("СтранаПроисхожденияДоИзменения");
	Результат.Вставить("СтранаПроисхожденияДоИзмененияКод");
	
	Результат.Вставить("ЕдиницаИзмеренияДоИзменения");
	Результат.Вставить("ЕдиницаИзмеренияДоИзмененияКод");
	
	Результат.Вставить("НомерГТДДоИзменения");
	Результат.Вставить("КодТНВЭДДоИзменения");
	Результат.Вставить("СтавкаНДСДоИзменения");
	Результат.Вставить("СтавкаНДСДоИзмененияПредставление");
	
	Результат.Вставить("КоличествоДоИзменения");
	Результат.Вставить("ЦенаДоИзменения");
	Результат.Вставить("СуммаДоИзменения");
	Результат.Вставить("СуммаНДСДоИзменения");
	Результат.Вставить("СуммаСНДСДоИзменения");
	
	Результат.Вставить("НомерГТДПредставление");
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что переданный параметр может использоваться в качестве ключа структуры:
// ключ может быть только строковым и должен удовлетворять требованиям, 
// предъявляемым к именованию переменных встроенного языка.
//
// Параметры:
//  ПроверяемоеЗначение - Произвольный - Произвольное значение.
// 
// Возвращаемое значение:
//  Булево - Истина, если проверяемое значение может использоваться в качестве ключа структуры.
//
Функция СтрокаСоответствуетТребованиямККлючуСтруктуры(ПроверяемоеЗначение)
	
	Результат = Ложь;
	
	Если Ложь
		Или ПроверяемоеЗначение = "НЕОПРЕДЕЛЕНО"
		Или ПроверяемоеЗначение = "ИСТИНА"
		Или ПроверяемоеЗначение = "ЛОЖЬ" Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ТипЗнч(ПроверяемоеЗначение) = Тип("Строка") И ПроверяемоеЗначение = СокрЛП(ПроверяемоеЗначение) Тогда
		
		Попытка
			НоваяСтруктура = Новый Структура(ПроверяемоеЗначение);
			Результат = (НоваяСтруктура.Количество() = 1);
		Исключение КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет существование реквизитов, значения которых нужно получить.
// Если требуемый реквизит отсутствует, то выражение для получения его значения
// заменяется на "НЕОПРЕДЕЛЕНО".
// Выражения для получения значений и представлений реквизитов ссылочных типов
// автоматически заменяются на "<ИмяРеквизита>" и "ПРЕДСТАВЛЕНИЕ(<ИмяРеквизита>)".
//
// Параметры:
//  Реквизиты			 - Структура - в качестве ключа передается псевдоним поля для возвращаемой структуры с результатом, 
//                                     а в качестве значения (опционально) фактическое имя поля в таблице или произвольное выражение.
//                                     Если ключ задан, а значение не определено, то имя поля берется из ключа.
//  МетаданныеИсточника	 - ОбъектМетаданных - Метаданные документа или его табличной части.
//
Процедура ЗаполнитьВыраженияПолейЗапроса(Реквизиты, МетаданныеИсточника)
	
	Для Каждого ОписаниеРеквизита Из Реквизиты Цикл 
		
		Псевдоним = ОписаниеРеквизита.Ключ;
		Выражение = ОписаниеРеквизита.Значение;
		
		Если Не ЗначениеЗаполнено(Выражение) Тогда 
			Выражение = Псевдоним;
		КонецЕсли;
		
		Если Не СтрокаСоответствуетТребованиямККлючуСтруктуры(Выражение) Тогда 
			// Значит, это не имя реквизита, а сложное выражение или поле, получаемое через точку.
			// Такие выражения обрабатывать не будем, а в случае ошибки выполнение запроса выпадет в исключение.
			Продолжить;
		КонецЕсли;
		
		// Будем искать реквизит, для которого строится выражение поля запроса.
		// Если такой реквизит не найдется, запишем в выражение поля запроса "НЕОПРЕДЕЛЕНО".
		РеквизитНайден = Ложь;
		
		Если ЕстьРеквизитМетаданных(МетаданныеИсточника, Выражение, Истина) Тогда
			
			РеквизитНайден = Истина;
			Реквизиты.Вставить(Псевдоним, Выражение);
			
		Иначе // Проверим, можно ли получить требуемое поле через точку от реквизита.
			
			// Будем проверять только наиболее часто встречающиеся разыменования
			ВозможныеПоляРеквизита = Новый Массив;
			ВозможныеПоляРеквизита.Добавить("Код");
			ВозможныеПоляРеквизита.Добавить("Наименование");
			
			Для Каждого ПолеЧерезТочку Из ВозможныеПоляРеквизита Цикл 
				
				Если Не КонецСтрокиРавен(Выражение, ПолеЧерезТочку) Тогда 
					Продолжить;
				КонецЕсли;
				
				ИмяРеквизита = ОбрезатьСтрокуСправа(Выражение, СтрДлина(ПолеЧерезТочку));
				
				Если ЕстьРеквизитМетаданных(МетаданныеИсточника, ИмяРеквизита) Тогда
					
					РеквизитНайден = Истина;
					Выражение = "ЕСТЬNULL(%1.%2, НЕОПРЕДЕЛЕНО)";
					Выражение = СтрЗаменить(Выражение, "%1", ИмяРеквизита);
					Выражение = СтрЗаменить(Выражение, "%2", ПолеЧерезТочку);
					
					Реквизиты.Вставить(Псевдоним, Выражение);
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не РеквизитНайден Тогда 
			Реквизиты.Вставить(Псевдоним, "НЕОПРЕДЕЛЕНО");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет существование реквизита метаданных.
//
// Параметры:
//  ОбъектМетаданных				 - ОбъектМетаданных	 - метаданные произвольного объекта.
//  ИмяРеквизита					 - Строка			 - имя проверяемого реквизита.
//  ПроверятьСтандартныеРеквизиты	 - Булево			 - Истина, если при проверке следует учитывать стандартные реквизиты (Код, Наименование и т.д.)
// 
// Возвращаемое значение:
//  Булево - Истина, если реквизит с заданным именем существует.
//
Функция ЕстьРеквизитМетаданных(ОбъектМетаданных, ИмяРеквизита, ПроверятьСтандартныеРеквизиты = Ложь) Экспорт
	
	Если ОбъектМетаданных = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьРеквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
	Если Не ЕстьРеквизит И ПроверятьСтандартныеРеквизиты Тогда 
		
		КоллекцияРеквизитов = ОбъектМетаданных.СтандартныеРеквизиты;
		
		Для Каждого СтандартныйРеквизит Из КоллекцияРеквизитов Цикл 
			
			Если ВРег(СтандартныйРеквизит.Имя) = ВРег(ИмяРеквизита) Тогда 
				ЕстьРеквизит = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЕстьРеквизит;
	
КонецФункции

// Определяет, заканчивается ли строка указанной подстрокой.
// Аналог функции СтрЗаканчиваетсяНа, реализованной в платформе 8.3.6.
// ВНИМАНИЕ! Имя функции нельзя изменить на СтрокаЗаканчиваетсяНа(), т.к.
// в некоторых типовых конфигурациях метод с таким именем присутствует
// в глобальном общем модуле.
//
// Параметры:
//  Строка			 - Строка - Строка, окончание которой проверяется на совпадение с подстрокой поиска.
//  СтрокаПоиска	 - Строка - Строка, содержащая предполагаемое окончание строки. 
//                              В случае если переданное значение является пустой строкой генерируется исключение.
//  УчитыватьРегистр - Булево - Истина, если проверять совпадение следует с учетом регистра.
// 
// Возвращаемое значение:
//  Булево - Истина, если строка заканчивается указанной подстрокой.
//
Функция КонецСтрокиРавен(Знач Строка, Знач СтрокаПоиска, УчитыватьРегистр = Истина) Экспорт
	
	Если Не ТипЗнч(СтрокаПоиска) = Тип("Строка") Тогда 
		ТекстИсключения = НСтр("ru = 'Ошибка при вызове метода контекста (КонецСтрокиРавен): 
                                |Недопустимое значение параметра (параметр номер ''2'')'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если Не УчитыватьРегистр Тогда 
		Строка		 = ВРег(Строка);
		СтрокаПоиска = ВРег(СтрокаПоиска);
	КонецЕсли;
	
	Результат = Ложь;
	Если ЗначениеЗаполнено(СтрокаПоиска) 
		И Прав(Строка, СтрДлина(СтрокаПоиска)) = СтрокаПоиска Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удаляет с конца строки заданное количество символов.
//
// Параметры:
//  Строка				 - Строка	 - исходная строка.
//  КоличествоСимволов	 - Число	 - количество удаляемых символов.
// 
// Возвращаемое значение:
//  Строка - обрезанная строка.
//
Функция ОбрезатьСтрокуСправа(Строка, КоличествоСимволов = 1) Экспорт
	
	Результат = Лев(Строка, СтрДлина(Строка) - КоличествоСимволов);
	
	Возврат Результат;
	
КонецФункции


// Возвращает представление статустов взаимоотношений контрагентов в сервисе
// 
// Возвращаемое значение:
//  Структура
//
Функция ПредставлениеСтатусовВзаимоотношений() Экспорт
	
	Результат= Новый Соответствие;
	Результат.Вставить("IsMyCounteragent"		, "Партнерские отношения");
	Результат.Вставить("InvitesMe"				, "Получен запрос");
	Результат.Вставить("IsInvitedByMe"			, "Ожидается ответ");
	Результат.Вставить("RejectsMe"				, "Заблокировал меня");
	Результат.Вставить("IsRejectedByMe"			, "Заблокирован мной");
	Результат.Вставить("IsOrganization"			, "Совпадает с организацией");
	Результат.Вставить("NotInCounteragentList"	, "Имеет доступ в " + КраткоеНаименованиеСистемы);
	Результат.Вставить("IsActive"				, "Работает в " + КраткоеНаименованиеСистемыПредложныйПадеж);
	
	Возврат Результат;
	
КонецФункции

