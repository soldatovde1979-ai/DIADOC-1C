	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ВариантОтправкиСФ) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаНастроек = ТаблицаНастроекФорматовОтправки();
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ВариантОтправкиСФ", ВариантОтправкиСФ);
	СтруктураОтбора.Вставить("ОсновнойВариантОтправкиНакладных", Истина);
	
