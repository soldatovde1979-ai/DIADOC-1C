// Разбивает строку на элементы, помещая их в массив
//
// Параметры:
//  Строка					- Строка		- исходная строка
//  РазделительПодстрок		- Произвольный	- разделитель по которому происходит декомпозиция строки 
//  ПропускатьПустыеСтроки	- Булево		- признак, ограничивающий добавление в массив пустые строки
//  ПрименятьСокрЛП	 		- Булево		- признак, позволяющий убрать пробелы справа и слева от подстроки
// 
// Возвращаемое значение:
//   Массив 
//
Функция Преобразование_СтрокуВМассивПодстрок(Знач Строка, РазделительПодстрок = ",", ПропускатьПустыеСтроки = Ложь, ПрименятьСокрЛП = Ложь) Экспорт
	
	МассивПодстрок 		= Новый Массив;
	ДлинаРазделителя 	= СтрДлина(РазделительПодстрок);
	ПозицияРазделителя 	= Найти(Строка, РазделительПодстрок);
	
	Пока ПозицияРазделителя > 0 Цикл
		
		Подстрока = Лев(Строка, ПозицияРазделителя - 1);
		
		Если НЕ ПропускатьПустыеСтроки ИЛИ ЗначениеЗаполнено(Подстрока) Тогда
			МассивПодстрок.Добавить(?(ПрименятьСокрЛП, СокрЛП(Подстрока), Подстрока));
		КонецЕсли;
		
		Строка = Сред(Строка, ПозицияРазделителя + ДлинаРазделителя);
		
		ПозицияРазделителя = Найти(Строка, РазделительПодстрок);
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(Строка) Тогда
		МассивПодстрок.Добавить(?(ПрименятьСокрЛП, СокрЛП(Строка), Строка));
	КонецЕсли;
	
	Возврат МассивПодстрок;
	
КонецФункции //Преобразование_СтрокуВМассивПодстрок()

// Объединяет элементы массива в строку с использованием разделителя
//
// Параметры:
//  МассивСтрок	 				- Массив 		- обрабатываемый массив 
//  Разделитель	 				- Произвольный	- добавляется между элементами массива
//  ПропускатьПустыеЗначения	- Булево		- признак, ограничивающий вывод в строку пустые значения
// 
// Возвращаемое значение:
//   Строка  
//
Функция Преобразование_МассивВСтроку(МассивСтрок, Разделитель = ",", ПропускатьПустыеЗначения = Ложь) Экспорт
	
	Результат	= "";
	
	Если ТипЗнч(МассивСтрок) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из МассивСтрок Цикл
			
			Если ПропускатьПустыеЗначения И НЕ ЗначениеЗаполнено(ЭлементМассива) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат = Результат + ?(СтрДлина(Результат) = 0, "", Разделитель) + ЭлементМассива;	
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(МассивСтрок) = Тип("Строка") Тогда
		
		Результат = МассивСтрок;		
		
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции //Преобразование_МассивВСтроку()

//Проверяет наличие заданного значения в кэш
//
// Параметры:
//	Значение	- Произвольный						- Искомое значение
//	Кэш			- Массив, Структура, 
//				  Соответствие, ТаблицаЗначений		- Коллекция, в которой осуществляется поиск значения
//
// Возвращает:
//	Булево
Функция ЗначениеЗаполненоИОтсутствуетВКеш(Значение, Кэш) Экспорт
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Если ТипЗнч(Кэш) = Тип("Массив") Тогда
			
			Результат = (Кэш.Найти(Значение) = Неопределено);
			
		ИначеЕсли ТипЗнч(Кэш) = Тип("Структура") Тогда
			
			Результат = (Кэш.Свойство(Значение) = Ложь);
			
		ИначеЕсли ТипЗнч(Кэш) = Тип("Соответствие") Тогда
			
			Результат = (Кэш.Получить(Значение) = Неопределено);
			
		ИначеЕсли ТипЗнч(Кэш) = Тип("ТаблицаЗначений") Тогда
			
			Результат = (Кэш.НайтиСтроки(Значение).Количество() = 0);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //ЗначениеЗаполненоИОтсутствуетВКеш()

// Процедура добавляет структурированное инфополе в контент исходящего документа.
//
// Параметры:
//  Массив	 - <Массив> - Коллекция инфополей шапки или табличной части документа
//  Key		 - <Строка> - Ключ добавляемого свойства
//  Value	 - <Строка> - Значение добавляемого свойства
//
Процедура ДополнитьМассивKeyValue(Массив, Key, Value)
	
	НовыйЭлемент = Новый Структура;
	
	НовыйЭлемент.Вставить("Key",	Key);
	НовыйЭлемент.Вставить("Value",	Value);
	
	Массив.Добавить(НовыйЭлемент);
	
КонецПроцедуры

// Подставляет параметры в строку, максимальное число параметров - 6.
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон содержащий маркеры подстановки вида: "%1..%N"
//                        . Нумерация маркеров начинается с 1.
//                          N не может быть более 6.
//  Параметр<n>  - Строка - подставляемые параметры.
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами.
//
Функция ПодставитьПараметрыВСтроку(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено
	, Параметр6 = Неопределено) Экспорт
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	Результат = СтрЗаменить(Результат	, "%6", Параметр6);
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру, содержащую значения реквизитов прочитанные из информационной базы
// по ссылке на объект.
// 
//  Если доступа к одному из реквизитов нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  Ссылка    - Ссылка на объект - элемент справочника, документ, ...
//
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//              требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель".
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//              псевдоним поля для возвращаемой структуры с результатом, а в качестве
//              значения (опционально) фактическое имя поля в таблице.
//              Если значение не определено, то имя поля берется из ключа.
//            - Массив, ФиксированныйМассив - имена реквизитов в формате требований
//              к свойствам структуры.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//              Если строка затребованных реквизитов пуста, то возвращается пустая структура
//
Функция ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты) Экспорт
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		Если ПустаяСтрока(Реквизиты) Тогда
			Возврат Новый Структура;
		КонецЕсли;
		
		СтруктураРеквизитов = Новый Структура(Реквизиты);
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Структура")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированнаяСтруктура") Тогда
		
		СтруктураРеквизитов = Реквизиты;
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		
		СтруктураРеквизитов = Новый Структура;
		Для каждого Реквизит Из Реквизиты Цикл
			СтруктураРеквизитов.Вставить(Реквизит);
		КонецЦикла;
	Иначе
		ВызватьИсключение ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Неверный тип второго параметра Реквизиты: %1'"),
		Строка(ТипЗнч(Реквизиты)));
		
	КонецЕсли;
	
	ТекстПолей = "";
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		
		ИмяПоля   = ?(ЗначениеЗаполнено(КлючИЗначение.Значение),
		СокрЛП(КлючИЗначение.Значение),
		СокрЛП(КлючИЗначение.Ключ));
		
		Псевдоним = СокрЛП(КлючИЗначение.Ключ);
		
		ТекстПолей  = ТекстПолей + ?(ПустаяСтрока(ТекстПолей), "", ",") + "
		|	" + ИмяПоля + " КАК " + Псевдоним;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|" + ТекстПолей + "
	|ИЗ
	|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК ПсевдонимЗаданнойТаблицы
	|ГДЕ
	|	ПсевдонимЗаданнойТаблицы.Ссылка = &Ссылка
	|";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		Результат.Вставить(КлючИЗначение.Ключ);
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение реквизита, прочитанного из информационной базы по ссылке на объект.
// 
//  Если доступа к реквизиту нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  Ссылка       - ссылка на объект, - элемент справочника, документ, ...
//  ИмяРеквизита - Строка, например, "Код".
// 
// Возвращаемое значение:
//  Произвольный    - зависит от типа значения прочитанного реквизита.
// 
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита) Экспорт
	
	Результат = ЗначенияРеквизитовОбъекта(Ссылка, ИмяРеквизита);
	Возврат Результат[ИмяРеквизита];
	
КонецФункции 

// Возвращает структуру, содержащую значения реквизитов, прочитанные из информационной базы
// для нескольких объектов.
// 
//  Если доступа к одному из реквизитов нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  МассивСсылок - массив ссылок на объекты одного типа
//				ВАЖНО! значения массива должны быть ссылками на 
//				объекты одного типа!
//  ИменаРеквизитов - Строка, имена реквизитов перечисленные через запятую,
//				в формате требований к свойствам структуры.
//				Например, "Код, Наименование, Родитель".
// 
// Возвращаемое значение:
//  Соответствие, где ключ - ссылка на объект, а Значение - структура, которая 
//				содержит список свойств, как список имен в строке
//				ИменаРеквизитов, со значениям реквизитов, прочитанными
//				из информационной базы.
// 
Функция ЗначенияРеквизитовОбъектов(МассивСсылок, ИменаРеквизитов) Экспорт
	
	ЗначенияРеквизитов = Новый Соответствие;
	Если ТипЗнч(МассивСсылок) = Тип("Массив") ИЛИ ТипЗнч(МассивСсылок) = Тип("ФиксированныйМассив") Тогда
		Если МассивСсылок.Количество() = 0 Тогда
			Возврат ЗначенияРеквизитов;
		КонецЕсли;
	Иначе
		Если НЕ Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") = Неопределено Тогда
			СтрокаСообщения = "Неверный тип параметра ""МассивСсылок""";
			Выполнить("ОбщегоНазначения.СообщитьОбОшибке(СтрокаСообщения)");
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ссылка КАК Ссылка, " + ИменаРеквизитов + "
	|ИЗ
	|	" + МассивСсылок[0].Метаданные().ПолноеИмя() + " КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Новый Структура(ИменаРеквизитов);
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ЗначенияРеквизитов[Выборка.Ссылка] = Результат;
	КонецЦикла;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

// Возвращает значения реквизита, прочитанного из информационной базы для нескольких объектов.
// 
//  Если доступа к реквизиту нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  МассивСсылок - массив ссылок на объекты одного типа
//				ВАЖНО! значения массива должны быть ссылками на 
//				объекты одного типа!
//  ИмяРеквизита - Строка, например, "Код".
// 
// Возвращаемое значение:
//  Соответствие, где ключ - ссылка на объект, Значение - значение прочитанного реквизита
// 
Функция ЗначениеРеквизитаОбъектов(МассивСсылок, ИмяРеквизита) Экспорт
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектов(МассивСсылок, ИмяРеквизита);
	Для Каждого Элемент Из ЗначенияРеквизитов Цикл
		ЗначенияРеквизитов[Элемент.Ключ] = Элемент.Значение[ИмяРеквизита];
	КонецЦикла;
	
	Возврат ЗначенияРеквизитов;
	
КонецФункции

Процедура ДополнитьСтруктуруСоответствие(Приемник, Источник) Экспорт
	
	Для Каждого КлючИЗначение Из Источник Цикл
		Приемник.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаменитьНедопустимыеСимволыИмениФайла(ИмяФайла) Экспорт
	
	Результат = ИмяФайла;
	
	НедопустимыеСимволы = "\/:*?""<>|";
	
	Для Сч = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		Результат = СтрЗаменить(Результат, Сред(НедопустимыеСимволы, Сч, 1), "_");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Base64СтрокаИзДвоичныхДанных(ДвоичныеДанные) Экспорт
	
	Результат = Base64Строка(ДвоичныеДанные);
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	
	Возврат Результат;
	
КонецФункции

// Сравнивает текущую версию приложения с переданной версией.
// Параметры:
//  СтрокаВерсии1 - Строка - номер версии
//  СтрокаВерсии2 - Строка - второй сравниваемый номер версии.
//
// Возвращаемое значение:
//   Число   - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
//
Функция ПриложениеСтаршеВерсии(Версия)
	
	РезультатыФункции = Кэш_Прочитать("РезультатыФункции_ПриложениеСтаршеВерсии");
	
	Если РезультатыФункции = Неопределено Тогда
		РезультатыФункции = Новый Соответствие;
	КонецЕсли;
	
	Результат = РезультатыФункции[Версия];
	
	Если Результат = Неопределено Тогда
		
		СисИнфо = Новый СистемнаяИнформация;
		
		Результат = СравнитьВерсии(СисИнфо.ВерсияПриложения, Версия) = "ПерваяМеньше";
		
		РезультатыФункции.Вставить(Версия, Результат);
		
		Кэш_Поместить("РезультатыФункции_ПриложениеСтаршеВерсии", РезультатыФункции);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодироватьЧислоHEX(Знач Число)
	
	Результат = "";
	
	Если Число <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Словарь = "0123456789ABCDEF";
	
	Пока Истина Цикл
		
		Результат = Сред(Словарь, Число % 16 + 1, 1) + Результат;
		
		Если Число < 16 Тогда
			Прервать;
		КонецЕсли;
		
		Число = Число / 16;
		
	КонецЦикла;
	
	НечетнаяДлина = СтрДлина(Результат) % 2 > 0;
	
	Если НечетнаяДлина Тогда
		Результат = "0" + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Кодирует строку URL в URL кодировке, cпецсимволы URL не кодируются
//
// Параметры:
//  Строка - Строка - строка URL
// 
// Возвращаемое значение:
//  Строка - закодированная строка URL
//
Функция КодироватьСтрокуURL(Строка) Экспорт
	
	Результат = "";
	
	Если ПриложениеСтаршеВерсии("8.3") Тогда
		
		СпецСимволы = "!#$%'()*+,/:;=?@[]&_.-";
		
		Код_А = КодСимвола("А");
		Код_п = КодСимвола("п");
		Код_р = КодСимвола("р");
		Код_я = КодСимвола("я");
		
		ДлинаСтроки = СтрДлина(Строка);
		
		Для Сч = 1 По ДлинаСтроки Цикл
			
			Символ	 = Сред(Строка, Сч, 1);
			Код		 = КодСимвола(Символ);
			ЭтоСпецСимвол = Найти(СпецСимволы, Символ) > 0;
			
			ДопустимыйСимвол = ЭтоСпецСимвол
			Или (Символ >= "a" И Символ <= "z")
			Или (Символ >= "A" И Символ <= "Z")
			Или (Символ >= "0" И Символ <= "9");
			
			Если ДопустимыйСимвол Тогда
				
				Результат = Результат + Символ;
				
			ИначеЕсли Код >= Код_А И Код <= Код_п Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(208) + "%" + КодироватьЧислоHEX(144 + Код - Код_А);
				
			ИначеЕсли Код >= Код_р И Код <= Код_я Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(209) + "%" + КодироватьЧислоHEX(128 + Код - Код_р);
				
			ИначеЕсли Символ = "ё" Тогда
				
				Результат = Результат + "%D1%91";
				
			ИначеЕсли Символ = "Ё" Тогда
				
				Результат = Результат + "%D0%81";
				
			ИначеЕсли Символ = Символы.НПП Тогда
				
				Результат = Результат + "%C2%A0";
				
			Иначе
				
				Результат = Результат + "%" + КодироватьЧислоHEX(Код);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Результат = Вычислить("КодироватьСтроку(Строка, СпособКодированияСтроки.URLВКодировкеURL)");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, содержит ли строка только цифры.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка содержит только цифры или пустая.
//
Функция ТолькоЦифрыВСтроке(Значение) Экспорт
	
	Результат	 = Истина;
	КодСимвола0	 = КодСимвола("0");
	КодСимвола9	 = КодСимвола("9");
	ДлинаСтроки	 = СтрДлина(Значение);
	
	Для НомерСимвола = 1 По ДлинаСтроки Цикл
		
		КодСимвола = КодСимвола(Значение, НомерСимвола);
		
		Если КодСимвола < КодСимвола0 Или КодСимвола > КодСимвола9 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Объединяет части пути через разделитель
//
Функция ОбъединитьПути(П1, П2, П3 = Неопределено, П4 = Неопределено) Экспорт
	
	Результат = П1;
	РазделительПути = "\";
	
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(П2);
	ЧастиПути.Добавить(П3);
	ЧастиПути.Добавить(П4);
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> РазделительПути Тогда
			Результат = Результат + РазделительПути;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает полное имя файла текущей внешней обработки
// 
// Возвращаемое значение:
//  Строка       - если обработка подключена из файла
//  Неопределено - если обработка подключена через временное хранилище
//                 или добавлена в состав конфигурации
//
Функция ИспользуемоеИмяФайлаОбработки() Экспорт
	
	Результат = Неопределено;
	
	МетаданныеОбработки = ЭтотОбъект.Метаданные();
	
	Если Не Метаданные.Обработки.Содержит(МетаданныеОбработки) Тогда
		
		ИмяФайла = ЭтотОбъект.ИспользуемоеИмяФайла;
		
		// Метод ЭтоАдресВременногоХранилища() может не сработать,
		// потому что файла во временном хранилище может уже не быть
		ЭтоПутьКФайлу = НРег(Прав(ИмяФайла, 4)) = ".epf";
		
		Если ЭтоПутьКФайлу Тогда
			Результат = ИмяФайла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

