Процедура ИнициализироватьМодулиЯдра(Отказ = Ложь) Экспорт
	
	Если НЕ ЗапущенКакВнешнийМодуль Тогда
		Модуль_РаботаССерверомДиадок = Модуль_РаботаССерверомДиадок();
		ОдинСАдаптер_Инициализировать(Отказ);
	КонецЕсли;
	
	Модуль_Интеграция = ПолучитьМодульИнтеграции();
	
	Если Модуль_Интеграция = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
	// Для совместимости со старыми ПМ
	Модуль_ИнтеграцияОбщий	  = Модуль_Интеграция;
	Модуль_ЗаполнениеКонтента = ЭтотОбъект;
	
	КэшМодулей().Вставить("Модуль_Интеграция"		 	  	 , Модуль_Интеграция);
	КэшМодулей().Вставить("Модуль_ИнтеграцияОбщий"	 	  	 , Модуль_Интеграция);
	КэшМодулей().Вставить("Модуль_ЗаполнениеКонтента"	 	 , ЭтотОбъект);
	КэшМодулей().Вставить("Модуль_Диадок_РаботаСКонтентом"	 , ЭтотОбъект);
	КэшМодулей().Вставить("Модуль_Логика_ПрофилиКонфигурации", ЭтотОбъект);
	
КонецПроцедуры

Функция ПолучитьМодульИнтеграции()
	
	Результат = Неопределено;
	
	РучнойВыбор = Ложь;
	
	Пока Результат = Неопределено Цикл
		
		Если НЕ ЗапущенКакВнешнийМодуль ИЛИ НЕ ЗначениеЗаполнено(ИмяМодуляИнтеграции) Тогда
			ИмяМодуляИнтеграции = ПолучитьИмяМодуляИнтеграции(РучнойВыбор).ИмяМодуляИнтеграции;
		КонецЕсли;
		
		Если РучнойВыбор И НЕ ЗначениеЗаполнено(ИмяМодуляИнтеграции) Тогда
			Прервать; // Пользователь отказался выбрать модуль интеграции вручную
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяМодуляИнтеграции) Тогда
			
			Попытка
				Результат = ВнешняяОбработкаИзМакета(ИмяМодуляИнтеграции);
			Исключение 
				ОписаниеОшибки = ОписаниеОшибки();
				Сообщить(ОписаниеОшибки, СтатусСообщения.Важное);
				ИмяМодуляИнтеграции = Неопределено;
			КонецПопытки;
			
		КонецЕсли;
		
		Если Результат = Неопределено Тогда
			
			#Если Клиент Тогда
				
				Ответ = Вопрос("Загрузить модуль интеграции не удалось!
					 		   |		Изменить модуль интеграции?",
							   РежимДиалогаВопрос.ДаНет, , , НаименованиеСистемы);
				
				РучнойВыбор = Ответ = КодВозвратаДиалога.Да;
				
			#КонецЕсли
			
			// Автоматически загрузить модуль уже пытались и не получилось.
			Если НЕ РучнойВыбор Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИмяМодуляИнтеграции) Тогда
		ВызватьИсключение "Не выбран модуль интеграции!";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПодключитьКомпонентуДиадока(Отказ)
	
	ПутьКФайлу = ОбщиеПараметры.ПутьКФайлуКомпоненты;
	РезультатПодключения = Модуль_РаботаССерверомДиадок.ПодключитьКомпонентуДиадока(ПутьКФайлу);
	
	ВерсияКомпоненты	 = РезультатПодключения.ВерсияКомпоненты;
	ТребуетсяПерезапуск	 = РезультатПодключения.ТребуетсяПерезапуск;
	
	Если ТребуетсяПерезапуск Тогда
		
		ФормаОшибки = Получитьформу("Модуль_СообщенияДляПользователей_Форма_ВыводОшибки");
		
		ЗаголовокОшибки = НСтр("ru = 'Обновление внешней компоненты'");
		
		ТекстОшибки = ПодставитьПараметрыВСтроку(НСтр(
		"ru = 'Для подключения внешней компоненты версии %1
		|необходимо перезапустить программу'"), ВерсияКомпоненты);
		
		ФормаОшибки.ПоказатьОшибку(ЗаголовокОшибки, ТекстОшибки);
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьМодуль_РаботаССерверомДиадок(Отказ = Ложь) Экспорт
	
	ПодключитьКомпонентуДиадока(Отказ);
	
	Если Не Отказ Тогда
		Модуль_РаботаССерверомДиадок.ЗаполнитьПараметрыDiadocInvoiceAPI();
		Модуль_РаботаССерверомДиадок.ИнициализироватьКонтекст(, , Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция ВнешняяОбработкаИзМакета(ИмяОбработки)
	
	ИмяМакета = ИмяОбработки + "_epf";
	
	Попытка
		
		Если Не ЭтоВнешняяОбработка() Тогда
			
			ПрефиксОбработокРасширения = "КонтурДиадокСтандартОФ_";
			Результат = Обработки[ПрефиксОбработокРасширения + ИмяОбработки].Создать();
			
		ИначеЕсли РежимОтладки = Истина И ЗначениеЗаполнено(КаталогОбработок) Тогда
			
			ИмяФайла = ИмяОбработки + ".epf";
			ПолноеИмяФайла = ОбъединитьПути(КаталогОбработок, ИмяФайла);
			
			Файл = Новый Файл(ПолноеИмяФайла);
			
			Если НЕ Файл.Существует() Тогда
				СоздатьКаталог(Файл.Путь);
				ПолучитьМакет(ИмяМакета).Записать(ПолноеИмяФайла);
			КонецЕсли;
			
			Результат = ВнешниеОбработки_Создать(ПолноеИмяФайла);
			
		Иначе
			
			Результат = ВнешниеОбработки_СоздатьБезПредупреждений(ПолучитьМакет(ИмяМакета));
			
		КонецЕсли;
		
		НеобязательныеРеквизиты = Новый Структура;
		НеобязательныеРеквизиты.Вставить("Ядро", ЭтотОбъект);
		НеобязательныеРеквизиты.Вставить("ОсновнойМодуль", ЭтотОбъект);
		ЗаполнитьЗначенияСвойств(Результат, НеобязательныеРеквизиты);
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ОписаниеОшибки = "Ошибка создания обработки из макета """ + ИмяОбработки + """:" + ОписаниеОшибки;
