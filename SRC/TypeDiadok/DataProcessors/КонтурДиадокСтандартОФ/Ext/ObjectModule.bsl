// Наполняет список выбора данными, переданными в виде списка значений.
//
// Параметры:
//  СписокВыбора 	- СписокЗначений - список выбора элемента формы, который нужно наполнить значениями.
//	СписокЗначений 	- СписокЗначений - коллекция, содержащая нужные значения.
//
Процедура ЗаполнитьСписокВыбораПоСпискуЗначений(СписокВыбора, СписокЗначений) Экспорт
	
	СписокВыбора.Очистить();
	
	Для Каждого ЭлементКоллекции Из СписокЗначений Цикл
		
		СписокВыбора.Добавить(ЭлементКоллекции.Значение, ЭлементКоллекции.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

