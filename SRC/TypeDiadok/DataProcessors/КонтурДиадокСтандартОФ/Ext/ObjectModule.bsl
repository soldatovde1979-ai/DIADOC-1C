Функция ПолучитьИмяМодуляИнтеграции(РучнойВыбор = Ложь) Экспорт
	
	Результат = Новый Структура("ИмяМодуляИнтеграции, ОпределенАвтоматически", "", Ложь);
	
	Если РучнойВыбор Тогда
		
		#Если Клиент Тогда
			
			РезультатВыбора = СписокМодулейИнтеграции().ВыбратьЭлемент("Выберите базовую конфигурацию");
			
			Если РезультатВыбора <> Неопределено Тогда
				Результат.ИмяМодуляИнтеграции = РезультатВыбора.Значение;
				СохранитьЗначение("ДиадокИмяБазовогоМодуля", Результат.ИмяМодуляИнтеграции);
			КонецЕсли;
			
		#КонецЕсли
		
	Иначе
		
		Результат.ИмяМодуляИнтеграции = ОпределитьИмяМодуляИнтеграцииАвтоматически();
		
		Если ЗначениеЗаполнено(Результат.ИмяМодуляИнтеграции) Тогда
			
			Результат.ОпределенАвтоматически = Истина;
			
		Иначе
			
			#Если Клиент Тогда
				Результат.ИмяМодуляИнтеграции = Строка(ВосстановитьЗначение("ДиадокИмяБазовогоМодуля"));
			#КонецЕсли
			
			Если СписокМодулейИнтеграции().НайтиПоЗначению(Результат.ИмяМодуляИнтеграции) = Неопределено Тогда
				Результат.ИмяМодуляИнтеграции = "";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МодульИнтеграцииОпределенАвтоматически() Экспорт
	
	ОпределенноеИмя = ОпределитьИмяМодуляИнтеграцииАвтоматически();
	
	Результат = ЗначениеЗаполнено(ОпределенноеИмя);
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьИмяМодуляИнтеграцииАвтоматически()
	
	Результат = "";
	
	Если 	Найти(Метаданные.Синоним, "Бухгалтерия предприятия, редакция 2.0") > 0
		ИЛИ Найти(Метаданные.Синоним, "Бухгалтерия предприятия КОРП, редакция 2.0") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияБух";
		
	ИначеЕсли Найти(Метаданные.Синоним, "10.3") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияУТ103";
				
	ИначеЕсли Найти(Метаданные.Синоним, "Управление торговлей") > 0 И Найти(Метаданные.Синоним, "10.2") = 0 Тогда // Управление торговлей, редакция 10.2 снята с поддержки в 5.38.01
		
		Результат = "Модуль_ИнтеграцияУТ103";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Комплексная автоматизация") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияКА";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Управление производственным предприятием, редакция 1.3") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияУПП13";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Управление ремонтным предприятием, редакция 1.3") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияУПП13";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Альфа-Авто") > 0 И Найти(Метаданные.Синоним, "4.1") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияАльфаАвто41";
		
	ИначеЕсли Найти(Метаданные.Синоним, "Альфа-Авто") > 0 И Найти(Метаданные.Синоним, "5") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияАльфаАвто41";
		
	ИначеЕсли Найти(ВРЕГ(Метаданные.Синоним), "ТКПТ") > 0 Тогда
		
		Результат = "Модуль_ИнтеграцияТКПТ";
		
	ИначеЕсли Метаданные.Имя = "ДАЛИОНУправлениеМагазином" ИЛИ Метаданные.Имя = "ДАЛИОНУправлениеМагазиномПРО" Тогда
		
		Результат = "Модуль_ИнтеграцияДалионУМ";
		
	ИначеЕсли Метаданные.Имя = "ТорговыйДом" И Метаданные.Поставщик = "ООО «АСТ СОФТ»" Тогда
		
		Результат = "Модуль_ИнтеграцияАсторТД";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

