Функция ИмяФайлаПечатнойФормы(ВидДокумента, НомерДокумента, ДатаДокумента, ФорматФайла)
	
	ДатаДокументаСтрокой = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
	
	НормализованныйНомер = ЗаменитьНедопустимыеСимволы(НомерДокумента);
	
	Результат = ПодставитьПараметрыВСтроку("%1 №%2 от %3.%4"
	, ВидДокумента, НормализованныйНомер, ДатаДокументаСтрокой, ФорматФайла);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаменитьНедопустимыеСимволы(НомерДокумента) Экспорт 
	
	Результат = НомерДокумента;
	
	НедопустимыеЗнаки = "\/:*?""<>|";
	
	Пока СтрДлина(НедопустимыеЗнаки) > 0 Цикл
		
		ТекСимвол = Лев(НедопустимыеЗнаки, 1);
		Если Найти(Результат, ТекСимвол) <> 0 Тогда
			Результат = СтрЗаменить(Результат, ТекСимвол, "_");
		КонецЕсли;
		НедопустимыеЗнаки = Сред(НедопустимыеЗнаки, 2);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеДанныхФайла(ТипДокумента) Экспорт
	
	Результат = Неопределено;
	
	Если ТипДокумента = "Nonformalized" Тогда
		
		Результат = Новый_Nonformalized();
		
	ИначеЕсли ТипДокумента = "PriceListAgreement" Тогда
		
		Результат = Новый_Nonformalized();
		Результат.NeedRecipientSignature = Истина;
		
	ИначеЕсли ТипДокумента = "CertificateRegistry" Тогда 
		
		Результат = Новый_Nonformalized();
		
	ИначеЕсли ТипДокумента = "ServiceDetails" Или ТипДокумента = "ReconciliationAct" Тогда
		
		Результат = Новый_ServiceDetails();
		
	ИначеЕсли ТипДокумента = "ProformaInvoice"
		Или ТипДокумента = "NonformalizedProforma" Тогда
		
		Результат = Новый_ProformaInvoice();
		
	ИначеЕсли ТипДокумента = "PriceList" Тогда
		
		Результат = Новый_PriceList();
		
	ИначеЕсли ТипДокумента = "AcceptanceCertificate" Тогда
		
		Результат = Новый_AcceptanceCertificate();
		
	ИначеЕсли ТипДокумента = "Contract" Тогда
		
		Результат = Новый_Contract();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеФорматаДляОтправкиФайла(DocumentType) Экспорт
	
	ТипыКонтента = ТипыКонтента();
	
	ТипДокумента = DocumentType;
	
	// Имя типа документа API не всегда совпадает с именем протообъекта
	Если ВРег(DocumentType) = ВРег("NonformalizedProforma") Тогда
		ТипДокумента = "ProformaInvoice";
	КонецЕсли;
	
	Результат = ОписаниеФорматаЭлектронногоДокумента(ТипДокумента, "default", "v1");
	
	Возврат Результат;
	
КонецФункции

