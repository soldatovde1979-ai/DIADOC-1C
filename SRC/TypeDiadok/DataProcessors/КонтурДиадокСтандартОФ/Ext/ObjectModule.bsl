Функция СоздатьДокументВ1СПоступление(Параметры, стВероятныеПоля, Document, ТабличнаяЧасть = Неопределено, СуммаВключаетНДС = Истина, ВидОперации, ЗаполнениеГТД = Ложь) Экспорт
	
	ДокументОбъект = Модуль_Интеграция.СоздатьДокументПоступлениеТоваровУслуг(	Параметры, 
	стВероятныеПоля, 
	Document, 
	ТабличнаяЧасть, 
	СуммаВключаетНДС, 
	ВидОперации, 
	ЗаполнениеГТД	);
	
	ИспользоватьСервисКонтурМаркировка = КонстантаИспользоватьСервисКонтурМаркировка();
	МенеджерИнтеграции_ЗагрузитьКодыМаркировки(ДокументОбъект, ТабличнаяЧасть, ИспользоватьСервисКонтурМаркировка);
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("Document"			, Document);
	ПараметрыПМ.Вставить("ДокументОбъект"	, ДокументОбъект);
	Если ЭтоФормализованныйДокумент(Document.type) Тогда
		ПараметрыПМ.Вставить("СтруктураКонтента", ПротоКонтентДокумента(Document));	
	Иначе
		ПараметрыПМ.Вставить("СтруктураКонтента", Неопределено);
	КонецЕсли;
	
	ОбработкаСобытияПодключаемогоМодуля("ПослеЗаполненияНовогоДокументаПоступления", ПараметрыПМ);
	
	Если ИмяМодуляИнтеграции = "Модуль_ИнтеграцияАльфаАвто41" Тогда
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		ДокументОбъект.ОбменДанными.Загрузка = Ложь;
		
	КонецЕсли;
	
	ФормаДокумента = ДокументОбъект.ПолучитьФорму();
	ФормаДокумента.Модифицированность = Истина;
	ФормаДокумента.ОткрытьМодально();
	Если ФормаДокумента.Модифицированность() Тогда
		Результат = Неопределено;
	Иначе
		Результат = ДокументОбъект.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция СоздатьДокументВ1СВозврат(параметры, стВероятныеПоля, ЭДОбъект) Экспорт
	ДокументОбъект = Модуль_Интеграция.СоздатьДокументВозвратТоваровОтПокупателя(параметры, стВероятныеПоля, ЭДОбъект);
	ДокументОбъект.ПолучитьФорму().ОткрытьМодально();
	Если ДокументОбъект.Модифицированность() = Ложь Тогда
		Возврат ДокументОбъект.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

