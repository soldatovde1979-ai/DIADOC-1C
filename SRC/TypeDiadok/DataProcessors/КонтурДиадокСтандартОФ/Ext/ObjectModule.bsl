	Результат.СальдоНачДебет = СвойствоСтруктуры(Прото, "BalanceDebitFrom", Неопределено);
	Результат.СальдоНачКредит = СвойствоСтруктуры(Прото, "BalanceAmountFrom", Неопределено);
	Результат.ОборотДебет = СвойствоСтруктуры(Прото, "TurnoverDebit", Неопределено);
	Результат.ОборотКредит = СвойствоСтруктуры(Прото, "TurnoverAmount", Неопределено);
	Результат.СальдоКонДебет = СвойствоСтруктуры(Прото, "BalanceDebitEnd", Неопределено);
	Результат.СальдоКонКредит = СвойствоСтруктуры(Прото, "BalanceAmountEnd", Неопределено);
	
	ПрочитатьСвойства_СведенияОДоговорах405(Результат, Прото);
	
	Возврат Результат;
	
КонецФункции

Процедура ПрочитатьСвойства_СведенияОДоговорах405(СтрокиТабличнойЧасти, ИсточникДанных)
	
	КоллекцияДоговоров = СвойствоСтруктуры(ИсточникДанных, "ContractInfo", Новый Массив);
	
	Для Каждого ЭлементДоговор Из КоллекцияДоговоров Цикл
		
		СтрокаДоговор = НовыйСведенияОДоговоре405();
		
		СтрокаДоговор.ИдДоговора = СвойствоСтруктуры(ЭлементДоговор, "ContractId", Неопределено);
		СтрокаДоговор.Описание = СвойствоСтруктуры(ЭлементДоговор, "ContractAdditionalInfo", Неопределено);
		СтрокаДоговор.Номер = СвойствоСтруктуры(ЭлементДоговор, "ContractNumber", Неопределено);
		СтрокаДоговор.Дата = СвойствоСтруктуры(ЭлементДоговор, "ContractDate", Неопределено);
		СтрокаДоговор.СальдоНачДебет = СвойствоСтруктуры(ЭлементДоговор, "BalanceDebitFrom", Неопределено);
		СтрокаДоговор.СальдоНачКредит = СвойствоСтруктуры(ЭлементДоговор, "BalanceAmountFrom", Неопределено);
		СтрокаДоговор.ОборотДебет = СвойствоСтруктуры(ЭлементДоговор, "TurnoverDebit", Неопределено);
		СтрокаДоговор.ОборотКредит = СвойствоСтруктуры(ЭлементДоговор, "TurnoverAmount", Неопределено);
		СтрокаДоговор.СальдоКонДебет = СвойствоСтруктуры(ЭлементДоговор, "BalanceDebitEnd", Неопределено);
		СтрокаДоговор.СальдоКонКредит = СвойствоСтруктуры(ЭлементДоговор, "BalanceAmountEnd", Неопределено);
		
		DocumentInfo = СвойствоСтруктуры(ЭлементДоговор, "DocumentInfo", Новый Массив);
		
		ПрочитатьСвойства_СведенияОДокументах405(СтрокаДоговор, DocumentInfo);
		
		СтрокиТабличнойЧасти.Договор.Добавить(СтрокаДоговор);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьСвойства_СведенияОДокументах405(СтрокаДоговор, DocumentInfo)
	
	Для Каждого ЭлементДокумент Из DocumentInfo Цикл
		
		СтрокаДокумент = НовыйСведенияОДокументе405();
		
		СтрокаДокумент.Наименование = СвойствоСтруктуры(ЭлементДокумент, "DocumentName", Неопределено);
		СтрокаДокумент.Номер = СвойствоСтруктуры(ЭлементДокумент, "DocumentNumber", Неопределено);
		СтрокаДокумент.Дата = СвойствоСтруктуры(ЭлементДокумент, "DocumentDate", Неопределено);
		СтрокаДокумент.ИдДокумента = СвойствоСтруктуры(ЭлементДокумент, "DocumentId", Неопределено);
		СтрокаДокумент.ДопИнфо = СвойствоСтруктуры(ЭлементДокумент, "AdditionalInfo", Неопределено);
		
		OperationInfo = СвойствоСтруктуры(ЭлементДокумент, "OperationInfo", Новый Массив);
		
		ПрочитатьСвойства_СведенияОбОперациях405(СтрокаДокумент, OperationInfo);
		
		СтрокаДоговор.Документ.Добавить(СтрокаДокумент);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьСвойства_СведенияОбОперациях405(СтрокаДокумент, OperationInfo)
	
	Для Каждого ЭлементОперация Из OperationInfo Цикл
		
		СтрокаОперация = НовыйСведенияОбОперации405();
		
		СтрокаОперация.Дата = СвойствоСтруктуры(ЭлементОперация, "OperationDate", Неопределено);
		СтрокаОперация.Наименование = СвойствоСтруктуры(ЭлементОперация, "OperationName", Неопределено);
		СтрокаОперация.СуммаДебет = СвойствоСтруктуры(ЭлементОперация, "SumDebit", Неопределено);
		СтрокаОперация.СуммаКредит = СвойствоСтруктуры(ЭлементОперация, "SumAmount", Неопределено);
		
		СтрокаДокумент.Операция.Добавить(СтрокаОперация);
		
	КонецЦикла;
	
КонецПроцедуры

