Процедура ВызватьИсключениеВалидацииПротоКонтента(ПротоКонтент, ФорматОтправки, СсылкаНаДокумент) Экспорт
	
	СписокОшибок = ВалидацияПротоКонтента(ПротоКонтент, ФорматОтправки);
	
	Если ЗначениеЗаполнено(СписокОшибок) Тогда
		ТекстОшибки = СписокОшибокВСтрокуXml(СсылкаНаДокумент, СписокОшибок);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

Функция ВалидацияДанныхФайла(DocumentType, ДанныеФайла) Экспорт
	
	Результат = Новый Массив;
	
	Если 	DocumentType = "AcceptanceCertificate" 
		ИЛИ DocumentType = "ReconciliationAct" 
		ИЛИ DocumentType = "NonformalizedProforma" 
		ИЛИ DocumentType = "Contract" Тогда
		
		Если ДанныеФайла.Свойство("DocumentNumber")
			И НЕ ЗначениеЗаполнено(ДанныеФайла.DocumentNumber) Тогда
			ДобавитьОшибкуВалидации(Результат, " - Номер документа");
		КонецЕсли;
		
		Если ДанныеФайла.Свойство("DocumentDate")
			И НЕ ЗначениеЗаполнено(ДанныеФайла.DocumentDate) Тогда
			ДобавитьОшибкуВалидации(Результат, " - Дата документа");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеФайла.Свойство("TotalVat")
		И НЕ ЗначениеЗаполнено(ДанныеФайла.TotalVat)
		И (НЕ ДанныеФайла.Свойство("БезНДС")
		ИЛИ НЕ ДанныеФайла.БезНДС) Тогда
		ДобавитьОшибкуВалидации(Результат, " - НДС");
	КонецЕсли;
	
	Если ДанныеФайла.Свойство("TotalSum")
		И НЕ ЗначениеЗаполнено(ДанныеФайла.TotalSum) Тогда
		ДобавитьОшибкуВалидации(Результат, " - Сумма с НДС");
	КонецЕсли;
	
	Если ДанныеФайла.Свойство("ContractPrice")
		И НЕ ЗначениеЗаполнено(ДанныеФайла.ContractPrice)
		И (НЕ ДанныеФайла.Свойство("ЦенаНеУказана")
		ИЛИ НЕ ДанныеФайла.ЦенаНеУказана) Тогда
		ДобавитьОшибкуВалидации(Результат, " - Цена");
	КонецЕсли;
	
	Результат = ОформитьОшибкиВHTML(Результат, "Необходимо заполнить следующие поля:");
	Возврат Результат;
	
КонецФункции

Функция ВалидацияПротоКонтента(ПротоКонтент, ФорматОтправки) Экспорт
	
	БазовыеФорматы	= БазовыеФорматы();
	БазовыйФормат	= ФорматОтправки.БазовыйФормат;
	
	Если БазовыйФормат = БазовыеФорматы.utd820 Тогда
		
		ЗаголовокHTML = "При формировании файла УПД обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияUTD820(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.utd Тогда
		
		ЗаголовокHTML = "При формировании файла УПД обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияUTD(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.ucd736 Тогда
		
		ЗаголовокHTML = "При формировании файла УКД обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияUCD736(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.ucd Тогда
		
		ЗаголовокHTML = "При формировании файла УКД обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияUCD(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.torg12 Тогда
		
		ЗаголовокHTML = "При формировании файла накладной обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияXmlTorg12Content(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.act Тогда
		
		ЗаголовокHTML = "При формировании файла акта обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияXmlAcceptanceCertificateContent(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.invoice Тогда
		
		ЗаголовокHTML = "При формировании файла счета-фактуры обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияInvoiceContent(ПротоКонтент);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.invoicecor Тогда
		
		ЗаголовокHTML = "При формировании файла корректировочного счета-фактуры обнаружены следующие ошибки:";
		СписокОшибок = ВалидацияInvoiceCorrectionContent(ПротоКонтент);
		
	КонецЕсли;
	
	Если ПротоКонтент.Свойство("ОшибкиВДанных") Тогда
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ПротоКонтент.ОшибкиВДанных, "Ошибки в данных");
	КонецЕсли;
	
	Результат = ОформитьОшибкиВHTML(СписокОшибок, ЗаголовокHTML);
	
	Возврат Результат;
	
КонецФункции

