// Формирует представление для формата электронных документов
// для отображения в пользовательском интерфейсе
//
// Параметры:
//  ИмяТипа			 - Строка - см. ИдентификаторыТиповДокументов;
//  ФункцияДокумента - Строка - см. ФункцииЭлектронныхДокументов;
// 
// Возвращаемое значение:
//  Строка - представление формата ЭД.
//
Функция ПредставлениеФорматаЭД(ИмяТипа, ФункцияДокумента)
	
	ПредставлениеТипа	 = ПредставлениеТипаЭлектронногоДокумента(ИмяТипа);
	ПредставлениеФункции = ПредставлениеФункцииЭлектронногоДокумента(ФункцияДокумента);
	
	Результат = ПредставлениеТипа;
	Если ЗначениеЗаполнено(ПредставлениеФункции) Тогда
		Результат = Результат + " " + ПредставлениеФункции;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление типа электронного документа для отображения
// в пользовательском интерфейсе.
//
// Параметры:
//  ИмяТипа - Строка - см. ИдентификаторыТиповДокументов;
// 
// Возвращаемое значение:
//  Строка.
//
Функция ПредставлениеТипаЭлектронногоДокумента(ИмяТипа)
	
	ТипыДокументов = ИдентификаторыТиповДокументов();
	
	ПредставленияТипов = Новый Соответствие;
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalTransferDocument
	, НСтр("ru = 'УПД'; en = 'UTD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalTransferDocumentRevision
	, НСтр("ru = 'ИУПД'; en = 'Revision of UTD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalCorrectionDocument
	, НСтр("ru = 'УКД'; en = 'UAD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalCorrectionDocumentRevision
	, НСтр("ru = 'ИУКД'; en = 'Revision of UAD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.XmlTorg12
	, НСтр("ru = 'Торг-12'; en='TORG-12'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.Torg12
	, НСтр("ru = 'Торг-12'; en='TORG-12'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.XmlAcceptanceCertificate
	, НСтр("ru = 'Акт'; en='Act'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.AcceptanceCertificate
	, НСтр("ru = 'Акт'; en='Act'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.Invoice
	, НСтр("ru = 'Счет-фактура'; en='Tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.InvoiceRevision
	, НСтр("ru = 'Исправление СФ'; en='Revision of tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.InvoiceCorrection
	, НСтр("ru = 'Корректировочный СФ'; en = 'Corrective tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.InvoiceCorrectionRevision
	, НСтр("ru = 'Исправление КСФ'; en = 'Revision of corrective tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.ProformaInvoice
	, НСтр("ru = 'Счет на оплату'; en='Proforma invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.ReconciliationAct
	, НСтр("ru = 'Акт сверки'; en='Reconciliation act'"));
	
