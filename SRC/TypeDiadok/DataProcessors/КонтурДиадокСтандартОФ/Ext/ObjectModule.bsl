Функция ЭДО_Кэш_Прочитать(ИмяЗначения) Экспорт
	
	Возврат Кэш_Прочитать(ИмяЗначения);
	
КонецФункции

// Устарела, следует использовать Кэш_Поместить
//
Процедура ЭДО_Кэш_Поместить(ИмяЗначения, Значение) Экспорт
	
	Кэш_Поместить(ИмяЗначения, Значение);
	
КонецПроцедуры

Функция Кэш_Прочитать(ИмяЗначения) Экспорт
	
	Результат = Неопределено;
	
	Если Кэш <> Неопределено Тогда
		Результат = Кэш[ИмяЗначения];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура Кэш_Поместить(ИмяЗначения, Значение) Экспорт
	
	Если Кэш = Неопределено Тогда
		Кэш = Новый Соответствие;
	КонецЕсли;
	
	Кэш.Вставить(ИмяЗначения, Значение);
	
КонецПроцедуры

