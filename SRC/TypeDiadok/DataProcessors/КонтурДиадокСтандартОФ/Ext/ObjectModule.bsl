	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Создает внешнюю обработку без предупреждения об опасных действиях. 
//
Функция ВнешниеОбработки_СоздатьБезПредупреждений(ДвоичныеДанные)
	
	ОписаниеЗащитыБезПредупреждений = ОписаниеЗащитыБезПредупреждений();
	
	Если СравнитьВерсии(ВерсияПриложения(), "8.2") = "ПерваяМеньше" Тогда
		// В 8.1 нет возможности подключения обработки через временное хранилище.
		ПодключитьЧерезВременноеХранилище = Ложь;
	Иначе
		#Если Клиент Тогда
			ПодключитьЧерезВременноеХранилище = Ложь;
		#Иначе
			ПодключитьЧерезВременноеХранилище = Истина;
		#КонецЕсли
	КонецЕсли;
	
	Если ПодключитьЧерезВременноеХранилище Тогда 
		
		АдресОбработки = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		// BSLLS:UsingExternalCodeTools-off
		Если ОписаниеЗащитыБезПредупреждений = Неопределено Тогда
			ИмяОбработки = ВнешниеОбработки.Подключить(АдресОбработки, , Ложь);
		Иначе
			ИмяОбработки = ВнешниеОбработки.Подключить(АдресОбработки, , Ложь, ОписаниеЗащитыБезПредупреждений);
		КонецЕсли;
		// BSLLS:UsingExternalCodeTools-on
		
		УдалитьИзВременногоХранилища(АдресОбработки);
		
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ИмяОбработки, Ложь);
		// BSLLS:UsingExternalCodeTools-on
		
	Иначе
		
		ИмяВремФайла = ПолучитьИмяВременногоФайла("epf");
		
		ДвоичныеДанные.Записать(ИмяВремФайла);
		
		Результат = ВнешниеОбработки_Создать(ИмяВремФайла);
		
		УдалитьФайлы(ИмяВремФайла);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обертка для создания внешних обработок по имени файла, разными версиями платформы.
//
Функция ВнешниеОбработки_Создать(ИмяФайла)
	
	Результат = Неопределено;
	
	ВерсияПриложения = ВерсияПриложения();
	
	Если СравнитьВерсии(ВерсияПриложения, "8.3.11") <> "ПерваяМеньше" Тогда
		
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ИмяФайла, Ложь, ОписаниеЗащитыБезПредупреждений());
		// BSLLS:UsingExternalCodeTools-on
		
	ИначеЕсли СравнитьВерсии(ВерсияПриложения, "8.2") <> "ПерваяМеньше" Тогда
		
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
		// BSLLS:UsingExternalCodeTools-on
		
	Иначе
		
		// BSLLS:UsingExternalCodeTools-off
		Результат = ВнешниеОбработки.Создать(ИмяФайла);  // 8.1
		// BSLLS:UsingExternalCodeTools-on
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Возвращает ОписаниеЗащитыОтОпасныхДействий, если возможно.
//
Функция ОписаниеЗащитыБезПредупреждений()
	
	Результат = Неопределено;
	
	Попытка
		Результат = Новый("ОписаниеЗащитыОтОпасныхДействий");
		Результат.ПредупреждатьОбОпасныхДействиях = Ложь;
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(
			СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			Неопределено,
			Неопределено,
			ПодробноеПредставлениеОшибки(Ошибка)
		);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМодульПрог(ИмяМодуля) Экспорт
	
	Результат = КэшМодулей()[ИмяМодуля];
	
	Если Результат = Неопределено Тогда
		
		Если Метаданные().Формы.Найти(ИмяМодуля) = Неопределено Тогда
			
			Результат = ВнешняяОбработкаИзМакета(ИмяМодуля);
			
		Иначе
			
			Попытка
				Результат = ПолучитьФорму(ИмяМодуля);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
				ОписаниеОшибки = "Ошибка получения формы обработки """ + ИмяМодуля + """:" + ОписаниеОшибки;
				ВызватьИсключение ОписаниеОшибки;
			КонецПопытки;
			
		КонецЕсли;
		
		КэшМодулей().Вставить(ИмяМодуля, Результат);
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Функция СуществуетОбъектМетаданных(ПолноеИмяОбъекта) Экспорт
	
	КэшСуществуетОбъектМетаданных = ЭДО_Кэш_Прочитать("КэшСуществуетОбъектМетаданных");
	
	Если КэшСуществуетОбъектМетаданных = Неопределено Тогда
		КэшСуществуетОбъектМетаданных = Новый Соответствие;
		ЭДО_Кэш_Поместить("КэшСуществуетОбъектМетаданных", КэшСуществуетОбъектМетаданных);
	КонецЕсли;
	
	Результат = КэшСуществуетОбъектМетаданных[ПолноеИмяОбъекта];
	
	Если Результат = Неопределено Тогда
		Результат = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта) <> Неопределено;
		КэшСуществуетОбъектМетаданных.Вставить(ПолноеИмяОбъекта, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

