	Таблица.Колонки.Добавить("ПрослеживаемыйТовар");
	Таблица.Колонки.Добавить("ИдентификаторСтроки");
	
КонецПроцедуры

Функция ТЧПолучитьДанныеЗапроса(ДокументСсылка, СчетФактура, ЭтоКСФ, ЭтоУКД_Дис = Ложь)
	
	СтандартнаяОбработка = Истина;
	
	Если СчетФактура = Неопределено И Не ЭтоУКД_Дис Тогда
		ТабличнаяЧасть = ИнициализацияТаблицыТоваров();
	Иначе
		ТабличнаяЧасть = ИнициализацияТаблицыСФ(ЭтоКСФ);
	КонецЕсли;
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("ДокументСсылка", ДокументСсылка);
	ПараметрыСобытия.Вставить("СчетФактура"	  , СчетФактура);
	ПараметрыСобытия.Вставить("ЭтоКСФ"		  , ЭтоКСФ);
	ПараметрыСобытия.Вставить("ТабличнаяЧасть", ТабличнаяЧасть);
	
	ОбработкаСобытияПодключаемогоМодуля("ДанныеДляКонтента_ТабличнаяЧасть", ПараметрыСобытия, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка = Ложь Тогда
		Возврат ПараметрыСобытия.ТабличнаяЧасть;
	Иначе
		
		РезультатЗапроса = Модуль_Интеграция.ПолучитьРезультатЗапросаТЧ(ДокументСсылка, СчетФактура, ЭтоКСФ);
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			РезультатЗапроса = Неопределено;
			
			Пока Выборка.Следующий() Цикл
				
				СтрокаДанных = ТабличнаяЧасть.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаДанных, Выборка);
				
				СтрокаДанных.КодЕдиницыИзмерения	= СокрЛП(СтрокаДанных.КодЕдиницыИзмерения);
				СтрокаДанных.КодНоменклатуры		= СокрЛП(СтрокаДанных.КодНоменклатуры);
				СтрокаДанных.ДопИнфо 				= Новый Массив;
				
				Если ЭтоКСФ Тогда
					СтрокаДанных.КодЕдиницыИзмеренияДоИзменения = СокрЛП(Выборка.КодЕдиницыИзмеренияДоИзменения);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаДанных.ПризнакТРУ) Тогда
					
					Если СтрокаДанных.ЭтоУслуга Тогда 
						СтрокаДанных.ПризнакТРУ = "Service";
					Иначе
						// Все, что не является услугой, по умолчанию считаем имуществом.
						// Если надо что-то другое, можно переопределить в подключаемом модуле.
						СтрокаДанных.ПризнакТРУ = "Property";
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ИспользуетсяУчетПрослеживаемыхТоваров(ДокументСсылка.Дата) Тогда
			Модуль_Интеграция.ЗаполнитьСведенияПрослеживаемостиДляОтправки(ТабличнаяЧасть, ДокументСсылка);
		КонецЕсли; 
		
		Возврат ТабличнаяЧасть;
		
	КонецЕсли;
	
КонецФункции

Функция ДанныеДляФормированияТорг12(ДокССылка, ЭтоАкт, ЭтоУПД) Экспорт
	
	ДанныеДляФормированияТорг12 = Новый Структура;
	
	ДокТоварный = ?(ПроверитьТипДокумента(Докссылка, "РеализацияОтгруженныхТоваров"), ДокССылка.ДокументОтгрузки, ДокССылка);
	
	СуммаВключаетНДС 		= ?(ДокТоварный.Метаданные().Реквизиты.Найти("СуммаВключаетНДС") = Неопределено, Истина, ДокТоварный.СуммаВключаетНДС);
	СуммаДокумента 			= Модуль_Интеграция.ПолучитьСуммуДокумента(ДокТоварный);
	СуммаНДСДокумента		= Модуль_Интеграция.ПолучитьСуммуНДС(ДокТоварный);
	СуммаБезНДСДокумента	= СуммаДокумента - СуммаНДСДокумента;
	
	ДанныеШапки = Модуль_Интеграция.ПолучитьСтруктуруШапки(ДокТоварный);
	ДанныеШапки.Вставить("Подразделение"	, Модуль_Интеграция.ПолучитьПодразделениеИзДокумента(ДокТоварный));
	ДанныеШапки.Вставить("Номер"			, Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(ДокТоварный));
	ДанныеШапки.Вставить("Дата"				, ДокТоварный.Дата);
	ДанныеШапки.Вставить("СуммаВключаетНДС"	, СуммаВключаетНДС);
	ДанныеШапки.Вставить("НДСИсчисляетсяНалоговымАгентом",	НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокТоварный));
	
	ДанныеШапки.Вставить("СуммаДокумента"		, СуммаДокумента);
	ДанныеШапки.Вставить("СуммаНДСДокумента"	, СуммаНДСДокумента);
	ДанныеШапки.Вставить("СуммаБезНДСДокумента"	, СуммаБезНДСДокумента);
	
	ТаблицаТоваров = ПолучитьДанныеТабличнойЧастиДляДокументаРеализации(ДокТоварный, ДанныеШапки, ЭтоУПД);
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		
		Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
			СтрокаТЧ.СтавкаНДС = СтавкаНДС_ИсчНалАг();
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеДляФормированияТорг12.Вставить("БанковскийСчетОрганизации", Модуль_Интеграция.ПолучитьБанковскийСчетПоДокументу(ДокТоварный));
	ДанныеДляФормированияТорг12.Вставить("СтруктураДоговора"		, Модуль_Интеграция.ПолучитьСтруктуруОснования(ДокССылка, ЭтоАкт, ЭтоУПД));
	ДанныеДляФормированияТорг12.Вставить("ТаблицаТоваров"			, ТаблицаТоваров);
	ДанныеДляФормированияТорг12.Вставить("ДанныеШапки"				, ДанныеШапки);
	
	Возврат ДанныеДляФормированияТорг12;
	
КонецФункции

// Проверяет, есть ли в договоре данного документа флаг "НДС исчисляется налоговым агентом"
// Возможно, тут еще надо проверять дату: Константы.ДатаНачалаОперацийСТоварамиОблагаемымиНДСУПокупателя
Функция НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокументСсылка)
	
	Возврат Модуль_Интеграция.НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокументСсылка);
	
КонецФункции // НДСПоДокументуИсчисляетсяНалоговымАгентом()

Функция ПолучитьДанныеТабличнойЧастиДляДокументаРеализации(ДокументСсылка, ДанныеШапки, ЭтоУПД) Экспорт
	
	МассивСтрокДляУдаления = Новый Массив();
	
	ТабличнаяЧасть = ТЧПолучитьДанныеЗапроса(ДокументСсылка, Неопределено, Ложь);
	
	ЭтоАкт = ДанныеШапки.Свойство("ЭтоАкт");	
	
	ТребуетсяПерезаполнитьСуммыПоУЕвРублях = Модуль_Интеграция.ТребуетсяПерезаполнитьСуммыПоУЕвРублях(ДокументСсылка, , , ЭтоАкт);
	
	Если ТребуетсяПерезаполнитьСуммыПоУЕвРублях Тогда 
		Модуль_Интеграция.ПерезаполнитьСуммыПоУЕвРублях(ТабличнаяЧасть, ДокументСсылка, ДанныеШапки);
	КонецЕсли;
	
	Для каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		СтрокаТЧ.СтавкаНДС 			= Модуль_Интеграция.ПолучитьПредставлениеСтавкиНДС(СтрокаТЧ.СтавкаНДС, ЭтоУПД);
		СтрокаТЧ.КодНоменклатуры 	= Модуль_Интеграция.ПолучитьКодНоменклатурыДляТорг12(СтрокаТЧ.КодНоменклатуры, СтрокаТЧ.НоменклатураСсылка);
		СтрокаТЧ.Номенклатура		= СтрокаТЧ.Номенклатура + Модуль_Интеграция.ПолучитьПредставлениеХарактеристикиИСерии(СтрокаТЧ);
		
		ОчиститьСсылкиСтраныИГТДВСтрокеТабЧасти(СтрокаТЧ);
		
		Если СтрокаТЧ.Сумма = 0 И СтрокаТЧ.Количество = 0 Тогда
			МассивСтрокДляУдаления.Добавить(СтрокаТЧ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивСтрокДляУдаления.Количество() = ТабличнаяЧасть.Количество() Тогда 
		МассивСтрокДляУдаления = Новый Массив;
	КонецЕсли;
	
	Для каждого СтрокаНаУдаление Из МассивСтрокДляУдаления Цикл
		ТабличнаяЧасть.Удалить(СтрокаНаУдаление);
	КонецЦикла;
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

//} ФОРМИРОВАНИЕ XML Торг-12

//{ ФОРМИРОВАНИЕ СФ

Функция ВСтрокеКСФНетИзменений(СтрокаТЧ)
	
	Если СтрокаТЧ.ЕдиницаИзмеренияДоИзменения = СтрокаТЧ.ЕдиницаИзмерения
		И СтрокаТЧ.КоличествоДоИзменения = СтрокаТЧ.Количество
		И СтрокаТЧ.ЦенаДоИзменения = СтрокаТЧ.Цена
		И СтрокаТЧ.СуммаДоИзменения = СтрокаТЧ.Сумма
		И СтрокаТЧ.СуммаНДСДоИзменения = СтрокаТЧ.СуммаНДС
		И СтрокаТЧ.СтавкаНДСДоИзменения = СтрокаТЧ.СтавкаНДС
		И СтрокаТЧ.СуммаДоИзменения = СтрокаТЧ.Сумма
		Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеТабличнойЧастиДляСФ(ДокументРеализации, СчетФактура, ЭтоКСФ = Ложь, ТребуетсяПерезаполнитьСуммыПоУЕвРублях, ЭтоУКД_Дис = Ложь, ДанныеШапки = Неопределено) 
	
	МассивСтрокДляУдаления =	Новый Массив();
	
	ТабличнаяЧасть = ТЧПолучитьДанныеЗапроса(ДокументРеализации, СчетФактура, ЭтоКСФ, ЭтоУКД_Дис);
	
	Если ТребуетсяПерезаполнитьСуммыПоУЕвРублях Тогда 
		Модуль_Интеграция.ПерезаполнитьСуммыПоУЕвРублях(ТабличнаяЧасть, ДокументРеализации, ДанныеШапки);
	КонецЕсли;	
	
	ЕстьЕдиницаИзмеренияДоИзменения = ТабличнаяЧасть.Колонки.Найти("ЕдиницаИзмеренияДоИзменения") <> Неопределено;
	
	Для каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Если ЭтоКСФ = Истина И ВСтрокеКСФНетИзменений(СтрокаТЧ) Тогда
			МассивСтрокДляУдаления.Добавить(СтрокаТЧ);
		ИначеЕсли ЭтоКСФ = Ложь И СтрокаТЧ.Сумма = 0 И СтрокаТЧ.Количество = 0 Тогда
			МассивСтрокДляУдаления.Добавить(СтрокаТЧ);
		КонецЕсли;
		
		СтрокаТЧ.СтавкаНДС = Модуль_Интеграция.ПолучитьПредставлениеСтавкиНДС(СтрокаТЧ.СтавкаНДС, Истина);
		Если ЭтоКСФ = Истина Тогда
			СтрокаТЧ.СтавкаНДСДоИзменения = Модуль_Интеграция.ПолучитьПредставлениеСтавкиНДС(СтрокаТЧ.СтавкаНДСДоИзменения, Истина);
		КонецЕсли;
		
		СтрокаТЧ.Номенклатура = СтрокаТЧ.Номенклатура + Модуль_Интеграция.ПолучитьПредставлениеХарактеристикиИСерии(СтрокаТЧ);
		
		Если ИмяФормыПрикладногорешенияДляИнтеграцииДиадок() = "Модуль_ИнтеграцияАльфаАвто41" Тогда
			
			ЭтоАвторабота = Модуль_Интеграция.ЭтоАвторабота(СтрокаТЧ.НоменклатураСсылка);
			
			Если ЭтоАвторабота Тогда
				СтрокаТЧ.ЕдиницаИзмерения = СчетФактура.ДоговорВзаиморасчетов.ЕдиницаИзмеренияАвтоработВПечатныхФормах;
				СтрокаТЧ.КодЕдиницыИзмерения = "356";
				
				Если ЕстьЕдиницаИзмеренияДоИзменения Тогда
					СтрокаТЧ.ЕдиницаИзмеренияДоИзменения = СчетФактура.ДоговорВзаиморасчетов.ЕдиницаИзмеренияАвтоработВПечатныхФормах;
					СтрокаТЧ.КодЕдиницыИзмеренияДоИзменения = "356";
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если (ЭтоКСФ = Ложь) И (МассивСтрокДляУдаления.Количество() = ТабличнаяЧасть.Количество()) Тогда 
		// Если в ИСФ нет ненулевых строк - Тогда выводим все строки с 0-м
		МассивСтрокДляУдаления =	Новый Массив();
	КонецЕсли;
	
	Для каждого СтрокаНаУдаление Из МассивСтрокДляУдаления Цикл
		ТабличнаяЧасть.Удалить(СтрокаНаУдаление);
	КонецЦикла;
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

Функция СтранаЧленТС(Знач КодСтраны)
	
	СтраныТС = Новый Массив;
	СтраныТС.Добавить("643"); // Россия
	СтраныТС.Добавить("051"); // Армения
	СтраныТС.Добавить("112"); // Беларусь
	СтраныТС.Добавить("398"); // Казахстан
	СтраныТС.Добавить("417"); // Киргизия
	СтраныТС.Добавить("981"); // ЕАЭС
	
	КодСтраны = СокрЛП(КодСтраны);
	
	Результат = СтраныТС.Найти(КодСтраны) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция СтранаРФ(Знач КодСтраны)
	
	КодСтраны = СокрЛП(КодСтраны);
	
	Результат = КодСтраны = "643";
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуСФ(СчетФактура, МассивДокументовОснований, ЭтоКСФ, ЭтоУКД_Дис = Ложь, ДанныеШапки = Неопределено)
	
	ТабличнаяЧасть = ИнициализацияТаблицыСФ(ЭтоКСФ);
	
	Для каждого ДокументОснование Из МассивДокументовОснований Цикл
		
		ДокТоварный = ?(ПроверитьТипДокумента(ДокументОснование, "РеализацияОтгруженныхТоваров"), ДокументОснование.ДокументОтгрузки, ДокументОснование);
		ТребуетсяПерезаполнитьСуммыПоУЕвРублях = Модуль_Интеграция.ТребуетсяПерезаполнитьСуммыПоУЕвРублях(ДокТоварный, СчетФактура, Истина);
		ДанныеТЧ = ПолучитьДанныеТабличнойЧастиДляСФ(ДокТоварный, СчетФактура, ЭтоКСФ, ТребуетсяПерезаполнитьСуммыПоУЕвРублях, ЭтоУКД_Дис, ДанныеШапки);
		
		Для каждого СтрокаДанных Из ДанныеТЧ Цикл
			
			СтрокаСФ = ТабличнаяЧасть.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСФ, СтрокаДанных);
			СтрокаСФ.КодНоменклатуры = Модуль_Интеграция.ПолучитьКодНоменклатурыДляТорг12(СтрокаСФ.КодНоменклатуры, СтрокаСФ.НоменклатураСсылка);
			
			Если ИмяФормыПрикладногорешенияДляИнтеграцииДиадок() = "Модуль_ИнтеграцияАльфаАвто41" Тогда
				
				Модуль_ИнтеграцияАльфаАвто = ПолучитьМодульПрог("Модуль_ИнтеграцияАльфаАвто41");
				
				СтрокаСФ.НоменклатураСсылка = Модуль_ИнтеграцияАльфаАвто.ВернутьСсылкуНаНоменклатуру(СтрокаДанных.НоменклатураСсылка);
				
				ЭтоУслуга = Модуль_ИнтеграцияАльфаАвто.ЭтоУслуга(СтрокаСФ.НоменклатураСсылка);
				ЭтоАвторабота = Модуль_ИнтеграцияАльфаАвто.ЭтоАвторабота(СтрокаДанных.НоменклатураСсылка);
				
				СтрокаСФ.ЭтоУслуга = ЭтоУслуга;
				
				Если ЭтоУслуга
					И НЕ ЭтоАвторабота
					И ЗначениеЗаполнено(СтрокаСФ.ЕдиницаИзмерения)
					И СтрокаСФ.ЕдиницаИзмерения.Наименование = "-" Тогда
					
					СтрокаСФ.ЕдиницаИзмерения 		= Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
					СтрокаСФ.КодЕдиницыИзмерения 	= "";
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОчиститьСсылкиСтраныИГТДВСтрокеТабЧасти(СтрокаСФ);
			
		КонецЦикла;
		
	КонецЦикла;
	
	КолонкиСуммирования = Новый Массив;
	КолонкиСуммирования.Добавить("Количество");
	КолонкиСуммирования.Добавить("Масса");
	КолонкиСуммирования.Добавить("СуммаНДС");
	КолонкиСуммирования.Добавить("Сумма");
	КолонкиСуммирования.Добавить("ДопИнфо");
	
	Если ЭтоКСФ Тогда
		КолонкиСуммирования.Добавить("КоличествоДоИзменения");
		КолонкиСуммирования.Добавить("СуммаНДСДоИзменения");
		КолонкиСуммирования.Добавить("СуммаДоИзменения");
	КонецЕсли;
	
	СписокКолонокДляСвертки = "";
	РазделительСписка 		= "";
	Для Каждого ТекКолонка Из ТабличнаяЧасть.Колонки Цикл
		
		КолонкаИсключение = "ИдентификаторСтроки";
		
		Если КолонкиСуммирования.Найти(ТекКолонка.Имя) = Неопределено
			И НРег(ТекКолонка.Имя) <> НРег(КолонкаИсключение) Тогда
			
			СписокКолонокДляСвертки = СписокКолонокДляСвертки + РазделительСписка + ТекКолонка.Имя; 
			РазделительСписка = ",";
		КонецЕсли;
		
	КонецЦикла;
	ТабличнаяЧасть.Свернуть(СписокКолонокДляСвертки, "Количество,Масса,СуммаНДС,Сумма" + ?(ЭтоКСФ, ",КоличествоДоИзменения,СуммаНДСДоИзменения,СуммаДоИзменения", ""));
	
	ТабличнаяЧасть.Колонки.Добавить("ДопИнфо");
	Для каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		СтрокаТЧ.ДопИнфо = Новый Массив;
	КонецЦикла;
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

Функция ДанныеДляФормированияСчетФактуры(СчетФактура, ЭтоКСФ) Экспорт
	
	МассивДокументовОснований =	Модуль_Интеграция.ПолучитьМассивСсылокРНКПоСчетуФактуреВыданному(СчетФактура);
	Если МассивДокументовОснований.Количество() = 0 Тогда
		ВызватьИсключение "Для " + СчетФактура + " не найдены документы основания";
	КонецЕсли;
	
	ДокументОснование	= МассивДокументовОснований[0];
	ДокТоварный 		= ?(ПроверитьТипДокумента(ДокументОснование, "РеализацияОтгруженныхТоваров"), ДокументОснование.ДокументОтгрузки, ДокументОснование);
	ДанныеСФ 			= Модуль_Интеграция.ПолучитьСтруктуруШапки(ДокТоварный, СчетФактура);
	
	Если ЭтоКСФ = Истина Тогда 
		ДанныеСФ.Вставить("НомераДляКСФ", Модуль_Интеграция.ПолучитьНомераДляКСФ(СчетФактура));
	Иначе 	
		ДанныеСФ.Вставить("НомераДляСФ", Модуль_Интеграция.ПолучитьНомераДляСФ(СчетФактура));
	КонецЕсли;	
	ДанныеСФ.Вставить("СФНаАванс", Модуль_Интеграция.ЭтоСчетФактуранаАванс(СчетФактура));
	ДанныеСФ.Вставить("ДатаНомерСвидетельстваОРегистрации", Модуль_Интеграция.ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(СчетФактура.Организация));
	ДанныеСФ.Вставить("КПППокупателя", Модуль_Интеграция.ПолучитьКПППокупателя(СчетФактура)); 
	ДанныеСФ.Вставить("ДатаНомерДокументовОплаты", Модуль_Интеграция.ПолучитьДатуНомерДокументовОплаты(СчетФактура));
	ДанныеСФ.Вставить("НДСИсчисляетсяНалоговымАгентом",	НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокТоварный));
	
	ДанныеСФ.Вставить("СуммаДокумента"		, Неопределено);
	ДанныеСФ.Вставить("СуммаНДСДокумента"	, Неопределено);
	ДанныеСФ.Вставить("СуммаБезНДСДокумента", Неопределено);
	
	ДанныеСФ.Вставить("ТабличнаяЧасть", ПолучитьТаблицуСФ(СчетФактура, МассивДокументовОснований, ЭтоКСФ, Ложь, ДанныеСФ));
	
	Если ДанныеСФ.НДСИсчисляетсяНалоговымАгентом Тогда
		
		ЕстьРеквизитСтавкаНДСДоИзменения = (НЕ ДанныеСФ.ТабличнаяЧасть.Колонки.Найти("СтавкаНДСДоИзменения") = Неопределено);
		
		Для Каждого СтрокаТЧ Из ДанныеСФ.ТабличнаяЧасть Цикл
			СтрокаТЧ.СтавкаНДС = СтавкаНДС_ИсчНалАг();
			Если ЕстьРеквизитСтавкаНДСДоИзменения Тогда
				СтрокаТЧ.СтавкаНДСДоИзменения = СтавкаНДС_ИсчНалАг();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ДанныеСФ.ТабличнаяЧасть.НайтиСтроки(Новый Структура("ЭтоУслуга", Ложь)).Количество() = 0 Тогда 
		ДанныеСФ.Грузоотправитель	= "";
		ДанныеСФ.Грузополучатель	= "";
	Иначе
		Если ИмяМодуляИнтеграции = "Модуль_ИнтеграцияАльфаАвто41" Тогда
			Если ЗначениеЗаполнено(СчетФактура.Грузополучатель) Тогда
				ДанныеСФ.Грузополучатель = СчетФактура.Грузополучатель;
			КонецЕсли;
			Если ДанныеСФ.Организация = ДанныеСФ.Грузоотправитель Тогда
				ДанныеСФ.Грузоотправитель = "он же";	
			КонецЕсли;
		Иначе
			Если ДанныеСФ.Свойство("Поставщик") И ДанныеСФ.Поставщик <> ДанныеСФ.Организация Тогда
				ДанныеСФ.Грузоотправитель = ДанныеСФ.Организация;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДанныеСФ;
	
КонецФункции 	

//} ФОРМИРОВАНИЕ СФ

//{ ВНЕШНЯЯ ПЕЧАТНАЯ ФОРМА

Функция СформироватьВнешнююПечатнуюФормуДокументаПакета(ДокументПакета, Организация, ПараметрыСогласования = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	DocumentType	 = ДокументПакета.DocumentType;
	ВидДокумента	 = ДокументПакета.ТипДокумента;
	ДокументСсылка	 = ДокументПакета.Документ;
	
	Если ЗначениеЗаполнено(ДокументПакета.ВнешняяПечатнаяФорма) Тогда
		
		ВнешняяПечатнаяФорма = ДокументПакета.ВнешняяПечатнаяФорма;
		
	Иначе
		
		НастройкиВПФ = Модуль_Данные1С_СвязиОбъектов().ПолучитьНастройкиВнешнихПечатныхФормДляДиадок(Организация);
		
		Если DocumentType = "XmlAcceptanceCertificate" Тогда
			
			ВнешняяПечатнаяФорма = НастройкиВПФ.ДиадокВнешняяПечатнаяФормаАкта;
			
		ИначеЕсли DocumentType = "NonformalizedProforma" Тогда
			
			ВнешняяПечатнаяФорма = НастройкиВПФ.ДиадокВнешняяПечатнаяФормаСчета;
			
		ИначеЕсли DocumentType = "ReconciliationAct" Тогда
			
			ВнешняяПечатнаяФорма = НастройкиВПФ.ДиадокВнешняяПечатнаяФормаСверки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВнешняяПечатнаяФорма) Тогда
		
		Результат = СформироватьВнешнююПечатнуюФорму(ДокументСсылка, ВнешняяПечатнаяФорма, ВидДокумента);
		
	Иначе
		
		Если DocumentType = "NonformalizedProforma" Тогда
			
			Результат = СформироватьПечатнуюФормуСчетаНаОплату(ДокументСсылка, ПараметрыСогласования);
			
		ИначеЕсли DocumentType = "ReconciliationAct" Тогда
			
			Результат = СформироватьПечатнуюФормуАктаСверки(ДокументСсылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат)
		И DocumentType = "XmlAcceptanceCertificate" Тогда
		Результат.Вставить("DocumentType", "AcceptanceCertificate"); // Полуформализованный Акт
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыОтправкиВПФ(ИдентификаторВПФ, ДокументСсылка) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Выгружать"					, Истина);
	Результат.Вставить("ВыгружатьEXEL"				, Ложь);
	Результат.Вставить("ТребоватьОтветнойПодписи"	, Истина);
	
	ПараметрыОтправки = Модуль_Интеграция.ВПФ_РезультатФункции(ИдентификаторВПФ, "ПолучитьПараметрыОтправкиЧерезДиадок", ДокументСсылка);
	
	Если ЗначениеЗаполнено(ПараметрыОтправки) Тогда
		ДополнитьСтруктуруСоответствие(Результат, ПараметрыОтправки);
	КонецЕсли;
	
	Если Не Результат.Свойство("ФорматФайла") Тогда
		Результат.Вставить("ФорматФайла", ?(Результат.ВыгружатьEXEL, "xlsx","pdf"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьВнешнююПечатнуюФорму(ДокументСсылка, ИдентификаторВПФ, ВидДокумента) Экспорт
	
	ПечатнаяФорма = Модуль_Интеграция.ВПФ_Печать(ДокументСсылка, ИдентификаторВПФ);
	ПараметрыОтправки = ПараметрыОтправкиВПФ(ИдентификаторВПФ, ДокументСсылка);
	
	Дата	 = ДокументСсылка.Дата;
	Номер	 = Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(ДокументСсылка);
	Сумма	 = Модуль_Интеграция.ПолучитьСуммуДокумента(ДокументСсылка);
	ДокументБезНДС = Модуль_Интеграция.ДокументБезНДС(ДокументСсылка);
	
	ФорматФайла = ПараметрыОтправки.ФорматФайла;
	ИмяФайла = ИмяФайлаПечатнойФормы(ВидДокумента, Номер, Дата, ФорматФайла);
	
	Результат = НовыеДанныеВнешнейПечатнойФормы();
	Результат.Таблица	 = ПечатнаяФорма;
	Результат.Дата		 = Дата;
	Результат.Номер		 = Номер;
	Результат.Сумма		 = Сумма;
	Результат.ДокументБезНДС = ДокументБезНДС;
	
	Результат.ИмяФайла = ИмяФайла;
	Результат.ФорматФайла = ФорматФайла;
	Результат.ТребоватьОтветнойПодписи = ПараметрыОтправки.ТребоватьОтветнойПодписи;
	
	Если Не ДокументБезНДС Тогда
		Результат.СуммаНДС = Модуль_Интеграция.ПолучитьСуммуНДС(ДокументСсылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Инициализирует структуру результата формирования внешних печатных форм
//
// Возвращаемое значение:
//  Структура - содержит поля:
//    * Дата           - Дата   - дата документа;
//    * Номер          - Строка - номер документа;
//    * Сумма          - Число  - общая сумма документа;
//    * СуммаНДС       - Число  - общая сумма НДС документа;
//    * ДокументБезНДС - Булево - Истина, если документ не содержит НДС;
//    * ФорматФайла    - Строка - формат в котором файл должен быть отправлен, pdf или xlsx;
//    * ИмяФайла       - Строка - имя файла с расширением;
//    * Таблица        - ТабличныйДокумент - печатная форма документа
//    * ТребоватьОтветнойПодписи - Булево  - Истина, если файл должен быть подписан получаталем;
//
Функция НовыеДанныеВнешнейПечатнойФормы()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Таблица");
	
	Результат.Вставить("Дата");
	Результат.Вставить("Номер");
	
	Результат.Вставить("Сумма");
	Результат.Вставить("СуммаНДС");
	Результат.Вставить("ДокументБезНДС", Ложь);
	
	Результат.Вставить("ИмяФайла");
	Результат.Вставить("ФорматФайла");
	
	Результат.Вставить("ТребоватьОтветнойПодписи", Ложь);
	Результат.Вставить("СписокОшибок", "");
	
	Возврат Результат;
	
КонецФункции

//{ СЧЕТ НА ОПЛАТУ

// Формирует структуру с данными, которые необходимы для визуализации ПФ счета на оплату
//	Параметры:
//		ДокументСчетаНаОплатуСсылка	- ДокументСсылка	- Ссылка на документ, по которому формируется печатная форма
//		ДополнительныеПараметры	- Структура	- дополнительные параметры.
//			* ПараметрыСогласования - Структура - параметры согласования
//			* ФИОПодписанта - Строка
//
//	Возвращаемое значение:
//		Структура - см. НовыеДанныеВнешнейПечатнойФормы()
//	
Функция СформироватьПечатнуюФормуСчетаНаОплату(СсылкаНаДокумент, ДополнительныеПараметры) Экспорт
	
	СтруктураДокумента	 = ДанныеДляФормированияСчетаНаОплату(СсылкаНаДокумент);
	ПечатнаяФорма		 = СформироватьПечатнуюФормуСчетаНаОплатуПоДанным(СтруктураДокумента, ДополнительныеПараметры);
	ДанныеШапки			 = СтруктураДокумента.ДанныеШапки;
	
	ВидДокумента = "Счет";
	ФорматФайла = "pdf";
	ИмяФайла = ИмяФайлаПечатнойФормы(ВидДокумента, ДанныеШапки.Номер, ДанныеШапки.Дата, ФорматФайла);
	
	Результат = НовыеДанныеВнешнейПечатнойФормы();
	Результат.Таблица		 = ПечатнаяФорма;
	Результат.Дата			 = ДанныеШапки.Дата;
	Результат.Номер			 = ДанныеШапки.Номер;
	Результат.Сумма			 = ДанныеШапки.Сумма;
	Результат.ДокументБезНДС = ДанныеШапки.ДокументБезНДС;
	
	Результат.ИмяФайла		 = ИмяФайла;
	Результат.ФорматФайла	 = ФорматФайла;
	Результат.ТребоватьОтветнойПодписи = Ложь;
	
	Если Не Результат.ДокументБезНДС Тогда
		Результат.СуммаНДС = ДанныеШапки.СуммаНДС;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляФормированияСчетаНаОплату(СсылкаНаДокумент)
	
	Номер = Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(СсылкаНаДокумент);
	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеДокумента, "ДокументОтгрузки") Тогда
		
		ДокументОтгрузки = СсылкаНаДокумент.ДокументОтгрузки;
		ДанныеШапки		 = Модуль_Интеграция.ПолучитьСтруктуруШапки(ДокументОтгрузки);
		ТаблицаТоваров	 = ПолучитьДанныеТабличнойЧастиДляСчетаНаОплату(ДокументОтгрузки, ДанныеШапки);
		БанковскийСчетОрганизации		 = Модуль_Интеграция.ПолучитьБанковскийСчетПоДокументу(ДокументОтгрузки);
		НДСИсчисляетсяНалоговымАгентом	 = НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокументОтгрузки);
		
	Иначе
		
		ДанныеШапки		 = Модуль_Интеграция.ПолучитьСтруктуруШапки(СсылкаНаДокумент);
		ТаблицаТоваров	 = ПолучитьДанныеТабличнойЧастиДляСчетаНаОплату(СсылкаНаДокумент, ДанныеШапки);
		БанковскийСчетОрганизации		 = Модуль_Интеграция.ПолучитьБанковскийСчетПоДокументу(СсылкаНаДокумент);
		НДСИсчисляетсяНалоговымАгентом	 = НДСПоДокументуИсчисляетсяНалоговымАгентом(СсылкаНаДокумент);
		
	КонецЕсли;
	
	Сумма	 = 0;
	СуммаНДС = 0;
	ДокументБезНДС = Истина;
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
		
		Сумма	 = Сумма 	+ СтрокаТЧ.Сумма;
		СуммаНДС = СуммаНДС + СтрокаТЧ.СуммаНДС;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.СтавкаНДС)
			И НРег(СтрокаТЧ.СтавкаНДС) <> НРег("без НДС")
			И СтрокаТЧ.СтавкаНДС <> "0" Тогда
			ДокументБезНДС = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ДанныеШапки.СуммаВключаетНДС Тогда
		Сумма = Сумма + СуммаНДС;
	КонецЕсли;
	
	ДанныеШапки.Вставить("Номер"							, Номер);
	ДанныеШапки.Вставить("Сумма"							, Сумма);
	ДанныеШапки.Вставить("СуммаНДС"							, СуммаНДС);
	ДанныеШапки.Вставить("ДокументБезНДС"					, ДокументБезНДС);
	ДанныеШапки.Вставить("БанковскийСчетОрганизации"		, БанковскийСчетОрганизации);
	ДанныеШапки.Вставить("НДСИсчисляетсяНалоговымАгентом"	, НДСИсчисляетсяНалоговымАгентом);
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки"	, ДанныеШапки);
	Результат.Вставить("ТаблицаТоваров"	, ТаблицаТоваров);
	
	Возврат Результат;
	
КонецФункции

// Формирует ПФ счета на оплату по переданным данным документа
//	Параметры:
//		СтруктураДокумента	- Структура	- см. ДанныеДляФормированияСчетаНаОплату()
//		ДополнительныеПараметры	- Структура	- дополнительные параметры.
//			* ПараметрыСогласования - Структура - параметры согласования
//			* ФИОПодписанта - Строка
//
//	Возвращаемое значение:
//		ТабличныйДокумент
//		
Функция СформироватьПечатнуюФормуСчетаНаОплатуПоДанным(СтруктураДокумента, ДополнительныеПараметры)
	
	ДанныеШапки					 = СтруктураДокумента.ДанныеШапки;
	ТаблицаТоваров				 = СтруктураДокумента.ТаблицаТоваров;
	БанковскийСчетОрганизации	 = ДанныеШапки.БанковскийСчетОрганизации;
	
	Таб= Новый ТабличныйДокумент;
	
	Таб.ОриентацияСтраницы= ОриентацияСтраницы.Портрет;
	Таб.АвтоМасштаб= 		Истина;
	
	Макет= ПолучитьМакет("СчетНаОплату");
	
	Область= Макет.ПолучитьОбласть("ШапкаСчета1");
	Если ЗначениеЗаполнено(БанковскийСчетОрганизации) Тогда
		
		Если ДанныеШапки.Свойство("ОрганизацияПолучатель") Тогда
			ОрганизацияПолучатель= ДанныеШапки.ОрганизацияПолучатель;
		Иначе
			ОрганизацияПолучатель= ДанныеШапки.Организация;
		КонецЕсли;
		
		РеквизитыПолучателя= Модуль_Интеграция.ПолучитьРеквизитыОрганизацииДляСчетаНаОплату(ОрганизацияПолучатель, ДанныеШапки.Дата);
		РеквизитыБанковскогоСчета= Модуль_Интеграция.ПолучитьСтруктуруБанковскогоСчета(ОрганизацияПолучатель, БанковскийсчетОрганизации);
		
		Область.Параметры.БанкПолучателя= 	   РеквизитыБанковскогоСчета.Банк;
		Область.Параметры.БИКБанкаПолучателя=  РеквизитыБанковскогоСчета.БИК;
		Область.Параметры.СчетБанкаПолучателя= РеквизитыБанковскогоСчета.КоррСчет;
		Область.Параметры.СчетПолучателя= 	   РеквизитыБанковскогоСчета.НомерСчета;
		Область.Параметры.Получатель= 		   РеквизитыБанковскогоСчета.ТекстПолучателя;
		Область.Параметры.ИННПолучателя= 	   РеквизитыПолучателя.ИНН;
		Область.Параметры.КПППолучателя= 	   РеквизитыПолучателя.КПП;
		
	КонецЕсли;
	Таб.Вывести(Область);
	
	Область=  Макет.ПолучитьОбласть("ШапкаСчета2");
	Область.Параметры.Заголовок = "Счет на оплату № " + ДанныеШапки.Номер + " от " + Формат(ДанныеШапки.Дата, "ДФ=dd.MM.yyyy");
	Таб.Вывести(Область);
	
	Область=  Макет.ПолучитьОбласть("ШапкаСчета3");
	Область.Параметры.Поставщик = Модуль_Интеграция.ПолучитьОписаниеОрганизацииДляСчетаНаОплату(ДанныеШапки.Организация, ДанныеШапки.Дата);
	Таб.Вывести(Область);
	
	Область=  Макет.ПолучитьОбласть("ШапкаСчета4");
	Область.Параметры.Покупатель =  Модуль_Интеграция.ПолучитьОписаниеОрганизацииДляСчетаНаОплату(ДанныеШапки.Контрагент, ДанныеШапки.Дата);
	Таб.Вывести(Область);
	
	Таб.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
	
	СтрокаТаблицы = Макет.ПолучитьОбласть("Строка");
	
	СуммаВсего = 	0;
	СуммаВсегоНДС = 	0;
	Ц = 0;
	
	Для Каждого Стр Из ТаблицаТоваров Цикл
		Ц = Ц + 1;
		СтрокаТаблицы.Параметры.НомерСтроки = 		Ц;
		СтрокаТаблицы.Параметры.Товар = 				Стр.Номенклатура;
		СтрокаТаблицы.Параметры.Количество = 		Стр.Количество;
		СтрокаТаблицы.Параметры.ЕдиницаИзмерения = 	Стр.ЕдиницаИзмерения;
		СтрокаТаблицы.Параметры.Цена = 				Стр.Цена;
		СтрокаТаблицы.Параметры.Сумма = 				Стр.сумма;
		
		СуммаВсего = 	СуммаВсего 		+ Стр.Сумма;
		СуммаВсегоНДС = СуммаВсегоНДС + Стр.СуммаНДС;
		
		Таб.Вывести(СтрокаТаблицы);
	КонецЦикла;
	СуммаВключаетНДС = 	ДанныеШапки.СуммаВключаетНДС;
	СуммаВсегоСНДС = 	СуммаВсего + ?(СуммаВключаетНДС, 0, СуммаВсегоНДС);
	
	Область = Макет.ПолучитьОбласть("Подвал");
	Область.Параметры.Всего = СуммаВсего; 
	Таб.Вывести(Область);
	
	Область= Макет.ПолучитьОбласть("ПодвалНДС");
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		Область.Параметры.НДС = 		"НДС исчисляется налоговым агентом";
		Область.Параметры.ВсегоНДС = "-";	
	ИначеЕсли СуммаВсегоНДС <> 0 Тогда
		Область.Параметры.НДС = 		?(СуммаВключаетНДС, "В том числе НДС:", "Сумма НДС:");
		Область.Параметры.ВсегоНДС = Формат(СуммаВсегоНДС, "ЧЦ=15; ЧДЦ=2");
	Иначе
		Область.Параметры.НДС = 		"Без налога (НДС)";
		Область.Параметры.ВсегоНДС = "-";
	КонецЕсли;
	
	Таб.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ПодвалИтогоКОплате");
	Область.Параметры.ИтогоКОплате = СуммаВсегоСНДС;
	Таб.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ПодвалСуммаПрописью");
	Область.Параметры.ИтоговаяСтрока = "Всего наименований " + ТаблицаТоваров.Количество() 
	+ ", на сумму " + Формат(СуммаВсегоСНДС, "ЧЦ=15; ЧДЦ=2") + " " + СокрП(ДанныеШапки.ВалютаДокумента);
	
	Область.Параметры.СуммаПрописью = ЧислоПрописью(СуммаВсегоСНДС, , ДанныеШапки.ВалютаДокумента.ПараметрыПрописиНаРусском);
	Таб.Вывести(Область);
	
	Область= Макет.ПолучитьОбласть("ПодвалСчета");
	ФИОРуководителя= Модуль_Интеграция.ПолучитьФИОРуководителяДляСчета(ДанныеШапки, ДополнительныеПараметры);
	Область.Параметры.ФИОРуководителя= ФИОРуководителя;
	Таб.Вывести(Область);
	
	Возврат Таб;
	
КонецФункции

Функция ПолучитьДанныеТабличнойЧастиДляСчетаНаОплату(ДокументСсылка, ДанныеШапки) Экспорт
	
	Результат = ТЧПолучитьДанныеЗапроса(ДокументСсылка, Неопределено, Ложь);
	
	Для Сч = - (Результат.Количество() - 1) По 0 Цикл
		
		СтрокаТЧ = Результат[-Сч];
		
		Если СтрокаТЧ.Сумма = 0 И СтрокаТЧ.Количество = 0 Тогда
			
			Результат.Удалить(-Сч);
			
		Иначе
			
			СтрокаТЧ.СтавкаНДС		 = Модуль_Интеграция.ПолучитьПредставлениеСтавкиНДС(СтрокаТЧ.СтавкаНДС, Ложь);
			СтрокаТЧ.КодНоменклатуры = Модуль_Интеграция.ПолучитьКодНоменклатурыДляТорг12(СтрокаТЧ.КодНоменклатуры, СтрокаТЧ.НоменклатураСсылка);
			СтрокаТЧ.Номенклатура	 = СтрокаТЧ.Номенклатура + Модуль_Интеграция.ПолучитьПредставлениеХарактеристикиИСерии(СтрокаТЧ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

