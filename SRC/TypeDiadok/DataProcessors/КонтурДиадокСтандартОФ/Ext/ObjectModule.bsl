// Возвращает представление функции электронного документа для отображения
// в пользовательском интерфейсе.
//
// Параметры:
//  ФункцияДокумента - Строка - см. ФункцииЭлектронныхДокументов;
// 
// Возвращаемое значение:
//  Строка.
//
Функция ПредставлениеФункцииЭлектронногоДокумента(ФункцияДокумента)
	
	ФункцииДокументов = ФункцииЭлектронныхДокументов();
	
	ПредставленияФункций = Новый Соответствие;
	
	ПредставленияФункций.Вставить(ФункцииДокументов.ПоУмолчанию
	, "");
	
	ПредставленияФункций.Вставить(ФункцииДокументов.СЧФДОП
	, НСтр("ru = 'Счф Доп'; en='Invoice and basic'"));
	
	ПредставленияФункций.Вставить(ФункцииДокументов.СЧФ
	, НСтр("ru = 'Счф'; en='Invoice'"));
	
	ПредставленияФункций.Вставить(ФункцииДокументов.ДОП
	, НСтр("ru = 'Доп'; en='Basic'"));
	
	ПредставленияФункций.Вставить(ФункцииДокументов.КСЧФДИС
	, НСтр("ru = 'Ксчф Дис'; en='Invoice and basic'"));
	
	ПредставленияФункций.Вставить(ФункцииДокументов.КСЧФ
	, НСтр("ru = 'Ксчф'; en='Invoice'"));
	
	ПредставленияФункций.Вставить(ФункцииДокументов.ДИС
	, НСтр("ru = 'Дис'; en='Basic'"));
	
	ПредставленияФункций.Вставить(ФункцииДокументов.БезДопИнфо
	, "");
	
	ПредставленияФункций.Вставить(ФункцииДокументов.СДопИнфо
	, "");
	
	Результат = ПредставленияФункций[ФункцияДокумента];
	Если Результат = Неопределено Тогда
		Результат = ФункцияДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует описание формата электронного документа.
//
// Параметры:
//  ИмяТипа			 - Строка - typeNameId (см. ИдентификаторыТиповДокументов())
//  ФункцияДокумента - Строка - Function (см. ФункцииЭлектронныхДокументов())
//  ВерсияФормата	 - Строка - Version (см. значения перечисления ВерсииФорматовЭлектронныхДокументов())
// 
// Возвращаемое значение:
//  Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
Функция ОписаниеФорматаЭлектронногоДокумента(ИмяТипа, ФункцияДокумента, ВерсияФормата) Экспорт
	
	БазовыйФормат	 = БазовыйФорматВерсииКонтента(ВерсияФормата);
	ТипКонтента		 = ТипКонтентаПоБазовомуФормату(БазовыйФормат);
	ТипДокументаCOM	 = ТипДокументаКомпоненты(ИмяТипа);
	Представление	 = ПредставлениеФорматаЭД(ИмяТипа, ФункцияДокумента);
	
	Результат = НовоеОписаниеФорматаЭлектронногоДокумента();
	Результат.ИмяТипа			 = ИмяТипа;
	Результат.ВерсияФормата		 = ВерсияФормата;
	Результат.ФункцияДокумента	 = ФункцияДокумента;
	
	// Расчетные параметры
	Результат.Представление	 = Представление;
	Результат.БазовыйФормат	 = БазовыйФормат;
	Результат.ТипКонтента	 = ТипКонтента;
	Результат.DocumentType	 = ТипДокументаCOM;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

