&НаКлиенте
Процедура Метрики_ДобавитьПоведение_НажатиеСкачатьОнлайнСчет()
	
	НазваниеФормы		= Метрика_НазваниеФормы();
	КатегорияМетрики	= Метрика_НазваниеКатегории();
	ДействиеМетрики		= Метрика_СкачатьСчет();
	
	МетодСервераБезКонтекста(Ложь, "Модуль_Ядро().Метрика_ДобавитьПоведение_НажатиеКнопки", НазваниеФормы, КатегорияМетрики, ДействиеМетрики);
	
КонецПроцедуры

&НаКлиенте
Процедура Метрики_ДобавитьСтатистику_СкачатьОнлайнСчет(BoxId, ИДЛицевогоСчета, ИДТарифа)
	
	Категория				= Метрика_НазваниеКатегории();
	ДействиеМетрики			= Метрика_СкачатьСчет();

		
	Переменные = Новый Соответствие;
	Переменные.Вставить("BoxID"					, BoxId);
	Переменные.Вставить("AccountId"				, ИДЛицевогоСчета);
	Переменные.Вставить("BillId"				, ИДТарифа);
	
	МетодСервераБезКонтекста(Ложь, "Модуль_Ядро().Метрика_ДобавитьСтатистику_ДляОрганизации", boxId, Категория, ДействиеМетрики, , Переменные);
	
КонецПроцедуры

&НаКлиенте
Процедура Метрика_ДобавитьСтатистику_ОнлайнСчетаПослеОткрытия()

	Категория	 		= Метрика_НазваниеКатегории();
	Действие	 		= "Оплатить счет";
	ИдентификаторБазы1С = МетодСервераБезКонтекста(Ложь, "Модуль_Ядро().ОбщиеНастройки_Прочитать", "ИдентификаторБазы1С");
		
	Для Каждого Организация Из СчетаНаОплатуСервиса Цикл
		
		BoxID = МетодСервераБезКонтекста(Ложь, "Модуль_Ядро().АдресЯщикаВИдентификатор", Организация.BoxId);
		
		Для Каждого ОписаниеСчета Из Организация.МассивСчетов Цикл
			
			AccountId			= ОписаниеСчета.ИДЛицевогоСчета;
			BillId				= ОписаниеСчета.ИДТарифа;
			SubscriptionEndDate	= ОписаниеСчета.ДатаОкончанияПодписки;
			
			Переменные = Новый Соответствие;
			Переменные.Вставить("BoxID",				BoxId);
			Переменные.Вставить("AccountId",			AccountId);
			Переменные.Вставить("BillId",				BillId);
			Переменные.Вставить("SubscriptionEndDate",	SubscriptionEndDate);
			Переменные.Вставить("BaseID", 				ИдентификаторБазы1С);
			
			МетодСервераБезКонтекста(Ложь, "Модуль_Ядро().Метрика_ДобавитьСтатистику_ДляОрганизации", boxId, Категория, Действие, , Переменные);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

