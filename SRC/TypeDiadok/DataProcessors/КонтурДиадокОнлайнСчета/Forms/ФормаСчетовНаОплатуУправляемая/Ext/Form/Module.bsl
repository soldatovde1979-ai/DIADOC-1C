&НаКлиенте
Функция РазложитьПараметрыСсылкиНаСкачивание(АдресСсылки)
	
	Результат = ПараметрыСсылки_НовыйКонтракт();  
	
	АдресСсылки = СтрЗаменить(АдресСсылки, ПрефиксОповещенияСохранитьФайОнлайнСчетаНаДиск(), "");
	
	МассивПараметров = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().РазделитьСтрокуЛок", АдресСсылки, "&");
	
	АктуальноеКоличествоПараметров = 3;
	
	Если НЕ МассивПараметров = Неопределено
		И МассивПараметров.Количество() = АктуальноеКоличествоПараметров Тогда 
		
		Результат.СсылкаНаФайл 	= МассивПараметров[0];
		Результат.НомерСчета 	= МассивПараметров[1];
		Результат.BoxID 		= МассивПараметров[2];
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции  

&НаКлиенте
Функция ПараметрыСсылки_НовыйКонтракт() 
	
	Результат = Новый Структура;
	
	Результат.Вставить("СсылкаНаФайл", "");
	Результат.Вставить("НомерСчета", "");
	Результат.Вставить("BoxId", "");
	
	Возврат Результат;  
	
КонецФункции

&НаКлиенте
Процедура СохранитьФайлОнлайнСчетаНаДиск(ПараметрыСервиса, BoxID, СсылкаНаФайл, НомерСчета) Экспорт 
	
	Организация = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().МассивСтруктур_Найти", СчетаНаОплатуСервиса, BoxID, "BoxID");
	
	ОписаниеПеременных = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().МассивСтруктур_Найти", Организация.МассивСчетов, СсылкаНаФайл, "СсылкаНаФайл");
	
	Попытка	 
		
		ФайлСчета = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().КонтурАПИ_GetPortalBillsContent", ПараметрыСервиса, СсылкаНаФайл);
		
		ИмяФайла 			= "Счет № " + НомерСчета + ".pdf";
		
		Модуль_смв = смв();
		ИмяВременногоФайла = Модуль_смв.СохранитьДвоичныеДанныеВоВременныйФайл(ФайлСчета, ИмяФайла);
		
		ОсновнаяФорма().Обработчик_КопироватьФайл(ИмяВременногоФайла, ИмяФайла);
		
		ВременныеФайлыКУдалению.Добавить(ИмяВременногоФайла);
		
		Если ЗначениеЗаполнено(ОписаниеПеременных) Тогда
			Метрики_ДобавитьСтатистику_СкачатьОнлайнСчет(BoxID, ОписаниеПеременных.ИДЛицевогоСчета, ОписаниеПеременных.ИДТарифа); 
		КонецЕсли;
		
	Исключение
		
		ОписаниеОшибки 	= НСтр("ru = 'Документ не был сохранен. Проверьте каталог, куда сохраняете документ и соединение с интернетом'");
		Подробности 	= ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Ошибка_Обработать(ОписаниеОшибки, Подробности);
		
	КонецПопытки;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьОнлайнСчетаПоОрганизациям() Экспорт
	
	СчетаНаОплатуСервиса = Новый Массив;
	
	КонтекстДиадока = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().ХранилищеКонтекстаСеанса");
	
	Для каждого ЭлементКонтекстаДиадок Из КонтекстДиадока Цикл
		
		ЭлементКонтекста 					= ЭлементКонтекстаДиадок.Значение;
		BoxID 								= ЭлементКонтекста.BoxId; 
		
		АвторизационныйТокен				= ЭлементКонтекста.Токен;
		ПараметрыСервиса_Диадок 			= МетодСервераБезКонтекста(Истина, "Модуль_Ядро().ПараметрыСервиса_Диадок", BoxID);
		AccountID 							= МетодСервераБезКонтекста(Истина, "Модуль_Ядро().АПИ_ИдентификаторЛицевогоСчетаДиадок", ПараметрыСервиса_Диадок, BoxID);
		
		Если Не ЗначениеЗаполнено(AccountID) Тогда
			Продолжить;
		КонецЕсли;

		СтруктураОрганизации 				= Новый Структура("Наименование, BoxId, МассивСчетов");
		СтруктураОрганизации.Наименование 	= ЭлементКонтекста.ОрганизацияНаименование;
		СтруктураОрганизации.BoxId 			= ЭлементКонтекста.BoxId; 
		СтруктураОрганизации.МассивСчетов	= СчетаНаОплатуСервиса(BoxID, AccountID);
		
		Если ЗначениеЗаполнено(СтруктураОрганизации.МассивСчетов) Тогда
			СчетаНаОплатуСервиса.Добавить(СтруктураОрганизации);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Функция СчетаНаОплатуСервиса(BoxID, AccountId)
	
	Результат = Новый Массив;
	
	ПараметрыСервиса_Контур = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().ПараметрыСервиса_Контур", BoxID);
	ОтветСервиса 			= МетодСервераБезКонтекста(Истина, "Модуль_Ядро().КонтурАПИ_GetPortalBills", ПараметрыСервиса_Контур, AccountId);
	
	РазобранныйОтвет = ЗначениеИзСтрокиJSON(ОтветСервиса);
	
	Если РазобранныйОтвет = Неопределено Тогда 
		РазобранныйОтвет = Результат;
	КонецЕсли;
	
	Для каждого Предложение Из РазобранныйОтвет Цикл
		
		МассивСчетов = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().СвойствоСтруктуры", Предложение, "bills");
		
		Для Каждого Счет Из МассивСчетов Цикл
			СтруктураСчета = Счета_НовыйКонтракт();
			
			СтруктураСчета.Номер				= Счет.billNumber;
			СтруктураСчета.Сумма				= Счет.amount;
			СтруктураСчета.ТарифныеПланы		= Счет.tariffsDetails;	
			СтруктураСчета.СсылкаНаФайл			= Предложение.offerId + "/bills/" + Счет.billId + "/pdf";
			СтруктураСчета.ИДЛицевогоСчета		= AccountId;
			СтруктураСчета.ИДТарифа				= Счет.billId;
			
			Результат.Добавить(СтруктураСчета); 
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ЗначениеИзСтрокиJSON(СтрокаJSON)
	
	Результат = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().ПарсерJSON_Прочитать", СтрокаJSON);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Счета_НовыйКонтракт()
	
	Результат = Новый Структура;
	
	Результат.Вставить("BoxId", "");
	Результат.Вставить("Номер", "");
	Результат.Вставить("Сумма", "");
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Организация", "");
	Результат.Вставить("ТарифныеПланы", "");
	Результат.Вставить("СсылкаНаФайл", "");
	Результат.Вставить("ДатаОкончанияПодписки", "");
	Результат.Вставить("ИДЛицевогоСчета", "");
	Результат.Вставить("ИДТарифа", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Для Каждого ФайлКУдалению Из ВременныеФайлыКУдалению Цикл
		УдалитьФайлы(ФайлКУдалению.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатие_ОткрытьЦентрПоддержки() Экспорт
	
	НазваниеФормы	= Метрика_НазваниеФормы();
	Категория		= Метрика_НазваниеКатегории();
	
	ОсновнаяФорма().ЦентрПоддержки_Открыть(Категория, НазваниеФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатие_СкачатьСчет(АдресСсылки)
	
	Метрики_ДобавитьПоведение_НажатиеСкачатьОнлайнСчет();
	
	ПараметрыСкачивания = РазложитьПараметрыСсылкиНаСкачивание(АдресСсылки);
	
	ПараметрыСервиса_Контур = МетодСервераБезКонтекста(Истина, "Модуль_Ядро().ПараметрыСервиса_Контур", ПараметрыСкачивания.BoxID);
	
	СохранитьФайлОнлайнСчетаНаДиск(
	ПараметрыСервиса_Контур,
	ПараметрыСкачивания.BoxID,
	ПараметрыСкачивания.СсылкаНаФайл, 
	ПараметрыСкачивания.НомерСчета);
	
КонецПроцедуры 

&НаКлиенте
Процедура Ошибка_Обработать(ОписаниеОшибки, Подробности)
	
	Ошибка_СообщитьПользователю(ОписаниеОшибки);
	
	МетодСервераБезКонтекста(Ложь, "Модуль_Ядро().Ошибка_Обработать", ОписаниеОшибки, Подробности);
	
КонецПроцедуры

&НаКлиенте
Процедура Ошибка_СообщитьПользователю(ТекстСообщения, ИдентификаторФормы = Неопределено, ПолеФормы = Неопределено) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	
	Сообщение.Текст = ТекстСообщения + Символы.ПС + НСтр("ru ='Подробности см. в журнале регистрации.'");
	
	Если ЗначениеЗаполнено(ИдентификаторФормы) Тогда
		Сообщение.ИдентификаторНазначения = ИдентификаторФормы;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолеФормы) Тогда
		Сообщение.Поле = ПолеФормы;
	КонецЕсли;
	
	Сообщение.Сообщить();
	
КонецПроцедуры


