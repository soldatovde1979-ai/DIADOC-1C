	ДополнительныеПараметры.Вставить("ДвоичныеДанныеПодписи",			ДвоичныеДанныеПодписи);
	
	ОповещениеЗавершения = НовыйОписаниеОповещения("ПроверитьПодпись_Завершение", ЭтаФорма, ДополнительныеПараметры);
	
