	Сертификат.Вставить("Отпечаток"				, ОтпечатокСертификата);
	Сертификат.Вставить("ТипХранилища"			, "ПерсональныеСертификаты");
	Сертификат.Вставить("РасположениеХранилища"	, "ДанныеПользователяОС");
	
	Результат = Модуль_Плагин().ПодписатьКонтент(ДвоичныеДанные, Сертификат);
	
	Возврат Результат;
	
