//{		Http запрос

&НаКлиенте
Функция ПараметрыHTTPЗапроса() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Метод");
	Результат.Вставить("АдресМетода");
	Результат.Вставить("ТелоЗапроса");
	Результат.Вставить("Параметры"					, Новый Структура);
	Результат.Вставить("Заголовки"					, Новый Соответствие);
	Результат.Вставить("ДопустимыеКодыОтвета"		, Новый Массив);
	Результат.Вставить("ТелоОтветаКакДвоичныеДанные", Ложь);
	
	Результат.Метод = "GET";
	
	Результат.Заголовки.Вставить("Accept"		, "application/json");
	Результат.Заголовки.Вставить("Content-Type"	, "application/json;charset=utf-8");
	
	Результат.ДопустимыеКодыОтвета.Добавить(200);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса) Экспорт
	
	Попытка
		
		Если ИспользоватьВнешнийHTTP() Тогда
			
			Результат = ВыполнитьHTTPЗапрос_Plugin(ПараметрыСервиса, ПараметрыЗапроса);
			
		Иначе
			
			Результат = ВыполнитьHTTPЗапрос_Native(ПараметрыСервиса, ПараметрыЗапроса);
			
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ОбработатьОшибкуHTTP(ПараметрыСервиса, ПараметрыЗапроса, ТекстОшибки);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Если НЕ Результат.КодОтветаДопустимый Тогда
		
		КодОтвета = Результат.КодОтвета;
		ТелоОтветаСтрокой = "";
		Если ТипЗнч(Результат.ТелоОтвета) = Тип("Строка") Тогда
			ТелоОтветаСтрокой = НРег(Результат.ТелоОтвета);
		КонецЕсли;
		
		Если ЭтоОшибкаАвторизации(КодОтвета, ТелоОтветаСтрокой) Тогда
			
			ОчиститьКонтекстСеанса();
			
			ТекстОшибки = НСтр("ru = 'Прошло слишком много времени с последней авторизации.
					|Для продолжения работы необходимо перезапустить модуль Диадока.'");
			
		Иначе
			
			СтрокаОшибки = НСтр(
					"ru = 'Ошибка HTTP запроса
					|Код ошибки: %1
					|%2'");
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(СтрокаОшибки, КодОтвета, ТелоОтветаСтрокой);
			
		КонецЕсли;
		
		ОбработатьОшибкуHTTP(ПараметрыСервиса, ПараметрыЗапроса, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удаление токена из контекста сеанса.
//
// Параметры:
//  Токен - Строка - Токен, по которому нужно очистить контекст сеанса.
//
&НаКлиенте
Процедура ОчиститьКонтекстСеанса()
	
	Ядро().ОчиститьКонтекстИКэшСеанса();
	
КонецПроцедуры

// Проверяет ответ HTTP-запроса на предмет наличия ошибки авторизации по токену.
//
// Параметры:
//  КодОтвета  - Число - Код ответа HTTP-сервиса.
//  ТелоОтвета - Строка - Текстовый ответ HTTP-сервиса.
//
// Возвращаемое значение:
//   Булево - Результат проверки ошибки авторизации.
//     * Истина - Произошла ошибка авторизации.
//     * Ложь   - Авторизация прошла учпешно.
//
&НаКлиенте
Функция ЭтоОшибкаАвторизации(КодОтвета, ТелоОтвета)
	
	Результат = КодОтвета = 401
				И ТелоОтвета = "invalid auth token";
									
	Возврат Результат

КонецФункции

//}		Http запрос


