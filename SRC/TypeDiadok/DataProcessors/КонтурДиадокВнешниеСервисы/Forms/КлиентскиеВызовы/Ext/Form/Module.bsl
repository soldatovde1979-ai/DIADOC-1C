//{		Получение сертификата

&НаКлиенте
Функция ПолучитьСертификат(ОтпечатокСертификата) Экспорт
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата(Истина);
	
	Если ИспользоватьВнешнююКриптографию() Тогда
		ПараметрыПоиска.Вставить("Отпечаток", ОтпечатокСертификата);
		Результат = Плагин_ПолучитьДанныеСертификата(ПараметрыПоиска, СвойстваСертификата);
	Иначе
		Результат = ПолучитьДанныеСертификата(ОтпечатокСертификата, ПараметрыПоиска, СвойстваСертификата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьСертификат_Асинхронно(Знач ОписаниеОповещения, ОтпечатокСертификата) Экспорт 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения",	ОписаниеОповещения);
	ДополнительныеПараметры.Вставить("ОтпечатокСертификата",	ОтпечатокСертификата);
	ДополнительныеПараметры.Вставить("СвойстваСертификата",		ВсеСвойстваСертификата(Истина));
	
	ОповещениеЗавершения = НовыйОписаниеОповещения("ПолучитьСертификат_Завершение", ЭтаФорма, ДополнительныеПараметры);
	
	ОповещениеИнициализацияМенеджераЗавершение = НовыйОписаниеОповещения("ПолучитьСертификат_ИнициализацияМенеджера_Завершение", ЭтаФорма, ОповещениеЗавершения);
	НачатьИнициализациюМенеджераКриптографии(ОповещениеИнициализацияМенеджераЗавершение);

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификат_Завершение(СертификатыКриптографии, ДополнительныеПараметры = Неопределено) Экспорт 
	
	ОповещениеЗавершения = СвойствоСтруктуры(ДополнительныеПараметры, "ОповещениеЗавершения");
	ОтпечатокСертификата = СвойствоСтруктуры(ДополнительныеПараметры, "ОтпечатокСертификата");
	СвойстваСертификата	 = СвойствоСтруктуры(ДополнительныеПараметры, "СвойстваСертификата");
	
	Если ТипЗнч(СертификатыКриптографии) = Тип("Массив") Тогда
		
		СертификатКриптографии = НайтиСертификатВМассивеПоОтпечатку(СертификатыКриптографии, ОтпечатокСертификата);
		
	Иначе
		
		СертификатКриптографии = СертификатыКриптографии;
		
	КонецЕсли;
	
	НачатьПолучениеОписанияСертификата(ОповещениеЗавершения, СертификатКриптографии, СвойстваСертификата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификат_ИнициализацияМенеджера_Завершение(МенеджерКриптографии, ОписаниеОповещения) Экспорт 
	
	Оповещение = НовыйОписаниеОповещения("ПолучитьСертификат_ПолучениеХранилищаСертификатов_Завершение", ЭтаФорма, ОписаниеОповещения);
	
	ПараметрыПоиска = ПараметрыПоискаСертификатов();
	
	МенеджерКриптографии.НачатьПолучениеХранилищаСертификатов(Оповещение, ПараметрыПоиска.ТипХранилища, ПараметрыПоиска.РасположениеХранилища);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСертификат_ПолучениеХранилищаСертификатов_Завершение(Хранилище, ОписаниеОповещения) Экспорт 
	
	ОтпечатокСертификата = ОписаниеОповещения.ДополнительныеПараметры.ОтпечатокСертификата;
	
	Если ТипЗнч(ОтпечатокСертификата) = Тип("ДвоичныеДанные") Тогда 
		Хранилище.НачатьПоискПоОтпечатку(ОписаниеОповещения, ОтпечатокСертификата);
	Иначе
		Хранилище.НачатьПолучениеВсех(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

//}		Получение сертификата


