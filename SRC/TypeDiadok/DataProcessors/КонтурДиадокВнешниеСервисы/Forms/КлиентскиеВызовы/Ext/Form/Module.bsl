&НаКлиенте
Функция НаименованиеСертификата(СубъектСертификата)
	
	Если ТипЗнч(СубъектСертификата) = Тип("Структура") Тогда
		
		Результат = НаименованиеСубъекта(СубъектСертификата);
		
	ИначеЕсли ТипЗнч(СубъектСертификата) = Тип("Массив") Тогда
		
		Для Каждого Субъект Из СубъектСертификата Цикл
			
			Результат = НаименованиеСубъекта(Субъект);
			
			Если ЗначениеЗаполнено(Результат) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение "Неожиданный тип значения субъекта сертификата: " + Строка(ТипЗнч(СубъектСертификата));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НаименованиеСубъекта(Субъект)
	
	Если Субъект.Свойство("SN") И Субъект.Свойство("G") Тогда
		Результат = Субъект.SN + " " + Субъект.G;
	ИначеЕсли Субъект.Свойство("CN") Тогда
		Результат = Субъект.CN;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
