	ОповещениеЗавершения = СвойствоСтруктуры(ДополнительныеПараметры, "ОповещениеЗавершения");
	
	СертификатКриптографии = Неопределено;
	
	Если СертификатыКриптографии.Количество() > 0 Тогда
		СертификатКриптографии = СертификатыКриптографии[0];
	КонецЕсли;
	
	НачатьПолучениеОписанияСертификата(ОповещениеЗавершения, СертификатКриптографии, ВсеСвойстваСертификата(Истина));
	
