	Для Каждого ДвоичныеДанныеСертификата Из МассивСертификатов Цикл
		Сертификаты.Добавить(Новый Структура("ДвоичныеДанные", ДвоичныеДанныеСертификата));
	КонецЦикла;
	
	Результат = Модуль_Плагин().ЗашифроватьКонтент(ДвоичныеДанные, Сертификаты);
	
	Возврат Результат;
	
