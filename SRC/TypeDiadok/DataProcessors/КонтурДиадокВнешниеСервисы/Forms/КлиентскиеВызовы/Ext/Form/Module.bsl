	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОповещениеЗавершения",			ОписаниеОповещения);
	ДополнительныеПараметры.Вставить("ДвоичныеДанныеПодписи",			ДвоичныеДанныеПодписи);
	
	ОповещениеЗавершения = НовыйОписаниеОповещения("ПолучитьСертификатИзПодписи_Завершение", ЭтаФорма, ДополнительныеПараметры);
	
	ОповещениеИнициализацияМенеджераЗавершение = НовыйОписаниеОповещения("ПолучитьСертификатИзПодписи_ИнициализацияМенеджера_Завершение", ЭтаФорма, ОповещениеЗавершения);
