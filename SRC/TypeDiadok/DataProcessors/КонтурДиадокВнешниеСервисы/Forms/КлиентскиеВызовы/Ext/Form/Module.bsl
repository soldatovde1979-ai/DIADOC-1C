&НаКлиенте
Функция ИННСертификата(СубъектСертификата)
	
	Если ТипЗнч(СубъектСертификата) = Тип("Структура") Тогда
		
		Результат = ИННСубъекта(СубъектСертификата);
		
	ИначеЕсли ТипЗнч(СубъектСертификата) = Тип("Массив") Тогда
		
		Для Каждого Субъект Из СубъектСертификата Цикл
			
			Результат = ИННСубъекта(Субъект);
			
			Если ЗначениеЗаполнено(Результат) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение "Неожиданный тип значения субъекта сертификата: " + Строка(ТипЗнч(СубъектСертификата));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИННСубъекта(Субъект)
	
	Если Субъект.Свойство("ИННЮЛ") Тогда
		Результат = Субъект.ИННЮЛ;
	ИначеЕсли Субъект.Свойство("ИНН") Тогда
		Результат = Субъект.ИНН;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Если Лев(Результат, 2) = "00" Тогда 
		Результат = Сред(Результат, 3);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КППСертификата(СубъектСертификата)
	
	Если ТипЗнч(СубъектСертификата) = Тип("Структура") Тогда
		
		Результат = КППСубъекта(СубъектСертификата);
		
	ИначеЕсли ТипЗнч(СубъектСертификата) = Тип("Массив") Тогда
		
		Для Каждого Субъект Из СубъектСертификата Цикл
			
			Результат = КППСубъекта(Субъект);
			
			Если ЗначениеЗаполнено(Результат) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение "Неожиданный тип значения субъекта сертификата: " + Строка(ТипЗнч(СубъектСертификата));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КППСубъекта(Субъект)
	
	Результат = "";
	
	НеструктурированноеИмя = СвойствоСтруктуры(Субъект, "_1_2_840_113549_1_9_2");
	
	Если ЗначениеЗаполнено(НеструктурированноеИмя) Тогда
		
		ЭлементыЗначения = РазделитьСтрокуЛок(НеструктурированноеИмя, "-");
		
		Если ЭлементыЗначения.Количество() > 1 Тогда
			Результат = ЭлементыЗначения[1];
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ТипСертификата(СубъектСертификата)
	
	ТипыСертификатовКЭП = Перечисление_ТипыСертификатовКЭП();
	
	ИННЮЛ = ЗначениеСвойстваСубъектаСертификата(СубъектСертификата, "ИННЮЛ");
	ИНН = ЗначениеСвойстваСубъектаСертификата(СубъектСертификата, "ИНН");
	ОГРН = ЗначениеСвойстваСубъектаСертификата(СубъектСертификата, "ОГРН");
	ОГРНИП = ЗначениеСвойстваСубъектаСертификата(СубъектСертификата, "ОГРНИП");
	
	Если Лев(ИНН, 2) = "00" Тогда
		ИНН = Сред(ИНН, 3);
	КонецЕсли;
	
	ПустойИННЮЛ		= "0000000000";
	ПустойИННФЛ		= "000000000000";
	ПустойОГРН		= "0000000000000";
	ПустойОГРНИП	= "000000000000000";
	
	ДлинаИННЮЛ	= СтрДлина(ПустойИННЮЛ);
	ДлинаИННФЛ	= СтрДлина(ПустойИННФЛ);
	ДлинаОГРН	= СтрДлина(ПустойОГРН);
	ДлинаОГРНИП	= СтрДлина(ПустойОГРНИП);
	
	ПрефиксНерезидента = "9909";
	
	Резидент		= Лев(ИННЮЛ, СтрДлина(ПрефиксНерезидента)) <> ПрефиксНерезидента
					И Лев(ИНН,	СтрДлина(ПрефиксНерезидента)) <> ПрефиксНерезидента;
					
	ЗаполненИННЮЛ	= СтрДлина(ИННЮЛ) = ДлинаИННЮЛ
					И ИННЮЛ <> ПустойИННЮЛ;
					
	ЗаполненИНН		= СтрДлина(ИНН) = ДлинаИННФЛ
					И ИНН <> ПустойИННФЛ;
					
	ЗаполненИНН_ЮЛ	= СтрДлина(ИНН) = ДлинаИННЮЛ
					И ИНН <> ПустойИННЮЛ;
					
	ЗаполненОГРНИП	= СтрДлина(ОГРНИП) = ДлинаОГРНИП
					И ОГРНИП <> ПустойОГРНИП;
					
	ЗаполненОГРН	= СтрДлина(ОГРН) = ДлинаОГРН
					И ОГРН <> ПустойОГРН;
					
	ЗаполненОГРН	= (Резидент И ЗаполненОГРН
					ИЛИ НЕ Резидент И НЕ ЗаполненОГРН)
					И НЕ ЗначениеЗаполнено(ОГРНИП);
					
	Если 	ЗаполненИННЮЛ 
			И ЗаполненОГРН Тогда
	
			Результат = ТипыСертификатовКЭП.ЮЛ;
			
	ИначеЕсли НЕ ЗаполненИННЮЛ 
			И ЗаполненИНН_ЮЛ 
			И ЗаполненОГРН Тогда
	
			Результат = ТипыСертификатовКЭП.ЮЛ;
	
	ИначеЕсли НЕ ЗаполненИННЮЛ
			И ЗаполненИНН
		    И ЗаполненОГРНИП
            И НЕ ЗаполненОГРН Тогда
	
		Результат = ТипыСертификатовКЭП.ИП;
		
	ИначеЕсли НЕ ЗаполненИННЮЛ
			И ЗаполненИНН
			И НЕ ЗаполненОГРНИП
			И НЕ ЗаполненОГРН Тогда
	
		Результат = ТипыСертификатовКЭП.ФЛ;
	
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЗначениеСвойстваСубъектаСертификата(СубъектСертификата, ИмяСвойства)
	
	Если ТипЗнч(СубъектСертификата) = Тип("Структура") Тогда
		
		Результат = СвойствоСтруктуры(СубъектСертификата, ИмяСвойства);
		
	ИначеЕсли ТипЗнч(СубъектСертификата) = Тип("Массив") Тогда
		
		Для Каждого Субъект Из СубъектСертификата Цикл
			
			Результат = СвойствоСтруктуры(Субъект, ИмяСвойства);
			
			Если ЗначениеЗаполнено(Результат) Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ВызватьИсключение "Неожиданный тип значения субъекта сертификата: " + Строка(ТипЗнч(СубъектСертификата));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

