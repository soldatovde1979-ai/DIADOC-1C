////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция ВызовМодуля(ИмяМодуля)
	
	Если МодулиЛок = Неопределено Тогда
		МодулиЛок = Новый Структура;
		МодулиЛок.Вставить("СтдСтр");
		МодулиЛок.Вставить("СтдОС");
		МодулиЛок.Вставить("СтдФС");
		МодулиЛок.Вставить("СтдJSON");
		МодулиЛок.Вставить("СтдОбщегоНазначения");
		МодулиЛок.Вставить("СтдДиалоги");
		МодулиЛок.Вставить("СтдКоллекции");
	КонецЕсли;
	
	Если НЕ МодулиЛок.Свойство(ИмяМодуля) Тогда
		ВызватьИсключение "Ошибка значения: " + ИмяМодуля;
	КонецЕсли;
	
	Если МодулиЛок[ИмяМодуля] = Неопределено Тогда
		МодулиЛок[ИмяМодуля] = ПолучитьФорму(ТипМетаданных + "." + ПространствоИмен + ИмяМодуля + ".Форма.Клиент");
		Попытка
			МодулиЛок[ИмяМодуля].Инит(ЭтаФорма);
		Исключение
			Возврат МодулиЛок[ИмяМодуля];
		КонецПопытки;
	КонецЕсли;
	
	Возврат МодулиЛок[ИмяМодуля];
	
КонецФункции // ВызовМодуля