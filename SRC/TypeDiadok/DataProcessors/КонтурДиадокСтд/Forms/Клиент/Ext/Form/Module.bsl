////////////////////////////////////////////////////////////////////////////////
// Описание переменных

// Служебные свойства
&НаКлиенте
Перем МодулиЛок;

////////////////////////////////////////////////////////////////////////////////
// Обработчики событий формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТипМетаданных = "ВнешняяОбработка";
	Если Лев(ЭтаФорма.ИмяФормы, СтрДлина(ЭтаФорма.ТипМетаданных)) <> ЭтаФорма.ТипМетаданных Тогда
		ЭтаФорма.ТипМетаданных = "Обработка";
	КонецЕсли;
	
	ЭтаФорма.ПространствоИмен = СтрЗаменить(
			СтрЗаменить(ЭтаФорма.ИмяФормы, ЭтаФорма.ТипМетаданных + ".", ""), "Стд.Форма.Клиент", "");
	
КонецПроцедуры // ПриСозданииНаСервере

