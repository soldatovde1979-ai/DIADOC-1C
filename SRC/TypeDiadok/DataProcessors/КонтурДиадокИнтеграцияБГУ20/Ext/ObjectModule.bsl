	|		КОГДА ДанныеШапки.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация
	|		ИНАЧЕ ДанныеШапки.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент
	|		ИНАЧЕ ДанныеШапки.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ДанныеШапки.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеШапки.РеквизитыЛицевогоСчета КАК БанковскийСчетОрганизации,
	|	ДанныеШапки.РасчетныйСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	ДанныеШапки.РасчетныйСчетГрузополучателя КАК БанковскийСчетГрузополучателя,
	|	ДанныеШапки.РасчетныйСчетГрузоотправителя КАК БанковскийСчетГрузоотправителя,
	|	ДанныеШапки.Договор КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(СпрДоговоры.ДатаДоговора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДоговорДата,
	|	ЕСТЬNULL(СпрДоговоры.НомерДоговора, """") КАК ДоговорНомер,
	|	ЕСТЬNULL(СпрДоговоры.ВидДоговора, ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ПустаяСсылка)) КАК ВидДоговора
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12 КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК СпрДоговоры
	|		ПО ДанныеШапки.Договор = СпрДоговоры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Подразделения КАК СпрПодразделения
	|		ПО ДанныеШапки.Подразделение = СпрПодразделения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК СпрКонтрагенты
	|		ПО ДанныеШапки.Контрагент = СпрКонтрагенты.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	Возврат Результат;
	
