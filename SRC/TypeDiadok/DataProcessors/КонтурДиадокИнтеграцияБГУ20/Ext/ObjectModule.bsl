// Формирует типовую печатную форму счета на оплату.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.СчетНаОплату - счет на оплату
// 
// Возвращаемое значение:
//  ТабличныйДокумент - стандартная печатная форма.
//
Функция СчетаНаОплату_ПечатнаяФорма1С(СсылкаНаОбъект) Экспорт
	
	Если ТипЗнч(СсылкаНаОбъект) <> Тип("ДокументСсылка.СчетНаОплату") Тогда
		
		ШаблонТекстаОшибки = НСтр("ru='СчетаНаОплату_ПечатнаяФорма1С: Неожиданный тип документа (%1)'");
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(СсылкаНаОбъект));
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(СсылкаНаОбъект);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	КоллекцияПечатныхФорм = НовыйКоллекцияПечатныхФормДляПечатиДокумента();
	ОписаниеПФ = КоллекцияПечатныхФорм.Добавить();
	ОписаниеПФ.ИмяМакета = "Счет";
	ОписаниеПФ.ИмяВРЕГ = ВРег(ОписаниеПФ.ИмяМакета);
	
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Новый Структура;
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.СчетНаОплату");
	
	МенеджерПечати.Печать(
		ДокументПечати,
		ПараметрыПечати,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода
	);
	
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			ТабличныйДокумент = Стр.ТабличныйДокумент;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Заполняет модель данных электронного счета на оплату.
//
// Параметры:
//  Шапка - Структура - Контракт шапки неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - ТаблицаЗначений - Контракт табличной части неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату())
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанные(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета) Экспорт
	
	ТипОснования = ТипЗнч(ОснованиеЭлектронногоСчета);
	
	Если ТипОснования = Тип("ДокументСсылка.СчетНаОплату") Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоСчетуНаОплату(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоАктуОбОказанииУслуг(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоНакладной(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ОснованиеЭлектронногоСчета));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет модель данных электронного счета на оплату на основании счета на оплату.
//
// Параметры:
//  Шапка - Структура - Контракт шапки неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату()
//  ТабличнаяЧасть - ТаблицаЗначений - Контракт табличной части неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату()
//  ОснованиеЭлектронногоСчета - ДокументСсылка.СчетНаОплату - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанныеПоСчетуНаОплату(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.ВалютаДокумента КАК Валюта,
	|	Т.ВалютаДокумента.Код КАК ВалютаКод,
	|	Т.Организация КАК Организация,
	|	Т.ЛицевойСчет КАК ЛицевойСчет,
	|	Т.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	Т.Контрагент КАК Контрагент,
	|	Т.СчетПлательщика КАК СчетПлательщика,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	Т.Руководитель КАК Руководитель,
	|	Т.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Т.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетНаОплату КАК Т
	|ГДЕ
	|	Т.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧ.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ПОДСТРОКА(ТЧ.Содержание, 1, 1000)
	|		КОГДА ПОДСТРОКА(ТЧ.Содержание, 1, 1000) <> """"
	|			ТОГДА ПОДСТРОКА(ТЧ.Содержание, 1, 1000)
	|		КОГДА ТЧ.Номенклатура.НаименованиеПолное <> """"
	|			ТОГДА ТЧ.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ТЧ.Номенклатура.Наименование
	|	КОНЕЦ КАК НоменклатураПредставление,
	|	ЕСТЬNULL(ТЧ.Номенклатура.НоменклатурныйНомер, """") КАК НоменклатураАртикул,
	|	ВЫБОР
	|		КОГДА ТЧ.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТЧ.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ ТЧ.ЕдиницаИзмерения.Представление
	|	КОНЕЦ КАК ЕдиницаИзмеренияПредставление,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Сумма КАК Сумма,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	1 КАК НомерТабличнойЧасти,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.Услуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧ.Номенклатура.НаименованиеПолное <> """"
	|			ТОГДА ТЧ.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ТЧ.Номенклатура.Наименование
	|	КОНЕЦ,
	|	ТЧ.Номенклатура.НоменклатурныйНомер,
	|	ВЫБОР
	|		КОГДА ТЧ.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТЧ.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ ТЧ.ЕдиницаИзмерения.Представление
	|	КОНЕЦ,
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	ТЧ.СтавкаНДС,
	|	ТЧ.Сумма,
	|	ТЧ.СуммаНДС,
	|	2,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.Материалы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.ОС,
	|	ВЫБОР
	|		КОГДА ТЧ.ОС.НаименованиеПолное <> """"
	|			ТОГДА ТЧ.ОС.НаименованиеПолное
	|		ИНАЧЕ ТЧ.ОС.Наименование
	|	КОНЕЦ,
	|	ТЧ.ОС.НоменклатурныйНомер,
	|	""шт."",
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	ТЧ.СтавкаНДС,
	|	ТЧ.Сумма,
	|	ТЧ.СуммаНДС,
	|	3,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.ОсновныеСредства КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧ.Номенклатура.НаименованиеПолное <> """"
	|			ТОГДА ТЧ.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ТЧ.Номенклатура.Наименование
	|	КОНЕЦ,
	|	ТЧ.Номенклатура.НоменклатурныйНомер,
	|	ВЫБОР
	|		КОГДА ТЧ.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТЧ.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ ТЧ.ЕдиницаИзмерения.Представление
	|	КОНЕЦ,
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	&СтавкаБезНДС,
	|	ТЧ.Сумма,
	|	0,
	|	4,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.ВозвратнаяТара КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНДС
	|ИЗ
	|	Документ.СчетНаОплату.Материалы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СтавкаНДС <> &СтавкаБезНДС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	Документ.СчетНаОплату.Услуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СтавкаНДС <> &СтавкаБезНДС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	Документ.СчетНаОплату.ОсновныеСредства КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СтавкаНДС <> &СтавкаБезНДС";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ОснованиеЭлектронногоСчета);
	Запрос.УстановитьПараметр("СтавкаБезНДС", Перечисления.СтавкиНДС.БезНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выбрать();
	
	Если Не ДанныеШапки.Следующий() Тогда
		Ошибка = СтрШаблон("СчетаНаОплату_Данные: Не удалось получить сведения по %1", Строка(ОснованиеЭлектронногоСчета));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ДанныеШапки.Номер;
	
	СведенияОбОрганизации = СчетаНаОплату_РеквизитыЮрФизЛица(ДанныеШапки.Организация);
	СведенияОКонтрагенте = СчетаНаОплату_РеквизитыЮрФизЛица(ДанныеШапки.Контрагент);
	СчетПлательщика = СчетаНаОплату_РеквизитыСчетаКонтрагента(ДанныеШапки.СчетПлательщика);
	
	Шапка.Номер = НомерДокумента;
	Шапка.Дата = ДатаДокумента;
	Шапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	Шапка.УчитыватьНДС = Не РезультатыЗапроса[2].Пустой();
	Шапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	Шапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	Шапка.Валюта = ДанныеШапки.Валюта;
	Шапка.ВалютаКод = ДанныеШапки.ВалютаКод;
	
	Шапка.Продавец = ДанныеШапки.Организация;
	Шапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	Шапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	Шапка.Покупатель = ДанныеШапки.Контрагент;
	Шапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	Шапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте, СчетПлательщика);
	
	Шапка.РуководительФИО = Справочники.Сотрудники.ФамилияИО(ДанныеШапки.Руководитель, Истина);
	
	СчетПолучателя = СчетаНаОплату_РеквизитыСчетаОрганизации(ДанныеШапки.ЛицевойСчет, ДанныеШапки.РеквизитыЛицевогоСчета);
	Если ЗначениеЗаполнено(СчетПолучателя) Тогда
		Шапка.ПродавецБанкБИК = СчетПолучателя.БИК;
		Шапка.ПродавецБанкПредставление = СчетПолучателя.Банк;
		Шапка.ПродавецБанковскийСчетНомер = СчетПолучателя.НомерСчета;
		Шапка.ПродавецБанковскийСчетКорСчет = СчетПолучателя.КоррСчет;
	КонецЕсли;
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = ТабличнаяЧасть.Добавить();
		Запись.Номенклатура = Выборка.Номенклатура;
		Запись.Характеристика = Неопределено;
		Запись.НоменклатураАртикул = Выборка.НоменклатураАртикул;
		Запись.НоменклатураПредставление = Выборка.НоменклатураПредставление;
		Запись.Количество = Выборка.Количество;
		Запись.ЕдиницаИзмерения = Выборка.ЕдиницаИзмеренияПредставление;
		Запись.Упаковка = Неопределено;
		Запись.Цена = Выборка.Цена;
		Запись.Сумма = Выборка.Сумма;
		Запись.СуммаНДС = Выборка.СуммаНДС;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет модель данных электронного счета на оплату на основании накладной.
//
// Параметры:
//  Шапка - Структура - Контракт шапки неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - ТаблицаЗначений - Контракт табличной части неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату())
//  ОснованиеЭлектронногоСчета - Документ.НакладнаяНаРеализациюТорг12 - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанныеПоНакладной(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.ВалютаДокумента КАК Валюта,
	|	Т.ВалютаДокумента.Код КАК ВалютаКод,
	|	Т.Организация КАК Организация,
	|	Т.РеквизитыЛицевогоСчета.Владелец КАК ЛицевойСчет,
	|	Т.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	Т.Контрагент КАК Контрагент,
	|	Т.РасчетныйСчетКонтрагента КАК СчетПлательщика,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	Т.Руководитель КАК Руководитель,
	|	Т.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Т.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12 КАК Т
	|ГДЕ
	|	Т.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧ.Номенклатура.НаименованиеПолное <> """"
	|			ТОГДА ТЧ.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ТЧ.Номенклатура.Наименование
	|	КОНЕЦ КАК НоменклатураПредставление,
	|	ТЧ.Номенклатура.Код КАК НоменклатураАртикул,
	|	ТЧ.Номенклатура.ЕдиницаИзмерения.Представление КАК ЕдиницаИзмеренияПредставление,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Сумма КАК Сумма,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	1 КАК НомерТабличнойЧасти,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	ВЫБОР
	|		КОГДА ТЧ.Номенклатура.НаименованиеПолное <> """"
	|			ТОГДА ТЧ.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ТЧ.Номенклатура.Наименование
	|	КОНЕЦ,
	|	ТЧ.Номенклатура.НоменклатурныйНомер,
	|	ТЧ.Номенклатура.ЕдиницаИзмерения.Представление,
	|	ТЧ.Количество,
	|	ВЫБОР
	|		КОГДА ТЧ.Количество > 0
	|			ТОГДА ТЧ.Сумма / ТЧ.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	&СтавкаБезНДС,
	|	ТЧ.Сумма,
	|	0,
	|	4,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.ВозвратнаяТара КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНДС
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СтавкаНДС <> &СтавкаБезНДС";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ОснованиеЭлектронногоСчета);
	Запрос.УстановитьПараметр("СтавкаБезНДС", Перечисления.СтавкиНДС.БезНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выбрать();
	
	Если Не ДанныеШапки.Следующий() Тогда
		Ошибка = СтрШаблон("СчетаНаОплату_Данные: Не удалось получить сведения по %1", Строка(ОснованиеЭлектронногоСчета));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ДанныеШапки.Номер;
	
	СведенияОбОрганизации = СчетаНаОплату_РеквизитыЮрФизЛица(ДанныеШапки.Организация);
	СчетПолучателя = СчетаНаОплату_РеквизитыСчетаОрганизации(ДанныеШапки.ЛицевойСчет, ДанныеШапки.РеквизитыЛицевогоСчета);
	
	СведенияОКонтрагенте = СчетаНаОплату_РеквизитыЮрФизЛица(ДанныеШапки.Контрагент);
	СчетПлательщика = СчетаНаОплату_РеквизитыСчетаКонтрагента(ДанныеШапки.СчетПлательщика);
	
	Шапка.Номер = НомерДокумента;
	Шапка.Дата = ДатаДокумента;
	Шапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	Шапка.УчитыватьНДС = Не РезультатыЗапроса[2].Пустой();
	Шапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	Шапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	Шапка.Валюта = ДанныеШапки.Валюта;
	Шапка.ВалютаКод = ДанныеШапки.ВалютаКод;
	
	Шапка.Продавец = ДанныеШапки.Организация;
	Шапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	Шапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	Шапка.Покупатель = ДанныеШапки.Контрагент;
	Шапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	Шапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте, СчетПлательщика);
	
	Шапка.РуководительФИО = Справочники.Сотрудники.ФамилияИО(ДанныеШапки.Руководитель, Истина);
	
	Если ЗначениеЗаполнено(СчетПолучателя) Тогда
		Шапка.ПродавецБанкБИК = СчетПолучателя.БИК;
		Шапка.ПродавецБанкПредставление = СчетПолучателя.Банк;
		Шапка.ПродавецБанковскийСчетНомер = СчетПолучателя.НомерСчета;
		Шапка.ПродавецБанковскийСчетКорСчет = СчетПолучателя.КоррСчет;
	КонецЕсли;
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = ТабличнаяЧасть.Добавить();
		Запись.Номенклатура = Выборка.Номенклатура;
		Запись.Характеристика = Неопределено;
		Запись.НоменклатураАртикул = Выборка.НоменклатураАртикул;
		Запись.НоменклатураПредставление = Выборка.НоменклатураПредставление;
		Запись.Количество = Выборка.Количество;
		Запись.ЕдиницаИзмерения = Выборка.ЕдиницаИзмеренияПредставление;
		Запись.Упаковка = Неопределено;
		Запись.Цена = Выборка.Цена;
		Запись.Сумма = Выборка.Сумма;
		Запись.СуммаНДС = Выборка.СуммаНДС;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет модель данных электронного счета на оплату на основании акта об оказание услуг.
//
// Параметры:
//  Шапка - Структура - Контракт шапки неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - ТаблицаЗначений - Контракт табличной части неформализованного счета на оплату по форме ДД
//  		(см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату())
//  ОснованиеЭлектронногоСчета - ДокументСсылка.АктОбОказанииУслуг - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанныеПоАктуОбОказанииУслуг(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.ВалютаДокумента КАК Валюта,
	|	Т.ВалютаДокумента.Код КАК ВалютаКод,
	|	Т.Организация КАК Организация,
	|	Т.РеквизитыЛицевогоСчета.Владелец КАК ЛицевойСчет,
	|	Т.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	Т.Контрагент КАК Контрагент,
	|	Т.РасчетныйСчетКонтрагента КАК СчетПлательщика,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	Т.Руководитель КАК Руководитель,
	|	Т.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Т.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.АктОбОказанииУслуг КАК Т
	|ГДЕ
	|	Т.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Номенклатура.Код КАК НоменклатураАртикул,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ТЧ.СодержаниеУслуги КАК СТРОКА(1000))) <> """"
	|			ТОГДА ВЫРАЗИТЬ(ТЧ.СодержаниеУслуги КАК СТРОКА(1000))
	|		КОГДА (ВЫРАЗИТЬ(ТЧ.Номенклатура.НаименованиеПолное КАК СТРОКА(1000))) <> """"
	|			ТОГДА ВЫРАЗИТЬ(ТЧ.Номенклатура.НаименованиеПолное КАК СТРОКА(1000))
	|		ИНАЧЕ ТЧ.Номенклатура.Наименование
	|	КОНЕЦ КАК НоменклатураПредставление,
	|	ВЫБОР
	|		КОГДА ТЧ.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТЧ.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ ТЧ.ЕдиницаИзмерения.Представление
	|	КОНЕЦ КАК ЕдиницаИзмеренияПредставление,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Сумма КАК Сумма,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	1 КАК НомерТабличнойЧасти,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьНДС
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СтавкаНДС <> &СтавкаБезНДС";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ОснованиеЭлектронногоСчета);
	Запрос.УстановитьПараметр("СтавкаБезНДС", Перечисления.СтавкиНДС.БезНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выбрать();
	
	Если Не ДанныеШапки.Следующий() Тогда
		Ошибка = СтрШаблон("СчетаНаОплату_Данные: Не удалось получить сведения по %1", Строка(ОснованиеЭлектронногоСчета));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ДанныеШапки.Номер;
	
	СведенияОбОрганизации = СчетаНаОплату_РеквизитыЮрФизЛица(ДанныеШапки.Организация);
	СчетПолучателя = СчетаНаОплату_РеквизитыСчетаОрганизации(ДанныеШапки.ЛицевойСчет, ДанныеШапки.РеквизитыЛицевогоСчета);
	
	СведенияОКонтрагенте = СчетаНаОплату_РеквизитыЮрФизЛица(ДанныеШапки.Контрагент);
	СчетПлательщика = СчетаНаОплату_РеквизитыСчетаКонтрагента(ДанныеШапки.СчетПлательщика);
	
	Шапка.Номер = НомерДокумента;
	Шапка.Дата = ДатаДокумента;
	Шапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	Шапка.УчитыватьНДС = Не РезультатыЗапроса[2].Пустой();
	Шапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	Шапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	Шапка.Валюта = ДанныеШапки.Валюта;
	Шапка.ВалютаКод = ДанныеШапки.ВалютаКод;
	
	Шапка.Продавец = ДанныеШапки.Организация;
	Шапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	Шапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	Шапка.Покупатель = ДанныеШапки.Контрагент;
	Шапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	Шапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте, СчетПлательщика);
	
	Шапка.РуководительФИО = Справочники.Сотрудники.ФамилияИО(ДанныеШапки.Руководитель, Истина);
	
	Если ЗначениеЗаполнено(СчетПолучателя) Тогда
		Шапка.ПродавецБанкБИК = СчетПолучателя.БИК;
		Шапка.ПродавецБанкПредставление = СчетПолучателя.Банк;
		Шапка.ПродавецБанковскийСчетНомер = СчетПолучателя.НомерСчета;
		Шапка.ПродавецБанковскийСчетКорСчет = СчетПолучателя.КоррСчет;
	КонецЕсли;
	
	Выборка = РезультатыЗапроса[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = ТабличнаяЧасть.Добавить();
		Запись.Номенклатура = Выборка.Номенклатура;
		Запись.Характеристика = Неопределено;
		Запись.НоменклатураАртикул = Выборка.НоменклатураАртикул;
		Запись.НоменклатураПредставление = Выборка.НоменклатураПредставление;
		Запись.Количество = Выборка.Количество;
		Запись.ЕдиницаИзмерения = Выборка.ЕдиницаИзмеренияПредставление;
		Запись.Упаковка = Неопределено;
		Запись.Цена = Выборка.Цена;
		Запись.Сумма = Выборка.Сумма;
		Запись.СуммаНДС = Выборка.СуммаНДС;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет адреса, телефон и факт в сведениях о юр./физ. лице
//
// Параметры:
//  Сведения - Структура - см. СчетаНаОплату_РеквизитыЮрФизЛица
//  ЮрФизЛицо - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - источник сведений
//
Процедура СчетаНаОплату_ЗаполнитьКонтактнуюИнформациюЮрФизЛица(Сведения, ЮрФизЛицо)
	
	ТипПараметра = ТипЗнч(ЮрФизЛицо);
	
	ВидыКИ = Справочники.ВидыКонтактнойИнформации;
	
	Если ТипПараметра = Тип("СправочникСсылка.Организации") Тогда
		
		ВладелецКИ = ЮрФизЛицо;
		ВидАдресЮридический = ВидыКИ.ЮрАдресОрганизации;
		ВидАдресФактический = ВидыКИ.ФактАдресОрганизации;
		ВидТелефон = ВидыКИ.ТелефонОрганизации;
		
	ИначеЕсли ТипПараметра = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Реквизиты = ЗначенияРеквизитовОбъектаЛок(ЮрФизЛицо, "ЮридическоеФизическоеЛицо, ВидКонтрагента");
		ВладелецКИ = Реквизиты.ЮридическоеФизическоеЛицо;
		
		Если Реквизиты.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			
			ВидАдресЮридический = ВидыКИ.ЮридическийАдресКонтрагенты;
			ВидАдресФактический = ВидыКИ.ФактическийАдресКонтрагенты;
			ВидТелефон = ВидыКИ.ТелефонКонтрагенты;
			
		Иначе
			
			ВидАдресЮридический = ВидыКИ.АдресПоПропискеФизическиеЛица;
			ВидАдресФактический = ВидыКИ.АдресМестаПроживанияФизическиеЛица;
			ВидТелефон = ВидыКИ.ТелефонДомашнийФизическиеЛица;
			
		КонецЕсли;
		
	Иначе
		
		Ошибка = СтрШаблон("Неожиданный тип параметра (ЮрФизЛицо = %1, Тип = %2)", Строка(ЮрФизЛицо), Строка(ТипПараметра));
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	МодульКонтактнаяИнформация = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
	
	Сведения.ЮридическийАдрес = МодульКонтактнаяИнформация.КонтактнаяИнформацияОбъекта(ВладелецКИ, ВидАдресЮридический);
	Сведения.ФактическийАдрес = МодульКонтактнаяИнформация.КонтактнаяИнформацияОбъекта(ВладелецКИ, ВидАдресФактический);
	Сведения.Телефоны = МодульКонтактнаяИнформация.КонтактнаяИнформацияОбъекта(ВладелецКИ, ВидТелефон);
	Сведения.Факс = "";
	
КонецПроцедуры

// Получает реквизиты банковского счета организации.
//
// Параметры:
//  ЛицевойСчет - СправочникСсылка.ЛицевыеСчета - лицевой счет организации.
//  РеквизитыЛицевогоСчета - СправочникСсылка.РеквизитыЛицевыхСчетов - Реквизиты лицевого счета организации.
// 
// Возвращаемое значение:
//  Структура - реквизиты счета для оплаты.
//
Функция СчетаНаОплату_РеквизитыСчетаОрганизации(ЛицевойСчет, РеквизитыЛицевогоСчета)
	
	Если Не ЗначениеЗаполнено(ЛицевойСчет)
		Или Не ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ИНН", "ИНН");
	Реквизиты.Вставить("КПП", "КПП");
	Реквизиты.Вставить("Корреспондент", "Корреспондент");
	Реквизиты.Вставить("НомерСчета", "СчетНомер");
	Реквизиты.Вставить("Банк", "Банк");
	Реквизиты.Вставить("Бик", "БИК");
	Реквизиты.Вставить("КоррСчет", "КоррСчет");
	
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, Реквизиты, Истина);
	
	Возврат Реквизиты;
	
КонецФункции

// Получает реквизиты банковского счета контрагента.
//
// Параметры:
//  СчетПлательщика - СправочникСсылка.БанковскиеИКазначейскиеСчета - счет контрагента.
// 
// Возвращаемое значение:
//  Структура - реквизиты счета контрагента.
//
Функция СчетаНаОплату_РеквизитыСчетаКонтрагента(СчетПлательщика)
	
	Если Не ЗначениеЗаполнено(СчетПлательщика) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Корреспондент", "Корреспондент");
	Реквизиты.Вставить("НомерСчета", "СчетНомер");
	Реквизиты.Вставить("Банк", "Банк");
	Реквизиты.Вставить("БИК", "БИК");
	Реквизиты.Вставить("КоррСчет", "КоррСчет");
	
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СчетПлательщика, СчетПлательщика, Реквизиты, Истина);
	
	Возврат Реквизиты;
	
КонецФункции

// Получает значения реквизитов юридического или физического лица.
//
// Параметры:
//  ЮрФизЛицо - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - юр./физ. лицо.
// 
// Возвращаемое значение:
//  Структура - реквизиты юр./физ. лица.
//
Функция СчетаНаОплату_РеквизитыЮрФизЛица(Знач ЮрФизЛицо)
	
	Сведения = Новый Структура;
	Сведения.Вставить("Представление", "");
	Сведения.Вставить("ПолноеНаименование", "");
	Сведения.Вставить("СокращенноеНаименование", "");
	Сведения.Вставить("НаименованиеДляПечатныхФорм", "");
	Сведения.Вставить("ФИОПБОЮЛ", "");
	Сведения.Вставить("КодПоОКПО", "");
	Сведения.Вставить("Свидетельство", "");
	Сведения.Вставить("ИНН", "");
	Сведения.Вставить("КПП", "");
	Сведения.Вставить("Телефоны", "");
	Сведения.Вставить("ЮридическийАдрес", "");
	Сведения.Вставить("ФактическийАдрес", "");
	Сведения.Вставить("Факс", "");
	
	Если НЕ ЗначениеЗаполнено(ЮрФизЛицо) Тогда
		Возврат Сведения;
	КонецЕсли;
	
	ЗапросПоОсновнымСведениям = Новый Запрос;
	
	ЗапросПоОсновнымСведениям.Текст = 
	"ВЫБРАТЬ
	|	Организации.Представление КАК Наименование,
	|	Организации.НаименованиеПолное КАК ПолноеНаименование,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КПП КАК КПП,
	|	Организации.КодОКПО КАК КодПоОКПО,
	|	Организации.НаименованиеСокращенное КАК СокращенноеНаименование,
	|	ВЫБОР
	|		КОГДА Организации.ИспользоватьВПлатежныхДокументахСокращенноеНаименование
	|			ТОГДА Организации.НаименованиеСокращенное
	|		ИНАЧЕ Организации.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеДляПечатныхФорм,
	|	Организации.НаименованиеПолное КАК ИндивидуальныйПредприниматель,
	|	Организации.СвидетельствоСерияНомер КАК СвидетельствоСерияНомер,
	|	Организации.СвидетельствоДатаВыдачи КАК СвидетельствоДатаВыдачи
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &ЮрФизЛицо
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагенты.Представление,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		ИНАЧЕ Контрагенты.Наименование
	|	КОНЕЦ,
	|	Контрагенты.ЮридическоеФизическоеЛицо.ИНН,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.КодОКПО
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	Контрагенты.НаименованиеСокращенное,
	|	Контрагенты.НаименованиеСокращенное,
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФИзЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	"""",
	|	""""
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &ЮрФизЛицо";
	
	ЗапросПоОсновнымСведениям.УстановитьПараметр("ЮрФизЛицо", ЮрФизЛицо);
	
	РезультатЗапросаПоОсновнымСведениям = ЗапросПоОсновнымСведениям.Выполнить();
	Если РезультатЗапросаПоОсновнымСведениям.Пустой() Тогда
		Ошибка = СтрШаблон("Не удалось получить сведения о юр./физ. лице (%1)", ЮрФизЛицо);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Выборка = РезультатЗапросаПоОсновнымСведениям.Выбрать();
	Выборка.Следующий();
	
	Сведения.ПолноеНаименование = СокрЛП(Выборка.ПолноеНаименование);
	Если НЕ ЗначениеЗаполнено(Сведения.ПолноеНаименование) Тогда
		Сведения.ПолноеНаименование = СокрЛП(Выборка.Наименование);
	КонецЕсли;
	
	Сведения.СокращенноеНаименование = СокрЛП(Выборка.СокращенноеНаименование);
	Сведения.НаименованиеДляПечатныхФорм = СокрЛП(Выборка.НаименованиеДляПечатныхФорм);
	Сведения.Представление = СокрЛП(Выборка.Наименование);
	Сведения.ИНН = Выборка.ИНН;
	Сведения.КПП = Выборка.КПП;
	Сведения.ФИОПБОЮЛ = "";
	Сведения.КодПоОКПО = Выборка.КодПоОКПО;
	
	Если НЕ ПустаяСтрока(Выборка.СвидетельствоСерияНомер) Тогда
		Сведения.Свидетельство = СтрШаблон("свидетельство %1 от %2",
			СокрЛП(Выборка.СвидетельствоСерияНомер),
			Формат(Выборка.СвидетельствоДатаВыдачи, "ДЛФ=D")
		);
	КонецЕсли;
	
	СчетаНаОплату_ЗаполнитьКонтактнуюИнформациюЮрФизЛица(Сведения, ЮрФизЛицо);
	
	Возврат Сведения;
	
КонецФункции

Функция ПредставлениеЮрФизЛицаСлужебный(Реквизиты, ШаблонПредставления)
	
	Перем Префикс, СтрокаДополнения;
	
	СоответствиеПараметров = Новый Структура;
	СоответствиеПараметров.Вставить("ПолноеНаименование", " ");
	СоответствиеПараметров.Вставить("СокращенноеНаименование", " ");
	СоответствиеПараметров.Вставить("НаименованиеДляПечатныхФорм", " ");
	СоответствиеПараметров.Вставить("ИНН", " ИНН ");
	СоответствиеПараметров.Вставить("КПП", " КПП ");
	СоответствиеПараметров.Вставить("Свидетельство", " ");
	СоответствиеПараметров.Вставить("СвидетельствоДатаВыдачи", " от ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес", " ");
	СоответствиеПараметров.Вставить("ФактическийАдрес", " ");
	СоответствиеПараметров.Вставить("Телефоны", " тел.: ");
	СоответствиеПараметров.Вставить("Факс", " факс: ");
	СоответствиеПараметров.Вставить("НомерСчета", " р/с ");
	СоответствиеПараметров.Вставить("Банк", " в банке ");
	СоответствиеПараметров.Вставить("БИК", " БИК ");
	СоответствиеПараметров.Вставить("КоррСчет", " к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО", " Код по ОКПО ");
	
	ПропускатьПустыеСтроки = Истина;
	Разделитель = ",";
	СписокПараметров = СтрРазделить(
		ШаблонПредставления,
		Разделитель,
		ПропускатьПустыеСтроки
	);
	
	Результат = Новый Массив;
	
	Для Каждого ИмяПараметра Из СписокПараметров Цикл
		
		Если Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения) Тогда
			
			Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения);
			Если ПустаяСтрока(СтрокаДополнения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СоответствиеПараметров.Свойство(ИмяПараметра, Префикс) Тогда
				Результат.Добавить(Префикс + СтрокаДополнения);
			Иначе
				Результат.Добавить(СтрокаДополнения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаРезультата = СтрСоединить(Результат, ",");
	СтрокаРезультата = СтрЗаменить(СтрокаРезультата, "  ", " ");
	
	Возврат СокрЛП(СтрокаРезультата);
	
КонецФункции

// Формирует строку с наименованием и реквизитами юридического или физического лица.
//
// Параметры:
//  РеквизитыЮрФизЛица - Структура - см. СчетаНаОплату_РеквизитыЮрФизЛица
//  РеквизитыСчета - Структура - (Необязательный) реквизиты счета
// 
// Возвращаемое значение:
//  Строка - строковое представление реквизитов.
//
Функция СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(Знач РеквизитыЮрФизЛица, Знач РеквизитыСчета = Неопределено)
	
	ШаблонПредставления = "НаименованиеДляПечатныхФорм,ИНН,КПП,ЮридическийАдрес,Телефоны";
	
	Если ЗначениеЗаполнено(РеквизитыСчета) Тогда
		
		ШаблонПредставления = ШаблонПредставления + ",НомерСчета,Банк,БИК,КоррСчет";
		
		Для Каждого Элемент Из РеквизитыСчета Цикл
			РеквизитыЮрФизЛица.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = ПредставлениеЮрФизЛицаСлужебный(РеквизитыЮрФизЛица, ШаблонПредставления);
	
	Возврат Результат;
	
КонецФункции

// Получает представление юр./физ. лица для вывода в печатной форме счета.
//
// Параметры:
//  РеквизитыЮрФизЛица - Структура - см. СчетаНаОплату_РеквизитыЮрФизЛица
// 
// Возвращаемое значение:
//  Строка - наименование юридического или физического лица для печати.
//
Функция СчетаНаОплату_ПредставлениеЮрФизЛица(РеквизитыЮрФизЛица)
	
	Результат = РеквизитыЮрФизЛица.СокращенноеНаименование;
	
	Если РеквизитыЮрФизЛица.Свойство("НаименованиеДляПечатныхФорм") Тогда
		Результат = РеквизитыЮрФизЛица.НаименованиеДляПечатныхФорм;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_ЗаголовокПечатнойФормы(Знач НомерДокумента, Знач ДатаДокумента)
	
	ДатаСтрокой = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
	
	Результат = СтрШаблон(
		"Счет на оплату № %1 от %2",
		НомерДокумента,
		ДатаСтрокой
	);
	
	Возврат Результат;
	
КонецФункции

