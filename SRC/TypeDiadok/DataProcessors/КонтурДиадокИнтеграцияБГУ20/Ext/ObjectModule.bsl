Функция ВидАдресаЮрФизЛица(Ссылка, ТипАдреса, ЭтоЮрЛицо)
	
	Перем Результат, ИмяВладельца;
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
		ИмяВладельца = "Организации";
		ПрефиксВидаЮр = "ЮрАдрес";
		ПрефиксВидаФакт = "ФактАдрес";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если ЭтоЮрЛицо Тогда
			ИмяВладельца = "Контрагенты";
			ПрефиксВидаЮр = "ЮридическийАдрес";
			ПрефиксВидаФакт = "ФактическийАдрес";
		Иначе
			ИмяВладельца = "ФизическиеЛица";
			ПрефиксВидаЮр = "АдресПоПрописке";
			ПрефиксВидаФакт = "АдресМестаПроживания";
		КонецЕсли;
		
	Иначе
		ИмяВладельца = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяВладельца) Тогда
		
		ВидыКИЮридическийАдрес = Перечисление_ВидыКонтактнойИнформации().ЮридическийАдрес;
		
		Если ТипАдреса = ВидыКИЮридическийАдрес Тогда
			ИмяВида = ПрефиксВидаЮр;
		Иначе
			ИмяВида = ПрефиксВидаФакт;
		КонецЕсли;
		
		ВидЭлементаКИ = ИмяВида + ИмяВладельца;
		
		Результат = Справочники.ВидыКонтактнойИнформации[ВидЭлементаКИ];
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

