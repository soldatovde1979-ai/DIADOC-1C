// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка - счет-фактура, основание которой нужно найти;
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на основания счета-фактуры.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФактура, "ДокументОснование");
	
	Если ЗначениеЗаполнено(ДокументОснование)
		И Результат.Найти(ДокументОснование) = Неопределено Тогда
		Результат.Добавить(ДокументОснование);
	КонецЕсли;
			
	Возврат Результат;
	
КонецФункции

// Процедура - При получении оснований документа учета
