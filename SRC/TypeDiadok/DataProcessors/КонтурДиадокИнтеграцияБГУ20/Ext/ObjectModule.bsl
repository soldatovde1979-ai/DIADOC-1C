Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаНакладнаяНаРеализациюТорг12()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТчНоменклатура.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			ТОГДА ""Работа""
	|		КОГДА ТчНоменклатура.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|				ИЛИ ТчНоменклатура.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.УслугиАренды)
	|				ИЛИ ТчНоменклатура.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Госуслуга)
	|				ИЛИ ТчНоменклатура.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ГруппаУслуг)
	|			ТОГДА ""Услуга""
	|		ИНАЧЕ ""Товар""
	|	КОНЕЦ КАК ТипНоменклатуры,
	|	1 КАК Порядок,
	|	ТчНоменклатура.Номенклатура КАК Товар,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000))) <> """"
	|			ТОГДА ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000))
	|		ИНАЧЕ СпрНоменклатура.Наименование
	|	КОНЕЦ КАК ТоварНаименование,
	|	СпрНоменклатура.Код КАК КодИлиАртикулНоменклатуры,
	|	ТчНоменклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(СтраныМира.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(СтраныМира.УчастникЕАЭС, ИСТИНА) КАК СтранаПроисхожденияУчастникЕАЭС,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕИ.НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторЕИ.Код, """") КАК ЕдиницаИзмеренияКод,
	|	"""" КАК НомерГТД,
	|	ТчНоменклатура.Количество КАК Количество,
	|	ТчНоменклатура.Цена КАК Цена,
	|	ТчНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	ТчНоменклатура.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчНоменклатура.Сумма - ТчНоменклатура.СуммаНДС
	|		ИНАЧЕ ТчНоменклатура.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчНоменклатура.Сумма + ТчНоменклатура.СуммаНДС
	|		ИНАЧЕ ТчНоменклатура.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	ТчНоменклатура.НомерСтроки КАК НомерСтроки,
	|	ТчНоменклатура.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	СпрНоменклатура.КодТНВЭД КАК НоменклатураТНВЭД,
	|	ТчНоменклатура.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТчНоменклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК ТчНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НакладнаяНаРеализациюТорг12 КАК ДанныеШапки
	|		ПО ТчНоменклатура.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчНоменклатура.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕИ
	|		ПО (СпрНоменклатура.ЕдиницаИзмерения = КлассификаторЕИ.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО ТчНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка
	|ГДЕ
	|	ТчНоменклатура.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""ВозвратнаяТара"",
	|	2,
	|	ВозвратнаяТара.Номенклатура,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000))) <> """"
	|			ТОГДА ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000))
	|		ИНАЧЕ СпрНоменклатура.Наименование
	|	КОНЕЦ,
	|	СпрНоменклатура.Код,
	|	НЕОПРЕДЕЛЕНО,
	|	"""",
	|	ИСТИНА,
	|	СпрНоменклатура.ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕИ.НаименованиеПолное, """"),
	|	ЕСТЬNULL(КлассификаторЕИ.Код, """"),
	|	"""",
	|	ВозвратнаяТара.Количество,
	|	ОКР(ВозвратнаяТара.Сумма / ВозвратнаяТара.Количество, 2),
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС),
	|	0,
	|	ВозвратнаяТара.Сумма,
	|	ВозвратнаяТара.Сумма,
	|	ВозвратнаяТара.НомерСтроки,
	|	ЛОЖЬ,
	|	СпрНоменклатура.КодТНВЭД,
	|	ВозвратнаяТара.НомерСтроки,
	|	ВозвратнаяТара.Ссылка
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12.ВозвратнаяТара КАК ВозвратнаяТара
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВозвратнаяТара.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕИ
	|		ПО (СпрНоменклатура.ЕдиницаИзмерения = КлассификаторЕИ.Ссылка)
	|ГДЕ
	|	ВозвратнаяТара.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки";
	
	Возврат Результат;
	
