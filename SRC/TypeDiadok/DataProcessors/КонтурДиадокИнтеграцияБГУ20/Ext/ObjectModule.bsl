//{ УПД970. Исходные данные по документам

Функция УПД970_ИсходныеДанныеДокументаСчетФактураВыданный(ДокСсылка)
	
	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданный();
	ТекстЗапросаТаблицаТоваров = УПД970_ТекстЗапросаСчетФактура_СоставНФА();
	ТекстЗапросаДанныхОДокументахОплаты = УПД970_ТекстЗапросаСчетФактура_ПлатежноРасчетныеДокументы();
	ТекстЗапросаДанныхДокументовОбОтгрузке = УПД970_ТекстЗапросаСчетФактура_ДокументыОбОтгрузке();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаТаблицаТоваров);
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхОДокументахОплаты);
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхДокументовОбОтгрузке);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТабДанныеШапки = РезультатыЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТабДанныеШапки[0]);
	
	ТабличныеДанные = РезультатыЗапроса[1].Выгрузить();
	СведенияОДокументахОплаты = РезультатыЗапроса[2].Выгрузить();
	СведенияОДокументахОтгрузки = РезультатыЗапроса[3].Выгрузить();
	
	ДокументОснование = ДанныеШапки.ДокументОснование;
	
	ОснованияПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваровПоОснованию(
		ДокументОснование
	);
		
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО(ДанныеШапки);
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	
	Результат = УПД970_Контракт_ДанныеСчетФактура();
	
	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ТабличныеДанные = ТабличныеДанные;
	Результат.ДокументыОснования = ЗначениеВМассив(ДанныеШапки.ДокументОснование);
	Результат.СведенияОДокументахОтгрузки = СведенияОДокументахОтгрузки;
	Результат.СведенияОДокументахОплаты = СведенияОДокументахОплаты;
	Результат.ЭтоСчетФактураНаАванс = Ложь;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.ОснованияПередачиТоваров = ОснованияПередачиТоваров;
	Результат.КодВидаОперации = ДанныеШапки.КодВидаОперации;
	Результат.СведенияОбУчастникахЭДО = СведенияОбУчастникахЭДО;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры(ДокСсылка, СчетФактура)
	
	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаАктОбОказанииУслуг(ДокСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаНакладнаяНаРеализациюТорг12(ДокСсылка, СчетФактура);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеДокументаАктОбОказанииУслуг(ДокСсылка, СчетФактура = Неопределено)
	
	ТекстЗапросаДанныхШапки = УПД970_ТекстЗапросаДанныхШапкиДокументаАктОбОказанииУслуг();
	ТекстЗапросаТабличныхДанных = УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаАктОбОказанииУслуг();
	ТекстЗапросаСведенийПрослеживаемости = Неопределено;
	
	Результат = УПД970_ИсходныеДанныеПервичногоДокумента(
		ДокСсылка,
		СчетФактура,
		ТекстЗапросаДанныхШапки,
		ТекстЗапросаТабличныхДанных,
		ТекстЗапросаСведенийПрослеживаемости
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеДокументаНакладнаяНаРеализациюТорг12(ДокСсылка, СчетФактура = Неопределено)
	
	ТекстЗапросаДанныхШапки = УПД970_ТекстЗапросаДанныхШапкиДокументаНакладнаяНаРеализациюТорг12();
	ТекстЗапросаТабличныхДанных = УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаНакладнаяНаРеализациюТорг12();
	ТекстЗапросаПрослеживаемость = УПД970_ТекстЗапросаСведенийОПрослеживаемостиДокументаНакладнаяНаРеализациюТорг12();
	
	Результат = УПД970_ИсходныеДанныеПервичногоДокумента(
		ДокСсылка,
		СчетФактура,
		ТекстЗапросаДанныхШапки,
		ТекстЗапросаТабличныхДанных,
		ТекстЗапросаПрослеживаемость
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеПервичногоДокумента(
	ДокСсылка,
	СчетФактура,
	ТекстЗапросаДанныхШапки,
	ТекстЗапросаТабличныхДанных,
	ТекстЗапросаСведенийПрослеживаемости)
	
	ЕстьСведенияПрослеживаемости = ЗначениеЗаполнено(ТекстЗапросаСведенийПрослеживаемости);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхШапки);
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныхДанных);
	
	Если ЕстьСведенияПрослеживаемости Тогда
		ТекстыЗапросов.Добавить(ТекстЗапросаСведенийПрослеживаемости);
	КонецЕсли;
	
	СтрОбъединениеЗапросов = ТекстЗапроса_РазделительЗапросов();
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, СтрОбъединениеЗапросов);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатЗапросаПоШапке = РезультатыЗапроса[0];
	РезультатЗапросаПоТаблицам = РезультатыЗапроса[1];
	
	Если ЕстьСведенияПрослеживаемости Тогда
		РезультатЗапросаПоПрослеживаемости = РезультатыЗапроса[2];
	Иначе
		РезультатЗапросаПоПрослеживаемости = Неопределено;
	КонецЕсли;
	
	Результат = УПД970_ОбработатьДанныеПервичногоДокумента(
		РезультатЗапросаПоШапке,
		РезультатЗапросаПоТаблицам,
		РезультатЗапросаПоПрослеживаемости,
		СчетФактура
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбработатьДанныеПервичногоДокумента(
	РезультатЗапросаПоШапке,
	РезультатЗапросаПоТаблицам,
	РезультатЗапросаПоПрослеживаемости,
	СчетФактура)
	
	ДанныеШапкиТаблица = РезультатЗапросаПоШапке.Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеШапкиТаблица[0]);
	
	ТабличныеДанные = РезультатЗапросаПоТаблицам.Выгрузить();
	
	Если РезультатЗапросаПоПрослеживаемости = Неопределено Тогда
		СведенияПрослеживаемости = Неопределено;
	Иначе
		СведенияПрослеживаемости = РезультатЗапросаПоПрослеживаемости.Выгрузить();
	КонецЕсли;
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО(ДанныеШапки);
	
	Если УПД970_ВТабличныхДанныхДокументаНетТоваров(ТабличныеДанные) Тогда
		СведенияОбУчастникахЭДО.Грузоотправитель = Неопределено;
		СведенияОбУчастникахЭДО.Грузополучатель = Неопределено;
	КонецЕсли;
	
	ОснованияПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваров(
		ДанныеШапки.ДоговорНомер,
		ДанныеШапки.ДоговорДата
	);
	
	Результат = УПД970_Контракт_ДанныеПервичногоДокумента();
	
	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ТабличныеДанные = ТабличныеДанные;
	Результат.СведенияПрослеживаемости = СведенияПрослеживаемости;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.СчетФактура = СчетФактура;
	Результат.СведенияОбУчастникахЭДО = СведенияОбУчастникахЭДО;
	Результат.ОснованияПередачиТоваров = ОснованияПередачиТоваров;
	
	Возврат Результат;
	
КонецФункции

//{ УПД970. Исходные данные по документам. Тексты запросов

Функция УПД970_ТекстЗапросаСчетФактура_ПлатежноРасчетныеДокументы()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПлатежноРасчетныеДокументы.ДатаДокумента КАК ДатаДокумента,
	|	ПлатежноРасчетныеДокументы.НомерДокумента КАК НомерДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК ПлатежноРасчетныеДокументы
	|ГДЕ
