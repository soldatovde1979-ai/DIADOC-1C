// Возвращает заполненную протоструктуру титула продавца в формате 970 по данным документа 1С
//
// Параметры:
//  ДокСсылка - ДокументСсылка - ссылка на учетный документ 1С,
//                               по которому заполняется протоконтент титула продавца 970@
//  ФункцияДокумента - Строка - функция УПД (возможные значения: СЧФ, СЧФДОП, ДОП)
//  ДополнительныеПараметры - Структура - Модуль_Ядро.ДополнительныеПараметрыПолученияКонтента
// 
// Возвращаемое значение:
//  Структура - заполненный протоконтент УПД (см. Контракт_ПротоСтруктураУПД970)
//
Функция УПД970_КонтентТитулаПродавца(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры) Экспорт
	
	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокСсылка);
	
	Если ЭтоСчетФактураНаАванс(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураНаАванс(ДокСсылка);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуСчетФактура(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры
		);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуАктОбОказанииУслуг(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры
		);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуНакладнаяНаРеализациюТорг12(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры
		);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

//} УПД970. Программный интерфейс

//{ УПД970. Заполнение протоструктуры по документам

Функция УПД970_КонтентТитулаПродавцаПоДокументуСчетФактура(
	ДокСсылка,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	Контент = Контракт_ПротоструктураУПД970();
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокументаСчетФактураВыданный(ДокСсылка);
	
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента);
	Контент.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	
	УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(
		Контент,
		ДанныеПоДокументу.СведенияОДокументахОплаты
	);
	
	ДокументыОснования = ДанныеПоДокументу.ДокументыОснования;
	ДокументОснование = ДокументыОснования[0];
	
	УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки.Номер, ДанныеШапки.Дата, ДокСсылка);
	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки.ВалютаДокументаКод);
	
	ДанныеПоДокументуОснования = УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры(ДокументОснование, ДокСсылка);
	
	Если ЗначениеЗаполнено(ДанныеПоДокументуОснования) Тогда
		
		ДанныеДляЗаполнения = ДанныеПоДокументуОснования;
		
	Иначе
		
		ДанныеДляЗаполнения = ДанныеПоДокументу;
		
	КонецЕсли;
		
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокумента(
		Контент,
		ДанныеДляЗаполнения,
		ДополнительныеПараметры); 
			
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО_ТолькоУслуги(ДанныеДляЗаполнения);
		
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(
		Контент, 
		СведенияОбУчастникахЭДО);
	
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(
		Контент,
		ДокументыОснования,
		ДанныеПоДокументу.СведенияОДокументахОтгрузки,
		ФункцияДокумента
	);
	
	УПД970_ЗаполнитьРеквизитыОснованияПередачиТоваров(
		Контент,
		ДанныеДляЗаполнения.ОснованияПередачиТоваров,
		ДополнительныеПараметры
	);
	
	УПД970_ЗаполнитьНаименованиеДокумента(Контент, ФункцияДокумента);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	УПД970_ЗаполнитьСведенияОСотруднике(Контент, ДополнительныеПараметры);
	УПД970_ЗаполнитьСведенияОМаркировке(Контент, ДокСсылка, ДополнительныеПараметры.ИспользоватьСервисКонтурМаркировка);
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	Возврат Контент;
	
КонецФункции

Функция УПД970_СведенияОбУчастникахЭДО_ТолькоУслуги(ДанныеДляЗаполнения)
	
	Результат = ДанныеДляЗаполнения.СведенияОбУчастникахЭДО;
	
	ТабличныеДанные = ДанныеДляЗаполнения.ТабличныеДанные;
	
	ЕстьТовары = ТабличныеДанные.Найти("Товар", "ТипНоменклатуры") <> Неопределено
	ИЛИ ТабличныеДанные.Найти("Имущество", "ТипНоменклатуры") <> Неопределено;
	
	Если Не ЕстьТовары Тогда
		Результат.Грузоотправитель = Неопределено;
		Результат.Грузополучатель = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураНаАванс(ДокСсылка)
	
	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданный();
	ТекстЗапросаТаблицаТоваров = УПД970_ТекстЗапросаСчетФактура_СоставНФА();
	ТекстЗапросаДанныхОДокументахОплаты = УПД970_ТекстЗапросаСчетФактура_ПлатежноРасчетныеДокументы();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаТаблицаТоваров);
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхОДокументахОплаты);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТабДанныеШапки = РезультатыЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТабДанныеШапки[0]);
	
	ТабличныеДанные = РезультатыЗапроса[1].Выгрузить();
	СведенияОДокументахОплаты = РезультатыЗапроса[2].Выгрузить();
	
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО(ДанныеШапки);
	
	Контент = Контракт_ПротоструктураУПД970();
	Контент.Function = "СЧФ";
	Контент.CircumFormatInvoice = "2";
	Контент.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	
	УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки.Номер, ДанныеШапки.Дата, ДокСсылка);
	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки.ВалютаДокументаКод);
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, СведенияОбУчастникахЭДО);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(Контент, СведенияОДокументахОплаты);
	УПД970_ЗаполнитьТаблицуКонтентаПоДаннымСчетФактураНаАванс(Контент, ТабличныеДанные);
	
	Возврат Контент;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоДокументуАктОбОказанииУслуг(
	ДокСсылка,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	Контент = Контракт_ПротоструктураУПД970();
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокументаАктОбОказанииУслуг(ДокСсылка);
	
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента);
	
	УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки.Номер, ДанныеШапки.Дата, ДокСсылка);
	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки.ВалютаДокументаКод);
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, ДанныеПоДокументу.СведенияОбУчастникахЭДО);
	
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокумента(
		Контент,
		ДанныеПоДокументу,
		ДополнительныеПараметры
	);
	
	ДокументыОтгрузки = ЗначениеВМассив(ДанныеШапки.Ссылка);
	
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДокументыОтгрузки, Неопределено, ФункцияДокумента);
	УПД970_ЗаполнитьРеквизитыОснованияПередачиТоваров(
		Контент,
		ДанныеПоДокументу.ОснованияПередачиТоваров,
		ДополнительныеПараметры
	);
	УПД970_ЗаполнитьНаименованиеДокумента(Контент, ФункцияДокумента);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	Возврат Контент;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоДокументуНакладнаяНаРеализациюТорг12(
	ДокСсылка,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	Контент = Контракт_ПротоструктураУПД970();
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокументаНакладнаяНаРеализациюТорг12(ДокСсылка);
	
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента);
	
	УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки.Номер, ДанныеШапки.Дата, ДокСсылка);
	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки.ВалютаДокументаКод);
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, ДанныеПоДокументу.СведенияОбУчастникахЭДО);
	
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокумента(
		Контент,
		ДанныеПоДокументу,
		ДополнительныеПараметры
	);
	
	ДокументыОтгрузки = ЗначениеВМассив(ДанныеШапки.Ссылка);
	
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДокументыОтгрузки, Неопределено, ФункцияДокумента);
	УПД970_ЗаполнитьРеквизитыОснованияПередачиТоваров(
		Контент,
		ДанныеПоДокументу.ОснованияПередачиТоваров,
		ДополнительныеПараметры
	);
	УПД970_ЗаполнитьНаименованиеДокумента(Контент, ФункцияДокумента);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	УПД970_ЗаполнитьСведенияОСотруднике(Контент, ДополнительныеПараметры);
	УПД970_ЗаполнитьСведенияОМаркировке(Контент, ДокСсылка, ДополнительныеПараметры.ИспользоватьСервисКонтурМаркировка);
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	Возврат Контент;
	
КонецФункции

