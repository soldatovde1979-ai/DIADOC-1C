// Используется для списка контрагентов в основном модуле для режима "Поиск и приглашение"
Функция ПолучитьКоличествоДокументовЗаПериод(Параметры)

	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Poluchit%27_Kolichestvo_Dokumentov_Za_Period.html
	
	МассивКонтрагентов	= Параметры.МассивКонтрагентов;
	ОрганизацияВ1С		= Параметры.Организация;
	
	СоответствиеДокументыЗаПериод = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивКонтрагентов",	МассивКонтрагентов);
	Запрос.УстановитьПараметр("ДатаНачала",			ДобавитьМесяц(КонецДня(ТекущаяДата()), -3));
	Запрос.УстановитьПараметр("Организация",		ОрганизацияВ1С);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НакладнаяНаРеализациюТорг12.Контрагент КАК Связь1,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НакладнаяНаРеализациюТорг12.Ссылка) КАК ДокументовЗаПериод
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.НакладнаяНаРеализациюТорг12 КАК НакладнаяНаРеализациюТорг12
	|ГДЕ
	|	НакладнаяНаРеализациюТорг12.Проведен = ИСТИНА
	|	И НакладнаяНаРеализациюТорг12.Организация = &Организация
	|	И НакладнаяНаРеализациюТорг12.Дата >= &ДатаНачала
	|	И НакладнаяНаРеализациюТорг12.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	НакладнаяНаРеализациюТорг12.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АктОбОказанииУслуг.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ АктОбОказанииУслуг.Ссылка)
	|ИЗ
	|	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	|ГДЕ
	|	АктОбОказанииУслуг.Проведен = ИСТИНА
	|	И АктОбОказанииУслуг.Организация = &Организация
	|	И АктОбОказанииУслуг.Дата >= &ДатаНачала
	|	И АктОбОказанииУслуг.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	АктОбОказанииУслуг.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеМЗ.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеМЗ.Ссылка)
	|ИЗ
	|	Документ.ПоступлениеМЗ КАК ПоступлениеМЗ
	|ГДЕ
	|	ПоступлениеМЗ.Проведен = ИСТИНА
	|	И ПоступлениеМЗ.Организация = &Организация
	|	И ПоступлениеМЗ.Дата >= &ДатаНачала
	|	И ПоступлениеМЗ.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеМЗ.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеУслугРабот.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеУслугРабот.Ссылка)
	|ИЗ
	|	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	|ГДЕ
	|	ПоступлениеУслугРабот.Проведен = ИСТИНА
	|	И ПоступлениеУслугРабот.Организация = &Организация
	|	И ПоступлениеУслугРабот.Дата >= &ДатаНачала
	|	И ПоступлениеУслугРабот.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеУслугРабот.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Связь1 КАК Связь1,
	|	СУММА(ВТ_Документы.ДокументовЗаПериод) КАК ДокументовЗаПериод
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Документы.Связь1";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;

КонецФункции // КоличествоДокументовЗаПериод()

