//{ УПД970. Служебные процедуры и функции

Функция УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента)
	
	Результат = Неопределено;
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФ() Тогда
		
		Результат = УПД970_ОбстоятельстваФормированияСчетФактуры(ДанныеПоДокументу);
		
	Иначе
		
		Результат = УПД970_ОбстоятельстваФормированияУПД(ДанныеПоДокументу);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияУПД(ДанныеПоДокументу)
	
	Результат = Неопределено;
	
	Если ДанныеПоДокументу.ЭтоДоговорСКомитентом Тогда
		Результат = "00007";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияСчетФактуры(ДанныеПоДокументу)
	
	Если ДанныеПоДокументу.КодВидаОперации = "01" И ДанныеПоДокументу.ЭтоДоговорСКомитентом Тогда
		Результат = "1";
	ИначеЕсли ДанныеПоДокументу.КодВидаОперации = "02" Тогда
		Результат = "2";
	ИначеЕсли ДанныеПоДокументу.КодВидаОперации = "27" Тогда
		Результат = "3";
	ИначеЕсли ДанныеПоДокументу.КодВидаОперации = "06" Тогда
		Результат = "4";
	ИначеЕсли ДанныеПоДокументу.КодВидаОперации = "34"
		Или (ДанныеПоДокументу.КодВидаОперации = "33" И ДанныеПоДокументу.ЭтоСчетФактураНаАванс) Тогда
		Результат = "5";
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияПередачиТоваровПоОснованию(СсылкаНаОбъект)
	
	Результат = Новый Массив;
	
	ЕстьРеквизитДоговор = ЗначениеЗаполнено(СсылкаНаОбъект) 
		И Ядро.Общее_ЕстьРеквизитМетаданных(СсылкаНаОбъект.Метаданные(), "Договор");
		
	Если Не ЕстьРеквизитДоговор Тогда
		Возврат Результат;
	КонецЕсли;
	
	РеквизитыДокумента = "Договор.НомерДоговора, Договор.ДатаДоговора";
	
	ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыДокумента);
	
	Результат = УПД970_РеквизитыОснованияПередачиТоваров(
		ЗначенияРеквизитовДокумента.ДоговорНомерДоговора,
		ЗначенияРеквизитовДокумента.ДоговорДатаДоговора
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияПередачиТоваров(НомерДоговора, ДатаДоговора)
	
	Результат = Новый Массив;
	
	РеквизитыОснования = Новый Структура;
	РеквизитыОснования.Вставить("Наименование", "Договор");
	РеквизитыОснования.Вставить("Номер", НомерДоговора);
	РеквизитыОснования.Вставить("Дата", ДатаДоговора);
	
	Результат.Добавить(РеквизитыОснования);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбУчастникахЭДО(ДанныеШапки)
	
	ЭтоОПНаОтдельномБалансе = УПД970_ЭтоОПНаОтдельномБалансе(ДанныеШапки.Организация, ДанныеШапки.ГоловнаяОрганизация);
	ЭтоОПНаОбщемБалансе = ДанныеШапки.ОбособленноеПодразделение;
	
	СведенияОбОрганизации = УПД970_СведенияОбОрганизации(ДанныеШапки, ЭтоОПНаОтдельномБалансе, ЭтоОПНаОбщемБалансе);
	
	СведенияОКонтрагенте = УПД970_СведенияОКонтрагенте(ДанныеШапки);
	
	СведенияОГрузоотправителе = УПД970_СведенияОГрузоотправителе(
		ДанныеШапки,
		ЭтоОПНаОтдельномБалансе,
		ЭтоОПНаОбщемБалансе
	);
	
	СведенияОГрузополучателе = УПД970_СведенияОГрузополучателе(ДанныеШапки);
	
	Результат = УПД970_Контракт_УчастникиЭДО();
	Результат.Организация = СведенияОбОрганизации;
	Результат.Контрагент = СведенияОКонтрагенте;
	Результат.Грузоотправитель = СведенияОГрузоотправителе;
	Результат.Грузополучатель = СведенияОГрузополучателе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбОрганизации(ДанныеШапки, ЭтоОПНаОтдельномБалансе, ЭтоОПНаОбщемБалансе)
	
	Если ЭтоОПНаОтдельномБалансе Тогда
		Организация = ДанныеШапки.ГоловнаяОрганизация;
	Иначе
		Организация = ДанныеШапки.Организация;
	КонецЕсли;
	
	Результат = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Организация,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации
	);
	
	Если ЭтоОПНаОтдельномБалансе Тогда
		
		КПППродавца = ДанныеШапки.ОрганизацияКПП;
		
		Если НЕ ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетОрганизации) Тогда
			УПД970_ЗаполнитьДанныеБанка(Результат, ДанныеШапки.Организация, Неопределено);
		КонецЕсли;
		
	ИначеЕсли ЭтоОПНаОбщемБалансе Тогда
		КПППродавца = ДанныеШапки.ПодразделениеКПП;
	Иначе
		КПППродавца = Результат.КПП;
	КонецЕсли;
	
	Результат.КПП = КПППродавца;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОКонтрагенте(ДанныеШапки)
	
	Если ЗначениеЗаполнено(ДанныеШапки.ГоловнойКонтрагент) Тогда
		Контрагент = ДанныеШапки.ГоловнойКонтрагент;
	Иначе
		Контрагент = ДанныеШапки.Контрагент;
	КонецЕсли;
	
	Результат = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Контрагент,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетКонтрагента
	);
	
	Если ЗначениеЗаполнено(ДанныеШапки.ГоловнойКонтрагент) Тогда
		Результат.КПП = ДанныеШапки.КонтрагентКПП;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОГрузоотправителе(ДанныеШапки, ЭтоОПНаОтдельномБалансе, ЭтоОПНаОбщемБалансе)
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
		
		Результат = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетГрузоотправителя
		);
		
	ИначеЕсли ЭтоОПНаОтдельномБалансе Тогда
		
		Результат = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Организация,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетОрганизации
		);
		
	ИначеЕсли ЭтоОПНаОбщемБалансе Тогда
		
		Результат = УПД970_ДанныеУчастникаЭДО(ДанныеШапки.Организация, ДанныеШапки.Дата);
		
		Результат.Ссылка = ДанныеШапки.Подразделение;
		Результат.Адрес = УПД970_СведенияОФактическомАдресе(ДанныеШапки.Подразделение, ДанныеШапки.Дата, Истина);
		Результат.Наименование = ДанныеШапки.ПодразделениеНаименование;
		Результат.КПП = ДанныеШапки.ПодразделениеКПП;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОГрузополучателе(ДанныеШапки)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		
		Результат = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетГрузополучателя
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЭтоОПНаОтдельномБалансе(Организация, ГоловнаяОрганизация)
	
	Если ЗначениеЗаполнено(ГоловнаяОрганизация)
		И Организация <> ГоловнаяОрганизация Тогда
		
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсЮрАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений, Результат.ЭтоЮрЛицо);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсФактАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений, Результат.ЭтоЮрЛицо);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_Контракт_ДанныеУчастникаЭДО();
	
	СведенияОЮрФизЛице = Новый Структура;
	
	МодульЭлектронныеДокументы = ОбщегоНазначения.ОбщийМодуль("ЭлектронныеДокументыБГУ");
	МодульЭлектронныеДокументы.ПолучитьДанныеЮрФизЛица(Ссылка, СведенияОЮрФизЛице, ДатаСведений);
	
	Результат.Ссылка = Ссылка;
	Результат.Наименование = УПД970_НаименованиеУчастникаЭДО(СведенияОЮрФизЛице);
	Результат.ИНН = СведенияОЮрФизЛице.ИНН;
	Результат.КПП = СведенияОЮрФизЛице.КПП;
	Результат.КодПоОКПО = СведенияОЮрФизЛице.КодПоОКПО;
	Результат.Телефоны = СведенияОЮрФизЛице.Телефоны;
	Результат.ЭлектроннаяПочта = СведенияОЮрФизЛице.ЭлектроннаяПочта;
	Результат.ЭтоЮрЛицо = (СведенияОЮрФизЛице.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо);
	Результат.ЭтоФизЛицо = (СведенияОЮрФизЛице.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо);
	
	УПД970_ЗаполнитьДанныеБанка(Результат, Ссылка, БанковскийСчет);
	
	Если СведенияОЮрФизЛице.ИП Тогда
		
		ДатаОГРНИП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЮридическоеФизическоеЛицо.ДатаРегистрации");
		
		Результат.ОГРНИП = СведенияОЮрФизЛице.ОГРНИП;
		Результат.ДатаОГРНИП = ДатаОГРНИП;
		Результат.ЭтоФизЛицо = Ложь;
		
		СвидетельствоДатаВыдачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			Ссылка,
			"ЮридическоеФизическоеЛицо.СвидетельствоДата"
		);
		
		Результат.Свидетельство = УПД970_СвидетельствоОГосРегистрации(
			СведенияОЮрФизЛице.СвидетельствоСерияНомер,
			СвидетельствоДатаВыдачи
		);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОЮрФизЛице.СтранаРегистрации) Тогда
		ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СведенияОЮрФизЛице.СтранаРегистрации, "Код, Наименование");
		
		Результат.СтранаКод = ДанныеСтраны.Код;
		Результат.СтранаНаименование = ДанныеСтраны.Наименование;
	Иначе
		Результат.СтранаКод = ОсновнаяСтрана().Код;
		Результат.СтранаНаименование = ОсновнаяСтрана().Наименование;
	КонецЕсли;
	
	Результат.Нерезидент = (Результат.СтранаКод <> ОсновнаяСтрана().Код);
	
	Если Результат.Нерезидент Тогда
		Результат.НалоговыйНомерВСтранеРегистрации = СведенияОЮрФизЛице.НалоговыйНомерВСтранеРегистрации;
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиОрганизации(Результат, Ссылка, СведенияОЮрФизЛице);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НаименованиеУчастникаЭДО(СведенияОЮрФизЛице)
	
	Результат = СведенияОЮрФизЛице.ПолноеНаименование;
	
	Если СведенияОЮрФизЛице.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		ФИОУчастникаЭДО = Новый Массив;
		ФИОУчастникаЭДО.Добавить(СведенияОЮрФизЛице.Фамилия);
		ФИОУчастникаЭДО.Добавить(СведенияОЮрФизЛице.Имя);
		ФИОУчастникаЭДО.Добавить(СведенияОЮрФизЛице.Отчество);
		
		РазделительФИО = " ";
		Результат = СтрСоединить(ФИОУчастникаЭДО, РазделительФИО);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьДанныеБанка(Результат, ЮрФизЛицо, БанковскийСчет)
	
	БанковскийСчетЮрФизЛица = БанковскийСчет;
	
	Если НЕ ЗначениеЗаполнено(БанковскийСчетЮрФизЛица) Тогда
		БанковскийСчетЮрФизЛица = УПД970_БанковскийСчетПоУмолчанию(ЮрФизЛицо);
	КонецЕсли;
	
	РеквизитыРасчетногоСчета = БанковскиеРеквизитыРасчетногоСчета(БанковскийСчетЮрФизЛица);
	
	Результат.НаименованиеБанка = РеквизитыРасчетногоСчета.НаименованиеБанкаПолучателя;
	Результат.НомерСчета = РеквизитыРасчетногоСчета.НомерСчетаПолучателя;
	Результат.БИК = РеквизитыРасчетногоСчета.БикБанкаПолучателя;
	Результат.КоррСчет = РеквизитыРасчетногоСчета.СчетБанкаПолучателя;
	
КонецПроцедуры

Функция УПД970_БанковскийСчетПоУмолчанию(ЮрФизЛицо)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", ЮрФизЛицо);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеИКазначейскиеСчета.Ссылка КАК Ссылка,
	|	БанковскиеИКазначейскиеСчета.Код КАК НомерСчета
	|ИЗ
	|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
	|ГДЕ
	|	БанковскиеИКазначейскиеСчета.Владелец = &Владелец
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеквизитыЛицевыхСчетов.Ссылка,
	|	РеквизитыЛицевыхСчетов.Владелец.Код
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец.Владелец = &Владелец";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
			Результат = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
		Иначе
			Результат = Справочники.ЛицевыеСчета.ПустаяСсылка();
		КонецЕсли;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДополнитьСведенияОбУчастникеЭДОДаннымиОрганизации(Результат, Ссылка, СведенияОЮрФизЛице)
	
	ДанныеОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Ссылка,
		"ИспользоватьВПлатежныхДокументахСокращенноеНаименование, СвидетельствоСерияНомер, СвидетельствоДатаВыдачи"
	);
	
	Если ДанныеОрганизации.ИспользоватьВПлатежныхДокументахСокращенноеНаименование Тогда
		Результат.Наименование = СведенияОЮрФизЛице.СокращенноеНаименование;
	КонецЕсли;
	
	Результат.Свидетельство = УПД970_СвидетельствоОГосРегистрации(
		ДанныеОрганизации.СвидетельствоСерияНомер,
		ДанныеОрганизации.СвидетельствоДатаВыдачи
	);
	
КонецПроцедуры

Функция УПД970_СвидетельствоОГосРегистрации(СвидетельствоСерияНомер, СвидетельствоДатаВыдачи)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(СвидетельствоСерияНомер) Тогда
		Результат = "свидетельство " + СвидетельствоСерияНомер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвидетельствоДатаВыдачи) Тогда
		Результат = Результат + " от " + Формат(СвидетельствоДатаВыдачи, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений, ЭтоЮрЛицо)
	
	ВидыКИ = Перечисление_ВидыКонтактнойИнформации();
	
	Результат = УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидыКИ.ЮридическийАдрес, ДатаСведений, ЭтоЮрЛицо);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений, ЭтоЮрЛицо)
	
	ВидыКИ = Перечисление_ВидыКонтактнойИнформации();
	
	Результат = УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидыКИ.ФактическийАдрес, ДатаСведений, ЭтоЮрЛицо);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидАдреса, ДатаСведений, ЭтоЮрЛицо)
	
	Результат = Неопределено;
	
	ВидКИ = ВидАдресаЮрФизЛица(Ссылка, ВидАдреса, ЭтоЮрЛицо);
	ТолькоПредставлениеКИ = Ложь;
	
	МодульУправлениеКонтактнойИнформацией = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
	
	КонтактнаяИнформация = МодульУправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Ссылка,
		ВидКИ,
		ДатаСведений,
		ТолькоПредставлениеКИ
	);
	
	Если ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
		
		АдресСтрокойJSON = КонтактнаяИнформация[0].Значение;
		
		Результат = СведенияОбАдресеЛок(АдресСтрокойJSON);
		
		СохраненноеПредставление = ПредставлениеАдреса(АдресСтрокойJSON);
		Результат.Вставить("СохраненноеПредставление", СохраненноеПредставление);
		
		ЭтоАдминистративноТерриториальныйАдрес = УПД970_АдресСоответствуетСтруктуреAddressRF(Результат);
		
		ЭтоМуниципальныйАдрес = Ложь;
		Если Не ЭтоАдминистративноТерриториальныйАдрес Тогда
			ЭтоМуниципальныйАдрес = УПД970_АдресСоответствуетСтруктуреAddressSAR(Результат);
		КонецЕсли;
		
		Если Не ЭтоМуниципальныйАдрес
			И Не ЭтоАдминистративноТерриториальныйАдрес Тогда
			
			Результат.Представление = Результат.СохраненноеПредставление;
			Результат.ТипАдреса = ТипАдресаВСвободнойФорме();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСоответствуетСтруктуреAddressRF(СведенияОбАдресе)
	
	Результат = Ложь;
	
	Если Не ЭтоАдминистративноТерриториальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьКодРегиона = ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона);
	
	ПомещенияНеЗаполнены = (СведенияОбАдресе.Помещения.Количество() = 0);
	ТипПомещенияСоответствуетАдрРФ = (СведенияОбАдресе.Помещения.Количество() = 1
		И ВРЕГ(СведенияОбАдресе.Помещения[0].ТипПомещения) = ВРЕГ(ТипПомещенияАдрРФ()));
		
	ПомещенияСоответствуютАдрРФ = (ПомещенияНеЗаполнены Или ТипПомещенияСоответствуетАдрРФ);
	
	КорпусаНеЗаполнены = (СведенияОбАдресе.Корпуса.Количество() = 0);
	ТипКорпусаСоответствуетАдрРФ = (СведенияОбАдресе.Корпуса.Количество() = 1
		И ВРЕГ(СведенияОбАдресе.Корпуса[0].ТипКорпуса) = ВРЕГ(ТипКорпусаАдрРФ()));
		
	КорпусаСоответствуютАдрРФ = (КорпусаНеЗаполнены Или ТипКорпусаСоответствуетАдрРФ);
		
	ТипЗданияСоответствуетАдрРФ = Не ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания)
		Или ВРЕГ(СведенияОбАдресе.Здание.ТипЗдания) = ВРЕГ(ТипЗданияАдрРФ());
		
	ЕстьНесоответствующиеСтруктуреАдрРФПоля = ЕстьНесоответствующиеСтруктуреАдрРФПоля(СведенияОбАдресе);
		
	ПредставлениеАдреса = СведенияОбАдресе.Представление;
	ПредставленияАдресаСовпадают = (ПредставлениеАдреса = СведенияОбАдресе.СохраненноеПредставление);
	
	Результат = ЕстьКодРегиона
		И ПомещенияСоответствуютАдрРФ
		И КорпусаСоответствуютАдрРФ
		И ТипЗданияСоответствуетАдрРФ
		И ПредставленияАдресаСовпадают
		И Не ЕстьНесоответствующиеСтруктуреАдрРФПоля;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСоответствуетСтруктуреAddressSAR(СведенияОбАдресе)
	
	Результат = Ложь;
	
	Если Не ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьКодРегиона = ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона);
	ЕстьНаименованиеМуниципальногоРайона = ЗначениеЗаполнено(СведенияОбАдресе.МуниципальныйРайон);
	
	ЕстьКодМуниципальногоРайона = ЗначениеЗаполнено(СведенияОбАдресе.КодМуниципальногоРайона);
	Если Не ЕстьКодМуниципальногоРайона Тогда
		КодМуниципальногоРайона = УПД970_КодМуниципальногоРайона(СведенияОбАдресе.МуниципальныйРайонСокращение);
		ЕстьКодМуниципальногоРайона = ЗначениеЗаполнено(КодМуниципальногоРайона);
	КонецЕсли;
	
	ЕстьИдентификаторАдресногоОбъекта = ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторАдресногоОбъекта);
	
	ЕстьНесколькоТиповПомещений = УПД970_АдресСодержитНесколькоТиповПомещений(СведенияОбАдресе);
	ЕстьНесколькоТиповАпартаментов = УПД970_АдресСодержитНесколькоТиповАпартаментов(СведенияОбАдресе);
	
	МуниципальноеПредставление = СвойствоСтруктурыЛок(СведенияОбАдресе, "МуниципальноеПредставление");
	ПредставленияАдресаСовпадают = (МуниципальноеПредставление = СведенияОбАдресе.СохраненноеПредставление);
	
	Результат = ЕстьКодРегиона
		И ЕстьНаименованиеМуниципальногоРайона
		И ЕстьКодМуниципальногоРайона
		И ЕстьИдентификаторАдресногоОбъекта
		И ПредставленияАдресаСовпадают
		И Не ЕстьНесколькоТиповПомещений
		И Не ЕстьНесколькоТиповАпартаментов;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСодержитНесколькоТиповПомещений(СведенияОбАдресе)
	
	Результат = Ложь;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	
	КоличествоТиповПомещений = 0;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		Если ТипыПомещенийЗдания.Найти(Элемент.ТипПомещения) <> Неопределено Тогда
			КоличествоТиповПомещений = КоличествоТиповПомещений + 1;
		КонецЕсли;
		
		Если КоличествоТиповПомещений > 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСодержитНесколькоТиповАпартаментов(СведенияОбАдресе)
	
	Результат = Ложь;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();
	
	КоличествоТиповПомещений = 0;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		ТипПомещения = Элемент.ТипПомещения;
		
		ЭтоПомещениеЗдания = (ТипыПомещенийЗдания.Найти(ТипПомещения) <> Неопределено);
		ЭтоПомещениеКвартиры = (ТипыПомещенийКвартиры.Найти(ТипПомещения) <> Неопределено);
		
		ЭтоНеклассифицированноеПомещениеКвартиры = (Не ЭтоПомещениеЗдания И Не ЭтоПомещениеКвартиры);
		
		Если ЭтоПомещениеКвартиры Или ЭтоНеклассифицированноеПомещениеКвартиры Тогда
			КоличествоТиповПомещений = КоличествоТиповПомещений + 1;
		КонецЕсли;
		
		Если КоличествоТиповПомещений > 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

