Функция УПД970_ТекстЗапросаСчетФактура_СоставНФА()
	
	Результат =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ДанныеШапки.ВидЦенности = ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	|			ТОГДА ""Услуга""
	|		КОГДА ТИПЗНАЧЕНИЯ(ТабСоставНФА.НФА) = ТИП(СТРОКА)
	|			ТОГДА ""Имущество""
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ""Имущество""
	|		КОГДА ТабСоставНФА.НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			ТОГДА ""Работа""
	|		КОГДА ТабСоставНФА.НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|				ИЛИ ТабСоставНФА.НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.УслугиАренды)
	|				ИЛИ ТабСоставНФА.НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Госуслуга)
	|				ИЛИ ТабСоставНФА.НФА.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ГруппаУслуг)
	|			ТОГДА ""Услуга""
	|		ИНАЧЕ ""Товар""
	|	КОНЕЦ КАК ТипНоменклатуры,
	|	1 КАК Порядок,
	|	ТабСоставНФА.НФА КАК Товар,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ТабСоставНФА.СодержаниеУслуги КАК СТРОКА(1000))) <> """"
	|			ТОГДА ВЫРАЗИТЬ(ТабСоставНФА.СодержаниеУслуги КАК СТРОКА(1000))
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.Номенклатура
	|				И (ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000))) <> """"
	|			ТОГДА СпрНоменклатура.НаименованиеПолное
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.Номенклатура
	|				И (ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000))) <> """"
	|			ТОГДА СпрНоменклатура.Наименование
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.ОсновныеСредства
	|				И (ВЫРАЗИТЬ(ОсновныеСредства.НаименованиеПолное КАК СТРОКА(1000))) <> """"
	|			ТОГДА ОсновныеСредства.НаименованиеПолное
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.ОсновныеСредства
	|				И (ВЫРАЗИТЬ(ОсновныеСредства.Наименование КАК СТРОКА(1000))) <> """"
	|			ТОГДА ОсновныеСредства.Наименование
	|		ИНАЧЕ ТабСоставНФА.НФА
	|	КОНЕЦ КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ОсновныеСредства.Код
	|		КОГДА ТИПЗНАЧЕНИЯ(ТабСоставНФА.НФА) = ТИП(СТРОКА)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	СтраныМира.Ссылка КАК СтранаПроисхождения,
	|	ЕСТЬNULL(СтраныМира.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(СтраныМира.УчастникЕАЭС, ИСТИНА) КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ТабСоставНФА.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕИ.НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторЕИ.Код, """") КАК ЕдиницаИзмеренияКод,
	|	"""" КАК НомерГТД,
	|	ТабСоставНФА.Количество КАК Количество,
	|	ТабСоставНФА.Цена КАК Цена,
	|	ТабСоставНФА.СтавкаНДС КАК СтавкаНДС,
	|	ТабСоставНФА.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.ВидЦенности = ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Аванс)
	|			ТОГДА 0
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТабСоставНФА.Сумма - ТабСоставНФА.СуммаНДС
	|		ИНАЧЕ ТабСоставНФА.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТабСоставНФА.Сумма + ТабСоставНФА.СуммаНДС
	|		ИНАЧЕ ТабСоставНФА.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	ТабСоставНФА.НомерСтроки КАК НомерСтроки,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ТабСоставНФА.НФА) = ТИП(СТРОКА)
	|			ТОГДА """"
	|		КОГДА ТабСоставНФА.НФА ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ОсновныеСредства.КодТНВЭД
	|		ИНАЧЕ СпрНоменклатура.КодТНВЭД
	|	КОНЕЦ КАК НоменклатураТНВЭД,
	|	ТабСоставНФА.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТабСоставНФА.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА КАК ТабСоставНФА
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК ДанныеШапки
	|		ПО ТабСоставНФА.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТабСоставНФА.НФА = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО ТабСоставНФА.НФА = ОсновныеСредства.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕИ
	|		ПО ТабСоставНФА.ЕдиницаИзмерения = КлассификаторЕИ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО (СпрНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка
	|				ИЛИ ОсновныеСредства.СтранаПроисхождения = СтраныМира.Ссылка)
	|ГДЕ
	|	ТабСоставНФА.Ссылка = &Ссылка";
	
	Возврат Результат;
	
