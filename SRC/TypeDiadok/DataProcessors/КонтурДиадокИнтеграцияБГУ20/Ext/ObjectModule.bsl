	|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
	|	"""" КАК СтранаПроисхожденияКод,
	|	ИСТИНА КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ВЫБОР
	|		КОГДА ТчУслуги.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчУслуги.ЕдиницаИзмерения
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТчУслуги.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчУслуги.ЕдиницаИзмерения.НаименованиеПолное
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.НаименованиеПолное
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА ТчУслуги.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчУслуги.ЕдиницаИзмерения.Код
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	"""" КАК НомерГТД,
	|	ТчУслуги.Количество КАК Количество,
	|	ТчУслуги.Цена КАК Цена,
	|	ТчУслуги.СтавкаНДС КАК СтавкаНДС,
	|	ТчУслуги.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчУслуги.Сумма - ТчУслуги.СуммаНДС
	|		ИНАЧЕ ТчУслуги.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчУслуги.Сумма + ТчУслуги.СуммаНДС
	|		ИНАЧЕ ТчУслуги.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	ТчУслуги.НомерСтроки КАК НомерСтроки,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	"""" КАК ИдентификаторСтроки,
	|	ТчУслуги.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК ТчУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОбОказанииУслуг КАК ДанныеШапки
	|		ПО ТчУслуги.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчУслуги.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	ТчУслуги.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиДокументаНакладнаяНаРеализациюТорг12()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеШапки.Ссылка КАК Ссылка,
	|	ДанныеШапки.Номер КАК Номер,
	|	ДанныеШапки.Дата КАК Дата,
	|	ДанныеШапки.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеШапки.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	ДанныеШапки.ВалютаДокумента.НаименованиеПолное КАК ВалютаДокументаНаименование,
	|	ДанныеШапки.Организация КАК Организация,
	|	ДанныеШапки.Организация.КПП КАК ОрганизацияКПП,
	|	ДанныеШапки.Организация.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	НЕОПРЕДЕЛЕНО КАК Подразделение,
	|	ЛОЖЬ КАК ОбособленноеПодразделение,
	|	"""" КАК ПодразделениеКПП,
	|	"""" КАК ПодразделениеНаименование,
	|	ДанныеШапки.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(СпрКонтрагенты.ГоловнаяОрганизация, НЕОПРЕДЕЛЕНО) КАК ГоловнойКонтрагент,
	|	ЕСТЬNULL(СпрКонтрагенты.КПП, """") КАК КонтрагентКПП,
	|	ЕСТЬNULL(СпрПодразделения.ЦифровойИндекс, """") КАК ЦифровойИндексОП,
