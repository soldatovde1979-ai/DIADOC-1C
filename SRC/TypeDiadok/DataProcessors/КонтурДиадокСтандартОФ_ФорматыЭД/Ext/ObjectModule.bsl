// Проверяет, что электронный документ является передаточным документом и счетом-фактурой.
//
// Параметры:
//  ФорматЭД - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если это УПД с функцией СЧФДОП.
//
Функция ЭтоУниверсальныйПередаточныйДокумент(ФорматЭД) Экспорт
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	ФункцияДокумента = ФорматЭД.ФункцияДокумента;
	
	ЭтоУПД = (ТипДокумента = Тип_УПД() ИЛИ ТипДокумента = Тип_ИсправлениеУПД());
	
	Результат = (ЭтоУПД И ФункцияДокумента = Функция_СЧФДОП());
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что электронный документ является счетом-фактурой.
//
// Параметры:
//  ФорматЭД - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если это СФ или УПД с функцией СЧФ.
//
Функция ЭтоСчетФактура(ФорматЭД) Экспорт
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	ФункцияДокумента = ФорматЭД.ФункцияДокумента;
	
	ЭтоУПД = (ТипДокумента = Тип_УПД() ИЛИ ТипДокумента = Тип_ИсправлениеУПД());
	ЭтоСФ = (ТипДокумента = Тип_СФ() ИЛИ ТипДокумента = Тип_ИсправлениеСФ());
	
	Результат = Ложь;
	
	Если ЭтоУПД И ФункцияДокумента = Функция_СЧФ()
		ИЛИ ЭтоСФ Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что электронный документ является передаточным документом.
//
// Параметры:
//  ФорматЭД - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если это накладная, акт или УПД с функцией ДОП.
//
Функция ЭтоПередаточныйДокумент(ФорматЭД) Экспорт
	
	Результат = Ложь;
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	ФункцияДокумента = ФорматЭД.ФункцияДокумента;
	
	ЭтоУПД = (ТипДокумента = Тип_УПД() ИЛИ ТипДокумента = Тип_ИсправлениеУПД());
	
	Если ЭтоУПД И ФункцияДокумента = Функция_ДОП()
		ИЛИ ТипДокумента = Тип_Накладная()
		ИЛИ ТипДокумента = Тип_АктОбОказанииУслуг() Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что электронный документ является соглашением об изменении стоимости и корректировочным счетом-фактурой.
//
// Параметры:
//  ФорматЭД - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если это УКД с функцией КСЧФДИС.
//
Функция ЭтоУниверсальныйКорректировочныйДокумент(ФорматЭД) Экспорт
	
