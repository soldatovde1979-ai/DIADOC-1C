	Если ЭтоУКД И ФункцияДокумента = Функция_КСЧФДИС() Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что электронный документ является корректировочным счетом-фактурой.
//
// Параметры:
//  ФорматЭД - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если это УКД с функцией КСЧФДИС или ДИС.
//
Функция ЭтоКорректировочныйСчетФактура(ФорматЭД) Экспорт
	
	Результат = Ложь;
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	ФункцияДокумента = ФорматЭД.ФункцияДокумента;
	
	ЭтоУКД = (ТипДокумента = Тип_УКД() ИЛИ ТипДокумента = Тип_ИсправлениеУКД());
	ЭтоКСФ = (ТипДокумента = Тип_КСФ() ИЛИ ТипДокумента = Тип_ИсправлениеКСФ());
	
	Если ЭтоУКД И ФункцияДокумента = Функция_КСЧФ()
		ИЛИ ЭтоКСФ Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что электронный документ является соглашением об изменении стоимости.
