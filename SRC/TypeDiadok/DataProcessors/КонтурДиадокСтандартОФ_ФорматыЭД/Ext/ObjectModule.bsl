// Проверяет, что электронный документ является актом сверки взаиморасчетов в формате 405@.
//
// Параметры:
//  ФорматЭД - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
// Возвращаемое значение:
//  Булево - Истина, если это Акт сверки взаиморасчетов в формате 405@.
//
Функция ЭтоАктСверкиВзаиморасчетов(ФорматЭД) Экспорт
	
	Результат = Ложь;
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	
	Если ТипДокумента = Тип_АктСверкиВзаиморасчетов() Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

