	Возврат Результат;
	
КонецФункции // ЛокальнаяДатаXML

&НаКлиенте
Функция СледующийЭлементJSON(ПараметрыЧтения)
	
	// Увеличивает номер текущей позиции в параметрах чтения json
	// и записывает значение элемента расположенного в этой позиции в поле Элемент
	Если ПараметрыЧтения.Позиция < ПараметрыЧтения.РазмерМассива Тогда
		ПараметрыЧтения.Позиция = ПараметрыЧтения.Позиция + 1;
		ПараметрыЧтения.Элемент = ПараметрыЧтения.МассивЭлементов[ПараметрыЧтения.Позиция];
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СледующийЭлементJSON

&НаКлиенте
Функция РазделитьСтрокуJSON(Строка)
	
	ВключатьПустые = Истина;
	Разделитель = Символы.ПС;
	Результат = СтдКлиентЛок.Стр().СтрРазделитьЛок(Строка, Разделитель, ВключатьПустые);
	
	Возврат Результат;
	
КонецФункции // РазделитьСтрокуJSON

&НаКлиенте
Функция РазбитьСтрокуПоСлужебнымСимволамJSON(Знач Строка)
	
	СлужебныеСимволы = "{}[]:,";
	Для Сч = 1 По СтрДлина(СлужебныеСимволы) Цикл
		ТекСимвол = Сред(СлужебныеСимволы, Сч, 1);
		Строка = СтрЗаменить(Строка, ТекСимвол, Символы.ПС + ТекСимвол + Символы.ПС);
	КонецЦикла;
	
	Возврат Строка;
	
КонецФункции // РазбитьСтрокуПоСлужебнымСимволамJSON

&НаКлиенте
Функция ЭкранироватьСимволыJSON(Знач Строка)
	
	Строка = СтрЗаменить(Строка, "\", "\\");
	Строка = СтрЗаменить(Строка, """", "\""");
	
	Возврат Строка;
	
КонецФункции // ЭкранироватьСимволыJSON

&НаКлиенте
Функция ЗаменитьЭкранированныеСимволыJSON(Знач Строка)
	
	Строка = СтрЗаменить(Строка, "\\", "<&sl>");
	Строка = СтрЗаменить(Строка, "\""", "<&qt>");
	
	Возврат Строка;
	
КонецФункции // ЗаменитьЭкранированныеСимволыJSON

&НаКлиенте
Функция ВосстановитьЭкранированныеСимволыJSON(Знач Строка)
	
	Строка = СтрЗаменить(Строка, "\/", "/");
	Строка = СтрЗаменить(Строка, "<&sl>", "\");
	Строка = СтрЗаменить(Строка, "<&qt>", Кавычки());
	
	Возврат Строка;
	
КонецФункции // ВосстановитьЭкранированныеСимволыJSON

&НаКлиенте
Функция ЗаменитьНедопустимыеСимволыJSON(Знач Строка)
	
	Backspace = 8;
	РазделителяGS = 29;
	
	СимволBackspace = Символ(Backspace);
	СимволРазделителяGS = Символ(РазделителяGS);
	
	Строка = СтрЗаменить(Строка, Символы.ПФ, "\f");
	Строка = СтрЗаменить(Строка, Символы.ПС, "\n");
	Строка = СтрЗаменить(Строка, Символы.ВК, "\r");
	Строка = СтрЗаменить(Строка, Символы.Таб, "\t");
	Строка = СтрЗаменить(Строка, СимволBackspace, "\b");
	Строка = СтрЗаменить(Строка, СимволРазделителяGS, "\u001D");
	
	Возврат Строка;
	
КонецФункции // ЗаменитьНедопустимыеСимволыJSON

&НаКлиенте
Функция ВосстановитьНедопустимыеСимволыJSON(Знач Строка)
	
	Backspace = 8;
	РазделителяGS = 29;
	
	СимволBackspace = Символ(Backspace);
	СимволРазделителяGS = Символ(РазделителяGS);
	
	Строка = СтрЗаменить(Строка, "\f", Символы.ПФ);
	Строка = СтрЗаменить(Строка, "\n", Символы.ПС);
	Строка = СтрЗаменить(Строка, "\r", Символы.ВК);
	Строка = СтрЗаменить(Строка, "\t", Символы.Таб);
	Строка = СтрЗаменить(Строка, "\b", СимволBackspace);
	Строка = СтрЗаменить(Строка, "\u001d", СимволРазделителяGS);
	Строка = СтрЗаменить(Строка, "\u001D", СимволРазделителяGS);
	
	Возврат Строка;
	
КонецФункции // ВосстановитьНедопустимыеСимволыJSON

&НаКлиенте
Функция ЭтоРазделительJSON(Строка)
	
	Результат = Строка = "," ИЛИ Строка = ":";
	
	Возврат Результат;
	
КонецФункции // ЭтоРазделительJSON

&НаКлиенте
Функция БулевоИзСтрокиJSON(Строка)
	
	Если НРег(Строка) = "true" Тогда
		Результат = Истина;
	ИначеЕсли НРег(Строка) = "false" Тогда
		Результат = Ложь;
	Иначе
		ВызватьИсключение "Не удалось преобразовать json строку в булево: " + Строка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // БулевоИзСтрокиJSON

&НаКлиенте
Функция Кавычки()
	
	Кавычки = 34;
	Возврат Символ(Кавычки);
	
КонецФункции // Кавычки

&НаКлиенте
Функция Апостроф()
	
	Апостроф = 39;
	Возврат Символ(Апостроф);
	
КонецФункции // Апостроф

&НаКлиенте
Функция СтрокаВКавычках(Строка)
	
	Возврат Кавычки() + Строка + Кавычки();
	
КонецФункции // СтрокаВКавычках

&НаКлиенте
Функция СократитьКавычки(Строка)
	
	Возврат СтрЗаменить(Строка, """", "");
	
КонецФункции // СократитьКавычки

&НаКлиенте
Функция СократитьАпострофы(Строка)
	
	Длина = 2;
	Возврат Сред(Строка, Длина, СтрДлина(Строка) - Длина);
	
КонецФункции // СократитьАпострофы

&НаКлиенте
Функция Base64ИзДвоичныхДанных(ДвоичныеДанные)
	
	Результат = Base64Строка(ДвоичныеДанные);
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	
	Возврат Результат;
	
КонецФункции // Base64ИзДвоичныхДанных

&НаКлиенте
Функция ВызватьФункциюВосстановления(ОписаниеФункцииВосстановлении, Свойство, Значение)
	
	МодульФункцииВосстановления = ОписаниеФункцииВосстановлении.МодульФункцииВосстановления;
	ДополнительныеПараметры = ОписаниеФункцииВосстановлении.ДополнительныеПараметрыФункцииВосстановления;
	
	ТекстВычисления = "МодульФункцииВосстановления." + ОписаниеФункцииВосстановлении.ИмяФункцииВосстановления
		+ "(Свойство, Значение, ДополнительныеПараметры)";
	
	Значение = Вычислить(ТекстВычисления);
	
	Возврат Значение;
	
КонецФункции // ВызватьФункциюВосстановления

// ПРОЧЕЕ

&НаКлиенте
Функция ФункцииДоступны()
	
	Если ФункцииДоступныЛок = Неопределено Тогда
		ФункцииДоступныЛок = СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.6");
	КонецЕсли;
	
	Возврат ФункцииДоступныЛок;
	
КонецФункции // ФункцииДоступны