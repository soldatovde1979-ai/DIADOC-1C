////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция ПлатформаПрочитатьJSON(Строка, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата, ОжидаемыйФорматДаты,
		ИмяФункцииВосстановления, МодульФункцииВосстановления,
		ДополнительныеПараметрыФункцииВосстановления, ИменаСвойствДляОбработкиВосстановления)
	
	Чтение = Новый("ЧтениеJSON");
	Чтение.УстановитьСтроку(Строка);
	
	Если НЕ ЗначениеЗаполнено(ОжидаемыйФорматДаты) Тогда
		ОжидаемыйФорматДаты = Вычислить("ФорматДатыJSON.ISO");
	КонецЕсли;
	
	ТекстВычисления = "ПрочитатьJSON(Чтение, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата, ОжидаемыйФорматДаты,
		|ИмяФункцииВосстановления, МодульФункцииВосстановления, ДополнительныеПараметрыФункцииВосстановления,
		|ИменаСвойствДляОбработкиВосстановления)";
	
	Результат = Вычислить(ТекстВычисления);
	
	Возврат Результат;
	
КонецФункции // ПлатформаПрочитатьJSON

&НаКлиенте
Функция ПарсерПрочитатьJSON(Строка, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата, ОжидаемыйФорматДаты,
		ИмяФункцииВосстановления, МодульФункцииВосстановления,
		ДополнительныеПараметрыФункцииВосстановления, ИменаСвойствДляОбработкиВосстановления)
	
	Если ТипЗнч(ИменаСвойствСоЗначениямиДата) = Тип("Строка") Тогда
		МассивИменаСвойствСоЗначениямиДата = СтдКлиентЛок.Стр().СтрРазделитьЛок(ИменаСвойствСоЗначениямиДата, ",", Ложь);
	Иначе
		МассивИменаСвойствСоЗначениямиДата = ИменаСвойствСоЗначениямиДата;
	КонецЕсли;
	
	ОписаниеФункцииВосстановлении = Новый Структура;
	ОписаниеФункцииВосстановлении.Вставить("ИмяФункцииВосстановления", ИмяФункцииВосстановления);
	ОписаниеФункцииВосстановлении.Вставить("МодульФункцииВосстановления", МодульФункцииВосстановления);
	ОписаниеФункцииВосстановлении.Вставить("ДополнительныеПараметрыФункцииВосстановления",
		ДополнительныеПараметрыФункцииВосстановления);
	ОписаниеФункцииВосстановлении.Вставить("ИменаСвойствДляОбработкиВосстановления",
		ИменаСвойствДляОбработкиВосстановления);
	
	ПараметрыЧтения = ПараметрыЧтенияJSON(Строка, ПрочитатьВСоответствие);
	Результат = ПрочитатьСтрокуJSON(ПараметрыЧтения, МассивИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
	
	Возврат Результат;
	
КонецФункции // ПарсерПрочитатьJSON

&НаКлиенте
Функция ПлатформаЗаписатьJSON(Значение)
	
	Запись = Новый("ЗаписьJSON");
	Запись.УстановитьСтроку();
	Выполнить("ЗаписатьJSON(Запись, Значение)");
	Результат = Запись.Закрыть();
	
	Возврат Результат;
	
КонецФункции // ПлатформаЗаписатьJSON

&НаКлиенте
Функция ПарсерЗаписатьJSON(Значение)
	
	Результат = ЗаписатьЗначениеВСтрокуJSON(Значение);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗаписатьОбъектВСтрокуJSON(Значение);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЗаписатьМассивВСтрокуJSON(Значение);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЭкранироватьСимволыJSON(Значение);
	Результат = ЗаменитьНедопустимыеСимволыJSON(Результат);
	Результат = СтрокаВКавычках(Результат);
	
	Возврат Результат;
	
КонецФункции // ПарсерЗаписатьJSON

&НаКлиенте
Функция ПарсерПрочитатьДатуJSON(Строка)
	
	Попытка
		ГодДлина = 4;
		Год = Лев(Строка, ГодДлина);
		МесяцНачало = 6;
		МесяцДлина = 2;
		Месяц = Сред(Строка, МесяцНачало, МесяцДлина);
		ДеньНачало = 9;
		ДеньДлина = 2;
		День = Сред(Строка, ДеньНачало, ДеньДлина);
		ЧасНачало = 12;
		ЧасДлина = 2;
		Час = Сред(Строка, ЧасНачало, ЧасДлина);
		МинутаНачало = 15;
		МинутаДлина = 2;
		Минута = Сред(Строка, МинутаНачало, МинутаДлина);
		СекундаНачало = 18;
		СекундаДлина = 2;
		Секунда = Сред(Строка, СекундаНачало, СекундаДлина);
		Возврат Дата(Год + Месяц + День + Час + Минута + Секунда);
	Исключение
		ВызватьИсключение "JSON: Некорректный формат даты: " + Строка;
	КонецПопытки;
	
КонецФункции // ПарсерПрочитатьДатуJSON

// ПАРСЕР 8.2 - ЧТЕНИЕ

// Формирует параметры для чтения json через парсер для 8.2
//
// Параметры:
//  Строка - Строка - строка json, которую надо прочитать;
//  ПрочитатьВСоответствие - Булево - Истина, если нужно прочитать объекты json в соответствие;
//
// Возвращаемое значение:
//  Структура - содержит поля:
//   * Элемент - Строка - значение текущего элемента json;
//   * Позиция - Число - индекс текущего элемента в массиве;
//   * МассивЭлементов - Массив - массив элементов строки json;
//   * ВсегоЭлементов - Число - количество элементов в массиве;
//   * ПрочитатьВСоответствие - Булево - см. входящий параметр;
//
&НаКлиенте
Функция ПараметрыЧтенияJSON(Строка, ПрочитатьВСоответствие)
	
	СтрокаЭлементов = ЗаменитьЭкранированныеСимволыJSON(Строка);
	СтрокаЭлементов = РазбитьСтрокуПоСлужебнымСимволамJSON(СтрокаЭлементов);
	МассивЭлементов = РазделитьСтрокуJSON(СтрокаЭлементов);
	
	ВосстановитьТекстыJSON(МассивЭлементов);
	
	Результат = Новый Структура;
	Результат.Вставить("Элемент", "");
	Результат.Вставить("Позиция", -1);
	Результат.Вставить("МассивЭлементов", МассивЭлементов);
	Результат.Вставить("РазмерМассива", МассивЭлементов.ВГраница());
	Результат.Вставить("ПрочитатьВСоответствие", ПрочитатьВСоответствие);
	
	Возврат Результат;
	
КонецФункции // ПараметрыЧтенияJSON

&НаКлиенте
Функция ПрочитатьСтрокуJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении)
	
	Результат = "";
	НачалоОбъекта = "{";
	НачалоМассива = "[";
	
	Пока СледующийЭлементJSON(ПараметрыЧтения) Цикл
		
		Если ПустаяСтрока(ПараметрыЧтения.Элемент)
			ИЛИ ЭтоРазделительJSON(ПараметрыЧтения.Элемент) Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыЧтения.Элемент = НачалоОбъекта Тогда
			Результат = ПрочитатьОбъектИзСтрокиJSON(
					ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
		ИначеЕсли ПараметрыЧтения.Элемент = НачалоМассива Тогда
			Результат = ПрочитатьМассивИзСтрокиJSON(
					ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
		Иначе
			Результат = ПрочитатьЗначениеИзСтрокиJSON(
					ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;
	
	ДекодироватьUnicodeСимволы(Результат);
	
	Возврат Результат;
	
КонецФункции // ПрочитатьСтрокуJSON

&НаКлиенте
Функция ПрочитатьОбъектИзСтрокиJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении)
	
	Если ПараметрыЧтения.ПрочитатьВСоответствие Тогда
		Результат = Новый Соответствие;
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	КонецОбъекта = "}";
	
	Пока СледующийЭлементJSON(ПараметрыЧтения) Цикл
		
		Если ПустаяСтрока(ПараметрыЧтения.Элемент)
			ИЛИ ЭтоРазделительJSON(ПараметрыЧтения.Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыЧтения.Элемент = КонецОбъекта Тогда
			Прервать;
		КонецЕсли;
		
		Ключ = ПрочитатьЗначениеИзСтрокиJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
		Значение = ПрочитатьСтрокуJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
		
		// Преобразуем дату по имени свойства
		Если ИменаСвойствСоЗначениямиДата <> Неопределено И ИменаСвойствСоЗначениямиДата.Найти(Ключ) <> Неопределено Тогда
			Значение = ПарсерПрочитатьДатуJSON(Значение);
		КонецЕсли;
		
		// Преобразуем дату вызывая метод восстановления
		Если ОписаниеФункцииВосстановлении.ИмяФункцииВосстановления <> Неопределено
			И (ОписаниеФункцииВосстановлении.ИменаСвойствДляОбработкиВосстановления = Неопределено
				ИЛИ ОписаниеФункцииВосстановлении.ИменаСвойствДляОбработкиВосстановления.Найти(Ключ) <> Неопределено) Тогда
			
			Значение = ВызватьФункциюВосстановления(ОписаниеФункцииВосстановлении, Ключ, Значение);
			
		КонецЕсли;
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПрочитатьОбъектИзСтрокиJSON

&НаКлиенте
Функция ПрочитатьМассивИзСтрокиJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении)
	
	Результат = Новый Массив;
	КонецМассива = "]";
	
	Пока СледующийЭлементJSON(ПараметрыЧтения) Цикл
		
		Если ПустаяСтрока(ПараметрыЧтения.Элемент)
			ИЛИ ЭтоРазделительJSON(ПараметрыЧтения.Элемент) Тогда
			
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыЧтения.Элемент = КонецМассива Тогда
			Прервать;
		Иначе
			ПараметрыЧтения.Позиция = ПараметрыЧтения.Позиция - 1;
			Значение = ПрочитатьСтрокуJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении);
			Результат.Добавить(Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПрочитатьМассивИзСтрокиJSON

&НаКлиенте
Функция ПрочитатьЗначениеИзСтрокиJSON(ПараметрыЧтения, ИменаСвойствСоЗначениямиДата, ОписаниеФункцииВосстановлении)
	
	Элемент = СокрЛП(ПараметрыЧтения.Элемент);
	
	Кавычки = Кавычки();
	ЕстьКавычкиСлева = (Лев(Элемент, 1) = Кавычки);
	ЕстьКавычкиСправа = (Прав(Элемент, 1) = Кавычки) И СтрДлина(Элемент) > 1;
	ЭтоТекст = ЕстьКавычкиСлева И ЕстьКавычкиСправа;
	
	Если ЭтоТекст Тогда
		
		Результат = СокрЛП(СократитьКавычки(Элемент));
		Результат = ВосстановитьНедопустимыеСимволыJSON(Результат);
		Результат = ВосстановитьЭкранированныеСимволыJSON(Результат);
		
		ДекодироватьUnicodeСимволы(Результат);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Апостроф = Апостроф();
	ЕстьАпострофСлева = (Лев(Элемент, 1) = Апостроф);
	ЕстьАпострофСправа = (Прав(Элемент, 1) = Апостроф) И СтрДлина(Элемент) > 1;
	ЭтоТекст = ЕстьАпострофСлева И ЕстьАпострофСправа;
	
	Если ЭтоТекст Тогда
		
		Результат = СокрЛП(СократитьАпострофы(Элемент));
		Результат = ВосстановитьНедопустимыеСимволыJSON(Результат);
		Результат = ВосстановитьЭкранированныеСимволыJSON(Результат);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Если Элемент = "null" Тогда
		
		Результат = Неопределено;
		Возврат Результат;
		
	КонецЕсли;
	
	Попытка
		Результат = БулевоИзСтрокиJSON(Элемент);
	Исключение
		Попытка
			Экспонента = Найти(Элемент, "e");
			Если Экспонента = 0 Тогда
				ТипЧисло = Новый ОписаниеТипов("Число");
				Результат = ТипЧисло.ПривестиЗначение(Элемент);
			Иначе
				// BSLLS:TryNumber-off
				// Попытка-Исключение не относится к приведению к числу, а
				// является частью сериализатора, отделяя экспоненциальные
				// числа от обычных строк
				Мантисса = Число(Лев(Элемент, Экспонента - 1));
				Степень = Число(Прав(Элемент, СтрДлина(Элемент) - Экспонента));
				// BSLLS:TryNumber-on
				Основание = 10;
				Результат = Мантисса * Pow(Основание, Степень);
			КонецЕсли;
		Исключение
			Результат = ВосстановитьНедопустимыеСимволыJSON(Результат);
			Результат = ВосстановитьЭкранированныеСимволыJSON(Элемент);
		КонецПопытки;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ПрочитатьЗначениеИзСтрокиJSON

// ПАРСЕР 8.2 - ЗАПИСЬ

&НаКлиенте
Функция ЗаписатьОбъектВСтрокуJSON(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	ЭтоСтруктура = ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура");
	ЭтоСоответствие = ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("ФиксированноеСоответствие");
	
	Если НЕ ЭтоСтруктура
		И НЕ ЭтоСоответствие Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = "{";
	Разделитель = "";
	Для Каждого Элемент Из Значение Цикл
		ВложенноеЗначение = ПарсерЗаписатьJSON(Элемент.Значение);
		Результат = Результат + Разделитель + СтрокаВКавычках(Элемент.Ключ) + ":" + ВложенноеЗначение;
		Разделитель = ",";
	КонецЦикла;
	Результат = Результат + "}";
	
	Возврат Результат;
	
КонецФункции // ЗаписатьОбъектВСтрокуJSON

&НаКлиенте
Функция ЗаписатьМассивВСтрокуJSON(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если НЕ (ТипЗначения = Тип("Массив")
			ИЛИ ТипЗначения = Тип("ФиксированныйМассив")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = "[";
	Разделитель = "";
	Для Каждого Элемент Из Значение Цикл
		ВложенноеЗначение = ПарсерЗаписатьJSON(Элемент);
		Результат = Результат + Разделитель + ВложенноеЗначение;
		Разделитель = ",";
	КонецЦикла;
	Результат = Результат + "]";
	
	Возврат Результат;
	
КонецФункции // ЗаписатьМассивВСтрокуJSON

&НаКлиенте
Функция ЗаписатьЗначениеВСтрокуJSON(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Булево") Тогда
		
		Результат = БулевоXML(Значение);
		
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		
		Результат = ЧислоXML(Значение);
		
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		
		Результат = СтрокаВКавычках(ЛокальнаяДатаXML(Значение));
		
	ИначеЕсли ТипЗначения = Тип("ДвоичныеДанные") Тогда
		
		Результат = СтрокаВКавычках(Base64ИзДвоичныхДанных(Значение));
		
	ИначеЕсли Значение = Неопределено Тогда
		
		Результат = "null";
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ЗаписатьЗначениеВСтрокуJSON

// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ JSON

&НаКлиенте
Процедура ВосстановитьТекстыJSON(МассивЭлементов)
	
	ВосстановитьТекстыJSONВКавычках(МассивЭлементов);
	ВосстановитьТекстыJSONВАпострофах(МассивЭлементов);
	
КонецПроцедуры // ВосстановитьТекстыJSON

&НаКлиенте
Процедура ВосстановитьТекстыJSONВКавычках(МассивЭлементов)
	
	Кавычки = Кавычки();
	
	Для Сч = -МассивЭлементов.ВГраница() По 0 Цикл
		
		Индекс = -Сч;
		Элемент = СокрЛП(МассивЭлементов[Индекс]);
		
		ЕстьКавычкиСлева = (Лев(Элемент, 1) = Кавычки) И СтрДлина(Элемент) > 1;
		ЕстьКавычкиСправа = (Прав(Элемент, 1) = Кавычки);
		
		Если ЕстьКавычкиСлева И ЕстьКавычкиСправа Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЕстьКавычкиСлева И НЕ ЕстьКавычкиСправа Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЕстьКавычкиСлева И ЕстьКавычкиСправа Тогда
			ПредИндекс = Индекс - 1;
			МассивЭлементов[ПредИндекс] = МассивЭлементов[ПредИндекс] + МассивЭлементов[Индекс];
			МассивЭлементов.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ВосстановитьТекстыJSONВКавычках

&НаКлиенте
Процедура ВосстановитьТекстыJSONВАпострофах(МассивЭлементов)
	
	Апостроф = Апостроф();
	
	Для Сч = -МассивЭлементов.ВГраница() По 0 Цикл
		
		Индекс = -Сч;
		Элемент = СокрЛП(МассивЭлементов[Индекс]);
		
		ЕстьАпострофСлева = (Лев(Элемент, 1) = Апостроф) И СтрДлина(Элемент) > 1;
		ЕстьАпострофСправа = (Прав(Элемент, 1) = Апостроф);
		
		Если ЕстьАпострофСлева И ЕстьАпострофСправа Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЕстьАпострофСлева И НЕ ЕстьАпострофСправа Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЕстьАпострофСлева И ЕстьАпострофСправа Тогда
			ПредИндекс = Индекс - 1;
			МассивЭлементов[ПредИндекс] = МассивЭлементов[ПредИндекс] + МассивЭлементов[Индекс];
			МассивЭлементов.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ВосстановитьТекстыJSONВАпострофах

&НаКлиенте
Процедура ДекодироватьUnicodeСимволы(Результат)
	
	Позиция = Найти(Результат, "\u");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Схема подстановок шестнадцатеричной системы.
	СхемаПодстановок = Новый Соответствие;
	ШестнадцатеричнаяСистема = "0123456789abcdef";
	ДесятичноеЧисло = 0;
	Для ВторойРазряд = 1 По 16 Цикл
		Для ПервыйРазряд = 1 По 16 Цикл
			ШестнадцатеричноеЧисло = Сред(ШестнадцатеричнаяСистема, ВторойРазряд, 1)
				+ Сред(ШестнадцатеричнаяСистема, ПервыйРазряд, 1);
			СхемаПодстановок.Вставить(ШестнадцатеричноеЧисло, ДесятичноеЧисло);
			ДесятичноеЧисло = ДесятичноеЧисло + 1;
		КонецЦикла;
	КонецЦикла;
	
	БуфферПозицийОбратныхСлешей = Новый Массив;
	Пока Позиция Цикл
		ДлинаСтаршийБайт = 2;
		ДлинаМладшийБайт = 4;
		СтаршийБайт = СхемаПодстановок[НРег(Сред(Результат, Позиция + ДлинаСтаршийБайт, ДлинаСтаршийБайт))];
		МладшийБайт = СхемаПодстановок[НРег(Сред(Результат, Позиция + ДлинаМладшийБайт, ДлинаСтаршийБайт))];
		Если (СтаршийБайт = Неопределено) ИЛИ (МладшийБайт = Неопределено) Тогда
			// Если не удалось найти, значит это не Unicode. Удалим символ, после декодировки вернем.
			БуфферПозицийОбратныхСлешей.Добавить(Позиция);
			Результат = Лев(Результат, Позиция - 1) + Прав(Результат, СтрДлина(Результат) - Позиция);
		Иначе
			Начало = 6;
			Длина = 256;
			Результат = СтрЗаменить(Результат, Сред(Результат, Позиция, Начало), Символ(Длина * СтаршийБайт + МладшийБайт));
		КонецЕсли;
		Позиция = Найти(Результат, "\u");
	КонецЦикла;
	
	// Вернем удаленные символы обратно
	ИндексПоследнего = БуфферПозицийОбратныхСлешей.ВГраница();
	Для Индекс = -ИндексПоследнего По 0 Цикл
		ИндексПозиции = -Индекс;
		Позиция = БуфферПозицийОбратныхСлешей[ИндексПозиции];
		Результат = Лев(Результат, Позиция - 1) + "\" + Прав(Результат, СтрДлина(Результат) - Позиция + 1);
	КонецЦикла;
	
КонецПроцедуры // ДекодироватьUnicodeСимволы

&НаКлиенте
Функция БулевоXML(Значение)
	
	Результат = Формат(Значение, "БЛ=false; БИ=true");
	
	Возврат Результат;
	
КонецФункции // БулевоXML

