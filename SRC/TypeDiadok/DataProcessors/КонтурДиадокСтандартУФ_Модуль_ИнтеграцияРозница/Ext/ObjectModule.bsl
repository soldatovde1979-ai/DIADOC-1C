Функция ВалютаПоОбщероссийскомуКлассификатору(ВалютаКод)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Code"		, "");
	Результат.Вставить("CodeSymbol"	, "");
	Результат.Вставить("Name"		, "");
	Результат.Вставить("Description", "");
	
	КлассификаторXML = ПолучитьОбщийМакет("ОбщероссийскийКлассификаторВалют").ПолучитьТекст();
	КлассификаторТаблица = ОбщегоНазначения.ПрочитатьXMLВТаблицу(КлассификаторXML).Данные;
	
	СтрокаТаблицыКлассификатора = КлассификаторТаблица.Найти(ВалютаКод, "Code");
	
	Если СтрокаТаблицыКлассификатора <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, СтрокаТаблицыКлассификатора);
	КонецЕсли;
	
	Возврат СтрокаТаблицыКлассификатора;
	
КонецФункции

