Функция ИдентификаторыПравилОбработкиДокументов()
	
	ЗначенияПеречисления = Новый Массив;
		
	ЗначенияПеречисления.Добавить("ПоступлениеТоваров");
	ЗначенияПеречисления.Добавить("СчетФактураПолученный");
	
	Результат = Новый Структура;
	
	Для Каждого Элемент Из ЗначенияПеречисления Цикл
		
		Результат.Вставить(Элемент, Элемент);
		
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
