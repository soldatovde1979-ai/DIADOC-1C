КонецФункции

Функция СтруктураЗаполненияПоступленияТоваров(ДанныеЭД, ДополнительныеПараметры = Неопределено)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияПоступленияТоваров();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеДляЗаполнения = Новый Структура;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	
	Шапка.Вставить("СуммаДокумента", ИтогиТЧ.СуммаСНДС);
	
	// Номера, даты
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Шапка.Вставить("ХозяйственнаяОперация", ПараметрыЗаполнения.ХозяйственнаяОперация);
	Шапка.Вставить("ЦенаВключаетНДС", ПараметрыЗаполнения.ЦенаВключаетНДС);
	Шапка.Вставить("УчитыватьНДС", ПараметрыЗаполнения.УчитыватьНДС);
	Шапка.Вставить("Магазин", ПараметрыЗаполнения.Магазин);
	Шапка.Вставить("Склад", ПараметрыЗаполнения.Склад);
	
	ФорматЭлектронногоДокумента = ДанныеЭД.ЭлектронныйДокумент.Формат;
	
	// Табличная часть
	Товары = Документы.ПоступлениеТоваров.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл
		
		НоменклатураИБ = Стр.Номенклатура;
		
		НоваяСтрока = Товары.Добавить();
		
		НоваяСтрока.Номенклатура	 = НоменклатураИБ.Номенклатура;
		НоваяСтрока.Характеристика	 = НоменклатураИБ.Характеристика;
		НоваяСтрока.Упаковка		 = НоменклатураИБ.Упаковка;
		
		НоваяСтрока.НомерГТД = НомерГТДПоДаннымЭлектронногоДокумента(Стр.ДанныеГТД);
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
		
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Количество = 1;
			Если НоваяСтрока.Цена = 0 Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыЗаполнения.ЦенаВключаетНДС Тогда
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		Иначе
			НоваяСтрока.Сумма = Стр.СуммаБезНДС;
			НоваяСтрока.Цена = Стр.Цена;
		КонецЕсли;
		
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		Если ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
			ТекКоэффициент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Упаковка, "Коэффициент");
		Иначе
			ТекКоэффициент = 1;
		КонецЕсли;
		НоваяСтрока.Количество = НоваяСтрока.КоличествоУпаковок * ТекКоэффициент;
		
		ДополнитьТаблицуШтрихкодов(
			ШтрихкодыУпаковок,
			Стр.СведенияОМаркировке,
			Стр.НоменклатураКонтрагента.GTIN);
		
	КонецЦикла;
		
	ДанныеДляЗаполнения.Вставить("Шапка"	, Шапка);
	ДанныеДляЗаполнения.Вставить("Товары"	, Товары);
	ДанныеДляЗаполнения.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ЗаполнитьПоступлениеТоваров(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	ДокументОбъект.УстановитьНовыйНомер();
	
	// вручную переопределим, если требуется
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ЗаполнитьБанковскиеСчета(ДокументОбъект);
			
	ДокументОбъект.Товары.Загрузить(ДанныеДляЗагрузки.Товары);
	
	Если ДанныеДляЗагрузки.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДляЗагрузки.ШтрихкодыУпаковок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьБанковскиеСчета(ДокументОбъект)
	
	Организация = ДокументОбъект.Организация;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ДокументОбъект.БанковскийСчетОрганизации = 
			ЗначениеНастроекВызовСервера.БанковскийСчетОрганизацииПоУмолчанию(Организация, , ДокументОбъект.БанковскийСчетОрганизации);
	КонецЕсли;
	
	Контрагент = ДокументОбъект.Контрагент;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДокументОбъект.БанковскийСчетКонтрагента = 
			ЗначениеНастроекВызовСервера.БанковскийСчетКонтрагентаПоУмолчанию(Контрагент, ДокументОбъект.БанковскийСчетКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыЗаполненияСчетаФактуры()
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументОснование", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияСчетаФактуры(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияСчетаФактуры();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	// Основания счета-фактуры
	ДокументыОснования = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументыОснования) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ДокументыОснования = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	
	Шапка = Новый Структура;
	
	// Даты, номера
	Шапка.Вставить("Номер", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаСоставления", ШапкаЭД.Дата);
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
			
	НомерИсправления = СвойствоСтруктуры(ШапкаЭД, "НомерИсправления");
	ДатаИсправления  = СвойствоСтруктуры(ШапкаЭД, "ДатаИсправления");
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		Шапка.Вставить("Исправление", Истина);
		Шапка.Вставить("НомерИсправления", НомерИсправления);
		Шапка.Вставить("ДатаИсправления",  ДатаИсправления);
	КонецЕсли;
	
	// Участники сделки
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
			
	Шапка.Вставить("ТипСчетаФактуры", Перечисления.ТипыПолученныхСчетовФактур.НаПоступление);
	Шапка.Вставить("КодВидаОперации", КодВидаОперацииСчетаФактурыПолученного(ДокументыОснования));
	
	Шапка.Вставить("ПолученВЭлектронномВиде", Истина);
	
	Если ЗначениеЗаполнено(ДанныеЭД.Шапка.Валюта.Код) Тогда
		СтрокаКлассификатора = ВалютаПоОбщероссийскомуКлассификатору(ДанныеЭД.Шапка.Валюта.Код);
		ВалютаСтрокой = СтрокаКлассификатора.CodeSymbol;
	Иначе
		ВалютаСтрокой = ВалютаСчетаФактурыПоУмолчанию();
	КонецЕсли;
		
	Шапка.Вставить("Валюта", ВалютаСтрокой);
					
	ДанныеОбъекта = Новый Структура;
	
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("ДокументыОснования", ДокументыОснования);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьСчетФактуруПолученный(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеШапки = ДанныеДляЗагрузки.Шапка;
	
	ДокументОбъект.Заполнить(ДанныеШапки);
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапки);
	
	Если ЗначениеЗаполнено(ДанныеДляЗагрузки.ДокументыОснования) Тогда
		
		ДокументОбъект.ДокументыОснования.Очистить();
		
		Для каждого ДокументОснование Из ДанныеДляЗагрузки.ДокументыОснования Цикл
			
			НоваяСтрокаТЧ = ДокументОбъект.ДокументыОснования.Добавить();
			НоваяСтрокаТЧ.ДокументОснование = ДокументОснование; 
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПерезаполнениеЗначенийРеквизитовШапки(ТекущийОбъект, ДанныеЗаполнения)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ОбъектМетаданных = ТекущийОбъект.Метаданные();
	
	Для Каждого Строка Из ДанныеЗаполнения Цикл
		
		Если ЗначениеЗаполнено(Строка.Ключ) И ЕстьРеквизитМетаданных(ОбъектМетаданных, Строка.Ключ) Тогда
			Если ТекущийОбъект[Строка.Ключ] <> Строка.Значение Тогда
				ТекущийОбъект[Строка.Ключ] = Строка.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КодВидаОперацииСчетаФактурыПолученного(ДокументыОснования)
	
	Если Не ЗначениеЗаполнено(ДокументыОснования) Тогда
		Основание = Неопределено;
	ИначеЕсли ТипЗнч(ДокументыОснования) = Тип("Массив") Тогда
		Основание = ДокументыОснования[0];
	Иначе
		Основание = ДокументыОснования;
	КонецЕсли;
	
	КодВидаОперации = "";
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
		КодВидаОперации = "03";
	Иначе
		КодВидаОперации = "01";
	КонецЕсли;
	
	Возврат КодВидаОперации;
	
КонецФункции

// Номера ГТД

Функция НомерГТДПоДаннымЭлектронногоДокумента(ДанныеГТД)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеГТД) Тогда
		
		ПолучитьНомераГТД(ДанныеГТД);
		
		Результат = ДанныеГТД[0].НомерГТД.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает элементы справочника НомераГТД
//
// Параметры:
//  ДанныеГТД - Массив - содержит структуры с ключами:
//    * СтранаПроисхождения - Структура - см. НовыйКлючевыеСвойстваСтранаМира;
//       ** Ссылка - СправочникСсылка.СтраныМира
//       ** Код - Строка - код по ОКСМ
//    * НомерГТД - Структура - см. НовыйКлючевыеСвойстваГТД:
//       ** Ссылка - СправочникСсылка.НомераГТД
//       ** РегистрационныйНомер - Строка
//
Процедура ПолучитьНомераГТД(ДанныеГТД)
	
	Для Каждого Элемент Из ДанныеГТД Цикл 
		
		Если ЗначениеЗаполнено(Элемент.НомерГТД.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерТаможеннойДекларации	= Элемент.НомерГТД.РегистрационныйНомер;
		СтранаПроисхождения 		= Элемент.СтранаПроисхождения.Ссылка;
		
		Элемент.НомерГТД.Ссылка = НайтиСоздатьНомерГТД(НомерТаможеннойДекларации, СтранаПроисхождения);
		
	КонецЦикла;
	
КонецПроцедуры

// Получает ссылку на элемент справочника НомераГТД по номеру таможенной декларации.
// Если элемента с заданным номером ТД нет, создает новый.
//
// Параметры:
//  НомерТаможеннойДекларации - Строка - номер таможенной декларации;
//  СтранаПроисхождения - СправочникСсылка.СтраныМира - страна происхождения.
// 
// Возвращаемое значение:
//  СправочникСсылка.НомераГТД
//
Функция НайтиСоздатьНомерГТД(НомерТаможеннойДекларации, СтранаПроисхождения)
	
	Если Не ЗначениеЗаполнено(НомерТаможеннойДекларации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НомераГТД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.НомераГТД КАК НомераГТД
	|ГДЕ
	|	НомераГТД.Код = &НомерТаможеннойДекларации
	|	И НомераГТД.СтранаПроисхождения = &СтранаПроисхождения
	|	И НЕ НомераГТД.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НомерТаможеннойДекларации"	, НомерТаможеннойДекларации);
	Запрос.УстановитьПараметр("СтранаПроисхождения"			, СтранаПроисхождения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Ссылка;
		
	Иначе
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Код");
		ЗначенияЗаполнения.Вставить("СтранаПроисхождения");
		ЗначенияЗаполнения.Вставить("РегистрационныйНомерДекларации");
		ЗначенияЗаполнения.Вставить("СтранаВвозаНеРФ");
		ЗначенияЗаполнения.Вставить("ПорядковыйНомерТовара");
		
		РеквизитыТД = Справочники.НомераГТД.РегистрационныйНомерИСтранаВвоза(НомерТаможеннойДекларации);
		
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, РеквизитыТД);
		ЗначенияЗаполнения.Код = НомерТаможеннойДекларации;
		ЗначенияЗаполнения.СтранаПроисхождения = СтранаПроисхождения;
		
		НомерГТД = Справочники.НомераГТД.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НомерГТД, ЗначенияЗаполнения);
		
		Попытка
			
			НомерГТД.Записать();
			Результат = НомерГТД.Ссылка;
			
		Исключение
			
			Ошибка = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаЗагрузка()
				, УровеньЖурналаРегистрации.Ошибка
				, НомерГТД.Метаданные()
				,
				, ПодробноеПредставлениеОшибки(Ошибка));
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитИлиСвойствоОбъектаЛок(Объект, ИмяРеквизита)
	
