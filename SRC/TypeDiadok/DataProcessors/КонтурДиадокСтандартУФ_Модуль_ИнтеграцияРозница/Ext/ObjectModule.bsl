Функция ПараметрыЗаполненияПоступленияТоваров()
	
	Магазин = ЗначениеНастроекПовтИсп.МагазинПоУмолчанию();
	Склад = ЗначениеНастроекПовтИсп.СкладПоступленияПоУмолчанию(Магазин, , , Пользователи.ТекущийПользователь());
	
	Результат = Новый Структура;
	Результат.Вставить("ХозяйственнаяОперация", ХозяйственнаяОперацияПоступленияТоваровПоУмолчанию());
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("УчитыватьНДС", Истина);
	Результат.Вставить("Магазин", Магазин);
	Результат.Вставить("Склад", Склад);
	
