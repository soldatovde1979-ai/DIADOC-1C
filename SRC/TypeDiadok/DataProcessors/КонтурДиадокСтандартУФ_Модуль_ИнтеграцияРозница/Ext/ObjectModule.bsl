// Параметры:
//  ПравилаОбработки - ТаблицаЗначений - правила обработки документов (см. ПравилаОбработкиВходящихДокументов);
//
Процедура ЗаполнитьПравилаОбработкиАктов(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	ДляПервичныхДокументов = Ложь;
	ВидДокумента = ВидыЭД.АктОбОказанииУслуг;
	
	// Товары, услуги, комиссия
	ДобавитьПравилоОбработкиДокументов(
		ПравилаОбработки,
		ИдентификаторыПравил.ПоступлениеТоваров,
		ВидДокумента,
		ДляПервичныхДокументов);
	
