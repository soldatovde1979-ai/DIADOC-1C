Функция СтрСоединитьСовместимость(Строки, Разделитель)
	
	Результат = "";
	РазделительСтрока = Строка(Разделитель);
	
	ЭтоПерваяСтрока = Истина;
	
	Для Каждого Строка Из Строки Цикл
		
		Если ЭтоПерваяСтрока = Истина Тогда
			ЭтоПерваяСтрока = Ложь;
			Результат = Результат + Строка;
		Иначе
			Результат = Результат + РазделительСтрока + Строка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
