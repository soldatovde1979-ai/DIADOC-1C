Процедура АдресаЭлектроннойПочтыИзСтрокиОбработатьСтроку(Результат, Строка)
	
	ЧастиПредставления = Новый Массив;
	Для Каждого АдресСПредставлением Из СтрРазделитьЛок(СокрЛП(Строка), ",", Ложь) Цикл
		Если НЕ ЗначениеЗаполнено(АдресСПредставлением) Тогда
			ЧастиПредставления.Добавить(АдресСПредставлением);
			Продолжить;
		КонецЕсли;
		
		ЧастиСтроки = СтрРазделитьЛок(СокрП(АдресСПредставлением), " ", Истина);
		Адрес = СокрЛП(ЧастиСтроки[ЧастиСтроки.ВГраница()]);
		Псевдоним = "";
		ОписаниеОшибки = "";
		
		Если НайтиСимволыВАдресеЭлектроннойПочты(Адрес) Тогда
			Адрес = СтрСоединитьЛок(СтрРазделитьЛок(Адрес, "<>", Ложь), "");
			Если АдресЭлектроннойПочтыСоответствуетТребованиямЛок(Адрес) Тогда
				ЧастиСтроки.Удалить(ЧастиСтроки.ВГраница());
			Иначе
				ОписаниеОшибки = ПодставитьПараметрыВСтрокуЛок("Некорректный адрес электронной почты ""%1""", Адрес);
				Адрес = "";
			КонецЕсли;
			
			Псевдоним = СокрЛП(СтрСоединитьЛок(ЧастиПредставления, ",") + СтрСоединитьЛок(ЧастиСтроки, " "));
			ЧастиПредставления.Очистить();
			СтруктураАдреса = Новый Структура("Псевдоним, Адрес, ОписаниеОшибки", Псевдоним, Адрес, ОписаниеОшибки);
			Результат.Добавить(СтруктураАдреса);
		Иначе
			ЧастиПредставления.Добавить(АдресСПредставлением);
		КонецЕсли;
	КонецЦикла;
	
	Псевдоним = СтрСоединитьЛок(ЧастиПредставления, ",");
	Если ЗначениеЗаполнено(Псевдоним) Тогда
		Адрес = "";
		ОписаниеОшибки = ПодставитьПараметрыВСтрокуЛок("Некорректный адрес электронной почты ""%1""", Псевдоним);
		СтруктураАдреса = Новый Структура("Псевдоним, Адрес, ОписаниеОшибки", Псевдоним, Адрес, ОписаниеОшибки);
		Результат.Добавить(СтруктураАдреса);
	КонецЕсли;
	
КонецПроцедуры // АдресаЭлектроннойПочтыИзСтрокиОбработатьСтроку

Функция АдресаЭлектроннойПочтыИзСтрокиРеализация(СтрокаАдресов)
	
	Результат = Новый Массив;
	СимволыСкобок = "()[]";
	СтрокаАдресов_ = СтрСоединитьЛок(СтрРазделитьЛок(СтрокаАдресов, СимволыСкобок + " ", Ложь), " ");
	СтрокаАдресов_ = СтрЗаменить(СтрокаАдресов_, ">", ">;");
	СписокАдресов = СтрРазделитьЛок(СтрокаАдресов_, ";", Ложь);
	
	Для Каждого Строка Из СписокАдресов Цикл
		АдресаЭлектроннойПочтыИзСтрокиОбработатьСтроку(Результат, Строка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // АдресаЭлектроннойПочтыИзСтрокиРеализация

Функция АдресЭлектроннойПочтыСоответствуетТребованиямРеализация(Знач Адрес, РазрешитьЛокальныеАдреса)
	
	Буквы = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	АдресНеВалиден = АдресЭлектроннойПочтыНеВалиден(Адрес);
	
	Если АдресНеВалиден Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Приводим строку адреса к нижнему регистру.
	Адрес = НРег(Адрес);
	
	// Разбираем адрес на local-part и domain.
	Позиция = СтрНайтиЛок(Адрес, "@");
	ЛокальноеИмя = Лев(Адрес, Позиция - 1);
	Домен = Сред(Адрес, Позиция + 1);
	
	// Проверяем на заполненность и допустимость длины.
	ДлинаЛокальногоИмени = 64;
	ДлинаДомена = 255;
	ДанныеНеЗаполнены = ПустаяСтрока(ЛокальноеИмя)
		ИЛИ ПустаяСтрока(Домен)
		ИЛИ СтрДлина(ЛокальноеИмя) > ДлинаЛокальногоИмени
		ИЛИ СтрДлина(Домен) > ДлинаДомена;
	
	ДоменНеВалиден = ДоменНеВалиден(Домен, РазрешитьЛокальныеАдреса);
	
	Если ДоменНеВалиден ИЛИ ДанныеНеЗаполнены Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Выделяем зону (TLD) из имени домена.
	Зона = Домен;
	Позиция = СтрНайтиЛок(Зона, ".");
	Пока Позиция > 0 Цикл
		Зона = Сред(Зона, Позиция + 1);
		Позиция = СтрНайтиЛок(Зона, ".");
	КонецЦикла;
	
	МинимумДваСимвола = 2;
	// Проверяем зону домена (минимум 2 символа, только буквы).
	Возврат РазрешитьЛокальныеАдреса ИЛИ СтрДлина(Зона) >= МинимумДваСимвола И СтрокаСодержитТолькоДопустимыеСимволы(
		Зона, Буквы);
	
КонецФункции // АдресЭлектроннойПочтыСоответствуетТребованиямРеализация

Функция РазобратьСтрокуСПочтовымиАдресамиРеализация(СтрокаПереданныхАдресов, ВызыватьИсключение)
	
	Результат = Новый Массив;
	ОписанияОшибок = Новый Массив;
	Адресаты = АдресаЭлектроннойПочтыИзСтрокиЛок(СтрокаПереданныхАдресов);
	
	Для Каждого Адресат Из Адресаты Цикл
		Если ЗначениеЗаполнено(Адресат.ОписаниеОшибки) Тогда
			ОписанияОшибок.Добавить(Адресат.ОписаниеОшибки);
		КонецЕсли;
		Результат.Добавить(Новый Структура("Адрес, Представление", Адресат.Адрес, Адресат.Псевдоним));
	КонецЦикла;
	
	Если ВызыватьИсключение И ЗначениеЗаполнено(ОписанияОшибок) Тогда
		ТекстОшибки = СтрСоединитьЛок(ОписанияОшибок, Символы.ПС);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // РазобратьСтрокуСПочтовымиАдресамиРеализация

Функция НайтиСимволыВАдресеЭлектроннойПочты(Адрес)
	
	Возврат СтрНайтиЛок(Адрес, "@")
	ИЛИ СтрНайтиЛок(Адрес, "<")
	ИЛИ СтрНайтиЛок(Адрес, ">");
	
КонецФункции // НайтиСимволыВАдресеЭлектроннойПочты

Функция АдресЭлектроннойПочтыНеВалиден(Адрес)
	
	Буквы = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	Цифры = "0123456789";
	СпецСимволы = ".@_-:+";
	
	Возврат СтрЧислоВхождений(Адрес, "@") <> 1 // проверяем символ @
	ИЛИ СтрЧислоВхождений(Адрес, ":") > 1 // Разрешаем двоеточие только один раз
	ИЛИ СтрНайтиЛок(Адрес, "..") > 0 // проверяем две точки подряд
	ИЛИ НЕ СтрокаСодержитТолькоДопустимыеСимволы(НРег(Адрес), Буквы + Цифры + СпецСимволы);
	
КонецФункции // АдресЭлектроннойПочтыНеВалиден

Функция ДоменНеВалиден(Домен, РазрешитьЛокальныеАдреса = Ложь)
	
	СпецСимволы = ".@_-:+";
	
	Возврат ЕстьСимволыВНачалеВКонце(Домен, СпецСимволы) // Проверяем наличие спецсимволов в начале и в конце домена.
	ИЛИ РазрешитьЛокальныеАдреса И СтрНайтиЛок(Домен, ".") = 0 // В домене должна быть минимум одна точка
		ИЛИ СтрНайтиЛок(Домен, "_") > 0 // В домене не должно быть символа подчеркивания
		ИЛИ СтрНайтиЛок(Домен, ":") > 0 // В домене не должно быть символа двоеточие.
		ИЛИ СтрНайтиЛок(Домен, "+") > 0; // В домене не должно быть символа "плюс"
	
КонецФункции // ДоменНеВалиден

// МЕТОДЫ ГК

Функция СтрНайтиРеализация(Строка, Подстрока, Направление, Знач НачальнаяПозиция, НомерВхождения)
	
	Если СтрДлина(Подстрока) > СтрДлина(Строка) ИЛИ (СтрДлина(Подстрока) = СтрДлина(Строка) И Подстрока <> Строка) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Подстрока = "" Тогда
		Возврат 1;
	КонецЕсли;
	
	Если НачальнаяПозиция = Неопределено Тогда
		Если Направление = "СНачала" ИЛИ Строка(Направление) = "С начала" Тогда
			НачальнаяПозиция = 1;
		Иначе
			НачальнаяПозиция = СтрДлина(Строка);
		КонецЕсли;
	КонецЕсли;
	
	Если СтроковыеФункцииДоступны() Тогда
		Результат = СтрСлужебный83().СтрНайтиЛок(Строка, Подстрока, Направление, НачальнаяПозиция, НомерВхождения);
	Иначе
		Результат = СтрНайтиСовместимость(Строка, Подстрока, Направление, НачальнаяПозиция, НомерВхождения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СтрНайтиРеализация

Функция СтрНайтиСовместимость(Знач Строка, Знач Подстрока, Направление, НачальнаяПозиция, НомерВхождения)
	
	Позиция = НачальнаяПозиция;
	Если Направление = "СКонца" Тогда
		Строка = СтрРазвернутьРеализация(Строка);
		Подстрока = СтрРазвернутьРеализация(Подстрока);
		Позиция = 1;
	КонецЕсли;
	
	Результат = 0;
	Вхождение = 0;
	ДлинаСтроки = СтрДлина(Строка);
	ДлинаПодстроки = СтрДлина(Подстрока);
	
	Пока Позиция <> ДлинаСтроки + 1 Цикл
		Если Сред(Строка, Позиция, ДлинаПодстроки) = Подстрока Тогда
			Результат = Позиция;
			Вхождение = Вхождение + 1;
			Если Вхождение = НомерВхождения Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Если Направление = "СКонца" Тогда
		Сдвиг = 2;
		Результат = ДлинаСтроки - ДлинаПодстроки - Результат + Сдвиг;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СтрНайтиСовместимость

Функция СтрШаблонРеализация(Знач Шаблон, Параметр1, Параметр2 = Неопределено, Параметр3 = Неопределено,
		Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено,
		Параметр8 = Неопределено, Параметр9 = Неопределено, Параметр10 = Неопределено)
	
	Если СтроковыеФункцииДоступны() Тогда
		Результат = СтрСлужебный83().СтрШаблонЛок(Шаблон, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6,
				Параметр7, Параметр8, Параметр9, Параметр10);
	Иначе
		Результат = СтрШаблонСовместимость(Шаблон, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6,
				Параметр7, Параметр8, Параметр9, Параметр10);
	КонецЕсли;
	
