// Сравнивает текущую версию платформы с переданной версией.
// Параметры:
//  Версия - Строка - номер сравниваемой версии
//
// Возвращаемое значение:
//   Число   - Истина - версия платформы больше чем переданная, иначе - Ложь
//
Функция ВерсияПлатформыБольшеИлиРавна(Знач Версия) Экспорт
	
	Возврат ВерсияПлатформыБольшеИлиРавнаРеализация(Версия);
	
КонецФункции // ВерсияПлатформыБольшеИлиРавна

// Получает значения параметров из строки.
//
// Параметры:
//  СтрокаПараметров - Строка - строка, содержащая параметры, каждый из которых представляет собой
//                              фрагмент вида <Имя параметра>=<Значение>, где:
//                                Имя параметра - имя параметра;
//                                Значение - его значение.
//                              Фрагменты отделяются друг от друга символами ';'.
//                              Если значение содержит пробельные символы, то оно должно быть заключено в двойные
//                              кавычки (").
//                              Например:
//                               "File=""c:\InfoBases\Trade""; Usr=""Director"";"
//  Разделитель - Строка - символ, которым фрагменты отделяются друг от друга.
//
// Возвращаемое значение:
//  Соответствие - значения параметров, где ключ - имя параметра, значение - значение параметра.
//
// Пример:
//  Результат = РазобратьСтрокуПараметров("File=""c:\InfoBases\Trade""; Usr=""Director"";""", ";");
//  - вернет соответствие:
//     ключ "File" и значение "c:\InfoBases\Trade"
//     ключ "Usr"  и значение "Director".
//
Функция РазобратьСтрокуПараметров(Знач СтрокаПараметров, Знач Разделитель = ";") Экспорт
	
	Если ТипЗнч(СтрокаПараметров) <> Тип("Строка") Тогда
		Ошибка = "Несоответствие типов (параметр номер 1)";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Если ТипЗнч(Разделитель) <> Тип("Строка") Тогда
		Ошибка = "Несоответствие типов (параметр номер 2)";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Если ПустаяСтрока(Разделитель) Тогда
		Ошибка = "Недопустимое значение параметра (параметр номер 2)";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ЧитатьВСоответствие = Истина;
	Возврат ПараметрыИзСтрокиРеализация(СтрокаПараметров, Разделитель, ЧитатьВСоответствие);
	
КонецФункции // РазобратьСтрокуПараметров

