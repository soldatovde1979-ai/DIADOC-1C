Функция СтрРазвернутьРеализация(Знач Строка)
	
	Результат = "";
	ВторойСимвол = 2;
	Для Сч = 1 По СтрДлина(Строка) Цикл
		Результат = Лев(Строка, 1) + Результат;
		Строка = Сред(Строка, ВторойСимвол);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // СтрРазвернутьРеализация

Функция РазложитьСтрокуВМассивПодстрокРеализация(
		Знач Значение,
		Разделитель,
		Знач ПропускатьПустыеСтроки,
		СокращатьНепечатаемыеСимволы)
	
	Результат = РазложитьСтрокуВМассивПодстрокСтандартно(
			Значение, Разделитель, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Новый Массив;
	
	// Для обеспечения обратной совместимости.
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = (Разделитель = " ");
		Если ПустаяСтрока(Значение) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	//
	
	Результат = РазложитьСтрокуВМассивПодстрокПоПозиции(
			Значение, Разделитель, ПропускатьПустыеСтроки, СокращатьНепечатаемыеСимволы);
	
	Возврат Результат;
	
КонецФункции // РазложитьСтрокуВМассивПодстрокРеализация

Функция РазложитьСтрокуВМассивСловРеализация(Значение, РазделителиСлов)
	
	Слова = Новый Массив;
	
	РазмерТекста = СтрДлина(Значение);
	НачалоСлова = 1;
	Для Позиция = 1 По РазмерТекста Цикл
		КодСимвола = КодСимвола(Значение, Позиция);
		Если ЭтоРазделительСловЛок(КодСимвола, РазделителиСлов) Тогда
			Если Позиция <> НачалоСлова Тогда
				Слова.Добавить(Сред(Значение, НачалоСлова, Позиция - НачалоСлова));
			КонецЕсли;
			НачалоСлова = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Позиция <> НачалоСлова Тогда
		Слова.Добавить(Сред(Значение, НачалоСлова, Позиция - НачалоСлова));
	КонецЕсли;
	
	Возврат Слова;
	
КонецФункции // РазложитьСтрокуВМассивСловРеализация

Функция ПодставитьПараметрыВСтрокуРеализация(Знач ШаблонСтроки,
		Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
		Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
		Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено)
	
	ЕстьПараметрыСПроцентом = СтрНайтиЛок(Параметр1, "%")
		ИЛИ СтрНайтиЛок(Параметр2, "%")
		ИЛИ СтрНайтиЛок(Параметр3, "%")
		ИЛИ СтрНайтиЛок(Параметр4, "%")
		ИЛИ СтрНайтиЛок(Параметр5, "%")
		ИЛИ СтрНайтиЛок(Параметр6, "%")
		ИЛИ СтрНайтиЛок(Параметр7, "%")
		ИЛИ СтрНайтиЛок(Параметр8, "%")
		ИЛИ СтрНайтиЛок(Параметр9, "%");
	
	Если ЕстьПараметрыСПроцентом Тогда
		Возврат ПодставитьПараметрыСПроцентом(ШаблонСтроки, Параметр1,
			Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7, Параметр8, Параметр9);
	КонецЕсли;
	
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%2", Параметр2);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%3", Параметр3);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%4", Параметр4);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%5", Параметр5);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%6", Параметр6);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%7", Параметр7);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%8", Параметр8);
	ШаблонСтроки = СтрЗаменить(ШаблонСтроки, "%9", Параметр9);
	
	Возврат ШаблонСтроки;
	
КонецФункции // ПодставитьПараметрыВСтрокуРеализация

Функция ПодставитьПараметрыВСтрокуИзМассиваРеализация(ШаблонСтроки, Параметры)
	
	СтрокаРезультата = ШаблонСтроки;
	
	Индекс = Параметры.Количество();
	Пока Индекс > 0 Цикл
		Значение = Параметры[Индекс - 1];
		Если НЕ ПустаяСтрока(Значение) Тогда
			СтрокаРезультата = СтрЗаменить(СтрокаРезультата, "%" + Формат(Индекс, "ЧГ="), Значение);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Возврат СтрокаРезультата;
	
КонецФункции // ПодставитьПараметрыВСтрокуИзМассиваРеализация

Функция ЭтоРазделительСловРеализация(КодСимвола, РазделителиСлов)
	
	Если РазделителиСлов <> Неопределено Тогда
		Возврат СтрНайтиЛок(РазделителиСлов, Символ(КодСимвола)) > 0;
	КонецЕсли;
	
	Диапазон = "Мин, Макс";
	ЦифрыМин = 48;
	ЦифрыМакс = 57;
	
	ЛатиницаВРегМин = 65;
	ЛатиницаВРегМакс = 90;
	
	ЛатиницаНРегМин = 97;
	ЛатиницаНРегМакс = 122;
	
	КириллицаМин = 1040;
	КириллицаМакс = 1103;
	
	СимволВРегЕ = 1025;
	СимволНРегЕ = 1105;
	
	Символ_ = 95;
	
	Диапазоны = Новый Массив;
	Диапазоны.Добавить(Новый Структура(Диапазон, ЦифрыМин, ЦифрыМакс)); // цифры
	Диапазоны.Добавить(Новый Структура(Диапазон, ЛатиницаВРегМин, ЛатиницаВРегМакс)); // латиница большие
	Диапазоны.Добавить(Новый Структура(Диапазон, ЛатиницаНРегМин, ЛатиницаНРегМакс)); // латиница маленькие
	Диапазоны.Добавить(Новый Структура(Диапазон, КириллицаМин, КириллицаМакс)); // кириллица
	Диапазоны.Добавить(Новый Структура(Диапазон, СимволВРегЕ, СимволВРегЕ)); // символ "Ё"
	Диапазоны.Добавить(Новый Структура(Диапазон, СимволНРегЕ, СимволНРегЕ)); // символ "ё"
	Диапазоны.Добавить(Новый Структура(Диапазон, Символ_, Символ_)); // символ "_"
	
	Для Каждого Диапазон Из Диапазоны Цикл
		Если КодСимвола >= Диапазон.Мин И КодСимвола <= Диапазон.Макс Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // ЭтоРазделительСловРеализация

Функция ПодставитьПараметрыСПроцентом(Знач СтрокаПодстановки,
		Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
		Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
		Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено)
	
	Результат = "";
	Позиция = СтрНайтиЛок(СтрокаПодстановки, "%");
	
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(СтрокаПодстановки, Позиция - 1);
		СимволПослеПроцента = Сред(СтрокаПодстановки, Позиция + 1, 1);
		ПодставляемыйПараметр = Неопределено;
		Если СимволПослеПроцента = "1" Тогда
			ПодставляемыйПараметр = Параметр1;
		ИначеЕсли СимволПослеПроцента = "2" Тогда
			ПодставляемыйПараметр = Параметр2;
		ИначеЕсли СимволПослеПроцента = "3" Тогда
			ПодставляемыйПараметр = Параметр3;
		ИначеЕсли СимволПослеПроцента = "4" Тогда
			ПодставляемыйПараметр = Параметр4;
		ИначеЕсли СимволПослеПроцента = "5" Тогда
			ПодставляемыйПараметр = Параметр5;
		ИначеЕсли СимволПослеПроцента = "6" Тогда
			ПодставляемыйПараметр = Параметр6;
		ИначеЕсли СимволПослеПроцента = "7" Тогда
			ПодставляемыйПараметр = Параметр7;
		ИначеЕсли СимволПослеПроцента = "8" Тогда
			ПодставляемыйПараметр = Параметр8;
		ИначеЕсли СимволПослеПроцента = "9" Тогда
			ПодставляемыйПараметр = Параметр9;
		Иначе
			ПодставляемыйПараметр = Неопределено;
		КонецЕсли;
		Если ПодставляемыйПараметр = Неопределено Тогда
			Результат = Результат + "%";
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 1);
		Иначе
			Результат = Результат + ПодставляемыйПараметр;
			СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 1 + 1);
		КонецЕсли;
		Позиция = СтрНайтиЛок(СтрокаПодстановки, "%");
	КонецЦикла;
	
	Результат = Результат + СтрокаПодстановки;
	
	Возврат Результат;
	
КонецФункции // ПодставитьПараметрыСПроцентом

Функция ВставитьПараметрыВСтрокуРеализация(ШаблонСтроки, Параметры)
	
	Результат = ШаблонСтроки;
	Для Каждого Параметр Из Параметры Цикл
		Результат = СтрЗаменить(Результат, "[" + Параметр.Ключ + "]", Параметр.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ВставитьПараметрыВСтрокуРеализация

Функция ПараметрыИзСтрокиРеализация(СтрокаПараметров, Разделитель, ЧитатьВСоответствие = Ложь)
	
	Если ЧитатьВСоответствие Тогда
		Результат = Новый Соответствие;
	Иначе
		Результат = Новый Структура;
	КонецЕсли;
	
	ОписаниеПараметра = "";
	НайденоНачалоСтроки = Ложь;
	НомерПоследнегоСимвола = СтрДлина(СтрокаПараметров);
	Для НомерСимвола = 1 По НомерПоследнегоСимвола Цикл
		Символ = Сред(СтрокаПараметров, НомерСимвола, 1);
		Если Символ = """" Тогда
			НайденоНачалоСтроки = НЕ НайденоНачалоСтроки;
		КонецЕсли;
		Если Символ <> Разделитель ИЛИ НайденоНачалоСтроки Тогда
			ОписаниеПараметра = ОписаниеПараметра + Символ;
		КонецЕсли;
		Если Символ = Разделитель И НЕ НайденоНачалоСтроки ИЛИ НомерСимвола = НомерПоследнегоСимвола Тогда
			Позиция = СтрНайтиЛок(ОписаниеПараметра, "=");
			Если Позиция > 0 Тогда
				ИмяПараметра = СокрЛП(Лев(ОписаниеПараметра, Позиция - 1));
				ЗначениеПараметра = СокрЛП(Сред(ОписаниеПараметра, Позиция + 1));
				ЗначениеПараметра = СократитьДвойныеКавычкиЛок(ЗначениеПараметра);
				Результат.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
			ОписаниеПараметра = "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПараметрыИзСтрокиРеализация

Функция ТолькоЦифрыВСтрокеРеализация(Знач Значение, Знач Устаревший, Знач ПробелыЗапрещены)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ПробелыЗапрещены Тогда
		Значение = СтрЗаменить(Значение, " ", "");
	КонецЕсли;
	
	Если СтрДлина(Значение) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Если содержит только цифры, то в результате замен должна быть получена пустая строка.
	// Проверять при помощи ПустаяСтрока нельзя, так как в исходной строке могут быть пробельные символы.
	
	Значение = СтрЗаменить(Значение, "0", "");
	Значение = СтрЗаменить(Значение, "1", "");
	Значение = СтрЗаменить(Значение, "2", "");
	Значение = СтрЗаменить(Значение, "3", "");
	Значение = СтрЗаменить(Значение, "4", "");
	Значение = СтрЗаменить(Значение, "5", "");
	Значение = СтрЗаменить(Значение, "6", "");
	Значение = СтрЗаменить(Значение, "7", "");
	Значение = СтрЗаменить(Значение, "8", "");
	Значение = СтрЗаменить(Значение, "9", "");
	
	Возврат СтрДлина(Значение) = 0;
	
КонецФункции // ТолькоЦифрыВСтрокеРеализация

Функция ТолькоЛатиницаВСтрокеРеализация(СтрокаПроверки, УчитыватьРазделителиСлов, ДопустимыеСимволы)
	
	Если ТипЗнч(СтрокаПроверки) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаПроверки) Тогда
		Возврат Истина;
	КонецЕсли;
	
	КодыДопустимыхСимволов = Новый Массив;
	
	Для Индекс = 1 По СтрДлина(ДопустимыеСимволы) Цикл
		КодыДопустимыхСимволов.Добавить(КодСимвола(Сред(ДопустимыеСимволы, Индекс, 1)));
	КонецЦикла;
	
	Результат = Истина;
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		КодСимвола = КодСимвола(Сред(СтрокаПроверки, Индекс, 1));
		НеПодходит = ((КодСимвола < КодЛатВРегНГраница())
				ИЛИ (КодСимвола > КодЛатВРегВГраница() И КодСимвола < КодЛатНРегНГраница())
				ИЛИ (КодСимвола > КодЛатНРегВГраница()))
			И (КодыДопустимыхСимволов.Найти(КодСимвола) = Неопределено)
			И НЕ (НЕ УчитыватьРазделителиСлов И ЭтоРазделительСловЛок(КодСимвола));
		Если НеПодходит Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ТолькоЛатиницаВСтрокеРеализация

Функция СократитьДвойныеКавычкиРеализация(Знач Значение)
	
	Два = 2;
	Пока СтрНачинаетсяСЛок(Значение, """") Цикл
		Значение = Сред(Значение, Два);
	КонецЦикла;
	
	Пока СтрЗаканчиваетсяНаЛок(Значение, """") Цикл
		Значение = Лев(Значение, СтрДлина(Значение) - 1);
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции // СократитьДвойныеКавычкиРеализация

Функция УдалитьПоследнийСимволВСтрокеРеализация(Текст, ЧислоСимволов)
	
	Возврат Лев(Текст, СтрДлина(Текст) - ЧислоСимволов);
	
КонецФункции // УдалитьПоследнийСимволВСтрокеРеализация

Функция ЭтоУникальныйИдентификаторРеализация(Значение)
	
	Шаблон = "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX";
	
	Если СтрДлина(Шаблон) <> СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодСимволаИксВРег = 88;
	КодСимволаФНРег = 102;
	КодСимволаФВРег = 70;
	КодСимволаТире = 45;
	
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		КодСимвола = КодСимвола(Значение, Позиция);
		НеПодходит = КодСимвола(Шаблон, Позиция) = КодСимволаИксВРег // X
			И ((КодСимвола < КодЦифрыНГраница() ИЛИ КодСимвола > КодЦифрыВГраница()) // 0..9
				И (КодСимвола < КодЛатНРегНГраница() ИЛИ КодСимвола > КодСимволаФНРег) // a..f
				И (КодСимвола < КодЛатВРегНГраница() ИЛИ КодСимвола > КодСимволаФВРег)) // A..F
			ИЛИ КодСимвола(Шаблон, Позиция) = КодСимволаТире И КодСимвола <> КодСимволаТире; // -
		Если НеПодходит Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // ЭтоУникальныйИдентификаторРеализация

Функция СформироватьСтрокуСимволовРеализация(Символ, ДлинаСтроки)
	
	Результат = "";
	Для Счетчик = 1 По ДлинаСтроки Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // СформироватьСтрокуСимволовРеализация

Функция ДополнитьСтрокуРеализация(Знач Значение, Знач ДлинаСтроки, Знач Символ = "0", Знач Режим = "Слева")
	
	// Длина символа не должна превышать единицы.
	Символ = Лев(Символ, 1);
	
	// Удаляем крайние пробелы слева и справа строки.
	Значение = СокрЛП(Значение);
	КоличествоСимволовНадоДобавить = ДлинаСтроки - СтрДлина(Значение);
	
	Если КоличествоСимволовНадоДобавить > 0 Тогда
		
		СтрокаДляДобавления = СформироватьСтрокуСимволовЛок(Символ, КоличествоСимволовНадоДобавить);
		Если ВРег(Режим) = "СЛЕВА" Тогда
			Значение = СтрокаДляДобавления + Значение;
		ИначеЕсли ВРег(Режим) = "СПРАВА" Тогда
			Значение = Значение + СтрокаДляДобавления;
		Иначе
			ВызватьИсключение "не предполагаемый режим";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // ДополнитьСтрокуРеализация

Функция УдалитьПовторяющиесяСимволыРеализация(Знач Значение, УдаляемыйСимвол, Режим = "Слева")
	
	Два = 2;
	Если ВРег(Режим) = "СЛЕВА" Тогда
		Пока Лев(Значение, 1) = УдаляемыйСимвол Цикл
			Значение = Сред(Значение, Два);
		КонецЦикла;
	ИначеЕсли ВРег(Режим) = "СПРАВА" Тогда
		Пока Прав(Значение, 1) = УдаляемыйСимвол Цикл
			Значение = Лев(Значение, СтрДлина(Значение) - 1);
		КонецЦикла;
	Иначе
		ВызватьИсключение "не предполагаемый режим";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // УдалитьПовторяющиесяСимволыРеализация

Функция ЗаменитьОдниСимволыДругимиРеализация(ЗаменяемыеСимволы, Значение, СимволыЗамены)
	
	Результат = Значение;
	
	Для НомерСимвола = 1 По СтрДлина(ЗаменяемыеСимволы) Цикл
		Результат = СтрЗаменить(Результат, Сред(ЗаменяемыеСимволы, НомерСимвола, 1), Сред(СимволыЗамены, НомерСимвола, 1));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ЗаменитьОдниСимволыДругимиРеализация

Функция ПреобразоватьЧислоВРимскуюНотациюРеализация(Знач АрабскоеЧисло, ИспользоватьКириллицу)
	
	РимскоеЧисло = "";
	Три = 3;
	Два = 2;
	АрабскоеЧисло = ДополнитьСтрокуЛок(АрабскоеЧисло, Три);
	
	Если ИспользоватьКириллицу Тогда
		
		c1 = "1";
		c5 = "У";
		c10 = "Х";
		c50 = "Л";
		c100 = "С";
		c500 = "Д";
		c1000 = "М";
		
	Иначе
		
		c1 = "I";
		c5 = "V";
		c10 = "X";
		c50 = "L";
		c100 = "C";
		c500 = "D";
		c1000 = "M";
		
	КонецЕсли;
	
	Единицы = Число(Сред(АрабскоеЧисло, Три, 1));
	Десятки = Число(Сред(АрабскоеЧисло, Два, 1));
	Сотни = Число(Сред(АрабскоеЧисло, 1, 1));
	
	РимскоеЧисло = РимскоеЧисло + ПреобразоватьЦифруВРимскуюНотациюЛок(Сотни, c100, c500, c1000);
	РимскоеЧисло = РимскоеЧисло + ПреобразоватьЦифруВРимскуюНотациюЛок(Десятки, c10, c50, c100);
	РимскоеЧисло = РимскоеЧисло + ПреобразоватьЦифруВРимскуюНотациюЛок(Единицы, c1, c5, c10);
	
	Возврат РимскоеЧисло;
	
КонецФункции // ПреобразоватьЧислоВРимскуюНотациюРеализация

Функция ПреобразоватьЦифруВРимскуюНотациюЛок(Цифра, РимскаяЕдиница, РимскаяПятерка, РимскаяДесятка)
	
	Один = 1;
	Два = 2;
	Три = 3;
	Четыре = 4;
	Пять = 5;
	Шесть = 6;
	Семь = 7;
	Восемь = 8;
	Девять = 9;
	
	РимскаяЦифра = "";
	Если Цифра = Один Тогда
		РимскаяЦифра = РимскаяЕдиница;
	КонецЕсли;
	Если Цифра = Два Тогда
		РимскаяЦифра = РимскаяЕдиница + РимскаяЕдиница;
	КонецЕсли;
	Если Цифра = Три Тогда
		РимскаяЦифра = РимскаяЕдиница + РимскаяЕдиница + РимскаяЕдиница;
	КонецЕсли;
	Если Цифра = Четыре Тогда
		РимскаяЦифра = РимскаяЕдиница + РимскаяПятерка;
	КонецЕсли;
	Если Цифра = Пять Тогда
		РимскаяЦифра = РимскаяПятерка;
	КонецЕсли;
	Если Цифра = Шесть Тогда
		РимскаяЦифра = РимскаяПятерка + РимскаяЕдиница;
	КонецЕсли;
	Если Цифра = Семь Тогда
		РимскаяЦифра = РимскаяПятерка + РимскаяЕдиница + РимскаяЕдиница;
	КонецЕсли;
	Если Цифра = Восемь Тогда
		РимскаяЦифра = РимскаяПятерка + РимскаяЕдиница + РимскаяЕдиница + РимскаяЕдиница;
	КонецЕсли;
	Если Цифра = Девять Тогда
		РимскаяЦифра = РимскаяЕдиница + РимскаяДесятка;
	КонецЕсли;
	
	Возврат РимскаяЦифра;
	
КонецФункции // ПреобразоватьЦифруВРимскуюНотациюЛок

Процедура ПреобразоватьЧислоВАрабскуюНотациюРеализацияОбработатьСимвол(Сч, ЧислоСимволов, АрабскоеЧисло, РимскоеЧисло,
		c1, c5, c10, c50, c100, c500, c1000)
	
	Тысяча = 1000;
	Пятьсот = 500;
	Сто = 100;
	Пятьдесят = 50;
	Десять = 10;
	Пять = 5;
	
	СоответствиеЧисел = Новый Соответствие;
	СоответствиеЧисел.Вставить(c1000, Тысяча);
	СоответствиеЧисел.Вставить(c500, Пятьсот);
	СоответствиеЧисел.Вставить(c100, Сто);
	СоответствиеЧисел.Вставить(c50, Пятьдесят);
	СоответствиеЧисел.Вставить(c10, Десять);
	СоответствиеЧисел.Вставить(c5, Пять);
	СоответствиеЧисел.Вставить(c1, 1);
	
	ТекущееЧисло = ВРег(Сред(РимскоеЧисло, Сч, 1));
	ТекущееАрабскоеЧисло = СоответствиеЧисел[ТекущееЧисло];
	Если ТекущееАрабскоеЧисло = Неопределено Тогда
		ВызватьИсключение "Ошибка значения: " + ТекущееЧисло;
	КонецЕсли;
	
	Если Сч >= ЧислоСимволов Тогда
		АрабскоеЧисло = АрабскоеЧисло + СоответствиеЧисел[ТекущееЧисло];
		Возврат;
	КонецЕсли;
	
	СледующееЧисло = ВРег(Сред(РимскоеЧисло, Сч + 1, 1));
	Если ПреобразоватьЧислоВАрабскуюНотациюОтрицательныйСдвиг(ТекущееЧисло, СледующееЧисло,
			c1, c5, c10, c50, c100, c500, c1000) Тогда
		Множитель = -1;
	Иначе
		Множитель = 1;
	КонецЕсли;
	
	АрабскоеЧисло = АрабскоеЧисло + (СоответствиеЧисел[ТекущееЧисло] * Множитель);
	
КонецПроцедуры // ПреобразоватьЧислоВАрабскуюНотациюРеализацияОбработатьСимвол

Функция ПреобразоватьЧислоВАрабскуюНотациюОтрицательныйСдвиг(ТекущееЧисло, СледующееЧисло,
		c1, c5, c10, c50, c100, c500, c1000)
	
	Возврат (ТекущееЧисло = c100 И (СледующееЧисло = c500 ИЛИ СледующееЧисло = c1000))
		ИЛИ (ТекущееЧисло = c10 И (СледующееЧисло = c50 ИЛИ СледующееЧисло = c100))
		ИЛИ (ТекущееЧисло = c1 И (СледующееЧисло = c5 ИЛИ СледующееЧисло = c10));
	
КонецФункции // ПреобразоватьЧислоВАрабскуюНотациюОтрицательныйСдвиг

Функция ПреобразоватьЧислоВАрабскуюНотациюРеализация(Знач РимскоеЧисло, ИспользоватьКириллицу = Истина)
	
	АрабскоеЧисло = 0;
	
	Если ИспользоватьКириллицу Тогда
		c1 = "1";
		c5 = "У";
		c10 = "Х";
		c50 = "Л";
		c100 = "С";
		c500 = "Д";
		c1000 = "М";
	Иначе
		c1 = "I";
		c5 = "V";
		c10 = "X";
		c50 = "L";
		c100 = "C";
		c500 = "D";
		c1000 = "M";
	КонецЕсли;
	
	РимскоеЧисло = СтрЗаменить(СокрЛП(РимскоеЧисло), " ", "");
	ЧислоСимволов = СтрДлина(РимскоеЧисло);
	
	Для Сч = 1 По ЧислоСимволов Цикл
		ПреобразоватьЧислоВАрабскуюНотациюРеализацияОбработатьСимвол(Сч, ЧислоСимволов, АрабскоеЧисло, РимскоеЧисло,
			c1, c5, c10, c50, c100, c500, c1000);
	КонецЦикла;
	
	Возврат АрабскоеЧисло;
	
КонецФункции // ПреобразоватьЧислоВАрабскуюНотациюРеализация

Функция ИзвлечьТекстИзHTMLРеализация(Знач ИсходныйТекст)
	
	Результат = "";
	Текст = НРег(ИсходныйТекст);
	
	Пять = 5;
	Восемь = 8;
	Девять = 9;
	// отрезаем все что не body
	Позиция = СтрНайтиЛок(Текст, "<body");
	Если Позиция > 0 Тогда
		Текст = Сред(Текст, Позиция + Пять);
		ИсходныйТекст = Сред(ИсходныйТекст, Позиция + Пять);
		Позиция = СтрНайтиЛок(Текст, ">");
		Если Позиция > 0 Тогда
			Текст = Сред(Текст, Позиция + 1);
			ИсходныйТекст = Сред(ИсходныйТекст, Позиция + 1);
		КонецЕсли;
	КонецЕсли;
	
	Позиция = СтрНайтиЛок(Текст, "</body>");
	Если Позиция > 0 Тогда
		Текст = Лев(Текст, Позиция - 1);
		ИсходныйТекст = Лев(ИсходныйТекст, Позиция - 1);
	КонецЕсли;
	
	// вырезаем скрипты
	Позиция = СтрНайтиЛок(Текст, "<script");
	Пока Позиция > 0 Цикл
		ПозицияЗакрывающегоТега = СтрНайтиЛок(Текст, "</script>");
		Если ПозицияЗакрывающегоТега = 0 Тогда
			// Не найден закрывающий тег - вырезаем оставшийся текст.
			ПозицияЗакрывающегоТега = СтрДлина(Текст);
		КонецЕсли;
		Текст = Лев(Текст, Позиция - 1) + Сред(Текст, ПозицияЗакрывающегоТега + Девять);
		ИсходныйТекст = Лев(ИсходныйТекст, Позиция - 1) + Сред(ИсходныйТекст, ПозицияЗакрывающегоТега + Девять);
		Позиция = СтрНайтиЛок(Текст, "<script");
	КонецЦикла;
	
	// вырезаем стили
	Позиция = СтрНайтиЛок(Текст, "<style");
	Пока Позиция > 0 Цикл
		ПозицияЗакрывающегоТега = СтрНайтиЛок(Текст, "</style>");
		Если ПозицияЗакрывающегоТега = 0 Тогда
			// Не найден закрывающий тег - вырезаем оставшийся текст.
			ПозицияЗакрывающегоТега = СтрДлина(Текст);
		КонецЕсли;
		Текст = Лев(Текст, Позиция - 1) + Сред(Текст, ПозицияЗакрывающегоТега + Восемь);
		ИсходныйТекст = Лев(ИсходныйТекст, Позиция - 1) + Сред(ИсходныйТекст, ПозицияЗакрывающегоТега + Восемь);
		Позиция = СтрНайтиЛок(Текст, "<style");
	КонецЦикла;
	
	// вырезаем все теги
	Позиция = СтрНайтиЛок(Текст, "<");
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(ИсходныйТекст, Позиция - 1);
		Текст = Сред(Текст, Позиция + 1);
		ИсходныйТекст = Сред(ИсходныйТекст, Позиция + 1);
		Позиция = СтрНайтиЛок(Текст, ">");
		Если Позиция > 0 Тогда
			Текст = Сред(Текст, Позиция + 1);
			ИсходныйТекст = Сред(ИсходныйТекст, Позиция + 1);
		КонецЕсли;
		Позиция = СтрНайтиЛок(Текст, "<");
	КонецЦикла;
	Результат = Результат + ИсходныйТекст;
	МассивСтрок = РазложитьСтрокуВМассивПодстрокЛок(Результат, Символы.ПС, Истина, Истина);
	
	Возврат СокрЛП(СтрСоединитьЛок(МассивСтрок, Символы.ПС));
	
КонецФункции // ИзвлечьТекстИзHTMLРеализация

Функция СтрокаВЧислоРеализация(Знач Значение)
	
	Значение = СтрЗаменить(Значение, " ", "");
	Если СтрНачинаетсяСЛок(Значение, "(") Тогда
		Значение = СтрЗаменить(Значение, "(", "-");
		Значение = СтрЗаменить(Значение, ")", "");
	КонецЕсли;
	
	СтрокаБезНулей = СтрЗаменить(Значение, "0", "");
	Если ПустаяСтрока(СтрокаБезНулей) ИЛИ СтрокаБезНулей = "-" Тогда
		Возврат 0;
	КонецЕсли;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	Результат = ТипЧисло.ПривестиЗначение(Значение);
	
	Если Результат <> 0 И НЕ ПустаяСтрока(СтрокаБезНулей) Тогда
		Возврат Результат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // СтрокаВЧислоРеализация

Функция СтрокаСодержитТолькоДопустимыеСимволы(Строка, ДопустимыеСимволы)
	
	МассивСимволов = Новый Массив;
	Для Позиция = 1 По СтрДлина(ДопустимыеСимволы) Цикл
		МассивСимволов.Добавить(Сред(ДопустимыеСимволы, Позиция, 1));
	КонецЦикла;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если МассивСимволов.Найти(Сред(Строка, Позиция, 1)) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // СтрокаСодержитТолькоДопустимыеСимволы

Функция ЕстьСимволыВНачалеВКонце(Строка, ПроверяемыеСимволы)
	
	Для Позиция = 1 По СтрДлина(ПроверяемыеСимволы) Цикл
		Символ = Сред(ПроверяемыеСимволы, Позиция, 1);
		СимволНайден = (Лев(Строка, 1) = Символ) ИЛИ (Прав(Строка, 1) = Символ);
		Если СимволНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции // ЕстьСимволыВНачалеВКонце