Функция ВерсияКонфигурацииБезНомераСборкиРеализация(Версия)
	
	Массив = СтрРазделитьЛок(Версия, ".");
	КоличествоРазрядов = 3;
	Два = 2;
	
	Если Массив.Количество() < КоличествоРазрядов Тогда
		Возврат Версия;
	КонецЕсли;
	
	Результат = "[Редакция].[Подредакция].[Релиз]";
	Результат = СтрЗаменить(Результат, "[Редакция]", Массив[0]);
	Результат = СтрЗаменить(Результат, "[Подредакция]", Массив[1]);
	Результат = СтрЗаменить(Результат, "[Релиз]", Массив[Два]);
	
	Возврат Результат;
	
КонецФункции // ВерсияКонфигурацииБезНомераСборкиРеализация

Функция СравнитьВерсииРеализация(Знач СтрокаВерсия1, Знач СтрокаВерсия2)
	
	Результат = 0;
	Если СокрЛП(СтрокаВерсия1) = СокрЛП(СтрокаВерсия2) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Версия1 = СтрРазделитьЛок(СтрокаВерсия1, ".");
	Версия2 = СтрРазделитьЛок(СтрокаВерсия2, ".");
	
	КоличествоИтераций = Мин(Версия1.Количество(), Версия2.Количество()) - 1;
	Для Разряд = 0 По КоличествоИтераций Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат (Результат > 0) - (Результат < 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // СравнитьВерсииРеализация

Функция СравнитьВерсииБезНомераСборкиРеализация(СтрокаВерсия1, СтрокаВерсия2)
	
	Результат = 0;
	Два = 2;
	Если СокрЛП(СтрокаВерсия1) = СокрЛП(СтрокаВерсия2) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Версия1 = СтрРазделитьЛок(СтрокаВерсия1, ".");
	Версия2 = СтрРазделитьЛок(СтрокаВерсия2, ".");
	
	КоличествоИтераций = Мин(Версия1.Количество(), Версия2.Количество()) - 1;
	КоличествоИтераций = Мин(КоличествоИтераций, Два);
	Для Разряд = 0 По КоличествоИтераций Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат (Результат > 0) - (Результат < 0);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // СравнитьВерсииБезНомераСборкиРеализация

