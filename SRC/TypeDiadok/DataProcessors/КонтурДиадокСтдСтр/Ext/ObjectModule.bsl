КонецФункции // СтрШаблонРеализация

Функция СтрШаблонСовместимость(Знач Шаблон, Параметр1, Параметр2 = Неопределено, Параметр3 = Неопределено,
		Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено,
		Параметр8 = Неопределено, Параметр9 = Неопределено, Параметр10 = Неопределено)
	
	ЕстьПараметрыСПроцентом = СтрНайтиЛок(Параметр1, "%")
		ИЛИ СтрНайтиЛок(Параметр2, "%")
		ИЛИ СтрНайтиЛок(Параметр3, "%")
		ИЛИ СтрНайтиЛок(Параметр4, "%")
		ИЛИ СтрНайтиЛок(Параметр5, "%")
		ИЛИ СтрНайтиЛок(Параметр6, "%")
		ИЛИ СтрНайтиЛок(Параметр7, "%")
		ИЛИ СтрНайтиЛок(Параметр8, "%")
		ИЛИ СтрНайтиЛок(Параметр9, "%")
		ИЛИ СтрНайтиЛок(Параметр10, "%");
	
	Если ЕстьПараметрыСПроцентом Тогда
		Возврат СтрШаблонСовместимостьСПроцентом(Шаблон, Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6,
			Параметр7, Параметр8, Параметр9, Параметр10);
	КонецЕсли;
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Параметр1);
	МассивПараметров.Добавить(Параметр2);
	МассивПараметров.Добавить(Параметр3);
	МассивПараметров.Добавить(Параметр4);
	МассивПараметров.Добавить(Параметр5);
	МассивПараметров.Добавить(Параметр6);
	МассивПараметров.Добавить(Параметр7);
	МассивПараметров.Добавить(Параметр8);
	МассивПараметров.Добавить(Параметр9);
	МассивПараметров.Добавить(Параметр10);
	
	ВсегоПараметров = 11;
	Для М = 1 По 10 Цикл
		
		НомерПараметра = Строка(ВсегоПараметров - М);
		
		Шаблон = СтрЗаменить(Шаблон, "%" + НомерПараметра, МассивПараметров.Получить(НомерПараметра - 1));
		Шаблон = СтрЗаменить(Шаблон, "%(" + НомерПараметра + ")", МассивПараметров.Получить(НомерПараметра - 1));
		
	КонецЦикла;
	
	Возврат Шаблон;
	
КонецФункции // СтрШаблонСовместимость

Функция СтрШаблонСовместимостьСПроцентом(Знач Шаблон, Параметр1, Параметр2 = Неопределено, Параметр3 = Неопределено,
		Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено,
		Параметр8 = Неопределено, Параметр9 = Неопределено, Параметр10 = Неопределено)
	
	Результат = "";
	Позиция = СтрНайтиЛок(Шаблон, "%");
	
	КартаПараметров = Новый Соответствие;
	КартаПараметров.Вставить("1", Параметр1);
	КартаПараметров.Вставить("(1)", Параметр1);
	КартаПараметров.Вставить("2", Параметр2);
	КартаПараметров.Вставить("(2)", Параметр2);
	КартаПараметров.Вставить("3", Параметр3);
	КартаПараметров.Вставить("(3)", Параметр3);
	КартаПараметров.Вставить("4", Параметр4);
	КартаПараметров.Вставить("(4)", Параметр4);
	КартаПараметров.Вставить("5", Параметр5);
	КартаПараметров.Вставить("(5)", Параметр5);
	КартаПараметров.Вставить("6", Параметр6);
	КартаПараметров.Вставить("(6)", Параметр6);
	КартаПараметров.Вставить("7", Параметр7);
	КартаПараметров.Вставить("(7)", Параметр7);
	КартаПараметров.Вставить("8", Параметр8);
	КартаПараметров.Вставить("(8)", Параметр8);
	КартаПараметров.Вставить("9", Параметр9);
	КартаПараметров.Вставить("(9)", Параметр9);
	КартаПараметров.Вставить("10", Параметр10);
	КартаПараметров.Вставить("(10)", Параметр10);
	
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Шаблон, Позиция - 1);
		СимволПослеПроцента = Сред(Шаблон, Позиция + 1, 1);
		Если СимволПослеПроцента = "(" Тогда
			СимволПослеПроцента = Сред(Шаблон, Позиция + 1, СтрНайтиЛок(Шаблон, ")", , Позиция) - Позиция);
		КонецЕсли;
		Если Сред(Шаблон, Позиция + 1 + 1, 1) = "0" Тогда
			СимволПослеПроцента = СимволПослеПроцента + "0";
		КонецЕсли;
		ПодставляемыйПараметр = КартаПараметров.Получить(СимволПослеПроцента);
		Если ПодставляемыйПараметр = Неопределено Тогда
			Шаблон = Сред(Шаблон, Позиция + СтрДлина(СимволПослеПроцента) + 1);
		Иначе
			Результат = Результат + ПодставляемыйПараметр;
			Шаблон = Сред(Шаблон, Позиция + СтрДлина(СимволПослеПроцента) + 1);
		КонецЕсли;
		Позиция = СтрНайтиЛок(Шаблон, "%");
	КонецЦикла;
	
	Результат = Результат + Шаблон;
	Возврат Результат;
	
КонецФункции // СтрШаблонСовместимостьСПроцентом

Функция СтрСравнитьРеализация(Строка1, Строка2)
	
	Если СтроковыеФункцииДоступны() Тогда
		Результат = СтрСлужебный83().СтрСравнитьЛок(Строка1, Строка2);
	Иначе
		Результат = СтрСравнитьСовместимость(Строка1, Строка2);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СтрСравнитьРеализация

Функция СтрСравнитьСовместимость(Строка1, Строка2)
	
	Результат = 0;
	КоличествоИтераций = Макс(СтрДлина(Строка1), СтрДлина(Строка2));
	
	Для Номер = 1 По КоличествоИтераций Цикл
		Если НРег(Сред(Строка1, Номер, 1)) < НРег(Сред(Строка2, Номер, 1)) Тогда
			Результат = -1;
			Прервать;
		ИначеЕсли НРег(Сред(Строка1, Номер, 1)) > НРег(Сред(Строка2, Номер, 1)) Тогда
			Результат = 1;
			Прервать;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // СтрСравнитьСовместимость

Функция СтрРазделитьРеализация(Строка, Разделитель, ВключатьПустые)
	
	Если СтроковыеФункцииДоступны() Тогда
		Результат = СтрСлужебный83().СтрРазделитьЛок(Строка, Разделитель, ВключатьПустые);
	Иначе
		Результат = СтрРазделитьСовместимость(Строка, Разделитель, ВключатьПустые);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СтрРазделитьРеализация

Функция СтрРазделитьСовместимость(Знач Строка, Знач Разделитель, ВключатьПустые)
	
	ПропускатьПустыеСтроки = НЕ ВключатьПустые;
	Результат = Новый Массив;
	
	НачалоСтроки = 1;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если СтрНайтиЛок(Разделитель, Символ) > 0 Тогда
			Значение = Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки);
			Если НЕ ПропускатьПустыеСтроки ИЛИ НЕ ПустаяСтрока(Значение) Тогда
				Результат.Добавить(Значение);
			КонецЕсли;
			НачалоСтроки = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Значение = Сред(Строка, НачалоСтроки, Позиция - НачалоСтроки);
	Если НЕ ПропускатьПустыеСтроки ИЛИ НЕ ПустаяСтрока(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СтрРазделитьСовместимость

