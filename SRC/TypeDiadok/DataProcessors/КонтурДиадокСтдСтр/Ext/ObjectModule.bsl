// ПРОЧЕЕ

Процедура СтрокаВДатуРеализацияЗаполнитьЗначенияДатаВремя(ОписаниеТипаДата, Значение,
		ЗначениеДата, ЗначениеВремя, Результат)
	
	НаборЦифр = "1234567890";
	ЗначениеМассивом = СтрРазделитьЛок(Значение, " ");
	Элемент = ЗначениеМассивом[ЗначениеМассивом.ВГраница()];
	Если ЗначениеМассивом.Количество() > 1 Тогда
		
		Два = 2;
		Четыре = 4;
		
		Если СтрДлина(Элемент) = Два ИЛИ СтрДлина(Элемент) = Четыре Тогда
			
			ЭтоТолькоЦифры = СтрРазделитьЛок(Элемент, НаборЦифр, Ложь).Количество() = 0;
			Если ЭтоТолькоЦифры Тогда
				ЗначениеДата = Значение;
				ЗначениеВремя = "";
			Иначе
				ЗначениеВремя = Элемент;
				ЗначениеМассивом.Удалить(ЗначениеМассивом.ВГраница());
				ЗначениеДата = СтрСоединитьЛок(ЗначениеМассивом, " ");
			КонецЕсли;
		Иначе
			
			ЗначениеВремя = Элемент;
			ЗначениеМассивом.Удалить(ЗначениеМассивом.ВГраница());
			ЗначениеДата = СтрСоединитьЛок(ЗначениеМассивом, " ");
		КонецЕсли;
		
	Иначе
		
		ЭтоТолькоЦифры = СтрРазделитьЛок(Элемент, НаборЦифр, Ложь).Количество() = 0;
		Если ЭтоТолькоЦифры Тогда
			СтрокаВДатуРеализацияЗаполнитьЗначенияДатаВремяТолькоЦифры(ОписаниеТипаДата, Элемент, Результат);
		ИначеЕсли СтрНайтиЛок(Элемент, ":") > 0 Тогда
			ЗначениеДата = "";
			ЗначениеВремя = Элемент;
		Иначе
			ЗначениеДата = Элемент;
			ЗначениеВремя = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // СтрокаВДатуРеализацияЗаполнитьЗначенияДатаВремя

Процедура СтрокаВДатуРеализацияЗаполнитьЗначенияДатаВремяТолькоЦифры(ОписаниеТипаДата, Элемент, Результат)
	
	Результат = ОписаниеТипаДата.ПривестиЗначение(Элемент);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		Два = 2;
		Три = 3;
		Пять = 5;
		Шесть = 6;
		Семь = 7;
		ДвадцатьДевять = 29;
		
		Если СтрДлина(Элемент) = Шесть Тогда
			
			ПеревернутаяДата = Сред(Элемент, Пять) + Сред(Элемент, Три, Два) + Лев(Элемент, Два);
			Год = СтрокаВЧислоЛок(Лев(ПеревернутаяДата, Два));
			Если Год <> Неопределено Тогда
				Если Год > ДвадцатьДевять Тогда
					ПеревернутаяДата = "19" + ПеревернутаяДата;
				Иначе
					ПеревернутаяДата = "20" + ПеревернутаяДата;
				КонецЕсли;
				Результат = ОписаниеТипаДата.ПривестиЗначение(ПеревернутаяДата);
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрДлина(Элемент) > Семь Тогда
			
			ПеревернутаяДата = Сред(Элемент, Пять) + Сред(Элемент, Три, Два) + Лев(Элемент, Два);
			Результат = ОписаниеТипаДата.ПривестиЗначение(ПеревернутаяДата);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // СтрокаВДатуРеализацияЗаполнитьЗначенияДатаВремяТолькоЦифры

Процедура СтрокаВДатуРеализацияОбработатьЗначениеДата(ОписаниеТипаДата, ЗначениеДата, ЧастьДаты)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеДата) ИЛИ ЧастьДаты = ЧастиДаты.Время Тогда
		ЗначениеДата = "00010101";
		Возврат;
	КонецЕсли;
	
	НаборЦифр = "1234567890";
	НаборРазделителей = СтрСоединитьЛок(СтрРазделитьЛок(ЗначениеДата, НаборЦифр, Ложь), "");
	ЗначениеДатаМассивом = СтрРазделитьЛок(ЗначениеДата, НаборРазделителей, Ложь);
	
	ЭтоТолькоЦифры = СтрРазделитьЛок(ЗначениеДата, НаборЦифр, Ложь).Количество() = 0;
	Если НЕ ЭтоТолькоЦифры Тогда
		СтрокаВДатуРеализацияОбработатьЗначениеДатаЭтоНеТолькоЦифры(ЗначениеДата, ЗначениеДатаМассивом);
	Иначе
		СтрокаВДатуРеализацияОбработатьЗначениеДатаЭтоТолькоЦифры(ОписаниеТипаДата, ЗначениеДата);
	КонецЕсли;
	
КонецПроцедуры // СтрокаВДатуРеализацияОбработатьЗначениеДата

Процедура СтрокаВДатуРеализацияОбработатьЗначениеДатаЭтоНеТолькоЦифры(ЗначениеДата, ЗначениеДатаМассивом)
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	Год = 1;
	Месяц = 1;
	День = 1;
	Два = 2;
	Три = 3;
	Четыре = 4;
	
	Если СтрДлина(ЗначениеДатаМассивом[0]) = Четыре Тогда
		Год = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеДатаМассивом[0]);
		ГодВНачале = Истина;
	Иначе
		День = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеДатаМассивом[0]);
		ГодВНачале = Ложь;
	КонецЕсли;
	
	Если ЗначениеДатаМассивом.Количество() = Два Тогда
		Месяц = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеДатаМассивом[1]);
	КонецЕсли;
	
	Если ЗначениеДатаМассивом.Количество() > Два Тогда
		Месяц = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеДатаМассивом[1]);
		Если ГодВНачале Тогда
			День = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеДатаМассивом[Два]);
		Иначе
			Год = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеДатаМассивом[Два]);
		КонецЕсли;
	КонецЕсли;
	
	Если СтрДлина(Год) < Три Тогда
		ГодЧислом = ОписаниеТипаЧисло.ПривестиЗначение(Год);
		Тридцать = 30;
		Если ГодЧислом < Тридцать Тогда
			ДвеТысячи = 2000;
			Год = ДвеТысячи + ГодЧислом;
		Иначе
			ТысячаДевятьсот = 1900;
			Год = ТысячаДевятьсот + ГодЧислом;
		КонецЕсли;
	Иначе
		Год = ОписаниеТипаЧисло.ПривестиЗначение(Год);
	КонецЕсли;
	
	ЗначениеДата = Формат(Год, "ЧЦ=4; ЧН=0001; ЧВН=; ЧГ=0")
		+ Формат(Месяц, "ЧЦ=2; ЧН=01; ЧВН=; ЧГ=0")
		+ Формат(День, "ЧЦ=2; ЧН=01; ЧВН=; ЧГ=0");
	
КонецПроцедуры // СтрокаВДатуРеализацияОбработатьЗначениеДатаЭтоНеТолькоЦифры

Процедура СтрокаВДатуРеализацияОбработатьЗначениеДатаЭтоТолькоЦифры(ОписаниеТипаДата, ЗначениеДата)
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	
	Два = 2;
	Три = 3;
	Шесть = 6;
	Восемь = 8;
	Тридцать = 30;
	
	Если СтрДлина(ЗначениеДата) = Шесть Тогда
		
		Год = Прав(ЗначениеДата, Два);
		ГодЧислом = ОписаниеТипаЧисло.ПривестиЗначение(Год);
		Если ГодЧислом < Тридцать Тогда
			ДвеТысячи = 2000;
			ЗначениеДата = ДвеТысячи + Год + Сред(ЗначениеДата, Три, Два) + Лев(ЗначениеДата, Два);
		Иначе
			ТысячаДевятьсот = 1900;
			ЗначениеДата = ТысячаДевятьсот + Год + Сред(ЗначениеДата, Три, Два) + Лев(ЗначениеДата, Два);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтрДлина(ЗначениеДата) = Восемь Тогда
		
		Результат = ОписаниеТипаДата.ПривестиЗначение(ЗначениеДата);
		Пять = 5;
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			ПеревернутаяДата = Сред(ЗначениеДата, Пять) + Сред(ЗначениеДата, Три, Два) + Лев(ЗначениеДата, Два);
			Результат = ОписаниеТипаДата.ПривестиЗначение(ПеревернутаяДата);
			Если ЗначениеЗаполнено(Результат) Тогда
				ЗначениеДата = ПеревернутаяДата;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // СтрокаВДатуРеализацияОбработатьЗначениеДатаЭтоТолькоЦифры

Процедура СтрокаВДатуРеализацияОбработатьЗначениеВремя(ЗначениеВремя, ЧастьДаты)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеВремя) ИЛИ ЧастьДаты = ЧастиДаты.Дата Тогда
		ЗначениеВремя = "000000";
		Возврат;
	КонецЕсли;
	
	НаборЦифр = "1234567890";
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	
	ЭтоТолькоЦифры = СтрРазделитьЛок(ЗначениеВремя, НаборЦифр, Ложь).Количество() = 0;
	Если НЕ ЭтоТолькоЦифры Тогда
		
		НаборРазделителей = СтрСоединитьЛок(СтрРазделитьЛок(ЗначениеВремя, НаборЦифр, Ложь), "");
		ЗначениеВремяМассивом = СтрРазделитьЛок(ЗначениеВремя, НаборРазделителей, Ложь);
		
		Час = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеВремяМассивом[0]);
		Два = 2;
		Минута = 0;
		Секунда = 0;
		
		Если ЗначениеВремяМассивом.Количество() = Два Тогда
			Минута = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеВремяМассивом[1]);
		КонецЕсли;
		Если ЗначениеВремяМассивом.Количество() > Два Тогда
			Минута = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеВремяМассивом[1]);
			Секунда = ОписаниеТипаЧисло.ПривестиЗначение(ЗначениеВремяМассивом[Два]);
		КонецЕсли;
		
		ШаблонФормата = "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0";
		ЗначениеВремя = Формат(Час, ШаблонФормата)
			+ Формат(Минута, ШаблонФормата)
			+ Формат(Секунда, ШаблонФормата);
		
	КонецЕсли;
	
КонецПроцедуры // СтрокаВДатуРеализацияОбработатьЗначениеВремя

Функция СтрокаВДатуРеализация(Знач Значение, Знач ЧастьДаты = Неопределено)
	
	НаборЦифр = "1234567890";
	Два = 2;
	
	Если ТипЗнч(ЧастьДаты) <> Тип("ЧастиДаты") Тогда
		ЧастьДаты = ЧастиДаты.Дата;
	КонецЕсли;
	
	ОписаниеТипаДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастьДаты));
	Значение = ВРег(СтрСоединитьЛок(СтрРазделитьЛок(СокрЛП(Значение), Символы.НПП + Символы.ПС + Символы.Таб), " "));
	Результат = ОписаниеТипаДата.ПривестиЗначение(Значение);
	
	Для НомерМесяца = 1 По 12 Цикл
		Значение = СтрЗаменить(Значение, ВРег(Формат(Дата(1, НомерМесяца, Два), "ДФ=ММММ")),
				Формат(НомерМесяца, "ЧЦ=2; ЧВН="));
		Значение = СтрЗаменить(Значение, ВРег(Формат(Дата(1, НомерМесяца, Два), "ДФ=MMM")),
				Формат(НомерМесяца, "ЧЦ=2; ЧВН="));
	КонецЦикла;
	
	МассивНеЦифр = СтрРазделитьЛок(Значение, НаборЦифр);
	Если МассивНеЦифр.Количество() < Два Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПозицияПервойЦифры = СтрДлина(МассивНеЦифр[0]);
	ПозицияПоследнейЦифры = СтрДлина(Значение) - СтрДлина(МассивНеЦифр[МассивНеЦифр.ВГраница()]);
	Значение = Сред(Значение, ПозицияПервойЦифры, ПозицияПоследнейЦифры - ПозицияПервойЦифры);
	Если ПустаяСтрока(Значение) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Неопределено;
	ЗначениеДата = "";
	ЗначениеВремя = "";
	
	СтрокаВДатуРеализацияЗаполнитьЗначенияДатаВремя(ОписаниеТипаДата, Значение, ЗначениеДата, ЗначениеВремя, Результат);
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаВДатуРеализацияОбработатьЗначениеДата(ОписаниеТипаДата, ЗначениеДата, ЧастьДаты);
	СтрокаВДатуРеализацияОбработатьЗначениеВремя(ЗначениеВремя, ЧастьДаты);
	
	Результат = ОписаниеТипаДата.ПривестиЗначение(ЗначениеДата + ЗначениеВремя);
	
	Возврат Результат;
	
КонецФункции // СтрокаВДатуРеализация

Функция ВерсияПлатформыБольшеИлиРавнаРеализация(Версия)
	
