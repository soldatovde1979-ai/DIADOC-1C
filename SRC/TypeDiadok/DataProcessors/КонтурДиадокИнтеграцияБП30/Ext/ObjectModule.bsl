Функция АктСверки405_ИнформацияПолучателя(ДокСсылка, ПараметрыФормирования) Экспорт
	
	Результат = Новый_ReconciliationActRecipientTitle();
	
	Если НЕ АктСверки405_ПроверитьВозможностьФормированияОтветногоТитула(Результат, ДокСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Запрос.Текст = ТекстЗапроса_ДанныеШапкиАктаСверкиВзаиморасчетов();
	
	ДанныеШапки = Запрос.Выполнить().Выгрузить();
	ДанныеШапки = ДанныеШапки[0];
	
	АктСверки405_ПроверитьВозможностьОтправки(Результат, ДокСсылка);
	
	Если ДанныеШапки.ЕстьРасхождения Тогда
		Результат.SignDisagreement = "WithDisagreements";
	Иначе
		Результат.SignDisagreement = "WithoutDisagreements";
	КонецЕсли;
	
	АктСверки405_ЗаполнитьШапкуОтветногоТитула(Результат);
	
	ЗаполнитьТаблицуОтветногоТитулаАктаСверки = ПараметрыФормирования.ЗаполнитьТаблицуОтветногоТитулаАктаСверки;
	
	Если ЗаполнитьТаблицуОтветногоТитулаАктаСверки Тогда
		
		ВыборкаДанныхАктаСверки = АктСверки405_ДанныеДляЗаполненияТабличнойЧастиОтветногоТитула(
			ДокСсылка,
			ДанныеШапки
		);
		
		АктСверки405_ЗаполнитьТабличнуюЧастьОтветногоТитула(
			Результат,
			ВыборкаДанныхАктаСверки,
			ДокСсылка
		);
		
		АктСверки405_ЗаполнитьИтогиТабличнойЧастиОтветногоТитула(
			Результат,
			ВыборкаДанныхАктаСверки,
			ДанныеШапки
		);
		
	КонецЕсли;
	
	АктСверки405_ЗаполнитьПодписанта(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки405_ИнформацияОтправителя(ДокСсылка) Экспорт
	
	РеквизитыДокумента = АктСверки405_ШапкаИнформацииОтправителя(ДокСсылка);
	
	Результат = Новый_ReconciliationActSenderTitle();
	
	АктСверки405_ПроверитьВозможностьОтправки(Результат, ДокСсылка);
	
	АктСверки405_ЗаполнитьШапкуТитулаОтправителя(
		Результат,
		РеквизитыДокумента
	);
	
	АктСверки405_ЗаполнитьРеквизитыОтправителя(
		Результат,
		РеквизитыДокумента.Организация,
		РеквизитыДокумента.Дата
	);
	
	АктСверки405_ЗаполнитьРеквизитыПолучателя(
		Результат,
		РеквизитыДокумента.Контрагент,
		РеквизитыДокумента.Дата
	);
	
	ВыборкаПоДоговорам = АктСверки405_ТабличнаяЧастьИнформацииОтправителя(ДокСсылка);
	
	АктСверки405_ПроверитьОборотыЗаПериодСверки(Результат, ВыборкаПоДоговорам, ДокСсылка);
	
	АктСверки405_ЗаполнитьТабличнуюЧастьТитулаОтправителя(
		Результат,
		ВыборкаПоДоговорам,
		ДокСсылка
	);
	
	ИтогиПоДокументу = АктСверки405_ИтогиИнформацииОтправителя(ДокСсылка);
	
	ОборотПоДебету = ИтогиПоДокументу.Итог("Дебет");
	ОборотПоКредиту = ИтогиПоДокументу.Итог("Кредит");
	
	ОстатокНаНачало = РеквизитыДокумента.ОстатокНаНачало;
	
	АктСверки405_ЗаполнитьИтогиПоТабличнойЧастиТитулаОтправителя(
		Результат,
		ОстатокНаНачало,
		ОборотПоДебету,
		ОборотПоКредиту
	);
	
	АктСверки405_ЗаполнитьПодписанта(Результат);
	
	Возврат Результат;
	
КонецФункции

