Функция АктСверки405_ДанныеДляЗаполненияТабличнойЧастиОтветногоТитула(ДокСсылка, ДанныеШапки)
	
	ПараметрСчетаИсключения = АктСверки405_СчетаИсключения();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Запрос.Текст = ТекстЗапроса_ДанныеТабличныхЧастейАктаСверкиВзаиморасчетов();
	
	ПараметрГруппаДоговоров = Неопределено;
	
	Если ДанныеШапки.ДоговорКонтрагента.ЭтоГруппа Тогда
		ПараметрГруппаДоговоров = ДанныеШапки.ДоговорКонтрагента;
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	ПараметрАналитикаРасчетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	ПараметрАктСверкиВВалюте = ДанныеШапки.ВалютаДокумента <> ВалютаРегламентированногоУчета;
	ПараметрСчетаИсключения = АктСверки405_СчетаИсключения();
	
	Запрос.УстановитьПараметр("ГруппаДоговоров", ПараметрГруппаДоговоров);
	Запрос.УстановитьПараметр("Организация", ДанныеШапки.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ДанныеШапки.ДатаНачала);
	Запрос.УстановитьПараметр("Контрагент", ДанныеШапки.Контрагент);
	Запрос.УстановитьПараметр("АналитикаРасчетов", ПараметрАналитикаРасчетов);
	Запрос.УстановитьПараметр("АктСверкиВВалюте", ПараметрАктСверкиВВалюте);
	Запрос.УстановитьПараметр("СчетаИсключения", ПараметрСчетаИсключения);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;
	
КонецФункции

