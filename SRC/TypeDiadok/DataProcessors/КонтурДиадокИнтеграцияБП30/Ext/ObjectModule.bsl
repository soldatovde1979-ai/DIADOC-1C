Функция АктСверки405_ПараметрыСверки(ДокСсылка)
	
	ФильтрСписокСчетов = АктСверки405_СчетаРасчетов(ДокСсылка);
	
	ДоговорыПоДаннымОрганизации = АктСверки405_Договоры(ДокСсылка, "ПоДаннымОрганизации");
	ДоговорыПоДаннымКонтрагента = АктСверки405_Договоры(ДокСсылка, "ПоДаннымКонтрагента");
	
	ВалютаРегламентированногоУчета = ВалютаРегламентированногоУчета();
	
	ТолькоУникальныеДоговоры = Истина;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		ДоговорыПоДаннымОрганизации,
		ДоговорыПоДаннымКонтрагента,
		ТолькоУникальныеДоговоры
	);
	
	ПараметрАналитикаРасчетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	ПараметрАктСверкиВВалюте = ДокСсылка.ВалютаДокумента <> ВалютаРегламентированногоУчета;
	ПараметрСчетаИсключения = АктСверки405_СчетаИсключения();
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(
		ДокСсылка,
		"Организация, ДатаНачала"
	);
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", РеквизитыДокумента.Организация);
	Результат.Вставить("НачалоПериода", РеквизитыДокумента.ДатаНачала);
	Результат.Вставить("СчетаРасчетов", ФильтрСписокСчетов);
	Результат.Вставить("Договоры", ДоговорыПоДаннымОрганизации);
	Результат.Вставить("АналитикаРасчетов", ПараметрАналитикаРасчетов);
	Результат.Вставить("АктСверкиВВалюте", ПараметрАктСверкиВВалюте);
	Результат.Вставить("СчетаИсключения", ПараметрСчетаИсключения);
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки405_СчетаРасчетов(ДокСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабличнаяЧастьСписокСчетов.Счет КАК Счет
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.СписокСчетов КАК ТабличнаяЧастьСписокСчетов
	|ГДЕ
	|	ТабличнаяЧастьСписокСчетов.Ссылка = &Ссылка
	|	И ТабличнаяЧастьСписокСчетов.УчаствуетВРасчетах = ИСТИНА
	|	И НЕ ТабличнаяЧастьСписокСчетов.Счет ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	ВыгрузкаСпискаСчетов = Запрос.Выполнить().Выгрузить();
	
	Результат = ВыгрузкаСпискаСчетов.ВыгрузитьКолонку("Счет");
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки405_Договоры(ДокСсылка, ИмяТаблицы)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Т.Договор КАК Договор
	|ИЗ
	|	&ПолноеИмяТаблицы КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка";
	
	ПолноеИмяТаблицы = СтрЗаменить("Документ.АктСверкиВзаиморасчетов.%ИмяТаблицы%", "%ИмяТаблицы%", ИмяТаблицы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	ВыгрузкаДоговоров = Запрос.Выполнить().Выгрузить();
	
	Результат = ВыгрузкаДоговоров.ВыгрузитьКолонку("Договор");
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки405_СчетаИсключения()
	
	СчетаИсключения = ПланыСчетов.Хозрасчетный.СчетаНДСПоАренднымОбязательствам();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		СчетаИсключения,
		ПланыСчетов.Хозрасчетный.СчетаПроцентовПоОбязательствам()
	);
	
	СчетаИсключения.Добавить(ПланыСчетов.Хозрасчетный.РасчетыНДСНалоговогоАгента);
	СчетаИсключения.Добавить(ПланыСчетов.Хозрасчетный.КорректировкаРасчетовПрошлогоПериода);
	
	Возврат СчетаИсключения;
	
КонецФункции

