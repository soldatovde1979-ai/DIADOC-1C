#Область УПД970

#Область УПД970_ПрограммныйИнтерфейс

// Возвращает заполненную протоструктуру титула продавца в формате 970 по данным документа 1С
//
// Параметры:
//  ДокСсылка				 - ДокументСсылка - ссылка на учетный документ 1С, по которому заполняется протоконтент титула продавца 970@
//  ФункцияДокумента - Строка - функция УПД (возможные значения: СЧФ, СЧФДОП, ДОП)
//  ДополнительныеПараметры	 - Структура - Модуль_Ядро.ДополнительныеПараметрыПолученияКонтента
// 
// Возвращаемое значение:
//  Структура - заполненный протоконтент УПД (см. Контракт_ПротоСтруктураУПД970)
//
Функция УПД970_КонтентТитулаПродавца(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры) Экспорт
	
	ТипДокумента = ТипЗнч(ДокСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		
		Content = УПД970_КонтентТитулаОтправителя_ВнутренниеПеремещения(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоРеализацииТоваровУслуг(
			ДокСсылка,
			ДополнительныеПараметры);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоВозвратуТоваровПоставщику(
			ДокСсылка,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоАктуОбОказанииПроизводственныхУслуг(
			ДокСсылка,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПоПереработке") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоРеализацииУслугПоПереработке(
			ДокСсылка,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОС") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоПередачеОС(
			ДокСсылка,
			ДополнительныеПараметры);
		
	ИначеЕсли Метаданные.Документы.Найти("АР_НачислениеАренднойПлаты") <> Неопределено
		И ТипДокумента = Тип("ДокументСсылка.АР_НачислениеАренднойПлаты") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоНачислениюАренднойПлаты(
			ДокСсылка,
			ДополнительныеПараметры);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
			
		Content = УПД970_КонтентТитулаПродавцаПоОтчетуКомитентуОПродажах(
			ДокСсылка,
			ДополнительныеПараметры);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			
		Если ЭтоСчетФактураВыданныйНаАванс(ДокСсылка) Тогда
			
			Content = УПД970_КонтентТитулаПродавцаПоСчетФактураВыданныйНаАванс(
				ДокСсылка,
				ДополнительныеПараметры
			);
			
		Иначе
			
			Content = УПД970_КонтентТитулаПродавцаПоСчетФактураВыданный(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры
			);
			
		КонецЕсли;
			
	ИначеЕсли ЭтоИсправлениеРеализации(ДокСсылка) Тогда
			
		Content = УПД970_КонтентТитулаПродавцаПоКорректировкеРеализации(
			ДокСсылка,
			ДополнительныеПараметры);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоРеализацииОтгруженныхТоваров(
			ДокСсылка,
			ДополнительныеПараметры);
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаТоваров") Тогда
		
		Content = УПД970_КонтентТитулаПродавцаПоПередачеТоваров(
			ДокСсылка,
			ДополнительныеПараметры);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru = 'Неподдерживаемый тип документа %1'");
		ВызватьИсключение СтрШаблон(ШаблонТекстаОшибки, ДокСсылка.Метаданные().Синоним);
		
	КонецЕсли;
	
	Возврат Content;
	
КонецФункции

#КонецОбласти

#Область УПД970_ВнутренниеПеремещения

// Возвращает заполненную протоструктуру титула продавца в формате 970 по данным документа 1С
//
// Параметры:
//  ДокСсылка				 - ДокументСсылка - ссылка на учетный документ 1С, по которому заполняется протоконтент титула продавца 970@
//  ФункцияДокумента - Строка - функция УПД (возможные значения: СЧФ, СЧФДОП, ДОП)
//  ДополнительныеПараметры	 - Структура - Модуль_Ядро.ДополнительныеПараметрыПолученияКонтента
// 
// Возвращаемое значение:
//  Структура - заполненный протоконтент УПД (см. Контракт_ПротоСтруктураУПД970)
//
Функция УПД970_КонтентТитулаОтправителя_ВнутренниеПеремещения(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры)
	
	Если ЭтоПередачаТоваровМеждуСотрудниками(ДокСсылка) Тогда
		
		ТекстОшибки = НСтр("ru='Отправка ТОРГ-13 на основании перемещения товаров между сотрудниками не поддержана'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ДанныеДокумента = УПД970_ПолучитьДанныеПоДокументуПеремещениеТоваров(ДокСсылка);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТаблицаДокумента = ДанныеДокумента.ТаблицаДокумента;
	ВалютаРегламентированногоУчета = ВалютаРегламентированногоУчета();
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Content = УПД970_НовыйПротоСтруктураУПД970();
	Content.Function = "ДОП";
	Content.CircumFormatInvoice = "00051";
	Content.DocumentNumber = ДанныеШапки.Номер;
	Content.DocumentDate = ДанныеШапки.Дата;
	Content.DocumentName = НаименованияДокументов.УПД;
	
	РеквизитыДокументов = Новый Структура;
	РеквизитыДокументов.Вставить("НомерДокумента", Content.DocumentNumber);
	РеквизитыДокументов.Вставить("ДатаДокумента", Content.DocumentDate);
	РеквизитыДокументов.Вставить("НаименованиеДокумента", Content.DocumentName);
	
	DocumentShipment = УПД970_ЗаполненныйDocumentShipments970(РеквизитыДокументов);
	Content.DocumentShipments.Добавить(DocumentShipment);
	
	Content.Currency = ВалютаРегламентированногоУчета.Код;
	
	ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДанныеШапки.Дата);
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеШапки.Организация, "Ссылка, КПП");
	
	ВнутренниеПеремещения_ЗаполнитьSeller(Content, ДанныеУчастникаЭДО, РеквизитыОрганизации);
	ВнутренниеПеремещения_ЗаполнитьBuyer(Content, ДанныеУчастникаЭДО, РеквизитыОрганизации);
	
	Грузоотправитель = ДанныеШапки.Организация;
	Если ЗначениеЗаполнено(ДанныеШапки.ПодразделениеОтправитель) Тогда
		Грузоотправитель = ДанныеШапки.ПодразделениеОтправитель;
	КонецЕсли;
	ВнутреннееПеремещение_ЗаполнитьГрузоотправителя(Content, Грузоотправитель, ДанныеШапки.Дата);
	Content.Shippers[0].OrganizationInfo.Department = ДанныеШапки.Поставщик;
	
	Грузополучатель = ДанныеШапки.Организация;
	Если ЗначениеЗаполнено(ДанныеШапки.ПодразделениеПолучатель) Тогда
		Грузополучатель = ДанныеШапки.ПодразделениеПолучатель;
	КонецЕсли;
	ВнутреннееПеремещение_ЗаполнитьГрузополучателя(Content, Грузополучатель, ДанныеШапки.Дата);
	Content.Consignees[0].Department = ДанныеШапки.Покупатель;
	
	ВнутренниеПеремещения_ЗаполнитьTableInvoice(Content, ТаблицаДокумента, ДокСсылка);
	ВнутренниеПеремещения_ЗаполнитьTransferInfo(Content, ДополнительныеПараметры);
	ВнутренниеПеремещения_ЗаполнитьEmployee(Content, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Content);
	УПД970_ЗаполнитьСведенияОМаркировке(Content, ДокСсылка);
	УПД970_ЗаполнитьСоставителяДокумента(Content, ДокСсылка);
	
	Возврат Content;
	
КонецФункции

Функция УПД970_ПолучитьДанныеПоДокументуПеремещениеТоваров(ДокСсылка)
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ДокСсылка);
	
	ДополнительнаяКолонкаПечатныхФормДокументов = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	Если НЕ ЗначениеЗаполнено(ДополнительнаяКолонкаПечатныхФормДокументов) Тогда
		ДополнительнаяКолонкаПечатныхФормДокументов = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить;
	КонецЕсли;
	
	ВыводитьКоды = ДополнительнаяКолонкаПечатныхФормДокументов <> Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить;
	
	ТекстЗапроса = ТекстЗапроса_ДанныеПоПеремещениюТоваров();
	
	ФормированиеЭД = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатЗапроса[1].Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТаблицаДокумента", ТаблицаДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДанныеПоПеремещениюТоваров()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПеремещениеТоваров.Ссылка КАК Ссылка,
	|	ПеремещениеТоваров.Номер КАК Номер,
	|	ПеремещениеТоваров.Дата КАК Дата,
	|	ПеремещениеТоваров.Организация КАК Организация,
	|	ПеремещениеТоваров.ПодразделениеОтправитель КАК ПодразделениеОтправитель,
	|	ПеремещениеТоваров.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
	|	ПеремещениеТоваров.СкладОтправитель КАК СкладОтправитель,
	|	ПеремещениеТоваров.СкладОтправитель.Представление КАК Поставщик,
	|	ПеремещениеТоваров.СкладПолучатель КАК СкладПолучатель,
	|	ПеремещениеТоваров.СкладПолучатель.Представление КАК Покупатель,
	|	ПеремещениеТоваров.ВидОперации КАК ВидОперации,
	|	ПеремещениеТоваров.СотрудникОтправитель КАК СотрудникОтправитель,
	|	ПеремещениеТоваров.СотрудникПолучатель КАК СотрудникПолучатель,
	|	ПеремещениеТоваров.СотрудникОтправитель.Представление КАК СотрудникОтправительПредставление,
	|	ПеремещениеТоваров.СотрудникПолучатель.Представление КАК СотрудникПолучательПредставление
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПеремещениеТоваров.Дата,
	|	ПеремещениеТоваров.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Номенклатура.НаименованиеПолное КАК ТоварНаименованиеПолное,
	|	Товары.Номенклатура.Наименование КАК ТоварНаименование,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА Товары.Номенклатура.Артикул
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Код)
	|			ТОГДА Товары.Номенклатура.Код
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить)
	|			ТОГДА """"
	|	КОНЕЦ КАК Артикул,
	|	Товары.Количество КАК Количество,
	|	Товары.КоличествоМест КАК КоличествоМест,
	|	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Товары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаХранения,
	|	ВЫБОР
	|		КОГДА Товары.ЦенаВРознице > 0
	|			ТОГДА Товары.ЦенаВРознице
	|		ИНАЧЕ Товары.Цена
	|	КОНЕЦ КАК Цена,
	|	Товары.СтавкаНДСВРознице КАК СтавкаНДС,
	|	Товары.СуммаВРознице КАК Сумма,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	1 КАК ID,
	|	Товары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Товары.Номенклатура.НаименованиеПолное,
	|	Товары.Номенклатура.Наименование,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА Товары.Номенклатура.Артикул
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Код)
	|			ТОГДА Товары.Номенклатура.Код
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить)
	|			ТОГДА """"
	|	КОНЕЦ,
	|	Товары.Количество,
	|	Товары.Количество,
	|	Товары.Номенклатура.ЕдиницаИзмерения,
	|	Товары.Номенклатура.ЕдиницаИзмерения,
	|	0,
	|	НЕОПРЕДЕЛЕНО,
	|	0,
	|	Товары.НомерСтроки,
	|	2,
	|	Товары.Ссылка
	|ИЗ
	|	Документ.ПеремещениеТоваров.ВозвратнаяТара КАК Товары
	|ГДЕ
	|	Товары.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ID,
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Процедура ВнутренниеПеремещения_ЗаполнитьSeller(Content, Знач ДанныеУчастникаЭДО, Знач РеквизитыОрганизации)
	
	Seller = Контракт_ExtendedOrganizationInfo970();
	
	УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, ДанныеУчастникаЭДО);
	
	Seller.Kpp = РеквизитыОрганизации.КПП;
	
	СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ЮридическийАдресJSON);
	Seller.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
	
	Seller.СлужебнаяИнформация.Ссылка = РеквизитыОрганизации.Ссылка;
	
	Content.Sellers.Добавить(Seller);
	
КонецПроцедуры

Процедура ВнутренниеПеремещения_ЗаполнитьBuyer(Content, Знач ДанныеУчастникаЭДО, Знач РеквизитыОрганизации)
		
	Buyer = Контракт_ExtendedOrganizationInfo970();
	
	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, ДанныеУчастникаЭДО);
	
	Buyer.Kpp = РеквизитыОрганизации.КПП;
	
	СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ЮридическийАдресJSON);
	Buyer.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
	
	Buyer.СлужебнаяИнформация.Ссылка = РеквизитыОрганизации.Ссылка;
	Content.Buyers.Добавить(Buyer);
		
КонецПроцедуры

Процедура ВнутреннееПеремещение_ЗаполнитьГрузоотправителя(
			Content, 
			Знач Грузоотправитель, 
			Знач ДатаСведений)
			
	Shipper = Контракт_Shipper970();
	Shipper.SameAsSeller = Ложь;
	
	ЭтоОбособленноеПодразделение = (ТипЗнч(Грузоотправитель) <> Тип("СправочникСсылка.Организации"))
		И Грузоотправитель.ОбособленноеПодразделение;
	
	ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Грузоотправитель, ДатаСведений);
	
	ShipperInfo = Контракт_ExtendedOrganizationInfo970();
	Shipper.OrganizationInfo = ShipperInfo;
	
	УПД970_ЗаполнитьExtendedOrganizationInfo(ShipperInfo, ДанныеУчастникаЭДО);
	
	Если ЭтоОбособленноеПодразделение Тогда
		
		Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.КПП)
			И Content.Sellers[0].Kpp <> ДанныеУчастникаЭДО.КПП Тогда
			Content.Sellers[0].Kpp = ДанныеУчастникаЭДО.КПП;
		КонецЕсли;
		
		ShipperInfo.Name = ДанныеУчастникаЭДО.НаименованиеПодразделения;
		
		ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций;
		
		ИнтерфейсБП = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейБП");
		СтруктураАдреса = ИнтерфейсБП.АдресСтруктурой(
			Грузоотправитель,
			ВидКонтактнойИнформации,
			ДатаСведений);
			
		СведенияОбАдресе = УПД970_СведенияОбАдресе(СтруктураАдреса.ЗначениеJSON);
		ShipperInfo.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
		
	КонецЕсли;
	
	ShipperInfo.СлужебнаяИнформация.Ссылка = Грузоотправитель;
	
	Content.Shippers.Добавить(Shipper);
	
КонецПроцедуры

Процедура ВнутреннееПеремещение_ЗаполнитьГрузополучателя(
			Content, 
			Знач Грузополучатель, 
			Знач ДатаСведений)
			
	Consignee = Контракт_ExtendedOrganizationInfo970();
	
	ЭтоОбособленноеПодразделение = (ТипЗнч(Грузополучатель) <> Тип("СправочникСсылка.Организации"))
		И Грузополучатель.ОбособленноеПодразделение;
	
	ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Грузополучатель, ДатаСведений);
	
	УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, ДанныеУчастникаЭДО);
	
	Если ЭтоОбособленноеПодразделение Тогда
		
		Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.КПП)
			И Content.Buyers[0].Kpp <> ДанныеУчастникаЭДО.КПП Тогда
			Content.Buyers[0].Kpp = ДанныеУчастникаЭДО.КПП;
		КонецЕсли;
		
		Consignee.Name = ДанныеУчастникаЭДО.НаименованиеПодразделения;
		
		ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций;
		
		ИнтерфейсБП = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейБП");
		СтруктураАдреса = ИнтерфейсБП.АдресСтруктурой(
			Грузополучатель,
			ВидКонтактнойИнформации,
			ДатаСведений);
			
		СведенияОбАдресе = УПД970_СведенияОбАдресе(СтруктураАдреса.ЗначениеJSON);
		Consignee.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
		
	КонецЕсли;
	
	Consignee.СлужебнаяИнформация.Ссылка = Грузополучатель;
	
	Content.Consignees.Добавить(Consignee);
	
КонецПроцедуры

Процедура ВнутренниеПеремещения_ЗаполнитьTableInvoice(Content, Знач ТаблицаДокумента, Знач ДокСсылка)
		
	Table = Content.Table;
	
	ВсеСтрокиБезНДС = Истина;
	СтавкаБезНДС = Перечисления.СтавкиНДС.БезНДС;
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	СписокНоменклатуры = ТаблицаДокумента.ВыгрузитьКолонку("Номенклатура");
	
	ДанныеОбъекта = Новый Структура("Дата, Организация, Склад");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, ДокСсылка);
	
	ДанныеОбъекта.Склад	= ДокСсылка.СкладОтправитель;
	СоответствиеСведенийОНоменклатуре = БухгалтерскийУчетПереопределяемый.ПолучитьСведенияОСпискеНоменклатуры(
		СписокНоменклатуры, ДанныеОбъекта, Ложь);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		
		Item = Контракт_Item970();
		
		РеквизитыТовара = СоответствиеСведенийОНоменклатуре.Получить(СтрокаТаблицы.Номенклатура);
		
		Если ЗначениеЗаполнено(РеквизитыТовара.НаименованиеПолное) Тогда
			НаименованиеТовара = РеквизитыТовара.НаименованиеПолное;
		Иначе
			НаименованиеТовара = РеквизитыТовара.Наименование;
		КонецЕсли;
		
		Item.Product = НаименованиеТовара;
		Item.ItemMark = ТипыНоменклатуры.Имущество;
		Item.ItemVendorCode = СтрокаТаблицы.Артикул;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			Item.Quantity = СтрокаТаблицы.Количество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			Item.UnitName = СокрЛП(СтрокаТаблицы.ЕдиницаИзмерения.Наименование);
			Item.Unit = СокрЛП(СтрокаТаблицы.ЕдиницаИзмерения.Код);
		КонецЕсли;
		
		Item.TaxRate = ПредставлениеСтавкиБезНДС();
		
		ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		Если НЕ ЭтоСтавкаБезНДС Тогда
			ВсеСтрокиБезНДС = Ложь;
		КонецЕсли;
		
		Item.Price = СтрокаТаблицы.Цена;
		Item.Subtotal = СтрокаТаблицы.Сумма;
		Item.Vat = 0;
		Item.SubtotalWithVatExcluded = Item.Subtotal - Item.Vat;
		
		ВнутренниеПеремещения_ЗаполнитьCustomDeclaration(Item, РеквизитыТовара);
		
		Item.СлужебнаяИнформация = ВнутренниеПеремещения_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы, ДокСсылка);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.TotalNet = ТаблицаДокумента.Итог("Количество");
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	Table.Vat = 0;
	Table.Total = ТаблицаДокумента.Итог("Сумма");
	Table.TotalWithVatExcluded = Table.Total - Table.Vat;
	
КонецПроцедуры

Процедура ВнутренниеПеремещения_ЗаполнитьCustomDeclaration(Item, СтрокаТаблицы)
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерГТД)
		И Не ЗначениеЗаполнено(СтрокаТаблицы.СтранаПроисхождения) Тогда
		Возврат;
	КонецЕсли;
	
	CustomDeclaration = Контракт_CustomDeclarations();
	CustomDeclaration.CountryCode = СтрокаТаблицы.СтранаПроисхождения.Код;
	CustomDeclaration.DeclarationNumber = СокрЛП(СтрокаТаблицы.НомерГТД);
		
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

Процедура ВнутренниеПеремещения_ЗаполнитьTransferInfo(Content, Знач ДополнительныеПараметры)
		
	TransferInfo = Content.TransferInfo;
	
	TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	TransferInfo.TransferDate = УПД970_ОпределитьДатаОтгрузки(Content.DocumentDate, Content.DocumentShipments);
	
	УПД970_УстановитьЗначениеБезОснованияОтгрузки(TransferInfo);
		
КонецПроцедуры

Процедура ВнутренниеПеремещения_ЗаполнитьEmployee(Content, Знач ДополнительныеПараметры)
		
	ДанныеСотрудника = СвойствоСтруктурыЛок(
	ДополнительныеПараметры,
	"ДанныеСотрудника");
	
	Если ЗначениеЗаполнено(ДанныеСотрудника)
		И ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
		
		Content.TransferInfo.Employee = УПД970_ЗаполненныйEmployee(ДанныеСотрудника);
		
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область УПД970_КонтентПоДокументам

Функция УПД970_КонтентТитулаПродавцаПоРеализацииТоваровУслуг(
	Документ,
	ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеРеализацияТоваровУслуг(Документ);
	ФункцияДокумента = ФункцияДокумента_ДОП();
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТабличныеДанные = ДанныеДокумента.ТабличныеДанные;
	СведенияПрослеживаемости = ДанныеДокумента.СведенияПрослеживаемости;
	
	Валюта = ДанныеШапки.ВалютаДокумента;
	НуженПересчетВРубли = НуженПересчетВРубли(ДанныеШапки.РасчетыВУсловныхЕдиницах, Валюта);
	ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;

	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента;
	Результат.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияУПД(ДанныеШапки.ВидДоговора);
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	Результат.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
	
	УПД970_ЗаполнитьКодВалюты(Результат, Валюта, НуженПересчетВРубли);
	
	Table = Результат.Table;

	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		Item = Контракт_Item970();
		
		Item.Product = СокрЛП(СтрокаТаблицы.НоменклатураНаименование);
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатуры(СтрокаТаблицы.ЭтоУслуга);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения)
			И ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			
			УПД970_ЗаполнитьЕдиницуИзмерения(
				Item,
				СтрокаТаблицы.ЕдиницаИзмеренияНаименование,
				СтрокаТаблицы.ЕдиницаИзмеренияКод);
			
		КонецЕсли;
		
		УПД970_ЗаполнитьЧисловыеДанныеИСтавкуНДСпоСтроке(
			Item,
			СтрокаТаблицы,
			НуженПересчетВРубли,
			ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
			ДополнительныеПараметры.ТочностьКоличества,
			ДополнительныеПараметры.ТочностьЦены,
			ЦенаВключаетНДС);

		Если СтрокаТаблицы.ПодакцизныйТовар Тогда
			Item.Excise = СтрокаТаблицы.СуммаАкциза;
		КонецЕсли;

		УПД970_ЗаполнитьCustomDeclaration(Item, СтрокаТаблицы.НомерГТД, СтрокаТаблицы.СтранаПроисхожденияКод);
		УПД970_ЗаполнитьItemTracingInfos(Item, СтрокаТаблицы, СведенияПрослеживаемости, НуженПересчетВРубли);
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	УПД970_ЗаполнитьИтоговыеЗначенияПоТаблице(Table);
	
	УПД970_ЗаполнитьСведенияОПродавце(Результат, ДанныеШапки);
	УПД970_ЗаполнитьСведенияОПокупателе(Результат, ДанныеШапки);
	
	ЕстьТовары = Не УПД970_СодержитТолькоУслуги(ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		УПД970_ЗаполнитьСведенияОГрузоотправителе(Результат, ДанныеШапки);
		
		СведенияОАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
			ДанныеШапки.АдресДоставки,
			ДанныеШапки.АдресДоставкиЗначение);
		
		УПД970_ЗаполнитьСведенияОГрузополучателе(Результат, ДанныеШапки, СведенияОАдресеДоставки);
		
	КонецЕсли;
	
	ДокументыОтгрузки = ЗначениеВМассивЛок(Документ);
	Результат.DocumentName = УПД790_НаименованиеДокументаОтгрузки(Table.Items, ДокументыОтгрузки, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОДокументеОтгрузки(Результат);
	
	TransferInfo = Результат.TransferInfo;
	
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferDate = УПД970_ОпределитьДатаОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	TransferInfo.TransferTextInfo = ДанныеШапки.СведенияОТранспортировке;
	
	Если ЕстьТовары Тогда
		УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры);
	КонецЕсли;
	
	УПД970_ЗаполнитьСведенияОбОснованииОтгрузки(TransferInfo, ДанныеШапки, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьСоставителяДокументаПоПродавцу(Результат);

	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Результат);
	
	УПД970_ЗаполнитьСведенияОМаркировке(Результат, Документ);
	
	Возврат Результат;

КонецФункции

