Функция УПД970_ИсходныеДанныеРеализацияТоваровУслуг(Документ)

	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиРеализацияТоваровУслуг();
	ТекстЗапросаТабличныеДанные = УПД970_ТекстЗапросаТабличныеДанныеРеализацияТоваровУслуг();
	ТекстЗапросаПрослеживаемость = УПД970_ТекстЗапросаСведенийПрослеживаемостиРеализацияТоваровУслуг();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныеДанные);
	ТекстыЗапросов.Добавить(ТекстЗапросаПрослеживаемость);
	
	РезультатЗапроса = УПД970_РезультатЗапросаИсходныхДанныхДокумента(Документ, ТекстыЗапросов);
	
	ТаблицаДанныеШапки = РезультатЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаДанныеШапки[0]);
	
	ТабличныеДанные = РезультатЗапроса[4].Выгрузить();
	СведенияПрослеживаемости = РезультатЗапроса[5].Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат Результат;
	
КонецФункции

