	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧПоставщики.Поставщик КАК Поставщик
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ТЧПоставщики
	|ГДЕ
	|	ТЧПоставщики.Ссылка = &ОтчетКомитенту
	|	И ТЧПоставщики.СчетФактура = &СчетФактура";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	Запрос.УстановитьПараметр("ОтчетКомитенту", ОтчетКомитенту);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Поставщик) Тогда
			Результат.Добавить(Выборка.Поставщик);
		КонецЕсли;
	КонецЦикла;
	
