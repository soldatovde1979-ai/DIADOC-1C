Функция УПД970_ЗаполненныйItemTracingInfo(СтрокаТаблицы, СведенияОПрослеживаемости, НуженПересчетВРубли)
	
	Результат = Контракт_ItemTracingInfo970();
	
	Результат.RegNumberUnit = СокрЛП(СведенияОПрослеживаемости.НомерТовара);
	Результат.Unit = СведенияОПрослеживаемости.ЕдиницаИзмеренияКод;
	Результат.UnitName = СведенияОПрослеживаемости.ЕдиницаИзмеренияНаименование;
	Результат.Quantity = СведенияОПрослеживаемости.Количество;
	
	СтоимостьБезНалога = 0;
	
	КурсПоСтроке = 1;
	Если НуженПересчетВРубли Тогда
		КурсПоСтроке = СтрокаТаблицы.СуммаБезНДСРуб / ?(СтрокаТаблицы.СуммаБезНДС = 0, 1, СтрокаТаблицы.СуммаБезНДС);
	КонецЕсли;
	
	СтруктураСтоимости = Новый Структура;
	СтруктураСтоимости.Вставить("СтоимостьБезНалога");
	СтруктураСтоимости.Вставить("Стоимость");
	
	ЗаполнитьЗначенияСвойств(СтруктураСтоимости, СведенияОПрослеживаемости);
	ЗаполнитьЗначенияСвойств(СтруктураСтоимости, СтрокаТаблицы);
	
	Если ЗначениеЗаполнено(СтруктураСтоимости.СтоимостьБезНалога) Тогда
		СтоимостьБезНалога = Окр(СтруктураСтоимости.СтоимостьБезНалога * КурсПоСтроке, 2);
	ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.Количество) 
		И ЗначениеЗаполнено(СтруктураСтоимости.Стоимость) Тогда
		СтоимостьБезНалога = Окр((СтруктураСтоимости.Стоимость / СтрокаТаблицы.Количество * СведенияОПрослеживаемости.Количество) * КурсПоСтроке, 2);
	КонецЕсли;
	
	Результат.SumWithoutVat = СтоимостьБезНалога;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьExtendedOrganizationInfo(Content, ДанныеУчастникаЭДО)
	
