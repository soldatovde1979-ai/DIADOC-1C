Функция УПД970_ТекстЗапросаСведенийПрослеживаемостиПоДокументу(ИмяДокумента)
	
	Результат =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Таблица.РНПТ.Код КАК НомерТовара,
	|	Таблица.КоличествоПрослеживаемости КАК Количество,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТаблицаДокумента.ПрослеживаемыйКомплект, ЛОЖЬ)
	|				ИЛИ Таблица.СтранаПроисхождения = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТаблицаДокумента.СтранаПроисхождения.Код, """")
	|		ИНАЧЕ Таблица.СтранаПроисхождения.Код
	|	КОНЕЦ КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения.Наименование, ""шт"") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения.Код, ""796"") КАК ЕдиницаИзмеренияКод,
	|	ВЫБОР
	|		КОГДА Таблица.Сумма = 0
	|			ТОГДА Таблица.Количество * ВЫБОР
	|					КОГДА Документ.СуммаВключаетНДС
	|							И ТаблицаДокумента.Количество <> 0
	|						ТОГДА (ТаблицаДокумента.Сумма - ТаблицаДокумента.СуммаНДС) / ТаблицаДокумента.Количество
	|					КОГДА Документ.СуммаВключаетНДС
	|							И ТаблицаДокумента.Количество = 0
	|						ТОГДА ТаблицаДокумента.Сумма - ТаблицаДокумента.СуммаНДС
	|					ИНАЧЕ ТаблицаДокумента.Цена
	|				КОНЕЦ
	|		ИНАЧЕ Таблица.Сумма
	|	КОНЕЦ КАК СтоимостьБезНалога
	|ИЗ
	|	Документ.%1.СведенияПрослеживаемости КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДокумента КАК ТаблицаДокумента
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|			ПО ТаблицаДокумента.НоменклатураКодТНВЭД = КлассификаторТНВЭД.Ссылка
	|		ПО (ТаблицаДокумента.ИдентификаторСтроки = Таблица.ИдентификаторСтроки)
	|			И Таблица.Ссылка = ТаблицаДокумента.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.%1 КАК Документ
	|		ПО Таблица.Ссылка = Документ.Ссылка";
	
	Результат = СтрШаблон(Результат, ИмяДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаРублевыхСуммДокументовВВалюте()

	Результат =
	"ВЫБРАТЬ
	|	РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента КАК ТабличнаяЧастьДокумента,
	|	РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего КАК Всего,
	|	РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС КАК НДС,
	|	РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС КАК НалоговаяБазаНДС
	|ПОМЕСТИТЬ РегистрСведенийРублевыеСуммыДокументовВВалюте
	|ИЗ
	|	РегистрСведений.РублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|ГДЕ
	|	РегистрСведенийРублевыеСуммыДокументовВВалюте.Регистратор = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСтрокиДокумента,
	|	ТабличнаяЧастьДокумента";

	Возврат Результат;
	
