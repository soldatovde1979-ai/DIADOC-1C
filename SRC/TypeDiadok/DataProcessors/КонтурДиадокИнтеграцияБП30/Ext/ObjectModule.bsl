// Процедура - При получении оснований документа учета
//
// Параметры:
//  КоллекцияОснований	 - Массив - Коллекция для заполнения документами основания
//  ДокументУчета		 - ДокументСсылка - Ссылка на документ учета по которому выбираются документы основания
//
Процедура ПриПолученииОснованийДокументаУчета(КоллекцияОснований, ДокументУчета) Экспорт
	
	Если НЕ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	КоллекцияОснований = ДокументыОснованияСчетаФактуры(ДокументУчета);
	
КонецПроцедуры

// Возвращает виды документов из текущей конфигурации для поиска в модуле
// 
// Возвращаемое значение:
//  Массив - Предопределенные виды документов конфигурации для поиска в модуле
//
Функция ВидыПредопределенныхДокументовДляПоискаВМодуле() Экспорт
	
	ДокументыКонфигурации = Метаданные.Документы;
	
	Результат = Новый Массив;
	Результат.Добавить(ДокументыКонфигурации.АктСверкиВзаиморасчетов);
	Результат.Добавить(ДокументыКонфигурации.ПередачаОС);
	Результат.Добавить(ДокументыКонфигурации.СчетФактураВыданный);
	Результат.Добавить(ДокументыКонфигурации.КорректировкаРеализации);
	Результат.Добавить(ДокументыКонфигурации.АктОбОказанииПроизводственныхУслуг);
	Результат.Добавить(ДокументыКонфигурации.ОказаниеУслуг);
	Результат.Добавить(ДокументыКонфигурации.ВозвратТоваровОтПокупателя);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомиссионераОПродажах);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомитентуОПродажах);
	Результат.Добавить(ДокументыКонфигурации.РеализацияУслугПоПереработке);
	Результат.Добавить(ДокументыКонфигурации.РеализацияТоваровУслуг);
	Результат.Добавить(ДокументыКонфигурации.ВозвратТоваровПоставщику);
	Результат.Добавить(ДокументыКонфигурации.РеализацияОтгруженныхТоваров);
	Результат.Добавить(ДокументыКонфигурации.СчетНаОплатуПокупателю);
	
	Если ЭтоАрендаИУправлениеНедвижимостью() Тогда
		Результат.Добавить(ДокументыКонфигурации.АР_СчетНаАренду);
		Результат.Добавить(ДокументыКонфигурации.АР_НачислениеАренднойПлаты);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает прикладное значение ставки НДС по его строковому представлению
//
// Параметры:
//  ПредставлениеСтавки - Строка - Представление ставки НДС
// 
// Возвращаемое значение:
//  ПеречислениеСсылка - Прикладное значение ставки НДС
//
Функция ЗначениеСтавкиНДС(ПредставлениеСтавки) Экспорт
	
	ЗначениеНДС = Неопределено;
	
	Если ПредставлениеСтавки = Неопределено
		ИЛИ СтрНайти("БЕЗ НДС", ВРег(ПредставлениеСтавки)) > 0 Тогда
		
		ЗначениеНДС = ПредставлениеСтавкиБезНДС();
		
	Иначе
		
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, "%", "");
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, " ", "");
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, "\", "/");
		
		Если СтрНайти("0", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "0";
		ИначеЕсли СтрНайти("5", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "5";
		ИначеЕсли СтрНайти("7", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "7";
		ИначеЕсли СтрНайти("10", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "10";
		ИначеЕсли СтрНайти("18", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "18";
		ИначеЕсли СтрНайти("20", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "20";
		ИначеЕсли СтрНайти("22", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "22";
		ИначеЕсли СтрНайти("10/110", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "10/110";
		ИначеЕсли СтрНайти("18/118", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "18/118";
		ИначеЕсли СтрНайти("20/120", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "20/120";
		ИначеЕсли СтрНайти("22/122", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "22/122";
		Иначе
			ЗначениеНДС = ПредставлениеСтавки;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = СтавкаНДСИзСоответствия(ЗначениеНДС);
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое представление ставки НДС по прикладному значению
//
// Параметры:
//  ЗначениеСтавки - ПеречислениеСсылка - Прикладное значение ставки НДС
//  НДСИсчисляетсяНалоговымАгентом - Булево - Истина, если НДС исчисляется налоговым агентом
// 
// Возвращаемое значение:
//  Строка - Строковое представление ставки НДС для электронного документа
//
Функция ПредставлениеСтавкиНДС(ЗначениеСтавки, НДСИсчисляетсяНалоговымАгентом = Ложь) Экспорт
	
	Если НДСИсчисляетсяНалоговымАгентом Тогда
		
		Результат = СтавкаНДСИсчисляетсяНалоговымАгентом();
		
	Иначе
		
		Результат = СтавкаНДСИзСоответствия(, ЗначениеСтавки);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = "##";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтавкаНДСИзСоответствия(ПредставлениеБЭД = "", ПрикладноеЗначение = Неопределено)
	
	Результат = Неопределено;
	
	ПеречислениеСтавокНДС = ЗаполнитьСоответствиеСтавокНДС();
	
	Если ЗначениеЗаполнено(ПредставлениеБЭД) Тогда
		
		Результат = ПеречислениеСтавокНДС.Получить(ПредставлениеБЭД);
		
	Иначе
		
		Для Каждого КлючИЗначение Из ПеречислениеСтавокНДС Цикл
			
			Если КлючИЗначение.Значение = ПрикладноеЗначение Тогда
				
				Результат = КлючИЗначение.Ключ;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьСоответствиеСтавокНДС()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	Результат.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	Результат.Вставить("18", Перечисления.СтавкиНДС.НДС18);
	Результат.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	Результат.Вставить("10/110", Перечисления.СтавкиНДС.НДС10_110);
	Результат.Вставить("18/118", Перечисления.СтавкиНДС.НДС18_118);
	Результат.Вставить("20/120", Перечисления.СтавкиНДС.НДС20_120);
	Результат.Вставить(ПредставлениеСтавкиБезНДС(), Перечисления.СтавкиНДС.БезНДС);
	Результат.Вставить(СтавкаНДСИсчисляетсяНалоговымАгентом(), СтавкаНДСИсчисляетсяНалоговымАгентомПредставление());
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		Результат.Вставить("5", Перечисления.СтавкиНДС.НДС5);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		Результат.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		Результат.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		Результат.Вставить("5/105", Перечисления.СтавкиНДС.НДС5_105);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		Результат.Вставить("7/107", Перечисления.СтавкиНДС.НДС7_107);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		Результат.Вставить("22/122", Перечисления.СтавкиНДС.НДС22_122);
	КонецЕсли;
	
	Результат.Вставить(Перечисления.СтавкиНДС.НДС0, "0");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10, "10");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18, "18");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20, "20");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10_110, "10/110");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18_118, "18/118");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20_120, "20/120");
	Результат.Вставить(Перечисления.СтавкиНДС.БезНДС, ПредставлениеСтавкиБезНДС());
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС5, "5");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС7, "7");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС22, "22");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС5_105, "5/105");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС7_107, "7/107");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС22_122, "22/122");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СуществуетЗначениеПеречисленияСтавкиНДС(ИмяЗначенияСтавкаНДС)
	
	ЗначенияПеречисления = Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления;
	Результат = (ЗначенияПеречисления.Найти(ИмяЗначенияСтавкаНДС) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ВнутренниеПеремещения_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы, ДокументОтгрузки)
	
	Результат = Контракт_СлужебнаяИнформацияСтроки();
	
	ЗаполнитьЗначенияСвойств(Результат, СтрокаТаблицы);
	
	Результат.Упаковка = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Упаковка");
	Результат.ЕдиницаИзмерения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "ЕдиницаИзмерения");
	Результат.Номенклатура = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Номенклатура");
	Результат.Характеристика = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Характеристика");
	Результат.Серия = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Серия");
	Результат.СтранаПроисхождения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтранаПроисхождения");
	Результат.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавкиБезНДС());
	
	Если Не ЗначениеЗаполнено(Результат.ПрослеживаемыйТовар) Тогда
		Результат.ПрослеживаемыйТовар = Ложь;
	КонецЕсли;
	
	Результат.ДокументОтгрузки = ДокументОтгрузки;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяТабЧастьДокументыОбОтгрузкеДляСФ()
	
	ВерсияОпределена = Истина;
	
	Попытка
		ВерсияБП = ВерсияБухгалтерскойПодсистемы();
	Исключение
		ВерсияОпределена = Ложь;
	КонецПопытки;
	
	Результат = Ложь;
	
	Если ВерсияОпределена Тогда
		Результат = (СравнитьВерсии_(ВерсияБП, "3.0.100.16") >= 0);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьCustomDeclaration(Item, НомерГТД, КодСтраныПроисхождения)
	
	Если Не ЗначениеЗаполнено(НомерГТД)
		Или Не ЗначениеЗаполнено(КодСтраныПроисхождения) Тогда
		Возврат;
	КонецЕсли;
	
	CustomDeclaration = Контракт_CustomDeclarations();
	CustomDeclaration.CountryCode = КодСтраныПроисхождения;
	CustomDeclaration.DeclarationNumber = СокрЛП(НомерГТД);
	
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

// Получает реквизиты юридического или физического лица для формата 970@
//
// Параметры:
//  ЮрФизЛицо - СправочникСсылка.Организации, СправочникСсылка.Контрагенты, СправочникСсылка.ПодразделенияОрганизаций - юридическое или физическое лицо
//  ДатаСведений - Дата - дата, на которую нужно получить значения периодических реквизитов
//  БанковскийСчет - СправочникСсылка.БанковскиеСчета - (необязательный) банковский счет юридического или физического лица.
//                                                      Если не передан, будут включены реквизиты основного банковского счета.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - содержит поля:
//    * ТипЮрФизЛица - Строка - тип юридического или физического лица (см. ГенерацияXML_Перечисление_ВидыЮрФизЛиц)
//    * НаименованиеПолное - Строка - наименование для печатных форм (для ОП - наименование головного юр. лица)
//    * НаименованиеПодразделения - Строка - наименование обособленного подразделения (если не ОП, совпадает с наименованием юр./физ. лица)
//    * НалоговыйНомерВСтранеРегистрации - Строка - налоговый номер в стране регистрации
//    * ИНН - Строка - ИНН юридического или физического лица
//    * КПП - Строка - КПП юридического лица
//    * КодПоОКПО - Строка - Код по ОКПО
//    * ОГРН - Строка - ОГРН, ОГРНИП или рег. номер для иностранных контрагентов
//    * ДатаРегистрации - Дата - дата государственной регистрации
//    * Свидетельство - Строка - реквизиты свидетельства о государственной регистрации ИП
//    * СтранаРегистрацииКод - Строка - код страны регистрации
//    * СтранаРегистрацииНаименование - Строка - наименование страны регистрации
//    * БИК - Строка - банковский идентификационный код
//    * Банк - Строка - наименование банка
//    * КоррСчет - Строка - корреспондентский счет банка
//    * НомерСчета - Строка - номер банковского счета юридического или физического лица
//    * Телефоны - Строка - номера телефонов юридического или физического лица
//    * Email - Строка - адрес электронной почты юридического или физического лица
//    * ЮридическийАдрес - Строка - юридический адрес
//    * ЮридическийАдресJSON - Строка - JSON со значениями полей юридического адреса
//    * ФактическийАдрес - Строка - фактический адрес
//    * ФактическийАдресJSON - Строка - JSON со значениями полей фактического адреса
//
Функция УПД970_ДанныеЮрФизЛица(ЮрФизЛицо, ДатаСведений, Знач БанковскийСчет = Неопределено)
	
	МодульОбменСКонтрагентамиБП = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиБП");
	Данные = МодульОбменСКонтрагентамиБП.ПолучитьДанныеЮрФизЛица(ЮрФизЛицо, ДатаСведений, БанковскийСчет);
	
	Если Не Данные.Свойство("ЭтоИндивидуальныйПредприниматель") Тогда
		// Совместимость с БП 3.0.142 и ниже
		Данные.Вставить("ЭтоИндивидуальныйПредприниматель", Ложь);
		Если Данные.ТипЮрФизЛица = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			Данные.ЭтоИндивидуальныйПредприниматель = ЭтоИндивидуальныйПредприниматель(ЮрФизЛицо);
		КонецЕсли;
	КонецЕсли;
	
	Модель = Новый Структура;
	Модель.Вставить("ТипЮрФизЛица", "");
	Модель.Вставить("НаименованиеПолное", "");
	Модель.Вставить("НаименованиеПодразделения", "");
	Модель.Вставить("ИНН", "");
	Модель.Вставить("КПП", "");
	Модель.Вставить("КодПоОКПО", "");
	Модель.Вставить("ОГРН", "");
	Модель.Вставить("ДатаРегистрации", Дата(1, 1, 1));
	Модель.Вставить("Свидетельство", "");
	Модель.Вставить("СтранаРегистрацииКод", "");
	Модель.Вставить("СтранаРегистрацииНаименование", "");
	Модель.Вставить("НалоговыйНомерВСтранеРегистрации", "");
	Модель.Вставить("ИныеСведения", "");
	
	Модель.Вставить("НомерСчета", "");
	Модель.Вставить("БИК", "");
	Модель.Вставить("Банк", "");
	Модель.Вставить("КоррСчет", "");
	
	Модель.Вставить("Телефоны", "");
	Модель.Вставить("Email", "");
	
	Модель.Вставить("ЮридическийАдрес", "");
	Модель.Вставить("ЮридическийАдресJSON", "");
	Модель.Вставить("ФактическийАдрес", "");
	Модель.Вставить("ФактическийАдресJSON", "");
	
	ЭтоРоссийскоеЮрФизЛицо = (Данные.СтранаРегистрации = Справочники.СтраныМира.Россия);
	ЭтоЮридическоеЛицо = (Данные.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	ВидыЮрФизЛицПрото = ГенерацияXML_Перечисление_ВидыЮрФизЛиц();
	
	Если ЭтоРоссийскоеЮрФизЛицо Тогда
		
		Если ЭтоЮридическоеЛицо Тогда
			ТипЮрФизЛица = ВидыЮрФизЛицПрото.ЮридическоеЛицо;
		ИначеЕсли Данные.ЭтоИндивидуальныйПредприниматель Тогда
			ТипЮрФизЛица = ВидыЮрФизЛицПрото.ИндивидуальныйПредприниматель;
		Иначе
			ТипЮрФизЛица = ВидыЮрФизЛицПрото.ФизическоеЛицо;
		КонецЕсли;
		
	Иначе
		
		Если ЭтоЮридическоеЛицо Тогда
			ТипЮрФизЛица = ВидыЮрФизЛицПрото.ИностраннаяОрганизация;
		Иначе
			ТипЮрФизЛица = ВидыЮрФизЛицПрото.ИностранныйГражданин;
		КонецЕсли;
		
		Модель.ИныеСведения = СокрЛП(Данные.ОГРН);
		
	КонецЕсли;
	
	Если Данные.ЭтоИндивидуальныйПредприниматель
		И ЗначениеЗаполнено(Данные.ИндивидуальныйПредприниматель) Тогда
		НаименованиеПолное = Данные.ФИОФизЛица;
	Иначе
		НаименованиеПолное = Данные.НаименованиеДляПечатныхФорм;
	КонецЕсли;
	
	Модель.ТипЮрФизЛица = ТипЮрФизЛица;
	Модель.НаименованиеПолное = СокрЛП(НаименованиеПолное);
	Модель.НаименованиеПодразделения = СокрЛП(Данные.ПолноеНаименование);
	Модель.ИНН = СокрЛП(Данные.ИНН);
	Модель.КПП = СокрЛП(Данные.КПП);
	Модель.ОГРН = СокрЛП(Данные.ОГРН);
	Модель.КодПоОКПО = СокрЛП(Данные.КодПоОКПО);
	Модель.ДатаРегистрации = Данные.ДатаРегистрации;
	Модель.Свидетельство = СокрЛП(Данные.Свидетельство);
	
	Модель.НалоговыйНомерВСтранеРегистрации = СокрЛП(Данные.НалоговыйНомерВСтранеРегистрации);
	Если ЗначениеЗаполнено(Данные.СтранаРегистрации) Тогда
		РеквизитыСтраны = ЗначенияРеквизитовОбъектаЛок(Данные.СтранаРегистрации, "Код, Наименование");
		Модель.СтранаРегистрацииКод = РеквизитыСтраны.Код;
		Модель.СтранаРегистрацииНаименование = РеквизитыСтраны.Наименование;
	КонецЕсли;
	
	Модель.БИК = СокрЛП(Данные.БИК);
	Модель.Банк = СокрЛП(Данные.Банк);
	Модель.КоррСчет = СокрЛП(Данные.КоррСчет);
	Модель.НомерСчета = СокрЛП(Данные.НомерСчета);
	
	Модель.Телефоны = СокрЛП(Данные.Телефоны);
	Модель.Email = СокрЛП(Данные.Email);
	
	Модель.ЮридическийАдрес = СокрЛП(Данные.ЮридическийАдрес);
	Модель.ЮридическийАдресJSON = Данные.ЗначениеJSONЮридическийАдрес;
	Модель.ФактическийАдрес = СокрЛП(Данные.ФактическийАдрес);
	Модель.ФактическийАдресJSON = Данные.ЗначениеJSONФактическийАдрес;
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

