Функция ЭтоВидСчетаФактурыНаАванс(ВидСчетаФактуры)
	
	Результат = (ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАванс
		ИЛИ ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАвансКомитента
		ИЛИ ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАвансКомитентаНаЗакупку);
		
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактураСоставленныйАгентом(СсылкаНаОбъект)
	
	Если Не ЭтоСчетФактураВыданный(СсылкаНаОбъект) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("ДокументОснование");
	ТребуемыеРеквизиты.Вставить("ВидДоговора", "ДоговорКонтрагента.ВидДоговора");
	// Реквизит заполняется в СФ по отчетам комитенту при выключенном флаге СчетаФактурыОтИмениОрганизации
	ТребуемыеРеквизиты.Вставить("СоставленОтИмени", "Продавец");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, ТребуемыеРеквизиты);
	
	Результат = Ложь;
	
	Если ТипЗнч(ЗначенияРеквизитов.ДокументОснование) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		ЭтоДоговорНаЗакупку = (ЗначенияРеквизитов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку);
		СоставленОтИмениПродавца = ЗначениеЗаполнено(ЗначенияРеквизитов.СоставленОтИмени);
		Результат = (ЭтоДоговорНаЗакупку И СоставленОтИмениПродавца);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактураОтНесколькихПродавцов(СчетФактура)
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("СводныйКомиссионный");
	ТребуемыеРеквизиты.Вставить("ОтИмениОрганизации", "ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛок(СчетФактура, ТребуемыеРеквизиты);
	
	Результат = Ложь;
	Если ЗначенияРеквизитов.СводныйКомиссионный Тогда
		Результат = Не ЗначенияРеквизитов.ОтИмениОрганизации;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

