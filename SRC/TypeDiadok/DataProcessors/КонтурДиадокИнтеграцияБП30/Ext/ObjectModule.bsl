	|	СУММА(ТабличнаяЧастьПоДаннымОрганизации.Кредит) КАК Кредит
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК ТабличнаяЧастьПоДаннымОрганизации
	|ГДЕ
	|	ТабличнаяЧастьПоДаннымОрганизации.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_АктСверки405ДетальныеДанные()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабличнаяЧастьПоДаннымОрганизации.НомерСтроки КАК НомерСтроки,
	|	ТабличнаяЧастьПоДаннымОрганизации.Договор КАК Договор,
	|	ТабличнаяЧастьПоДаннымОрганизации.Дата КАК ДатаОперации,
	|	ТабличнаяЧастьПоДаннымОрганизации.Дебет КАК СуммаДебет,
	|	ТабличнаяЧастьПоДаннымОрганизации.Кредит КАК СуммаКредит,
	|	ТабличнаяЧастьПоДаннымОрганизации.НомерДокумента КАК НомерДокумента,
	|	ТабличнаяЧастьПоДаннымОрганизации.ДатаДокумента КАК ДатаДокумента,
	|	ТабличнаяЧастьПоДаннымОрганизации.НаименованиеДокумента КАК НаименованиеДокумента,
	|	ТабличнаяЧастьПоДаннымОрганизации.НаименованиеОперации КАК НаименованиеОперации,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Номер, """") КАК НомерДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВидДоговора, ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ПустаяСсылка)) КАК ВидДоговора
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК ТабличнаяЧастьПоДаннымОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ТабличнаяЧастьПоДаннымОрганизации.Договор = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	ТабличнаяЧастьПоДаннымОрганизации.Ссылка = &Ссылка
	|ИТОГИ
	|	СУММА(СуммаДебет),
	|	СУММА(СуммаКредит),
	|	МАКСИМУМ(ДатаДоговора),
	|	МАКСИМУМ(НомерДоговора),
	|	МАКСИМУМ(ВидДоговора)
	|ПО
	|	Договор";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_АктСверки405ОстаткиПоДоговорам()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Хозрасчетный.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ СчетаРасчетов
	|ИЗ
	|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Ссылка В ИЕРАРХИИ(&СчетаРасчетов)
	|	И НЕ Хозрасчетный.Ссылка В (&СчетаИсключения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ХозрасчетныйОстатки.Субконто1 КАК Договор,
	|	ВЫБОР
	|		КОГДА &АктСверкиВВалюте
	|			ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстатокДт
	|		ИНАЧЕ ХозрасчетныйОстатки.СуммаОстатокДт
	|	КОНЕЦ КАК НачОстатокПоДоговоруДт,
	|	ВЫБОР
	|		КОГДА &АктСверкиВВалюте
	|			ТОГДА ХозрасчетныйОстатки.ВалютнаяСуммаОстатокКт
	|		ИНАЧЕ ХозрасчетныйОстатки.СуммаОстатокКт
	|	КОНЕЦ КАК НачОстатокПоДоговоруКт
	|ПОМЕСТИТЬ ОстаткиПоДоговорамАкта
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&НачалоПериода,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаРасчетов.Ссылка
	|				ИЗ
	|					СчетаРасчетов КАК СчетаРасчетов),
	|			&АналитикаРасчетов,
	|			Организация = &Организация
	|				И Субконто1 В (&Договоры)) КАК ХозрасчетныйОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиПоДоговорамАкта.Договор КАК Договор,
	|	СУММА(ОстаткиПоДоговорамАкта.НачОстатокПоДоговоруДт) КАК НачОстатокПоДоговоруДт,
	|	СУММА(ОстаткиПоДоговорамАкта.НачОстатокПоДоговоруКт) КАК НачОстатокПоДоговоруКт
	|ИЗ
	|	ОстаткиПоДоговорамАкта КАК ОстаткиПоДоговорамАкта
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиПоДоговорамАкта.Договор";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДанныеШапкиАктаСверкиВзаиморасчетов()
	
	Результат =
	"ВЫБРАТЬ
