Функция УПД970_ВыводитьКодыТНВЭД(Покупатель, Грузополучатель)
	
	КодСтраныПокупателя = "0";
	Если ЗначениеЗаполнено(Покупатель) Тогда
		КодСтраныПокупателя = ЗначениеРеквизитаОбъектаЛок(Покупатель.СтранаРегистрации, "Код");
	КонецЕсли;
	
	КодСтраныГрузополучателя = "0";
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		КодСтраныГрузополучателя = ЗначениеРеквизитаОбъектаЛок(Покупатель.СтранаРегистрации, "Код");
	КонецЕсли;
	
	ПокупательСтранаЕАЭС = СтранаЧленТС(КодСтраныПокупателя);
	ГрузополучательСтранаЕАЭС = СтранаЧленТС(КодСтраныГрузополучателя);
	
	// Обязательно указание значения в случае отражения в счете-фактуре товаров,
	// вывезенных за пределы территории Российской Федерации на территорию государства - члена ЕАЭС
	Результат = ((КодСтраныПокупателя <> "643")
		И (КодСтраныГрузополучателя <> "643")
		И ПокупательСтранаЕАЭС
		И ГрузополучательСтранаЕАЭС);
	
	Возврат Результат;
	
КонецФункции

