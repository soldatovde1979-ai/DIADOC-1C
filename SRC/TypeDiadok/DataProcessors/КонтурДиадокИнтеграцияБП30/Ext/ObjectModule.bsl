// Получает код валюты в соответствии с ОКВ
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта, код которой требуется определить
// 
// Возвращаемое значение:
//  Строка - код валюты по ОКВ
//
Функция КодВалютыПоКлассификатору(Валюта)
	
	РеквизитыВалюты = Новый Структура;
	РеквизитыВалюты.Вставить("Код");
	РеквизитыВалюты.Вставить("ЗагружаетсяИзИнтернета");
	РеквизитыВалюты.Вставить("ОсновнаяВалютаКод", "ОсновнаяВалюта.Код");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛок(Валюта, РеквизитыВалюты);
	
	Результат = СокрЛП(ЗначенияРеквизитов.Код);
	Если Не ЗначенияРеквизитов.ЗагружаетсяИзИнтернета
		И ЗначениеЗаполнено(ЗначенияРеквизитов.ОсновнаяВалютаКод) Тогда
		Результат = СокрЛП(ЗначенияРеквизитов.ОсновнаяВалютаКод);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

