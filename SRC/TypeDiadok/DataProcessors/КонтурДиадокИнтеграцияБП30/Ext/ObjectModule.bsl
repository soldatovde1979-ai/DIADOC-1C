// Возвращает массив ссылок на связанные документы учета 1С
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на документ учета 1С, для которого необходимо получить коллекую связанных с ним
// 
// Возвращаемое значение:
//  Массив - ссылки на связанные объекты
//
Функция СвязиДокументов_НайтиПоКритериюОтбора(Знач СсылкаНаОбъект, Знач ИсключаемыеТипы = Неопределено)
	
	Если Не Метаданные.КритерииОтбора.СвязанныеДокументы.Тип.СодержитТип(ТипЗнч(СсылкаНаОбъект)) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	УсловиеИсключитьТипы = "ИСТИНА";
	
	Если ЗначениеЗаполнено(ИсключаемыеТипы) Тогда
		УсловиеИсключитьТипы = "НЕ ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) В(&ИсключаемыеТипы)";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	|ГДЕ
	|	&УсловиеИсключитьТипы";
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&УсловиеИсключитьТипы",
		УсловиеИсключитьТипы
	);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИсключаемыеТипы", ИсключаемыеТипы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат Результат;
	
КонецФункции

