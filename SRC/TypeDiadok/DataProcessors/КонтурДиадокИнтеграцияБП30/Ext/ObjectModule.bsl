Функция УПД970_ИсходныеДанныеСчетФактурыВыданныйНаАванс(Документ)

	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиСчетФактурыВыданныйНаАванс();
	ТекстЗапросаТабличныеДанные = УПД970_ТекстЗапросаТабличныхДанныхСчетФактурыВыданныйНаАванс();
	ТекстЗапросаПлатежныеДокументы = УПД970_ТекстЗапросаПлатежныхДокументовСчетФактурыВыданный();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныеДанные);
	ТекстыЗапросов.Добавить(ТекстЗапросаПлатежныеДокументы);
	
	РезультатЗапроса = УПД970_РезультатЗапросаИсходныхДанныхДокумента(Документ, ТекстыЗапросов);
	
	ТаблицаДанныеШапки = РезультатЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаДанныеШапки[0]);
	
	ЦифровойИндексОбособленногоПодразделения = "";
	
	Если ЗначениеЗаполнено(Документ.ДокументОснование) Тогда 
		
		ОснованиеСчетаФактуры = Документ.ДокументОснование;
		ЕстьРеквизитПодразделениеОрганизации = ЕстьРеквизитОбъектаЛок(
			"ПодразделениеОрганизации",
			ОснованиеСчетаФактуры.Метаданные()
		);
		
		Если ЕстьРеквизитПодразделениеОрганизации Тогда
			ЦифровойИндексОбособленногоПодразделения = ЗначениеРеквизитаОбъектаЛок(
				ОснованиеСчетаФактуры,
				"ПодразделениеОрганизации.ЦифровойИндексОбособленногоПодразделения"
			);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦифровойИндексОбособленногоПодразделения) Тогда
		ДанныеШапки.ЦифровойИндексОбособленногоПодразделения = ЦифровойИндексОбособленногоПодразделения;
	КонецЕсли;
	
	ТабличныеДанные = РезультатЗапроса[1].Выгрузить();
	ПлатежныеДокументы = РезультатЗапроса[2].Выгрузить();

	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("ПлатежноРасчетныеДокументы", ПлатежныеДокументы);
	
	Возврат Результат;
	
КонецФункции

