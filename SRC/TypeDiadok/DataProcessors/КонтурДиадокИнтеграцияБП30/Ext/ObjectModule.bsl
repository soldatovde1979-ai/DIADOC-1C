// Типовой обработчик события "ПодготовитьДанныеДляОтправкиВнутреннихДокументов"
//
// Параметры:
//  ВидПакетаID - Строка - идентификатор вида пакета
//  Запрос - Запрос - инициализированный запрос (с параметрами и менеджером временных таблиц)
// 
// Возвращаемое значение:
//  Массив из Строка - имена добавленных временных таблиц
//
Функция ВнутренниеДокументыСлужебный_ПодготовитьДанныеДляОтправки(ВидПакетаID, Запрос) Экспорт
	
	Результат = Новый Массив;
	
	Если ВидПакетаID <> "ID_УПД_ВНУТР" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ПеремещениеТоваров) Тогда
		ИмяВТ = ДобавитьТаблицу_ПеремещениеТоваров(Запрос);
		Результат.Добавить(ИмяВТ);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Вызывается из МодульМенеджер.ЗначенияПолейМаршрутизацииПоПодразделениям.
// Переопределяет получение значений полей маршрутизации по документу 1С
//
// Параметры:
//	ПоляОтправителя		- Массив 			- значения полей маршрутизации в подразделение отправителя
//	ПоляПолучателя		- Массив 			- значения полей маршрутизации в подразделение получателя
//	Документ1С			- ДокументСсылка 	- документ пакета, для которого определяются значения полей
Процедура ЗаполнитьЗначенияПолейМаршрутизацииПоПодразделениям(ПоляОтправителя, ПоляПолучателя, Документ1С) Экспорт
	
	ТипСсылки = ТипЗнч(Документ1С);
	
	ЭтоСчетФактураВыданный = (ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный"));
	
	Если ЭтоСчетФактураВыданный Тогда
		
		ДокОснованиеСФ = ДокументыОснованияСчетаФактуры(Документ1С);
		
		Если НЕ ЗначениеЗаполнено(ДокОснованиеСФ) Тогда
			Возврат;
		КонецЕсли;
		
		ИсточникДанных = ДокОснованиеСФ[0];
		
	Иначе
		
		ИсточникДанных = Документ1С;
		
	КонецЕсли;
	
	МетаданныеИсточникаДанных = ИсточникДанных.Метаданные();
	
	ЕстьРеквизитПодразделение = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "ПодразделениеОрганизации");
	ЕстьРеквизитОрганизация = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "Организация");
	ЕстьРеквизитКонтрагент = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "Контрагент");
	ЕстьРеквизитДоговорКонтрагента = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "ДоговорКонтрагента");
	ЕстьРеквизитПодразделениеОтправитель = Ядро.Общее_ЕстьРеквизитМетаданных(
			МетаданныеИсточникаДанных, "ПодразделениеОтправитель");
	ЕстьРеквизитПодразделениеПолучатель = Ядро.Общее_ЕстьРеквизитМетаданных(
			МетаданныеИсточникаДанных, "ПодразделениеПолучатель");
	ЕстьРеквизитСкладОтправитель = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "СкладОтправитель");
	ЕстьРеквизитСкладПолучатель = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "СкладПолучатель");
	
	ИменаРеквизитов = Новый Массив;

	Если ЕстьРеквизитПодразделение Тогда
		ИменаРеквизитов.Добавить("ПодразделениеОрганизации");
	КонецЕсли;
	
	Если ЕстьРеквизитПодразделениеОтправитель Тогда
		ИменаРеквизитов.Добавить("ПодразделениеОтправитель");
	КонецЕсли;
	
	Если ЕстьРеквизитПодразделениеПолучатель Тогда
		ИменаРеквизитов.Добавить("ПодразделениеПолучатель");
	КонецЕсли;
	
	Если ЕстьРеквизитСкладОтправитель Тогда
		ИменаРеквизитов.Добавить("СкладОтправитель");
	КонецЕсли;
	
	Если ЕстьРеквизитСкладПолучатель Тогда
		ИменаРеквизитов.Добавить("СкладПолучатель");
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация Тогда
		ИменаРеквизитов.Добавить("Организация");
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент Тогда
		ИменаРеквизитов.Добавить("Контрагент");
	КонецЕсли;
	
	Если ЕстьРеквизитДоговорКонтрагента Тогда
		ИменаРеквизитов.Добавить("ДоговорКонтрагента");
	КонецЕсли;
	
	Разделитель = ",";
	ТребуемыеРеквизиты = Ядро.СоединитьСтроку(ИменаРеквизитов, Разделитель);
	
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		Реквизиты = Ядро.Общее_ЗначенияРеквизитовОбъекта(ИсточникДанных, ТребуемыеРеквизиты);
	КонецЕсли;
	
	// В коллекции ПоляОтправителя и ПоляПолучателя индекс элементов соответствует приоритету этих элементов.
	// Чем меньше индекс, тем выше приоритет.
	
	Если ЕстьРеквизитПодразделениеОтправитель И ЗначениеЗаполнено(Реквизиты.ПодразделениеОтправитель) Тогда
		ПоляОтправителя.Добавить(Реквизиты.ПодразделениеОтправитель);
	КонецЕсли;
	
	Если ЕстьРеквизитСкладОтправитель И ЗначениеЗаполнено(Реквизиты.СкладОтправитель) Тогда
		ПоляОтправителя.Добавить(Реквизиты.СкладОтправитель);
	КонецЕсли;
	
	Если ЕстьРеквизитПодразделение И ЗначениеЗаполнено(Реквизиты.ПодразделениеОрганизации) Тогда
		ПоляОтправителя.Добавить(Реквизиты.ПодразделениеОрганизации);
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация И ЗначениеЗаполнено(Реквизиты.Организация) Тогда
		ПоляОтправителя.Добавить(Реквизиты.Организация);
	КонецЕсли;
	
	Если ЕстьРеквизитПодразделениеПолучатель И ЗначениеЗаполнено(Реквизиты.ПодразделениеПолучатель) Тогда
		ПоляПолучателя.Добавить(Реквизиты.ПодразделениеПолучатель);
	КонецЕсли;
	
	Если ЕстьРеквизитСкладПолучатель И ЗначениеЗаполнено(Реквизиты.СкладПолучатель) Тогда
		ПоляПолучателя.Добавить(Реквизиты.СкладПолучатель);
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент И ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Контрагент);
	КонецЕсли;
	
	Если ЕстьРеквизитДоговорКонтрагента И ЗначениеЗаполнено(Реквизиты.ДоговорКонтрагента) Тогда
		ПоляПолучателя.Добавить(Реквизиты.ДоговорКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка.СчетФактураВыданный - Счет-фактура, основание которого требуется получить.
// 
// Возвращаемое значение:
//  ДокументСсылка - документ, на основании которого выписан счет-фактура.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Выборка = Ядро.Общее_ВыборкаДанныхОбъекта(СчетФактура, "ДокументыОснования", "ДокументОснование");
			
	Пока Выборка.Следующий() Цикл 
		
		ДокументОснование = Выборка.ДокументОснование;
		
		Если Результат.Найти(ДокументОснование) = Неопределено Тогда
			Результат.Добавить(ДокументОснование);
		КонецЕсли;
		
	КонецЦикла;
			
	Возврат Результат;
	
КонецФункции

// См. метод "ПередФормированиемПечатнойФормыСчетаНаОплату" в модуле "МенеджерИнтеграции"
