Функция УПД970_ИсходныеДанныеДокументаОснованияСчетФактураВыданный(СчетФактура, ДокументОснование)

	ТипДокумента = ТипЗнч(ДокументОснование);
	
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанныеРеализацияТоваровУслуг(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Результат = УПД970_ИсходныеДанныеКорректировкаРеализации(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанныеАктОбОказанииПроизводственныхУслуг(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПоПереработке") Тогда
		
		Результат = УПД970_ИсходныеДанныеРеализацииУслугПоПереработке(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОС") Тогда
		
		Результат = УПД970_ИсходныеДанныеПередачиОС(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		Результат = УПД970_ИсходныеДанныеОтчетаКомитентуОПродажах(СчетФактура, ДокументОснование);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			
		Результат = УПД970_ИсходныеДанныеВозвратаТоваровПоставщику(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах") Тогда
			
		Результат = УПД970_ИсходныеДанныеОтчетаКомиссионераОПродажах(СчетФактура, ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОказаниеУслуг") Тогда
			
		Результат = УПД970_ИсходныеДанныеОказанияУслуг(СчетФактура, ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров") Тогда
			
		Результат = УПД970_ИсходныеДанныеРеализацииОтгруженныхТоваров(ДокументОснование);
		
	ИначеЕсли Метаданные.Документы.Найти("АР_НачислениеАренднойПлаты") <> Неопределено
		И ТипДокумента = Тип("ДокументСсылка.АР_НачислениеАренднойПлаты") Тогда
		
		Результат = УПД970_ИсходныеДанныеНачисленияАренднойПлаты(ДокументОснование);
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаТоваров") Тогда
		
		Результат = УПД970_ИсходныеДанныеПередачаТоваров(ДокументОснование);
		
	Иначе
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не поддерживаются счета-фактуры с документами-основаниями %1'"),
			ДокументОснование.Метаданные().Синоним);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РезультатЗапросаИсходныхДанныхДокумента(Документ, ТекстыЗапросов)
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов",
		ДополнительнаяКолонкаПечатныхФормДокументов());

	Результат = Запрос.ВыполнитьПакет();

	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьДанныеПоКонтрагентамСводногоСчетаФактурыКомиссияПоЗакупке(ДанныеШапки, СчетФактура)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДанныеШапки.Ссылка);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ОтчетКомитентуОПродажахПоставщики.Поставщик.ОбособленноеПодразделение
	|				И ОтчетКомитентуОПродажахПоставщики.Поставщик.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА ОтчетКомитентуОПродажахПоставщики.Поставщик.ГоловнойКонтрагент
	|		ИНАЧЕ ОтчетКомитентуОПродажахПоставщики.Поставщик
	|	КОНЕЦ КАК Поставщик,
	|	ВЫБОР
	|		КОГДА ОтчетКомитентуОПродажахПоставщики.Поставщик.ОбособленноеПодразделение
	|				ИЛИ ЕСТЬNULL(ОтчетКомитентуОПродажахПоставщики.Партия.Грузоотправитель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				ИЛИ ЕСТЬNULL(ОтчетКомитентуОПродажахПоставщики.Партия.Грузоотправитель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ОтчетКомитентуОПродажахПоставщики.Поставщик
	|			ТОГДА ОтчетКомитентуОПродажахПоставщики.Поставщик
	|		ИНАЧЕ ОтчетКомитентуОПродажахПоставщики.Партия.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОтчетКомитентуОПродажахПоставщики.Партия.Грузополучатель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ОтчетКомитентуОПродажахПоставщики.Партия.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|		ИНАЧЕ ОтчетКомитентуОПродажахПоставщики.Партия.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ОтчетКомитентуОПродажахПоставщики
	|ГДЕ
	|	ОтчетКомитентуОПродажахПоставщики.Ссылка = &Ссылка
	|	И ОтчетКомитентуОПродажахПоставщики.СчетФактура = &СчетФактура
	|	И ОтчетКомитентуОПродажахПоставщики.Ссылка.ВыписыватьСчетаФактурыСводно";

	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеШапки.Вставить("Поставщик", Новый Массив);
	ДанныеШапки.Вставить("Грузоотправитель", Новый Массив);
	ДанныеШапки.Вставить("Грузополучатель", Новый Массив);

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Поставщик) Тогда
			ДанныеШапки.Поставщик.Добавить(Выборка.Поставщик);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Грузоотправитель) Тогда
			ДанныеШапки.Грузоотправитель.Добавить(Выборка.Грузоотправитель);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Грузополучатель) Тогда
			ДанныеШапки.Грузополучатель.Добавить(Выборка.Грузополучатель);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область УПД970_ЗаполнениеЭлементовПротоструктуры

Функция УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы)
	
	Результат = Контракт_СлужебнаяИнформацияСтроки();
	
	ЗаполнитьЗначенияСвойств(Результат, СтрокаТаблицы);
	
	Результат.Упаковка = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Упаковка");
	Результат.УпаковкаДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "УпаковкаДоИзменения");
	
	Результат.ЕдиницаИзмерения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "ЕдиницаИзмерения");
	Результат.ЕдиницаИзмеренияДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "ЕдиницаИзмеренияДоИзменения");
	
	Результат.Номенклатура = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Номенклатура");
	Результат.Характеристика = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Характеристика");
	Результат.Серия = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Серия");
	Результат.СтранаПроисхождения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтранаПроисхождения");
	Результат.СтавкаНДС = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтавкаНДС");
	Результат.СтавкаНДСДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтавкаНДСДоИзменения");
	Результат.ДокументОтгрузки = СтрокаТаблицы.Ссылка;
	
	Если Не ЗначениеЗаполнено(Результат.ПрослеживаемыйТовар) Тогда
		Результат.ПрослеживаемыйТовар = Ложь;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "ИдентификаторСтроки") Тогда
		Результат.ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "ИмяТабличнойЧасти") Тогда
		Результат.ПутьКИдентификаторуСтроки = СтрокаТаблицы.ИмяТабличнойЧасти;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

