Функция ЭтоСчетФактураПеревыставленный(СчетФактура)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Поставщики.Ссылка КАК Ссылка,
	|	Поставщики.КлючСтроки КАК КлючСтроки
	|ПОМЕСТИТЬ ВТ_КлючиСтрок
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК ОснованияСФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах.Поставщики КАК Поставщики
	|		ПО ОснованияСФ.ДокументОснование = Поставщики.Ссылка
	|ГДЕ
	|	ОснованияСФ.Ссылка = &Ссылка
	|	И Поставщики.СчетФактура = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыУслуги.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК ТоварыУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КлючиСтрок КАК ВТ_КлючиСтрок
	|		ПО ТоварыУслуги.Ссылка = ВТ_КлючиСтрок.Ссылка
	|			И ТоварыУслуги.КлючСтроки = ВТ_КлючиСтрок.КлючСтроки
	|ГДЕ
	|	НЕ ЕСТЬNULL(ТоварыУслуги.Номенклатура.Услуга, ИСТИНА)");
	
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция ПоставщикиИзОтчетаКомитенту(СчетФактура)
	
	ОтчетКомитенту = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФактура, "ДокументОснование");
	
