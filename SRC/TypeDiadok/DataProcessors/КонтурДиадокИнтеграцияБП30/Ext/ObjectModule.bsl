// См. метод "ЭтоДокументКонфигурацииСчетНаОплату" в модуле "МенеджерИнтеграции"
// Определяет является ли переданный документ ИБ счетом на оплату
//
// Параметры:
//	Документ1С - ДокументСсылка - учетный документ информационной базы
//
// Возвращаемое значение:
//	Булево - Истина, если это счет на оплату
Функция ЭтоДокументКонфигурацииСчетНаОплату(Документ1С) Экспорт
	
	СравниваемыеТипы = Новый Массив;
	
	СравниваемыеТипы.Добавить(Тип("ДокументСсылка.СчетНаОплатуПокупателю"));
	
	Если Метаданные.Документы.Найти("АР_СчетНаАренду") <> Неопределено Тогда
		СравниваемыеТипы.Добавить(Тип("ДокументСсылка.АР_СчетНаАренду"));
	КонецЕсли;
	
	Результат = СравниваемыеТипы.Найти(ТипЗнч(Документ1С)) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

