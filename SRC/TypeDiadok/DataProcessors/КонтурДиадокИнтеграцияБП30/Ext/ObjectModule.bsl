//   - ТаблицаЗначений
//
Функция НовыйКоллекцияПечатныхФормДляПечатиДокумента()
	
	КоллекцияПечатныхФорм = Новый ТаблицаЗначений;
	
	КоллекцияПечатныхФорм.Колонки.Добавить("ИмяМакета");
	КоллекцияПечатныхФорм.Колонки.Добавить("ИмяВРЕГ");
	КоллекцияПечатныхФорм.Колонки.Добавить("ТабличныйДокумент");
	КоллекцияПечатныхФорм.Колонки.Добавить("СинонимМакета");
	КоллекцияПечатныхФорм.Колонки.Добавить("Картинка");
	КоллекцияПечатныхФорм.Колонки.Добавить("ПолныйПутьКМакету");
	КоллекцияПечатныхФорм.Колонки.Добавить("ИмяФайлаПечатнойФормы");
	КоллекцияПечатныхФорм.Колонки.Добавить("Экземпляров");
	
	Возврат КоллекцияПечатныхФорм;
	
КонецФункции 

Процедура СчетаНаОплату_ЗаполнитьКоллекциюПечатныхФорм(КоллекцияПечатныхФорм)
	
	НовыйЭлементТаблицы = КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета 	= "СчетЗаказ";
	НовыйЭлементТаблицы.ИмяВРЕГ 	= ВРег(НовыйЭлементТаблицы.ИмяМакета);
	
КонецПроцедуры

Процедура АктыСверок_ЗаполнитьКоллекциюПечатныхФорм(КоллекцияПечатныхФорм)
	
	НовыйЭлементТаблицы = КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета = "АктСверки";
	НовыйЭлементТаблицы.ИмяВРЕГ = ВРег(НовыйЭлементТаблицы.ИмяМакета);
	НовыйЭлементТаблицы.Экземпляров = 1;

КонецПроцедуры

Функция СчетаНаОплату_ПечатнаяФорма1С(ДокСсылка) Экспорт
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(ДокСсылка);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	КоллекцияПечатныхФорм = НовыйКоллекцияПечатныхФормДляПечатиДокумента();
	
	СчетаНаОплату_ЗаполнитьКоллекциюПечатныхФорм(КоллекцияПечатныхФорм);
	
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Новый Структура;
	
	МенеджерПечати = Обработки.ПечатьСчетаНаОплату;
	
	МенеджерПечати.Печать(
		ДокументПечати,
		ПараметрыПечати,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода
	);
	
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			
			ТабличныйДокумент = Стр.ТабличныйДокумент;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;

	Возврат ТабличныйДокумент;
	
КонецФункции

// Заполняет модель данных электронного счета на оплату.
//
// Параметры:
//	Шапка - Контракт шапки неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - Контракт табличной части неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату() 
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанные(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета) Экспорт
	
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета)
		Или ЭтоСчетНаАренду(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоСчетуНаОплату(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоДокументуПродажи(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ОснованиеЭлектронногоСчета));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет модель данных электронного счета на оплату на основании счета.
//
// Параметры:
//	Шапка - Контракт шапки неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - Контракт табличной части неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату()
//  Счет - ДокументСсылка.СчетНаОплатуПокупателю, ДокументСсылка.АР_СчетНаАренду - основание электронного счета
// 
Процедура СчетаНаОплату_ЗаполнитьДанныеПоСчетуНаОплату(Шапка, ТабличнаяЧасть, Счет)
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Счет);
	
	МенеджерОбъекта = Документы.СчетНаОплатуПокупателю;
	Если ЭтоСчетНаАренду(Счет) Тогда
		МенеджерОбъекта = Документы.АР_СчетНаАренду;
	КонецЕсли;
	
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьТаблицуСведенийСчетаНаОплату(МассивОбъектов);
	
	ДанныеШапки = СтруктураДанныхДляПечати[0];
	
	НомерДокумента = ДанныеШапки.НомерДокумента;
	ДатаДокумента = ДанныеШапки.ДатаДокумента;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Покупатель, ДатаДокумента);
	СведенияОПолучателе = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Получатель, ДатаДокумента);
	
	Шапка.Номер = НомерДокумента;
	Шапка.Дата = ДатаДокумента;
	Шапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	Шапка.УчитыватьНДС = Не СчетНаОплатуПокупателюБезНДС(Счет);
	Шапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	Шапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Шапка.Валюта = ДанныеШапки.Валюта;
	Шапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	Шапка.Продавец = ДанныеШапки.Организация;
	Шапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОПолучателе);
	Шапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецИНН = СведенияОПолучателе.ИНН;
	Шапка.ПродавецКПП = СведенияОПолучателе.КПП;
	
	Шапка.ПродавецБанкБИК = ДанныеШапки.БикБанкаПолучателя;
	Шапка.ПродавецБанкПредставление = ДанныеШапки.НаименованиеБанкаПолучателя;
	Шапка.ПродавецБанковскийСчет = ДанныеШапки.БанковскийСчетПродавца;
	Шапка.ПродавецБанковскийСчетНомер = ДанныеШапки.НомерСчетаПолучателя;
	Шапка.ПродавецБанковскийСчетКорСчет = ДанныеШапки.СчетБанкаПолучателя;
	
	Шапка.Покупатель = ДанныеШапки.Покупатель;
	Шапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	Шапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	Шапка.РуководительФИО = ДанныеШапки.РуководительФИО;
	
	ДанныеТабличнойЧасти = СтруктураДанныхДляПечати[0].ТаблицаДокумента;
	
	// Если сумма скидки по документу в целом, то сумма пересчитывается при распределении скидки
	ПересчитатьСуммуСУчетомСкидки = (ДанныеШапки.СуммаСкидки = 0);
	
	РаспределитьСкидкуПоСтрокамТабличнойЧасти(
		ДанныеТабличнойЧасти,
		ДанныеШапки.СуммаСкидки,
		ДанныеШапки.СуммаВключаетНДС
	);
	
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатуры(
			Запись.НоменклатураНаименование,
			Запись.Содержание
		);
		
		НоваяСтрока.НоменклатураАртикул = Запись.НоменклатураАртикул;
		
		Если ПересчитатьСуммуСУчетомСкидки Тогда
			НоваяСтрока.Сумма = НоваяСтрока.Сумма - НоваяСтрока.СуммаСкидки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьСкидкуПоСтрокамТабличнойЧасти(ТабличнаяЧасть, СуммаСкидки, СуммаВключаетНДС)
	
	Если СуммаСкидки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоПоДокументу = 0;
	ВсегоПоСтрокам = Новый Массив;
	
	Для Индекс = 0 По ТабличнаяЧасть.Количество() - 1 Цикл
		
		СтрокаТабличнойЧасти = ТабличнаяЧасть[Индекс];
		
		ВсегоПоСтроке = СтрокаТабличнойЧасти.Сумма + ?(СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
		Если ВсегоПоСтроке > 0 Тогда
			ВсегоПоДокументу = ВсегоПоДокументу + ВсегоПоСтроке;
			ВсегоПоСтрокам.Добавить(ВсегоПоСтроке);
		Иначе
			ВсегоПоСтрокам.Добавить(0);
		КонецЕсли;
		
	КонецЦикла;
	
	ВсегоСоСкидкой = ВсегоПоДокументу - СуммаСкидки;
	
	Если ВсегоСоСкидкой <= 0 Тогда
		ТабличнаяЧасть.ЗаполнитьЗначения(0, "Цена, Сумма, СуммаНДС");
		Возврат;
	КонецЕсли;
	
	ИнтерфейсБСП = ОбщийМодульПоИмениЛок("ОбщегоНазначенияКлиентСервер");
	ВсегоПоСтрокамСоСкидкой =
		ИнтерфейсБСП.РаспределитьСуммуПропорциональноКоэффициентам(ВсегоСоСкидкой, ВсегоПоСтрокам, 2);
	МассивСкидок = ИнтерфейсБСП.РаспределитьСуммуПропорциональноКоэффициентам(СуммаСкидки, ВсегоПоСтрокам, 2);
	
	Для Индекс = 0 По ТабличнаяЧасть.Количество()-1 Цикл
		
		СтрокаТабличнойЧасти = ТабличнаяЧасть[Индекс];
		
		СуммаВсего = ВсегоПоСтрокамСоСкидкой[Индекс];
		
		Если СуммаВсего = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		СтрокаТабличнойЧасти.СуммаНДС = РассчитатьСуммуНДС(
			СуммаВсего,
			Истина,
			СтрокаТабличнойЧасти.СтавкаНДС
		);
		
		СтрокаТабличнойЧасти.Сумма = СуммаВсего - ?(СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
		СтрокаТабличнойЧасти.СуммаСкидки = МассивСкидок[Индекс];
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет модель данных электронного счета на оплату на основании документа продажи.
//
// Параметры:
//	Шапка - Контракт шапки неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - Контракт табличной части неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату()
//  ДокументПродажи - ДокументСсылка.РеализацияТоваровУслуг, ДокументСсылка.РеализацияУслугПоПереработке
//                    ДокументСсылка.КорректировкаРеализации, ДокументСсылка.АктОбОказанииПроизводственныхУслуг
//                    ДокументСсылка.ПередачаОС, ДокументСсылка.ОтчетКомитентуОПродажах
//                    ДокументСсылка.АР_НачислениеАренднойПлаты - основание электронного счета
// 
Процедура СчетаНаОплату_ЗаполнитьДанныеПоДокументуПродажи(Шапка, ТабличнаяЧасть, ДокументПродажи)
	
	Если ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_РеализацияТоваровУслуг(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.РеализацияУслугПоПереработке") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_РеализацияУслугПоПереработке(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_КорректировкаРеализации(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_АктОбОказанииПроизводственныхУслуг(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.ПередачаОС") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_ПередачаОС(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_ОтчетКомитентуОПродажах(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ЭтоНачислениеАренднойПлаты(ДокументПродажи) Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_НачислениеАренднойПлаты(Шапка, ТабличнаяЧасть, ДокументПродажи);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокументПродажи));
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_РеализацияТоваровУслуг(Шапка, ТабличнаяЧасть, ДокументПродажи)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДанныеДокумента.ДоговорКонтрагента.УчетАгентскогоНДС, ЛОЖЬ) КАК УчетАгентскогоНДС,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
