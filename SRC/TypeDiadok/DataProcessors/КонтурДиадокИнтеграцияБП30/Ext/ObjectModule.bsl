Процедура УПД970_ЗаполнитьДатуНомерДляИсправительногоДокумента(Контент, ДанныеШапки)
	
	Контент.RevisionNumber = ДанныеШапки.НомерИсправления;
	Контент.RevisionDate = ДанныеШапки.Дата;
	
	Если ЗначениеЗаполнено(ДанныеШапки.НомерИсходногоДокумента) Тогда
		DocumentNumber = ПредставлениеНомера(ДанныеШапки.НомерИсходногоДокумента);
		
		Если ЗначениеЗаполнено(ДанныеШапки.ЦифровойИндексОбособленногоПодразделения) Тогда
			DocumentNumber = УПД970_ПредставлениеНомераДокументаСИндексомОП(
				DocumentNumber,
				ДанныеШапки.ЦифровойИндексОбособленногоПодразделения
			);
		КонецЕсли;
	Иначе
		DocumentNumber = ДанныеШапки.НомерИсправляемогоКорректировочногоДокумента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ДатаИсходногоДокумента) Тогда
		DocumentDate = ДанныеШапки.ДатаИсходногоДокумента;
	Иначе
		DocumentDate = ДанныеШапки.ДатаИсправляемогоКорректировочногоДокумента;
	КонецЕсли;
	
	Контент.DocumentNumber = DocumentNumber;
	Контент.DocumentDate = DocumentDate;
	
КонецПроцедуры

