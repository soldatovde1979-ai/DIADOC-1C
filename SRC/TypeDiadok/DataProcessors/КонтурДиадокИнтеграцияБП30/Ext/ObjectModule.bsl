Функция Счет29_НовыйOrganizationInfo(Организация, Дата, БанковскийСчет = Неопределено)
	
	OrgInfo = Новый_ЭлементПротоКонтента("ExtendedOrganizationInfoXmlProformaInvoice29");
	
	ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Организация, Дата, БанковскийСчет);
	
	Счет29_ЗаполнитьExtendedOrganizationInfoXmlProformaInvoice29(OrgInfo, ДанныеУчастникаЭДО);
	
	СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ЮридическийАдресJSON);
	OrgInfo.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
	
	OrgInfo.СлужебнаяИнформация = Новый_ЭлементПротоКонтента("OrganizationСлужебнаяИнформация");
	OrgInfo.СлужебнаяИнформация.Ссылка = Организация;
	
	Возврат OrgInfo;
	
КонецФункции

Функция Счет29_НовыйOrganizationInfoСФактическимАдресом(Организация, Дата, Знач СведенияОбАдресе = Неопределено)
	
	OrgInfo = Новый_ЭлементПротоКонтента("ExtendedOrganizationInfoXmlProformaInvoice29");
	
	ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Организация, Дата);
	
	Счет29_ЗаполнитьExtendedOrganizationInfoXmlProformaInvoice29(OrgInfo, ДанныеУчастникаЭДО);
	
	Если Не ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ФактическийАдресJSON);
	КонецЕсли;
	
	OrgInfo.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
	
	OrgInfo.СлужебнаяИнформация = Новый_ЭлементПротоКонтента("OrganizationСлужебнаяИнформация");
	OrgInfo.СлужебнаяИнформация.Ссылка = Организация;
	
	Возврат OrgInfo;
	
КонецФункции

Процедура Счет29_ЗаполнитьExtendedOrganizationInfoXmlProformaInvoice29(OrgInfo, ДанныеУчастникаЭДО)
	
	OrgInfo.Type = ДанныеУчастникаЭДО.ТипЮрФизЛица;
	OrgInfo.Name = ДанныеУчастникаЭДО.НаименованиеПолное;
	
	OrgInfo.Inn = ДанныеУчастникаЭДО.ИНН;
	OrgInfo.Kpp = ДанныеУчастникаЭДО.КПП;
	OrgInfo.Okpo = ДанныеУчастникаЭДО.КодПоОКПО;
	
	OrgInfo.LegalEntityId = ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации;
	OrgInfo.OrganizationOrPersonInfo = ДанныеУчастникаЭДО.ИныеСведения;
	
	ВидыЮрФизЛиц = ГенерацияXML_Перечисление_ВидыЮрФизЛиц();
	
	Если ДанныеУчастникаЭДО.ТипЮрФизЛица = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		OrgInfo.IndividualEntityRegistrationCertificate = ДанныеУчастникаЭДО.Свидетельство;
		OrgInfo.IndividualEntityRegistrationNumber = ДанныеУчастникаЭДО.ОГРН;
		OrgInfo.IndividualEntityRegistrationDate = ДанныеУчастникаЭДО.ДатаРегистрации;
	КонецЕсли;
	
	Если ДанныеУчастникаЭДО.ТипЮрФизЛица = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		OrgInfo.PhysicalEntityStatusID = "1"; // Иное лицо
	КонецЕсли;
	
	OrgInfo.Country = ДанныеУчастникаЭДО.СтранаРегистрацииНаименование;
	OrgInfo.CountryCode = ДанныеУчастникаЭДО.СтранаРегистрацииКод;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Телефоны) Тогда
		OrgInfo.Phone.Добавить(ДанныеУчастникаЭДО.Телефоны);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Email) Тогда
		OrgInfo.Email.Добавить(ДанныеУчастникаЭДО.Email);
	КонецЕсли;
	
	OrgInfo.BankName = ДанныеУчастникаЭДО.Банк;
	OrgInfo.BankAccountNumber = ДанныеУчастникаЭДО.НомерСчета;
	OrgInfo.CorrespondentAccount = ДанныеУчастникаЭДО.КоррСчет;
	OrgInfo.BankId = ДанныеУчастникаЭДО.БИК;
	
КонецПроцедуры

Функция Счет29_НовыйКонтент(ДанныеШапки)
	
	СсылкаНаОбъект = ДанныеШапки.Документ;
	МодульСрокиОплатыДокументов = ОбщийМодульПоИмениЛок("СрокиОплатыДокументов");
	СтруктураСрокОплаты = МодульСрокиОплатыДокументов.СрокОплатыДокументаРасчетов(
		ДанныеШапки.Организация,
		СсылкаНаОбъект,
		ДанныеШапки.Дата,
		ДанныеШапки.ДоговорКонтрагента
	);
	
	Content = Новый_ЭлементПротоКонтента("ProformaInvoice29SellerContent");
	
	Content.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Content.DocumentDate = ДанныеШапки.Дата;
	
	Если ДанныеШапки.ЭтоВалютаПоОКВ Или ДанныеШапки.Валюта = ВалютаРегламентированногоУчета() Тогда
		Content.Currency = ДанныеШапки.ВалютаКод;
		Content.IsConventionalUnit = Ложь;
		Content.ConventionalUnitDefinition = "";
	Иначе
		Content.Currency = "";
		Content.IsConventionalUnit = Истина;
		Content.ConventionalUnitDefinition = ДанныеШапки.ВалютаНаименование;
	КонецЕсли;
	Content.CurrencyRate = Окр(ДанныеШапки.Курс / ДанныеШапки.Кратность, 4);
	
	Content.Seller = Счет29_НовыйOrganizationInfo(ДанныеШапки.Организация, ДанныеШапки.Дата);
	Content.Buyer = Счет29_НовыйOrganizationInfo(ДанныеШапки.Контрагент, ДанныеШапки.Дата);
	Content.Payer = Content.Buyer;
	Content.MoneyRecipient = Счет29_НовыйOrganizationInfo(
		ДанныеШапки.ОрганизацияПолучатель,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетПолучателя
	);
	
	BaseInfo = Счет29_НовыйBaseInfo(ДанныеШапки.ДоговорКонтрагента);
	Если ЗначениеЗаполнено(BaseInfo) Тогда
		Content.ProformaInvoiceBases.Добавить(BaseInfo);
	КонецЕсли;
	
	Content.ProformaInvoiceAdditionalInfo = Новый_ЭлементПротоКонтента("ProformaInvoiceAdditionalInfo");
	Content.ProformaInvoiceAdditionalInfo.DateRestriction = СтруктураСрокОплаты.СрокОплаты;
	Content.ProformaInvoiceAdditionalInfo.PaymentPurpose = СтрШаблон(
		"Оплата по счету %1 от %2",
		Content.DocumentNumber,
		Формат(Content.DocumentDate, "ДФ=dd.MM.yyyy")
	);
	
	Возврат Content;
	
КонецФункции

Функция Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА)
	
	ТочностьОкругления = 2;
	Table = Новый_ЭлементПротоКонтента("ProformaInvoiceTable29");
	
	ВсеСтрокиБезНДС = Истина;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		
		Item = Новый_ЭлементПротоКонтента("Item29");
		
		Item.Product = СтрокаТаблицы.НоменклатураСодержание;
		Если Не ЗначениеЗаполнено(Item.Product) Тогда
			Item.Product = СтрокаТаблицы.НоменклатураНаименование;
		КонецЕсли;
		
		Item.ItemMark = СтрокаТаблицы.НоменклатураТип;
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураАртикул;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество)
			И ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			
			Item.Quantity = СтрокаТаблицы.Количество;
			Item.UnitName = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияНаименование);
			Item.Unit = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияКод);
			
		КонецЕсли;
		
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС, ЭтоНДСИНА);
		ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
		ВсеСтрокиБезНДС = ВсеСтрокиБезНДС И ЭтоСтавкаБезНДС;
		
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		Item.Vat = СтрокаТаблицы.СуммаНДС;
		Item.Subtotal = СтрокаТаблицы.СуммаВсего;
		Item.SubtotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		
		Если ЗначениеЗаполнено(Item.Quantity) Тогда
			Item.Price = Окр(Item.SubtotalWithVatExcluded / Item.Quantity, ТочностьОкругления);
		Иначе
			Item.Price = Item.SubtotalWithVatExcluded;
		КонецЕсли;
		
		Item.PriceWithoutDiscount = Item.Price; // ЦенаТовБезСки требуется для корректной визуализации
		Item.VatWithoutDiscount = Item.Vat; // СумНалБезСки обязательный элемент
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	Table.Vat = ТаблицаДокумента.Итог("СуммаНДС");
	Table.Total = ТаблицаДокумента.Итог("СуммаВсего");
	Table.TotalWithVatExcluded = ТаблицаДокумента.Итог("СуммаБезНДС");
	
	Возврат Table;
	
КонецФункции

Функция Счет29_НовыйTableWithDiscount(ТаблицаДокумента, ЭтоНДСИНА)
	
	ТочностьОкругления = 2;
	Table = Новый_ЭлементПротоКонтента("ProformaInvoiceTable29");
	
	ВсеСтрокиБезНДС = Истина;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		
		Item = Новый_ЭлементПротоКонтента("Item29");
		
		Item.Product = СтрокаТаблицы.НоменклатураСодержание;
		Если Не ЗначениеЗаполнено(Item.Product) Тогда
			Item.Product = СтрокаТаблицы.НоменклатураНаименование;
		КонецЕсли;
		
		Item.ItemMark = СтрокаТаблицы.НоменклатураТип;
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураАртикул;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество)
			И ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			
			Item.Quantity = СтрокаТаблицы.Количество;
			Item.UnitName = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияНаименование);
			Item.Unit = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияКод);
			
		КонецЕсли;
		
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС, ЭтоНДСИНА);
		ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
		ВсеСтрокиБезНДС = ВсеСтрокиБезНДС И ЭтоСтавкаБезНДС;
		
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		Item.Vat = СтрокаТаблицы.СуммаНДС;
		Item.Subtotal = СтрокаТаблицы.СуммаВсего;
		Item.SubtotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		
		Если ЗначениеЗаполнено(Item.Quantity) Тогда
			Item.Price = Окр(Item.SubtotalWithVatExcluded / Item.Quantity, ТочностьОкругления);
		Иначе
			Item.Price = Item.SubtotalWithVatExcluded;
		КонецЕсли;
		
		Item.VatWithoutDiscount = СтрокаТаблицы.СуммаНДСБезСкидки;
		Item.SubtotalWithoutDiscount = СтрокаТаблицы.СуммаВсегоБезСкидки;
		Item.SubtotalWithoutVatAndDiscount = СтрокаТаблицы.СуммаБезНДСБезСкидки;
		
		Если ЗначениеЗаполнено(Item.Quantity) Тогда
			Item.PriceWithoutDiscount = Окр(Item.SubtotalWithoutVatAndDiscount / Item.Quantity, ТочностьОкругления);
		Иначе
			Item.PriceWithoutDiscount = Item.SubtotalWithoutVatAndDiscount;
		КонецЕсли;
		
		Item.DiscountSum = СтрокаТаблицы.СуммаСкидки;
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	Table.Vat = ТаблицаДокумента.Итог("СуммаНДС");
	Table.Total = ТаблицаДокумента.Итог("СуммаВсего");
	Table.TotalWithVatExcluded = ТаблицаДокумента.Итог("СуммаБезНДС");
	Table.TotalDiscountSum = ТаблицаДокумента.Итог("СуммаСкидки");
	
	Возврат Table;
	
КонецФункции

Функция Счет29_НовыйBaseInfo(Договор)
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыДоговора = ЗначенияРеквизитовОбъектаЛок(Договор, "Дата, Номер, Наименование");
	
	Если СокрЛП(Нрег(РеквизитыДоговора.Наименование)) = Нрег("Без договора") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	DocumentRequisitesType = Новый_ЭлементПротоКонтента("DocumentRequisitesType");
	
	DocumentRequisitesType.DocumentName = "Договор";
	DocumentRequisitesType.DocumentDate = РеквизитыДоговора.Дата;
	
	Если ПустаяСтрока(РеквизитыДоговора.Номер) Тогда
		DocumentRequisitesType.DocumentNumber = "Без номера";
	Иначе
		DocumentRequisitesType.DocumentNumber = РеквизитыДоговора.Номер;
	КонецЕсли;
	
	ProformaInvoice29Base = Новый_ЭлементПротоКонтента("ProformaInvoice29Base");
	
	ProformaInvoice29Base.ProformaInvoiceBaseDocument = DocumentRequisitesType;
	
	Возврат ProformaInvoice29Base;
	
КонецФункции

Процедура Счет29_РаспределитьСкидкуПоСтрокамТабличнойЧасти(ТабличнаяЧасть, СуммаСкидки)
	
	Если СуммаСкидки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоПоДокументу = ТабличнаяЧасть.Итог("СуммаВсего");
	ВсегоПоСтрокам = ТабличнаяЧасть.ВыгрузитьКолонку("СуммаВсего");
	
	ВсегоСоСкидкой = ВсегоПоДокументу - СуммаСкидки;
	
	Если ВсегоСоСкидкой <= 0 Тогда
		Ошибка = "Сумма скидки превышает сумму по документу";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ИнтерфейсБСП = ОбщийМодульПоИмениЛок("ОбщегоНазначенияКлиентСервер");
	ТочностьОкругления = 2;
	
	СуммыВсегоСоСкидкой =
		ИнтерфейсБСП.РаспределитьСуммуПропорциональноКоэффициентам(ВсегоСоСкидкой, ВсегоПоСтрокам, ТочностьОкругления);
	СуммыСкидок = ИнтерфейсБСП.РаспределитьСуммуПропорциональноКоэффициентам(СуммаСкидки, ВсегоПоСтрокам, 2);
	
	Для Индекс = 0 По ТабличнаяЧасть.Количество() - 1 Цикл
		
		Стр = ТабличнаяЧасть[Индекс];
		
		Стр.СуммаВсего = СуммыВсегоСоСкидкой[Индекс];
		Стр.СуммаНДС = РассчитатьСуммуНДС(Стр.СуммаВсего, Истина, Стр.СтавкаНДС);
		Стр.СуммаНДС = Окр(Стр.СуммаНДС, ТочностьОкругления);
		Стр.СуммаБезНДС = Стр.СуммаВсего - Стр.СуммаНДС;
		Стр.СуммаСкидки = СуммыСкидок[Индекс];
		
	КонецЦикла;
	
КонецПроцедуры

Функция Счет29_СодержитТолькоУслуги(ТаблицаДокумента)
	
	ТипНоменклатурыИмущество = ГенерацияXML.Перечисление_ItemMarks().Имущество;
	Результат = (ТаблицаДокумента.Найти(ТипНоменклатурыИмущество, "НоменклатураТип") = Неопределено);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


