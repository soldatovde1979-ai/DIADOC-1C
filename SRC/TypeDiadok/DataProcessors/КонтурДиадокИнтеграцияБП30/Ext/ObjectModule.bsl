	ТекстЗапросаПлатежныеДокументы = УПД970_ТекстЗапросаПлатежныхДокументовСчетФактурыВыданный();
	ТекстЗапросаАвансовыхДокументов = УПД970_ТекстЗапросаАвансовыхДокументовСчетФактурыВыданный();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаДокументовОснований);
	ТекстыЗапросов.Добавить(ТекстЗапросаПлатежныеДокументы);
	ТекстыЗапросов.Добавить(ТекстЗапросаАвансовыхДокументов);
	
	РезультатЗапроса = УПД970_РезультатЗапросаИсходныхДанныхДокумента(Документ, ТекстыЗапросов);
	
	ТаблицаДанныеШапки = РезультатЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаДанныеШапки[0]);
	
	ДокументыОснования = РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	ПлатежныеДокументы = РезультатЗапроса[2].Выгрузить();
	АвансовыеДокументы = РезультатЗапроса[3].Выгрузить();
	
	ТабличныеДанные = УПД970_НоваяТаблицаТоварСчетФактураВыданный();
	СведенияПрослеживаемости = Неопределено;
	
	Для Индекс = 0 По ДокументыОснования.ВГраница() Цикл
		
		ДокументОснования = ДокументыОснования[Индекс];
		
		ИсходныеДанныеОснования = УПД970_ИсходныеДанныеДокументаОснованияСчетФактураВыданный(Документ, ДокументОснования);
		
		Если Индекс = 0 Тогда
			УПД970_КопироватьРеквизитыИсходногоДокументаВДанныеСчетФактуры(ДанныеШапки, ИсходныеДанныеОснования.ДанныеШапки);
		КонецЕсли;
		
		ЗагрузитьВТаблицуЗначенийЛок(ИсходныеДанныеОснования.ТабличныеДанные, ТабличныеДанные);
		
		Если ИсходныеДанныеОснования.Свойство("СведенияПрослеживаемости") Тогда
			
			Если СведенияПрослеживаемости = Неопределено Тогда
				СведенияПрослеживаемости = ИсходныеДанныеОснования.СведенияПрослеживаемости;
			Иначе
				ЗагрузитьВТаблицуЗначенийЛок(ИсходныеДанныеОснования.СведенияПрослеживаемости, СведенияПрослеживаемости);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	Результат.Вставить("ДокументыОснования", ДокументыОснования);
	Результат.Вставить("ПлатежноРасчетныеДокументы", ПлатежныеДокументы);
	Результат.Вставить("АвансовыеДокументы", АвансовыеДокументы);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеКорректировкаРеализации(Документ)
	
	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиКорректировкаРеализации();
	ТекстЗапросаТабличныеДанные = УПД970_ТекстЗапросаТабличныеДанныеКорректировкаРеализации();
	ТекстЗапросаПрослеживаемость = УПД970_ТекстЗапросаСведенийПрослеживаемостиКорректировкаРеализации();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныеДанные);
	ТекстыЗапросов.Добавить(ТекстЗапросаПрослеживаемость);
	
	РезультатЗапроса = УПД970_РезультатЗапросаИсходныхДанныхДокумента(Документ, ТекстыЗапросов);
	
	ТаблицаДанныеШапки = РезультатЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаДанныеШапки[0]);
	
	ТабличныеДанные = РезультатЗапроса[4].Выгрузить();
	СведенияПрослеживаемости = РезультатЗапроса[5].Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат Результат;
	
КонецФункции

