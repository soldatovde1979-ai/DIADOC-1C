Функция Счет29_ОтчетКомитенту(СсылкаНаОбъект)
	
	СуммаВознаграждения = СсылкаНаОбъект.Товары.Итог("СуммаВознаграждения");
	Если СуммаВознаграждения = 0 Тогда
		Ошибка = "Формирование счетов на оплату поддерживается только для
		| ОтчетовКомитенту с указанной суммой вознаграждения.";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка,
	|	СУММА(ТЧ.СуммаНДСВознаграждения) КАК СуммаНДС,
	|	СУММА(ВЫБОР
	|			КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|				ТОГДА ТЧ.СуммаВознаграждения - ТЧ.СуммаНДСВознаграждения
	|			ИНАЧЕ ТЧ.СуммаВознаграждения
	|		КОНЕЦ) КАК СуммаБезНДС,
	|	СУММА(ВЫБОР
	|			КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|				ТОГДА ТЧ.СуммаВознаграждения
	|			ИНАЧЕ ТЧ.СуммаВознаграждения + ТЧ.СуммаНДСВознаграждения
	|		КОНЕЦ) КАК СуммаВсего
	|ПОМЕСТИТЬ ВТ_Вознаграждение
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетПолучателя,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.УслугаПоВознаграждению КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Шапка.УслугаПоВознаграждению = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА &ПредопределенноеНаименованиеУслуги
	|		КОГДА Шапка.УслугаПоВознаграждению.НаименованиеПолное ПОДОБНО """"
	|			ТОГДА Шапка.УслугаПоВознаграждению.Наименование
	|		ИНАЧЕ Шапка.УслугаПоВознаграждению.НаименованиеПолное
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА ЕСТЬNULL(Шапка.УслугаПоВознаграждению.Артикул, """")
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Код)
	|			ТОГДА ЕСТЬNULL(Шапка.УслугаПоВознаграждению.Код, """")
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.НеВыводить)
	|			ТОГДА """"
	|	КОНЕЦ КАК НоменклатураАртикул,
	|	ЕСТЬNULL(Шапка.УслугаПоВознаграждению.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(Шапка.УслугаПоВознаграждению.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(Шапка.УслугаПоВознаграждению.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	Шапка.СтавкаНДСВознаграждения КАК СтавкаНДС,
	|	ЕСТЬNULL(ВТ_Вознаграждение.СуммаНДС, 0) КАК СуммаНДС,
	|	ЕСТЬNULL(ВТ_Вознаграждение.СуммаБезНДС, 0) КАК СуммаБезНДС,
	|	ЕСТЬNULL(ВТ_Вознаграждение.СуммаВсего, 0) КАК СуммаВсего
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Вознаграждение КАК ВТ_Вознаграждение
	|		ПО Шапка.Ссылка = ВТ_Вознаграждение.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект";
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ПредопределенноеНаименованиеУслуги", "Комиссионное вознаграждение");
	Запрос.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов",
		ДополнительнаяКолонкаПечатныхФормДокументов());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Ошибка = СтрШаблон("Не удалось получить данные по документу '%1'", СсылкаНаОбъект);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ДанныеДокумента = РезультатЗапроса.Выбрать();
	ДанныеДокумента.Следующий();
	
	Content = Счет29_НовыйКонтент(ДанныеДокумента);
	
	Item = Новый_ЭлементПротоКонтента("Item29");
	
	Item.Product = ДанныеДокумента.НоменклатураНаименование;
	Item.ItemMark = ТипыНоменклатуры.Услуга;
	Item.ItemVendorCode = ДанныеДокумента.НоменклатураАртикул;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.ЕдиницаИзмерения) Тогда
		
		Item.Quantity = 1;
		Item.UnitName = СокрЛП(ДанныеДокумента.ЕдиницаИзмеренияНаименование);
		Item.Unit = СокрЛП(ДанныеДокумента.ЕдиницаИзмеренияКод);
		
	КонецЕсли;
	
	ЭтоНДСИНА = Ложь;
	Item.TaxRate = ПредставлениеСтавкиНДС(ДанныеДокумента.СтавкаНДС, ЭтоНДСИНА);
	
	ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
	Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
	Item.Vat = ДанныеДокумента.СуммаНДС;
	Item.Subtotal = ДанныеДокумента.СуммаВсего;
	Item.SubtotalWithVatExcluded = ДанныеДокумента.СуммаБезНДС;
	Item.Price = Item.SubtotalWithVatExcluded;
	Item.PriceWithoutDiscount = Item.Price;
	Item.VatWithoutDiscount = Item.Vat; // СумНалБезСки обязательный элемент
	
	Content.Table = Новый_ЭлементПротоКонтента("ProformaInvoiceTable29");
	Content.Table.Items.Добавить(Item);
	
	Content.Table.WithoutVat = Item.WithoutVat;
	Content.Table.Vat = Item.Vat;
	Content.Table.Total = Item.Subtotal;
	Content.Table.TotalWithVatExcluded = Item.SubtotalWithVatExcluded;
	
	Возврат Content;
	
КонецФункции

Функция Счет29_СчетНаАренду(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.СчетОрганизации КАК БанковскийСчетПолучателя,
	|	ЕСТЬNULL(Шапка.ДополнительныеУсловия.ТекстУсловий, """") КАК ДополнительныеУсловия
	|ИЗ
	|	Документ.АР_СчетНаАренду КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ТЧ.Содержание КАК НоменклатураСодержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ТипНоменклатурыУслуга КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АР_СчетНаАренду.Состав КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	ПсевдонимТабличнойЧасти = "ТЧ";
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", ТипыНоменклатуры.Услуга);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	Если ЗначениеЗаполнено(ДанныеШапки.ДополнительныеУсловия) Тогда
		УсловияОплаты = Лев(СокрЛП(ДанныеШапки.ДополнительныеУсловия), 1000);
		Content.ProformaInvoiceAdditionalInfo.PaymentTerms.Добавить(УсловияОплаты);
	КонецЕсли;
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	
	Возврат Content;
	
КонецФункции

