Функция ДляОтгрузкиБезПереходаПраваСобственностиНачисляетсяНДС(Документ1С)
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(Документ1С, "Организация, Дата");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаНДССрезПоследних.НачислятьНДСПоОтгрузке КАК НачислятьНДСПоОтгрузке
		|ИЗ
		|	РегистрСведений.НастройкиУчетаНДС.СрезПоследних(
		|		&Дата,
		|		Организация = &Организация) КАК НастройкиУчетаНДССрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("Дата", РеквизитыДокумента.Дата);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() > 0 Тогда
		Результат = Выборка[0].НачислятьНДСПоОтгрузке;
	Иначе
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

