Функция УПД970_КонтентТитулаПродавцаПоСчетФактураВыданныйНаАванс(
	Документ,
	ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеСчетФактурыВыданныйНаАванс(Документ);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТабличныеДанные = ДанныеДокумента.ТабличныеДанные;
	
	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ГенерацияXML_ФункцииУПД().СЧФ;
	Результат.CircumFormatInvoice = "2";
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	
	НомерДокумента = ДанныеШапки.ПредставлениеНомера;
	Если ЗначениеЗаполнено(ДанныеШапки.ЦифровойИндексОбособленногоПодразделения) Тогда
		НомерДокумента = УПД970_ПредставлениеНомераДокументаСИндексомОП(
			НомерДокумента,
			ДанныеШапки.ЦифровойИндексОбособленногоПодразделения);
	КонецЕсли;
	
	Если ДанныеШапки.Исправление Тогда
		УПД970_ЗаполнитьДатуНомерДляИсправительногоДокумента(Результат, ДанныеШапки);
	Иначе
		Результат.DocumentNumber = НомерДокумента;
		Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
	КонецЕсли;
	
	Результат.Currency = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.ВалютаДокумента, "Код");
	
	Table = Результат.Table;
	
	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		Item = Контракт_Item970();
		
		Item.Product = СокрЛП(СтрокаТаблицы.НоменклатураНаименование);
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатуры(СтрокаТаблицы.ЭтоУслуга);
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		
		Item.Quantity = 0;
		Item.Price = 0;
		
		Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
			Item.SubtotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
			Item.Vat = 0;
			Item.Subtotal = 0;
		Иначе
			Item.SubtotalWithVatExcluded = 0;
			Item.Vat = СтрокаТаблицы.СуммаНДС;
			Item.Subtotal = СтрокаТаблицы.Всего;
		КонецЕсли;
		
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС, ДанныеШапки.НДСИсчисляетсяНалоговымАгентом);
		Item.WithoutVat = XMLСтрока(Ложь);
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	УПД970_ЗаполнитьИтоговыеЗначенияПоТаблице(Table);
	
	УПД970_ЗаполнитьСведенияОПродавце(Результат, ДанныеШапки);
	УПД970_ЗаполнитьСведенияОПокупателе(Результат, ДанныеШапки);

	УПД970_ЗаполнитьСведенияОПлатежноРасчетныхДокументах(
		Результат.PaymentDocuments,
		ДанныеДокумента.ПлатежноРасчетныеДокументы
	);
	
	TransferInfo = Результат.TransferInfo;
	TransferInfo.OperationInfo = "Регистрация счет-фактуры на аванс";
	
	УПД970_ЗаполнитьСведенияОбОснованииОтгрузки(TransferInfo, ДанныеШапки, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьСоставителяДокументаПоПродавцу(Результат);

	Возврат Результат;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоСчетФактураВыданный(
	Документ,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеСчетФактурыВыданный(Документ);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТабличныеДанные = ДанныеДокумента.ТабличныеДанные;
	СведенияПрослеживаемости = ДанныеДокумента.СведенияПрослеживаемости;
	ДокументыОснования = ДанныеДокумента.ДокументыОснования;
	
	Валюта = ДанныеШапки.ВалютаДокумента;
	НуженПересчетВРубли = НуженПересчетВРубли(ДанныеШапки.РасчетыВУсловныхЕдиницах, Валюта);
	ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	ВыводитьКодыТНВЭД = УПД970_ВыводитьКодыТНВЭД(ДанныеШапки.Покупатель, ДанныеШапки.Грузополучатель);
	
	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента;
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФ() Тогда
		ОбстФормированияДокумента = УПД970_ОбстоятельстваФормированияСчетаФактуры(
			ДанныеШапки.КодВидаОперации,
			ДанныеШапки.ВидДоговора);
	Иначе
		ОбстФормированияДокумента = УПД970_ОбстоятельстваФормированияУПД(ДанныеШапки.ВидДоговора);
	КонецЕсли;
	
	Результат.CircumFormatInvoice = ОбстФормированияДокумента;
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	
	НомерДокумента = ДанныеШапки.ПредставлениеНомера;
	Если ЗначениеЗаполнено(ДанныеШапки.ЦифровойИндексОбособленногоПодразделения) Тогда
		НомерДокумента = УПД970_ПредставлениеНомераДокументаСИндексомОП(
			НомерДокумента,
			ДанныеШапки.ЦифровойИндексОбособленногоПодразделения
		);
	КонецЕсли;
	
	Если ДанныеШапки.Исправление Тогда
		УПД970_ЗаполнитьДатуНомерДляИсправительногоДокумента(Результат, ДанныеШапки);
	Иначе
		Результат.DocumentNumber = НомерДокумента;
		Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
	КонецЕсли;
	
	УПД970_ЗаполнитьКодВалюты(Результат, Валюта, НуженПересчетВРубли);
	
	Table = Результат.Table;
	
	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		Item = Контракт_Item970();
		
		Item.Product = СокрЛП(СтрокаТаблицы.НоменклатураНаименование);
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатуры(СтрокаТаблицы.ЭтоУслуга);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.НоменклатураКод) Тогда
			Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения)
			И ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			
			УПД970_ЗаполнитьЕдиницуИзмерения(
				Item,
				СтрокаТаблицы.ЕдиницаИзмеренияНаименование,
				СтрокаТаблицы.ЕдиницаИзмеренияКод);
			
		КонецЕсли;
		
		УПД970_ЗаполнитьЧисловыеДанныеИСтавкуНДСпоСтроке(
			Item,
			СтрокаТаблицы,
			НуженПересчетВРубли,
			ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
			ДополнительныеПараметры.ТочностьКоличества,
			ДополнительныеПараметры.ТочностьЦены,
			ЦенаВключаетНДС);
		
		Если СтрокаТаблицы.ПодакцизныйТовар Тогда
			Item.Excise = СтрокаТаблицы.СуммаАкциза;
		КонецЕсли;
		
		УПД970_ЗаполнитьCustomDeclaration(Item, СтрокаТаблицы.НомерГТД, СтрокаТаблицы.СтранаПроисхожденияКод);
		УПД970_ЗаполнитьItemTracingInfos(Item, СтрокаТаблицы, СведенияПрослеживаемости, НуженПересчетВРубли);
		
		Если ВыводитьКодыТНВЭД И ЗначениеЗаполнено(СтрокаТаблицы.КодТНВЭД) Тогда
			Item.ItemTypeCode = ЗначениеРеквизитаОбъектаЛок(СтрокаТаблицы.КодТНВЭД, "Код");
		КонецЕсли;
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	УПД970_ЗаполнитьИтоговыеЗначенияПоТаблице(Table);
	
	УПД970_ЗаполнитьСведенияОПродавце(Результат, ДанныеШапки, ДанныеШапки.КПППоставщика);
	УПД970_ЗаполнитьСведенияОПокупателе(Результат, ДанныеШапки);
	
	ЕстьТовары = Не УПД970_СодержитТолькоУслуги(ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		УПД970_ЗаполнитьСведенияОГрузоотправителе(Результат, ДанныеШапки);
		
		СведенияОАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
			ДанныеШапки.АдресДоставки,
			ДанныеШапки.АдресДоставкиЗначение);
		
		УПД970_ЗаполнитьСведенияОГрузополучателе(Результат, ДанныеШапки, СведенияОАдресеДоставки);
		
	КонецЕсли;
	
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Результат, Документ, ДокументыОснования, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОПлатежноРасчетныхДокументах(
		Результат.PaymentDocuments,
		ДанныеДокумента.ПлатежноРасчетныеДокументы
	);
	УПД970_ЗаполнитьСведенияОбАвансовыхСФ(
		Результат.AccompanyingDocuments,
		ДанныеДокумента.АвансовыеДокументы
	);
	
	ДатаОтгрузки = УПД970_ДатаОтгрузки(
		ДокументыОснования[0],
		Результат.DocumentDate,
		Результат.DocumentShipments,
		ФункцияДокумента);
	
	TransferInfo = Результат.TransferInfo;
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferDate = ДатаОтгрузки;
	TransferInfo.TransferTextInfo = ДанныеШапки.СведенияОТранспортировке;
	
	Если ЕстьТовары Тогда
		УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры);
	КонецЕсли;
	
	УПД970_ЗаполнитьСведенияОбОснованииОтгрузки(TransferInfo, ДанныеШапки, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьСоставителяДокумента(Результат, Документ);
	
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Результат);
	
	УПД970_ЗаполнитьСведенияОМаркировке(Результат, Документ);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоКорректировкеРеализации(
	Документ,
	ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеКорректировкаРеализации(Документ);
	ФункцияДокумента = ФункцияДокумента_ДОП();
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТабличныеДанные = ДанныеДокумента.ТабличныеДанные;
	СведенияПрослеживаемости = ДанныеДокумента.СведенияПрослеживаемости;
	
	Валюта = ДанныеШапки.ВалютаДокумента;
	НуженПересчетВРубли = НуженПересчетВРубли(ДанныеШапки.РасчетыВУсловныхЕдиницах, Валюта);
	ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	
	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента;
	Результат.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияУПД(ДанныеШапки.ВидДоговора);
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	Результат.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Результат.DocumentDate = ДанныеШапки.Дата;
	Результат.RevisionNumber = ДанныеШапки.НомерИсправления;
	Результат.RevisionDate = ДанныеШапки.ДатаИсправления;
	
	УПД970_ЗаполнитьКодВалюты(Результат, Валюта, НуженПересчетВРубли);
	
	УПД970_ЗаполнитьСведенияОПродавце(Результат, ДанныеШапки);
	УПД970_ЗаполнитьСведенияОПокупателе(Результат, ДанныеШапки);
	
	ЕстьТовары = Не УПД970_СодержитТолькоУслуги(ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		АдресДоставкиЗначение = Неопределено;
		СведенияОАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
			ДанныеШапки.АдресДоставки,
			АдресДоставкиЗначение
		);
		УПД970_ЗаполнитьСведенияОГрузополучателе(Результат, ДанныеШапки, СведенияОАдресеДоставки);
		УПД970_ЗаполнитьСведенияОГрузоотправителе(Результат, ДанныеШапки);
		
	КонецЕсли;
	
	Table = Результат.Table;
	
	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		Item = Контракт_Item970();
		
		Item.Product = СокрЛП(СтрокаТаблицы.НоменклатураНаименование);
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатуры(СтрокаТаблицы.ЭтоУслуга);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения)
			И ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			
			УПД970_ЗаполнитьЕдиницуИзмерения(
			Item,
			СтрокаТаблицы.ЕдиницаИзмеренияНаименование,
			СтрокаТаблицы.ЕдиницаИзмеренияКод
			);
			
		КонецЕсли;
		
		Если СтрокаТаблицы.ПодакцизныйТовар Тогда
			Item.Excise = ПривестиКЧислуЛок(СтрокаТаблицы.Акциз);
		КонецЕсли;
		
		УПД970_ЗаполнитьЧисловыеДанныеИСтавкуНДСпоСтроке(
			Item,
			СтрокаТаблицы,
			НуженПересчетВРубли,
			ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
			ДополнительныеПараметры.ТочностьКоличества,
			ДополнительныеПараметры.ТочностьЦены,
			ЦенаВключаетНДС
		);
		
		УПД970_ЗаполнитьCustomDeclaration(Item, СтрокаТаблицы.НомерГТД, СтрокаТаблицы.СтранаПроисхожденияКод);
		УПД970_ЗаполнитьItemTracingInfos(Item, СтрокаТаблицы, СведенияПрослеживаемости, НуженПересчетВРубли);
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	УПД970_ЗаполнитьИтоговыеЗначенияПоТаблице(Table);
	
	ДокументыОтгрузки = ЗначениеВМассивЛок(Документ);
	Результат.DocumentName = УПД790_НаименованиеДокументаОтгрузки(Table.Items, ДокументыОтгрузки, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОДокументеОтгрузки(Результат);
	
	TransferInfo = Результат.TransferInfo;
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferDate = УПД970_ОпределитьДатаОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	
	Если ЕстьТовары Тогда
		УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры);
	КонецЕсли;
	
	УПД970_ЗаполнитьСведенияОбОснованииОтгрузки(TransferInfo, ДанныеШапки, ДополнительныеПараметры);
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Результат);
	УПД970_ЗаполнитьСведенияОМаркировке(Результат, Документ);
	УПД970_ЗаполнитьСоставителяДокументаПоПродавцу(Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область УПД970_ТекстыЗапросов

Функция УПД970_ТекстЗапросаДанныхШапкиРеализацияТоваровУслуг()
	
	Результат =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Номер КАК Номер,
	|	Реквизиты.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|					ТОГДА Реквизиты.Организация.ЦифровойИндексОбособленногоПодразделения
	|				ИНАЧЕ """"
	|			КОНЕЦ
	|	КОНЕЦ КАК ЦифровойИндексОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация.ГоловнаяОрганизация
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК Поставщик,
	|	ВЫБОР
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделениеПоставщика,
	|	ВЫБОР
	|		КОГДА Реквизиты.Контрагент.ОбособленноеПодразделение
	|				И Реквизиты.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК Покупатель,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель.ОбособленноеПодразделение
	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент = Реквизиты.Контрагент
	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Грузополучатель
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК ОбособленноеПодразделениеПокупателя,
	|	Реквизиты.ДоговорКонтрагента КАК Договор,
	|	Реквизиты.ДоговорКонтрагента.Наименование КАК Основание,
	|	Реквизиты.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Реквизиты.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	Реквизиты.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем КАК НДСИсчисляетсяНалоговымАгентом,
	|	Реквизиты.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Реквизиты.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.ГосударственныйКонтракт.Код, """") КАК ИдентификаторГосКонтракта,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Грузоотправитель
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация
	|		КОГДА Реквизиты.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером)
	|			ТОГДА Реквизиты.Организация
	|		ИНАЧЕ ""он же""
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Контрагент
	|		ИНАЧЕ Реквизиты.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	Реквизиты.БанковскийСчетОрганизации КАК БанковскийСчетПродавца,
	|	Реквизиты.АдресДоставки КАК АдресДоставки,
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	Реквизиты.СведенияОТранспортировкеИГрузе КАК СведенияОТранспортировке,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	УПД970_ЗаполнитьВТекстеЗапросаРТиУВыражениеСАдресомДоставкиЗначение(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличныеДанныеРеализацияТоваровУслуг()
	
	Результат = УПД970_ТекстЗапросаРублевыхСуммДокументовВВалюте()
	+ ТекстЗапроса_РазделительЗапросов() +
	"ВЫБРАТЬ
	|	&ИдентификаторСтрокиУслуги КАК ИдентификаторСтроки,
	|	МАКСИМУМ(РеализацияТоваровУслугСведенияПрослеживаемости.СтранаПроисхождения) КАК СтранаПроисхождения,
	|	МАКСИМУМ(СтраныМира.Код) КАК СтранаПроисхожденияКод
	|ПОМЕСТИТЬ ВТ_ДанныеПоСтранеПроисхождения
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.СведенияПрослеживаемости КАК РеализацияТоваровУслугСведенияПрослеживаемости
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|			ПО РеализацияТоваровУслугСведенияПрослеживаемости.СтранаПроисхождения = СтраныМира.Ссылка
	|		ПО &ИдентификаторСтрокиУслуги = РеализацияТоваровУслугСведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	РеализацияТоваровУслугСведенияПрослеживаемости.Ссылка = &Ссылка
	|	И Таблица.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	&ИдентификаторСтрокиУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК ПорядокТЧ,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	&КодТовараУслуги КАК НоменклатураКод,
	|	&НаименованиеНоменклатуры КАК НоменклатураНаименование,
	|	Таблица.Номенклатура.Услуга КАК ЭтоУслуга,
	|	Таблица.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Таблица.Номенклатура.КодТНВЭД КАК НоменклатураКодТНВЭД,
	|	Таблица.Количество КАК Количество,
	|	Таблица.Цена КАК Цена,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	&НомерГТД КАК НомерГТД,
	|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Таблица.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	Таблица.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	Таблица.ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	&ПодакцизныйТовар КАК ПодакцизныйТовар,
	|	&СуммаАкциза КАК СуммаАкциза,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0) КАК ВсегоРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0) КАК НДСРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0) КАК СуммаБезНДСРуб
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО Таблица.НомерСтроки = РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента
	|			И (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Товары))
	|			И (Таблица.Ссылка.ВалютаДокумента <> &ВалютаРеглУчета)
	|ГДЕ	
	|	Таблица.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2,
	|	""Услуги"",
	|	Таблица.Ссылка,
	|	Таблица.НомерСтроки,
	|	Таблица.Номенклатура,
	|	&КодТовараУслуги,
	|	&НаименованиеУслуги,
	|	ИСТИНА,
	|	ЕСТЬNULL(Таблица.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)),
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка),
	|	Таблица.Количество,
	|	Таблица.Цена,
	|	Таблица.Сумма,
	|	Таблица.СтавкаНДС,
	|	Таблица.СуммаНДС,
	|	НЕОПРЕДЕЛЕНО,
	|	ЕСТЬNULL(ВТ_ДанныеПоСтранеПроисхождения.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)),
	|	ЕСТЬNULL(ВТ_ДанныеПоСтранеПроисхождения.СтранаПроисхожденияКод, """"),
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	ЛОЖЬ,
	|	0,
	|	&ИдентификаторСтрокиУслуги,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0),
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0),
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0)
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО Таблица.НомерСтроки = РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента
	|			И (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Услуги))
	|			И (Таблица.Ссылка.ВалютаДокумента <> &ВалютаРеглУчета)
