КонецФункции

Функция НоваяТаблицаНоменклатурыДляСопоставления()
	
	Результат = Новый ТаблицаЗначений;
	
	Если ИспользуетсяНоменклатураКонтрагентовБЭД() Тогда
		
		МетаданныеНоменклатурыКонтрагентов = Метаданные.РегистрыСведений.НоменклатураКонтрагентовБЭД;
		
		ВладелецТип = Метаданные.ОпределяемыеТипы.ВладелецНоменклатурыБЭД.Тип;
		
		НоменклатураТип = Новый_ТипНоменклатурыБЭДДляСопоставления(Метаданные.ОпределяемыеТипы.НоменклатураБЭД.Тип);
		
		УпаковкаТип = МетаданныеНоменклатурыКонтрагентов.Ресурсы.Упаковка.Тип; 
		НаименованиеТип = МетаданныеНоменклатурыКонтрагентов.Ресурсы.Наименование.Тип;
		АртикулТип = МетаданныеНоменклатурыКонтрагентов.Ресурсы.Артикул.Тип;
		КодТип = АртикулТип; // поля "Код" в регистре нет
		
	Иначе
		
		МетаданныеНоменклатурыПоставщиков = Метаданные.Справочники.НоменклатураПоставщиков;
		
		ВладелецТип = МетаданныеНоменклатурыПоставщиков.СтандартныеРеквизиты.Владелец.Тип;
		
		НоменклатураТип = МетаданныеНоменклатурыПоставщиков.Реквизиты.Номенклатура.Тип;
		
		УпаковкаТип = Неопределено;
		НаименованиеТип = МетаданныеНоменклатурыПоставщиков.СтандартныеРеквизиты.Наименование.Тип;
		АртикулТип = МетаданныеНоменклатурыПоставщиков.Реквизиты.Артикул.Тип;
		КодТип = МетаданныеНоменклатурыПоставщиков.Реквизиты.Идентификатор.Тип;
		
	КонецЕсли;
	
	ШиринаМалая = 10;
	
	// Ограничения типам реквизитов для текущей конфигурации
	Результат.Колонки.Добавить("Контрагент"             , ВладелецТип);
	Результат.Колонки.Добавить("Наименование"           , НаименованиеТип);
	Результат.Колонки.Добавить("Код"                    , КодТип, , ШиринаМалая);
	Результат.Колонки.Добавить("Артикул"                , АртикулТип, , ШиринаМалая);
	Результат.Колонки.Добавить("Номенклатура"           , НоменклатураТип);
	Результат.Колонки.Добавить("НоменклатураКонтрагента", Неопределено);
	Если НЕ УпаковкаТип = Неопределено Тогда
		Результат.Колонки.Добавить("Упаковка"           , УпаковкаТип);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТипНоменклатурыБЭДДляСопоставления(ОписаниеТипаНоменклатураБЭД)
	
	Результат = ОписаниеТипаНоменклатураБЭД;
	
	ИмяОбъектаМетаданных = "Справочник.Номенклатура";
	Если Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМетаданных) <> Неопределено Тогда
		
		ИмяТипа			 = "СправочникСсылка.Номенклатура";
		ТипНоменклатура	 = Тип(ИмяТипа);
		
		Если ОписаниеТипаНоменклатураБЭД.СодержитТип(ТипНоменклатура) Тогда
			Результат = Новый ОписаниеТипов(ИмяТипа);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Процедура ДобавитьНоменклатуруДляСопоставления(Результат, Контрагент, НоменклатураКонтрагента)
	
	Если Не Результат.Свойство("ТаблицаНоменклатурыДляСопоставления") Тогда
		
		ТаблицаНоменклатуры = НоваяТаблицаНоменклатурыДляСопоставления();
		Результат.Вставить("ТаблицаНоменклатурыДляСопоставления", ТаблицаНоменклатуры);
		
	КонецЕсли;
	
	НоваяСтрока = Результат.ТаблицаНоменклатурыДляСопоставления.Добавить();
	НоваяСтрока.Контрагент				= Контрагент;
	НоваяСтрока.Наименование			= НоменклатураКонтрагента.Наименование;
	НоваяСтрока.Код						= НоменклатураКонтрагента.Код;
	НоваяСтрока.Артикул					= НоменклатураКонтрагента.Артикул;
	НоваяСтрока.НоменклатураКонтрагента = НоменклатураКонтрагента;
	
КонецПроцедуры

Функция ПолучитьРеквизитыПодписантаПоОрганизации1С(Организация, Дата, ВызыватьИсключение = Истина)
	
	Результат = Новый Структура("Фамилия, Имя, Отчество, Должность", "", "", "", "");
	
	ОтвЛица = ОтветственныеЛицаБП.ОтветственныеЛица(Организация, Дата);
	
	Если ТипЗнч(ОтвЛица.РуководительФИО) = Тип("Структура") Тогда
		
		// Свежие БП
	
		ЗаполнитьЗначенияСвойств(Результат, ОтвЛица.РуководительФИО);
	
	Иначе
		
		// Старые БП
		ФИО = ОсновнойМодуль.ЭДО_Служебные_РазложитьСтрокуВМассивСлов(ОтвЛица.РуководительФИО, " ");
		
		Если ФИО.Количество() >= 3 Тогда
			
			Результат.Фамилия 	= ФИО[0];
			Результат.Имя 		= ФИО[1];
			Результат.Отчество 	= ФИО[2];
			
		ИначеЕсли ВызыватьИсключение Тогда
			
			ВызватьИсключение "Отсутствует ФИО руководителя организации " + Организация;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Должность = ОтвЛица.РуководительДолжностьПредставление;
		
	Возврат Результат;
	
КонецФункции

// Возвращает строку с ФИО подписанта по реквизитам организации
//
// Параметры:
//  РеквизитыПодписанта - Структура - см. ПолучитьРеквизитыПодписантаПоОрганизации1С()
//  ЗначениеПоУмолчанию - Строка - Значение ФИО по умолчанию
// 
// Возвращаемое значение:
//  Строка - ФИО подписанта из структуры РеквизитыОрганизации
//
Функция ФИОПодписантаПоРеквизитамПодписантаОрганизации(РеквизитыПодписанта, ЗначениеПоУмолчанию)
	
	ЧастиФИО = Новый Массив;
	Если РеквизитыПодписанта.Фамилия <> "" Тогда
		ЧастиФИО.Добавить(РеквизитыПодписанта.Фамилия);
	КонецЕсли;
	Если РеквизитыПодписанта.Имя <> "" Тогда
		ЧастиФИО.Добавить(РеквизитыПодписанта.Имя);
	КонецЕсли;
	Если РеквизитыПодписанта.Отчество <> "" Тогда
		ЧастиФИО.Добавить(РеквизитыПодписанта.Отчество);
	КонецЕсли;
	
	Результат = СтрСоединить(ЧастиФИО, " ");
	
	Если Результат = "" Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДокументы1С(ПараметрыОтбора, ВидДокумента1С)

	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	
	Для Каждого Элемент Из ПараметрыОтбора Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Если ВидДокумента1С = "ПоступлениеТоваровУслуг" Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
		|	И ПоступлениеТоваровУслуг.Организация В (&Организация)
		|	И ПоступлениеТоваровУслуг.Контрагент В (&Контрагент)
		|	И ПоступлениеТоваровУслуг.ДатаВходящегоДокумента = &ДатаДокумента
		|	И ПоступлениеТоваровУслуг.НомерВходящегоДокумента = &НомерДокумента";
	
	ИначеЕсли ВидДокумента1С = "ПоступлениеДопРасходов" Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоступлениеДопРасходов.Ссылка
		|ИЗ
		|	Документ.ПоступлениеДопРасходов КАК ПоступлениеДопРасходов
		|ГДЕ
		|	НЕ ПоступлениеДопРасходов.ПометкаУдаления
		|	И ПоступлениеДопРасходов.Организация В (&Организация)
		|	И ПоступлениеДопРасходов.Контрагент В (&Контрагент)
		|	И ПоступлениеДопРасходов.ДатаВходящегоДокумента = &ДатаДокумента
		|	И ПоступлениеДопРасходов.НомерВходящегоДокумента = &НомерДокумента";
		
	ИначеЕсли ВидДокумента1С = "КорректировкаПоступления" Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КорректировкаПоступления.Ссылка
		|ИЗ
		|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
		|ГДЕ
		|	НЕ КорректировкаПоступления.ПометкаУдаления
		|	И КорректировкаПоступления.Организация В (&Организация)
		|	И КорректировкаПоступления.Контрагент В (&Контрагент)
		|	И КорректировкаПоступления.ДатаВходящегоДокумента = &ДатаДокумента
		|	И КорректировкаПоступления.НомерВходящегоДокумента = &НомерДокумента";
		
	ИначеЕсли ВидДокумента1С = "СчетФактураПолученный" Тогда
	
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактураПолученный.Ссылка
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	НЕ СчетФактураПолученный.ПометкаУдаления
		|	И СчетФактураПолученный.Организация В (&Организация)
		|	И СчетФактураПолученный.Контрагент В (&Контрагент)
		|	И СчетФактураПолученный.ДатаВходящегоДокумента = &ДатаДокумента
		|	И СчетФактураПолученный.НомерВходящегоДокумента = &НомерДокумента";
		
		Если ПараметрыОтбора.Свойство("ВидСчетаФактуры") Тогда
			ДополнительноеУсловие = " И СчетФактураПолученный.ВидСчетаФактуры = &ВидСчетаФактуры";
			Запрос.Текст = Запрос.Текст + ДополнительноеУсловие;
		КонецЕсли;
		
	ИначеЕсли ВидДокумента1С = "СчетНаОплатуПоставщика" Тогда
	
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетНаОплатуПоставщика.Ссылка
		|ИЗ
		|	Документ.СчетНаОплатуПоставщика КАК СчетНаОплатуПоставщика
		|ГДЕ
		|	НЕ СчетНаОплатуПоставщика.ПометкаУдаления
		|	И СчетНаОплатуПоставщика.Организация В (&Организация)
		|	И СчетНаОплатуПоставщика.Контрагент В (&Контрагент)
		|	И СчетНаОплатуПоставщика.ДатаВходящегоДокумента = &ДатаДокумента
		|	И СчетНаОплатуПоставщика.НомерВходящегоДокумента = &НомерДокумента";
		
	ИначеЕсли ВидДокумента1С = "АктОРасхожденияхПолученный" Тогда
	
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктОРасхожденияхПолученный.Ссылка
		|ИЗ
		|	Документ.АктОРасхожденияхПолученный КАК АктОРасхожденияхПолученный
		|ГДЕ
		|	НЕ АктОРасхожденияхПолученный.ПометкаУдаления
		|	И АктОРасхожденияхПолученный.Организация В (&Организация)
		|	И АктОРасхожденияхПолученный.Контрагент В (&Контрагент)
		|	И АктОРасхожденияхПолученный.ДатаВходящегоДокумента = &ДатаДокумента
		|	И АктОРасхожденияхПолученный.НомерВходящегоДокумента = &НомерДокумента";
		
	КонецЕсли;

	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		
		РезультатЗапроса = Запрос.Выполнить();

		Если НЕ РезультатЗапроса.Пустой() Тогда
			Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет операцию по умолчанию при создании учетного документа.
//
// Параметры:
//  ТипЭД - Структура - Тип электронного документа (см. Документ.Тип)
// 
// Возвращаемое значение:
//  Строка - Идентификатор операции по умолчанию (см. СписокТиповДокументовДляСоздания).
//  Неопределено - Если не удалось определить тип операциии.
//
Функция ИдентификаторОперацииПоУмолчанию(ТипЭД)
	
	Если ОсновнойМодуль.ЭтоУниверсальныйПередаточныйДокумент(ТипЭД)
		Или ОсновнойМодуль.ЭтоПередаточныйДокумент(ТипЭД) Тогда
		
		Результат = ИдентификаторОперации_ПоступлениеТоваровУслуг();
		
	ИначеЕсли ОсновнойМодуль.ЭтоУниверсальныйКорректировочныйДокумент(ТипЭД)
		Или ОсновнойМодуль.ЭтоСоглашениеОбИзмененииСтоимости(ТипЭД) Тогда
		
		Результат = ИдентификаторОперации_КорректировкаПоступления();
		
	ИначеЕсли ОсновнойМодуль.ЭтоСчетФактура(ТипЭД)
		Или ОсновнойМодуль.ЭтоКорректировочныйСчетФактура(ТипЭД) Тогда
		
		Результат = ИдентификаторОперации_СчетФактураПолученный();
		
	ИначеЕсли ОсновнойМодуль.ЭтоАктОРасхождениях(ТипЭД) Тогда
		
		Результат = ИдентификаторОперации_АктОРасхожденияхПолученный();
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторОперации_ПоступлениеТоваровУслуг()
	Возврат "ПоступлениеТоваровУслуг";
КонецФункции

Функция ИдентификаторОперации_КорректировкаПоступления()
	Возврат "КорректировкаПоступления";
КонецФункции

Функция ИдентификаторОперации_СчетФактураПолученный()
	Возврат "СчетФактураПолученный";
КонецФункции

Функция ИдентификаторОперации_АктОРасхожденияхПолученный()
	Возврат "АктОРасхожденияхПолученный";
КонецФункции

Процедура ПроверитьЗаполнитьИдентификаторОперации(ПараметрыСобытия)
	
	Если ЗначениеЗаполнено(ПараметрыСобытия.ИдентификаторОперации) Тогда
		Возврат;
	КонецЕсли;
	
	ТипЭД = ПараметрыСобытия.Документ.Тип;
	ПараметрыСобытия.ИдентификаторОперации = ИдентификаторОперацииПоУмолчанию(ТипЭД);
	
КонецПроцедуры

Функция ПроверкаДокументаОснования(Документ, ВыбранныйВид)
	
	Результат = ОсновнойМодуль.НовыйРезультатФункции();
	
	Если ВыбранныйВид = "КорректировкаПоступления" Тогда
		
		ТипДокумента		= Документ.Тип.ТипДокумента;
		ФункцияДокумента	= Документ.Тип.ФункцияДокумента;
		Контент				= Документ.Документооборот.ХранилищеКонтента;
		ДвоичныеДанные		= Контент.Данные;
		ДеревоКонтента		= ОсновнойМодуль.XML_В_XDTO(ДвоичныеДанные);
		
		НомерДатаСФ = Неопределено;		
		
		Если ТипДокумента = "UniversalCorrectionDocument" Тогда
			
			НомерДатаСФ = ДеревоКонтента.Документ.СвКСчФ.СчФ;
		
			Если ТипЗнч(НомерДатаСФ) = Тип("СписокXDTO") Тогда
				
				НомерДатаСФ = Неопределено;
				
				Результат.ОписаниеОшибки = "Создание корректировки по нескольким документам-оснований недоступно. Вы можете вручную создать документ в 1С и сопоставить его с текущим документом";
				
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = "UniversalTransferDocumentRevision" Тогда
			
			НомерДатаСФ = ДеревоКонтента.Документ.СвСчФакт;
			
		КонецЕсли;	
		
		Если НомерДатаСФ <> Неопределено Тогда
			
			Если Документ.Тип.ТипКонтента = ТипКонтентаUtd970() Тогда
				НомерОснования = НомерДатаСФ.НомерДок;
				ДатаОснования = ОсновнойМодуль.ДатаXML_в_Дата1С(НомерДатаСФ.ДатаДок);
			Иначе
				НомерОснования = НомерДатаСФ.НомерСчФ;
				ДатаОснования = ОсновнойМодуль.ДатаXML_в_Дата1С(НомерДатаСФ.ДатаСчФ);
            КонецЕсли;

			ДокументОснование = Неопределено;
			
			Идентификаторы = ОсновнойМодуль.ЭДО_Новый_ИдентификаторыСправочника(
					Документ.Получатель.ОрганизацияЭДО, 
					Документ.Получатель.BoxId);
			СопоставленныеОрганизации1С = ОсновнойМодуль.ЭДО_Организации_СопоставленныеВ1С(Идентификаторы);
			
			Идентификаторы = ОсновнойМодуль.ЭДО_Новый_ИдентификаторыСправочника(
					Документ.Отправитель.ОрганизацияЭДО, 
					Документ.Отправитель.BoxId);
			СопоставленныеКонтрагенты1С = ОсновнойМодуль.ЭДО_Контрагенты_СопоставленныеВ1С(Идентификаторы);
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Организация", СопоставленныеОрганизации1С);
			ПараметрыОтбора.Вставить("Контрагент",	СопоставленныеКонтрагенты1С);
			ПараметрыОтбора.Вставить("ДатаДокумента",	ДатаОснования);
			ПараметрыОтбора.Вставить("НомерДокумента",	НомерОснования);
			
			Если ФункцияДокумента = "InvoiceAndBasic" Тогда
				
				ДокументыОснования1С = ПолучитьДокументы1С(ПараметрыОтбора, "СчетФактураПолученный");
				
				Если ДокументыОснования1С <> Неопределено И ДокументыОснования1С.Количество() = 1 
					И ДокументыОснования1С[0].ДокументыОснования.Количество() = 1 Тогда
					ДокументОснование = ДокументыОснования1С[0].ДокументыОснования[0].ДокументОснование;
				КонецЕсли;
				
			ИначеЕсли ФункцияДокумента = "Basic" Тогда
				
				ДокументыОснования1С = ПолучитьДокументы1С(ПараметрыОтбора, "ПоступлениеТоваровУслуг");
				
				Если ДокументыОснования1С = Неопределено Тогда
					ДокументыОснования1С = ПолучитьДокументы1С(ПараметрыОтбора, "ПоступлениеДопРасходов");
				КонецЕсли;
				
				Если ДокументыОснования1С <> Неопределено И ДокументыОснования1С.Количество() = 1 Тогда
					ДокументОснование = ДокументыОснования1С[0];
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДокументОснование = Неопределено Тогда
				
				СоздаватьСчетаФактуры = ОсновнойМодуль.ЭДО_Модуль_ОбщиеНастройки().СоздаватьСчетаФактуры;
								
				Результат.ОписаниеОшибки = "Для корректировки не найден документ-основание №" + НомерОснования + " от " + Формат(ДатаОснования, "ДФ=dd.MM.yyyy");
												
				Если СоздаватьСчетаФактуры = Истина Тогда
					Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ". Создайте счет-фактуру для документа-основания и повторите создание документа";
				Иначе
					Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ". Сопоставьте документ вручную из карточки документа.";
				КонецЕсли;
				
			КонецЕсли;
			
			Результат.ОсновнойОбъект = ДокументОснование;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции			

Функция ЭтоМетаданныеОснованияСчетаФактурыПолученного(ОбъектМетаданных)
	
	МетаданныеОснованийСФ = Метаданные.Документы.СчетФактураПолученный.ВводитсяНаОсновании;
	Результат = МетаданныеОснованийСФ.Содержит(ОбъектМетаданных);
	
	Возврат Результат;
	
КонецФункции

Функция ТребуетсяСоздатьСчетФактуру(ДокументОбъект)
	
	Результат = Ложь;
	
	ОбъектМетаданных = ДокументОбъект.Метаданные();
	
	Если ЭтоМетаданныеОснованияСчетаФактурыПолученного(ОбъектМетаданных) Тогда
		
		Результат = (ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.СчетФактураПолученный"));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьСчетФактуру(ДокументОбъект, Документ, ИспользоватьДатуЭД)
	
	Если ДокументОбъект = Неопределено
		ИЛИ НЕ ТребуетсяСоздатьСчетФактуру(ДокументОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОсновнойМодуль.ЭтоСоглашениеОбИзмененииСтоимости(Документ.Тип) Тогда
		
		ЭлектронныйСФ = ЭлектронныйКорректировочныйСчетФактураПакета(Документ);
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный;
		
	Иначе
		
		ЭлектронныйСФ = ЭлектронныйСчетФактураПакета(Документ);
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаПоступление;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭлектронныйСФ)
		ИЛИ ЗначениеЗаполнено(ЭлектронныйСФ.ДокументУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ВозвратТоваровОтПокупателя") Тогда
		ДокументОбъект.ПокупателемВыставляетсяСчетФактураНаВозврат = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
		ДокументОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	ДокументОбъект.Записать();
	
	ОснованиеСФ = ДокументОбъект.Ссылка;
	
	ДатаДокумента = ТекущаяДатаСеанса();
	Если ИспользоватьДатуЭД Тогда
		ДатаДокумента = ЭлектронныйСФ.Реквизиты.Дата;
	КонецЕсли;
	
	ДокументСФ = Документы.СчетФактураПолученный.СоздатьДокумент();
	
	СтруктураДляСФ = Новый Структура;
	СтруктураДляСФ.Вставить("ДокументОснование", ОснованиеСФ);
	СтруктураДляСФ.Вставить("Основание", ОснованиеСФ);
	СтруктураДляСФ.Вставить("ВидСчетаФактуры", ВидСчетаФактуры);
	
	ДокументСФ.Заполнить(СтруктураДляСФ);
	
	ЭтоИсправлениеСФ = Ядро.Документы_ЭтоИсправительныйСчетФактура(ЭлектронныйСФ.Тип);
	
	Если НЕ ЭтоИсправлениеСФ Тогда
		
		ДокументСФ.ДатаВходящегоДокумента = ЭлектронныйСФ.Реквизиты.Дата;
		ДокументСФ.НомерВходящегоДокумента = ЭлектронныйСФ.Реквизиты.Номер;
		
	КонецЕсли;
	
	ДокументСФ.КодСпособаПолучения = 2;
	ДокументСФ.Дата = ДатаДокумента;
	ДокументСФ.УстановитьНовыйНомер();
	ДокументСФ.ОбменДанными.Загрузка = Истина;
	ДокументСФ.Записать();
	
	Если НЕ ЭлектронныеДокументыРавны(Документ, ЭлектронныйСФ) Тогда
		ОсновнойМодуль.ОбновлениеРеквизитовДокумента(ЭлектронныйСФ.Идентификаторы, ДокументСФ.Ссылка);
		ОсновнойМодуль.ЭДО_ОбновитьКомментарийДокументаУчета(Документ, ДокументСФ);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭлектронныйСчетФактураПакета(Документ)
	
	Результат = Неопределено;
	
	ТипДокумента = Документ.Тип;
	
	Если ОсновнойМодуль.ЭтоУниверсальныйПередаточныйДокумент(ТипДокумента)
		Или ОсновнойМодуль.ЭтоСчетФактура(ТипДокумента) Тогда
		
		Результат = Документ;
		
	Иначе
		
		ТаблицаДокументовПакета = ОсновнойМодуль.Пакеты_ДокументыПакетов(Документ.Идентификаторы);
		
		Для Каждого ДокументПакета Из ТаблицаДокументовПакета Цикл
			
			Если ЭлектронныеДокументыРавны(Документ, ДокументПакета) Тогда
				Продолжить;
			КонецЕсли;
			
			ТипДокументаПакета = ДокументПакета.Тип;
			
			Если ОсновнойМодуль.ЭтоСчетФактура(ТипДокументаПакета) Тогда
				Результат = ДокументПакета;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭлектронныйКорректировочныйСчетФактураПакета(Документ)
	
	Результат = Неопределено;
	
	ТипДокумента = Документ.Тип;
	
	Если ОсновнойМодуль.ЭтоУниверсальныйКорректировочныйДокумент(ТипДокумента)
		Или ОсновнойМодуль.ЭтоКорректировочныйСчетФактура(ТипДокумента) Тогда
		
		Результат = Документ;
		
	Иначе
		
		ТаблицаДокументовПакета = ОсновнойМодуль.Пакеты_ДокументыПакетов(Документ.Идентификаторы);
		
		Для Каждого ДокументПакета Из ТаблицаДокументовПакета Цикл
			
			Если ЭлектронныеДокументыРавны(Документ, ДокументПакета) Тогда
				Продолжить;
			КонецЕсли;
			
			ТипДокументаПакета = ДокументПакета.Тип;
			
			Если ОсновнойМодуль.ЭтоКорректировочныйСчетФактура(ТипДокументаПакета) Тогда
				Результат = ДокументПакета;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОбновитьКомментарийДокументаУчета(Параметры)
	
	Документ = Параметры.Документ;
	
	ДокументУчета		= Документ.ДокументУчета;
	ФункцияДокумента	= Документ.Тип.ФункцияДокумента;
	    	
	ДобавляемыйКомментарий = Параметры.Комментарий;
	
	Если Параметры.ДокументОбъект = Неопределено Тогда
		Документ1С = ДокументУчета;
	Иначе
		Документ1С = Параметры.ДокументОбъект;
	КонецЕсли;

	// меняем комментарий в самом документе
	ОсновнойМодуль.ЭДО_ОбновитьКомментарийДокумента1С(Документ1С, ДобавляемыйКомментарий);

	// далее при необходимости поменяем комментарий в документах-основаниях
	ЭтоПолныйУПД_УКД = ФункцияДокумента = "СЧФДОП" ИЛИ ФункцияДокумента = "КСЧФДИС"; 
	
	ЭтоСФ = ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.СчетФактураВыданный")
			ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.СчетФактураПолученный");
	
	Если ЭтоПолныйУПД_УКД И ЭтоСФ Тогда
		
		Для Каждого СтрокаОснование Из ДокументУчета.ДокументыОснования Цикл
			ОсновнойМодуль.ЭДО_ОбновитьКомментарийДокумента1С(СтрокаОснование.ДокументОснование, ДобавляемыйКомментарий);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

