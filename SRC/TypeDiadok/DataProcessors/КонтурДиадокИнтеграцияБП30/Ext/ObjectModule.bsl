#Область АктCверки405_ТекстыЗапросов

Функция ТекстЗапроса_АктСверки405Шапка()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДокумент.Номер КАК Номер,
	|	ТаблицаДокумент.Дата КАК Дата,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ТаблицаДокумент.Контрагент КАК Контрагент,
	|	ТаблицаДокумент.ВалютаДокумента КАК ВалютаДокумента,
	|	ТаблицаДокумент.ДатаНачала КАК ДатаНачала,
	|	ТаблицаДокумент.ДатаОкончания КАК ДатаОкончания,
	|	ТаблицаДокумент.ОстатокНаНачало КАК ОстатокНаНачало,
	|	ЕСТЬNULL(Валюты.Код, ""643"") КАК КодВалюты
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов КАК ТаблицаДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ТаблицаДокумент.ВалютаДокумента = Валюты.Ссылка
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_АктСверки405Итоги()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
