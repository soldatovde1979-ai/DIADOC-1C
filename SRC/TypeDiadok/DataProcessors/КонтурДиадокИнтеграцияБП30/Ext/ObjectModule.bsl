		Шапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		Шапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		Шапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		Шапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
		
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = Запись.НоменклатураНаименование;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_ОтчетКомитентуОПродажах(Шапка, ТабличнаяЧасть, ДокументПродажи)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДанныеДокумента.ДоговорКонтрагента.УчетАгентскогоНДС, ЛОЖЬ) КАК УчетАгентскогоНДС,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.УслугаПоВознаграждению КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.УслугаПоВознаграждению = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ""Комиссионное вознаграждение""
	|		КОГДА ПОДСТРОКА(ДанныеДокумента.УслугаПоВознаграждению.НаименованиеПолное, 1, 10) = """"
	|			ТОГДА ДанныеДокумента.УслугаПоВознаграждению.Наименование
	|		ИНАЧЕ ДанныеДокумента.УслугаПоВознаграждению.НаименованиеПолное
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	ДанныеДокумента.УслугаПоВознаграждению.Артикул КАК НоменклатураАртикул,
	|	ДанныеДокумента.УслугаПоВознаграждению.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.СуммаВознаграждения КАК Цена,
	|	1 КАК Количество,
	|	ДанныеДокумента.СуммаВознаграждения КАК Сумма,
	|	ДанныеДокумента.СтавкаНДСВознаграждения КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.СтавкаНДСВознаграждения = &СтавкаБезНДС
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДокументБезНДС
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументПродажи);
	Запрос.УстановитьПараметр("СтавкаБезНДС", Перечисления.СтавкиНДС.БезНДС);
	
	ДанныеШапки = Запрос.Выполнить().Выгрузить()[0];
	
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	ДатаДокумента = ДанныеШапки.Дата;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	Шапка.Номер = НомерДокумента;
	Шапка.Дата = ДатаДокумента;
	Шапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	Шапка.УчитыватьНДС = Не ДанныеШапки.ДокументБезНДС;
	Шапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	Шапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	Шапка.Валюта = ДанныеШапки.Валюта;
	Шапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	Шапка.Продавец = ДанныеШапки.Организация;
	Шапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	Шапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	Шапка.Покупатель = ДанныеШапки.Контрагент;
	Шапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	Шапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	Шапка.РуководительФИО = БП30_РуководительФамилияИО(ДанныеШапки.Организация, ДатаДокумента);
	
	Если ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетОрганизации) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(ДанныеШапки.БанковскийСчетОрганизации);
		
		Шапка.ПродавецБанк = РеквизитыСчета.Банк;
		Шапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		Шапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		Шапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		Шапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
		
	НоваяСтрока = ТабличнаяЧасть.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеШапки);
	
	НоваяСтрока.НоменклатураПредставление = ДанныеШапки.НоменклатураНаименование;
	НоваяСтрока.СуммаНДС = РассчитатьСуммуНДС(
		ДанныеШапки.Сумма,
		ДанныеШапки.СуммаВключаетНДС,
		ДанныеШапки.СтавкаНДС
	);
		
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьДанные_ДокументПродажи_НачислениеАренднойПлаты(Шапка, ТабличнаяЧасть, ДокументПродажи)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(ДанныеДокумента.ДоговорКонтрагента.УчетАгентскогоНДС, ЛОЖЬ) КАК УчетАгентскогоНДС,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.АР_НачислениеАренднойПлаты КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	&ПолеСодержаниеУслуги КАК СодержаниеУслуги,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	ДанныеДокумента.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.АР_НачислениеАренднойПлаты.Состав КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	ПсевдонимТаблицы = "ДанныеДокумента";
	
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(
		ТекстЗапроса,
		ПсевдонимТаблицы
	);
	
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(
		ТекстЗапроса,
		ПсевдонимТаблицы
	);
	
	ЗаполнитьВыражениеЗапросаСодержаниеУслуги(
		ТекстЗапроса,
		ПсевдонимТаблицы
	);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументПродажи);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	Шапка.Номер = НомерДокумента;
	Шапка.Дата = ДатаДокумента;
	Шапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	Шапка.УчитыватьНДС = Не НачислениеАренднойПлатыБезНДС(ДокументПродажи);
	Шапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	Шапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	Шапка.Валюта = ДанныеШапки.Валюта;
	Шапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	Шапка.Продавец = ДанныеШапки.Организация;
	Шапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	Шапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	Шапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	Шапка.Покупатель = ДанныеШапки.Контрагент;
	Шапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	Шапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	Шапка.РуководительФИО = БП30_РуководительФамилияИО(ДанныеШапки.Организация, ДатаДокумента);
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		Шапка.ПродавецБанк = РеквизитыСчета.Банк;
		Шапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		Шапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		Шапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		Шапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатуры(
			Запись.НоменклатураНаименование,
			Запись.СодержаниеУслуги
		);
		
	КонецЦикла;
	
КонецПроцедуры

// Получает реквизиты участника сделки с учетом истории изменения и настроек
//
// Параметры:
//  Участник - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - участник сделки
//  ДатаСведений - Дата - дата, на которую нужно получить реквизиты
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - значения реквизитов:
//    * ПолноеНаименование - Строка - Общество с ограниченной ответственностью "Ромашка"
//    * СокращенноеНаименование - Строка - ООО "Ромашка"
//    * НаименованиеДляПечатныхФорм - Строка - Полное или сокращенное наименование (определяется настройкой организации)
//    * ИНН - Строка - ИНН участника
//    * КПП - Строка - КПП участника
//    * Телефоны - Строка - Телефоны участника
//    * ЮридическийАдрес - Строка - Юридический адрес участника
//
Функция СчетаНаОплату_ДанныеЮрФизЛица(Участник, ДатаСведений)
	
	Модель = Новый Структура;
	Модель.Вставить("ПолноеНаименование", "");
	Модель.Вставить("СокращенноеНаименование", "");
	Модель.Вставить("НаименованиеДляПечатныхФорм", "");
	Модель.Вставить("ИНН", "");
	Модель.Вставить("КПП", "");
	Модель.Вставить("Телефоны", "");
	Модель.Вставить("ЮридическийАдрес", "");
	
	МодульОбменСКонтрагентамиБП = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиБП");
	
	Данные = МодульОбменСКонтрагентамиБП.ПолучитьДанныеЮрФизЛица(Участник, ДатаСведений);
	
	Модель.ПолноеНаименование = Данные.ПолноеНаименование;
	Модель.СокращенноеНаименование = Данные.СокращенноеНаименование;
	Модель.НаименованиеДляПечатныхФорм = Данные.НаименованиеДляПечатныхФорм;
	Модель.ИНН = Данные.ИНН;
	Модель.КПП = Данные.КПП;
	Модель.Телефоны = Данные.Телефоны;
	Модель.ЮридическийАдрес = Данные.ЮридическийАдрес;
	
	Если ТипЗнч(Участник) = Тип("СправочникСсылка.Контрагенты") Тогда
		// функция Справочники.Контрагенты.НаименованияНаДату возвращает
		// наименование элемента, а не официальное наименование
		Модель.СокращенноеНаименование = Модель.НаименованиеДляПечатныхФорм;
	КонецЕсли;
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_ПредставлениеЮрФизЛица(РеквизитыЮрФизЛица)
	
	Результат = РеквизитыЮрФизЛица.НаименованиеДляПечатныхФорм;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = РеквизитыЮрФизЛица.СокращенноеНаименование;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует строку с наименованием и реквизитами юридического или физического лица
//
// Параметры:
//   Реквизиты - Структура - см. СчетаНаОплату_ДанныеЮрФизЛица
//
// Возвращаемое значение:
//   Строка - строковое представление реквизитов
//
Функция СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(Реквизиты)
	
	ШаблонПредставления = "СокращенноеНаименование,ИНН,КПП,ЮридическийАдрес,Телефоны";
	Результат = ПредставлениеЮрФизЛицаСлужебный(Реквизиты, ШаблонПредставления);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеЮрФизЛицаСлужебный(Реквизиты, ШаблонПредставления)
	
	Перем Префикс, СтрокаДополнения;
	
	СоответствиеПараметров = Новый Структура;
	СоответствиеПараметров.Вставить("ПолноеНаименование", " ");
	СоответствиеПараметров.Вставить("СокращенноеНаименование", " ");
	СоответствиеПараметров.Вставить("НаименованиеДляПечатныхФорм", " ");
	СоответствиеПараметров.Вставить("ИНН", " ИНН ");
	СоответствиеПараметров.Вставить("КПП", " КПП ");
	СоответствиеПараметров.Вставить("Свидетельство", " ");
	СоответствиеПараметров.Вставить("СвидетельствоДатаВыдачи", " от ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес", " ");
	СоответствиеПараметров.Вставить("ФактическийАдрес", " ");
	СоответствиеПараметров.Вставить("Телефоны", " тел.: ");
	СоответствиеПараметров.Вставить("Факс", " факс: ");
	СоответствиеПараметров.Вставить("НомерСчета", " р/с ");
	СоответствиеПараметров.Вставить("Банк", " в банке ");
	СоответствиеПараметров.Вставить("БИК", " БИК ");
	СоответствиеПараметров.Вставить("КоррСчет", " к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО", " Код по ОКПО ");
	
	ПропускатьПустыеСтроки = Истина;
	Разделитель = ",";
	СписокПараметров = СтрРазделить(
		ШаблонПредставления,
		Разделитель,
		ПропускатьПустыеСтроки
	);
	
	Результат = Новый Массив;
	
	Для Каждого ИмяПараметра Из СписокПараметров Цикл
		
		Если Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения) Тогда
			
			Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения);
			Если ПустаяСтрока(СтрокаДополнения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СоответствиеПараметров.Свойство(ИмяПараметра, Префикс) Тогда
				Результат.Добавить(Префикс + СтрокаДополнения);
			Иначе
				Результат.Добавить(СтрокаДополнения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаРезультата = СтрСоединить(Результат, ",");
	СтрокаРезультата = СтрЗаменить(СтрокаРезультата, "  ", " ");
	
	Возврат СокрЛП(СтрокаРезультата);
	
КонецФункции

Функция СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента)
	
	Результат = СтрШаблон(
		"Счет на оплату № %1 от %2",
		НомерДокумента,
		Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")
	);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТаблицы = "ДанныеДокумента")
	
	ЗначениеКонстанты = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	
	Если ЗначениеКонстанты = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
		Выражение = "ЕСТЬNULL(ПсевдонимТаблицы.Номенклатура.Артикул, """")";
	ИначеЕсли ЗначениеКонстанты = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Код Тогда
		Выражение = "ЕСТЬNULL(ПсевдонимТаблицы.Номенклатура.Код, """")";
	Иначе
		Выражение = """""";
	КонецЕсли;
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Выражение, ПсевдонимТаблицы);
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ПолеНоменклатураАртикул",
		Выражение
	);
	
КонецПроцедуры

Процедура ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТаблицы = "ДанныеДокумента")
	
	Выражение = 
	"ВЫБОР
	|		КОГДА НЕ (ПсевдонимТаблицы.Номенклатура.НаименованиеПолное ПОДОБНО """")
	|			ТОГДА ПсевдонимТаблицы.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ПсевдонимТаблицы.Номенклатура.Наименование
	|	КОНЕЦ";
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Выражение, ПсевдонимТаблицы);
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ПолеНоменклатураНаименование",
		Выражение
	);
	
КонецПроцедуры

Процедура ЗаполнитьВыражениеЗапросаСодержаниеУслуги(ТекстЗапроса, ПсевдонимТаблицы = "ДанныеДокумента")
	
	Выражение = 
	"ВЫБОР
	|		КОГДА НЕ (ПсевдонимТаблицы.Содержание ПОДОБНО """")
	|			ТОГДА ПсевдонимТаблицы.Содержание
	|		КОГДА НЕ (ПсевдонимТаблицы.Номенклатура.НаименованиеПолное ПОДОБНО """")
	|			ТОГДА ПсевдонимТаблицы.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ПсевдонимТаблицы.Номенклатура.Наименование
	|	КОНЕЦ";
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Выражение, ПсевдонимТаблицы);
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ПолеСодержаниеУслуги",
		Выражение
	);
	
КонецПроцедуры

Процедура ЗаполнитьВыражениеЗапросаАдресДоставкиЗначение(ТекстЗапроса, МетаданныеДокумента)
	
	ВыражениеТекстаЗапроса = """""";
	
	ЕстьАдресДоставкиВJSON = ЕстьРеквизитОбъектаЛок("АдресДоставкиЗначение", МетаданныеДокумента);
	
	Если ЕстьАдресДоставкиВJSON Тогда
		ВыражениеТекстаЗапроса = "Шапка.АдресДоставкиЗначение";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&АдресДоставкиЗначение", ВыражениеТекстаЗапроса);
	
КонецПроцедуры

Процедура ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Выражение, ПсевдонимТаблицы)
	
	ПодстрокаПоиска = "ПсевдонимТаблицы";
	Если Не ЗначениеЗаполнено(ПсевдонимТаблицы) Тогда
		ПодстрокаПоиска = ПодстрокаПоиска + ".";
	КонецЕсли;
	
	Выражение = СтрЗаменить(Выражение, ПодстрокаПоиска, ПсевдонимТаблицы);
	
КонецПроцедуры

