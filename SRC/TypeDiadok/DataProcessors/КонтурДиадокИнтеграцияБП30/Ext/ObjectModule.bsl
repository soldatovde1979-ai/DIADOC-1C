		|	И ТаблицаДокумент.СпособРасчетаКомиссионногоВознаграждения <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается)
		|	И ОтправленныеДокументы.Документ ЕСТЬ NULL
		|	И ВТКэшКонтрагентовПоВидамПакетов.ОтправлятьНепроведенные
		|	И ВТКэшКонтрагентовПоВидамДокументов.ВидДокументаID = &ВидДокументаID
		|	И ВТКэшКонтрагентовПоВидамДокументов.ФормироватьНаОсновании = &ЗначениеНастройкиФормироватьНаОсновании
		|	И ТаблицаДокумент.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ТаблицаДокумент.ПометкаУдаления";
	
	Результат = СтрЗаменить(Результат, "&ВидПакетаID", """" + ВидПакетаID + """");
	
	ВидДокументаID = ВидДокументаIDПоВидуПакетаID(ВидПакетаID);
	Результат = СтрЗаменить(Результат, "&ВидДокументаID", """" + ВидДокументаID + """");
	Результат = СтрЗаменить(Результат, "&ЗначениеНастройкиФормироватьНаОсновании", """" + "ДокументПродажи" + """");
	
	Результат = ТекстЗапроса_СкорректированныеСвязиДляОтправленныхДокументов(Результат, ОписаниеВидаПакета);
	
