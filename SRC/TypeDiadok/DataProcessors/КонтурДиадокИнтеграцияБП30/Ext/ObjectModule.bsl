#Область СчетНаОплату29

Функция СчетФНС29(СсылкаНаОбъект) Экспорт
	
	ТипПараметра = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипПараметра = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		Контент = Счет29_СчетНаОплату(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Контент = Счет29_РеализацияТоваровУслуг(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.РеализацияУслугПоПереработке") Тогда
		Контент = Счет29_РеализацияУслугПоПереработке(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Контент = Счет29_КорректировкаРеализации(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		Контент = Счет29_АктОбОказанииПроизводственныхУслуг(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ПередачаОС") Тогда
		Контент = Счет29_ПередачаОС(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		Контент = Счет29_ОтчетКомитенту(СсылкаНаОбъект);
	ИначеЕсли ЭтоСчетНаАренду(СсылкаНаОбъект) Тогда
		Контент = Счет29_СчетНаАренду(СсылкаНаОбъект);
	ИначеЕсли ЭтоНачислениеАренднойПлаты(СсылкаНаОбъект) Тогда
		Контент = Счет29_НачислениеАренды(СсылкаНаОбъект);
	Иначе
		Ошибка = СтрШаблон("Неожиданный тип документа (%1)", ТипЗнч(СсылкаНаОбъект));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат Контент;
	
КонецФункции

#КонецОбласти

#Область Счет29_ЗаполнениеЭлементовПротоструктуры

Функция Счет29_СчетНаОплату(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.ОрганизацияПолучатель КАК ОрганизацияПолучатель,
	|	Шапка.СтруктурнаяЕдиница КАК БанковскийСчетПолучателя,
	|	Шапка.СуммаСкидки КАК СуммаСкидки,
	|	Шапка.СсылочныйИдентификатор КАК СсылочныйИдентификатор,
	|	ЕСТЬNULL(Шапка.ДополнительныеУсловия.ТекстУсловий, """") КАК ДополнительныеУсловия
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ТЧ.Содержание КАК НоменклатураСодержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТЧ.Номенклатура.Услуга, ИСТИНА)
	|			ТОГДА &ТипНоменклатурыУслуга
	|		ИНАЧЕ &ТипНоменклатурыТовар
	|	КОНЕЦ КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.Сумма КАК СуммаИсходная,
	|	ТЧ.СуммаСкидки КАК СуммаСкидки,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	ПсевдонимТабличнойЧасти = "ТЧ";
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", ТипыНоменклатуры.Услуга);
	Запрос.УстановитьПараметр("ТипНоменклатурыТовар", ТипыНоменклатуры.Имущество);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	ТаблицаДокумента.Колонки.Добавить("СуммаБезНДСБезСкидки");
	ТаблицаДокумента.Колонки.Добавить("СуммаНДСБезСкидки");
	ТаблицаДокумента.Колонки.Добавить("СуммаВсегоБезСкидки");
	ТаблицаДокумента.ЗагрузитьКолонку(ТаблицаДокумента.ВыгрузитьКолонку("СуммаБезНДС"), "СуммаБезНДСБезСкидки");
	ТаблицаДокумента.ЗагрузитьКолонку(ТаблицаДокумента.ВыгрузитьКолонку("СуммаНДС"), "СуммаНДСБезСкидки");
	ТаблицаДокумента.ЗагрузитьКолонку(ТаблицаДокумента.ВыгрузитьКолонку("СуммаВсего"), "СуммаВсегоБезСкидки");
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	Если ЗначениеЗаполнено(ДанныеШапки.СсылочныйИдентификатор) Тогда
		Content.ProformaInvoiceAdditionalInfo.UniquePaymentInfo = ДанныеШапки.СсылочныйИдентификатор;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ДополнительныеУсловия) Тогда
		УсловияОплаты = СокрЛП(ДанныеШапки.ДополнительныеУсловия);
		Content.ProformaInvoiceAdditionalInfo.PaymentTerms.Добавить(УсловияОплаты);
	КонецЕсли;
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	
	Если ДанныеШапки.СуммаСкидки <> 0 Тогда
		
		Счет29_РаспределитьСкидкуПоСтрокамТабличнойЧасти(ТаблицаДокумента, ДанныеШапки.СуммаСкидки);
		
		Content.Table = Счет29_НовыйTableWithDiscount(ТаблицаДокумента, ЭтоНДСИНА);
		
	ИначеЕсли ТаблицаДокумента.Итог("СуммаСкидки") <> 0 Тогда
		
		ТочностьОкругления = 2;
		
		Для Каждого Стр Из ТаблицаДокумента Цикл
			
			Если Стр.СуммаСкидки = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДанныеШапки.СуммаВключаетНДС Тогда
				
				Стр.СуммаВсегоБезСкидки = Стр.СуммаИсходная;
				Стр.СуммаВсего = Стр.СуммаВсегоБезСкидки - Стр.СуммаСкидки;
				
				Стр.СуммаНДСБезСкидки = РассчитатьСуммуНДС(Стр.СуммаВсегоБезСкидки, Истина, Стр.СтавкаНДС);
				Стр.СуммаНДСБезСкидки = Окр(Стр.СуммаНДСБезСкидки, ТочностьОкругления);
				
				Стр.СуммаБезНДС = Стр.СуммаВсего - Стр.СуммаНДС;
				Стр.СуммаБезНДСБезСкидки = Стр.СуммаВсегоБезСкидки - Стр.СуммаНДСБезСкидки;
				
			Иначе
				
				Стр.СуммаБезНДСБезСкидки = Стр.СуммаИсходная;
				Стр.СуммаБезНДС = Стр.СуммаБезНДСБезСкидки - Стр.СуммаСкидки;
				
				Стр.СуммаНДСБезСкидки = РассчитатьСуммуНДС(Стр.СуммаБезНДСБезСкидки, Ложь, Стр.СтавкаНДС);
				Стр.СуммаНДСБезСкидки = Окр(Стр.СуммаНДСБезСкидки, ТочностьОкругления);
				
				Стр.СуммаВсего = Стр.СуммаБезНДС + Стр.СуммаНДС;
				Стр.СуммаВсегоБезСкидки = Стр.СуммаБезНДСБезСкидки + Стр.СуммаНДСБезСкидки;
				
				Стр.СуммаСкидки = Стр.СуммаВсегоБезСкидки - Стр.СуммаВсего;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Content.Table = Счет29_НовыйTableWithDiscount(ТаблицаДокумента, ЭтоНДСИНА);
		
	Иначе
		Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	КонецЕсли;
	
	Возврат Content;
	
КонецФункции

Функция Счет29_РеализацияТоваровУслуг(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.ВидОперации КАК ВидОперации,
	|	Шапка.ПериодНачалаРабот КАК ДатаНачала,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.Грузоотправитель КАК Грузоотправитель,
	|	Шапка.Грузополучатель КАК Грузополучатель,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.БанковскийСчетОрганизации КАК БанковскийСчетПолучателя,
	|	Шапка.АдресДоставки КАК АдресДоставки,
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	"""" КАК НоменклатураСодержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ТипНоменклатурыТовар КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Ссылка КАК Ссылка,
	|	0 КАК ПорядокТЧ,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	&ПолеНоменклатураНаименование,
	|	ТЧ.Содержание,
	|	&ПолеНоменклатураАртикул,
	|	&ТипНоменклатурыУслуга,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """"),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """"),
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ,
	|	ТЧ.СтавкаНДС,
	|	ТЧ.Ссылка,
	|	1,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	&ПолеНоменклатураНаименование,
	|	ТЧ.Содержание,
	|	&ПолеНоменклатураАртикул,
	|	&ТипНоменклатурыУслуга,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """"),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """"),
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ,
	|	ТЧ.СтавкаНДС,
	|	ТЧ.Ссылка,
	|	2,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.АгентскиеУслуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	ПсевдонимТабличнойЧасти = "ТЧ";
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаАдресДоставкиЗначение(ТекстЗапроса, Метаданные.Документы.РеализацияТоваровУслуг);
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", ТипыНоменклатуры.Услуга);
	Запрос.УстановитьПараметр("ТипНоменклатурыТовар", ТипыНоменклатуры.Имущество);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	ЕстьТовары = Не Счет29_СодержитТолькоУслуги(ТаблицаДокумента);
	Если ЕстьТовары Тогда
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
			Content.Shipper = Счет29_НовыйOrganizationInfoСФактическимАдресом(
				ДанныеШапки.Грузоотправитель,
				ДанныеШапки.Дата
			);
		КонецЕсли;
		
		
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
			СведенияОбАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
				ДанныеШапки.АдресДоставки,
				ДанныеШапки.АдресДоставкиЗначение
			);
			Content.Consignee = Счет29_НовыйOrganizationInfoСФактическимАдресом(
				ДанныеШапки.Грузополучатель,
				ДанныеШапки.Дата,
				СведенияОбАдресеДоставки
			);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ДатаНачала) Тогда
		Content.ProformaInvoiceAdditionalInfo.StartShipmentDate = ДанныеШапки.ДатаНачала;
	КонецЕсли;
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	
	Возврат Content;
	
КонецФункции

Функция Счет29_РеализацияУслугПоПереработке(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетПолучателя
	|ИЗ
	|	Документ.РеализацияУслугПоПереработке КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ТЧ.Содержание КАК НоменклатураСодержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ТипНоменклатурыУслуга КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Ссылка КАК Ссылка,
	|	0 КАК ПорядокТЧ,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.РеализацияУслугПоПереработке.Услуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	ПсевдонимТабличнойЧасти = "ТЧ";
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", ТипыНоменклатуры.Услуга);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	
	Возврат Content;
	
КонецФункции

Функция Счет29_КорректировкаРеализации(СсылкаНаОбъект)
	
	Если Не ЭтоИсправлениеРеализации(СсылкаНаОбъект) Тогда
		Ошибка = "Формирование счетов на оплату поддерживается только для 
		|корректировок реализации с видом 'Исправление'";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.ВидОперации КАК ВидОперации,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.Грузоотправитель КАК Грузоотправитель,
	|	Шапка.Грузополучатель КАК Грузополучатель,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	ЕСТЬNULL(КурсыВалютНаДату.Курс, 1) КАК Курс,
	|	ЕСТЬNULL(КурсыВалютНаДату.Кратность, 1) КАК Кратность,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.БанковскийСчетОрганизации КАК БанковскийСчетПолучателя,
	|	Шапка.АдресДоставки КАК АдресДоставки,
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение
	|ИЗ
	|	Документ.КорректировкаРеализации КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаДокумента, Валюта = &ВалютаДокумента) КАК КурсыВалютНаДату
	|		ПО Шапка.ВалютаДокумента = КурсыВалютНаДату.Валюта
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	"""" КАК НоменклатураСодержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ТипНоменклатурыТовар КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Ссылка КАК Ссылка,
	|	0 КАК ПорядокТЧ,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	&ПолеНоменклатураНаименование,
	|	ТЧ.Содержание,
	|	&ПолеНоменклатураАртикул,
	|	&ТипНоменклатурыУслуга,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """"),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """"),
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ,
	|	ТЧ.СтавкаНДС,
	|	ТЧ.Ссылка,
	|	1,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.КорректировкаРеализации.Услуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Номенклатура,
	|	&ПолеНоменклатураНаименование,
	|	ТЧ.Содержание,
	|	&ПолеНоменклатураАртикул,
	|	&ТипНоменклатурыУслуга,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """"),
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """"),
	|	ТЧ.Количество,
	|	ТЧ.Цена,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ,
	|	ТЧ.СтавкаНДС,
	|	ТЧ.Ссылка,
	|	2,
	|	ТЧ.НомерСтроки
	|ИЗ
	|	Документ.КорректировкаРеализации.АгентскиеУслуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	ПсевдонимТабличнойЧасти = "ТЧ";
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаАдресДоставкиЗначение(ТекстЗапроса, Метаданные.Документы.КорректировкаРеализации);
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	РеквизитыДокумента = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, "Дата, ВалютаДокумента");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДатаДокумента", РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("ВалютаДокумента", РеквизитыДокумента.ВалютаДокумента);
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", ТипыНоменклатуры.Услуга);
	Запрос.УстановитьПараметр("ТипНоменклатурыТовар", ТипыНоменклатуры.Имущество);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	ЕстьТовары = Не Счет29_СодержитТолькоУслуги(ТаблицаДокумента);
	Если ЕстьТовары Тогда
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
			Content.Shipper = Счет29_НовыйOrganizationInfoСФактическимАдресом(
				ДанныеШапки.Грузоотправитель,
				ДанныеШапки.Дата
			);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
			СведенияОбАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
				ДанныеШапки.АдресДоставки,
				ДанныеШапки.АдресДоставкиЗначение
			);
			Content.Consignee = Счет29_НовыйOrganizationInfoСФактическимАдресом(
				ДанныеШапки.Грузополучатель,
				ДанныеШапки.Дата,
				СведенияОбАдресеДоставки
			);
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	
	Возврат Content;
	
КонецФункции

Функция Счет29_АктОбОказанииПроизводственныхУслуг(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетПолучателя
	|ИЗ
	|	Документ.АктОбОказанииПроизводственныхУслуг КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	"""" КАК НоменклатураСодержание,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ТипНоменклатурыУслуга КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Ссылка КАК Ссылка,
	|	0 КАК ПорядокТЧ,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.АктОбОказанииПроизводственныхУслуг.Услуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	ПсевдонимТабличнойЧасти = "ТЧ";
	ЗаполнитьВыражениеЗапросаНоменклатураАртикул(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	ЗаполнитьВыражениеЗапросаНоменклатураНаименование(ТекстЗапроса, ПсевдонимТабличнойЧасти);
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", ТипыНоменклатуры.Услуга);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	
	Возврат Content;
	
КонецФункции

Функция Счет29_ПередачаОС(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Шапка.Ссылка КАК Документ,
	|	Шапка.Организация КАК Организация,
	|	Шапка.Контрагент КАК Контрагент,
	|	Шапка.Грузоотправитель КАК Грузоотправитель,
	|	Шапка.Грузополучатель КАК Грузополучатель,
	|	Шапка.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЕСТЬNULL(Шапка.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Шапка.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(Шапка.ВалютаДокумента.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	Шапка.КурсВзаиморасчетов КАК Курс,
	|	Шапка.КратностьВзаиморасчетов КАК Кратность,
	|	Шапка.Организация КАК ОрганизацияПолучатель,
	|	Шапка.Организация.ОсновнойБанковскийСчет КАК БанковскийСчетПолучателя
	|ИЗ
	|	Документ.ПередачаОС КАК Шапка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.ОсновноеСредство КАК Номенклатура,
	|	ЕСТЬNULL(ТЧ.ОсновноеСредство.НаименованиеПолное, """") КАК НоменклатураНаименование,
	|	"""" КАК НоменклатураСодержание,
	|	"""" КАК НоменклатураАртикул,
	|	&ТипНоменклатурыТовар КАК НоменклатураТип,
	|	ЕСТЬNULL(ТЧ.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТЧ.ЕдиницаИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТЧ.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма - ТЧ.СуммаНДС
	|		ИНАЧЕ ТЧ.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТЧ.Сумма
	|		ИНАЧЕ ТЧ.Сумма + ТЧ.СуммаНДС
	|	КОНЕЦ КАК СуммаВсего,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.Ссылка КАК Ссылка,
	|	0 КАК ПорядокТЧ,
	|	ТЧ.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.ПередачаОС.ОС КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипНоменклатурыТовар", ТипыНоменклатуры.Имущество);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатыЗапроса[1].Выгрузить();
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
		Content.Shipper = Счет29_НовыйOrganizationInfoСФактическимАдресом(
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата
		);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		Content.Consignee = Счет29_НовыйOrganizationInfoСФактическимАдресом(
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата
		);
	КонецЕсли;
	
	ЭтоНДСИНА = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	Content.Table = Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА);
	
	Возврат Content;
	
