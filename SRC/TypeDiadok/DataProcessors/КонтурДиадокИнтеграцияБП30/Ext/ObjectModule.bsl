Функция ПолучитьВидДоговораПоДокументу(Знач ДокСсылка)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ДокСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
		
	Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ДокСсылка = ДокументОснованиеСчетаФактурыВыданный(ДокСсылка);
	КонецЕсли; 
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДоговорКонтрагента", ДокСсылка.Метаданные()) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокСсылка, "ДоговорКонтрагента.ВидДоговора");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

