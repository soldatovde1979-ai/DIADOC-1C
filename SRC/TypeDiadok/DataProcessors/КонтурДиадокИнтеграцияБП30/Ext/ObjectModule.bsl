Функция СсылочноеЗначениеСвойстваИсточникаДанных(ИсточникДанных, КаноничноеИмяСвойства)
	
	Результат = Неопределено;
	
	ПроверяемыеСвойства = Новый Массив;
	ПроверяемыеСвойства.Добавить(КаноничноеИмяСвойства);
	ПроверяемыеСвойства.Добавить(КаноничноеИмяСвойства + "Ссылка");
	
	Для Каждого ИмяСвойства Из ПроверяемыеСвойства Цикл 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ИсточникДанных, ИмяСвойства)
		И ОбщегоНазначения.ЗначениеСсылочногоТипа(ИсточникДанных[ИмяСвойства]) Тогда 
			
			Результат = ИсточникДанных[ИмяСвойства];
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОснованияОтгрузкиПоДокументуОснования(ОснованиеОтгрузки, Документ)
	
	Если ЭтоСчетФактураВыданный(Документ) Тогда
		ДокументОснование = ЗначениеРеквизитаОбъектаЛок(Документ, "ДокументОснование");
	Иначе
		ДокументОснование = Документ;
	КонецЕсли;
		
	ЕстьРеквизитДоговорКонтрагента = ЕстьРеквизитОбъектаЛок(
		"ДоговорКонтрагента",
		ДокументОснование.Метаданные());
	
	ОснованиеОтгрузки.Основание = "Без договора";
	Если ЕстьРеквизитДоговорКонтрагента Тогда
		
		Реквизиты = Новый Массив;
		Реквизиты.Добавить("ДоговорКонтрагента");
		Реквизиты.Добавить("ДоговорКонтрагента.Номер");
		Реквизиты.Добавить("ДоговорКонтрагента.Дата");
		Реквизиты.Добавить("ДоговорКонтрагента.Наименование");
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
				
				Если ЭтоСчетФактураВыданный(ДокументОснование.ДокументРеализации) Тогда
					Основание = ДокументОснование.ДокументРеализации.ДокументОснование;
				Иначе
					Основание = ДокументОснование.ДокументРеализации;
				КонецЕсли;
				
			ДанныеДоговора = ЗначенияРеквизитовОбъектаЛок(Основание, Реквизиты);
			
		Иначе
			
			ДанныеДоговора = ЗначенияРеквизитовОбъектаЛок(ДокументОснование, Реквизиты);
			
		КонецЕсли;
		
		ОснованиеОтгрузки.ОснованиеНомер = ДанныеДоговора.ДоговорКонтрагентаНомер;
		ОснованиеОтгрузки.ОснованиеДата = ДанныеДоговора.ДоговорКонтрагентаДата;
		ОснованиеОтгрузки.Основание = ДанныеДоговора.ДоговорКонтрагентаНаименование;
		ОснованиеОтгрузки.Ссылка = ДанныеДоговора.ДоговорКонтрагента;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_СведенияОбОтгрузочномДокументеЗаполнены(ДанныеДокумента)

