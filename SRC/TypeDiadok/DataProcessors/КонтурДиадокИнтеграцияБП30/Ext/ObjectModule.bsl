	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&СуммаАкциза",
		ВыражениеТекстаЗапросаСуммаАкциза);
		
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&ПодакцизныйТовар",
