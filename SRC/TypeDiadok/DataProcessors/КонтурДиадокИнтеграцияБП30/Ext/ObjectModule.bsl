Функция РеквизитыБанковскогоСчета(БанковскийСчет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	БанковскиеСчета.Банк.Код КАК БИК,
	|	БанковскиеСчета.Банк КАК Банк,
	|	БанковскиеСчета.Банк.Наименование КАК БанкНаименование,
	|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Ссылка = &БанковскийСчет";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Результат[0]);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция АктыСверок_ПечатнаяФорма1С(СсылкаНаОбъект) Экспорт
	
	ТипОбъекта = ТипЗнч(СсылкаНаОбъект);
	Если ТипОбъекта <> Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		
		Ошибка = СтрШаблон(
			"Неожиданный тип параметра 'СсылкаНаОбъект' (%1)",
			Строка(ТипОбъекта)
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(СсылкаНаОбъект);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	КоллекцияПечатныхФорм = НовыйКоллекцияПечатныхФормДляПечатиДокумента();
	
	АктыСверок_ЗаполнитьКоллекциюПечатныхФорм(КоллекцияПечатныхФорм);
	
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Новый Структура;
	
	МенеджерПечати = Документы.АктСверкиВзаиморасчетов;
	МенеджерПечати.Печать(
		ДокументПечати,
		ПараметрыПечати,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода
	);
	
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			
			ТабличныйДокумент = Стр.ТабличныйДокумент;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;

	Возврат ТабличныйДокумент;
	
КонецФункции

// Заполняет мету электронных актов и накладных
//
// Параметры:
//  Мета - Структура - модель меты передаточного документа
//  УчетныйДокумент - ЛюбаяСсылка - основание электронного акта или накладной
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартный обработчик заполнения меты
//
Процедура ПередаточныеДокументы_ЗаполнитьМету(Мета, УчетныйДокумент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТипОснования = ТипЗнч(УчетныйДокумент);
	
	Если ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоРТУ(Мета, УчетныйДокумент);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоАОПУ(Мета, УчетныйДокумент);
		
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередаточныеДокументы_ЗаполнитьМетуПоРТУ(Мета, УчетныйДокумент)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ВалютаДокумента.Код КАК ВалютаКод,
	|	МАКСИМУМ(Шапка.СуммаДокумента) КАК СуммаДокумента,
	|	СУММА(ЕСТЬNULL(ТЧАгентскиеУслуги.СуммаНДС, 0) + ЕСТЬNULL(ТЧТовары.СуммаНДС, 0) + ЕСТЬNULL(ТЧУслуги.СуммаНДС, 0)) КАК СуммаНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК ТЧТовары
	|		ПО Шапка.Ссылка = ТЧТовары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК ТЧУслуги
	|		ПО Шапка.Ссылка = ТЧУслуги.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.АгентскиеУслуги КАК ТЧАгентскиеУслуги
	|		ПО Шапка.Ссылка = ТЧАгентскиеУслуги.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Ссылка,
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.ВалютаДокумента.Код";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", УчетныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Мета.Дата = Выборка.Дата;
	Мета.Номер = ПредставлениеНомера(Выборка.Номер);
	Мета.Сумма = Выборка.СуммаДокумента;
	Мета.СуммаНДС = Выборка.СуммаНДС;
	Мета.ДокументБезНДС = РеализацияТоваровУслугБезНДС(УчетныйДокумент);
	Мета.КодВалюты = Выборка.ВалютаКод;
	
КонецПроцедуры

Процедура ПередаточныеДокументы_ЗаполнитьМетуПоАОПУ(Мета, УчетныйДокумент)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ВалютаДокумента.Код КАК ВалютаКод,
	|	МАКСИМУМ(Шапка.СуммаДокумента) КАК СуммаДокумента,
	|	СУММА(ЕСТЬNULL(ТЧУслуги.СуммаНДС, 0)) КАК СуммаНДС
	|ИЗ
	|	Документ.АктОбОказанииПроизводственныхУслуг КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктОбОказанииПроизводственныхУслуг.Услуги КАК ТЧУслуги
	|		ПО Шапка.Ссылка = ТЧУслуги.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Ссылка,
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.ВалютаДокумента.Код";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", УчетныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Мета.Дата = Выборка.Дата;
	Мета.Номер = ПредставлениеНомера(Выборка.Номер);
	Мета.Сумма = Выборка.СуммаДокумента;
	Мета.СуммаНДС = Выборка.СуммаНДС;
	Мета.ДокументБезНДС = АктОбОказанииПроизводственныхУслугБезНДС(УчетныйДокумент);
	Мета.КодВалюты = Выборка.ВалютаКод;
	
КонецПроцедуры

Функция СведенияОбАдресеЛок(АдресСтрокойJSON)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("БезПредставлений", Ложь);
	ДопПараметры.Вставить("КодыАдреса", Истина);
	ДопПараметры.Вставить("КодыКЛАДР", Ложь);
	ДопПараметры.Вставить("ПолныеНаименованияСокращений", Ложь);
	ДопПараметры.Вставить("НаименованиеВключаетСокращение", Ложь);
	ДопПараметры.Вставить("ПроверитьАдрес", Ложь);
	
	ВерсияБСП = ВерсияБиблиотекиСтандартныхПодсистем();
	Если СравнитьВерсии_(ВерсияБСП, "2.4") >= 0 Тогда
		ИмяМодуля = "РаботаСАдресами";
	Иначе 
		ИмяМодуля = "УправлениеКонтактнойИнформацией";
	КонецЕсли;
	
	МодульРаботыСАдресами = ОбщийМодульПоИмениЛок(ИмяМодуля);
	
	Результат = МодульРаботыСАдресами.СведенияОбАдресе(АдресСтрокойJSON, ДопПараметры);
	
	Возврат Результат;
	
