	Content.Kpp = ДанныеУчастникаЭДО.КПП;
	Content.Okpo = ДанныеУчастникаЭДО.КодПоОКПО;
	
	Content.LegalEntityId = ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации;
	Content.OrganizationOrPersonInfo = ДанныеУчастникаЭДО.ИныеСведения;
	
	Если ДанныеУчастникаЭДО.ТипЮрФизЛица = ГенерацияXML_Перечисление_ВидыЮрФизЛиц().ИндивидуальныйПредприниматель Тогда
		Content.IndividualEntityRegistrationCertificate = ДанныеУчастникаЭДО.Свидетельство;
		Content.IndividualEntityRegistrationNumber = ДанныеУчастникаЭДО.ОГРН;
		Content.IndividualEntityRegistrationDate = ДанныеУчастникаЭДО.ДатаРегистрации;
	КонецЕсли;
	
	Content.Country = ДанныеУчастникаЭДО.СтранаРегистрацииНаименование;
	Content.CountryCode = ДанныеУчастникаЭДО.СтранаРегистрацииКод;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Телефоны) Тогда
		Content.Phone.Добавить(ДанныеУчастникаЭДО.Телефоны);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Email) Тогда
		Content.Email.Добавить(ДанныеУчастникаЭДО.Email);
	КонецЕсли;
	
	Content.BankName = ДанныеУчастникаЭДО.Банк;
	Content.BankAccountNumber = ДанныеУчастникаЭДО.НомерСчета;
	Content.CorrespondentAccount = ДанныеУчастникаЭДО.КоррСчет;
	Content.BankId = ДанныеУчастникаЭДО.БИК;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПродавце(Content, ДанныеШапки, КПППоставщика = "")
	
	СведенияОПоставщике = ДанныеШапки.Поставщик;
	Если Не ЗначениеЗаполнено(СведенияОПоставщике) Тогда
		СведенияОПоставщике = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Ссылка, "Организация");
	КонецЕсли;
	
	Продавцы = ЗначениеВМассивЛок(СведенияОПоставщике);
	
	ИспользоватьДанныеШапки = (Продавцы.Количество() = 1);
	
	БанковскийСчет = Неопределено;
	Если ИспользоватьДанныеШапки И ДанныеШапки.Свойство("БанковскийСчетПродавца") Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетПродавца;
	КонецЕсли;
	
	ПродавецОбособленноеПодразделение = (ИспользоватьДанныеШапки
		И ДанныеШапки.ОбособленноеПодразделениеПоставщика <> ДанныеШапки.Поставщик);
	
	Для Каждого Продавец Из Продавцы Цикл
		
		ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Продавец, ДанныеШапки.Дата, БанковскийСчет);
		
		Seller = Контракт_ExtendedOrganizationInfo970();
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, ДанныеУчастникаЭДО);
		
		Если ЗначениеЗаполнено(КПППоставщика) Тогда
			КПП = КПППоставщика;
		ИначеЕсли ПродавецОбособленноеПодразделение Тогда
			КПП = КППНаДатуЛок(ДанныеШапки.ОбособленноеПодразделениеПоставщика, ДанныеШапки.Дата);
		ИначеЕсли ПродавецКрупнейшийНалогоплательщик(Продавец) Тогда
			КПП = Справочники.Организации.КППНаДату(Продавец, ДанныеШапки.Дата);
		Иначе
			КПП = ДанныеУчастникаЭДО.КПП;
		КонецЕсли;
		
		Seller.Kpp = КПП;
		
		СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ЮридическийАдресJSON);
		Seller.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
		
		Seller.СлужебнаяИнформация.Ссылка = Продавец;
		
		Content.Sellers.Добавить(Seller);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПокупателе(Content, ДанныеШапки)
	
	СведенияОПокупателе = ДанныеШапки.Покупатель;
	Если НЕ ЗначениеЗаполнено(СведенияОПокупателе) Тогда
		СведенияОПокупателе = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Ссылка, "Контрагент");
	КонецЕсли;
	
	Покупатели = ЗначениеВМассивЛок(СведенияОПокупателе);
	
	КПП = Неопределено;
	Если ЭтоСчетФактураВыданный(ДанныеШапки.Ссылка)
		И ЗначениеЗаполнено(ДанныеШапки.КПППокупателя) Тогда
		КПП = ДанныеШапки.КПППокупателя;
	Иначе
		КПП = КППНаДатуЛок(ДанныеШапки.ОбособленноеПодразделениеПокупателя, ДанныеШапки.Дата);
	КонецЕсли;

	Для Каждого Покупатель Из Покупатели Цикл
		
		ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Покупатель, ДанныеШапки.Дата);
		
		Buyer = Контракт_ExtendedOrganizationInfo970();
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, ДанныеУчастникаЭДО);
		
		Если ЗначениеЗаполнено(КПП) Тогда
			Buyer.Kpp = КПП;
		КонецЕсли;
		
		СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ЮридическийАдресJSON);
		Buyer.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
		
		Buyer.СлужебнаяИнформация.Ссылка = Покупатель;
		
		Content.Buyers.Добавить(Buyer);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГрузоотправителе(Content, ДанныеШапки)
	
	Если Не ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
		Возврат;
	КонецЕсли;
	
	Грузоотправители = ЗначениеВМассивЛок(ДанныеШапки.Грузоотправитель);
	
	ДатаСведений = ДанныеШапки.Дата;
	
	Для Каждого Грузоотправитель Из Грузоотправители Цикл
		
		Если Не ЗначениеЗаполнено(Грузоотправитель) Тогда
			Продолжить;
		КонецЕсли;
		
		Shipper = Контракт_Shipper970();
		
		Shipper.SameAsSeller = Ложь;
		
		Если ТипЗнч(Грузоотправитель) = Тип("Строка")
			И НРег(Грузоотправитель) = "он же" Тогда
			
			Shipper.SameAsSeller = Истина;
			
		Иначе
			
			ЭтоОбособленноеПодразделение = (ТипЗнч(Грузоотправитель) = Тип("СправочникСсылка.ПодразделенияОрганизаций"));
			
			ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Грузоотправитель, ДатаСведений);
			
			ShipperInfo = Контракт_ExtendedOrganizationInfo970();
			Shipper.OrganizationInfo = ShipperInfo;
			
			УПД970_ЗаполнитьExtendedOrganizationInfo(ShipperInfo, ДанныеУчастникаЭДО);
			
			Если ЭтоОбособленноеПодразделение Тогда
				
				ShipperInfo.Name = ДанныеУчастникаЭДО.НаименованиеПодразделения;
				
				ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций;
				
				ИнтерфейсБП = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформациейБП");
				СведенияОбАдресе = ИнтерфейсБП.АдресСтруктурой(
					Грузоотправитель,
					ВидКонтактнойИнформации,
					ДатаСведений
				);
				
				АдресСтрокойJSON = СведенияОбАдресе.ЗначениеJSON;
				
			Иначе
				
				АдресСтрокойJSON = ДанныеУчастникаЭДО.ФактическийАдресJSON;
				
			КонецЕсли;
			
			СведенияОбАдресе = УПД970_СведенияОбАдресе(АдресСтрокойJSON);
			ShipperInfo.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
			
			ShipperInfo.СлужебнаяИнформация.Ссылка = Грузоотправитель;
			
		КонецЕсли;
		
		Content.Shippers.Добавить(Shipper);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГрузополучателе(Content, ДанныеШапки, СведенияОбАдресе = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		Возврат;
	КонецЕсли;
	
	Грузополучатели = ЗначениеВМассивЛок(ДанныеШапки.Грузополучатель);
	
	ДатаСведений = ДанныеШапки.Дата;
	
	Для Каждого Грузополучатель Из Грузополучатели Цикл
		
		Если НЕ ЗначениеЗаполнено(Грузополучатель) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеУчастникаЭДО = УПД970_ДанныеЮрФизЛица(Грузополучатель, ДатаСведений);
		
		Consignee = Контракт_ExtendedOrganizationInfo970();
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, ДанныеУчастникаЭДО);
		
		Consignee.Name = ДанныеУчастникаЭДО.НаименованиеПодразделения;
		
		Если Не ЗначениеЗаполнено(СведенияОбАдресе) Тогда
			СведенияОбАдресе = УПД970_СведенияОбАдресе(ДанныеУчастникаЭДО.ФактическийАдресJSON);
		КонецЕсли;
		
		Consignee.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
		
		Consignee.СлужебнаяИнформация.Ссылка = Грузополучатель;
		
		Content.Consignees.Добавить(Consignee);
		
	КонецЦикла;
	
КонецПроцедуры

Функция УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе)
	
	Перем Результат;
	
	Если НЕ ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыАдресов = ГенерацияXML.Перечисление_ВидыАдресов();

	Результат = Контракт_AddressInfo970();

	Если ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		
		AddressSAR = УПД970_ЗаполненныйAddressSAR(СведенияОбАдресе);
		
		Результат.AddressSAR = AddressSAR;
		Результат.Type = ВидыАдресов.АдресГАР;
		
	ИначеЕсли ЭтоАдминистративноТерриториальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		
		AddressRF = УПД970_ЗаполненныйAddressRF(СведенияОбАдресе);
		
		Результат.AddressRF = AddressRF;
		Результат.Type = ВидыАдресов.АдресРФ;
		
	Иначе
		
		AddressText = УПД970_ЗаполненныйAddressText(СведенияОбАдресе);
		
		Результат.AddressText = AddressText;
		Результат.Type = ВидыАдресов.АдресСтрокой;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressRF(СведенияОбАдресе)
	
	Результат = Контракт_AddressRFInfo();
	
	Результат.ZipCode = СведенияОбАдресе.Индекс;
	Результат.RegionCode = СведенияОбАдресе.КодРегиона;
	Результат.Region = СведенияОбАдресе.Регион;
	Результат.Territory = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.РайонТипКраткий, СведенияОбАдресе.Район);
		
	Если ВРег(СведенияОбАдресе.Город) <> ВРег(СведенияОбАдресе.Регион) Тогда
		Результат.City = СоединитьЭлементыАдресногоОбъекта(
			СведенияОбАдресе.ГородТипКраткий, 
			СведенияОбАдресе.Город);
	КонецЕсли;
	
	Если ВРег(СведенияОбАдресе.Город) <> ВРег(СведенияОбАдресе.НаселенныйПункт) Тогда
		Результат.Locality = СоединитьЭлементыАдресногоОбъекта(
			СведенияОбАдресе.НаселенныйПунктТипКраткий, 
			СведенияОбАдресе.НаселенныйПункт);
	КонецЕсли;
	
	Результат.Street = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.УлицаТипКраткий, СведенияОбАдресе.Улица);
	
	ИмяСвойства = "Номер";
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание) Тогда
		Результат.Building = СвойствоСтруктурыЛок(СведенияОбАдресе.Здание, ИмяСвойства);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Корпуса) Тогда
		Результат.Block = СвойствоСтруктурыЛок(СведенияОбАдресе.Корпуса[0], ИмяСвойства);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Помещения) Тогда
		Результат.Apartment = СвойствоСтруктурыЛок(СведенияОбАдресе.Помещения[0], ИмяСвойства);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressText(СведенияОбАдресе)
	
	Результат = Контракт_AddressTextInfo();

	Результат.AddressText = СведенияОбАдресе.Представление;
	Результат.CountryCode = СведенияОбАдресе.КодСтраны;
	Результат.Country = СведенияОбАдресе.Страна;

	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressSAR(СведенияОбАдресе)
	
	КодыРегионов = ГенерацияXML.КодыРегионов();
	
	Результат = Контракт_AddressSARInfo();
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторДома) Тогда
		Результат.ID = СведенияОбАдресе.ИдентификаторДома;
	Иначе
		Результат.ID = СведенияОбАдресе.ИдентификаторАдресногоОбъекта;
	КонецЕсли;
	
	Результат.ZipCode = СведенияОбАдресе.Индекс;
	Результат.RegionCode = СведенияОбАдресе.КодРегиона;
	
	ПредставлениеРегиона = "";
	Если ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона) Тогда
		ПредставлениеРегиона = КодыРегионов.Получить(XMLЗначение(Тип("Число"), СведенияОбАдресе.КодРегиона));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПредставлениеРегиона) Тогда
		
		ЧастиРегиона = Новый Массив;
		ЧастиРегиона.Добавить(СокрЛП(СведенияОбАдресе.Регион));
		ЧастиРегиона.Добавить(НРег(СведенияОбАдресе.РегионТипПолный));
		
		ПредставлениеРегиона = СтрСоединить(ЧастиРегиона, " ");
		
	КонецЕсли;
	Результат.Region = ПредставлениеРегиона;
	
	MunicipalDistrictCode = СведенияОбАдресе.КодМуниципальногоРайона;
	Если НЕ ЗначениеЗаполнено(MunicipalDistrictCode) Тогда
		MunicipalDistrictCode = УПД970_КодМуниципальногоРайона(СведенияОбАдресе.МуниципальныйРайонСокращение);
	КонецЕсли;
	
	Результат.MunicipalDistrict = СведенияОбАдресе.МуниципальныйРайон;
	Результат.MunicipalDistrictCode = MunicipalDistrictCode;
	
	УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОНаселенномПункте(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОТерритории(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОУлице(Результат, СведенияОбАдресе);
	
	Результат.LandPlot = СведенияОбАдресе.НомерЗемельногоУчастка;
	
	УПД970_ЗаполнитьСведенияОЗданиях(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОПомещенииЗдания(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОПомещенииКвартиры(Результат, СведенияОбАдресе);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Поселение) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.Поселение;
		AddressSAR.SettlementCode = СведенияОбАдресе.КодПоселения;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.ВнутригородскойРайон) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.ВнутригородскойРайон;
		AddressSAR.SettlementCode = "4";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОНаселенномПункте(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.НаселенныйПункт) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.НаселенныйПункт;
		AddressSAR.LocalityType = СведенияОбАдресе.НаселенныйПунктТипКраткий;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.Город) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.Город;
		AddressSAR.LocalityType = СведенияОбАдресе.ГородТипКраткий;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОТерритории(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Территория) Тогда
		AddressSAR.PlanningElement = СведенияОбАдресе.Территория;
		AddressSAR.PlanningElementType = СведенияОбАдресе.ТерриторияТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОУлице(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Улица) Тогда
		AddressSAR.StreetElement = СведенияОбАдресе.Улица;
		AddressSAR.StreetElementType = СведенияОбАдресе.УлицаТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОЗданиях(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание.Номер)
		И ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания) Тогда
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = СведенияОбАдресе.Здание.Номер;
		AddressObject.Type = СведенияОбАдресе.Здание.ТипЗдания;
		
	КонецЕсли;

	Для Каждого Корпус Из СведенияОбАдресе.Корпуса Цикл
		
		Если Не ЗначениеЗаполнено(Корпус.Номер)
			И Не ЗначениеЗаполнено(Корпус.ТипКорпуса) Тогда
			Продолжить;
		КонецЕсли;
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = Корпус.Номер;
		AddressObject.Type = Корпус.ТипКорпуса;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииЗдания(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	
	Для Каждого ТипПомещения Из ТипыПомещенийЗдания Цикл
		
		ПомещениеЗдания = Ядро.МассивСтруктур_Найти(Помещения, ТипПомещения, "ТипПомещения");
		Если ПомещениеЗдания <> Неопределено Тогда
			
			AddressSAR.House = ПомещениеЗдания.Номер;
			AddressSAR.HouseType = ПомещениеЗдания.ТипПомещения;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииКвартиры(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ПомещениеКвартиры = УПД970_ПолучитьПомещениеКвартиры(Помещения);
	
	Если ПомещениеКвартиры = Неопределено Тогда
		ПомещениеКвартиры = УПД970_ПолучитьНеклассифицированноеПомещение(Помещения);
	КонецЕсли;
	
	Если ПомещениеКвартиры <> Неопределено Тогда
		AddressSAR.Apartment = ПомещениеКвартиры.Номер;
		AddressSAR.ApartmentType = ПомещениеКвартиры.ТипПомещения;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьItemTracingInfos(Item, СтрокаТаблицы, СведенияОПрослеживаемости, НуженПересчетВРубли)
	
	Если Не ЗначениеЗаполнено(СведенияОПрослеживаемости) Тогда
		Возврат;
	КонецЕсли;
	
	СведенияОПрослеживаемостиПоСтроке = СведенияОПрослеживаемости.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки));
	
	Если СведенияОПрослеживаемостиПоСтроке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КодыСтранПроисхождения = Новый Массив;
	
	Для Каждого СтрокаДанныхПрослеживаемости Из СведенияОПрослеживаемостиПоСтроке Цикл
		
		ItemTracingInfo = УПД970_ЗаполненныйItemTracingInfo(
			СтрокаТаблицы,
			СтрокаДанныхПрослеживаемости,
			НуженПересчетВРубли);
		
		Item.ItemTracingInfos.Добавить(ItemTracingInfo);
		
		КодСтраны = СтрокаДанныхПрослеживаемости.СтранаПроисхожденияКод;
		Если КодыСтранПроисхождения.Найти(КодСтраны) = Неопределено Тогда
			КодыСтранПроисхождения.Добавить(КодСтраны);
		КонецЕсли;
		
	КонецЦикла;
	
	Item.CustomDeclarations.Очистить();
	
	Для Каждого КодСтраны Из КодыСтранПроисхождения Цикл
		УПД970_ЗаполнитьCustomDeclarationДляПрослеживаемыхТоваров(Item, КодСтраны);
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОбОснованииОтгрузки(Контент, ДанныеШапки, ДополнительныеПараметры)
	
	УстановитьЗначениеБезОснованияОтгрузки = Истина;
		
	РеквизитыОснования = УПД970_РеквизитыОснованияОтгрузки(ДанныеШапки);
	Если РеквизитыОснования <> Неопределено Тогда
		
		УказыватьОтсутствиеОснованияУПД = СвойствоСтруктурыЛок(
			ДополнительныеПараметры,
			"УказыватьОтсутствиеОснованияУПД");

		РеквизитыОснованияЗаполнены = (ЗначениеЗаполнено(РеквизитыОснования.ОснованиеДата)
			И ЗначениеЗаполнено(РеквизитыОснования.ОснованиеНомер));
			
		УстановитьЗначениеБезОснованияОтгрузки = Не РеквизитыОснованияЗаполнены И УказыватьОтсутствиеОснованияУПД;
			
	КонецЕсли;
	
	Если УстановитьЗначениеБезОснованияОтгрузки Тогда
		
		УПД970_УстановитьЗначениеБезОснованияОтгрузки(Контент);
		
	Иначе
		
		TransferBases = УПД970_ЗаполненныйTransferBases(РеквизитыОснования);
		
		TransferBases.СлужебнаяИнформация = Контракт_СлужебнаяИнформацияTransferBases970();
		TransferBases.СлужебнаяИнформация.ОснованиеСсылка = РеквизитыОснования.Ссылка;
		
		Контент.TransferBases.Добавить(TransferBases);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьЕдиницуИзмерения(Item, Наименование, Код)

	КодЕИ = СокрЛП(Код);
	ИмяЕИ = СокрЛП(Наименование);
	
	Item.Unit = ГенерацияXML.XML_КодЕдиницыИзмерения(КодЕИ);
	Item.UnitName = ИмяЕИ;

КонецПроцедуры

Процедура УПД970_ЗаполнитьКодВалюты(Контент, ВалютаДокумента, НуженПересчетВРубли)
	
	Если НуженПересчетВРубли Тогда
		Валюта = ВалютаРегламентированногоУчета();
	Иначе
		Валюта = ВалютаДокумента;
	КонецЕсли;
	
	Контент.Currency = ЗначениеРеквизитаОбъектаЛок(Валюта, "Код");
	
КонецПроцедуры

Функция УПД970_РеквизитыОснованияОтгрузки(ДанныеШапки)
	
	Перем Результат;
	
	ВестиУчетПоДоговорам = ВестиУчетПоДоговорам();
	
	Если ВестиУчетПоДоговорам Тогда
		
		Договор = СвойствоСтруктурыЛок(ДанныеШапки, "Договор");
		
		Результат = УПД970_НовыйРеквизитыОснованияОтгрузки();
		Если Не ЗначениеЗаполнено(Договор) Тогда
			УПД970_ЗаполнитьСведенияОснованияОтгрузкиПоДокументуОснования(Результат, ДанныеШапки.Ссылка);
		Иначе
			Результат.ОснованиеДата = ДанныеШапки.ОснованиеДата;
			Результат.ОснованиеНомер = ДанныеШапки.ОснованиеНомер;
			Результат.Основание = ДанныеШапки.Основание;
			Результат.Ссылка = Договор;
		КонецЕсли;
		
		БезДоговора = (НРег(Результат.Основание) = НРег("Без договора"));
		
		Если БезДоговора Тогда
			Результат = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НовыйРеквизитыОснованияОтгрузки()
	
	Результат = Новый Структура;
	Результат.Вставить("ОснованиеДата");
	Результат.Вставить("ОснованиеНомер");
	Результат.Вставить("Основание");
	Результат.Вставить("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_УстановитьЗначениеБезОснованияОтгрузки(Контент)
	Контент.WithoutTransferBase = Истина;
КонецПроцедуры

Процедура УПД970_ЗаполнитьСоставителяДокумента(Контент, СсылкаНаОбъект)
	
	Если ЭтоСчетФактураСоставленныйАгентом(СсылкаНаОбъект) Тогда
		
		Агент = ЗначениеРеквизитаОбъектаЛок(СсылкаНаОбъект, "Организация");
		РеквизитыАгента = УПД970_ДанныеЮрФизЛица(Агент, Контент.DocumentDate);
		
		Контент.DocumentCreator = НаименованиеИННКПП(
			РеквизитыАгента.НаименованиеПолное,
			РеквизитыАгента.ИНН,
			РеквизитыАгента.КПП);
		
		УПД970_ЗаполнитьСведенияОДокументеОснованияСоставителяФайла(Контент, СсылкаНаОбъект);
		
	Иначе
		
		УПД970_ЗаполнитьСоставителяДокументаПоПродавцу(Контент);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСоставителяДокументаПоПродавцу(Контент)
	
	ПродавецИнфо = Контент.Sellers[0];
	Контент.DocumentCreator = НаименованиеИННКПП(ПродавецИнфо.Name, ПродавецИнфо.Inn, ПродавецИнфо.Kpp);

КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОДокументеОснованияСоставителяФайла(Контент, СсылкаНаОбъект)

	РеквизитыДоговора = Новый Структура;
	РеквизитыДоговора.Вставить("Номер", "ДоговорКонтрагента.Номер");
	РеквизитыДоговора.Вставить("Дата", "ДоговорКонтрагента.Дата");
	
	РеквизитыДоговора = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, РеквизитыДоговора);
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.Номер)
		И ЗначениеЗаполнено(РеквизитыДоговора.Дата) Тогда
		
		НаименованиеДокумент = "Договор";
		
		Контент.DocumentCreatorBase = Контракт_DocumentCreatorBase();
		
		Контент.DocumentCreatorBase.Name = НаименованиеДокумент;
		Контент.DocumentCreatorBase.Number = РеквизитыДоговора.Номер;
		Контент.DocumentCreatorBase.Date = РеквизитыДоговора.Дата;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДокСсылка, ДокументыОтгрузки, ФункцияДокумента)
	
	DocumentShipments = Контент.DocumentShipments;
	СтрокиТаблицы = Контент.Table.Items;
	
	НаименованиеДокумента = УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента);
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФ() Тогда
		
		ЗаполнитьДокументыОбОтгрузкиИзТабличнойЧасти(DocumentShipments, ДокСсылка);
		
		Если DocumentShipments.Количество() = 0 Тогда
			
			Для Каждого ДокументОснования Из ДокументыОтгрузки Цикл
				
				ДатаНомерДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснования, "Номер, Дата");
				НомерДокумента = ПредставлениеНомера(ДатаНомерДокумента.Номер);
				
				РеквизитыДокументов = Новый Структура;
				РеквизитыДокументов.Вставить("НомерДокумента", НомерДокумента);
				РеквизитыДокументов.Вставить("ДатаДокумента", ДатаНомерДокумента.Дата);
				РеквизитыДокументов.Вставить("НаименованиеДокумента", НаименованиеДокумента);
				
				DocumentShipment = УПД970_ЗаполненныйDocumentShipments970(РеквизитыДокументов);
				DocumentShipments.Добавить(DocumentShipment);
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе

		РеквизитыДокументов = Новый Структура;
		РеквизитыДокументов.Вставить("НомерДокумента", Контент.DocumentNumber);
		РеквизитыДокументов.Вставить("ДатаДокумента", Контент.DocumentDate);
		РеквизитыДокументов.Вставить("НаименованиеДокумента", НаименованиеДокумента);
		
		DocumentShipment = УПД970_ЗаполненныйDocumentShipments970(РеквизитыДокументов);
		DocumentShipments.Добавить(DocumentShipment);
		
		Контент.DocumentName = НаименованиеДокумента;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДокументыОбОтгрузкиИзТабличнойЧасти(DocumentShipments, ДокСсылка)
	
	Если ТипЗнч(ДокСсылка) <> Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользуетсяТабЧастьДокументыОбОтгрузкеДляСФ = ИспользуетсяТабЧастьДокументыОбОтгрузкеДляСФ();
	
	Если ИспользуетсяТабЧастьДокументыОбОтгрузкеДляСФ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетФактураВыданныйДокументыОбОтгрузке.НаименованиеДокумента КАК НаименованиеДокумента,
		|	СчетФактураВыданныйДокументыОбОтгрузке.НомерДокумента КАК НомерДокумента,
		|	СчетФактураВыданныйДокументыОбОтгрузке.ДатаДокумента КАК ДатаДокумента
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОбОтгрузке КАК СчетФактураВыданныйДокументыОбОтгрузке
		|ГДЕ
		|	СчетФактураВыданныйДокументыОбОтгрузке.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
		
		ДанныеДокументовОбОтгрузке = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ДокументОтгрузки Из ДанныеДокументовОбОтгрузке Цикл
			
			РеквизитыДокументов = Новый Структура;
			РеквизитыДокументов.Вставить("НаименованиеДокумента", ДокументОтгрузки.НаименованиеДокумента);
			РеквизитыДокументов.Вставить("НомерДокумента", ДокументОтгрузки.НомерДокумента);
			РеквизитыДокументов.Вставить("ДатаДокумента", ДокументОтгрузки.ДатаДокумента);
			
			DocumentShipment = УПД970_ЗаполненныйDocumentShipments970(РеквизитыДокументов);
			DocumentShipments.Добавить(DocumentShipment);
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Функция УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента)
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФДОП() Тогда
		
		Результат = НаименованияДокументов.УПД;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументыОтгрузки) И ДокументыОтгрузки.Количество() > 1 Тогда
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		ЕстьУслуги = УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы);
		
		Если ЕстьТовары И НЕ ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Накладная;
			
		ИначеЕсли НЕ ЕстьТовары И ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Акт;
			
		Иначе
			Результат = НаименованияДокументов.Документ;
		КонецЕсли;
		
	Иначе
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		
		Если ЕстьТовары Тогда
			Результат = НаименованияДокументов.Накладная;
		Иначе
			Результат = НаименованияДокументов.Акт;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеЕстьТовары(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Имущество Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	МаксИндекс = СтрокиТаблицы.Количество() - 1;
	
	Для ТекИндекс = - МаксИндекс По 0 Цикл
		
		ItemMark = СтрокиТаблицы[ - ТекИндекс].ItemMark;
		
		Если ItemMark = ТипыНоменклатуры.Услуга
			ИЛИ ItemMark = ТипыНоменклатуры.Работа
			ИЛИ ItemMark = ТипыНоменклатуры.ИмущественныеПрава Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОпределитьДатаОтгрузки(DocumentDate, DocumentShipments)
	
	Результат = DocumentDate;
	
	Для Каждого DocumentShipment Из DocumentShipments Цикл
		Результат = DocumentShipment.Date;
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДатаОтгрузки(
	ДокументОтгрузки,
	DocumentDate,
	DocumentShipments,
	ФункцияДокумента)
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФДОП()
		И ЗначениеЗаполнено(ДокументОтгрузки) Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументОтгрузки, "ДокументОтгрузки")
			И ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки, "Дата")
				<> ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки.ДокументОтгрузки, "Дата") Тогда
			
			Результат = НачалоДня(ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки.ДокументОтгрузки, "Дата"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументОтгрузки, "ИсходныйДокументРеализации")
			И ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки, "Дата")
				<> ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки.ИсходныйДокументРеализации, "Дата") Тогда
			
			Результат = НачалоДня(ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки.ИсходныйДокументРеализации, "Дата"));
			
		Иначе
			
			Результат = НачалоДня(ЗначениеРеквизитаОбъектаЛок(ДокументОтгрузки, "Дата"));
			
		КонецЕсли;
		
	ИначеЕсли ФункцияДокумента = ФункцияДокумента_ДОП() Тогда
		
		Результат = УПД970_ОпределитьДатаОтгрузки(DocumentDate, DocumentShipments);
		
	Иначе
		
		Результат = Дата(1, 1, 1);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОМаркировке(Контент, СсылкаНаОбъект)
	
	Попытка
		
		РаботаСМаркировкой.ЗаполнитьСведенияОМаркировке970(Контент);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		
		ПодробнаяОшибка = СтрШаблон(
			"Не удалось заполнить сведения о маркировке по причине:
			|%1",
			ПодробноеПредставлениеОшибки(Ошибка)
		);
		
		ЗаписьЖурналаРегистрации(
			"Диадок.РаботаСМаркировкой",
			УровеньЖурналаРегистрации.Ошибка,
			СсылкаНаОбъект.Метаданные(),
			СсылкаНаОбъект,
			ПодробнаяОшибка
		);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Content)
	
	ЕстьПрослеживаемыеТовары = Ложь;
	
	Для Каждого Item Из Content.Table.Items Цикл
		Если Item.ItemTracingInfos.Количество() > 0 Тогда
			ЕстьПрослеживаемыеТовары = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПризнакиПрослежкиИМаркировки = ГенерацияXML.Новый_ПризнакиПрослеживаемыхИМаркируемыхТоваровУПД970(ЕстьПрослеживаемыеТовары);
	
	ГенерацияXML.Заполнить_ПризнакиПрослеживаемыхИМаркируемыхТоваровДокументаУПД970(Content, ПризнакиПрослежкиИМаркировки);

КонецПроцедуры

Процедура УПД970_ЗаполнитьКоличествоПоСтроке(Item, СтрокаТаблицы, ФункцияДокумента, ТочностьКоличества)
	
	Item.Quantity = 0;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
		
		Item.Quantity = Окр(СтрокаТаблицы.Количество, ТочностьКоличества);
		
	Иначе
		
		ТипыНоменклатурыКонтента = ГенерацияXML.Перечисление_ItemMarks();
		
		ЭтоТипНоменклатурыУслугаИлиРабота = (Item.ItemMark = ТипыНоменклатурыКонтента.Услуга
			Или Item.ItemMark = ТипыНоменклатурыКонтента.Работа);
		
		КоличествоИЦенаОбязательны = УПД970_КоличествоИЦенаОбязательныПоФормату(ФункцияДокумента, Item.Unit);

		Если КоличествоИЦенаОбязательны И ЭтоТипНоменклатурыУслугаИлиРабота Тогда
			Item.Quantity = 1;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ЗаполнитьЦенуПоСтроке(Item, СтрокаТаблицы, ФункцияДокумента, ТочностьЦены)
	
	Item.Price = 0;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Цена) Тогда
		
		Item.Price = Окр(СтрокаТаблицы.Цена, ТочностьЦены);
		
	Иначе
		
		ТипыНоменклатурыКонтента = ГенерацияXML.Перечисление_ItemMarks();
		
		ЭтоТипНоменклатурыУслугаИлиРабота = (Item.ItemMark = ТипыНоменклатурыКонтента.Услуга
			Или Item.ItemMark = ТипыНоменклатурыКонтента.Работа);
		
		КоличествоИЦенаОбязательны = УПД970_КоличествоИЦенаОбязательныПоФормату(ФункцияДокумента, Item.Unit);

		Если КоличествоИЦенаОбязательны
			И ЭтоТипНоменклатурыУслугаИлиРабота
			И ЗначениеЗаполнено(Item.Quantity) Тогда
			
			Item.Price = Окр(СтрокаТаблицы.Стоимость / Item.Quantity, ТочностьЦены);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры)
	
	ДанныеСотрудника = СвойствоСтруктурыЛок(ДополнительныеПараметры, "ДанныеСотрудника");
	Если ЗначениеЗаполнено(ДанныеСотрудника)
		И ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
		
		TransferInfo.Employee = УПД970_ЗаполненныйEmployee(ДанныеСотрудника);
	
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_КоличествоИЦенаОбязательныПоФормату(ФункцияДокумента, КодЕдиницыИзмерения)
	
	Результат = ФункцияДокумента <> ФункцияДокумента_ДОП()
				И ЗначениеЗаполнено(КодЕдиницыИзмерения);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВТаблицеДокументаЕстьСуммаАкциза(ТаблицаДокумента)
	
	НазваниеКолонкиССуммойАкциза = "Акциз";
	
	Результат = ТаблицаДокумента.Колонки.Найти(НазваниеКолонкиССуммойАкциза) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НовыйТаблицаКонтента()
	
	Результат = Контракт_InvoiceTable970();
	
	Результат.TotalNet = 0;
	Результат.TotalWithVatExcluded = 0;
	Результат.Vat = 0;
	Результат.Total = 0;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВсеСтрокиБезНДС(Таблица)

	СтрокиБезНДС = Таблица.НайтиСтроки(Новый Структура("СтавкаНДС", ПрикладнаяСтавкаБезНДС()));
	Результат = (СтрокиБезНДС.Количество() = Таблица.Количество());
	
