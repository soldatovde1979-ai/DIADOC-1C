Функция АдресДоставкиДокумента(ДокСсылка)
	
	Результат = Новый Структура;
	Результат.Вставить("АдресДоставкиЗначение", "");
	Результат.Вставить("АдресДоставки", "");
	
	МетаданныеДокумента = ДокСсылка.Метаданные();
	ТекстЗапроса = ТекстЗапросаДанныхАдресаДоставки(МетаданныеДокумента);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокСсылка", ДокСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат.АдресДоставки = Выборка.АдресДоставки;
		Результат.АдресДоставкиЗначение = Выборка.АдресДоставкиЗначение;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаДанныхАдресаДоставки(МетаданныеДокумента)

	Результат = 
	"ВЫБРАТЬ
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	&АдресДоставкиСтрока КАК АдресДоставки
	|ИЗ
	|	&ПолноеИмяДокумента
	|ГДЕ
	|	Ссылка = &ДокСсылка";
	
	ВыражениеПустаяСтрока = """""";

	ВыражениеАдресДоставкиСтрока = ВыражениеПустаяСтрока;
	Если ЕстьРеквизитОбъектаЛок("АдресДоставки", МетаданныеДокумента) Тогда
		ВыражениеАдресДоставкиСтрока = "АдресДоставки";
	КонецЕсли;
		
	ВыражениеАдресДоставкиЗначение = ВыражениеПустаяСтрока;
	Если ЕстьРеквизитОбъектаЛок("АдресДоставкиЗначение", МетаданныеДокумента) Тогда
		ВыражениеАдресДоставкиЗначение = "АдресДоставкиЗначение";
	КонецЕсли;

	Результат = СтрЗаменить(Результат, "&АдресДоставкиСтрока", ВыражениеАдресДоставкиСтрока);
	Результат = СтрЗаменить(Результат, "&АдресДоставкиЗначение", ВыражениеАдресДоставкиЗначение);
	
	Результат = СтрЗаменить(Результат, "&ПолноеИмяДокумента", МетаданныеДокумента.ПолноеИмя());
	
	Возврат Результат;
	
КонецФункции

