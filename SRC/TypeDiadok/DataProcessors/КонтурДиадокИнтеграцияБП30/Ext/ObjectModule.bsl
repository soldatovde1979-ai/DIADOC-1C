Функция ЭтоИндивидуальныйПредприниматель(ЮрФизЛицо)
	
	ТипПараметра = ТипЗнч(ЮрФизЛицо);
	
	Результат = Ложь;
	
	Если ТипПараметра = Тип("СправочникСсылка.Организации") Тогда
		
		СтатусФЛ = ЗначениеРеквизитаОбъектаЛок(ЮрФизЛицо, "СтатусФизическогоЛица");
		Результат = (СтатусФЛ = Перечисления.СтатусыФизическихЛиц.ИндивидуальныйПредприниматель);
		
	ИначеЕсли ТипПараметра = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ОбъектМД = Метаданные.Справочники.Контрагенты;
		
		Если ЕстьРеквизитОбъектаЛок("ИндивидуальныйПредприниматель", ОбъектМД) Тогда
			
			Результат = ЗначениеРеквизитаОбъектаЛок(ЮрФизЛицо, "ИндивидуальныйПредприниматель");
			
		ИначеЕсли ЕстьРеквизитОбъектаЛок("Самозанятый", ОбъектМД) Тогда
			
			РеквизитыФЛ = ЗначенияРеквизитовОбъектаЛок(ЮрФизЛицо, "Самозанятый, ИНН");
			Результат = ЗначениеЗаполнено(РеквизитыФЛ.ИНН) И Не РеквизитыФЛ.Самозанятый;
			
		Иначе
			
			Ошибка = СтрШаблон("ЭтоИндивидуальныйПредприниматель: Не удалось определить признак ИП (контрагент = %1)", ЮрФизЛицо);
			ВызватьИсключение Ошибка;
			
		КонецЕсли;
		
	Иначе
		
		Ошибка = СтрШаблон("ЭтоИндивидуальныйПредприниматель: Неожиданный тип параметра ""ЮрФизЛицо"" (тип = %1)", ТипПараметра);
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//} ПРЯМЫЕ ВЫЗОВЫ ИМ


