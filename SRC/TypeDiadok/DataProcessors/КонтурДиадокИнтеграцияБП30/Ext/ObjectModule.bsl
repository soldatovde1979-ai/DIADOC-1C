Функция УПД970_ТекстЗапросаАвансовыхДокументовСчетФактурыВыданный()
	
	Результат =
	"ВЫБРАТЬ
	|	&НомерСчетаФактурыНаАванс КАК НомерСчетаФактурыНаАванс,
	|	&ДатаСчетаФактурыНаАванс КАК ДатаСчетаФактурыНаАванс,
	|	&НомерИсправленияСчетаФактурыНаАванс КАК НомерИсправленияСчетаФактурыНаАванс,
	|	&ДатаИсправленияСчетаФактурыНаАванс КАК ДатаИсправленияСчетаФактурыНаАванс
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|	И &ДанныеАСЧФ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ЕстьФункционалСведенийОбАвансах = ЕстьФункционалСведенийОбАвансах();
	
	Если ЕстьФункционалСведенийОбАвансах Тогда
		
		ВыражениеНомерСчетаФактурыНаАванс = "Таблица.НомерСчетаФактурыНаАванс";
		ВыражениеДатаСчетаФактурыНаАванс = "Таблица.ДатаСчетаФактурыНаАванс";
		ВыражениеНомерИсправленияСчетаФактурыНаАванс = "Таблица.НомерИсправленияСчетаФактурыНаАванс";
		ВыражениеДатаИсправленияСчетаФактурыНаАванс = "Таблица.ДатаИсправленияСчетаФактурыНаАванс";
		
		ВыражениеДанныеАСЧФ = "(Таблица.НомерСчетаФактурыНаАванс <> """"
			|	ИЛИ Таблица.ДатаСчетаФактурыНаАванс <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|	ИЛИ Таблица.НомерИсправленияСчетаФактурыНаАванс <> """"
			|	ИЛИ Таблица.ДатаИсправленияСчетаФактурыНаАванс <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
		
	Иначе
		
		НеопределеноДляЗапроса = "НЕОПРЕДЕЛЕНО";
		
		ВыражениеНомерСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		ВыражениеДатаСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		ВыражениеНомерИсправленияСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		ВыражениеДатаИсправленияСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		
		ВыражениеДанныеАСЧФ = "ЛОЖЬ";
		
	КонецЕсли;
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&НомерСчетаФактурыНаАванс", ВыражениеНомерСчетаФактурыНаАванс);
	Замены.Добавить("&ДатаСчетаФактурыНаАванс", ВыражениеДатаСчетаФактурыНаАванс);
	Замены.Добавить("&НомерИсправленияСчетаФактурыНаАванс", ВыражениеНомерИсправленияСчетаФактурыНаАванс);
	Замены.Добавить("&ДатаИсправленияСчетаФактурыНаАванс", ВыражениеДатаИсправленияСчетаФактурыНаАванс);
	Замены.Добавить("&ДанныеАСЧФ", ВыражениеДанныеАСЧФ);
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиСчетФактурыВыданный()

	Результат =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Дата КАК Дата,
	|	Реквизиты.ПредставлениеНомера КАК ПредставлениеНомера,
	|	Реквизиты.Исправление КАК Исправление,
	|	Реквизиты.НомерИсправления КАК НомерИсправления,
	|	Реквизиты.Дата КАК ДатаИсправления,
	|	Реквизиты.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	Реквизиты.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	Реквизиты.КПППродавца КАК КПППоставщика,
	|	Реквизиты.КППКонтрагента КАК КПППокупателя,
	|	НЕОПРЕДЕЛЕНО КАК Грузоотправитель,
	|	НЕОПРЕДЕЛЕНО КАК Грузополучатель,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах, ЛОЖЬ) КАК РасчетыВУсловныхЕдиницах,
	|	Реквизиты.ДоговорКонтрагента КАК Договор,
	|	Реквизиты.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Реквизиты.ДоговорКонтрагента.Наименование КАК Основание,
	|	Реквизиты.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Реквизиты.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем, ЛОЖЬ) КАК НДСИсчисляетсяНалоговымАгентом,
	|	Реквизиты.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	Реквизиты.КодВидаОперации КАК КодВидаОперации,
	|	Реквизиты.СводныйКомиссионный
	|		И НЕ ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации, ЛОЖЬ) КАК СводныйКомиссионный
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
