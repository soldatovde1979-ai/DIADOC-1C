	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Грузополучатель
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК ОбособленноеПодразделениеПокупателя,
	|	Реквизиты.ДоговорКонтрагента КАК Договор,
	|	Реквизиты.ДоговорКонтрагента.Наименование КАК Основание,
	|	Реквизиты.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Реквизиты.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	Реквизиты.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем КАК НДСИсчисляетсяНалоговымАгентом,
	|	Реквизиты.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Реквизиты.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.ГосударственныйКонтракт.Код, """") КАК ИдентификаторГосКонтракта,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Грузоотправитель
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация
	|		КОГДА Реквизиты.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером)
	|			ТОГДА Реквизиты.Организация
	|		ИНАЧЕ ""он же""
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Контрагент
	|		ИНАЧЕ Реквизиты.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.ПередачаОС КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличныеДанныеПередачиОС()
	
	Результат = УПД970_ТекстЗапросаРублевыхСуммДокументовВВалюте()
	+ ТекстЗапроса_РазделительЗапросов() +
	"ВЫБРАТЬ
	|	1 КАК ПорядокТЧ,
	|	""ОС"" КАК ИмяТабличнойЧасти,
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ОсновноеСредство КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Код)
	|			ТОГДА Таблица.ОсновноеСредство.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НоменклатураКод,
	|	ВЫБОР
	|		КОГДА Таблица.ОсновноеСредство.НаименованиеПолное <> """"
	|			ТОГДА Таблица.ОсновноеСредство.НаименованиеПолное
	|		ИНАЧЕ Таблица.ОсновноеСредство.Наименование
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	ЕСТЬNULL(Таблица.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	Таблица.ОсновноеСредство.КодТНВЭД КАК НоменклатураКодТНВЭД,
	|	Таблица.Количество КАК Количество,
	|	Таблица.Цена КАК Цена,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	ЛОЖЬ КАК ЭтоУслуга,
	|	Таблица.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0) КАК ВсегоРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0) КАК НДСРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0) КАК СуммаБезНДСРуб
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.ПередачаОС.ОС КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО Таблица.НомерСтроки = РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента
	|			И (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.ОС))
	|			И (Таблица.Ссылка.ВалютаДокумента <> &ВалютаРеглУчета)
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.ПорядокТЧ КАК ПорядокТЧ,
	|	ТаблицаДокумента.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДокумента.Номенклатура КАК Номенклатура,
	|	ТаблицаДокумента.НоменклатураКод КАК НоменклатураКод,
	|	ТаблицаДокумента.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ТаблицаДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименованиеПолное,
	|	ТаблицаДокумента.НоменклатураКодТНВЭД КАК КодТНВЭД,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокумента.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокумента.Цена
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТаблицаДокумента.Сумма - ТаблицаДокумента.СуммаНДС
	|		ИНАЧЕ ТаблицаДокумента.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТаблицаДокумента.Сумма
	|		ИНАЧЕ ТаблицаДокумента.Сумма + ТаблицаДокумента.СуммаНДС
	|	КОНЕЦ КАК Всего,
	|	ТаблицаДокумента.СуммаНДС КАК СуммаНДС,
	|	ТаблицаДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаДокумента.ЭтоУслуга КАК ЭтоУслуга,
	|	ТаблицаДокумента.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТаблицаДокумента.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаДокумента.ВсегоРуб КАК ВсегоРуб,
	|	ТаблицаДокумента.НДСРуб КАК НДСРуб,
	|	ТаблицаДокумента.СуммаБезНДСРуб КАК СуммаБезНДСРуб
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ТаблицаДокумента.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокТЧ,
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаСведенийПрослеживаемостиПередачиОС()

	Результат =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Таблица.РНПТ.Код КАК НомерТовара,
	|	Таблица.КоличествоПрослеживаемости КАК Количество,
	|	ЕСТЬNULL(Таблица.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(ТаблицаТоваров.КодТНВЭД.Код, ""796"") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Наименование, ""шт"") КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА Таблица.Сумма = 0
	|			ТОГДА Таблица.Количество * ВЫБОР
	|					КОГДА Реквизиты.СуммаВключаетНДС
	|						ТОГДА (ТаблицаТоваров.Сумма - ТаблицаТоваров.СуммаНДС) / ТаблицаТоваров.Количество
	|					ИНАЧЕ ТаблицаТоваров.Цена
	|				КОНЕЦ
	|		ИНАЧЕ Таблица.Сумма
	|	КОНЕЦ КАК СтоимостьБезНалога
	|ИЗ
	|	Документ.ПередачаОС.СведенияПрослеживаемости КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОС.ОС КАК ТаблицаТоваров
	|		ПО Таблица.Ссылка = ТаблицаТоваров.Ссылка
	|			И Таблица.ИдентификаторСтроки = ТаблицаТоваров.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПередачаОС КАК Реквизиты
	|		ПО Таблица.Ссылка = Реквизиты.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаРеквизитовНачисленияАренднойПлаты()
	
	Результат =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Номер КАК Номер,
	|	Реквизиты.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЦифровойИндексОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация.ГоловнаяОрганизация
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК Поставщик,
	|	Реквизиты.Организация КАК ОбособленноеПодразделениеПоставщика,
	|	ВЫБОР
	|		КОГДА Реквизиты.Контрагент.ОбособленноеПодразделение
	|				И Реквизиты.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК Покупатель,
	|	Реквизиты.Контрагент КАК ОбособленноеПодразделениеПокупателя,
	|	Реквизиты.ДоговорКонтрагента КАК Договор,
	|	Реквизиты.ДоговорКонтрагента.Наименование КАК Основание,
	|	Реквизиты.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Реквизиты.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	Реквизиты.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем КАК НДСИсчисляетсяНалоговымАгентом,
	|	Реквизиты.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Реквизиты.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.ГосударственныйКонтракт.Код, """") КАК ИдентификаторГосКонтракта,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.АР_НачислениеАренднойПлаты КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличныхДанныхНачисленияАренднойПлаты()
	
	Результат = УПД970_ТекстЗапросаРублевыхСуммДокументовВВалюте()
	+ ТекстЗапроса_РазделительЗапросов() +
	"ВЫБРАТЬ
	|	""Услуги"" КАК ИмяТабличнойЧасти,
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА """"
	|		ИНАЧЕ ЕСТЬNULL(Таблица.Номенклатура.Код, """")
	|	КОНЕЦ КАК НоменклатураКод,
	|	&НаименованиеУслуги КАК НоменклатураНаименование,
	|	ЕСТЬNULL(Таблица.Номенклатура.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	Таблица.Количество КАК Количество,
	|	Таблица.Цена КАК Цена,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	ИСТИНА КАК ЭтоУслуга,
	|	НЕОПРЕДЕЛЕНО КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0) КАК ВсегоРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0) КАК НДСРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0) КАК СуммаБезНДСРуб
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.АР_НачислениеАренднойПлаты.Состав КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО Таблица.НомерСтроки = РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента
	|			И (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Услуги))
	|			И (Таблица.Ссылка.ВалютаДокумента <> &ВалютаРеглУчета)
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДокумента.Номенклатура КАК Номенклатура,
	|	ТаблицаДокумента.НоменклатураКод КАК НоменклатураКод,
	|	ТаблицаДокумента.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ТаблицаДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименованиеПолное,
	|	НЕОПРЕДЕЛЕНО КАК КодТНВЭД,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокумента.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокумента.Цена
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТаблицаДокумента.Сумма - ТаблицаДокумента.СуммаНДС
	|		ИНАЧЕ ТаблицаДокумента.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТаблицаДокумента.Сумма
	|		ИНАЧЕ ТаблицаДокумента.Сумма + ТаблицаДокумента.СуммаНДС
	|	КОНЕЦ КАК Всего,
	|	ТаблицаДокумента.СуммаНДС КАК СуммаНДС,
	|	ТаблицаДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаДокумента.ЭтоУслуга КАК ЭтоУслуга,
	|	ТаблицаДокумента.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаДокумента.ВсегоРуб КАК ВсегоРуб,
	|	ТаблицаДокумента.НДСРуб КАК НДСРуб,
	|	ТаблицаДокумента.СуммаБезНДСРуб КАК СуммаБезНДСРуб
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ТаблицаДокумента.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	УПД970_ЗаполнитьВТекстеЗапросаВыражениеСКодомТовараУслуги(Результат);
	УПД970_ЗаполнитьВТекстеЗапросаВыражениеСНаименованиемУслуги(Результат);

	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаРеквизитовОтчетаКомитентуОПродажах()
	
	Результат =
	"ВЫБРАТЬ
	|	ТЧПоставщики.Поставщик КАК Поставщик,
	|	ТЧПоставщики.КлючСтроки КАК КлючСтроки,
	|	ТЧПоставщики.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ТЧПоставщики.Партия.Грузоотправитель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Грузоотправитель,
	|	ЕСТЬNULL(ТЧПоставщики.Партия.Грузополучатель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Грузополучатель,
	|	ТЧПоставщики.ДатаСФ КАК ДатаСФ,
	|	ТЧПоставщики.Партия КАК Партия
	|ПОМЕСТИТЬ ВТ_КлючиСтрок
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ТЧПоставщики
	|ГДЕ
	|	ТЧПоставщики.Ссылка = &Ссылка
	|	И ТЧПоставщики.СчетФактура = &СчетФактура
	|	И ТЧПоставщики.СчетФактура <> ЗНАЧЕНИЕ(Документ.СчетФактураВыданный.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЧПоставщики.КлючСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТЧПоставщики.Поставщик) КАК Продавец,
	|	МАКСИМУМ(ТЧПоставщики.Грузоотправитель) КАК Грузоотправитель,
	|	МАКСИМУМ(ТЧПоставщики.Грузополучатель) КАК Грузополучатель,
	|	ТЧПоставщики.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Поставщики
	|ИЗ
	|	ВТ_КлючиСтрок КАК ТЧПоставщики
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧПоставщики.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Номер КАК Номер,
	|	Реквизиты.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|					ТОГДА Реквизиты.Организация.ЦифровойИндексОбособленногоПодразделения
	|				ИНАЧЕ """"
	|			КОНЕЦ
	|	КОНЕЦ КАК ЦифровойИндексОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Реквизиты.ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|						ТОГДА Реквизиты.Организация.ГоловнаяОрганизация
	|					ИНАЧЕ Реквизиты.Организация
	|				КОНЕЦ
	|		КОГДА ЕСТЬNULL(ВТ_Поставщики.Продавец, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И ВТ_Поставщики.Продавец.ОбособленноеПодразделение
	|				И ВТ_Поставщики.Продавец.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА ВТ_Поставщики.Продавец.ГоловнойКонтрагент
	|		КОГДА ЕСТЬNULL(ВТ_Поставщики.Продавец, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВТ_Поставщики.Продавец
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|					ТОГДА Реквизиты.Организация.ГоловнаяОрганизация
	|				ИНАЧЕ Реквизиты.Организация
	|			КОНЕЦ
	|	КОНЕЦ КАК Поставщик,
	|	ВЫБОР
	|		КОГДА Реквизиты.ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|						ТОГДА Реквизиты.ПодразделениеОрганизации
	|					ИНАЧЕ Реквизиты.Организация
	|				КОНЕЦ
	|		КОГДА ЕСТЬNULL(ВТ_Поставщики.Продавец, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ_Поставщики.Грузоотправитель.ОбособленноеПодразделение
	|							И ВТ_Поставщики.Грузоотправитель.ГоловнойКонтрагент = ВТ_Поставщики.Продавец
	|							И ВТ_Поставщики.Грузоотправитель.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|						ТОГДА ВТ_Поставщики.Грузоотправитель
	|					ИНАЧЕ ВТ_Поставщики.Продавец
	|				КОНЕЦ
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделениеПоставщика,
	|	ВЫБОР
	|		КОГДА Реквизиты.ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации = ИСТИНА
	|			ТОГДА ""он же""
	|		КОГДА ВТ_Поставщики.Грузоотправитель = ВТ_Поставщики.Продавец
	|			ТОГДА ""он же""
	|		КОГДА ЕСТЬNULL(ВТ_Поставщики.Грузоотправитель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВТ_Поставщики.Грузоотправитель
	|		КОГДА ЕСТЬNULL(ВТ_Поставщики.Продавец, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И ВТ_Поставщики.Продавец.ОбособленноеПодразделение
	|			ТОГДА ВТ_Поставщики.Продавец
	|		КОГДА НЕ ВТ_Поставщики.Грузоотправитель ЕСТЬ NULL
	|			ТОГДА ""он же""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА Реквизиты.Контрагент.ОбособленноеПодразделение
	|				И Реквизиты.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК Покупатель,
	|	Реквизиты.Контрагент КАК ОбособленноеПодразделениеПокупателя,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_Поставщики.Грузополучатель, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ВТ_Поставщики.Грузополучатель
	|		КОГДА НЕ ВТ_Поставщики.Грузополучатель ЕСТЬ NULL
	|			ТОГДА Реквизиты.Организация
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Грузополучатель,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	Реквизиты.ДоговорКонтрагента КАК Договор,
	|	Реквизиты.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем КАК НДСИсчисляетсяНалоговымАгентом,
	|	Реквизиты.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	Реквизиты.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Реквизиты.ДоговорКонтрагента.Наименование КАК Основание,
	|	Реквизиты.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Реквизиты.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.ГосударственныйКонтракт.Код, """") КАК ИдентификаторГосКонтракта,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК Реквизиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Поставщики КАК ВТ_Поставщики
	|		ПО Реквизиты.Ссылка = ВТ_Поставщики.Ссылка
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличныхДанныхОтчетаКомитентуОПродажах()
	
	ТекстЗапросаТабличныхДанных =
	"ВЫБРАТЬ
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Номенклатура.Код КАК НоменклатураКод,
	|	Таблица.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Таблица.Содержание КАК СТРОКА(1000)), """") <> """"
	|			ТОГДА Таблица.Содержание
	|		КОГДА ЕСТЬNULL(ВТ_НаименованиеУслуг.Содержание, """") <> """"
	|			ТОГДА ВТ_НаименованиеУслуг.Содержание
	|		КОГДА ЕСТЬNULL(ВЫРАЗИТЬ(Таблица.Номенклатура.НаименованиеПолное КАК СТРОКА(1000)), """") <> """"
	|			ТОГДА Таблица.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ Таблица.Номенклатура.Наименование
	|	КОНЕЦ КАК НоменклатураНаименование,
	|	Таблица.Номенклатура.КодТНВЭД КАК НоменклатураКодТНВЭД,
	|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Таблица.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	&НомерГТД КАК НомерГТД,
	|	Таблица.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Таблица.Количество КАК Количество,
	|	Таблица.Цена КАК Цена,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(Таблица.Номенклатура.Услуга, ИСТИНА) КАК ЭтоУслуга,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВТ_КлючиСтрок.Партия КАК Партия,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0) КАК ВсегоРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0) КАК СуммаБезНДСРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0) КАК НДСРуб,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КлючиСтрок КАК ВТ_КлючиСтрок
	|		ПО Таблица.Ссылка = ВТ_КлючиСтрок.Ссылка
	|			И Таблица.КлючСтроки = ВТ_КлючиСтрок.КлючСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах КАК Реквизиты
	|		ПО (ВТ_КлючиСтрок.Ссылка = Реквизиты.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО Таблица.НомерСтроки = РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента
	|			И (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Товары))
	|			И (Реквизиты.ВалютаДокумента <> &ВалютаРеглУчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НаименованиеУслуг КАК ВТ_НаименованиеУслуг
	|		ПО Таблица.КлючСтроки = ВТ_НаименованиеУслуг.КлючСтроки
	|			И Таблица.Номенклатура = ВТ_НаименованиеУслуг.Номенклатура
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	"""",
	|	Таблица.НомерСтроки,
	|	Таблица.Ссылка,
	|	Таблица.Номенклатура,
	|	Таблица.НоменклатураКод,
	|	Таблица.НоменклатураАртикул,
	|	ВЫБОР
	|		КОГДА Таблица.НоменклатураНаименование ПОДОБНО """"
	|			ТОГДА ""Комиссионное вознаграждение""
	|		ИНАЧЕ Таблица.НоменклатураНаименование
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	"""",
	|	"""",
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка),
	|	0,
	|	0,
	|	Таблица.Сумма,
	|	Таблица.СуммаНДС,
	|	Таблица.СтавкаНДС,
	|	Таблица.ЭтоУслуга,
	|	Таблица.СуммаВключаетНДС,
	|	НЕОПРЕДЕЛЕНО,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0),
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0),
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0),
	|	""""
	|ИЗ
	|	ВТВознаграждение КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.ПустаяСсылка))
	|			И (Таблица.ВалютаДокумента <> &ВалютаРеглУчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА Таблица.НоменклатураАртикул
	|		ИНАЧЕ Таблица.НоменклатураКод
	|	КОНЕЦ КАК НоменклатураКод,
	|	Таблица.НоменклатураНаименование КАК НоменклатураНаименование,
	|	Таблица.СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	Таблица.НомерГТД КАК НомерГТД,
	|	Таблица.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименованиеПолное,
	|	Таблица.НоменклатураКодТНВЭД КАК КодТНВЭД,
	|	ВЫБОР
	|		КОГДА Таблица.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ Таблица.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА Таблица.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ Таблица.Цена
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА Таблица.Ссылка.СуммаВключаетНДС
	|			ТОГДА Таблица.Сумма - Таблица.СуммаНДС
	|		ИНАЧЕ Таблица.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА Таблица.Ссылка.СуммаВключаетНДС
	|			ТОГДА Таблица.Сумма
	|		ИНАЧЕ Таблица.Сумма + Таблица.СуммаНДС
	|	КОНЕЦ КАК Всего,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.ВсегоРуб КАК ВсегоРуб,
	|	Таблица.НДСРуб КАК НДСРуб,
	|	Таблица.СуммаБезНДСРуб КАК СуммаБезНДСРуб,
	|	Таблица.ЭтоУслуга КАК ЭтоУслуга,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ТаблицаДокумента КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО (СтраныМира.Ссылка = Таблица.СтранаПроисхождения)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО (КлассификаторЕдиницИзмерения.Ссылка = Таблица.ЕдиницаИзмерения)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	УПД970_ЗаполнитьВТекстеЗапросаВыражениеСНомеромГТД(ТекстЗапросаТабличныхДанных);

	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаРублевыхСуммДокументовВВалюте());
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаВременнаяТаблицаНаименованияУслуг());
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаВременнаяТаблицаВознаграждения());
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныхДанных);
	
	Результат = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаСведенийПрослеживаемостиОтчетаКомитентуОПродажах()
	
	Результат =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Таблица.РНПТ.Код КАК НомерТовара,
	|	Таблица.КоличествоПрослеживаемости КАК Количество,
	|	ЕСТЬNULL(ТаблицаТоваров.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Код, ""796"") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Наименование, ""шт"") КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА Таблица.Сумма = 0
	|			ТОГДА Таблица.Количество * ВЫБОР
	|					КОГДА Реквизиты.СуммаВключаетНДС
	|						ТОГДА (ТаблицаТоваров.Сумма - ТаблицаТоваров.СуммаНДС) / ТаблицаТоваров.Количество
	|					ИНАЧЕ ТаблицаТоваров.Цена
	|				КОНЕЦ
	|		ИНАЧЕ Таблица.Сумма
	|	КОНЕЦ КАК СтоимостьБезНалога
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.СведенияПрослеживаемости КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах.Товары КАК ТаблицаТоваров
	|		ПО Таблица.Ссылка = ТаблицаТоваров.Ссылка
	|			И Таблица.ИдентификаторСтроки = ТаблицаТоваров.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах КАК Реквизиты
	|		ПО Таблица.Ссылка = Реквизиты.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиВозвратаТоваровПоставщику()
	
	Результат =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Ссылка,
	|	Реквизиты.Номер КАК Номер,
	|	Реквизиты.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|					ТОГДА Реквизиты.Организация.ЦифровойИндексОбособленногоПодразделения
	|				ИНАЧЕ """"
	|			КОНЕЦ
	|	КОНЕЦ КАК ЦифровойИндексОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация.ГоловнаяОрганизация
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК Поставщик,
	|	ВЫБОР
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации
	|		ИНАЧЕ Реквизиты.Организация
	|	КОНЕЦ КАК ОбособленноеПодразделениеПоставщика,
	|	ВЫБОР
	|		КОГДА Реквизиты.Контрагент.ОбособленноеПодразделение
	|				И Реквизиты.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК Покупатель,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель.ОбособленноеПодразделение
	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент = Реквизиты.Контрагент
	|				И Реквизиты.Грузополучатель.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА Реквизиты.Грузополучатель
	|		ИНАЧЕ Реквизиты.Контрагент
	|	КОНЕЦ КАК ОбособленноеПодразделениеПокупателя,
	|	Реквизиты.ДоговорКонтрагента КАК Договор,
	|	Реквизиты.ДоговорКонтрагента.Наименование КАК Основание,
	|	Реквизиты.ДоговорКонтрагента.Дата КАК ОснованиеДата,
	|	Реквизиты.ДоговорКонтрагента.Номер КАК ОснованиеНомер,
	|	Реквизиты.ДоговорКонтрагента.УчетАгентскогоНДСПокупателем КАК НДСИсчисляетсяНалоговымАгентом,
	|	Реквизиты.ДоговорКонтрагента.ВидДоговора КАК ВидДоговора,
	|	Реквизиты.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(Реквизиты.ДоговорКонтрагента.ГосударственныйКонтракт.Код, """") КАК ИдентификаторГосКонтракта,
	|	Реквизиты.ВалютаДокумента КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Грузоотправитель
	|		КОГДА Реквизиты.ПодразделениеОрганизации.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.ПодразделениеОрганизации
	|		КОГДА Реквизиты.Организация.ОбособленноеПодразделение
	|			ТОГДА Реквизиты.Организация
	|		КОГДА Реквизиты.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером)
	|			ТОГДА Реквизиты.Организация
	|		ИНАЧЕ ""он же""
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Контрагент
	|		ИНАЧЕ Реквизиты.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	Реквизиты.СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаТабличныеДанныеВозвратаТоваровПоставщику()
	
	Результат = УПД970_ТекстЗапросаРублевыхСуммДокументовВВалюте()
	+ ТекстЗапроса_РазделительЗапросов() +
	"ВЫБРАТЬ
	|	1 КАК ПорядокТЧ,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	&КодТовараУслуги КАК НоменклатураКод,
	|	&НаименованиеНоменклатуры КАК НоменклатураНаименование,
	|	Таблица.Номенклатура.Услуга КАК ЭтоУслуга,
	|	Таблица.Номенклатура.КодТНВЭД КАК НоменклатураКодТНВЭД,
	|	Таблица.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Таблица.Количество КАК Количество,
	|	Таблица.Цена КАК Цена,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.СтавкаНДС КАК СтавкаНДС,
	|	Таблица.СуммаНДС КАК СуммаНДС,
	|	&НомерГТД КАК НомерГТД,
	|	Таблица.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Таблица.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	Таблица.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.Всего, 0) КАК ВсегоРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НДС, 0) КАК НДСРуб,
	|	ЕСТЬNULL(РегистрСведенийРублевыеСуммыДокументовВВалюте.НалоговаяБазаНДС, 0) КАК СуммаБезНДСРуб
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.Товары КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийРублевыеСуммыДокументовВВалюте КАК РегистрСведенийРублевыеСуммыДокументовВВалюте
	|		ПО Таблица.НомерСтроки = РегистрСведенийРублевыеСуммыДокументовВВалюте.НомерСтрокиДокумента
	|			И (РегистрСведенийРублевыеСуммыДокументовВВалюте.ТабличнаяЧастьДокумента = ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Товары))
	|			И (Таблица.Ссылка.ВалютаДокумента <> &ВалютаРеглУчета)
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.ПорядокТЧ КАК ПорядокТЧ,
	|	ТаблицаДокумента.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДокумента.Номенклатура КАК Номенклатура,
	|	ТаблицаДокумента.НоменклатураКод КАК НоменклатураКод,
	|	ТаблицаДокумента.НоменклатураНаименование КАК НоменклатураНаименование,
	|	ТаблицаДокумента.ЭтоУслуга КАК ЭтоУслуга,
	|	ТаблицаДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.НаименованиеПолное, """") КАК ЕдиницаИзмеренияНаименованиеПолное,
	|	ТаблицаДокумента.НоменклатураКодТНВЭД КАК КодТНВЭД,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокумента.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТаблицаДокумента.Цена
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТаблицаДокумента.Сумма - ТаблицаДокумента.СуммаНДС
	|		ИНАЧЕ ТаблицаДокумента.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Ссылка.СуммаВключаетНДС
	|			ТОГДА ТаблицаДокумента.Сумма
	|		ИНАЧЕ ТаблицаДокумента.Сумма + ТаблицаДокумента.СуммаНДС
	|	КОНЕЦ КАК Всего,
	|	ТаблицаДокумента.СуммаНДС КАК СуммаНДС,
	|	ТаблицаДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаДокумента.НомерГТД КАК НомерГТД,
	|	ТаблицаДокумента.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаДокумента.СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	ТаблицаДокумента.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТаблицаДокумента.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаДокумента.ВсегоРуб КАК ВсегоРуб,
	|	ТаблицаДокумента.НДСРуб КАК НДСРуб,
	|	ТаблицаДокумента.СуммаБезНДСРуб КАК СуммаБезНДСРуб
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ТаблицаДокумента.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокТЧ,
	|	НомерСтроки";

	УПД970_ЗаполнитьВТекстеЗапросаВыражениеСКодомТовараУслуги(Результат);
	УПД970_ЗаполнитьВТекстеЗапросаВыражениеСНаименованиемНоменклатуры(Результат);
	УПД970_ЗаполнитьВТекстеЗапросаВыражениеСНомеромГТД(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаСведенийПрослеживаемостиВозвратаТоваровПоставщику()

	Результат =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Таблица.РНПТ.Код КАК НомерТовара,
	|	Таблица.КоличествоПрослеживаемости КАК Количество,
	|	ЕСТЬNULL(ТаблицаТоваров.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(ТаблицаТоваров.КодТНВЭД.Код, ""796"") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Наименование, ""шт"") КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА Таблица.Сумма = 0
	|			ТОГДА Таблица.Количество * ВЫБОР
	|					КОГДА Реквизиты.СуммаВключаетНДС
	|						ТОГДА (ТаблицаТоваров.Сумма - ТаблицаТоваров.СуммаНДС) / ТаблицаТоваров.Количество
	|					ИНАЧЕ ТаблицаТоваров.Цена
	|				КОНЕЦ
	|		ИНАЧЕ Таблица.Сумма
	|	КОНЕЦ КАК СтоимостьБезНалога
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику.СведенияПрослеживаемости КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары КАК ТаблицаТоваров
	|		ПО Таблица.Ссылка = ТаблицаТоваров.Ссылка
	|			И Таблица.ИдентификаторСтроки = ТаблицаТоваров.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику КАК Реквизиты
	|		ПО Таблица.Ссылка = Реквизиты.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка";
	
	Возврат Результат;
	
