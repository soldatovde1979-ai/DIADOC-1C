Функция ТекстЗапроса_СкорректированныеСвязиДляОтправленныхДокументов(ТекстЗапроса, ОписаниеВидаПакета)
	
	ВидПакетаID = ОписаниеВидаПакета.ID;
	КатегорияПакета = ОписаниеВидаПакета.КатегорияПакета;
	ОсновнойПакет = КатегорииПакетов_Основная();
	
	ПодстрокаПоиска = "&УсловиеСвязиПоКатегорииПакета";
	
	Если ЗначениеЗаполнено(КатегорияПакета) Тогда
		ПодстрокаЗамены = "ОтправленныеДокументы.КатегорияПакета = """ + КатегорияПакета + """"
			+ " ИЛИ ОтправленныеДокументы.КатегорияПакета ЕСТЬ NULL";
	Иначе
		ПодстрокаЗамены = "ОтправленныеДокументы.ВидПакета = &ВидПакетаID_" + ВидПакетаID
			+ " ИЛИ ОтправленныеДокументы.ВидПакета ЕСТЬ NULL";
	КонецЕсли;
	
	Если КатегорияПакета = КатегорииПакетов_СчетаНаОплату() Тогда
		
		ПодстрокаЗамены = ПодстрокаЗамены
			+ " ИЛИ ОтправленныеДокументы.КатегорияПакета = """ + ОсновнойПакет + """";
		
		ИспользоватьСХ2 = НЕ ОсновнойМодуль.ИспользоватьПодсистемуДиадока();
		ОснованияПоУмолчанию = Ядро_ОснованияВидовДокументов_ИспользуютсяТолькоНастройкиПоУмолчанию();
		
		Если ИспользоватьСХ2 И ОснованияПоУмолчанию Тогда
			ПодстрокаЗамены = "ИСТИНА";
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = СтрЗаменить(ТекстЗапроса, ПодстрокаПоиска, ПодстрокаЗамены);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ВременныеТаблицыДляСпискаПакетовНаОтправку()
	
	Результат = Ядро.СписокНаОтправку_ТекстЗапроса_ВременныеТаблицы();
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ВТДокументыБезНДС()
	
	ОсновнойЗапрос = ДокументыБезНДС_ТекстЗапроса_ВТДокументы() +
	";
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Документ,
	|	ВТ_Документы.ЭтоИсправление,
	|	ВТ_Документы.ЭтоКорректировка
	|ПОМЕСТИТЬ ВТ_ПодходящиеДокументы
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Документы.Документ,
	|	ВТ_Документы.ЭтоИсправление,
	|	ВТ_Документы.ЭтоКорректировка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВТ_Документы.ВсегоПозиций) = СУММА(ВТ_Документы.ПозицийБезНДС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПодходящиеДокументы.Документ,
	|	ВТ_ПодходящиеДокументы.ЭтоИсправление,
	|	ВТ_ПодходящиеДокументы.ЭтоКорректировка,
	|	ВТ_ПодходящиеДокументы.Документ.Проведен КАК Проведен,
	|	ВТ_ПодходящиеДокументы.Документ.Номер КАК НомерДокумента,
	|	ВТ_ПодходящиеДокументы.Документ.Дата КАК ДатаДокумента,
	|	ВТ_ПодходящиеДокументы.Документ.Контрагент КАК Контрагент,
	|	ВТ_ПодходящиеДокументы.Документ.Организация КАК Организация,
	|	ВТ_ПодходящиеДокументы.Документ.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТ_ДокументыБезНДС
	|ИЗ
	|	ВТ_ПодходящиеДокументы КАК ВТ_ПодходящиеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО ВТ_ПодходящиеДокументы.Документ = СчетФактураВыданныйДокументыОснования.ДокументОснование
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка ЕСТЬ NULL"; 
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ОсновнойЗапрос);
	
	Если Не ЗапрещеноЧтениеТаблицыДанныхДокумента(Метаданные.Документы.КорректировкаРеализации) Тогда
		ЧастиЗапроса.Добавить(ТекстЗапроса_ОбъединитьВсе());
		ЧастиЗапроса.Добавить(ДокументыБезСФ_ДобавитьТекстЗапросаПОКРТУКомиссионера());
	КонецЕсли;
	
	Если Не ЗапрещеноЧтениеТаблицыДанныхДокумента(Метаданные.Документы.ОтчетКомитентуОПродажах) Тогда
		ЧастиЗапроса.Добавить(ТекстЗапроса_ОбъединитьВсе());
		ЧастиЗапроса.Добавить(ДокументыБезСФ_ДобавитьТекстЗапроса_ОтчетКомитентуОПродажах());
	КонецЕсли;
	
	Если Не ЗапрещеноЧтениеТаблицыДанныхДокумента(Метаданные.Документы.ПередачаТоваров) Тогда
		ЧастиЗапроса.Добавить(ТекстЗапроса_ОбъединитьВсе());
		ЧастиЗапроса.Добавить(ДокументыБезСФ_ДобавитьТекстЗапроса_ПередачаТоваров());
	КонецЕсли;
	
	Результат = СтрСоединить(ЧастиЗапроса, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

Процедура ТекстЗапроса_ДополнитьВременнойТаблицей_СчетФактурыПоОтчетуКомиссионера(ТекстЗапроса)
	
	Если ЗапрещеноЧтениеТаблицыДанныхДокумента(Метаданные.Документы.СчетФактураВыданный)
		Или ЗапрещеноЧтениеТаблицыДанныхДокумента(Метаданные.Документы.ОтчетКомиссионераОПродажах) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапросаВременныхТаблиц = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактура.Ссылка КАК Документ,
		|	СчетФактура.Проведен КАК Проведен,
		|	СчетФактура.Номер КАК НомерДокумента,
		|	СчетФактура.Дата КАК ДатаДокумента,
		|	ОтчетКомиссионера.Контрагент КАК Контрагент,
		|	СчетФактура.Организация КАК Организация,
		|	СчетФактура.СуммаДокумента КАК СуммаДокумента,
		|	СчетФактура.СводныйКомиссионный КАК Сводный,
		|	СчетФактура.ВидСчетаФактуры КАК ВидСчетаФактуры
		|ПОМЕСТИТЬ ВТ_СчетФактурыПоОтчетуКомиссионера
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионераОПродажах КАК ОтчетКомиссионера
		|		ПО СчетФактура.ДокументОснование = ОтчетКомиссионера.Ссылка
		|ГДЕ
		|	СчетФактура.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ СчетФактура.СводныйКомиссионный
		|	И НЕ СчетФактура.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Документ";
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_РазделительЗапросов() + ТекстЗапросаВременныхТаблиц;
	
КонецПроцедуры

Процедура ТекстЗапроса_ДополнитьВременнойТаблицейДокументовБезНДС(ТекстЗапроса, НужнаВТДокументыБезНДС)

	Если НужнаВТДокументыБезНДС Тогда
		
		ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_РазделительЗапросов() + ТекстЗапроса_ВТДокументыБезНДС();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДокументыБезНДС_ТекстЗапроса_ВТДокументы()
	
	Запросы = Новый Массив;
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "АктОбОказанииПроизводственныхУслуг", "Услуги");
	
	ТекстОтбораДокументов = ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураТребуется("ТабличнаяЧасть.Ссылка");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияТоваровУслуг", "Товары", ТекстОтбораДокументов);
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияТоваровУслуг", "Услуги");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияТоваровУслуг", "АгентскиеУслуги");
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииОтгруженныхТоваров(Запросы);
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "РеализацияУслугПоПереработке", "Услуги");
	
	Если Метаданные.Документы.Найти("АР_НачислениеАренднойПлаты") <> Неопределено Тогда
		ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "АР_НачислениеАренднойПлаты", "Состав");
	КонецЕсли;
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "ПередачаОС", "ОС");
	
	ТекстОтбораДокументов = ТекстЗапрос_ОтборКорректировкиВПервичныхДокументах();
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Товары", ТекстОтбораДокументов, "Истина");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Услуги", ТекстОтбораДокументов, "Истина");
	
	ТекстОтбораДокументов = ТекстЗапрос_ОтборКорректировкиПоСогласованиюСторон();
	
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Товары", ТекстОтбораДокументов, , "Истина");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "Услуги", ТекстОтбораДокументов, , "Истина");
	ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, "КорректировкаРеализации", "АгентскиеУслуги", ТекстОтбораДокументов, , "Истина");
	
	ДокументыБезСФ_ДобавитьТекстЗапросаПоРТУ(Запросы);
	ДокументыБезСФ_ДобавитьТекстЗапросаПоВозвратам(Запросы);
	
	Результат = ОсновнойМодуль.ЭДО_Служебные_МассивВСтроку(Запросы, ТекстЗапроса_ОбъединитьВсе());
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоДаннымТЧ(Запросы, ВидДокумента, ТабличнаяЧасть, Условие = "", Исправление = "Ложь", Корректировка = "Ложь")
	
	МетаданныеДокумента = Метаданные.Документы.Найти(ВидДокумента);
	
	Если МетаданныеДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗапрещеноЧтениеТаблицыДанныхДокумента(МетаданныеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ТабличнаяЧасть) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|	ТабличнаяЧасть.Ссылка КАК Документ,
	|	1 КАК ВсегоПозиций,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПозицийБезНДС,
	|	&Исправление КАК ЭтоИсправление,
	|	&Корректировка КАК ЭтоКорректировка
	|ИЗ
	|	&Таблица КАК ТабличнаяЧасть
	|ГДЕ
	|	НЕ ТабличнаяЧасть.Ссылка.ПометкаУдаления
	|	И ТабличнаяЧасть.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода" + Условие;
	
	Таблица = "Документ" + "." + ВидДокумента + "." + ТабличнаяЧасть;
	
	Результат = СтрЗаменить(Результат, "&Таблица", Таблица);
	Результат = СтрЗаменить(Результат, "&Исправление", Исправление);
	Результат = СтрЗаменить(Результат, "&Корректировка", Корректировка);
	
	ДобавитьТекстЗапросаВПакет(Запросы, Результат);
	
КонецПроцедуры

Функция ТекстЗапрос_ОтборКорректировкиВПервичныхДокументах()
	
	Результат = " И ТабличнаяЧасть.Ссылка.ВидОперации = 
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапрос_ОтборКорректировкиПоСогласованиюСторон()
	
	Результат = " И ТабличнаяЧасть.Ссылка.ВидОперации = 
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение)";
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументыБезСФ_ДобавитьТекстЗапросаПоРТУ(Запросы)

	ИмяОбъектаМетаданных = "Документ.РеализацияТоваровУслуг";
	
	ТекстЗапроса = ТекстыЗапросов_ВыборкаДокументовЗаПериод(ИмяОбъектаМетаданных);
	
	ДополнительныеУсловия = ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураНеТребуется("Док");
	
	ТекстЗапроса = ТекстЗапроса + " И " + ДополнительныеУсловия;
	
	ДобавитьТекстЗапросаВПакет(Запросы, ТекстЗапроса);
	
КонецПроцедуры    

Процедура ДокументыБезСФ_ДобавитьТекстЗапросаПоВозвратам(Запросы)
	
	ОбъектМетаданных = Метаданные.Документы.ВозвратТоваровПоставщику;
	
	Если Не РазрешеноЧтениеТаблицы(ОбъектМетаданных) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = ТекстыЗапросов_ВыборкаДокументовЗаПериод(ОбъектМетаданных.ПолноеИмя());
	
	ДобавитьТекстЗапросаВПакет(Запросы, ТекстЗапроса);
	
КонецПроцедуры

Функция ДокументыБезСФ_ДобавитьТекстЗапросаПОКРТУКомиссионера()
	
	Результат = 
	"ВЫБРАТЬ
	|КРТУ.Ссылка КАК Документ,
	|ВЫБОР
	|	КОГДА КРТУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|		ТОГДА ИСТИНА
	|	ИНАЧЕ ЛОЖЬ
	|КОНЕЦ КАК ЭтоИсправление,
	|ВЫБОР
	|	КОГДА КРТУ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки)
	|		ТОГДА ЛОЖЬ
	|	ИНАЧЕ ИСТИНА
	|КОНЕЦ КАК ЭтоКорректировка,
	|КРТУ.Проведен КАК Проведен,
	|КРТУ.Номер КАК НомерДокумента,
	|КРТУ.Дата КАК ДатаДокумента,
	|КРТУ.Контрагент КАК Контрагент,
	|КРТУ.Организация КАК Организация,
	|КРТУ.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КРТУ
	|ГДЕ
	|	КРТУ.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером)
	|	И КРТУ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ КРТУ.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыБезСФ_ДобавитьТекстЗапроса_ОтчетКомитентуОПродажах()
	
	Результат = 
	"ВЫБРАТЬ
	|	ОТОП.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	ОТОП.Проведен КАК Проведен,
	|	ОТОП.Номер КАК НомерДокумента,
	|	ОТОП.Дата КАК ДатаДокумента,
	|	ОТОП.Контрагент КАК Контрагент,
	|	ОТОП.Организация КАК Организация,
	|	ОТОП.СуммаВознаграждения КАК СуммаДокумента
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах КАК ОТОП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах.Товары КАК ТоварыДокумента
	|		ПО ОТОП.Ссылка = ТоварыДокумента.Ссылка
	|ГДЕ
	|	НЕ ОТОП.ПометкаУдаления
	|	И ОТОП.СтавкаНДСВознаграждения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И ОТОП.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ТоварыДокумента.СуммаВознаграждения > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ОТОП.Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция ДокументыБезСФ_ДобавитьТекстЗапроса_ПередачаТоваров()
	
	Результат = 
	"ВЫБРАТЬ
	|	ШапкаПередачаТоваров.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	ШапкаПередачаТоваров.Проведен КАК Проведен,
	|	ШапкаПередачаТоваров.Номер КАК НомерДокумента,
	|	ШапкаПередачаТоваров.Дата КАК ДатаДокумента,
	|	ШапкаПередачаТоваров.Контрагент КАК Контрагент,
	|	ШапкаПередачаТоваров.Организация КАК Организация,
	|	СУММА(ТоварПередачаТоваров.Сумма) КАК СуммаДокумента
	|ИЗ
	|	Документ.ПередачаТоваров.Товары КАК ТоварПередачаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаТоваров КАК ШапкаПередачаТоваров
	|		ПО ТоварПередачаТоваров.Ссылка = ШапкаПередачаТоваров.Ссылка
	|ГДЕ
	|	НЕ ШапкаПередачаТоваров.ПометкаУдаления
	|	И ТоварПередачаТоваров.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И ШапкаПередачаТоваров.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ШапкаПередачаТоваров.Ссылка,
	|	ШапкаПередачаТоваров.Проведен,
	|	ШапкаПередачаТоваров.Номер,
	|	ШапкаПередачаТоваров.Дата,
	|	ШапкаПередачаТоваров.Контрагент,
	|	ШапкаПередачаТоваров.Организация";
	
	Возврат Результат;
	
КонецФункции

Процедура ДокументыБезНДС_ДобавитьТекстЗапросаПоРеализацииОтгруженныхТоваров(Запросы)
	
	ОбъектМетаданных = Метаданные.Документы.РеализацияОтгруженныхТоваров;
	
	Если ЗапрещеноЧтениеТаблицыДанныхДокумента(ОбъектМетаданных) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Документ,
	|	1 КАК ВсегоПозиций,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПозицийБезНДС,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК ТабличнаяЧасть
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияОтгруженныхТоваров КАК Реквизиты
	|		ПО ТабличнаяЧасть.Ссылка = Реквизиты.ДокументОтгрузки
	|ГДЕ
	|	НЕ Реквизиты.ПометкаУдаления
	|	И Реквизиты.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	ДобавитьТекстЗапросаВПакет(Запросы, ТекстЗапроса);
	
КонецПроцедуры

Функция ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураНеТребуется(ПсевдонимТаблицы)
	
	ВидыОпераций = Новый Массив;
	ВидыОпераций.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.ПродажаКомиссия)"); 
	
	Если ИспользуетсяРеализацияЧерезПередачуТоваров() Тогда 
		ВидыОпераций.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.ПередачаТоваров)");
	КонецЕсли;
	
	ШаблонУсловия = "%1.ВидОперации В (%2)";
	
	ВидыИсправленийСтрокой = СтрСоединить(ВидыОпераций, ",");
	
	Результат = СтрШаблон(ШаблонУсловия, ПсевдонимТаблицы, ВидыИсправленийСтрокой);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураТребуется(ПсевдонимТаблицы)
	
	ОсновноеУсловие = ТекстыЗапросов_ДопУсловия_ВидыОперации_СчетФактураНеТребуется(ПсевдонимТаблицы);
	
	ШаблонУсловия = " И НЕ (%1)";
	
	Результат = СтрШаблон(ШаблонУсловия, ОсновноеУсловие);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстыЗапросов_ВыборкаДокументовЗаПериод(ИмяОбъектаМетаданных)

	Результат = 
	"ВЫБРАТЬ
	|	Док.Ссылка 	КАК Документ,
	|	0 			КАК ВсегоПозиций,
	|	0 			КАК ПозицийБезНДС,
	|	Ложь 		КАК ЭтоИсправление,
	|	Ложь 		КАК ЭтоКорректировка
	|ИЗ
	|	&Таблица КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Результат = СтрЗаменить(Результат, "&Таблица", ИмяОбъектаМетаданных);
	
	Возврат Результат;
	
КонецФункции

