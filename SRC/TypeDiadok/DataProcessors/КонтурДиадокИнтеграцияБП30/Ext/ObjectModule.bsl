Процедура УПД970_ЗаполнитьЧисловыеДанныеИСтавкуНДСпоСтроке(
		Item,
		ИсходнаяСтрока,
		НуженПересчетВРубли,
		НДСИсчисляетсяНалоговымАгентом,
		ТочностьКоличества,
		ТочностьЦены,
		ЦенаВключаетНДС)
	
	Если НуженПересчетВРубли Тогда
		
		СуммаБезНДС = ИсходнаяСтрока.ВсегоРуб - ИсходнаяСтрока.НДСРуб;
		СуммаНДС = ИсходнаяСтрока.НДСРуб;
		СуммаВсего = ИсходнаяСтрока.ВсегоРуб;
		
	Иначе
		
		СуммаБезНДС = ИсходнаяСтрока.СуммаБезНДС;
		СуммаНДС = ИсходнаяСтрока.СуммаНДС;
		СуммаВсего = ИсходнаяСтрока.Всего;
		
	КонецЕсли;
	
	Если НДСИсчисляетсяНалоговымАгентом Тогда
		СуммаНДС = 0;
		СуммаВсего = 0;
	КонецЕсли;
	
	Количество = 0;
	Если ЗначениеЗаполнено(ИсходнаяСтрока.Количество) Тогда
		Количество = Окр(ИсходнаяСтрока.Количество, ТочностьКоличества);
	КонецЕсли;
	
	Цена = 0;
	Если ЗначениеЗаполнено(ИсходнаяСтрока.Количество) Тогда
		Если (ЦенаВключаетНДС
			И ЗначениеЗаполнено(СуммаНДС))
			ИЛИ НуженПересчетВРубли Тогда
			Цена = Окр(СуммаБезНДС / ИсходнаяСтрока.Количество, ТочностьЦены);
		Иначе
			Цена = ИсходнаяСтрока.Цена;
		КонецЕсли;
	КонецЕсли;
	
	Item.Quantity = Количество;
	Item.Price = Цена;
	Item.SubtotalWithVatExcluded = СуммаБезНДС;
	Item.Vat = СуммаНДС;
	Item.Subtotal = СуммаВсего;
	
	Item.TaxRate = ПредставлениеСтавкиНДС(ИсходнаяСтрока.СтавкаНДС, НДСИсчисляетсяНалоговымАгентом);
	Item.WithoutVat = УПД970_ЗначениеПризнакаБезНДС(ИсходнаяСтрока.СтавкаНДС);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьИтоговыеЗначенияПоТаблице(Таблица)
	
	Таблица.TotalNet = 0;
	Таблица.TotalWithVatExcluded = 0;
	Таблица.Vat = 0;
	Таблица.Total = 0;
	
	XmlЗначениеЛожь = XMLСтрока(Ложь);
	
	Таблица.WithoutVat = XMLСтрока(Истина);
	
	Для Каждого Item Из Таблица.Items Цикл
		
		Таблица.TotalNet = Таблица.TotalNet + Item.Quantity;
		Таблица.TotalWithVatExcluded = Таблица.TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
		Таблица.Vat = Таблица.Vat + Item.Vat;
		Таблица.Total = Таблица.Total + Item.Subtotal;
		
		Если Item.WithoutVat = XmlЗначениеЛожь Тогда
			Таблица.WithoutVat = XmlЗначениеЛожь;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

