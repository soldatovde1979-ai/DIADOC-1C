// Значения реквизитов документов учета организация контрагент
//
// Параметры:
//  ДокументыПоТипам - Соответствие - Соотвествие типов документов где ключ это Тип документа а значение это массив документов
// 
// Возвращаемое значение:
//  Соотвествие - Соответствие в котором ключом является сам документ а в значении структура ревизитов (Организация, Контрагент) 
//
Функция ЗначенияРеквизитовДокументовУчета_ОрганизацияКонтрагент(КоллекцияДокументов) Экспорт
	
	ПервыйЭлемент = КоллекцияДокументов[0];
	МетаданныеЭлемента = ПервыйЭлемент.Метаданные();
	
	Реквизиты = Новый Массив;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеЭлемента) Тогда
		Реквизиты.Добавить("Организация");
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеЭлемента) Тогда
		Реквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(КоллекцияДокументов, Реквизиты, Истина);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументаУчетаДляПакетаНаОтправку(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("НомерДокумента", "");
	Результат.Вставить("ДатаДокумента", '00010101');
	Результат.Вставить("СуммаДокумента", "");
	Результат.Вставить("ДокументБезНДС", Ложь);
	Результат.Вставить("ТипДокументаПоддерживается", Истина);
	Результат.Вставить("КатегорияПакета", "ОсновнойПакет");
	
	Если ЭтоПодходящийСчетФактураДляПакетаНаОтправку(СсылкаНаОбъект) Тогда
		
		ВыборкаРеквизитов = ВыборкаРеквизитовСчетФактурыДляПакетаНаОтправку(СсылкаНаОбъект);
		
		Если ЭтоСчетФактураВыданныйНаАванс(СсылкаНаОбъект) Тогда
			Результат.КатегорияПакета = "СчетФактураНаАванс";
		КонецЕсли;
		
	ИначеЕсли ЭтоРеализацияТоваровУслуг(СсылкаНаОбъект) Тогда
		
		Если ЭтоРеализацияДляКоторойСчетФактураНеТребуется(СсылкаНаОбъект) Тогда
			Результат.ДокументБезНДС = Истина;
		Иначе
			Результат.ДокументБезНДС = РеализацияТоваровУслугБезНДС(СсылкаНаОбъект);
		КонецЕсли;
		
		Если Результат.ДокументБезНДС Тогда
			ВыборкаРеквизитов = ВыборкаРеквизитовРеализацииДляПакетаНаОтправку(СсылкаНаОбъект);
		Иначе
			ВыборкаРеквизитов = ВыборкаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку(СсылкаНаОбъект);
		КонецЕсли;
		
	Иначе
		
		Результат.ТипДокументаПоддерживается = Ложь;
		
	КонецЕсли;
	
	Если Результат.ТипДокументаПоддерживается
		И ВыборкаРеквизитов.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, ВыборкаРеквизитов);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаРеквизитовСчетФактурыДляПакетаНаОтправку(СсылкаНаОбъект)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокСчетФактура.Ссылка КАК Документ,
	|	ДокСчетФактура.Контрагент КАК Контрагент,
	|	ДокСчетФактура.Организация КАК Организация,
	|	ДокСчетФактура.Номер КАК НомерДокумента,
	|	ДокСчетФактура.Дата КАК ДатаДокумента,
	|	ДокСчетФактура.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный КАК ДокСчетФактура
	|ГДЕ
	|	ДокСчетФактура.Ссылка = &СсылкаНаОбъект
	|	И НЕ ДокСчетФактура.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаРеквизитовРеализацииДляПакетаНаОтправку(СсылкаНаОбъект)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслуг.Ссылка КАК Документ,
	|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
	|	РеализацияТоваровУслуг.Организация КАК Организация,
	|	РеализацияТоваровУслуг.Номер КАК НомерДокумента,
	|	РеализацияТоваровУслуг.Дата КАК ДатаДокумента,
	|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку(СсылкаНаОбъект)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Контрагент КАК Контрагент,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Организация КАК Организация,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер КАК НомерДокумента,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Дата КАК ДатаДокумента,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПодходящийСчетФактураДляПакетаНаОтправку(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	Если ЭтоСчетФактураВыданныйНаАванс(СсылкаНаОбъект) Тогда
		Результат = НЕ ЭтоИсправительныйИлиКорректировочныйСчетФактура(СсылкаНаОбъект);
	ИначеЕсли ЭтоСчетФактураВыданный(СсылкаНаОбъект) Тогда
		Результат = НЕ ЭтоИсправительныйИлиКорректировочныйСчетФактура(СсылкаНаОбъект)
			И МодульПоддерживаетОбработкуДокументаОснованияСчетФактуры(СсылкаНаОбъект);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоИсправительныйИлиКорректировочныйСчетФактура(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	РеквизитыСФ = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, "ВидСчетаФактуры, Исправление");
	ВидСФКорректировочный = ПредопределенноеЗначение("Перечисление.ВидСчетаФактурыВыставленного.Корректировочный");
	
	Если РеквизитыСФ.ВидСчетаФактуры = ВидСФКорректировочный
		Или РеквизитыСФ.Исправление = Истина Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МодульПоддерживаетОбработкуДокументаОснованияСчетФактуры(СсылкаНаОбъект)
	
	Результат = Истина;
	
	ВидыПредопределенныхДокументов = ВидыПредопределенныхДокументовДляПоискаВМодуле();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &СсылкаНаОбъект";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументОснование = Выборка.ДокументОснование;
		
		Если ВидыПредопределенныхДокументов.Найти(ДокументОснование.Метаданные()) = Неопределено Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Определяет необходимость наличия счета-фактуры выданного у документа реализации товаров и услуг
//
// Параметры:
//  Документ1С	 - ДокументСсылка	 - реализация товаров и услуг, у которой необходимо проверить необходимость наличия СФ  
// 
// Возвращаемое значение:
//  Результат	- Булево - Истина, если требуется наличие счета-фактуры 
//
Функция ТребуетсяСчетФактура(Документ1С) Экспорт

	Результат = Ложь;
	
	Если ТипЗнч(Документ1С) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ЭтоРеализацияДляКоторойСчетФактураНеТребуется = ЭтоРеализацияДляКоторойСчетФактураНеТребуется(Документ1С);
		УДокументаЕстьСчетФактураВыданный = УДокументаЕстьСчетФактураВыданный(Документ1С);
		ДокументБезНДС = РеализацияТоваровУслугБезНДС(Документ1С);
		Если Не ЭтоРеализацияДляКоторойСчетФактураНеТребуется
			И (Не ДокументБезНДС И Не УДокументаЕстьСчетФактураВыданный) Тогда
			
			Результат = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УДокументаЕстьСчетФактураВыданный(Документ1С)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", Документ1С);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Не РезультатЗапроса.Пустой();
	
	Возврат Результат;		
	
КонецФункции

// Находит связи с учетным документом, на основании которого формируется электронный счет на оплату.
// Алгоритм поиска связанных документов такой же, как в СчетаНаОплату_СвязанныеДокументы,
// но запрос строится универсально (по критерию отбора).
//
// Параметры:
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - учетный документ (счет, заказ, документ продажи),
//                               на основании которого формируется электронный счет на оплату.
// 
// Возвращаемое значение:
//  Массив из ЛюбаяСсылка.
//
Функция СчетаНаОплату_СвязанныеДокументыПоКритериюОтбора(ОснованиеЭлектронногоСчета) Экспорт
	
	Результат = Новый Массив;
	
	ИсключаемыеТипы = СчетаНаОплату_ИсключаемыеТипыСвязей();
	Результат = СвязиДокументов_НайтиПоКритериюОтбора(ОснованиеЭлектронногоСчета, ИсключаемыеТипы);
	
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета)
		Или ЭтоСчетНаАренду(ОснованиеЭлектронногоСчета) Тогда
		
		Для Каждого СвязанныйДокумент Из Результат Цикл
			
			ВторичныеСвязи = СвязиДокументов_НайтиПоКритериюОтбора(СвязанныйДокумент, ИсключаемыеТипы);
			Общее_ДополнитьМассив(Результат, ВторичныеСвязи);
			
		КонецЦикла;
		
	Иначе
		
		Если ЭтоРеализацияТоваровУслуг(ОснованиеЭлектронногоСчета) Тогда
			СчетНаОплату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеЭлектронногоСчета, "СчетНаОплатуПокупателю");
		ИначеЕсли ЭтоНачислениеАренднойПлаты(ОснованиеЭлектронногоСчета) Тогда
			СчетНаОплату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеЭлектронногоСчета, "ДокументОснование");
		Иначе
			СчетНаОплату = Неопределено;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(СчетНаОплату) Тогда
			Результат.Добавить(СчетНаОплату);
		КонецЕсли;
		
		Результат.Добавить(ОснованиеЭлектронногоСчета);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Находит связи с учетным документом, на основании которого формируется электронный счет на оплату.
// Если в аргументе передается счет на оплату, то в результат функции добавляются связи
// второго порядка. Например, документ реализации - это связь первого порядка.
// А счет-фактура на реализацию - это связь второго порядка.
//
// Параметры:
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - учетный документ (счет, заказ, документ продажи),
//                               на основании которого формируется электронный счет на оплату.
// 
// Возвращаемое значение:
//  Массив из ЛюбаяСсылка.
//
Функция СчетаНаОплату_СвязанныеДокументы(ОснованиеЭлектронногоСчета) Экспорт
	
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета)
		Или ЭтоСчетНаАренду(ОснованиеЭлектронногоСчета) Тогда
		
		Результат = СчетаНаОплату_СвязиПоСчетуНаОплату(ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеЭлектронногоСчета) Тогда
		
		Результат = СчетаНаОплату_СвязиПоДокументуПродажи(ОснованиеЭлектронногоСчета);
		Результат.Добавить(ОснованиеЭлектронногоСчета);
		
	Иначе
		
		Результат = Новый Массив;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_СвязиПоСчетуНаОплату(СчетНаОплату)
	
	Результат = Новый Массив;
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетНаОплатуПокупателю.ДокументОснование КАК Документ
		|ПОМЕСТИТЬ ВТ_СвязанныеПервичныеДокументы
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|ГДЕ
		|	СчетНаОплатуПокупателю.Ссылка = &СчетНаОплатуПокупателю
		|	И НЕ СчетНаОплатуПокупателю.ДокументОснование = Неопределено
		|    
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка КАК Документ
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.СчетНаОплатуПокупателю = &СчетНаОплатуПокупателю
		|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугТовары.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО РеализацияТоваровУслугТовары.Ссылка = РеализацияТоваровУслуг.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугТовары.СчетНаОплатуПокупателю = &СчетНаОплатуПокупателю
		|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугУслуги.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО РеализацияТоваровУслугУслуги.Ссылка = РеализацияТоваровУслуг.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугУслуги.СчетНаОплатуПокупателю = &СчетНаОплатуПокупателю
		|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровУслугАгентскиеУслуги.Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.АгентскиеУслуги КАК РеализацияТоваровУслугАгентскиеУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ПО РеализацияТоваровУслугАгентскиеУслуги.Ссылка = РеализацияТоваровУслуг.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслугАгентскиеУслуги.СчетНаОплатуПокупателю = &СчетНаОплатуПокупателю
		|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|" + "&ЗапросТаблицАрендаНедвижимости" + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ
		|ИЗ
		|	ВТ_СвязанныеПервичныеДокументы КАК ВТ_ДокументыОснованияСчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
		|		ПО ВТ_ДокументыОснованияСчетов.Документ = СчетФактураВыданныйДокументыОснования.ДокументОснование
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СвязанныеПервичныеДокументы.Документ
		|ИЗ
		|	ВТ_СвязанныеПервичныеДокументы КАК СвязанныеПервичныеДокументы";
	
	Если Метаданные.Документы.Найти("АР_НачислениеАренднойПлаты") <> Неопределено Тогда
		
		ТекстЗапросаАрендаНедвижимости = "
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	НачАренднойПлатыСостав.Ссылка
			|ИЗ
			|	Документ.АР_НачислениеАренднойПлаты.Состав КАК НачАренднойПлатыСостав
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АР_НачислениеАренднойПлаты КАК НачАренднойПлаты
			|		ПО НачАренднойПлатыСостав.Ссылка = НачАренднойПлаты.Ссылка
			|ГДЕ
			|	НачАренднойПлатыСостав.СчетНаАренду = &СчетНаОплатуПокупателю
			|	И НЕ НачАренднойПлаты.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	НачАренднойПлаты.Ссылка
			|ИЗ
			|	Документ.АР_НачислениеАренднойПлаты КАК НачАренднойПлаты
			|ГДЕ
			|	НачАренднойПлаты.ДокументОснование = &СчетНаОплатуПокупателю
			|	И НЕ НачАренднойПлаты.ПометкаУдаления"
			
		Иначе
			
			ТекстЗапросаАрендаНедвижимости = "";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЗапросТаблицАрендаНедвижимости", ТекстЗапросаАрендаНедвижимости);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СчетНаОплатуПокупателю", СчетНаОплату);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	Результат = ТаблицаРезультата.ВыгрузитьКолонку(0);
	
	Возврат Результат;
	
КонецФункции

