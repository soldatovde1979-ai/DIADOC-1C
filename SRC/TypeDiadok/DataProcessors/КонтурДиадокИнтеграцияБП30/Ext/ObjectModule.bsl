Процедура ДобавитьЗапросПоВидуПакетуПакета(Запросы, ОписаниеВидаПакета)
	
	ВидПакетаID = ОписаниеВидаПакета.ID;
	ЭтоИсправление = ЭтоИсправительныйВидПакета(ВидПакетаID);
	
	Если ВидПакетаID = "ID_ОсновнойПакет"
		ИЛИ ВидПакетаID = "ID_УПД"
		ИЛИ ВидПакетаID = "ID_УПД_раздельно" Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_НаРеализацию(
			Запросы,
			ОписаниеВидаПакета,
			ЭтоИсправление
		);
		
		ДобавитьТекстЗапроса_СчетаФактурыПоОтчетуКомиссионера_НаРеализацию(Запросы, ОписаниеВидаПакета);
		
	ИначеЕсли ВидПакетаID = "ID_УКД"
		ИЛИ ВидПакетаID = "ID_УКД_раздельно"
		ИЛИ ВидПакетаID = "ID_КСФ" Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_Корректировочный(
			Запросы,
			ОписаниеВидаПакета,
			ЭтоИсправление
		);
		
		ДобавитьТекстЗапроса_СчетаФактурыПоОтчетуКомиссионера_Корректировочный(Запросы, ОписаниеВидаПакета)
		
	ИначеЕсли ВидПакетаID = "ID_УПД_НаАванс"
		ИЛИ ВидПакетаID = "ID_СФ_НаАванс" Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_НаАванс(
			Запросы,
			ОписаниеВидаПакета,
			ЭтоИсправление
		);
		
		Если ПредопределенноеЗначение("Перечисление.ВидСчетаФактурыПолученного.НаАвансКомитента") <> Неопределено Тогда
			
			ДобавитьТекстЗапроса_СчетаФактуры_НаАвансКомитента(
				Запросы,
				ОписаниеВидаПакета,
				ЭтоИсправление
			);
			
		КонецЕсли;
		
		ДобавитьТекстЗапроса_СчетаФактурыПоОтчетуКомиссионера_НаАванс(Запросы, ОписаниеВидаПакета);
		
	ИначеЕсли ВидПакетаID = "ID_ИУПД"
		ИЛИ ВидПакетаID = "ID_ИУПД_раздельно"
		ИЛИ ВидПакетаID = "ID_ИСФ" Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_НаРеализацию(
			Запросы,
			ОписаниеВидаПакета,
			ЭтоИсправление
		);
		
	ИначеЕсли ВидПакетаID = "ID_ИУКД"
		ИЛИ ВидПакетаID = "ID_ИУКД_раздельно"
		ИЛИ ВидПакетаID = "ID_ИКСФ" Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_Корректировочный(
			Запросы,
			ОписаниеВидаПакета,
			ЭтоИсправление
		);
		
	ИначеЕсли ВидПакетаID = "ID_ИУПД_НаАванс"
		ИЛИ ВидПакетаID = "ID_ИСФ_НаАванс" Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_НаАванс(
			Запросы,
			ОписаниеВидаПакета,
			ЭтоИсправление
		);
		
	ИначеЕсли ВидПакетаID = "ID_ТОРГ12_Акт_БезНДС"
		ИЛИ ВидПакетаID = "ID_УПД_БезНДС"
		ИЛИ ВидПакетаID = "ID_ИУПД_БезНДС"
		ИЛИ ВидПакетаID = "ID_УКД_БезНДС" Тогда
		
		ДобавитьТекстЗапроса_ПервичныеДокументыБезНДС(Запросы, ОписаниеВидаПакета);
		
	ИначеЕсли ВидПакетаID = "ID_Счет"
		ИЛИ ВидПакетаID = "ID_СчетФормализованный"
		ИЛИ ВидПакетаID = "ID_СчетФормализованныйФНС"
		ИЛИ ВидПакетаID = "ID_СчетОфертаФормализованныйФНС" Тогда
		
		ИспользуютсяТолькоОснованияПоУмолчанию = Ядро_ОснованияВидовДокументов_ИспользуютсяТолькоНастройкиПоУмолчанию();
		
		Если ИспользуютсяТолькоОснованияПоУмолчанию Тогда
			
			ДобавитьТекстЗапроса_СчетаНаОплату(Запросы, ОписаниеВидаПакета)
			
		Иначе
			
			ТипОснования_СчетНаОплату 		= ТипОснованияСчетаНаОплату_СчетНаОплату();
			ТипОснования_ДокументПродажи	= ТипОснованияСчетаНаОплату_ДокументПродажи();
			
			ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
				Запросы,
				ОписаниеВидаПакета,
				"СчетНаОплатуПокупателю",
				ТипОснования_СчетНаОплату
			);
			ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
				Запросы,
				ОписаниеВидаПакета,
				"РеализацияТоваровУслуг",
				ТипОснования_ДокументПродажи
			);
			ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
				Запросы,
				ОписаниеВидаПакета,
				"РеализацияУслугПоПереработке",
				ТипОснования_ДокументПродажи
			);
			ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
				Запросы, 
				ОписаниеВидаПакета,
				"КорректировкаРеализации",
				ТипОснования_ДокументПродажи
			);
			ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
				Запросы,
				ОписаниеВидаПакета,
				"АктОбОказанииПроизводственныхУслуг",
				ТипОснования_ДокументПродажи
			);
			ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
				Запросы,
				ОписаниеВидаПакета,
				"ПередачаОС",
				ТипОснования_ДокументПродажи
			);
			
			ДобавитьТекстЗапроса_СчетаНаОплату_ОтчетКомитентуОПродажах(Запросы, ОписаниеВидаПакета);
			
			// Аренда
			Если Метаданные.Документы.Найти("АР_СчетНаАренду") <> Неопределено Тогда
				ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
					Запросы,
					ОписаниеВидаПакета,
					"АР_СчетНаАренду",
					ТипОснования_СчетНаОплату
				);
			КонецЕсли;
			
			Если Метаданные.Документы.Найти("АР_НачислениеАренднойПлаты") <> Неопределено Тогда
				ДобавитьТекстЗапросаПоОснованиюДляСчетаНаОплату(
					Запросы,
					ОписаниеВидаПакета,
					"АР_НачислениеАренднойПлаты",
					ТипОснования_ДокументПродажи
				);
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВидПакетаID = "ID_АктСверки"
		ИЛИ ВидПакетаID = "ID_АктСверкиФормализованный" Тогда
		
		ДобавитьТекстЗапроса_АктыСверок(Запросы, ОписаниеВидаПакета);
		
	КонецЕсли;
	
КонецПроцедуры

