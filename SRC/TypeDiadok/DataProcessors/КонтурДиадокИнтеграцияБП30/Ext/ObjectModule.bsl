	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Дебет КАК СуммаДебет,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Кредит КАК СуммаКредит,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Документ КАК Документ,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.НомерДокумента КАК НомерДокумента,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.ДатаДокумента КАК ДатаДокумента,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.НаименованиеДокумента КАК НаименованиеДокумента,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.НаименованиеОперации КАК НаименованиеОперации,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.Номер, """") КАК НомерДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВидДоговора, ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ПустаяСсылка)) КАК ВидДоговора
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК АктСверкиВзаиморасчетовПоДаннымОрганизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО АктСверкиВзаиморасчетовПоДаннымОрганизации.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоДоговорамАкта КАК ОстаткиПоДоговорамАкта
	|		ПО АктСверкиВзаиморасчетовПоДаннымОрганизации.Договор = ОстаткиПоДоговорамАкта.Договор
	|ГДЕ
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Ссылка = &Ссылка
	|ИТОГИ
	|	МАКСИМУМ(НачОстатокПоДоговоруДт),
	|	МАКСИМУМ(НачОстатокПоДоговоруКт),
	|	СУММА(СуммаДебет),
	|	СУММА(СуммаКредит),
	|	МАКСИМУМ(ДатаДоговора),
	|	МАКСИМУМ(НомерДоговора),
	|	МАКСИМУМ(ВидДоговора)
	|ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктСверкиВзаиморасчетовСверка.СверяемыйДокумент КАК Документ,
	|	АктСверкиВзаиморасчетовСверка.ДебетПоДаннымОрганизации КАК ДебетОрганизации,
	|	АктСверкиВзаиморасчетовСверка.КредитПоДаннымОрганизации КАК КредитОрганизации,
	|	АктСверкиВзаиморасчетовСверка.ДебетПоДаннымКонтрагента КАК ДебетКонтрагента,
	|	АктСверкиВзаиморасчетовСверка.КредитПоДаннымКонтрагента КАК КредитКонтрагента
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.Сверка КАК АктСверкиВзаиморасчетовСверка
	|ГДЕ
	|	АктСверкиВзаиморасчетовСверка.Ссылка = &Ссылка
	|	И АктСверкиВзаиморасчетовСверка.ЕстьРасхождения
	|	И ВЫРАЗИТЬ(АктСверкиВзаиморасчетовСверка.СверяемыйДокумент КАК СТРОКА(500)) ЕСТЬ NULL
	|";
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область АктCверки405_ЗаполнениеЭлементовПротоструктуры

Процедура АктСверки405_ЗаполнитьШапкуОтветногоТитула(Content)
	
	ReconciliationAct = Новый_RecipientData_ReconciliationAct();
	
	ReconciliationAct.IdentityInfoSender = Новый_IdentityInfoSender();
	ReconciliationAct.ReconciliationActTable = Новый_RecipientReconciliationActTable();
	ReconciliationAct.Signer = Новый_Signer_ReconciliationAct();
	
	Content.ReconciliationAct = ReconciliationAct;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьИтогиТабличнойЧастиОтветногоТитула(Content, ВыборкаДанныхАктаСверки, РеквизитыДокумента)
	
	ТаблицаИтогиПоОрганизации = ВыборкаДанныхАктаСверки[7].Выгрузить();
	ТаблицаИтогиПоКонтрагенту = ВыборкаДанныхАктаСверки[8].Выгрузить();
	
	ОстатокНаНачалоПоОрганизации = РеквизитыДокумента.ОстатокНаНачалоПоОрганизации;
	ОборотПоДебетуПоОрганизации = ТаблицаИтогиПоОрганизации.Итог("Дебет");
	ОборотПоКредитуПоОрганизации = ТаблицаИтогиПоОрганизации.Итог("Кредит");
	ОстатокНаКонецПоОрганизации = ОстатокНаНачалоПоОрганизации + ОборотПоДебетуПоОрганизации - ОборотПоКредитуПоОрганизации;
	
	ОстатокНаНачалоПоКонтрагенту = РеквизитыДокумента.ОстатокНаНачалоПоКонтрагенту;
	ОборотПоДебетуПоКонтрагенту = ТаблицаИтогиПоКонтрагенту.Итог("Дебет");
	ОборотПоКредитуПоКонтрагенту = ТаблицаИтогиПоКонтрагенту.Итог("Кредит");
	ОстатокНаКонецПоКонтрагенту = ОстатокНаНачалоПоКонтрагенту + ОборотПоДебетуПоКонтрагенту - ОборотПоКредитуПоКонтрагенту;
	
	ОстатокНаКонецРасхождение = ОстатокНаКонецПоОрганизации + ОстатокНаКонецПоКонтрагенту;
	
	ReconciliationActTable = Content.ReconciliationAct.ReconciliationActTable;
	
	ReconciliationActTable.BalanceDebitFrom = ?(ОстатокНаНачалоПоОрганизации > 0, ОстатокНаНачалоПоОрганизации, 0);
	ReconciliationActTable.BalanceAmountFrom = ?(ОстатокНаНачалоПоОрганизации < 0, -ОстатокНаНачалоПоОрганизации, 0);
	ReconciliationActTable.TurnoverDebit = ОборотПоДебетуПоОрганизации;
	ReconciliationActTable.TurnoverAmount = ОборотПоКредитуПоОрганизации;
	ReconciliationActTable.BalanceDebitEnd = ?(ОстатокНаКонецПоОрганизации > 0, ОстатокНаКонецПоОрганизации, 0);
	ReconciliationActTable.BalanceAmountEnd = ?(ОстатокНаКонецПоОрганизации < 0, -ОстатокНаКонецПоОрганизации, 0);
	ReconciliationActTable.TotalConsumptionDebit = ?(ОстатокНаКонецРасхождение > 0, ОстатокНаКонецРасхождение, 0);
	ReconciliationActTable.TotalConsumptionAmount = ?(ОстатокНаКонецРасхождение < 0, -ОстатокНаКонецРасхождение, 0);
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьТабличнуюЧастьОтветногоТитула(Content, ВыборкаДанныхАктаСверки, ДокСсылка)
	
	ВыборкаПоДоговорам = ВыборкаДанныхАктаСверки[9].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаРазличающихсяДокументов = ВыборкаДанныхАктаСверки[10].Выгрузить();
	
	ReconciliationActTable = Новый_RecipientReconciliationActTable();
	
	Пока ВыборкаПоДоговорам.Следующий() Цикл
		
		ContractInfo = Новый_RecipientContractInfo_ReconciliationAct();
		
		НачОстатокПоДоговоруДт = ВыборкаПоДоговорам.НачОстатокПоДоговоруДт;
		НачОстатокПоДоговоруКт = ВыборкаПоДоговорам.НачОстатокПоДоговоруКт;
		
		СуммаОборотДт = ВыборкаПоДоговорам.СуммаДебет;
		СуммаОборотКт = ВыборкаПоДоговорам.СуммаКредит;
		
		КонОстатокПоДоговоруДт = НачОстатокПоДоговоруДт + СуммаОборотДт;
		КонОстатокПоДоговоруКт = НачОстатокПоДоговоруКт + СуммаОборотКт;
		КонОстатокПоДоговору = КонОстатокПоДоговоруДт - КонОстатокПоДоговоруКт;
		
		ContractInfo.ContractAdditionalInfo = Строка(ВыборкаПоДоговорам.ВидДоговора);
		ContractInfo.ContractNumber = ВыборкаПоДоговорам.НомерДоговора;
		ContractInfo.ContractDate = ВыборкаПоДоговорам.ДатаДоговора;
		ContractInfo.BalanceDebitFrom = НачОстатокПоДоговоруДт;
		ContractInfo.BalanceAmountFrom = НачОстатокПоДоговоруКт;
		ContractInfo.TurnoverDebit = СуммаОборотДт;
		ContractInfo.TurnoverAmount = СуммаОборотКт;
		ContractInfo.BalanceDebitEnd = ?(КонОстатокПоДоговору > 0, КонОстатокПоДоговору, 0);
		ContractInfo.BalanceAmountEnd = ?(КонОстатокПоДоговору < 0, -КонОстатокПоДоговору, 0);
		ContractInfo.TotalConsumptionDebit = 0;
		ContractInfo.TotalConsumptionAmount = 0;
		
		ReconciliationActTable.ContractInfo.Добавить(ContractInfo);
		
		ВыборкаПоДокументам = ВыборкаПоДоговорам.Выбрать();
		
		Пока ВыборкаПоДокументам.Следующий() Цикл
			
			ДанныеРазличающегосяДокумента = ТаблицаРазличающихсяДокументов.Найти(ВыборкаПоДокументам.Документ, "Документ");
			
			DocumentInfo = Новый_RecipientDocumentInfo_ReconciliationAct();
			OperationInfo = Новый_RecipientOperationInfo_ReconciliationAct();
			
			АктСверки405_ЗаполнитьDocumentInfoОтветногоТитула(DocumentInfo, ВыборкаПоДокументам, ДанныеРазличающегосяДокумента);
			АктСверки405_ЗаполнитьOperationInfoОтветногоТитула(OperationInfo, ВыборкаПоДокументам);
			
			DocumentInfo.OperationInfo.Добавить(OperationInfo);
			ContractInfo.DocumentInfo.Добавить(DocumentInfo);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьDocumentInfoОтветногоТитула(Content, ВыборкаПоДокументам, ДанныеРазличающегосяДокумента)
	
	Если ДанныеРазличающегосяДокумента = Неопределено Тогда
		ИтогоРасх = 0;
	Иначе
		ИтогоРасх = ДанныеРазличающегосяДокумента.ДебетОрганизации - ДанныеРазличающегосяДокумента.КредитКонтрагента;
		
		Если ИтогоРасх = 0 Тогда
			ИтогоРасх = ДанныеРазличающегосяДокумента.КредитОрганизации - ДанныеРазличающегосяДокумента.ДебетКонтрагента;
		КонецЕсли;
	КонецЕсли;
	
	НаименованиеДокумента = ВыборкаПоДокументам.НаименованиеДокумента;
	
	Если НЕ ЗначениеЗаполнено(НаименованиеДокумента) Тогда
		НаименованиеДокумента = ВыборкаПоДокументам.НомерДокумента + " от " + Формат(ВыборкаПоДокументам.ДатаДокумента, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	
	Content.DocumentName = НаименованиеДокумента;
	Content.DocumentNumber = ВыборкаПоДокументам.НомерДокумента;
	Content.DocumentDate = ВыборкаПоДокументам.ДатаДокумента;
	Content.TotalConsumption = ИтогоРасх;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьOperationInfoОтветногоТитула(Content, ВыборкаПоДокументам)
	
	Content.StringNumber = ВыборкаПоДокументам.НомерСтроки;
	Content.OperationDate = ВыборкаПоДокументам.ДатаОперации;
	Content.OperationName = ВыборкаПоДокументам.НаименованиеОперации;
	Content.SumDebit = ВыборкаПоДокументам.СуммаДебет;
	Content.SumAmount = ВыборкаПоДокументам.СуммаКредит;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьШапкуТитулаОтправителя(Content, РеквизитыДокумента)
	
	АктСверки405_ЗаполнитьНомер(Content, РеквизитыДокумента.Номер);
	АктСверки405_ЗаполнитьПериод(Content, РеквизитыДокумента.ДатаНачала, РеквизитыДокумента.ДатаОкончания);
	АктСверки405_ЗаполнитьВалюту(Content, РеквизитыДокумента.КодВалюты);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьНомер(Content, НомерАктаСверки)
	
	Content.ActNumber = ПредставлениеНомера(НомерАктаСверки);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьПериод(Content, ДатаНачала, ДатаОкончания)
	
	Content.ReconcilationDateFrom = ДатаНачала;
	Content.ReconcilationDateTo = ДатаОкончания;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьВалюту(Content, КодВалюты)
	
	AdditionalInfoReconciliationAct = Новый_AdditionalInfoReconciliationAct();
	AdditionalInfoReconciliationAct.Currency = КодВалюты;
	
	SenderData_ReconciliationAct = Новый_SenderData_ReconciliationAct();
	SenderData_ReconciliationAct.AdditionalInfoReconciliationAct = AdditionalInfoReconciliationAct;
	
	Content.ReconciliationAct = SenderData_ReconciliationAct;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьТабличнуюЧастьТитулаОтправителя(Content, ВыборкаПоДоговорам, ДокСсылка)
	
	НачальноеСальдоПоДоговорамАкта = АктСверки405_НачальноеСальдоПоДоговорам(ДокСсылка);
	
	ReconciliationActTable = Новый_SenderReconciliationActTable();
	
	Пока ВыборкаПоДоговорам.Следующий() Цикл
		
		ОтборПоДоговору = Новый Структура("Договор", ВыборкаПоДоговорам.Договор);
		НачальноеСальдоПоДоговору = НачальноеСальдоПоДоговорамАкта.Скопировать(ОтборПоДоговору);
		
		НачОстатокПоДоговоруДт = НачальноеСальдоПоДоговору.Итог("НачОстатокПоДоговоруДт");
		НачОстатокПоДоговоруКт = НачальноеСальдоПоДоговору.Итог("НачОстатокПоДоговоруКт");
		
		СуммаОборотДт = ВыборкаПоДоговорам.СуммаДебет;
		СуммаОборотКт = ВыборкаПоДоговорам.СуммаКредит;
		
		КонОстатокПоДоговоруДт = НачОстатокПоДоговоруДт + СуммаОборотДт;
		КонОстатокПоДоговоруКт = НачОстатокПоДоговоруКт + СуммаОборотКт;
		КонОстатокПоДоговору = КонОстатокПоДоговоруДт - КонОстатокПоДоговоруКт;
		
		ContractInfo = Новый_SenderContractInfo_ReconciliationAct();
		
		ContractInfo.ContractAdditionalInfo = Строка(ВыборкаПоДоговорам.ВидДоговора);
		ContractInfo.ContractNumber = ВыборкаПоДоговорам.НомерДоговора;
		ContractInfo.ContractDate = ВыборкаПоДоговорам.ДатаДоговора;
		ContractInfo.BalanceDebitFrom = НачОстатокПоДоговоруДт;
		ContractInfo.BalanceAmountFrom = НачОстатокПоДоговоруКт;
		ContractInfo.TurnoverDebit = СуммаОборотДт;
		ContractInfo.TurnoverAmount = СуммаОборотКт;
		ContractInfo.BalanceDebitEnd = ?(КонОстатокПоДоговору > 0, КонОстатокПоДоговору, 0);
		ContractInfo.BalanceAmountEnd = ?(КонОстатокПоДоговору < 0, -КонОстатокПоДоговору, 0);
		
		ReconciliationActTable.ContractInfo.Добавить(ContractInfo);
		
		ВыборкаПоДокументам = ВыборкаПоДоговорам.Выбрать();
		
		Пока ВыборкаПоДокументам.Следующий() Цикл
			
			DocumentInfo = Новый_SenderDocumentInfo_ReconciliationAct();
			OperationInfo = Новый_SenderOperationInfo_ReconciliationAct();
			
			АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(DocumentInfo, ВыборкаПоДокументам);
			АктСверки405_ЗаполнитьOperationInfoТитулаОтправителя(OperationInfo, ВыборкаПоДокументам);
			
			ContractInfo.DocumentInfo.Добавить(DocumentInfo);
			DocumentInfo.OperationInfo.Добавить(OperationInfo);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(Content, ВыборкаПоДокументам)
	
	Content.DocumentName = ВыборкаПоДокументам.НаименованиеДокумента;
	Content.DocumentNumber = ВыборкаПоДокументам.НомерДокумента;
	Content.DocumentDate = ВыборкаПоДокументам.ДатаДокумента;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьOperationInfoТитулаОтправителя(Content, ВыборкаПоДокументам)
	
	Content.StringNumber = ВыборкаПоДокументам.НомерСтроки;
	Content.OperationDate = ВыборкаПоДокументам.ДатаОперации;
	Content.OperationName = ВыборкаПоДокументам.НаименованиеОперации;
	Content.SumDebit = ВыборкаПоДокументам.СуммаДебет;
	Content.SumAmount = ВыборкаПоДокументам.СуммаКредит;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьИтогиПоТабличнойЧастиТитулаОтправителя(Content, ОстатокНаНачало, ОборотПоДебету, ОборотПоКредиту)
	
	ОстатокНаКонец = ОстатокНаНачало + ОборотПоДебету - ОборотПоКредиту;
	
	ReconciliationActTable = Content.ReconciliationAct.ReconciliationActTable;
	
	ReconciliationActTable.BalanceDebitFrom = ?(ОстатокНаНачало > 0, ОстатокНаНачало, 0);
	ReconciliationActTable.BalanceAmountFrom = ?(ОстатокНаНачало < 0, -ОстатокНаНачало, 0);
	ReconciliationActTable.TurnoverDebit = ОборотПоДебету;
	ReconciliationActTable.TurnoverAmount = ОборотПоКредиту;
	ReconciliationActTable.BalanceDebitEnd = ?(ОстатокНаКонец > 0, ОстатокНаКонец, 0);
	ReconciliationActTable.BalanceAmountEnd = ?(ОстатокНаКонец < 0, -ОстатокНаКонец, 0);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьРеквизитыОтправителя(Content, Организация, ДатаСведений)
	
	АктСверки405_ЗаполнитьРеквизитыУчастника(
		Content.ReconciliationAct.AdditionalInfoReconciliationAct.Sender,
		Организация,
		ДатаСведений
	);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьРеквизитыПолучателя(Content, Контрагент, ДатаСведений)
	
	АктСверки405_ЗаполнитьРеквизитыУчастника(
		Content.ReconciliationAct.AdditionalInfoReconciliationAct.Recipient,
		Контрагент,
		ДатаСведений
	);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьРеквизитыУчастника(Content, Участник, ДатаСведений)
	
	СведенияОбУчастнике = АктСверки_ДанныеЮрФизЛица(Участник, ДатаСведений);
	
	Content = Новый_ExtendedOrganizationInfo_ReconciliationAct();
	
	Content.Name = СведенияОбУчастнике.ПолноеНаименование;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		Content.Phone = СведенияОбУчастнике.Телефоны;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Email) Тогда
		Content.Email = СведенияОбУчастнике.Email;
	КонецЕсли;
	
	Если СведенияОбУчастнике.СтранаРегистрации <> Справочники.СтраныМира.Россия Тогда
		
		Content.LegalEntityId = СведенияОбУчастнике.НалоговыйНомерВСтранеРегистрации;
		Content.Type = "ForeignEntity";
		
	ИначеЕсли СведенияОбУчастнике.ТипЮрФизЛица = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		
		Content.Inn = СведенияОбУчастнике.ИНН;
		Content.Kpp = СведенияОбУчастнике.КПП;
		Content.Ogrn = СведенияОбУчастнике.ОГРН;
		Content.Type = "LegalEntity";
		
	ИначеЕсли СведенияОбУчастнике.ЭтоИндивидуальныйПредприниматель Тогда
		
		Content.Type = "IndividualEntity";
		Content.Inn = СведенияОбУчастнике.ИНН;
		Content.Ogrn = СведенияОбУчастнике.ОГРН;
		
	Иначе
		
		Content.Type = "PhysicalEntity";
		Content.Inn = СведенияОбУчастнике.ИНН;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьПодписанта(Content)
	
	Signer = Новый_Signer_ReconciliationAct();
	Signer.Official = Новый_Official();
	Signer.DigitalAttorneyInfo = Новый_DigitalAttorneyInfo_ReconciliationAct();
	Signer.PaperAttorneyInfo = Новый_PaperAttorneyInfo_ReconciliationAct();
	
	Content.ReconciliationAct.Signer = Signer;
	
КонецПроцедуры

#КонецОбласти

#Область АктCверки405_Контракты

// Инициализирует конревой элемент контента ответного титула АС405@
// 
// Возвращаемое значение:
//  Структура - содержит элементы:
//   * ReconciliationAct - Структура - Данные ответного титула акта сверки (см. Новый_RecipientData_ReconciliationAct);
//   * DateCreateFile - Дата - Дата формирования файла обмена информации получателя;
//   * TimeCreateFile - Строка - Время формирования файла обмена информации получателя;
//   * SignDisagreement - Строка - Признак наличия разногласий.
//
