Функция ЭтоРеализацияДляКоторойСчетФактураНеТребуется(Документ1С)
	
	ВидОперацииДокумента = ЗначениеРеквизитаОбъектаЛок(Документ1С, "ВидОперации");
	
	ВидыОпераций = Новый Массив;
	
	Если ИспользуетсяРеализацияЧерезПередачуТоваров() Тогда
		ВидыОпераций.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийРеализацияТоваров.ПередачаТоваров"));
	КонецЕсли;
	
	Если ЭтоОтгрузкаБезПереходаправаСобственности(Документ1С)
		И НЕ ДляОтгрузкиБезПереходаПраваСобственностиНачисляетсяНДС(Документ1С) Тогда
		ВидыОпераций.Добавить(
			ПредопределенноеЗначение("Перечисление.ВидыОперацийРеализацияТоваров.ОтгрузкаБезПереходаПраваСобственности")
		);
	КонецЕсли;
	
	Результат = ВидыОпераций.Найти(ВидОперацииДокумента) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

