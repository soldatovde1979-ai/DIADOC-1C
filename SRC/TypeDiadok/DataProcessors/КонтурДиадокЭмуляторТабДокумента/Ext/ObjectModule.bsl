//{ Основные методы

// Возвращает СТРУКТУРУ параметров, переданных в Область
Функция СтруктураПараметровОбласти(Область) Экспорт
	
	Результат = Новый Структура;
	Для Каждого ИмяПараметра Из МассивИменПараметровОбласти(Область) Цикл
		Результат.Вставить(ИмяПараметра, Область.Параметры[ИмяПараметра]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяВиртуальногоПараметраСсылки() Экспорт
	Возврат "ВиртуальныйПараметр_Ссылка_РодительскаяОбласть";
КонецФункции

// Возвращает массив ИМЕН параметров, переданных в Область, чтобы в дальнейшем можно было получить их значения
Функция МассивИменПараметровОбласти(Область)
	
	Результат = Новый Массив;
	
	// Сериализуем область в XML, чтобы извлечь имена параметров
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Сериализатор.ЗаписатьXML(Запись, Область);
	ТекстОбласти = Запись.Закрыть();
	
	// И теперь пробежимся по XML и извлечем имена
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстОбласти);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.Имя = "parameter" Или Чтение.Имя = "detailParameter" Тогда
				Чтение.Прочитать();
				Результат.Добавить(Чтение.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя области табличного документа
Функция ИмяОбласти(Область)
	
	Результат = Область.Области[0].Имя; // Опасно! Надо добиться ошибки на реальном примере и придумать, что с этим делать. Гуиды, например, генерировать.
	
	Возврат Результат;
	
КонецФункции

Процедура Инициализировать()
		
	// Поиграемся с разными вариантами представления, чтобы понять, какой будет удобнее в применении.

	ВыведенныеОбласти						 = Новый Массив;
	ИменаСтартовыхОбластейТабличныхЧастей	 = Новый Массив;
	ВыведенныеТабличныеЧасти				 = Новый Соответствие;
	ПараметрыВыведенныхОбластей				 = Новый Массив;

	мТабДок = Новый ТабличныйДокумент;
	
	ВерхнийКолонтитул = мТабДок.ВерхнийКолонтитул;
	НижнийКолонтитул = мТабДок.НижнийКолонтитул;

КонецПроцедуры

// Процедура предназначена для добавления "виртуальной области" с параметрами.
Процедура ДобавитьПроизвольныйПараметрВРезультаты(ИмяОбласти, ЗначенияПараметров) Экспорт
	
// Можно использовать в случае, если какие-то промежуточные параметры не выводятся на печать, а используются для внутренних расчетов,
//  но их тоже необходимо получить на выходе
// В этом случае в коде подготовки печатной формы вызываем примерно так:
//		Если ТипЗначения(ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
//			ТабличныйДокумент.ДобавитьПроизвольныйПараметрВРезультаты("АдресГрузополучателя", "г.Арамиль, ул. Ленина, д.1");
//		КонецЕсли;
// А в модуле Диадок к этому значению потом можно обращаться как обычно:
//		АдресГрузополучателя = ОбластьИзДанныхЭмулятораПечати(ДанныеПечати, "АдресГрузополучателя");

	НовЭлемент = Новый Структура;
	НовЭлемент.Вставить("ИмяОбласти",	ИмяОбласти);
	НовЭлемент.Вставить("Параметры",	ЗначенияПараметров);
	ПараметрыВыведенныхОбластей.Добавить(НовЭлемент);
	
КонецПроцедуры

// Возвращает Массив из параметров областей с заданным именем. например, "СтрокаТоваров". В основном используется для доступа к табличным частям.
Функция МассивСтрокИзДанныхЭмулятораПечати(ИмяОбласти) Экспорт
	Результат =  Новый Массив;
	Для Каждого Стр Из ПараметрыВыведенныхОбластей Цикл
		Если Стр.ИмяОбласти = ИмяОбласти Тогда
			Результат.Добавить(Стр.Параметры);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Возвращает параметры единичной области, например, "ДанныеОПокупателе" или "ШапкаДокумента"
Функция ОбластьИзДанныхЭмулятораПечати(ИмяОбласти) Экспорт
	
	Для Каждого Стр Из ПараметрыВыведенныхОбластей Цикл
		Если Стр.ИмяОбласти = ИмяОбласти Тогда
			Возврат Стр.Параметры;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

