//{		СВЕДЕНИЯ О ВНЕШНЕЙ ОБРАБОТКЕ

// Сведения о внешней обработке совместимые со стандартной подсистемой ДополнительныеОтчетыИОбработки
//
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * Версия          - Строка - версия обработки;
//   * Наименование    - Строка - представление для администратора (наименование элемента справочника),
//                                берется синоним объекта метаданных внешней обработки;
//   * Информация      - Строка - краткая информация о внешней обработке,
//                                берется комментарий объекта метаданных внешней обработки;
//   * БезопасныйРежим - Булево - признак подключения внешней обработки в безопасном режиме:
//                                 Игнорируется привилегированный режим
//                                 Запрещены внешние по отношению к платформе «1С:Предприятия» действия:
//                                  COM;
//                                  загрузка внешних компонент;
//                                  запуск внешних приложений и команд операционной системы;
//                                  доступ к файловой системе, кроме временных файлов;
//                                  доступ к Интернету.
//   * Вид             - Строка - содержит значение "ДополнительнаяОбработка";
//   * Команды         - ТаблицаЗначений - настройки команд, поставляемых внешней обработкой:
//      ** Идентификатор        - Строка- внутреннее имя команды;
//      ** Представление        - Строка- пользовательское представление команды;
//      ** Использование        - Строка- тип команды:
//                                         "ВызовКлиентскогоМетода",
//                                         "ВызовСерверногоМетода";
//      ** Модификатор          - Строка- дополнительная классификация команды;
//      ** ПоказыватьОповещение - Булево- если Истина, то при запуске команды выводится оповещение "Команда выполняется...";
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("БезопасныйРежим", Истина);
	Результат.Вставить("Наименование"	, Метаданные().Синоним);
	Результат.Вставить("Информация"		, Метаданные().Комментарий);
	Результат.Вставить("Версия"			, ВерсияОбработки());
	Результат.Вставить("Команды"		, Новый ТаблицаЗначений);
	Результат.Вставить("Вид"			, "ДополнительнаяОбработка");
	
	Возврат Результат;
	
КонецФункции

// Версия обработки в стандартном формате
//
// Возвращаемое значение:
//  Строка - версия в формате РР.ВВ.ФФ.СС, где:
//   * РР - номер редакции    - в рамках одной редакции гарантируется обратная совместимость;
//   * ВВ - номер версии      - новая функциональность (или несколько);
//   * ФФ - номер исправления - исправление ошибки;
//   * СС - номер сборки      - сквозная нумерация обновляется автоматически;
Функция ВерсияОбработки()
	
	Версия = "0.1.0";
	
	Результат = Версия + "." + НомерСборки();
	
	Возврат Результат;
	
КонецФункции

// Сквозной номер сборки, обновляется автоматически
//
Функция НомерСборки()
	
	Возврат "2";
	
КонецФункции

//}		СВЕДЕНИЯ О ВНЕШНЕЙ ОБРАБОТКЕ

//{ Заглушки для эмуляции табличного документа
	
Процедура Вывести(Область) Экспорт
	
	ВыведенныеОбласти.Добавить(Область);
	
	// И альтернативный вариант добавления области. Кажется, что им будет легче пользоваться.
	НовЭлемент = Новый Структура;
	НовЭлемент.Вставить("ИмяОбласти",	ИмяОбласти(Область));
	НовЭлемент.Вставить("Параметры",	СтруктураПараметровОбласти(Область));
	ПараметрыВыведенныхОбластей.Добавить(НовЭлемент);
	
	мТекущаяОбластьГруппировки = Область; // к этой  области будем добавлять то, что накидывается в Присоединить
	
	мИмяОбласти = ИмяОбласти(Область);
	Если НЕ ИменаСтартовыхОбластейТабличныхЧастей.Найти(мИмяОбласти) = Неопределено Тогда
		мТекущаяОбластьГруппировки = Новый Массив;
		мТекущаяОбластьГруппировки.Добавить(Область);
		
		ТекТабличнаяЧасть = ВыведенныеТабличныеЧасти[мИмяОбласти];
		Если ТекТабличнаяЧасть = Неопределено Тогда
			ТекТабличнаяЧасть = Новый Массив;
			ВыведенныеТабличныеЧасти.Вставить(мИмяОбласти, ТекТабличнаяЧасть);
		КонецЕсли;
		
		ТекТабличнаяЧасть.Добавить(мТекущаяОбластьГруппировки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Присоединить(Область) Экспорт
	
	// Тожет немного отличаться от Вывести: здесь не новая строка, а "присоединение" к предыдущей.
	// Т.е. мы можем здесь группировать области между собой.
	ВыведенныеОбласти.Добавить(Область);
	
	НовЭлемент = Новый Структура;
	НовЭлемент.Вставить("ИмяОбласти",	ИмяОбласти(Область));
	НовЭлемент.Вставить("Параметры",	СтруктураПараметровОбласти(Область));
	ПараметрыВыведенныхОбластей.Добавить(НовЭлемент);
	
	Если НЕ мТекущаяОбластьГруппировки = Неопределено Тогда
		мТекущаяОбластьГруппировки.Добавить(Область);
	КонецЕсли;
	//Область.Параметры.Вставить(ИмяВиртуальногоПараметраСсылки(), мТекущаяОбластьГруппировки);
	// и как-то прикрепить к мТекущаяОбластьГруппировки;
	
КонецПроцедуры

