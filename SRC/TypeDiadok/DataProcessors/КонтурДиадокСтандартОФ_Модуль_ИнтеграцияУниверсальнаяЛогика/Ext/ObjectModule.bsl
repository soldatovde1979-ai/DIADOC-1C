Функция ГрузополучательПоДокументу(ДокументСсылка) Экспорт
	
	Результат = Неопределено;
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	
	Если ПолучитьМодульПрог("Модуль_Интеграция").ЭтоРТУ_ДД(ДокументСсылка) Тогда 
		
		Если МетаданныеДокумента.Реквизиты.Найти("Грузополучатель") <> Неопределено Тогда
			Результат = ДокументСсылка.Грузополучатель;
		Иначе
			Результат = ДокументСсылка.Контрагент;
		КонецЕсли;
		
	ИначеЕсли ПолучитьМодульПрог("Модуль_Интеграция").ЭтоСФ(ДокументСсылка) Тогда
		
		Если МетаданныеДокумента.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено 
			И ДокументСсылка.ДокументыОснования.Количество()>0 
			И (		ТипЗнч(ДокументСсылка.ДокументыОснования[0].ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
				ИЛИ ТипЗнч(ДокументСсылка.ДокументыОснования[0].ДокументОснование) = Тип("ДокументСсылка.КорректировкаРеализации")
				ИЛИ ТипЗнч(ДокументСсылка.ДокументыОснования[0].ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах")	) Тогда
				
			Результат = ДокументСсылка.ДокументыОснования[0].ДокументОснование.Грузополучатель;
			
		ИначеЕсли НЕ МетаданныеДокумента.Реквизиты.Найти("ДокументОснование") = Неопределено
					И (		Метаданные.Документы.Найти("РеализацияТоваров") <> Неопределено И ТипЗнч(ДокументСсылка.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваров")
						ИЛИ Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено И ТипЗнч(ДокументСсылка.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг")	) Тогда 
			
			Результат = ДокументСсылка.ДокументОснование.Контрагент;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КонтрагентПоДокументу(ДокументСсылка) Экспорт
	
	Результат = Неопределено;
	
	Если НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("Контрагент") = Неопределено Тогда
		
		Результат = ДокументСсылка.Контрагент;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

