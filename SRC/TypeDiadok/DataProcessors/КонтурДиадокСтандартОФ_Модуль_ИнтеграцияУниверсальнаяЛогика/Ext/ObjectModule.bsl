// Подставляет параметры в строку, максимальное число параметров - 5.
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон содержащий маркеры подстановки вида: "%1..%N"
//                        . Нумерация маркеров начинается с 1.
//                          N не может быть более 5.
//  Параметр<n>  - Строка - подставляемые параметры.
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами.
//
Функция ПодставитьПараметрыВСтроку(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено) Экспорт
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтавкуНДСДиадок(Знач TaxRate) Экспорт
	
	КэшСтавкиНДС = ОсновнойМодуль.ЭДО_Кэш_Прочитать("КэшСтавкиНДС");
	
	Если КэшСтавкиНДС = Неопределено Тогда
		
		КэшСтавкиНДС = Новый Соответствие;
		
		ОсновнойМодуль.ЭДО_Кэш_Поместить("СтавкаНДСДиадок", КэшСтавкиНДС);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(TaxRate) Тогда
		TaxRate = "нет значения";
	КонецЕсли;
	
	TaxRate = НРег(СтрЗаменить(СтрЗаменить(TaxRate, " ", ""), "%", ""));
	
	Результат = КэшСтавкиНДС[TaxRate];
	
	Если Результат = Неопределено Тогда
		
		СтавкиНДСДиадок = Новый Соответствие;
		СтавкиНДСДиадок.Вставить("0", Перечисления.СтавкиНДС.НДС0);
		СтавкиНДСДиадок.Вставить("10", Перечисления.СтавкиНДС.НДС10);
		СтавкиНДСДиадок.Вставить("18", Перечисления.СтавкиНДС.НДС18);
		СтавкиНДСДиадок.Вставить("20", Перечисления.СтавкиНДС.НДС20);
		СтавкиНДСДиадок.Вставить("10/110", Перечисления.СтавкиНДС.НДС10_110);
		СтавкиНДСДиадок.Вставить("18/118", Перечисления.СтавкиНДС.НДС18_118);
		СтавкиНДСДиадок.Вставить("безндс", Перечисления.СтавкиНДС.БезНДС);
		СтавкиНДСДиадок.Вставить("исчналаг", "НДС исчисляется налоговым агентом");
		СтавкиНДСДиадок.Вставить("нетзначения", Перечисления.СтавкиНДС.БезНДС);
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС5") Тогда
			СтавкиНДСДиадок.Вставить("5", Перечисления.СтавкиНДС.НДС5);
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС7") Тогда
			СтавкиНДСДиадок.Вставить("7", Перечисления.СтавкиНДС.НДС7);
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС22") Тогда
			СтавкиНДСДиадок.Вставить("22", Перечисления.СтавкиНДС.НДС22);
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС20_120") Тогда
			СтавкиНДСДиадок.Вставить("20/120", Перечисления.СтавкиНДС.НДС20_120);
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС5_105") Тогда
			СтавкиНДСДиадок.Вставить("5/105", Перечисления.СтавкиНДС.НДС5_105);
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС7_107") Тогда
			СтавкиНДСДиадок.Вставить("7/107", Перечисления.СтавкиНДС.НДС7_107);
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС22_122") Тогда
			СтавкиНДСДиадок.Вставить("22/122", Перечисления.СтавкиНДС.НДС22_122);
		КонецЕсли;
		
		Результат = СтавкиНДСДиадок.Получить(TaxRate);
		
		КэшСтавкиНДС.Вставить(TaxRate, Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, содержит ли строка только цифры.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка содержит только цифры или пустая.
//
Функция ТолькоЦифрыВСтроке(Значение) Экспорт
	
	Результат	 = Истина;
	ДлинаСтроки	 = СтрДлина(Значение);
	
	Для НомерСимвола = 1 По ДлинаСтроки Цикл
		
		КодСимвола = КодСимвола(Значение, НомерСимвола);
		
		Если КодСимвола < 48 Или КодСимвола > 57 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

