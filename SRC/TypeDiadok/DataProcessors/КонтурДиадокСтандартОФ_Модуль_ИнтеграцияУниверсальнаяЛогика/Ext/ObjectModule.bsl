Процедура ЗаполнитьСведенияПрослеживаемости736(Контент) Экспорт
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		Если ОсновнойМодуль.СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ПрослеживаемыйТовар", Ложь) = Истина Тогда
			
			ДанныеПрослеживаемости = ОсновнойМодуль.СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ДанныеПрослеживаемости", Новый Массив);
			
			Если ДанныеПрослеживаемости <> Неопределено Тогда
				
				ЕстьУвеличение = ОсновнойМодуль.ЕстьДельта(СтрокаТЧ.AmountsInc);
				ЕстьУменьшение = ОсновнойМодуль.ЕстьДельта(СтрокаТЧ.AmountsDec);
				
				Для каждого СтрокаДанныхПрослеживаемости Из ДанныеПрослеживаемости Цикл
					
					QuantityDiff = ОсновнойМодуль.Новый_QuantityDiff();
					QuantityDiff.QuantityDec		 = СтрокаДанныхПрослеживаемости.КоличествоУменьшение;
					QuantityDiff.QuantityInc		 = СтрокаДанныхПрослеживаемости.КоличествоУвеличение;
					QuantityDiff.CorrectedQuantity	 = СтрокаДанныхПрослеживаемости.КоличествоПослеИзменения;
					QuantityDiff.OriginalQuantity	 = СтрокаДанныхПрослеживаемости.КоличествоДоИзменения;
					
					Если НЕ ЗначениеЗаполнено(QuantityDiff.QuantityDec) 
						И НЕ ЗначениеЗаполнено(QuantityDiff.QuantityInc) Тогда
						
						Если ЕстьУвеличение Тогда
							QuantityDiff.QuantityInc = 0;
							QuantityDiff.QuantityDec = Неопределено;
						ИначеЕсли ЕстьУменьшение Тогда
							QuantityDiff.QuantityInc = Неопределено;
							QuantityDiff.QuantityDec = 0;
						КонецЕсли;
						
					КонецЕсли;
					
					ItemTracingInfo					 = ОсновнойМодуль.Новый_ItemTracingInfo736();
					ItemTracingInfo.Unit			 = СтрокаДанныхПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости;
					ItemTracingInfo.QuantityDiff	 = QuantityDiff;
					ItemTracingInfo.RegNumberUnit	 = СокрЛП(СтрокаДанныхПрослеживаемости.НомерГТДРегистрационныйНомер);
					
					СтрокаТЧ.ItemTracingInfos.Добавить(ItemTracingInfo);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает структуру свойств строки прослеживаемости для корректировки
//
// Возвращаемое значение:
//  Структура - содержит поля:
//   * НомерТовара
//   * ЕдиницаИзмеренияКод
//   * ЕдиницаИзмеренияНаименование
//   * КоличествоТовараДоИзменения
//   * КоличествоТовараПослеИзменения
//   * КоличествоТовараУвеличение
//   * КоличествоТовараУменьшение
//   * КоличествоУчетноеДоИзменения
//   * КоличествоУчетноеПослеИзменения
//
Функция НовыеСвойстваЭлементаПрослеживаемостиПоКорректировке() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("НомерГТДРегистрационныйНомер");
	Результат.Вставить("КодЕдиницыИзмеренияПрослеживаемости");
	Результат.Вставить("КоличествоДоИзменения");
	Результат.Вставить("КоличествоПослеИзменения");
	Результат.Вставить("КоличествоУвеличение");
	Результат.Вставить("КоличествоУменьшение");
	
	Возврат Результат;
	
КонецФункции
