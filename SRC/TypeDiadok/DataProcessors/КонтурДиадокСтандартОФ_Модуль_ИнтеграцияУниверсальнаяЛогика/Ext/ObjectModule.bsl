Функция ВладельцыКодовМаркировки(СсылкаНаОбъект)
	
	Если ЭтоДокументСФ(СсылкаНаОбъект) Тогда
		Результат = ДокументыОснованияСчетаФактуры(СсылкаНаОбъект);
	Иначе
		Результат = Новый Массив;
		Результат.Добавить(СсылкаНаОбъект);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоДокументСФ(СсылкаНаДокумент)
			
	Результат = 	ЭтоСФВыданный(СсылкаНаДокумент)
				ИЛИ ЭтоКСФ(СсылкаНаДокумент);
	
	Возврат Результат;
	
КонецФункции

// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка - счет-фактура, основание которой нужно найти;
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на основания счета-фактуры.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЭтоДокументСФ(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = СчетФактура.Метаданные();
	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	Если СуществуетОбъектМетаданных(ПолноеИмяОбъекта + ".ТабличнаяЧасть.ДокументыОснования") Тогда 
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &СчетФактура";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяОбъекта + ".ДокументыОснования");
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			Результат.Добавить(Выборка.ДокументОснование);
		КонецЦикла;
		
	ИначеЕсли ЕстьРеквизитМетаданных(ОбъектМетаданных, "ДокументОснование") Тогда 
		
		ДокументОснование = ОсновнойМодуль.ЗначениеРеквизитаОбъекта(СчетФактура, "ДокументОснование");
		Результат.Добавить(ДокументОснование);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает новую таблицу значений для штрихкодов упаковок.
// В прикладных документах должна существовать табличная часть с аналогичным набором колонок.
// См. ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок()
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица значений штрихкодов упаковок:
//    * ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров - Штрихкод упаковки
//    * ЗначениеШтрихкода - Строка - Значение штрихкода
//
Функция НоваяТаблицаШтрихкодыУпаковок()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ШтрихкодУпаковки");
	Результат.Колонки.Добавить("ЗначениеШтрихкода");
	
	Возврат Результат;
	
КонецФункции

// Считывает коды маркировки из строки электронного документа и
// добавляет их в общую таблицу штрихкодов.
//
// Параметры:
//  ШтрихкодыУпаковок	 - ТаблицаЗначений - таблица с кодами маркировки (см НоваяТаблицаШтрихкодыУпаковок)
//  СведенияОМаркировке	 - Структура - сведения о маркировке (см. НовыйСведенияОМаркировке)
//  GTIN				 - Строка - Глобальный идентификационный номер товарной продукции
//
Процедура ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, СведенияОМаркировке, GTIN = "")
	
	Если Не ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(GTIN)
		И ЗначениеЗаполнено(СведенияОМаркировке.КоличествоТовараВУпаковке) Тогда
		
		КоличествоТовараВУпаковке = СведенияОМаркировке.КоличествоТовараВУпаковке;

		ЗначениеШтрихкода = НовыйКодОСУ(GTIN, КоличествоТовараВУпаковке);
		
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;

	КонецЕсли;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ИндивидуальныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ТранспортныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
КонецПроцедуры

Функция НовыйКодОСУ(GTIN, Количество)
	
	КоличествоСтрокой = XMLСтрока(Цел(Количество));
	
	Результат = "02" + GTIN + "37" + КоличествоСтрокой;
	
	Возврат Результат;
	
КонецФункции

