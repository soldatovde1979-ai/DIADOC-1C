		ВыражениеУпаковка = ВыражениеПустаяУпаковка();
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмерения", ВыражениеЕдиницаИзмерения);
	Результат = СтрЗаменить(Результат, "&Упаковка", ВыражениеУпаковка);
	
	Возврат Результат;
	
КонецФункции

