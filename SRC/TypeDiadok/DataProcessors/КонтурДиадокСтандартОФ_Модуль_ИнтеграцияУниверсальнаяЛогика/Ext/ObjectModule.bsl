КонецФункции

// Инициализирует структуру полей записи регистра КонтактнаяИнформация.
// 
// Возвращаемое значение:
//  Структура - свойства структуры соответствуют полям типового регистра КонтактнаяИнформация.
//
Функция НоваяЗаписьКонтактнойИнформации()
	
	Результат = Новый Структура;
	Результат.Вставить("Представление");
	Результат.Вставить("Значение");
	Результат.Вставить("Поле1");
	Результат.Вставить("Поле2");
	Результат.Вставить("Поле3");
	Результат.Вставить("Поле4");
	Результат.Вставить("Поле5");
	Результат.Вставить("Поле6");
	Результат.Вставить("Поле7");
	Результат.Вставить("Поле8");
	Результат.Вставить("Поле9");
	Результат.Вставить("Поле10");
	Результат.Вставить("ТипДома", "дом");
	Результат.Вставить("ТипКорпуса", "корпус");
	Результат.Вставить("ТипКвартиры", "кв.");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТипЗданияКорпусаПомещения(ЗначенияПолей)
	
	Если Не ЗначениеЗаполнено(ЗначенияПолей.ТипДома) Тогда 
		ЗначенияПолей.ТипДома = "дом";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначенияПолей.ТипКорпуса) Тогда 
		ЗначенияПолей.ТипКорпуса = "корпус";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначенияПолей.ТипКвартиры) Тогда 
		ЗначенияПолей.ТипКвартиры = "кв.";
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает представление адреса собранного из полей значений Поле1 - Поле10.
//
// Параметры
//  ЗначенияПолей - Структура - значения полей регистра контактной информации (см. НоваяЗаписьКонтактнойИнформации).
//
// Возвращаемое значение:
//   Строка - представление адреса.
//
Функция ПредставлениеАдресаПоЗначениямПолейКИ(ЗначенияПолей)
	
	СтруктураЗаписи = НоваяЗаписьКонтактнойИнформации();
	ЗаполнитьЗначенияСвойств(СтруктураЗаписи, ЗначенияПолей);
	ЗаполнитьТипЗданияКорпусаПомещения(СтруктураЗаписи);
	
	Результат = "";
	
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле1), ", ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле2), ", ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле3), ", ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле4), ", ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле5), ", ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле6), ", ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле7), ", " + СтруктураЗаписи.ТипДома + " № ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле8), ", " + СтруктураЗаписи.ТипКорпуса + " ");
	ДополнитьПредставлениеАдреса(Результат, СокрЛП(СтруктураЗаписи.Поле9), ", " + СтруктураЗаписи.ТипКвартиры + " ");
	
	Если СтрДлина(Результат) > 2 Тогда
		Результат = Сред(Результат, 3);
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

// Процедура дополняет представление адреса строкой.
//
Процедура ДополнитьПредставлениеАдреса(ТекущееПредставление, Дополнение, СтрокаКонкатенации)
	
	Если Дополнение <> "" Тогда
		ТекущееПредставление = ТекущееПредставление + СтрокаКонкатенации + Дополнение;
	КонецЕсли;
  	
КонецПроцедуры

// Возвращает данные регистра КонтактнаяИнформация по виду адреса.
//
// Параметры:
//  ЮрФизЛицо - ЛюбаяСсылка	 - владелец контактной информации;
//  ВидАдреса - Строка		 - вида адреса (см. функцию Перечисление_ВидыКИ);
// 
// Возвращаемое значение:
//  Структура - см. НоваяЗаписьКонтактнойИнформации().
//
Функция ЗначенияПолейКонтактнойИнформацииПоВидуАдреса(ЮрФизЛицо, ВидАдреса)
	
	Результат = Неопределено;
	
	ВладелецКИ = ХранилищеКонтактнойИнформацииОбъекта(ЮрФизЛицо);
	ВидКИ = ВидАдресаЮрФизЛица(ЮрФизЛицо, ВидАдреса);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ВладелецКИ);
	Запрос.УстановитьПараметр("Вид", ВидКИ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И Т.Вид = &Вид";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Результат = НоваяЗаписьКонтактнойИнформации();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ЗаполнитьТипЗданияКорпусаПомещения(Результат); 
		
		Если ЗначениеЗаполнено(Результат.Значение) Тогда
			ДополнитьКонтактнуюИнформациюДаннымиJson(Результат, Выборка.Значение, Выборка.Тип);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьКонтактнуюИнформациюДаннымиJson(КонтактнаяИнформация, ЗначениеJson, Тип)
	
	МодульУправлениеКонтактнойИнформациейСлужебный = ОбщийМодульПоИмени("УправлениеКонтактнойИнформациейСлужебный");
	
	Если МодульУправлениеКонтактнойИнформациейСлужебный <> Неопределено Тогда
		
		ДанныеАдреса = Неопределено;
		
		Попытка
			ДанныеАдреса = МодульУправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(ЗначениеJson, Тип);
		Исключение
		КонецПопытки;
		
		Если ДанныеАдреса <> Неопределено Тогда
		
			Если  ДанныеАдреса.Свойство("addressType") И ДанныеАдреса.addressType = "ВСвободнойФорме" 
				И ДанныеАдреса.Свойство("Country") Тогда
				
				КонтактнаяИнформация.Поле1 = ДанныеАдреса.Country;	// Страна
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает данные регистра КонтактнаяИнформация по представлению КИ.
//
// Параметры:
//  ЮрФизЛицо - ЛюбаяСсылка	 - владелец контактной информации;
//  ВидАдреса - Строка		 - вида адреса (см. функцию Перечисление_ВидыКИ);
// 
// Возвращаемое значение:
//  Структура - см. НоваяЗаписьКонтактнойИнформации().
//
Функция ЗначенияПолейКонтактнойИнформацииПоПредставлению(ЮрФизЛицо, ПредставлениеКИ)
	
	Результат = Неопределено;
	
	ВладелецКИ = ХранилищеКонтактнойИнформацииОбъекта(ЮрФизЛицо);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ВладелецКИ);
	Запрос.УстановитьПараметр("Представление", ПредставлениеКИ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК Т
	|ГДЕ
	|	Т.Объект = &Объект
	|	И ВЫРАЗИТЬ(Т.Представление КАК СТРОКА(&ДлинаСтроки)) = &Представление";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДлинаСтроки", Формат(СтрДлина(ПредставлениеКИ), "ЧГ=0"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Результат = НоваяЗаписьКонтактнойИнформации();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		ЗаполнитьТипЗданияКорпусаПомещения(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структурированную информацию об адресе юридического или физического лица.
//
// Параметры:
//  ЮрФизЛицо - ЛюбаяСсылка - владелец контактной информации
//  ИспользоватьЮрАдрес - Булево - (Необязательный) Истина, если требуется получить юридический адрес.
//                                 Ложь, если требуется фактический адрес.
//  АдресСтрокой - Строка - (Необязательный) строковое представление адреса. Если указано, сначала
//                          будет выполнен поиск сведений об адресе по переданному представлению.
//
// Возвращаемое значение:
//  Структура - см. функцию НовыйСведенияОбАдресе()
//  Нопределено, если нет сведений о требуемом адресе.
//
Функция СведенияОбАдресе(ЮрФизЛицо, ИспользоватьЮрАдрес = Истина, АдресСтрокой = Неопределено) Экспорт
	
	Результат = Неопределено;
	ЗаписьКИ = Неопределено;
	
	ПредставлениеАдреса = СокрЛП(АдресСтрокой);
	
	Если ЗначениеЗаполнено(ПредставлениеАдреса) Тогда 
		
		ЗаписьКИ = ЗначенияПолейКонтактнойИнформацииПоПредставлению(ЮрФизЛицо, ПредставлениеАдреса);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗаписьКИ) Тогда 
		
		ВидыКИ = Перечисление_ВидыКИ();
		
		ВидАдреса = ?(ИспользоватьЮрАдрес, ВидыКИ.ЮридическийАдрес, ВидыКИ.ФактическийАдрес);
		ЗаписьКИ = ЗначенияПолейКонтактнойИнформацииПоВидуАдреса(ЮрФизЛицо, ВидАдреса);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаписьКИ)
		Или ЗначениеЗаполнено(ПредставлениеАдреса) Тогда 
		
		Результат = НовыйСведенияОбАдресе();
		
		Если ЗначениеЗаполнено(ЗаписьКИ) Тогда 
			ЗаполнитьСведенияОбАдресеПоДаннымРегистра(Результат, ЗаписьКИ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПредставлениеАдреса) Тогда 
			Результат.СохраненноеПредставление = ПредставлениеАдреса;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат.КодСтраны) Тогда 
			Результат.КодСтраны = ОсновнаяСтрана().Код;
		КонецЕсли;
		
		УдалитьСтрануИзПредставленияАдреса(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьСтрануИзПредставленияАдреса(СведенияОбАдресе)
	
	Если Не ЗначениеЗаполнено(СведенияОбАдресе.Страна) Тогда 
		Возврат;
	КонецЕсли;
	
	Подстроки = ОсновнойМодуль.Преобразование_СтрокуВМассивПодстрок(СведенияОбАдресе.СохраненноеПредставление
					, ","
					, Истина
					, Истина);
	
	Если ЗначениеЗаполнено(Подстроки) 
		И ВРег(Подстроки[0]) = ВРег(СведенияОбАдресе.Страна) Тогда 
		
		Подстроки.Удалить(0);
		СведенияОбАдресе.СохраненноеПредставление = ОсновнойМодуль.Преобразование_МассивВСтроку(Подстроки, ", ", Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОсновнаяСтрана()
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "РОССИЯ");
	Результат.Вставить("Код", "643");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСведенияОбАдресеПоДаннымРегистра(СведенияОбАдресе, ЗаписьКИ)
	
	СведенияОбАдресе.СохраненноеПредставление = ЗаписьКИ.Представление;
	СведенияОбАдресе.Представление = ПредставлениеАдресаПоЗначениямПолейКИ(ЗаписьКИ);
	
	Индекс = Неопределено;
	КодСтраны = Неопределено;
	НаименованиеСтраны = Неопределено;
	
	Если Не ТолькоЦифрыВСтроке(ЗаписьКИ.Поле1) Тогда 
		НаименованиеСтраны = СокрП(ЗаписьКИ.Поле1);
		КодСтраны = ОсновнойМодуль.КодСтраны(НаименованиеСтраны);
	Иначе 
		Индекс = СокрП(ЗаписьКИ.Поле1);
	КонецЕсли;
	
	НаименованиеРегиона = СокрЛП(ЗаписьКИ.Поле2);
	КодРегиона = ОсновнойМодуль.КодРегиона(НаименованиеРегиона);
	
	Если ЗначениеЗаполнено(КодРегиона) Тогда // Это структурированный адрес РФ
		
		СведенияОбАдресе.Страна				 = ОсновнаяСтрана().Наименование;
		СведенияОбАдресе.Индекс				 = Индекс;
		СведенияОбАдресе.КодСтраны			 = ОсновнаяСтрана().Код;
		СведенияОбАдресе.КодРегиона			 = КодРегиона;
		СведенияОбАдресе.Район				 = ЗаписьКИ.Поле3;
		СведенияОбАдресе.Город				 = ЗаписьКИ.Поле4;
		СведенияОбАдресе.НаселенныйПункт	 = ЗаписьКИ.Поле5;
		СведенияОбАдресе.Улица				 = ЗаписьКИ.Поле6;
		
		СведенияОбАдресе.Здание.ТипЗдания	 = ЗаписьКИ.ТипДома;
		СведенияОбАдресе.Здание.Номер		 = ЗаписьКИ.Поле7;
		
		Если ЗначениеЗаполнено(ЗаписьКИ.Поле8) Тогда
			
			Корпус = Новый Структура;
			Корпус.Вставить("ТипКорпуса", ЗаписьКИ.ТипКорпуса);
			Корпус.Вставить("Номер", ЗаписьКИ.Поле8);
			
			СведенияОбАдресе.Корпуса.Добавить(Корпус);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаписьКИ.Поле9) Тогда
			
			Помещение = Новый Структура;
			Помещение.Вставить("ТипПомещения", ЗаписьКИ.ТипКвартиры);
			Помещение.Вставить("Номер", ЗаписьКИ.Поле9); 
			СведенияОбАдресе.Помещения.Добавить(Помещение);
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(КодСтраны) Тогда // Это иностранный или российский адрес в свободной форме
		
		СведенияОбАдресе.КодСтраны	 = КодСтраны;
		СведенияОбАдресе.Страна		 = НаименованиеСтраны;
		
	ИначеЕсли ЗначениеЗаполнено(Индекс) Тогда // Это российский адрес, который не удалось разложить в структуру
		
		СведенияОбАдресе.Страна		 = ОсновнаяСтрана().Наименование;
		СведенияОбАдресе.КодСтраны	 = ОсновнаяСтрана().Код;
		
	КонецЕсли;
	
КонецПроцедуры

// Описывает значения псевдоперечисления ВидыКонтактнойИнформации.
// 
// Возвращаемое значение:
//  Структура - значения и представления значений перечисления.
//
Функция Перечисление_ВидыКИ() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЮридическийАдрес", "ЮридическийАдрес");
	Результат.Вставить("ФактическийАдрес", "ФактическийАдрес");
	Результат.Вставить("ПочтовыйАдрес", "ПочтовыйАдрес");
	Результат.Вставить("Телефон", "Телефон");
	Результат.Вставить("Факс", "Факс");
	
	Возврат Результат;
	
КонецФункции

//{ Структура адреса по объекту

