// Загружает в учетный документ сведения о маркировке из товарной части ЭД.
//
// Параметры:
//  ДокументОбъект 					- ЛюбойОбъект 		- документ-владелец штрихкодов
//  ТоварнаяЧасть 					- ТаблицаЗначений 	- данные товарной части электронного документа.
//                  										См. Форма_Диадок_ЭД.Новый_ТабличнаяЧастьСтруктурыДокумента
//	ИспользоватьКонтурМаркировку	- Булево 			- истина, если получать сведения о маркировке
//                                          				нужно с помощью подсистемы "Контур.Маркировка"
//
Процедура ЗагрузитьКодыМаркировки(ДокументОбъект, ТоварнаяЧасть, ИспользоватьКонтурМаркировку = Ложь) Экспорт
	
	Если ИспользоватьКонтурМаркировку Тогда
		ЗагрузитьКодыМаркировкиКонтурМаркировка(ДокументОбъект, ТоварнаяЧасть);
	Иначе
		ЗагрузитьКодыМаркировкиВнутренний(ДокументОбъект, ТоварнаяЧасть);
	КонецЕсли;
	
КонецПроцедуры

// Загружает сведения о маркировке из товарной части ЭД штатными средствами модуля.
// Сначала загрузка выполняется с помощью интеграционного модуля. Если в интеграционном
// модуле не будет отключена стандартная обработка, то коды маркировки будут загружены
// средствами типовой библиотеки интеграции с ИС МП.
//
// Параметры:
//  ДокументОбъект - ЛюбойОбъект - документ-владелец штрихкодов
//  ТоварнаяЧасть - ТаблицаЗначений - данные товарной части электронного документа.
//
Процедура ЗагрузитьКодыМаркировкиВнутренний(ДокументОбъект, ТоварнаяЧасть)
	
	СтандартнаяОбработка = Истина;
	
	ЗагрузитьКодыМаркировкиКонфигурация(ДокументОбъект, ТоварнаяЧасть, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ЗагрузитьКодыМаркировкиИСМП(ДокументОбъект, ТоварнаяЧасть);
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьКодОСУИзGTIN(КоличествоТовара, СтрокаУпаковки)
	
	Если СтрокаУпаковки.КоличествоВПотребительскойУпаковке = 0 Тогда
		КоличествоПоТегу37 = 0;
	Иначе
		КоличествоПоТегу37 = Окр(КоличествоТовара / СтрокаУпаковки.КоличествоВПотребительскойУпаковке);
	КонецЕсли;
	
	Результат = ПодставитьПараметрыВСтроку("%1%2%3%4"
		,"02"
		,СтрокаУпаковки.ЗначениеШтрихкода
		,"37"
		,Формат(КоличествоПоТегу37,"ЧДЦ=0; ЧН=0; ЧГ=;"));
	
	Возврат Результат;
	
КонецФункции

// Переносит коды маркировки в коллекцию ItemIdentificationNumbers.
//
// Параметры:
//  НомСредИдентТов	 - Массив - содержит структуры, соответствующие объекту ItemIdentificationNumber (см. Новый_ItemIdentificationNumber)
//  КодыМаркировки	 - Структура - содержит коллекции кодов маркировки (см. НовыйСведенияОМаркировке)
//
Процедура ЗаполнитьКодыМаркировкиВСтрокеКонтента(ItemIdentificationNumbers, КодыМаркировки)
	
	Для Каждого Элемент Из КодыМаркировки.ТранспортныеУпаковки Цикл
		
		ИдентификационныйНомер = ОсновнойМодуль.Новый_ItemIdentificationNumber();
		ИдентификационныйНомер.TransPackageId = Элемент;
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КодыМаркировки.ИндивидуальныеУпаковки) Тогда
		
		ИдентификационныйНомер = ОсновнойМодуль.Новый_ItemIdentificationNumber();
		
		Для Каждого Элемент Из КодыМаркировки.ИндивидуальныеУпаковки Цикл
			ИдентификационныйНомер.PackageIds.Добавить(Элемент);
		КонецЦикла;
		
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодыМаркировки.КонтрольныеИдентификационныеЗнаки) Тогда
		
		ИдентификационныйНомер = ОсновнойМодуль.Новый_ItemIdentificationNumber();
		
		Для Каждого Элемент Из КодыМаркировки.КонтрольныеИдентификационныеЗнаки Цикл
			ИдентификационныйНомер.Units.Добавить(Элемент);
		КонецЦикла;
		
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает параметры учета номенклатуры в текущей информационной базе.
// 
// Возвращаемое значение:
//  ФикисированнаяСтруктура - содержит ключи:
//    * ИспользоватьХарактеристики - Булево - Истина, если используются характеристики номенклатуры
//    * ИспользоватьСерии - Булево - Истина, если используются серии номенклатуры
//
Функция ПараметрыУчетаНоменклатуры()
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьХарактеристики", Ложь);
	Результат.Вставить("ИспользоватьСерии", Ложь);
	
	Если Метаданные.Справочники.Найти("ХарактеристикиНоменклатуры") <> Неопределено Тогда
		Результат.ИспользоватьХарактеристики = Истина;
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("СерииНоменклатуры") <> Неопределено Тогда
		Результат.ИспользоватьСерии = Истина;
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Конструктор таблицы кодов маркировки, развернутой по номенклатуре.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица упаковок с товарными данными:
//   * Ссылка             - Произвольный - объект-владелец штрихкода - исходная колонка
//   * Номенклатура       - ОпределяемыйТип.Номенклатура - содержимое
//   * Характеристика     - ОпределяемыйТип.ХарактеристикаНоменклатуры - содержимое
//   * Серия              - ОпределяемыйТип.СерияНоменклатуры - содержимое
//   * ЗначениеШтрихкода  - Строка - текстовое представление исходного штрихкода для передачи в ЭДО
//   * ВидУпаковки        - Строка - вид упаковки номенклатуры для кодировки значения штрихкода. Допустимые значения:
//                                   УпаковкаПотребительская(), УпаковкаЛогистическая(), УпаковкаГрупповая(), Неопределено.
//   * Обработан          - Булево - признак сопоставления строки товарной части документа
//
//
Функция НоваяРазвернутаяТаблицаУпаковок()
	
	ТипСтрока200 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Серия");
	Результат.Колонки.Добавить("ЗначениеШтрихкода", ТипСтрока200);
	Результат.Колонки.Добавить("ВидУпаковки", ТипСтрока200);
	Результат.Колонки.Добавить("Обработан", ТипБулево);
	Результат.Колонки.Добавить("ИспользоватьХарактеристики", ТипБулево);
	Результат.Колонки.Добавить("ИспользоватьСерии", ТипБулево);
	
	Возврат Результат;
	
КонецФункции

