Функция ХранилищеКонтактнойИнформацииОбъекта(СсылкаНаОбъект)
	
	ХранилищеКИ = Неопределено;
	
	СтандартнаяОбработка = Истина;
	ПриОпределенииМестаХраненияКонтактнойИнформацииОбъекта(ХранилищеКИ, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		//Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Организации")
		//	И СсылкаНаОбъект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		//	ХранилищеКИ = СсылкаНаОбъект.ИндивидуальныйПредприниматель;
		//Иначе 
			ХранилищеКИ = СсылкаНаОбъект;
		//КонецЕсли;
		
	КонецЕсли;
	
	Возврат ХранилищеКИ;
	
КонецФункции

// Получает ссылку на вид контактной информации объекта.
//
// Параметры:
//  ЮрФизЛицо - ЛюбаяСсылка	 - ссылка на объект (контрагента/организацию/подразделение);
//  ТипАдреса - Строка		 - вид адреса (см. функцию Перечисление_ВидыКИ);
// 
// Возвращаемое значение:
//  СправочникСсылка.ВидыКонтактнойИнформации - вид контактной информации объекта.
//
Функция ВидАдресаЮрФизЛица(ЮрФизЛицо, ТипАдреса)
	
	Результат = Неопределено;
	
	СтандартнаяОбработка = Истина;
	ПриПолученииВидаКонтактнойИнформации(Результат, ЮрФизЛицо, ТипАдреса, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
			
			Если ЮрФизЛицо.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
				ПринадлежностьАдреса = "Организации";
			Иначе
				ПринадлежностьАдреса = "ФизЛица";
			КонецЕсли;
			
		Иначе
			ПринадлежностьАдреса = "Контрагента";
		КонецЕсли;
		
		ИмяВидаКИ = ?(ТипАдреса = Перечисление_ВидыКИ().ЮридическийАдрес, "ЮрАдрес", "ФактАдрес") + ПринадлежностьАдреса;
		Результат = Справочники.ВидыКонтактнойИнформации[ИмяВидаКИ];
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Событие возникает при определении фактического места хранения контактной информации объекта.
//
// Параметры:
//  ХранилищеКИ			 - ЛюбаяСсылка	 - место хранения контактной информации;
//  СсылкаНаОбъект		 - ЛюбаяСсылка	 - объект-владелец контактной информации;
//  СтандартнаяОбработка - Булево		 - Ложь, чтобы отключить стандартную обработку события;
