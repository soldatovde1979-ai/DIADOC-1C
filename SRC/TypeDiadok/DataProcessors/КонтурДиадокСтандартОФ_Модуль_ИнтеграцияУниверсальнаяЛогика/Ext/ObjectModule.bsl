Функция ПолучитьДатуНомерВходящейНакладной(ДокСсылка) Экспорт 
	
	Результат= Новый Структура("ДатаВходящегоДокумента, НомерВходящегоДокумента");
	
	МетаданныеДокумента= ДокСсылка.Метаданные();
	
	Если  МетаданныеДокумента.Реквизиты.Найти("ДатаВходящегоДокумента")  <> Неопределено 
		И МетаданныеДокумента.Реквизиты.Найти("НомерВходящегоДокумента") <> Неопределено Тогда 
		
		Результат.ДатаВходящегоДокумента=  ДокСсылка.ДатаВходящегоДокумента;
		Результат.НомерВходящегоДокумента= ДокСсылка.НомерВходящегоДокумента;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатуНомерВходящегоСчетаФактуры(ДокСсылка) Экспорт 
	
	Возврат ПолучитьДатуНомерВходящейНакладной(ДокСсылка);
	
КонецФункции

Процедура УстановитьДатуНомерВходящейНакладной(ДокСсылка, ДатаВходящегоДокумента, НомерВходящегоДокумента, СписокОтличающихсяРеквизитов) Экспорт 
		
	МетаданныеДокумента = ДокСсылка.Метаданные();
					
	Если  ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеДокумента, "ДатаВходящегоДокумента")
		И ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеДокумента, "НомерВходящегоДокумента")		
		И (ДокСсылка.ДатаВходящегоДокумента <> ДатаВходящегоДокумента
			ИЛИ ДокСсылка.НомерВходящегоДокумента <> НомерВходящегоДокумента) Тогда
		
		Объект = ДокСсылка.ПолучитьОбъект();
		Объект.ДатаВходящегоДокумента	= ДатаВходящегоДокумента;
		Объект.НомерВходящегоДокумента	= НомерВходящегоДокумента;
		
		Попытка
			Объект.Записать();
			Сообщить("Изменены следующие реквизиты: "+ СписокОтличающихсяРеквизитов + " 
			|у документа: " + ДокСсылка);
		Исключение
			Сообщить("Не удалось изменить следующие реквизиты: " + СписокОтличающихсяРеквизитов + "
			|у документа: " + ДокСсылка);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДатуНомерВходящегоСчетаФактуры(ДокСсылка, ДатаВходящегоДокумента, НомерВходящегоДокумента, СписокОтличающихсяРеквизитов) Экспорт 
	
	УстановитьДатуНомерВходящейНакладной(ДокСсылка, ДатаВходящегоДокумента, НомерВходящегоДокумента, СписокОтличающихсяРеквизитов);
	
КонецПроцедуры

Функция ИменаРеквизитов_КодСпособаПолучения(ДокСсылка) Экспорт
	
	Результат = "";
	
	МетаданныеДокумента = ДокСсылка.Метаданные();
	
	Если ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеДокумента, "КодСпособаПолучения") Тогда
		
		Результат = "КодСпособаПолучения";
		
	КонецЕсли;
			
	//Переопределяем имена реквизитов непосредственно в интеграционном модуле
	ОсновнойМодуль.Модуль_Интеграция.ПереопределитьИменаРеквизитов_КодСпособаПолучения(Результат, ДокСсылка);	
	
	Возврат Результат;
	
КонецФункции

//Возвращает имена реквизитов "НомерВходящегоДокумента" и "ДатаВходящегоДокумента"
//так как они заданны в текущей конфигурации
//
//Параметры:
// ДокСсылка	- ДокументСсылка	- документ, имена реквизитов которого проверяем
//
//Возвращаемое значение:
//	Структура	- с ключами "НомерВходящегоДокумента" и "ДатаВходящегоДокумента". Значением ключей
//				  является имена реквизитов в конфигурации
Функция ИменаРеквизитов_НомерИДатаВходящегоДокумента(ДокСсылка) Экспорт
	
	Результат = Новый Структура("НомерВходящегоДокумента, ДатаВходящегоДокумента");
	
	МетаданныеДокумента = ДокСсылка.Метаданные();
	
	Если ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеДокумента, "НомерВходящегоДокумента") Тогда
		
		Результат.Вставить("НомерВходящегоДокумента", "НомерВходящегоДокумента"); 
		
	КонецЕсли;
	
	Если ОсновнойМодуль.ЕстьРеквизитМетаданных(МетаданныеДокумента, "ДатаВходящегоДокумента") Тогда
		
		Результат.Вставить("ДатаВходящегоДокумента", "ДатаВходящегоДокумента"); 
		
	КонецЕсли;
	
	//Переопределяем имена реквизитов непосредственно в интеграционном модуле
	ОсновнойМодуль.Модуль_Интеграция.ПереопределитьИменаРеквизитов_НомерИДатаВходящегоДокумента(Результат, ДокСсылка);	
							
	Возврат Результат;
	
КонецФункции //ИменаРеквизитов_НомерИДатаВходящегоДокумента()

