// Ищет варианты сопоставления номенклатуры по номенклатуре контрагента.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - см. Контракт_НоменклатураКонтрагента
// 
// Возвращаемое значение:
//  Массив из Контракт_НоменклатураКонтрагента
//
Функция ВариантыСопоставленияНоменклатуры(НоменклатураКонтрагента) Экспорт
	
	Результат = Новый Массив;
	
	СтандартнаяОбработка = Истина;
	
	ИнтеграционныйМодуль = МодульИнтеграции();
	
	Если ИнтеграционныйМодуль <> Неопределено Тогда
		
		ИнтеграционныйМодуль.ПриЗаполненииВариантовСопоставленияНоменклатуры(
			Результат, 
			НоменклатураКонтрагента,
			СтандартнаяОбработка
		);
		
	КонецЕсли;
	
	Если СтандартнаяОбработка Тогда
		
		ЗаполнитьВариантыСопоставленияНоменклатурыПоУмолчанию(
			Результат,
			НоменклатураКонтрагента
		);
		
	КонецЕсли;
	
	
	Возврат Результат;
	
КонецФункции

// Запоняет варианты сопоставления номенклатурыИБ по полям НоменклатураКонтрагента
//
// Параметры:
//  Результат				 - Массив - Используется для заполнения контрактами НоваяНоменклатураИнформационнойБазы
//  НоменклатураКонтрагента	 - Структура - Структура полей см. Контракт_НоменклатураКонтрагента 
//
Процедура ЗаполнитьВариантыСопоставленияНоменклатурыПоУмолчанию(Результат, НоменклатураКонтрагента) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ИменаВТ = Новый Массив;
	
	ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Артикул);
	ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Код);
	ДобавитьЗапросПоНаименованию(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Наименование);
	
	Если Не ЗначениеЗаполнено(ИменаВТ) Тогда
		Возврат;
	КонецЕсли;
	
	ИтоговыйТекст = "";
	Разделитель = "";
	Для Каждого ИмяВТ Из ИменаВТ Цикл
		ТекстЗапроса = "ВЫБРАТЬ * ИЗ " + ИмяВТ; 
		ИтоговыйТекст = ИтоговыйТекст + Разделитель + ТекстЗапроса;
		Разделитель = " ОБЪЕДИНИТЬ ";
	КонецЦикла;
	
	Запрос = Новый Запрос(ИтоговыйТекст);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоменклатураИБ = НоваяНоменклатураИнформационнойБазы(ВыборкаДетальныеЗаписи.НоменклатураСсылка);
		
		Результат.Добавить(НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

// Добавить запрос по артикулу
//
// Параметры:
//  МенеджерВТ	 - МенеджерВременныхТаблиц - менеджер временных таблиц запроса на варианты сопоставления номенклатуры 
//  ИменаВТ		 - Массив - Массив имен временных таблиц
//  Артикул		 - Строка - Искомый артикул
//
Процедура ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, Артикул)
	
	Если Не ЗначениеЗаполнено(Артикул) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = "ВТ_ПоАртикулу" + XMLСтрока(ИменаВТ.Количество());
	
	Текст = 
	"ВЫБРАТЬ
	|  Т.Ссылка КАК НоменклатураСсылка
	|ПОМЕСТИТЬ ИмяВТ
	|ИЗ
	|  Справочник.Номенклатура КАК Т
	|ГДЕ
	|  Т.Артикул = &Артикул
	|  И НЕ Т.ЭтоГруппа
	|  И НЕ Т.ПометкаУдаления";
	
	Запрос = Новый Запрос(Текст);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТ", ИмяВТ);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Параметры.Вставить("Артикул", Артикул); 
	
	Запрос.Выполнить();
	
	ИменаВТ.Добавить(ИмяВТ);
	
КонецПроцедуры

// Добавить запрос по наименованию
//
// Параметры:
//  МенеджерВТ	 - МенеджерВременныхТаблиц - менеджер временных таблиц запроса на варианты сопоставления номенклатуры 
//  ИменаВТ		 - Массив - Массив имен временных таблиц
//  Наименование - Строка - Искомое наименование
//
Процедура ДобавитьЗапросПоНаименованию(МенеджерВТ, ИменаВТ, Наименование)
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = "ВТ_ПоНаименованию" + XMLСтрока(ИменаВТ.Количество());
	
	Текст =
		"ВЫБРАТЬ
		|  Т.Ссылка КАК НоменклатураСсылка
		|ПОМЕСТИТЬ ИмяВТ
		|ИЗ
		|  Справочник.Номенклатура КАК Т
		|ГДЕ
		|  Т.Наименование = ВЫРАЗИТЬ(&Наименование КАК Строка(1024))
		|  И НЕ Т.ЭтоГруппа
		|  И НЕ Т.ПометкаУдаления";
	
	Запрос = Новый Запрос(Текст);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТ", ИмяВТ);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Параметры.Вставить("Наименование", Наименование);
	
	Запрос.Выполнить();
	
	ИменаВТ.Добавить(ИмяВТ);
	
КонецПроцедуры

// Контракт новой номенклатуры Информационной базы
//
// Параметры:
//  Номенклатура	 - СправочникСсылка - Ссылка на номенклатуру
//  Характеристика	 - СправочникСсылка - Ссылка на характеристику
//  Упаковка		 - СправочникСсылка - Ссылка на упаковку или единицу измерения
// 
// Возвращаемое значение:
//  Структура - структура с полями 
//			  - Номенклатура - Ссылка или неопределено
//			  - Характеристика - Ссылка или неопределено
//			  - Упаковка - Ссылка или неопределено
//
Функция НоваяНоменклатураИнформационнойБазы(Номенклатура, Характеристика = Неопределено, Упаковка = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Номенклатура);
	Результат.Вставить("Характеристика");
	Результат.Вставить("Упаковка");
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Результат.Характеристика = Характеристика;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Результат.Упаковка = Упаковка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

