// Заполняет коллекцию DocumentShipments переданного контента документа 
// данными документов об отгрузке счет-фактуры.
//
//Параметры:
// Контент820 - Структура - см. ОсновнойМодуль.Новый_Utd820SellerContent()
//
Процедура ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку(Контент820, СсылкаНаОбъект) Экспорт
	
	ИнтеграционныйМодуль = ОсновнойМодуль.Модуль_Интеграция;
	
	Если ИнтеграционныйМодуль.ЭтоСчетФактураНаАванс(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокПодтвОтгр = Контент820.DocumentShipments;
	ФункцияДокумента = Контент820.Function;
	СтрокиТаблицы = Контент820.Table.Items;
	
	Если ФункцияДокумента = ФункцияПрото_Invoice() Тогда
		
		ДокументыОснования = ДокументыОснованияСчетаФактуры(СсылкаНаОбъект);
		
		НаименованиеДокумента = НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОснования, ФункцияДокумента);
		
		Для Каждого ОснованиеСФ Из ДокументыОснования Цикл
			
			Если ИнтеграционныйМодуль.ЭтоКорректировкаРеализации(ОснованиеСФ) Тогда
				ДокументОтгрузки = ИнтеграционныйМодуль.ПолучитьДокОснованиеКорректировкиРеализациии(ОснованиеСФ);
			Иначе
				ДокументОтгрузки = ОснованиеСФ;
			КонецЕсли;
			
			РеквизитыДокументаОтгрузки = ЗначенияРеквизитовОбъектаЛокальная(ДокументОтгрузки, "Дата");
			
			ДатаДокумента = РеквизитыДокументаОтгрузки.Дата;
			НомерДокумента = ИнтеграционныйМодуль.ПолучитьНомерНаПечатьДиадок(ДокументОтгрузки);
			
			РеквизитыДокумента = ДокПодтвОтгр.Добавить();
			РеквизитыДокумента.Name = НаименованиеДокумента;
			РеквизитыДокумента.Number = НомерДокумента;
			РеквизитыДокумента.Date = ДатаДокумента;
			
		КонецЦикла;
		
	Иначе
		
		ДокументыОснования = Новый Массив;
		
		НаименованиеДокумента = НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОснования, ФункцияДокумента);
		
		РеквизитыДокумента = ДокПодтвОтгр.Добавить();
		РеквизитыДокумента.Name = НаименованиеДокумента;
		РеквизитыДокумента.Number = Контент820.DocumentNumber;
		РеквизитыДокумента.Date = Контент820.DocumentDate;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента)
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Если ФункцияДокумента = ФункцияПрото_InvoiceAndBasic() Тогда
		
		Результат = НаименованияДокументов.УПД;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументыОтгрузки) И ДокументыОтгрузки.Количество() > 1 Тогда
		
		ЕстьТовары = ВДокументеЕстьТовары(СтрокиТаблицы);
		ЕстьУслуги = ВДокументеЕстьУслуги(СтрокиТаблицы);
		
		Если ЕстьТовары И НЕ ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Накладная;
			
		ИначеЕсли НЕ ЕстьТовары И ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Акт;
			
		Иначе
			Результат = НаименованияДокументов.Документ;
		КонецЕсли;
		
	Иначе
		
		ЕстьТовары = ВДокументеЕстьТовары(СтрокиТаблицы);
		
		Если ЕстьТовары Тогда
			Результат = НаименованияДокументов.Накладная;
		Иначе
			Результат = НаименованияДокументов.Акт;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованияДокументовОтгрузки()
	
	Результат = Новый Структура;
	
	Результат.Вставить("УПД", "Универсальный передаточный документ");
	Результат.Вставить("Накладная", "Товарная накладная");
	Результат.Вставить("Акт", "Акт");
	Результат.Вставить("Документ", "Документ");
	
	Возврат Результат;
	
КонецФункции

Функция ВДокументеЕстьТовары(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Имущество Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВДокументеЕстьУслуги(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = Перечисление_ItemMarks();
	
	МаксИндекс = СтрокиТаблицы.Количество() - 1;
	
	Для ТекИндекс = - МаксИндекс По 0 Цикл
		
		ItemMark = СтрокиТаблицы[ - ТекИндекс].ItemMark;
		
		Если ItemMark = ТипыНоменклатуры.Услуга
			ИЛИ ItemMark = ТипыНоменклатуры.Работа
			ИЛИ ItemMark = ТипыНоменклатуры.ИмущественныеПрава Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_ItemMarks()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Имущество", "Property");
	Результат.Вставить("Работа", "Job");
	Результат.Вставить("Услуга", "Service");
	Результат.Вставить("ИмущественныеПрава", "PropertyRights");
	Результат.Вставить("Иное", "Other");
	
	Возврат Результат;
	
КонецФункции

Функция ФункцияПрото_InvoiceAndBasic()
	
	Возврат "InvoiceAndBasic";
	
КонецФункции

Функция ФункцияПрото_Invoice()
	
	Возврат "Invoice";
	
КонецФункции

// Заполняет список правил создания учетных документов, которые
// могут быть применены к указанному формату электронных документов.
//
// Параметры:
//  ПравилаСоздания - СписокЗначений - Список с идентификаторами правил создания дкоументов учета.
//  ФорматЭД - Структура - описание формата электронных документов (см. НовоеОписаниеФорматаЭлектронногоДокумента).
//
Процедура ЗаполнитьПравилаСозданияДокументовУчета(ПравилаСоздания, ФорматЭД) Экспорт
	
	СтандартнаяОбработка = Истина;
	ИнтеграционныйМодуль = МодульИнтеграции();
	
	ИнтеграционныйМодуль.ПриЗаполненииПравилСозданияДокументовУчета(
		ПравилаСоздания,
		ФорматЭД,
		СтандартнаяОбработка
	);
	
	Если СтандартнаяОбработка Тогда
		
		ЗаполнитьПравилаСозданияДокументовУчетаПоУмолчанию(ПравилаСоздания, ФорматЭД);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НовыйДокументИнформационнойБазы(ИдентификаторОперации, ПараметрыСоздания, ДанныеЭД) Экспорт
	
	СтандартнаяОбработка = Истина;
	ИнтеграционныйМодуль = МодульИнтеграции();
	
	НовыйОбъект = Неопределено;
	
	ИнтеграционныйМодуль.ПриСозданииДокументаУчета(
		НовыйОбъект,
		ИдентификаторОперации,
		ПараметрыСоздания,
		ДанныеЭД,
		СтандартнаяОбработка
	);
	
	Если НовыйОбъект = Неопределено Тогда
		
		МенеджерОбъекта = Документы[ИдентификаторОперации];
		НовыйОбъект = МенеджерОбъекта.СоздатьДокумент();
		
	КонецЕсли;
	
	Если СтандартнаяОбработка Тогда
		
		НовыйОбъект.Заполнить(ПараметрыСоздания);
		
		ОбъектМетаданных = НовыйОбъект.Метаданные();
		
		Если ЕстьРеквизитМетаданных(ОбъектМетаданных, "Комментарий")
			И Не ЗначениеЗаполнено(НовыйОбъект.Комментарий) Тогда
			НовыйОбъект.Комментарий = "Загружен из системы Диадок";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйОбъект.Дата) Тогда
			НовыйОбъект.Дата = ТекущаяДата();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйОбъект.Номер) Тогда
			НовыйОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не НовыйОбъект = Неопределено Тогда
		ТабличнаяЧастьЭД = ДанныеЭД.ТабличнаяЧасть;
		ИспользоватьКонтурМаркировку = ПараметрыСоздания.ИспользоватьКонтурМаркировку; // TODO: Получать из параметров
		ЗагрузитьКодыМаркировки(НовыйОбъект, ТабличнаяЧастьЭД, ИспользоватьКонтурМаркировку);
	КонецЕсли;
	
	Возврат НовыйОбъект;
	
КонецФункции

// Получает номенклатуру информационной базы, соответствующую идентификаторам номенклатуры контрагента.
//
// Параметры:
//  ВладелецНоменклатуры - ОпределяемыйТип.ВладелецНоменклатурыБЭД - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Строка, Массив из Строка - идентификаторы номенклатуры контрагента.
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//    * Ключ - Строка - идентификатор номенклатуры контрагента.
//    * Значение - Структура - номенклатура информационной базы (см. МенеджерИнтеграции.НоваяНоменклатураИнформационнойБазы)
//
Функция ПрочитатьСопоставлениеНоменклатуры(ВладелецНоменклатуры, ИдентификаторыНоменклатуры) Экспорт
	
	Результат = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(ИдентификаторыНоменклатуры) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ИдентификаторыНоменклатуры) = Тип("Массив") Тогда
		КоллекцияИдентификаторов = ИдентификаторыНоменклатуры;
	Иначе
		КоллекцияИдентификаторов = Новый Массив;
		КоллекцияИдентификаторов.Добавить(ИдентификаторыНоменклатуры);
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ПрочитатьСоответствиеНоменклатурыПереопределяемый(
		Результат,
		ВладелецНоменклатуры,
		КоллекцияИдентификаторов,
		СтандартнаяОбработка
	);
	
	Если СтандартнаяОбработка Тогда
		
		ПрочитатьСоответствиеНоменклатурыПоУмолчанию(
			Результат,
			ВладелецНоменклатуры,
			КоллекцияИдентификаторов
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает соответствие номенклатуры информационной базы с номенклатурой поставщика.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - сведения о номенклатуре контрагента (см. МенеджерИнтеграции.НоваяНоменклатураКонтрагента)
//  НоменклатураИБ - Структура - сведения о номенклатуре информационной базы (см. МенеджерИнтеграции.НоваяНоменклатураИнформационнойБазы)
//
Процедура ЗаписатьСопоставлениеНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ) Экспорт
	
	СтандартнаяОбработка = Истина;
	ЗаписатьСоответствиеНоменклатурыПереопределяемый(НоменклатураКонтрагента, НоменклатураИБ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ЗаписатьСоответствиеНоменклатурыПоУмолчанию(НоменклатураКонтрагента, НоменклатураИБ);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает описание и взаимосвязь объектов, составляющих номенклатуру информационной базы.
// Результат базируется на определяемых типах и переопределяемых методах.
//
// Возвращаемое значение:
//  Структура - данные о структуре номенклатуры информационной базы:
//   * ВладелецНоменклатурыПредставлениеОбъекта - Строка - представление единичного объекта владельца номенклатуры.
//   * НоменклатураПредставлениеОбъекта - Строка - представление единичного объекта номенклатуры.
//   * ХарактеристикаПредставлениеОбъекта - Строка - представление единичного объекта характеристики.
//   * УпаковкаПредставлениеОбъекта - Строка - представление единичного объекта упаковки.
//   * ИмяПараметраСвязиХарактеристики - Строка - имя параметра связи характеристики от номенклатуры.
//   * ИмяПараметраСвязиУпаковки - Строка - имя параметра связи упаковки от номенклатуры.
//
Функция МетаданныеСопоставленияНоменклатуры() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВладелецНоменклатурыПредставлениеОбъекта");
	Результат.Вставить("НоменклатураПредставлениеОбъекта");
	Результат.Вставить("ХарактеристикаПредставлениеОбъекта");
	Результат.Вставить("УпаковкаПредставлениеОбъекта");
	
	Результат.Вставить("ИмяПараметраСвязиХарактеристики", "Отбор.Владелец");
	Результат.Вставить("ИмяПараметраСвязиУпаковки", "Отбор.Владелец");
	
	СтандартнаяОбработка = Истина;
	
	ИнтеграционныйМодуль = МодульИнтеграции();
	ИнтеграционныйМодуль.ПриЗаполненииМетаданныхСопоставленияНоменклатуры(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ЗаполнитьМетаданныеСопоставленияНоменклатурыПоУмолчанию(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает свойства набора номенклатур информационной базы.
// Определяет обязательность использования характеристики и упаковки.
//
// Параметры:
//  СсылкаИлиМассив - Массив из ОпределяемыйТип.НоменклатураБЭД, ОпределяемыйТип.НоменклатураБЭД
//    - ссылки на номенклатуру ИБ, для которой требуется определить свойства. Если передается ссылка, преобразуется в массив.
//
// Возвращаемое значение:
// Соответствие, Неопределено - в случае незаполненного набора номенклатуры возвращается Неопределено. Соответствие содержит:
//  * Ключ     - ОпределяемыйТип.НоменклатураБЭД - ссылка на номенклатуру ИБ.
//  * Значение - Структура                       - содержит свойства номенклатуры ИБ. См. НовыеСвойстваНоменклатурыИБ.
//
Функция СвойстваНоменклатурыИнформационнойБазы(Знач СсылкаИлиМассив) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СсылкаИлиМассив) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СвойстваНоменклатурИБ = Новый Соответствие;
	
	Если ТипЗнч(СсылкаИлиМассив) = Тип("Массив") Тогда
		НаборНоменклатуры = СсылкаИлиМассив;
	Иначе
		НаборНоменклатуры = Новый Массив;
		НаборНоменклатуры.Добавить(СсылкаИлиМассив);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаборНоменклатуры) Тогда
		Возврат СвойстваНоменклатурИБ;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	
	ИнтеграционныйМодуль = МодульИнтеграции();
	ИнтеграционныйМодуль.ПриОпределенииСвойствНоменклатурыИнформационнойБазы(СвойстваНоменклатурИБ, НаборНоменклатуры, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ОпределитьСвойстваНоменклатурыИнформационнойБазыПоУмолчанию(СвойстваНоменклатурИБ, НаборНоменклатуры);
	КонецЕсли;
	
	Возврат СвойстваНоменклатурИБ;
	
КонецФункции

// Возвращает структуру свойств номенклатуры ИБ.
//
// Возвращаемое значение:
//  Структура - свойства номенклатуры информационной базы:
//   * ИспользоватьХарактеристики           - Булево - признак использования характеристик. По умолчанию Ложь.
//   * ИспользоватьУпаковки                 - Булево - признак использования упаковок. По умолчанию Ложь.
//   * ОбязательноеЗаполнениеХарактеристики - Булево - признак обязательного заполнения характеристик при их использовании. По умолчанию Истина.
//
Функция НовыеСвойстваНоменклатурыИБ() Экспорт
	
	СвойствоНоменклатуры = Новый Структура;
	СвойствоНоменклатуры.Вставить("ИспользоватьХарактеристики"          , Ложь);
	СвойствоНоменклатуры.Вставить("ИспользоватьУпаковки"                , Ложь);
	СвойствоНоменклатуры.Вставить("ОбязательноеЗаполнениеХарактеристики", Ложь);
	
	Возврат СвойствоНоменклатуры;
	
КонецФункции

// Заполняет коллекцию значений полей маршрутизации по данным документа 1С
//
// Параметры:
//	ЗначениеПолей	- Массив			- коллекция со значением полей маршрутизации
//	ИменаПолей		- Массив			- коллекция с именами полей маршрутизации
//	Документ1С		- ДокументСсылка	- документ, по которому определяются значения полей маршрутизации
Процедура ПолучитьЗначениеПолейМаршрутизацииПоДокументу1С(ЗначениеПолей, ИменаПолей, Документ1С) Экспорт
	
	Если Не ЗначениеЗаполнено(ИменаПолей) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛокальная(Документ1С, ИменаПолей);
	
	Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			ЗначениеПолей.Добавить(КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

