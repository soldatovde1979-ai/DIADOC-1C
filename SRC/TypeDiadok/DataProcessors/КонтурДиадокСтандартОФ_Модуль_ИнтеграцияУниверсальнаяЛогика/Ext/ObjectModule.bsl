	|			КОГДА ПОДСТРОКА(СчетНаоплатуТовары.Номенклатура.НаименованиеПолное, 1, 10) = """"
	|				ТОГДА СчетНаоплатуТовары.Номенклатура.Наименование
	|			ИНАЧЕ СчетНаоплатуТовары.Номенклатура.НаименованиеПолное
