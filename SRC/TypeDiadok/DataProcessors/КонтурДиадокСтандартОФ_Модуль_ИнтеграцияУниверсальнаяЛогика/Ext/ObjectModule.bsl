// Возвращает XML представление ставки НДС для записи в контент электронных документов.
//
// Параметры:
//  СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - ставка НДС, представление которой нужно получить;
//  ИспользоватьРасчетныеСтавки     - Булево - Ложь, если наименование расчетных ставок,
//                                             таких как "20/120", использовать запрещено (необязательный);
// 
// Возвращаемое значение:
//   - Строка - Наименование ставки НДС или "##", если наименование определить не удалось.
//
Функция ПолучитьПредставлениеСтавкиНДС(СтавкаНДС, ИспользоватьРасчетныеСтавки = Истина) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда
		
		НаименованияСтавок = Новый Соответствие;
		НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС0		, "0");
		НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС10	, "10");
		НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС18	, "18");
		НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС20	, "20");
		НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.БезНДС	, "без НДС");
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС5") Тогда
			НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС5, "5");
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС7") Тогда
			НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС7, "7");
		КонецЕсли;
		
		Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС22") Тогда
			НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС22, "22");
		КонецЕсли;
		
		Если ИспользоватьРасчетныеСтавки Тогда
			
			НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС10_110, "10/110");
			НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС18_118, "18/118");
			
			Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС20_120") Тогда
				НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС20_120, "20/120");
			КонецЕсли;
			
			Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС5_105") Тогда
				НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС5_105, "5/105");
			КонецЕсли;
			
			Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС7_107") Тогда
				НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС7_107, "7/107");
			КонецЕсли;
			
			Если СуществуетОбъектМетаданных("Перечисление.СтавкиНДС.ЗначениеПеречисления.НДС22_122") Тогда
				НаименованияСтавок.Вставить(Перечисления.СтавкиНДС.НДС22_122, "22/122");
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = НаименованияСтавок.Получить(СтавкаНДС);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			
			// Представление ставки НДС получить не удалось,
			// поэтому возвращаем признак ошибки через зарезервированную строку "##".
			// Такую строку умеет обрабатывать валидация контента.
			Результат = "##";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактуранаАванс(СчетФактура) Экспорт
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный")
		И СуществуетОбъектМетаданных("Перечисление.ВидСчетаФактурыВыставленного")
		И СуществуетОбъектМетаданных("Документ.СчетФактураВыданный.Реквизит.ВидСчетаФактуры") Тогда
		
		ВидСчетаФактуры = СчетФактура.ВидСчетаФактуры;
		
		Возврат
		
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАванс
		ИЛИ (СуществуетОбъектМетаданных("Перечисление.ВидСчетаФактурыВыставленного.ЗначениеПеречисления.НаАвансКомитента")
			  И ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАвансКомитента);
		
			 
	КонецЕсли;
				
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьНаименованиеКолонкиКодаТовара() Экспорт
	
	КолонкаКодаТовара = "Код";
	
	Попытка
		Если Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить() = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
			КолонкаКодаТовара = "Артикул";
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат КолонкаКодаТовара;
	
КонецФункции

Функция ДиадокПолучитьПараметрыУчетнойПолитики(ДокСсылка) 
	
	Результат = Неопределено;
	
	Дата		 = ДокСсылка.Дата;
	Организация	 = ДокСсылка.Организация;
	
	Если Метаданные.ОбщиеМодули.ОбщегоНазначения.Глобальный Тогда
		// Поддержка БП 1.5 для 8.1
		Результат = Вычислить("ПолучитьПараметрыУчетнойПолитики(Дата, Неопределено, Организация)");
	Иначе
		Результат = Вычислить("ОбщегоНазначения.ПолучитьПараметрыУчетнойПолитики(Дата, Неопределено, Организация)");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатуНомерДокументовОплаты(СчетФактура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданныйДатаНомерДокументовОплаты.ДатаПлатежноРасчетногоДокумента,
	|	СчетФактураВыданныйДатаНомерДокументовОплаты.НомерПлатежноРасчетногоДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДатаНомерДокументовОплаты КАК СчетФактураВыданныйДатаНомерДокументовОплаты
	|ГДЕ
	|	СчетФактураВыданныйДатаНомерДокументовОплаты.Ссылка = &Ссылка
	|	И СчетФактураВыданныйДатаНомерДокументовОплаты.НомерПлатежноРасчетногоДокумента <> """"
	|	И СчетФактураВыданныйДатаНомерДокументовОплаты.ДатаПлатежноРасчетногоДокумента <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьНомераДляСФ(СсылкаНаОбъект) Экспорт 
	
	ДанныеДляПечати = Новый Структура;
	
	Если СсылкаНаОбъект.Метаданные().Реквизиты.Найти("Исправление") <> Неопределено И СсылкаНаОбъект.Исправление Тогда
		
		ДанныеДляПечати.Вставить("НомерДокумента"	, ?(ЗначениеЗаполнено(СсылкаНаОбъект.НомерИсходногоДокумента), СсылкаНаОбъект.НомерИсходногоДокумента, СсылкаНаОбъект.НомерИсправляемогоКорректировочногоДокумента));
		ДанныеДляПечати.Вставить("ДатаДокумента"	, ?(ЗначениеЗаполнено(СсылкаНаОбъект.ДатаИсходногоДокумента), СсылкаНаОбъект.ДатаИсходногоДокумента, СсылкаНаОбъект.ДатаИсправляемогоКорректировочногоДокумента));
		ДанныеДляПечати.Вставить("ЭтоИСФ"			, Истина);
		ДанныеДляПечати.Вставить("НомерИсправления"	, Строка(СсылкаНаОбъект.НомерИсправления));
		ДанныеДляПечати.Вставить("ДатаИсправления"	, СсылкаНаОбъект.Дата);
		
	Иначе 
		
		ДанныеДляПечати.Вставить("НомерДокумента"	, ПолучитьНомерНаПечатьДиадок(СсылкаНаОбъект));
		ДанныеДляПечати.Вставить("ДатаДокумента" 	, СсылкаНаОбъект.Дата);
		ДанныеДляПечати.Вставить("ЭтоИСФ"			, Ложь);
		
	КонецЕсли;	
	
	Возврат ДанныеДляПечати;
	
КонецФункции	

Функция ПолучитьНомераДляКСФ(ДокСсылка) Экспорт 
	
	ДанныеДляПечати = Новый Структура;
	Если (ДокСсылка.Метаданные().Реквизиты.Найти("Исправление")<>Неопределено) И (ДокСсылка.Исправление) Тогда 
		//это ксф с исправлением
		ДанныеДляПечати.вставить("НомерКСФ", ДокСсылка.НомерИсправляемогоКорректировочногоДокумента);
		ДанныеДляПечати.вставить("ДатаКСФ",  ДокСсылка.ДатаИсправляемогоКорректировочногоДокумента);
		ДанныеДляПечати.вставить("ЭтоИКСФ", Истина);
		
		ДанныеДляПечати.вставить("НомерИКСФ", формат(ДокСсылка.НомерИсправления, "ЧДЦ=0; ЧГ=0"));
		ДанныеДляПечати.вставить("ДатаИКСФ",  ДокСсылка.Дата);
	Иначе 
		//это ксф без исправлений
		ДанныеДляПечати.вставить("НомерКСФ", ОсновнойМодуль.Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(ДокСсылка));
		ДанныеДляПечати.вставить("ДатаКСФ",  ДокСсылка.Дата);
		ДанныеДляПечати.вставить("ЭтоИКСФ", Ложь);
	КонецЕсли;
	
	Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ИсправляемыйДокументРеализации = ОсновнойМодуль.Модуль_Интеграция.ПолучитьИсправляемыйДокументРеализации(ДокСсылка);
		ДатаИсходногоДокумента 	= ИсправляемыйДокументРеализации.Дата;
		НомерИсходногоДокумента = ОсновнойМодуль.Модуль_Интеграция.ПолучитьНомерНаПечатьДиадок(ИсправляемыйДокументРеализации);
		УчитыватьИсправлениеИсходногоДокумента 	= Ложь;
		НомерИсправленияИсходногоДокумента 		=  "";
		ДатаИсправленияИсходногоДокумента 		= Дата(1, 1, 1);
	Иначе
		ПерваяСтрокаТЧ = ДокСсылка.ДокументыОснования[0];
		ДатаИсходногоДокумента = ПерваяСтрокаТЧ.ДатаИсходногоДокумента;
		НомерИсходногоДокумента = ПерваяСтрокаТЧ.НомерИсходногоДокумента;
		ДатаИсправленияИсходногоДокумента = ПерваяСтрокаТЧ.ДатаИсправленияИсходногоДокумента;
		НомерИсправленияИсходногоДокумента = ПерваяСтрокаТЧ.НомерИсправленияИсходногоДокумента;
		УчитыватьИсправлениеИсходногоДокумента = ПерваяСтрокаТЧ.УчитыватьИсправлениеИсходногоДокумента;
	КонецЕсли;
	
	ДанныеДляПечати.вставить("ДатаИсходногоДокумента",				  	ДатаИсходногоДокумента);
	ДанныеДляПечати.вставить("НомерИсходногоДокумента", 				НомерИсходногоДокумента);
	ДанныеДляПечати.вставить("УчитыватьИсправлениеИсходногоДокумента",  УчитыватьИсправлениеИсходногоДокумента);
	ДанныеДляПечати.вставить("НомерИсправленияИсходногоДокумента",  	НомерИсправленияИсходногоДокумента);
	ДанныеДляПечати.вставить("ДатаИсправленияИсходногоДокумента",  		ДатаИсправленияИсходногоДокумента);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ПолучитьКПППокупателя(СсылкаНаОбъект) Экспорт 
	
	Если НЕ СсылкаНаОбъект.Метаданные().Реквизиты.Найти("КППКонтрагента") = Неопределено Тогда
		Если ЗначениеЗаполнено(СсылкаНаОбъект.КППКонтрагента) Тогда
			Возврат СсылкаНаОбъект.КППКонтрагента
		КонецЕсли
	КонецЕсли;	
	
	Возврат ""
КонецФункции	

Функция ТребуетсяПерезаполнитьСуммыПоУЕвРублях(ДокументРеализации, СчетФактура = Неопределено, ЭтоСФ = Ложь, ЭтоАкт = Ложь) Экспорт 
	
	Результат = Ложь;
	
	Если НЕ ЭтоСчетФактуранаАванс(СчетФактура)                                               // Счета-фактуры на аванс заполняются в рублях, их пересчитывать не надо.
		И ДокументРеализации.ВалютаДокумента <> ПолучитьВалютуРегламентированногоУчета()     // Документ в иностранной валюте.
		И ДиадокПолучитьПараметрыУчетнойПолитики(ДокументРеализации) <> Неопределено Тогда   // Есть учетная политика на дату документа.
		
		Если ДокументРеализации.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах Тогда

			
			Результат = Истина; // Документ в у.е. всегда пересчитываем в рубли.
			
		Иначе
			
			Результат = НЕ ЭтоСФ И НЕ ЭтоАкт; // Валютный Счет-фактуру и валютный Акт в рубли пересчитывать не нужно.
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
			
КонецФункции

Функция ПолучитьВалютуРегламентированногоУчета() Экспорт
	
	Результат = ОсновнойМодуль.ЭДО_Кэш_Прочитать("ВалютаРегламентированногоУчета");
	
	Если Результат = Неопределено Тогда
		
		Попытка
			Результат = Вычислить("глЗначениеПеременной(""ВалютаРегламентированногоУчета"")");
		Исключение
			Результат = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецПопытки;
		
		ОсновнойМодуль.ЭДО_Кэш_Поместить("ВалютаРегламентированногоУчета", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВалютуДокумента(ВалютаДокумента, СчетФактура) Экспорт 
	
	Валюта = ВалютаДокумента; 
	РасчетыВУЕ = Ложь;
	ВалютаРегламентированногоУчета=	Константы.ВалютаРегламентированногоУчета.Получить();
	УчетнаяПолитика=				ДиадокПолучитьПараметрыУчетнойПолитики(СчетФактура);
	Если НЕ УчетнаяПолитика = Неопределено 
		И СчетФактура.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах = Истина И
		ВалютаДокумента <> ВалютаРегламентированногоУчета Тогда
		РасчетыВУЕ = Истина;
	КонецЕсли;
	
	Если РасчетыВУЕ = Истина ИЛИ ЭтоСчетФактуранаАванс(СчетФактура) Тогда
		Валюта = ВалютаРегламентированногоУчета;
	КонецЕсли;		
	
	Возврат Валюта; 
	
КонецФункции 

Функция ПолучитьСтруктуруОснования(ДокСсылка, ЭтоАкт = Ложь, ЭтоУПД = Ложь)  Экспорт 
	
	Перем Сделка;
	
	ДоговорКонтрагента = ДокСсылка.ДоговорКонтрагента;
	
	Если ЭтоАкт = Ложь
		И ЗначениеЗаполнено(ДоговорКонтрагента)
		И ДоговорКонтрагента.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам
		И ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокСсылка, "Сделка", Сделка)
		И ЗначениеЗаполнено(Сделка)
		И ТипЗнч(Сделка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		Результат = ПолучитьСтруктуруОснованияПоЗаказу(Сделка);
		
	Иначе
		
		Результат = ПолучитьСтруктуруОснованияПоДоговору(ДоговорКонтрагента, ЭтоУПД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьСтруктуруОснованияПоДоговору(Договор, ЭтоУПД)  Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("GroundName");
	Результат.Вставить("GroundNumber");
	Результат.Вставить("GroundDate");
	Результат.Вставить("Основание");
	
	Если ЗначениеЗаполнено(Договор) Тогда
		
		Результат.GroundName   = ?(ЭтоУПД, "Договор", Договор.Наименование);
		Результат.GroundNumber = Договор.Номер;
		Результат.GroundDate   = Договор.Дата;
		Результат.Основание	   = Договор;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьСтруктуруОснованияПоЗаказу(Заказ)  Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("GroundName");
	Результат.Вставить("GroundNumber");
	Результат.Вставить("GroundDate");
	Результат.Вставить("Основание");
	
	Если ЗначениеЗаполнено(Заказ) Тогда
		
		Результат.GroundName   = Заказ.Метаданные().Представление();
		Результат.GroundNumber = ПолучитьМодульПрог("Модуль_Интеграция").ПолучитьНомерНаПечатьДиадок(Заказ);
		Результат.GroundDate   = Заказ.Дата;
		Результат.Основание	   = Заказ;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	



Функция ПолучитьПредставлениеХарактеристикиИСерии(Выборка) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
		Результат = "(" + стрЗаменить(выборка.Характеристика, "<>", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Серия) Тогда
		Результат = ?(стрДлина(результат) = 0, " (", Результат+"; ") + стрЗаменить(выборка.серия, "<>", "");
	КонецЕсли;
	
	Возврат ?(Результат = "", "", Результат + ")");
	
КонецФункции

Функция ПолучитьНомерГТД(НомерГТД) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(НомерГТД) Тогда
		
		Если ТипЗнч(НомерГТД) = Тип("Строка") Тогда
			
			Результат = НомерГТД;
			
		ИначеЕсли НЕ ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(НомерГТД, "РегистрационныйНомер", Результат) Тогда
			
			Результат = НомерГТД.Код;
			
		КонецЕсли; 
		
		Результат = СокрЛП(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуНомерГТД(НомерГТД, СоздатьНовый = Ложь) Экспорт
	
	Результат = Неопределено;
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.НомераГТД ГДЕ Код = &НомерГТД";
	
	Если СуществуетОбъектМетаданных("Справочник.НомераГТД.Реквизит.РегистрационныйНомер") Тогда
		ТекстЗапроса = ТекстЗапроса + РазделительОбъединенияЗапросов() + "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.НомераГТД ГДЕ РегистрационныйНомер = &НомерГТД";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НомерГТД", НомерГТД);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат = Выборка.Ссылка;
		
	Иначе
		
		НовыйЭлемент = Справочники.НомераГТД.СоздатьЭлемент();
		
		НовыйЭлемент.Код = НомерГТД;
		
		Если СуществуетОбъектМетаданных("Справочник.НомераГТД.Реквизит.РегистрационныйНомер") Тогда
			
			РеквизитыДляЗаполнения = Новый Структура;
			РеквизитыДляЗаполнения.Вставить("РегистрационныйНомер", НомерГТД);
			
			Попытка
				ЗначенияРеквизитов = Справочники.НомераГТД.РегистрационныйНомерИСтранаВвоза(НомерГТД);
			Исключение 
				ЗначенияРеквизитов = РеквизитыДляЗаполнения;
			КонецПопытки;    
			
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЗначенияРеквизитов);
			
		КонецЕсли;
		
		НовыйЭлемент.Записать();
		
		Результат = НовыйЭлемент.Ссылка;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуСерииНоменклатуры(Номенклатура, НомерГТД, СтранаПроисхождения = "", СоздатьНовый = Ложь) Экспорт
	
	Результат = Неопределено;
	
	ВестиУчетПоСериям = Ложь;
	
	Если	НЕ ЗначениеЗаполнено(Номенклатура)
		ИЛИ НЕ ЗначениеЗаполнено(НомерГТД)
		ИЛИ НЕ ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(Номенклатура, "ВестиУчетПоСериям", ВестиУчетПоСериям)
		ИЛИ НЕ ВестиУчетПоСериям Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	СсылкаНомерГТД = ОсновнойМодуль.Модуль_Интеграция.ПолучитьСсылкуНомерГТД(НомерГТД);
		
	// Ищем существующий элемент в справочнике серий.
	Если ЗначениеЗаполнено(СсылкаНомерГТД) Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			| 	СерииНоменклатуры.Ссылка
			| ИЗ
			| 	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
			| ГДЕ
			| 	СерииНоменклатуры.Владелец = &Владелец
			| 	И СерииНоменклатуры.НомерГТД = &НомерГТД
			| 	И &ТекстОтбораПоСтранеПроисхождения
			| 	И НЕ СерииНоменклатуры.ПометкаУдаления";
		
		Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
			ПодстрокаЗамены = "СерииНоменклатуры.СтранаПроисхождения = &СтранаПроисхождения";
			СсылкаСтранаПроисхождения = Справочники.КлассификаторСтранМира.НайтиПоНаименованию(СтранаПроисхождения);
			Если Не ЗначениеЗаполнено(СсылкаСтранаПроисхождения) Тогда
				СсылкаСтранаПроисхождения = Справочники.КлассификаторСтранМира.ПустаяСсылка();
			КонецЕсли;
		Иначе
			// для совместимости с необязательностью параметра "СтранаПроисхождения"
			ПодстрокаЗамены = "ИСТИНА";
		КонецЕсли;		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстОтбораПоСтранеПроисхождения", ПодстрокаЗамены);
		
		Запрос.УстановитьПараметр("Владелец", Номенклатура);
		Запрос.УстановитьПараметр("НомерГТД", СсылкаНомерГТД);
		Запрос.УстановитьПараметр("СтранаПроисхождения", СсылкаСтранаПроисхождения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Результат = Выборка.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Создаем новый элемент в справочнике серий.
	Если НЕ ЗначениеЗаполнено(Результат) И СоздатьНовый = Истина Тогда
		
		СсылкаСтранаПроисхождения = НайтиСоздатьСтрануПроисхождения(СтранаПроисхождения);
		
		Если ЗначениеЗаполнено(СсылкаСтранаПроисхождения) Тогда
			
			// Создаем новый элемент в справочнике НомераГТД
			Если НЕ ЗначениеЗаполнено(СсылкаНомерГТД) Тогда
				СсылкаНомерГТД = ОсновнойМодуль.Модуль_Интеграция.ПолучитьСсылкуНомерГТД(НомерГТД, Истина);
			КонецЕсли;
			
			НовыйЭлемент = Справочники.СерииНоменклатуры.СоздатьЭлемент();
			
			НовыйЭлемент.Владелец 	  = Номенклатура;
			НовыйЭлемент.НомерГТД	  = СсылкаНомерГТД;
			НовыйЭлемент.Наименование = Строка(СсылкаНомерГТД) + ", " + Строка(СсылкаСтранаПроисхождения); 
			НовыйЭлемент.СтранаПроисхождения = СсылкаСтранаПроисхождения;
			
			НовыйЭлемент.Записать();
			
			Результат = НовыйЭлемент.Ссылка;
			
		Иначе
			
			Сообщить("Не удалось создать серию """ + НомерГТД + """ для номенклатуры """ + Номенклатура + """
			|По причине: В классификаторе стран мира не найдена страна с наименованием """ + СтранаПроисхождения + ""); 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция НайтиСоздатьСтрануПроисхождения(СтранаПроисхождения)
	
	СсылкаСтранаПроисхождения = Справочники.КлассификаторСтранМира.НайтиПоНаименованию(СтранаПроисхождения);
	
	Если НЕ ЗначениеЗаполнено(СсылкаСтранаПроисхождения) Тогда
		
		ПодходящиеСтраны = ПолучитьМодульПрог("ГенерацияXML").ПодходящиеСтраны(СтранаПроисхождения);
		
		Если ЗначениеЗаполнено(ПодходящиеСтраны) Тогда
			ПодходящаяСтрана = ДанныезаполненияСтраны(ПодходящиеСтраны[0]);
			
			СсылкаСтранаПроисхождения = Справочники.КлассификаторСтранМира.НайтиПокоду(ПодходящаяСтрана.Код);
			
			Если НЕ ЗначениеЗаполнено(СсылкаСтранаПроисхождения) Тогда
				НовыйЭлемент = Справочники.КлассификаторСтранМира.СоздатьЭлемент();
				ЗаполнитьЗначенияСвойств(НовыйЭлемент, ПодходящаяСтрана);
				НовыйЭлемент.Записать();
				СсылкаСтранаПроисхождения = НовыйЭлемент.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	Возврат СсылкаСтранаПроисхождения;
КонецФункции

Функция ДанныеЗаполненияСтраны(ОписаниеСтраны)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Наименование"		, "");
	СтруктураВозврата.Вставить("НаименованиеКраткое", "");
	СтруктураВозврата.Вставить("НаименованиеПолное"	, "");
	СтруктураВозврата.Вставить("КодАльфа2"			, "");
	СтруктураВозврата.Вставить("КодАльфа3"			, "");  
	СтруктураВозврата.Вставить("Код"				, "");
	СтруктураВозврата.Вставить("Неактуальный"		, "");
	
	ЗаполнитьЗначенияСвойств(СтруктураВозврата, ОписаниеСтраны);
	
	Если НЕ ЗначениеЗаполнено(СтруктураВозврата.Наименование) Тогда
		СтруктураВозврата.Наименование = СтруктураВозврата.НаименованиеКраткое;
	КонецЕсли;         
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ДиадокПолучитьОсновнойДоговорКонтрагента(Контрагент, Организация, СписокВидовДоговоров) Экспорт
	
	Запрос = Новый Запрос( 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.ОсновнойДоговорКонтрагента КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО Контрагенты.ОсновнойДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|			И (ДоговорыКонтрагентов.Организация = &Организация)
	|			И (НЕ ДоговорыКонтрагентов.ПометкаУдаления)
	|			И (ДоговорыКонтрагентов.ВидДоговора В (&СписокДоговоров))
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент");
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СписокДоговоров", СписокВидовДоговоров);
	
	РезультатЗапроса= Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка= РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка
	КонецЕсли;
		
КонецФункции

