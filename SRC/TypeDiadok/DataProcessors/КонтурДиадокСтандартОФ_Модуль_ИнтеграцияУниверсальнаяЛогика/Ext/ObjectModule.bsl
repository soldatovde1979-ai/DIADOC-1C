//{ Маркировка.ИнтеграционныйМодульКонфигурации

// Получает коды маркировки из документа с помощью ИМ и обогащает ими контент.
//
// Параметры:
//  Контент - Структура - протоконтент электронного документа.
//  СсылкаНаОбъект - ЛюбаяСсылка - источник данных для получения контента.
//
Процедура ЗаполнитьСведенияОМаркировке_ИнтеграционныйМодуль(Контент, СсылкаНаОбъект)
	
	СтандартнаяОбработка = Истина;
	РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
	
	ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковок, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка = Ложь Тогда
		ЗаполнитьСведенияОМаркировкеВКонтенте(Контент, РазвернутаяТаблицаУпаковок);
	КонецЕсли;
	
КонецПроцедуры

// Получает коды маркировки из документа с помощью подсистемы ИМ и обогащает ими контент.
//
// Параметры:
//  Контент - Структура - протоконтент электронного документа.
//  СсылкаНаОбъект - ЛюбаяСсылка - источник данных для получения контента.
//  ИсходныйДокумент - ЛюбаяСсылка - источник данных для получения контена до изменения.
//
Процедура ЗаполнитьСведенияОМаркировке736_ИнтеграционныйМодуль(Контент, СсылкаНаОбъект, ИсходныйДокумент)
	
	СтандартнаяОбработка = Истина;
	РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
	РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок();
	
	ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковок, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда 
		ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковокДоИзменения, ИсходныйДокумент, СтандартнаяОбработка);
	КонецЕсли;
	
	Если СтандартнаяОбработка = Ложь Тогда
		ЗаполнитьСведенияОМаркировкеВКонтенте736(Контент, РазвернутаяТаблицаУпаковок, РазвернутаяТаблицаУпаковокДоИзменения);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет таблицу кодов штатными средствами конфигурации (с помощью интеграционного модуля).
//
// Параметры:
//  Результат - ТаблицаЗначений - Заполняемая таблица (см. НоваяРазвернутаяТаблицаУпаковок).
//  СсылкаНаДокумент - ЛюбаяСсылка - объект-владелец штрихкода.
//  СтандартнаяОбработка - Булево - если установить Ложь, то заполнение таблицы кодов средствами
//                                  типовой библиотеки интеграции с ИС МП будет отключено.
//
Процедура ЗаполнитьРазвернутуюТаблицуКодов(Результат, СсылкаНаОбъект, СтандартнаяОбработка)
	
	ИнтеграционныйМодуль = ОсновнойМодуль.Модуль_Интеграция;
	ИнтеграционныйМодуль.ЗаполнитьРазвернутуюТаблицуКодов(Результат, СсылкаНаОбъект, СтандартнаяОбработка);
	
КонецПроцедуры

// Загружает сведения о маркировке из товарной части ЭД штатными средствами конфигурации.
//
// Параметры:
//  ДокументОбъект - ЛюбойОбъект - документ-владелец штрихкодов.
//  ТоварнаяЧасть - ТаблицаЗначений - данные товарной части электронного документа.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить загрузку средствами библиотеки интеграции ИС МП.
//
Процедура ЗагрузитьКодыМаркировкиКонфигурация(ДокументОбъект, ТоварнаяЧасть, СтандартнаяОбработка = Истина)
	
	ИнтеграционныйМодуль = ОсновнойМодуль.Модуль_Интеграция;
	ИнтеграционныйМодуль.ЗагрузитьКодыМаркировки(ДокументОбъект, ТоварнаяЧасть, СтандартнаяОбработка);
	
КонецПроцедуры

//} Маркировка.ИнтеграционныйМодульКонфигурации


//{ Маркировка.БиблиотекаИнтеграцииИСМП

// Получает коды маркировки из документа с помощью подсистемы ИСМП и обогащает ими контент.
//
// Параметры:
//  Контент - Структура - протоконтент электронного документа.
//  СсылкаНаОбъект - ЛюбаяСсылка - источник данных для получения контента.
//
Процедура ЗаполнитьСведенияОМаркировке_ИСМП(Контент, СсылкаНаОбъект)
	
	Если НЕ ЕстьИнтеграцияИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
	ТаблицаУпаковок = ТаблицаУпаковокИСМП(ДокументыПередачи);
	
	Если Не ЗначениеЗаполнено(ТаблицаУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяИнтеграцияИСМП10127() Тогда
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок_ИСМП10127();
		ТаблицаТоваров = ТаблицаТоваровИСМП(Контент.Table.Items);
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИКодыОСУИСМП(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте_ИСМП10127(Контент, РазвернутаяТаблицаУпаковок);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИСМП(ТаблицаУпаковок);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте(Контент, РазвернутаяТаблицаУпаковок);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировке736_ИСМП(Контент, СсылкаНаОбъект, ИсходныйДокумент)
	
	Если НЕ ЕстьИнтеграцияИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
	ТаблицаУпаковок = ТаблицаУпаковокИСМП(ДокументыПередачи);
	
	Если Не ЗначениеЗаполнено(ТаблицаУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяИнтеграцияИСМП10127() Тогда
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок_ИСМП10127();
		РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок_ИСМП10127();
		ТаблицаТоваров = ТаблицаТоваровИСМП736(Контент.InvoiceCorrectionTable.Items, Ложь);
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИКодыОСУИСМП(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда 
			
			ИсходныеДокументыПередачи = ВладельцыКодовМаркировки(ИсходныйДокумент);
			ТаблицаУпаковокДоИзменения = ТаблицаУпаковокИСМП(ИсходныеДокументыПередачи);
			ИсходныйДокументПередачи = ?(ИсходныеДокументыПередачи.Количество(), ИсходныеДокументыПередачи[0], Неопределено);
			ТаблицаТоваровДоИзменения = ТаблицаТоваровИСМП736(
				Контент.InvoiceCorrectionTable.Items,
				Истина,
				ИсходныйДокументПередачи
			);
			ДанныеШтрихкодовУпаковокДоИзменения = ЧастичноеСодержимоеИКодыОСУИСМП(
				ТаблицаУпаковокДоИзменения,
				ТаблицаТоваровДоИзменения,
				ИсходныеДокументыПередачи
			);
			
			ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковокДоИзменения, ДанныеШтрихкодовУпаковокДоИзменения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736_ИСМП10127(
			Контент,
			РазвернутаяТаблицаУпаковок,
			РазвернутаяТаблицаУпаковокДоИзменения
		);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
		РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок();
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИСМП(ТаблицаУпаковок);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда 
			
			ИсходныеДокументыПередачи = ВладельцыКодовМаркировки(ИсходныйДокумент);
			ТаблицаУпаковокДоИзменения = ТаблицаУпаковокИСМП(ИсходныеДокументыПередачи);
			ДанныеШтрихкодовУпаковокДоИзменения = ЧастичноеСодержимоеИСМП(ТаблицаУпаковокДоИзменения);
			
			ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковокДоИзменения, ДанныеШтрихкодовУпаковокДоИзменения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736(Контент, РазвернутаяТаблицаУпаковок, РазвернутаяТаблицаУпаковокДоИзменения);
		
	КонецЕсли;
	
КонецПроцедуры

// Загружает сведения о маркировке из товарной части ЭД средствами типовой библиотеки интеграции с ИС МП.
//
// Параметры:
//  ДокументОбъект - ЛюбойОбъект - документ-владелец штрихкодов
//  ТоварнаяЧасть - ТаблицаЗначений - данные товарной части электронного документа.
//
Процедура ЗагрузитьКодыМаркировкиИСМП(ДокументОбъект, ТоварнаяЧасть)
	
	Если Не ЕстьИнтеграцияИСМП()
		Или Не ЕстьШтрихкодыУпаковокИСМП(ДокументОбъект.Метаданные())
		Или Не ЗначениеЗаполнено(ТоварнаяЧасть) Тогда
		Возврат;
	КонецЕсли;
	
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	Для Каждого СтрокаТЧ Из ТоварнаяЧасть Цикл
		ДополнитьТаблицуШтрихкодов(
		    ШтрихкодыУпаковок,
			СтрокаТЧ.СведенияОМаркировке,
			СтрокаТЧ.НоменклатураДокумента.GTIN);
	КонецЦикла;
	
	ШтрихкодыУпаковок.Свернуть("ШтрихкодУпаковки, ЗначениеШтрихкода");
	
	ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	
КонецПроцедуры

Функция ТаблицаТоваровИСМП(СтрокиКонтента)
	
	Результат = НоваяТаблицаТоваровИСМП(СтрокиКонтента);
	
	Для Каждого СтрокаКонтента Из СтрокиКонтента Цикл
		
		СлужебнаяИнформацияСтрокиКонтента = СтрокаКонтента.СлужебнаяИнформация;
		
		СтрокаТаблицыТоваров = Результат.Добавить();
		СтрокаТаблицыТоваров.Номенклатура = СлужебнаяИнформацияСтрокиКонтента.Номенклатура;
		СтрокаТаблицыТоваров.Характеристика = СлужебнаяИнформацияСтрокиКонтента.Характеристика;
		СтрокаТаблицыТоваров.Ссылка = СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки;
		СтрокаТаблицыТоваров.Количество = СтрокаКонтента.Quantity;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаТоваровИСМП736(СтрокиКонтента, ИспользоватьКоличествоДоИзменения,
		ДокументОтгрузкиДоИзменения = Неопределено)
	
	Результат = НоваяТаблицаТоваровИСМП(СтрокиКонтента, ДокументОтгрузкиДоИзменения);
	
	Для Каждого СтрокаКонтента Из СтрокиКонтента Цикл
		
		СлужебнаяИнформацияСтрокиКонтента = СтрокаКонтента.СлужебнаяИнформация;
		
		СтрокаТаблицыТоваров = Результат.Добавить();
		СтрокаТаблицыТоваров.Номенклатура = СлужебнаяИнформацияСтрокиКонтента.Номенклатура;
		СтрокаТаблицыТоваров.Характеристика = СлужебнаяИнформацияСтрокиКонтента.Характеристика;
		
		Если ЗначениеЗаполнено(ДокументОтгрузкиДоИзменения) Тогда
			СтрокаТаблицыТоваров.Ссылка = ДокументОтгрузкиДоИзменения;
		Иначе
			СтрокаТаблицыТоваров.Ссылка = СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки;
		КонецЕсли;
		
		Если ИспользоватьКоличествоДоИзменения Тогда
			СтрокаТаблицыТоваров.Количество = СтрокаКонтента["OriginalValues"].Quantity;
		Иначе
			СтрокаТаблицыТоваров.Количество = СтрокаКонтента["CorrectedValues"].Quantity;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НоваяТаблицаТоваровИСМП(СтрокиКонтента, ДокументОтгрузкиДоИзменения = Неопределено)
	
	ОписаниеТипаНоменклатура = Новый ОписаниеТипов(Справочники.ТипВсеСсылки());
	ОписаниеТипаХарактеристика = Новый ОписаниеТипов(Справочники.ТипВсеСсылки());
	ОписаниеТипаСсылка = Новый ОписаниеТипов(Документы.ТипВсеСсылки());
	
	Если СтрокиКонтента.Количество() Тогда
		
		СлужебнаяИнформацияСтрокиКонтента = СтрокиКонтента[0].СлужебнаяИнформация;
		
		Если ЗначениеЗаполнено(СлужебнаяИнформацияСтрокиКонтента.Номенклатура) Тогда
			ОписаниеТипаНоменклатура = ОписаниеТиповЗначения(СлужебнаяИнформацияСтрокиКонтента.Номенклатура);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СлужебнаяИнформацияСтрокиКонтента.Характеристика) Тогда
			ОписаниеТипаХарактеристика = ОписаниеТиповЗначения(СлужебнаяИнформацияСтрокиКонтента.Характеристика);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОтгрузкиДоИзменения) Тогда
			ОписаниеТипаСсылка = ОписаниеТиповЗначения(ДокументОтгрузкиДоИзменения);
		ИначеЕсли ЗначениеЗаполнено(СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки) Тогда
			ОписаниеТипаСсылка = ОписаниеТиповЗначения(СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", ОписаниеТипаНоменклатура);
	Результат.Колонки.Добавить("Характеристика", ОписаниеТипаХарактеристика);
	Результат.Колонки.Добавить("Ссылка", ОписаниеТипаСсылка);
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Возврат Результат;
	
КонецФункции

// Проверяет, возможна ли интеграция с ИС МП.
// 
// Возвращаемое значение:
//  Булево - Истина, если подсистема есть.
//
Функция ЕстьИнтеграцияИСМП()
	
	Результат = Ложь;
	
	Если Метаданные.ОбщиеМодули.Найти("ОбновлениеИнформационнойБазыИСМП") <> Неопределено Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияБиблиотекиИнтеграцииИСМП()
	
	ОписаниеПодсистемы = Новый Структура;
	ОписаниеПодсистемы.Вставить("Имя", "");
	ОписаниеПодсистемы.Вставить("Версия", "");
	ОписаниеПодсистемы.Вставить("ТребуемыеПодсистемы", Новый Массив);
	
	МодульОбновлениеИнформационнойБазыИСМП = Вычислить("ОбновлениеИнформационнойБазыИСМП");
	МодульОбновлениеИнформационнойБазыИСМП.ПриДобавленииПодсистемы(ОписаниеПодсистемы);
	
	Результат = ОписаниеПодсистемы.Версия;
	
	Возврат Результат;
	
КонецФункции

