Функция СчетФактураПолученныйПоДокументуОснование(ДокументОснование) Экспорт
	
	Запрос= Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования КАК ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК Т
	|		ПО ТЧ.Ссылка = Т.Ссылка
	|			И (НЕ Т.ПометкаУдаления)
	|ГДЕ
	|	ТЧ.ДокументОснование = &ДокументОснование");
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	Запрос = Неопределено;
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		РезультатЗапроса = Неопределено;
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
КонецФункции

Функция СчетФактураВыданныйПоДокументуОснование(ДокументОснование) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Док.Ссылка
		|ИЗ
		|	Документ.СчетФактураВыданный КАК Док
		|ГДЕ
		|	Док.ДокументОснование = &ДокументОснование";
		
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		РезультатЗапроса = Неопределено;
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
		
КонецФункции


Функция СФПоМассивуДокументовОснованийИдентичны(МассивДокументыОснования) Экспорт
	
	Запрос = Новый Запрос;
	
	Если СуществуетОбъектМетаданных("Документ.СчетФактураПолученный.ТабличнаяЧасть.ДокументыОснования") Тогда

	    Запрос.Текст =
		    "ВЫБРАТЬ Т.ДокументОснование ПОМЕСТИТЬ ВТ Из &ТаблицаДокументов КАК Т;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		    |   ИСТИНА
		    |ИЗ
		    |   ВТ КАК ВТ
		    |       ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный.ДокументыОснования КАК ТЧ
		    |           ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК Т
		    |           ПО ТЧ.Ссылка = Т.Ссылка
		    |               И (НЕ Т.ПометкаУдаления)
		    |       ПО ВТ.ДокументОснование = ТЧ.ДокументОснование
		    |
		    |ИМЕЮЩИЕ
		    |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(Т.Ссылка, НЕОПРЕДЕЛЕНО)) = 1";

	Иначе

	    Запрос.Текст = 
			"ВЫБРАТЬ Т.ДокументОснование ПОМЕСТИТЬ ВТ ИЗ &ТаблицаДокументов КАК Т;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		    |   ИСТИНА
		    |ИЗ
		    |   ВТ КАК ВТ
		    |       ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК Т
		    |       ПО ВТ.ДокументОснование = Т.ДокументОснование
		    |           И (НЕ Т.ПометкаУдаления)
		    |
		    |ИМЕЮЩИЕ
		    |   КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(Т.Ссылка, НЕОПРЕДЕЛЕНО)) = 1";

	КонецЕсли;

	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("ДокументОснование", Документы.ТипВсеСсылки());
	
	Для Каждого ДокументОснование Из МассивДокументыОснования Цикл
		НоваяСтрока = ТаблицаДокументов.Добавить(); 
		НоваяСтрока.ДокументОснование = ДокументОснование;
	КонецЦикла;
		
	Запрос.УстановитьПараметр("ТаблицаДокументов", ТаблицаДокументов);

	// Запрос возвращает Истину, если счета-фактуры или их остутствие идентичны у всех документов оснований.
	Возврат НЕ Запрос.Выполнить().Пустой();
		
КонецФункции

