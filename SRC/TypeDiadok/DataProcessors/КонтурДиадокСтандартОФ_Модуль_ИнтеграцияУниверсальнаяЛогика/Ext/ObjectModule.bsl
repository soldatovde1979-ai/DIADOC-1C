//{ Прослеживаемость

// Возвращает признак применения Федерального Закона 
// который вводит понятие прослеживаемости для определенных групп товаров
// Параметры:
// Дата - тип дата, в данном параметре передается
//        дата на которую необходимо определить признак применения ФЗ
// Возвращаемое значение:
//  Булево - признак применения
//           Истина - ФЗ применяется
//           Ложь   - ФЗ не применяется
Функция ИспользуетсяУчетПрослеживаемыхТоваров(Дата) Экспорт
	
	ИнтеграционныйМодуль	 = ОсновнойМодуль.Модуль_Интеграция;
	Результат				 = ИнтеграционныйМодуль.ИспользуетсяУчетПрослеживаемыхТоваров(Дата);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСведенияПрослеживаемости(Контент) Экспорт
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		Если ОсновнойМодуль.СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ПрослеживаемыйТовар", Ложь) = Истина Тогда
			
			ДанныеПрослеживаемости = ОсновнойМодуль.СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ДанныеПрослеживаемости", Новый Массив);
			
			Если ДанныеПрослеживаемости <> Неопределено Тогда
				
				Для каждого СтрокаДанныхПрослеживаемости Из ДанныеПрослеживаемости Цикл
					
					ItemTracingInfo					 = ОсновнойМодуль.Новый_ItemTracingInfo();
					
					ItemTracingInfo.Unit			 = СтрокаДанныхПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости;
					ItemTracingInfo.UnitName		 = СокрЛП(СтрокаДанныхПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости);
					ItemTracingInfo.Quantity		 = СтрокаДанныхПрослеживаемости.КоличествоПоРНПТ;
					ItemTracingInfo.RegNumberUnit	 = СокрЛП(СтрокаДанныхПрослеживаемости.НомерГТДРегистрационныйНомер);
					
					Если ЗначениеЗаполнено(ItemTracingInfo.RegNumberUnit) Тогда
						СтрокаТЧ.ItemTracingInfos.Добавить(ItemTracingInfo);
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЗначениеЗаполнено(СтрокаТЧ.CustomDeclarations) Тогда
					
					Для каждого CustomDeclaration Из СтрокаТЧ.CustomDeclarations Цикл
						CustomDeclaration.DeclarationNumber = "Прослеж";
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает структуру свойств строки прослеживаемости
//
// Возвращаемое значение:
//  Структура
//
Функция НовыеСвойстваЭлементаПрослеживаемости() Экспорт
	
