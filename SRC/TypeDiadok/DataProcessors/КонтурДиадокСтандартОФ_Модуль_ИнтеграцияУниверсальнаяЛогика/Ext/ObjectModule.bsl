Функция НДСПоДокументуИсчисляетсяНалоговымАгентом(ДокументСсылка) Экспорт

	Если НЕ ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументСсылка, "ДоговорКонтрагента") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ОсновнойМодуль.ЕстьРеквизитИлиСвойствоОбъектаЛок(ДокументСсылка.ДоговорКонтрагента,
		"РеализацияТоваровОблагаемыхНДСУПокупателя") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ДокументСсылка.ДоговорКонтрагента.РеализацияТоваровОблагаемыхНДСУПокупателя;

КонецФункции // НДСПоДокументуИсчисляетсяНалоговымАгентом()

Функция АдресЭлектроннойПочты(Объект, ВидАдреса) Экспорт
	
	Перем Результат;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Представление ИЗ РегистрСведений.КонтактнаяИнформация ГДЕ Объект = &Объект И Вид = &ВидАдреса И Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты) ");
	
	Запрос.УстановитьПараметр("Объект"	 , Объект);
	Запрос.УстановитьПараметр("ВидАдреса", ВидАдреса);
	
	РезультатЗапроса= Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка= РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат = Выборка.Представление;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтруктуруАдреса(AddressInfo, ЮрФизЛицо, ИспользоватьЮрАдрес = Ложь, АдресСтрокой = "") Экспорт
	
	СведенияОбАдресе = СведенияОбАдресе(ЮрФизЛицо, ИспользоватьЮрАдрес, АдресСтрокой);
	
	Заполнить_AddressInfo(AddressInfo, СведенияОбАдресе);
				
КонецПроцедуры

Функция СтрокаИностранногоАдресаБезСтраны(СтрокаАдреса, НаименованиеСтраны)
	// Вырезает страну из начала строки с адресом
	// Если название страны входит, например, в улицу, то из улицы вырезаться не должно
	
	Результат = "";
	МассивТокенов = ПреобразоватьСтрокуВМассивПодстрок(СтрокаАдреса, ",");
	
	// Удалим первое вхождение страны
	Для Сч = 0 По МассивТокенов.ВГраница() Цикл
		
		Токен = МассивТокенов[Сч];
		
		Если ВРЕГ(СокрЛП(Токен)) = ВРЕГ(СокрЛП(НаименованиеСтраны)) Тогда
			МассивТокенов.Удалить(Сч);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	// И соберем строку обратно
	Для Каждого Токен Из МассивТокенов Цикл
		Результат = Результат + Токен + ",";
	КонецЦикла;
	
	// Удалим последнюю запятую
	Результат = Лев(Результат, СтрДлина(Результат) - 1);
	
	Возврат СокрЛП(Результат);

КонецФункции

