Функция ТаблицаВыгрузкиВДиадок_ТаблицаНастроекПечати(Организация)
	
	Запрос= Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация,
	|	ЕСТЬNULL(ПечатныеФормыДляТоваров.Значение, ""Торг-12"") КАК ПечатнаяФормаДляТоваров,
	|	ЕСТЬNULL(ПечатныеФормыДляУслуг.Значение, ""Акт"") КАК ПечатнаяФормаДляУслуг
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЯщикиДиадок
	|		ПО Организации.Ссылка = ЯщикиДиадок.Объект
	|			И (ЯщикиДиадок.Свойство = &СвойствоЯщикДиадокДляОрганизации)
	|			И (ЯщикиДиадок.Значение <> """")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ПечатныеФормыДляТоваров
	|		ПО Организации.Ссылка = ПечатныеФормыДляТоваров.Объект
	|			И (ПечатныеФормыДляТоваров.Объект ССЫЛКА Справочник.Организации)
	|			И (ПечатныеФормыДляТоваров.Свойство = &СвойствоПечатнаяФормаДляТоваров)
	|			И (ПечатныеФормыДляТоваров.Значение <> """")
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ПечатныеФормыДляУслуг
	|		ПО Организации.Ссылка = ПечатныеФормыДляУслуг.Объект
	|			И (ПечатныеФормыДляУслуг.Объект ССЫЛКА Справочник.Организации)
	|			И (ПечатныеФормыДляУслуг.Свойство = &СвойствоПечатнаяФормаДляУслуг)
	|			И (ПечатныеФормыДляУслуг.Значение <> """")
	|ГДЕ
	|	Организации.Ссылка В (&Организация)");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.УстановитьПараметр("СвойствоЯщикДиадокДляОрганизации", ОсновнойМодуль.ОдинСАдаптер_СвойстваОбъектов_ПолучитьСсылкуНаСвойство(ПолучитьМодульПрог("Модуль_Данные1С_СвязиОбъектов").ИдентификаторСвойстваЯщикОрганизации()));
	Запрос.УстановитьПараметр("СвойствоПечатнаяФормаДляТоваров"	,ОсновнойМодуль.ОдинСАдаптер_СвойстваОбъектов_ПолучитьСсылкуНаСвойство(ПолучитьМодульПрог("Модуль_Данные1С_СвязиОбъектов").ИдентификаторСвойстваПечатнаяФормаДляТоваров()));
	Запрос.УстановитьПараметр("СвойствоПечатнаяФормаДляУслуг"	,ОсновнойМодуль.ОдинСАдаптер_СвойстваОбъектов_ПолучитьСсылкуНаСвойство(ПолучитьМодульПрог("Модуль_Данные1С_СвязиОбъектов").ИдентификаторСвойстваПечатнаяФормаДляУслуг()));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает строку представления суммы счета-фактуры
// Для корректировочных счетов-фактур отображает суммы увеличения и уменьшения
//
// Параметры:
//  ПараметрыСФ - Структура - см. функцию модуля интеграции ПолучитьПараметрыСФ()
// 
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеСуммы(ПараметрыСФ)
	
	СуммаДокумента = Формат(ПараметрыСФ.СуммаДокумента, "ЧДЦ=2");
	СуммаУвеличение = Формат(ПараметрыСФ.СуммаУвеличение, "ЧДЦ=2");
	СуммаУменьшение = Формат(ПараметрыСФ.СуммаУменьшение, "ЧДЦ=2");
	
	Если ЗначениеЗаполнено(СуммаУвеличение) И ЗначениеЗаполнено(СуммаУменьшение) Тогда
		
		Результат = "+" + СуммаУвеличение + " -" + СуммаУменьшение;
		
	ИначеЕсли ЗначениеЗаполнено(СуммаУвеличение) Тогда
		
		Результат = "+" + СуммаУвеличение;
		
	ИначеЕсли ЗначениеЗаполнено(СуммаУменьшение) Тогда
		
		Результат = "-" + СуммаУменьшение;
		
	Иначе
		
		Результат = СуммаДокумента;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строку представления суммы НДС счета-фактуры
// Для корректировочных счетов-фактур отображает суммы увеличения НДС и уменьшения НДС
//
// Параметры:
//  ПараметрыСФ - Структура - см. функцию модуля интеграции ПолучитьПараметрыСФ()
// 
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеСуммыНДС(ПараметрыСФ)
	
	СуммаНДСДокумента = Формат(ПараметрыСФ.СуммаНДСДокумента, "ЧДЦ=2");
	СуммаНДСУвеличение = Формат(ПараметрыСФ.СуммаНДСУвеличение, "ЧДЦ=2");
	СуммаНДСУменьшение = Формат(ПараметрыСФ.СуммаНДСУменьшение, "ЧДЦ=2");
	
	Если ЗначениеЗаполнено(СуммаНДСУвеличение) И ЗначениеЗаполнено(СуммаНДСУменьшение) Тогда
		
		Результат = "+" + СуммаНДСУвеличение + " -" + СуммаНДСУменьшение;
		
	ИначеЕсли ЗначениеЗаполнено(СуммаНДСУвеличение) Тогда
		
		Результат = "+" + СуммаНДСУвеличение;
		
	ИначеЕсли ЗначениеЗаполнено(СуммаНДСУменьшение) Тогда
		
		Результат = "-" + СуммаНДСУменьшение;
		
	Иначе
		
		Результат = СуммаНДСДокумента;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

