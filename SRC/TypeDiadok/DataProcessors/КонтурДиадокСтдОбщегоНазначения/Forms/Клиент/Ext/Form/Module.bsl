&НаКлиенте
Процедура ВыполнитьОбработкуОповещенияСлужебный(ВыполняемоеОповещение, МассивПараметров = Неопределено)
	
	Если ВыполняемоеОповещение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрокаПараметров = Новый Массив;
	Если ТипЗнч(МассивПараметров) = Тип("Массив")
		ИЛИ ТипЗнч(МассивПараметров) = Тип("ФиксированныйМассив") Тогда
		Для Сч = 0 По МассивПараметров.ВГраница() Цикл
			МассивСтрокаПараметров.Добавить("МассивПараметров[" + Формат(Сч, "ЧН=0; ЧГ=0") + "]");
		КонецЦикла;
	КонецЕсли;
	МассивСтрокаПараметров.Добавить("ВыполняемоеОповещение.ДополнительныеПараметры");
	СтрокаПараметров = СтдКлиентЛок.Стр().СтрСоединитьЛок(МассивСтрокаПараметров, ", ");
	
	Скрипт = "ВыполняемоеОповещение.Модуль.%1(%2)";
	Скрипт = СтрЗаменить(Скрипт, "%1", ВыполняемоеОповещение.ИмяПроцедуры);
	Скрипт = СтрЗаменить(Скрипт, "%2", СтрокаПараметров);
	
	Выполнить(Скрипт);
	
КонецПроцедуры // ВыполнитьОбработкуОповещенияСлужебный

&НаКлиенте
Функция ЗначениеТипаПлатформыСистемнойИнформацииКлиента(Значение)

	Массив = Новый Массив;
	Массив.Добавить("Android_ARM");
	Массив.Добавить("Android_ARM_64");
	Массив.Добавить("Android_x86");
	Массив.Добавить("Android_x86_64");
	Массив.Добавить("iOS_ARM");
	Массив.Добавить("iOS_ARM_64");
	Массив.Добавить("Linux_ARM64");
	Массив.Добавить("Linux_E2K");
	Массив.Добавить("Linux_x86");
	Массив.Добавить("Linux_x86_64");
	Массив.Добавить("MacOS_x86");
	Массив.Добавить("MacOS_x86_64");
	Массив.Добавить("Windows_x86");
	Массив.Добавить("Windows_x86_64");
	Массив.Добавить("WinRT_ARM");
	Массив.Добавить("WinRT_x86");
	Массив.Добавить("WinRT_x86_64");	
	
	Соответствие = Новый Соответствие;
	
	Для Каждого Элемент Из Массив Цикл
		Попытка 	
			Соответствие.Вставить(ТипПлатформы[Элемент], Элемент);
		Исключение
			Продолжить;	
		КонецПопытки;
	КонецЦикла;
	
	Результат = Соответствие.Получить(Значение);
	Если Результат = Неопределено Тогда
		Результат = "Неопределено";	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ЗначениеТипаПлатформыСистемнойИнформацииКлиента

&НаКлиенте
Функция СообщениеПользователюЛок(
		Знач ТекстСообщенияПользователю,
		Знач КлючДанных,
		Знач Поле,
		Знач ПутьКДанным = "",
		Отказ = Ложь,
		ЭтоОбъект = Ложь) Экспорт
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
	
	Отказ = Истина;
	
	Возврат Сообщение;
	
КонецФункции // СообщениеПользователюЛок

