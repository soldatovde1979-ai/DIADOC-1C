Процедура ЗаполнитьШапкуПоступленияТоваровУслуг(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	УстановитьПараметрыУчетаНДС(ДокументОбъект, ПараметрыСоздания.ЦенаВключаетНДС);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьДоговорСПоставщиком(ДокументОбъект);
	УстановитьТипЦенДокумента(ДокументОбъект);
	
	УстановитьПараметрыОтраженияДокументаВУчете(ДокументОбъект);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьПодразделениеДокумента(ДокументОбъект);
	УстановитьВалютуДокумента(ДокументОбъект);
	УстановитьСкладДокумента(ДокументОбъект);
	УстановитьВидПоступленияПокупка(ДокументОбъект);
	
	ЗаполнитьСчетаУчетаРасчетов(ДокументОбъект);
	
КонецПроцедуры

Функция НоменклатураЯвляетсяУслугойВЭД(ВидНоменклатурыЭД)
	
	Результат = Ложь;
	
	Если ВидНоменклатурыЭД = "2" Или ВидНоменклатурыЭД = "3" Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьПоступленияТоваровУслуг(ДокументОбъект, ТабличнаяЧасть)
	
	ВладелецНоменклатуры = ДокументОбъект.Контрагент;
	
	МетаданныеОбъекта = ДокументОбъект.Метаданные();
	
	Для Каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		НоменклатураИБ = СтрокаДанных.НоменклатураИнформационнойБазы;
		
		Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура = НоменклатураИБ.Номенклатура;
			Характеристика= НоменклатураИБ.Характеристика;
		Иначе
			Номенклатура = Неопределено;
			Характеристика= Неопределено;
		КонецЕсли;
		
		ЭтоУслуга = ЭтоНоменклатураУслуга(Номенклатура);
		НоменклатураЯвляетсяУслугойВЭД = НоменклатураЯвляетсяУслугойВЭД(СтрокаДанных.ВидНоменклатуры);

		Если (Номенклатура <> Неопределено И ЭтоУслуга) ИЛИ (Номенклатура = Неопределено И НоменклатураЯвляетсяУслугойВЭД) Тогда
			
			ИмяТЧ = "Услуги";
			
			СтрокаТЧ = ДокументОбъект.Услуги.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.Содержание = СтрокаДанных.Наименование;
			
			ЗаполнитьСтатьюЗатратВПоступленииТоваровУслуг(СтрокаТЧ, Номенклатура);
			
		Иначе
			
			ИмяТЧ = "Товары";
			
			СтрокаТЧ = ДокументОбъект.Товары.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.ХарактеристикаНоменклатуры = Характеристика;
			СтрокаТЧ.ЕдиницаИзмерения = ЕдиницаИзмеренияНоменклатуры(Номенклатура, СтрокаДанных.КодЕдИзм);
			СтрокаТЧ.Коэффициент = 1;
			
		КонецЕсли;
		
		Количество = СтрокаДанных.Количество;
		Если Не ЗначениеЗаполнено(Количество) Тогда
			Количество = 1;
		КонецЕсли;
		
		Сумма = СтрокаДанных.СуммаБезНДС;
		Цена = СтрокаДанных.Цена;
		
		Если ДокументОбъект.СуммаВключаетНДС Тогда
			Сумма = СтрокаДанных.СуммаСНДС;
			Цена = Сумма / Количество;
		КонецЕсли;
		
		СтрокаТЧ.Количество	= Количество;
		СтрокаТЧ.Цена		= Цена;
		СтрокаТЧ.Сумма		= Сумма;
		СтрокаТЧ.СуммаНДС	= СтрокаДанных.СуммаНДС;
		СтрокаТЧ.СтавкаНДС	= ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС);
		
		ЗаполнитьСчетаУчетаСтрокиТабличнойЧасти(ИмяТЧ, СтрокаТЧ, ДокументОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуКорректировкиПоступления(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	ЗаполнитьПоДокументуОснованию(ДокументОбъект, ПараметрыСоздания.ДокументОснование);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьВидКорректировкиСогласованноеИзменение(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьКорректировкиПоступления(ДокументОбъект, ТабличнаяЧасть)
	
	ДокументОбъект.Товары.Очистить();
	ДокументОбъект.Услуги.Очистить();
	
	ВладелецНоменклатуры = ДокументОбъект.Контрагент;
	
	Для Каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		НоменклатураНаименование = СтрокаДанных.Наименование;
		
		НоменклатураИБ = СтрокаДанных.НоменклатураИнформационнойБазы;
		
		Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура = НоменклатураИБ.Номенклатура;
			Характеристика= НоменклатураИБ.Характеристика;
		Иначе
			Номенклатура = Неопределено;
			Характеристика= Неопределено;
		КонецЕсли;
		
		РеквизитыНоменклатуры = РеквизитыНоменклатурыИнформационнойБазы(Номенклатура);
		
		Если РеквизитыНоменклатуры.Услуга Тогда
			
			ИмяТЧ = "Услуги";
			
			СтрокаТЧ = ДокументОбъект.Услуги.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.Содержание = НоменклатураНаименование;
			СтрокаТЧ.СодержаниеДоИзменения = НоменклатураНаименование;
			
		Иначе
			
			ИмяТЧ = "Товары";
			
			СтрокаТЧ = ДокументОбъект.Товары.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.ХарактеристикаНоменклатуры = Характеристика;
			СтрокаТЧ.ЕдиницаИзмерения = ЕдиницаИзмеренияНоменклатуры(Номенклатура, СтрокаДанных.КодЕдИзм);
			СтрокаТЧ.Коэффициент = 1;
			
		КонецЕсли;
		
		СтрокаТЧ.Количество				= СтрокаДанных.Количество;
		СтрокаТЧ.КоличествоДоИзменения	= СтрокаДанных.Количество_До;
		СтрокаТЧ.Цена					= СтрокаДанных.Цена;
		СтрокаТЧ.ЦенаДоИзменения		= СтрокаДанных.Цена_До;
		СтрокаТЧ.Сумма					= СтрокаДанных.СуммаБезНДС;
		СтрокаТЧ.СуммаДоИзменения		= СтрокаДанных.СуммаБезНДС_До;
		СтрокаТЧ.СуммаНДС				= СтрокаДанных.СуммаНДС;
		СтрокаТЧ.СуммаНДСДоИзменения	= СтрокаДанных.СуммаНДС_До;
		СтрокаТЧ.СтавкаНДС				= ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС);
		СтрокаТЧ.СтавкаНДСДоИзменения	= ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС_До);
		
		ЗаполнитьСчетаУчетаСтрокиТабличнойЧасти(ИмяТЧ, СтрокаТЧ, ДокументОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуСчетаФактурыПолученного(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	ЗаполнитьПоДокументуОснованию(ДокументОбъект, ПараметрыСоздания.ДокументОснование);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьРеквизитыИсправленияВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьОбщиеРеквизитыСчетаФактуры(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеРеквизитыСчетаФактурыПолученного(ДокументОбъект, ДанныеЭД, ФорматЭД)

	ЭтоСчетФактураНаАванс	= ДанныеЭД.ЭтоАванс;
	Итоги					= ДанныеЭД.Итоги;

	ДокументОбъект.СуммаДокумента		= Итоги.СуммаВсего;
	ДокументОбъект.СуммаНДСДокумента	= Итоги.СуммаНДС;
	
	Если ЭтоСчетФактураНаАванс Тогда
		
		Для Каждого СтрокаСФ Из ДанныеЭД.ТабличнаяЧасть Цикл
			
			НоваяСтрокаАвансы = ДокументОбъект.Авансы.Добавить();
			
			НоваяСтрокаАвансы.Сумма		= СтрокаСФ.СуммаСНДС;
			НоваяСтрокаАвансы.СуммаНДС	= СтрокаСФ.СуммаНДС;
			НоваяСтрокаАвансы.СтавкаНДС	= ПолучитьСтавкуНДСДиадок(СтрокаСФ.СтавкаНДС);
			
		КонецЦикла;
		
		ДокументОбъект.КодВидаОперации = "02";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаАванс;
		
	Иначе
		
		ДокументОбъект.КодВидаОперации = "01";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаПоступление;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОсновныеРеквизитыКорректировочногоСчетаФактурыПолученного(ДокументОбъект, ДанныеЭД, ФорматЭД)

	ЭтоСчетФактураНаАванс	= ДанныеЭД.ЭтоАванс;	
	ИтогиУменьшение			= ДанныеЭД.ИтогиУменьшение;
	ИтогиУвеличение			= ДанныеЭД.ИтогиУвеличение;
	
	ДокументОбъект.СуммаУменьшение		= ИтогиУменьшение.СуммаВсего;
	ДокументОбъект.СуммаНДСУменьшение	= ИтогиУменьшение.СуммаНДС;
	
	ДокументОбъект.СуммаУвеличение		= ИтогиУвеличение.СуммаВсего;
	ДокументОбъект.СуммаНДСУвеличение	= ИтогиУвеличение.СуммаНДС;
	
	Если ЭтоСчетФактураНаАванс Тогда
		ДокументОбъект.КодВидаОперации = "02";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.КорректировочныйНаАванс;
	Иначе
		ДокументОбъект.КодВидаОперации = "01";
		ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьОбщиеРеквизитыСчетаФактуры(ДокументОбъект)

	ДокументОбъект.КодСпособаПолучения = 2;
	
	Если ДокументОбъект.ДокументыОснования.Количество() = 0 Тогда
		ДокументОбъект.ДокументыОснования.Добавить().ДокументОснование = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьШапкуПоступленияДопРасходов(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	УстановитьПараметрыУчетаНДС(ДокументОбъект, ПараметрыСоздания.ЦенаВключаетНДС);
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьДоговорСПоставщиком(ДокументОбъект);
	
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	
	УстановитьВидОперацииПоступленияДопРасходов(ДокументОбъект);
	УстановитьПараметрыОтраженияДокументаВУчете(ДокументОбъект);
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьПодразделениеДокумента(ДокументОбъект);
	УстановитьВалютуДокумента(ДокументОбъект);
	
	ЗаполнитьСчетаУчетаРасчетов(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьШапкуПоступленияДопРасходовПоТабличнойЧасти(ДокументОбъект, ТабличнаяЧастьЭД)
	
	Если Не ЗначениеЗаполнено(ТабличнаяЧастьЭД) Тогда
		Возврат;
	КонецЕсли;
	
	СуммаСНалогом = 0;
	СуммаНалога = 0;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Для Каждого СтрокаДанных Из ТабличнаяЧастьЭД Цикл
		
		СуммаСНалогом = СуммаСНалогом + ТипЧисло.ПривестиЗначение(СтрокаДанных.СуммаСНДС);
		СуммаНалога = СуммаНалога + ТипЧисло.ПривестиЗначение(СтрокаДанных.СуммаНДС);
		
	КонецЦикла;
	
	СуммаБезНалога = СуммаСНалогом - СуммаНалога;
	
	ПерваяСтрокаТЧ = ТабличнаяЧастьЭД[0];
	ДокументОбъект.СтавкаНДС = ПолучитьСтавкуНДСДиадок(ПерваяСтрокаТЧ.СтавкаНДС);
	ДокументОбъект.Содержание = ПерваяСтрокаТЧ.Наименование;
	ДокументОбъект.СуммаДокумента = СуммаСНалогом;
	ДокументОбъект.СуммаНДС = СуммаНалога;
	ДокументОбъект.Сумма = СуммаБезНалога;
	
	Если ДокументОбъект.СуммаВключаетНДС Тогда
		ДокументОбъект.Сумма = СуммаСНалогом;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуАктаСверкиВзаиморасчетов(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента, ИтогиТЧ)
	
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	
	УстановитьРеквизитыСверкиВзаиморасчетов(ДокументОбъект, РеквизитыЭлектронногоДокумента, ИтогиТЧ);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьАктаСверкиВзаиморасчетов(ДокументОбъект, ТабличнаяЧастьЭД)
	
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		
		ДоговорКонтрагента = ДоговорПоСтрокеАктаСверки(ДокументОбъект, СтрокаДоговора);
		
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ДокументОбъект.ПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.ДоговорКонтрагента = ДоговорКонтрагента;
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.Представление = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьРеквизитыСверкиВзаиморасчетов(ДокументОбъект, РеквизитыЭлектронногоДокумента, ИтогиТЧ)
	
	ДокументОбъект.ВалютаДокумента = ВалютаРегламентированногоУчета();
	ДокументОбъект.ОстатокНаНачало = ИтогиТЧ.СальдоНачДеб - ИтогиТЧ.СальдоНачКр;
	ДокументОбъект.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ДокументОбъект.СверкаСогласована = Ложь;
	
	ДокументОбъект.ДатаНачала = РеквизитыЭлектронногоДокумента.ДатаНачала;
	ДокументОбъект.Датаокончания = РеквизитыЭлектронногоДокумента.Датаокончания;
	
КонецПроцедуры

Функция ДоговорПоСтрокеАктаСверки(ДокументОбъект, ДанныеДоговора)
	
	Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	ВалютаДоговора = ДокументОбъект.ВалютаДокумента;
	Организация = ДокументОбъект.Организация;
	Контрагент = ДокументОбъект.Контрагент;
	НомерДоговора = ДанныеДоговора.Номер;
	ДатаДоговора = ДанныеДоговора.Дата;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДоговорПоСтрокеАктаСверки();
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Дата", ДатаДоговора);
	Запрос.УстановитьПараметр("Номер", НомерДоговора);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", ВалютаДоговора);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДоговорПоСтрокеАктаСверки()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТаблицаДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ТаблицаДоговорыКонтрагентов
	|ГДЕ
	|	ТаблицаДоговорыКонтрагентов.Организация = &Организация
	|	И ТаблицаДоговорыКонтрагентов.Владелец = &Контрагент
	|	И ТаблицаДоговорыКонтрагентов.Дата = &Дата
	|	И ТаблицаДоговорыКонтрагентов.Номер = &Номер
	|	И ТаблицаДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
	|	И НЕ ТаблицаДоговорыКонтрагентов.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыНоменклатурыИнформационнойБазы(Номенклатура)
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Услуга");
	ТребуемыеРеквизиты.Вставить("СтатьяЗатрат");
	ТребуемыеРеквизиты.Вставить("НоменклатурнаяГруппа");
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ТребуемыеРеквизиты);
	Иначе
		Результат = ТребуемыеРеквизиты;
		Результат.Услуга = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоНоменклатураУслуга(Номенклатура)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Услуга");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕдиницаИзмеренияПоКлассификатору(КодЕИ)
	
	Результат = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(КодЕИ);
	Возврат Результат;
	
КонецФункции

Функция ЕдиницаИзмеренияНоменклатуры(Номенклатура, КодЕИ)
	
	ЕдиницаПоОКЕИ = ЕдиницаИзмеренияПоКлассификатору(КодЕИ);
	
	Результат = Справочники.ЕдиницыИзмерения.НайтиПоРеквизиту(
		"ЕдиницаПоКлассификатору",
		ЕдиницаПоОКЕИ,
		Неопределено,
		Номенклатура
	);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПоДокументуОснованию(ДокументОбъект, ДокументОснование)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.Заполнить(ДокументОснование);
	
КонецПроцедуры

Процедура УстановитьОрганизациюДокумента(ДокументОбъект, Знач Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	ДокументОбъект.Организация = Организация;
	
КонецПроцедуры

Процедура УстановитьКонтрагентаДокумента(ДокументОбъект, Знач Контрагент)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = ПоставщикПоУмолчанию();
	КонецЕсли;
	
	ДокументОбъект.Контрагент = Контрагент;
	
КонецПроцедуры

Процедура УстановитьПодразделениеДокумента(ДокументОбъект)
	
	ДокументОбъект.Подразделение = ПодразделениеПоУмолчанию();
	
КонецПроцедуры

Процедура УстановитьСкладДокумента(ДокументОбъект)
	
	ДокументОбъект.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	ДокументОбъект.СкладОрдер = СкладПоУмолчанию();
	
КонецПроцедуры

Процедура УстановитьВидОперацииПоступленияДопРасходов(ДокументОбъект)
	
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеДопРасходов.УслугаСтороннейОрганизации;
	
КонецПроцедуры

Процедура УстановитьПараметрыОтраженияДокументаВУчете(ДокументОбъект)
	
	ДокументОбъект.ОтражатьВУправленческомУчете	= ОтражатьДокументыВУправленческомУчетеПоУмолчанию();
	ДокументОбъект.ОтражатьВБухгалтерскомУчете	= ОтражатьДокументыВБухгалтерскомУчетеПоУмолчанию();
	ДокументОбъект.ОтражатьВНалоговомУчете		= ОтражатьДокументыВНалоговомУчетеПоУмолчанию();
	
КонецПроцедуры

Процедура УстановитьВалютуДокумента(ДокументОбъект)
	
	ДокументОбъект.ВалютаДокумента = ВалютаРегламентированногоУчета();
	ДокументОбъект.КурсВзаиморасчетов = 1;
	ДокументОбъект.КратностьВзаиморасчетов = 1;
	
КонецПроцедуры

Процедура УстановитьОсновныеРеквизитыДокумента(ДокументОбъект)
	
	ДокументОбъект.Дата = ТекущаяДата();
	ДокументОбъект.Ответственный = ТекущийПользователь();
	
КонецПроцедуры

Процедура УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента)
	
	ДокументОбъект.ДатаВходящегоДокумента	= РеквизитыЭлектронногоДокумента.Дата;
	ДокументОбъект.НомерВходящегоДокумента	= РеквизитыЭлектронногоДокумента.Номер;
	
КонецПроцедуры

Процедура УстановитьРеквизитыИсправленияВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента)

	ДокументОбъект.НомерИсправления	= РеквизитыЭлектронногоДокумента.НомерИсправления;
	ДокументОбъект.ДатаИсправления	= РеквизитыЭлектронногоДокумента.ДатаИсправления;
	
	Если ЗначениеЗаполнено(ДокументОбъект.НомерИсправления)
		И ЗначениеЗаполнено(ДокументОбъект.ДатаИсправления) Тогда
		ДокументОбъект.Исправление = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьДоговорСПоставщиком(ДокументОбъект)
	
	ВидыДоговоров = Новый Массив;
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	УправлениеВзаиморасчетами.УстановитьДоговорКонтрагента(
		ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент,
		ДокументОбъект.Организация,
		ВидыДоговоров
	);
	
КонецПроцедуры

Процедура УстановитьТипЦенДокумента(ДокументОбъект)
	
	Если НЕ ЕстьРеквизитМетаданных(ДокументОбъект.Метаданные(), "ДоговорКонтрагента") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.ДоговорКонтрагента) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДокументОбъект.ДоговорКонтрагента, "ТипЦен");
	
КонецПроцедуры

Процедура УстановитьПараметрыУчетаНДС(ДокументОбъект, ЦенаВключаетНДС)
	
	ДокументОбъект.УчитыватьНДС = Истина;
	ДокументОбъект.СуммаВключаетНДС = ЦенаВключаетНДС;
	
КонецПроцедуры

Процедура УстановитьВидПоступленияПокупка(ДокументОбъект)
	
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
	
КонецПроцедуры

Процедура УстановитьВидКорректировкиСогласованноеИзменение(ДокументОбъект)
	
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
	
КонецПроцедуры

Процедура ПроверитьЗаполнитьОснованиеКорректировкиПоступления(ПараметрыСоздания, ШапкаЭД, ФорматЭД)
	
	Если ЗначениеЗаполнено(ПараметрыСоздания.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ФорматыЭД = МодульФорматыЭлектронныхДокументов();
	
	ТипыОснований = Новый Массив;
	
	Если ФорматыЭД.ЭтоУниверсальныйКорректировочныйДокумент(ФорматЭД)
		Или ФорматыЭД.ЭтоКорректировочныйСчетФактура(ФорматЭД) Тогда
		
		ТипыОснований.Добавить("СчетФактураПолученный");
		
	ИначеЕсли ФорматыЭД.ЭтоСоглашениеОбИзмененииСтоимости(ФорматЭД) Тогда
		
		ТипыОснований.Добавить("ПоступлениеТоваровУслуг");
		ТипыОснований.Добавить("ПоступлениеДопРасходов");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипыОснований) Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ПараметрыСоздания.Организация;
	Контрагент = ПараметрыСоздания.Контрагент;
	НомерЭД = ШапкаЭД.Номер;
	ДатаЭД = ШапкаЭД.Дата;
	
	Для Каждого ВидДокумента Из ТипыОснований Цикл
		
		СсылкаНаОбъект = НайтиДокументПоРеквизитам(
			ВидДокумента,
			Организация,
			Контрагент,
			ДатаЭД,
			НомерЭД
		);
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			
			Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СсылкаНаОбъект = СсылкаНаОбъект.ДокументОснование;
			КонецЕсли;
			
			ПараметрыСоздания.ДокументОснование = СсылкаНаОбъект;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиДокументПоРеквизитам(ВидДокумента, Организация, Контрагент, ДатаВходящегоДокумента, НомерВходящегоДокумента)
	
	ШаблонЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Дата КАК Дата
	|ИЗ
	|	&ПолноеИмяТаблицы КАК Таблица
	|ГДЕ
	|	НЕ Таблица.ПометкаУдаления
	|	И Таблица.Организация = &Организация
	|	И Таблица.Контрагент = &Контрагент
	|	И Таблица.ДатаВходящегоДокумента = &ДатаДокумента
	|	И Таблица.НомерВходящегоДокумента = &НомерДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	ПолноеИмяТаблицы = "Документ." + ВидДокумента;
	ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаВходящегоДокумента);
	Запрос.УстановитьПараметр("НомерДокумента", НомерВходящегоДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

