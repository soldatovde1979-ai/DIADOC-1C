// Получает ссылку на документ, на который оформлена корректировка.
//
// Параметры:
//  КорректировочныйДокумент - ЛюбаяСсылка - Корректировочный документ (корректировка реализации или корректировочный счет-фактура)
// 
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка на корректируемый документ.
//
Функция КорректируемыйДокумент(КорректировочныйДокумент) Экспорт
	
	ТипДокумента = ТипЗнч(КорректировочныйДокумент);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ИмяРеквизита = "ИсправляемыйСчетФактура";
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КорректировочныйДокумент, ИмяРеквизита);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ИмяРеквизита = "ИсправляемыйДокументРеализации";
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КорректировочныйДокумент, ИмяРеквизита);
		
	Иначе
		
		КонтекстПроверки = "ИнтеграционныйМодуль.КорректируемыйДокумент";
		ПараметрИмя = "КорректировочныйДокумент";
		ПараметрПредставление = Строка(КорректировочныйДокумент);
		Если КорректировочныйДокумент = Неопределено Тогда
			ПараметрПредставление = "Неопределено";
		КонецЕсли;
		
		Ошибка = ОсновнойМодуль.ПодставитьПараметрыВСтроку(
			"Недопустимое значение параметра %1 (передано значение: %2) в %3",
			ПараметрИмя,
			ПараметрПредставление,
			КонтекстПроверки
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

