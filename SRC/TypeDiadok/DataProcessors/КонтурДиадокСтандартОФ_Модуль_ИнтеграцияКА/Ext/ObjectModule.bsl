Функция ПолучитьНоменклатуруИнформационнойБазы(Владелец, ИдентификаторНоменклатуры)
	
	ТаблицаСопоставленияНоменклатуры = ПолучитьТаблицуСопоставленияИзХранилища(Владелец);
	
	СтрокаПоиска = ТаблицаСопоставленияНоменклатуры.Найти(ИдентификаторНоменклатуры, "Идентификатор");
	
	Если НЕ СтрокаПоиска = Неопределено
		И НЕ ОбщегоНазначения.СсылкаСуществует(СтрокаПоиска.Номенклатура) Тогда
		ТаблицаСопоставленияНоменклатуры.Удалить(СтрокаПоиска);
		СтрокаПоиска = Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Если НЕ СтрокаПоиска = Неопределено Тогда
		
		Результат = НоваяНоменклатураИнформационнойБазы(
				СтрокаПоиска.Номенклатура,
				СтрокаПоиска.Характеристика,
				СтрокаПоиска.Упаковка
			);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСопоставлениеНоменклатуры(НоменклатураКонтрагента, Номенклатура, Характеристика)
	
	Владелец = НоменклатураКонтрагента.Владелец;
	
	ТаблицаСопоставленияНоменклатуры = ПолучитьТаблицуСопоставленияИзХранилища(Владелец);
	Идентификатор = НоменклатураКонтрагента.Идентификатор;
	
	СтрокаТаблицы = ТаблицаСопоставленияНоменклатуры.Найти(Идентификатор, "Идентификатор");
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = ТаблицаСопоставленияНоменклатуры.Добавить();
	КонецЕсли;
	
	СтрокаТаблицы.Идентификатор = Идентификатор;
	СтрокаТаблицы.Номенклатура = Номенклатура;
	СтрокаТаблицы.Характеристика = Характеристика;
	
	ЗаписатьСопоставлениеНоменклатурыВХранилище(Владелец, ТаблицаСопоставленияНоменклатуры);
	
КонецПроцедуры

Процедура ЗаписатьСопоставлениеНоменклатурыВХранилище(Владелец, ТаблицаСопоставленияНоменклатуры)
	
	ХранилищеСопоставления = НайтиСоздатьХранилищеСопоставленияНоменклатуры(Владелец);
	
	ХранилищеСопоставленияОбъект = ХранилищеСопоставления.ПолучитьОбъект();
	ХранилищеСопоставленияОбъект.Хранилище = Новый ХранилищеЗначения(ТаблицаСопоставленияНоменклатуры);
	ХранилищеСопоставленияОбъект.Записать();
	
КонецПроцедуры

Функция ПолучитьТаблицуСопоставленияИзХранилища(Владелец)
	
	ХранилищеСопоставления = НайтиСоздатьХранилищеСопоставленияНоменклатуры(Владелец);
	ТаблицаСопоставленияНоменклатуры = ХранилищеСопоставления.Хранилище.Получить();
	
	Если НЕ ЗначениеЗаполнено(ТаблицаСопоставленияНоменклатуры) Тогда
		ТаблицаСопоставленияНоменклатуры = Контракт_ХранениеТаблицыСопоставленияНоменклатуры();
	КонецЕсли;
	
	Если НЕ ТипЗнч(ТаблицаСопоставленияНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		ШаблонОшибки = "Не удалось прочитать файл сопоставления номенклатуры по контрагенту """"%1"""". 
			|Подробности см. в журнале регистрации.";
		
		ТекстОшибки = СтрЗаменить(ШаблонОшибки, "%1", СокрЛП(Владелец));
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат ТаблицаСопоставленияНоменклатуры;
	
КонецФункции

Функция Контракт_ХранениеТаблицыСопоставленияНоменклатуры()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Упаковка");
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьСопоставлениеНоменклатуры_НоменклатураКонтрагентов(Владелец, ИдентификаторНоменклатуры)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.НоменклатураКонтрагентов КАК Т
		|ГДЕ
		|	Т.Контрагент = &Владелец
		|	И Т.Идентификатор = &Идентификатор";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерТаблицы = РегистрыСведений.НоменклатураКонтрагентов;
	
	Пока Выборка.Следующий() Цикл
		Запись = МенеджерТаблицы.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьОшибкуСопоставленияНоменклатуры(ИдентификаторНоменклатуры, ПредставлениеВладельца, Ошибка)
	
	ПодробностиОшибки = ПодробноеПредставлениеОшибки(Ошибка);
	
	ТекстОшибки = "Не удалось записать сопоставление номенклатуры (Идентификатор = %1, контрагент = %2)";
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", ИдентификаторНоменклатуры);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%2", ПредставлениеВладельца);
	ТекстОшибки = ТекстОшибки + Символы.ПС + ПодробностиОшибки;
	
	ЗаписьЖурналаРегистрации(
		"Диадок.Сопоставление номенклатуры",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.РегистрыСведений.НоменклатураКонтрагентов,
		Неопределено,
		ТекстОшибки
	);
	
КонецПроцедуры

Функция НайтиСоздатьХранилищеСопоставленияНоменклатуры(Контрагент)
	
	Наименование = НаименованиеСлужебногоХранилищаСопоставления();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ХранилищеДополнительнойИнформации КАК Т
		|ГДЕ
		|	Т.Объект = &Объект
		|	И НЕ Т.ПометкаУдаления
		|	И Т.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Объект", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Результат = ВыборкаДетальныеЗаписи.Ссылка;
		
	Иначе
		
		НовыйОбъект = Справочники.ХранилищеДополнительнойИнформации.СоздатьЭлемент();
		НовыйОбъект.ВидДанных = Перечисления.ВидыДополнительнойИнформацииОбъектов.Файл;
		НовыйОбъект.Объект = Контрагент;
		НовыйОбъект.ИмяФайла = Контрагент;
		НовыйОбъект.Наименование = Наименование;
		НовыйОбъект.Записать();
		
		Результат = НовыйОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеСлужебногоХранилищаСопоставления()
	Возврат "Диадок_СопоставлениеНоменклатуры";
КонецФункции

// Получает сопоставление номенклатуры из устаревшего хранилища и переносит в актуальное.
//
// Параметры:
//  ВладелецНоменклатуры - СправочникСсылка.Контрагенты - контрагент-владелец номенклатуры;
//  ИдентификаторНоменклатуры - Строка - идентификатор номенклатуры контрагента;
// 
// Возвращаемое значение:
//  Структура - номенклатура информационной базы (сведения из устаревшего хранилища);
//  Неопределено - если сопоставление не найдено.
//
Функция ПеренестиСопоставлениеНоменклатуры_НоменклатураКонтрагентов(ВладелецНоменклатуры, ИдентификаторНоменклатуры)
	
	НоменклатураИБ = ПолучитьНоменклатуруИнформационнойБазы_НоменклатураКонтрагентов(
			ВладелецНоменклатуры,
			ИдентификаторНоменклатуры);
	
	Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
		
		КлючевыеПоля = Новый Структура;
		КлючевыеПоля.Вставить("Владелец", ВладелецНоменклатуры);
		КлючевыеПоля.Вставить("Идентификатор", ИдентификаторНоменклатуры);
		
		ДобавитьСопоставлениеНоменклатуры(
			КлючевыеПоля,
			НоменклатураИБ.Номенклатура,
			НоменклатураИБ.Характеристика
		);
		
	КонецЕсли;
	
	Возврат НоменклатураИБ;
	
КонецФункции

Функция ПолучитьНоменклатуруИнформационнойБазы_НоменклатураКонтрагентов(Владелец, ИдентификаторНоменклатуры)
	
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.ХарактеристикаНоменклатуры КАК Характеристика,
		|	НЕОПРЕДЕЛЕНО КАК Упаковка
		|ИЗ
		|	РегистрСведений.НоменклатураКонтрагентов КАК Т
		|ГДЕ
		|	Т.Контрагент = &Владелец
		|	И Т.Идентификатор = &Идентификатор";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	
	Если Выборка.Следующий() Тогда
		
		Результат = НоваяНоменклатураИнформационнойБазы(
				Выборка.Номенклатура,
				Выборка.Характеристика,
				Выборка.Упаковка
			);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСопоставлениеНоменклатуры_НоменклатураКонтрагентов(НоменклатураКонтрагента, Номенклатура, Характеристика)
	
	НовыйОбъект = РегистрыСведений.НоменклатураКонтрагентов.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(НовыйОбъект, НоменклатураКонтрагента);
	
	НовыйОбъект.Контрагент = НоменклатураКонтрагента.Владелец;
	НовыйОбъект.КодНоменклатурыКонтрагента = НоменклатураКонтрагента.Код;
	НовыйОбъект.АртикулНоменклатурыКонтрагента = НоменклатураКонтрагента.Артикул;
	НовыйОбъект.НаименованиеНоменклатурыКонтрагента = НоменклатураКонтрагента.Наименование;
	
	НовыйОбъект.Номенклатура = Номенклатура;
	НовыйОбъект.ХарактеристикаНоменклатуры = Характеристика;
	
	НовыйОбъект.Записать(Истина);
	
КонецПроцедуры

Функция НоваяНоменклатураИнформационнойБазы(Номенклатура, Характеристика = Неопределено, Упаковка = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Номенклатура);
	Результат.Вставить("Характеристика");
	Результат.Вставить("Упаковка");
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Результат.Характеристика = Характеристика;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Результат.Упаковка = Упаковка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

