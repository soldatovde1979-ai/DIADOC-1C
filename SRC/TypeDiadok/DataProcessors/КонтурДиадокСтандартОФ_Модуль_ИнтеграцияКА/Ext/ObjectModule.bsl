Функция ПолучитьВидОперацииРТУ(Док) 
	Если  ПроверитьТипДокумента(Док, "РеализацияТоваровУслуг") Тогда 
		Возврат Док.ВидОперации
	ИначеЕсли ПроверитьТипДокумента(Док, "РеализацияОтгруженныхТоваров") Тогда 
		Возврат Док.ДокументОснование.ВидОперации
	ИначеЕсли 	ПроверитьТипДокумента(Док, "КорректировкаРеализации") Тогда 
		Возврат ПолучитьВидОперацииРТУ(Док.ДокументРеализации)
	Иначе 
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции 

Функция ПолучитьТипДокумента(Док, ТаблицаНастроекПечати, ЭтоСчет, ФункцияУПД) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ФункцияУПД) Тогда
		
		Результат = ОсновнойМодуль.ТипДокументаУПД(ФункцияУПД);
		Если ЗначениеЗаполнено(Результат) Тогда
			Возврат Результат;
		Иначе
			
			Результат = ОсновнойМодуль.ТипДокументаУКД(ФункцияУПД);
			Если ЗначениеЗаполнено(Результат) Тогда
				Возврат Результат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(Док);
	Если ЭтоСчет Или ТипДокумента = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		
		Результат = "Счет на оплату";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ЭтоКСФ = Строка(Док.ВидСчетаФактуры) = "Корректировочный";
		ЭтоИсправление = Док.Метаданные().Реквизиты.Найти("Исправление") <> Неопределено И Док.Исправление;
		
		Если ЭтоКСФ Тогда
			Результат = ?(ЭтоИсправление, "Исправление КСФ", "Корректировочный СФ");
		Иначе
			Результат = ?(ЭтоИсправление, "Исправление СФ", "Счет-фактура");
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		
		Результат = "Акт сверки";
		
	Иначе
		
		ПараметрыОтбора = Новый Структура("Организация", Док.Организация);
		СтрокиНастроек = ТаблицаНастроекПечати.НайтиСтроки(ПараметрыОтбора);
		ЕстьНастройкиПечати = СтрокиНастроек.Количество() > 0;
		Если ЕстьНастройкиПечати Тогда
			НастройкиПечати = СтрокиНастроек[0];
		КонецЕсли;
		
		Если ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			
			Если ЕстьНастройкиПечати И ЗначениеЗаполнено(НастройкиПечати.ПечатнаяФормаДляТоваров) Тогда
				Результат = НастройкиПечати.ПечатнаяФормаДляТоваров;
			Иначе
				Результат = "Торг-12";
			КонецЕсли;
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипДокумента = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров")
			Или ПроверитьТипДокумента(Док, "КорректировкаРеализации") Тогда
			
			РНК = ?(ТипДокумента = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров"), Док.ДокументОтгрузки, Док);
			СтрокиНастроек = ТаблицаНастроекПечати.НайтиСтроки(Новый Структура("Организация", РНК.Организация));
			Если СтрокиНастроек.Количество() = 0 Тогда
				ФормаДляУслуг = "Акт";
				ФормаДляТоваров = "Торг-12";
			Иначе 
				
				НастройкиПечати = СтрокиНастроек[0];
				ФормаДляТоваров = ?(ЗначениеЗаполнено(НастройкиПечати.ПечатнаяФормаДляТоваров), НастройкиПечати.ПечатнаяФормаДляТоваров, "Торг-12");
				ФормаДляУслуг = ?(ЗначениеЗаполнено(НастройкиПечати.ПечатнаяФормаДляУслуг), НастройкиПечати.ПечатнаяФормаДляУслуг, "Акт");
				
				//хитрая ситуация "в зависимости от вида операции"
				Если ПечатнаяФормаВЗависимостиОтВидаОперации(ФормаДляУслуг) Тогда 
					ВидОперации = ПолучитьВидОперацииРТУ(Док);
					ФормаДляУслуг = ?(ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.АктВыполненныхРабот , "Акт", "Торг-12");
				КонецЕсли;
				
			КонецЕсли;
			
			ТолькоУслуги = РНК.Товары.Количество() = 0 И РНК.Услуги.Количество() > 0;
			Результат = ?(ТолькоУслуги, ФормаДляУслуг, ФормаДляТоваров);
			
		ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг")
			Или ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПоПереработке")
			Или ТипДокумента = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда 
			
			Если ЕстьНастройкиПечати
				И ЗначениеЗаполнено(НастройкиПечати.ПечатнаяФормаДляУслуг)
				И Не ПечатнаяФормаВЗависимостиОтВидаОперации(НастройкиПечати.ПечатнаяФормаДляУслуг) Тогда
				
				Результат = НастройкиПечати.ПечатнаяФормаДляУслуг;
				
			Иначе
				Результат = "Акт";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПечатнаяФормаВЗависимостиОтВидаОперации(ПечатнаяФорма)
	
	Результат = ПечатнаяФорма = "В зависимости от вида операции";
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыСФ(Док) Экспорт
	
	Результат = Неопределено;
	
	УчетНДС.ПолучитьПараметрыСчетаФактуры(Док, ПолучитьВалютуРегламентированногоУчета(), Результат);
	
	Если Не ЗначениеЗаполнено(Результат.СуммаНДСДокумента) Тогда
		Результат.СуммаНДСДокумента = Док.СуммаНДСДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//{ Подготовка временных таблиц для списка отправки документов...

Функция ПодготовитьВТ_СпискаОтправкиДокументов(ТипыДокументов, Запрос) Экспорт
	
	МассивВременныхТаблиц= Новый Массив;
	
	Если ТипыДокументов = 0 ИЛИ ТипыДокументов = 1 ИЛИ ТипыДокументов = 2 ИЛИ ТипыДокументов = 5 ИЛИ ТипыДокументов = 6 Тогда
		ПодготовитьВТ_СЧФ_Основная(Запрос, МассивВременныхТаблиц);
		ПодготовитьВТ_УПД_СЧФДОП(Запрос, МассивВременныхТаблиц, ТипыДокументов);
		ПодготовитьВТ_УКД_КСЧФДИС(Запрос, МассивВременныхТаблиц, ТипыДокументов);
	КонецЕсли;
	
	Если ТипыДокументов = 0 ИЛИ ТипыДокументов = 1 Тогда
		ПодготовитьВТ_Накладные(Запрос, МассивВременныхТаблиц, ТипыДокументов);
	КонецЕсли;
	
	Если ТипыДокументов = 0 ИЛИ ТипыДокументов = 2 Тогда
		ПодготовитьВТ_СчетаФактуры(Запрос, МассивВременныхТаблиц, ТипыДокументов);
	КонецЕсли;
	
	Если ТипыДокументов = 0 ИЛИ ТипыДокументов = 3 Тогда
		ПодготовитьВТ_СчетаНаОплату(Запрос, МассивВременныхТаблиц);
	КонецЕсли;
	
	Если ТипыДокументов = 0 ИЛИ ТипыДокументов = 4 Тогда
		ПодготовитьВТ_АктыСверки(Запрос, МассивВременныхТаблиц);
	КонецЕсли;
	
	Возврат МассивВременныхТаблиц;
	
КонецФункции


Процедура ПодготовитьВТ_СЧФ_Основная(Запрос, МассивВременныхТаблиц)
	
