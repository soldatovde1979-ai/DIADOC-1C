КонецФункции

Функция ЭтоСчетФактуранаАванс(СФ) Экспорт
	Возврат ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").ЭтоСчетФактуранаАванс(СФ);
КонецФункции	

Функция ПолучитьСуммуДокументаВВалютеРегламентированногоУчета_Диадок(ДокументСсылка) Экспорт 
	
	Если УчетНДС.ПолучитьУПУпрощенныйУчетНДС(ДокументСсылка.Организация, ДокументСсылка.Дата) Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(НДСЗаписиКнигиПродажОбороты.СуммаБезНДСОборот, 0) + ЕСТЬNULL(НДСЗаписиКнигиПродажОбороты.НДСОборот, 0)) КАК СуммаВзаиморасчетов
		|ИЗ
		|	РегистрНакопления.НДСЗаписиКнигиПродаж.Обороты(, , Регистратор, СчетФактура = &Ссылка) КАК НДСЗаписиКнигиПродажОбороты
		|ГДЕ
		|	НДСЗаписиКнигиПродажОбороты.Регистратор = &Ссылка";
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ХозрасчетныйОборотыДтКт.СуммаОборот, 0) КАК СуммаВзаиморасчетов
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(, , Регистратор, , , , , ) КАК ХозрасчетныйОборотыДтКт
		|ГДЕ
		|	ХозрасчетныйОборотыДтКт.Регистратор = &Ссылка
		|	И ХозрасчетныйОборотыДтКт.Регистратор.СчетУчетаРасчетовПоПретензиям = ХозрасчетныйОборотыДтКт.СчетДт";	
		
	ИначеЕсли  ДокументСсылка.Метаданные().Имя = "РеализацияТоваровУслуг"
		ИЛИ (НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("ОтражатьВБухгалтерскомУчете") = Неопределено
				И ДокументСсылка.ОтражатьВБухгалтерскомУчете = Ложь) Тогда
				
		ЗапросКурсАванса = Новый Запрос;
		ЗапросКурсАванса.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		ЗапросКурсАванса.Текст =
		"ВЫБРАТЬ
		|	Док.СуммаВзаиморасчетов,
		|	Док.СуммаРегл
		|ИЗ 
		|	Документ.РеализацияТоваровУслуг.ДокументыРасчетовСКонтрагентом КАК Док
		|ГДЕ Док.Ссылка = &ДокументСсылка
		|ИТОГИ СУММА(СуммаВзаиморасчетов), СУММА(СуммаРегл) ПО ОБЩИЕ";
		
		Выборка = ЗапросКурсАванса.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если Выборка.Следующий() Тогда
			ВыборкаСуммаВзаиморасчетов = Выборка.СуммаВзаиморасчетов;
			ВыборкаСуммаРегл           = Выборка.СуммаРегл;
		Иначе
			ВыборкаСуммаВзаиморасчетов = 0;
			ВыборкаСуммаРегл           = 0;
		КонецЕсли;
		
		СуммаВзаиморасчетов = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(УчетНДС.ПолучитьСуммуДокументаСНДС(ДокументСсылка),
																			  ДокументСсылка.ВалютаДокумента, ДокументСсылка.ДоговорКонтрагента.ВалютаВзаиморасчетов,
																			  ЗаполнениеДокументов.КурсДокумента(ДокументСсылка, ПолучитьВалютуРегламентированногоУчета()), ДокументСсылка.КурсВзаиморасчетов,
																			  ЗаполнениеДокументов.КратностьДокумента(ДокументСсылка, ПолучитьВалютуРегламентированногоУчета()), ДокументСсылка.КратностьВзаиморасчетов);
		НеоплаченнаяСумма = СуммаВзаиморасчетов - ВыборкаСуммаВзаиморасчетов;
		
		НеоплаченнаяСуммаРегл = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(НеоплаченнаяСумма,
																				ДокументСсылка.ДоговорКонтрагента.ВалютаВзаиморасчетов, ПолучитьВалютуРегламентированногоУчета(),
																				ДокументСсылка.КурсВзаиморасчетов, 1,
																				ДокументСсылка.КратностьВзаиморасчетов, 1);
															
		Возврат ВыборкаСуммаРегл + НеоплаченнаяСуммаРегл;
		
	ИначеЕсли НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("СчетУчетаРасчетовСКонтрагентом") = Неопределено Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.СуммаВзаиморасчетов, 0)) КАК СуммаВзаиморасчетов,
		|	СУММА(ЕСТЬNULL(РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.СуммаРегл, 0)) КАК СуммаРегл
		|ПОМЕСТИТЬ Предоплата
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.ДокументыРасчетовСКонтрагентом КАК РеализацияТоваровУслугДокументыРасчетовСКонтрагентом
		|ГДЕ
		|	РеализацияТоваровУслугДокументыРасчетовСКонтрагентом.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА РеализацияТоваровУслуг.ВалютаДокумента = &ВалютаРегл
		|				ТОГДА РеализацияТоваровУслуг.СуммаДокумента
		|			КОГДА НЕ РеализацияТоваровУслуг.КратностьВзаиморасчетов = 0
		|				ТОГДА (РеализацияТоваровУслуг.СуммаДокумента - ЕСТЬNULL(Предоплата.СуммаВзаиморасчетов, 0)) * РеализацияТоваровУслуг.КурсВзаиморасчетов / РеализацияТоваровУслуг.КратностьВзаиморасчетов + ЕСТЬNULL(Предоплата.СуммаРегл, 0)
		|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК СуммаВзаиморасчетов
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
		|	Предоплата КАК Предоплата
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка = &Ссылка";
		
	Иначе
		Возврат 0;	
	КонецЕсли;
				
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаРегл", ПолучитьВалютуРегламентированногоУчета());
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаВзаиморасчетов;
	Иначе
		Возврат 0; 
	КонецЕсли;
	
КонецФункции

Процедура ПерезаполнитьСуммыПоУЕвРублях(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки) Экспорт 
	
	Если ДанныеШапки.Свойство("СчетФактура") Тогда
		
		ДанныеШапки.Вставить("ТабличнаяЧасть", ТабличнаяЧасть);
		ПересчетВалюты_УПД(ДанныеШапки.СчетФактура, ТекущееОснование, ДанныеШапки);
		
	ИначеЕсли ТипЗнч(ТекущееОснование) = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда
		
		ПересчетВалюты_Акт(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки, "АктОбОказанииПроизводственныхУслуг");
		
	ИначеЕсли ТипЗнч(ТекущееОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда 
		
		ПересчетВалюты_ВозвратТоваровПоставщику(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки);
		
	ИначеЕсли ТипЗнч(ТекущееОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
		
		ПересчетВалюты_РеализацияТоваровУслуг(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересчетВалюты_Акт(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки, ИмяДокумента)
	
	//1. Рассчитываем по курсу документа
	Курс		= ТекущееОснование.КурсВзаиморасчетов;
	Кратность	= ТекущееОснование.КратностьВзаиморасчетов;
	
	ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность);	
	
	//2. Считаем сумму в рублях с учетом аванса и распределяем
	СтруктураДляПересчета = ПересчетВалюты_СтруктураДляПересчетаСУчетомАванса(ТекущееОснование, "АктОбОказанииПроизводственныхУслуг");
	СуммаРегл = СтруктураДляПересчета.СуммаРегл;
	
	ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаРегл);
	
	ДанныеШапки.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	
КонецПроцедуры	

Процедура ПересчетВалюты_ВозвратТоваровПоставщику(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки)
	
	Курс		= ТекущееОснование.КурсВзаиморасчетов;
	Кратность	= ТекущееОснование.КратностьВзаиморасчетов;
	
	ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность);	
	
	ДанныеШапки.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	
КонецПроцедуры

Процедура ПересчетВалюты_РеализацияТоваровУслуг(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки)
	
	//1. Рассчитываем по курсу документа
	Курс		= ТекущееОснование.КурсВзаиморасчетов;
	Кратность	= ТекущееОснование.КратностьВзаиморасчетов;
	
	ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность);	
	
	//2. Считаем сумму в рублях с учетом аванса и распределяем
	СтруктураДляПересчета = ПересчетВалюты_СтруктураДляПересчетаСУчетомАванса(ТекущееОснование, "РеализацияТоваровУслуг");
	СуммаРегл = СтруктураДляПересчета.СуммаРегл;
	
	ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаРегл);
	
	ДанныеШапки.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	
КонецПроцедуры

Процедура ПересчетВалюты_УПД(СчетФактура, ТекущееОснование, ДанныеШапки)
	
	ТабличнаяЧасть		= ДанныеШапки.ТабличнаяЧасть;
	СуммаВзаиморасчетов = УчетНДСФормированиеДвижений.ПолучитьСуммуВзаиморасчетов(СчетФактура, ТекущееОснование, ДанныеШапки);
	
	ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаВзаиморасчетов);
	
КонецПроцедуры

Функция ПересчетВалюты_СтруктураДляПересчетаСУчетомАванса(Ссылка, ИмяДокумента)
	
	ЗапросКурсАванса = Новый Запрос;
	ЗапросКурсАванса.УстановитьПараметр("ТекущийДокумент", Ссылка);
	ЗапросКурсАванса.Текст =
	"ВЫБРАТЬ
	|	Док.СуммаВзаиморасчетов КАК СуммаВзаиморасчетов,
	|	Док.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	Документ." + ИмяДокумента + ".ДокументыРасчетовСКонтрагентом КАК Док
	|ГДЕ
	|	Док.Ссылка = &ТекущийДокумент
	|ИТОГИ
	|	СУММА(СуммаВзаиморасчетов),
	|	СУММА(СуммаРегл)
	|ПО
	|	ОБЩИЕ";
	
	Выборка = ЗапросКурсАванса.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если Выборка.Следующий() Тогда
		КурсОплаты                 = ?(Выборка.СуммаВзаиморасчетов = 0, 0, Выборка.СуммаРегл / Выборка.СуммаВзаиморасчетов);
		ВыборкаСуммаВзаиморасчетов = Выборка.СуммаВзаиморасчетов;
		ВыборкаСуммаРегл           = Выборка.СуммаРегл;
	Иначе
		КурсОплаты                 = 0;
		ВыборкаСуммаВзаиморасчетов = 0;
		ВыборкаСуммаРегл           = 0;
	КонецЕсли;
	
	СуммаВзаиморасчетов = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(УчетНДС.ПолучитьСуммуДокументаСНДС(Ссылка),
																			Ссылка.ВалютаДокумента, Ссылка.ДоговорКонтрагента.ВалютаВзаиморасчетов,
																			ЗаполнениеДокументов.КурсДокумента(Ссылка, ПолучитьВалютуРегламентированногоУчета()), Ссылка.КурсВзаиморасчетов,
																			ЗаполнениеДокументов.КратностьДокумента(Ссылка, ПолучитьВалютуРегламентированногоУчета()), Ссылка.КратностьВзаиморасчетов);
	НеоплаченнаяСумма = СуммаВзаиморасчетов - ВыборкаСуммаВзаиморасчетов;
	Если НеоплаченнаяСумма > 0 Тогда
		КурсДляПечати = (НеоплаченнаяСумма * Ссылка.КурсВзаиморасчетов + ВыборкаСуммаРегл)/(НеоплаченнаяСумма + ВыборкаСуммаВзаиморасчетов);
	Иначе
		КурсДляПечати = КурсОплаты;
	КонецЕсли;
	
	НеоплаченнаяСуммаРегл = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(НеоплаченнаяСумма,
																			Ссылка.ДоговорКонтрагента.ВалютаВзаиморасчетов, ПолучитьВалютуРегламентированногоУчета(),
																			Ссылка.КурсВзаиморасчетов, 1,
																			Ссылка.КратностьВзаиморасчетов, 1);
	
	СуммаРегл = ВыборкаСуммаРегл + НеоплаченнаяСуммаРегл;
	
	СтруктураДляПересчета = Новый Структура;
	
	Если КурсДляПечати = 0 Тогда
		СтруктураДляПересчета.Вставить("Курс",		Ссылка.КурсВзаиморасчетов);
		СтруктураДляПересчета.Вставить("Кратность",	?(Ссылка.КратностьВзаиморасчетов = 0, 1, Ссылка.КратностьВзаиморасчетов));
		СтруктураДляПересчета.Вставить("СуммаРегл",	СуммаРегл);
	Иначе
		СтруктураДляПересчета.Вставить("Курс",		КурсДляПечати);
		СтруктураДляПересчета.Вставить("Кратность",	1);
		СтруктураДляПересчета.Вставить("СуммаРегл",	СуммаРегл);
	КонецЕсли;
	
	Возврат СтруктураДляПересчета;
	
КонецФункции	

Процедура ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность)
	
	Для Каждого ТекСтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Сумма		= ТекСтрокаТЧ.Сумма * Курс / Кратность;
		СуммаНДС	= ТекСтрокаТЧ.СуммаНДС * Курс / Кратность;
		
		ТекСтрокаТЧ.Сумма		= Окр(Сумма, 2);
		ТекСтрокаТЧ.СуммаНДС	= Окр(СуммаНДС, 2);
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаРегл)
	
	РасчетСуммыНДСПоСтавке	= УчетНДС.РасчетНДСвРубляхПоСтавкеДокумента(ДанныеШапки.Дата);
	
	Если СуммаРегл <> 0 Тогда
		
		ТабличнаяЧасть.Колонки.Добавить("СуммаБезНДС");
		ТабличнаяЧасть.Колонки.Добавить("СуммаРублевая");
		
		//1. Распределяем сумму регл пропорционально Сумме с НДС
		МассивРаспределения = Новый Массив;
		
		Для Каждого СтрокаТовар Из ТабличнаяЧасть Цикл
			
			СуммаСНДС	= СтрокаТовар.Сумма + ?(ДанныеШапки.СуммаВключаетНДС, 0, СтрокаТовар.СуммаНДС);
			СуммаБезНДС	= СуммаСНДС - СтрокаТовар.СуммаНДС;
			
			СтрокаТовар.СуммаБезНДС = СуммаБезНДС;
			
			МассивРаспределения.Добавить(СуммаСНДС);
			
		КонецЦикла;
		
		УчетНДС.РаспределитьСуммуПоСтолбцу(МассивРаспределения, СуммаРегл, ТабличнаяЧасть, "СуммаРублевая");
		
		//2. Пересчитываем СуммаНДС и Сумму
		Для Каждого СтрокаТовар Из ТабличнаяЧасть Цикл
			
			Если РасчетСуммыНДСПоСтавке Тогда
				
				ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(СтрокаТовар.СтавкаНДС);
				
				СтрокаТовар.СуммаНДС	= ?(ЗначениеСтавкиНДС = 0, 0, Окр(СтрокаТовар.СуммаРублевая * ЗначениеСтавкиНДС / (100 + ЗначениеСтавкиНДС), 2));
				СтрокаТовар.Сумма		= СтрокаТовар.СуммаРублевая - СтрокаТовар.СуммаНДС;
				
			Иначе
				
				МассивРаспределения.Очистить();
				МассивРаспределения.Добавить(СтрокаТовар.СуммаБезНДС);
				МассивРаспределения.Добавить(СтрокаТовар.СуммаНДС);
				
				МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьПропорционально(СтрокаТовар.СуммаРублевая, МассивРаспределения);
				
				Если МассивРаспределенныхСумм <> Неопределено Тогда
					СтрокаТовар.Сумма		= МассивРаспределенныхСумм[0];
					СтрокаТовар.СуммаНДС	= МассивРаспределенныхСумм[1];
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДанныеШапки.СуммаВключаетНДС Тогда
				СтрокаТовар.Сумма = СтрокаТовар.Сумма + СтрокаТовар.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

