#Область ОписаниеПеременных

&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшНаКлиенте;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Открывает основную форму библиотеки плагинов.
//
// Параметры:
//  КонтекстИлиВызвающийМодуль - Структура, ФормаКлиентскогоПриложения - см. НовыйКонтекстВызывающегоМодуля
//  ПараметрВладелец - ФормаКлиентскогоПриложения - форма или элемент управления другой формы.
//
&НаКлиенте
Процедура ОткрытьОсновнуюФорму(КонтекстИлиВызвающийМодуль, ПараметрВладелец) Экспорт
	
	Если ТипЗнч(КонтекстИлиВызвающийМодуль) = Тип("Структура") Тогда
		Контекст = КонтекстИлиВызвающийМодуль;
	Иначе
		Контекст = НовыйКонтекстВызывающегоМодуля(КонтекстИлиВызвающийМодуль);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ИмяОсновнойФормы = "Форма";
	
	ПараметрКлючУникальности = Неопределено;
	ПараметрЗакрыватьПриЗакрытииВладельца = Истина;
	
	ФормаОбработки = ПолучитьФормуОбработки(
		ИмяОсновнойФормы,
		ПараметрВладелец,
		ПараметрыФормы,
		ПараметрКлючУникальности,
		ПараметрЗакрыватьПриЗакрытииВладельца
	);
	
	ФормаОбработки.Инициализировать(Контекст, ЭтаФорма);
	ФормаОбработки.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, КонтекстИлиВызвающийМодуль) Экспорт
	
	Если ТипЗнч(КонтекстИлиВызвающийМодуль) = Тип("Структура") Тогда
		Контекст = КонтекстИлиВызвающийМодуль;
	Иначе
		Контекст = НовыйКонтекстВызывающегоМодуля(КонтекстИлиВызвающийМодуль);
	КонецЕсли;
	
	МассивПлагинов = СписокПлагинов();
	
	Если МассивПлагинов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Плагин ИЗ МассивПлагинов Цикл
		
		Если Не ЭтоАктивныйПлагин(Плагин) Тогда
			Продолжить;
		КонецЕсли;
		
		Плагин_ОбработатьСобытие(Плагин, ИмяСобытия, ПараметрыСобытия);
		
	КонецЦикла;

КонецПроцедуры 

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Открывает список опубликованных плагинов.
//
// Параметры:
//  ПараметрВладелец - ФормаКлиентскогоПриложения - форма или элемент управления другой формы.
//
&НаКлиенте
Процедура ОткрытьБиблиотекуПлагинов(ПараметрВладелец) Экспорт
	
	ИмяФормыБиблиотеки = "Форма_БиблиотекаПлагинов";
	
	ПараметрыФормы = Новый Структура;
	
	ОткрытьФормуОбработкиМодально(
		ИмяФормыБиблиотеки,
		ПараметрыФормы,
		ПараметрВладелец
	);
	
КонецПроцедуры

// Открывает настройки выбранного плагина.
//
// Параметры:
//  ИдентификаторПлагина - Строка - идентификатор плагина.
//  ПараметрВладелец - ФормаКлиентскогоПриложения - форма или элемент управления другой формы.
//
&НаКлиенте
Процедура ОткрытьНастройкиПлагина(ИдентификаторПлагина, ПараметрВладелец) Экспорт
	
	ИмяФормыПлагина = "ВнешняяОбработка." + ИдентификаторПлагина + ".Форма.КлиентскиеВызовы";
	
	ПараметрыФормы = Новый Структура;
	
	ПлагинКлиент = ПолучитьФорму(
		ИмяФормыПлагина,
		ПараметрыФормы,
		ПараметрВладелец
	);
	
	ПлагинКлиент.ОткрытьНастройки();
	
КонецПроцедуры

// Загружает плагин в хранилище плагинов. Если файл не указан, то он будет загружен из сервиса.
//
// Параметры:
//  Идентификатор - Строка - идентификатор плагина.
//  Представление - Строка - (Необязательный) представление плагина.
//  Версия - Строка - (Необязательный) версия плагина.
//  ДвоичныеДанные - ДвоичныеДанные - (Необязательный) файл плагина. Если не указан, плагин будет загружен из сервиса.
// 
// Возвращаемое значение:
//  Структура:
//    * Успешно - Булево - Ложь, если есть ошибки
//    * ОписаниеОшибки - Строка - текст ошибки.
//
&НаКлиенте
Функция ЗагрузитьПлагин(Идентификатор, Знач Представление = "", Знач Версия = "", Знач ДвоичныеДанные = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = Идентификатор;
	КонецЕсли;
	
	ПараметрыСобытия = Новый Структура();
	ПараметрыСобытия.Вставить("ДвоичныеДанные", ДвоичныеДанные);
	ПараметрыСобытия.Вставить("Идентификатор", Идентификатор);
	ПараметрыСобытия.Вставить("Представление", Представление);
	ПараметрыСобытия.Вставить("Версия", Версия);
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаЗагрузитьПлагин(),
		ПараметрыСобытия
	);
	
	Результат = ПараметрыСобытия.Результат;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИмяОбработки() Экспорт
	
	КлючКэш = "ИмяОбработки";
	
	Результат = Кэш_Прочитать(КлючКэш);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ИмяОбработкиНаСервере();
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуОбработки(ИмяФормыОбработки, ПараметрыФормы = Неопределено, Владелец = Неопределено
	, Обработчик = Неопределено, МодульОбработчика = Неопределено, ПараметрыОбработчика = Неопределено
	, БлокироватьВладельца = Ложь) Экспорт
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	Если Владелец <> Неопределено Тогда
		ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	КонецЕсли;
	
	ПутьКФорме = ИмяОбработки() + ".Форма." + ИмяФормыОбработки;
	
	Если ДоступныАсинхронныеФормы() Тогда
		
		Если ЗначениеЗаполнено(Обработчик) Тогда
			ОповещениеОЗакрытии = НовоеОписаниеОповещения(Обработчик, МодульОбработчика, ПараметрыОбработчика);
		Иначе
			ОповещениеОЗакрытии = Неопределено;
		КонецЕсли;
		
		Если БлокироватьВладельца Тогда
			РежимОткрытияНовогоОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Иначе
			РежимОткрытияНовогоОкна = Неопределено;
		КонецЕсли;
		
		Выполнить("ОткрытьФорму(ПутьКФорме, ПараметрыФормы, Владелец,
		|, , , ОповещениеОЗакрытии, РежимОткрытияНовогоОкна)");
		
	Иначе
		
		Если ЗначениеЗаполнено(Обработчик) Тогда
			
			Результат = ОткрытьФормуМодально(ПутьКФорме, ПараметрыФормы, Владелец);
			
			ВызватьОбработчикОповещения(Обработчик, МодульОбработчика, Результат, ПараметрыОбработчика);
			
		Иначе
			
			ОткрытьФорму(ПутьКФорме, ПараметрыФормы, Владелец, , Окно);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОбработкиМодально(ИмяФормыОбработки, ПараметрыФормы = Неопределено, Владелец
	, Обработчик = Неопределено, МодульОбработчика = Неопределено, ПараметрыОбработчика = Неопределено) Экспорт
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	Если Владелец <> Неопределено Тогда
		ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	КонецЕсли;
	
	ПутьКФорме = ИмяОбработки() + ".Форма." + ИмяФормыОбработки;
	
	Если ДоступныАсинхронныеФормы() Тогда
		
		Если ЗначениеЗаполнено(Обработчик) Тогда
			ОповещениеОЗакрытии = НовоеОписаниеОповещения(Обработчик, МодульОбработчика, ПараметрыОбработчика);
		Иначе
			ОповещениеОЗакрытии = Неопределено;
		КонецЕсли;
		
		Выполнить("ОткрытьФорму(ПутьКФорме, ПараметрыФормы, Владелец,
		|, , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)");
		
	Иначе
		
		Результат = ОткрытьФормуМодально(ПутьКФорме, ПараметрыФормы, Владелец);
		
		Если ЗначениеЗаполнено(Обработчик) Тогда
			ВызватьОбработчикОповещения(Обработчик, МодульОбработчика, Результат, ПараметрыОбработчика);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОбъектаИС(СсылкаНаОбъект) Экспорт
	
	Если ДоступныАсинхронныеФормы() Тогда
		Выполнить("ПоказатьЗначение( , СсылкаНаОбъект)");
	Иначе
		ОткрытьЗначение(СсылкаНаОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораОбъектаИС(ОписаниеОбъектаДляВыбора, Владелец
	, Обработчик, МодульОбработчика, ПараметрыОбработчика = Неопределено) Экспорт
	
	ПолноеИмяОбъекта = ОписаниеОбъектаДляВыбора.ПолноеИмяОбъекта;
	ИмяФормыВыбора	 = ОписаниеОбъектаДляВыбора.ИмяФормыВыбора;
	ПараметрыФормы	 = ОписаниеОбъектаДляВыбора.ПараметрыФормы;
	
	Если ЗначениеЗаполнено(ИмяФормыВыбора) Тогда
		ПутьКФормеВыбора = ПолноеИмяОбъекта + ".Форма." + ИмяФормыВыбора;
	Иначе
		ПутьКФормеВыбора = ПолноеИмяОбъекта + ".ФормаВыбора";
	КонецЕсли;
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	
	Если ДоступныАсинхронныеФормы() И ЭтоУправляемаяФормаВыбора(ПутьКФормеВыбора) Тогда
		
		ОповещениеОЗакрытии = НовоеОписаниеОповещения(Обработчик, МодульОбработчика, ПараметрыОбработчика);
		
		Выполнить("ОткрытьФорму(ПутьКФормеВыбора, ПараметрыФормы, Владелец,
		|, , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца)");
		
	Иначе
		
		Результат = ОткрытьФормуМодально(ПутьКФормеВыбора, ПараметрыФормы, Владелец);
		
		ВызватьОбработчикОповещения(Обработчик, МодульОбработчика, Результат, ПараметрыОбработчика);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПолноеИмяОбработки = ОбработкаОбъект.Метаданные().ПолноеИмя();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта = Неопределено Тогда
		КэшМодуляОбъекта = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Функция ОсновнойМодуль()
	Возврат ВладелецФормы;
КонецФункции


// Кэш

// Возвращает значение из кэша на время вызова сервера
//
// Параметры:
//  Ключ - Строка - см. процедуру Кэш_Поместить
//
// Возвращаемое значение: 
//  Произвольный - см. процедуру Кэш_Поместить
//
&НаКлиенте
Функция Кэш_Прочитать(Ключ)
	
	Если ЗначениеЗаполнено(КэшНаКлиенте) Тогда
		Результат = КэшНаКлиенте.Получить(Ключ);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Помещает значение в кэш на время вызова сервера
//
// Параметры:
//  Ключ     - Строка       - уникальный ключ помещаемого значения;
//  Значение - Произвольный - помещаемое значение;
//
&НаКлиенте
Процедура Кэш_Поместить(Ключ, Значение)
	
	Если КэшНаКлиенте = Неопределено Тогда
		КэшНаКлиенте = Новый Соответствие;
	КонецЕсли;
	
	КэшНаКлиенте.Вставить(Ключ, Значение);
	
КонецПроцедуры

// Открытие форм

&НаСервере
Функция ИмяОбработкиНаСервере()
	
	Возврат МодульОбъекта().Метаданные().ПолноеИмя();
	
КонецФункции

&НаКлиенте
Функция ПолучитьФормуОбработки(ПараметрИмяФормы,
								парамВладелецФормы = Неопределено,
								ПараметрыФормы = Неопределено,
								КлючУникальности = Неопределено,
								ЗакрыватьПриЗакрытииВладельца = Ложь)
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли;
	
	Если НЕ ПараметрыФормы.Свойство("Объект") Тогда
		ПараметрыФормы.Вставить("Объект",	Объект);
	КонецЕсли;
	
	Если парамВладелецФормы = Неопределено Тогда
		парамВладелецФормы = ЭтаФорма;
	КонецЕсли;
	
	Если ЗакрыватьПриЗакрытииВладельца Тогда
		ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", ЗакрыватьПриЗакрытииВладельца);
	КонецЕсли;
	
	ПолноеИмяФормы = ПолноеИмяОбработки + ".Форма." + ПараметрИмяФормы;
	
	Результат = ПолучитьФорму(
		ПолноеИмяФормы,
		ПараметрыФормы,
		парамВладелецФормы,
		КлючУникальности
	);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйКонтекстВызывающегоМодуля(ВызывающийМодуль)
	
	Результат = Новый Структура;
	Результат.Вставить("ВызывающийМодуль", ВызывающийМодуль);
	Результат.Вставить("РежимОтладки", Ложь);
	Результат.Вставить("КаталогОтладки", "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПлагинСодержитСобытие(Плагин, ИмяСобытия)
	
	Результат = (Плагин.События.Найти(ИмяСобытия) <> Неопределено);
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоАктивныйПлагин(Плагин)
	
	СостоянияПлагинов = Перечисление_СостоянияПлагинов();
	
	Результат = (Плагин.Состояние = СостоянияПлагинов.Включен);
	
	Возврат Результат;
	
КонецФункции

//Обработчики клиентских процедур

&НаКлиенте
Процедура ОсновнойМодуль_ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды)
	
	ОсновнойМодуль().КонтурПлагины_ОбработатьСлужебнуюКоманду(
		ИмяКоманды,
		ПараметрыКоманды
	);
	
КонецПроцедуры

&НаКлиенте
Функция СписокПлагинов()
	
	Результат = Неопределено;
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Результат");
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаПолучитьСписокПлагинов(),
		ПараметрыСобытия
	);
	
	Результат = ПараметрыСобытия.Результат;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Перечисление_СостоянияПлагинов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Включен",				СостояниеВключен());
	Результат.Вставить("Отключен",				"Отключен");
