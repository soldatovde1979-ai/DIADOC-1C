&НаКлиенте
Процедура Плагин_ОбработатьСобытие(Плагин, ИмяСобытия, ПараметрыСобытия)
	
	Если Не ПлагинСодержитСобытие(Плагин, ИмяСобытия) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиПлагина = Неопределено;
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Результат");
	ПараметрыКоманды.Вставить("Идентификатор", Плагин.Идентификатор);
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаПолучитьНастройки(),
		ПараметрыКоманды
	);
	
	РезультатНастроек = ПараметрыКоманды.Результат;
	
	Если РезультатНастроек.Успешно Тогда
		НастройкиПлагина = РезультатНастроек.Данные;	
	КонецЕсли;
	
	МодульПлагина = Плагин_СоздатьОбъект(Плагин.Идентификатор);
	
	Попытка
		
		МодульПлагина.ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, НастройкиПлагина);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ЗафиксироватьОшибкуПлагина(Плагин, ИмяСобытия, ТекстОшибки)
		
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция Плагин_СоздатьОбъект(Идентификатор = Неопределено)
	
	Результат = Неопределено; 
	
	Попытка
		
		Результат = ПолучитьФорму("ВнешняяОбработка." + Идентификатор + ".Форма.КлиентскиеВызовы",, ВладелецФормы);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		Сообщить(ТекстОшибки);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции 

// Добавляет ошибку плагина в массив ошибок и запись в журнал регистрации
//
// Параметры:
//  ОписаниеПлагина - Структура - см. Новый_ОписаниеПлагина();
//  ИмяСобытия - Строка - имя события;
//  ТекстОшибки - Строка - текст ошибки;
//
&НаКлиенте
Процедура ЗафиксироватьОшибкуПлагина(Плагин, ИмяСобытия, ТекстОшибки) 
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("Плагин", Плагин);
	ПараметрыКоманды.Вставить("ИмяСобытия", ИмяСобытия);
	ПараметрыКоманды.Вставить("ТекстОшибки", ТекстОшибки);
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаЗафиксироватьОшибкуПлагина(),
		ПараметрыКоманды
	);
	
КонецПроцедуры

