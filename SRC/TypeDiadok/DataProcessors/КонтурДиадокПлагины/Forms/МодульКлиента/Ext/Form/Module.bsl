	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = НаименованиеМодуля();
	КонецЕсли;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("ОК");
	Кнопки.Добавить("Подробно...");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("ТекстПодробно", ТекстПодробно);
	
	ПоказатьДиалогВопроса(ТекстПредупреждения, Кнопки
	, "ВывестиПредупреждениеСКнопкойПодробно_ПослеПредупреждения", ЭтаФорма, ДопПараметры, Заголовок);
	
