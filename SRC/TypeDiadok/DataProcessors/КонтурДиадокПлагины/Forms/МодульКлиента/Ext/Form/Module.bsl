&НаКлиенте
Процедура ВывестиПредупреждение(ТекстПредупреждения, Таймаут = 0, Заголовок = ""
	, МодульОбработчика = Неопределено, Обработчик = Неопределено, ПараметрыОбработчика = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = НаименованиеМодуля();
	КонецЕсли;
	
	Если ДоступныАсинхронныеФормы() Тогда
		
		ОповещениеОЗакрытии = Неопределено;
		
		Если ЗначениеЗаполнено(Обработчик) Тогда
			ОповещениеОЗакрытии = НовоеОписаниеОповещения(Обработчик, МодульОбработчика, ПараметрыОбработчика);
		КонецЕсли;
		
		Выполнить("ПоказатьПредупреждение(ОповещениеОЗакрытии, ТекстПредупреждения, Таймаут, Заголовок)");
		
	Иначе
		
		Предупреждение(ТекстПредупреждения, Таймаут, Заголовок);
		
		Если ЗначениеЗаполнено(Обработчик) Тогда
			ВызватьОбработчикОповещения(Обработчик, МодульОбработчика, ПараметрыОбработчика);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

