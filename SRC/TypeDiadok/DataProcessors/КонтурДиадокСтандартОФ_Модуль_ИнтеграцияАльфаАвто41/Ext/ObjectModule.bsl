Функция ЕдиницаИзмеренияПоКлассификатору(КодЕИ)
	
	Результат = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(КодЕИ);
	Возврат Результат;
	
КонецФункции

Функция ЕдиницаИзмеренияНоменклатуры(Номенклатура, КодЕИ)
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыНоменклатуры = ЗначенияРеквизитовОбъектаЛокальная(
			Номенклатура,
			"ТипНоменклатуры, ОсновнаяЕдиницаИзмерения");
	
	РеквизитыЕдиницыИзмерения = ЗначенияРеквизитовОбъектаЛокальная(
			РеквизитыНоменклатуры.ОсновнаяЕдиницаИзмерения,
			"ЕдиницаПоКлассификатору");
	
	ЕдиницаПоОКЕИ = ЕдиницаИзмеренияПоКлассификатору(КодЕИ);
	
	НайденнаяЕИ = Справочники.ЕдиницыИзмерения.НайтиПоРеквизиту(
		"ЕдиницаПоКлассификатору",
		ЕдиницаПоОКЕИ,
		Неопределено,
		РеквизитыНоменклатуры.ТипНоменклатуры
		);
	
	Если РеквизитыЕдиницыИзмерения.ЕдиницаПоКлассификатору = ЕдиницаПоОКЕИ Тогда
		
		Результат = РеквизитыНоменклатуры.ОсновнаяЕдиницаИзмерения;
		
	ИначеЕсли ЗначениеЗаполнено(НайденнаяЕИ) Тогда
		
		Результат = НайденнаяЕИ;
		
	Иначе
		
		Результат = РеквизитыНоменклатуры.ОсновнаяЕдиницаИзмерения;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НоваяНоменклатураИнформационнойБазы(Номенклатура, Характеристика = Неопределено, Упаковка = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", Номенклатура);
	Результат.Вставить("Характеристика");
	Результат.Вставить("Упаковка");
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Результат.Характеристика = Характеристика;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Результат.Упаковка = Упаковка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНоменклатуруИнформационнойБазы_ПрайсЛистыКонтрагентов(Владелец, ПолныйИдентификаторНоменклатуры)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Номенклатура КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	НЕОПРЕДЕЛЕНО КАК Упаковка
	|ИЗ
	|	РегистрСведений.ПрайсЛистыКонтрагентов КАК Т
	|ГДЕ
	|	Т.ПрайсЛист = &ПрайсЛист
	|	И Т.НаименованиеИностранное = &Идентификатор
	|	И Т.Номенклатура <> &ПустаяНоменклатура";
	
	СлужебныйПрайсЛист = ПолучитьСсылкуНаПрайсЛистПоставщика(Владелец);
	ИдентификаторНоменклатуры = ЗначениеИдентификатораНоменклатурыВИнформационнойБазе(ПолныйИдентификаторНоменклатуры);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПрайсЛист", СлужебныйПрайсЛист);
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторНоменклатуры);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	
	Если Выборка.Следующий() Тогда
		
		Результат = НоваяНоменклатураИнформационнойБазы(
			Выборка.Номенклатура,
			Выборка.Характеристика,
			Выборка.Упаковка
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьСопоставлениеНоменклатуры(НоменклатураКонтрагента, Номенклатура, Характеристика)
	
	ВладелецНоменклатуры = НоменклатураКонтрагента.Владелец;
	ПолныйИдентификаторНоменклатуры = НоменклатураКонтрагента.Идентификатор;
	
	НачатьТранзакцию();
	
	Попытка
		
		УдалитьСопоставлениеНоменклатуры_ПрайсЛистыКонтрагентов(ВладелецНоменклатуры, ПолныйИдентификаторНоменклатуры);
		ДобавитьСопоставлениеНоменклатуры(НоменклатураКонтрагента, Номенклатура, Характеристика);
		
		// Запись дублируется в устаревшее хранилище для обратной совместимости
		ДобавитьСопоставлениеНоменклатуры_ПрайсЛистыКонтрагентов(НоменклатураКонтрагента, Номенклатура);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьОшибкуСопоставленияНоменклатуры(ПолныйИдентификаторНоменклатуры, ВладелецНоменклатуры, Ошибка);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УдалитьСопоставлениеНоменклатуры_ПрайсЛистыКонтрагентов(Владелец, ПолныйИдентификаторНоменклатуры)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.ПрайсЛистыКонтрагентов КАК Т
	|ГДЕ
	|	Т.ПрайсЛист = &ПрайсЛист
	|	И &ПолеИдентификатор = &Идентификатор";
	
	ПолеИдентификатор = ИмяПоляИдентификаторНоменклатуры();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИдентификатор", "Т." + ПолеИдентификатор);
	
	СлужебныйПрайсЛист = ПолучитьСсылкуНаПрайсЛистПоставщика(Владелец);
	ИдентификаторНоменклатуры = ЗначениеИдентификатораНоменклатурыВИнформационнойБазе(ПолныйИдентификаторНоменклатуры);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПрайсЛист", СлужебныйПрайсЛист);
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторНоменклатуры);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерТаблицы = РегистрыСведений.ПрайсЛистыКонтрагентов;
	
	Пока Выборка.Следующий() Цикл
		Запись = МенеджерТаблицы.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Удалить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСопоставлениеНоменклатуры_ПрайсЛистыКонтрагентов(НоменклатураКонтрагента, Номенклатура)
	
	ВладелецНоменклатуры = НоменклатураКонтрагента.Владелец;
	ПолныйИдентификаторНоменклатуры = НоменклатураКонтрагента.Идентификатор;
	
	СлужебныйПрайсЛист = ПолучитьСсылкуНаПрайсЛистПоставщика(ВладелецНоменклатуры);
	ИдентификаторНоменклатуры = ЗначениеИдентификатораНоменклатурыВИнформационнойБазе(ПолныйИдентификаторНоменклатуры);
	ПолеИдентификатор = ИмяПоляИдентификаторНоменклатуры();
	
	НовыйОбъект = РегистрыСведений.ПрайсЛистыКонтрагентов.СоздатьМенеджерЗаписи();
	
	НовыйОбъект.Контрагент	 = ВладелецНоменклатуры;
	НовыйОбъект.ПрайсЛист	 = СлужебныйПрайсЛист;
	НовыйОбъект.Номенклатура = Номенклатура;
	НовыйОбъект.Артикул		 = НоменклатураКонтрагента.Артикул;
	НовыйОбъект.Наименование = НоменклатураКонтрагента.Наименование;
	НовыйОбъект[ПолеИдентификатор] = ИдентификаторНоменклатуры;
	
	НовыйОбъект.АртикулДляПоиска = НоменклатураКонтрагента.Код;
	
	НовыйОбъект.Записать();
	
КонецПроцедуры

Процедура ЗаписатьОшибкуСопоставленияНоменклатуры(ИдентификаторНоменклатуры, ВладелецНоменклатуры, Ошибка)
	
	ПодробностиОшибки = ПодробноеПредставлениеОшибки(Ошибка);
	
	ТекстОшибки = "Не удалось записать сопоставление номенклатуры (Идентификатор = %1, контрагент = %2)";
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%1", ИдентификаторНоменклатуры);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%2", ВладелецНоменклатуры);
	ТекстОшибки = ТекстОшибки + Символы.ПС + ПодробностиОшибки;
	
	ЗаписьЖурналаРегистрации(
		"Диадок.Сопоставление номенклатуры",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.РегистрыСведений.ПрайсЛистыКонтрагентов,
		Неопределено,
		ТекстОшибки
	);
	
КонецПроцедуры

Функция ЗначениеИдентификатораНоменклатурыВИнформационнойБазе(ИдентификаторНоменклатуры)
	
	ПолеИдентификатор = МетаданныеПоляДляЗаписиИдентификатораНоменклатуры();
	МаксимальнаяДлина = ПолеИдентификатор.Тип.КвалификаторыСтроки.Длина;
	
	Результат = Прав(ИдентификаторНоменклатуры, МаксимальнаяДлина);
	
	Возврат Результат;
	
КонецФункции

Функция МетаданныеПоляДляЗаписиИдентификатораНоменклатуры()
	
	Результат = Метаданные.РегистрыСведений.ПрайсЛистыКонтрагентов.Ресурсы.НаименованиеИностранное;
	Возврат Результат;
	
КонецФункции

Функция ИмяПоляИдентификаторНоменклатуры()
	
	ПолеИдентификатор = МетаданныеПоляДляЗаписиИдентификатораНоменклатуры();
	Результат = ПолеИдентификатор.Имя;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеСлужебногоПрайсЛиста()
	Возврат "СЛУЖЕБНЫЙ_ДИАДОК_СопоставлениеНоменклатуры";
КонецФункции

Функция НайтиСлужебныйПрайсЛист(Контрагент)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.Код КАК Код
	|ИЗ
	|	Справочник.ПрайсЛистыКонтрагентов КАК Т
	|ГДЕ
	|	Т.Владелец = &Владелец
	|	И Т.Наименование = &Наименование
	|	И НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код УБЫВ");
	
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Наименование", НаименованиеСлужебногоПрайсЛиста());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьСлужебныйПрайсЛист(Контрагент)
	
	НовыйПрайс = Справочники.ПрайсЛистыКонтрагентов.СоздатьЭлемент();
	НовыйПрайс.Владелец = Контрагент;
	НовыйПрайс.Наименование = НаименованиеСлужебногоПрайсЛиста();
	НовыйПрайс.ОбменДанными.Загрузка = Истина;
	
	НовыйПрайс.Записать();
	
	Результат = НовыйПрайс.Ссылка;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуНаПрайсЛистПоставщика(Контрагент)
	
	Результат = СоответствиеПрайсЛистовПоставщиков.Получить(Контрагент);
	
	Если Результат = Неопределено Тогда
		
		Результат = НайтиСлужебныйПрайсЛист(Контрагент);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = СоздатьСлужебныйПрайсЛист(Контрагент);
		КонецЕсли;
		
		СоответствиеПрайсЛистовПоставщиков.Вставить(Контрагент, Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНоменклатуруИнформационнойБазы(Владелец, ИдентификаторНоменклатуры)
	
	Результат = Неопределено;
	
	ТаблицаСопоставленияНоменклатуры = ПолучитьТаблицуСопоставленияИзХранилища(Владелец);
	
	СтрокаПоиска = ТаблицаСопоставленияНоменклатуры.Найти(ИдентификаторНоменклатуры, "Идентификатор");
	
	Если СтрокаПоиска = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Номенклатура = СтрокаПоиска.Номенклатура;
	Если НЕ ЗначениеЗаполнено(Номенклатура)
		ИЛИ НЕ Общее_СсылкаСуществует(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Характеристика = СтрокаПоиска.Характеристика;
	Если НЕ ЗначениеЗаполнено(Характеристика)
		ИЛИ НЕ Общее_СсылкаСуществует(Характеристика) Тогда
		Характеристика = Неопределено;
	КонецЕсли;
	
	
	Результат = НоваяНоменклатураИнформационнойБазы(
		Номенклатура,
		Характеристика
	);
	
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСопоставлениеНоменклатуры(НоменклатураКонтрагента, Номенклатура, Характеристика = Неопределено)
	
	Владелец = НоменклатураКонтрагента.Владелец;
	
	ТаблицаСопоставленияНоменклатуры = ПолучитьТаблицуСопоставленияИзХранилища(Владелец);
	Идентификатор = НоменклатураКонтрагента.Идентификатор;
	
	СтрокаТаблицы = ТаблицаСопоставленияНоменклатуры.Найти(Идентификатор, "Идентификатор");
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = ТаблицаСопоставленияНоменклатуры.Добавить();
	КонецЕсли;
	
	СтрокаТаблицы.Идентификатор = Идентификатор;
	СтрокаТаблицы.Номенклатура = Номенклатура;
	СтрокаТаблицы.Характеристика = Характеристика;
	
	ЗаписатьСопоставлениеНоменклатурыВХранилище(Владелец, ТаблицаСопоставленияНоменклатуры);
	
КонецПроцедуры

Процедура ЗаписатьСопоставлениеНоменклатурыВХранилище(Владелец, ТаблицаСопоставленияНоменклатуры)
	
	Идентификатор = ИдентификаторСлужебногоХранилищаСопоставления();
	ХранилищеСопоставления = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
	ХранилищеСопоставления.Объект = Владелец;
	ХранилищеСопоставления.ИмяФайла = Владелец;
	ХранилищеСопоставления.Идентификатор = Идентификатор;
	ХранилищеСопоставления.Данные = Новый ХранилищеЗначения(ТаблицаСопоставленияНоменклатуры);
	ХранилищеСопоставления.Записать();
	
КонецПроцедуры

Функция ПолучитьТаблицуСопоставленияИзХранилища(Владелец)
	
	ТаблицаСопоставленияНоменклатуры = ПолучитьТаблицуСопоставленияНоменклатуры(Владелец);
	
	Если НЕ ЗначениеЗаполнено(ТаблицаСопоставленияНоменклатуры) Тогда
		ТаблицаСопоставленияНоменклатуры = Контракт_ХранениеТаблицыСопоставленияНоменклатуры();
	КонецЕсли;
	
	Если НЕ ТипЗнч(ТаблицаСопоставленияНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		ШаблонОшибки = "Не удалось прочитать файл сопоставления номенклатуры по контрагенту """"%1"""". 
			|Подробности см. в журнале регистрации.";
		
		ТекстОшибки = СтрЗаменить(ШаблонОшибки, "%1", СокрЛП(Владелец));
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат ТаблицаСопоставленияНоменклатуры;
	
КонецФункции

Функция Контракт_ХранениеТаблицыСопоставленияНоменклатуры()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Упаковка");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуСопоставленияНоменклатуры(Контрагент)
	
	Результат = Контракт_ХранениеТаблицыСопоставленияНоменклатуры();
	Идентификатор = ИдентификаторСлужебногоХранилищаСопоставления();
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Данные КАК Данные
	|ИЗ
	|	РегистрСведений.КартинкиИФайлы КАК Т
	|ГДЕ
	|	Т.Объект = &Контрагент
	|	И Т.Идентификатор = &Идентификатор";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Данные.Получить();
		
	КонецЕсли;
	
