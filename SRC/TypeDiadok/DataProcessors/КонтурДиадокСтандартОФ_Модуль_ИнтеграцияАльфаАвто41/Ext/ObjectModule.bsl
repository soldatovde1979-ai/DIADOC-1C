КонецФункции

Функция ТекстЗапросаРазвернутаяТаблицаКодов(ПолноеИмяТаблицы)
	
	Результат =
	"ВЫБРАТЬ
	|	КМ.Ссылка КАК Ссылка,
	|	КМ.ИдентификаторТовара КАК ИдентификаторТовара,
	|	КМ.КодМаркировки КАК КодМаркировки
	|ПОМЕСТИТЬ КодыМаркировки
	|ИЗ
	|	&ТЧКодыМаркировки КАК КМ
	|ГДЕ
	|	КМ.Ссылка В(&ДокументыПередачи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.ХарактеристикаНоменклатуры КАК Характеристика,
	|	Т.ИдентификаторТовара КАК ИдентификаторТовара
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&ТЧТовары КАК Т
	|ГДЕ
	|	Т.Ссылка В(&ДокументыПередачи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	КодыМаркировки.КодМаркировки КАК ЗначениеШтрихкода,
	|	&УпаковкаПотребительская КАК ВидУпаковки
	|ИЗ
	|	Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыМаркировки КАК КодыМаркировки
	|		ПО Товары.Ссылка = КодыМаркировки.Ссылка
	|			И Товары.ИдентификаторТовара = КодыМаркировки.ИдентификаторТовара";
	
	Результат = СтрЗаменить(Результат, "&ТЧКодыМаркировки", ПолноеИмяТаблицы + ".КодыМаркировки");
	Результат = СтрЗаменить(Результат, "&ТЧТовары", ПолноеИмяТаблицы + ".Товары");
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьТаблицуКодовМаркировки(ТаблицаКодов, ДокументПередачи)
	
	МетаданныеОбъекта = ДокументПередачи.Метаданные();
	
	Если Не ЕстьШтрихкодыУпаковок(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыНоменклатуры = ПараметрыУчетаНоменклатуры();
	
	ТекстЗапроса = ТекстЗапросаРазвернутаяТаблицаКодов(МетаданныеОбъекта.ПолноеИмя());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументыПередачи", ДокументПередачи);
	Запрос.УстановитьПараметр("УпаковкаПотребительская", "Потребительская");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаКодов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ИспользоватьХарактеристики = ПараметрыНоменклатуры.ИспользоватьХарактеристики;
		НоваяСтрока.ИспользоватьСерии = ПараметрыНоменклатуры.ИспользоватьСерии;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьКодыМаркировки(КодыМаркировки, СведенияОМаркировке, ИдентификаторСтроки, GTIN = "")
	
	Если Не ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(GTIN)
		И ЗначениеЗаполнено(СведенияОМаркировке.КоличествоТовараВУпаковке) Тогда
		
		КоличествоТовараВУпаковке = СведенияОМаркировке.КоличествоТовараВУпаковке;

		ЗначениеШтрихкода = НовыйКодОСУ(GTIN, КоличествоТовараВУпаковке);
		
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = ЗначениеШтрихкода;
		НоваяСтрока.ИдентификаторТовара = ИдентификаторСтроки;

	КонецЕсли;

	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки Цикл
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = ЗначениеШтрихкода;
		НоваяСтрока.ИдентификаторТовара = ИдентификаторСтроки;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ИндивидуальныеУпаковки Цикл
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = ЗначениеШтрихкода;
		НоваяСтрока.ИдентификаторТовара = ИдентификаторСтроки;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ТранспортныеУпаковки Цикл
		НоваяСтрока = КодыМаркировки.Добавить();
		НоваяСтрока.КодМаркировки = ЗначениеШтрихкода;
		НоваяСтрока.ИдентификаторТовара = ИдентификаторСтроки;
	КонецЦикла;
	
КонецПроцедуры

Функция НовыйКодОСУ(GTIN, Количество)
	
	КоличествоСтрокой = XMLСтрока(Цел(Количество));
	
	Результат = "02" + GTIN + "37" + КоличествоСтрокой;
	
	Возврат Результат;
	
КонецФункции

// Возвращает параметры учета номенклатуры в текущей информационной базе.
// 
// Возвращаемое значение:
//  ФикисированнаяСтруктура - содержит ключи:
//    * ИспользоватьХарактеристики - Булево - Истина, если используются характеристики номенклатуры
//    * ИспользоватьСерии - Булево - Истина, если используются серии номенклатуры
//
Функция ПараметрыУчетаНоменклатуры()
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьХарактеристики", Ложь);
	Результат.Вставить("ИспользоватьСерии", Ложь);
	
	Если Метаданные.Справочники.Найти("ХарактеристикиНоменклатуры") <> Неопределено Тогда
		Результат.ИспользоватьХарактеристики = Истина;
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("СерииНоменклатуры") <> Неопределено Тогда
		Результат.ИспользоватьСерии = Истина;
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Проверяет физическое наличие записи в информационной базе данных о переданном значении ссылки.
//
// Параметры:
//  ЛюбаяСсылка - значение любой ссылки информационной базы данных.
// 
// Возвращаемое значение:
//  Булево.
//
Функция Общее_СсылкаСуществует(ЛюбаяСсылка) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	[ИмяТаблицы]
	|ГДЕ
	|	Ссылка = &Ссылка
	|";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ИмяТаблицы]", ЛюбаяСсылка.Метаданные().ПолноеИмя());
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ЛюбаяСсылка);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ПреобразоватьСтрокуВМассивПодстрок(Знач Строка, Разделитель = ",", ПропускатьПустыеСтроки = Ложь, ПрименятьСокрЛП = Ложь) Экспорт
	
	Возврат ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").ПреобразоватьСтрокуВМассивПодстрок(Строка, Разделитель, ПропускатьПустыеСтроки, ПрименятьСокрЛП);
	
КонецФункции

// Извлекает из строки номер и дату
//
// Параметры:
//  ИсходнаяСтрока - Строка - Строка в формате "[Что-то] [№]<Номер> от <dd.MM.yyyy>"
// 
// Возвращаемое значение:
//  Структура:
//   * Номер - Строка - номер документа
//   * Дата - Дата - дата документа
//
Функция ВыделитьНомерДатуИзСтроки(ИсходнаяСтрока)
	
	Подстроки = ПреобразоватьСтрокуВМассивПодстрок(ИсходнаяСтрока, "№");
	СтрокаНомерДата = СокрЛП(Подстроки[Подстроки.ВГраница()]);
	
	Подстроки = ПреобразоватьСтрокуВМассивПодстрок(СтрокаНомерДата, " от ");
	Номер = СокрЛП(Подстроки[0]);
	
	СтрокаДата = "";
	Если Подстроки.Количество() > 1 Тогда
		СтрокаДата = СокрЛП(Подстроки[1]);
	КонецЕсли;
	
	Подстроки =  ПреобразоватьСтрокуВМассивПодстрок(СтрокаДата, ".");
	
	День = 1;
	Если Подстроки.Количество() > 0 Тогда
		День = СокрЛП(Подстроки[0]);
	КонецЕсли;
	
	Месяц = 1;
	Если Подстроки.Количество() > 1 Тогда
		Месяц = СокрЛП(Подстроки[1]);
	КонецЕсли;
	
	Год = 1;
	Если Подстроки.Количество() > 2 Тогда
		Год = Подстроки[2];
		Год = СтрЗаменить(Год, "г.", "");
		Год = СтрЗаменить(Год, "г", "");
		Год = СокрЛП(Год);
	КонецЕсли;
	
	Попытка
		Дата = Дата(Год, Месяц, День);
	Исключение
		Дата = Дата(1, 1, 1);
	КонецПопытки;
	
	Результат = Новый Структура;
	Результат.Вставить("Номер", Номер);
	Результат.Вставить("Дата", Дата);
	
	Возврат Результат;
	
КонецФункции

