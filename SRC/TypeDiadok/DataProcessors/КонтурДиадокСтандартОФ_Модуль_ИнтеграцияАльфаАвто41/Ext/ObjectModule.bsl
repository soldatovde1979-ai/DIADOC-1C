// Заполняет список правил создания и заполнения документов учета.
//
// Параметры:
//  ПравилаСоздания - СписокЗначений - (возвращаемый параметр) идентификаторы правил создания и их представления.
//  ФорматЭД - Структура - см. ОсновнойМодуль.НовоеОписаниеФорматаЭлектронногоДокумента.
//  СтандартнаяОбработка - Булево - Ложь, если требуется отключить стандартную обработку заполнения правил.
//
Процедура ПриЗаполненииПравилСозданияДокументовУчета(ПравилаСоздания, ФорматЭД, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ФорматыЭД = МодульФорматыЭлектронныхДокументов();
	
	Если ФорматыЭД.ЭтоУниверсальныйПередаточныйДокумент(ФорматЭД)
		Или ФорматыЭД.ЭтоПередаточныйДокумент(ФорматЭД) Тогда
		
		Операция = ОперацияПоступлениеТоваров();
		Представление = "Поступление товаров";
		ПравилаСоздания.Добавить(Операция, Представление);
		
	ИначеЕсли ФорматыЭД.ЭтоСчетФактура(ФорматЭД)
		ИЛИ ФорматыЭД.ЭтоКорректировочныйСчетФактура(ФорматЭД) Тогда
		
		Операция = ОперацияСчетФактураПолученный();
		Представление = "Счет-фактура полученный";
		ПравилаСоздания.Добавить(Операция, Представление);
		
	Иначе
		
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработка создания и заполнения документа учета по указанному правилу.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - (возвращаемый параметр) Заполняемый объект.
//  ИдентификаторОпераци - Строка - идентификатор правила создания и заполнения документа учета.
//  ПараметрыСоздания - Структура - см. ОсновнойМодуль.ПараметрыСозданияДокументаИнформационнойБазы.
//  ДанныеЭД - Структура - разобранное содержимое электронного документа (см. ОсновнойМодуль.ДанныеЭлектронногоДокумента)
//  СтандартнаяОбработка - Булево - Ложь, если требуется отключить стандартную обработку заполнения объекта.
//
Процедура ПриСозданииДокументаУчета(ДокументОбъект, ИдентификаторОперации, ПараметрыСоздания, ДанныеЭД, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ФорматЭД = ДанныеЭД.Формат;
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТабличнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	Если ИдентификаторОперации = ОперацияПоступлениеТоваров() Тогда
		
		ДокументОбъект = Документы.ПоступлениеТоваров.СоздатьДокумент();
		ЗаполнитьШапкуПоступленияТоваровУслуг(ДокументОбъект, ПараметрыСоздания, ШапкаЭД);
		ЗаполнитьТабличнуюЧастьПоступленияТоваровУслуг(ДокументОбъект, ТабличнаяЧастьЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияАктСверкиВзаиморасчетов() Тогда
		
		ДокументОбъект = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
		ЗаполнитьШапкуАктаСверкиВзаиморасчетов(ДокументОбъект, ПараметрыСоздания, ШапкаЭД, ИтогиЭД);
		ЗаполнитьТабличнуюЧастьАктаСверкиВзаиморасчетов(ДокументОбъект, ТабличнаяЧастьЭД);
		
	ИначеЕсли ИдентификаторОперации = ОперацияСчетФактураПолученный() Тогда
		
		Ошибка = "Создание счетов-фактур в текущей конфигурации не поддерживается.";
		ВызватьИсключение Ошибка;
		
	Иначе
		
		Ошибка = "Неизвестный идентификатор операции (%1)";
		Ошибка = СтрЗаменить(Ошибка, "%1", ИдентификаторОперации);
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
КонецПроцедуры

// Выполяется при чтении соответствия номенклатуры контрагента и номенклатуры информационной базы.
//
// Параметры:
//  Результат - Соответствие - (возвращаемый параметр) содержит элементы:
//    * Ключ - Строка - идентификатор номенклатуры контрагента;
//    * Значение - Структура - номенклатура информационной базы (см. НоваяНоменклатураИнформационнойБазы)
//  ВладелецНоменклатуры - ЛюбаяСсылка - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Массив из Строка - идентификаторы номенклатуры контрагентов.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриЧтенииСоответствияНоменклатуры(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Идентификатор Из ИдентификаторыНоменклатуры Цикл
		
		НоменклатураИБ = ПолучитьНоменклатуруИнформационнойБазы(ВладелецНоменклатуры, Идентификатор);
		
				
		Если НЕ ЗначениеЗаполнено(НоменклатураИБ) Тогда
			// Миграция данных из устаревшего хранилища по требованию
			НоменклатураИБ = ПеренестиСопоставлениеНоменклатуры_ПрайсЛистыКонтрагентов(ВладелецНоменклатуры, Идентификатор);
		КонецЕсли;

		
		Результат.Вставить(Идентификатор, НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

