Процедура ЗаполнитьТабличнуюЧастьАктаСверкиВзаиморасчетов(ДокументОбъект, ТабличнаяЧастьЭД)
	
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		
		ДоговорВзаиморасчетов = ДоговорПоСтрокеАктаСверки(ДокументОбъект, СтрокаДоговора);
		
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ДокументОбъект.ПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.ДоговорВзаиморасчетов = ДоговорВзаиморасчетов;
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.Представление = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.УвеличениеДолга = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.УменьшениеДолга = СтрокаОперации.СуммаКредит;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьРеквизитыСверкиВзаиморасчетов(ДокументОбъект, РеквизитыЭлектронногоДокумента, ИтогиТЧ)
	
	ДатаДокумента = ТекущаяДата();
	
	ВалютаРегл = ВалютаРегламентированногоУчета();
	КурсыРегл = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаДокумента, Новый Структура("Валюта", ВалютаРегл));
	
	ВалютаУпр = ВалютаУправленческогоУчета();
	КурсыУпр = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаДокумента, Новый Структура("Валюта", ВалютаУпр));
	
	ДокументОбъект.Дата = ДатаДокумента;
	ДокументОбъект.Автор = ТекущийПользователь();
	ДокументОбъект.ВалютаДокумента = ВалютаРегл;
	ДокументОбъект.КурсДокумента = КурсыРегл.Курс;
	ДокументОбъект.КурсВалютыУпр = КурсыУпр.Курс;
	ДокументОбъект.ОстатокНаНачало = ИтогиТЧ.СальдоНачДеб - ИтогиТЧ.СальдоНачКр;
	ДокументОбъект.ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	ДокументОбъект.ХозОперация = Справочники.ХозОперации.АктСверкиВзаиморасчетов;
	ДокументОбъект.СверкаСогласована = Ложь;
	
	ДокументОбъект.ДатаНачала = РеквизитыЭлектронногоДокумента.ДатаНачала;
	ДокументОбъект.Датаокончания = РеквизитыЭлектронногоДокумента.Датаокончания;
	
КонецПроцедуры

Функция ДоговорПоСтрокеАктаСверки(ДокументОбъект, ДанныеДоговора)
	
	Результат = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Организация = ДокументОбъект.Организация;
	Контрагент = ДокументОбъект.Контрагент;
	НомерДоговора = ДанныеДоговора.Номер;
	ДатаДоговора = ДанныеДоговора.Дата;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДоговорПоСтрокеАктаСверки();
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Дата", ДатаДоговора);
	Запрос.УстановитьПараметр("Номер", НомерДоговора);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДоговорПоСтрокеАктаСверки()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТаблицаДоговорыВзаиморасчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ТаблицаДоговорыВзаиморасчетов
	|ГДЕ
	|	ТаблицаДоговорыВзаиморасчетов.Организация = &Организация
	|	И ТаблицаДоговорыВзаиморасчетов.Владелец = &Контрагент
	|	И ТаблицаДоговорыВзаиморасчетов.ДатаНачала = &Дата
	|	И ТаблицаДоговорыВзаиморасчетов.НомерДоговора = &Номер
	|	И НЕ ТаблицаДоговорыВзаиморасчетов.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции

