	|	ЕСТЬNULL(ИдентификаторДокументаВДиадокДокументОснование.Значение, """"),
	|	ЕСТЬNULL(ОтборКонтрагенты.ФормироватьУПД, ОтборОрганизации.ФормироватьУПД)
	|ИЗ
