// Получает сопоставление номенклатуры из устаревшего хранилища и переносит в актуальное.
//
// Параметры:
//  ВладелецНоменклатуры - СправочникСсылка.Контрагенты - контрагент-владелец номенклатуры;
//  ИдентификаторНоменклатуры - Строка - идентификатор номенклатуры контрагента;
// 
// Возвращаемое значение:
//  Структура - номенклатура информационной базы (сведения из устаревшего хранилища);
//  Неопределено - если сопоставление не найдено.
//
Функция ПеренестиСопоставлениеНоменклатуры_ПрайсЛистыКонтрагентов(ВладелецНоменклатуры, ИдентификаторНоменклатуры)
	
	НоменклатураИБ = ПолучитьНоменклатуруИнформационнойБазы_ПрайсЛистыКонтрагентов(
			ВладелецНоменклатуры,
			ИдентификаторНоменклатуры);
	
	Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
		
		КлючевыеПоля = Новый Структура;
		КлючевыеПоля.Вставить("Владелец", ВладелецНоменклатуры);
		КлючевыеПоля.Вставить("Идентификатор", ИдентификаторНоменклатуры);
		
		ДобавитьСопоставлениеНоменклатуры(
			КлючевыеПоля,
			НоменклатураИБ.Номенклатура,
			НоменклатураИБ.Характеристика
		);
		
	КонецЕсли;
	
	Возврат НоменклатураИБ;
	
КонецФункции

