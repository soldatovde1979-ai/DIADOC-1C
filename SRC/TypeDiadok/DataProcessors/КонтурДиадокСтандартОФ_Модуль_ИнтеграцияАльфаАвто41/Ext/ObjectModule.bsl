// Генерирует идентификатор строки табличной части документа.
// 
// Возвращаемое значение:
//  Строка - строковое представление уникального идентификатора.
//
Функция НовыйИдентификаторСтрокиТЧ()
	
	Результат = Строка(Новый УникальныйИдентификатор);
	Возврат Результат;
	
КонецФункции

// Формирует структуру для безопасного заполнения идентификатора строки табличной части учетного документа.
//
// Параметры:
//  ИдентификаторСтроки - Строка - (Необязательный) идентификатор строки табличной части.
//                                 Если не задан, формируется новый.
// 
// Возвращаемое значение:
//  Структура - содержит возможные имена свойств для записи идентификатора строки.
//
Функция ЗначенияЗаполненияИдентификатораСтрокиТЧ(Знач ИдентификаторСтроки = Неопределено)
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = НовыйИдентификаторСтрокиТЧ();
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторТовара", ИдентификаторСтроки);
	Результат.Вставить("ИдентификаторАвтомобиля", ИдентификаторСтроки);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьПоступленияТоваровУслуг(ДокументОбъект, ТабличнаяЧасть)
	
	ОбъектМетаданных = ДокументОбъект.Метаданные();
	ЕстьКодыМаркировки = ЕстьШтрихкодыУпаковок(ОбъектМетаданных);
	ВладелецНоменклатуры = ДокументОбъект.Контрагент;
	
	Для Каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		ИдентификаторСтроки = НовыйИдентификаторСтрокиТЧ();
		ЗначениеСвойстваИдентификатор = ЗначенияЗаполненияИдентификатораСтрокиТЧ(ИдентификаторСтроки);
		
		Номенклатура = Неопределено;
		Характеристика = Неопределено;
		
		НоменклатураИБ = СтрокаДанных.НоменклатураИнформационнойБазы;
		
		Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура = НоменклатураИБ.Номенклатура;
			Характеристика = НоменклатураИБ.Характеристика;
		КонецЕсли;
		
		СтрокаТЧ = ДокументОбъект.Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗначениеСвойстваИдентификатор);
		
		СтрокаТЧ.Номенклатура= Номенклатура;
		СтрокаТЧ.ХарактеристикаНоменклатуры = Характеристика;
		СтрокаТЧ.ЕдиницаИзмерения = ЕдиницаИзмеренияНоменклатуры(Номенклатура, СтрокаДанных.КодЕдИзм);
		СтрокаТЧ.Коэффициент = 1;
		
		СтрокаТЧ.СтавкаНДС = ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС);
		
		СтрокаТЧ.Количество			= СтрокаДанных.Количество;
		СтрокаТЧ.КоличествоБазовое 	= СтрокаТЧ.Количество * СтрокаТЧ.Коэффициент;
		СтрокаТЧ.Цена				= СтрокаДанных.Цена;
		СтрокаТЧ.Сумма				= СтрокаДанных.СуммаБезНДС;
		СтрокаТЧ.СуммаНДС			= СтрокаДанных.СуммаНДС;
		СтрокаТЧ.СуммаВсего			= СтрокаДанных.СуммаСНДС;
		
		ДокументОбъект.ОбработкаРеквизита("Товары.СуммаВсего", СтрокаТЧ);
		
		Если ЗначениеЗаполнено(СтрокаДанных.НомерГТД) Тогда
			СтранаПроисхождения = СтранаПоКлассификатору(СтрокаДанных.КодСтраны);
			СтрокаТЧ.ГТД = НайтиИлиСоздатьГТД(СтрокаДанных.НомерГТД, СтранаПроисхождения);
		КонецЕсли;
		
		Если ЕстьКодыМаркировки Тогда
			
			ДополнитьКодыМаркировки(
				ДокументОбъект.КодыМаркировки,
				СтрокаДанных.СведенияОМаркировке,
				ИдентификаторСтроки,
				СтрокаДанных.НоменклатураДокумента.GTIN
			);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

