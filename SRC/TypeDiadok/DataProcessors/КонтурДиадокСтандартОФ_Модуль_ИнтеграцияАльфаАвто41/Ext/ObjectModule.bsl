// 
// Возвращаемое значение:
//  Булево - Истина, если у объекта есть табличная часть "КодыМаркировки".
//
Функция ЕстьШтрихкодыУпаковок(ОбъектМетаданных)
	
	Результат = (ОбъектМетаданных.ТабличныеЧасти.Найти("КодыМаркировки") <> Неопределено);
