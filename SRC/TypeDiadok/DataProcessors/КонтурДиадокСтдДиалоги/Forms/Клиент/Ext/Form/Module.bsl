&НаКлиенте
Перем СтдКлиентЛок, СтдДиалогиСлужебный83Лок;

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Показывает диалог ввода даты
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры,
//                                                       которая будет вызвана после закрытия окна
//  Дата - Дата - Начальное значение даты, отображаемое в окне ввода
//  Подсказка - Строка - (Необязательный) Текст заголовка диалога ввода даты
//  ЧастьДаты - ЧастиДаты - (Необязательный) Вводимая в диалоге часть даты, если не указано, то ДатаВремя
//
&НаКлиенте
Процедура ПоказатьВводДатыЛок(ОписаниеОповещенияОЗавершении, Дата = Неопределено,
		Подсказка = "", ЧастьДаты = Неопределено) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
		
		Если ЧастьДаты = Неопределено Тогда
			ЧастьДатыСлужебный = ЧастиДаты.ДатаВремя;
		Иначе
			ЧастьДатыСлужебный = ЧастьДаты;
		КонецЕсли;
		
		Если Дата = Неопределено Тогда
			Результат = Дата(1, 1, 1);
		Иначе
			Результат = Дата;
		КонецЕсли;
		
		Если ВвестиДату(Результат, Подсказка, ЧастьДатыСлужебный) Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Результат);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Неопределено);
		КонецЕсли;
		
	Иначе
		
		СтдДиалогиСлужебный83().ПоказатьВводДатыЛок(
			ОписаниеОповещенияОЗавершении, Дата, Подсказка, ЧастьДаты);
		
	КонецЕсли;
	
КонецПроцедуры // ПоказатьВводДатыЛок

// Показывает диалог ввода значения заданного типа
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры,
//                                                       которая будет вызвана после закрытия окна ввода значения
//  Значение - Произвольный - Значение, которое будет использовано в качестве начального значения в диалоге
//  Подсказка - Строка - (Необязательный) Текст заголовка окна ввода значения.
//  Тип - Тип, ОписаниеТипов - (Необязательный) Тип вводимого значения.
//
&НаКлиенте
Процедура ПоказатьВводЗначенияЛок(ОписаниеОповещенияОЗавершении, Значение, Подсказка = "", Тип = Неопределено) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
		
		Если Тип = Неопределено Тогда
			ТипСлужебный = ТипЗнч(Значение);
		Иначе
			ТипСлужебный = Тип;
		КонецЕсли;
		
		Результат = Значение;
		
		Если ВвестиЗначение(Результат, Подсказка, ТипСлужебный) Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Результат);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Неопределено);
		КонецЕсли;
		
	Иначе
		
		СтдДиалогиСлужебный83().ПоказатьВводЗначенияЛок(
			ОписаниеОповещенияОЗавершении, Значение, Подсказка, ТипСлужебный);
		
	КонецЕсли;
	
КонецПроцедуры // ПоказатьВводЗначенияЛок

// Показывает диалог ввода строки
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                       после закрытия окна ввода строки
//  Строка - Строка - Начальное значение строки, отображаемое в окне ввода;
//  Подсказка - Строка - (Необязательный) текст заголовка диалога ввода строки;
//  Длина - Число - (Необязательный) длина вводимой строки, если не указан, то длина не ограничена;
//  Многострочность - Булево - (Необязательный) режим ввода многострочного текста,
//                             Истина ввод многострочного текста с разделителями строк,
//                             Ложь ввод простой строки;
//
&НаКлиенте
Процедура ПоказатьВводСтрокиЛок(ОписаниеОповещенияОЗавершении, Строка = "", Подсказка = "",
		Длина = 0, Многострочность = Ложь) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Строка;
		
		Если ВвестиСтроку(Результат, Подсказка, Длина, Многострочность) Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Результат);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Неопределено);
		КонецЕсли;
		
	Иначе
		
		СтдДиалогиСлужебный83().ПоказатьВводСтрокиЛок(
			ОписаниеОповещенияОЗавершении, Строка, Подсказка, Длина, Многострочность);
		
	КонецЕсли;
	
КонецПроцедуры // ПоказатьВводСтрокиЛок

// Показывает диалог ввода числа
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                       после закрытия окна
//  Число - Число - Начальное значение числа, отображаемое в окне ввода;
//  Подсказка - Строка - (Необязательный) текст заголовка диалога ввода числа;
//  Длина - Число - (Необязательный) длина вводимого числа включая дробную часть;
//  Точность - Число - (Необязательный) количество знаков дробной части, по умолчанию 0;
//
&НаКлиенте
Процедура ПоказатьВводЧислаЛок(ОписаниеОповещенияОЗавершении, Число, Подсказка = "", Длина = 0, Точность = 0) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Число;
		
		Если ВвестиЧисло(Результат, Подсказка, Длина, Точность) Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Результат);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Неопределено);
		КонецЕсли;
		
	Иначе
		
		СтдДиалогиСлужебный83().ПоказатьВводЧислаЛок(ОписаниеОповещенияОЗавершении, Число, Подсказка, Длина, Точность);
		
	КонецЕсли;
	
КонецПроцедуры // ПоказатьВводЧислаЛок

// Показывает на экране окно вопроса
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                       после закрытия окна
//  ТекстВопроса - Строка - Текст задаваемого вопроса;
//  Кнопки - РежимДиалогаВопрос, СписокЗначений - (Необязательный) задает состав и текст кнопок диалога,
//                                               а также, связанные с кнопками значения, по умолчанию ДаНетОтмена
//  Таймаут - Число - (Необязательный) время в секундах, в течении которого система ожидает ответа от пользователя
//  КнопкаДиалогаПоУмолчанию - Произвольный - Определяет кнопку по умолчанию
//  ЗаголовокДиалога - Строка - Содержит заголовок окна вопроса.
//  КнопкаТаймаута - Произвольный - (Необязательный) Определяет кнопку, на которой отображается количество секунд,
//                                  оставшихся до истечения таймаута.
//
&НаКлиенте
Процедура ПоказатьВопросЛок(ОписаниеОповещенияОЗавершении, ТекстВопроса, Кнопки, Таймаут = 0,
		КнопкаДиалогаПоУмолчанию = Неопределено, ЗаголовокДиалога = "", КнопкаТаймаута = Неопределено) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
		
		Ответ = Вопрос(ТекстВопроса, Кнопки, Таймаут, КнопкаДиалогаПоУмолчанию, ЗаголовокДиалога, КнопкаТаймаута);
		
		СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, Ответ);
		
	Иначе
		
		СтдДиалогиСлужебный83().ПоказатьВопросЛок(ОписаниеОповещенияОЗавершении,
			ТекстВопроса, Кнопки, Таймаут, КнопкаДиалогаПоУмолчанию, ЗаголовокДиалога, КнопкаТаймаута);
		
	КонецЕсли;
	
КонецПроцедуры // ПоказатьВопросЛок

// Показывает на экране окно предупреждения
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                       после закрытия окна.
//  ТекстПредупреждения - Строка, ФорматированнаяСтрока - Текст предупреждения.
//  Таймаут - Число - Время в секундах, в течении которого система ожидает ответа от пользователя;
//  ЗаголовокДиалога - Строка - Содержит заголовок окна предупреждения.
//
&НаКлиенте
Процедура ПоказатьПредупреждениеЛок(ОписаниеОповещенияОЗавершении = Неопределено, // BSLLS:OrderOfParams-off
		ТекстПредупреждения, Таймаут = 0, ЗаголовокДиалога = "") Экспорт
	
	Если СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.3") Тогда
		СтдДиалогиСлужебный83().ПоказатьПредупреждениеЛок(ОписаниеОповещенияОЗавершении,
			ТекстПредупреждения, Таймаут, ЗаголовокДиалога);
	Иначе
		Предупреждение(ТекстПредупреждения, Таймаут, ЗаголовокДиалога);
		Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ПоказатьПредупреждениеЛок

// Показывает на экране окно оповещения
//
// Параметры:
//  Текст - Строка - Текст оповещения
//  ДействиеПриНажатии - Строка - (Необязательный) навигационная ссылка, показывается как гиперссылка,
//                                 при нажатии происходит переход по указанной ссылке
//  Пояснение - Строка - (Необязательный) пояснение оповещения
//  Картинка - Картинка - (Необязательный) картинка, которая будет показана в оповещении;
//  СтатусОповещенияПользователя - СтатусОповещенияПользователя - определяет важность оповещения пользователя,
//                                                    до версии 8.3.10 игнорируется (Необязательный)
//  КлючУникальности - Строка - (Необязательный) ключ уникальности оповещения, до версии 8.3.10 игнорируется
//
&НаКлиенте
Процедура ПоказатьОповещениеПользователяЛок(Текст = "", ДействиеПриНажатии = Неопределено, Пояснение = "",
		Картинка = Неопределено, СтатусОповещенияПользователя = Неопределено, КлючУникальности = "") Экспорт
	
	Если СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.10") Тогда
		СтдДиалогиСлужебный83().ПоказатьОповещениеПользователяЛок(Текст, ДействиеПриНажатии, Пояснение, Картинка,
			СтатусОповещенияПользователя, КлючУникальности);
	Иначе
		ПоказатьОповещениеПользователя(Текст, ДействиеПриНажатии, Пояснение, Картинка);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьОповещениеПользователяЛок

// Показывает в диалоге переданное значение, вид диалога зависит от типа переданного значения
//
// Параметры:
//  ОписаниеОповещенияОЗавершении - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                       после закрытия окна.
//  Значение - Произвольный - Значение любого типа, который может быть показан системой в диалоге.
//
&НаКлиенте
Процедура ПоказатьЗначениеЛок(ОписаниеОповещенияОЗавершении = Неопределено, Значение) Экспорт // BSLLS:OrderOfParams-off
	
	Если СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.3") Тогда
		СтдДиалогиСлужебный83().ПоказатьЗначениеЛок(ОписаниеОповещенияОЗавершении, Значение);
	Иначе
		ОткрытьЗначение(Значение);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьЗначениеЛок

// Показывает диалог выбора файла
//
// Параметры:
//  ДиалогВыбораФайла - ДиалогВыбораФайла - Открываемый диалог
//  ОписаниеОповещения - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                            после закрытия диалога выбора
//
&НаКлиенте
Процедура ПоказатьДиалогВыбораФайла(ДиалогВыбораФайла, ОписаниеОповещения) Экспорт
	
	Если ТипЗнч(ОписаниеОповещения) = Тип("ФиксированнаяСтруктура") Тогда
		Если ДиалогВыбораФайла.Выбрать() Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещения,
				ДиалогВыбораФайла.ВыбранныеФайлы);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещения, Неопределено);
		КонецЕсли;
	Иначе
		ДиалогВыбораФайла.Показать(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьДиалогВыбораФайла

// Показывает диалог редактирования расписания регламентного задания
//
// Параметры:
//  ДиалогРасписанияРегламентногоЗадания - ДиалогРасписанияРегламентногоЗадания - Предназначен для работы с диалогом
//                                                                                расписания регламентного задания.
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                     после завершения диалога.
//
&НаКлиенте
Процедура ПоказатьДиалогРасписанияРегламентногоЗадания(ДиалогРасписанияРегламентногоЗадания,
		ОписаниеОповещенияОЗакрытии) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗакрытии) = Тип("ФиксированнаяСтруктура") Тогда
		Если ДиалогРасписанияРегламентногоЗадания.ОткрытьМодально() Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии,
				ДиалогРасписанияРегламентногоЗадания.Расписание);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии, Неопределено);
		КонецЕсли;
	Иначе
		ДиалогРасписанияРегламентногоЗадания.Показать(ОписаниеОповещенияОЗакрытии);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьДиалогРасписанияРегламентногоЗадания

// Показывает диалог редактирования стандартного периода
//
// Параметры:
//  ДиалогРедактированияСтандартногоПериода - ДиалогРедактированияСтандартногоПериода - Предназначен для интерактивного
//                                                                             редактирования объекта СтандартныйПериод.
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения - Содержит описание процедуры, которая будет вызвана
//                                                     после завершения диалога.
//
&НаКлиенте
Процедура ПоказатьДиалогРедактированияСтандартногоПериода(ДиалогРедактированияСтандартногоПериода,
		ОписаниеОповещенияОЗакрытии) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗакрытии) = Тип("ФиксированнаяСтруктура") Тогда
		Если ДиалогРедактированияСтандартногоПериода.Редактировать() Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии,
				ДиалогРедактированияСтандартногоПериода.Период);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии, Неопределено);
		КонецЕсли;
	Иначе
		ДиалогРедактированияСтандартногоПериода.Показать(ОписаниеОповещенияОЗакрытии);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьДиалогРедактированияСтандартногоПериода

// Интерактивная установка пометок у элементов списка значений
//
// Параметры:
//  СписокЗначений - СписокЗначений - Список значений в котором необходимо проставить отметки.
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения - Содержит описание процедуры, которая
//                                                     будет вызвана после закрытия диалога.
//  Заголовок - Строка - Заголовок окна диалога.
//
&НаКлиенте
Процедура ПоказатьОтметкуЭлементовСпискаЗначений(СписокЗначений,
		ОписаниеОповещенияОЗакрытии, Заголовок = "") Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗакрытии) = Тип("ФиксированнаяСтруктура") Тогда
		Если СписокЗначений.ОтметитьЭлементы(Заголовок) Тогда
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии, СписокЗначений);
		Иначе
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии, Неопределено);
		КонецЕсли;
	Иначе
		СписокЗначений.ПоказатьОтметкуЭлементов(ОписаниеОповещенияОЗакрытии, Заголовок);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьОтметкуЭлементовСпискаЗначений

// Интерактивный выбор элементы списка значений
//
// Параметры:
//  СписокЗначений - СписокЗначений - Список значений из которого необходимо выбрать значение
//  ОписаниеОповещенияОЗакрытии - ОписаниеОповещения - см. функцию СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения()
//  Заголовок - Строка - (Необязательный) заголовок окна диалога
//  Элемент - ЭлементСпискаЗначений - (Необязательный) элемент списка значений для позиционирования по умолчанию
//
&НаКлиенте
Процедура ПоказатьВыборЭлементаСпискаЗначений(СписокЗначений,
		ОписаниеОповещенияОЗакрытии, Заголовок = "", Элемент = Неопределено) Экспорт
	
	Если ТипЗнч(ОписаниеОповещенияОЗакрытии) = Тип("ФиксированнаяСтруктура") Тогда
		СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗакрытии,
			СписокЗначений.ВыбратьЭлемент(Заголовок, Элемент));
	Иначе
		СписокЗначений.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗакрытии, Заголовок, Элемент);
	КонецЕсли;
	
КонецПроцедуры // ПоказатьВыборЭлементаСпискаЗначений

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

&НаКлиенте
Функция Инит(СтдКлиент) Экспорт
	
	СтдКлиентЛок = СтдКлиент;
	
	Возврат ЭтаФорма;
	
КонецФункции // Инит

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция СтдДиалогиСлужебный83()
	
	Если СтдДиалогиСлужебный83Лок = Неопределено Тогда
		СтдДиалогиСлужебный83Лок = ПолучитьФорму(ИмяФормы + "Служебный83");
	КонецЕсли;
	
	Возврат СтдДиалогиСлужебный83Лок;
	
КонецФункции // СтдДиалогиСлужебный83