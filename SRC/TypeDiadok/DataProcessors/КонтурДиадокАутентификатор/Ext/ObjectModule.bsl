Функция УдалитьПустыеЛок(Коллекция)

	Пустые = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			Пустые.Добавить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;    
	
	Для Каждого Элемент Из Пустые Цикл
		Коллекция.Удалить(Элемент);
	КонецЦикла; 
	
	Возврат Коллекция;
	
КонецФункции

Функция ХранилищеЭтоОбработка(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КоличествоЭлементов = 2;
	МассивЗначений = СтдСтр().СтрРазделитьЛок(Значение, ".");
	Если МассивЗначений.Количество() <> КоличествоЭлементов Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат МассивЗначений[0] = "DataProcessorObject" 
		Или МассивЗначений[0] = "ExternalDataProcessorObject"
		Или МассивЗначений[0] = "DataProcessorManager";
		
КонецФункции

Функция ХранилищеЭтоСправочник(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.Справочники.Найти(Значение) <> Неопределено;
	
