// КОД УСТРОЙСТВА

Функция КодУстройства() Экспорт
	
	ПараметрыЗапроса = ДевайКодСформироватьПараметры();
	Запрос = ЗапросКодУстройства(ПараметрыЗапроса);
	Результат = Коннектор().Post(СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс), Запрос.Параметры);
	Ответ = Коннектор().КакJson(Результат);
	
	Если Ответ.Получить("error") <> Неопределено Тогда
		ВызватьИсключение СтдСтр().СтрШаблонЛок("error: %1, TraceId: %2", Ответ.Получить("error"), 
			Результат.Заголовки.Получить("X-Kontur-Trace-Id"));
	КонецЕсли;
	
	Результат = РазобратьОтветКодУстройства(Ответ);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ДевайКодСформироватьПараметры() 
	
	Результат = Новый Соответствие;
	Результат.Вставить("client_id", КонфигурацияПриложения.Имя);
	Результат.Вставить("client_secret", КонфигурацияПриложения.Ключ);
	Результат.Вставить("scope", КонфигурацияПриложения.Разрешения);
	
	Возврат Результат;
	
КонецФункции

Функция РазобратьОтветКодУстройства(Ответ)
	
	Результат = МодельОтветКодУстройства();
	
	Результат.Код = Ответ.Получить("device_code");
	Результат.КодПользователя = Ответ.Получить("user_code");
	Результат.Ссылка = Ответ.Получить("verification_uri");
	Результат.СсылкаАвторизации = Ответ.Получить("verification_uri_complete");
	Результат.Интервал = Ответ.Получить("interval");
	Результат.ВремяЖизни = Ответ.Получить("expires_in");
	
	ВМиллисекундах = 1000;	
	Если ЗначениеЗаполнено(Результат.ВремяЖизни) Тогда
		Результат.УниверсальнаяДатаОкончания = ТекущаяУниверсальнаяДата() + Число(Результат.ВремяЖизни);
		Результат.УниверсальнаяДатаОкончанияМС = (Дата(1, 1, 1) - Результат.УниверсальнаяДатаОкончания) 
			* ВМиллисекундах * -1; 
	Иначе
		Результат.УниверсальнаяДатаОкончания = Дата(1, 1, 1);
		Результат.УниверсальнаяДатаОкончанияМС = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ТОКЕН ДОСТУПА

Функция Токен(КодУстройства)
	
	ПараметрыЗапроса = ТокенСформироватьПараметры(КодУстройства); 
	Запрос = ЗапросТокен(ПараметрыЗапроса);
	
	Результат = Коннектор().Post(СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс), Запрос.Параметры);
	Ответ = Неопределено;
	Если Результат.КодСостояния >= Коннектор().КодыСостоянияHTTP().НеверныйЗапрос_400 Тогда
		След = Результат.Заголовки.Получить("X-Kontur-Trace-Id");
		Попытка
			Ответ = Коннектор().КакJson(Результат);
		Исключение
			ВызватьИсключение СтдСтр().СтрШаблонЛок("error: %1, TraceId: %2", "Неизвестная ошибка", След);	
		КонецПопытки;
		Если ОтветСОшибкой(Ответ) Тогда
			ВызватьИсключение СтдСтр().СтрШаблонЛок("error: %1, TraceId: %2", Ответ.Получить("error"), След);
		КонецЕсли;
	КонецЕсли;
	
	Если Ответ = Неопределено Тогда
		Ответ = Коннектор().КакJson(Результат);
	КонецЕсли;
	Результат = ТокенРазобратьОтвет(Ответ);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ТокенСформироватьПараметры(КодУстройства)
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("grant_type", КонфигурацияПровайдера.Тип);
	Результат.Вставить("client_id", КонфигурацияПриложения.Имя);
	Результат.Вставить("client_secret", КонфигурацияПриложения.Ключ);
	Результат.Вставить("scope", КонфигурацияПриложения.Разрешения);
	Результат.Вставить("device_code", КодУстройства);
	
	УдалитьПустыеЛок(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ТокенРазобратьОтвет(Ответ)
	
	Результат = МодельОтветТокен();
	
	ДанныеТокена = КакJwt(Ответ.Получить("id_token"));
	
	Результат.ТокенДоступа = Ответ.Получить("access_token");
	Результат.ТокенОбновления = Ответ.Получить("refresh_token");
	Результат.ВремяЖизни = Ответ.Получить("expires_in");
	Результат.Тип = Ответ.Получить("token_type");
	Результат.ПортальныйИд = ДанныеТокена.Тело.Получить("sub");
	Результат.Имя = ДанныеТокена.Тело.Получить("given_name");
	Результат.Фамилия = ДанныеТокена.Тело.Получить("family_name");
	Результат.Отчество = ДанныеТокена.Тело.Получить("middle_name");
	Результат.ФИО = ДанныеТокена.Тело.Получить("name");
	Результат.Телефон = ДанныеТокена.Тело.Получить("phone_number");
	Результат.Почта = ДанныеТокена.Тело.Получить("email");
	
	ВМиллисекундах = 1000;	
	Если ЗначениеЗаполнено(Результат.ВремяЖизни) Тогда
		Результат.УниверсальнаяДатаОкончания = ТекущаяУниверсальнаяДата() + Число(Результат.ВремяЖизни);
		Результат.УниверсальнаяДатаОкончанияМС = (Дата(1, 1, 1) - Результат.УниверсальнаяДатаОкончания) 
			* ВМиллисекундах * -1; 
	Иначе
		Результат.УниверсальнаяДатаОкончания = Дата(1, 1, 1);
		Результат.УниверсальнаяДатаОкончанияМС = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ВалидацияСессии(Знач Сессия)
	
	Если ТипЗнч(Сессия) = Тип("Структура") Тогда
		Сессия = Новый ФиксированнаяСтруктура(Сессия);
	КонецЕсли;

	Если СессияВалидна(Сессия) = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Если ТребуетсяОбновитьСессию(Сессия) Тогда
		Результат = ОбновитьСессию(Сессия);
	ИначеЕсли СессияЗавершена(Сессия) Или ТокенОтозван(Сессия.ТокенДоступа) Тогда
		Результат = Неопределено;
	Иначе
		Результат = Сессия;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ТребуетсяОбновитьСессию(Сессия)
	
	ОбновитьСессию = СессияЗавершена(Сессия) И ЗначениеЗаполнено(Сессия.ТокенОбновления);
	
	Если КонфигурацияПриложения.ПроверятьАктуальностьТокена Тогда
		ТокенОтозван = ТокенОтозван(Сессия.ТокенДоступа);
	Иначе
		ТокенОтозван = Ложь;
	КонецЕсли;
	
	Возврат ОбновитьСессию И Не ТокенОтозван;
	
КонецФункции

Функция СессияЗавершена(Сессия)

	Возврат  ТекущаяУниверсальнаяДата() >= Сессия.УниверсальнаяДатаОкончания;
	
КонецФункции

// ТОКЕН ОБНОВЛЕНИЯ

Функция _ОбновитьСессию(Сессия)
	
	ПараметрыЗапроса = ОбновитьСессиюСформироватьПараметры(Сессия.ТокенОбновления);
	Запрос = ЗапросТокен(ПараметрыЗапроса);
	
	Результат = Коннектор().Post(СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс), Запрос.Параметры);
	Ответ = Коннектор().КакJson(Результат);
	
	Если ОтветСОшибкой(Ответ) Тогда
		ВызватьИсключение СтдСтр().СтрШаблонЛок("error: %1, TraceId: %2", Ответ.Получить("error"), 
			Результат.Заголовки.Получить("X-Kontur-Trace-Id"));
	КонецЕсли;
	
	Результат = ТокенРазобратьОтвет(Ответ);
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ОбновитьСессиюСформироватьПараметры(ТокенОбновления)
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("grant_type", "refresh_token");
	Результат.Вставить("client_id", КонфигурацияПриложения.Имя);
	Результат.Вставить("client_secret", КонфигурацияПриложения.Ключ);	
	Результат.Вставить("refresh_token", ТокенОбновления);
	
	Возврат Результат;
	
КонецФункции

// ПРОВЕРИТЬ ТОКЕН

Функция ТокенОтозван(Токен)
	
	Если КонфигурацияПровайдера.Тип = ТипАутентификацииКодУстройства() Тогда
		Результат = ЗначениеЗаполнено(ДанныеПользователя(Токен).ПортальныйИд) = Ложь;
	ИначеЕсли КонфигурацияПровайдера.Тип = ТипАутентификацииКлиентУчетныеДанные() Тогда
		Попытка
			Результат = Не ДанныеТокена(Токен).Активный;	
		Исключение
			Результат = Истина;
		КонецПопытки;
	Иначе
		ВызватьИсключение СтдСтр().СтрШаблонЛок("Не ожидаемый тип конфигурации провайдера: %1", КонфигурацияПровайдера.Тип);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ДАННЫЕ ПОЛЬЗОВАТЕЛЯ

Функция ДанныеПользователя(Токен)

	Запрос = ЗапросДанныеПользователя(Токен);	
	
	URL = СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс);
	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = Коннектор().Post(URL, Запрос.Параметры, ДополнительныеПараметры);
	Если Результат.КодСостояния >= Коннектор().КодыСостоянияHTTP().НеверныйЗапрос_400 Тогда
		Возврат МодельОтветДанныеПользователя();
	КонецЕсли;
	
	Ответ = Коннектор().КакJson(Результат);
	
	Возврат ДанныеПользователяРазобратьОтвет(Ответ);
	
КонецФункции

Функция ЗапросДанныеПользователя(ТокенДоступа)
	
	Результат = МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization", СтдСтр().СтрШаблонЛок("Bearer %1", ТокенДоступа));
		
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/userinfo";
	Результат.Метод = "GET";
	Результат.Заголовки = Заголовки;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеПользователяРазобратьОтвет(Ответ)
	
	Результат = МодельОтветДанныеПользователя();
	Результат.ПортальныйИд = Ответ.Получить("sub");
	Результат.Имя = Ответ.Получить("name");
	Результат.Почта = Ответ.Получить("email");
	
	Возврат Результат;
	
КонецФункции

// АНАЛИЗ ТОКЕНА

Функция ДанныеТокена(Токен)

	ПараметрыЗапроса = ДанныеТокенаСформироватьПараметры(Токен);
	Запрос = ЗапросДанныеТокена(ПараметрыЗапроса);	
	
	URL = СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс);
	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = Коннектор().Post(URL, Запрос.Параметры, ДополнительныеПараметры);
	Если Результат.КодСостояния > Коннектор().КодыСостоянияHTTP().НеАвторизован_401 Тогда
		Возврат "Не удалось получить данные о токене";
	КонецЕсли;
	
	Ответ = Коннектор().КакJson(Результат);
	
	Возврат ДанныеТокенаРазобратьОтвет(Ответ);
	
КонецФункции

Функция ДанныеТокенаСформироватьПараметры(Токен)

	Результат = Новый Соответствие;
		
	Результат.Вставить("token", Токен);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеТокенаРазобратьОтвет(Ответ)
	
	Результат = МодельОтветДанныеТокена();
	
	Результат.Активный = Ответ.Получить("active");
	Результат.ПортальныйИд = Ответ.Получить("sub");
	Результат.Ресурсы = Ответ.Получить("aud");
	Результат.Разрешения = Ответ.Получить("scope");
	Результат.ИмяПриложения = Ответ.Получить("client_id");
	Результат.Провайдер = Ответ.Получить("iss");
	
	Год = 1970;
	
	Если Ответ.Получить("auth_time") <> Неопределено Тогда
		Результат.УниверсальнаяДатаСоздания = Дата(Год, 1, 1, 1, 0, 0) + Ответ.Получить("auth_time");
	КонецЕсли;
	Если Ответ.Получить("nbf") <> Неопределено Тогда
		Результат.УниверсальнаяДатаВыдачи = Дата(Год, 1, 1, 1, 0, 0) + Ответ.Получить("nbf");
	КонецЕсли;
	Если Ответ.Получить("exp") <> Неопределено Тогда
		Результат.УниверсальнаяДатаОкончания = Дата(Год, 1, 1, 1, 0, 0) + Ответ.Получить("exp");
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// ОТОЗВАТЬ ТОКЕН

Процедура ОтозватьТокен(Сессия)
		
	// Токен доступа
	
	ПараметрыЗапроса = ОтозватьТокенСформироватьПараметры(Сессия.ТокенДоступа, "access_token");
	Запрос = ЗапросОтозватьТокен(ПараметрыЗапроса);
	
	URL = СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс);
	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = Коннектор().Post(URL, Запрос.Параметры, ДополнительныеПараметры);
	
	// Токен обновления
	
	Если ЗначениеЗаполнено(Сессия.ТокенОбновления) Тогда
		
		ПараметрыЗапроса = ОтозватьТокенСформироватьПараметры(Сессия.ТокенОбновления, "refresh_token");
		Запрос = ЗапросОтозватьТокен(ПараметрыЗапроса);
		
		URL = СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс);
		ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
		
		Результат = Коннектор().Post(URL, Запрос.Параметры, ДополнительныеПараметры);
		
	КонецЕсли;

КонецПроцедуры

Функция ОтозватьТокенСформироватьПараметры(Токен, Тип)

	Результат = Новый Соответствие;
	
	Результат.Вставить("token_type_hint", Тип);	
	Результат.Вставить("token", Токен);
	
	Возврат Результат;
	
КонецФункции

// ВЫХОД

Функция Выйти(Сессия)
	
	Если Не ЗначениеЗаполнено(Сессия.ПортальныйИд) Тогда
		ВызватьИсключение "Для отзыва всех токенов необходим портальный идентификатор пользователя";
	КонецЕсли;
	
	Запрос = ЗапросВыйти(Сессия);	
	
	URL = СтдСтр().СтрШаблонЛок("%1%2", Запрос.Хост, Запрос.Ресурс);
	ДополнительныеПараметры = Новый Структура("Заголовки", Запрос.Заголовки);
	
	Результат = Коннектор().Post(URL,, ДополнительныеПараметры);
	Успех = Результат.КодСостояния < Коннектор().КодыСостоянияHTTP().НеверныйЗапрос_400;
	
	Если Успех Тогда
		ХранилищеСессий().УдалитьСессию(ОтборСессий);
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

// ДРУГОЕ

Функция КакJwt(Знач Токен)  

	Токен = СтрЗаменить(Токен, "-", "+");
	Токен = СтрЗаменить(Токен, "_", "/");

	МассивДанных = СтдСтр().СтрРазделитьЛок(Токен, ".");
	Результат = Новый Структура;
	Результат.Вставить("Заголовок", Новый Соответствие);
	Результат.Вставить("Тело", Новый Соответствие);
	
	КоличествоЭлементовТокена = 3;
	
	Если МассивДанных.Количество() <> КоличествоЭлементовТокена Тогда
		Возврат Результат;
	КонецЕсли;
		
	Результат.Заголовок = Коннектор().JsonВОбъект(Base64Значение(МассивДанных[0] + Base64Постфикс(МассивДанных[0]))); 
	Результат.Тело = Коннектор().JsonВОбъект(Base64Значение(МассивДанных[1] + Base64Постфикс(МассивДанных[1])));
	
	Возврат Результат;
	
КонецФункции

Функция СтрокаКакДвоичныеДанные(Строка, КодировкаТекста_ = "UTF-8") Экспорт
	
	Если ВерсияСовместимостиБольшеРавно("8.3.10") Тогда
		
		ДвоичныеДанные = Вычислить("ПолучитьДвоичныеДанныеИзСтроки(Строка, КодировкаТекста_, Ложь)");
		
	Иначе
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла, КодировкаТекста_,, Истина);
		ЗаписьТекста.Записать(Строка);
		ЗаписьТекста.Закрыть();
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		
		УдалитьФайлы(ИмяВременногоФайла);
		
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
	
КонецФункции

Функция Base64Постфикс(СтрокаBase64)
	
	Результат = "";
	КоличествоСимволов = 4;
	КоличествоДополнительныхСимволов = КоличествоСимволов - (СтрДлина(СтрокаBase64) % КоличествоСимволов);

	Пока КоличествоДополнительныхСимволов > 0 Цикл
		
		Результат = Результат + "=";
		КоличествоДополнительныхСимволов = КоличествоДополнительныхСимволов - 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОтветСОшибкой(Ответ)
	
	Возврат Ответ.Получить("error") <> Неопределено И Ответ.Получить("error") <> "authorization_pending";
	
КонецФункции

Процедура ПроверитьКонфигурациюПриложения(Значение)
		
	Результат = ПроверитьКоллекцию(МодельКонфигурацияПриложения(), Значение);
	
	Если Результат.Количество() Тогда
		Ошибки = СтдСтр().СтрСоединитьЛок(Результат, ", ");
		Сообщение = СтдСтр().СтрШаблонЛок("При проверке конфигурации приложения обнаружены ошибки: %1", Ошибки);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКонфигурациюПровайдера(Значение)
	
	Результат = ПроверитьКоллекцию(МодельКонфигурацияПровайдера(), Значение);
	
	Если Результат.Количество() Тогда
		Ошибки = СтдСтр().СтрСоединитьЛок(Результат, ", ");
		Сообщение = СтдСтр().СтрШаблонЛок("При проверке конфигурации провайдера обнаружены ошибки: %1", Ошибки);
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьКоллекцию(Модель, Коллекция)
	
	Ошибки = Новый Массив;
	Для Каждого Элемент Из Модель Цикл
		Если Элемент.Ключ = "Опции" Тогда
			Продолжить;
		КонецЕсли;
		Если Коллекция.Свойство(Элемент.Ключ) = Ложь Тогда
				Ошибки.Добавить(СтдСтр().СтрШаблонЛок("Не найден ключ: %1", Элемент.Ключ));
				Продолжить;
		КонецЕсли;
		Если ЗначениеКоллекцииЗаполнено(Коллекция[Элемент.Ключ]) = Ложь Тогда
				Ошибки.Добавить(СтдСтр().СтрШаблонЛок("Пустое значение ключа: %1", Элемент.Ключ));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

Функция ЗначениеКоллекцииЗаполнено(Значение)
	
	ТипЗнч = ТипЗнч(Значение);
	
	Если ТипЗнч = Тип("Строка") Тогда
		Результат = Значение <> "";
	ИначеЕсли ТипЗнч = Тип("Массив") Тогда
		Результат = Значение.Количество() > 0;
	ИначеЕсли Значение = Неопределено Тогда
		Результат = Ложь;
	ИначеЕсли ТипЗнч = Тип("Булево") Или ТипЗнч = Тип("Число") Тогда
		Результат = Истина;
	Иначе
		ВызватьИсключение "Неопределенный ключ конфигурации";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает контракт опций конифгурации приложения
//
// Возвращаемое значение:
//	- Структура:
// Ссылка - Строка - Наименование опциональной гиперссылки на основной форме. Необязательный
// ПредставлениеСсылки - Строка - Адрес перехода по опциональной ссылке на форме. Необязательный
//
Функция МодельОпции()

	Результат = Новый Структура;
	Результат.Вставить("Ссылка");
	Результат.Вставить("ПредставлениеСсылки");
	
	Возврат Результат;
	
КонецФункции

