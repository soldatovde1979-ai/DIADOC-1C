// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Получает текущую сессию из хранилища и проверяет её валидность.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Данные валидной сессии.
//                          См. МодельОтветТокен.
//  Неопределено - Если сессия отсутствует или невалидна.
//
Функция ПолучитьСессию() Экспорт
	
	Выборка = ХранилищеСессий().ВыбратьСессии(ОтборСессий);	
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сессия = МодельОтветТокен();
	ЗаполнитьЗначенияСвойств(Сессия, Выборка);
	
	Сессия = Новый ФиксированнаяСтруктура(Сессия);	
	Возврат ВалидацияСессии(Сессия);
		
КонецФункции

// Обновляет сессию и сохраняет её в хранилище, если она валидна.
//
// Параметры:
//  Сессия - ФиксированнаяСтруктура - Данные сессии для обновления.
//                                    См. МодельОтветТокен.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Обновлённые данные сессии, если обновление успешно.
//                          См. МодельОтветТокен.
//
Функция ОбновитьСессию(Сессия) Экспорт
	
	Если Не СессияВалидна(Сессия) Тогда
		ВызватьИсключение "Не удалось обновить сессию: сессия не валидна";
	КонецЕсли;
	
	Попытка
		Результат = _ОбновитьСессию(Сессия);
	Исключение
		Результат = Неопределено;
		ХранилищеСессий().УдалитьСессию(ОтборСессий);
	КонецПопытки;
	
	Если СессияВалидна(Результат) Тогда
		СохранитьСессию(Результат);
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

// Сохраняет данные сессии в хранилище.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Данные сессии для сохранения.
//                                     См. МодельОтветТокен.
//
Процедура СохранитьСессию(Значение) Экспорт 
	
	Модель = МодельОтветТокен();
	
	ЗаполнитьЗначенияСвойств(Модель, Значение);
	          
	Сессия = Новый ФиксированнаяСтруктура(Модель);
	ХранилищеСессий().СохранитьСессию(ОтборСессий, Сессия);
	
КонецПроцедуры

// Отправляет запрос провайдеру на отзыв токена.
//
Процедура ЗавершитьСессию() Экспорт
	
	Попытка
		Сессия = ПолучитьСессию();
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Сессия = Неопределено Тогда
		ВызватьИсключение "Не удалось найти сессию";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сессия.ПортальныйИд) Тогда
		Выйти(Сессия);
	Иначе
		ОтозватьТокен(Сессия);	
	КонецЕсли;
	
	ХранилищеСессий().УдалитьСессию(ОтборСессий);
	
КонецПроцедуры

// Возвращает интерфейс для работы с хранилищем сессий.
//
// Возвращаемое значение:
//	Произвольный - Зависит от конкретной реализации хранилища.
//
Функция ХранилищеСессий() Экспорт
	
	Если ХранилищеСессий = Неопределено Тогда
		ВызватьИсключение "Хранилище сессий не определенно";
	КонецЕсли;
	
	Возврат ХранилищеСессий;
	
КонецФункции

// Устанавливает свойство формы для использования указанной конфигурации приложения.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Конфигурация приложения.
//                                     См. МодельКонфигурацияПриложения.
//
Процедура УстановитьКонфигурациюПриложения(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);	
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки конфигурации приложения: ожидалась структура или фиксированная структура";
	КонецЕсли;
	
	ПроверитьКонфигурациюПриложения(Значение);
	
	КонфигурацияПриложения = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для использования указанной конфигурации провайдера.
//
// Параметры:
//  Значение - ФиксированнаяСтруктура - Конфигурация провайдера.
//                                     См. МодельКонфигурацияПровайдера.
//
Процедура УстановитьКонфигурациюПровайдера(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);	
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Ошибка установки конфигурации провайдера: ожидалась структура или фиксированная структура";	
	КонецЕсли;
	
	ПроверитьКонфигурациюПровайдера(Значение);
	
	КонфигурацияПровайдера = Значение;
	
КонецПроцедуры

// Устанавливает свойство формы для использования указанного объекта метаданных в качестве хранилища сессий.
//
// Параметры:
//  Значение - Строка - Имя объекта метаданных, используемого как хранилище сессий.
//                     Допустимые значения: "Обработка", "Справочник", "РегистрСведений", "ОбщийМодуль".
//
Процедура УстановитьХранилищеСессий(Значение = Неопределено) Экспорт
	
	Если Значение = Неопределено Тогда
		ХранилищеСессий = ХранилищеПоУмолчанию();
	Иначе
		Если ХранилищеЭтоОбработка(Значение) Тогда
			ХранилищеСессий = Новый(Значение);
		ИначеЕсли ХранилищеЭтоСправочник(Значение) Тогда
			ХранилищеСессий = Справочники[Значение];
		ИначеЕсли ХранилищеЭтоРегистрСведений(Значение) Тогда
			ХранилищеСессий = РегистрыСведений[Значение];
		ИначеЕсли ХранилищеЭтоОбщийМодуль(Значение) Тогда
			ХранилищеСессий = Вычислить(Значение);			
		Иначе
			ВызватьИсключение "Неопределенный тип хранилища сессией";
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

// Устанавливает свойство формы для использования отбора сессий. Устанавливать отбор необходимо после установки 
//	конфигурации приложения и провайдера, так как на основании этих данных собирается ключ объекта
//
// Параметры:
//  Значение - Структура, ФиксированнаяСтруктура - Модель зависит от реализации хранилища.
//							Аутентификатор добавит поле КлючОбъекта, если такое поле уже имеется, оно будет перезаписано
//
Процедура УстановитьОтборСессий(Знач Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		ВызватьИсключение "Пустое значение отбора сессией";	
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Значение = Новый ФиксированнаяСтруктура(Значение);
	КонецЕсли;

	ОтборСессий = Значение; 
	
КонецПроцедуры

// Возвращает контракт конифгурации приложения
//
// Возвращаемое значение:
//	- Структура: 
//		Имя - Строка - Имя приложения у провайдера
//		Ключ - Строка - Ключ приложения у провайдера
//		Разрешения - Строка - Набор запрашиваемых доступов
//		ПроверятьАктуальностьТокена - Булево - опция определения валидности токенна у провайдера
//      Опции - Структура - Контракт необязательных параметров. см. МодельОпции
//
Функция МодельКонфигурацияПриложения() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Имя");
	Результат.Вставить("Ключ");
	Результат.Вставить("Разрешения");
	Результат.Вставить("ПроверятьАктуальностьТокена", Ложь);
	Результат.Вставить("Опции", МодельОпции());
	
	Возврат Результат;
	
КонецФункции

// Возвращает контракт конифгурации провайдера
//
// Возвращаемое значение:
//	- Структура: 
//		Хост - Строка - Сервер провайдера
//		Тип - Строка - Тип получаемого токена: "urn:ietf:params:oauth:grant-type:device_code", "client_credentials"
//
Функция МодельКонфигурацияПровайдера() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Хост");
	Результат.Вставить("Тип");
	
	Возврат Результат;
	
КонецФункции

// Собирает ключ объекта аутентификатора по конифгурации приложения и конфигурации провайдера.
//
// Возвращаемое значение:
//	Строка - ключ объекта аутентификатора.
//
Функция СобратьКлючОбъекта() Экспорт
	
	Если ТипЗнч(КонфигурацияПриложения) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Не установлена конфигурация приложения";
	КонецЕсли;
	
	Если ТипЗнч(КонфигурацияПровайдера) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "Не установлена конфигурация провайдера";
	КонецЕсли;
	
	Разрешения = СортироватьРазрешения(КонфигурацияПриложения.Разрешения);
	Ключ = СтдСтр().СтрШаблонЛок("%1%2%3", КонфигурацияПриложения.Имя, НРег(КонфигурацияПровайдера.Хост), Разрешения);
	Ключ = СтдСтр().СтрШаблонЛок("%1%2%3", КонфигурацияПриложения.Имя, НРег(КонфигурацияПровайдера.Хост), Разрешения);
	Ключ = Base64Строка(СтрокаКакДвоичныеДанные(Ключ));
	
	Результат = СтрЗаменить(Ключ, Символ(КодСимвола(Символы.ПС)), "");
	Результат = СтрЗаменить(Результат, Символ(КодСимвола(Символы.ВК)), "");
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЙ ПРОГРАММНЫЙ ИНТЕРФЕЙС

Функция _НовыйКодУстройства() Экспорт
	
	Возврат КодУстройства();

КонецФункции

Функция _НоваяСессия(КодУстройства = Неопределено) Экспорт
	
	Если КодУстройства = Неопределено И КонфигурацияПровайдера.Тип <> ТипАутентификацииКлиентУчетныеДанные() Тогда
		ВызватьИсключение "Для данного типа аутентификации требуется код устройства";
	КонецЕсли;
	
	Результат = Токен(КодУстройства);	
	Если СессияВалидна(Результат) Тогда
		СохранитьСессию(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция _КонфигурацияПровайдераПоУмолчанию() Экспорт

	Результат = МодельКонфигурацияПровайдера();
	Результат.Хост = "https://identity.kontur.ru";
	Результат.Тип  = "urn:ietf:params:oauth:grant-type:device_code";
	
	Возврат Результат;
	
КонецФункции

// Возвращает Истина, если объект внешняя обработка, Иначе Ложь
//
// Возвращаемое значение:
//	- Булево
//
Функция _ЭтоВнешняяОбработка() Экспорт
	
	Если ЭтоВнешняяОбработкаКэш = Неопределено Тогда
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
			ЭтоВнешняяОбработкаКэш = Ложь;
		Иначе
			ЭтоВнешняяОбработкаКэш = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработкаКэш;
	
КонецФункции

// Возвращает данные компоненты
//
// Возвращаемое значение:
// - ДвоичныеДанные
//
Функция _ДанныеКомпонентыГенератораQr() Экспорт
	
	Если Не _КомпонентаГенератораQrЕсть() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьМакет(ИмяКомпонентыГенератораQr());
	
КонецФункции

// Если есть макет с компонентой для генерации Qr-кода, возвращает истина
//
// Возвращаемое значение:
// - Булево
//
Функция _КомпонентаГенератораQrЕсть() Экспорт

	Возврат Метаданные().Макеты.Найти(ИмяКомпонентыГенератораQr()) <> Неопределено;
	
КонецФункции

