// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// ЗАПРОСЫ

Функция ЗапросКодУстройства(ПараметрыЗапроса)
	
	Результат = МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/deviceauthorization";
	Результат.Метод = "POST";
	Результат.Заголовки = Заголовки;
	Результат.Параметры = ПараметрыЗапроса;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросТокен(ПараметрыЗапроса)
	
	Результат = МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/token";
	Результат.Метод = "POST";
	Результат.Заголовки = Заголовки;
	Результат.Параметры = ПараметрыЗапроса;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросОтозватьТокен(ПараметрыЗапроса)
	
	Результат = МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization", АвторизацияБазовая());
	
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/revocation";
	Результат.Метод = "POST";
	Результат.Заголовки = Заголовки;
	Результат.Параметры = ПараметрыЗапроса;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросДанныеТокена(ПараметрыЗапроса)
	
	Результат = МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization", АвторизацияБазовая());
		
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = "/connect/introspect";
	Результат.Метод = "GET";
	Результат.Заголовки = Заголовки;
	Результат.Параметры = ПараметрыЗапроса;
	
	Возврат Результат;
	
КонецФункции

Функция ЗапросВыйти(Сессия)
	
	Результат = МодельЗапрос();
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Kontur-Apikey", КонфигурацияПриложения.Ключ);
		
	Результат.Хост = КонфигурацияПровайдера.Хост;
	Результат.Ресурс = СтдСтр().СтрШаблонЛок("/grants/%1|%2/revoke", КонфигурацияПриложения.Имя, Сессия.ПортальныйИд);
	Результат.Метод = "POST";
	Результат.Заголовки = Заголовки;
	
	Возврат Результат;
	
КонецФункции

// ОПРЕДЕЛЕНИЯ

Функция МодельЗапрос()
	
	Результат = Новый Структура;
	Результат.Вставить("Хост");
	Результат.Вставить("Ресурс");
	Результат.Вставить("Метод");
	Результат.Вставить("Параметры");
	
	Результат.Вставить("Заголовки");
	
	Возврат Результат;
	
КонецФункции

Функция МодельОтветКодУстройства()
	
	Результат = Новый Структура;
	Результат.Вставить("Код");
	Результат.Вставить("КодПользователя");
	Результат.Вставить("Ссылка");
	Результат.Вставить("СсылкаАвторизации");
	Результат.Вставить("Интервал");
	Результат.Вставить("ВремяЖизни", 0);
