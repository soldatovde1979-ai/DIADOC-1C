		Результат = Новый("ExternalDataProcessorObject.КонтурДиадокАутентификаторХранилище");
	Иначе
		Результат = Новый("DataProcessorObject.КонтурДиадокАутентификаторХранилище");
	КонецЕсли;
	
	Возврат Результат;
		
