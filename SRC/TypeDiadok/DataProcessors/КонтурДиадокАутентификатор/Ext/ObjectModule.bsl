Функция АвторизацияБазовая()
	
	Ключ = СтдСтр().СтрШаблонЛок("%1:%2", КонфигурацияПриложения.Имя, КонфигурацияПриложения.Ключ);
	Значение = Base64Строка(СтрокаКакДвоичныеДанные(Ключ));
	Значение = СтрЗаменить(Значение, Символы.ПС, "");
	Значение = СтрЗаменить(Значение, Символы.ВК, "");
	
	Возврат Авторизация("Basic", Значение);
	
