Функция СессияВалидна(Сессия)
	
	Возврат ТипЗнч(Сессия) = Тип("ФиксированнаяСтруктура")
		И Сессия.Свойство("ТокенДоступа")
		И Не ПустаяСтрока(Сессия.ТокенДоступа)
		И Сессия.Свойство("Тип")
		И ЗначениеЗаполнено(Сессия.Тип);
		
КонецФункции

Функция СортироватьРазрешения(Разрешения)
	
	Массив = СтдСтр().СтрРазделитьЛок(Разрешения, " ");
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Массив);
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
	Возврат СтдСтр().СтрСоединитьЛок(Список.ВыгрузитьЗначения(), " "); 
	
КонецФункции

Функция ВерсияСовместимостиБольшеРавно(ВерсияСтрокой) Экспорт
	
		ВерсияСовместимостиБольшеРавно = Истина;
		Если Метаданные.РежимСовместимости = Неопределено Или Метаданные.РежимСовместимости
			= Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
			СистемнаяИнфо = Новый СистемнаяИнформация;
			Результат = СтдСтр().СравнитьВерсииЛок(СистемнаяИнфо.ВерсияПриложения, ВерсияСтрокой) >= 0;
		Иначе
			РежимСовместимости = Строка(Метаданные.РежимСовместимости);
			РежимСовместимости = СтрЗаменить(РежимСовместимости, "Версия", "");
			РежимСовместимости = СтрЗаменить(РежимСовместимости, "Version", "");
			РежимСовместимости = СтрЗаменить(РежимСовместимости, "_", ".");
			Результат = СтдСтр().СравнитьВерсииЛок(РежимСовместимости, ВерсияСтрокой) >= 0;
		КонецЕсли;

	Возврат Результат;
	
КонецФункции

