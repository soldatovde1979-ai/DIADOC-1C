// СТАВКИ НДС в proto.xsd (TaxRate)

// Преобразует XML-представление ставки НДС в значение прото
//
// Параметры:
//  НалСт - Строка - значение поля НалСт из XML
// 
// Возвращаемое значение:
//  Строка - значение ставки в терминах proto.xsd (см. Перечисление_TaxRate())
//
Функция TaxRate_Из_НалСт(Знач НалСт)
	
	Маппинг = Новый Соответствие;
	Маппинг.Вставить(НалСт_0(), TaxRate_0());
	Маппинг.Вставить(НалСт_5(), TaxRate_5());
	Маппинг.Вставить(НалСт_7(), TaxRate_7());
	Маппинг.Вставить(НалСт_9_09(), TaxRate_9_09());
	Маппинг.Вставить(НалСт_10(), TaxRate_10());
	Маппинг.Вставить(НалСт_16_67(), TaxRate_16_67());
	Маппинг.Вставить(НалСт_18_03(), TaxRate_18_03());
	Маппинг.Вставить(НалСт_18(), TaxRate_18());
	Маппинг.Вставить(НалСт_20(), TaxRate_20());
	Маппинг.Вставить(НалСт_22(), TaxRate_22());
	Маппинг.Вставить(НалСт_5_105(), TaxRate_5_105());
	Маппинг.Вставить(НалСт_7_107(), TaxRate_7_107());
	Маппинг.Вставить(НалСт_10_110(), TaxRate_10_110());
	Маппинг.Вставить(НалСт_18_118(), TaxRate_18_118());
	Маппинг.Вставить(НалСт_20_120(), TaxRate_20_120());
	Маппинг.Вставить(НалСт_22_122(), TaxRate_22_122());
	Маппинг.Вставить(НалСт_БезНДС(), TaxRate_БезНДС());
	Маппинг.Вставить(НалСт_НДСИсчисляетсяНалоговымАгентом(), TaxRate_ИсчНалАг());
	
	Результат = Маппинг.Получить(НалСт);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Ошибка = Общее_ПодставитьПараметрыВСтроку(
			"InvalidValue: Преобразование НалСт в TaxRate не выполнено (%1)",
			НалСт
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет значение TaxRate по сумме без налога и сумме налога
//
// Параметры:
//  СуммаБезНДС - Число - сумма без налога
//  СуммаНДС - Число - сумма налога
// 
// Возвращаемое значение:
//  Строка - значение TaxRate
//
Функция TaxRate_Рассчитать(СуммаБезНДС, СуммаНДС)
	
	Если НЕ ЗначениеЗаполнено(СуммаБезНДС) ИЛИ НЕ ЗначениеЗаполнено(СуммаНДС) Тогда
		Возврат TaxRate_БезНДС();
	КонецЕсли;
	
	РасчетнаяСтавка = 100 * СуммаНДС / СуммаБезНДС;
	
	Если РасчетнаяСтавка < 5 Тогда
		Возврат TaxRate_БезНДС();
	ИначеЕсли РасчетнаяСтавка < 14 Тогда
		Возврат TaxRate_10();
	ИначеЕсли РасчетнаяСтавка < 21 Тогда
		Возврат TaxRate_20();
	Иначе
		Возврат TaxRate_22();
	КонецЕсли;
	
КонецФункции

// Проверяет, входит ли указанное значение в список допустимых значений типа "TaxRate"
//
// Параметры:
//  TaxRate - Произвольный - Проверяемое значение
// 
// Возвращаемое значение:
//  Булево - Истина, если это строка из допустимого перечня ставок.
//
Функция TaxRate_ЭтоВалидноеЗначение(Знач TaxRate)
	
	Если ТипЗнч(TaxRate) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_0()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_5()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_7()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_10()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_20()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_22()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_5_105()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_7_107()));
	ДопустимыеЗначения.Добавить(ВРег(TaxRate_10_110()));
