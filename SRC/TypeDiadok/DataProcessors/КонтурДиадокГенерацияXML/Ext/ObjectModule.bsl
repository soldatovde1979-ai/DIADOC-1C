Процедура Заполнить_DigitalAttorneyInfo(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НомДовер") Тогда
		УстановитьЗначениеXDTO(Контент, "Number", Параметры.НомДовер);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаНач") Тогда
		УстановитьЗначениеXDTO(Контент, "Date", ДатаXML_в_Дата1С(Параметры.ДатаНач));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ВнНомДовер") Тогда
