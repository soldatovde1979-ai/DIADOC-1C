//
// Параметры:
//  СтрокаXDTO - ОбъектXDTO - элемент коллекции Документ.СодФХЖ2.РезПрием
// 
// Возвращаемое значение:
//  Массив из НовыйКлючЗначение.
//
Функция ПрочитатьТекстИнфТип423(СтрокаXDTO)
	
	Результат = Новый Массив;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СтрокаXDTO, "ИнфПолРезПрием") Тогда
