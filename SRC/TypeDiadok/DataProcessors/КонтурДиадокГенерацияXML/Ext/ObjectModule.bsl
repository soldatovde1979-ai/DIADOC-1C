	ФункцияСчета = "0";
	УстановитьЗначениеXDTO(Документ, "Функция", ФункцияСчета);
	
	XML_ФНС29_ЗаполнитьИнфПол(Документ, ПротоКонтент.AdditionalInfoId, ИмяПакетаXDTO);
	
	XML_ФНС29_ЗаполнитьСодСч(Документ, ПротоКонтент, ИмяПакетаXDTO, ПараметрыФормированияФайла);
	
	XML_УПД_970_ЗаполнитьПодписантов(ИмяПакетаXDTO, Документ, ПротоКонтент);

	Возврат Файл;
	
