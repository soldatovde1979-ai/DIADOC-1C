Функция XML_ПараметрыФормированияФайла() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДатаФормирования"		, ПолучитьТекущуюДатуСеанса());
	Результат.Вставить("УникальныйИдентификатор", Строка(Новый УникальныйИдентификатор));
	
	Результат.Вставить("ИдентификаторОтправителя", "");
	Результат.Вставить("ИдентификаторПолучателя", "");
	
	Результат.Вставить("ТочностьЦены"		, 2);
	Результат.Вставить("ТочностьКоличества"	, 3);
	
	Возврат Результат;
	
КонецФункции

