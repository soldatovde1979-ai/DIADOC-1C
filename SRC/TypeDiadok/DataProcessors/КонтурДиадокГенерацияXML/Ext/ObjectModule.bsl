Процедура Заполнить_AcceptanceCertificateBuyerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	Принял	 = Документ.СвАктИ.Принял;
	
	Заполнить_Signer(Контент, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Принял, "Претенз") Тогда
		УстановитьЗначениеXDTO(Контент, "Complaints", Принял.Претенз);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Принял, "ДатаЗаказ") Тогда
		УстановитьЗначениеXDTO(Контент, "SignatureDate", ДатаXML_в_Дата1С(Принял.ДатаЗаказ));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ.СвАктИ, "ИнфПол") И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ.СвАктИ.ИнфПол, "ТекстИнф") Тогда
		УстановитьЗначениеXDTO(Контент, "AdditionalInfo", Документ.СвАктИ.ИнфПол.ТекстИнф);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Принял, "ПодписьЗаказ") Тогда
		Заполнить_Official(Контент.Official, Принял.ПодписьЗаказ);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Принял, "ДоверенЗаказ") Тогда
		Заполнить_Attorney(Контент.Attorney, Принял.ДоверенЗаказ);
	КонецЕсли;
	
КонецПроцедуры

