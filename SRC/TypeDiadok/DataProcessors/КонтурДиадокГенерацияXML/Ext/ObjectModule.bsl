		НаименованиеРегиона = НаименованиеРегиона(Address820.RegionCode);
		УстановитьЗначениеXDTO(Результат.AddressRF, "Region", НаименованиеРегиона);
		
	ИначеЕсли ЗначениеЗаполнено(Address820.AddressText) Тогда
		
		Результат.Type = ВидыАдресов.АдресСтрокой;
		Результат.AddressText = НовыйProtoОбъектXDTO("AddressTextInfo");
		
		НаименованиеСтраны = НаименованиеСтраны(Address820.CountryCode);
		
		УстановитьЗначениеXDTO(Результат.AddressText, "Country", НаименованиеСтраны);
		УстановитьЗначениеXDTO(Результат.AddressText, "CountryCode", Address820.CountryCode);
		УстановитьЗначениеXDTO(Результат.AddressText, "AddressText", Address820.AddressText);
		
