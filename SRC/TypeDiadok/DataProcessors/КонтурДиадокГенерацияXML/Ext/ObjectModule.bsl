		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремФайлИнфИсп"	, ВремяФайла);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ИдФайлТН") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИдФайлТН"	, ИмяФайла);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаДокТН"	, ДатаФайла);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремДокТН"	, ВремяФайла);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ИдФайлАктИ") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИдФайлАктИ"	, ИмяФайла);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаДокАктИ", ДатаФайла);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремДокАктИ", ВремяФайла);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ИдФайлИнфПок") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИдФайлИнфПок"	, ИмяФайла);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаФайлИнфПок"	, ДатаФайла);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремФайлИнфПок"	, ВремяФайла);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФайлыПодписей) Тогда
		XML_ДобавитьФайлыЭлектронныхПодписей(ИмяПакетаXDTO, ОбъектXDTO, ФайлыПодписей)
	КонецЕсли;
	
КонецПроцедуры

