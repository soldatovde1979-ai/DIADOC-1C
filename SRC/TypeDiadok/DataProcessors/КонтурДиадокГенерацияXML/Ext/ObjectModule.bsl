		УстановитьЗначениеXDTO(Контент, "Type", ВидыАдресов.АдресСтрокой);
		
		Заполнить_AddressTextInfo(Контент.AddressText, Параметры.АдрИнф);
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "GLN", ПолучитьЗначениеXDTO(Параметры, "ГЛНМеста"));
	
