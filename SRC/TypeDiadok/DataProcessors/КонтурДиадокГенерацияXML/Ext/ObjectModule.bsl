Процедура XML_УПД_970_ЗаполнитьОсновныеСведенияОДокументе(Фабрика, Документ, ПротоКонтент, КНД, ПараметрыФормированияФайла)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "КНД") Тогда
		УстановитьЗначениеXDTO(Документ, "КНД", КНД);
	КонецЕсли;
	
	ДатаФормирования = Дата1С_в_ДатаXML(ПараметрыФормированияФайла.ДатаФормирования);
	ВремяФормирования = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=HH.mm.ss");
	
	УстановитьЗначениеXDTO(Документ, "ДатаИнфПр", ДатаФормирования);
	УстановитьЗначениеXDTO(Документ, "ВремИнфПр", ВремяФормирования);
	
	УстановитьЗначениеXDTO(Документ, "НаимЭконСубСост", ПротоКонтент.DocumentCreator);
	УстановитьЗначениеXDTO(Документ, "СоглСтрДопИнф", ПротоКонтент.ApprovedStructureAdditionalInfoFields);
	УстановитьЗначениеXDTO(Документ, "УИД", ПротоКонтент.DocumentUID);
	
	НомерДокумента = ПолучитьЗначениеXDTO(ПротоКонтент.DocumentCreatorBase, "Number");
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ОснДоверОргСост = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ОснДоверОргСост");	
		XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснДоверОргСост, ПротоКонтент.DocumentCreatorBase);
	КонецЕсли;
	
	XML_УПД_970_ЗаполнитьСведенияОДокументе(Документ, ПротоКонтент);
		
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, Документ, ПротоКонтент)
	
	TransferInfo = ПротоКонтент.TransferInfo;
	Фабрика	= XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	// Содержание факта хозяйственной жизни 3 (Обязателен при Функция=СЧФДОП или Функция=ДОП)
	Если ЗначениеЗаполнено(TransferInfo.OperationInfo) Тогда
		
		// Сведения о факте отгрузки товаров
		СвПродПер = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СвПродПер");
		СвПер = НовыйДочернийОбъектXDTO(Фабрика, СвПродПер, "СвПер");
		
		УстановитьЗначениеXDTO(СвПер, "СодОпер", TransferInfo.OperationInfo);
		УстановитьЗначениеXDTO(СвПер, "ВидОпер", TransferInfo.OperationType);
		
		Если ЗначениеЗаполнено(TransferInfo.TransferDate) Тогда
			ДатаОтгрузки = Дата1С_в_ДатаXML(TransferInfo.TransferDate); 
			УстановитьЗначениеXDTO(СвПер, "ДатаПер", ДатаОтгрузки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(TransferInfo.TransferStartDate) Тогда
			ДатаНачала = Дата1С_в_ДатаXML(TransferInfo.TransferStartDate);
			УстановитьЗначениеXDTO(СвПер, "ДатаНачПер", ДатаНачала);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(TransferInfo.TransferEndDate) Тогда
			ДатаОкончания = Дата1С_в_ДатаXML(TransferInfo.TransferEndDate);
			УстановитьЗначениеXDTO(СвПер, "ДатаОконПер", ДатаОкончания);
		КонецЕсли;
		
		Если TransferInfo.WithoutTransferBase = Истина Тогда
			УстановитьЗначениеXDTO(СвПер, "БезДокОснПер", "1");
		ИначеЕсли ЗначениеЗаполнено(TransferInfo.TransferBases) Тогда
			Для Каждого TransferBase Из TransferInfo.TransferBases Цикл
				ОснПер = НовыйДочернийОбъектXDTO(Фабрика, СвПер, "ОснПер");
				XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснПер, TransferBase);
			КонецЦикла;
		КонецЕсли;
		
		Employee = TransferInfo.Employee;
		OtherIssuer = TransferInfo.OtherIssuer;
		
		Если ЗначениеЗаполнено(Employee.Surname) Тогда
			
			СвЛицПер = НовыйДочернийОбъектXDTO(Фабрика, СвПер, "СвЛицПер");
	
			РабОргПрод = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПер, "РабОргПрод");
			XML_УПД_970_ЗаполнитьРаботникаОрганизации(ИмяПакетаXDTO, РабОргПрод, Employee);
			
		ИначеЕсли ЗначениеЗаполнено(OtherIssuer.Surname) Тогда
			
			СвЛицПер = НовыйДочернийОбъектXDTO(Фабрика, СвПер, "СвЛицПер");

			ИнЛицо = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПер, "ИнЛицо");
			
			Если ЗначениеЗаполнено(OtherIssuer.EmployeePosition) Тогда
				ПредОргПер = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ПредОргПер");
				XML_УПД_970_ЗаполнитьПредставителяОрганизации(ИмяПакетаXDTO, ПредОргПер, TransferInfo.OtherIssuer);
			Иначе
				ФЛПер = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ФЛПер");
				XML_УПД_970_ЗаполнитьФизическоеЛицо(ИмяПакетаXDTO, ФЛПер, TransferInfo.OtherIssuer)
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(TransferInfo.TransferTextInfo)
			ИЛИ ЗначениеЗаполнено(TransferInfo.Incoterms)
			ИЛИ ЗначениеЗаполнено(TransferInfo.IncotermsVersion) Тогда
			
			ТранГруз = НовыйДочернийОбъектXDTO(Фабрика, СвПер, "Тран");
			
			УстановитьЗначениеXDTO(ТранГруз, "СвТран", TransferInfo.TransferTextInfo);
			УстановитьЗначениеXDTO(ТранГруз, "Инкотермс", TransferInfo.Incoterms);
			УстановитьЗначениеXDTO(ТранГруз, "ВерИнкотермс", TransferInfo.IncotermsVersion);
			
		КонецЕсли;
		
		XML_УПД_970_ЗаполнитьСведенияОПередачеВещи(Фабрика, СвПер, TransferInfo);
		
		Если ЗначениеЗаполнено(TransferInfo.AdditionalInfoId.InfoFileId)
			ИЛИ ЗначениеЗаполнено(TransferInfo.AdditionalInfoId.StructedAdditionalInfos) Тогда
			
			ИнфПолФХЖ3 = НовыйДочернийОбъектXDTO(Фабрика, СвПродПер, "ИнфПолФХЖ3");
			
			УстановитьЗначениеXDTO(ИнфПолФХЖ3, "ИдФайлИнфПол", TransferInfo.AdditionalInfoId.InfoFileId);
			
			XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПолФХЖ3.ТекстИнф, TransferInfo.AdditionalInfoId.StructedAdditionalInfos);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСведенияОПередачеВещи(Фабрика, Контент, TransferInfo)
	
	CreatedThingTransferDoc = TransferInfo.CreatedThingTransferDoc;
	
	ЕстьДокументОПередачеВещи = (CreatedThingTransferDoc <> Неопределено
		И ЗначениеЗаполнено(CreatedThingTransferDoc.Name)
		И ЗначениеЗаполнено(CreatedThingTransferDoc.Number)
		И ЗначениеЗаполнено(CreatedThingTransferDoc.Date));
		
	ЗаполнитьТэгСвПерВещи = (ЕстьДокументОПередачеВещи
		Или ЗначениеЗаполнено(TransferInfo.CreatedThingTransferDate)
		Или ЗначениеЗаполнено(TransferInfo.CreatedThingInfo));
		
	Если ЗаполнитьТэгСвПерВещи Тогда
		
		СвПерВещи = НовыйДочернийОбъектXDTO(Фабрика, Контент, "СвПерВещи");
		
		УстановитьЗначениеXDTO(СвПерВещи, "СвПерВещ", TransferInfo.CreatedThingInfo);
		
		ДатаПередачи = Дата1С_в_ДатаXML(TransferInfo.CreatedThingTransferDate); 
		УстановитьЗначениеXDTO(СвПерВещи, "ДатаПерВещ", ДатаПередачи);
		
		Если ЕстьДокументОПередачеВещи Тогда
			ДокПерВещ = НовыйДочернийОбъектXDTO(Фабрика, СвПерВещи, "ДокПерВещ");
			XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ДокПерВещ, CreatedThingTransferDoc);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьРаботникаОрганизации(ИмяПакетаXDTO, ОбъектXDTO, Employee)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, Employee);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "Должность", Employee.EmployeePosition);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", Employee.EmployeeInfo);
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьПредставителяОрганизации(ИмяПакетаXDTO, ОбъектXDTO, OtherIssuer)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, OtherIssuer);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "Должность", OtherIssuer.EmployeePosition);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", OtherIssuer.EmployeeInfo);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", OtherIssuer.EmployeeInfo);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "НаимОргПер") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимОргПер", OtherIssuer.OrganizationName);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИННЮЛПер", OtherIssuer.Inn);
		
		XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОбъектXDTO.ОснДоверОргПер, OtherIssuer.OrganizationBase);
		
		XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОбъектXDTO.ОснПолнПредПер, OtherIssuer.EmployeeBase);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "НаимОргПрин") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимОргПрин", OtherIssuer.OrganizationName);
		
		Если ЗначениеЗаполнено(OtherIssuer.Inn) Тогда
			УстановитьЗначениеXDTO(ОбъектXDTO, "ИННОргПрин", OtherIssuer.Inn);
		Иначе
			
			ОснДоверОргПрин = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ОснДоверОргПрин");
			
			XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснДоверОргПрин, OtherIssuer.OrganizationBase);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(OtherIssuer.EmployeeBase.Name) Тогда
			
			ОснПолнПредПрин = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ОснПолнПредПрин");
			
			XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснПолнПредПрин, OtherIssuer.EmployeeBase);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьФизическоеЛицо(ИмяПакетаXDTO, ОбъектXDTO, OtherIssuer)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, OtherIssuer);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", OtherIssuer.EmployeeInfo);
	
	Если ЗначениеЗаполнено(OtherIssuer.Inn) Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИННФЛПрин", OtherIssuer.Inn);
	Иначе
		
		ОснДоверФЛ = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ОснДоверФЛ");
		
		XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснДоверФЛ, OtherIssuer.EmployeeBase);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, РеквДокТип, СведенияОДокументе)
	
	Если ЗначениеЗаполнено(СведенияОДокументе.Date) Тогда
		ДатаДокумента = Дата1С_в_ДатаXML(СведенияОДокументе.Date);
	Иначе
		ДатаДокумента = Неопределено;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(РеквДокТип, "РеквНаимДок", СведенияОДокументе.Name);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквНомерДок", СведенияОДокументе.Number);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквДатаДок", ДатаДокумента);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквИдФайлДок", СведенияОДокументе.FileID);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквИдДок", СведенияОДокументе.ID);
	УстановитьЗначениеXDTO(РеквДокТип, "РИдСистХранД", СведенияОДокументе.StorageID);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквУРЛСистДок", СведенияОДокументе.URL);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквДопСведДок", СведенияОДокументе.AdditionalInfo);
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	Для Каждого EconomicEntity Из СведенияОДокументе.EconomicEntities Цикл
		
		РеквИдРекСост = НовыйДочернийОбъектXDTO(Фабрика, РеквДокТип, "РеквИдРекСост");
		
		Если EconomicEntity.Type = ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			
			УстановитьЗначениеXDTO(РеквИдРекСост, "ИННЮЛ", EconomicEntity.Inn);
			
		ИначеЕсли EconomicEntity.Type = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель
			Или EconomicEntity.Type = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			
			УстановитьЗначениеXDTO(РеквИдРекСост, "ИННФЛ", EconomicEntity.Inn);
			
		ИначеЕсли EconomicEntity.Type = ВидыЮрФизЛиц.ОрганИсполнительнойВласти Тогда
			
			УстановитьЗначениеXDTO(РеквИдРекСост, "НаимОИВ", EconomicEntity.Name);
			
		ИначеЕсли EconomicEntity.Type = ВидыЮрФизЛиц.ИностраннаяОрганизация
			Или EconomicEntity.Type = ВидыЮрФизЛиц.ИностранныйГражданин Тогда
			
			ДаннИно = НовыйДочернийОбъектXDTO(Фабрика, РеквИдРекСост, "ДаннИно");
			
			XML_УПД_970_ЗаполнитьИдентификаторСтатусаИностранногоЮрФизЛица(EconomicEntity.Type, ДаннИно);
			
			УстановитьЗначениеXDTO(ДаннИно, "КодСтр", EconomicEntity.CountryCode);
			УстановитьЗначениеXDTO(ДаннИно, "НаимСтран", EconomicEntity.Country);
			УстановитьЗначениеXDTO(ДаннИно, "Наим", EconomicEntity.Name);
			УстановитьЗначениеXDTO(ДаннИно, "Идентиф", EconomicEntity.LegalEntityID);
			УстановитьЗначениеXDTO(ДаннИно, "ИныеСвед", EconomicEntity.OtherInfo);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция XML_УПД_970_ЭтоСпособПодтвержденияПолномочийЭлектроннойДоверенностью(ConfirmCredentials)

	Возврат (ConfirmCredentials = "3");
	
КонецФункции

Функция XML_УПД_970_ЭтоСпособПодтвержденияПолномочийДоверенностьюНаБумаге(ConfirmCredentials)
	
	Возврат (ConfirmCredentials = "5");
	
КонецФункции

Процедура XML_УПД_970_ЗаполнитьИдентификаторСтатусаИностранногоЮрФизЛица(ТипЮрФизЛица, ОбъектXDTO)

	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	Если ТипЮрФизЛица = ВидыЮрФизЛиц.ИностраннаяОрганизация Тогда
		ИдСтат = "ИО";
	Иначе
		ИдСтат = "ИГ";
	КонецЕсли;
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИдСтат", ИдСтат);
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСведенияОИностраннойОрганизации(ДаннИно, ПротоКонтент)
	
	XML_УПД_970_ЗаполнитьИдентификаторСтатусаИностранногоЮрФизЛица(ПротоКонтент.Type, ДаннИно);
	
	УстановитьЗначениеXDTO(ДаннИно, "Наим", ПротоКонтент.Name);
	УстановитьЗначениеXDTO(ДаннИно, "ИныеСвед", ПротоКонтент.OrganizationOrPersonInfo);
	УстановитьЗначениеXDTO(ДаннИно, "Идентиф", ПротоКонтент.LegalEntityId);
	УстановитьЗначениеXDTO(ДаннИно, "КодСтр", ПротоКонтент.CountryCode);
	УстановитьЗначениеXDTO(ДаннИно, "НаимСтран", ПротоКонтент.Country);

КонецПроцедуры

Функция XML_ТипПодписи(ТипПодписиПрото)

	ТипыПодписей = Перечисление_ТипыПодписей();
	
	Если ТипПодписиПрото = ТипыПодписей.Квалифицированная Тогда
		Результат = "1";	
	ИначеЕсли ТипПодписиПрото = ТипыПодписей.Простая Тогда
		Результат = "2";
	Иначе
		Результат = "3";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ОтветныйТитул_УПД_970_ЗаполнитьОсновныеСведенияФайла(Файл, ТитулПродавца, ПараметрыФормированияФайла)
	
	ВерсПрог = "Diadoc 1.0";
	ВерсияФормата = ТитулПродавца.ВерсФорм;
	
	ИдФайлПокупателя = XML_ОтветныйТитул_УПД_970_НовыйИдФайл(ТитулПродавца.ИдФайл, ПараметрыФормированияФайла);
	
	УстановитьЗначениеXDTO(Файл, "ИдФайл", ИдФайлПокупателя);
	УстановитьЗначениеXDTO(Файл, "ВерсПрог", ВерсПрог);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм", ВерсияФормата);
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_УПД_970_ЗаполнитьОсновныеДокумента(ДокументXDTO, ПротоКонтент, ТитулПродавца, ПараметрыФормированияФайла)
	
	Если ТитулПродавца.ВерсФорм = "5.03" Тогда
		ИмяПакетаXDTO = XML_ОтветныйТитул_УПД_970_ИмяПакета_5_03();
	Иначе
		ИмяПакетаXDTO = XML_ОтветныйТитул_УПД_970_ИмяПакета_5_02();
	КонецЕсли;
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	НалоговыйКод = XML_ОтветныйТитул_НалоговыйКод();
	УстановитьЗначениеXDTO(ДокументXDTO, "КНД", НалоговыйКод);
	
	УИД = ПолучитьЗначениеXDTO(ТитулПродавца.Документ, "УИД");
	УстановитьЗначениеXDTO(ДокументXDTO, "УИД", УИД);
	
	ДатаФормирования = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=dd.MM.yyyy");
	ВремяФормирования = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=HH.mm.ss");
	
	УстановитьЗначениеXDTO(ДокументXDTO, "ДатаИнфПок", ДатаФормирования);
	УстановитьЗначениеXDTO(ДокументXDTO, "ВремИнфПок", ВремяФормирования);
	
	Если ЗначениеЗаполнено(ПротоКонтент.DocumentCreator) Тогда
		УстановитьЗначениеXDTO(ДокументXDTO, "НаимЭконСубСост", ПротоКонтент.DocumentCreator);
	КонецЕсли;
	
	НомерДокумента = ПолучитьЗначениеXDTO(ПротоКонтент.DocumentCreatorBase, "Number");
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ОснДоверОргСост = НовыйДочернийОбъектXDTO(Фабрика, ДокументXDTO, "ОснДоверОргСост");
		XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснДоверОргСост, ПротоКонтент.DocumentCreatorBase);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_УПД_970_ЗаполнитьСведенияПродавца(ИмяПакетаXDTO, ИдИнфПрод, ТитулПродавца, ФайлыПодписейПродавца)
	
    ИмяФайлаПродавца = ТитулПродавца.ИдФайл;
	ДатаФайлаПродавца = ТитулПродавца.Документ.ДатаИнфПр;
	ВремяФайлаПродавца = ТитулПродавца.Документ.ВремИнфПр;

	XML_ОтветныйТитул_ЗаполнитьСведенияПродавца(ИмяПакетаXDTO, ИдИнфПрод
		, ИмяФайлаПродавца, ДатаФайлаПродавца, ВремяФайлаПродавца, ФайлыПодписейПродавца);

КонецПроцедуры

Процедура XML_ОтветныйТитул_УПД_970_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, СодФХЖ4, ПротоКонтент, ТитулПродавца)

	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ДатаДокумента = ТитулПродавца.Документ.СвСчФакт.ДатаДок;
	НомерДокумента = ТитулПродавца.Документ.СвСчФакт.НомерДок;
	
	НаименованиеДокумента = ТитулПродавца.Документ.НаимДокОпр;
	ФункцияДокумента = ТитулПродавца.Документ.Функция;
	
	УстановитьЗначениеXDTO(СодФХЖ4, "Функция", ФункцияДокумента);
	УстановитьЗначениеXDTO(СодФХЖ4, "ВидОпер", ПротоКонтент.OperationCode);
	УстановитьЗначениеXDTO(СодФХЖ4, "НаимДокОпрПр", НаименованиеДокумента);
	УстановитьЗначениеXDTO(СодФХЖ4, "ДатаДокИнфПр", Дата1С_в_ДатаXML(ДатаДокумента));
	УстановитьЗначениеXDTO(СодФХЖ4, "ПорНомДокИнфПр", НомерДокумента);
	
	СвПрин = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ4, "СвПрин");
	УстановитьЗначениеXDTO(СвПрин, "ДатаПрин",	Дата1С_в_ДатаXML(ПротоКонтент.AcceptanceDate));
	
	КодСодержанияОперации = XML_ОтветныйТитул_УПД_970_ЗначениеКодаСодержанияОперации(ПротоКонтент);
	
	Если ЗначениеЗаполнено(КодСодержанияОперации) Тогда
		
		КодСодОпер = НовыйДочернийОбъектXDTO(Фабрика, СвПрин, "КодСодОпер");
		УстановитьЗначениеXDTO(КодСодОпер, "КодИтога", КодСодержанияОперации);
		
		Если НЕ XML_ОтветныйТитул_РезультатПриемкиПринятоБезРазногласий(КодСодержанияОперации) Тогда
			XML_ОтветныйТитул_УПД_970_ЗаполнитьРеквизитыДокументаОРазногласиях(ПротоКонтент, КодСодОпер, Фабрика);
		КонецЕсли;
		
	КонецЕсли;
	
	OperationContent = ПолучитьЗначениеXDTO(ПротоКонтент, "OperationContent");
	Если ЗначениеЗаполнено(OperationContent)
		И НЕ XML_ОтветныйТитул_РезультатПриемкиНеПринято(КодСодержанияОперации) Тогда
		УстановитьЗначениеXDTO(СвПрин, "СодОпер", OperationContent);
	КонецЕсли;

	ЕстьСведенияОРаботнике = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "Employee")
		И ЗначениеЗаполнено(ПротоКонтент.Employee.Surname);
		
	ЕстьСведенияОбИномЛице = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "OtherIssuer")
		И ЗначениеЗаполнено(ПротоКонтент.OtherIssuer.Surname);
	
	Если ЕстьСведенияОРаботнике Или ЕстьСведенияОбИномЛице Тогда
		
		СвЛицПрин = НовыйДочернийОбъектXDTO(Фабрика, СвПрин, "СвЛицПрин");
		
		Если ЕстьСведенияОРаботнике Тогда
			
			РабОргПок = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПрин, "РабОргПок");
			XML_УПД_970_ЗаполнитьРаботникаОрганизации(ИмяПакетаXDTO, РабОргПок, ПротоКонтент.Employee);
			
		ИначеЕсли ЕстьСведенияОбИномЛице Тогда
			
			ИнЛицо = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПрин, "ИнЛицо");
			
			Если ЗначениеЗаполнено(ПротоКонтент.OtherIssuer.EmployeePosition) Тогда
				
				ПредОргПрин = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ПредОргПрин");
				XML_УПД_970_ЗаполнитьПредставителяОрганизации(ИмяПакетаXDTO, ПредОргПрин, ПротоКонтент.OtherIssuer);
				
			Иначе
				
				ФЛПрин = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ФЛПрин");
				XML_УПД_970_ЗаполнитьФизическоеЛицо(ИмяПакетаXDTO, ФЛПрин, ПротоКонтент.OtherIssuer)
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	XML_ЗаполнитьИнфоПоляФХЖ(ИмяПакетаXDTO, СодФХЖ4, ПротоКонтент.AdditionalInfoId, "ИнфПолФХЖ4", "Файл.Документ.СодФХЖ4.ИнфПолФХЖ4.ТекстИнф");
	
КонецПроцедуры

Функция XML_ОтветныйТитул_УПД_970_НовыйИдФайл(ИдФайлПродавца, ПараметрыФормированияФайла)
	
	ПрефиксИдФайла = "ON_NSCHFDOPPOK";
	
	ПредставлениеДатыФормирования = Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=yyyyMMdd");
	
	СведенияИдФайлПродавца = XML_СведенияИдФайлУПД970(ИдФайлПродавца);
	
	ЧастиИдФайл = Новый Массив;
	ЧастиИдФайл.Добавить(ПрефиксИдФайла);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ИдОтправителя);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ИдПолучателя);
	ЧастиИдФайл.Добавить(ПредставлениеДатыФормирования);
	ЧастиИдФайл.Добавить(ПараметрыФормированияФайла.УникальныйИдентификатор);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ПризнакЕстьПрослежка);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ПризнакЕстьМаркировка);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ПризнакЕстьАлкоголь);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ПризнакЕстьТабак);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.ПризнакЕстьНефтепродукты);
	ЧастиИдФайл.Добавить(СведенияИдФайлПродавца.СвободноеЗначение);
	
	Разделитель = "_";
	Результат = Общее_СоединитьСтроку(ЧастиИдФайл, Разделитель);
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ОтветныйТитул_УПД_970_ЗаполнитьРеквизитыДокументаОРазногласиях(ПротоКонтент, КодСодОпер, Фабрика)
	
	DiscrepDocument = ПолучитьЗначениеXDTO(ПротоКонтент.ContentOperCode, "DiscrepDocument");
	Если DiscrepDocument = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(DiscrepDocument.Name)
		И ЗначениеЗаполнено(DiscrepDocument.Name)
		И ЗначениеЗаполнено(DiscrepDocument.Date) Тогда
		
		РеквДокРасх = НовыйДочернийОбъектXDTO(Фабрика, КодСодОпер, "РеквДокРасх");
		XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, РеквДокРасх, DiscrepDocument);
		
	КонецЕсли;
	
КонецПроцедуры

