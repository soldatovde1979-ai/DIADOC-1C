// Конструктор описания номенклатуры электронного документа.
//
// Параметры:
//  Наименование - Строка - наименование номенклатуры.
//  Артикул - Строка - артикул номенклатуры.
//  Код - Строка - код номенклатуры.
//  Характеристика - Строка - наименование характеристики.
//  Идентификатор - Строка - идентификатор номенклатуры документа. Если не указан, формируется автоматически.
// 
// Возвращаемое значение:
//  Структура - см. Контракт_НоменклатураЭлектронногоДокумента.
//
Функция Новый_НоменклатураЭлектронногоДокумента(Идентификатор = "", Наименование = "", Артикул = "", Код = "", Характеристика = "") Экспорт
	
	ПустаяСтрока = "";
	
	Результат = Контракт_НоменклатураЭлектронногоДокумента();
	Результат.Идентификатор = Идентификатор;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		Результат.Наименование = Наименование;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Артикул) Тогда
		Результат.Артикул = Артикул;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Код) Тогда
		Результат.Код = Код;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Результат.Характеристика = Характеристика;
	КонецЕсли;
	
	ПроверитьЗаполнитьИдентификаторНоменклатуры(Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ЭДО_ЗаполнитьДанныеИзСпискаЭлементовXML(СтрокаТЧ, СписокXDTO, Источник1, Источник2, Приемник1, Приемник2)
	
	Если ТипЗнч(СписокXDTO) = Тип("СписокXDTO") Тогда
		
		Разделитель1 = "";
		Разделитель2 = "";
		
		СтрокаТЧ[Приемник1] = "";
		СтрокаТЧ[Приемник2] = "";
		
		Для Каждого СтрокаXDTO Из СписокXDTO Цикл
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СтрокаXDTO, Источник1) Тогда
				СтрокаТЧ[Приемник1] = СтрокаТЧ[Приемник1] + Разделитель1 + СтрокаXDTO[Источник1];
				Разделитель1 = "|";
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СтрокаXDTO, Источник2) Тогда
				СтрокаТЧ[Приемник2] = СтрокаТЧ[Приемник2] + Разделитель2 + СтрокаXDTO[Источник2];
				Разделитель2 = "|";
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(СписокXDTO) = Тип("ОбъектXDTO") Тогда
		
		СтрокаТЧ[Приемник1] = ПолучитьЗначениеXDTO(СписокXDTO, Источник1);
		СтрокаТЧ[Приемник2] = ПолучитьЗначениеXDTO(СписокXDTO, Источник2);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭДО_ЗаполнитьДопИнформациюСтрокиТЧ(СтрокаТЧ, ИнфоПоля)
	
	СтрокаТЧ.ДополнительнаяИнформация = _ФиксированныеДанные(ИнфоПоля);
	
	ЕстьУстаревшиеКолонки = (СтрокаТЧ.Владелец().Колонки.Найти("ДопИнформацияИд") <> Неопределено);
	
	Если НЕ ЕстьУстаревшиеКолонки Тогда
		Возврат;
	КонецЕсли;
	
	Разделитель = "";
	Ключи = "";
	Значения = "";
	
	Для Каждого КлючЗначение Из ИнфоПоля Цикл
		
		Ключи = Ключи + Разделитель + КлючЗначение.Ключ;
		Значения = Значения + Разделитель + КлючЗначение.Значение;
		
		Разделитель = "|";
		
	КонецЦикла;
	
	СтрокаТЧ.ДопИнформацияИд = Ключи;
	СтрокаТЧ.ДопИнформация = Значения;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировке(СведенияОМаркировке, СписокНомСредИдентТов)
	
	Для Каждого НомСредИдентТов Из СписокНомСредИдентТов Цикл
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(НомСредИдентТов, "ИдентТрансУпак") Тогда
			СведенияОМаркировке.ТранспортныеУпаковки.Добавить(НомСредИдентТов.ИдентТрансУпак);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(НомСредИдентТов, "КИЗ") Тогда
			ДобавитьВМассивЭлементыСпискаXDTO(СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки, СписокXDTOИзЭлемента(НомСредИдентТов, "КИЗ"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(НомСредИдентТов, "НомУпак") Тогда
			ДобавитьВМассивЭлементыСпискаXDTO(СведенияОМаркировке.ИндивидуальныеУпаковки, СписокXDTOИзЭлемента(НомСредИдентТов, "НомУпак"));
		КонецЕсли;
		
		КолВедМарк = ПолучитьЗначениеXDTO(НомСредИдентТов, "КолВедМарк");
		Если ЗначениеЗаполнено(КолВедМарк) Тогда
			СведенияОМаркировке.КоличествоТовараВУпаковке = XMLЗначение(Тип("Число"), КолВедМарк);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияПрослеживаемости(СведенияПрослеживаемости, СведПрослеж, ЭтоУКД)
	
	Для Каждого ЭлементСведПрослеж Из СведПрослеж Цикл
		
		СписокПолей	 = "НомТовПрослеж, ЕдИзмПрослеж, НаимЕдИзмПрослеж, КолВЕдПрослеж, ДопПрослеж, СтТовБезНДСПрослеж";
		Если ЭтоУКД = Истина Тогда
			СписокПолей = СписокПолей + ", ИзмКолЕдПТ";
		КонецЕсли; 
		
		СтрокаПрослеживаемости					 = Новый Структура(СписокПолей);
		СтрокаПрослеживаемости.НомТовПрослеж	 = ПолучитьЗначениеXDTO(ЭлементСведПрослеж, "НомТовПрослеж");
		СтрокаПрослеживаемости.ЕдИзмПрослеж		 = ПолучитьЗначениеXDTO(ЭлементСведПрослеж, "ЕдИзмПрослеж");
		СтрокаПрослеживаемости.НаимЕдИзмПрослеж	 = ПолучитьЗначениеXDTO(ЭлементСведПрослеж, "НаимЕдИзмПрослеж");
		СтрокаПрослеживаемости.КолВЕдПрослеж	 = ПолучитьЗначениеXDTO(ЭлементСведПрослеж, "КолВЕдПрослеж");
		СтрокаПрослеживаемости.ДопПрослеж		 = ПолучитьЗначениеXDTO(ЭлементСведПрослеж, "ДопПрослеж");
		СтрокаПрослеживаемости.СтТовБезНДСПрослеж = ПолучитьЗначениеXDTO(ЭлементСведПрослеж, "СтТовБезНДСПрослеж");
		
		Если ЭтоУКД = Истина 
			И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЭлементСведПрослеж, "ИзмКолЕдПТ") Тогда
			
			ЭлементИзмКолЕдПТ = ЭлементСведПрослеж.ИзмКолЕдПТ;
			СписокПолейИзмКолЕдПТ = "КолТовЕдПТДо, КолТовЕдПТПосле, КолТовЕдПТУвел, КолТовЕдПТУм";
			
			ИзмКолЕдПТ							 = Новый Структура(СписокПолейИзмКолЕдПТ);
			ИзмКолЕдПТ.КолТовЕдПТДо				 = ПолучитьЗначениеXDTO(ЭлементИзмКолЕдПТ, "КолТовЕдПТДо");
			ИзмКолЕдПТ.КолТовЕдПТПосле			 = ПолучитьЗначениеXDTO(ЭлементИзмКолЕдПТ, "КолТовЕдПТПосле");
			ИзмКолЕдПТ.КолТовЕдПТУвел			 = ПолучитьЗначениеXDTO(ЭлементИзмКолЕдПТ, "КолТовЕдПТУвел");
			ИзмКолЕдПТ.КолТовЕдПТУм				 = ПолучитьЗначениеXDTO(ЭлементИзмКолЕдПТ, "КолТовЕдПТУм");
			
			СтрокаПрослеживаемости.ИзмКолЕдПТ	 = ИзмКолЕдПТ;
			
		КонецЕсли;
		
		СведенияПрослеживаемости.Добавить(СтрокаПрослеживаемости);
		
	КонецЦикла;
	
КонецПроцедуры

