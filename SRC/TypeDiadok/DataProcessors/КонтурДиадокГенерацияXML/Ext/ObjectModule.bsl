Функция ItemMark(Код)
	
	// Соответствие ItemMark в терминах компоненты и ПрТовРаб в XML
	Результат = "NotSpecified";
	
	Если ЗначениеЗаполнено(Код) Тогда
		
		ВидыТоваров = Перечисление_ItemMarks();
		
		ItemMarks = Новый Соответствие;
		ItemMarks.Вставить("1", ВидыТоваров.Имущество);
		ItemMarks.Вставить("2", ВидыТоваров.Работа);
		ItemMarks.Вставить("3", ВидыТоваров.Услуга);
		ItemMarks.Вставить("4", ВидыТоваров.ИмущественныеПрава);
		ItemMarks.Вставить("5", ВидыТоваров.Иное);
		
		Результат = ItemMarks[Код];
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заглушка для обращения к множественным элементам XML,
// которые платформенный парсер распознал как единичные
//
Функция СписокXDTOИзЭлемента(Параметры, ИмяСвойства)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, ИмяСвойства) Тогда
		
		Элемент = Параметры[ИмяСвойства];
		
		Если ТипЗнч(Элемент) = Тип("СписокXDTO") Тогда
			Результат = Элемент;
		Иначе
			Результат = Новый Массив;
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	Иначе
		Результат = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДатаXML_в_Дата1С(Строка)
	
	Если ТипЗнч(Строка) = Тип("Дата") Тогда	
		Возврат Строка;
	КонецЕсли;
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат Дата(1, 1, 1);
	Иначе
		Возврат Дата(Прав(Строка, 4), Сред(Строка, 4, 2), Лев(Строка, 2));
	КонецЕсли;	
		
КонецФункции

// Преобразует строку длиной 19 и формата "22.04.2020 01.01.01" в дату 1С
//
Функция ДатаВремяXML_В_Дата1С(ДатаВремяXML)
	
	Если ТипЗнч(ДатаВремяXML) = Тип("Дата") Или ДатаВремяXML = Неопределено Тогда
		Возврат ДатаВремяXML;
	КонецЕсли;
	
	Если ПустаяСтрока(ДатаВремяXML) И СтрДлина(ДатаВремяXML) <> 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Год = Сред(ДатаВремяXML, 7, 4);
	Месяц = Сред(ДатаВремяXML, 4, 2);
	День = Лев(ДатаВремяXML, 2);
	Час = Сред(ДатаВремяXML, 12, 2);
	Минута = Сред(ДатаВремяXML, 15, 2);
	Секунда = Прав(ДатаВремяXML, 2);
	
	Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	
КонецФункции

