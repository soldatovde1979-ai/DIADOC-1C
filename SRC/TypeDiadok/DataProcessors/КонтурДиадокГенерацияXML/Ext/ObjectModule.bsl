Процедура Заполнить_TovTorgBuyerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СодФХЖ4 = Документ.СодФХЖ4;
	ГрузПолучил = СодФХЖ4.ГрузПолучил;
	
	УстановитьЗначениеXDTO(Контент, "DocumentCreator",		Документ.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "DocumentCreatorBase",	ПолучитьЗначениеXDTO(Документ, "ОснДоверОргСост"));
	УстановитьЗначениеXDTO(Контент, "OperationCode",		ПолучитьЗначениеXDTO(СодФХЖ4, "ВидОперации"));
	УстановитьЗначениеXDTO(Контент, "OperationContent",		ГрузПолучил.СодОпер);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ГрузПолучил, "ДатаПолуч") Тогда
		УстановитьЗначениеXDTO(Контент, "AcceptanceDate",	ДатаXML_в_Дата1С(ГрузПолучил.ДатаПолуч));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ГрузПолучил, "СвЛицПолГруз") Тогда
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ГрузПолучил.СвЛицПолГруз, "РабОргПок") Тогда
			Заполнить_Employee(Контент.Employee, ГрузПолучил.СвЛицПолГруз.РабОргПок);
		Иначе
			Заполнить_OtherIssuer(Контент.OtherIssuer, ГрузПолучил.СвЛицПолГруз.ИнЛицо);
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ4, "ИнфПолФХЖ4") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfo, СодФХЖ4.ИнфПолФХЖ4);
	КонецЕсли;
	
	Заполнить_ExtendedSigner(Контент.Signers, Документ, "Подписант");
	
КонецПроцедуры

