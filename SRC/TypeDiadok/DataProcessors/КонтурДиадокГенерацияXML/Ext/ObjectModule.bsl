	ВалидацияUTD970_ПроверитьИнфПолФХЖ1(Content, СписокПредупреждений);
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПроверитьИнфПолФХЖ1(Content, СписокПредупреждений)
	
	ИнфПолФХЖ1 = Content.AdditionalInfoId.StructedAdditionalInfos;
	
	ВидыТоваровДокумента = Content.СлужебнаяИнформация.ContentsDocumentProductsType;
	
	Если ВидыТоваровДокумента.ContainsAlcoholeProducts Тогда
		
		ОшибкиАлкогольнаяПродукция = ВалидацияUTD970_ПроверитьСоставИнфПолФХЖ1АлкогольнойПродукции(ИнфПолФХЖ1);
		
		Если ОшибкиАлкогольнаяПродукция.Количество() > 0 Тогда
			
			ВалидацияUTD970_ДобавитьШапкуПредупрежденияВалидацияИнфПолФХЖ1(СписокПредупреждений);
			
			Для Каждого Элемент Из ОшибкиАлкогольнаяПродукция Цикл
				СписокПредупреждений.Добавить(Элемент);
			КонецЦикла;
			
			ВалидацияUTD970_ДобавитьПодвалПредупрежденияВалидацияИнфПолФХЖ1(СписокПредупреждений);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВалидацияUTD970_ПроверитьСоставИнфПолФХЖ1АлкогольнойПродукции(ИнфПолФХЖ1)
	
	Результат = Новый Массив;
	
	Продавец_ФиасИД = УПД970_СвойствоПродавец_ФиасИД(ИнфПолФХЖ1);
	Покупатель_ФиасИД = УПД970_СвойствоПокупатель_ФиасИД(ИнфПолФХЖ1);
	НомерПеревозДок = УПД970_СвойствоНомерПеревозДок(ИнфПолФХЖ1);
	ДатаПеревозДок = УПД970_СвойствоДатаПеревозДок(ИнфПолФХЖ1);
	РегНомер = УПД970_СвойствоРегНомер(ИнфПолФХЖ1);
	НомерПеревозЭлДок = УПД970_СвойствоНомерПеревозЭлДок(ИнфПолФХЖ1);
	
	Если Продавец_ФиасИД.Количество() > 0 Тогда
		ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(Продавец_ФиасИД, Результат);
	КонецЕсли;
	
	Если Покупатель_ФиасИД.Количество() > 0 Тогда
		ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(Покупатель_ФиасИД, Результат);
	КонецЕсли;
	
	ЕстьДанныеЭлектронногоТранспортногоДокумента = (НомерПеревозЭлДок.Количество() > 0);
	ЕстьДанныеБумажногоТранспортногоДокумента = (НомерПеревозДок.Количество() > 0)
		И (ДатаПеревозДок.Количество() > 0)
		И (РегНомер.Количество() > 0);
	
	Если ЕстьДанныеБумажногоТранспортногоДокумента Тогда
		
		ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(НомерПеревозДок, Результат);
		ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(ДатаПеревозДок, Результат);
		ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(РегНомер, Результат);
		
	ИначеЕсли ЕстьДанныеЭлектронногоТранспортногоДокумента Тогда
		
		ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(НомерПеревозЭлДок, Результат);
		
	Иначе
		
		ТекстПредупреждения = "НомерПеревозЭлДок или НомерПеревозДок, ДатаПеревозДок, РегНомер";
		
		ВалидацияUTD970_ДобавитьПредупреждениеВалидацияИнфПолФХЖ1(Результат, ТекстПредупреждения);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ВалидацияUTD970_ПроверитьЭлементИнфПолФХЖ1АлкогольнойПродукции(Свойство, СписокОшибок)
	
	КлючСвойства = Свойство[0].Key;
	ЗначениеСвойства = Свойство[0].Value;
	
	Если ЗначениеСвойства = "-" Тогда
		ВалидацияUTD970_ДобавитьПредупреждениеВалидацияИнфПолФХЖ1(СписокОшибок, КлючСвойства);
	КонецЕсли;
	
КонецПроцедуры

