Процедура XML_ЗаполнитьИндивидуальногоПредпринимателяПодписанта(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, ПротоКонтент);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИННФЛ", ПротоКонтент.Inn);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "RegistrationCertificate") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "СвГосРегИП", ПротоКонтент.RegistrationCertificate);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "SoleProprietorRegistrationCertificate") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "СвГосРегИП", ПротоКонтент.SoleProprietorRegistrationCertificate);
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ИныеСвед") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", ПротоКонтент.SignerInfo);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьЮридическоеЛицоПодписанта(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, ПротоКонтент);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИННЮЛ", ПротоКонтент.Inn);
	УстановитьЗначениеXDTO(ОбъектXDTO, "Должн", ПротоКонтент.JobTitle);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "НаимОрг") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимОрг", ПротоКонтент.OrganizationName);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ИныеСвед") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", ПротоКонтент.SignerInfo);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ГосРегИПВыдДов") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "ГосРегИПВыдДов", ПротоКонтент.RegistrationCertificate);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ГосРегИППодп") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "ГосРегИППодп", ПротоКонтент.RegistrationCertificate);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ДобавитьФайлыЭлектронныхПодписей(ИмяПакетаXDTO, ОбъектXDTO, ФайлыПодписей)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	МассивФайлов = ЗначениеВМассив(ФайлыПодписей);
	
	Для каждого ФайлПодписи Из МассивФайлов Цикл
		
		НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ЭП", Base64СтрокаИзДвоичныхДанных(ФайлПодписи));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ЗаполнитьИнфоПоляФХЖ(ИмяПакетаXDTO, ОбъектXDTO, AdditionalInfoId, ИмяИнфоПоля, ТипОбъектаКоллекции = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(AdditionalInfoId.InfoFileId)
		И НЕ ЗначениеЗаполнено(AdditionalInfoId.StructedAdditionalInfos) Тогда
		Возврат;
	КонецЕсли;
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	// Информационное поле факта хозяйственной жизни
	ИнфПолФХЖ = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, ИмяИнфоПоля);
	УстановитьЗначениеXDTO(ИнфПолФХЖ, "ИдФайлИнфПол", AdditionalInfoId.InfoFileId);
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПолФХЖ.ТекстИнф, AdditionalInfoId.StructedAdditionalInfos, ТипОбъектаКоллекции);
	
КонецПроцедуры

Процедура XML_ЗаполнитьИнфПолТип(ИмяПакетаXDTO, ИнфПолТип, AdditionalInfoId)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ИнфПолТип, "ИдФайлИнфПол", ПолучитьЗначениеXDTO(AdditionalInfoId, "InfoFileId"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AdditionalInfoId, "AdditionalInfo") Тогда
		
		Для Каждого AdditionalInfo Из AdditionalInfoId.AdditionalInfo Цикл
			ТекстИнф = НовыйДочернийОбъектXDTO(Фабрика, ИнфПолТип, "ТекстИнф");
			XML_ЗаполнитьТекстИнфТип(ТекстИнф, AdditionalInfo);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьТекстИнфТип(ТекстИнфТип, AdditionalInfo)
	
	УстановитьЗначениеXDTO(ТекстИнфТип, "Идентиф", AdditionalInfo.Id);
	УстановитьЗначениеXDTO(ТекстИнфТип, "Значен", AdditionalInfo.Value);
	
КонецПроцедуры

Процедура XML_ЗаполнитьМасГрузТип(МасГрузТип, WeightCargo, ПараметрыФормированияФайла)
	
	ТочностьКоличества = ПараметрыФормированияФайла.ТочностьКоличества;
	
	УстановитьЗначениеXDTO(МасГрузТип, "МассаБр", XML_ФорматЧисла(WeightCargo.GrossWeight, ТочностьКоличества));
	УстановитьЗначениеXDTO(МасГрузТип, "МассаНет", XML_ФорматЧисла(WeightCargo.NetWeight, ТочностьКоличества));
	
КонецПроцедуры

Процедура XML_ЗаполнитьСопрДокТип(СопрДокТип, AccompanyingDocument)
	
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	ДатаСопрДок = ПолучитьЗначениеXDTO(AccompanyingDocument, "Date");
	
	УстановитьЗначениеXDTO(СопрДокТип, "НаимСопрДок", AccompanyingDocument.Name);
	УстановитьЗначениеXDTO(СопрДокТип, "НомСопрДок", ПолучитьЗначениеXDTO(AccompanyingDocument, "Number"));
	УстановитьЗначениеXDTO(СопрДокТип, "ДопИдСопрДок", ПолучитьЗначениеXDTO(AccompanyingDocument, "AdditionalIdentifier"));
	
	Если ЗначениеЗаполнено(ДатаСопрДок) Тогда
		УстановитьЗначениеXDTO(СопрДокТип, "ДатаСопрДок", Дата_В_Формат(ДатаСопрДок, ФорматДаты));
	КонецЕсли;

КонецПроцедуры

Процедура XML_ЗаполнитьРабОргПок(ИмяПакетаXDTO, РабОргПок, Employee)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, РабОргПок, "ФИО");
	
	УстановитьЗначениеXDTO(ФИО, "Фамилия", Employee.LastName);
	УстановитьЗначениеXDTO(ФИО, "Имя", Employee.FirstName);
	УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(Employee, "MiddleName"));
	
	УстановитьЗначениеXDTO(РабОргПок, "Должность", Employee.Position);
	УстановитьЗначениеXDTO(РабОргПок, "ИныеСвед", ПолучитьЗначениеXDTO(Employee, "EmployeeInfo"));
	УстановитьЗначениеXDTO(РабОргПок, "ОснПолн", ПолучитьЗначениеXDTO(Employee, "EmployeeBase"));
	
КонецПроцедуры

Процедура XML_ЗаполнитьИнЛицо(ИмяПакетаXDTO, ИнЛицо, OtherIssuer)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Должность = ПолучитьЗначениеXDTO(OtherIssuer, "Position");
	Если ЗначениеЗаполнено(Должность) Тогда
		
		ПредОргПер = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ПредОргПер");
		
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, ПредОргПер, "ФИО");
		
		УстановитьЗначениеXDTO(ФИО, "Фамилия", OtherIssuer.LastName);
		УстановитьЗначениеXDTO(ФИО, "Имя", OtherIssuer.FirstName);
		УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(OtherIssuer, "MiddleName"));
		
		УстановитьЗначениеXDTO(ПредОргПер, "Должность", Должность);
		УстановитьЗначениеXDTO(ПредОргПер, "ИныеСвед", ПолучитьЗначениеXDTO(OtherIssuer, "EmployeeInfo"));
		УстановитьЗначениеXDTO(ПредОргПер, "ОснПолнПредПрин", ПолучитьЗначениеXDTO(OtherIssuer, "EmployeeBase"));
		УстановитьЗначениеXDTO(ПредОргПер, "НаимОргПрин", ПолучитьЗначениеXDTO(OtherIssuer, "OrganizationName"));
		УстановитьЗначениеXDTO(ПредОргПер, "ОснДоверОргПрин", ПолучитьЗначениеXDTO(OtherIssuer, "OrganizationBase"));
		
	Иначе
		
		ФЛПрин = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ФЛПрин");
		
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, ФЛПрин, "ФИО");
		
		УстановитьЗначениеXDTO(ФИО, "Фамилия", OtherIssuer.LastName);
		УстановитьЗначениеXDTO(ФИО, "Имя", OtherIssuer.FirstName);
		УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(OtherIssuer, "MiddleName"));
		
		УстановитьЗначениеXDTO(ФЛПрин, "ИныеСвед", ПолучитьЗначениеXDTO(OtherIssuer, "EmployeeInfo"));
		УстановитьЗначениеXDTO(ФЛПрин, "ОснДоверФЛ", ПолучитьЗначениеXDTO(OtherIssuer, "EmployeeBase"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьПринТовТип(ИмяПакетаXDTO, ПринТовТип, AcceptedProductData, ПараметрыФормированияФайла)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ТочностьКоличества = ПараметрыФормированияФайла.ТочностьКоличества;
	ТочностьЦены = ПараметрыФормированияФайла.ТочностьЦены;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptedProductData, "ItemIdentificationNumbers") Тогда
		
		Для Каждого ItemIdentificationNumber Из AcceptedProductData.ItemIdentificationNumbers.ItemIdentificationNumber Цикл
			НомСредИдентТов = НовыйДочернийОбъектXDTO(Фабрика, ПринТовТип, "НомСредИдентТов");
			XML_Торг2_ЗаполнитьНомСредИдентТов(ИмяПакетаXDTO, НомСредИдентТов, ItemIdentificationNumber);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(ПринТовТип, "КолТовПрин", XML_ФорматЧисла(AcceptedProductData.Quantity, ТочностьКоличества));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptedProductData, "Price")
		И AcceptedProductData.Price <> Неопределено Тогда
		УстановитьЗначениеXDTO(ПринТовТип, "ЦенаПрин", XML_ФорматЧисла(AcceptedProductData.Price, ТочностьЦены));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptedProductData, "TaxRate")
		И AcceptedProductData.TaxRate <> Неопределено Тогда
		УстановитьЗначениеXDTO(ПринТовТип, "СтавНДСПрин", НалСт_Из_TaxRate(ПолучитьЗначениеXDTO(AcceptedProductData, "TaxRate")));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptedProductData, "Subtotal")
		И AcceptedProductData.Subtotal <> Неопределено Тогда
		УстановитьЗначениеXDTO(ПринТовТип, "СтоимТовНДСПрин", XML_ФорматЧисла(AcceptedProductData.Subtotal, ТочностьЦены));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptedProductData, "Vat")
		И AcceptedProductData.Vat <> Неопределено Тогда
		УстановитьЗначениеXDTO(ПринТовТип, "СумНДСПрин", XML_ФорматЧисла(AcceptedProductData.Vat, ТочностьЦены));
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьРасхТип(ИмяПакетаXDTO, РасхТип, DiscrepancyData, ПараметрыФормированияФайла)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ТочностьЦены = ПараметрыФормированияФайла.ТочностьЦены;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(DiscrepancyData, "ItemIdentificationNumbers") Тогда
		
		Для Каждого ItemIdentificationNumber Из DiscrepancyData.ItemIdentificationNumbers.ItemIdentificationNumber Цикл
			НомСредИдентТов = НовыйДочернийОбъектXDTO(Фабрика, РасхТип, "НомСредИдентТов");
			XML_Торг2_ЗаполнитьНомСредИдентТов(ИмяПакетаXDTO, НомСредИдентТов, ItemIdentificationNumber);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(РасхТип, "КолТовРасх", DiscrepancyData.Quantity);
	УстановитьЗначениеXDTO(РасхТип, "СтоимТовНДСРасх", XML_ФорматЧисла(DiscrepancyData.Subtotal, ТочностьЦены));
	УстановитьЗначениеXDTO(РасхТип, "СумНДСРасх", XML_ФорматЧисла(DiscrepancyData.Vat, ТочностьЦены));
	УстановитьЗначениеXDTO(РасхТип, "ПоясненияРасх", ПолучитьЗначениеXDTO(DiscrepancyData, "Explanations"));
	
КонецПроцедуры

Процедура XML_ЗаполнитьДельтаТип(ИмяПакетаXDTO, ДельтаТип, Delta, ПараметрыФормированияФайла)
	
	ТочностьЦены = ПараметрыФормированияФайла.ТочностьЦены;
	
	УстановитьЗначениеXDTO(ДельтаТип, "ДельтаЦена", XML_ФорматЧисла(Delta.Price, ТочностьЦены));
	УстановитьЗначениеXDTO(ДельтаТип, "ДельтаСтоимНДС", XML_ФорматЧисла(Delta.Subtotal, ТочностьЦены));
	УстановитьЗначениеXDTO(ДельтаТип, "ДельтаСумНДС", XML_ФорматЧисла(Delta.Vat, ТочностьЦены));
	УстановитьЗначениеXDTO(ДельтаТип, "ПояснДельта", ПолучитьЗначениеXDTO(Delta, "Explanations"));
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьНомСредИдентТов(ИмяПакетаXDTO, НомСредИдентТов, ItemIdentificationNumber)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ItemIdentificationNumber, "Unit") Тогда
		Для Каждого Unit Из ItemIdentificationNumber.Unit Цикл
			НомСредИдентТов.КИЗ.Добавить(Unit);
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ItemIdentificationNumber, "PackageId") Тогда
		Для Каждого PackageId Из ItemIdentificationNumber.PackageId Цикл
			НомСредИдентТов.НомУпак.Добавить(PackageId);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(НомСредИдентТов, "ИдентТрансУпак", ПолучитьЗначениеXDTO(ItemIdentificationNumber, "TransPackageId"));
	
КонецПроцедуры

