//#КонецОбласти ПубличныеКонтракты


// Рекурсивно преобразует коллекции в фиксированные коллекции
//
// Параметры:
//  Данные - Произвольный - данные для преобразования
// 
// Возвращаемое значение:
//  ФиксированныйМассив, ФиксированнаяСтруктура, ФиксированноеСоответствие
//
Функция _ФиксированныеДанные(Данные)
	
	// BSLLS:CyclomaticComplexity-off
	// BSLLS:CognitiveComplexity-off
	
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		
		Массив = Новый Массив;
		
		Для Каждого Значение Из Данные Цикл
			Если ТипЗнч(Значение) = Тип("Структура")
				ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
				ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
				Массив.Добавить(_ФиксированныеДанные(Значение));
			Иначе
				Массив.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		
		Результат = Новый ФиксированныйМассив(Массив);
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура")
		ИЛИ ТипЗнч(Данные) = Тип("Соответствие") Тогда
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Коллекция = Новый Структура;
		Иначе
			Коллекция = Новый Соответствие;
		КонецЕсли;
		
		Для Каждого КлючИЗначение Из Данные Цикл
			
			Значение = КлючИЗначение.Значение;
			Если ТипЗнч(Значение) = Тип("Структура")
				ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
				ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
				Коллекция.Вставить(КлючИЗначение.Ключ, _ФиксированныеДанные(Значение));
			Иначе
				Коллекция.Вставить(КлючИЗначение.Ключ, Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Результат = Новый ФиксированнаяСтруктура(Коллекция);
		Иначе
			Результат = Новый ФиксированноеСоответствие(Коллекция);
		КонецЕсли;
		
	Иначе
		Результат = Данные;
	КонецЕсли;
	
	Возврат Результат;
	
	// BSLLS:CyclomaticComplexity-on
	// BSLLS:CognitiveComplexity-on
	
КонецФункции // _ФиксированныеДанные

// КОНВЕРТАЦИЯ КОНТЕНТА 155 В 820

// Возвращает прото-контент титула продавца в формате 820, заполненный по данным контента в 155 формате
//
// Параметры:
//  Контент155	 - Структура - заполненная протоструктура ответного титула в 155 формате
//								(см. НовыйProtoОбъектXDTO("UtdSellerContent"))
//
// Возвращаемое значение:
//  ОбъектXDTO - заполненная протоструктура ответного титула в 155 формате
//							(см. НовыйProtoОбъектXDTO("UtdSellerContent"))
//
Функция УПД155_Конвертировать_в820(Знач Контент155) Экспорт
	
	Контент155вXDTO = НовыйProtoОбъектXDTO("UtdSellerContent");
	ЗаполнитьПротоКонтентXDTOПоСтруктуре(Контент155вXDTO, Контент155);
	
	Контент820 = ПолучитьUtd820SellerContentИзUtdSellerContent(Контент155вXDTO);
	
	Если Не ЗначениеЗаполнено(Контент155.Consignee.Type) Тогда
		Контент820.Consignees.Очистить();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контент155.Shipper.SameAsSeller)
		И Не ЗначениеЗаполнено(Контент155.Shipper.OrganizationInfo.Type) Тогда
		Контент820.Shippers.Очистить();
	КонецЕсли;
	
	InvoiceTableItems155 = Контент155.InvoiceTable.Items;
	Для ИндексСтроки = 0 По InvoiceTableItems155.ВГраница() Цикл
		
		Item155 = InvoiceTableItems155[ИндексСтроки];
		Item820 = Контент820.Table.Items[ИндексСтроки];
		
		Для Каждого ItemIdentificationNumber155 Из Item155.СлужебнаяИнформация.ItemIdentificationNumbers Цикл
			ItemIdentificationNumber820 = НовыйProtoОбъектXDTO("ItemIdentificationNumber");
			ЗаполнитьПротоКонтентXDTOПоСтруктуре(ItemIdentificationNumber820, ItemIdentificationNumber155);
			Item820.ItemIdentificationNumbers.Добавить(ItemIdentificationNumber820);
		КонецЦикла;
		
		Для Каждого ItemTracingInfo155 Из Item155.СлужебнаяИнформация.ItemTracingInfos Цикл
			ItemTracingInfo820 = НовыйProtoОбъектXDTO("ItemTracingInfo");
			ЗаполнитьПротоКонтентXDTOПоСтруктуре(ItemTracingInfo820, ItemTracingInfo155);
			Item820.ItemTracingInfos.Добавить(ItemTracingInfo820);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Контент820;
	
КонецФункции

// КОНВЕРТАЦИЯ КОНТЕНТА 820 В 155

// Возвращает прото-контент титула продавца в формате 155, заполненный по данным контента в 820 формате
//
// Параметры:
//  Контент820	 - Структура - заполненная протоструктура ответного титула в 820 формате
//							(см. НовыйProtoОбъектXDTO("Utd820SellerContent"))
//
// Возвращаемое значение:
//  Структура - заполненная протоструктура ответного титула в 155 формате
//							(см. НовыйProtoОбъектXDTO("UtdSellerContent"))
//
Функция УПД820_Конвертировать_в155(Знач Контент820) Экспорт
	
	Контент155 = ОбъектXDTOВСтруктуру(НовыйProtoОбъектXDTO("UtdSellerContent"));
	Контент820 = ОбъектXDTOВСтруктуру(Контент820);
	
	ЗаполнитьЗначенияСвойств(Контент155, Контент820, , "TransferInfo, PaymentDocuments");
	
	Контент155.Name = Контент820.DocumentName;
	Контент155.Date = Контент820.DocumentDate;
	Контент155.Number = Контент820.DocumentNumber;
	
	Контент155.Creator = Контент820.DocumentCreator;
	Контент155.CreatorBase = Контент820.DocumentCreatorBase;
	
	Если Контент820.Sellers.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Контент155.Seller, Контент820.Sellers[0]);
	КонецЕсли;
	
	Если Контент820.Buyers.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Контент155.Buyer, Контент820.Buyers[0]);
	КонецЕсли;
	
	Если Контент820.Consignees.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Контент155.Consignee, Контент820.Consignees[0]);
	КонецЕсли;
	
	Если Контент820.Shippers.Количество() > 0 Тогда
		
		Shipper820 = Контент820.Shippers[0];
		
		Контент155.Shipper.SameAsSeller = Shipper820.SameAsSeller;
		
		ЗаполнитьЗначенияСвойств(Контент155.Shipper.OrganizationInfo, Shipper820.OrganizationInfo);
		
	КонецЕсли;
	
	Для Каждого PaymentDocument820 Из Контент820.PaymentDocuments Цикл
		PaymentDocument155 = ОбъектXDTOВСтруктуру(НовыйProtoОбъектXDTO("PaymentDocument"));
		ЗаполнитьЗначенияСвойств(PaymentDocument155, PaymentDocument820);
		Контент155.PaymentDocuments.Добавить(PaymentDocument155);
	КонецЦикла;
	
	УПД820_КонвертироватьTransferInfo_в155(Контент155.TransferInfo, Контент820.TransferInfo);
	
	УПД820_КонвертироватьСведенияОТоварах_в155(Контент155, Контент820);
	
	Контент155.Вставить("ОшибкиВДанных", Контент820.ОшибкиВДанных);
	
	Возврат Контент155;
	
КонецФункции

// Заполняет в прото-источник данные, которые были "потеряны" при конвертации 820-155-820
//
// Параметры:
//  Приемник - ОбъектXDTO - контент документа в 820, полученный из 155
//  Источник - ОбъектXDTO - контент документа в 820 до конвертации в 155
//
Процедура УПД820_ВосстановитьДанныеПослеКонвертации_из155(Приемник, Источник) Экспорт

	Для Каждого DocumentShipment Из Источник.DocumentShipments Цикл
		НовыйDocumentShipment = НовыйЭлементСпискаXDTO(Приемник.DocumentShipments);
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НовыйDocumentShipment, DocumentShipment);
	КонецЦикла;
	
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(
		Приемник.SellerInfoCircumPublicProc,
		Источник.SellerInfoCircumPublicProc);
		
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(
		Приемник.MainAssignMonetaryClaim,
		Источник.MainAssignMonetaryClaim);
		
	УстановитьЗначениеXDTO(
		Приемник,
		"ApprovedStructureAdditionalInfoFields",
		Источник.ApprovedStructureAdditionalInfoFields);
		
	УстановитьЗначениеXDTO(Приемник, "CircumFormatInvoice", Источник.CircumFormatInvoice);
	
	УстановитьЗначениеXDTO(Приемник, "HyphenRevisionDate", Источник.HyphenRevisionDate);
	УстановитьЗначениеXDTO(Приемник, "HyphenRevisionNumber", Источник.HyphenRevisionNumber);
	
	Если Источник.TransferInfo <> Неопределено
		И Приемник.TransferInfo <> Неопределено Тогда
		
		УстановитьЗначениеXDTO(Приемник.TransferInfo, "TransferStartDate", Источник.TransferInfo.TransferStartDate);
		УстановитьЗначениеXDTO(Приемник.TransferInfo, "TransferEndDate", Источник.TransferInfo.TransferEndDate);
		
	КонецЕсли;

	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(
		Приемник.FactorInfo,
		Источник.FactorInfo);
		
	Если Источник.FactorInfo <> Неопределено
		И Приемник.FactorInfo <> Неопределено Тогда
		
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(
			Приемник.FactorInfo.Address,
			Источник.FactorInfo.Address);
			
	КонецЕсли;

КонецПроцедуры

Процедура УПД820_КонвертироватьTransferInfo_в155(TransferInfo155, TransferInfo820)
	
	ЗаполнитьЗначенияСвойств(TransferInfo155, TransferInfo820, , "TransferBases, Carrier");
	
	Для каждого TransferBase820 Из TransferInfo820.TransferBases Цикл
		
		TransferBase155 = ОбъектXDTOВСтруктуру(НовыйProtoОбъектXDTO("TransferBase"));
		
		ЗаполнитьЗначенияСвойств(TransferBase155, TransferBase820);
		
		Если TransferBase820.DocumentName = "Без документа-основания" Тогда
			TransferBase155.DocumentName = "Отсутствует";
		КонецЕсли;
		
		TransferInfo155.TransferBases.Добавить(TransferBase155);
		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(TransferInfo155.Carrier, TransferInfo820.Carrier);
	
КонецПроцедуры

Процедура УПД820_КонвертироватьСведенияОТоварах_в155(Контент155, Контент820)
	
	InvoiceTable155 = Контент155.InvoiceTable;
	
	ЗаполнитьЗначенияСвойств(InvoiceTable155, Контент820.Table, , "Items");
	
	Для Каждого Item820 Из Контент820.Table.Items Цикл
		
		Item155 = ОбъектXDTOВСтруктуру(НовыйProtoОбъектXDTO("ExtendedInvoiceItem"));
		
		ЗаполнитьЗначенияСвойств(Item155, Item820, , "СлужебнаяИнформация, CustomDeclarations");
		
		Item155.UnitCode = Item820.Unit;
		Item155.VendorCode = Item820.ItemVendorCode;
		Item155.ToRelease = Item820.ItemToRelease;
		
		Для Каждого CustomDeclaration820 Из Item820.CustomDeclarations Цикл
			CustomDeclaration155 = ОбъектXDTOВСтруктуру(НовыйProtoОбъектXDTO("CustomDeclaration"));
			ЗаполнитьЗначенияСвойств(CustomDeclaration155, CustomDeclaration820);
			Item155.CustomDeclarations.Добавить(CustomDeclaration155);
		КонецЦикла;
		
		Если Item820.WithoutVat = "true" Тогда
			Item155.TaxRate = "без НДС";
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Item155.СлужебнаяИнформация, Item820.СлужебнаяИнформация);
		
		Item155.СлужебнаяИнформация.Вставить("ItemTracingInfos", Item820.ItemTracingInfos);
		Item155.СлужебнаяИнформация.Вставить("ItemIdentificationNumbers", Item820.ItemIdentificationNumbers);
		
		Item820.СлужебнаяИнформация.Свойство("ЕдиницаИзмерения", Item155.ЕдиницаИзмеренияСсылка);
		
		InvoiceTable155.Items.Добавить(Item155);
		
	КонецЦикла;
	
КонецПроцедуры

// КОНВЕРТАЦИЯ КОНТЕНТА 820 В 970

// Возвращает прото-контент титула продавца в формате 970, заполненный по данным контента в 820 формате
//
// Параметры:
//  Контент820	 - Структура - заполненная протоструктура ответного титула в 820 формате
//							(см. НовыйProtoОбъектXDTO("Utd820SellerContent"))
//  ОшибкиКонвертации - Массив - ошибки конвертации
//		* Структура - см. НовоеОписаниеОшибкиКонвертации()
//
// Возвращаемое значение:
//  ОбъектXDTO - заполненная протоструктура ответного титула в 970 формате
//							(см. НовыйProtoОбъектXDTO("Utd970SellerContent"))
//
Функция УПД820_Конвертировать_в970(Знач Контент820, ОшибкиКонвертации) Экспорт
	
	Контент970 = НовыйProtoОбъектXDTO("Utd970SellerContent");

	ИсключаемыеСвойства = Новый Массив;
	ИсключаемыеСвойства.Добавить("CircumFormatInvoice");
	ИсключаемыеСвойства.Добавить("DocumentCreatorBase");
	ИсключаемыеСвойства.Добавить("Function");
	ИсключаемыеСвойства.Добавить("DocumentName");
	
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Контент970, Контент820, ИсключаемыеСвойства);
	
	Если ЗначениеЗаполнено(Контент820.DocumentCreatorBase) Тогда
		УПД820_ДобавитьОшибкуКонвертацииСведенийОрганизацииСоставителяФайла(ОшибкиКонвертации);
	КонецЕсли;
	
	ФункцияДокумента = УПД820_КонвертироватьЗначениеФункцииДокумента_в970(Контент820);
	УстановитьЗначениеXDTO(Контент970, "Function", ФункцияДокумента);
	
	ЗначениеСпецОбстоятельств = УПД820_КонвертироватьСпецОбстоятельствФормированияДокумента_в970(Контент820);
	УстановитьЗначениеXDTO(Контент970, "CircumFormatInvoice", ЗначениеСпецОбстоятельств);
	
	НаименованиеВалюты = НаименованиеВалюты(Контент970.Currency, Истина);
	УстановитьЗначениеXDTO(Контент970, "CurrencyName", НаименованиеВалюты);

	MainAssignMonetaryClaim = УПД820_КонвертироватьОснованиеУступкиДенТребования_в970(Контент820);
	УстановитьЗначениеXDTO(Контент970, "MainAssignMonetaryClaim", MainAssignMonetaryClaim);
	
	SellerInfoCircumPublicProc = УПД820_КонвертироватьСведенияОЗакупкахДляГосНужд_в970(Контент820);
	УстановитьЗначениеXDTO(Контент970, "SellerInfoCircumPublicProc", SellerInfoCircumPublicProc);
	
	AdditionalInfoId = УПД820_КонвертироватьИнформационныеПоляФХЖ_в970(Контент820.AdditionalInfoId);
	УстановитьЗначениеXDTO(Контент970, "AdditionalInfoId", AdditionalInfoId);
	
	УПД820_КонвертироватьСведенияОбУчастникахЭДО_в970(Контент820, Контент970);
	
	УПД820_КонвертироватьСведенияОТоварах_в970(Контент970, Контент820);
	
	TransferInfo = УПД820_КонвертироватьСведенияОПередачеТоваров_в970(Контент820.TransferInfo, ОшибкиКонвертации);
	УстановитьЗначениеXDTO(Контент970, "TransferInfo", TransferInfo);
	
	Для Каждого PaymentDocument820 Из Контент820.PaymentDocuments Цикл
		PaymentDocument = УПД820_КонвертироватьСведенияОДокументеОплаты_в970(PaymentDocument820);
		Контент970.PaymentDocuments.Добавить(PaymentDocument);
	КонецЦикла;
	
	УПД820_КонвертироватьСведенияОДокументахОтгрузки_в970(Контент820, Контент970, ОшибкиКонвертации);
	
	НаименованиеДокумента = УПД820_КонвертироватьНаименованиеДокумента_в970(Контент820, Контент970);
	УстановитьЗначениеXDTO(Контент970, "DocumentName", НаименованиеДокумента);
	
	Контент970.СлужебнаяИнформация = НовыйProtoОбъектXDTO("СлужебнаяИнформация");
	Для Каждого ОписаниеОшибки Из Контент820.ОшибкиВДанных Цикл
		НовоеОписаниеОшибки = НовыйProtoОбъектXDTO("ОшибкиВДанныхТип");
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НовоеОписаниеОшибки, ОписаниеОшибки);
		Контент970.СлужебнаяИнформация.ОшибкиВДанных.Добавить(НовоеОписаниеОшибки);
	КонецЦикла;
	
	ЕстьМаркировка = XML_УПД_970_ПризнакНаличияТоваровПодлежащихМаркировке(Контент970);
	ЕстьПрослежка = XML_УПД_970_ПризнакНаличияТоваровПодлежащихПрослеживаемости(Контент970);
	
	ContentsDocumentProductsType = Контент970.СлужебнаяИнформация.ContentsDocumentProductsType;
	ContentsDocumentProductsType.ContainsMarkedProducts = ЕстьМаркировка;
	ContentsDocumentProductsType.ContainsTraceableProducts = ЕстьПрослежка;
	
	Возврат Контент970;
	
КонецФункции

// Заполняет в прото-источник данные, которые были "потеряны" при конвертации 970-820*-970
//
// Параметры:
//  Приемник - ОбъектXDTO - контент документа в 970, полученный из 820
//  Источник - ОбъектXDTO - контент документа в 970 до конвертации в 820
//
Процедура УПД970_ВосстановитьДанныеПослеКонвертации_из820(Приемник, Источник) Экспорт

	ПризнакиТоваровВПриемнике = Приемник.СлужебнаяИнформация.ContentsDocumentProductsType;
	ПризнакиТоваровВИсточнике = Источник.СлужебнаяИнформация.ContentsDocumentProductsType;

	ПризнакиТоваровВПриемнике.ContainsAlcoholeProducts = ПризнакиТоваровВИсточнике.ContainsAlcoholeProducts;
	ПризнакиТоваровВПриемнике.ContainsPetroleumProducts = ПризнакиТоваровВИсточнике.ContainsPetroleumProducts;
	ПризнакиТоваровВПриемнике.ContainsTobaccoProducts = ПризнакиТоваровВИсточнике.ContainsTobaccoProducts;

КонецПроцедуры

Функция УПД820_КонвертироватьСпецОбстоятельствФормированияДокумента_в970(Контент820)
	
	Перем Результат;
	
	ФункцияДокумента = XML_УПД_ПолучитьФункцию(Контент820.Function);
	
	Если ФункцияДокумента = Перечисление_ФункцииУПД().СЧФ Тогда
		
		Результат = УПД820_КонвертироватьОбстоятельстваФормированияСчетФактуры_в970(Контент820);
		
	Иначе
		
		Значение = Контент820.CircumFormatInvoice;
		
		Если Значение = "4" Тогда
			Результат = "00005";
		ИначеЕсли Значение = "5" Тогда
			Результат = "00006";
		ИначеЕсли Значение = "6" Тогда
			Результат = "00007";
		ИначеЕсли Значение = "7" Тогда
			Результат = "00008";
		ИначеЕсли Значение = "8" Тогда
			Результат = "00009";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД820_КонвертироватьОбстоятельстваФормированияСчетФактуры_в970(Контент820)

	Результат = Контент820.CircumFormatInvoice;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		ЕстьСведенияОДокументеОтгрузки = (Контент820.DocumentShipments.Количество() > 0);
		ВТаблицеТолькоУслуги = УПД820_ВТаблицеТолькоУслуги(Контент820.Table);
		
		Если Не ЕстьСведенияОДокументеОтгрузки И ВТаблицеТолькоУслуги Тогда
			Результат = "2";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД820_ВТаблицеТолькоУслуги(Table820)

