КонецПроцедуры

Процедура XML_ЗаполнитьНДС(ОбъектXDTO, Сумма, БезНДС)
	
	Если ЭтоИстина(БезНДС) Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "БезНДС", СтрокаБезНДС());
	Иначе
		СуммаНДС = XML_ФорматЧисла(Сумма, 2); 
		УстановитьЗначениеXDTO(ОбъектXDTO, "СумНал", СуммаНДС);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСведПрослеж(ИмяПакетаXDTO, ОбъектXDTO, ItemTracingInfos, ИмяИнфоПоля)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого ItemTracingInfo Из ItemTracingInfos Цикл
		
		Если ЗначениеЗаполнено(ItemTracingInfo.RegNumberUnit) Тогда
			
			СведПрослеж = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, ИмяИнфоПоля);
			
			XML_УПД_ЗаполнитьЗначениеСведПрослеж(СведПрослеж, ItemTracingInfo);
			
			Если XML_УПД_970_ИспользуетсяФормат5_03() Тогда
				СтТовБезНДСПрослеж = Формат(ItemTracingInfo.SumWithoutVat, "ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=");
			Иначе
				СтТовБезНДСПрослеж = ItemTracingInfo.SumWithoutVat;
			КонецЕсли;
			
			УстановитьЗначениеXDTO(СведПрослеж, "СтТовБезНДСПрослеж", СтТовБезНДСПрослеж);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСведенияОФайле(Файл, ПротоКонтент, ПрефиксИдФайла, ВерсияФормата, ПараметрыФормированияФайла)
	
	ВерсПрог = "Diadoc 1.0";
	
	Разделитель = "_";
	
	ПредставлениеДатыФормирования = Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=yyyyMMdd");
	
	ПризнакПрослеживаемыеТовары = XML_УПД_970_ПризнакНаличияТоваровПодлежащихПрослеживаемости(ПротоКонтент);
	ПризнакМаркируемыеТовары = XML_УПД_970_ПризнакНаличияТоваровПодлежащихМаркировке(ПротоКонтент);
	ПризнакАлкогольнаяПродукция = XML_УПД_970_ПризнакНаличияАлкогольнойПродукции(ПротоКонтент);
	ПризнакТабачнаяПродукция = XML_УПД_970_ПризнакНаличияТабачнойПродукции(ПротоКонтент);
	ПризнакНефтепродукты = XML_УПД_970_ПризнакНаличияНефтепродуктов(ПротоКонтент);
	
	СвободноеЗначение = "00";
	
	ИдентификаторПолучателя	= ПротоКонтент.Buyers[0].FnsParticipantId;
	Если Не ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		ПараметрыФормированияФайла.Свойство("ИдентификаторПолучателя", ИдентификаторПолучателя);
	КонецЕсли;
	
	ИдентификаторОтправителя = ПротоКонтент.Sellers[0].FnsParticipantId;
	Если Не ЗначениеЗаполнено(ИдентификаторОтправителя) Тогда
		ПараметрыФормированияФайла.Свойство("ИдентификаторОтправителя", ИдентификаторОтправителя);
	КонецЕсли;

	ЧастиИдФайл = Новый Массив;
	ЧастиИдФайл.Добавить(ПрефиксИдФайла);
	ЧастиИдФайл.Добавить(ИдентификаторПолучателя);
	ЧастиИдФайл.Добавить(ИдентификаторОтправителя);
	ЧастиИдФайл.Добавить(ПредставлениеДатыФормирования);
	ЧастиИдФайл.Добавить(ПараметрыФормированияФайла.УникальныйИдентификатор);
	ЧастиИдФайл.Добавить(ПризнакПрослеживаемыеТовары);
	ЧастиИдФайл.Добавить(ПризнакМаркируемыеТовары);
	ЧастиИдФайл.Добавить(ПризнакАлкогольнаяПродукция);
	ЧастиИдФайл.Добавить(ПризнакТабачнаяПродукция);
	ЧастиИдФайл.Добавить(ПризнакНефтепродукты);
	ЧастиИдФайл.Добавить(СвободноеЗначение);
	
	ИдФайл = Общее_СоединитьСтроку(ЧастиИдФайл, Разделитель);

	УстановитьЗначениеXDTO(Файл, "ИдФайл", ИдФайл);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм", ВерсияФормата);
	УстановитьЗначениеXDTO(Файл, "ВерсПрог", ВерсПрог);
	
КонецПроцедуры

// Возвращает признак наличия в документе товаров, подлежащих прослеживаемости
//
// Параметры:
//  ПротоКонтент - Структура - заполненное прото (см. Заполнить_Utd970SellerContent)
// 
// Возвращаемое значение:
//  Строка - "1", если документ содержит товары, подлежащие прослеживаемости. Иначе - "0"
//
Функция XML_УПД_970_ПризнакНаличияТоваровПодлежащихПрослеживаемости(ПротоКонтент)
	
	ЕстьПрослеживаемыеТовары = Ложь;
	
	ContentsDocumentProductsType = ПолучитьЗначениеXDTO(ПротоКонтент.СлужебнаяИнформация, "ContentsDocumentProductsType"); 
	Если ContentsDocumentProductsType <> Неопределено Тогда
		ЕстьПрослеживаемыеТовары = ContentsDocumentProductsType.ContainsTraceableProducts;
	КонецЕсли;
	
	Если Не ЕстьПрослеживаемыеТовары Тогда
		// Признак могли не заполнить в ПМ (например, при "ручном" заполнении контента)
		Для Каждого Item Из ПротоКонтент.Table.Items Цикл
			Если Item.ItemTracingInfos.Количество() > 0 Тогда
				ЕстьПрослеживаемыеТовары = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат = Формат(ЕстьПрослеживаемыеТовары, "БЛ=0; БИ=1");
	
	Возврат Результат;
	
КонецФункции

// Возвращает признак наличия в документе товаров, подлежащих маркировке
