// Парсит коллекцию информационных полей в формате накладной Республики Беларусь.
//
// Параметры:
//  СтрокаXDTO - ОбъектXDTO - элемент коллекции DeliveryNote.DespatchAdviceLogisticUnitLineItem.LineItem
// 
// Возвращаемое значение:
//  Массив из НовыйКлючЗначение.
//
Функция ПрочитатьТекстИнфТипНакладнаяРБ01(СтрокаXDTO)
	
	Результат = Новый Массив;
	
	Если Не ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СтрокаXDTO, "LineItemExtraField") Тогда
		Возврат Результат;
	КонецЕсли;
	
	СписокИлиОбъектXDTO = СтрокаXDTO.LineItemExtraField;
	
	Если ТипЗнч(СписокИлиОбъектXDTO) = Тип("СписокXDTO") Тогда
