// КОНВЕРТАЦИЯ КОНТЕНТА 970 В 820

// Возвращает прото-контент титула продавца в формате 820, заполненный по данным контента в 970 формате
//
// Параметры:
//  Контент970	 - Структура - заполненная протоструктура ответного титула в 970 формате
//							(см. НовыйProtoОбъектXDTO("Utd970SellerContent"))
//  ОшибкиКонвертации - Массив - ошибки конвертации
//		* Структура - см. НовоеОписаниеОшибкиКонвертации()
//
// Возвращаемое значение:
//  ОбъектXDTO - заполненная протоструктура ответного титула в 820 формате
//							(см. НовыйProtoОбъектXDTO("Utd820SellerContent"))
//
Функция УПД970_Конвертировать_в820(Знач Контент970, ОшибкиКонвертации) Экспорт

	Контент820 = НовыйProtoОбъектXDTO("Utd820SellerContent");
	
	ИсключаемыеСвойства = Новый Массив;
	ИсключаемыеСвойства.Добавить("Function");
	ИсключаемыеСвойства.Добавить("CircumFormatInvoice");
	ИсключаемыеСвойства.Добавить("DocumentCreatorBase");
	
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Контент820, Контент970, ИсключаемыеСвойства);
	
	ФункцияДокумента = УПД970_КонвертироватьЗначениеФункцииДокумента_в820(Контент970);
	УстановитьЗначениеXDTO(Контент820, "Function", ФункцияДокумента);

	ЗначениеСпецОбстоятельств = УПД970_КонвертироватьСпецОбстоятельствФормированияДокумента_в820(Контент970);
	УстановитьЗначениеXDTO(Контент820, "CircumFormatInvoice", ЗначениеСпецОбстоятельств);
	
	DocumentCreatorBase = УПД970_КонвертироватьСведенияОСоставителеФайла_в820(Контент970);
	УстановитьЗначениеXDTO(Контент820, "DocumentCreatorBase", DocumentCreatorBase);
	
	MainAssignMonetaryClaim = УПД970_КонвертироватьОснованиеУступкиДенТребования_в820(Контент970);
	УстановитьЗначениеXDTO(Контент820, "MainAssignMonetaryClaim", MainAssignMonetaryClaim);
	
	SellerInfoCircumPublicProc = УПД970_КонвертироватьСведенияОЗакупкахДляГосНужд_в820(Контент970);
	УстановитьЗначениеXDTO(Контент820, "SellerInfoCircumPublicProc", SellerInfoCircumPublicProc);
	
	AdditionalInfoId = УПД970_КонвертироватьИнформационныеПоляФХЖ_в820(Контент970.AdditionalInfoId);
	УстановитьЗначениеXDTO(Контент820, "AdditionalInfoId", AdditionalInfoId);
	
	УПД970_КонвертироватьСведенияОбУчастникахЭДО_в820(Контент970, Контент820);
	
	Если Контент970.FactorInfo <> Неопределено
		И ЗначениеЗаполнено(Контент970.FactorInfo.Type) Тогда
		FactorInfo = УПД970_КонвертироватьСведенияУчастникаЭДО_в820(Контент970.FactorInfo);
		УстановитьЗначениеXDTO(Контент820, "FactorInfo", FactorInfo);
	КонецЕсли;
	
	Table = УПД970_КонвертироватьСведенияОТоварах_в820(Контент970.Table);
	УстановитьЗначениеXDTO(Контент820, "Table", Table);
	
	TransferInfo = УПД970_КонвертироватьСведенияОПередачеТоваров_в820(Контент970.TransferInfo);
	УстановитьЗначениеXDTO(Контент820, "TransferInfo", TransferInfo);
	
	Для Каждого PaymentDocument970 Из Контент970.PaymentDocuments Цикл
		PaymentDocument = УПД970_КонвертироватьСведенияОДокументеОплаты_в820(PaymentDocument970);
		Контент820.PaymentDocuments.Добавить(PaymentDocument);
	КонецЦикла;
	
	Для Каждого DocumentShipment970 Из Контент970.DocumentShipments Цикл
		DocumentShipment = УПД970_КонвертироватьСведенияОДокументеОтгрузки_в820(DocumentShipment970);
		Контент820.DocumentShipments.Добавить(DocumentShipment);
	КонецЦикла;
	
	Если Контент970.СлужебнаяИнформация <> Неопределено Тогда
		Для Каждого ОписаниеОшибки Из Контент970.СлужебнаяИнформация.ОшибкиВДанных Цикл
			НовоеОписаниеОшибки = НовыйProtoОбъектXDTO("ОшибкиВДанныхТип");
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НовоеОписаниеОшибки, ОписаниеОшибки);
			Контент820.ОшибкиВДанных.Добавить(НовоеОписаниеОшибки);
		КонецЦикла;
	КонецЕсли;

	Возврат Контент820;
	
КонецФункции

Функция УПД970_КонвертироватьЗначениеФункцииДокумента_в820(Контент970)
	
	ФункцииУПД = Перечисление_ФункцииУПД();
	
	СоответствиеФункций = Новый Соответствие;
	
	СоответствиеФункций.Вставить(ФункцииУПД.СЧФДОП, "InvoiceAndBasic");
	СоответствиеФункций.Вставить(ФункцииУПД.СЧФ, "Invoice");
	СоответствиеФункций.Вставить(ФункцииУПД.ДОП, "Basic");
	
	Результат = СоответствиеФункций.Получить(Контент970.Function);
	
	Если Результат = Неопределено Тогда
		Результат = Контент970.Function;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

