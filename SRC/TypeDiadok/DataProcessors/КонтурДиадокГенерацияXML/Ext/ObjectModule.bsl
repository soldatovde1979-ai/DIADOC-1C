	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "ДатаПер") Тогда
		УстановитьЗначениеXDTO(Контент, "TransferDate", ДатаXML_в_Дата1С(СвПер.ДатаПер));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "ДатаНачПер") Тогда
		УстановитьЗначениеXDTO(Контент, "TransferStartDate", ДатаXML_в_Дата1С(СвПер.ДатаНачПер));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "ДатаОконПер") Тогда
		УстановитьЗначениеXDTO(Контент, "TransferEndDate", ДатаXML_в_Дата1С(СвПер.ДатаОконПер));
	КонецЕсли;
			
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "БезДокОснПер") Тогда
		WithoutTransferBase = (СвПер.БезДокОснПер = "1");
		УстановитьЗначениеXDTO(Контент, "WithoutTransferBase", WithoutTransferBase);
	КонецЕсли;

	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "Тран") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер.Тран, "СвТран") Тогда
