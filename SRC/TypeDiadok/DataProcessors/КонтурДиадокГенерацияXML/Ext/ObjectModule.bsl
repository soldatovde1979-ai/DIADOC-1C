Процедура Заполнить_ProformaInvoice29SellerContent(Контент, Параметры)
	// BSLLS:Typo-off
	
	Документ = Параметры.Документ;
	
	СодСч = Документ.СодСч;
	
	УстановитьЗначениеXDTO(Контент, "DocumentDate", ДатаXML_в_Дата1С(СодСч.ДатаДок));
	УстановитьЗначениеXDTO(Контент, "DocumentNumber", СодСч.НомерДок);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодСч, "ДенИзм") Тогда
		
		ДенИзм = СодСч.ДенИзм;
		
		КурсВал = ПолучитьЗначениеXDTO(ДенИзм, "КурсВал");
		ОпрУЕ = ПолучитьЗначениеXDTO(ДенИзм, "ОпрУЕ");
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДенИзм, "КодОКВ") Тогда
			УстановитьЗначениеXDTO(Контент, "Currency", ДенИзм.КодОКВ);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "CurrencyRate", КурсВал);
		УстановитьЗначениеXDTO(Контент, "ConventionalUnitDefinition", ОпрУЕ);
		
		УЕ = ПолучитьЗначениеXDTO(ДенИзм, "УЕ");
		Если Нрег(УЕ) = "у.е." Тогда
			УстановитьЗначениеXDTO(Контент, "IsConventionalUnit", "true");
		Иначе
			УстановитьЗначениеXDTO(Контент, "IsConventionalUnit", "false");
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "TotalItems", ПолучитьЗначениеXDTO(СодСч, "ВсегоНаим"));
	
	Для Каждого Основание Из СписокXDTOИзЭлемента(СодСч, "Основание") Цикл
		ProformaInvoiceBase = НовыйЭлементСпискаXDTO(Контент.ProformaInvoiceBases);
		Заполнить_ProformaInvoice29Base(ProformaInvoiceBase, Основание);
	КонецЦикла;
	
	Для Каждого ВидОбяз Из СписокXDTOИзЭлемента(СодСч, "ВидОбяз") Цикл
		CommitmentType = НовыйЭлементСпискаXDTO(Контент.CommitmentTypes);
		
		УстановитьЗначениеXDTO(CommitmentType, "CommitmentTypeCode", ПолучитьЗначениеXDTO(ВидОбяз, "КодВидОбяз"));
		УстановитьЗначениеXDTO(CommitmentType, "CommitmentTypeName", ПолучитьЗначениеXDTO(ВидОбяз, "НаимВидОбязм"));
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодСч, "ДопСв") Тогда
		Заполнить_ProformaInvoice29AdditionalInfo(Контент.ProformaInvoiceAdditionalInfo, СодСч.ДопСв);
	КонецЕсли;
	
	Для Каждого ИнфПол Из СписокXDTOИзЭлемента(Документ, "ИнфПол") Цикл
		AdditionalInfoId = НовыйЭлементСпискаXDTO(Контент.AdditionalInfoId);
		
		Заполнить_AdditionalInfoId(AdditionalInfoId, ИнфПол);
	КонецЦикла;
	
	Заполнить_ExtendedOrganizationInfo29(Контент.Seller, СодСч.СвПрод);
	Заполнить_ExtendedOrganizationInfo29(Контент.Buyer, СодСч.СвПокуп);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодСч, "СвПлат") Тогда
		Заполнить_ExtendedOrganizationInfo29(Контент.Payer, СодСч.СвПлат);
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодСч, "ПолучДнСр") Тогда
		Заполнить_ExtendedOrganizationInfo29(Контент.MoneyRecipient, СодСч.ПолучДнСр);
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодСч, "ГрузОт") Тогда
		Заполнить_ExtendedOrganizationInfo29(Контент.Shipper, СодСч.ГрузОт);
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодСч, "ГрузПолуч") Тогда
		Заполнить_ExtendedOrganizationInfo29(Контент.Consignee, СодСч.ГрузПолуч);
	КонецЕсли;
	
	Заполнить_ProformaInvoice29Table(Контент.Table, СодСч);
	
	Для Каждого Подписант Из СписокXDTOИзЭлемента(Документ, "Подписант") Цикл
		Signer = НовыйЭлементСпискаXDTO(Контент.Signers);
		Заполнить_Signer970(Signer, Подписант);
	КонецЦикла;
	
	// BSLLS:Typo-on
КонецПроцедуры

Процедура Заполнить_ProformaInvoice29Base(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ОснИное") Тогда
