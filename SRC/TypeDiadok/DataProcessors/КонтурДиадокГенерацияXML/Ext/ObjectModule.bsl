Функция УПД970_КонвертироватьСведенияОТоварах_в820(Table970)
	
	Перем Результат;
	
	Если Table970 = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НовыйProtoОбъектXDTO("InvoiceTable820");
	
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат, Table970);
	
	Для Каждого Item970 Из Table970.Items Цикл
		
		Item820 = НовыйProtoОбъектXDTO("Item820");
		Результат.Items.Добавить(Item820);
		
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Item820, Item970);
		
		Для Каждого CustomDeclaration970 Из Item970.CustomDeclarations Цикл
			НоваяСтрока = НовыйProtoОбъектXDTO("CustomDeclaration820");
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НоваяСтрока, CustomDeclaration970);
			Item820.CustomDeclarations.Добавить(НоваяСтрока);
		КонецЦикла;
		
		Для Каждого ItemTracingInfo970 Из Item970.ItemTracingInfos Цикл
			НоваяСтрока = НовыйProtoОбъектXDTO("ItemTracingInfo");
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НоваяСтрока, ItemTracingInfo970);
			Item820.ItemTracingInfos.Добавить(НоваяСтрока);
		КонецЦикла;
		
		КоличествоОСУ = 0;
		Для Каждого ItemIdentificationNumber970 Из Item970.ItemIdentificationNumbers Цикл
			
			НоваяСтрока = НовыйProtoОбъектXDTO("ItemIdentificationNumber");
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НоваяСтрока, ItemIdentificationNumber970);
			
			Для Каждого Unit Из ItemIdentificationNumber970.Units Цикл
				НоваяСтрока.Units.Добавить(Unit);
			КонецЦикла;
			
			Для Каждого PackageId Из ItemIdentificationNumber970.PackageIds Цикл
				НоваяСтрока.PackageIds.Добавить(PackageId);
			КонецЦикла;
			
			Если НоваяСтрока.Units.Количество() > 0
				Или НоваяСтрока.PackageIds.Количество() > 0
				Или ЗначениеЗаполнено(НоваяСтрока.TransPackageId) Тогда
				
				Item820.ItemIdentificationNumbers.Добавить(НоваяСтрока);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ItemIdentificationNumber970.MarkedItemsQuantity) Тогда
				КоличествоОСУ = КоличествоОСУ + ItemIdentificationNumber970.MarkedItemsQuantity;
			КонецЕсли;
			
		КонецЦикла;
		
		// Код ОСУ
		Если ЗначениеЗаполнено(Item970.GTIN) И КоличествоОСУ > 0 Тогда
			КодОСУ = НовыйКодОСУ(Item970.GTIN, КоличествоОСУ);
			НоваяСтрока = НовыйProtoОбъектXDTO("ItemIdentificationNumber");
			НоваяСтрока.PackageIds.Добавить(КодОСУ);
			Item820.ItemIdentificationNumbers.Добавить(НоваяСтрока);
		КонецЕсли;
		
		Для Каждого AdditionalInfoItem970 Из Item970.StructedAdditionalInfos Цикл
			AdditionalInfoItem820 = УПД970_КонвертироватьAdditionalInfoItem_в820(AdditionalInfoItem970);
			Item820.StructedAdditionalInfos.Добавить(AdditionalInfoItem820);
		КонецЦикла;
		
		ItemСлужебнаяИнформация = НовыйProtoОбъектXDTO("ItemСлужебнаяИнформация");
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(ItemСлужебнаяИнформация, Item970.СлужебнаяИнформация);
		УстановитьЗначениеXDTO(Item820, "СлужебнаяИнформация", ItemСлужебнаяИнформация);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

