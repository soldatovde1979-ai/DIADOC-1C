Процедура Заполнить_Utd970SellerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	
	УстановитьЗначениеXDTO(Контент, "Function", Документ.Функция);
	
	НаимДокОпр = ПолучитьЗначениеXDTO(Документ, "НаимДокОпр");
	УстановитьЗначениеXDTO(Контент, "DocumentName", НаимДокОпр);
	
	УИД = ПолучитьЗначениеXDTO(Документ, "УИД");
	УстановитьЗначениеXDTO(Контент, "DocumentUID", УИД);
	
	СвСчФакт = Документ.СвСчФакт;
	
	НаимЭконСубСост = ПолучитьЗначениеXDTO(Документ, "НаимЭконСубСост");
	УстановитьЗначениеXDTO(Контент, "DocumentCreator", НаимЭконСубСост);
	
	СоглСтрДопИнф = ПолучитьЗначениеXDTO(Документ, "СоглСтрДопИнф");
	УстановитьЗначениеXDTO(Контент, "ApprovedStructureAdditionalInfoFields", СоглСтрДопИнф);
	
	ДатаДок = ПолучитьЗначениеXDTO(СвСчФакт, "ДатаДок");
	УстановитьЗначениеXDTO(Контент, "DocumentDate", ДатаXML_в_Дата1С(ДатаДок));
	
	НомерДок = ПолучитьЗначениеXDTO(СвСчФакт, "НомерДок");
	УстановитьЗначениеXDTO(Контент, "DocumentNumber", НомерДок);
	
	УстановитьЗначениеXDTO(Контент, "Currency", СвСчФакт.ДенИзм.КодОКВ);
	УстановитьЗначениеXDTO(Контент, "CurrencyName", СвСчФакт.ДенИзм.НаимОКВ);
	
	КурсВал = ПолучитьЗначениеXDTO(СвСчФакт.ДенИзм, "КурсВал");
	УстановитьЗначениеXDTO(Контент, "CurrencyRate", КурсВал);
	
	ИмяФайлИспрПрод = ПолучитьЗначениеXDTO(СвСчФакт, "ИмяФайлИспрПрод");
	УстановитьЗначениеXDTO(Контент, "SourceFileNameSeller", ИмяФайлИспрПрод);
	
	ИмяФайлИспрПок = ПолучитьЗначениеXDTO(СвСчФакт, "ИмяФайлИспрПок");
	УстановитьЗначениеXDTO(Контент, "SourceFileNameBuyer", ИмяФайлИспрПок);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ИспрДок") Тогда
		УстановитьЗначениеXDTO(Контент, "RevisionDate", ДатаXML_в_Дата1С(СвСчФакт.ИспрДок.ДатаИспр));
		УстановитьЗначениеXDTO(Контент, "RevisionNumber", СвСчФакт.ИспрДок.НомИспр);
	КонецЕсли;
	
	СведенияИдФайл = XML_СведенияИдФайлУПД970(Параметры.ИдФайл);
	
	ИдПолучателя = СведенияИдФайл.ИдПолучателя;
	ИдОтправителя = СведенияИдФайл.ИдОтправителя;
	
	Для Каждого СвПрод Из СписокXDTOИзЭлемента(СвСчФакт, "СвПрод") Цикл
		Seller = НовыйЭлементСпискаXDTO(Контент.Sellers);
		Заполнить_ExtendedOrganizationInfo970(Seller, СвПрод);
		Seller.FnsParticipantId = ИдОтправителя;
	КонецЦикла;
	
	Для Каждого СвПокуп Из СписокXDTOИзЭлемента(СвСчФакт, "СвПокуп") Цикл
		Buyer = НовыйЭлементСпискаXDTO(Контент.Buyers);
		Заполнить_ExtendedOrganizationInfo970(Buyer, СвПокуп);
		Buyer.FnsParticipantId = ИдПолучателя;
	КонецЦикла;
	
	Для Каждого ГрузОт Из СписокXDTOИзЭлемента(СвСчФакт, "ГрузОт") Цикл
		Shipper = НовыйЭлементСпискаXDTO(Контент.Shippers);
		Заполнить_Shipper970(Shipper, ГрузОт);
	КонецЦикла;
	
	Для Каждого ГрузПолуч Из СписокXDTOИзЭлемента(СвСчФакт, "ГрузПолуч") Цикл
		Consignee = НовыйЭлементСпискаXDTO(Контент.Consignees);
		Заполнить_ExtendedOrganizationInfo970(Consignee, ГрузПолуч);
	КонецЦикла;
	
	Для Каждого СвПРД Из СписокXDTOИзЭлемента(СвСчФакт, "СвПРД") Цикл
		PaymentDocumentInfo = НовыйЭлементСпискаXDTO(Контент.PaymentDocuments);
		Заполнить_PaymentDocument(PaymentDocumentInfo, СвПРД);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ДопСвФХЖ1") Тогда
		
		ДопСвФХЖ1 = СвСчФакт.ДопСвФХЖ1;
		
		УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo", ПолучитьЗначениеXDTO(ДопСвФХЖ1, "ИдГосКон"));
		
		ФункцииУПД = Перечисление_ФункцииУПД();
		
		Если Документ.Функция = ФункцииУПД.СЧФ 
			И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "СпОбстФСЧФ") Тогда
			УстановитьЗначениеXDTO(Контент, "CircumFormatInvoice", ДопСвФХЖ1.СпОбстФСЧФ);
		ИначеЕсли Документ.Функция = ФункцииУПД.СЧФДОП 
			И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "СпОбстФСЧФДОП") Тогда
			УстановитьЗначениеXDTO(Контент, "CircumFormatInvoice", ДопСвФХЖ1.СпОбстФСЧФДОП);
		ИначеЕсли Документ.Функция = ФункцииУПД.ДОП 
			И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "СпОбстФДОП") Тогда
			УстановитьЗначениеXDTO(Контент, "CircumFormatInvoice", ДопСвФХЖ1.СпОбстФДОП);
		КонецЕсли;
		
		Для Каждого ВидОбяз Из СписокXDTOИзЭлемента(ДопСвФХЖ1, "ВидОбяз") Цикл
			CommitmentType = НовыйЭлементСпискаXDTO(Контент.CommitmentType);
			Заполнить_CommitmentType(CommitmentType, ВидОбяз);
		КонецЦикла;
		
		Для Каждого СопрДокФХЖ Из СписокXDTOИзЭлемента(ДопСвФХЖ1, "СопрДокФХЖ") Цикл
			AccompanyingDocument = НовыйЭлементСпискаXDTO(Контент.AccompanyingDocuments);
			Заполнить_DocumentDetails(AccompanyingDocument, СопрДокФХЖ);
		КонецЦикла;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "СвФактор") Тогда
			Заполнить_ExtendedOrganizationInfo970(Контент.FactorInfo, ДопСвФХЖ1.СвФактор);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "ОснУстДенТреб") Тогда
			Заполнить_DocumentDetails(Контент.MainAssignMonetaryClaim, ДопСвФХЖ1.ОснУстДенТреб);
		КонецЕсли;
		
		Если Параметры.ВерсФорм = "5.03" Тогда
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "ИнфПродЗаГоскКазн") Тогда
				Заполнить_SellerInfoCircumPublicProc(Контент.SellerInfoCircumPublicProc, ДопСвФХЖ1.ИнфПродЗаГоскКазн);
			КонецЕсли;
		Иначе
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСвФХЖ1, "ИнфПродЗаГосКазн") Тогда
				Заполнить_SellerInfoCircumPublicProc(Контент.SellerInfoCircumPublicProc, ДопСвФХЖ1.ИнфПродЗаГосКазн);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ОснДоверОргСост") Тогда
		Заполнить_DocumentDetails(Контент.DocumentCreatorBase, Документ.ОснДоверОргСост);
	КонецЕсли;
	
	Для Каждого ДокПодтвОтгрНом Из СписокXDTOИзЭлемента(СвСчФакт, "ДокПодтвОтгрНом") Цикл
		DocumentShipment = НовыйЭлементСпискаXDTO(Контент.DocumentShipments);
		Заполнить_DocumentDetails(DocumentShipment, ДокПодтвОтгрНом);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ИнфПолФХЖ1") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, СвСчФакт.ИнфПолФХЖ1);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ТаблСчФакт") Тогда
		Заполнить_InvoiceTable970(Контент.Table, Документ.ТаблСчФакт);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "СвПродПер") Тогда
		Заполнить_TransferInfo970(Контент.TransferInfo, Документ.СвПродПер);
	КонецЕсли;
	
	Для Каждого Подписант Из СписокXDTOИзЭлемента(Документ, "Подписант") Цикл
		Signer = НовыйЭлементСпискаXDTO(Контент.Signers);
		Заполнить_Signer970(Signer, Подписант);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_Utd970BuyerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "НаимЭконСубСост") Тогда
		УстановитьЗначениеXDTO(Контент, "DocumentCreator", Документ.НаимЭконСубСост);
	КонецЕсли;
	
	ОснДоверОргСост = ПолучитьЗначениеXDTO(Документ, "ОснДоверОргСост");
	Заполнить_DocumentDetails(Контент.DocumentCreatorBase, ОснДоверОргСост);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ИнфПокГосЗакКазн") Тогда
		Заполнить_BuyerInfoCircumPublicProc(Контент.BuyerInfoCircumPublicProc, Документ.ИнфПокГосЗакКазн);
	КонецЕсли;
	
	Для Каждого Подписант Из СписокXDTOИзЭлемента(Документ, "Подписант") Цикл
		Signer = НовыйЭлементСпискаXDTO(Контент.Signers);
		Заполнить_Signer970(Signer, Подписант);
	КонецЦикла;
	
	СодФХЖ4 = Документ.СодФХЖ4;
	
	ВидОперации = ПолучитьЗначениеXDTO(СодФХЖ4, "ВидОпер");
	УстановитьЗначениеXDTO(Контент, "OperationCode", ВидОперации);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ4, "СвПрин") Тогда
		
		СвПрин = СодФХЖ4.СвПрин;
		
		СодОпер = ПолучитьЗначениеXDTO(СвПрин, "СодОпер");	
		УстановитьЗначениеXDTO(Контент, "OperationContent",	СодОпер);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин, "ДатаПрин") Тогда
			ДатаПринятия = ДатаXML_в_Дата1С(СвПрин.ДатаПрин);
			УстановитьЗначениеXDTO(Контент, "AcceptanceDate", ДатаПринятия);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин, "КодСодОпер") Тогда
			Заполнить_ContentOperCode970(Контент.ContentOperCode, СвПрин.КодСодОпер);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин, "СвЛицПрин") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин.СвЛицПрин, "РабОргПок") Тогда
				Заполнить_Employee(Контент.Employee, СвПрин.СвЛицПрин.РабОргПок);
			Иначе
				Заполнить_OtherIssuer970(Контент.OtherIssuer, СвПрин.СвЛицПрин.ИнЛицо);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ4, "ИнфПолФХЖ4") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, СодФХЖ4.ИнфПолФХЖ4);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_UcdSellerContent(Контент, Параметры)
	
	// Документация: http://diadocsdk-1c.readthedocs.io/ru/latest/UcdSellerContent.html
	
	Документ = Параметры.Документ;
	СвКСчФ = Документ.СвКСчФ;
	
	Контент.Seller.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдОтпр;
	Контент.Buyer.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдПол;
	
	УстановитьЗначениеXDTO(Контент, "FormatVersion", "ucd");
	УстановитьЗначениеXDTO(Контент, "Number"	, СвКСчФ.НомерКСчФ);
	УстановитьЗначениеXDTO(Контент, "Date"		, ДатаXML_в_Дата1С(СвКСчФ.ДатаКСчФ));
	УстановитьЗначениеXDTO(Контент, "Function"	, Документ.Функция);
	УстановитьЗначениеXDTO(Контент, "Creator"	, Документ.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "Currency"	, СвКСчФ.КодОКВ);
	
	Заполнить_ExtendedOrganizationInfo(Контент.Seller	, СвКСчФ.СвПрод);
	Заполнить_ExtendedOrganizationInfo(Контент.Buyer	, СвКСчФ.СвПокуп);
	
	Заполнить_EventContent(Контент.EventContent, Документ.СодФХЖ3);
	Заполнить_ExtendedSigner(Контент.Signers, Документ, "Подписант");
	Заполнить_InvoiceCorrectionTable(Контент.InvoiceCorrectionTable, Документ.ТаблКСчФ);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "НаимДокОпр") Тогда
		УстановитьЗначениеXDTO(Контент, "Name", Документ.НаимДокОпр);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ДопСвФХЖ1") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ.ДопСвФХЖ1, "КурсВал") Тогда
			УстановитьЗначениеXDTO(Контент, "CurrencyRate", СвКСчФ.ДопСвФХЖ1.КурсВал);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ.ДопСвФХЖ1, "ИдГосКон") Тогда
			УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo", СвКСчФ.ДопСвФХЖ1.ИдГосКон);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ИспрКСчФ") Тогда
		УстановитьЗначениеXDTO(Контент, "RevisionDate"	, ДатаXML_в_Дата1С(СвКСчФ.ИспрКСчФ.ДатаИспрКСчФ));
		УстановитьЗначениеXDTO(Контент, "RevisionNumber", СвКСчФ.ИспрКСчФ.НомИспрКСчФ);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ИнфПолФХЖ1") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, СвКСчФ.ИнфПолФХЖ1);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ОснДоверОргСост") Тогда
		УстановитьЗначениеXDTO(Контент, "CreatorBase", Документ.ОснДоверОргСост);
	КонецЕсли;
	
	// Номера корректируемых документов.
	Для Каждого СчФ Из СписокXDTOИзЭлемента(СвКСчФ, "СчФ") Цикл
		Заполнить_InvoiceForCorrectionInfo(НовыйЭлементСпискаXDTO(Контент.Invoices), СчФ);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_Ucd736SellerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СвКСчФ = Документ.СвКСчФ;
	
	УстановитьЗначениеXDTO(Контент, "FormatVersion", "ucd736");
	УстановитьЗначениеXDTO(Контент, "Function", Документ.Функция);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "НаимДокОпр") Тогда
		УстановитьЗначениеXDTO(Контент, "Name", Документ.НаимДокОпр);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Date", ДатаXML_в_Дата1С(СвКСчФ.ДатаКСчФ));
	УстановитьЗначениеXDTO(Контент, "Number", СвКСчФ.НомерКСчФ);
	
	Для Каждого СчФ Из СписокXDTOИзЭлемента(СвКСчФ, "СчФ") Цикл
		Заполнить_InvoiceForCorrectionInfo(НовыйЭлементСпискаXDTO(Контент.Invoices), СчФ);
	КонецЦикла;
	
	Заполнить_ExtendedOrganizationInfo(Контент.Seller, СвКСчФ.СвПрод);
	Контент.Seller.FnsParticipantId = Параметры.СвУчДокОбор.ИдОтпр;
	
	Заполнить_ExtendedOrganizationInfo(Контент.Buyer, СвКСчФ.СвПокуп);
	Контент.Buyer.FnsParticipantId = Параметры.СвУчДокОбор.ИдПол;
	
	Заполнить_ExtendedSigner(Контент.Signers, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "СодФХЖ3") Тогда
		Заполнить_EventContent(Контент.EventContent, Документ.СодФХЖ3);
	КонецЕсли;
	
	Заполнить_InvoiceCorrectionTable(Контент.InvoiceCorrectionTable, Документ.ТаблКСчФ);
	
	УстановитьЗначениеXDTO(Контент, "Currency", СвКСчФ.КодОКВ);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ДопСвФХЖ1") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ.ДопСвФХЖ1, "КурсВал") Тогда
			УстановитьЗначениеXDTO(Контент, "CurrencyRate", СвКСчФ.ДопСвФХЖ1.КурсВал);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ.ДопСвФХЖ1, "ИдГосКон") Тогда
			УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo", СвКСчФ.ДопСвФХЖ1.ИдГосКон);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ.ДопСвФХЖ1, "НаимОКВ") Тогда
			УстановитьЗначениеXDTO(Контент, "CurrencyName", ?(ЗначениеЗаполнено(СвКСчФ.ДопСвФХЖ1.НаимОКВ), 1, 0));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ИспрКСчФ") Тогда
		УстановитьЗначениеXDTO(Контент, "RevisionDate"	, ДатаXML_в_Дата1С(СвКСчФ.ИспрКСчФ.ДатаИспрКСчФ));
		УстановитьЗначениеXDTO(Контент, "RevisionNumber", СвКСчФ.ИспрКСчФ.НомИспрКСчФ);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ИнфПолФХЖ1") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, СвКСчФ.ИнфПолФХЖ1);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Creator", Документ.НаимЭконСубСост);
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ОснДоверОргСост") Тогда
		УстановитьЗначениеXDTO(Контент, "CreatorBase", Документ.ОснДоверОргСост);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_InvoiceForCorrectionInfo(Контент, Параметры)
	
	// Документация: http://diadocsdk-1c.readthedocs.io/ru/latest/InvoiceForCorrectionInfo.html
	
	УстановитьЗначениеXDTO(Контент, "InvoiceDate",		ДатаXML_в_Дата1С(Параметры.ДатаСчФ));
	УстановитьЗначениеXDTO(Контент, "InvoiceNumber",	Параметры.НомерСчФ);
	
	// Номера предыдущих исправлений
	Для Каждого ИспрСчФ Из СписокXDTOИзЭлемента(Параметры, "ИспрСчФ") Цикл
		Заполнить_InvoiceRevisionInfo(НовыйЭлементСпискаXDTO(Контент.InvoiceRevisions), ИспрСчФ);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_InvoiceRevisionInfo(Контент, Параметры)
	
	// Документация: http://diadocsdk-1c.readthedocs.io/ru/latest/InvoiceRevisionInfo.html
	
	УстановитьЗначениеXDTO(Контент, "RevisionDate",		ДатаXML_в_Дата1С(Параметры.ДатаИспрСчФ));
	УстановитьЗначениеXDTO(Контент, "RevisionNumber",	Параметры.НомИспрСчФ);
	
КонецПроцедуры

Процедура Заполнить_EventContent(Контент, Параметры)
	
	// Документация: http://diadocsdk-1c.readthedocs.io/ru/latest/EventContent.html
	
	Если ТипЗнч(Параметры.ПередатДокум) = Тип("Строка") Тогда
		// 189@
		УстановитьЗначениеXDTO(Контент, "TransferDocDetails", Параметры.ПередатДокум);
	Иначе
		// 736@
		Для Каждого ПередатДокум Из СписокXDTOИзЭлемента(Параметры, "ПередатДокум") Цикл
			Заполнить_CorrectionBases(НовыйЭлементСпискаXDTO(Контент.TransferDocDetails736), ПередатДокум);
		КонецЦикла;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "OperationContent", Параметры.СодОпер);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИныеСвИзмСтоим") Тогда
		УстановитьЗначениеXDTO(Контент, "CostChangeInfo", Параметры.ИныеСвИзмСтоим);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаНапр") Тогда
		УстановитьЗначениеXDTO(Контент, "NotificationDate", ДатаXML_в_Дата1С(Параметры.ДатаНапр));
	КонецЕсли;
	
	ИмяСвойства = "ОснКор"; // 189@
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДокумОснКор") Тогда
		// 736@
		ИмяСвойства = "ДокумОснКор";
	КонецЕсли;
	Для Каждого ОснКор Из СписокXDTOИзЭлемента(Параметры, ИмяСвойства) Цикл
		Заполнить_CorrectionBases(НовыйЭлементСпискаXDTO(Контент.CorrectionBases), ОснКор);
	КонецЦикла;
		
КонецПроцедуры

Процедура Заполнить_CorrectionBases(Контент, Параметры)
	
	// Документация: http://diadocsdk-1c.readthedocs.io/ru/latest/CorrectionBase.html
	
	УстановитьЗначениеXDTO(Контент, "BaseDocumentName", Параметры.НаимОсн);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НомОсн") Тогда
		УстановитьЗначениеXDTO(Контент, "BaseDocumentNumber", Параметры.НомОсн);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаОсн") Тогда
		УстановитьЗначениеXDTO(Контент, "BaseDocumentDate", ДатаXML_в_Дата1С(Параметры.ДатаОсн));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСвОсн") Тогда
		УстановитьЗначениеXDTO(Контент, "AdditionalInfo", Параметры.ДопСвОсн);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИдФайлОсн") Тогда
		УстановитьЗначениеXDTO(Контент, "BaseIdFile", Параметры.ИдФайлОсн);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_Waybill(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "DocumentNumber",			Параметры.НомТранНакл);
	УстановитьЗначениеXDTO(Контент, "DocumentDate",				ДатаXML_в_Дата1С(Параметры.ДатаТранНакл));
	
КонецПроцедуры

Процедура Заполнить_Act552SellerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СвДокПРУ = Документ.СвДокПРУ;
	СодФХЖ1	 = СвДокПРУ.СодФХЖ1;
	
	Контент.Seller.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдОтпр;
	Контент.Buyer.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдПол;
	
	УстановитьЗначениеXDTO(Контент, "DocumentDate"	, ДатаXML_в_Дата1С(СвДокПРУ.ИдентДок.ДатаДокПРУ));
	УстановитьЗначениеXDTO(Контент, "DocumentNumber", ПолучитьЗначениеXDTO(СвДокПРУ.ИдентДок, "НомДокПРУ"));
	
	УстановитьЗначениеXDTO(Контент, "Currency"		, СвДокПРУ.ДенИзм.КодОКВ);
	УстановитьЗначениеXDTO(Контент, "CurrencyRate"	, ПолучитьЗначениеXDTO(СвДокПРУ.ДенИзм, "КурсВал"));
	
	УстановитьЗначениеXDTO(Контент, "DocumentName"			, СвДокПРУ.НаимДок.НаимДокОпр);
	УстановитьЗначениеXDTO(Контент, "DocumentCreator"		, Документ.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "DocumentCreatorBase"	, ПолучитьЗначениеXDTO(Документ, "ОснДоверОргСост"));
	УстановитьЗначениеXDTO(Контент, "OperationType"			, ПолучитьЗначениеXDTO(СодФХЖ1, "ВидОперации"));
	УстановитьЗначениеXDTO(Контент, "OperationTitle"		, ПолучитьЗначениеXDTO(СодФХЖ1, "ЗагСодОпер"));
	УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo", ПолучитьЗначениеXDTO(СодФХЖ1, "ИдГосКон"));
	
	Заполнить_ExtendedOrganizationInfo(Контент.Seller	, СодФХЖ1.Исполнитель);
	Заполнить_ExtendedOrganizationInfo(Контент.Buyer	, СодФХЖ1.Заказчик);
	
	Заполнить_ExtendedSigner(Контент.Signers, Документ, "Подписант");
	
	Для Каждого Основание Из СписокXDTOИзЭлемента(СодФХЖ1, "Основание") Цикл
		Заполнить_GroundInfo(НовыйЭлементСпискаXDTO(Контент.Grounds), Основание);
	КонецЦикла;
	
	Для Каждого ОписРабот Из СписокXDTOИзЭлемента(СодФХЖ1, "ОписРабот") Цикл
		Заполнить_Act552WorkDescription(НовыйЭлементСпискаXDTO(Контент.Works), ОписРабот);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвДокПРУ, "ИспрДокПРУ") Тогда
		УстановитьЗначениеXDTO(Контент, "RevisionDate"	, ДатаXML_в_Дата1С(СвДокПРУ.ИспрДокПРУ.ДатаИспрДокПРУ));
		УстановитьЗначениеXDTO(Контент, "RevisionNumber", СвДокПРУ.ИспрДокПРУ.НомИспрДокПРУ);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ1, "ИнфПолФХЖ1") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfo, СодФХЖ1.ИнфПолФХЖ1);
	КонецЕсли;
	
	Заполнить_Act552TransferInfo(Контент.TransferInfo, Документ.СодФХЖ2);
	
КонецПроцедуры

Процедура Заполнить_GroundInfo(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Name",		Параметры.НаимОсн);
	УстановитьЗначениеXDTO(Контент, "Number",	ПолучитьЗначениеXDTO(Параметры, "НомОсн"));
	УстановитьЗначениеXDTO(Контент, "Info",	ПолучитьЗначениеXDTO(Параметры, "ДопСвОсн"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаОсн") Тогда
		УстановитьЗначениеXDTO(Контент, "Date",	ДатаXML_в_Дата1С(Параметры.ДатаОсн));
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_Act552WorkDescription(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Total",				Параметры.СтУчНДСИт);
	УстановитьЗначениеXDTO(Контент, "TotalVat",				ПолучитьЗначениеXDTO(Параметры, "СумНДСИт"));
	УстановитьЗначениеXDTO(Контент, "TotalWithVatExcluded",	ПолучитьЗначениеXDTO(Параметры, "СтБезНДСИт"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НачРабот") Тогда
		УстановитьЗначениеXDTO(Контент, "StartingDate", ДатаXML_в_Дата1С(Параметры.НачРабот));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "КонРабот") Тогда
		УстановитьЗначениеXDTO(Контент, "CompletionDate", ДатаXML_в_Дата1С(Параметры.КонРабот));
	КонецЕсли;
	
	Для Каждого Работа Из СписокXDTOИзЭлемента(Параметры, "Работа") Цикл
		Заполнить_Act552WorkItem(НовыйЭлементСпискаXDTO(Контент.Items), Работа);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_Act552WorkItem(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НаимРабот") Тогда
		УстановитьЗначениеXDTO(Контент, "Name", 					ПолучитьЗначениеXDTO(Параметры, "НаимРабот"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Описание") Тогда
		УстановитьЗначениеXDTO(Контент, "Description",				ПолучитьЗначениеXDTO(Параметры, "Описание"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ОКЕИ") Тогда
		УстановитьЗначениеXDTO(Контент, "UnitCode",					ПолучитьЗначениеXDTO(Параметры, "ОКЕИ"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НаимЕдИзм") Тогда
		УстановитьЗначениеXDTO(Контент, "UnitName",					ПолучитьЗначениеXDTO(Параметры, "НаимЕдИзм"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Цена") Тогда
		УстановитьЗначениеXDTO(Контент, "Price",					ПолучитьЗначениеXDTO(Параметры, "Цена"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Количество") Тогда
		УстановитьЗначениеXDTO(Контент, "Quantity",					ПолучитьЗначениеXDTO(Параметры, "Количество"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтоимБезНДС") Тогда
		УстановитьЗначениеXDTO(Контент, "SubtotalWithVatExcluded",	ПолучитьЗначениеXDTO(Параметры, "СтоимБезНДС"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНДС") Тогда
		УстановитьЗначениеXDTO(Контент, "Vat",						ПолучитьЗначениеXDTO(Параметры, "СумНДС"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтоимУчНДС") Тогда
		УстановитьЗначениеXDTO(Контент, "Subtotal",					ПолучитьЗначениеXDTO(Параметры, "СтоимУчНДС"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НалСт") Тогда
		УстановитьЗначениеXDTO(Контент, "TaxRate",					TaxRate_Из_НалСт(ПолучитьЗначениеXDTO(Параметры, "НалСт")));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "КоррСчДебет") Тогда
		УстановитьЗначениеXDTO(Контент, "ItemAccountDebit",			ПолучитьЗначениеXDTO(Параметры, "КоррСчДебет"));
	КонецЕсли;  
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "КоррСчКредит") Тогда
		УстановитьЗначениеXDTO(Контент, "ItemAccountCredit",		ПолучитьЗначениеXDTO(Параметры, "КоррСчКредит"));
	КонецЕсли;
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолеОписРабот");
	
КонецПроцедуры

Процедура Заполнить_Act552TransferInfo(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "OperationInfo",	Параметры.СодОпер);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаПер") Тогда
		УстановитьЗначениеXDTO(Контент, "TransferDate",	ДатаXML_в_Дата1С(Параметры.ДатаПер));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СвПерВещи") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СвПерВещи, "ДатаПерВещ") Тогда
			УстановитьЗначениеXDTO(Контент, "CreatedThingTransferDate", ДатаXML_в_Дата1С(Параметры.СвПерВещи.ДатаПерВещ));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "CreatedThingInfo", ПолучитьЗначениеXDTO(Параметры.СвПерВещи, "СвПерВещ"));
		
	КонецЕсли;
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолФХЖ2");
	
КонецПроцедуры

Процедура Заполнить_Act552BuyerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СодФХЖ3 = Документ.СодФХЖ3;
	
	УстановитьЗначениеXDTO(Контент, "DocumentCreator",		Документ.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "DocumentCreatorBase",	ПолучитьЗначениеXDTO(Документ, "ОснДоверОргСост"));
	УстановитьЗначениеXDTO(Контент, "OperationType",		ПолучитьЗначениеXDTO(СодФХЖ3, "ВидОперации"));
	УстановитьЗначениеXDTO(Контент, "OperationContent",		СодФХЖ3.РезПринял.СодОпер);
	
	Заполнить_ExtendedSigner(Контент.Signers, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ3.РезПринял, "ДатаПрием") Тогда
		УстановитьЗначениеXDTO(Контент, "AcceptanceDate",	ДатаXML_в_Дата1С(СодФХЖ3.РезПринял.ДатаПрием));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ3, "СвПолВещи") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ3.СвПолВещи, "ДатаПол") Тогда
			УстановитьЗначениеXDTO(Контент, "CreatedThingAcceptDate", ДатаXML_в_Дата1С(СодФХЖ3.СвПолВещи.ДатаПол));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "CreatedThingInfo", ПолучитьЗначениеXDTO(СодФХЖ3.СвПолВещи, "СвПол"));
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ3, "ИнфПолФХЖ3") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, СодФХЖ3.ИнфПолФХЖ3);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_TovTorgSellerContent(Контент, Параметры)
	
	Документ		 = Параметры.Документ;
	СвДокПТПрКроме	 = Документ.СвДокПТПрКроме;
	СвДокПТПр		 = СвДокПТПрКроме.СвДокПТПр;
	СодФХЖ1			 = СвДокПТПр.СодФХЖ1;
	
	Контент.Seller.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдОтпр;
	Контент.Buyer.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдПол;
	
	УстановитьЗначениеXDTO(Контент, "DocumentDate"	, ДатаXML_в_Дата1С(СвДокПТПр.ИдентДок.ДатаДокПТ));
	УстановитьЗначениеXDTO(Контент, "DocumentNumber", ПолучитьЗначениеXDTO(СвДокПТПр.ИдентДок, "НомДокПТ"));
	
	УстановитьЗначениеXDTO(Контент, "Currency"		, СвДокПТПр.ДенИзм.КодОКВ);
	УстановитьЗначениеXDTO(Контент, "CurrencyRate"	, ПолучитьЗначениеXDTO(СвДокПТПр.ДенИзм, "КурсВал"));
	
	УстановитьЗначениеXDTO(Контент, "DocumentCreator"		, Документ.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "DocumentCreatorBase"	, ПолучитьЗначениеXDTO(Документ, "ОснДоверОргСост"));
	УстановитьЗначениеXDTO(Контент, "OperationType"			, ПолучитьЗначениеXDTO(СодФХЖ1, "ВидОперации"));
	УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo", ПолучитьЗначениеXDTO(СодФХЖ1, "ИдГосКон"));
	
	Заполнить_ExtendedOrganizationInfo(Контент.Seller	, СодФХЖ1.Продавец);
	Заполнить_ExtendedOrganizationInfo(Контент.Buyer	, СодФХЖ1.Покупатель);
	
	Заполнить_ExtendedSigner(Контент.Signers, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ1, "ГрузОтпр") Тогда
		Заполнить_ExtendedOrganizationInfo(Контент.Shipper, СодФХЖ1.ГрузОтпр);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ1, "ГрузПолуч") Тогда
		Заполнить_ExtendedOrganizationInfo(Контент.Consignee, СодФХЖ1.ГрузПолуч);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ1, "Перевозчик") Тогда
		Заполнить_ExtendedOrganizationInfo(Контент.Carrier, СодФХЖ1.Перевозчик);
	КонецЕсли;
	
	Для Каждого Основание Из СписокXDTOИзЭлемента(СодФХЖ1, "Основание") Цикл
		Заполнить_GroundInfo(НовыйЭлементСпискаXDTO(Контент.Grounds), Основание);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвДокПТПр, "ИспрДокПТ") Тогда
		УстановитьЗначениеXDTO(Контент, "RevisionDate",		ДатаXML_в_Дата1С(СвДокПТПр.ИспрДокПТ.ДатаИспрДокПТ));
		УстановитьЗначениеXDTO(Контент, "RevisionNumber",	СвДокПТПр.ИспрДокПТ.НомИспрДокПТ);
	КонецЕсли;
	
	Заполнить_TovTorgTransferInfo(Контент.TransferInfo, Документ.СодФХЖ3);
	
	Заполнить_TovTorgTable(Контент.Table, СвДокПТПрКроме.СодФХЖ2);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ1, "ИнфПолФХЖ1") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, СодФХЖ1.ИнфПолФХЖ1);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "DocumentName", СвДокПТПр.НаимДок.НаимДокОпр);
	
КонецПроцедуры

Процедура Заполнить_TovTorgTransferInfo(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "OperationInfo", Параметры.СодОпер);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаОтпуск") Тогда
		УстановитьЗначениеXDTO(Контент, "TransferDate", ДатаXML_в_Дата1С(Параметры.ДатаОтпуск));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "КолПрил") Тогда
		УстановитьЗначениеXDTO(Контент, "Attachment", Параметры.КолПрил);
	КонецЕсли;
	
	Для Каждого ТранНакл Из СписокXDTOИзЭлемента(Параметры, "ТранНакл") Цикл
		Заполнить_Waybill(НовыйЭлементСпискаXDTO(Контент.Waybills), ТранНакл);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СвЛицОтпГруз") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СвЛицОтпГруз, "РабОргПрод") Тогда
			Заполнить_Employee(Контент.Employee, Параметры.СвЛицОтпГруз.РабОргПрод);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СвЛицОтпГруз, "ИнЛицо") Тогда
			Заполнить_OtherIssuer(Контент.OtherIssuer, Параметры.СвЛицОтпГруз.ИнЛицо);
		КонецЕсли;
		
	КонецЕсли;
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолФХЖ3");
	
КонецПроцедуры

Процедура Заполнить_TovTorgTable(Контент, Параметры)
	
	Всего = Параметры.Всего;
	УстановитьЗначениеXDTO(Контент, "TotalQuantity"			, ПолучитьЗначениеXDTO(Всего, "КолМестВс"));
	УстановитьЗначениеXDTO(Контент, "TotalGross"			, ПолучитьЗначениеXDTO(Всего, "БруттоВс"));
	УстановитьЗначениеXDTO(Контент, "TotalNet"				, ПолучитьЗначениеXDTO(Всего, "НеттоВс"));
	УстановитьЗначениеXDTO(Контент, "TotalWithVatExcluded"	, ПолучитьЗначениеXDTO(Всего, "СтБезНДСВс"));
	УстановитьЗначениеXDTO(Контент, "TotalVat"				, ПолучитьЗначениеXDTO(Всего, "СумНДСВс"));
	УстановитьЗначениеXDTO(Контент, "Total"					, Всего.СтУчНДСВс);
	
	Для Каждого СвТов Из СписокXDTOИзЭлемента(Параметры , "СвТов") Цикл
		Заполнить_TovTorgItem(НовыйЭлементСпискаXDTO(Контент.Items), СвТов);
