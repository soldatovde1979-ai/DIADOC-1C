Процедура УПД970_КонвертироватьСведенияОбУчастникахЭДО_в820(Контент970, Контент820)

	Для Каждого Seller970 Из Контент970.Sellers Цикл
		
		Seller = УПД970_КонвертироватьСведенияУчастникаЭДО_в820(Seller970);
		Если Seller <> Неопределено Тогда
			Контент820.Sellers.Добавить(Seller);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Buyer970 Из Контент970.Buyers Цикл
		
		Buyer = УПД970_КонвертироватьСведенияУчастникаЭДО_в820(Buyer970);
		Если Buyer <> Неопределено Тогда
			Контент820.Buyers.Добавить(Buyer);
		КонецЕсли;
		
	КонецЦикла;
	
	Контент820.Consignees.Очистить();
	
	Для Каждого Consignee970 Из Контент970.Consignees Цикл
		
		Consignee = УПД970_КонвертироватьСведенияУчастникаЭДО_в820(Consignee970);
		Если Consignee <> Неопределено Тогда
			Контент820.Consignees.Добавить(Consignee);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Контент820.Consignees.Количество() = 0 Тогда
		Контент820.Consignees.Добавить(НовыйProtoОбъектXDTO("ExtendedOrganizationInfo820"));
	КонецЕсли;
	
	Контент820.Shippers.Очистить();
	
	Для Каждого Shipper970 Из Контент970.Shippers Цикл
		Shipper = УПД970_КонвертироватьСведенияГрузоотправителя_в820(Shipper970);
		Если Shipper <> Неопределено Тогда
			Контент820.Shippers.Добавить(Shipper);
		КонецЕсли;
	КонецЦикла;
	
	Если Контент820.Shippers.Количество() = 0 Тогда
		Shipper = НовыйProtoОбъектXDTO("Shipper820");
		Shipper.OrganizationInfo = НовыйProtoОбъектXDTO("ExtendedOrganizationInfo820");
		Контент820.Shippers.Добавить(Shipper);
	КонецЕсли;
	
	Если Контент970.FactorInfo <> Неопределено
		И ЗначениеЗаполнено(Контент970.FactorInfo.Type) Тогда
		
		FactorInfo = УПД970_КонвертироватьСведенияУчастникаЭДО_в820(Контент970.FactorInfo);
		УстановитьЗначениеXDTO(Контент820, "FactorInfo", FactorInfo);
		
	КонецЕсли;

КонецПроцедуры

