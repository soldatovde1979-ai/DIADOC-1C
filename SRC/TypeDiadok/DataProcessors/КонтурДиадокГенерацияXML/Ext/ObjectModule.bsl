	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНал, "БезНДС") Тогда
		УстановитьЗначениеXDTO(Контент, "WithoutVat", "true");
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНал, "ДефНДС") Тогда
		УстановитьЗначениеXDTO(Контент, "HyphenVat", Истина);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСведТов") Тогда
		
		ItemMark = ItemMark(ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "ПрТовРаб"));
		
		УстановитьЗначениеXDTO(Контент, "ItemMark",				ItemMark);
		УстановитьЗначениеXDTO(Контент, "AdditionalProperty",	ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "ДопПризн"));
		УстановитьЗначениеXDTO(Контент, "UnitName",				ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "НаимЕдИзм"));
		УстановитьЗначениеXDTO(Контент, "ItemToRelease",		ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "НадлОтп"));
		УстановитьЗначениеXDTO(Контент, "ItemCharact",			ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "ХарактерТов"));
		УстановитьЗначениеXDTO(Контент, "ItemKind",				ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "СортТов"));
		УстановитьЗначениеXDTO(Контент, "ItemArticle",			ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "АртикулТов"));
		УстановитьЗначениеXDTO(Контент, "ItemVendorCode",		ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "КодТов"));
		УстановитьЗначениеXDTO(Контент, "CatalogCode",			ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "КодКат"));
		УстановитьЗначениеXDTO(Контент, "ItemTypeCode",			ПолучитьЗначениеXDTO(Параметры.ДопСведТов, "КодВидТов"));
		
		// В Прото нет поля для "КрНаимСтрПр".
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "СведПрослеж") Тогда
			
			СведПрослеж = Параметры.ДопСведТов.СведПрослеж;
			
			Для Каждого СведПрослеж Из СписокXDTOИзЭлемента(Параметры.ДопСведТов, "СведПрослеж") Цикл

				ItemTracingInfo = НовыйЭлементСпискаXDTO(Контент.ItemTracingInfos);
				
				УстановитьЗначениеXDTO(ItemTracingInfo, "RegNumberUnit",	СведПрослеж.НомТовПрослеж);
				УстановитьЗначениеXDTO(ItemTracingInfo, "Unit",				СведПрослеж.ЕдИзмПрослеж);
				УстановитьЗначениеXDTO(ItemTracingInfo, "UnitName",			ПолучитьЗначениеXDTO(СведПрослеж, "НаимЕдИзмПрослеж"));
				УстановитьЗначениеXDTO(ItemTracingInfo, "Quantity",			СведПрослеж.КолВЕдПрослеж);
				УстановитьЗначениеXDTO(ItemTracingInfo, "ItemAddInfo",		ПолучитьЗначениеXDTO(СведПрослеж, "ДопПрослеж"));
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "НомСредИдентТов") Тогда
			Заполнить_ItemIdentificationNumbers(Контент.ItemIdentificationNumbers,
												СписокXDTOИзЭлемента(Параметры.ДопСведТов, "НомСредИдентТов"));
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СвТД Из СписокXDTOИзЭлемента(Параметры, "СвТД") Цикл
		Заполнить_CustomDeclaration(НовыйЭлементСпискаXDTO(Контент.CustomDeclarations), СвТД);
	КонецЦикла;
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолФХЖ2");
	
КонецПроцедуры

Процедура Заполнить_ExtendedOrganizationInfo(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьЗначениеXDTO(Контент, "BoxId",										Неопределено);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвЮЛУч") Тогда
		
		// Юр. лицо 820@, 155@, 189@
		УстановитьЗначениеXDTO(Контент, "Type",										"LegalEntity");
		УстановитьЗначениеXDTO(Контент, "Name",										Параметры.ИдСв.СвЮЛУч.НаимОрг);
		УстановитьЗначениеXDTO(Контент, "Inn",										ПолучитьЗначениеXDTO(Параметры.ИдСв.СвЮЛУч, "ИННЮЛ"));
		УстановитьЗначениеXDTO(Контент, "Kpp",										ПолучитьЗначениеXDTO(Параметры.ИдСв.СвЮЛУч, "КПП"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв.СвЮЛУч, "ДефИННЮЛ") Тогда
			УстановитьЗначениеXDTO(Контент, "HyphenInn", Истина);
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИП") Тогда
		
		// ИП 820@, 155@, 189@
		УстановитьЗначениеXDTO(Контент, "Type",										"IndividualEntity");
		УстановитьЗначениеXDTO(Контент, "Name",										XML_СтрокаФИО(Параметры.ИдСв.СвИП.ФИО));
		УстановитьЗначениеXDTO(Контент, "Inn",										ПолучитьЗначениеXDTO(Параметры.ИдСв.СвИП, "ИННФЛ"));
		УстановитьЗначениеXDTO(Контент, "IndividualEntityRegistrationCertificate",	ПолучитьЗначениеXDTO(Параметры.ИдСв.СвИП, "СвГосРегИП"));
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo",					ПолучитьЗначениеXDTO(Параметры.ИдСв.СвИП, "ИныеСвед"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв.СвИП, "ДефИННФЛ") Тогда
			УстановитьЗначениеXDTO(Контент, "HyphenInn", Истина);
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИнНеУч") Тогда
		
		// Иностранное лицо, не состоящее на учете в налоговых органах 820@, 155@, 189@
		УстановитьЗначениеXDTO(Контент, "Type",										"ForeignEntity");
		УстановитьЗначениеXDTO(Контент, "Name",										Параметры.ИдСв.СвИнНеУч.НаимОрг);
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo",					ПолучитьЗначениеXDTO(Параметры.ИдСв.СвИнНеУч, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "LegalEntityId",							ПолучитьЗначениеXDTO(Параметры.ИдСв.СвИнНеУч, "Идентиф"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвЮлНеУч") Тогда
		
		// Юр. лицо, не состоящее на учете в налоговых органах 155@
		УстановитьЗначениеXDTO(Контент, "Type",										"ForeignEntity");
		УстановитьЗначениеXDTO(Контент, "Name",										Параметры.ИдСв.СвЮлНеУч.НаимОрг);
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo",					ПолучитьЗначениеXDTO(Параметры.ИдСв.СвЮлНеУч, "ИныеСвед"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвФЛ") Тогда
		
		// Физ. лицо 551@ и 552@
		УстановитьЗначениеXDTO(Контент, "Type",										"PhysicalEntity");
		УстановитьЗначениеXDTO(Контент, "Name",										XML_СтрокаФИО(Параметры.ИдСв.СвФЛ.ФИО));
		УстановитьЗначениеXDTO(Контент, "Inn",										ПолучитьЗначениеXDTO(Параметры.ИдСв.СвФЛ, "ИННФЛ"));
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo",					ПолучитьЗначениеXDTO(Параметры.ИдСв.СвФЛ, "ИныеСвед"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвФЛУчастФХЖ") Тогда
		
		// Физ. лицо 820@
		УстановитьЗначениеXDTO(Контент, "Type",										"PhysicalEntity");
		УстановитьЗначениеXDTO(Контент, "Name",										XML_СтрокаФИО(Параметры.ИдСв.СвФЛУчастФХЖ.ФИО));
		УстановитьЗначениеXDTO(Контент, "Inn",										ПолучитьЗначениеXDTO(Параметры.ИдСв.СвФЛУчастФХЖ, "ИННФЛ"));
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo",					ПолучитьЗначениеXDTO(Параметры.ИдСв.СвФЛУчастФХЖ, "ИныеСвед"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвОрг") Тогда
		
		СвОрг = Параметры.ИдСв.СвОрг; // Сведения об организации 551@ и 552@
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвОрг, "СвЮЛ") Тогда
			
			// Российская организаця
			УстановитьЗначениеXDTO(Контент, "Type",									"LegalEntity");
			УстановитьЗначениеXDTO(Контент, "Name",									СвОрг.СвЮЛ.НаимОрг);
			УстановитьЗначениеXDTO(Контент, "Inn",									СвОрг.СвЮЛ.ИННЮЛ);
			УстановитьЗначениеXDTO(Контент, "Kpp",									ПолучитьЗначениеXDTO(СвОрг.СвЮЛ, "КПП"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвОрг, "ИнОрг") Тогда
			
			// Иностранная организация
			УстановитьЗначениеXDTO(Контент, "Type",									"ForeignEntity");
			УстановитьЗначениеXDTO(Контент, "Name",									СвОрг.ИнОрг.НаимОрг);
			УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo",				ПолучитьЗначениеXDTO(СвОрг.ИнОрг, "ИныеСвед"));
			УстановитьЗначениеXDTO(Контент, "Country",								ПолучитьЗначениеXDTO(СвОрг.ИнОрг, "Страна"));
			
		КонецЕсли;
		
	КонецЕсли;	
	
	УстановитьЗначениеXDTO(Контент, "Okpo",											ПолучитьЗначениеXDTO(Параметры, "ОКПО"));
	УстановитьЗначениеXDTO(Контент, "Department",									ПолучитьЗначениеXDTO(Параметры, "СтруктПодр"));
	УстановитьЗначениеXDTO(Контент, "AdditionalInfo",								ПолучитьЗначениеXDTO(Параметры, "ИнфДляУчаст"));
		
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "БанкРекв") Тогда
		УстановитьЗначениеXDTO(Контент, "BankAccountNumber",						ПолучитьЗначениеXDTO(Параметры.БанкРекв, "НомерСчета"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.БанкРекв, "СвБанк") Тогда
			УстановитьЗначениеXDTO(Контент, "BankName",								ПолучитьЗначениеXDTO(Параметры.БанкРекв.СвБанк, "НаимБанк"));
			УстановитьЗначениеXDTO(Контент, "BankId",								ПолучитьЗначениеXDTO(Параметры.БанкРекв.СвБанк, "БИК"));
			УстановитьЗначениеXDTO(Контент, "CorrespondentAccount",					ПолучитьЗначениеXDTO(Параметры.БанкРекв.СвБанк, "КорСчет"));
		КонецЕсли;
				
	КонецЕсли;

	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Контакт") Тогда
		УстановитьЗначениеXDTO(Контент, "Phone",									ПолучитьЗначениеXDTO(Параметры.Контакт, "Тлф"));
		УстановитьЗначениеXDTO(Контент, "Email",									ПолучитьЗначениеXDTO(Параметры.Контакт, "ЭлПочта"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Адрес") Тогда
		Заполнить_AddressInfo(Контент.Address, Параметры.Адрес);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_ExtendedOrganizationInfo970(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвЮЛУч") Тогда
		
		СвЮЛУч = Параметры.ИдСв.СвЮЛУч;	
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидыЮрФизЛиц.ЮридическоеЛицо);
		
		УстановитьЗначениеXDTO(Контент, "Name", СвЮЛУч.НаимОрг);
		УстановитьЗначениеXDTO(Контент, "Inn", СвЮЛУч.ИННЮЛ);
		УстановитьЗначениеXDTO(Контент, "Kpp", ПолучитьЗначениеXDTO(СвЮЛУч, "КПП"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИП") Тогда
		
		СвИП = Параметры.ИдСв.СвИП;
		
		УстановитьЗначениеXDTO(Контент, "Type",	ВидыЮрФизЛиц.ИндивидуальныйПредприниматель);
		
		УстановитьЗначениеXDTO(Контент, "Name",	XML_СтрокаФИО(СвИП.ФИО));
		УстановитьЗначениеXDTO(Контент, "Inn", СвИП.ИННФЛ);
		
		УстановитьЗначениеXDTO(Контент, "IndividualEntityRegistrationCertificate", ПолучитьЗначениеXDTO(СвИП, "СвГосРегИП"));
		УстановитьЗначениеXDTO(Контент, "IndividualEntityRegistrationNumber", ПолучитьЗначениеXDTO(СвИП, "ОГРНИП"));
		УстановитьЗначениеXDTO(Контент, "IndividualEntityRegistrationDate", ДатаXML_в_Дата1С(ПолучитьЗначениеXDTO(СвИП, "ДатаОГРНИП")));
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo", ПолучитьЗначениеXDTO(СвИП, "ИныеСвед"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвФЛУч") Тогда
		
		СвФЛУч = Параметры.ИдСв.СвФЛУч;	
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидыЮрФизЛиц.ФизическоеЛицо);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвФЛУч, "ФИО") Тогда
			УстановитьЗначениеXDTO(Контент, "Name", XML_СтрокаФИО(СвФЛУч.ФИО));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "Inn", ПолучитьЗначениеXDTO(СвФЛУч, "ИННФЛ"));
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo", ПолучитьЗначениеXDTO(СвФЛУч, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "PhysicalEntityStatusID", ПолучитьЗначениеXDTO(СвФЛУч, "ИдСтатЛ"));
			
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИнНеУч") Тогда
		
		СвИнНеУч = Параметры.ИдСв.СвИнНеУч;

		Если СвИнНеУч.ИдСтат = "ИО" Тогда
			ВидЮрФизЛица = ВидыЮрФизЛиц.ИностраннаяОрганизация;
		Иначе
			ВидЮрФизЛица = ВидыЮрФизЛиц.ИностранныйГражданин;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидЮрФизЛица);
		
		УстановитьЗначениеXDTO(Контент, "Name", СвИнНеУч.Наим);
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo", ПолучитьЗначениеXDTO(СвИнНеУч, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "LegalEntityId", ПолучитьЗначениеXDTO(СвИнНеУч, "Идентиф"));
		
		УстановитьЗначениеXDTO(Контент, "Country", СвИнНеУч.НаимСтран);
		УстановитьЗначениеXDTO(Контент, "CountryCode", ПолучитьЗначениеXDTO(СвИнНеУч, "КодСтр"));
		
	КонецЕсли;	
	
	УстановитьЗначениеXDTO(Контент, "Okpo", ПолучитьЗначениеXDTO(Параметры, "ОКПО"));
	УстановитьЗначениеXDTO(Контент, "Okopf", ПолучитьЗначениеXDTO(Параметры, "КодОПФ"));
	УстановитьЗначениеXDTO(Контент, "FullNameOPF", ПолучитьЗначениеXDTO(Параметры, "ПолнНаимОПФ"));
	УстановитьЗначениеXDTO(Контент, "Department", ПолучитьЗначениеXDTO(Параметры, "СтруктПодр"));
	УстановитьЗначениеXDTO(Контент, "AdditionalInfo", ПолучитьЗначениеXDTO(Параметры, "ИнфДляУчаст"));
		
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "БанкРекв") Тогда
		
		БанкРекв = Параметры.БанкРекв;
		
		УстановитьЗначениеXDTO(Контент, "BankAccountNumber", ПолучитьЗначениеXDTO(БанкРекв, "НомерСчета"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(БанкРекв, "СвБанк") Тогда
			УстановитьЗначениеXDTO(Контент, "BankName", ПолучитьЗначениеXDTO(БанкРекв.СвБанк, "НаимБанк"));
			УстановитьЗначениеXDTO(Контент, "BankId", ПолучитьЗначениеXDTO(БанкРекв.СвБанк, "БИК"));
			УстановитьЗначениеXDTO(Контент, "CorrespondentAccount", ПолучитьЗначениеXDTO(БанкРекв.СвБанк, "КорСчет"));
		КонецЕсли;
				
	КонецЕсли;

	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Контакт") Тогда
		
		Для Каждого НомерТелефона Из СписокXDTOИзЭлемента(Параметры.Контакт, "Тлф") Цикл
			Контент.Phone.Добавить(НомерТелефона);
		КонецЦикла;
		
		Для Каждого ЭлПочта Из СписокXDTOИзЭлемента(Параметры.Контакт, "ЭлПочта") Цикл
			Контент.Email.Добавить(ЭлПочта);
		КонецЦикла;

		УстановитьЗначениеXDTO(Контент, "OtherContactInfo", ПолучитьЗначениеXDTO(Параметры.Контакт, "ИнКонт"));
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Адрес") Тогда
		Заполнить_AddressInfo970(Контент.Address, Параметры.Адрес);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_ExtendedSigner(Signers, Параметры, ИмяСвойства)
	
	Для Каждого Подписант Из СписокXDTOИзЭлемента(Параметры, ИмяСвойства) Цикл
		
		ExtendedSigner	 = НовыйЭлементСпискаXDTO(Signers);
		SignerDetails	 = ExtendedSigner.SignerDetails;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ОблПолн") Тогда
			УстановитьЗначениеXDTO(SignerDetails, "Powers", SignerPowers(Подписант.ОблПолн));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "Статус") Тогда
			УстановитьЗначениеXDTO(SignerDetails, "Status", SignerStatus(Подписант.Статус));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ОснПолн") Тогда
			УстановитьЗначениеXDTO(SignerDetails, "PowersBase", Подписант.ОснПолн);
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ОснПолнПодп") Тогда
			УстановитьЗначениеXDTO(SignerDetails, "PowersBase", Подписант.ОснПолнПодп);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ОснПолнОрг") Тогда
			УстановитьЗначениеXDTO(SignerDetails, "OrganizationPowersBase", Подписант.ОснПолнОрг);
		КонецЕсли;
		
		ФИО = Неопределено;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ФЛ") Тогда
			
