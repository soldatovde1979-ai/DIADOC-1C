Функция ВалидацияТорг2_ДанныеОРасхождениях(DiscrepancyData)
	
	СписокОшибок = Новый Массив;
	
	Если СтруктураЗаполнена(DiscrepancyData.ItemIdentificationNumbers) Тогда
		Ошибки = ВалидацияТорг2_НомераСредствИдентификацииТоваров(DiscrepancyData.ItemIdentificationNumbers);
