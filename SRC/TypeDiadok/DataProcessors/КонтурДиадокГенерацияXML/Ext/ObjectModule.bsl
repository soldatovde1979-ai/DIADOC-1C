		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт.ИспрСчФ, "ДефНомИспрСчФ") Тогда
			УстановитьЗначениеXDTO(Контент, "HyphenRevisionNumber", Истина);
