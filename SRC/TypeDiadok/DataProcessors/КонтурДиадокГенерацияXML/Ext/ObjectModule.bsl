	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО, "СвПлат") Тогда
		Заполнить_ExtendedOrganizationInfo(Контент.Payer, СвСНО.СвПлат);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО, "СвПолуч") Тогда
		Заполнить_ExtendedOrganizationInfo(Контент.Recipient, СвСНО.СвПолуч);
