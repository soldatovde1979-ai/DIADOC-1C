// 970@
Процедура XML_ЗаполнитьСведенияОбИндивидуальномПредпринимателе(ИмяПакетаXDTO, СвИП, ПротоКонтент)
	
	XML_ЗаполнитьОбщиеСведенияОбИндивидуальномПредпринимателе(ИмяПакетаXDTO, СвИП, ПротоКонтент);
	
	Если ЗначениеЗаполнено(ПротоКонтент.IndividualEntityRegistrationDate) Тогда
		ДатаОГРНИП = Формат(ПротоКонтент.IndividualEntityRegistrationDate, "ДФ=dd.MM.yyyy");
		УстановитьЗначениеXDTO(СвИП, "ДатаОГРНИП", ДатаОГРНИП);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СвИП, "ОГРНИП", ПротоКонтент.IndividualEntityRegistrationNumber);
	
КонецПроцедуры

Процедура XML_ЗаполнитьОбщиеСведенияОбИндивидуальномПредпринимателе(ИмяПакетаXDTO, СвИП, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СвИП, "ИныеСвед", ПротоКонтент.OrganizationOrPersonInfo);
	УстановитьЗначениеXDTO(СвИП, "СвГосРегИП", ПротоКонтент.IndividualEntityRegistrationCertificate);
	
	Если ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
		УстановитьЗначениеXDTO(СвИП, "ИННФЛ", ПротоКонтент.Inn);
	КонецЕсли;
	
	СтруктураФИО = XML_ПротоСтруктураФИО(ПротоКонтент.Name);
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвИП, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
	
КонецПроцедуры

Процедура XML_ЗаполнитьФизическоеЛицоКонтрагента(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "СвФЛУчастФХЖ") Тогда
		ИмяСвойства = "СвФЛУчастФХЖ"; // 820@
	Иначе
		ИмяСвойства = "СвФЛ"; // 551@, 552@
	КонецЕсли;
	
	СвТип = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, ИмяСвойства);
	
	Если ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
		УстановитьЗначениеXDTO(СвТип, "ИННФЛ", ПротоКонтент.Inn);
	КонецЕсли;
	
	// 820@
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвТип, "ДефИННФЛ") Тогда
		Если ЭтоИстина(ПротоКонтент.HyphenInn)
			Или Не ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
			УстановитьЗначениеXDTO(СвТип, "ДефИННФЛ", СтрокаДефис());
		КонецЕсли;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СвТип, "ИныеСвед", ПротоКонтент.OrganizationOrPersonInfo);
	
	СтруктураФИО = XML_ПротоСтруктураФИО(ПротоКонтент.Name);
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвТип, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
	
КонецПроцедуры

// 970@
Процедура XML_ЗаполнитьСведенияОФизическомЛице(ИмяПакетаXDTO, СвФЛУч, ПротоКонтент)
	
	Если ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
		УстановитьЗначениеXDTO(СвФЛУч, "ИННФЛ", ПротоКонтент.Inn);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоКонтент.PhysicalEntityStatusID) Тогда
		УстановитьЗначениеXDTO(СвФЛУч, "ИдСтатЛ", ПротоКонтент.PhysicalEntityStatusID);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СвФЛУч, "ИныеСвед", ПротоКонтент.OrganizationOrPersonInfo);
	
	СтруктураФИО = XML_ПротоСтруктураФИО(ПротоКонтент.Name);
	
	ФИОЗаполнено = ЗначениеЗаполнено(СтруктураФИО.Surname)
		И ЗначениеЗаполнено(СтруктураФИО.Firstname);
		
	Если ФИОЗаполнено Тогда
		Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвФЛУч, "ФИО");
		XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьИностранноеЛицоКонтрагента(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "СвИнНеУч") Тогда
		
		// 155@, 820@
		СвИнНеУч = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "СвИнНеУч");
		
		УстановитьЗначениеXDTO(СвИнНеУч, "НаимОрг"	, ПротоКонтент.Name);
		УстановитьЗначениеXDTO(СвИнНеУч, "ИныеСвед"	, ПротоКонтент.OrganizationOrPersonInfo);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвИнНеУч, "Идентиф") Тогда
			// 820@
			УстановитьЗначениеXDTO(СвИнНеУч, "Идентиф", ПротоКонтент.LegalEntityId);
		КонецЕсли;
		
	Иначе
		
		// 551@, 552@
		СвОрг = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO	, "СвОрг");
		ИнОрг = НовыйДочернийОбъектXDTO(Фабрика, СвОрг		, "ИнОрг");
		
		УстановитьЗначениеXDTO(ИнОрг, "НаимОрг"	, ПротоКонтент.Name);
		УстановитьЗначениеXDTO(ИнОрг, "Страна"	, ПротоКонтент.Country);
		УстановитьЗначениеXDTO(ИнОрг, "ИныеСвед", ПротоКонтент.OrganizationOrPersonInfo);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьФизическоеЛицо(ИмяПакетаXDTO, ОбъектXDTO, OtherIssuer)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФИО");
	XML_ЗаполнитьФИОТип(ФИО, OtherIssuer);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИныеСвед", OtherIssuer.EmployeeInfo);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ОснДоверФЛ") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснДоверФЛ", OtherIssuer.EmployeeBase);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ОснДоверФЛПер") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснДоверФЛПер", OtherIssuer.EmployeeBase);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьФизическоеЛицоПодписанта(ИмяПакетаXDTO, ОбъектXDTO, SignerDetails)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
