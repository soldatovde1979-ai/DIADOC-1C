// XML: функции заполнения УПД 970

Процедура XML_УПД_970_ЗаполнитьПодписантов(ИмяПакетаXDTO, Документ, ПротоКонтент)

	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого Signer Из СписокXDTOИзЭлемента(ПротоКонтент, "Signers") Цикл

		Подписант = НовыйДочернийОбъектXDTO(Фабрика, Документ, "Подписант");
		
		УстановитьЗначениеXDTO(Подписант, "Должн", Signer.JobTitle);
		УстановитьЗначениеXDTO(Подписант, "СпосПодтПолном", Signer.ConfirmCredentials);
		УстановитьЗначениеXDTO(Подписант, "ДопСведПодп", Signer.AdditionalInfo);
		
		ДатаПодписанияДокумента = Дата1С_в_ДатаXML(Signer.DateSigningDocument);
		УстановитьЗначениеXDTO(Подписант, "ДатаПодДок", ДатаПодписанияДокумента);
		
		ТипПодписиXML = XML_ТипПодписи(Signer.SignType);	
		УстановитьЗначениеXDTO(Подписант, "ТипПодпис", ТипПодписиXML);
		
		Если ЗначениеЗаполнено(Signer.Surname) Тогда
			ФИО = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ФИО");
			XML_ЗаполнитьФИОТип(ФИО, Signer);
		КонецЕсли;
		
		Если XML_УПД_970_ЭтоСпособПодтвержденияПолномочийЭлектроннойДоверенностью(Signer.ConfirmCredentials) Тогда
			
			Для Каждого ElectronicPOA Из СписокXDTOИзЭлемента(Signer, "ElectronicPOA") Цикл
				
				СвДоверЭл = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "СвДоверЭл");
				
				ДатаВыдачи = Дата1С_в_ДатаXML(ElectronicPOA.IssueDate);
				УстановитьЗначениеXDTO(СвДоверЭл, "ДатаВыдДовер", ДатаВыдачи);
				УстановитьЗначениеXDTO(СвДоверЭл, "НомДовер", ElectronicPOA.ID);
				
				ДатаРегистрации = Дата1С_в_ДатаXML(ElectronicPOA.RegistrationDate);
				УстановитьЗначениеXDTO(СвДоверЭл, "ДатаВнРегДовер", ДатаРегистрации);
				УстановитьЗначениеXDTO(СвДоверЭл, "ВнНомДовер", ElectronicPOA.Number);
				
				УстановитьЗначениеXDTO(СвДоверЭл, "ИдСистХран", ElectronicPOA.StorageID);
				УстановитьЗначениеXDTO(СвДоверЭл, "УРЛСист", ElectronicPOA.URL);
				
			КонецЦикла;			
			
		ИначеЕсли XML_УПД_970_ЭтоСпособПодтвержденияПолномочийДоверенностьюНаБумаге(Signer.ConfirmCredentials) Тогда
			
			Для Каждого PaperPOA Из СписокXDTOИзЭлемента(Signer, "PaperPOA") Цикл
				
				СвДоверБум = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "СвДоверБум");
				
				ДатаВыдачи = Дата1С_в_ДатаXML(PaperPOA.IssueDate);
				УстановитьЗначениеXDTO(СвДоверБум, "ДатаВыдДовер", ДатаВыдачи);
				УстановитьЗначениеXDTO(СвДоверБум, "ВнНомДовер", PaperPOA.Number);
				УстановитьЗначениеXDTO(СвДоверБум, "СвИдДовер", PaperPOA.PrincipalInfo);
				
				Если ЗначениеЗаполнено(PaperPOA.IssuerFirstName)
					И ЗначениеЗаполнено(PaperPOA.IssuerSurname) Тогда
					
					ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвДоверБум, "ФИО");
				
					УстановитьЗначениеXDTO(ФИО, "Фамилия", PaperPOA.IssuerSurname);
					УстановитьЗначениеXDTO(ФИО, "Имя", PaperPOA.IssuerFirstName);
					УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(PaperPOA, "IssuerPatronymic"));
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСведенияСФ(ИмяПакетаXDTO, Документ, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	СвСчФакт = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СвСчФакт");
	
	ДатаДокумента = Дата1С_в_ДатаXML(ПротоКонтент.DocumentDate);
	
	УстановитьЗначениеXDTO(СвСчФакт, "НомерДок", ПротоКонтент.DocumentNumber);
	УстановитьЗначениеXDTO(СвСчФакт, "ДатаДок", ДатаДокумента);
	
	Если ЗначениеЗаполнено(ПротоКонтент.RevisionNumber)
		ИЛИ ЗначениеЗаполнено(ПротоКонтент.RevisionDate) Тогда
		
		ИспрДок = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ИспрДок");
		
		ДатаИсправления = Дата1С_в_ДатаXML(ПротоКонтент.RevisionDate);
		
		УстановитьЗначениеXDTO(ИспрДок, "НомИспр", ПротоКонтент.RevisionNumber);
		УстановитьЗначениеXDTO(ИспрДок, "ДатаИспр", ДатаИсправления);
		
	КонецЕсли;
	
	Для Каждого Seller Из ПротоКонтент.Sellers Цикл
		СвПрод = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "СвПрод");
		XML_ЗаполнитьСведенияОКонтрагенте_970(ИмяПакетаXDTO, СвПрод, Seller);
	КонецЦикла;
	
	Для Каждого Buyer Из ПротоКонтент.Buyers Цикл
		СвПокуп = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "СвПокуп");
		XML_ЗаполнитьСведенияОКонтрагенте_970(ИмяПакетаXDTO, СвПокуп, Buyer);
	КонецЦикла;
	
	Для Каждого Consignee Из ПротоКонтент.Consignees Цикл
		Если ЗначениеЗаполнено(Consignee.Name) Тогда
			ГрузПолуч = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ГрузПолуч");
			XML_ЗаполнитьСведенияОКонтрагенте_970(ИмяПакетаXDTO, ГрузПолуч, Consignee);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Shipper Из ПротоКонтент.Shippers Цикл
		Если Shipper.SameAsSeller = Истина ИЛИ ЗначениеЗаполнено(Shipper.OrganizationInfo.Name) Тогда
			
			ГрузОт = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ГрузОт");
			
			Если Shipper.SameAsSeller = Истина Тогда
				УстановитьЗначениеXDTO(ГрузОт, "ОнЖе", "он же");
			Иначе
				ГрузОтпр = НовыйДочернийОбъектXDTO(Фабрика, ГрузОт, "ГрузОтпр");
				XML_ЗаполнитьСведенияОКонтрагенте_970(ИмяПакетаXDTO, ГрузОтпр, Shipper.OrganizationInfo);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого PaymentDocument Из ПротоКонтент.PaymentDocuments Цикл
		
		СвПРД = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "СвПРД");
		
		ДатаДокументаОплаты = Дата1С_в_ДатаXML(PaymentDocument.Date);
		
		УстановитьЗначениеXDTO(СвПРД, "НомерПРД", PaymentDocument.Number);
		УстановитьЗначениеXDTO(СвПРД, "ДатаПРД", ДатаДокументаОплаты);
		УстановитьЗначениеXDTO(СвПРД, "СуммаПРД", PaymentDocument.Total);
		
	КонецЦикла;
	
	ДенИзм = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ДенИзм");
	
	НаименованиеВалюты = НаименованиеВалюты(ПротоКонтент.Currency, Истина);
	
	УстановитьЗначениеXDTO(ДенИзм, "КодОКВ", ПротоКонтент.Currency);
	УстановитьЗначениеXDTO(ДенИзм, "НаимОКВ", НаименованиеВалюты);
	УстановитьЗначениеXDTO(ДенИзм, "КурсВал", ПротоКонтент.CurrencyRate);
	
	Для Каждого DocumentShipment Из ПротоКонтент.DocumentShipments Цикл
		Если ЗначениеЗаполнено(DocumentShipment.Name) Тогда
			ДокПодтвОтгрНом = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ДокПодтвОтгрНом");
			XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ДокПодтвОтгрНом, DocumentShipment);
		КонецЕсли;
	КонецЦикла;
	
	AdditionalInfoId = ПротоКонтент.AdditionalInfoId;
	Если ЗначениеЗаполнено(AdditionalInfoId.InfoFileId)
		ИЛИ ЗначениеЗаполнено(AdditionalInfoId.StructedAdditionalInfos) Тогда
		
		ИнфПолФХЖ1 = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ИнфПолФХЖ1");
		УстановитьЗначениеXDTO(ИнфПолФХЖ1, "ИдФайлИнфПол", AdditionalInfoId.InfoFileId);
		
		XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПолФХЖ1.ТекстИнф, AdditionalInfoId.StructedAdditionalInfos);
		
	КонецЕсли;
	
	НеобходимоДобавитьДопСвФХЖ1 = XML_УПД_970_НеобходимоДобавитьДопСвФХЖ1(ПротоКонтент);
	
	Если НеобходимоДобавитьДопСвФХЖ1 Тогда
		
		ДопСвФХЖ1 = НовыйДочернийОбъектXDTO(Фабрика, СвСчФакт, "ДопСвФХЖ1");
		
		УстановитьЗначениеXDTO(ДопСвФХЖ1, "ИдГосКон", ПротоКонтент.GovernmentContractInfo);
		
		ФункцииУПД = Перечисление_ФункцииУПД();
		
		XML_УПД_970_ЗаполнитьОбстоятельстваФормирования(ДопСвФХЖ1, ПротоКонтент, ФункцииУПД);
		
		Если ЗначениеЗаполнено(ПротоКонтент.FactorInfo.Type) Тогда
			СвФактор = НовыйДочернийОбъектXDTO(Фабрика, ДопСвФХЖ1, "СвФактор");
			XML_ЗаполнитьСведенияОКонтрагенте_970(ИмяПакетаXDTO, СвФактор, ПротоКонтент.FactorInfo);
		КонецЕсли;
		
		MainAssignMonetaryClaim = ПротоКонтент.MainAssignMonetaryClaim;
		Если ЗначениеЗаполнено(MainAssignMonetaryClaim.Name) Тогда
			
			ОснУстДенТреб = НовыйДочернийОбъектXDTO(Фабрика, ДопСвФХЖ1, "ОснУстДенТреб");
			XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, ОснУстДенТреб, MainAssignMonetaryClaim);
			
		КонецЕсли;
		
		SellerInfoCircumPublicProc = ПротоКонтент.SellerInfoCircumPublicProc;
		Если ЗначениеЗаполнено(SellerInfoCircumPublicProc.DateStateContract) Тогда
			
			Если XML_УПД_970_ИспользуетсяФормат5_03() Тогда
				ИнфПродГосЗакКазн = НовыйДочернийОбъектXDTO(Фабрика, ДопСвФХЖ1, "ИнфПродЗаГоскКазн");
			Иначе
				ИнфПродГосЗакКазн = НовыйДочернийОбъектXDTO(Фабрика, ДопСвФХЖ1, "ИнфПродЗаГосКазн");
			КонецЕсли;
			
			ДатаГосКонтракта = Дата1С_в_ДатаXML(SellerInfoCircumPublicProc.DateStateContract);
			
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "ДатаГосКонт", ДатаГосКонтракта);
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "НомерГосКонт", SellerInfoCircumPublicProc.NumberStateContract);
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "ЛицСчетПрод", SellerInfoCircumPublicProc.PersonalAccountSeller);
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "КодПродБюджКласс", SellerInfoCircumPublicProc.SellerBudjetClassCode);
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "КодЦелиПрод", SellerInfoCircumPublicProc.SellerTargetCode);
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "КодКазначПрод", SellerInfoCircumPublicProc.SellerTreasuryCode);
			УстановитьЗначениеXDTO(ИнфПродГосЗакКазн, "НаимКазначПрод", SellerInfoCircumPublicProc.SellerTreasuryName);
			
		КонецЕсли;
		
		Для Каждого CommitmentType Из ПротоКонтент.CommitmentType Цикл
			
			ДокПодтвОтгрНом = НовыйДочернийОбъектXDTO(Фабрика, ДопСвФХЖ1, "ВидОбяз");
			
			УстановитьЗначениеXDTO(ДокПодтвОтгрНом, "КодВидОбяз", CommitmentType.Code);
			УстановитьЗначениеXDTO(ДокПодтвОтгрНом, "НаимВидОбяз", CommitmentType.Name);
			
		КонецЦикла;
		
		Для Каждого AccompanyingDocument Из ПротоКонтент.AccompanyingDocuments Цикл
			СопрДокФХЖ = НовыйДочернийОбъектXDTO(Фабрика, ДопСвФХЖ1, "СопрДокФХЖ");
			XML_УПД_970_ЗаполнитьРеквДокТип(Фабрика, СопрДокФХЖ, AccompanyingDocument);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьОбстоятельстваФормирования(ДопСвФХЖ1, Знач ПротоКонтент, Знач ФункцииУПД)
	
	Если XML_УПД_970_ИспользуетсяФормат5_03()
		И НЕ ЗначениеЗаполнено(ПротоКонтент.CircumFormatInvoice) Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ПротоКонтент.Function = ФункцииУПД.СЧФ Тогда
		СпОбстФСЧФ = XML_УПД_970_ПолучитьОбстоятельствоФормированияСЧФ(ПротоКонтент);
		УстановитьЗначениеXDTO(ДопСвФХЖ1, "СпОбстФСЧФ", СпОбстФСЧФ);
	ИначеЕсли ПротоКонтент.Function = ФункцииУПД.СЧФДОП Тогда
		СпОбстФСЧФДОП = XML_УПД_970_ПолучитьОбстоятельствоФормированияСЧФДОПиДОП(ПротоКонтент);
		УстановитьЗначениеXDTO(ДопСвФХЖ1, "СпОбстФСЧФДОП", СпОбстФСЧФДОП);
	ИначеЕсли ПротоКонтент.Function = ФункцииУПД.ДОП Тогда
		СпОбстФДОП = XML_УПД_970_ПолучитьОбстоятельствоФормированияСЧФДОПиДОП(ПротоКонтент);
		УстановитьЗначениеXDTO(ДопСвФХЖ1, "СпОбстФДОП", СпОбстФДОП);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Функция XML_УПД_970_ИспользуетсяФормат5_03()
	
	Результат = Ложь;
	
	ДатаФормата5_03 = Дата("20250122");
	Если ТекущаяУниверсальнаяДата() + 3 * 60 * 60 >= ДатаФормата5_03 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Если мы добавляем структуру ДопСвФХЖ1, то по формату в нем обязательно должно быть одно из полей:
// СпОбстФСЧФ | СпОбстФСЧФДОП | СпОбстФДОП.
// Остальные поля структуры ДопСвФХЖ1 опускаем, т.к. в интеграционном модуле они не заполняются
// Если будут обращения, дополнить условие.
//
// Параметры:
//  Content	 - Структура - прото структура
//
// Возвращаемое значение:
//  Булево - Истина - добавить структуру ДопСвФХЖ1
//
Функция XML_УПД_970_НеобходимоДобавитьДопСвФХЖ1(ПротоКонтент)
	
	Результат = (ЗначениеЗаполнено(ПротоКонтент.GovernmentContractInfo)
		Или ЗначениеЗаполнено(ПротоКонтент.CircumFormatInvoice)
		Или ЗначениеЗаполнено(ПротоКонтент.FactorInfo.Type)
		Или ЗначениеЗаполнено(ПротоКонтент.MainAssignMonetaryClaim.Name)
		Или ЗначениеЗаполнено(ПротоКонтент.SellerInfoCircumPublicProc.DateStateContract)
		Или ПротоКонтент.CommitmentType.Количество() > 0
		Или ПротоКонтент.AccompanyingDocuments.Количество() > 0);
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение для поля СпОбстФСЧФ
// Если в прото значение не указано, то возвращает значение по умолчанию
// По формату нет значений по умолчанию, но без заполнения полей СпОбстФСЧФ | СпОбстФСЧФДОП | СпОбстФДОП
// не получится заполнить вложенные поля структуры ДопСвФХЖ1
//
// Параметры:
//  Content	 - Структура - прото структура
// 
// Возвращаемое значение:
//  Строка - значение для поля СпОбстФСЧФ
//
Функция XML_УПД_970_ПолучитьОбстоятельствоФормированияСЧФ(ПротоКонтент)

	Результат = ПротоКонтент.CircumFormatInvoice;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = "1";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение для полей СпОбстФСЧФДОП и СпОбстФДОП
// Если в прото значение не указано, то возвращает значение по умолчанию
// По формату нет значений по умолчанию, но без заполнения полей СпОбстФСЧФ | СпОбстФСЧФДОП | СпОбстФДОП
// не получится заполнить вложенные поля структуры ДопСвФХЖ1
//
// Параметры:
//  Content	 - Структура - прото структура
// 
// Возвращаемое значение:
//  Строка - значение для поля СпОбстФСЧФДОП
//
Функция XML_УПД_970_ПолучитьОбстоятельствоФормированияСЧФДОПиДОП(ПротоКонтент)

	Результат = ПротоКонтент.CircumFormatInvoice;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = "00005";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_УПД_970_ЗаполнитьСведенияТаблицыСФ(ИмяПакетаXDTO, Документ, ПротоКонтент, ПараметрыФормированияФайла)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Table = ПротоКонтент.Table;
	
	Если ЗначениеЗаполнено(Table.Items) Тогда
		
		ТаблСчФакт = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ТаблСчФакт");
		
		Для НомерСтроки = 1 По Table.Items.Количество() Цикл
			
			СведТов = НовыйДочернийОбъектXDTO(Фабрика, ТаблСчФакт, "СведТов");
			
			УстановитьЗначениеXDTO(СведТов, "НомСтр", НомерСтроки);
			
			Item = Table.Items[НомерСтроки - 1];
			
			XML_УПД_970_ЗаполнитьСтрокуТабЧасти(
				ИмяПакетаXDTO,
				СведТов,
				Item,
				ПараметрыФормированияФайла);
			
		КонецЦикла;
		
		ВсегоОпл = НовыйДочернийОбъектXDTO(Фабрика, ТаблСчФакт, "ВсегоОпл");
		СумНалВсего = НовыйДочернийОбъектXDTO(Фабрика, ВсегоОпл, "СумНалВсего");
		
		УстановитьЗначениеXDTO(ВсегоОпл, "СтТовБезНДСВсего", XML_ФорматЧисла(Table.TotalWithVatExcluded, 2));
		УстановитьЗначениеXDTO(ВсегоОпл, "КолНеттоВс", Table.TotalNet);
		
		УстановитьЗначениеXDTO(ВсегоОпл, "СтТовУчНалВсего", XML_ФорматЧисла(Table.Total, 2));
		
		Если ЭтоИстина(Table.WithoutVat) Тогда
			УстановитьЗначениеXDTO(СумНалВсего, "БезНДС", СтрокаБезНДС());
		Иначе
			УстановитьЗначениеXDTO(СумНалВсего, "СумНал", XML_ФорматЧисла(Table.Vat, 2));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСтрокуТабЧасти(
		ИмяПакетаXDTO,
		СведТов,
		Item,
		ПараметрыФормированияФайла)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЗначениеЗаполнено(Item.Product) Тогда
		УстановитьЗначениеXDTO(СведТов, "НаимТов", Item.Product);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "ОКЕИ_Тов", Item.Unit);
	УстановитьЗначениеXDTO(СведТов, "НаимЕдИзм", Item.UnitName);
	
	Если ЗначениеЗаполнено(Item.Quantity) Тогда
		Количество = XML_ФорматЧисла(Item.Quantity, ПараметрыФормированияФайла.ТочностьКоличества);
		УстановитьЗначениеXDTO(СведТов, "КолТов", Количество);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Item.Price) Тогда
		
		ЦенаТовара = Item.Price;
		ТочностьЦены = ПараметрыФормированияФайла.ТочностьЦены;
		
		Если ТочностьЦены = Неопределено Тогда
			
			ТочностьЦеныПоУмолчанию = XML_ПараметрыФормированияФайла().ТочностьЦены;
			
			ЦенаПоУмолчанию = XML_ФорматЧисла(ЦенаТовара, ТочностьЦеныПоУмолчанию);
			
			Если Число(ЦенаПоУмолчанию) = ЦенаТовара Тогда
				УстановитьЗначениеXDTO(СведТов, "ЦенаТов", ЦенаПоУмолчанию);
			Иначе
				УстановитьЗначениеXDTO(СведТов, "ЦенаТов", XML_ФорматЧисла(ЦенаТовара, ТочностьЦены));
			КонецЕсли;
			
		Иначе
			УстановитьЗначениеXDTO(СведТов, "ЦенаТов", XML_ФорматЧисла(ЦенаТовара, ТочностьЦены));
		КонецЕсли;
		
	КонецЕсли;
	
	СтоимостьБезНДС = XML_ФорматЧисла(Item.SubtotalWithVatExcluded, 2);
	УстановитьЗначениеXDTO(СведТов, "СтТовБезНДС", СтоимостьБезНДС);
	
	СтоимостьСНДС = XML_ФорматЧисла(Item.Subtotal, 2);
	УстановитьЗначениеXDTO(СведТов, "СтТовУчНал", СтоимостьСНДС);
	
	СтавкаНДС = НалСт_Из_TaxRate(Item.TaxRate);
	УстановитьЗначениеXDTO(СведТов, "НалСт", СтавкаНДС);
	
	СумНал = НовыйДочернийОбъектXDTO(Фабрика, СведТов, "СумНал");
	XML_ЗаполнитьНДС(СумНал, Item.Vat, Item.WithoutVat);
	
	Акциз = НовыйДочернийОбъектXDTO(Фабрика, СведТов, "Акциз");
	
	Если НЕ ЗначениеЗаполнено(Строка(Item.Excise)) Тогда
		УстановитьЗначениеXDTO(Акциз, "БезАкциз", "без акциза");
	Иначе
		СуммаАкциза = XML_ФорматЧисла(Число(Item.Excise), 2);
		УстановитьЗначениеXDTO(Акциз, "СумАкциз", СуммаАкциза);
	КонецЕсли;
	
	ДопСведТов = НовыйДочернийОбъектXDTO(Фабрика, СведТов, "ДопСведТов");
	
	Для Каждого CustomDeclaration Из Item.CustomDeclarations Цикл
		
		СвДТ = НовыйДочернийОбъектXDTO(Фабрика, СведТов, "СвДТ");
		
		Если ЗначениеЗаполнено(CustomDeclaration.DeclarationNumber) Тогда
			УстановитьЗначениеXDTO(СвДТ, "НомерДТ", CustomDeclaration.DeclarationNumber);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(СвДТ, "КодПроисх", CustomDeclaration.CountryCode);
		
	КонецЦикла;
	
	Если XML_УПД_970_ИспользуетсяФормат5_03() Тогда
		XML_УПД_970_УстановитьСтрануПроисхожденияДопСведТов_5_03(ИмяПакетаXDTO, ДопСведТов, Item);
	Иначе
		XML_УПД_970_УстановитьСтрануПроисхожденияДопСведТов_5_02(ИмяПакетаXDTO, ДопСведТов, Item);
	КонецЕсли;
	
	XML_УПД_970_ЗаполнитьДопСведТов(ИмяПакетаXDTO, ДопСведТов, Item);
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СведТов.ИнфПолФХЖ2, Item.StructedAdditionalInfos);
	
КонецПроцедуры

Процедура XML_УПД_970_УстановитьСтрануПроисхожденияДопСведТов_5_02(ИмяПакетаXDTO, ДопСведТов, СтрокаТоварыПрото)
	
	СтранаПроисхождения = Неопределено;
	
	Для Каждого CustomDeclaration Из СтрокаТоварыПрото.CustomDeclarations Цикл
		
		Если ЗначениеЗаполнено(CustomDeclaration.CountryCode)
			И НЕ ЗначениеЗаполнено(СтранаПроисхождения) Тогда
			СтранаПроисхождения = НаименованиеСтраны(CustomDeclaration.CountryCode);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьЗначениеXDTO(ДопСведТов, "КрНаимСтрПр", СтранаПроисхождения);
	
КонецПроцедуры

Процедура XML_УПД_970_УстановитьСтрануПроисхожденияДопСведТов_5_03(ИмяПакетаXDTO, ДопСведТов, СтрокаТоварыПрото)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого CustomDeclaration Из СтрокаТоварыПрото.CustomDeclarations Цикл
		
		Если ЗначениеЗаполнено(CustomDeclaration.CountryCode) Тогда
			СтранаПроисхождения = НаименованиеСтраны(CustomDeclaration.CountryCode);
			ДопСведТов.КрНаимСтрПр.Добавить(СтранаПроисхождения);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьДопСведТов(ИмяПакетаXDTO, ДопСведТов, СтрокаТоварыПрото)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ПризнакНоменклатуры = XML_ПолучитьПризнакНоменклатуры(СтрокаТоварыПрото.ItemMark);
	
	УстановитьЗначениеXDTO(ДопСведТов, "ПрТовРаб", ПризнакНоменклатуры);
	УстановитьЗначениеXDTO(ДопСведТов, "ДопПризн", СтрокаТоварыПрото.AdditionalProperty);
	УстановитьЗначениеXDTO(ДопСведТов, "НадлОтп", СтрокаТоварыПрото.ItemToRelease);
	УстановитьЗначениеXDTO(ДопСведТов, "ХарактерТов", СтрокаТоварыПрото.ItemCharact);
	УстановитьЗначениеXDTO(ДопСведТов, "СортТов", СтрокаТоварыПрото.ItemKind);
	УстановитьЗначениеXDTO(ДопСведТов, "СерияТов", СтрокаТоварыПрото.Series);
	УстановитьЗначениеXDTO(ДопСведТов, "АртикулТов", СтрокаТоварыПрото.ItemArticle);
	УстановитьЗначениеXDTO(ДопСведТов, "КодТов", СтрокаТоварыПрото.ItemVendorCode);
	УстановитьЗначениеXDTO(ДопСведТов, "ГТИН", GTINКаноническогоВида(СтрокаТоварыПрото.GTIN));
	УстановитьЗначениеXDTO(ДопСведТов, "КодКат", СтрокаТоварыПрото.CatalogCode);
	УстановитьЗначениеXDTO(ДопСведТов, "КодВидТов", СтрокаТоварыПрото.ItemTypeCode);
	УстановитьЗначениеXDTO(ДопСведТов, "КодВидПр", СтрокаТоварыПрото.ProductTypeCode);
	
	Если XML_УПД_970_ИспользуетсяФормат5_03() Тогда
		УстановитьЗначениеXDTO(ДопСведТов, "КодТовОКПД2", СтрокаТоварыПрото.CodeRCPEA);
	Иначе
		УстановитьЗначениеXDTO(ДопСведТов, "КодТовОКДП2", СтрокаТоварыПрото.CodeRCPEA);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.RecoveredVat) Тогда
		СумНалВосст = НовыйДочернийОбъектXDTO(Фабрика, ДопСведТов, "СумНалВосст");
		XML_ЗаполнитьНДС(СумНалВосст, СтрокаТоварыПрото.RecoveredVat, СтрокаТоварыПрото.RecoveredWithoutVat);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.AdditionalInfoTypeOperations) Тогда
		УстановитьЗначениеXDTO(ДопСведТов, "ДопИнфПВидО", СтрокаТоварыПрото.AdditionalInfoTypeOperations);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.ItemTracingInfos) Тогда
		
		XML_УПД_970_ЗаполнитьСведПрослеж(ИмяПакетаXDTO, ДопСведТов, СтрокаТоварыПрото.ItemTracingInfos, "СведПрослеж");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.ItemIdentificationNumbers) Тогда
		XML_УПД_970_ЗаполнитьНомСредИдентТов(
			ИмяПакетаXDTO,
			ДопСведТов,
			СтрокаТоварыПрото.ItemIdentificationNumbers,
			"НомСредИдентТов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.AdditionalInfoStateSystem) Тогда
		XML_УПД_970_ЗаполнитьСвГосСист(ИмяПакетаXDTO, ДопСведТов, СтрокаТоварыПрото.AdditionalInfoStateSystem, "СвГосСист");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.ItemAccompanyingDocuments) Тогда
		XML_УПД_970_ЗаполнитьСопрДокТов(ИмяПакетаXDTO, ДопСведТов, СтрокаТоварыПрото.ItemAccompanyingDocuments, "СопрДокТов");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТоварыПрото.TaxDeprication.Code) Тогда
		
		НалУчАморт = НовыйДочернийОбъектXDTO(Фабрика, ДопСведТов, "НалУчАморт");
		
		TaxDeprication = СтрокаТоварыПрото.TaxDeprication;
		
		УстановитьЗначениеXDTO(НалУчАморт, "АмГруппа", TaxDeprication.Code);
		УстановитьЗначениеXDTO(НалУчАморт, "КодОКОФ", TaxDeprication.OKOF);
		УстановитьЗначениеXDTO(НалУчАморт, "СрПолИспОС", TaxDeprication.UsefulPeriod);
		УстановитьЗначениеXDTO(НалУчАморт, "ФактСрокИсп", TaxDeprication.ActualPeriod);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьНомСредИдентТов(ИмяПакетаXDTO, ОбъектXDTO, ItemIdentificationNumbers, ИмяИнфоПоля)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого ItemIdentificationNumber Из ItemIdentificationNumbers Цикл
		
		НомСредИдентТов = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, ИмяИнфоПоля);
		
		XML_ЗаполнитьЗначениеНомСредИдентТов(ИмяПакетаXDTO, НомСредИдентТов, ItemIdentificationNumber);
		
		Если ЗначениеЗаполнено(ItemIdentificationNumber.MarkedItemsQuantity) Тогда
			УстановитьЗначениеXDTO(НомСредИдентТов, "КолВедМарк", ItemIdentificationNumber.MarkedItemsQuantity);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(НомСредИдентТов, "ПрПартМарк", ItemIdentificationNumber.BatchCode);

	КонецЦикла;
		
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСвГосСист(ИмяПакетаXDTO, ОбъектXDTO, StructedAdditionalInfos, ИмяИнфоПоля)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
