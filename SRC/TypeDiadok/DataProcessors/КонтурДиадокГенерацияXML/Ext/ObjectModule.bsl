КонецФункции

Функция ВалидацияАктСверки405_Участник_СвЮЛУч(ExtendedOrganizationInfo, СсылкаУчастник,
	ПредставлениеУчастника, ВидУчастникаРодительныйПадеж)
	
	СписокОшибок = Новый Массив;
	
	СтрокаОшибка = ПроверитьИННКонтрагента(ExtendedOrganizationInfo.Inn, "ЮрЛицо", ВидУчастникаРодительныйПадеж);
	
	Если ЗначениеЗаполнено(СтрокаОшибка) Тогда
		
		ШаблонОшибки = "Ошибки в сведениях <%1>.
		|%2.
		|Перейдите в карточку %3 и заполните ИНН";
		
		СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
			ПредставлениеУчастника,
			СтрокаОшибка,
			ВидУчастникаРодительныйПадеж);
		
		ДобавитьОшибкуВалидации(СписокОшибок, СтрокаОшибка, СсылкаУчастник);
		
	КонецЕсли;
	
	СтрокаОшибка = ПроверитьКППКонтрагента(ExtendedOrganizationInfo.Kpp, ВидУчастникаРодительныйПадеж);
	
	Если ЗначениеЗаполнено(СтрокаОшибка) Тогда
		
		ШаблонОшибки = "Ошибки в сведениях <%1>.
		|%2.
		|Перейдите в карточку %3 и заполните КПП";
		
		СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
			ПредставлениеУчастника,
			СтрокаОшибка,
			ВидУчастникаРодительныйПадеж);
		
		ДобавитьОшибкуВалидации(СписокОшибок, СтрокаОшибка, СсылкаУчастник);
		
	КонецЕсли;
	
	ОшибкаОГРН = ОшибкаФорматаПоля(ExtendedOrganizationInfo.Ogrn,
	"ОГРН", Истина, 13, 13, Истина);
	
	Если ЗначениеЗаполнено(ОшибкаОГРН) Тогда
		
		ШаблонОшибки = "Ошибки в сведениях <%1>.
		|%2.
		|Перейдите в карточку %3 и заполните ОГРН";
		
		СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
			ПредставлениеУчастника,
			ОшибкаОГРН,
			ВидУчастникаРодительныйПадеж);

		ДобавитьОшибкуВалидации(СписокОшибок, СтрокаОшибка, СсылкаУчастник);

	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияАктСверки405_Участник_ФЛ(ExtendedOrganizationInfo, СсылкаУчастник,
	ПредставлениеУчастника, ВидУчастникаРодительныйПадеж)
	
	СписокОшибок = Новый Массив;
	
	СтрокаОшибка = ПроверитьИННКонтрагента(ExtendedOrganizationInfo.Inn, "ФизЛицо", ВидУчастникаРодительныйПадеж);
	
	Если ЗначениеЗаполнено(СтрокаОшибка) Тогда
		
		ШаблонОшибки = "Ошибки в сведениях <%1>.
		|%2.
		|Перейдите в карточку %3 и заполните ИНН";
		
		СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
			ПредставлениеУчастника,
			СтрокаОшибка,
			ВидУчастникаРодительныйПадеж);
		
		ДобавитьОшибкуВалидации(СписокОшибок, СтрокаОшибка, СсылкаУчастник);
		
	КонецЕсли;
	
	Если ExtendedOrganizationInfo.Свойство("Name") = Неопределено Тогда
		
		ШаблонОшибки = "Ошибки в сведениях <%1>.
		|Не указано имя/фамилия.
		|Перейдите в карточку %2 и заполните";
		
		СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
