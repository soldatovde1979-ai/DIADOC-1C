		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция XML_ПротоСтруктураФИО(ФИО)
	
	Результат = Новый Структура;
	Результат.Вставить("Surname"	, "");
	Результат.Вставить("Firstname"	, "");
	Результат.Вставить("Patronymic"	, "");
	
	МассивФИО = РазложитьСтрокуВМассивСлов(ФИО, " ");
	Разделитель = "";
	
	Для Сч = 0 По МассивФИО.ВГраница() Цикл
		
		ЧастьФИО = МассивФИО[Сч];
		
		Если Сч = 0 Тогда
			
			Результат.Surname = ЧастьФИО;
			
		ИначеЕсли Сч = 1 Тогда
			
			Результат.Firstname = ЧастьФИО;
			
		Иначе
			
			Результат.Patronymic = Результат.Patronymic + Разделитель + ЧастьФИО;
			Разделитель = " ";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция XML_СтрокаФИО(ОбъектXDTO)
	
	Результат = ОбъектXDTO.Фамилия + " " + ОбъектXDTO.Имя;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "Отчество") Тогда
