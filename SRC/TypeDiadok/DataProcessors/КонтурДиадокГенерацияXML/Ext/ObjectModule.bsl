//{ МЕТОДЫ ГЕНЕРАЦИИ XML-файлов ИЗ Proto

Процедура XML_ВыгрузитьФайл(ИмяПакетаXDTO, ОбъектXDTO, ИмяФайла, ТипКодировки = "windows-1251") Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку(ТипКодировки);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);	
	Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, , , , НазначениеТипаXML.Неявное);
	
	СтрокаXML = ЗаписьXML.Закрыть();
	
	XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, СтрокаXML);
	
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(СтрокаXML);
	ТД.Записать(ИмяФайла, ТипКодировки);
	
КонецПроцедуры

Функция ОбъектXDTO_В_ДвоичныеДанные(ОбъектXDTO, ТипКодировки = "windows-1251") Экспорт
	
	ИмяПакетаXDTO = ОбъектXDTO.Тип().URIПространстваИмен;
	
	Если ПриложениеСтаршеВерсии("8.3.9") Тогда
		
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		
		XML_ВыгрузитьФайл(ИмяПакетаXDTO, ОбъектXDTO, ИмяФайла, ТипКодировки);
		
		Результат = Новый ДвоичныеДанные(ИмяФайла);
		
		Попытка
			
			УдалитьФайлы(ИмяФайла);
			
		Исключение
			
			Ошибка = ИнформацияОбОшибке();
			
			ЖурналРегистрации_ЗаписатьПредупреждение(
				"ФормированиеXML",
				ПодробноеПредставлениеОшибки(Ошибка)
			);
			
		КонецПопытки;
		
	Иначе
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку(ТипКодировки);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
		Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, , , , НазначениеТипаXML.Неявное);
		
		СтрокаXML = ЗаписьXML.Закрыть();
		
		XML_УдалитьОбъявлениеПрефиксовПространстваИмен(ИмяПакетаXDTO, СтрокаXML);
		
		Поток = Новый("ПотокВПамяти");
		ПараметрыЗаписи = Новый Массив;
		ПараметрыЗаписи.Добавить(Поток);
		ПараметрыЗаписи.Добавить(ТипКодировки);
		Запись = Новый("ЗаписьДанных", ПараметрыЗаписи);
		
		Запись.ЗаписатьСимволы(СтрокаXML);
