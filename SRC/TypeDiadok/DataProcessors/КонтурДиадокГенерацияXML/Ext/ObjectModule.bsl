Процедура Заполнить_UtdBuyerContent(Контент, Параметры)
	
	ИнфПок = Параметры.ИнфПок;
	СодФХЖ4 = ИнфПок.СодФХЖ4;
	
	УстановитьЗначениеXDTO(Контент, "Creator",			ИнфПок.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "CreatorBase",		ПолучитьЗначениеXDTO(ИнфПок, "ОснДоверОргСост"));
	УстановитьЗначениеXDTO(Контент, "OperationCode",	ПолучитьЗначениеXDTO(СодФХЖ4, "ВидОперации"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СодФХЖ4, "СвПрин") Тогда
		
		// УПД
		СвПрин = СодФХЖ4.СвПрин;
		
		УстановитьЗначениеXDTO(Контент, "OperationContent",    СвПрин.СодОпер);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин, "ДатаПрин") Тогда
			УстановитьЗначениеXDTO(Контент, "AcceptanceDate", ДатаXML_в_Дата1С(СвПрин.ДатаПрин));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин, "СвЛицПрин") Тогда
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПрин.СвЛицПрин, "РабОргПок") Тогда
				Заполнить_Employee(Контент.Employee, СвПрин.СвЛицПрин.РабОргПок);
			Иначе
