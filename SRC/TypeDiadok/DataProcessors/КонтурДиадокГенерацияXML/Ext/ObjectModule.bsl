Функция XML_ПолучитьПустойОбъектXDTO(Тип, ИмяПакетаXDTO) Экспорт
	
	Результат = Неопределено;
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ЧастиПути = РазложитьСтрокуВМассивСлов(Тип, ".");
	
	Если ИмяПакетаXDTO = "Proto" Тогда
		ПространствоИмен = ПространствоИменПрото();
	Иначе
		ПространствоИмен = ИмяПакетаXDTO;
	КонецЕсли;
	
	ТипОбъекта = Фабрика.Тип(ПространствоИмен, ЧастиПути[0]);
	
	ЧастиПути.Удалить(0);
	
	Коллекция = ТипОбъекта.Свойства;
	
	Пока ЗначениеЗаполнено(ЧастиПути) Цикл
		
		Если Коллекция = Неопределено Тогда
			ТипОбъекта = Неопределено;
			Прервать;
		КонецЕсли;
		
		Свойство = Коллекция.Получить(ЧастиПути[0]);
		
		Если Свойство = Неопределено Тогда
			ТипОбъекта = Неопределено;
			Прервать;
		КонецЕсли;
		
		ТипОбъекта = Свойство.Тип;
		
		ЧастиПути.Удалить(0);
		
		Попытка
			Коллекция = ТипОбъекта.Свойства;
		Исключение
			Прервать;
		КонецПопытки;
		
	КонецЦикла;
	
	Если ТипОбъекта <> Неопределено Тогда
		Результат = Фабрика.Создать(ТипОбъекта);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

