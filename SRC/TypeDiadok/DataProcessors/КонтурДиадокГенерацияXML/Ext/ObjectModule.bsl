Функция УПД820_КонвертироватьАдресУчастникаЭДО_в970(Address820)
	
	Перем Результат;
	
	Результат = НовыйProtoОбъектXDTO("AddressInfo970");

	ВидыАдресов = Перечисление_ВидыАдресов();

	Если ЗначениеЗаполнено(Address820.RegionCode) Тогда
		
		Результат.Type = ВидыАдресов.АдресРФ;
		Результат.AddressRF = НовыйProtoОбъектXDTO("AddressRFInfo");
		
