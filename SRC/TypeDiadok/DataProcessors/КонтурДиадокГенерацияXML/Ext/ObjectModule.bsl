Процедура Заполнить_OtherIssuer_Torg2(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ПредОргПрин") Тогда
		
		// Представитель организации, уполномоченной на принятие товаров (груза)
		
		ПредОргПрин = Параметры.ПредОргПрин;
		
		УстановитьЗначениеXDTO(Контент, "Position", ПредОргПрин.Должность);
		УстановитьЗначениеXDTO(Контент, "EmployeeInfo", ПолучитьЗначениеXDTO(ПредОргПрин, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "EmployeeBase", ПолучитьЗначениеXDTO(ПредОргПрин, "ОснПолнПредПрин"));
		УстановитьЗначениеXDTO(Контент, "OrganizationName", ПредОргПрин.НаимОргПрин);
		УстановитьЗначениеXDTO(Контент, "OrganizationBase", ПолучитьЗначениеXDTO(ПредОргПрин, "ОснДоверОргПрин"));
		УстановитьЗначениеXDTO(Контент, "LastName", ПредОргПрин.ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "FirstName", ПредОргПрин.ФИО.Имя);
		УстановитьЗначениеXDTO(Контент, "MiddleName", ПолучитьЗначениеXDTO(ПредОргПрин.ФИО, "Отчество"));
		
	Иначе
		
		// Физическое лицо, которое уполномочено на принятие товаров (груза) "ФЛПрин"
		
		ФЛПрин = Параметры.ФЛПрин;
		
		УстановитьЗначениеXDTO(Контент, "EmployeeInfo", ПолучитьЗначениеXDTO(ФЛПрин, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "EmployeeBase", ПолучитьЗначениеXDTO(ФЛПрин, "ОснДоверФЛ"));
		УстановитьЗначениеXDTO(Контент, "LastName", ФЛПрин.ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "FirstName", ФЛПрин.ФИО.Имя);
		УстановитьЗначениеXDTO(Контент, "MiddleName", ПолучитьЗначениеXDTO(ФЛПрин.ФИО, "Отчество"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_AccompanyingDocument(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Name", Параметры.НаимСопрДок);
	УстановитьЗначениеXDTO(Контент, "Number", ПолучитьЗначениеXDTO(Параметры, "НомСопрДок"));
	УстановитьЗначениеXDTO(Контент, "Date", ДатаXML_в_Дата1С(ПолучитьЗначениеXDTO(Параметры, "ДатаСопрДок")));
	УстановитьЗначениеXDTO(Контент, "AdditionalIdentifier", ПолучитьЗначениеXDTO(Параметры, "ДопИдСопрДок"));
	
КонецПроцедуры

Процедура Заполнить_Address_Torg2(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АдрРФ") Тогда
		
		// Адрес, указанный в Едином государственном реестре юридических лиц/почтовый адрес/адрес места жительства индивидуального предпринимателя (реквизиты адреса на территории Российской Федерации)
		
		АдрРФ = Параметры.АдрРФ;
		УстановитьЗначениеXDTO(Контент.RussianAddress, "ZipCode", ПолучитьЗначениеXDTO(АдрРФ, "Индекс"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Region", АдрРФ.КодРегион);
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Territory", ПолучитьЗначениеXDTO(АдрРФ, "Район"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "City", ПолучитьЗначениеXDTO(АдрРФ, "Город"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Locality", ПолучитьЗначениеXDTO(АдрРФ, "НаселПункт"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Street", ПолучитьЗначениеXDTO(АдрРФ, "Улица"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Building", ПолучитьЗначениеXDTO(АдрРФ, "Дом"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Block", ПолучитьЗначениеXDTO(АдрРФ, "Корпус"));
		УстановитьЗначениеXDTO(Контент.RussianAddress, "Apartment", ПолучитьЗначениеXDTO(АдрРФ, "Кварт"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АдрИнф") Тогда
		
		// Адрес, указанный в Едином государственном реестре юридических лиц/почтовый адрес/адрес места жительства индивидуального предпринимателя (информация об адресе, в том числе об адресе за пределами территории Российской Федерации)
		
		АдрИнф = Параметры.АдрИнф;
		УстановитьЗначениеXDTO(Контент.ForeignAddress, "Country", АдрИнф.КодСтр);
		УстановитьЗначениеXDTO(Контент.ForeignAddress, "Address", АдрИнф.АдрТекст);
		
	Иначе
		
		// Уникальный номер адреса объекта адресации в государственном адресном реестре "КодГАР"
		
		УстановитьЗначениеXDTO(Контент, "AddressCode", Параметры.КодГАР);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_AcceptanceResults(Контент, Параметры)
	
	Для Каждого РезПрием Из Параметры Цикл
		
		AcceptanceResult = НовыйЭлементСпискаXDTO(Контент.AcceptanceResult);
		
		Ценности = РезПрием.Ценности;
		Assets = AcceptanceResult.Assets;
		
		УстановитьЗначениеXDTO(Assets, "AccompanyingDocumentLineNumber", ПолучитьЗначениеXDTO(Ценности, "НомСтрСопрДок"));
		УстановитьЗначениеXDTO(Assets, "Product", ПолучитьЗначениеXDTO(Ценности, "НаимТов"));
		УстановитьЗначениеXDTO(Assets, "ItemCharact", ПолучитьЗначениеXDTO(Ценности, "ХарактТов"));
		УстановитьЗначениеXDTO(Assets, "ItemKind", ПолучитьЗначениеXDTO(Ценности, "СортТов"));
		УстановитьЗначениеXDTO(Assets, "ItemArticle", ПолучитьЗначениеXDTO(Ценности, "АртикулТов"));
		УстановитьЗначениеXDTO(Assets, "ItemVendorCode", ПолучитьЗначениеXDTO(Ценности, "КодТов"));
		УстановитьЗначениеXDTO(Assets, "PassportNumber", ПолучитьЗначениеXDTO(Ценности, "Паспорт"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "ПоДокум") Тогда
			Заполнить_AcceptedProductData(AcceptanceResult.AccordingToSellerDocument, РезПрием.ПоДокум);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "ПоФакту") Тогда
			Заполнить_AcceptedProductData(AcceptanceResult.ActuallyAccepted, РезПрием.ПоФакту);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "Брак") Тогда
			Заполнить_DiscrepancyData(AcceptanceResult.Reject, РезПрием.Брак);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "Бой") Тогда
			Заполнить_DiscrepancyData(AcceptanceResult.Breakage, РезПрием.Бой);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "Недостача") Тогда
			Заполнить_DiscrepancyData(AcceptanceResult.Shortfall, РезПрием.Недостача);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "Излишки") Тогда
			Заполнить_DiscrepancyData(AcceptanceResult.Surplus, РезПрием.Излишки);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "ЦенОтклон") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием.ЦенОтклон, "ПолДельта") Тогда
				Заполнить_Delta(AcceptanceResult.PriceDeviations.PositiveDeviations, РезПрием.ЦенОтклон.ПолДельта);
			Иначе
				Заполнить_Delta(AcceptanceResult.PriceDeviations.NegativeDeviations, РезПрием.ЦенОтклон.ОтрицатДельта);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РезПрием, "ИнфПолРезПрием") Тогда
			Заполнить_СписокIdValue(AcceptanceResult.AdditionalInfos.AdditionalInfo, РезПрием, "ИнфПолРезПрием");
		КонецЕсли;
		
		УстановитьЗначениеXDTO(AcceptanceResult, "Unit", ПолучитьЗначениеXDTO(РезПрием, "ОКЕИ_Тов"));
		УстановитьЗначениеXDTO(AcceptanceResult, "UnitName", ПолучитьЗначениеXDTO(РезПрием, "НаимЕдИзм"));
		УстановитьЗначениеXDTO(AcceptanceResult, "AcceptanceDiscrepancyInfo", ПолучитьЗначениеXDTO(РезПрием, "РасхРабУслПрав"));
		
	КонецЦикла;
	
КонецПроцедуры

