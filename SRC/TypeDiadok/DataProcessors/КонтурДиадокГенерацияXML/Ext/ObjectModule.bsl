Процедура Заполнить_UtdSellerContent(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Function",					Параметры.Документ.Функция);
	ФункцииУПД = Перечисление_ФункцииУПД();
	Если Не Параметры.Документ.Функция = ФункцииУПД.СЧФ Тогда
		УстановитьЗначениеXDTO(Контент, "Name",					Параметры.Документ.НаимДокОпр);
	КонецЕсли;
	УстановитьЗначениеXDTO(Контент, "Currency",					Параметры.Документ.СвСчФакт.КодОКВ);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "ДатаСчФ") Тогда
		УстановитьЗначениеXDTO(Контент, "Date", ДатаXML_в_Дата1С(Параметры.Документ.СвСчФакт.ДатаСчФ));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "НомерСчФ") Тогда
		УстановитьЗначениеXDTO(Контент, "Number", Параметры.Документ.СвСчФакт.НомерСчФ);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "ИспрСчф") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт.ИспрСчФ, "ДатаИспрСчф") Тогда
			УстановитьЗначениеXDTO(Контент, "RevisionDate", ДатаXML_в_Дата1С(Параметры.Документ.СвСчФакт.ИспрСчФ.ДатаИспрСчф));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт.ИспрСчФ, "НомИспрСчФ") Тогда
			УстановитьЗначениеXDTO(Контент, "RevisionNumber", Параметры.Документ.СвСчФакт.ИспрСчФ.НомИспрСчФ);
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Creator",					Параметры.Документ.НаимЭконСубСост);
	УстановитьЗначениеXDTO(Контент, "CreatorBase",				ПолучитьЗначениеXDTO(Параметры.Документ, "ОснДоверОргСост"));
	
	Заполнить_ExtendedOrganizationInfo(Контент.Seller, Параметры.Документ.СвСчФакт.СвПрод);
	Контент.Seller.FnsParticipantId = Параметры.СвУчДокОбор.ИдОтпр;
	
	Заполнить_ExtendedOrganizationInfo(Контент.Buyer, Параметры.Документ.СвСчФакт.СвПокуп);
	Контент.Buyer.FnsParticipantId = Параметры.СвУчДокОбор.ИдПол;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "ГрузОт") Тогда
		Заполнить_Shipper(Контент.Shipper, Параметры.Документ.СвСчФакт.ГрузОт);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "ГрузПолуч") Тогда
		Заполнить_ExtendedOrganizationInfo(Контент.Consignee, Параметры.Документ.СвСчФакт.ГрузПолуч);
	КонецЕсли; 
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ, "ТаблСчФакт") Тогда
		Заполнить_InvoiceTable(Контент.InvoiceTable, Параметры.Документ.ТаблСчФакт);
	КонецЕсли;
		
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "ИнфПолФХЖ1") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, Параметры.Документ.СвСчФакт.ИнфПолФХЖ1);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ.СвСчФакт, "ДопСвФХЖ1") Тогда
		УстановитьЗначениеXDTO(Контент, "CurrencyRate",				ПолучитьЗначениеXDTO(Параметры.Документ.СвСчФакт.ДопСвФХЖ1, "КурсВал")); 
		УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo",	ПолучитьЗначениеXDTO(Параметры.Документ.СвСчФакт.ДопСвФХЖ1, "ИдГосКон"));
	КонецЕсли;
		
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.Документ, "СвПродПер") Тогда
		Заполнить_TransferInfo(Контент.TransferInfo, Параметры.Документ.СвПродПер);
	КонецЕсли;
	
	Для Каждого СвПРД Из СписокXDTOИзЭлемента(Параметры.Документ.СвСчФакт, "СвПРД") Цикл
		Заполнить_PaymentDocument(НовыйЭлементСпискаXDTO(Контент.PaymentDocuments), СвПРД);
	КонецЦикла;
	
	Заполнить_ExtendedSigner(Контент.Signers, Параметры.Документ, "Подписант");
	
КонецПроцедуры

