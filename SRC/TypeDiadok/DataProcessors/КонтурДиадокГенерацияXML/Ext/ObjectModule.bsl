КонецФункции

Функция ВалидацияТорг2_ДанныеОПринимаемомТоваре(AcceptedProductData)
	
	СписокОшибок = Новый Массив;
	
	Если СтруктураЗаполнена(AcceptedProductData.ItemIdentificationNumbers) Тогда
		Ошибки = ВалидацияТорг2_НомераСредствИдентификацииТоваров(AcceptedProductData.ItemIdentificationNumbers);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в номерах средств идентификации товаров");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(AcceptedProductData.Quantity) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Не указано количество (масса)");
	КонецЕсли;
	
	Возврат СписокОшибок;
	
