	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ПредОргПер") Тогда
		
		УстановитьЗначениеXDTO(Контент, "EmployeePosition",			Параметры.ПредОргПер.Должность);
		УстановитьЗначениеXDTO(Контент, "EmployeeInfo",				ПолучитьЗначениеXDTO(Параметры.ПредОргПер, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "OrganizationName",			Параметры.ПредОргПер.НаимОргПер);
		УстановитьЗначениеXDTO(Контент, "OrganizationBase",			ПолучитьЗначениеXDTO(Параметры.ПредОргПер, "ОснДоверОргПер"));
		УстановитьЗначениеXDTO(Контент, "EmployeeBase",				ПолучитьЗначениеXDTO(Параметры.ПредОргПер, "ОснПолнПредОформ"));
		УстановитьЗначениеXDTO(Контент, "Surname",					Параметры.ПредОргПер.ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "FirstName",				Параметры.ПредОргПер.ФИО.Имя);
		УстановитьЗначениеXDTO(Контент, "Patronymic",				ПолучитьЗначениеXDTO(Параметры.ПредОргПер.ФИО, "Отчество"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ПредОргПрин") Тогда
		
		УстановитьЗначениеXDTO(Контент, "EmployeePosition",	Параметры.ПредОргПрин.Должность);
		УстановитьЗначениеXDTO(Контент, "EmployeeInfo",		ПолучитьЗначениеXDTO(Параметры.ПредОргПрин, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "OrganizationName", Параметры.ПредОргПрин.НаимОргПрин);
		УстановитьЗначениеXDTO(Контент, "OrganizationBase",	ПолучитьЗначениеXDTO(Параметры.ПредОргПрин, "ОснДоверОргПрин"));
		УстановитьЗначениеXDTO(Контент, "EmployeeBase",		ПолучитьЗначениеXDTO(Параметры.ПредОргПрин, "ОснПолнПредПрин"));
		УстановитьЗначениеXDTO(Контент, "Surname",			Параметры.ПредОргПрин.ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "FirstName",		Параметры.ПредОргПрин.ФИО.Имя);
		УстановитьЗначениеXDTO(Контент, "Patronymic",		ПолучитьЗначениеXDTO(Параметры.ПредОргПрин.ФИО, "Отчество"));	
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ФЛПер") Тогда
		
		УстановитьЗначениеXDTO(Контент, "EmployeeInfo",				ПолучитьЗначениеXDTO(Параметры.ФЛПер, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "OrganizationBase",			ПолучитьЗначениеXDTO(Параметры.ФЛПер, "ОснДоверФЛ"));
		УстановитьЗначениеXDTO(Контент, "Surname",					Параметры.ФЛПер.ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "FirstName",				Параметры.ФЛПер.ФИО.Имя);
