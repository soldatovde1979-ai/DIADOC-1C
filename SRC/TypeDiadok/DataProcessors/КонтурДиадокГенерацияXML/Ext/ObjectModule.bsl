Функция ВалидацияСчетаФНС29(Content) Экспорт
	
	СписокОшибок = Новый Массив;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentNumber, "Номер счета", Истина, 1, 255, Ложь, "м");
	ПроверитьФорматДаты(СписокОшибок, Content.DocumentDate, "Дата счета", Истина);
	// BSLLS:MagicNumber-on
	
	ВалидацияСчетаФНС29_ПроверитьДополнительныеСведения(Content.ProformaInvoiceAdditionalInfo, СписокОшибок);
	
	ВалидацияСчетаФНС29_ПроверитьВалюту(Content.Currency, Content.IsConventionalUnit, СписокОшибок);
	
	ВалидацияСчетаФНС29_ПроверитьСведенияОПродавце(Content.Seller, СписокОшибок);
	ВалидацияСчетаФНС29_ПроверитьСведенияОПокупателе(Content.Buyer, СписокОшибок);
	
	ВалидацияСчетаФНС29_ПроверитьСведенияОГрузоотправителе(Content.Shipper, СписокОшибок);
	ВалидацияСчетаФНС29_ПроверитьСведенияОГрузополучателе(Content.Consignee, СписокОшибок);
	ВалидацияСчетаФНС29_ПроверитьСведенияОПлательщике(Content.Payer, СписокОшибок);
	ВалидацияСчетаФНС29_ПроверитьСведенияОПолучателеДенежныхСредств(Content.MoneyRecipient, СписокОшибок);
	
	ВалидацияСчетаФНС29_ПроверитьТабличныеДанныеДокумента(Content.Table, СписокОшибок);
	
	ВалидацияСчетаФНС29_ПроверитьРеквизитыОснованийВыставленияСчета(Content.ProformaInvoiceBases, СписокОшибок);
	
	Возврат СписокОшибок;
	
КонецФункции

Процедура ВалидацияСчетаФНС29_ПроверитьДополнительныеСведения(ProformaInvoiceAdditionalInfo, СписокОшибок)
	
	Если ProformaInvoiceAdditionalInfo = Неопределено
		Или Не СтруктураЗаполнена(ProformaInvoiceAdditionalInfo) Тогда
		Возврат;
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	НазначениеПлатежа = ProformaInvoiceAdditionalInfo.PaymentPurpose;
	ПроверитьФорматПоля(СписокОшибок, НазначениеПлатежа, "Назначение платежа", Истина, 1, 210, Ложь, "с");
	// BSLLS:MagicNumber-on
	
	ШаблонТекстаОшибки = "[%1] Дополнительное условие";
	
	ОшибкиВалидацииДопСведений = Новый Массив;

	НомерСтроки = 1;
	Для Каждого PaymentTerm Из ProformaInvoiceAdditionalInfo.PaymentTerms Цикл
		
		ПредставлениеПоля = Общее_ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, НомерСтроки);
		
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(ОшибкиВалидацииДопСведений, PaymentTerm, ПредставлениеПоля, Ложь, 1, 1000, Ложь, "с");
		// BSLLS:MagicNumber-on
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	ДобавитьГруппуОшибокВалидации(
		СписокОшибок,
		ОшибкиВалидацииДопСведений,
		"Ошибки в дополнительных условиях по документу");
	
КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьВалюту(КодВалюты, ЭтоУсловныеЕдиницы, СписокОшибок)
	
	ОшибкиВалидацииВалюты = Новый Массив;
	
	Если Не ЭтоУсловныеЕдиницы Тогда
		
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(ОшибкиВалидацииВалюты, КодВалюты, "Код валюты счета", Истина, 3, 3, Истина, "м");
		// BSLLS:MagicNumber-on
		
		Если ОшибкиВалидацииВалюты.Количество() = 0 Тогда
			ПроверитьКодВалютыПоКлассификатору(КодВалюты, ОшибкиВалидацииВалюты);
		КонецЕсли;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВалидацииВалюты, "Ошибки в заполнении валюты");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьСведенияОПродавце(Seller, СписокОшибок)
	
	Если ЗначениеЗаполнено(Seller)
		И СтруктураЗаполнена(Seller) Тогда
			
		ОшибкиКонтрагента = ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастнике(Seller);
		
		ОшибкиАдреса = ВалидацияСчетаФНС29_ПроверитьСтруктуруАдреса(Seller.Address);
		Если ЗначениеЗаполнено(ОшибкиАдреса) Тогда 
			ДобавитьОшибкуВалидацииСОформлением(ОшибкиКонтрагента, "Ошибки в юридическом адресе:", , "b");
			ДополнитьМассивОшибокВалидации(ОшибкиКонтрагента, ОшибкиАдреса);
		КонецЕсли;
		
		Если ВалидацияСчетаФНС29_ЕстьСведенияОБанковскомСчете(Seller) Тогда
			ОшибкиБанковскогоСчета = ВалидацияСчетаФНС29_ПроверитьСведенияОБанковскомСчете(Seller);
		Иначе
			ОшибкиБанковскогоСчета = ВалидацияСчетаФНС29_ТекстОшибкиПриОтсутствииБанковскихСведенийВДокументе1С();
		КонецЕсли;
		
		ВалидацияСчетаФНС29_ДополнитьОшибкамиОБанковскомСчете(ОшибкиКонтрагента, ОшибкиБанковскогоСчета);
		
		ОрганизацияСсылка = ПолучитьЗначениеXDTO(Seller.СлужебнаяИнформация, "Ссылка");
		
		ДобавитьГруппуОшибокВалидации(
			СписокОшибок,
			ОшибкиКонтрагента,
			"Ошибки в сведениях о <продавце>",
			ОрганизацияСсылка);
		
	Иначе
		
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют сведения о продавце");
		
	КонецЕсли;
	
