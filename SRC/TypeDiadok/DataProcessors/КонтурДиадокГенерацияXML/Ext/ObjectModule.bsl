Функция ЗначениеПоКлючу(ИнфоПоля, Ключ)
	
	Результат = Неопределено;
	
	Для Каждого КлючЗначение Из ИнфоПоля Цикл
		
		Если КлючЗначение.Ключ = Ключ Тогда
			Результат = КлючЗначение.Значение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
