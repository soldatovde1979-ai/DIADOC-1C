Процедура ЗаполнитьИтогиУКД(Table)
	
	Vat_dec						= 0;
	Total_dec					= 0;
	TotalWithVatExcluded_dec	= 0;
	
	Vat_inc						= 0;
	Total_inc					= 0;
	TotalWithVatExcluded_inc	= 0;
	
	Для Каждого Item Из Table.Items Цикл
		
		// dec
		Если Item.AmountsDec.Установлено("Total") Тогда
			Total_dec = Total_dec + Item.AmountsDec.Total;
		КонецЕсли;
		
		Если Item.AmountsDec.Установлено("TotalWithVatExcluded") Тогда
			TotalWithVatExcluded_dec = TotalWithVatExcluded_dec + Item.AmountsDec.TotalWithVatExcluded;
		КонецЕсли;
		
		Если Item.AmountsDec.Установлено("Vat") Тогда
			Vat_dec = Vat_dec + Item.AmountsDec.Vat;
		КонецЕсли;
		
		// inc
		Если Item.AmountsDec.Установлено("Total") Тогда
			Total_inc = Total_inc + Item.AmountsDec.Total;
		КонецЕсли;
		
		Если Item.AmountsDec.Установлено("TotalWithVatExcluded") Тогда
			TotalWithVatExcluded_inc = TotalWithVatExcluded_inc + Item.AmountsDec.TotalWithVatExcluded;
		КонецЕсли;
		
		Если Item.AmountsDec.Установлено("Vat") Тогда
			Vat_inc = Vat_inc + Item.AmountsDec.Vat;
		КонецЕсли;
		
	КонецЦикла;
	
	Table.TotalsDec.Vat						= Vat_dec;
	Table.TotalsDec.TotalWithVatExcluded	= TotalWithVatExcluded_dec;
	Table.TotalsDec.Total					= Total_dec;
	
	Table.TotalsInc.Vat						= Vat_inc;
	Table.TotalsInc.TotalWithVatExcluded	= TotalWithVatExcluded_inc;
	Table.TotalsInc.Total					= Total_inc;
	
КонецПроцедуры

Процедура ЗаполнитьИтогиУПД(Table)
	
	Vat						= 0;
	Total					= 0;
	TotalWithVatExcluded	= 0;
	
	Для Каждого Item Из Table.Items Цикл
		
		Если Item.Установлено("Subtotal") Тогда
			Total = Total + Item.Subtotal;
		КонецЕсли;
		
		Если Item.Установлено("SubtotalWithVatExcluded") Тогда
			TotalWithVatExcluded = TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
		КонецЕсли;
		
		Если Item.Установлено("Vat") Тогда
			Vat = Vat + Item.Vat;
		КонецЕсли;
		
	КонецЦикла;
	
	Table.Vat					= Vat;
	Table.TotalWithVatExcluded	= TotalWithVatExcluded;
	Table.Total					= Total;
	
КонецПроцедуры

