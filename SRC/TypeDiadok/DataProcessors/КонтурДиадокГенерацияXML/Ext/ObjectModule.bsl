// Возвращает ответный титул УПД в формате 820@
//
// Параметры:
//  ПротоКонтент               - ОбъектXDTO     - ответный титул в терминах прото структуры Диадока;
//  ФайлТитулаПродавца         - ДвоичныеДанные - файл УПД в формате 820@;
//  ФайлыПодписейПродавца      - Массив         - содержит все файлы подписей продавца;
//                             - ДвоичныеДанные - если файл подписи продавца всего один;
//  ПараметрыФормированияФайла - Структура      - см. функцию XML_ПараметрыФормированияФайла();
// 
// Возвращаемое значение:
//   - ОбъектXDTO - ответный титул УПД в формате 820@
//
Функция XML_ОтветныйТитул_УПД_820(ПротоКонтент, ФайлТитулаПродавца, ФайлыПодписейПродавца, ПараметрыФормированияФайла) Экспорт
	
	НалоговыйКод	 = XML_ОтветныйТитул_НалоговыйКод();
	ВерсияФормата	 = "5.01";
	ИмяПакетаXDTO	 = "ON_NSCHFDOPPOK";
	
	Фабрика			 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ТитулПродавца	 = XML_В_ОбъектXDTO(ФайлТитулаПродавца);
	
	ИдентификаторПродавца	 = ТитулПродавца.СвУчДокОбор.ИдОтпр;
	ИдентификаторПокупателя	 = ТитулПродавца.СвУчДокОбор.ИдПол;
	
	ИмяФайлаПродавца	 = ТитулПродавца.ИдФайл;
	ДатаФайлаПродавца	 = ТитулПродавца.Документ.ДатаИнфПр;
	ВремяФайлаПродавца	 = ТитулПродавца.Документ.ВремИнфПр;
	
	ДатаДокумента	 = ТитулПродавца.Документ.СвСчФакт.ДатаСчФ;
	НомерДокумента	 = ТитулПродавца.Документ.СвСчФакт.НомерСчФ;
	
	НаименованиеДокумента	 = ТитулПродавца.Документ.НаимДокОпр;
	ФункцияДокумента		 = ТитулПродавца.Документ.Функция;
	
	Файл				= XML_ПолучитьПустойОбъектXDTO("Файл", ИмяПакетаXDTO);
	ИнфПок		 		= НовыйДочернийОбъектXDTO(Фабрика, Файл,	"ИнфПок");
	ИдИнфПрод			= НовыйДочернийОбъектXDTO(Фабрика, ИнфПок,	"ИдИнфПрод");
	СодФХЖ4		 		= НовыйДочернийОбъектXDTO(Фабрика, ИнфПок,	"СодФХЖ4");
	
	Если Найти(ИмяФайлаПродавца, "ON_NSCHFDOPPRPROS") = 1 Тогда
		ДопПрефикс = "PROS";
	ИначеЕсли Найти(ИмяФайлаПродавца, "ON_NSCHFDOPPRMARK") = 1 Тогда
		ДопПрефикс = "MARK";
	КонецЕсли;
	
	XML_ОтветныйТитул_ЗаполнитьОсновныеСведенияФайла(ИмяПакетаXDTO, Файл
	, ВерсияФормата, ИдентификаторПродавца, ИдентификаторПокупателя, ПараметрыФормированияФайла, ДопПрефикс);
	
	XML_ОтветныйТитул_ЗаполнитьОсновныеСведенияПокупателя(ИнфПок
	, ПротоКонтент, НалоговыйКод, ПараметрыФормированияФайла);
	
	XML_ОтветныйТитул_ЗаполнитьСведенияПродавца(ИмяПакетаXDTO, ИдИнфПрод
	, ИмяФайлаПродавца, ДатаФайлаПродавца, ВремяФайлаПродавца, ФайлыПодписейПродавца);
	
	XML_ОтветныйТитул_УПД_820_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, СодФХЖ4
	, ПротоКонтент, НаименованиеДокумента, ФункцияДокумента, НомерДокумента, ДатаДокумента);
	
	XML_ОтветныйТитул_УПД_ЗаполнитьИнфПокГосЗакКазн(ИмяПакетаXDTO, ИнфПок, ПротоКонтент);

	XML_ОтветныйТитул_УПД_820_ЗаполнитьРасширенныхПодписантов(ИмяПакетаXDTO, ИнфПок, ПротоКонтент);
		
	Возврат Файл;
	
КонецФункции

// Возвращает ответный титул УПД в формате 970@
//
// Параметры:
//  ПротоКонтент               - ОбъектXDTO     - ответный титул в терминах прото структуры Диадока;
//  ФайлТитулаПродавца         - ДвоичныеДанные - файл УПД в формате 820@;
//  ФайлыПодписейПродавца      - Массив         - содержит все файлы подписей продавца;
//                             - ДвоичныеДанные - если файл подписи продавца всего один;
//  ПараметрыФормированияФайла - Структура      - см. функцию XML_ПараметрыФормированияФайла();
//
// Возвращаемое значение:
//   - ОбъектXDTO - ответный титул УПД в формате 970@
//
Функция XML_ОтветныйТитул_УПД_970(
		ПротоКонтент,
		ФайлТитулаПродавца,
		ФайлыПодписейПродавца,
		ПараметрыФормированияФайла) Экспорт
		
	ТитулПродавца = XML_В_ОбъектXDTO(ФайлТитулаПродавца);
	
	Если ТитулПродавца.ВерсФорм = "5.03" Тогда
		ИмяПакетаXDTO = XML_ОтветныйТитул_УПД_970_ИмяПакета_5_03();
	Иначе
		ИмяПакетаXDTO = XML_ОтветныйТитул_УПД_970_ИмяПакета_5_02();
	КонецЕсли;
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Файл = XML_ПолучитьПустойОбъектXDTO("Файл", ИмяПакетаXDTO);
	Документ = НовыйДочернийОбъектXDTO(Фабрика, Файл, "Документ");
	
	ИдИнфПрод = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ИдИнфПрод");
	СодФХЖ4 = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СодФХЖ4");
	
	XML_ОтветныйТитул_УПД_970_ЗаполнитьОсновныеСведенияФайла(Файл, ТитулПродавца, ПараметрыФормированияФайла);
	
	XML_ОтветныйТитул_УПД_970_ЗаполнитьОсновныеДокумента(
		Документ,
		ПротоКонтент,
		ТитулПродавца,
		ПараметрыФормированияФайла);
	
	XML_ОтветныйТитул_УПД_970_ЗаполнитьСведенияПродавца(ИмяПакетаXDTO, ИдИнфПрод, ТитулПродавца, ФайлыПодписейПродавца);
	
	XML_ОтветныйТитул_УПД_970_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, СодФХЖ4, ПротоКонтент, ТитулПродавца);
	
	XML_ОтветныйТитул_УПД_ЗаполнитьИнфПокГосЗакКазн(ИмяПакетаXDTO, Документ, ПротоКонтент);
	
	XML_УПД_970_ЗаполнитьПодписантов(ИмяПакетаXDTO, Документ, ПротоКонтент);
	
	Возврат Файл;
	
КонецФункции

// Возвращает ответный титул покупателя белорусской накладной 133 формат
//
// Параметры:
//  ПротоКонтент               - ОбъектXDTO     - ответный титул в терминах прото структуры Диадока;
//  ФайлТитулаПродавца         - ДвоичныеДанные - файл УПД в формате 820@;
//  ФайлыПодписейПродавца      - Массив         - содержит все файлы подписей продавца;
//                             - ДвоичныеДанные - если файл подписи продавца всего один;
//  ПараметрыФормированияФайла - Структура      - см. функцию XML_ПараметрыФормированияФайла();
//
// Возвращаемое значение:
//   - ОбъектXDTO - ответный титул УПД в формате 970@
//
Функция XML_ОтветныйТитул_TORGBLR_133(
		ПротоКонтент,
		ФайлТитулаПродавца,
		ФайлыПодписейПродавца,
		ПараметрыФормированияФайла) Экспорт
	
	ИмяПакетаXDTO = "TORGBLRPOL";
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ТитулПродавца = XML_В_ОбъектXDTO(ФайлТитулаПродавца);
	
	Результат = XML_ПолучитьПустойОбъектXDTO("DeliveryNote", ИмяПакетаXDTO);
	
	Результат.DeliveryNoteDate = ТитулПродавца.DeliveryNoteDate;
	Результат.DeliveryNoteID = ТитулПродавца.DeliveryNoteID;
	Результат.DeliveryNoteType = ТитулПродавца.DeliveryNoteType;
	Результат.FunctionCode = 11;
	Результат.CreationDateTime = Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	Результат.DocumentID = СтрЗаменить(XMLСтрока(Новый УникальныйИдентификатор), "-", "");
	
	Результат.ReferenceDocument = НовыйДочернийОбъектXDTO(Фабрика, Результат, "ReferenceDocument");
	Результат.ReferenceDocument.Date = ТитулПродавца.CreationDateTime;
	Результат.ReferenceDocument.ID = ТитулПродавца.DocumentID;
	
	Результат.Receiver = НовыйДочернийОбъектXDTO(Фабрика, Результат, "Receiver");
	ЗаполнитьЗначенияСвойств(Результат.Receiver, ТитулПродавца.Receiver);
	
	Результат.Shipper = НовыйДочернийОбъектXDTO(Фабрика, Результат, "Shipper");
	ЗаполнитьЗначенияСвойств(Результат.Shipper, ТитулПродавца.Shipper);
	
	Результат.ShipTo = НовыйДочернийОбъектXDTO(Фабрика, Результат, "ShipTo");
	
	Для Каждого Signer Из СписокXDTOИзЭлемента(ПротоКонтент, "Signers") Цикл
		
		Результат.ShipTo.Contact = Signer.FirstName
		+ " " + Signer.Surname
		+ " " + Signer.Patronymic
		+ ", " + Signer.JobTitle;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

