		УстановитьЗначениеXDTO(Контент, "Price", ПолучитьЗначениеXDTO(Параметры, "ЦенаПрин"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтавНДСПрин") Тогда
		УстановитьЗначениеXDTO(Контент, "TaxRate", TaxRate_Из_НалСт(ПолучитьЗначениеXDTO(Параметры, "СтавНДСПрин")));
	КонецЕсли;
	
