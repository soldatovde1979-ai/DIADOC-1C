		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПредОргПрин, "ОснПолнПредПрин") Тогда
			Заполнить_DocumentDetails(Контент.EmployeeBase, ПредОргПрин.ОснПолнПредПрин);	
		КонецЕсли;

	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ФЛПер") Тогда
		
		ФЛПер = Параметры.ФЛПер;
		
