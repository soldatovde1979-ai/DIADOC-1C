			УстановитьЗначениеXDTO(Контент, "TransferTextInfo", СвПер.ТранГруз.СвТранГруз);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер.ТранГруз, "Перевозчик") Тогда
			Заполнить_ExtendedOrganizationInfo(Контент.Carrier, СвПер.ТранГруз.Перевозчик);
		КонецЕсли;
		
		Для Каждого ТранНакл Из СписокXDTOИзЭлемента(СвПер.ТранГруз, "ТранНакл") Цикл
			Заполнить_Waybill(НовыйЭлементСпискаXDTO(Контент.Waybills), ТранНакл);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "СвПерВещи") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер.СвПерВещи, "ДатаПерВещ") Тогда
			УстановитьЗначениеXDTO(Контент, "CreatedThingTransferDate", ДатаXML_в_Дата1С(СвПер.СвПерВещи.ДатаПерВещ));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер.СвПерВещи, "СвПерВещ") Тогда
			УстановитьЗначениеXDTO(Контент, "CreatedThingInfo", СвПер.СвПерВещи.СвПерВещ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер, "СвЛицПер") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвПер.СвЛицПер, "РабОргПрод") Тогда
			Заполнить_Employee(Контент.Employee, СвПер.СвЛицПер.РабОргПрод);
		Иначе 
			Заполнить_OtherIssuer(Контент.OtherIssuer, СвПер.СвЛицПер.ИнЛицо);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИнфПолФХЖ3") Тогда
		Заполнить_AdditionalInfoId(Контент.AdditionalInfoId, Параметры.ИнфПолФХЖ3);
	КонецЕсли;
	
	Для Каждого ОснПер Из СписокXDTOИзЭлемента(СвПер, "ОснПер") Цикл
		Заполнить_TransferBase(НовыйЭлементСпискаXDTO(Контент.TransferBases), ОснПер);
	КонецЦикла;
	
