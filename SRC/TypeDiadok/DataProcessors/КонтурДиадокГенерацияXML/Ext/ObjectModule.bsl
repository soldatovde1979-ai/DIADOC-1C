// Возвращает представление даты в указанном формате, дату можно передавать строкой.
//
// Важно! Для пустой даты метод Формат с пустой форматной строкой работает иначе чем преобразование к строке:
// 	Формат('00010101') = ""
// 	Строка('00010101') = "01.01.0001 0:00:00"
//
Функция Дата_В_Формат(ДатаСтрока, ФорматнаяСтрока = "", ПустоеЗначение = Неопределено)
	
	Если ПустаяСтрока(ДатаСтрока) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Попытка
		Значение = Дата(ДатаСтрока);
	Исключение
		Значение = ДатаСтрока;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Значение) И ПустоеЗначение <> Неопределено Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Возврат Формат(Значение, ФорматнаяСтрока);
	
КонецФункции

Функция СтруктураЗаполнена(Структура)
	
	Результат = Ложь;
	
	Для Каждого КлючИЗначение Из Структура Цикл
		
		ТипЗначения = ТипЗнч(КлючИЗначение.Значение);
		
		Если ТипЗначения = Тип("Структура") Тогда
			Результат = СтруктураЗаполнена(КлючИЗначение.Значение);
		ИначеЕсли ТипЗначения = Тип("Булево") Тогда
			Результат = КлючИЗначение.Значение = Истина;
		Иначе
			Результат = ЗначениеЗаполнено(КлючИЗначение.Значение);
		КонецЕсли;
		
		Если Результат = Истина Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектXDTOЗаполнен(ОбъектXDTO)
	
	Результат = Ложь;
	
	СвойстваОбъекта = ОбъектXDTO.Свойства();
	Для Каждого Свойство Из СвойстваОбъекта Цикл
		
		Если ТипЗнч(ОбъектXDTO[Свойство.Имя]) = Тип("ОбъектXDTO") Тогда
			
			Если ОбъектXDTOЗаполнен(ОбъектXDTO[Свойство.Имя]) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
			
		ИначеЕсли ОбъектXDTO.Установлено(Свойство.Имя) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

