Процедура Заполнить_ProformaInvoice29IdentificationDetails(Контент, Параметры)
	
	Для Каждого РеквИдРекСост Из СписокXDTOИзЭлемента(Параметры, "РеквИдРекСост") Цикл
		IdentificationDetail = НовыйЭлементСпискаXDTO(Контент.IdentificationDetails);
		
		// BSLLS:IfElseIfEndsWithElse-off
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РеквИдРекСост, "ИННЮЛ") Тогда
			УстановитьЗначениеXDTO(IdentificationDetail, "Inn", РеквИдРекСост.ИННЮЛ);
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РеквИдРекСост, "ИННФЛ") Тогда
			УстановитьЗначениеXDTO(IdentificationDetail, "Inn", РеквИдРекСост.ИННФЛ);
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РеквИдРекСост, "НаимОИВ") Тогда
			УстановитьЗначениеXDTO(IdentificationDetail, "ShortNameExecutiveAuthority", РеквИдРекСост.НаимОИВ);
		КонецЕсли;
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(РеквИдРекСост, "ДаннИно") Тогда
			ДаннИно = РеквИдРекСост.ДаннИно;
			
			Заполнить_ProformaInvoice29IdentificationDetails_ИностраннаяОрганизация(IdentificationDetail, ДаннИно);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_ProformaInvoice29IdentificationDetails_ИностраннаяОрганизация(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Country", Параметры.КодСтр);
	УстановитьЗначениеXDTO(Контент, "OrgName", Параметры.Наим);
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ВРег(Параметры.ИдСтат) = "ИГ" Тогда
		УстановитьЗначениеXDTO(Контент, "StatusId", "PhysicalPerson");
	ИначеЕсли ВРег(Параметры.ИдСтат) = "ИО" Тогда
		УстановитьЗначениеXDTO(Контент, "StatusId", "LegalEntity");
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Идентиф") Тогда
		УстановитьЗначениеXDTO(Контент, "LegalEntityId", Параметры.Идентиф);
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИныеСвед") Тогда
		УстановитьЗначениеXDTO(Контент, "OrganizationOrPersonInfo", Параметры.ИныеСвед);
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура Заполнить_ProformaInvoice29AdditionalInfo(Контент, Параметры)
	// BSLLS:Typo-off
	
	УстановитьЗначениеXDTO(Контент, "PaymentPurpose", Параметры.НазнПл);
	
