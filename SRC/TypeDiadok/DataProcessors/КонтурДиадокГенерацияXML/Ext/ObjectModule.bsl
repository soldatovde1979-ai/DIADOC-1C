Процедура ПроверитьСвидетельствоОРегистрацииИП(СписокОшибок, Свидетельство)
	
	Если НЕ ЗначениеЗаполнено(Свидетельство) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, 
			"Не указаны данные о государственной регистрации продавца-индивидуального предпринимателя
			|(номер и дата свидетельства о госрегистрации)");
	Иначе
		Если СтрДлина(Свидетельство) > 128 Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "Реквизиты свидетельства о регистрации должны иметь длину менее 128 символов");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Функция Валидация_ПроверитьСтруктуруАдресаРФ(Address)
	
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Address) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(Результат, Address.ZipCode, "Индекс", Ложь, 6, 6, Истина, "м");
	
	RegionCode = Address.RegionCode;
	
	Если НЕ ЗначениеЗаполнено(RegionCode) Тогда
		ДобавитьОшибкуВалидации(Результат, "В адресе не указан код региона по классификатору");
	ИначеЕсли RegionCode = "##" Тогда
		ДобавитьОшибкуВалидации(Результат, "Код региона указан не по классификатору");
	ИначеЕсли НЕ СтрДлина(RegionCode) = 2 Тогда
		ДобавитьОшибкуВалидации(Результат, "Код региона должен иметь длину 2 символа");
	ИначеЕсли НЕ СтрокаСодержитТолькоЦифры(RegionCode) Тогда
		ДобавитьОшибкуВалидации(Результат, "Код региона должен состоять из цифр");
	КонецЕсли;
	
	ПроверитьФорматПоля(Результат, Address.Region, "наименование региона", Истина, 0, 51, Ложь, "с");
	
	ПроверитьФорматПоля(Результат, Address.Territory, "наименование района", Ложь, 0, 255, Ложь, "с");
	ПроверитьФорматПоля(Результат, Address.City, "наименование города", Ложь, 0, 255, Ложь, "с");
	ПроверитьФорматПоля(Результат, Address.Locality, "наименование населенного пункта", Ложь, 0, 255, Ложь, "с");
	ПроверитьФорматПоля(Результат, Address.Street, "наименование улицы", Ложь, 0, 255, Ложь, "с");
	
	ПроверитьФорматПоля(Результат, Address.Building, "номер дома", Ложь, 0, 20, Ложь, "м");
	ПроверитьФорматПоля(Результат, Address.Block, "номер корпуса", Ложь, 0, 20, Ложь, "м");
	ПроверитьФорматПоля(Результат, Address.Apartment, "номер квартиры", Ложь, 0, 50, Ложь, "м");
	// BSLLS:MagicNumber-on
	
	Возврат Результат;
	
КонецФункции

Функция Валидация_ПроверитьСтруктуруАдресаГАР(Address) 

	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Address) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(Результат, Address.ID, "Уникальный номер адреса", Истина, 36, 36, Ложь, "м");
	
	ПроверитьФорматПоля(Результат, Address.ZipCode, "Индекс", Ложь, 6, 6, Истина, "м");
	
	RegionCode = Address.RegionCode;
	
	Если НЕ ЗначениеЗаполнено(RegionCode) Тогда 
		ДобавитьОшибкуВалидации(Результат, "В адресе не указан код региона по классификатору");
	ИначеЕсли RegionCode = "##" Тогда 
		ДобавитьОшибкуВалидации(Результат, "Код региона указан не по классификатору");
	ИначеЕсли НЕ СтрДлина(RegionCode) = 2 Тогда 
		ДобавитьОшибкуВалидации(Результат, "Код региона должен иметь длину 2 символа");
	ИначеЕсли НЕ СтрокаСодержитТолькоЦифры(RegionCode) Тогда 
		ДобавитьОшибкуВалидации(Результат, "Код региона должен состоять из цифр");
	КонецЕсли;
	
	ПроверитьФорматПоля(Результат, Address.Region, "наименование региона", Истина, 0, 51, Ложь, "с");
	
	Если RegionCode <> "99" Тогда
		
		Если Не ЗначениеЗаполнено(Address.MunicipalDistrict)
			И Не ЗначениеЗаполнено(Address.MunicipalDistrictCode) Тогда
			ДобавитьОшибкуВалидации(Результат, "Не указан муниципальный район");
		Иначе
			
			ПредставлениеПоля = "наименование муниципального района";
			ПроверитьФорматПоля(Результат, Address.MunicipalDistrict, ПредставлениеПоля, Истина, 0, 255, Ложь, "м");
			
			ПредставлениеПоля = "код вида муниципального района";
			ПроверитьФорматПоля(Результат, Address.MunicipalDistrictCode, ПредставлениеПоля, Истина, 0, 1, Ложь, "м");
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПредставлениеПоля = "городское поселение/сельское поселение";
	ПроверитьФорматПоля(Результат, Address.Settlement, ПредставлениеПоля, Ложь, 0, 255, Ложь, "с");
	
	ПредставлениеПоля = "код городского поселения/сельского поселения";
	ПроверитьФорматПоля(Результат, Address.SettlementCode, ПредставлениеПоля, Ложь, 1, 1, Ложь, "с");
	
	ПроверитьФорматПоля(Результат, Address.Locality, "населенный пункт", Ложь, 0, 255, Ложь, "с");
	ПроверитьФорматПоля(Результат, Address.LocalityType, "тип населенного пункта", Ложь, 0, 50, Ложь, "с");
	
	ПредставлениеПоля = "элемент планировочной структуры";
	ПроверитьФорматПоля(Результат, Address.PlanningElement, ПредставлениеПоля, Ложь, 0, 255, Ложь, "с");
	
	ПредставлениеПоля = "тип элемента планировочной структуры";
	ПроверитьФорматПоля(Результат, Address.PlanningElementType, ПредставлениеПоля, Ложь, 0, 50, Ложь, "с");
	
	ПредставлениеПоля = "элемент уличной дорожной сети";
	ПроверитьФорматПоля(Результат, Address.StreetElement, ПредставлениеПоля, Ложь, 0, 255, Ложь, "с");
	
	ПредставлениеПоля = "тип элемента уличной дорожной сети";
	ПроверитьФорматПоля(Результат, Address.StreetElementType, ПредставлениеПоля, Ложь, 0, 50, Ложь, "с");
	
	ПроверитьФорматПоля(Результат, Address.LandPlot, "земельный участок", Ложь, 1, 50, Ложь, "с");
	
	// BSLLS:UseLessForEach-off
	Если ЗначениеЗаполнено(Address.Buildings) Тогда
		Для Каждого BuildingInfo Из Address.Buildings Цикл
			ПроверитьФорматПоля(Результат, Address.House, "номер здания/сооружения", Ложь, 0, 255, Ложь, "с");
			ПроверитьФорматПоля(Результат, Address.HouseType, "тип здания/сооружения", Ложь, 0, 50, Ложь, "с");
		КонецЦикла;
	КонецЕсли;
	// BSLLS:UseLessForEach-on
	
	ПредставлениеПоля = "номер помещения в пределах здание/сооружение";
	ПроверитьФорматПоля(Результат, Address.House, ПредставлениеПоля, Ложь, 0, 255, Ложь, "с");
	
	ПредставлениеПоля = "тип помещения в пределах здание/сооружения";
	ПроверитьФорматПоля(Результат, Address.HouseType, ПредставлениеПоля, Ложь, 0, 50, Ложь, "с");
	
	ПредставлениеПоля = "номер помещения в пределах здание/сооружение";
	ПроверитьФорматПоля(Результат, Address.Apartment, ПредставлениеПоля, Ложь, 0, 255, Ложь, "с");
	
	ПредставлениеПоля = "тип помещения в пределах здание/сооружения";
	ПроверитьФорматПоля(Результат, Address.ApartmentType, ПредставлениеПоля, Ложь, 0, 50, Ложь, "с");
	// BSLLS:MagicNumber-on
	
	Возврат Результат;
	
КонецФункции

Функция Валидация_ПроверитьСтруктуруАдресаСтрокой(Address) 
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Address) Тогда
		Возврат Результат;
	КонецЕсли;

	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(Результат, Address.Country, "Наименование страны", Истина, 0, 255, Ложь, "с");
	ПроверитьФорматПоля(Результат, Address.CountryCode, "Код страны", Ложь, 3, 3, Истина, "м");
	ПроверитьФорматПоля(Результат, Address.AddressText, "строковое представление адреса", Истина, 0, 1000, Ложь, "с");
	// BSLLS:MagicNumber-on
	
	Возврат Результат;
	
КонецФункции	

Процедура Валидация_ДополнитьСписокОшибкамиГТД(СписокОшибок, МассивОшибокГТД)
	
	Если МассивОшибокГТД.Количество() > 0 Тогда
		
		ОшибкиВСтроке = Новый Массив;
		
		ТекстИнструкции	= ПодставитьГиперссылкуВОшибкуВалидации("<Как заполнить?>", "ИНСТРУКЦИЯКАКЗАПОЛНИТЬГТД");
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, ТекстИнструкции);
		
		Для Каждого ОшибкаГТД Из МассивОшибокГТД Цикл
			
			Если ТипЗнч(ОшибкаГТД) = Тип("Массив") Тогда
				ДополнитьМассивОшибокВалидации(ОшибкиВСтроке, ОшибкаГТД);
			Иначе
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, ОшибкаГТД);
			КонецЕсли;
			
		КонецЦикла;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в заполнении номеров ГТД");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Валидация_ПроверитьСтавкуНДС(TaxRate, ОшибкиВСтроке)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если Не ЗначениеЗаполнено(TaxRate) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Ставка НДС не указана");
		
	ИначеЕсли Не TaxRate_ЭтоВалидноеЗначение(TaxRate) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Указана недопустимая ставка налога (" + TaxRate + ")");
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Функция ПроверитьСтруктуруКонтрагентаДляТОРГ12(OrganizationInfo, ТипСтруктуры, ПроверкаДляСФ = Ложь)
	// ТипСтруктуры =1 : юридический адрес. Проверяем Seller и Buyer.
	// ТипСтруктуры =2 : фактический адрес. Проверяем Shipper и Consignee.
	
	списокОшибок = Новый Массив;
	
	// проверяем наименование
	Если НЕ ЗначениеЗаполнено(OrganizationInfo.Name) Тогда 
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано название организации");
	ИначеЕсли (OrganizationInfo.IsSoleProprietor = Истина) И (найти(OrganizationInfo.Name, " ") = 0) Тогда 
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя индивидуального предпринимателя");
	Иначе 
		ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Name, "Наименование контрагента", Ложь, 0, 1000, Ложь, "с");
	КонецЕсли; 
	
	Если Не (ПроверкаДляСФ И (ТипСтруктуры = 2)) Тогда 
		// проверяем ИНН
		Если ЗначениеЗаполнено(OrganizationInfo.Inn) Тогда 
			ТекстОшибки = "";
			ИНН = OrganizationInfo.Inn;
			Если OrganizationInfo.IsSoleProprietor = Ложь Тогда 
				ТекстОшибки = ПроверитьИННКонтрагента(ИНН, "ЮрЛицо");
			Иначе
				// ФЛ
				ТекстОшибки = ПроверитьИННКонтрагента(ИНН, "ФизЛицо");
			КонецЕсли;
			
			ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
			
		ИначеЕсли ТипСтруктуры = 1 Тогда 
			ДобавитьОшибкуВалидации(СписокОшибок, "ИНН контрагента не указан");
			
		КонецЕсли;	
		
		// проверяем КПП
		Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда 
			ТекстОшибки = ПроверитьКППКонтрагента(OrganizationInfo.Kpp);
			ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		ИначеЕсли OrganizationInfo.IsSoleProprietor = Ложь
			И ПроверкаДляСФ Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "КПП контрагента не указан");
		КонецЕсли;
	КонецЕсли;
	
	ОшибкиАдреса = ПроверитьСтруктуруАдреса(OrganizationInfo.Address);

	Если ЗначениеЗаполнено(ОшибкиАдреса) Тогда 
		ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, "Ошибки в " + ?(ТипСтруктуры = 1, "юридическом", "фактическом") + " адресе:", , "b");
		ДополнитьМассивОшибокВалидации(СписокОшибок, ОшибкиАдреса);
	КонецЕсли; 
	
	Если ПроверкаДляСФ = Ложь Тогда
		// проверяем ОКОПФ
		ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okopf, "ОКОПФ контрагента", Ложь, 2, 5, Истина, "м");
		
		// проверяем ОКПО
		Если ЗначениеЗаполнено(OrganizationInfo.Okpo) Тогда 
			ОКПО = OrganizationInfo.Okpo;
			Если стрДлина(ОКПО) <> 8 и стрДлина(ОКПО) <> 10 Тогда 
				ДобавитьОшибкуВалидации(СписокОшибок, "ОКПО контрагента (" + ОКПО + ") должен иметь длину 8 или 10 цифр");
			ИначеЕсли СтрокаСодержитТолькоЦифры(ОКПО) = Ложь Тогда
				ДобавитьОшибкуВалидации(СписокОшибок, "ОКПО контрагента (" + ОКПО + ") должен состоять из цифр");
			КонецЕсли;
		КонецЕсли;
		
		// проверяем Телефон
		Если ЗначениеЗаполнено(OrganizationInfo.Phone) Тогда 
			ОшибкаТелефона = ОшибкаФорматаПоля(OrganizationInfo.Phone, "Номер телефона контрагента", Ложь, 0, 20, Ложь, "м");
			Если ЗначениеЗаполнено(ОшибкаТелефона) Тогда
				ДобавитьОшибкуВалидации(СписокОшибок,  ОшибкаТелефона);
				ДобавитьОшибкуВалидации(СписокОшибок, "Для передачи через ЭДО части строки поставьте разделитель «;»");
			КонецЕсли;
		КонецЕсли;
		
		// проверяем факс
		Если ЗначениеЗаполнено(OrganizationInfo.Fax) Тогда 
			ОшибкиФакса = ОшибкаФорматаПоля(OrganizationInfo.Fax, "Номер факса контрагента", Ложь, 0, 20, Ложь, "м");
			Если ЗначениеЗаполнено(ОшибкиФакса) Тогда 
				ДополнитьМассивОшибокВалидации(СписокОшибок,  ОшибкиФакса);
				ДобавитьОшибкуВалидации(СписокОшибок, "Для передачи через ЭДО части строки поставьте разделитель «;»");
			КонецЕсли;
		КонецЕсли;
		
		// проверяем БИК Банка 
		ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.BankId, "БИК банка контрагента", Ложь, 9, 9, Истина, "м");
		
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции	

Функция КонтрольнаяСуммаИННЮЛСовпадает(ИНН)
	КС_Диадок = умножитьВектора(ИНН, "2:4:10:3:5:9:4:6:8:");
	Возврат ((КС_Диадок % 11) % 10) = Число(Сред(ИНН, 10, 1));
КонецФункции

Функция КонтрольнаяСуммаИННФЛСовпадает(ИНН)
	
	КС1_Диадок = УмножитьВектора(ИНН, "7:2:4:10:3:5:9:4:6:8:");
	КС2_Диадок = УмножитьВектора(ИНН, "3:7:2:4:10:3:5:9:4:6:8:");
	
	Возврат (((КС1_Диадок % 11) % 10) = Число(Сред(ИНН, 11, 1))) И (((КС2_Диадок % 11) % 10) = Число(Сред(ИНН, 12, 1)));
	
КонецФункции

Функция ПроверитьСтруктуруАдреса(Address, МаксДлинаАдреса = 255, ПроверятьЗаполненостьАдреса = Истина) Экспорт

	Результат = Новый Массив;
	
	Если НЕ СтруктураЗаполнена(Address) Тогда
		
		Если ПроверятьЗаполненостьАдреса Тогда
			ДобавитьОшибкуВалидации(Результат, "отсутствуют сведения об адресе");
		КонецЕсли;
		
	ИначеЕсли НЕ Address.IsForeign Тогда
		
		// проверяем российский адрес
		
		ПроверитьФорматПоля(Результат, Address.ZipCode, "Индекс", Ложь, 6, 6, Истина, "м");
		
		RegionCode = Address.RegionCode;
		
		Если НЕ ЗначениеЗаполнено(RegionCode) Тогда 
			ДобавитьОшибкуВалидации(Результат, "В адресе не указан регион по классификатору");
		ИначеЕсли RegionCode = "##" Тогда 
			ДобавитьОшибкуВалидации(Результат, "Наименование региона указано не по классификатору");
		ИначеЕсли НЕ СтрДлина(RegionCode) = 2 Тогда 
			ДобавитьОшибкуВалидации(Результат, "Код региона должен иметь длину 2 символа");
		ИначеЕсли НЕ СтрокаСодержитТолькоЦифры(RegionCode) Тогда 
			ДобавитьОшибкуВалидации(Результат, "Код региона должен состоять из цифр");
		КонецЕсли;
		
		ПроверитьФорматПоля(Результат, Address.Territory	, "наименование района",			 Ложь, 0, 50, Ложь, "с");
		ПроверитьФорматПоля(Результат, Address.City			, "наименование города",			 Ложь, 0, 50, Ложь, "с");
		ПроверитьФорматПоля(Результат, Address.Locality		, "наименование населенного пункта", Ложь, 0, 50, Ложь, "с");
		ПроверитьФорматПоля(Результат, Address.Street		, "наименование улицы",				 Ложь, 0, 50, Ложь, "с");
		
		ПроверитьФорматПоля(Результат, Address.Building		, "номер дома", 					 Ложь, 0, 20, Ложь, "м");
		ПроверитьФорматПоля(Результат, Address.Block		, "номер корпуса", 					 Ложь, 0, 20, Ложь, "м");
		ПроверитьФорматПоля(Результат, Address.Apartment	, "номер квартиры", 				 Ложь, 0, 20, Ложь, "м");
		
	Иначе
		
		// проверяем адрес в свободной форме
		
		Country 	= Address.CountryCode;
		AddressName = Address.AddressText;
		
		Если ЗначениеЗаполнено(Country) Тогда
			
			ПроверитьФорматПоля(Результат, Country, "Код страны", Ложь, 3, 3, Истина, "м");
			
			Если ЗначениеЗаполнено(AddressName) Тогда
				ПроверитьФорматПоля(Результат, AddressName, "строковое представление адреса", Ложь, 0, МаксДлинаАдреса, Ложь, "с");
			Иначе
				ДобавитьОшибкуВалидации(Результат, "Не указан адрес внутри страны");
			КонецЕсли;
			
		Иначе 
			ДобавитьОшибкуВалидации(Результат, "В адресе не заполнена страна");
		КонецЕсли;
		
	КонецЕсли;
				
	Возврат Результат;
	
КонецФункции	

Функция УПД970_ПроверитьСтруктуруАдреса(Address, ContentFunction) 

	Результат = УПД970_ОбщаяПроверкаЗаполненияАдреса(Address, ContentFunction);
	
	Если Результат.Количество() = 0 Тогда
		
		ВидАдреса = Перечисление_ВидыАдресов();
		
		Если Address.Type = ВидАдреса.АдресРФ Тогда
			Результат = Валидация_ПроверитьСтруктуруАдресаРФ(Address.AddressRF);
		ИначеЕсли Address.Type = ВидАдреса.АдресГАР Тогда
			Результат = Валидация_ПроверитьСтруктуруАдресаГАР(Address.AddressSAR);
		ИначеЕсли Address.Type = ВидАдреса.АдресСтрокой Тогда
			Результат = Валидация_ПроверитьСтруктуруАдресаСтрокой(Address.AddressText);
		КонецЕсли;
		
	КонецЕсли;
	
	ПроверитьФорматПоля(Результат, Address.GLN, "GLN места", Ложь, 13, 13, Ложь, "м");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбщаяПроверкаЗаполненияАдреса(AddressInfo, ContentFunction)
	
	Перем Address;
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(AddressInfo) Тогда
		
		ВидАдреса = Перечисление_ВидыАдресов();
		
		Если AddressInfo.Type = ВидАдреса.АдресРФ Тогда
			Address = AddressInfo.AddressRF;
		ИначеЕсли AddressInfo.Type = ВидАдреса.АдресГАР Тогда
			Address = AddressInfo.AddressSAR;
		ИначеЕсли AddressInfo.Type = ВидАдреса.АдресСтрокой Тогда
			Address = AddressInfo.AddressText;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Address = Неопределено
		Или Не СтруктураЗаполнена(Address) Тогда
		
		ФункцияУПД = XML_УПД_ПолучитьФункцию(ContentFunction);
		ФункцииУПД = Перечисление_ФункцииУПД();
		
		Если ФункцияУПД <> ФункцииУПД.ДОП Тогда
			ДобавитьОшибкуВалидации(Результат, "отсутствуют сведения об адресе");
		КонецЕсли;
		
	Иначе
		ПроверитьФорматПоля(Результат, AddressInfo.Type, "вид адреса", Истина, 0, 11, Ложь, "м");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СсылкаНаОрганизацию(СведенияОКонтрагенте)
	
	Перем Результат;
	
	СлужебнаяИнформация = СведенияОКонтрагенте.СлужебнаяИнформация;
	
	Если Тип(СлужебнаяИнформация) = Тип("Структура") Тогда
		СлужебнаяИнформация.Свойство("Ссылка", Результат);
	ИначеЕсли Тип(СлужебнаяИнформация) = Тип("ОбъектXDTO") Тогда
		Результат = ПолучитьЗначениеXDTO(СлужебнаяИнформация, "Ссылка");
	КонецЕсли;

	Возврат Результат;
КонецФункции

Процедура Валидация_ПроверитьЕдиницуИзмеренияПоОКЕИ(СписокОшибок, КодЕИ)
	
	Если СокрЛП(КодЕИ) = "0000" Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "Неверно заполнена ед. измерения. Выберите ед. измерения из классификатора";
	
	ОКЕИ = ПолучитьОКЕИ();
	
	Если ОКЕИ.Найти(КодЕИ, "Код") = Неопределено Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьИННКонтрагента(ИНН, ВидКонтрагента, ВидУчастникаРодительныйПадеж = "контрагента")
	
	ТекстОшибки = "";
	КонтрольнаяСуммаСовпадает = Ложь;
	
	Если ВидКонтрагента = "ЮрЛицо" Тогда
		
		Если СтрДлина(ИНН) <> 10 Тогда 
			
			ШаблонОшибки = "ИНН %1 (%2) должен иметь длину 10 цифр";
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
				ВидУчастникаРодительныйПадеж,
				ИНН);
			
		Иначе	
			КонтрольнаяСуммаСовпадает = КонтрольнаяСуммаИННЮЛСовпадает(ИНН);
		КонецЕсли;
		
		
	ИначеЕсли ВидКонтрагента = "ФизЛицо" Тогда
		
		Если СтрДлина(ИНН) <> 12 Тогда
			
			ШаблонОшибки = "ИНН %1-индивидуального предпринимателя (%2) должен иметь длину 12 цифр";
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
				ВидУчастникаРодительныйПадеж,
				ИНН);
			
		Иначе	
			КонтрольнаяСуммаСовпадает = КонтрольнаяСуммаИННФЛСовпадает(ИНН);
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "Некорректное использование метода: ПроверитьИННКонтрагента";
		
	КонецЕсли;	
	
	// Общие проверки для ИП и ЮЛ
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		
		Если Не СтрокаСодержитТолькоЦифры(ИНН) Тогда
			
			ШаблонОшибки = "ИНН %1 (%2) должен состоять из цифр";
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
				ВидУчастникаРодительныйПадеж,
				ИНН);
			
		ИначеЕсли Лев(ИНН, 2) = "00" Тогда
			
			ШаблонОшибки = "ИНН %1 (%2) не должен начинаться с двух нулей";
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
				ВидУчастникаРодительныйПадеж,
				ИНН);
			
		ИначеЕсли Не КонтрольнаяСуммаСовпадает Тогда
			
			ШаблонОшибки = "ИНН %1 (%2) неверный (не совпадает контрольная сумма)";
			
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
				ВидУчастникаРодительныйПадеж,
				ИНН);
			
		КонецЕсли;	
			
	КонецЕсли;	
	
	Возврат ТекстОшибки;
	
КонецФункции	

Функция ПроверитьКППКонтрагента(КПП, ВидУчастникаРодительныйПадеж = "контрагента")
	
	ТекстОшибки = "";
	
	Если СтрДлина(КПП) <> 9 Тогда
		
		ШаблонОшибки = "КПП %1 (%2) должен иметь длину 9 цифр";
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
			ВидУчастникаРодительныйПадеж,
			КПП);
		
	ИначеЕсли Лев(КПП, 2) = "00" Тогда
		
		ШаблонОшибки = "КПП %1 (%2) не должен начинаться с двух нулей";
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
			ВидУчастникаРодительныйПадеж,
			КПП);
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции	

Функция СтрокаЧтоМенять(НеправильноеНаименование, НеправильныйКод)
	
	Если НеправильноеНаименование И НЕ НеправильныйКод Тогда
		Возврат "наименования";
	ИначеЕсли НЕ НеправильноеНаименование И НеправильныйКод Тогда
		Возврат "коды";
	ИначеЕсли НеправильноеНаименование И НеправильныйКод Тогда
		Возврат "наименования и коды";
	Иначе 
		Возврат "";
	КонецЕсли;	
	
КонецФункции

Функция ПроверитьОшибкиВСтрокеСФ(item)
	
	СписокОшибокСтроки = Новый Массив;
	
	ПроверитьФорматПоля(СписокОшибокСтроки, Item.Product, "Наименование товара", Истина, 0, 1000, Ложь, "с");
	
	Если TaxRate_ЭтоЗначениеИсчНалАг(item.TaxRate) Тогда
		ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Для данного формата документа недопустимо использовать ставку НДС ""НДС исчисляется налоговым агентом""");
	Иначе
		ПроверитьОшибкиВ_UnitCode_TaxRate(СписокОшибокСтроки, item.UnitCode, item.TaxRate);
	КонецЕсли;
				
	Если ЗначениеЗаполнено(Item.Quantity) и (Item.Quantity < 0) Тогда
		ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Количество не может быть отрицательным");
	КонецЕсли;	
	
    Если НЕ ЗначениеЗаполнено(Item.Total) Тогда
		ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Не указана общая сумма по строке");
	КонецЕсли;
	
	Если 	 ЗначениеЗаполнено(Item.CustomsDeclarationNumbers)
		И НЕ ЗначениеЗаполнено(Item.CountriesOfOrigin) Тогда
		
		ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Для номенклатуры " + """" + Item.Product + """" + " не заполнена страна происхождения товара");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Item.CustomsDeclarationNumbers)
			И ЗначениеЗаполнено(Item.CountriesOfOrigin)
			И НЕ СокрЛП(Item.CountriesOfOrigin) = "643"
			И НЕ СокрЛП(Item.CountriesOfOrigin) = "981" Тогда
			
		ДополнитьМассивОшибокВалидации(СписокОшибокСтроки, ТекстОшибкиНеЗаполненГТД(Item));
			
	КонецЕсли;
				
	Если СтрДлина(СокрЛП(Item.CustomsDeclarationNumbers)) > 29 Тогда 
		ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Длина номера ГТД превышает максимальное ограничение в 29 символов");
	КонецЕсли;		
	
	Возврат СписокОшибокСтроки;
	
КонецФункции 

Функция ПроверитьКлассификаторыСФ(InvoiceContent)
	
	Результат = Новый Массив;
	
	КодыСтранДляПроверки = Новый Соответствие;
	КодыЕдиницДляПроверки = Новый Соответствие;
	
	Для каждого item Из InvoiceContent.Items Цикл
		
		ЕдиницаИзмеренияСсылка = СвойствоСлужебнойИнформации(Item, "ЕдиницаИзмерения");
		Если ЗначениеЗаполнено(Item.UnitCode) Тогда
			КодыЕдиницДляПроверки.Вставить(ЕдиницаИзмеренияСсылка, СокрЛП(Item.UnitCode));
		КонецЕсли;
		
		СтранаПроисхожденияСсылка = СвойствоСлужебнойИнформации(Item, "СтранаПроисхождения");
		
		Если ЗначениеЗаполнено(Item.CountriesOfOrigin) Тогда 
			КодыСтранДляПроверки.Вставить(СтранаПроисхожденияСсылка, Item.CountriesOfOrigin);
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьВалюту(InvoiceContent.ВалютаСсылка, InvoiceContent.Currency),	"Ошибки в классификаторе валют");
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьСтраны(КодыСтранДляПроверки),									"Ошибки в классификаторе стран");
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьЕдиницыИзмерения(КодыЕдиницДляПроверки),						"Ошибки в классификаторе единиц измерения");
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьОшибкиВ_UnitCode_TaxRate(СписокОшибок, UnitCode, TaxRate)
	
	ПроверитьФорматПоля(СписокОшибок, UnitCode, "Код единицы измерения", Ложь, 3, 4, Истина, "м");
	
	Если TaxRate = "##"	Тогда 
		ДобавитьОшибкуВалидации(СписокОшибок, "Указана недопустимая ставка налога");
	ИначеЕсли Не ЗначениеЗаполнено(TaxRate) Тогда 
		ДобавитьОшибкуВалидации(СписокОшибок, "Ставка НДС не указана");
	КонецЕсли;
	
КонецПроцедуры

Функция КодЕдиницыИзмеренияСоответствуетКлассификатору(ЕдиницаИзмеренияСсылка, КодЕдиницы) Экспорт
	
	// Предыстория и аналитика: DD1C-84
	
	// Замена функции ПроверитьЕИ в основном модуле.
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияСсылка) Тогда
		Результат = Истина;
		Возврат Результат;
	КонецЕсли;
	
	ПодходящиеЕИ = ПодходящиеЕдиницыИзмерения(ЕдиницаИзмеренияСсылка.Наименование);
	
	Для Каждого СтрокаОКЕИ Из ПодходящиеЕИ Цикл
		Если СтрокаОКЕИ.Код = КодЕдиницы Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции	

Функция ПроверитьЕдиницыИзмерения(СоответствиеЕдиниц)
	
	Результат = Новый Массив;
	
	ОшибкаЕИНеНайдена = Ложь;
	ОшибкаЕИНеТотКод = Ложь;
	ГиперссылкаОКЕИ = "<a href=""Открыть_ОКЕИ"" title=""Общероссийский классификатор единиц измерения"">ОКЕИ</a>";
	
	ТаблицаЕИ = Соответствие_В_СортированнуюТЗ(СоответствиеЕдиниц, "Значение");
	
	Для каждого СтрокаТЗ Из ТаблицаЕИ Цикл
	
		ЕИ = СтрокаТЗ.Ключ;
		ЕИПредставление = Строка(ЕИ);
		КодЕИ = СтрокаТЗ.Значение;
		
		Если Не ЗначениеЗаполнено(ЕИ) Тогда
			Продолжить;
		КонецЕсли;
		
		ПодходящиеЕИ = ПодходящиеЕдиницыИзмерения(ЕИ.Наименование);
		
		ФлагВсеХорошо = Ложь;
		
		Для Каждого СтрокаОКЕИ Из ПодходящиеЕИ Цикл
			Если СтрокаОКЕИ.Код = КодЕИ Тогда
				ФлагВсеХорошо = Истина;  // ЕИ найдена, код совпал с классификатором, все хорошо
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ФлагВсеХорошо Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ПодходящиеЕИ.Количество() = 0 Тогда
			
			ОшибкаЕИНеНайдена = Истина;
			ДобавитьОшибкуВалидации(Результат,
					"Единица измерения «<" + ЕИПредставление + ">» не найдена в " + ГиперссылкаОКЕИ, ЕИ);
			
		ИначеЕсли ПодходящиеЕИ.Количество() = 1 Тогда
			
			ОшибкаЕИНеТотКод = Истина;
			ДобавитьОшибкуВалидации(Результат,
				"Код единицы измерения «<" + ЕИПредставление + ">» - " + КодЕИ
				+ " не соответствует коду по " + ГиперссылкаОКЕИ + " - " + ПодходящиеЕИ[0].код, ЕИ);
			
		Иначе 
			
			ОшибкаЕИНеТотКод = Истина;
			ДобавитьОшибкуВалидации(Результат, 
				"Код единицы измерения «<" + ЕИПредставление + ">» - " + КодЕИ
				+ " не соответствует коду по " + ГиперссылкаОКЕИ, ЕИ);
				
			Для Каждого СтрокаОКЕИ Из ПодходящиеЕИ Цикл
				
				ДобавитьОшибкуВалидации(Результат, 
					"Единице измерения «" + СтрокаОКЕИ.НаименованиеПолное + "», ("
					+ СтрокаОКЕИ.НаименованиеКраткое + ") соответствует код ОКЕИ " + СтрокаОКЕИ.код);
					
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если ЗначениеЗаполнено(Результат) Тогда

		ДобавитьОшибкуВалидации(Результат, 
			"Перейдите в <справочник единиц измерения> и приведите "
			+ строкаЧтоМенять(ОшибкаЕИНеНайдена, ОшибкаЕИНеТотКод)
			+ " единиц в соответствие с классификатором", "СПРАВОЧНИКЕДИНИЦ");

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПроверитьЕдиницыИзмеренияПоОКЕИ(СоответствиеЕдиниц)
	
	Результат = Новый Массив;
	
	ОКЕИ = ПолучитьОКЕИ();
	
	ГиперссылкаОКЕИ	 = "<a href=""Открыть_ОКЕИ"" title=""Общероссийский классификатор единиц измерения"">ОКЕИ</a>";
	ШаблонОшибки	 = "Единица измерения <%1> не найдена в %2";
	
	ТаблицаЕИ = Соответствие_В_СортированнуюТЗ(СоответствиеЕдиниц, "Значение");
	
	Для каждого СтрокаТЗ Из ТаблицаЕИ Цикл
		
		ЕИ = СтрокаТЗ.Ключ;
		ЕИПредставление = Строка(ЕИ);
		КодЕИ = СтрокаТЗ.Значение;
		
		Если Не ЗначениеЗаполнено(ЕИ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОКЕИ.Найти(КодЕИ, "Код") = Неопределено Тогда
			ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки, ЕИПредставление, ГиперссылкаОКЕИ);
			ДобавитьОшибкуВалидации(Результат, ТекстОшибки, ЕИ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ТекстОшибки = "Перейдите в <справочник единиц измерения> и приведите коды единиц в соответствие с классификатором";
		ДобавитьОшибкуВалидации(Результат, ТекстОшибки, "СПРАВОЧНИКЕДИНИЦ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьСтраны(СоответствиеКодов)
	
	Результат = Новый Массив;
	
	ОшибкаСтраныНеНайдена = Ложь;
	ОшибкаСтраныНеТотКод = Ложь;
	
	ГиперссылкаОКСМ = "<a href=""Открыть_ОКСМ"" title=""Общероссийский классификатор стран мира"">ОКСМ</a>";
		
	СортированноеСоответствие = Соответствие_В_СортированнуюТЗ(СоответствиеКодов, "Значение");
	
	Для каждого КлючИЗначение Из СортированноеСоответствие Цикл
	
		Страна = КлючИЗначение.Ключ;  // здесь ссылка на элемент справочника
		СтранаПредставление = Строка(Страна);
		КодСтраны = КлючИЗначение.Значение;
		
		Если Не ЗначениеЗаполнено(Страна) Тогда
			Продолжить;
		КонецЕсли;
		
		ПодходящиеСтраны = ПодходящиеСтраны(СтранаПредставление);
		
		ФлагВсеХорошо = Ложь;
		Для Каждого СтрокаОКСМ Из ПодходящиеСтраны Цикл
			Если СтрокаОКСМ.Код = КодСтраны Тогда
				ФлагВсеХорошо = Истина;
				Прервать;  // код по ОКСМ верный, и эту страну надо будет пропустить
			КонецЕсли;
		КонецЦикла;
		
		Если ФлагВсеХорошо Тогда
			Продолжить;
		КонецЕсли;	
		
		// что-то плохо, коды не совпадают.
		Если ПодходящиеСтраны.Количество() = 0 Тогда
			
			ОшибкаСтраныНеНайдена = Истина;
			ДобавитьОшибкуВалидации(Результат, 
				"Страна происхождения «<" + СтранаПредставление + ">» не найдена в " + ГиперссылкаОКСМ, Страна);
			
		ИначеЕсли ПодходящиеСтраны.Количество() = 1 Тогда
			
			ОшибкаСтраныНеТотКод = Истина;
			ДобавитьОшибкуВалидации(Результат, 
				"Код страны происхождения «<" + СтранаПредставление + ">» - " + КодСтраны
				+ " не соответствует коду по " + ГиперссылкаОКСМ + " - " + ПодходящиеСтраны[0].Код, Страна);
			
		Иначе 
			
			ОшибкаСтраныНеТотКод = Истина;
			
			ДобавитьОшибкуВалидации(Результат, 
				"Код страны происхождения «<" + СтранаПредставление + ">» - " + КодСтраны
				+ " не соответствует коду по " + ГиперссылкаОКСМ, Страна);
			
			Для каждого СтрокаОКСМ Из ПодходящиеСтраны Цикл 
				ДобавитьОшибкуВалидации(Результат, 
					"Стране «" + СтрокаОКСМ.НаименованиеКраткое + "» соответствует код ОКСМ " + СтрокаОКСМ.Код);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ДобавитьОшибкуВалидации(Результат, 
			"Перейдите в <справочник стран мира> и приведите " + СтрокаЧтоМенять(ОшибкаСтраныНеНайдена, ОшибкаСтраныНетотКод) + " стран в соответствие с классификатором", "СПРАВОЧНИКСТРАН");
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции	

Функция ПроверитьВалюту(валюта, ВалютаКод)
	
	Результат = Новый Массив;
	
	Если Валюта = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаВалютыНеНайдена = Ложь;
	ОшибкаВалютыНеТотКод = Ложь;
	
	НаименованиеВалюты = Новый Массив;
	НаименованиеВалюты.Добавить(Валюта.Наименование);
	НаименованиеВалюты.Добавить(Валюта.НаименованиеПолное);
	ПодходящаяВалюта = ПодходящаяВалюта(НаименованиеВалюты);
	
	Для Каждого СтрокаОКВ Из ПодходящаяВалюта Цикл
		Если СтрокаОКВ.Код = ВалютаКод Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	ТекстГиперссылкиОКВ = "<a href=""Открыть_ОКВ"" title=""Общероссийский классификатор валют"">ОКВ</a>";
	
	Если ПодходящаяВалюта.Количество() = 0 Тогда
		
		ОшибкаВалютыНеНайдена = Истина;
		ДобавитьОшибкуВалидации(Результат, "Валюта «<" + Строка(Валюта) + ">» не найдена в " + ТекстГиперссылкиОКВ, валюта);
		
	ИначеЕсли ПодходящаяВалюта.Количество() = 1 Тогда
		
		ОшибкаВалютыНеТотКод = Истина;
		ДобавитьОшибкуВалидации(Результат, "Код валюты «<" + Строка(Валюта) + ">» - " + ВалютаКод + " не соответствует коду по " + ТекстГиперссылкиОКВ + " - " + ПодходящаяВалюта[0].Код, валюта);
		
	Иначе
		
		ОшибкаВалютыНеТотКод = Истина;
		ДобавитьОшибкуВалидации(Результат, "Код валюты «<" + Строка(Валюта) + ">» - " + ВалютаКод + " не соответствует коду по " + ТекстГиперссылкиОКВ, валюта);
		
		Для Каждого СтрокаОКВ Из ПодходящаяВалюта Цикл 
			ДобавитьОшибкуВалидации(Результат, "Валюте «" + СтрокаОКВ.Наименование + "», (" + СтрокаОКВ.КодСимвольный + ") соответствует код ОКВ " + СтрокаОКВ.Код);
		КонецЦикла;	
		
	КонецЕсли;
	
	ДобавитьОшибкуВалидации(Результат, 
		"Перейдите в <справочник валют> и приведите " + СтрокаЧтоМенять(ОшибкаВалютыНеНайдена, ОшибкаВалютыНеТотКод) + " валют в соответствие с классификатором", "СПРАВОЧНИКВАЛЮТ");
	
	Возврат Результат;
	
КонецФункции		

// Используется в алгоритмах, где на вход подается Соответствие, но для обработки его надо осортировать.
Функция Соответствие_В_СортированнуюТЗ(Соответствие, ПолеСортировки = "Ключ")
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ключ");
	Результат.Колонки.Добавить("Значение");
	
	Для каждого КлючИЗначение Из Соответствие Цикл
		
		НовСтрока = Результат.Добавить();
		НовСтрока.Ключ		= КлючИЗначение.Ключ;
		НовСтрока.Значение	= КлючИЗначение.Значение;
	
	КонецЦикла;
	
	Результат.Сортировать(ПолеСортировки);
	
	Возврат Результат;
	
КонецФункции	

Функция КлассификаторВалютПолучитьНаименованиеПоКоду(Код) Экспорт
	Если СокрЛП(Строка(Код)) = "643" Тогда
		Возврат "RUB";
	ИначеЕсли СокрЛП(Строка(Код)) = "978" Тогда
		Возврат "EUR";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ТекстОшибкиНеЗаполненГТД(Item, НачалоОшибки = "")

	Результат = Новый Массив;
	
	НомерГТДСсылка = СвойствоСлужебнойИнформации(Item, "НомерГТД");
	Если ЗначениеЗаполнено(НомерГТДСсылка) Тогда
		ДобавитьОшибкуВалидации(Результат, НачалоОшибки + "Для номенклатуры """ + Item.Product + """" + " не заполнен <регистрационный номер ГТД>", НомерГТДСсылка);
	Иначе
		ДобавитьОшибкуВалидации(Результат, НачалоОшибки + "Для номенклатуры " + """" + Item.Product + """" + " не указан номер ГТД");
	КонецЕсли;
	
	Возврат Результат;		

КонецФункции

Функция ПроверитьОшибкиВСтрокеКСФ(Item, ЭтоУКД = Истина)
	
	СписокОшибокСтроки = Новый Массив;
	ПроверитьФорматПоля(СписокОшибокСтроки, Item.Product, "Наименование товара", Истина, 0, 1000, Ложь, "с");
	
	Если Item.AmountsDec.Total = 0 И Item.AmountsInc.Total = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Нет изменения стоимости товаров (работ, услуг), имущественных прав с налогом - всего");
	КонецЕсли;
	
	ПроверитьОшибкиВ_UnitCode_TaxRate(СписокОшибокСтроки, Item.OriginalValues.UnitCode, Item.OriginalValues.TaxRate);
	ПроверитьОшибкиВ_UnitCode_TaxRate(СписокОшибокСтроки, Item.CorrectedValues.UnitCode, Item.CorrectedValues.TaxRate);
	
	Если НЕ ЭтоУКД Тогда
		
		Если TaxRate_ЭтоЗначениеИсчНалАг(Item.OriginalValues.TaxRate)
			Или TaxRate_ЭтоЗначениеИсчНалАг(Item.CorrectedValues.TaxRate) Тогда
			ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Для данного формата документа недопустимо использовать ставку НДС ""НДС исчисляется налоговым агентом""");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СписокОшибокСтроки;
	
КонецФункции
	
Функция ПроверитьКлассификаторыКСФ(InvoiceCorrectionContent, Items)
	
	Результат = Новый Массив;
	
	КодыЕдиницДляПроверки = КодыЕдиницИзмеренияДляПроверкиКСФ_УКД(Items);
	
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьВалюту(InvoiceCorrectionContent.ВалютаСсылка, InvoiceCorrectionContent.Currency),	"Ошибки в классификаторе валют");
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьЕдиницыИзмерения(КодыЕдиницДляПроверки),											"Ошибки в классификаторе единиц измерения");
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьКлассификаторыУКД(InvoiceCorrectionContent, Items)
	
	Результат = Новый Массив;
	
	КодыЕдиницДляПроверки = КодыЕдиницИзмеренияДляПроверкиКСФ_УКД(Items);
	
	ДобавитьГруппуОшибокВалидации(Результат, ВалидацияUCD736_ПроверитьВалюту(InvoiceCorrectionContent.ВалютаСсылка, InvoiceCorrectionContent.Currency),	"Ошибки в классификаторе валют");
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьЕдиницыИзмеренияПоОКЕИ(КодыЕдиницДляПроверки),									"Ошибки в классификаторе единиц измерения");
	
	Возврат Результат;
	
КонецФункции

Функция КодыЕдиницИзмеренияДляПроверкиКСФ_УКД(Items)
	
	Результат = Новый Соответствие;
	
	Для каждого item Из Items Цикл
		
		ЕдиницаИзмеренияДоИзмененияСсылка = СвойствоСлужебнойИнформации(Item, "ЕдиницаИзмеренияДоИзменения");
		Если ЗначениеЗаполнено(Item.OriginalValues.UnitCode) И Item.OriginalValues.UnitCode <> "0000" Тогда 
			Результат.Вставить(ЕдиницаИзмеренияДоИзмененияСсылка, СокрЛП(Item.OriginalValues.UnitCode));
		КонецЕсли;
		
		ЕдиницаИзмеренияСсылка = СвойствоСлужебнойИнформации(Item, "ЕдиницаИзмерения");
		Если ЗначениеЗаполнено(Item.CorrectedValues.UnitCode) И Item.CorrectedValues.UnitCode <> "0000" Тогда 
			Результат.Вставить(ЕдиницаИзмеренияСсылка, СокрЛП(Item.CorrectedValues.UnitCode));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьОшибкиВШапкеУПД_УКД(СписокОшибок, Content, ФорматПриказа = "")
	
	ПроверитьФорматПоля(СписокОшибок, Content.Number, "Номер счета-фактуры", Истина, 0, 1000, Ложь, "м");
	ПроверитьФорматДаты(СписокОшибок, Content.Date, "Дата счета-фактуры", Истина);
	
	Если ЗначениеЗаполнено(Content.RevisionDate) или  значениеЗаполнено(Content.RevisionNumber) Тогда 
		ПроверитьФорматПоля(СписокОшибок, Content.RevisionNumber, "Номер исправления счета-фактуры", Ложь, 1, 3, Истина, "м");
		ПроверитьФорматДаты(СписокОшибок, Content.RevisionDate, "Дата исправления счета-фактуры");
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок, Content.Currency, "Код валюты счета-фактуры", Истина, 3, 3, Истина, "м");
	
	МаксДлинаАдреса = 255;
	
	// проверяем сведения об участниках сделки
	Если  СтруктураЗаполнена(Content.Seller) Тогда
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляУПД(Content.Seller, 1, Content.Function, МаксДлинаАдреса, ФорматПриказа);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <продавце>", Content.Seller.Ссылка);
	Иначе 
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о продавце");
	КонецЕсли;

	Если  СтруктураЗаполнена(Content.Buyer) Тогда
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляУПД(Content.Buyer, 1, Content.Function, МаксДлинаАдреса, ФорматПриказа);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <покупателе>", Content.Buyer.Ссылка);
	Иначе 
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о покупателе");
	КонецЕсли;
	
КонецПроцедуры

// Проверяет сведения об организации на соответствие требованиям приказа 970@
//
// Параметры:
//  OrganizationInfo - Структура - см. тип ExtendedOrganizationInfo970 в схеме Proto.xsd
// 
// Возвращаемое значение:
//  Массив из НовыйОшибкаВалидации.
//
Функция ВалидацияUTD970_УчастникТип(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	// BSLLS:MagicNumber-off
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Name, "Наименование контрагента", Истина, 0, 1000, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okpo, "ОКПО контрагента", Ложь, 1, 10, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okopf, "ОКОПФ контрагента", Ложь, 2, 5, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Department, "Структурное подразделение", Ложь, 1, 500, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок,
		OrganizationInfo.FullNameOPF,
		"Полное наименование ОПФ",
		Ложь,
		4,
		255,
		Ложь
	);
	
	ПроверитьФорматПоля(СписокОшибок,
		OrganizationInfo.AdditionalInfo,
		"Информация для участника документооборота",
		Ложь,
		1,
		255,
		Ложь
	);
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	ВидКонтрагента = OrganizationInfo.Type;
	
	Если ВидКонтрагента = ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ЮрЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
		
		Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
			Ошибки = ПроверитьКППКонтрагента(OrganizationInfo.Kpp);
			ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
		КонецЕсли;
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		
		Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ФизЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
		
		Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "Для физ. лиц КПП не указывается");
		КонецЕсли;
		
		ПроверитьФорматПоля(СписокОшибок,
			OrganizationInfo.IndividualEntityRegistrationCertificate,
			"Свидетельство о гос. регистрации ИП",
			Ложь,
			1,
			100,
			Ложь
		);
		
		ПроверитьФорматПоля(СписокОшибок, 
			OrganizationInfo.IndividualEntityRegistrationNumber,
			"ОГРНИП",
			Ложь,
			15,
			15,
			Истина
		);
		
		ПроверитьФорматПоля(СписокОшибок,
			OrganizationInfo.OrganizationOrPersonInfo,
			"иные сведения",
			Ложь,
			1,
			255,
			Ложь
		);
		
		ЧастиФИО = РазложитьСтрокуВМассивСлов(OrganizationInfo.Name, " ");
		Если ЧастиФИО.Количество() < 2 Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя индивидуального предпринимателя");
		КонецЕсли;
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Если НЕ ЗначениеЗаполнено(OrganizationInfo.OrganizationOrPersonInfo)
			И НЕ ЗначениеЗаполнено(OrganizationInfo.Name) Тогда
			
			Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ФизЛицо");
			ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "Для физ. лиц КПП не указывается");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(OrganizationInfo.PhysicalEntityStatusID) Тогда
			
			Если OrganizationInfo.PhysicalEntityStatusID <> "0" И OrganizationInfo.PhysicalEntityStatusID <> "1" Тогда
				
				ДобавитьОшибкуВалидации(
					СписокОшибок,
					"указано не валидное значение в статусе контрагента (допустимо ""0"" или ""1"")"
				);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ПроверитьФорматПоля(СписокОшибок,
			OrganizationInfo.OrganizationOrPersonInfo,
			"иные сведения",
			Ложь,
			1,
			255,
			Ложь
		);
		
		ЧастиФИО = РазложитьСтрокуВМассивСлов(OrganizationInfo.Name, " ");
		
		Если ЧастиФИО.Количество() < 2 Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя физического лица");
		КонецЕсли;
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ИностраннаяОрганизация
		Или ВидКонтрагента = ВидыЮрФизЛиц.ИностранныйГражданин Тогда
		
		ПроверитьФорматПоля(
			СписокОшибок,
			OrganizationInfo.CountryCode,
			"код страны",
			Истина,
			3,
			3,
			Истина
		);
		
		ПроверитьФорматПоля(
			СписокОшибок,
			OrganizationInfo.Country,
			"наименование страны",
			Истина,
			1,
			255,
			Ложь
		);
		
		Если Не ЗначениеЗаполнено(OrganizationInfo.LegalEntityId) И 
			Не ЗначениеЗаполнено(OrganizationInfo.OrganizationOrPersonInfo) Тогда
			
			ДобавитьОшибкуВалидации(СписокОшибок, "Должно быть заполнено хотя бы одно поле для идентификации
			|иностранной организации (иностранного гражданина): налоговый номер или регистрационный номер");
			
		КонецЕсли;
		
		ПроверитьФорматПоля(
			СписокОшибок,
			OrganizationInfo.LegalEntityId,
			"идентификатор иностранной организации",
			Ложь,
			1,
			255,
			Ложь
		);
		
		ПроверитьФорматПоля(
			СписокОшибок,
			OrganizationInfo.OrganizationOrPersonInfo,
			"иные сведения для однозначной идентификации иностранной организации",
			Ложь,
			1,
			255,
			Ложь
		);
				
	Иначе
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			"Неправильно указан тип контрагента (%1)",
			ВидКонтрагента
		);
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	КонецЕсли;
	
	// BSLLS:MagicNumber-on
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ПроверитьСтруктуруКонтрагентаДляУПД(OrganizationInfo, ТипСтруктуры, ContentFunction, МаксДлинаАдреса, ФорматПриказа = "")
	// ТипСтруктуры =1 : юридический адрес. Проверяем Seller и Buyer.
	// ТипСтруктуры =2 : фактический адрес. Проверяем Shipper и Consignee.
	
	списокОшибок = Новый Массив;
	
	// проверяем наименование
	Если Не ЗначениеЗаполнено(OrganizationInfo.Name) Тогда 
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано название организации");
	ИначеЕсли OrganizationInfo.Type = "IndividualEntity"  и (найти(OrganizationInfo.Name, " ") = 0) Тогда 
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя индивидуального предпринимателя");
	Иначе 
		ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Name, "Наименование контрагента", Ложь, 0, 1000, Ложь, "с");
	КонецЕсли; 
	
	// проверяем ИНН
	Если ЗначениеЗаполнено(OrganizationInfo.Inn) Тогда
		
		ТекстОшибки = "";
		ИНН = OrganizationInfo.Inn;
		
		Если OrganizationInfo.Type = "LegalEntity" Тогда 
			ТекстОшибки = ПроверитьИННКонтрагента(ИНН, "ЮрЛицо");
		ИначеЕсли OrganizationInfo.Type = "IndividualEntity" Тогда
			ТекстОшибки = ПроверитьИННКонтрагента(ИНН, "ФизЛицо");
		КонецЕсли;
		
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	ИначеЕсли OrganizationInfo.Type = "LegalEntity" Тогда
		
		HyphenInn = ПолучитьЗначениеXDTO(OrganizationInfo, "HyphenInn");
		
		Если Не ЭтоИстина(HyphenInn) Тогда
			ДобавитьОшибкуВалидации(СписокОшибок, "ИНН контрагента не указан");
		КонецЕсли;
		
	КонецЕсли;
	
	// проверяем КПП
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда 
		ТекстОшибки = ПроверитьКППКонтрагента(OrganizationInfo.Kpp);
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
	КонецЕсли;
	
	ПроверятьЗаполненостьАдреса = ПроверятьЗаполненностьАдресаУПД(ФорматПриказа, ContentFunction);
	
	ОшибкиАдреса = ПроверитьСтруктуруАдреса(OrganizationInfo.Address, МаксДлинаАдреса, ПроверятьЗаполненостьАдреса);
	
	Если ЗначениеЗаполнено(ОшибкиАдреса) Тогда 
		ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, "Ошибки в " + ?(ТипСтруктуры = 1, "юридическом", "фактическом") + " адресе:", , "b");
		ДополнитьМассивОшибокВалидации(СписокОшибок, ОшибкиАдреса);
	КонецЕсли; 
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okopf, "ОКОПФ контрагента", Ложь, 2, 5, Истина, "м");
	
	Возврат СписокОшибок;
	
КонецФункции	

Процедура УПД970_ДополнитьСписокОшибкамиПроверкиЮридическогоАдреса(СписокОшибок, ОшибкиАдреса)
	
	Если ЗначениеЗаполнено(ОшибкиАдреса) Тогда 
		ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, "Ошибки в юридическом адресе:", , "b");
		ДополнитьМассивОшибокВалидации(СписокОшибок, ОшибкиАдреса);
	КонецЕсли; 
	
КонецПроцедуры

Процедура УПД970_ДополнитьСписокОшибкамиПроверкиФактическогоАдреса(СписокОшибок, ОшибкиАдреса)
	
	Если ЗначениеЗаполнено(ОшибкиАдреса) Тогда 
		ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, "Ошибки в фактическом адресе:", , "b");
		ДополнитьМассивОшибокВалидации(СписокОшибок, ОшибкиАдреса);
	КонецЕсли; 
	
КонецПроцедуры

Функция ПроверятьЗаполненностьАдресаУПД(ФорматПриказа, ContentFunction)
	
	Результат = Истина;
	
	Если ФорматПриказа = "820"
		Или ФорматПриказа = "970" Тогда
		
		ФункцияУПД = XML_УПД_ПолучитьФункцию(ContentFunction);
		Если ФункцияУПД = Перечисление_ФункцииУПД().ДОП Тогда
			Результат = Ложь;
		КонецЕсли;
	
	ИначеЕсли ФорматПриказа = "736" Тогда
		
		ФункцияУКД = XML_УКД_ПолучитьФункцию(ContentFunction);
		Если ФункцияУКД = Перечисление_ФункцииУКД().ДИС Тогда
			Результат = Ложь;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьОшибкиОснованияПередачи(СписокОшибок, Content, ФорматПриказа = "155")
	
	ФункцияУПД = XML_УПД_ПолучитьФункцию(Content.Function);
	ФункцииУПД = Перечисление_ФункцииУПД();
	
	ЭтоУПДСЧФ_820 = ФорматПриказа = "820"
					И ФункцияУПД = ФункцииУПД.СЧФ;
	
	Если Content.TransferInfo.TransferBases.Количество() = 0
		И НЕ ЭтоУПДСЧФ_820 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Не заполнены основания передачи");
		Возврат;
	КонецЕсли;
	
	Если ФорматПриказа = "155" Тогда
		ДокументОснованиеОтсутствует = "Отсутствует";
		ТекстФорматаПриказа	= ПодставитьГиперссылкуВОшибкуВалидации(" согласно формату <155 приказа>", "https://normativ.kontur.ru/document?moduleId=1&documentId=339569&rangeId=242736");
	Иначе // @820
		ДокументОснованиеОтсутствует = "Без документа-основания";
		ТекстФорматаПриказа = ПодставитьГиперссылкуВОшибкуВалидации(" согласно формату <820 приказа>", "https://normativ.kontur.ru/document?moduleId=1&documentId=328588&rangeId=242759");
	КонецЕсли;
		
	Для Каждого TransferBase Из Content.TransferInfo.TransferBases Цикл
		
		ОшибкиОснования = Новый Массив;
		
		Если TransferBase.DocumentName = ДокументОснованиеОтсутствует Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстНезаполненаДата	= "При наличии основания дата обязательна" + ТекстФорматаПриказа + ".";
		ТекстНезаполненНомер	= " Номер заполняется в рекомендательном порядке.";
		
		ТекстГруппыОшибок = "";
		
		Если Не ЗначениеЗаполнено(TransferBase.DocumentDate) 
			И Не ЗначениеЗаполнено(TransferBase.DocumentNumber) Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиОснования, "" + ТекстНезаполненаДата + ТекстНезаполненНомер);
			ТекстГруппыОшибок = "Заполните дату и номер.";
			
		ИначеЕсли Не ЗначениеЗаполнено(TransferBase.DocumentDate) Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиОснования, ТекстНезаполненаДата);
			ТекстГруппыОшибок = "Заполните дату.";
			
		КонецЕсли;
		
		Если ОшибкиОснования.Количество() > 0 Тогда
			ТекстИнструкции	= ПодставитьГиперссылкуВОшибкуВалидации("<Как заполнить?>", "ИНСТРУКЦИЯКАКЗАПОЛНИТЬОСНОВАНИЕ");
			ДобавитьОшибкуВалидации(ОшибкиОснования, ТекстИнструкции);
		КонецЕсли;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиОснования, "Ошибки в основании. <" + ТекстГруппыОшибок + ">", СвойствоСлужебнойИнформации(TransferBase, "ОснованиеСсылка"));
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьОшибкиВСтрокеУПД(item) 

	СписокОшибокСтроки = Новый Массив;
	
	ПроверитьФорматПоля(СписокОшибокСтроки, Item.Product, "Наименование товара", Истина, 0, 1000, Ложь, "с");
	
	ПроверитьОшибкиВ_UnitCode_TaxRate(СписокОшибокСтроки, item.UnitCode, item.TaxRate);
	
	Если item.CustomDeclarations <> Неопределено Тогда
		
		Для Каждого CustomsDeclaration Из item.CustomDeclarations Цикл 
	
			Если ЗначениеЗаполнено(CustomsDeclaration.DeclarationNumber)
				И Не ЗначениеЗаполнено(CustomsDeclaration.CountryCode) Тогда
				
				ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Для номенклатуры " + """" + Item.Product + """" + " не заполнена страна происхождения товара");
				
			ИначеЕсли Не ЗначениеЗаполнено(CustomsDeclaration.DeclarationNumber)
					И ЗначениеЗаполнено(CustomsDeclaration.CountryCode)
					И (СокрЛП(CustomsDeclaration.CountryCode) <> "643"
                    И СокрЛП(CustomsDeclaration.CountryCode) <> "981") Тогда
					
					// 981 - это ЕАЭС, которого нет в ОКСМ.
					// http://www.consultant.ru/document/cons_doc_LAW_197242/7556e2e94ff8990c8aa5f2cf32bb0e715f031cf5/
					// https://forum.infostart.ru/forum81/topic167091/
					
				ДополнитьМассивОшибокВалидации(СписокОшибокСтроки, ТекстОшибкиНеЗаполненГТД(Item));
					
			КонецЕсли;
						
			Если (стрДлина(сокрЛП(CustomsDeclaration.DeclarationNumber)) > 29) Тогда
				ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Длина номера ГТД превышает максимальное ограничение в 29 символов");
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СписокОшибокСтроки;
	
КонецФункции 

Функция ПроверитьКлассификаторыУПД(InvoiceContent)			
	
	Результат = Новый Массив;
	
	КодыСтранДляПроверки = Новый Соответствие;
	КодыЕдиницДляПроверки = Новый Соответствие;

	Для Каждого item Из InvoiceContent.InvoiceTable.Items Цикл
		
		ЕдиницаИзмеренияСсылка = СвойствоСлужебнойИнформации(Item, "ЕдиницаИзмерения");
		
		Если ЗначениеЗаполнено(Item.UnitCode) И Item.UnitCode <> "0000" Тогда
			КодыЕдиницДляПроверки.Вставить(ЕдиницаИзмеренияСсылка, СокрЛП(Item.UnitCode));
		КонецЕсли;
		
		Если item.CustomDeclarations <> Неопределено Тогда
			Для Каждого CustomsDeclaration Из item.CustomDeclarations Цикл 
				
				СтранаПроисхожденияСсылка = СвойствоСлужебнойИнформации(item, "СтранаПроисхождения");
				
				Если НЕ ЗначениеЗаполнено(CustomsDeclaration.DeclarationNumber) ИЛИ СтранаЧленТС(CustomsDeclaration.CountryCode) Тогда 
					Продолжить;  // можно объединить с условием ниже
				КонецЕсли;
				
				Если ЗначениеЗаполнено(CustomsDeclaration.CountryCode) Тогда 
					КодыСтранДляПроверки.Вставить(СтранаПроисхожденияСсылка, CustomsDeclaration.CountryCode);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьВалюту(InvoiceContent.ВалютаСсылка, InvoiceContent.Currency),	"Ошибки в классификаторе валют");
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьСтраны(КодыСтранДляПроверки),									"Ошибки в классификаторе стран");
	ДобавитьГруппуОшибокВалидации(Результат, ПроверитьЕдиницыИзмеренияПоОКЕИ(КодыЕдиницДляПроверки),				"Ошибки в классификаторе единиц измерения");
	
	Возврат Результат;
	
КонецФункции

Функция СтранаЧленТС(Знач КодСтраны) Экспорт
	
	КодСтраны = СокрЛП(КодСтраны);
	
	КодыСтранТС = Новый Массив;
	КодыСтранТС.Добавить("643"); // Россия
	КодыСтранТС.Добавить("051"); // Армения
	КодыСтранТС.Добавить("112"); // Беларусь
	КодыСтранТС.Добавить("398"); // Казахстан
	КодыСтранТС.Добавить("417"); // Киргизия
	КодыСтранТС.Добавить("981"); // ЕАЭС
	
	Возврат КодыСтранТС.Найти(КодСтраны) <> Неопределено;
	
КонецФункции

// обертка для совместимости ОФ-УФ
Функция СвойствоСлужебнойИнформации(ВходящиеПараметры, ИмяСвойства)
	
	Результат = Неопределено;
	
	СтруктураСлужебнаяИнформация = Новый Структура("СлужебнаяИнформация");
	ЗаполнитьЗначенияСвойств(СтруктураСлужебнаяИнформация, ВходящиеПараметры);
  	СлужебнаяИнформация = СтруктураСлужебнаяИнформация.СлужебнаяИнформация;
	
	Если ТипЗнч(СлужебнаяИнформация) <> Тип("Структура") Тогда
		Возврат Результат;  // может встретиться в Про, либо СлужебнаяИнформация не была добавлена в ПМ
	КонецЕсли;	
	
	Если ИмяСвойства = "ЕдиницаИзмерения" Тогда
		
		Если СлужебнаяИнформация.Свойство("ЕдиницаИзмерения") Тогда
			Результат = СлужебнаяИнформация.ЕдиницаИзмерения;
		ИначеЕсли СлужебнаяИнформация.Свойство("Упаковка") Тогда
			Результат = СлужебнаяИнформация.Упаковка;
		КонецЕсли;	
		
	ИначеЕсли ИмяСвойства = "ЕдиницаИзмеренияДоИзменения" Тогда
		
		Если СлужебнаяИнформация.Свойство("ЕдиницаИзмеренияДоИзменения") Тогда
			Результат = СлужебнаяИнформация.ЕдиницаИзмеренияДоИзменения;
		ИначеЕсли СлужебнаяИнформация.Свойство("УпаковкаДоИзменения") Тогда
			Результат = СлужебнаяИнформация.УпаковкаДоИзменения;
		КонецЕсли;	
		
	ИначеЕсли ИмяСвойства = "НомерГТД" Тогда
		
		Если СлужебнаяИнформация.Свойство("НомерГТД") Тогда
			Результат = СлужебнаяИнформация.НомерГТД;
		КонецЕсли;
		
	ИначеЕсли ИмяСвойства = "СтранаПроисхождения" Тогда
		
		Если СлужебнаяИнформация.Свойство("СтранаПроисхождения") Тогда
			Результат = СлужебнаяИнформация.СтранаПроисхождения;
		КонецЕсли;
		
	ИначеЕсли ИмяСвойства = "ОснованиеСсылка" Тогда
		
		Если СлужебнаяИнформация.Свойство("ОснованиеСсылка") Тогда
			Результат = СлужебнаяИнформация.ОснованиеСсылка;
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

