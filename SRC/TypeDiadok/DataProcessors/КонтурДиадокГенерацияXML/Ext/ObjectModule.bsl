// Извлекает текст из XML-файла в кодировке, указанной в объявлении XML.
//
// Параметры:
//  ИмяФайлаXML - Строка - полное имя XML-файла
// 
// Возвращаемое значение:
//  Строка - содержимое XML-файла.
//  Неопределено - если файл не существует.
//
Функция СодержимоеФайлаXML(ИмяФайлаXML)
	
	ФайлXML = Новый Файл(ИмяФайлаXML);
	Если Не ФайлXML.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КодировкаПоУмолчанию = КодировкаПоУмолчанию();
	Результат = СтрокаИзФайла(ИмяФайлаXML, КодировкаПоУмолчанию);
	
	КодировкаФайла = КодировкаXML(Результат);
	Если КодировкаФайла <> КодировкаПоУмолчанию Тогда
		Результат = СтрокаИзФайла(ИмяФайлаXML, КодировкаФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Извлекает текст из двоичных данных
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Двоичные данные, которые требуется преобразовать в строку
//  Кодировка - КодировкаТекста, Строка - кодировка, в которой требуется получить строку
// 
// Возвращаемое значение:
//  Строка - содержимое текста, переданного в двоичных данных.
//
Функция СтрокаИзДвоичныхДанных(ДвоичныеДанные, Кодировка)
	
	Если Не ПриложениеСтаршеВерсии("8.3.10") Тогда
		
		Результат = Вычислить("ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, Кодировка)");
		
	Иначе
		
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		ДвоичныеДанные.Записать(ИмяФайла);
		
		Результат = СтрокаИзФайла(ИмяФайла, Кодировка);
		
		Попытка
			
			УдалитьФайлы(ИмяФайла);
			
		Исключение
			
			Ошибка = ИнформацияОбОшибке();
			
			ЖурналРегистрации_ЗаписатьПредупреждение(
				"ЧтениеФайла",
				ПодробноеПредставлениеОшибки(Ошибка)
			);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Извлекает текст двоичных данных XML-файла в кодировке, указанной в объявлении XML.
//
// Параметры:
//  ДвоичныеДанныеXML - ДвоичныеДанные - Двоичные данные XML-файла, которые требуется преобразовать в строку
// 
// Возвращаемое значение:
//  Строка - текст из двоичных данных XML-файла.
//
Функция СодержимоеДвоичныхДанныхXML(ДвоичныеДанныеXML)
	
	КодировкаПоУмолчанию = КодировкаПоУмолчанию();
	
	Результат = СтрокаИзДвоичныхДанных(ДвоичныеДанныеXML, КодировкаПоУмолчанию);
	
	КодировкаФайла = КодировкаXML(Результат);
	
	Если КодировкаФайла <> КодировкаПоУмолчанию Тогда
		Результат = СтрокаИзДвоичныхДанных(ДвоичныеДанныеXML, КодировкаФайла);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает кодировку файла по объявлению xml: <?xml version="1.0" encoding="windows-1251"?>.
//
// Параметры:
//  СтрокаXML - Строка - строка с текстом XML-документа
// 
// Возвращаемое значение:
//  Строка - кодировка из объявления XML.
//
Функция КодировкаXML(СтрокаXML) Экспорт
	
	Результат = "";
	
	Тег = "encoding";
	ПозНачало = Найти(СтрокаXML, Тег);
	ПозНачало = ?(ПозНачало > 0, ПозНачало + СтрДлина(Тег), 0);
	
	Если ПозНачало > 0 Тогда
		
		Тег = "=";
		ПозДоп = Найти(Сред(СтрокаXML, ПозНачало), Тег);
		ПозНачало = ПозНачало + ПозДоп;
		
		Тег = Сред(СтрокаXML, ПозНачало, 1);
		ПозКонец = Найти(Сред(СтрокаXML, ПозНачало + 1), Тег);
		ПозКонец = ?(ПозКонец > 0, ПозКонец + 1, 0);
		
		Если ПозКонец > 0 Тогда
			
			Результат = Сред(СтрокаXML, ПозНачало, ПозКонец);
			Результат = НРег(Результат);
			Результат = СокрЛП(Результат);
			Результат = СтрЗаменить(Результат, Тег, "");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСтрокаXML(Строка)
	
	Результат = Ложь;
	
	Если ТипЗнч(Строка) = Тип("Строка") Тогда
		Результат = (Лев(Строка, 1) = "<");
	КонецЕсли;
	
	Возврат Результат;
	
