			ФИО	 = ФЛ.ФИО;
			
			УстановитьЗначениеXDTO(SignerDetails, "SignerType",	"PhysicalPerson");
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ФЛ, "ГосРегИППодп") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "RegistrationCertificate", ФЛ.ГосРегИППодп);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ФЛ, "ГосРегИПВыдДов") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "RegistrationCertificate", ФЛ.ГосРегИПВыдДов);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ФЛ, "ИННФЛ") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "Inn", ФЛ.ИННФЛ);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ФЛ, "ИныеСвед") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "SignerInfo", ФЛ.ИныеСвед);
			КонецЕсли;
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ИП") Тогда
			
			ИП	 = Подписант.ИП;
			ФИО	 = ИП.ФИО;
			
			УстановитьЗначениеXDTO(SignerDetails, "SignerType"	, "IndividualEntity");
			УстановитьЗначениеXDTO(SignerDetails, "Inn"			, ИП.ИННФЛ);
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ИП, "СвГосРегИП") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "RegistrationCertificate", ИП.СвГосРегИП);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ИП, "ИныеСвед") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "SignerInfo", ИП.ИныеСвед);
			КонецЕсли;
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ЮЛ") Тогда
			
			ЮЛ	 = Подписант.ЮЛ;
			ФИО	 = ЮЛ.ФИО;
			
			УстановитьЗначениеXDTO(SignerDetails, "SignerType"	, "LegalEntity");
			УстановитьЗначениеXDTO(SignerDetails, "Inn"			, ЮЛ.ИННЮЛ);
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЮЛ, "Должн") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "JobTitle", ЮЛ.Должн);
			ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЮЛ, "Должность") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "JobTitle", ЮЛ.Должность);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЮЛ, "ГосРегИППодп") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "RegistrationCertificate", ЮЛ.ГосРегИППодп);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЮЛ, "ГосРегИПВыдДов") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "RegistrationCertificate", ЮЛ.ГосРегИПВыдДов);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЮЛ, "НаимОрг") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "OrganizationName", ЮЛ.НаимОрг);
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ЮЛ, "ИныеСвед") Тогда
				УстановитьЗначениеXDTO(SignerDetails, "SignerInfo", ЮЛ.ИныеСвед);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ФИО <> Неопределено Тогда
			
			УстановитьЗначениеXDTO(SignerDetails, "FirstName"	, ФИО.Имя);
			УстановитьЗначениеXDTO(SignerDetails, "Surname"		, ФИО.Фамилия);
			УстановитьЗначениеXDTO(SignerDetails, "Patronymic"	, ПолучитьЗначениеXDTO(ФИО, "Отчество"));
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_Signer970(Контент, Параметры)
	
	ФИО = ПолучитьЗначениеXDTO(Параметры, "ФИО");
	Если ФИО <> Неопределено Тогда
		Заполнить_ФИО(Контент, ФИО);
	КонецЕсли;
	
	Долж = ПолучитьЗначениеXDTO(Параметры, "Должн");
	СпосПодтПолном = ПолучитьЗначениеXDTO(Параметры, "СпосПодтПолном");
	ДопСведПодп = ПолучитьЗначениеXDTO(Параметры, "ДопСведПодп");
	ДатаПодДок = ДатаXML_в_Дата1С(ПолучитьЗначениеXDTO(Параметры, "ДатаПодДок"));
	
	УстановитьЗначениеXDTO(Контент, "JobTitle", Долж);
	УстановитьЗначениеXDTO(Контент, "DateSigningDocument", ДатаПодДок);
	УстановитьЗначениеXDTO(Контент, "ConfirmCredentials", СпосПодтПолном);
	УстановитьЗначениеXDTO(Контент, "AdditionalInfo", ДопСведПодп);
	
	ТипПодписиXML = ПолучитьЗначениеXDTO(Параметры, "ТипПодпис"); 	
	ТипыПодписей = Перечисление_ТипыПодписей();
	
	Если ТипПодписиXML = "1" Тогда
		ТипПодписиПрото = ТипыПодписей.Квалифицированная;
	ИначеЕсли ТипПодписиXML = "2" Тогда
		ТипПодписиПрото = ТипыПодписей.Простая;
	ИначеЕсли ТипПодписиXML = "3" Тогда
		ТипПодписиПрото = ТипыПодписей.Неквалифицированная;
	Иначе
		ТипПодписиПрото = Неопределено;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "SignType", ТипПодписиПрото);
	
	Если Контент.ConfirmCredentials = "3" Тогда
		
		Для Каждого СвДоверЭл Из СписокXDTOИзЭлемента(Параметры, "СвДоверЭл") Цикл
			СведенияОМЧД = НовыйЭлементСпискаXDTO(Контент.ElectronicPOA);
			Заполнить_ElectronicAttorneyInfo970(СведенияОМЧД, СвДоверЭл);
		КонецЦикла;
		
	ИначеЕсли Контент.ConfirmCredentials = "5" Тогда
		
		Для Каждого СвДоверБум Из СписокXDTOИзЭлемента(Параметры, "СвДоверБум") Цикл
			СведенияОДоверенности = НовыйЭлементСпискаXDTO(Контент.PaperPOA);
			Заполнить_PaperAttorneyInfo970(СведенияОДоверенности, СвДоверБум);
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_ElectronicAttorneyInfo970(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "ID", Параметры.НомДовер);
	УстановитьЗначениеXDTO(Контент, "IssueDate", ДатаXML_в_Дата1С(Параметры.ДатаВыдДовер));
	
	УстановитьЗначениеXDTO(Контент, "StorageID", Параметры.ИдСистХран);
	УстановитьЗначениеXDTO(Контент, "URL", ПолучитьЗначениеXDTO(Параметры, "УРЛСист"));
	
	УстановитьЗначениеXDTO(Контент, "Number", ПолучитьЗначениеXDTO(Параметры, "ВнНомДовер"));
	УстановитьЗначениеXDTO(Контент, "RegistrationDate", ДатаXML_в_Дата1С(ПолучитьЗначениеXDTO(Параметры, "ДатаВнРегДовер")));
	
КонецПроцедуры
	
Процедура Заполнить_PaperAttorneyInfo970(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ФИО") Тогда
		ФИО = Параметры.ФИО;
		УстановитьЗначениеXDTO(Контент, "IssuerFirstName", ФИО.Имя);
		УстановитьЗначениеXDTO(Контент, "IssuerSurname", ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "IssuerPatronymic", ПолучитьЗначениеXDTO(ФИО, "Отчество"));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Number", Параметры.ВнНомДовер);
	УстановитьЗначениеXDTO(Контент, "IssueDate", ДатаXML_в_Дата1С(Параметры.ДатаВыдДовер));
	
	УстановитьЗначениеXDTO(Контент, "PrincipalInfo", ПолучитьЗначениеXDTO(Параметры, "СвИдДовер"));
	
КонецПроцедуры

Процедура Заполнить_InvoiceContent(Контент, Параметры)
	
	Если Параметры.ВерсФорм = "5.01" Тогда
		Заполнить_InvoiceContent_5_01(Контент, Параметры);
	ИначеЕсли Параметры.ВерсФорм = "5.02" Тогда
		Заполнить_InvoiceContent_5_02(Контент, Параметры);
	ИначеЕсли Параметры.ВерсФорм = "5.03" Тогда
		Заполнить_InvoiceContent_5_03(Контент, Параметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_InvoiceContent_5_01(Контент, Параметры)
	
	Документ	 = Параметры.Документ;
	СвСчФакт	 = Документ.СвСчФакт;
	ТаблСчФакт	 = Документ.ТаблСчФакт;
	
	УстановитьЗначениеXDTO(Контент, "InvoiceVersion", Параметры.ВерсФорм);
	УстановитьЗначениеXDTO(Контент, "Number"		, СвСчФакт.НомерСчФ);
	УстановитьЗначениеXDTO(Контент, "Date"			, ДатаXML_в_Дата1С(СвСчФакт.ДатаСчФ));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ИспрСчФ") Тогда
		УстановитьЗначениеXDTO(Контент, "InvoiceRevisionDate", ДатаXML_в_Дата1С(СвСчФакт.ИспрСчФ.ДатаИспрСчФ));
		УстановитьЗначениеXDTO(Контент, "InvoiceRevisionNumber", СвСчФакт.ИспрСчФ.НомИспрСчФ);
	КонецЕсли;	
	
	УстановитьЗначениеXDTO(Контент, "Currency", СвСчФакт.КодОКВ);
	
	Заполнить_OrganizationInfo(Контент.Seller, СвСчФакт.СвПрод);
	Заполнить_OrganizationInfo(Контент.Buyer, СвСчФакт.СвПокуп);
	
	Заполнить_InvoiceTotals(Контент.Totals, ТаблСчФакт.ВсегоОпл);
	Заполнить_Signer(Контент, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ГрузОт") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт.ГрузОт, "ОнЖе") Тогда
			УстановитьЗначениеXDTO(Контент.Shipper, "SameAsSellerOrBuyer", Истина);
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт.ГрузОт, "ГрузОтпр") Тогда
			Заполнить_ShipperOrConsigneeInfo(Контент.Shipper, СвСчФакт.ГрузОт.ГрузОтпр);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ГрузПолуч") Тогда
		Заполнить_ShipperOrConsigneeInfo(Контент.Consignee, СвСчФакт.ГрузПолуч);
	КонецЕсли;
	
	Для Каждого СведТов Из СписокXDTOИзЭлемента(ТаблСчФакт, "СведТов") Цикл
		Заполнить_InvoiceItem(НовыйЭлементСпискаXDTO(Контент.Items), СведТов);
	КонецЦикла;
	
	Для Каждого СвПРД Из СписокXDTOИзЭлемента(СвСчФакт, "СвПРД") Цикл
		Заполнить_PaymentDocument(НовыйЭлементСпискаXDTO(Контент.PaymentDocuments), СвПРД);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСчФакт, "ИнфПол") Тогда
		Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, СвСчФакт.ИнфПол, "ТекстИнф");
	КонецЕсли;
	
КонецПроцедуры

