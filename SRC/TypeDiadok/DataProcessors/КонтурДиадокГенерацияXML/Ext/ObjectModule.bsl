Процедура ВалидацияСтавокНДС_ДобавитьОшибку(СписокОшибокВалидации, СтрокаТЧ)
	
	ШаблонГиперссылкиВключитьКонвертацию = НСтр("ru='<Заменить на НДС 22%>'");
		ГиперссылкаВключитьКонвертацию = ПодставитьГиперссылкуВОшибкуВалидации(
		ШаблонГиперссылкиВключитьКонвертацию,
		"ВКЛЮЧИТЬКОНВЕРТАЦИЮСТАВОКНДС"
	);
	
	ШаблонГиперссылкиПодробнее = НСтр("ru='<Подробнее в статье>'");
		ГиперссылкаПодробнее = ПодставитьГиперссылкуВОшибкуВалидации(
		ШаблонГиперссылкиПодробнее,
		"https://support.kontur.ru/diadoc-1s8x/82632-konvertaciya_stavki_nds_22_pm"
	);
	
	ШаблонТекстаОшибки = НСтр(
		"ru='<p>
		|В документе указана некорректная ставка НДС (%1)
		|<br>
		|Хотите заменить на ставку НДС 22%?
		|<br>
		|%2
		|<br>
		|%3'"
	);
	ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
		ШаблонТекстаОшибки,
		СтрокаТЧ.TaxRate,
		ГиперссылкаПодробнее,
		ГиперссылкаВключитьКонвертацию
	);
	
	ДобавитьОшибкуВалидации(СписокОшибокВалидации, ТекстОшибки);
	
КонецПроцедуры

