КонецПроцедуры

Процедура Заполнить_Signers(Контент, Параметры)
	
	Для Каждого Подписант Из Параметры Цикл
		
		Signer = НовыйЭлементСпискаXDTO(Контент);
		SignerDetails = Signer.SignerDetails;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ФЛ") Тогда
			
			// Физическое лицо
			
			УстановитьЗначениеXDTO(SignerDetails, "SignerType", "PhysicalPerson");
			
			ФЛ = Подписант.ФЛ;
			
			УстановитьЗначениеXDTO(SignerDetails, "LastName", ФЛ.ФИО.Фамилия);
			УстановитьЗначениеXDTO(SignerDetails, "FirstName", ФЛ.ФИО.Имя);
			УстановитьЗначениеXDTO(SignerDetails, "MiddleName", ПолучитьЗначениеXDTO(ФЛ.ФИО, "Отчество"));
			УстановитьЗначениеXDTO(SignerDetails, "Inn", ПолучитьЗначениеXDTO(ФЛ, "ИННФЛ"));
			УстановитьЗначениеXDTO(SignerDetails, "SignerInfo", ПолучитьЗначениеXDTO(ФЛ, "ИныеСвед"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ИП") Тогда
			
			// Индивидуальный предприниматель
			
			УстановитьЗначениеXDTO(SignerDetails, "SignerType", "IndividualEntity");
			
			ИП = Подписант.ИП;
			
			УстановитьЗначениеXDTO(SignerDetails, "LastName", ИП.ФИО.Фамилия);
			УстановитьЗначениеXDTO(SignerDetails, "FirstName", ИП.ФИО.Имя);
			УстановитьЗначениеXDTO(SignerDetails, "MiddleName", ПолучитьЗначениеXDTO(ИП.ФИО, "Отчество"));
			УстановитьЗначениеXDTO(SignerDetails, "Inn", ПолучитьЗначениеXDTO(ИП, "ИННФЛ"));
			УстановитьЗначениеXDTO(SignerDetails, "RegistrationCertificate", ПолучитьЗначениеXDTO(ИП, "СвГосРегИП"));
			УстановитьЗначениеXDTO(SignerDetails, "SignerInfo", ПолучитьЗначениеXDTO(ИП, "ИныеСвед"));
			
		Иначе
			
			// Представитель юридического лица "ЮЛ"
			
			УстановитьЗначениеXDTO(SignerDetails, "SignerType", "LegalEntity");
			
			ЮЛ = Подписант.ЮЛ;
			
			УстановитьЗначениеXDTO(SignerDetails, "LastName", ЮЛ.ФИО.Фамилия);
			УстановитьЗначениеXDTO(SignerDetails, "FirstName", ЮЛ.ФИО.Имя);
			УстановитьЗначениеXDTO(SignerDetails, "MiddleName", ПолучитьЗначениеXDTO(ЮЛ.ФИО, "Отчество"));
			УстановитьЗначениеXDTO(SignerDetails, "Inn", ЮЛ.ИННЮЛ);
			УстановитьЗначениеXDTO(SignerDetails, "SignerOrganizationName", ПолучитьЗначениеXDTO(ЮЛ, "НаимОрг"));
			УстановитьЗначениеXDTO(SignerDetails, "Position", ЮЛ.Должн);
			УстановитьЗначениеXDTO(SignerDetails, "SignerInfo", ПолучитьЗначениеXDTO(ЮЛ, "ИныеСвед"));
			
		КонецЕсли;
		
		УстановитьЗначениеXDTO(SignerDetails, "SignerPowers", SignerPowers(Подписант.ОблПолн));
		УстановитьЗначениеXDTO(SignerDetails, "SignerStatus", SignerStatus(Подписант.Статус));
		УстановитьЗначениеXDTO(SignerDetails, "SignerPowersBase", Подписант.ОснПолн);
		УстановитьЗначениеXDTO(SignerDetails, "SignerOrgPowersBase", ПолучитьЗначениеXDTO(Подписант, "ОснПолнОрг"));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_DocumentAdditionalInfos(Контент, Параметры)
	
	Для Каждого ИнфДопСв Из Параметры Цикл
		Контент.DocumentAdditionalInfo.Добавить(ИнфДопСв);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_ExtendedOrganizationInfo_Torg2(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвФЛ") Тогда
		
		// Сведения о физическом лице
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgType", "PhysicalEntity");
		
		СвФЛ = Параметры.ИдСв.СвФЛ;
		
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgName", XML_СтрокаФИО(СвФЛ.ФИО));
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Inn", ПолучитьЗначениеXDTO(СвФЛ, "ИННФЛ"));
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrganizationOrPersonInfo", ПолучитьЗначениеXDTO(СвФЛ, "ИныеСвед"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИП") Тогда
		
		// Сведения об индивидуальном предпринимателе
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgType", "IndividualEntity");
		
		СвИП = Параметры.ИдСв.СвИП;
		
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgName", XML_СтрокаФИО(СвИП.ФИО));
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Inn", СвИП.ИННФЛ);
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "IndividualEntityRegistrationCertificate", ПолучитьЗначениеXDTO(СвИП, "СвГосРегИП"));
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrganizationOrPersonInfo", ПолучитьЗначениеXDTO(СвИП, "ИныеСвед"));
		
	Иначе
		
		// Сведения об организации "СвОрг"
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв.СвОрг, "СвОргУч") Тогда
			
			// Сведения об организации, состоящей на учете в налоговом органе
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgType", "LegalEntity");
			
			СвОргУч = Параметры.ИдСв.СвОрг.СвОргУч;
			
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Inn", СвОргУч.ИННЮЛ);
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgName", СвОргУч.НаимОрг);
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Kpp", ПолучитьЗначениеXDTO(СвОргУч, "КПП"));
			
		Иначе
			
			// Сведения об иностранном лице, не состоящем на учете в налоговых органах в качестве налогоплательщика "СвИнНеУч"
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgType", "ForeignEntity");
			
			СвИнНеУч = Параметры.ИдСв.СвОрг.СвИнНеУч;
			
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrgName", СвИнНеУч.НаимОрг);
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "LegalEntityId", ПолучитьЗначениеXDTO(СвИнНеУч, "Идентиф"));
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrganizationOrPersonInfo", ПолучитьЗначениеXDTO(СвИнНеУч, "ИныеСвед"));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Адрес") Тогда
		Заполнить_Address_Torg2(Контент.OrganizationDetails.Address, Параметры.Адрес);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Контакт") Тогда
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Phone", ПолучитьЗначениеXDTO(Параметры.Контакт, "Тлф"));
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Email", ПолучитьЗначениеXDTO(Параметры.Контакт, "ЭлПочта"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "БанкРекв") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.БанкРекв, "СвБанк") Тогда
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "BankName", ПолучитьЗначениеXDTO(Параметры.БанкРекв.СвБанк, "НаимБанк"));
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "BankId", ПолучитьЗначениеXDTO(Параметры.БанкРекв.СвБанк, "БИК"));
			УстановитьЗначениеXDTO(Контент.OrganizationDetails, "CorrespondentAccount", ПолучитьЗначениеXDTO(Параметры.БанкРекв.СвБанк, "КорСчет"));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент.OrganizationDetails, "BankAccountNumber", ПолучитьЗначениеXDTO(Параметры.БанкРекв, "НомерСчета"));
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Okpo", ПолучитьЗначениеXDTO(Параметры, "ОКПО"));
	УстановитьЗначениеXDTO(Контент.OrganizationDetails, "Department", ПолучитьЗначениеXDTO(Параметры, "СтруктПодр"));
	УстановитьЗначениеXDTO(Контент.OrganizationDetails, "OrganizationAdditionalInfo", ПолучитьЗначениеXDTO(Параметры, "ИнфДляУчаст"));
	
КонецПроцедуры

Процедура Заполнить_CargoInspectionInformation(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СертСоотв") Тогда
