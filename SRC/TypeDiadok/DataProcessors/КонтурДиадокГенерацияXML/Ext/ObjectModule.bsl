Процедура XML_АктСверки_ОтветныйТитул_ЗаполнитьОсновныеСведенияФайла(ИмяПакетаXDTO, Файл, Документ, Content, КНД, ВерсияФормата, ПараметрыФормированияФайла)
	
	ИдентификаторОтправителя = ПараметрыФормированияФайла.ИдентификаторОтправителя;
	ИдентификаторПолучателя = ПараметрыФормированияФайла.ИдентификаторПолучателя;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОтправителя)
		ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не заполнены идентификаторы отправителя или получателя'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ВерсПрог = XML_ВерсияПрограммыФормированияФайла();
	ДопПрефикс = "";
	
	ИдФайл = XML_ИдФайл(
		ИмяПакетаXDTO,
		ДопПрефикс,
		ИдентификаторПолучателя,
		ИдентификаторОтправителя,
		ПараметрыФормированияФайла
	);
	
	ПризнРазн = XML_АктСверки_ПризнакРазногласий(Content.SignDisagreement);
	
	УстановитьЗначениеXDTO(Файл, "ИдФайл", ИдФайл);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм", ВерсияФормата);
	УстановитьЗначениеXDTO(Файл, "ВерсПрог", ВерсПрог);
	УстановитьЗначениеXDTO(Файл, "ПризнРазн", ПризнРазн);
	УстановитьЗначениеXDTO(Документ, "КНД", КНД);
	
	ДатаИнфПол = Дата1С_в_ДатаXML(Content.DateCreateFile);
	ВрИнфПол = Время1С_в_ВремяXML(Content.TimeCreateFile);
	
	УстановитьЗначениеXDTO(Документ, "ДатаИнфПол", ДатаИнфПол);
	УстановитьЗначениеXDTO(Документ, "ВрИнфПол", ВрИнфПол);
	
КонецПроцедуры

Функция XML_АктСверки_СтатусПодписанта(ИдентификаторСтатусаПодписанта)
	
	СтатусыПодписанта = Новый Соответствие;
	
	// 1 - лицо, имеющее полномочия на подписание документа без доверенности
	СтатусыПодписанта.Вставить(НРег("WithoutPowerOfAttorney"), 1);
	
	// 2 - лицо, имеющее полномочия на подписание документа на основании доверенности в электронной форме
	СтатусыПодписанта.Вставить(НРег("DigitalPowerOfAttorney"), 2);
	
	// 3 - лицо, имеющее полномочия на подписание документа на основании доверенности в бумажном виде
	СтатусыПодписанта.Вставить(НРег("PaperPowerOfAttorney"), 3);
	
	Результат = СтатусыПодписанта.Получить(НРег(ИдентификаторСтатусаПодписанта));
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ШаблонТекстаОшибки = "Неожиданный статус подписанта: %1";
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			ШаблонТекстаОшибки,
			ИдентификаторСтатусаПодписанта
		);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XML_АктСверки_ТипПодписи(ИдентификаторТипаПодписи)
	
	ТипыПодписи = Новый Соответствие;
	
	// 1 - усиленная квалифицированная электронная подпись
	ТипыПодписи.Вставить(НРег("EnhancedQualifiedSignature"), 1);
	
	// 2 - простая электронная подпись
	ТипыПодписи.Вставить(НРег("SimpleSignature"), 2);
	
	// 3 - усиленная неквалифицированная электронная подпись
	ТипыПодписи.Вставить(НРег("EnhancedUnqualifiedSignature"), 3);
	
	Результат = ТипыПодписи.Получить(НРег(ИдентификаторТипаПодписи));
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ШаблонТекстаОшибки = "Неожиданный тип подписи: %1";
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			ШаблонТекстаОшибки,
			ИдентификаторТипаПодписи
		);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XML_АктСверки_ПризнакРазногласий(ИдентификаторПризнака)
	
	ПризнакиРазногласий = Новый Соответствие;
	
	// 1 - нет разногласий между сверяемыми операциями отправителя и получателя
	ПризнакиРазногласий.Вставить(НРег("WithoutDisagreements"), 1);
	
	// 2 - есть разногласия между сверяемыми операциями отправителя и получателя
	ПризнакиРазногласий.Вставить(НРег("WithDisagreements"), 2);
	
	Результат = ПризнакиРазногласий.Получить(НРег(ИдентификаторПризнака));
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ШаблонТекстаОшибки = "Неожиданный признак разногласий: %1";
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			ШаблонТекстаОшибки,
			ИдентификаторПризнака
		);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// XML: общие функции заполнения

Функция XML_ФабрикаXDTO(ИмяПакетаXDTO) Экспорт
	
	КлючКэш = "ФабрикаXDTO_" + ИмяПакетаXDTO;
	
	Результат = Кэш_Прочитать(КлючКэш);
	
	Если Результат = Неопределено Тогда
		
		ИмяМакета	 = ИмяПакетаXDTO + "_xsd";
		ТекстМакета	 = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстМакета);
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		ПостроительСхемXML = Новый ПостроительСхемXML;
		СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
		
		НаборСхемXML = Новый НаборСхемXML;
		НаборСхемXML.Добавить(СхемаXML);
		
		Результат = Новый ФабрикаXDTO(НаборСхемXML);
		
		Кэш_Поместить(КлючКэш, Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XML_ФорматЧисла(Число, Точность)
	
	Результат = Неопределено;
	
	Если Число <> Неопределено Тогда
		
		Если Точность = Неопределено Тогда
			Число			= Окр(Число, 11); 
			ФорматнаяСтрока	= "ЧРД=.; ЧН=; ЧГ=";
		Иначе
			ФорматнаяСтрока = "ЧДЦ=" + Точность + "; ЧРД=.; ЧН=; ЧГ=";
		КонецЕсли; 
		
		Результат = Формат(Число, ФорматнаяСтрока);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ЗаполнитьОсновныеСведенияФайла(ИмяПакетаXDTO, Файл, Документ, Content, КНД, ВерсияФормата, ПараметрыФормированияФайла, ДопПрефикс = "")
	
	ИдентификаторОтправителя = ПараметрыФормированияФайла.ИдентификаторОтправителя;
	ИдентификаторПолучателя	 = ПараметрыФормированияФайла.ИдентификаторПолучателя;
	
	Если Не ЗначениеЗаполнено(ИдентификаторОтправителя) Или Не ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		Если ИмяПакетаXDTO = "ON_NSCHFDOPPR" Тогда
			ИдентификаторПолучателя	 = ?(Content.Buyers.Количество() > 0, Content.Buyers[0].FnsParticipantId, "");
			ИдентификаторОтправителя = ?(Content.Sellers.Количество() > 0, Content.Sellers[0].FnsParticipantId, "");
		ИначеЕсли ИмяПакетаXDTO = "DP_PRIRASXPRIN" Тогда
			ИдентификаторПолучателя	 = Content.CircumstancesAcceptanceInfo.Buyer.OrganizationDetails.FnsParticipantId;
			ИдентификаторОтправителя = Content.CircumstancesAcceptanceInfo.Seller.OrganizationDetails.FnsParticipantId;
		Иначе
			ИдентификаторПолучателя	 = Content.Buyer.FnsParticipantId;
			ИдентификаторОтправителя = Content.Seller.FnsParticipantId;
		КонецЕсли;
	КонецЕсли;
	
	ВерсПрог	 = "Diadoc 1.0";
	ОператорЭДО	 = XML_ОператорЭДО();
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ИдФайл		 = XML_ИдФайл(ИмяПакетаXDTO, ДопПрефикс, ИдентификаторПолучателя, ИдентификаторОтправителя, ПараметрыФормированияФайла);
	
	УстановитьЗначениеXDTO(Файл, "ИдФайл", ИдФайл);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм", ВерсияФормата);
	УстановитьЗначениеXDTO(Файл, "ВерсПрог", ВерсПрог);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "КНД") Тогда
		УстановитьЗначениеXDTO(Документ, "КНД", КНД);
	КонецЕсли;
	
	// Сведения об участниках электронного документооборота
	СвУчДокОбор = НовыйДочернийОбъектXDTO(Фабрика, Файл, "СвУчДокОбор");
	УстановитьЗначениеXDTO(СвУчДокОбор, "ИдОтпр", ИдентификаторОтправителя);
	УстановитьЗначениеXDTO(СвУчДокОбор, "ИдПол",  ИдентификаторПолучателя);
	
	// Сведения об операторе
	Если ИмяПакетаXDTO = "DP_PRIRASXPRIN" Тогда
		
		СвОЭДОтпр	 = НовыйДочернийОбъектXDTO(Фабрика, СвУчДокОбор, "СвОЭДОтпрСФ");
		УстановитьЗначениеXDTO(СвОЭДОтпр, "НаимОрг", ОператорЭДО.Имя);
		УстановитьЗначениеXDTO(СвОЭДОтпр, "ИННЮЛ",	ОператорЭДО.ИНН);
		УстановитьЗначениеXDTO(СвОЭДОтпр, "ИдЭДОСФ",	ОператорЭДО.ID);
		
	Иначе
		
		СвОЭДОтпр	 = НовыйДочернийОбъектXDTO(Фабрика, СвУчДокОбор, "СвОЭДОтпр");
		УстановитьЗначениеXDTO(СвОЭДОтпр, "НаимОрг", ОператорЭДО.Имя);
		УстановитьЗначениеXDTO(СвОЭДОтпр, "ИННЮЛ",	ОператорЭДО.ИНН);
		УстановитьЗначениеXDTO(СвОЭДОтпр, "ИдЭДО",	ОператорЭДО.ID);
		
	КонецЕсли;
	
	// Дата и время формирования файла
	ДатаФормирования	 = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=dd.MM.yyyy");
	ВремяФормирования	 = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=HH.mm.ss");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ДатаИнфИсп") Тогда
		
		УстановитьЗначениеXDTO(Документ, "ДатаИнфИсп", ДатаФормирования);
		УстановитьЗначениеXDTO(Документ, "ВремИнфИсп", ВремяФормирования);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ДатаИнфПр") Тогда
		
		УстановитьЗначениеXDTO(Документ, "ДатаИнфПр", ДатаФормирования);
		УстановитьЗначениеXDTO(Документ, "ВремИнфПр", ВремяФормирования);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ДатаДокПт") Тогда
		
		УстановитьЗначениеXDTO(Документ, "ДатаДокПт", ДатаФормирования);
		УстановитьЗначениеXDTO(Документ, "ВремДокПт", ВремяФормирования);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ДатаИнфПок") Тогда
		
		УстановитьЗначениеXDTO(Документ, "ДатаИнфПок", ДатаФормирования);
		УстановитьЗначениеXDTO(Документ, "ВремИнфПок", ВремяФормирования);
		
	КонецЕсли;
	
	// Наименование экономического субъекта
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "НаимЭконСубСост") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "DocumentCreator") Тогда
			СоставительФайла = Content.DocumentCreator;
		Иначе
			СоставительФайла = Content.Creator;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Документ, "НаимЭконСубСост", СоставительФайла);
		
	КонецЕсли;
	
	// Основание, по которому экономический субъект является составителем файла обмена
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ОснДоверОргСост") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "DocumentCreatorBase") Тогда
			ОснованиеСоставителя = Content.DocumentCreatorBase;
		Иначе
			ОснованиеСоставителя = Content.CreatorBase;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Документ, "ОснДоверОргСост", ОснованиеСоставителя);
		
	КонецЕсли;
	
	// Информация о наличии согласованной структуры дополнительных информационных полей 
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "СоглСтрДопИнф") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "ApprovedStructureAdditionalInfoFields") Тогда
			СтруктураДопПолей = Content.ApprovedStructureAdditionalInfoFields;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Документ, "СоглСтрДопИнф", СтруктураДопПолей);
		
	КонецЕсли;
	
	Если ИмяПакетаXDTO = "ON_SCHFDOPPR" Или ИмяПакетаXDTO = "ON_NSCHFDOPPR" Тогда // УПД
		
		XML_УПД_ЗаполнитьСведенияОДокументе(Документ, Content);
		
	ИначеЕсли ИмяПакетаXDTO = "ON_KORSCHFDOPPR" Тогда // УКД
		
		XML_УКД_ЗаполнитьСведенияОДокументе(Документ, Content);
		
	ИначеЕсли ИмяПакетаXDTO = "ON_NKORSCHFDOPPR" Тогда // УКД
		
		XML_УКД_736_ЗаполнитьСведенияОДокументе(Документ, Content);
		
	ИначеЕсли ИмяПакетаXDTO = "ON_SCHET" Тогда // Счет
		
		УстановитьЗначениеXDTO(Документ, "ТипДок", "ФормализованныйСчет");
		УстановитьЗначениеXDTO(Документ, "НаимДок", "Формализованный счет");
		
	ИначеЕсли ИмяПакетаXDTO = "DP_PRIRASXPRIN" Тогда
		
		XML_Торг2_ЗаполнитьСведенияОДокументе(Фабрика, Документ, Content);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура XML_УПД_ЗаполнитьСведенияОДокументе(Документ, Content)
	
	ФункцияУПД = XML_УПД_ПолучитьФункцию(Content.Function);
	УстановитьЗначениеXDTO(Документ, "Функция", ФункцияУПД);
	
	ФункцииУПД = Перечисление_ФункцииУПД();
	Если ФункцияУПД = ФункцииУПД.СЧФ Тогда
		Возврат;
	КонецЕсли;
	
	// Определено приказом ФНС
	ПоФактХЖ = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	
	Если ФункцияУПД = ФункцииУПД.СЧФДОП Тогда
		
		// Определено приказом ФНС
		НаимДокОпр = "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";

	Иначе // ДОП
		
		// Наименование явно указано в контенте
		НаимДокОпр = НаименованиеПервичногоДокументаИзПрото(Content);
		
		Если Не ЗначениеЗаполнено(НаимДокОпр) Тогда
			// Вариант по умолчанию, определенный приказом ФНС
			НаимДокОпр = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Документ, "ПоФактХЖ"		, ПоФактХЖ);
	УстановитьЗначениеXDTO(Документ, "НаимДокОпр"	, НаимДокОпр);
	
КонецПроцедуры

