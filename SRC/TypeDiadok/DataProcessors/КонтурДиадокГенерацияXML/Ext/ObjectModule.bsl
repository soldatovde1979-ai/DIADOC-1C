	УстановитьЗначениеXDTO(Контент, "ReceptionFinishTime", ПолучитьЗначениеXDTO(Параметры, "ВремяОконч"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДатаОтпр") Тогда
		УстановитьЗначениеXDTO(Контент, "DeliveryDate", ДатаXML_в_Дата1С(Параметры.ДатаОтпр));
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_ReceptionInformation(Контент, Параметры)
	
