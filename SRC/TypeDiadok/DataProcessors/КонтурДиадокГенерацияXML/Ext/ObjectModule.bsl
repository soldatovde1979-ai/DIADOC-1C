//{ Алгоритмы валидации контента исходящих документов

// РАБОТА С КОЛЛЕКЦИЯМИ ОШИБОК - ДОБАВЛЕНИЕ, ИНТЕРПРЕТАЦИЯ

// Основной метод для добавления ошибок валидации.
Функция ДобавитьОшибкуВалидации(СписокОшибок = Неопределено, ТекстОшибки, СсылкаДляИсправления = Неопределено) Экспорт
	
	Возврат ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, ТекстОшибки, СсылкаДляИсправления);
	
КонецФункции

// времянка для выделения в коде мест, где требуется оформление ошибки (<h3>, <b>)
Функция ДобавитьОшибкуВалидацииСОформлением(СписокОшибок = Неопределено, ТекстОшибки, СсылкаДляИсправления = Неопределено, Обрамление = "")
	
	Если СписокОшибок = Неопределено Тогда
		СписокОшибок = Новый Массив;
	КонецЕсли;
	
    Если ПустаяСтрока(ТекстОшибки) Тогда
        Возврат СписокОшибок;
	КонецЕсли;
	
	НоваяОшибка = НовыйОшибкаВалидации(ТекстОшибки, Обрамление, СсылкаДляИсправления);
	СписокОшибок.Добавить(НоваяОшибка);
	
	Возврат СписокОшибок;
	
КонецФункции

// Добавляет группу ошибок с общим заголовком
Функция ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокДобавляемыхОшибок, ШаблонЗаголовка, СсылкаДляИсправления = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(СписокДобавляемыхОшибок) Тогда
		Возврат СписокОшибок;
	КонецЕсли;
	
	Обрамление = "h3";  // выделим заголовок группы
	ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, ШаблонЗаголовка, СсылкаДляИсправления, Обрамление);
	ДополнитьМассивОшибокВалидации(СписокОшибок, СписокДобавляемыхОшибок);
	
	Возврат СписокОшибок;
	
КонецФункции

Процедура ДополнитьМассивОшибокВалидации(ДополняемыйМассив, ДобавляемыеОшибки) Экспорт
	
	Для каждого Ошибка Из ДобавляемыеОшибки Цикл
		ДополняемыйМассив.Добавить(Ошибка);
	КонецЦикла;
		
КонецПроцедуры

Функция ОформитьОшибкиВHTML(СписокОшибок, ЗаголовокОшибки = "") Экспорт
	
	Результат = "";
	
	// заглушка для возможности переключения между структурированным и неструктурированным поведением
	Если ТипЗнч(СписокОшибок) = Тип("Строка") Тогда
		
		Ошибка = СписокОшибок;
		
	Иначе
	
		Ошибка = ПеревестиСтруктурированныеОшибкиВТекст(СписокОшибок);
		
	КонецЕсли;

	Если ЗначениеЗаполнено(Ошибка) Тогда

		ТелоHTML = ?(ЗначениеЗаполнено(ЗаголовокОшибки),
					"<h2>" + ЗаголовокОшибки + "</h2>" + Ошибка,
					Ошибка);
					
		Результат = 
		"<HTML><head>
		|<META content=""text/html; charset=utf-8"" http-equiv=Content-Type>
		|<style type=""text/css"">
		| h3 {
		|  margin-top: 0.5em; /* Отступ сверху */
		|  margin-bottom: 0em; /* Отступ снизу */
		| }
		| p {
		|  margin-top: 0.2em; /* Отступ сверху */
		|  margin-bottom: 0em; /* Отступ снизу */
		| }
		|</style>
		|</head>
		|<body>" + ТелоHTML + "</body></HTML>";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор для ошибки валидации
//
// Параметры:
//  ТекстОшибки			 - Строка	 - текст ошибки
//  Обрамление			 - Строка	 - оформление ошибки в HTML, обрамляющие теги. Например, "b" или "i,h3"
//  СсылкаДляИсправления - СправочникСсылка
//						 - ДокументСсылка
//						 - Строка	 - Ссылка на элемент данных или закодированная строка, указывающая на место возникновения ошибки
// 
// Возвращаемое значение:
//   - Структура
//
Функция НовыйОшибкаВалидации(ТекстОшибки, Обрамление = "", СсылкаДляИсправления = Неопределено)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТекстОшибки",			ТекстОшибки);
	Результат.Вставить("Обрамление",			Обрамление);
	Результат.Вставить("СсылкаДляИсправления",	СсылкаДляИсправления);
	
	Возврат Результат;

КонецФункции	

Функция ПеревестиСтруктурированныеОшибкиВТекст(СписокОшибок)
	
	Результат = "";
	
    Для каждого СтрокаОшибки Из СписокОшибок Цикл
	
		МассивОбрамляющихТегов = РазложитьСтрокуВМассивСлов(СтрокаОшибки.Обрамление, ",");
		
		Если МассивОбрамляющихТегов.Найти("p") = Неопределено Тогда
			МассивОбрамляющихТегов.Вставить(0, "p");  // каждый тег обязательно будет отдельным параграфом
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СтрокаОшибки.СсылкаДляИсправления) Тогда
			ПредставлениеОшибки = ПодставитьГиперссылкуВОшибкуВалидации(СтрокаОшибки.ТекстОшибки, СтрокаОшибки.СсылкаДляИсправления);
		Иначе
			ПредставлениеОшибки = СтрокаОшибки.ТекстОшибки;
		КонецЕсли;	
	
		Результат = Результат 
				+ ОбрамляющиеТегиСтрокой(МассивОбрамляющихТегов, Ложь)		// <p><h3>
				+ ПредставлениеОшибки										// Ошибка в ИНН
				+ ОбрамляющиеТегиСтрокой(МассивОбрамляющихТегов, Истина);	// </h3></p>
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ОбрамляющиеТегиСтрокой(МассивОбрамляющихТегов, ОбратныйПорядок)
	
	Результат = "";
	
	ВГраница = МассивОбрамляющихТегов.ВГраница();
	
	Для Сч = 0 По ВГраница Цикл
		
		Если НЕ ОбратныйПорядок Тогда
			Результат = Результат + "<" + МассивОбрамляющихТегов[ВГраница - Сч] + ">";
		Иначе
			Результат = Результат + "</" + МассивОбрамляющихТегов[Сч] + ">";  // закрывающий тег
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

// Текст: Строка такого вида:
// "Ошибки в данных о <поставщике>: откройте его"
// На выходе получаем:
// "Ошибки в данных о <a href="СправочникСсылка.Контрагенты:faefaef-aegaeg-sahy43-334ff">поставщике</a>: откройте его"
// или
// "Ошибки в <a href="НастройкаПараметровПодписания">параметрах подписанта</a>"
// Ссылка - либо ссылка на элемент справочника/документа, либо Строка. 
Функция ПодставитьГиперссылкуВОшибкуВалидации(Текст, Ссылка)
	
	ПозицияОткрывающейСкобки = Найти(Текст, "<");
	ПозицияЗакрывающейСкобки = Найти(Текст, ">");
	
	Если (ПозицияОткрывающейСкобки = 0 И ПозицияЗакрывающейСкобки = 0)
		Или ПозицияОткрывающейСкобки > ПозицияЗакрывающейСкобки Тогда
		ВызватьИсключение "Некорректный параметр метода: ПодставитьГиперссылкуВОшибкуВалидации";
	КонецЕсли;
	
	Если ТипЗнч(Ссылка) = Тип("Строка") Тогда
		СодержимоеСсылки = Ссылка;
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка))
		Или	Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка)) Тогда
		СодержимоеСсылки = ВРЕГ("" + Ссылка.Метаданные().ПолноеИмя() + ":" + Ссылка.УникальныйИдентификатор());
	Иначе
		ВызватьИсключение "Некорректный параметр метода: ПодставитьГиперссылкуВОшибкуВалидации";
	КонецЕсли;
	
	Результат = Лев(Текст, ПозицияОткрывающейСкобки - 1)
				+ "<a href="
				+ СодержимоеСсылки
				+ ">" + Сред(Текст, ПозицияОткрывающейСкобки + 1, ПозицияЗакрывающейСкобки - ПозицияОткрывающейСкобки - 1)
				+ "</a>"
				+ Сред(Текст, ПозицияЗакрывающейСкобки + 1);
	
	Возврат Результат;
	
КонецФункции	



