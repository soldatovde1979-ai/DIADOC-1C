		Результат = ТипПрото_ИнформацияПродавцаСчетНаОплату29();
		
	ИначеЕсли Найти(ИдФайл, "DP_PRIRASXPRIN") = 1 Тогда
		
		Результат = ТипПрото_ИнформацияОтправителя423();
		
	ИначеЕсли Найти(ИдФайл, "DP_PRIRASXSVED") = 1 Тогда
		
		Результат = ТипПрото_ИнформацияПолучателя423();
		
	ИначеЕсли Найти(ИдФайл, "ON_AKTSVEROTP") = 1 Тогда
		
		Результат = ТипПрото_ИнформацияОтправителя405();
		
	ИначеЕсли Найти(ИдФайл, "ON_AKTSVERPOL") = 1 Тогда
		
		Результат = ТипПрото_ИнформацияПолучателя405();
		
	Иначе
		
		ТекстОшибки = СтрЗаменить(
			"Не удалось определить тип контента по причине:
			|Неизвестный префикс атрибута ИдФайл (%1)",
			"%1",
			ИдФайл
		);
		
		Сообщить(ТекстОшибки);
		
	КонецЕсли;
	
	Возврат Результат;
	
	// BSLLS:DeprecatedFind-on
КонецФункции

Функция ПолучитьТипКонтентаОбъектаXDTO(ОбъектXDTO)
	
	Результат = Неопределено;
	
	Если XML_ЭтоТитулПродавцаУПД970(ОбъектXDTO) Тогда
		
		Результат = ТипПрото_ИнформацияПродавца970();

	ИначеЕсли XML_ЭтоТитулПокупателяУПД970(ОбъектXDTO) Тогда
		
		Результат = ТипПрото_ИнформацияПокупателя970();
		
	ИначеЕсли XML_ЭтоТитулПродавцаУПД820(ОбъектXDTO) Тогда
		
		Результат = ТипПрото_ИнформацияПродавца820();
		
	ИначеЕсли XML_ЭтоТитулПокупателяУПД820(ОбъектXDTO) Тогда
		
		Результат = ТипПрото_ИнформацияПокупателя820();
		
	ИначеЕсли XML_ЭтоТитулПродавцаНакладнаяРБ01(ОбъектXDTO) Тогда
		
		Результат = ТипПрото_ИнформацияПродавцаНакладнаяРБ01();
		
	ИначеЕсли XML_ЭтоТитулПокупателяНакладнаяРБ01(ОбъектXDTO) Тогда
		
		Результат = ТипПрото_ИнформацияПокупателяНакладнаяРБ01();
		
	Иначе
		
		ИдФайл = ПолучитьЗначениеXDTO(ОбъектXDTO, "ИдФайл", "");

		Результат = ИдФайл_В_ТипКонтента(ИдФайл);
		
