//#Область ПубличныеКонтракты

// Контракт структуры НоменклатураЭлектронногоДокумента.
// 
// Возвращаемое значение:
//  Структура:
//    * Идентификатор - Строка - идентификатор номенклатуры документа
//    * Тип - Строка - принимает значения "Имущество", "Работа", "Услуга", "Право", "Иное" или ""
//    * Код - Строка - код номенклатуры
//    * Артикул - Строка - артикул номенклатуры
//    * Наименование - Строка - наименование номенклатуры
//    * Характеристика - Строка - наименование характеристики
//    * Сорт - Строка - сорт номенклатуры
//    * СтавкаНДС - Строка - представление ставки НДС
//    * ЕдиницаИзмерения - Строка - наименование единицы измерения
//    * ЕдиницаИзмеренияКод - Строка - код единицы измерения
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция Контракт_НоменклатураЭлектронногоДокумента()
	
	ПустаяСтрока = "";
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", ПустаяСтрока);
	Результат.Вставить("Тип", ТипНоменклатурыНеУказан());
	Результат.Вставить("Код", ПустаяСтрока);
	Результат.Вставить("Артикул", ПустаяСтрока);
	Результат.Вставить("Сорт", ПустаяСтрока);
	Результат.Вставить("Наименование", ПустаяСтрока);
	Результат.Вставить("Характеристика", ПустаяСтрока);
	Результат.Вставить("СтавкаНДС", ПустаяСтрока);
	Результат.Вставить("ЕдиницаИзмерения", ПустаяСтрока);
	Результат.Вставить("ЕдиницаИзмеренияКод", ПустаяСтрока);
	Результат.Вставить("GTIN", ПустаяСтрока);
	
	Возврат Результат;
	
КонецФункции

// Возвращает заполненный ОбъектXDTO со сведениями о подписанте для документов в формате 970
//
// Параметры:
//  Полномочия				 - Структура - сведения о полномочиях подписанта (см. Ядро.Подписант_ОписаниеПолномочий)
//  Сертификат				 - Структура - сведения о сертификате (см. Ядро.ВнешниеСервисы_Контракт_ОписаниеСертификата)
//  КонтрактМЧД				 - Структура - сведения о МЧД (см. Ядро.Контракт_МЧД)
//  ПараметрыФормирования	 - Структура - доп. параметры для заполнения сведений о подписанте (см. Новый_ПараметрыФормированияSigner970)
// 
// Возвращаемое значение:
//  ОбъектXDTO - протоструктура с описанием сведений о подписанте (см. в макете "Proto_xsd" описание типа "Signer970")
//
Функция УПД970_ЗаполненныйSigner(Полномочия, Сертификат, КонтрактМЧД, ПараметрыФормирования) Экспорт
	
	Результат = НовыйProtoОбъектXDTO("Signer970");
	
	Если Полномочия = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Surname = Полномочия.Surname;
	Результат.FirstName = Полномочия.FirstName;
	
	ЕстьСвойствоОтчество = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Полномочия, "Patronymic");
	Если ЕстьСвойствоОтчество Тогда
		Результат.Patronymic = СокрЛП(Полномочия.Patronymic);
	КонецЕсли;
	
	ЕстьСвойствоДолжность = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Полномочия, "JobTitle");
	Если ЕстьСвойствоДолжность Тогда
		Результат.JobTitle = СокрЛП(Полномочия.JobTitle);
	КонецЕсли;
	
	ЭтоКЭП = Ложь;
	
	ЕстьСвойствоКЭП = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Сертификат, "ЭтоКЭП");
	Если ЕстьСвойствоКЭП Тогда
		ЭтоКЭП = Сертификат.ЭтоКЭП;
	КонецЕсли;
	
	Если ЭтоКЭП Тогда
		Результат.SignType = "Qualified";
	КонецЕсли;
	
	СпосПодтПолном = XML_СпособПодтвержденияПолномочийПодписанта(Сертификат, КонтрактМЧД, ПараметрыФормирования);
	Результат.ConfirmCredentials = СпосПодтПолном;
	
	ЕстьСвойствоДопСведений = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Полномочия, "SignerInfo");
	Если ЕстьСвойствоДопСведений Тогда
		Результат.AdditionalInfo = СокрЛП(Полномочия.SignerInfo);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру параметров для заполнения прото со сведениями о подписанте в методе Новый_SignerContent970
//
// Параметры:
//  ПередаватьМЧДФайлом	 - Булево - признак передачи МЧД файлом
//  ИННОрганизации		 - Строка - ИНН организации (владельца ящика)
// 
// Возвращаемое значение:
//  Структура - структура доп. параметров для заполнения сведений о подписанте
//
Функция УПД970_Новый_ПараметрыФормированияSigner(ПередаватьМЧДФайлом, ИННОрганизации) Экспорт
			
	Результат = Новый Структура;
	
	Результат.Вставить("ПередаватьМЧДФайлом", ПередаватьМЧДФайлом);
	Результат.Вставить("ИННОрганизации", ИННОрганизации);
	
	Возврат Результат;		
		
КонецФункции

Функция XML_СпособПодтвержденияПолномочийПодписанта(Сертификат, КонтрактМЧД, ПараметрыФормирования)
	
	Результат = Неопределено;
	
	ЕстьСвойствоТип = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Сертификат, "Тип");
	Если ЕстьСвойствоТип Тогда
		ТипСертификата = Сертификат.Тип;
	Иначе
		ТипСертификата = "ФЛ";
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Сертификат, "ИНН") Тогда
		ИННСертификата = Сертификат.ИНН;
	Иначе
		ИННСертификата = "";
	КонецЕсли;
	
	Если (ТипСертификата = "ЮЛ" Или ТипСертификата = "ИП")
		И ИННСертификата = ПараметрыФормирования.ИННОрганизации Тогда
		
		Результат = 1;
		
	ИначеЕсли ТипСертификата = "ФЛ"
		И ИННСертификата = ПараметрыФормирования.ИННОрганизации Тогда
		
		Результат = 6;
		
	ИначеЕсли ИННСертификата <> ПараметрыФормирования.ИННОрганизации Тогда
		
		Если КонтрактМЧД <> Неопределено
			И ПараметрыФормирования.ПередаватьМЧДФайлом Тогда
			
			Результат = 2;
			
		ИначеЕсли КонтрактМЧД <> Неопределено
			И НЕ ПараметрыФормирования.ПередаватьМЧДФайлом Тогда
			
			Результат = 4;
			
		ИначеЕсли КонтрактМЧД = Неопределено Тогда
			
			Результат = 6;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

