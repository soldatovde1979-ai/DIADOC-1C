			Результат = Значение;
		КонецЕсли;
		
	Иначе
		
		Если Значение = "00005" Тогда
			Результат = "4";
		ИначеЕсли Значение = "00006" Тогда
			Результат = "5";
		ИначеЕсли Значение = "00007" Тогда
			Результат = "6";
		ИначеЕсли Значение = "00008" Тогда
			Результат = "7";
		ИначеЕсли Значение = "00009" Тогда
			Результат = "8";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
