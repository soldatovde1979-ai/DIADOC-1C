	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ТаблКСчФ, "ВсегоУвел") Тогда
		Заполнить_InvoiceTotalsDiff(Контент.TotalsInc, ТаблКСчФ.ВсегоУвел);
