		УстановитьЗначениеXDTO(Контент, "Inn", ИНН);
		
		Заполнить_ФИО(Контент, ФЛПер.ФИО);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ФЛПер, "ОснДоверФЛ") Тогда
			Заполнить_DocumentDetails(Контент.OrganizationBase, ФЛПер.ОснДоверФЛ);	
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ФЛПрин") Тогда
		
