		УстановитьЗначениеXDTO(Контент, "Subtotal", ПолучитьЗначениеXDTO(Параметры, "СтоимТовНДСПрин"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНДСПрин") Тогда
		УстановитьЗначениеXDTO(Контент, "Vat", ПолучитьЗначениеXDTO(Параметры, "СумНДСПрин"));
	КонецЕсли;
	
КонецПроцедуры

