Функция XML_СведенияИдФайлУПД970(ИдФайл)
	
	Разделитель = "_";
	ЧастиИдФайл = РазложитьСтрокуВМассивСлов(ИдФайл, Разделитель);
	
	Если ЧастиИдФайл.Количество() <> 12 Тогда
		ВызватьИсключение "Неверный формат значения ИдФайл. По формату значение должно содержать 12 элементов, разделенных знаком ""_""";	
	КонецЕсли;
	
	Префикс = ЧастиИдФайл[0] + Разделитель + ЧастиИдФайл[1]; 
	
	Результат = Новый Структура;
	Результат.Вставить("Префикс", Префикс);
	Результат.Вставить("ИдПолучателя", ЧастиИдФайл[2]);
	Результат.Вставить("ИдОтправителя", ЧастиИдФайл[3]);
	Результат.Вставить("ДатаФормирования", ЧастиИдФайл[4]);
	Результат.Вставить("УникальныйНомерФайла", ЧастиИдФайл[5]);
	Результат.Вставить("ПризнакЕстьПрослежка", ЧастиИдФайл[6]);
	Результат.Вставить("ПризнакЕстьМаркировка", ЧастиИдФайл[7]);
	Результат.Вставить("ПризнакЕстьАлкоголь", ЧастиИдФайл[8]);
	Результат.Вставить("ПризнакЕстьТабак", ЧастиИдФайл[9]);
	Результат.Вставить("ПризнакЕстьНефтепродукты", ЧастиИдФайл[10]);
	Результат.Вставить("СвободноеЗначение", ЧастиИдФайл[11]);

	Возврат Результат;

КонецФункции

// XML функции заполнения счета ФНС29

Функция XML_ФНС29_СформироватьИдФайла(ПротоКонтент, ПараметрыФормированияФайла)

	ПрефиксИдФайла = "ON_CHETOP";
	ПредставлениеДатыФормирования = Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=yyyyMMdd");
	
	ИдентификаторПолучателя = "";
	Если ПротоКонтент.Buyer <> Неопределено Тогда
		ИдентификаторПолучателя = ПротоКонтент.Buyer.FnsParticipantId;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		ПараметрыФормированияФайла.Свойство("ИдентификаторПолучателя", ИдентификаторПолучателя);
	КонецЕсли;

	ИдентификаторОтправителя = "";
	Если ПротоКонтент.Seller <> Неопределено Тогда
		ИдентификаторОтправителя = ПротоКонтент.Seller.FnsParticipantId;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторОтправителя) Тогда
		ПараметрыФормированияФайла.Свойство("ИдентификаторОтправителя", ИдентификаторОтправителя);
	КонецЕсли;

	ЧастиИдФайл = Новый Массив;
	ЧастиИдФайл.Добавить(ПрефиксИдФайла);
	ЧастиИдФайл.Добавить(ИдентификаторПолучателя);
	ЧастиИдФайл.Добавить(ИдентификаторОтправителя);
	ЧастиИдФайл.Добавить(ПредставлениеДатыФормирования);
	ЧастиИдФайл.Добавить(ПараметрыФормированияФайла.УникальныйИдентификатор);
	
	Разделитель = "_";
	Результат = Общее_СоединитьСтроку(ЧастиИдФайл, Разделитель);

	Возврат Результат;
	
КонецФункции

Процедура XML_ФНС29_ЗаполнитьСодСч(Документ, ПротоКонтент, ИмяПакетаXDTO, ПараметрыФормированияФайла)
	
	Фабрика	= XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	СодСч = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СодСч");

	ДатаДокумента = Дата1С_в_ДатаXML(ПротоКонтент.DocumentDate);
	
	УстановитьЗначениеXDTO(СодСч, "НомерДок", ПротоКонтент.DocumentNumber);
	УстановитьЗначениеXDTO(СодСч, "ДатаДок", ДатаДокумента);
	
	ДенИзм = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ДенИзм");
	XML_ФНС29_ЗаполнитьДенИзм(ДенИзм, ПротоКонтент);
	
	Если ПротоКонтент.Table <> Неопределено Тогда
		ВсегоСтрок = ПротоКонтент.Table.Items.Количество();
		УстановитьЗначениеXDTO(СодСч, "ВсегоНаим", XML_ФорматЧисла(ВсегоСтрок, 0));
	КонецЕсли;
	
	Если ПротоКонтент.Seller <> Неопределено
		И ЗначениеЗаполнено(ПротоКонтент.Seller.Type) Тогда
		СвПрод = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "СвПрод");
		XML_ФНС29_ЗаполнитьУчастникТип(СвПрод, ПротоКонтент.Seller, ИмяПакетаXDTO);
	КонецЕсли;
	
	Если ПротоКонтент.Buyer <> Неопределено
		И ЗначениеЗаполнено(ПротоКонтент.Buyer.Type) Тогда
		СвПокуп = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "СвПокуп");
		XML_ФНС29_ЗаполнитьУчастникТип(СвПокуп, ПротоКонтент.Buyer, ИмяПакетаXDTO);
	КонецЕсли;
	
	Если ПротоКонтент.MoneyRecipient <> Неопределено
		И ЗначениеЗаполнено(ПротоКонтент.MoneyRecipient.Type) Тогда
		ПолучДнСр = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ПолучДнСр");
		XML_ФНС29_ЗаполнитьУчастникТип(ПолучДнСр, ПротоКонтент.MoneyRecipient, ИмяПакетаXDTO);
	КонецЕсли;
	
	Если ПротоКонтент.Payer <> Неопределено
		И ЗначениеЗаполнено(ПротоКонтент.Payer.Type) Тогда
		СвПлат = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "СвПлат");
		XML_ФНС29_ЗаполнитьУчастникТип(СвПлат, ПротоКонтент.Payer, ИмяПакетаXDTO);
	КонецЕсли;
	
	Если ПротоКонтент.Shipper <> Неопределено
		И ЗначениеЗаполнено(ПротоКонтент.Shipper.Type) Тогда
		ГрузОт = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ГрузОт");
		XML_ФНС29_ЗаполнитьУчастникТип(ГрузОт, ПротоКонтент.Shipper, ИмяПакетаXDTO);
	КонецЕсли;
	
	Если ПротоКонтент.Consignee <> Неопределено
		И ЗначениеЗаполнено(ПротоКонтент.Consignee.Type) Тогда
		ГрузПолуч = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ГрузПолуч");
		XML_ФНС29_ЗаполнитьУчастникТип(ГрузПолуч, ПротоКонтент.Consignee, ИмяПакетаXDTO);
	КонецЕсли;
	
	Для Каждого ProformaInvoiceBase Из ПротоКонтент.ProformaInvoiceBases Цикл
		Основание = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "Основание");
		XML_ФНС29_ЗаполнитьОснование(Основание, ProformaInvoiceBase, Фабрика);
	КонецЦикла;
	
	Для Каждого CommitmentTypes Из ПротоКонтент.CommitmentTypes Цикл
		ВидОбяз = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ВидОбяз");
		УстановитьЗначениеXDTO(ВидОбяз, "КодВидОбяз", CommitmentTypes.CommitmentTypeCode);
		// BSLLS:Typo-off
		УстановитьЗначениеXDTO(ВидОбяз, "НаимВидОбязм", CommitmentTypes.CommitmentTypeName);
		// BSLLS:Spelling:on
	КонецЦикла;
	
	Если ТипЗнч(ПротоКонтент.ProformaInvoiceAdditionalInfo) = Тип("ОбъектXDTO")
		И ОбъектXDTOЗаполнен(ПротоКонтент.ProformaInvoiceAdditionalInfo) Тогда
		ДопСв = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ДопСв");
		XML_ФНС29_ЗаполнитьДопСв(ДопСв, ПротоКонтент.ProformaInvoiceAdditionalInfo, ИмяПакетаXDTO);
	КонецЕсли;
	
	XML_ФНС29_ЗаполнитьВсегоОпл(СодСч, ПротоКонтент.Table, Фабрика);
	XML_ФНС29_ЗаполнитьСведТовЦенПок(СодСч, ПротоКонтент.Table, ИмяПакетаXDTO, ПараметрыФормированияФайла);
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьУчастникТип(УчастникТип, СведенияОбУчастнике, ИмяПакетаXDTO)
	
	Если СведенияОбУчастнике = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(УчастникТип, "ОКПО", СведенияОбУчастнике.Okpo);
	УстановитьЗначениеXDTO(УчастникТип, "КодОПФ", СведенияОбУчастнике.Okopf);
	УстановитьЗначениеXDTO(УчастникТип, "ПолнНаимОПФ", СведенияОбУчастнике.FullNameOPF);
	УстановитьЗначениеXDTO(УчастникТип, "СтруктПодр", СведенияОбУчастнике.Department);
	УстановитьЗначениеXDTO(УчастникТип, "ИнфДляУчаст", СведенияОбУчастнике.AdditionalInfo);
	
	УстановитьЗначениеXDTO(УчастникТип, "СокрНаим", СведенияОбУчастнике.ShortOrgName);
	
	XML_ЗаполнитьИдСв(УчастникТип, СведенияОбУчастнике, ИмяПакетаXDTO);
	
	Если СведенияОбУчастнике.Address <> Неопределено Тогда
		XML_ЗаполнитьАдрес_970(ИмяПакетаXDTO, УчастникТип, СведенияОбУчастнике.Address);
	КонецЕсли;
	
	Если СведенияОбУчастнике.Phone.Количество() > 0
		Или СведенияОбУчастнике.Email.Количество() > 0
		Или ЗначениеЗаполнено(СведенияОбУчастнике.OtherContactInfo) Тогда
		
		XML_ЗаполнитьКонтактТип(УчастникТип, СведенияОбУчастнике, ИмяПакетаXDTO);
		
	КонецЕсли;

	XML_ФНС29_ЗаполнитьБанкРекв(УчастникТип, СведенияОбУчастнике, Фабрика);
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьДенИзм(ДенИзм, ПротоКонтент)
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ПротоКонтент.IsConventionalUnit Тогда
		
		УстановитьЗначениеXDTO(ДенИзм, "УЕ", "у.е.");
		УстановитьЗначениеXDTO(ДенИзм, "ОпрУЕ", ПротоКонтент.ConventionalUnitDefinition);
		
	ИначеЕсли ЗначениеЗаполнено(ПротоКонтент.Currency) Тогда
		
		УстановитьЗначениеXDTO(ДенИзм, "КодОКВ", ПротоКонтент.Currency);
		УстановитьЗначениеXDTO(ДенИзм, "КурсВал", ПротоКонтент.CurrencyRate);
		
		НаименованиеВалюты = НаименованиеВалюты(ПротоКонтент.Currency, Истина);
		Если ЗначениеЗаполнено(НаименованиеВалюты) Тогда
			УстановитьЗначениеXDTO(ДенИзм, "НаимОКВ", НаименованиеВалюты);
		КонецЕсли;
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьИнфПол(Документ, ДанныеИнфоПоля, ИмяПакетаXDTO)
	
	Для Каждого ДанныеПоля Из ДанныеИнфоПоля Цикл
		
		ИдИнфоПоля = ДанныеПоля.InfoFileId;
		ЗначенияИнфоПоля = ДанныеПоля.StructedAdditionalInfos;
		
		Если ЗначениеЗаполнено(ИдИнфоПоля)
			ИЛИ ЗначениеЗаполнено(ЗначенияИнфоПоля) Тогда
			
			Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
			ИнфПол = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ИнфПол");
			
			УстановитьЗначениеXDTO(ИнфПол, "ИдФайлИнфПол", ИдИнфоПоля);
			
			XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПол.ТекстИнф, ЗначенияИнфоПоля);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьБанкРекв(УчастникТип, СведенияОбУчастнике, Фабрика)
	
	Если Не ЗначениеЗаполнено(СведенияОбУчастнике.BankId)
		Или Не ЗначениеЗаполнено(СведенияОбУчастнике.BankAccountNumber)
		Или Не ЗначениеЗаполнено(СведенияОбУчастнике.CorrespondentAccount) Тогда
		Возврат;
	КонецЕсли;
	
	БанкРекв = НовыйДочернийОбъектXDTO(Фабрика, УчастникТип, "БанкРекв");
	
	УстановитьЗначениеXDTO(БанкРекв, "НомерСчета", СведенияОбУчастнике.BankAccountNumber);
	УстановитьЗначениеXDTO(БанкРекв, "НаимБанк", СведенияОбУчастнике.BankName);
	УстановитьЗначениеXDTO(БанкРекв, "ИННЮЛ", СведенияОбУчастнике.BankInn);
	УстановитьЗначениеXDTO(БанкРекв, "КПП", СведенияОбУчастнике.BankKpp);
	УстановитьЗначениеXDTO(БанкРекв, "БИК", СведенияОбУчастнике.BankId);
	УстановитьЗначениеXDTO(БанкРекв, "КорСчет", СведенияОбУчастнике.CorrespondentAccount);
	УстановитьЗначениеXDTO(БанкРекв, "SWIFTКод", СведенияОбУчастнике.SwiftCode);
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьОснование(Основание, СведенияОбОсновании, Фабрика)
	
	Если ЗначениеЗаполнено(СведенияОбОсновании.OtherBase) Тогда
		УстановитьЗначениеXDTO(Основание, "ОснИное", СведенияОбОсновании.OtherBase);
	Иначе
		ОснРеквДок = НовыйДочернийОбъектXDTO(Фабрика, Основание, "ОснРеквДок");
		XML_ФНС29_ЗаполнитьРеквДокТип(ОснРеквДок, СведенияОбОсновании.ProformaInvoiceBaseDocument, Фабрика);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьРеквДокТип(РеквДокТип, СведенияОДокументе, Фабрика)
	
	УстановитьЗначениеXDTO(РеквДокТип, "РеквНаимДок", СведенияОДокументе.DocumentName);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквНомерДок", СведенияОДокументе.DocumentNumber);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквДатаДок", Дата1С_в_ДатаXML(СведенияОДокументе.DocumentDate));
	
	УстановитьЗначениеXDTO(РеквДокТип, "РеквИдФайлДок", СведенияОДокументе.FileId);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквИдДок", СведенияОДокументе.Id);
	УстановитьЗначениеXDTO(РеквДокТип, "РИдСистХранД", СведенияОДокументе.SystemId);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквУРЛСистДок", СведенияОДокументе.SystemUrl);
	УстановитьЗначениеXDTO(РеквДокТип, "РеквДопСведДок", СведенияОДокументе.AdditionalInfo);
	
	Для Каждого IdentificationDetail Из СведенияОДокументе.IdentificationDetails Цикл
		
		РеквИдРекСост = НовыйДочернийОбъектXDTO(Фабрика, РеквДокТип, "РеквИдРекСост");
		
		Если ЭтоИННЮрЛица(IdentificationDetail.Inn) Тогда
			УстановитьЗначениеXDTO(РеквИдРекСост, "ИННЮЛ", IdentificationDetail.Inn);
		Иначе
			УстановитьЗначениеXDTO(РеквИдРекСост, "ИННФЛ", IdentificationDetail.Inn);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(РеквИдРекСост, "НаимОИВ", IdentificationDetail.ShortNameExecutiveAuthority);
		
		НаименованиеСтраны = НаименованиеСтраны(IdentificationDetail.Country);
		ВсеОбязательныеПоляДаннИноЗаполнены = ЗначениеЗаполнено(IdentificationDetail.Country)
			И ЗначениеЗаполнено(НаименованиеСтраны)
			И ЗначениеЗаполнено(IdentificationDetail.OrgName)
			И ЗначениеЗаполнено(IdentificationDetail.StatusId)
			И (ЗначениеЗаполнено(IdentificationDetail.LegalEntityId)
				ИЛИ ЗначениеЗаполнено(IdentificationDetail.OrganizationOrPersonInfo));
				
		Если ВсеОбязательныеПоляДаннИноЗаполнены Тогда
		
			ДаннИно = НовыйДочернийОбъектXDTO(Фабрика, РеквИдРекСост, "ДаннИно");
			
			НаименованиеСтраны = НаименованиеСтраны(IdentificationDetail.Country);
			
			УстановитьЗначениеXDTO(ДаннИно, "Наим", IdentificationDetail.OrgName);
			УстановитьЗначениеXDTO(ДаннИно, "КодСтр", IdentificationDetail.Country);
			УстановитьЗначениеXDTO(ДаннИно, "НаимСтран", НаименованиеСтраны);
			
			УстановитьЗначениеXDTO(ДаннИно, "Идентиф", IdentificationDetail.LegalEntityId);
			УстановитьЗначениеXDTO(ДаннИно, "ИныеСвед", IdentificationDetail.OrganizationOrPersonInfo);
			
			Если IdentificationDetail.StatusId = ТипУчастника_ФизическоеЛицо() Тогда
				ИдСтат = XML_ИностранныйГражданин();
			Иначе
				ИдСтат = XML_ИностраннаяОрганизация();
			КонецЕсли;
			
			УстановитьЗначениеXDTO(ДаннИно, "ИдСтат", ИдСтат);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьДопСв(ДопСв, ДопСведенияСчета, ИмяПакетаXDTO)
	
	УстановитьЗначениеXDTO(ДопСв, "НазнПл", ДопСведенияСчета.PaymentPurpose);
	УстановитьЗначениеXDTO(ДопСв, "УникИнф", ДопСведенияСчета.UniquePaymentInfo);
	УстановитьЗначениеXDTO(ДопСв, "СпособОпл", ДопСведенияСчета.PaymentMethod);
	
	Если ЗначениеЗаполнено(ДопСведенияСчета.StartShipmentDate) Тогда
		УстановитьЗначениеXDTO(ДопСв, "ДатаНачТов", Дата1С_в_ДатаXML(ДопСведенияСчета.StartShipmentDate));
	КонецЕсли;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ЗначениеЗаполнено(ДопСведенияСчета.DateRestriction) Тогда
		УстановитьЗначениеXDTO(ДопСв, "ОгранОпДат", Дата1С_в_ДатаXML(ДопСведенияСчета.DateRestriction));
	ИначеЕсли ЗначениеЗаполнено(ДопСведенияСчета.DateAndTimeRestriction) Тогда
		УстановитьЗначениеXDTO(ДопСв, "ОгранОпДатВр", XMLСтрока(ДопСведенияСчета.DateAndTimeRestriction));
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	Для Каждого PaymentTerm Из ДопСведенияСчета.PaymentTerms Цикл
		ДопСв.УслОпл.Добавить(PaymentTerm);
	КонецЦикла;
	
	Для Каждого ShipmentTerm Из ДопСведенияСчета.ShipmentTerms Цикл
		ДопСв.УслОказПост.Добавить(ShipmentTerm);
	КонецЦикла;
	
	XML_ФНС29_ЗаполнитьИнфПол(ДопСв, ДопСведенияСчета.AdditionalInfoId, ИмяПакетаXDTO);
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьВсегоОпл(СодСч, ТабличныеДанные, Фабрика)
	
	Если ТабличныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВсегоОпл = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "ВсегоОпл");
	
	УстановитьЗначениеXDTO(ВсегоОпл, "СтТовБезНДСВсего", ТабличныеДанные.TotalWithVatExcluded);
	УстановитьЗначениеXDTO(ВсегоОпл, "СтТовУчНалВсего", ТабличныеДанные.Total);
	УстановитьЗначениеXDTO(ВсегоОпл, "СумСкиВсего", ТабличныеДанные.TotalDiscountSum);

	СумНалВсего = НовыйДочернийОбъектXDTO(Фабрика, ВсегоОпл, "СумНалВсего");
	
	БезНДС = (ТабличныеДанные.WithoutVat = "true");
	XML_ЗаполнитьСумНал(СумНалВсего, ТабличныеДанные.Vat, БезНДС);
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьСведТовЦенПок(СодСч, ТабличныеДанные, ИмяПакетаXDTO, ПараметрыФормированияФайла)

	Если ТабличныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Фабрика	= XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ТочностьЦены = ПараметрыФормированияФайла.ТочностьЦены;
	
	НомерСтроки = 1;
	Для Каждого Item Из ТабличныеДанные.Items Цикл
		
		СведТовЦенПок = НовыйДочернийОбъектXDTO(Фабрика, СодСч, "СведТовЦенПок");
		
		УстановитьЗначениеXDTO(СведТовЦенПок, "НомСтр", НомерСтроки);
		УстановитьЗначениеXDTO(СведТовЦенПок, "НаимТов", Item.Product);
		
		Если ЗначениеЗаполнено(Item.Quantity) Тогда
			Количество = Окр(Item.Quantity, ПараметрыФормированияФайла.ТочностьКоличества);
			УстановитьЗначениеXDTO(СведТовЦенПок, "КолТов", Количество);
		КонецЕсли;
		
		XML_ФНС29_ЗаполнитьЦену(СведТовЦенПок, "ЦенаТов", Item.Price, ТочностьЦены);
		XML_ФНС29_ЗаполнитьЦену(СведТовЦенПок, "ЦенаТовБезСки", Item.PriceWithoutDiscount, ТочностьЦены);
		
		УстановитьЗначениеXDTO(СведТовЦенПок, "ОКЕИТов", Item.Unit);
		УстановитьЗначениеXDTO(СведТовЦенПок, "НаимЕдИзм", Item.UnitName);
		
		УстановитьЗначениеXDTO(СведТовЦенПок, "СтТовБезНДС", Item.SubtotalWithVatExcluded);
		УстановитьЗначениеXDTO(СведТовЦенПок, "СтТовБезНДССки", Item.SubtotalWithoutVatAndDiscount);
		УстановитьЗначениеXDTO(СведТовЦенПок, "СтТовУчНал", Item.Subtotal);
		УстановитьЗначениеXDTO(СведТовЦенПок, "СтТовУчНалБезСки", Item.SubtotalWithoutDiscount);

		БезНДС = TaxRate_ЭтоЗначениеБезНДС(Item.TaxRate);
		
		Если ЗначениеЗаполнено(Item.OtherTaxRate) Тогда
			УстановитьЗначениеXDTO(СведТовЦенПок, "НалСтИн", Item.OtherTaxRate);
		Иначе
			УстановитьЗначениеXDTO(СведТовЦенПок, "НалСт", НалСт_Из_TaxRate(Item.TaxRate));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Item.DiscountSum) Тогда
			УстановитьЗначениеXDTO(СведТовЦенПок, "СумСки", Item.DiscountSum);
		Иначе
			УстановитьЗначениеXDTO(СведТовЦенПок, "ПроцентСки", Item.DiscountPercent);
		КонецЕсли;

		СумНал = НовыйДочернийОбъектXDTO(Фабрика, СведТовЦенПок, "СумНал");
		XML_ЗаполнитьСумНал(СумНал, Item.Vat, БезНДС);
		
		СуммаНДСБезСкидки = Привести_К_Числу(Item.VatWithoutDiscount);
		СумНалБезСки = НовыйДочернийОбъектXDTO(Фабрика, СведТовЦенПок, "СумНалБезСки");
		XML_ЗаполнитьСумНал(СумНалБезСки, СуммаНДСБезСкидки, БезНДС);
		
		ДопСведТов = НовыйДочернийОбъектXDTO(Фабрика, СведТовЦенПок, "ДопСведТов");
		XML_ФНС29_ЗаполнитьДопСведТов(ДопСведТов, Item, Фабрика);
		
		XML_ФНС29_ЗаполнитьИнфПол(СведТовЦенПок, Item.AdditionalInfoId, ИмяПакетаXDTO);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьЦену(СведТовЦенПок, ИмяСвойства, Цена, Точность)
	
	Если ЗначениеЗаполнено(Цена) Тогда
		
		Если Точность = Неопределено Тогда
			
			ТочностьПоУмолчанию = XML_ПараметрыФормированияФайла().ТочностьЦены;
			
			ЦенаПоУмолчанию = Окр(Цена, ТочностьПоУмолчанию);
			
			Если Число(ЦенаПоУмолчанию) = Цена Тогда
				УстановитьЗначениеXDTO(СведТовЦенПок, ИмяСвойства, ЦенаПоУмолчанию);
			Иначе
				УстановитьЗначениеXDTO(СведТовЦенПок, ИмяСвойства, Окр(Цена, Точность));
			КонецЕсли;
			
		Иначе
			УстановитьЗначениеXDTO(СведТовЦенПок, ИмяСвойства, Окр(Цена, Точность));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ФНС29_ЗаполнитьДопСведТов(ДопСведТов, Item, Фабрика)
	
	ПрТовРаб = XML_ПолучитьПризнакНоменклатуры(Item.ItemMark);
	УстановитьЗначениеXDTO(ДопСведТов, "ПрТовРаб", ПрТовРаб);
	
	УстановитьЗначениеXDTO(ДопСведТов, "ДопПризн", Item.AdditionalProperty);
	УстановитьЗначениеXDTO(ДопСведТов, "КодТов", Item.ItemVendorCode);
	УстановитьЗначениеXDTO(ДопСведТов, "КодПроисх", Item.Country);
	УстановитьЗначениеXDTO(ДопСведТов, "ХарактерТов", Item.ItemCharact);
	УстановитьЗначениеXDTO(ДопСведТов, "АртикулТов", Item.ItemArticle);
	УстановитьЗначениеXDTO(ДопСведТов, "СортТов", Item.ItemKind);
	УстановитьЗначениеXDTO(ДопСведТов, "СерияТов", Item.ItemSeries);
	УстановитьЗначениеXDTO(ДопСведТов, "КодКат", Item.CatalogCode);
	УстановитьЗначениеXDTO(ДопСведТов, "КодВидТов", Item.ItemTypeCode);
	
	Если ЗначениеЗаполнено(Item.Country) Тогда
		СтранаПроисхождения = НаименованиеСтраны(Item.Country);
		УстановитьЗначениеXDTO(ДопСведТов, "КрНаимСтрПр", СтранаПроисхождения);
	КонецЕсли;
	
	Для Каждого StateSystemItemInfo Из Item.StateSystemItemInfos Цикл
		
		СвГосСист = НовыйДочернийОбъектXDTO(Фабрика, ДопСведТов, "СвГосСист");
		
		УстановитьЗначениеXDTO(СвГосСист, "НаимГосСист", StateSystemItemInfo.StateSystemName);
		УстановитьЗначениеXDTO(СвГосСист, "УчетЕд", StateSystemItemInfo.AccountingUnit);
		УстановитьЗначениеXDTO(СвГосСист, "ИнаяИнф", StateSystemItemInfo.OtherInfo);
		
		Для Каждого StateSystemId Из StateSystemItemInfo.StateSystemId Цикл
			СвГосСист.ИдНомУчетЕд.Добавить(StateSystemId);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// XML: функции заполнения УКД

Функция XML_УКД_ПолучитьФункцию(ContentFunction)
	
	СоответствиеФункций = Новый Соответствие;
	
	ФункцииУКД = Перечисление_ФункцииУКД();
	
	СоответствиеФункций.Вставить("InvoiceAndBasic", ФункцииУКД.КСЧФДИС);
	СоответствиеФункций.Вставить("Invoice", 		ФункцииУКД.КСЧФ);
	СоответствиеФункций.Вставить("Basic", 			ФункцииУКД.ДИС);
	
	ФункцияДокумента = СоответствиеФункций.Получить(ContentFunction);
	
	Если ФункцияДокумента = Неопределено Тогда
		ФункцияДокумента = ContentFunction;
	КонецЕсли;
	
	Возврат ФункцияДокумента;

КонецФункции

Функция Перечисление_ФункцииУКД()
	
	Результат = Новый Структура;
	
	Результат.Вставить("КСЧФДИС", 	"КСЧФДИС");
	Результат.Вставить("КСЧФ", 		"КСЧФ");
	Результат.Вставить("ДИС", 		"ДИС");
	
	Возврат Результат;

КонецФункции

Процедура XML_УКД_ЗаполнитьСведенияСФ(ИмяПакетаXDTO, Документ, Content)

	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	// Сведения о корректировочном счете-фактуре
	СвКСчФ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвКСчФ", ИмяПакетаXDTO);
	УстановитьЗначениеXDTO(СвКСчФ, "НомерКСчФ", Content.Number);
	УстановитьЗначениеXDTO(СвКСчФ, "ДатаКСчФ", Дата_В_Формат(Content.Date, ФорматДаты));
	УстановитьЗначениеXDTO(СвКСчФ, "КодОКВ", Content.Currency);
	
	// Корректируемые СФ
	
	Для Каждого InvoiceForCorrectionInfo Из Content.Invoices Цикл
		
		СчФ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвКСчФ.СчФ", ИмяПакетаXDTO);
		УстановитьЗначениеXDTO(СчФ, "НомерСчФ", InvoiceForCorrectionInfo.InvoiceNumber);
		УстановитьЗначениеXDTO(СчФ, "ДатаСчФ", Дата_В_Формат(InvoiceForCorrectionInfo.InvoiceDate, ФорматДаты));
		
		Для Каждого InvoiceRevisionInfo Из InvoiceForCorrectionInfo.InvoiceRevisions Цикл
			
			ИспрСчФ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвКСчФ.СчФ.ИспрСчФ", ИмяПакетаXDTO);
			УстановитьЗначениеXDTO(ИспрСчФ, "НомИспрСчФ", InvoiceRevisionInfo.RevisionNumber);
			УстановитьЗначениеXDTO(ИспрСчФ, "ДатаИспрСчФ", Дата_В_Формат(InvoiceRevisionInfo.RevisionDate, ФорматДаты));
			СчФ.ИспрСчФ.Добавить(ИспрСчФ);
			
		КонецЦикла;		
		
		СвКСчФ.СчФ.Добавить(СчФ);
		
	КонецЦикла;
	
	// Исправление УКД
	
	Если ЗначениеЗаполнено(Content.RevisionNumber) И ЗначениеЗаполнено(Content.RevisionDate) Тогда
		
		ИспрКСчФ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвКСчФ.ИспрКСчФ", ИмяПакетаXDTO);		
		УстановитьЗначениеXDTO(ИспрКСчФ, "НомИспрКСчФ", Content.RevisionNumber);
		УстановитьЗначениеXDTO(ИспрКСчФ, "ДатаИспрКСчФ", Дата_В_Формат(Content.RevisionDate, ФорматДаты));		
		УстановитьЗначениеXDTO(СвКСчФ, "ИспрКСчФ", ИспрКСчФ);
		
	КонецЕсли;
	
	// Продавец
	СвПрод = XML_ПолучитьПустойОбъектXDTO("СвПродПокТип", ИмяПакетаXDTO);	
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, СвПрод, Content.Seller);
	УстановитьЗначениеXDTO(СвКСчФ, "СвПрод", СвПрод);
	
	// Покупатель
	СвПокуп = XML_ПолучитьПустойОбъектXDTO("СвПродПокТип", ИмяПакетаXDTO);
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, СвПокуп, Content.Buyer);
	УстановитьЗначениеXDTO(СвКСчФ, "СвПокуп", СвПокуп);
	
	// Дополнительные сведения об участниках факта хозяйственной жизни, основаниях и обстоятельствах его проведения
	ДопСвФХЖ1 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвКСчФ.ДопСвФХЖ1", ИмяПакетаXDTO);
	УстановитьЗначениеXDTO(ДопСвФХЖ1, "ИдГосКон", Content.GovernmentContractInfo);
	УстановитьЗначениеXDTO(ДопСвФХЖ1, "НаимОКВ", НаименованиеВалюты(Content.Currency, Истина));
	УстановитьЗначениеXDTO(ДопСвФХЖ1, "КурсВал", Content.CurrencyRate);
	УстановитьЗначениеXDTO(СвКСчФ, "ДопСвФХЖ1", ДопСвФХЖ1);
	
	// Информационное поле - 1
	Если ЗначениеЗаполнено(Content.AdditionalInfoId.InfoFileId) ИЛИ Content.AdditionalInfoId.StructedAdditionalInfos.Количество() > 0 Тогда
		
		ИнфПолФХЖ1 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвКСчФ.ИнфПолФХЖ1", ИмяПакетаXDTO);
		УстановитьЗначениеXDTO(ИнфПолФХЖ1, "ИдФайлИнфПол", Content.AdditionalInfoId.InfoFileId);
		XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПолФХЖ1.ТекстИнф, Content.AdditionalInfoId.StructedAdditionalInfos);
		УстановитьЗначениеXDTO(СвКСчФ, "ИнфПолФХЖ1", ИнфПолФХЖ1);
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Документ, "СвКСчФ", СвКСчФ);
	
КонецПроцедуры

Процедура XML_УКД_ЗаполнитьСведенияТаблицыСФ(ИмяПакетаXDTO, Документ, Content, ПараметрыФормированияФайла)
	
	// Таблица счета-фактуры
	Если Content.InvoiceCorrectionTable.Items.Количество() > 0 Тогда
		
		ТаблКСчФ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ", ИмяПакетаXDTO);
		
		ВсеСтрокиБезНДСДо = Истина;
		ВсеСтрокиБезНДСПосле = Истина;
		НомерСтроки = 1;
		
		Для Каждого ExtendedInvoiceCorrectionItem Из Content.InvoiceCorrectionTable.Items Цикл
						
			СведТов = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.СведТов", ИмяПакетаXDTO);
			УстановитьЗначениеXDTO(СведТов, "НомСтр", НомерСтроки);			
			XML_УКД_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СведТов, ExtendedInvoiceCorrectionItem, ВсеСтрокиБезНДСДо, ВсеСтрокиБезНДСПосле, ПараметрыФормированияФайла);
			
			ТаблКСчФ.СведТов.Добавить(СведТов);
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		// Всего увеличение
		Если Content.InvoiceCorrectionTable.TotalsInc.Total <> Неопределено Тогда
			
			ВсегоУвел = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.ВсегоУвел", ИмяПакетаXDTO);
			
			УстановитьЗначениеXDTO(ВсегоУвел, "СтТовБезНДСВсего", 	XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded, 2));
			УстановитьЗначениеXDTO(ВсегоУвел, "СтТовУчНалВсего", 	XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsInc.Total, 2));
			
			СумНал = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
			
			Если ВсеСтрокиБезНДСДо Тогда
				УстановитьЗначениеXDTO(СумНал, "БезНДС", СтрокаБезНДС());
			Иначе			
				УстановитьЗначениеXDTO(СумНал, "СумНДС", XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsInc.Vat, 2));
			КонецЕсли;
			
			УстановитьЗначениеXDTO(ВсегоУвел, "СумНал", СумНал);		
			УстановитьЗначениеXDTO(ТаблКСчФ, "ВсегоУвел", ВсегоУвел);
			
		КонецЕсли;
		
		// Всего уменьшение
		Если Content.InvoiceCorrectionTable.TotalsDec.Total <> Неопределено Тогда
			
			ВсегоУм = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.ВсегоУм", ИмяПакетаXDTO);
			
			УстановитьЗначениеXDTO(ВсегоУм, "СтТовБезНДСВсего", XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded, 2));
			УстановитьЗначениеXDTO(ВсегоУм, "СтТовУчНалВсего", 	XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsDec.Total, 2));
			
			СумНал = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
			
			Если ВсеСтрокиБезНДСДо Тогда
				УстановитьЗначениеXDTO(СумНал, "БезНДС", СтрокаБезНДС());
			Иначе			
				УстановитьЗначениеXDTO(СумНал, "СумНДС", XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsDec.Vat, 2));
			КонецЕсли;
			
			УстановитьЗначениеXDTO(ВсегоУм, "СумНал", СумНал);		
			УстановитьЗначениеXDTO(ТаблКСчФ, "ВсегоУм", ВсегоУм);
			
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Документ, "ТаблКСчФ", ТаблКСчФ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УКД_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, Документ, Content)		

	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	// Информационное поле - 3 (сведения о факте согласования)
	СодФХЖ3 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СодФХЖ3", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СодФХЖ3, "ИныеСвИзмСтоим",	Content.EventContent.CostChangeInfo);
	УстановитьЗначениеXDTO(СодФХЖ3, "ПередатДокум", 	Content.EventContent.TransferDocDetails );
	УстановитьЗначениеXDTO(СодФХЖ3, "СодОпер", 			Content.EventContent.OperationContent);
	УстановитьЗначениеXDTO(СодФХЖ3, "ДатаНапр", 		Дата_В_Формат(Content.EventContent.NotificationDate, ФорматДаты));
	
	// Основание корректировки
	Для Каждого CorrectionBase Из Content.EventContent.CorrectionBases Цикл
		
		ОснКор = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СодФХЖ3.ОснКор", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(ОснКор, "НаимОсн",	CorrectionBase.BaseDocumentName);
		УстановитьЗначениеXDTO(ОснКор, "НомОсн",	CorrectionBase.BaseDocumentNumber);
		УстановитьЗначениеXDTO(ОснКор, "ДатаОсн",	Дата_В_Формат(CorrectionBase.BaseDocumentDate, ФорматДаты));
		УстановитьЗначениеXDTO(ОснКор, "ДопСвОсн",	CorrectionBase.AdditionalInfo);
		
		СодФХЖ3.ОснКор.Добавить(ОснКор);
	
	КонецЦикла;
		
	УстановитьЗначениеXDTO(Документ, "СодФХЖ3", СодФХЖ3);
	
КонецПроцедуры

Процедура XML_УКД_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СведТов, ExtendedInvoiceCorrectionItem, ВсеСтрокиБезНДСДо, ВсеСтрокиБезНДСПосле, ПараметрыФормированияФайла)

	УстановитьЗначениеXDTO(СведТов, "НаимТов", 		ExtendedInvoiceCorrectionItem.Product);			
	УстановитьЗначениеXDTO(СведТов, "ОКЕИ_ТовДо", 	ExtendedInvoiceCorrectionItem.OriginalValues.UnitCode);
	УстановитьЗначениеXDTO(СведТов, "ОКЕИ_ТовПосле", ExtendedInvoiceCorrectionItem.CorrectedValues.UnitCode);
	
	УстановитьЗначениеXDTO(СведТов, "КолТовДо", 	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.OriginalValues.Quantity,	ПараметрыФормированияФайла.ТочностьКоличества));
	УстановитьЗначениеXDTO(СведТов, "КолТовПосле", 	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.CorrectedValues.Quantity,	ПараметрыФормированияФайла.ТочностьКоличества));
	УстановитьЗначениеXDTO(СведТов, "ЦенаТовДо", 	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.OriginalValues.Price,		ПараметрыФормированияФайла.ТочностьЦены));
	УстановитьЗначениеXDTO(СведТов, "ЦенаТовПосле", XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.CorrectedValues.Price,	ПараметрыФормированияФайла.ТочностьЦены));
	
	УстановитьЗначениеXDTO(СведТов, "НалСтДо", 		НалСт_Из_TaxRate(ExtendedInvoiceCorrectionItem.OriginalValues.TaxRate));
	УстановитьЗначениеXDTO(СведТов, "НалСтПосле", 	НалСт_Из_TaxRate(ExtendedInvoiceCorrectionItem.CorrectedValues.TaxRate));
	
	// - Стоимость без учета НДС
	
	СтТовБезНДС = XML_ПолучитьПустойОбъектXDTO("СтоимТип", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимДоИзм", 		XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.OriginalValues.TotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимПослеИзм",	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.CorrectedValues.TotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимУвел", 		XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsInc.TotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимУм", 			XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsDec.TotalWithVatExcluded, 2));
	
	УстановитьЗначениеXDTO(СведТов, "СтТовБезНДС", СтТовБезНДС);
	
	// - Акциз
	
	АкцизДо = XML_ПолучитьПустойОбъектXDTO("СумАкцизТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.OriginalValues.Excise) ИЛИ Число(ExtendedInvoiceCorrectionItem.OriginalValues.Excise) = 0 Тогда
		УстановитьЗначениеXDTO(АкцизДо, "БезАкциз", "без акциза");
	Иначе
		УстановитьЗначениеXDTO(АкцизДо, "СумАкциз", XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.OriginalValues.Excise, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "АкцизДо", АкцизДо);
	
	АкцизПосле = XML_ПолучитьПустойОбъектXDTO("СумАкцизТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.CorrectedValues.Excise) ИЛИ Число(ExtendedInvoiceCorrectionItem.CorrectedValues.Excise) = 0 Тогда
		УстановитьЗначениеXDTO(АкцизПосле, "БезАкциз", "без акциза");
	Иначе
		УстановитьЗначениеXDTO(АкцизПосле, "СумАкциз", XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.CorrectedValues.Excise, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "АкцизПосле", АкцизПосле);
	
	АкцизРазн = XML_ПолучитьПустойОбъектXDTO("РазнСумНалТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsInc.Excise) 
		И НЕ ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsDec.Excise) Тогда
		УстановитьЗначениеXDTO(АкцизРазн, "СумУвел",	XML_ФорматЧисла(0, 2));
		
	ИначеЕсли ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsInc.Excise) Тогда
		УстановитьЗначениеXDTO(АкцизРазн, "СумУвел",	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsInc.Excise, 2));
		
	ИначеЕсли ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsDec.Excise) Тогда
		УстановитьЗначениеXDTO(АкцизРазн, "СумУм",		XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsDec.Excise, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "АкцизРазн", АкцизРазн);
	
	// - Сумма НДС
	
	СумНалДо = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
	
	Если TaxRate_ЭтоЗначениеБезНДС(ExtendedInvoiceCorrectionItem.OriginalValues.TaxRate) Тогда
		УстановитьЗначениеXDTO(СумНалДо, "БезНДС", СтрокаБезНДС());
	Иначе
		ВсеСтрокиБезНДСДо = Ложь;
		УстановитьЗначениеXDTO(СумНалДо, "СумНДС", XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.OriginalValues.Vat, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "СумНалДо", СумНалДо);
	
	
	СумНалПосле = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
	
	Если TaxRate_ЭтоЗначениеБезНДС(ExtendedInvoiceCorrectionItem.CorrectedValues.TaxRate) Тогда
		УстановитьЗначениеXDTO(СумНалПосле, "БезНДС", СтрокаБезНДС());
	Иначе
		ВсеСтрокиБезНДСПосле = Ложь;
		УстановитьЗначениеXDTO(СумНалПосле, "СумНДС", XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.CorrectedValues.Vat, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "СумНалПосле", СумНалПосле);
	
	СумНалРазн = XML_ПолучитьПустойОбъектXDTO("РазнСумНалТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsInc.Vat) 
		И НЕ ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsDec.Vat) Тогда
		УстановитьЗначениеXDTO(СумНалРазн, "СумУвел",	XML_ФорматЧисла(0, 2));
		
	ИначеЕсли ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsInc.Vat) Тогда
		УстановитьЗначениеXDTO(СумНалРазн, "СумУвел",	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsInc.Vat, 2));
		
	ИначеЕсли ЗначениеЗаполнено(ExtendedInvoiceCorrectionItem.AmountsDec.Vat) Тогда
		УстановитьЗначениеXDTO(СумНалРазн, "СумУм", 	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsDec.Vat, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "СумНалРазн", СумНалРазн);
	
	// - Стоимость с учетом НДС
	
	СтТовУчНал = XML_ПолучитьПустойОбъектXDTO("СтоимТип", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимДоИзм", 	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.OriginalValues.Total, 2));
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимПослеИзм",	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.CorrectedValues.Total, 2));
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимУвел", 	XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsInc.Total, 2));
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимУм", 		XML_ФорматЧисла(ExtendedInvoiceCorrectionItem.AmountsDec.Total, 2));
	
	УстановитьЗначениеXDTO(СведТов, "СтТовУчНал", СтТовУчНал);
	
	// - Информационное поле события (факта хозяйственной жизни) 2
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СведТов.ИнфПолФХЖ2, ExtendedInvoiceCorrectionItem.StructedAdditionalInfos, "Файл.Документ.ТаблКСчФ.СведТов.ИнфПолФХЖ2");
	
	// - Доп. сведения
	
	ДопСведТов = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.СведТов.ДопСведТов", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ДопСведТов, "КорСчДебет", ExtendedInvoiceCorrectionItem.ItemAccountDebit);
	УстановитьЗначениеXDTO(ДопСведТов, "КорСчКредит", ExtendedInvoiceCorrectionItem.ItemAccountCredit);
	
	УстановитьЗначениеXDTO(СведТов, "ДопСведТов", ДопСведТов);
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_УКД_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO
	, СодФХЖ4
	, ПротоКонтент
	, НаименованиеДокумента
	, ФункцияДокумента
	, НомерДокумента
	, ДатаДокумента)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	УстановитьЗначениеXDTO(СодФХЖ4, "ФункцияПр"		, ФункцияДокумента);
	УстановитьЗначениеXDTO(СодФХЖ4, "НаимДокОпрПр"	, НаименованиеДокумента);
	УстановитьЗначениеXDTO(СодФХЖ4, "ДатаДокИнфПр"	, Дата_В_Формат(ДатаДокумента, ФорматДаты));
	СодФХЖ4.НомДокИнфПр = НомерДокумента;
	
	// Сведения о согласовании изменения стоимости
	СвСоглас = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ4, "СвСоглас");
	УстановитьЗначениеXDTO(СвСоглас, "СодОпер"		, ПротоКонтент.OperationContent);
	УстановитьЗначениеXDTO(СвСоглас, "ДатаСоглас"	, Дата_В_Формат(ПротоКонтент.AcceptanceDate, ФорматДаты));
	
	XML_ЗаполнитьИнфоПоляФХЖ(ИмяПакетаXDTO, СодФХЖ4, ПротоКонтент.AdditionalInfoId, "ИнфПолФХЖ4");
	
КонецПроцедуры

Функция XML_УКД_736_ДопПрефиксИмениФайла(ПротоКонтент)
	
	Результат = "";
	
	Для Каждого Item Из ПротоКонтент.InvoiceCorrectionTable.Items Цикл
		
		Если Item.OriginalItemIdentificationNumbers.Количество() > 0
			Или Item.CorrectedItemIdentificationNumbers.Количество() > 0 Тогда
			
			Результат = "MARK";
			Прервать;
			
		ИначеЕсли Item.ItemTracingInfos.Количество() > 0 Тогда
			
			Результат = "PROS";
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_УКД_736_ЗаполнитьСведенияСФ(ИмяПакетаXDTO, Документ, Content)

	XML_УКД_ЗаполнитьСведенияСФ(ИмяПакетаXDTO, Документ, Content);
	
КонецПроцедуры

Процедура XML_УКД_736_ЗаполнитьСведенияТаблицыСФ(ИмяПакетаXDTO, Документ, Content, ПараметрыФормированияФайла)
	
	// Таблица счета-фактуры
	Если Content.InvoiceCorrectionTable.Items.Количество() > 0 Тогда
		
		ТаблКСчФ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ", ИмяПакетаXDTO);
		
		НомерСтроки = 1;
		
		Для Каждого ExtendedInvoiceCorrectionItem Из Content.InvoiceCorrectionTable.Items Цикл
			
			СведТов = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.СведТов", ИмяПакетаXDTO);
			УстановитьЗначениеXDTO(СведТов, "НомСтр", НомерСтроки);
			XML_УКД_736_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СведТов, ExtendedInvoiceCorrectionItem, ПараметрыФормированияФайла);
			
			ТаблКСчФ.СведТов.Добавить(СведТов);
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		// Всего увеличение
		Если Content.InvoiceCorrectionTable.TotalsInc.Total <> Неопределено Тогда
			
			ВсегоУвел = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.ВсегоУвел", ИмяПакетаXDTO);
			
			УстановитьЗначениеXDTO(ВсегоУвел, "СтТовБезНДСВсего", 	XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded, 2));
			УстановитьЗначениеXDTO(ВсегоУвел, "СтТовУчНалВсего", 	XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsInc.Total, 2));
			
			СумНал = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
			
			Если ЭтоИстина(Content.InvoiceCorrectionTable.TotalsInc.WithoutVat) Тогда
				УстановитьЗначениеXDTO(СумНал, "БезНДС", СтрокаБезНДС());
			Иначе			
				УстановитьЗначениеXDTO(СумНал, "СумНДС", XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsInc.Vat, 2));
			КонецЕсли;
			
			УстановитьЗначениеXDTO(ВсегоУвел, "СумНал", СумНал);
			УстановитьЗначениеXDTO(ТаблКСчФ, "ВсегоУвел", ВсегоУвел);
			
		КонецЕсли;
		
		// Всего уменьшение
		Если Content.InvoiceCorrectionTable.TotalsDec.Total <> Неопределено Тогда
			
			ВсегоУм = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.ВсегоУм", ИмяПакетаXDTO);
			
			УстановитьЗначениеXDTO(ВсегоУм, "СтТовБезНДСВсего", XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded, 2));
			УстановитьЗначениеXDTO(ВсегоУм, "СтТовУчНалВсего", 	XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsDec.Total, 2));
			
			СумНал = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
			
			Если ЭтоИстина(Content.InvoiceCorrectionTable.TotalsDec.WithoutVat) Тогда
				УстановитьЗначениеXDTO(СумНал, "БезНДС", СтрокаБезНДС());
			Иначе			
				УстановитьЗначениеXDTO(СумНал, "СумНДС", XML_ФорматЧисла(Content.InvoiceCorrectionTable.TotalsDec.Vat, 2));
			КонецЕсли;
			
			УстановитьЗначениеXDTO(ВсегоУм, "СумНал", СумНал);
			УстановитьЗначениеXDTO(ТаблКСчФ, "ВсегоУм", ВсегоУм);
			
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Документ, "ТаблКСчФ", ТаблКСчФ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УКД_736_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СведТов, Item, ПараметрыФормированияФайла)

	УстановитьЗначениеXDTO(СведТов, "НаимТов", 		Item.Product);
	УстановитьЗначениеXDTO(СведТов, "ОКЕИ_ТовДо", 	Item.OriginalValues.UnitCode);
	УстановитьЗначениеXDTO(СведТов, "ОКЕИ_ТовПосле", Item.CorrectedValues.UnitCode);
	
	УстановитьЗначениеXDTO(СведТов, "КолТовДо", 	XML_ФорматЧисла(Item.OriginalValues.Quantity,	ПараметрыФормированияФайла.ТочностьКоличества));
	УстановитьЗначениеXDTO(СведТов, "КолТовПосле", 	XML_ФорматЧисла(Item.CorrectedValues.Quantity,	ПараметрыФормированияФайла.ТочностьКоличества));
	УстановитьЗначениеXDTO(СведТов, "ЦенаТовДо", 	XML_ФорматЧисла(Item.OriginalValues.Price,		ПараметрыФормированияФайла.ТочностьЦены));
	УстановитьЗначениеXDTO(СведТов, "ЦенаТовПосле", XML_ФорматЧисла(Item.CorrectedValues.Price,		ПараметрыФормированияФайла.ТочностьЦены));
	
	УстановитьЗначениеXDTO(СведТов, "НалСтДо", 		НалСт_Из_TaxRate(Item.OriginalValues.TaxRate));
	УстановитьЗначениеXDTO(СведТов, "НалСтПосле", 	НалСт_Из_TaxRate(Item.CorrectedValues.TaxRate));
	УстановитьЗначениеXDTO(СведТов, "ПорНомТовВСЧФ", Item.OriginalNumber);
	
	// - Стоимость без учета НДС
	
	СтТовБезНДС = XML_ПолучитьПустойОбъектXDTO("СтоимТип", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимДоИзм", 	XML_ФорматЧисла(Item.OriginalValues.TotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимПослеИзм", XML_ФорматЧисла(Item.CorrectedValues.TotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимУвел", 	XML_ФорматЧисла(Item.AmountsInc.TotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СтТовБезНДС, "СтоимУм", 		XML_ФорматЧисла(Item.AmountsDec.TotalWithVatExcluded, 2));
	
	УстановитьЗначениеXDTO(СведТов, "СтТовБезНДС", СтТовБезНДС);
	
	// - Акциз
	
	АкцизДо = XML_ПолучитьПустойОбъектXDTO("СумАкцизТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(Item.OriginalValues.Excise) Тогда
		УстановитьЗначениеXDTO(АкцизДо, "БезАкциз", "без акциза");
	Иначе
		УстановитьЗначениеXDTO(АкцизДо, "СумАкциз", XML_ФорматЧисла(Item.OriginalValues.Excise, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "АкцизДо", АкцизДо);
	
	АкцизПосле = XML_ПолучитьПустойОбъектXDTO("СумАкцизТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(Item.CorrectedValues.Excise) Тогда
		УстановитьЗначениеXDTO(АкцизПосле, "БезАкциз", "без акциза");
	Иначе
		УстановитьЗначениеXDTO(АкцизПосле, "СумАкциз", XML_ФорматЧисла(Item.CorrectedValues.Excise, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "АкцизПосле", АкцизПосле);
	
	Если Привести_К_Числу(Item.AmountsInc.Excise) > 0 Или Привести_К_Числу(Item.AmountsDec.Excise) > 0 Тогда
		
		АкцизРазн = XML_ПолучитьПустойОбъектXDTO("РазнСумНалТип", ИмяПакетаXDTO);
		
		Если Привести_К_Числу(Item.AmountsInc.Excise) > 0 Тогда
			УстановитьЗначениеXDTO(АкцизРазн, "СумУвел",	XML_ФорматЧисла(Item.AmountsInc.Excise, 2));
			
		ИначеЕсли Привести_К_Числу(Item.AmountsDec.Excise) > 0 Тогда
			УстановитьЗначениеXDTO(АкцизРазн, "СумУм",		XML_ФорматЧисла(Item.AmountsDec.Excise, 2));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(СведТов, "АкцизРазн", АкцизРазн);
		
	КонецЕсли;
	
	// - Сумма НДС
	
	СумНалДо = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
	
	Если ЭтоИстина(Item.OriginalValues.WithoutVat) Тогда
		УстановитьЗначениеXDTO(СумНалДо, "БезНДС", СтрокаБезНДС());
	Иначе
		УстановитьЗначениеXDTO(СумНалДо, "СумНДС", XML_ФорматЧисла(Item.OriginalValues.Vat, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "СумНалДо", СумНалДо);
	
	СумНалПосле = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
	
	Если ЭтоИстина(Item.CorrectedValues.WithoutVat) Тогда
		УстановитьЗначениеXDTO(СумНалПосле, "БезНДС", СтрокаБезНДС());
	Иначе
		УстановитьЗначениеXDTO(СумНалПосле, "СумНДС", XML_ФорматЧисла(Item.CorrectedValues.Vat, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "СумНалПосле", СумНалПосле);
	
	СтавкаНДС_ИсчНалАг = TaxRate_ЭтоЗначениеИсчНалАг(Item.OriginalValues.TaxRate);
	
	Если НЕ СтавкаНДС_ИсчНалАг Тогда
		
		// - Сумма НДС
		
		СумНалРазн = XML_ПолучитьПустойОбъектXDTO("РазнСумНалТип", ИмяПакетаXDTO);
		
		Если НЕ ЗначениеЗаполнено(Item.AmountsInc.Vat) 
			И НЕ ЗначениеЗаполнено(Item.AmountsDec.Vat) Тогда
			
			УстановитьЗначениеXDTO(СумНалРазн, "СумУвел",	XML_ФорматЧисла(0, 2));
			
		ИначеЕсли ЗначениеЗаполнено(Item.AmountsInc.Vat) Тогда
			УстановитьЗначениеXDTO(СумНалРазн, "СумУвел",	XML_ФорматЧисла(Item.AmountsInc.Vat, 2));
		ИначеЕсли ЗначениеЗаполнено(Item.AmountsDec.Vat) Тогда
			УстановитьЗначениеXDTO(СумНалРазн, "СумУм", 	XML_ФорматЧисла(Item.AmountsDec.Vat, 2));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(СведТов, "СумНалРазн", СумНалРазн);
		
	КонецЕсли;
	
	// - Стоимость с учетом НДС
	
	СтТовУчНал = XML_ПолучитьПустойОбъектXDTO("СтоимТип", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимДоИзм", 	XML_ФорматЧисла(Item.OriginalValues.Total, 2));
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимПослеИзм",	XML_ФорматЧисла(Item.CorrectedValues.Total, 2));
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимУвел", 	XML_ФорматЧисла(Item.AmountsInc.Total, 2));
	УстановитьЗначениеXDTO(СтТовУчНал, "СтоимУм", 		XML_ФорматЧисла(Item.AmountsDec.Total, 2));
	
	УстановитьЗначениеXDTO(СведТов, "СтТовУчНал", СтТовУчНал);
	
	// - Информационное поле события (факта хозяйственной жизни) 2
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СведТов.ИнфПолФХЖ2, Item.StructedAdditionalInfos, "Файл.Документ.ТаблКСчФ.СведТов.ИнфПолФХЖ2");
	
	// - Доп. сведения
	
	ДопСведТов = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.СведТов.ДопСведТов", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ДопСведТов, "АртикулТов", Item.ItemArticle);
	УстановитьЗначениеXDTO(ДопСведТов, "КодВидТов", Item.ItemTypeCode);
	УстановитьЗначениеXDTO(ДопСведТов, "КодТов", Item.ItemVendorCode);
	УстановитьЗначениеXDTO(ДопСведТов, "НаимЕдИзмДо", Item.OriginalValues.UnitName);
	УстановитьЗначениеXDTO(ДопСведТов, "НаимЕдИзмПосле", Item.CorrectedValues.UnitName);
	УстановитьЗначениеXDTO(ДопСведТов, "СортТов", Item.ItemKind);
	УстановитьЗначениеXDTO(ДопСведТов, "ХарактерТов", Item.ItemCharact);
	
	УстановитьЗначениеXDTO(СведТов, "ДопСведТов", ДопСведТов);
	
	// Сведения о маркировке
	Если ЗначениеЗаполнено(Item.OriginalItemIdentificationNumbers) Тогда
		XML_ЗаполнитьНомСредИдентТов(ИмяПакетаXDTO, СведТов, Item.OriginalItemIdentificationNumbers, "НомСредИдентТовДо");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Item.CorrectedItemIdentificationNumbers) Тогда
		XML_ЗаполнитьНомСредИдентТов(ИмяПакетаXDTO, СведТов, Item.CorrectedItemIdentificationNumbers, "НомСредИдентТовПосле");
	КонецЕсли;
	
	Если Item.ItemTracingInfos.Количество() > 0 Тогда
		XML_УКД_736_ЗаполнитьСведПрослеж(ИмяПакетаXDTO, СведТов.СведПрослеж, Item.ItemTracingInfos);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_УКД_736_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, Документ, Content)
	
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	// Информационное поле - 3 (сведения о факте согласования)
	СодФХЖ3 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СодФХЖ3", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СодФХЖ3, "ИныеСвИзмСтоим", Content.EventContent.CostChangeInfo);
	УстановитьЗначениеXDTO(СодФХЖ3, "СодОпер", Content.EventContent.OperationContent);
	УстановитьЗначениеXDTO(СодФХЖ3, "ДатаНапр", Дата_В_Формат(Content.EventContent.NotificationDate, ФорматДаты));
	
	XML_ЗаполнитьДокумТип(ИмяПакетаXDTO, СодФХЖ3.ПередатДокум, Content.EventContent.TransferDocDetails736);
	XML_ЗаполнитьДокумТип(ИмяПакетаXDTO, СодФХЖ3.ДокумОснКор, Content.EventContent.CorrectionBases);
	
	УстановитьЗначениеXDTO(Документ, "СодФХЖ3", СодФХЖ3);
	
КонецПроцедуры

Процедура XML_УКД_736_ЗаполнитьСведПрослеж(ИмяПакетаXDTO, СведПрослеж, ItemTracingInfos)
	
	Для Каждого ItemTracingInfo Из ItemTracingInfos Цикл
		
		НовыйСведПрослеж = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.СведТов.СведПрослеж", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(НовыйСведПрослеж, "ДопПрослеж", ItemTracingInfo.ItemAddInfo);
		УстановитьЗначениеXDTO(НовыйСведПрослеж, "НомТовПрослеж", ItemTracingInfo.RegNumberUnit);
		УстановитьЗначениеXDTO(НовыйСведПрослеж, "ЕдИзмПрослеж", ItemTracingInfo.Unit);
		
		ИзмКолЕдПТ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблКСчФ.СведТов.СведПрослеж.ИзмКолЕдПТ", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(ИзмКолЕдПТ, "КолТовЕдПТДо", ItemTracingInfo.QuantityDiff.OriginalQuantity);
		УстановитьЗначениеXDTO(ИзмКолЕдПТ, "КолТовЕдПТПосле", ItemTracingInfo.QuantityDiff.CorrectedQuantity);
		УстановитьЗначениеXDTO(ИзмКолЕдПТ, "КолТовЕдПТУвел", ItemTracingInfo.QuantityDiff.QuantityInc);
		УстановитьЗначениеXDTO(ИзмКолЕдПТ, "КолТовЕдПТУм", ItemTracingInfo.QuantityDiff.QuantityDec);
		
		НовыйСведПрослеж.ИзмКолЕдПТ = ИзмКолЕдПТ;
		
		СведПрослеж.Добавить(НовыйСведПрослеж);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ЗаполнитьДокумТип(ИмяПакетаXDTO, ДокумТип, BaseDocumentNames)
	
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	Для Каждого BaseDocumentName Из BaseDocumentNames Цикл
		
		НовыйДокумТип = XML_ПолучитьПустойОбъектXDTO("ДокумТип", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(НовыйДокумТип, "НаимОсн", BaseDocumentName.BaseDocumentName);
		УстановитьЗначениеXDTO(НовыйДокумТип, "НомОсн", BaseDocumentName.BaseDocumentNumber);
		УстановитьЗначениеXDTO(НовыйДокумТип, "ДатаОсн", Дата_В_Формат(BaseDocumentName.BaseDocumentDate, ФорматДаты));
		УстановитьЗначениеXDTO(НовыйДокумТип, "ДопСвОсн", BaseDocumentName.AdditionalInfo);
		УстановитьЗначениеXDTO(НовыйДокумТип, "ИдФайлОсн", BaseDocumentName.BaseIdFile);
		
		ДокумТип.Добавить(НовыйДокумТип);
		
	КонецЦикла;
	
КонецПроцедуры

// XML: функции заполнения Акт_552

Процедура XML_Акт_552_ЗаполнитьСведенияДокумента(ИмяПакетаXDTO, Документ, Content)

	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	СвДокПРУ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ", ИмяПакетаXDTO);
	
	// Наименование первичного документа
	
	НаимДок = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.НаимДок", ИмяПакетаXDTO);
	
	НаимДок.ПоФактХЖ = "Документ о передаче результатов работ (Документ об оказании услуг)";
	
	УстановитьЗначениеXDTO(НаимДок, "НаимДокОпр", Content.DocumentName);
	
	УстановитьЗначениеXDTO(СвДокПРУ, "НаимДок", НаимДок);
	
	// Дата и номер документа
	
	ИдентДок = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.ИдентДок", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ИдентДок, "НомДокПРУ", Content.DocumentNumber);
	УстановитьЗначениеXDTO(ИдентДок, "ДатаДокПРУ", Дата_В_Формат(Content.DocumentDate, ФорматДаты));
	
	УстановитьЗначениеXDTO(СвДокПРУ, "ИдентДок", ИдентДок);
	
	// Исправление
	
	Если ЗначениеЗаполнено(Content.RevisionNumber) И ЗначениеЗаполнено(Content.RevisionDate) Тогда
		
		ИспрДокПРУ = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.ИспрДокПРУ", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(ИспрДокПРУ, "НомИспрДокПРУ", Content.RevisionNumber);
		УстановитьЗначениеXDTO(ИспрДокПРУ, "ДатаИспрДокПРУ", Дата_В_Формат(Content.RevisionDate, ФорматДаты));
		
		УстановитьЗначениеXDTO(СвДокПРУ, "ИспрДокПРУ", ИспрДокПРУ);
		
	КонецЕсли;

	// Единица денежного измерения
	
	ДенИзм = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.ДенИзм", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ДенИзм, "КодОКВ", Content.Currency);
	УстановитьЗначениеXDTO(ДенИзм, "НаимОКВ", НаименованиеВалюты(Content.Currency, Истина));
	УстановитьЗначениеXDTO(ДенИзм, "КурсВал", Content.CurrencyRate);
	
	УстановитьЗначениеXDTO(СвДокПРУ, "ДенИзм", ДенИзм);
	
	// Содержание факта хозяйственной жизни (1)
	
	СодФХЖ1 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.СодФХЖ1", ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(СодФХЖ1, "ЗагСодОпер", Content.OperationTitle);
	
	// Исполнитель
	
	Исполнитель = XML_ПолучитьПустойОбъектXDTO("УчастникТип", ИмяПакетаXDTO);
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, Исполнитель, Content.Seller);
	УстановитьЗначениеXDTO(СодФХЖ1, "Исполнитель", Исполнитель);
	
	// Заказчик
	
	Заказчик = XML_ПолучитьПустойОбъектXDTO("УчастникТип", ИмяПакетаXDTO);
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, Заказчик, Content.Buyer);
	УстановитьЗначениеXDTO(СодФХЖ1, "Заказчик", Заказчик);
	
	// Основание
			
	Для Каждого GroundInfo Из Content.Grounds Цикл
		
		Основание = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.СодФХЖ1.Основание", ИмяПакетаXDTO);				
		
		УстановитьЗначениеXDTO(Основание, "НаимОсн", GroundInfo.Name);
		УстановитьЗначениеXDTO(Основание, "НомОсн", GroundInfo.Number);
		УстановитьЗначениеXDTO(Основание, "ДатаОсн", Дата_В_Формат(GroundInfo.Date, ФорматДаты));
		УстановитьЗначениеXDTO(Основание, "ДопСвОсн", GroundInfo.Info);
		
		СодФХЖ1.Основание.Добавить(Основание);
		
	КонецЦикла;
		
	// Идентификатор государственного контракта
		
	УстановитьЗначениеXDTO(СодФХЖ1, "ИдГосКон", Content.GovernmentContractInfo);
	
	// Вид операции
	
	УстановитьЗначениеXDTO(СодФХЖ1, "ВидОперации", Content.OperationType);
	
	// Описание выполненных работ (услуг)
	
	Для Каждого Act552WorkDescription Из Content.Works Цикл
		
		ОписРабот = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.СодФХЖ1.ОписРабот", ИмяПакетаXDTO);
		XML_Акт_552_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, ОписРабот, Act552WorkDescription);
		СодФХЖ1.ОписРабот.Добавить(ОписРабот);
		
	КонецЦикла;
	
	// Информационное поле факта хозяйственной жизни (1)
	
	Если ЗначениеЗаполнено(Content.AdditionalInfo.InfoFileId) ИЛИ Content.AdditionalInfo.StructedAdditionalInfos.Количество() > 0 Тогда
		
		ИнфПолФХЖ1 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.СодФХЖ1.ИнфПолФХЖ1", ИмяПакетаXDTO);		
		УстановитьЗначениеXDTO(ИнфПолФХЖ1, "ИдФайлИнфПол", Content.AdditionalInfo.InfoFileId);		
		XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПолФХЖ1.ТекстИнф, Content.AdditionalInfo.StructedAdditionalInfos);
		УстановитьЗначениеXDTO(СодФХЖ1, "ИнфПолФХЖ1", ИнфПолФХЖ1);
		
	КонецЕсли;	
	
	УстановитьЗначениеXDTO(СвДокПРУ, "СодФХЖ1", СодФХЖ1);
	УстановитьЗначениеXDTO(Документ, "СвДокПРУ", СвДокПРУ);
	
КонецПроцедуры

Процедура XML_Акт_552_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, Документ, Content)

	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	// Содержание факта хозяйственной жизни (2)
	
	СодФХЖ2 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СодФХЖ2", ИмяПакетаXDTO);	
	УстановитьЗначениеXDTO(СодФХЖ2, "СодОпер", Content.TransferInfo.OperationInfo);	
	УстановитьЗначениеXDTO(СодФХЖ2, "ДатаПер", Дата_В_Формат(Content.TransferInfo.TransferDate, ФорматДаты));
	
	// Сведения о передаче вещи, изготовленной по договору подряда			
		
	Если ЗначениеЗаполнено(Content.TransferInfo.CreatedThingTransferDate) Тогда
		
		СвПерВещи = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СодФХЖ2.СвПерВещи", ИмяПакетаXDTO);		
		УстановитьЗначениеXDTO(СвПерВещи, "ДатаПерВещ", Дата_В_Формат(Content.TransferInfo.CreatedThingTransferDate, ФорматДаты));
		УстановитьЗначениеXDTO(СвПерВещи, "СвПерВещ", Content.TransferInfo.CreatedThingInfo);
		УстановитьЗначениеXDTO(СодФХЖ2, "СвПерВещи", СвПерВещи);
		
	КонецЕсли;
	
	// Информационное поле факта хозяйственной жизни (2)
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СодФХЖ2.ИнфПолФХЖ2, Content.TransferInfo.StructedAdditionalInfos);	
	
	УстановитьЗначениеXDTO(Документ, "СодФХЖ2", СодФХЖ2);
	
КонецПроцедуры

Процедура XML_Акт_552_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, ОписРабот, Act552WorkDescription)
	
	УстановитьЗначениеXDTO(ОписРабот, "НачРабот", 	Дата_В_Формат(Act552WorkDescription.StartingDate, "ДФ=dd.MM.yyyy"));
	УстановитьЗначениеXDTO(ОписРабот, "КонРабот", 	Дата_В_Формат(Act552WorkDescription.CompletionDate, "ДФ=dd.MM.yyyy"));		
	УстановитьЗначениеXDTO(ОписРабот, "СтБезНДСИт", Act552WorkDescription.TotalWithVatExcluded);
	УстановитьЗначениеXDTO(ОписРабот, "СумНДСИт", 	Act552WorkDescription.TotalVat);
	УстановитьЗначениеXDTO(ОписРабот, "СтУчНДСИт", 	Act552WorkDescription.Total);
	
	НомерСтроки = 1;
	
	Для Каждого Act552WorkItem Из Act552WorkDescription.Items Цикл
		
		Работа = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвДокПРУ.СодФХЖ1.ОписРабот.Работа", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(Работа, "Номер", НомерСтроки);
		
		УстановитьЗначениеXDTO(Работа, "НаимРабот", 	Act552WorkItem.Name);
		УстановитьЗначениеXDTO(Работа, "НаимЕдИзм", 	Act552WorkItem.UnitName);
		УстановитьЗначениеXDTO(Работа, "ОКЕИ",			Act552WorkItem.UnitCode);
		УстановитьЗначениеXDTO(Работа, "Цена", 			Act552WorkItem.Price);
		УстановитьЗначениеXDTO(Работа, "Количество", 	Act552WorkItem.Quantity);
		УстановитьЗначениеXDTO(Работа, "СтоимБезНДС", 	Act552WorkItem.SubtotalWithVatExcluded);
		УстановитьЗначениеXDTO(Работа, "НалСт", 		НалСт_Из_TaxRate(Act552WorkItem.TaxRate));
		УстановитьЗначениеXDTO(Работа, "СумНДС", 		Act552WorkItem.Vat);
		УстановитьЗначениеXDTO(Работа, "СтоимУчНДС", 	Act552WorkItem.Subtotal);			
		УстановитьЗначениеXDTO(Работа, "КоррСчДебет", 	Act552WorkItem.ItemAccountDebit);
		УстановитьЗначениеXDTO(Работа, "КоррСчКредит",	Act552WorkItem.ItemAccountCredit);
		УстановитьЗначениеXDTO(Работа, "Описание", 		Act552WorkItem.Description);
		
		// - Информационное поле описания работ
		
		XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, Работа.ИнфПолеОписРабот, Act552WorkItem.StructedAdditionalInfos);
		
		ОписРабот.Работа.Добавить(Работа);
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_Акт_552_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO
	, СодФХЖ3
	, ПротоКонтент
	, НаименованиеДокумента
	, НомерДокумента
	, ДатаДокумента)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	УстановитьЗначениеXDTO(СодФХЖ3, "ВидОперации"	, ПротоКонтент.OperationType);
	УстановитьЗначениеXDTO(СодФХЖ3, "НаимДокОпрИсп"	, НаименованиеДокумента);
	УстановитьЗначениеXDTO(СодФХЖ3, "ДатаДокПРУИсп"	, Дата_В_Формат(ДатаДокумента, ФорматДаты));
	
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		СодФХЖ3.НомДокПРУИсп = НомерДокумента;
	КонецЕсли;
	
	// Сведения о приемке результатов работ (подтверждение факта оказания услуг)
	РезПринял = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ3, "РезПринял");
	УстановитьЗначениеXDTO(РезПринял, "СодОпер"		, ПротоКонтент.OperationContent);
	УстановитьЗначениеXDTO(РезПринял, "ДатаПрием"	, Дата_В_Формат(ПротоКонтент.AcceptanceDate, ФорматДаты));
	
	ЕстьДатаПолучения		 = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "CreatedThingAcceptDate") И ЗначениеЗаполнено(ПротоКонтент.CreatedThingAcceptDate);
	ЕстьСведенияОПолучении	 = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "CreatedThingInfo") И ЗначениеЗаполнено(ПротоКонтент.CreatedThingInfo);
	
	Если ЕстьДатаПолучения Или ЕстьСведенияОПолучении Тогда
		
		// Сведения о получении вещи, изготовленной по договору подряда
		СвПолВещи = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ3, "СвПолВещи");
		
		Если ЕстьДатаПолучения Тогда
			УстановитьЗначениеXDTO(СвПолВещи, "ДатаПол", Дата_В_Формат(ПротоКонтент.CreatedThingAcceptDate, ФорматДаты));
		КонецЕсли;
		
		Если ЕстьСведенияОПолучении Тогда
			УстановитьЗначениеXDTO(СвПолВещи, "СвПол", ПротоКонтент.CreatedThingInfo);
		КонецЕсли;
		
	КонецЕсли;
	
	XML_ЗаполнитьИнфоПоляФХЖ(ИмяПакетаXDTO, СодФХЖ3, ПротоКонтент.AdditionalInfoId, "ИнфПолФХЖ3");
	
КонецПроцедуры

// XML: функции заполнения Торг12_551

Процедура XML_Торг_551_ЗаполнитьСведенияДокумента(ИмяПакетаXDTO, Документ, Content)

	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты	 = "ДФ=dd.MM.yyyy";
	
	СвДокПТПрКроме = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СвДокПТПрКроме");
	СвДокПТПр = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПрКроме, "СвДокПТПр");
	
	// Наименование первичного документа
	
	НаимДок = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПр, "НаимДок");
	
	УстановитьЗначениеXDTO(НаимДок, "ПоФактХЖ", "Документ о передаче товара при торговых операциях");
	УстановитьЗначениеXDTO(НаимДок, "НаимДокОпр", Content.DocumentName);
	
	// Дата и номер документа
	
	ИдентДок = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПр, "ИдентДок");
	
	УстановитьЗначениеXDTO(ИдентДок, "НомДокПТ", Content.DocumentNumber);
	УстановитьЗначениеXDTO(ИдентДок, "ДатаДокПТ", Дата_В_Формат(Content.DocumentDate, ФорматДаты));
	
	// Исправление
	
	Если ЗначениеЗаполнено(Content.RevisionNumber) И ЗначениеЗаполнено(Content.RevisionDate) Тогда
		
		// протестировать отдельно!
		
		ИспрДокПТ = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПр, "ИспрДокПТ");
		
		УстановитьЗначениеXDTO(ИспрДокПТ, "НомИспрДокПТ", Content.RevisionNumber);
		УстановитьЗначениеXDTO(ИспрДокПТ, "ДатаИспрДокПТ", Дата_В_Формат(Content.RevisionDate, ФорматДаты));
		
	КонецЕсли;

	// Единица денежного измерения
	
	ДенИзм = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПр, "ДенИзм");
	
	УстановитьЗначениеXDTO(ДенИзм, "КодОКВ", Content.Currency);
	УстановитьЗначениеXDTO(ДенИзм, "НаимОКВ", НаименованиеВалюты(Content.Currency, Истина));
	УстановитьЗначениеXDTO(ДенИзм, "КурсВал", Content.CurrencyRate);
	
	// Содержание факта хозяйственной жизни (1)
	
	СодФХЖ1 = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПр, "СодФХЖ1");
	
	// Грузоотправитель
	
	Если ЗначениеЗаполнено(Content.Shipper.Name) Тогда
		ГрузОтпр = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "ГрузОтпр");
		XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, ГрузОтпр, Content.Shipper);
	КонецЕсли;

	// Грузополучатель
	
	Если ЗначениеЗаполнено(Content.Consignee.Name) Тогда
		ГрузПолуч = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "ГрузПолуч");
		XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, ГрузПолуч, Content.Consignee);
	КонецЕсли;

	// Продавец
	
	Продавец = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Продавец");
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, Продавец, Content.Seller);
	
	// Покупатель
	
	Покупатель = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Покупатель");
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, Покупатель, Content.Buyer);
	
	// Перевозчик
	
	Если ЗначениеЗаполнено(Content.Carrier.Name) Тогда
		Перевозчик = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Перевозчик");
		XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, Перевозчик, Content.Carrier);
	КонецЕсли;
	
	// Основание
			
	Для Каждого GroundInfo Из Content.Grounds Цикл
		
		Основание = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Основание");
		
		УстановитьЗначениеXDTO(Основание, "НаимОсн", GroundInfo.Name);
		УстановитьЗначениеXDTO(Основание, "НомОсн", GroundInfo.Number);
		УстановитьЗначениеXDTO(Основание, "ДатаОсн", Дата_В_Формат(GroundInfo.Date, ФорматДаты));
		УстановитьЗначениеXDTO(Основание, "ДопСвОсн", GroundInfo.Info);
		
	КонецЦикла;
		
	// Идентификатор государственного контракта
		
	УстановитьЗначениеXDTO(СодФХЖ1, "ИдГосКон", Content.GovernmentContractInfo);
	
	// Вид операции
	
	УстановитьЗначениеXDTO(СодФХЖ1, "ВидОперации", Content.OperationType);
	
	// Описание товаров
	
	СодФХЖ2 = НовыйДочернийОбъектXDTO(Фабрика, СвДокПТПрКроме, "СодФХЖ2");
	
	НомерСтроки = 0;
	Для Каждого TovTorgItem Из Content.Table.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		СвТов = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ2, "СвТов");
		XML_Торг_551_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СвТов, TovTorgItem, НомерСтроки);
		
	КонецЦикла;
	
	// Итоги по товарам
	
	Всего = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ2, "Всего");
	
	УстановитьЗначениеXDTO(Всего, "КолМестВс",		Content.Table.TotalQuantity);
	УстановитьЗначениеXDTO(Всего, "БруттоВс",		Content.Table.TotalGross);
	УстановитьЗначениеXDTO(Всего, "НеттоВс",		Content.Table.TotalNet);
	
	// Возможны проблемы с форматированием данных полей - схема предполагает 2 знака после запятой. Надо проверить.
	УстановитьЗначениеXDTO(Всего, "СтБезНДСВс",		Content.Table.TotalWithVatExcluded);
	УстановитьЗначениеXDTO(Всего, "СумНДСВс",		Content.Table.TotalVat);
	УстановитьЗначениеXDTO(Всего, "СтУчНДСВс",		Content.Table.Total);
	
	// Информационное поле факта хозяйственной жизни (1)
	
	Если ЗначениеЗаполнено(Content.AdditionalInfoId.InfoFileId) ИЛИ Content.AdditionalInfoId.StructedAdditionalInfos.Количество() > 0 Тогда
		
		ИнфПолФХЖ1 = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "ИнфПолФХЖ1");
		
		УстановитьЗначениеXDTO(ИнфПолФХЖ1, "ИдФайлИнфПол", Content.AdditionalInfoId.InfoFileId);		
		XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ИнфПолФХЖ1.ТекстИнф, Content.AdditionalInfoId.StructedAdditionalInfos);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_Торг_551_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO, Документ, Content)

	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);

	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	// Содержание факта хозяйственной жизни (3)
	
	СодФХЖ3 = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СодФХЖ3");
	
	УстановитьЗначениеXDTO(СодФХЖ3, "СодОпер", Content.TransferInfo.OperationInfo);	
	УстановитьЗначениеXDTO(СодФХЖ3, "ДатаОтпуск", Дата_В_Формат(Content.TransferInfo.TransferDate, ФорматДаты));
	
	УстановитьЗначениеXDTO(СодФХЖ3, "КолПрил", Content.TransferInfo.Attachment);	
	
	// Транспортные накладные
	
	Для Каждого WayBill Из Content.TransferInfo.Waybills Цикл
		
		ТранНакл = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ3, "ТранНакл");
		УстановитьЗначениеXDTO(ТранНакл, "НомТранНакл", WayBill.DocumentNumber);
		УстановитьЗначениеXDTO(ТранНакл, "ДатаТранНакл", Дата_В_Формат(WayBill.DocumentDate, ФорматДаты));
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Content.TransferInfo.Employee.Surname)
		Или ЗначениеЗаполнено(Content.TransferInfo.OtherIssuer.Surname) Тогда
		
		// Лицо, отпустившее груз
		СвЛицОтпГруз = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ3, "СвЛицОтпГруз");
		
		Если ЗначениеЗаполнено(Content.TransferInfo.Employee.Surname) Тогда
			
			// Работник организации
			РабОргПрод = НовыйДочернийОбъектXDTO(Фабрика, СвЛицОтпГруз, "РабОргПрод");
			XML_ЗаполнитьРаботникаОрганизации(ИмяПакетаXDTO, РабОргПрод, Content.TransferInfo.Employee);
			
		ИначеЕсли ЗначениеЗаполнено(Content.TransferInfo.OtherIssuer.Surname) Тогда
			
			// Иное лицо
			ИнЛицо = НовыйДочернийОбъектXDTO(Фабрика, СвЛицОтпГруз, "ИнЛицо");
			
			Если ЗначениеЗаполнено(Content.OtherIssuer.EmployeePosition)
				И ЗначениеЗаполнено(Content.OtherIssuer.OrganizationName) Тогда
				
				ПредОргПер = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ПредОргПер");
				XML_ЗаполнитьПредставителяОрганизации(ИмяПакетаXDTO, ПредОргПер, Content.TransferInfo.OtherIssuer);
				
			Иначе
				
				ФЛПер = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ФЛПер");
				XML_ЗаполнитьФизическоеЛицо(ИмяПакетаXDTO, ФЛПер, Content.TransferInfo.OtherIssue)
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Информационное поле факта хозяйственной жизни (3)
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СодФХЖ3.ИнфПолФХЖ3, Content.TransferInfo.StructedAdditionalInfos);	
	
КонецПроцедуры

Процедура XML_Торг_551_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СвТов, Item, НомерСтроки)
	
	УстановитьЗначениеXDTO(СвТов, "НомТов",			НомерСтроки);
	УстановитьЗначениеXDTO(СвТов, "НаимТов",		Item.Product);
	УстановитьЗначениеXDTO(СвТов, "ХарактерТов",	Item.Feature);
	УстановитьЗначениеXDTO(СвТов, "СортТов",		Item.Sort);
	УстановитьЗначениеXDTO(СвТов, "АртикулТов",		Item.VendorCode);
	УстановитьЗначениеXDTO(СвТов, "КодТов",			Item.ProductCode );
	УстановитьЗначениеXDTO(СвТов, "НаимЕдИзм",		Item.UnitName);
	УстановитьЗначениеXDTO(СвТов, "ОКЕИ_Тов",		Item.Unit);
	УстановитьЗначениеXDTO(СвТов, "ВидУпак",		Item.PackageType);
	УстановитьЗначениеXDTO(СвТов, "Место",			Item.QuantityInPack);
	УстановитьЗначениеXDTO(СвТов, "КолМест",		Item.Quantity);
	УстановитьЗначениеXDTO(СвТов, "Брутто",			Item.Gross);
	УстановитьЗначениеXDTO(СвТов, "НеттоПередано",	Item.Net);
	УстановитьЗначениеXDTO(СвТов, "НадлОтп",		Item.ItemToRelease);
	УстановитьЗначениеXDTO(СвТов, "Цена",			XML_ФорматЧисла(Item.Price, 2));
	УстановитьЗначениеXDTO(СвТов, "НалСт",			НалСт_Из_TaxRate(Item.TaxRate));
	УстановитьЗначениеXDTO(СвТов, "КорСчДебет",		Item.ItemAccountDebit);
	УстановитьЗначениеXDTO(СвТов, "КорСчКредит",	Item.ItemAccountCredit);
	
	// Возможны проблемы с форматированием данных полей - схема предполагает 2 знака после запятой. Надо проверить.
	УстановитьЗначениеXDTO(СвТов, "СтБезНДС",		XML_ФорматЧисла(Item.SubtotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СвТов, "СумНДС",			XML_ФорматЧисла(Item.Vat, 2));
	УстановитьЗначениеXDTO(СвТов, "СтУчНДС",		XML_ФорматЧисла(Item.Subtotal, 2));
	
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СвТов.ИнфПолФХЖ2, Item.StructedAdditionalInfos);
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_Торг_551_ЗаполнитьСодержаниеФХЖ(ИмяПакетаXDTO
	, СодФХЖ4
	, ПротоКонтент
	, НаименованиеДокумента
	, НомерДокумента
	, ДатаДокумента)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	УстановитьЗначениеXDTO(СодФХЖ4, "ВидОперации"	, ПротоКонтент.OperationCode);
	УстановитьЗначениеXDTO(СодФХЖ4, "НаимДокОпрПр"	, НаименованиеДокумента);
	УстановитьЗначениеXDTO(СодФХЖ4, "ДатаДокПТПр"	, Дата_В_Формат(ДатаДокумента, ФорматДаты));
	СодФХЖ4.НомДокПТПр = НомерДокумента;
	
	// Сведения о принятии товара (получении груза)
	СвПрин = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ4, "ГрузПолучил");
	УстановитьЗначениеXDTO(СвПрин, "СодОпер"	, ПротоКонтент.OperationContent);
	УстановитьЗначениеXDTO(СвПрин, "ДатаПолуч"	, Дата_В_Формат(ПротоКонтент.AcceptanceDate, ФорматДаты));
	
	ЕстьСведенияОРаботнике = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "Employee") И ЗначениеЗаполнено(ПротоКонтент.Employee.Surname);
	ЕстьСведенияОбИномЛице = ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "OtherIssuer") И ЗначениеЗаполнено(ПротоКонтент.OtherIssuer.Surname);
	
	Если ЕстьСведенияОРаботнике Или ЕстьСведенияОбИномЛице Тогда
		
		// Сведения о лице, принявшем товары (груз)
		СвЛицПолГруз = НовыйДочернийОбъектXDTO(Фабрика, СвПрин, "СвЛицПолГруз");
		
		Если ЕстьСведенияОРаботнике Тогда
			
			// Работник организации покупателя
			РабОргПок = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПолГруз, "РабОргПок");
			XML_ЗаполнитьРаботникаОрганизации(ИмяПакетаXDTO, РабОргПок, ПротоКонтент.Employee);
			
		ИначеЕсли ЕстьСведенияОбИномЛице Тогда
			
			// Иное лицо
			ИнЛицо = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПолГруз, "ИнЛицо");
			
			Если ЗначениеЗаполнено(ПротоКонтент.OtherIssuer.EmployeePosition) Тогда
				
				// Представитель организации, которой доверено принятие товаров (груза)
				ПредОргПол = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ПредОргПол");
				XML_ЗаполнитьПредставителяОрганизации(ИмяПакетаXDTO, ПредОргПол, ПротоКонтент.OtherIssuer);
				
			Иначе
				
				// Физическое лицо, которому доверено принятие товаров (груза)
				ФЛ = НовыйДочернийОбъектXDTO(Фабрика, ИнЛицо, "ФЛ");
				XML_ЗаполнитьФизическоеЛицо(ИмяПакетаXDTO, ФЛ, ПротоКонтент.OtherIssuer);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	XML_ЗаполнитьИнфоПоляФХЖ(ИмяПакетаXDTO, СодФХЖ4, ПротоКонтент.AdditionalInfo, "ИнфПолФХЖ4", "Файл.Документ.СодФХЖ4.ИнфПолФХЖ4.ТекстИнф");
	
КонецПроцедуры

// XML: функции заполнения Счета

Процедура XML_Счет_ЗаполнитьСведенияДокумента(ИмяПакетаXDTO, Документ, Content)
	
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	СвСНО = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвСНО", ИмяПакетаXDTO);
	УстановитьЗначениеXDTO(СвСНО, "НомерДок", Content.DocumentNumber);
	УстановитьЗначениеXDTO(СвСНО, "ДатаДок"	, Дата_В_Формат(Content.DocumentDate, ФорматДаты));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "GovernmentContractInfo") Тогда
		УстановитьЗначениеXDTO(СвСНО, "ИдГосКон", Content.GovernmentContractInfo);
	КонецЕсли;
	
	// Назначение платежа
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "PaymentPurpose") Тогда
		УстановитьЗначениеXDTO(СвСНО, "НазначПлатеж", Content.PaymentPurpose);
	КонецЕсли;
	
	// Валюта
	ДенИзм = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвСНО.ДенИзм", ИмяПакетаXDTO);
	УстановитьЗначениеXDTO(ДенИзм, "КодОКВ"	, Content.Currency);
	УстановитьЗначениеXDTO(ДенИзм, "НаимОКВ", НаименованиеВалюты(Content.Currency, Истина));
	УстановитьЗначениеXDTO(ДенИзм, "КурсВал", Content.CurrencyRate);
	УстановитьЗначениеXDTO(СвСНО, "ДенИзм", ДенИзм);
	
	// Продавец
	СвПрод = XML_ПолучитьПустойОбъектXDTO("УчастникТип", ИмяПакетаXDTO);
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, СвПрод, Content.Seller);
	УстановитьЗначениеXDTO(СвСНО, "СвПрод", СвПрод);
	
	// Покупатель
	СвПокуп = XML_ПолучитьПустойОбъектXDTO("УчастникТип", ИмяПакетаXDTO);
	XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, СвПокуп, Content.Buyer);
	УстановитьЗначениеXDTO(СвСНО, "СвПокуп", СвПокуп);
	
	// Плательщик
	Если ЗначениеЗаполнено(Content.Payer.Name) Тогда 
		
		СвПлат = XML_ПолучитьПустойОбъектXDTO("УчастникТип", ИмяПакетаXDTO);
		XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, СвПлат, Content.Payer);
		УстановитьЗначениеXDTO(СвСНО, "СвПлат", СвПлат);
		
	КонецЕсли;
	
	// Получатель платежа
	Если ЗначениеЗаполнено(Content.Recipient.Name) Тогда 
		
		СвПолуч = XML_ПолучитьПустойОбъектXDTO("УчастникТип", ИмяПакетаXDTO);
		XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, СвПолуч, Content.Recipient);
		УстановитьЗначениеXDTO(СвСНО, "СвПолуч", СвПолуч);
		
	КонецЕсли;
	
	// Договор
	Если ЗначениеЗаполнено(Content.Contract.Name) Тогда
		
		Договор = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.СвСНО.Договор", ИмяПакетаXDTO);
		УстановитьЗначениеXDTO(Договор, "НаимДог"	, Content.Contract.Name);
		УстановитьЗначениеXDTO(Договор, "НомерДог"	, Content.Contract.Number);
		УстановитьЗначениеXDTO(Договор, "ДатаДог"	, Дата_В_Формат(Content.Contract.Date, ФорматДаты));
		
		УстановитьЗначениеXDTO(СвСНО, "Договор", Договор);
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Документ, "СвСНО", СвСНО);
	
	// Доп. сведения
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, Документ.ИнфПол, Content.StructedAdditionalInfos);
	
КонецПроцедуры

Процедура XML_Счет_ЗаполнитьСведенияТабЧасти(ИмяПакетаXDTO, Документ, Content, ПараметрыФормированияФайла)
	
	ProformaInvoiceTable = Content.ProformaInvoiceTable;
	Items				 = ProformaInvoiceTable.Items;
	
	ТаблСНО = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблСНО", ИмяПакетаXDTO);
	
	// Лицевые счета
	СведЛицСчет = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблСНО.СведЛицСчет", ИмяПакетаXDTO);
	Если ЗначениеЗаполнено(Content.PersonalAccountInfo) Тогда
		XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СведЛицСчет.ЛицСчетИнф, Content.PersonalAccountInfo, "ЛицСчетИнфТип");
	КонецЕсли;
	УстановитьЗначениеXDTO(ТаблСНО, "СведЛицСчет", СведЛицСчет);
	
	Если ЗначениеЗаполнено(Items) Тогда
		
		НомерСтроки		 = 0;
		ВсеСтрокиБезНДС	 = Истина;
		
		Для Каждого Item Из Items Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			СведТов = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблСНО.СведТов", ИмяПакетаXDTO);
			
			УстановитьЗначениеXDTO(СведТов, "НомСтр", НомерСтроки);
			
			XML_Счет_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СведТов, Item, ВсеСтрокиБезНДС, ПараметрыФормированияФайла);
			
			ТаблСНО.СведТов.Добавить(СведТов);
			
		КонецЦикла;
		
		// Итоги
		ВсегоОпл	 = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблСНО.ВсегоОпл", ИмяПакетаXDTO);
		СумНалВсего	 = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(ВсегоОпл, "СтТовБезНДСВсего"	, XML_ФорматЧисла(ProformaInvoiceTable.TotalWithVatExcluded, 2));
		УстановитьЗначениеXDTO(ВсегоОпл, "СтТовУчНалВсего"	, XML_ФорматЧисла(ProformaInvoiceTable.Total, 2));
		
		Если ВсеСтрокиБезНДС Тогда
			УстановитьЗначениеXDTO(СумНалВсего, "БезНДС", СтрокаБезНДС());
		Иначе
			УстановитьЗначениеXDTO(СумНалВсего, "СумНал", XML_ФорматЧисла(ProformaInvoiceTable.TotalVat, 2));
		КонецЕсли;
		УстановитьЗначениеXDTO(ВсегоОпл, "СумНалВсего", СумНалВсего);
		
		// Итого к оплате, с учетом дополнительных начислений, перерасчетов и оплат
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ProformaInvoiceTable, "GrandTotal") Тогда
			УстановитьЗначениеXDTO(ВсегоОпл, "Итого", XML_ФорматЧисла(ProformaInvoiceTable.GrandTotal, 2));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(ТаблСНО, "ВсегоОпл", ВсегоОпл);
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Документ, "ТаблСНО", ТаблСНО);
	
КонецПроцедуры

Процедура XML_Счет_ЗаполнитьСтрокуТабЧасти(ИмяПакетаXDTO, СведТов, ProformaInvoiceItem, ВсеСтрокиБезНДС, ПараметрыФормированияФайла)
	
	УстановитьЗначениеXDTO(СведТов, "НаимТов"	, ProformaInvoiceItem.Product);
	УстановитьЗначениеXDTO(СведТов, "НаимЕдИзм"	, ProformaInvoiceItem.UnitName);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ProformaInvoiceItem, "Unit") Тогда
		УстановитьЗначениеXDTO(СведТов, "ОКЕИ_Тов", ProformaInvoiceItem.Unit);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "КолТов"	, XML_ФорматЧисла(ProformaInvoiceItem.Quantity	, ПараметрыФормированияФайла.ТочностьКоличества));
	УстановитьЗначениеXDTO(СведТов, "ЦенаТов"	, XML_ФорматЧисла(ProformaInvoiceItem.Price		, ПараметрыФормированияФайла.ТочностьЦены));
	
	УстановитьЗначениеXDTO(СведТов, "СтТовБезНДС"	, XML_ФорматЧисла(ProformaInvoiceItem.SubtotalWithVatExcluded, 2));
	УстановитьЗначениеXDTO(СведТов, "НалСт"			, НалСт_Из_TaxRate(ProformaInvoiceItem.TaxRate));
	УстановитьЗначениеXDTO(СведТов, "СтТовУчНал"	, XML_ФорматЧисла(ProformaInvoiceItem.Subtotal, 2));
	
	// Акциз
	СумАкциз = XML_ПолучитьПустойОбъектXDTO("СумАкцизТип", ИмяПакетаXDTO);
	
	Если НЕ ЗначениеЗаполнено(ProformaInvoiceItem.Excise) ИЛИ Число(ProformaInvoiceItem.Excise) = 0 Тогда
		УстановитьЗначениеXDTO(СумАкциз, "БезАкциз", "без акциза");
	Иначе
		УстановитьЗначениеXDTO(СумАкциз, "СумАкциз", XML_ФорматЧисла(Число(ProformaInvoiceItem.Excise), 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "Акциз", СумАкциз);
	
	// НДС
	СумНал = XML_ПолучитьПустойОбъектXDTO("СумНДСТип", ИмяПакетаXDTO);
	
	Если TaxRate_ЭтоЗначениеБезНДС(ProformaInvoiceItem.TaxRate) Тогда
		УстановитьЗначениеXDTO(СумНал, "БезНДС", СтрокаБезНДС());
	Иначе
		ВсеСтрокиБезНДС = Ложь;
		УстановитьЗначениеXDTO(СумНал, "СумНал", XML_ФорматЧисла(ProformaInvoiceItem.Vat, 2));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СведТов, "СумНал", СумНал);
	
	// Доп. сведения
	XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, СведТов.ДопСведТов, ProformaInvoiceItem.StructedAdditionalInfos);
	
КонецПроцедуры

// XML: функции заполнения Торг_172

Процедура XML_ОтветныйТитул_ЗаполнитьСведенияПокупателя_Торг_172(ИмяПакетаXDTO
	, ОбъектXDTO
	, ПротоКонтент
	, НомерДокумента
	, ДатаДокумента)
	
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты	 = "ДФ=dd.MM.yyyy";
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "НаимПервДок", "Товарная накладная");
	УстановитьЗначениеXDTO(ОбъектXDTO, "ОКУДПервДок", "0330212");
	УстановитьЗначениеXDTO(ОбъектXDTO, "НомФорм"	, "ТОРГ-12");
	УстановитьЗначениеXDTO(ОбъектXDTO, "НомТН"		, НомерДокумента);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаТН"		, Дата_В_Формат(ДатаДокумента, ФорматДаты));
	
	Если ЗначениеЗаполнено(ПротоКонтент.ShipmentReceiptDate) Тогда
		
		// Сведения по получению груза
		ПолучилГруз = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ПолучилГруз");
		
		УстановитьЗначениеXDTO(ПолучилГруз, "ДатаПолуч", Дата_В_Формат(ПротоКонтент.ShipmentReceiptDate, ФорматДаты));
		
		Если ЗначениеЗаполнено(ПротоКонтент.Accepter.Surname) Тогда
			
			ГрузПринял = НовыйДочернийОбъектXDTO(Фабрика, ПолучилГруз, "ГрузПринял");
			XML_ЗаполнитьДолжЛицоТип(ИмяПакетаXDTO, ГрузПринял, ПротоКонтент.Accepter);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.Receiver.Surname) Тогда
			
			ГрузПолучил = НовыйДочернийОбъектXDTO(Фабрика, ПолучилГруз, "ГрузПолучил");
			XML_ЗаполнитьДолжЛицоТип(ИмяПакетаXDTO, ГрузПолучил, ПротоКонтент.Receiver);
			
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "Attorney") Тогда
			
			Доверенность = НовыйДочернийОбъектXDTO(Фабрика, ПолучилГруз, "Доверенность");
			XML_ДоверенностьТип(ИмяПакетаXDTO, Доверенность, ПротоКонтент.Attorney);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "AdditionalInfo") И ЗначениеЗаполнено(ПротоКонтент.AdditionalInfo) Тогда
		ИнфПол = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ИнфПол");
		УстановитьЗначениеXDTO(ИнфПол, "ТекстИнф", ПротоКонтент.AdditionalInfo);
	КонецЕсли;
	
КонецПроцедуры

// XML: функции заполнения Акт_172

Процедура XML_ОтветныйТитул_ЗаполнитьСведенияПокупателя_Акт_172(ИмяПакетаXDTO
	, ОбъектXDTO
	, ПротоКонтент
	, НомерДокумента
	, ДатаДокумента)
	
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты	 = "ДФ=dd.MM.yyyy";
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "НаимПервДок", "Акт о выполнении работ (оказании услуг)");
	
	// Сведения акта о выполнении работ (оказании услуг) - титул исполнителя
	СвАктИ = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "СвАктИ");
	УстановитьЗначениеXDTO(СвАктИ, "НомАкт"	, НомерДокумента);
	УстановитьЗначениеXDTO(СвАктИ, "ДатаАкт", Дата_В_Формат(ДатаДокумента, ФорматДаты));
	
	// Принял
	Принял = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "Принял");
	УстановитьЗначениеXDTO(Принял, "ДатаЗаказ", Дата_В_Формат(ПротоКонтент.SignatureDate, ФорматДаты));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "Complaints") Тогда
		
		// Претензии
		УстановитьЗначениеXDTO(Принял, "Претенз", ПротоКонтент.Complaints);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоКонтент.Official.Surname) Тогда
		
		// Должностное лицо, представляющее заказчика работ (услуг)
		ПодписьЗаказ = НовыйДочернийОбъектXDTO(Фабрика, Принял, "ПодписьЗаказ");
		XML_ЗаполнитьДолжЛицоТип(ИмяПакетаXDTO, ПодписьЗаказ, ПротоКонтент.Official);
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "Attorney") Тогда
		
		// Сведения о доверенности подписывающего со стороны заказчика работ (услуг)
		ДоверенЗаказ = НовыйДочернийОбъектXDTO(Фабрика, Принял, "ДоверенЗаказ");
		XML_ДоверенностьТип(ИмяПакетаXDTO, ДоверенЗаказ, ПротоКонтент.Attorney);
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "AdditionalInfo") И ЗначениеЗаполнено(ПротоКонтент.AdditionalInfo) Тогда
		
		// Информационное поле
		ИнфПол = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ИнфПол");
		УстановитьЗначениеXDTO(ИнфПол, "ТекстИнф", ПротоКонтент.AdditionalInfo);
		
	КонецЕсли;
	
КонецПроцедуры

// XML: функции заполнения Торг2

Функция XML_Торг2_ДопПрефиксИмениФайла(ПротоКонтент)
	
	Результат = "";
	
	ПроверяемыеСтруктуры = Новый Массив;
	ПроверяемыеСтруктуры.Добавить("AccordingToSellerDocument");
	ПроверяемыеСтруктуры.Добавить("ActuallyAccepted");
	ПроверяемыеСтруктуры.Добавить("Breakage");
	ПроверяемыеСтруктуры.Добавить("Surplus");
	ПроверяемыеСтруктуры.Добавить("Shortfall");
	ПроверяемыеСтруктуры.Добавить("Reject");
	
	Для Каждого AcceptanceResult Из ПротоКонтент.EvidenceAcceptanceInfo.AcceptanceResults.AcceptanceResult Цикл
		
		Для Каждого Структура Из ПроверяемыеСтруктуры Цикл
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, Структура)
				И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult[Структура], "ItemIdentificationNumbers")
				И AcceptanceResult[Структура].ItemIdentificationNumbers.ItemIdentificationNumber.Количество() > 0 Тогда
				
				Результат = "MARK";
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_Торг2_ЗаполнитьСведенияОбОбстоятельствахПриемки(ИмяПакетаXDTO, СодФХЖ1, CircumstancesAcceptanceInfo, ПараметрыФормированияФайла)
	
	ФорматДаты		 = "ДФ=dd.MM.yyyy";
	ФорматДатаВремя	 = "ДФ='dd.MM.yyyy HH.mm.ss'";
	Фабрика			 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Продавец = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Продавец");
	XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, Продавец, CircumstancesAcceptanceInfo.Seller);
	
	Покупатель = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Покупатель");
	XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, Покупатель, CircumstancesAcceptanceInfo.Buyer);
	
	Если ЗначениеЗаполнено(CircumstancesAcceptanceInfo.Shipper.OrganizationDetails.OrgName) Тогда
		Грузоотправитель = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Грузоотправитель");
		XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, Грузоотправитель, CircumstancesAcceptanceInfo.Shipper);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(CircumstancesAcceptanceInfo.Consignee.OrganizationDetails.OrgName) Тогда
		Грузополучатель = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Грузополучатель");
		XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, Грузополучатель, CircumstancesAcceptanceInfo.Consignee);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(CircumstancesAcceptanceInfo.InsuranceCompany.OrganizationDetails.OrgName) Тогда
		СтрахКом = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "СтрахКом");
		XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, СтрахКом, CircumstancesAcceptanceInfo.InsuranceCompany);
	КонецЕсли;
	
	// Дата и номер приказа (распоряжения) о назначении комиссии
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "Order") И ЗначениеЗаполнено(CircumstancesAcceptanceInfo.Order.Date) Тогда
		Приказ = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "Приказ");
		УстановитьЗначениеXDTO(Приказ, "ДатаПрик", Дата_В_Формат(CircumstancesAcceptanceInfo.Order.Date, ФорматДаты));
		УстановитьЗначениеXDTO(Приказ, "НомПрик", CircumstancesAcceptanceInfo.Order.Number);
	КонецЕсли;
	
	// Сведения о событиях, связанных с осмотром груза (о результатах осмотра прибывшего груза)
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "CargoInspectionInformation") Тогда
		СвОсмГруз = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "СвОсмГруз");
		XML_Торг2_ЗаполнитьСведенияОРезультатахОсмотра(ИмяПакетаXDTO, СвОсмГруз, CircumstancesAcceptanceInfo.CargoInspectionInformation);
	КонецЕсли;
	
	// Сведения о грузе по сопроводительным транспортным документам
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "AccompanyingDocumentTable") Тогда
		
		Для Каждого Item Из CircumstancesAcceptanceInfo.AccompanyingDocumentTable.Item Цикл
			СвСопрДок = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "СвСопрДок");
			XML_Торг2_ЗаполнитьСведенияОГрузе(ИмяПакетаXDTO, СвСопрДок, Item, ПараметрыФормированияФайла);
		КонецЦикла;
		
	КонецЕсли;
	
	// Сведения о дате и времени событий, связанных с приемкой груза
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "ReceptionInformation") Тогда
		
		ReceptionInformation = CircumstancesAcceptanceInfo.ReceptionInformation;
		
		ПрибГруз = ПолучитьЗначениеXDTO(ReceptionInformation, "CargoArrivalDateTime");
		ВыдачГруз = ПолучитьЗначениеXDTO(ReceptionInformation, "DeliveryPoint");
		ВскрытГруз = ПолучитьЗначениеXDTO(ReceptionInformation, "CargoOpeningDateTime");
		ДостГруз = ПолучитьЗначениеXDTO(ReceptionInformation, "DeliveryDateTime");
		
		Если ЗначениеЗаполнено(ПрибГруз)
			Или ЗначениеЗаполнено(ВыдачГруз)
			Или ЗначениеЗаполнено(ВскрытГруз)
			Или ЗначениеЗаполнено(ДостГруз) Тогда
			
			СвВремПрием = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "СвВремПрием");
			
			УстановитьЗначениеXDTO(СвВремПрием, "ПрибГруз", Дата_В_Формат(ПрибГруз, ФорматДатаВремя));
			УстановитьЗначениеXDTO(СвВремПрием, "ВыдачГруз", Дата_В_Формат(ВыдачГруз, ФорматДатаВремя));
			УстановитьЗначениеXDTO(СвВремПрием, "ВскрытГруз", Дата_В_Формат(ВскрытГруз, ФорматДатаВремя));
			УстановитьЗначениеXDTO(СвВремПрием, "ДостГруз", Дата_В_Формат(ДостГруз, ФорматДатаВремя));
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Другие обстоятельства приемки ценностей
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "OtherCircumstancesAcceptanceInfo")
		И ОбъектXDTOЗаполнен(CircumstancesAcceptanceInfo.OtherCircumstancesAcceptanceInfo) Тогда
		OtherCircumstancesAcceptanceInfo = CircumstancesAcceptanceInfo.OtherCircumstancesAcceptanceInfo;
		ДрОбстПрием = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "ДрОбстПрием");
		XML_Торг2_ЗаполнитьДругиеОбстоятельстваПриемки(ИмяПакетаXDTO, ДрОбстПрием, OtherCircumstancesAcceptanceInfo);
	КонецЕсли;
	
	// Сведения о лице, принявшем товар (получившем груз) (в том числе на ответственное хранение)
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "PersonAcceptedCargoInfo") Тогда
		
		СвЛицПрин = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "СвЛицПрин");
		PersonAcceptedCargoInfo = CircumstancesAcceptanceInfo.PersonAcceptedCargoInfo;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(PersonAcceptedCargoInfo, "Employee")
			И ЗначениеЗаполнено(PersonAcceptedCargoInfo.Employee.Position) Тогда
			
			РабОргПок = НовыйДочернийОбъектXDTO(Фабрика, СвЛицПрин, "РабОргПок");
			XML_ЗаполнитьРабОргПок(ИмяПакетаXDTO, РабОргПок, PersonAcceptedCargoInfo.Employee);
			
		Иначе
			ИнЛицо = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "ИнЛицо");
			XML_ЗаполнитьИнЛицо(ИмяПакетаXDTO, ИнЛицо, PersonAcceptedCargoInfo.OtherIssuer);
		КонецЕсли;
		
	КонецЕсли;
	
	// Информационное поле события (факта хозяйственной жизни) 1
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CircumstancesAcceptanceInfo, "AdditionalInfoId") Тогда
		ИнфПолФХЖ1 = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ1, "ИнфПолФХЖ1");
		XML_ЗаполнитьИнфПолТип(ИмяПакетаXDTO, ИнфПолФХЖ1, CircumstancesAcceptanceInfo.AdditionalInfoId);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СодФХЖ1, "ОбстИсп", ПолучитьЗначениеXDTO(CircumstancesAcceptanceInfo, "CircumFormat"));
	УстановитьЗначениеXDTO(СодФХЖ1, "ИдГосКон", ПолучитьЗначениеXDTO(CircumstancesAcceptanceInfo, "GovernmentContractInfo"));
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьСведенияОРезультатахОсмотра(ИмяПакетаXDTO, СвОсмГруз, CargoInspectionInformation)
	
	ФорматДаты	 = "ДФ=dd.MM.yyyy";
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	// Номер сертификата соответствия
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CargoInspectionInformation, "CertificateConformityNumbers") Тогда
		Для Каждого CertificateConformityNumber Из CargoInspectionInformation.CertificateConformityNumbers.CertificateConformityNumber Цикл
			СвОсмГруз.СертСоотв.Добавить(CertificateConformityNumber);
		КонецЦикла;
	КонецЕсли;
	
	// Наименование, номер и дата сопроводительного документа (идентификатор сопроводительного документа)
	СопрДок = НовыйДочернийОбъектXDTO(Фабрика, СвОсмГруз, "СопрДок");
	XML_ЗаполнитьСопрДокТип(СопрДок, CargoInspectionInformation.AccompanyingDocumentInfo);
	
	// Информационное поле сведений о результатах осмотра
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(CargoInspectionInformation, "AdditionalInfoId")
		И ОбъектXDTOЗаполнен(CargoInspectionInformation.AdditionalInfoId) Тогда
		ИнфПолСвОсм = НовыйДочернийОбъектXDTO(Фабрика, СвОсмГруз, "ИнфПолСвОсм");
		XML_ЗаполнитьИнфПолТип(ИмяПакетаXDTO, ИнфПолСвОсм, CargoInspectionInformation.AdditionalInfoId);
	КонецЕсли;
	
	ДатаОсм = ПолучитьЗначениеXDTO(CargoInspectionInformation, "ReceptionDate");
	Если ЗначениеЗаполнено(ДатаОсм) Тогда
		УстановитьЗначениеXDTO(СвОсмГруз, "ДатаОсм", Дата_В_Формат(ДатаОсм, ФорматДаты));
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СвОсмГруз, "МестоСост", ПолучитьЗначениеXDTO(CargoInspectionInformation, "ReceptionPlace"));
	УстановитьЗначениеXDTO(СвОсмГруз, "ВремяНач", ПолучитьЗначениеXDTO(CargoInspectionInformation, "ReceptionStartTime"));
	УстановитьЗначениеXDTO(СвОсмГруз, "ВремяОконч", ПолучитьЗначениеXDTO(CargoInspectionInformation, "ReceptionFinishTime"));
	
	ДатаОтпр = ПолучитьЗначениеXDTO(CargoInspectionInformation, "DeliveryDate");
	Если ЗначениеЗаполнено(ДатаОтпр) Тогда
		УстановитьЗначениеXDTO(СвОсмГруз, "ДатаОтпр", Дата_В_Формат(ДатаОтпр, ФорматДаты));
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьСведенияОГрузе(ИмяПакетаXDTO, СвСопрДок, Item, ПараметрыФормированияФайла)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Item, "DocumentWeight") Тогда
		МассаДок = НовыйДочернийОбъектXDTO(Фабрика, СвСопрДок, "МассаДок");
		XML_ЗаполнитьМасГрузТип(МассаДок, Item.DocumentWeight, ПараметрыФормированияФайла);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Item, "FactWeight") Тогда
		МассаФакт = НовыйДочернийОбъектXDTO(Фабрика, СвСопрДок, "МассаФакт");
		XML_ЗаполнитьМасГрузТип(МассаФакт, Item.FactWeight, ПараметрыФормированияФайла);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Item, "AdditionalInfo") И ЗначениеЗаполнено(Item.AdditionalInfo.Id) Тогда
		ИнфПолСопрДок = НовыйДочернийОбъектXDTO(Фабрика, СвСопрДок, "ИнфПолСопрДок");
		XML_ЗаполнитьТекстИнфТип(ИнфПолСопрДок, Item.AdditionalInfo);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СвСопрДок, "ОтмПломб", ПолучитьЗначениеXDTO(Item, "SealingMark"));
	УстановитьЗначениеXDTO(СвСопрДок, "ВидУпак", ПолучитьЗначениеXDTO(Item, "PackingType"));
	УстановитьЗначениеXDTO(СвСопрДок, "КолМест", ПолучитьЗначениеXDTO(Item, "Quantity"));
	УстановитьЗначениеXDTO(СвСопрДок, "НаимГруз", Item.CargoName);
	УстановитьЗначениеXDTO(СвСопрДок, "ОКЕИ_Тов", ПолучитьЗначениеXDTO(Item, "Unit"));
	УстановитьЗначениеXDTO(СвСопрДок, "НаимЕдИзм", ПолучитьЗначениеXDTO(Item, "UnitName"));
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьДругиеОбстоятельстваПриемки(ИмяПакетаXDTO, ДрОбстПрием, OtherCircumstancesAcceptanceInfo)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OtherCircumstancesAcceptanceInfo, "Carrier") Тогда
		Перевозчик = НовыйДочернийОбъектXDTO(Фабрика, ДрОбстПрием, "Перевозчик");
		XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, Перевозчик, OtherCircumstancesAcceptanceInfo.Carrier);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OtherCircumstancesAcceptanceInfo, "AccompanyingTransferDocumentInfo") Тогда
		СопрТрансДок = НовыйДочернийОбъектXDTO(Фабрика, ДрОбстПрием, "СопрТрансДок");
		XML_ЗаполнитьСопрДокТип(СопрТрансДок, OtherCircumstancesAcceptanceInfo.AccompanyingTransferDocumentInfo);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(ДрОбстПрием, "УсловХран", ПолучитьЗначениеXDTO(OtherCircumstancesAcceptanceInfo, "StorageConditions"));
	УстановитьЗначениеXDTO(ДрОбстПрием, "СостТара", ПолучитьЗначениеXDTO(OtherCircumstancesAcceptanceInfo, "CargoActualState"));
	УстановитьЗначениеXDTO(ДрОбстПрием, "ОпредНедост", ПолучитьЗначениеXDTO(OtherCircumstancesAcceptanceInfo, "MissingAssets"));
	УстановитьЗначениеXDTO(ДрОбстПрием, "ДопСв", ПолучитьЗначениеXDTO(OtherCircumstancesAcceptanceInfo, "AdditionalInfo"));
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьСведенияОФактеПриемки(ИмяПакетаXDTO, СодФХЖ2, EvidenceAcceptanceInfo, ПараметрыФормированияФайла)
	
	ФорматДаты	 = "ДФ=dd.MM.yyyy";
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	// Результаты приемки ценностей (груза)
	Для Каждого AcceptanceResult Из EvidenceAcceptanceInfo.AcceptanceResults.AcceptanceResult Цикл
		РезПрием = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ2, "РезПрием");
		XML_Торг2_ЗаполнитьРезультатыПриемкиЦенностей(ИмяПакетаXDTO, РезПрием, AcceptanceResult, ПараметрыФормированияФайла);
	КонецЦикла;
	
	// Прилагаемые документы
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(EvidenceAcceptanceInfo, "AttachedDocuments") Тогда
		
		Для Каждого AttachedDocument Из EvidenceAcceptanceInfo.AttachedDocuments.AttachedDocument Цикл
			
			ПрилДок = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ2, "ПрилДок");
			
			УстановитьЗначениеXDTO(ПрилДок, "ВидПрилДок", AttachedDocument.Type);
			УстановитьЗначениеXDTO(ПрилДок, "НомерПрилДок", AttachedDocument.Number);
			УстановитьЗначениеXDTO(ПрилДок, "ДатаПрилДок", Дата_В_Формат(AttachedDocument.Date, ФорматДаты));
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СодФХЖ2, "ВидОперации", ПолучитьЗначениеXDTO(EvidenceAcceptanceInfo, "OperationType"));
	
	// Информационное поле события (факта хозяйственной жизни) 2
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(EvidenceAcceptanceInfo, "AdditionalInfos") Тогда
		
		Для Каждого AdditionalInfo Из EvidenceAcceptanceInfo.AdditionalInfos.AdditionalInfo Цикл
			ИнфПолФХЖ2 = НовыйДочернийОбъектXDTO(Фабрика, СодФХЖ2, "ИнфПолФХЖ2");
			XML_ЗаполнитьТекстИнфТип(ИнфПолФХЖ2, AdditionalInfo);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СодФХЖ2, "СодСоб", EvidenceAcceptanceInfo.EventSummary);
	УстановитьЗначениеXDTO(СодФХЖ2, "Заключение", ПолучитьЗначениеXDTO(EvidenceAcceptanceInfo, "Conclusion"));
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьРезультатыПриемкиЦенностей(ИмяПакетаXDTO, РезПрием, AcceptanceResult, ПараметрыФормированияФайла)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	// Ценности
	Ценности = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "Ценности");
	Assets = AcceptanceResult.Assets;
	
	УстановитьЗначениеXDTO(Ценности, "НомСтрСопрДок", ПолучитьЗначениеXDTO(Assets, "AccompanyingDocumentLineNumber"));
	УстановитьЗначениеXDTO(Ценности, "НаимТов", ПолучитьЗначениеXDTO(Assets, "Product"));
	УстановитьЗначениеXDTO(Ценности, "ХарактТов", ПолучитьЗначениеXDTO(Assets, "ItemCharact"));
	УстановитьЗначениеXDTO(Ценности, "СортТов", ПолучитьЗначениеXDTO(Assets, "ItemKind"));
	УстановитьЗначениеXDTO(Ценности, "АртикулТов", ПолучитьЗначениеXDTO(Assets, "ItemArticle"));
	УстановитьЗначениеXDTO(Ценности, "КодТов", ПолучитьЗначениеXDTO(Assets, "ItemVendorCode"));
	УстановитьЗначениеXDTO(Ценности, "Паспорт", ПолучитьЗначениеXDTO(Assets, "PassportNumber"));
	
	// Информация по документам поставщика
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "AccordingToSellerDocument")
		И ЗначениеЗаполнено(AcceptanceResult.AccordingToSellerDocument.Quantity) Тогда
		
		ПоДокум = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "ПоДокум");
		XML_ЗаполнитьПринТовТип(
			ИмяПакетаXDTO,
			ПоДокум,
			AcceptanceResult.AccordingToSellerDocument,
			ПараметрыФормированияФайла
		);
		
	КонецЕсли;
	
	// Фактически
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "ActuallyAccepted")
		И ЗначениеЗаполнено(AcceptanceResult.ActuallyAccepted.Quantity) Тогда
		
		ПоФакту = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "ПоФакту");
		XML_ЗаполнитьПринТовТип(ИмяПакетаXDTO, ПоФакту, AcceptanceResult.ActuallyAccepted, ПараметрыФормированияФайла);
		
	КонецЕсли;
	
	// Брак
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "Reject")
		И ЗначениеЗаполнено(AcceptanceResult.Reject.Quantity) Тогда
		
		Брак = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "Брак");
		XML_ЗаполнитьРасхТип(ИмяПакетаXDTO, Брак, AcceptanceResult.Reject, ПараметрыФормированияФайла);
		
	КонецЕсли;
	
	// Бой
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "Breakage")
		И ЗначениеЗаполнено(AcceptanceResult.Breakage.Quantity) Тогда
		
		Бой = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "Бой");
		XML_ЗаполнитьРасхТип(ИмяПакетаXDTO, Бой, AcceptanceResult.Breakage, ПараметрыФормированияФайла);
		
	КонецЕсли;
	
	// Недостача
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "Shortfall")
		И ЗначениеЗаполнено(AcceptanceResult.Shortfall.Quantity) Тогда
		
		Недостача = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "Недостача");
		XML_ЗаполнитьРасхТип(ИмяПакетаXDTO, Недостача, AcceptanceResult.Shortfall, ПараметрыФормированияФайла);
		
	КонецЕсли;
	
	// Излишки
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "Surplus")
		И ЗначениеЗаполнено(AcceptanceResult.Surplus.Quantity) Тогда
		
		Излишки = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "Излишки");
		XML_ЗаполнитьРасхТип(ИмяПакетаXDTO, Излишки, AcceptanceResult.Surplus, ПараметрыФормированияФайла);
		
	КонецЕсли;
	
	// Ценовые отклонения
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "PriceDeviations") Тогда
		
		PriceDeviations = AcceptanceResult.PriceDeviations;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(PriceDeviations, "PositiveDeviations")
			И ЗначениеЗаполнено(PriceDeviations.PositiveDeviations.Subtotal) Тогда
			
			ЦенОтклон = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "ЦенОтклон");
			ПолДельта = НовыйДочернийОбъектXDTO(Фабрика, ЦенОтклон, "ПолДельта");
			XML_ЗаполнитьДельтаТип(ИмяПакетаXDTO, ПолДельта, PriceDeviations.PositiveDeviations, ПараметрыФормированияФайла);
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(PriceDeviations, "NegativeDeviations")
			И ЗначениеЗаполнено(PriceDeviations.NegativeDeviations.Subtotal) Тогда
			
			ЦенОтклон = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "ЦенОтклон");
			ОтрицатДельта = НовыйДочернийОбъектXDTO(Фабрика, ЦенОтклон, "ОтрицатДельта");
			XML_ЗаполнитьДельтаТип(ИмяПакетаXDTO, ОтрицатДельта, PriceDeviations.NegativeDeviations, ПараметрыФормированияФайла);
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Информационное поле сведений о результатах приемки ценностей (груза)
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(AcceptanceResult, "AdditionalInfos") Тогда
		
		Для Каждого AdditionalInfo Из AcceptanceResult.AdditionalInfos.AdditionalInfo Цикл
			ИнфПолРезПрием = НовыйДочернийОбъектXDTO(Фабрика, РезПрием, "ИнфПолРезПрием");
			XML_ЗаполнитьТекстИнфТип(ИнфПолРезПрием, AdditionalInfo);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(РезПрием, "ОКЕИ_Тов", ПолучитьЗначениеXDTO(AcceptanceResult, "Unit"));
	УстановитьЗначениеXDTO(РезПрием, "РасхРабУслПрав", ПолучитьЗначениеXDTO(AcceptanceResult, "AcceptanceDiscrepancyInfo"));
	УстановитьЗначениеXDTO(РезПрием, "НаимЕдИзм", ПолучитьЗначениеXDTO(AcceptanceResult, "UnitName"));
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьПодписантов(ИмяПакетаXDTO, Документ, Signers)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого Signer Из Signers Цикл
		
		Подписант = НовыйДочернийОбъектXDTO(Фабрика, Документ, "Подписант");
		
		SignerDetails = Signer.SignerDetails; // см. ExtendedSignerDetailsTorg2
		
		Если SignerDetails.SignerType = "LegalEntity" Тогда
			
			ЮЛ = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ЮЛ");
			
			ФИО = НовыйДочернийОбъектXDTO(Фабрика, ЮЛ, "ФИО");
			
			УстановитьЗначениеXDTO(ФИО, "Фамилия", SignerDetails.LastName);
			УстановитьЗначениеXDTO(ФИО, "Имя", SignerDetails.FirstName);
			УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(SignerDetails, "MiddleName"));
			
			УстановитьЗначениеXDTO(ЮЛ, "ИННЮЛ", SignerDetails.Inn);
			УстановитьЗначениеXDTO(ЮЛ, "НаимОрг", ПолучитьЗначениеXDTO(SignerDetails, "SignerOrganizationName"));
			УстановитьЗначениеXDTO(ЮЛ, "Должн", SignerDetails.Position);
			УстановитьЗначениеXDTO(ЮЛ, "ИныеСвед", ПолучитьЗначениеXDTO(SignerDetails, "SignerInfo"));
			
		ИначеЕсли SignerDetails.SignerType = "IndividualEntity" Тогда
			
			ИП = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ИП");
			
			ФИО = НовыйДочернийОбъектXDTO(Фабрика, ИП, "ФИО");
			
			УстановитьЗначениеXDTO(ФИО, "Фамилия", SignerDetails.LastName);
			УстановитьЗначениеXDTO(ФИО, "Имя", SignerDetails.FirstName);
			УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(SignerDetails, "MiddleName"));
			
			УстановитьЗначениеXDTO(ИП, "ИННФЛ", SignerDetails.Inn);
			УстановитьЗначениеXDTO(ИП, "СвГосРегИП", ПолучитьЗначениеXDTO(SignerDetails, "RegistrationCertificate"));
			УстановитьЗначениеXDTO(ИП, "ИныеСвед", ПолучитьЗначениеXDTO(SignerDetails, "SignerInfo"));
			
		Иначе
			
			ФЛ = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ФЛ");
			
			ФИО = НовыйДочернийОбъектXDTO(Фабрика, ФЛ, "ФИО");
			
			УстановитьЗначениеXDTO(ФИО, "Фамилия", SignerDetails.LastName);
			УстановитьЗначениеXDTO(ФИО, "Имя", SignerDetails.FirstName);
			УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(SignerDetails, "MiddleName"));
			
			УстановитьЗначениеXDTO(ФЛ, "ИННФЛ", ПолучитьЗначениеXDTO(SignerDetails, "Inn"));
			УстановитьЗначениеXDTO(ФЛ, "ИныеСвед", ПолучитьЗначениеXDTO(SignerDetails, "SignerInfo"));
			
		КонецЕсли;
		
		СтатусПодписанта = XML_СтатусПодписанта(SignerDetails.SignerStatus);
		ОбластьПолномочий = XML_ОбластьПолномочийПодписанта(SignerDetails.SignerPowers);
		
		УстановитьЗначениеXDTO(Подписант, "ОблПолн", ОбластьПолномочий);
		УстановитьЗначениеXDTO(Подписант, "Статус", СтатусПодписанта);
		УстановитьЗначениеXDTO(Подписант, "ОснПолн", SignerDetails.SignerPowersBase);
		УстановитьЗначениеXDTO(Подписант, "ОснПолнОрг", ПолучитьЗначениеXDTO(SignerDetails, "SignerOrgPowersBase"));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_ЗаполнитьСведенияПоИтогамПриемки(ИмяПакетаXDTO, СвИтПрием, Torg2RecipientTitle)
	
	ФорматДаты	 = "ДФ=dd.MM.yyyy";
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Torg2RecipientTitle, "AdditionalInfoId") Тогда
		ИнфПол = НовыйДочернийОбъектXDTO(Фабрика, СвИтПрием, "ИнфПол");
		XML_ЗаполнитьИнфПолТип(ИмяПакетаXDTO, ИнфПол, Torg2RecipientTitle.AdditionalInfoId);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(СвИтПрием, "ДатаСвИтПрием", Дата_В_Формат(Torg2RecipientTitle.CompilationInfoDate, ФорматДаты));
	УстановитьЗначениеXDTO(СвИтПрием, "СодСвИтПрием", Torg2RecipientTitle.TotalAcceptanceContent);
	
КонецПроцедуры

Процедура XML_Торг2_ЗаполнитьУчастникТип(ИмяПакетаXDTO, УчастникТип, ExtendedOrganizationInfo_Torg2)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ИдСв = НовыйДочернийОбъектXDTO(Фабрика, УчастникТип, "ИдСв");
	
	OrganizationDetails = ExtendedOrganizationInfo_Torg2.OrganizationDetails;
	OrgType = OrganizationDetails.OrgType;
	
	Если OrgType = "PhysicalEntity" Тогда
		
		// Сведения о физическом лице
		
		СвФЛ = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвФЛ");
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвФЛ, "ФИО");
		СтруктураФИО = XML_ПротоСтруктураФИО(OrganizationDetails.OrgName);
		XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
		
		УстановитьЗначениеXDTO(СвФЛ, "ИННФЛ", ПолучитьЗначениеXDTO(OrganizationDetails, "Inn"));
		УстановитьЗначениеXDTO(СвФЛ, "ИныеСвед", ПолучитьЗначениеXDTO(OrganizationDetails, "OrganizationOrPersonInfo"));
		
	ИначеЕсли OrgType = "IndividualEntity" Тогда
		
		// Сведения об индивидуальном предпринимателе
		
		СвИП = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвИП");
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвИП, "ФИО");
		СтруктураФИО = XML_ПротоСтруктураФИО(OrganizationDetails.OrgName);
		XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
		
		УстановитьЗначениеXDTO(СвИП, "ИННФЛ", OrganizationDetails.Inn);
		УстановитьЗначениеXDTO(СвИП, "СвГосРегИП", ПолучитьЗначениеXDTO(OrganizationDetails, "IndividualEntityRegistrationCertificate"));
		УстановитьЗначениеXDTO(СвИП, "ИныеСвед", ПолучитьЗначениеXDTO(OrganizationDetails, "OrganizationOrPersonInfo"));
		
	Иначе
		
		СвОрг = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвОрг");
		
		Если OrgType = "LegalEntity" Тогда
			
			// Сведения о юридическом лице, состоящем на учете в налоговых органах
			
			СвОргУч = НовыйДочернийОбъектXDTO(Фабрика, СвОрг, "СвОргУч");
			
			УстановитьЗначениеXDTO(СвОргУч, "ИННЮЛ", OrganizationDetails.Inn);
			УстановитьЗначениеXDTO(СвОргУч, "НаимОрг", OrganizationDetails.OrgName);
			УстановитьЗначениеXDTO(СвОргУч, "КПП", ПолучитьЗначениеXDTO(OrganizationDetails, "Kpp"));
			
		Иначе
			
			// Сведения об иностранном лице, не состоящем на учете в налоговых органах
			
			СвИнНеУч = НовыйДочернийОбъектXDTO(Фабрика, СвОрг, "СвИнНеУч");
			
			УстановитьЗначениеXDTO(СвИнНеУч, "НаимОрг", OrganizationDetails.OrgName);
			УстановитьЗначениеXDTO(СвИнНеУч, "Идентиф", ПолучитьЗначениеXDTO(OrganizationDetails, "LegalEntityId"));
			УстановитьЗначениеXDTO(СвИнНеУч, "ИныеСвед", ПолучитьЗначениеXDTO(OrganizationDetails, "OrganizationOrPersonInfo"));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(OrganizationDetails, "Address") Тогда
		Адрес = НовыйДочернийОбъектXDTO(Фабрика, УчастникТип, "Адрес");
		XML_ЗаполнитьАдресТип(ИмяПакетаXDTO, Адрес, OrganizationDetails.Address);
	КонецЕсли;
	
	// Контактные данные
	Тлф = ПолучитьЗначениеXDTO(OrganizationDetails, "Phone");
	ЭлПочта = ПолучитьЗначениеXDTO(OrganizationDetails, "Email");
	Если ЗначениеЗаполнено(Тлф) Или ЗначениеЗаполнено(ЭлПочта) Тогда
		Контакт = НовыйДочернийОбъектXDTO(Фабрика, УчастникТип, "Контакт");
		УстановитьЗначениеXDTO(Контакт, "Тлф", Тлф);
		УстановитьЗначениеXDTO(Контакт, "ЭлПочта", ЭлПочта);
	КонецЕсли;
	
	// Банковские реквизиты
	НаимБанк = ПолучитьЗначениеXDTO(OrganizationDetails, "BankName");
	БИК = ПолучитьЗначениеXDTO(OrganizationDetails, "BankId");
	КорСчет = ПолучитьЗначениеXDTO(OrganizationDetails, "CorrespondentAccount");
	НомерСчета = ПолучитьЗначениеXDTO(OrganizationDetails, "BankAccountNumber");
	
	ЕстьСвБанк = ЗначениеЗаполнено(НаимБанк) Или ЗначениеЗаполнено(БИК) Или ЗначениеЗаполнено(КорСчет);
	
	Если ЕстьСвБанк Или ЗначениеЗаполнено(НомерСчета) Тогда
		
		БанкРекв = НовыйДочернийОбъектXDTO(Фабрика, УчастникТип, "БанкРекв");
		
		УстановитьЗначениеXDTO(БанкРекв, "НомерСчета", НомерСчета);
		
		Если ЕстьСвБанк Тогда
			
			СвБанк = НовыйДочернийОбъектXDTO(Фабрика, БанкРекв, "СвБанк");
			УстановитьЗначениеXDTO(СвБанк, "НаимБанк", НаимБанк);
			УстановитьЗначениеXDTO(СвБанк, "БИК", БИК);
			УстановитьЗначениеXDTO(СвБанк, "КорСчет", КорСчет);
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(УчастникТип, "ОКПО", ПолучитьЗначениеXDTO(OrganizationDetails, "Okpo"));
	УстановитьЗначениеXDTO(УчастникТип, "СтруктПодр", ПолучитьЗначениеXDTO(OrganizationDetails, "Department"));
	УстановитьЗначениеXDTO(УчастникТип, "ИнфДляУчаст", ПолучитьЗначениеXDTO(OrganizationDetails, "OrganizationAdditionalInfo"));
	
КонецПроцедуры

// XML: функции заполнения Акта сверки 405

Процедура XML_АктСверки_ЗаполнитьСведенияОДокументе(ИмяПакетаXDTO, Документ, Content)
	
	// Сведения документа, кроме сведений таблицы акта сверки взаимных расчетов
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	СвДокКрАкт = НовыйДочернийОбъектXDTO(Фабрика, Документ, "СвДокКрАкт");
	
	// Отправитель
	СвОтпр = НовыйДочернийОбъектXDTO(Фабрика, СвДокКрАкт, "СвОтпр");
	XML_АктСверки_ЗаполнитьУчастникТип(ИмяПакетаXDTO, СвОтпр, Content.ReconciliationAct.AdditionalInfoReconciliationAct.Sender);
	
	// Получатель
	СвПол = НовыйДочернийОбъектXDTO(Фабрика, СвДокКрАкт, "СвПол");
	XML_АктСверки_ЗаполнитьУчастникТип(ИмяПакетаXDTO, СвПол, Content.ReconciliationAct.AdditionalInfoReconciliationAct.Recipient);
	
	УстановитьЗначениеXDTO(СвДокКрАкт, "КодОКВ", Content.ReconciliationAct.AdditionalInfoReconciliationAct.Currency);
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьУчастникТип(ИмяПакетаXDTO, СвОтпр, Content)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ИдСв = НовыйДочернийОбъектXDTO(Фабрика, СвОтпр, "ИдСв");
	
	OrgType = Content.Type;
	
	Если OrgType = "PhysicalEntity" Тогда
		
		// Сведения о физическом лице
		
		СвФЛ = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвФЛ");
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвФЛ, "ФИО");
		СтруктураФИО = XML_ПротоСтруктураФИО(Content.Name);
		XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
		
		УстановитьЗначениеXDTO(СвФЛ, "ИННФЛ", ПолучитьЗначениеXDTO(Content, "Inn"));
		
	ИначеЕсли OrgType = "IndividualEntity" Тогда
		
		// Сведения об индивидуальном предпринимателе
		
		СвИП = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвИП");
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвИП, "ФИО");
		СтруктураФИО = XML_ПротоСтруктураФИО(Content.Name);
		XML_ЗаполнитьФИОТип(ФИО, СтруктураФИО);
		
		УстановитьЗначениеXDTO(СвИП, "ИННФЛ", Content.Inn);
		УстановитьЗначениеXDTO(СвИП, "ОГРНИП", Content.Ogrn);
		
	ИначеЕсли OrgType = "LegalEntity" Тогда
		
		// Сведения о юридическом лице, состоящем на учете в налоговых органах
		
		СвЮЛУч = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвЮЛУч");
		
		УстановитьЗначениеXDTO(СвЮЛУч, "ИННЮЛ", Content.Inn);
		УстановитьЗначениеXDTO(СвЮЛУч, "НаимОрг", Content.Name);
		УстановитьЗначениеXDTO(СвЮЛУч, "КПП", ПолучитьЗначениеXDTO(Content, "Kpp"));
		УстановитьЗначениеXDTO(СвЮЛУч, "ОГРН", ПолучитьЗначениеXDTO(Content, "Ogrn"));
		
	ИначеЕсли OrgType = "ForeignEntity" Тогда
		
		// Сведения об иностранном лице, не состоящем на учете в налоговых органах
		
		СвИнНеУч = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвИнНеУч");
		
		УстановитьЗначениеXDTO(СвИнНеУч, "НаимОрг", Content.Name);
		УстановитьЗначениеXDTO(СвИнНеУч, "Идентиф", ПолучитьЗначениеXDTO(Content, "LegalEntityId"));
		
	Иначе
		
		ШаблонТекстаОшибки = "Неожиданный идентификатор типа участника сверки: %1";
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			ШаблонТекстаОшибки,
			OrgType
		);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	// Контактные данные
	Контакт = НовыйДочернийОбъектXDTO(Фабрика, СвОтпр, "Контакт");
	
	Тлф = ПолучитьЗначениеXDTO(Content, "Phone");
	ЭлПочта = ПолучитьЗначениеXDTO(Content, "Email");
	ИнКонт = ПолучитьЗначениеXDTO(Content, "AdditionalCont");
	
	УстановитьЗначениеXDTO(Контакт, "Тлф", Тлф);
	УстановитьЗначениеXDTO(Контакт, "ЭлПочта", ЭлПочта);
	УстановитьЗначениеXDTO(Контакт, "ИнКонт", ИнКонт);
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьТаблицуВзаиморасчетов(ИмяПакетаXDTO, Документ, Content)
	
	// Сведения таблицы акта сверки взаимных расчетов
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ТаблАкт = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ТаблАкт");
	
	ReconciliationActTable = Content.ReconciliationAct.ReconciliationActTable;
	
	XML_АктСверки_ЗаполнитьСведенияОДоговорах(ИмяПакетаXDTO, ТаблАкт, ReconciliationActTable);
	
	УстановитьЗначениеXDTO(ТаблАкт, "СальдоНачДеб", ПолучитьЗначениеXDTO(ReconciliationActTable, "BalanceDebitFrom"));
	УстановитьЗначениеXDTO(ТаблАкт, "СальдоНачКр", ПолучитьЗначениеXDTO(ReconciliationActTable, "BalanceAmountFrom"));
	УстановитьЗначениеXDTO(ТаблАкт, "ОборотДеб", ПолучитьЗначениеXDTO(ReconciliationActTable, "TurnoverDebit"));
	УстановитьЗначениеXDTO(ТаблАкт, "ОборотКр", ПолучитьЗначениеXDTO(ReconciliationActTable, "TurnoverAmount"));
	УстановитьЗначениеXDTO(ТаблАкт, "СальдоКонДеб", ПолучитьЗначениеXDTO(ReconciliationActTable, "BalanceDebitEnd"));
	УстановитьЗначениеXDTO(ТаблАкт, "СальдоКонКр", ПолучитьЗначениеXDTO(ReconciliationActTable, "BalanceAmountEnd"));
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьСведенияОДоговорах(ИмяПакетаXDTO, ТаблАкт, Content)
	
	// Сведения о договоре
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого Contract Из Content.ContractInfo Цикл
		
		ДогСв = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблАкт.ДогСв", ИмяПакетаXDTO);
		
		XML_АктСверки_ЗаполнитьСведенияОДокументах(ИмяПакетаXDTO, ДогСв, Contract);
		
		ДатаДог = ПолучитьЗначениеXDTO(Contract, "ContractDate");
		
		Если ЗначениеЗаполнено(ДатаДог) Тогда
			УстановитьЗначениеXDTO(ДогСв, "ДатаДог", Дата1С_в_ДатаXML(ДатаДог));
		КонецЕсли;
		
		УстановитьЗначениеXDTO(ДогСв, "ИдДог", ПолучитьЗначениеXDTO(Contract, "ContractId"));
		УстановитьЗначениеXDTO(ДогСв, "ОписТипДог", ПолучитьЗначениеXDTO(Contract, "ContractAdditionalInfo"));
		УстановитьЗначениеXDTO(ДогСв, "НомДог", ПолучитьЗначениеXDTO(Contract, "ContractNumber"));
		УстановитьЗначениеXDTO(ДогСв, "СальдоНачДеб", ПолучитьЗначениеXDTO(Contract, "BalanceDebitFrom"));
		УстановитьЗначениеXDTO(ДогСв, "СальдоНачКр", ПолучитьЗначениеXDTO(Contract, "BalanceAmountFrom"));
		УстановитьЗначениеXDTO(ДогСв, "ОборотДеб", ПолучитьЗначениеXDTO(Contract, "TurnoverDebit"));
		УстановитьЗначениеXDTO(ДогСв, "ОборотКр", ПолучитьЗначениеXDTO(Contract, "TurnoverAmount"));
		УстановитьЗначениеXDTO(ДогСв, "СальдоКонДеб", ПолучитьЗначениеXDTO(Contract, "BalanceDebitEnd"));
		УстановитьЗначениеXDTO(ДогСв, "СальдоКонКр", ПолучитьЗначениеXDTO(Contract, "BalanceAmountEnd"));
		
		ТаблАкт.ДогСв.Добавить(ДогСв);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьСведенияОДокументах(ИмяПакетаXDTO, ДогСв, Content)
	
	// Сведения о документах
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого Document Из Content.DocumentInfo Цикл
		
		ДокСв = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблАкт.ДогСв.ДокСв", ИмяПакетаXDTO);
		
		XML_АктСверки_ЗаполнитьСведенияОбОперациях(ИмяПакетаXDTO, ДокСв, Document);
		
		УстановитьЗначениеXDTO(ДокСв, "НаимДок", Document.DocumentName);
		УстановитьЗначениеXDTO(ДокСв, "НомДок", Document.DocumentNumber);
		УстановитьЗначениеXDTO(ДокСв, "ДатаДок", Дата1С_в_ДатаXML(Document.DocumentDate));
		УстановитьЗначениеXDTO(ДокСв, "ИдДок", ПолучитьЗначениеXDTO(Document, "DocumentId"));
		УстановитьЗначениеXDTO(ДокСв, "ДопИнф", ПолучитьЗначениеXDTO(Document, "AdditionalInfo"));
		
		ДогСв.ДокСв.Добавить(ДокСв);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьСведенияОбОперациях(ИмяПакетаXDTO, ДокСв, Content)
	
	// Сведения об операциях
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого Operation Из Content.OperationInfo Цикл
		
		СвОпер = XML_ПолучитьПустойОбъектXDTO("Файл.Документ.ТаблАкт.ДогСв.ДокСв.СвОпер", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(СвОпер, "НомСтр", Operation.StringNumber);
		УстановитьЗначениеXDTO(СвОпер, "ДатаОпер", Дата1С_в_ДатаXML(Operation.OperationDate));
		УстановитьЗначениеXDTO(СвОпер, "НаимОпер", Operation.OperationName);
		УстановитьЗначениеXDTO(СвОпер, "СумДебет", ПолучитьЗначениеXDTO(Operation, "SumDebit"));
		УстановитьЗначениеXDTO(СвОпер, "СумКредит", ПолучитьЗначениеXDTO(Operation, "SumAmount"));
		
		ДокСв.СвОпер.Добавить(СвОпер);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьПодписанта(ИмяПакетаXDTO, Документ, Content)
	
	// Сведения о лице, подписавшем информацию отправителя в электронной форме
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Подписант = НовыйДочернийОбъектXDTO(Фабрика, Документ, "Подписант");
	
	SignerDetails = Content.ReconciliationAct.Signer;
	
	XML_АктСверки_ЗаполнитьСведенияОДоверенности(Фабрика, Подписант, SignerDetails);
	
	XML_АктСверки_ЗаполнитьСведенияОБумажнойДоверенности(Фабрика, Подписант, SignerDetails);
	
	XML_АктСверки_ЗаполнитьСведенияОПодписанте(Фабрика, Подписант, SignerDetails);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(SignerDetails, "SignerStatus")
		И ЗначениеЗаполнено(SignerDetails.SignerStatus) Тогда
		
		СтатусПодписанта = XML_АктСверки_СтатусПодписанта(SignerDetails.SignerStatus);
		УстановитьЗначениеXDTO(Подписант, "СтатПодп", СтатусПодписанта);
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(SignerDetails, "SignatureType")
		И ЗначениеЗаполнено(SignerDetails.SignatureType) Тогда
		
		ТипПодписи = XML_АктСверки_ТипПодписи(SignerDetails.SignatureType);
		УстановитьЗначениеXDTO(Подписант, "ТипПодпис", ТипПодписи);
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Подписант, "ИдСистХран", ПолучитьЗначениеXDTO(SignerDetails, "IdSystemStorage"));
	УстановитьЗначениеXDTO(Подписант, "Должн", ПолучитьЗначениеXDTO(SignerDetails, "JobTitle"));
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьСведенияОДоверенности(Фабрика, Подписант, Content)
	
	// Сведения о доверенности, используемой для подтверждения полномочий в электронной форме
	
	DigitalAttorneyInfo = Content.DigitalAttorneyInfo;
	
	Если НЕ ОбъектXDTOЗаполнен(DigitalAttorneyInfo) Тогда
		Возврат;
	КонецЕсли;
	
	СвДовер = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "СвДовер");
	
	ДатаНач = ПолучитьЗначениеXDTO(DigitalAttorneyInfo, "Date");
	ДатаВнРегДовер = ПолучитьЗначениеXDTO(DigitalAttorneyInfo, "InternalDate");
	
	УстановитьЗначениеXDTO(СвДовер, "НомДовер", ПолучитьЗначениеXDTO(DigitalAttorneyInfo, "Number"));
	УстановитьЗначениеXDTO(СвДовер, "ДатаНач", Дата1С_в_ДатаXML(ДатаНач));
	УстановитьЗначениеXDTO(СвДовер, "ВнНомДовер", ПолучитьЗначениеXDTO(DigitalAttorneyInfo, "InternalNumber"));
	УстановитьЗначениеXDTO(СвДовер, "ДатаВнРегДовер", Дата1С_в_ДатаXML(ДатаВнРегДовер));
	УстановитьЗначениеXDTO(СвДовер, "СведСистОтм", ПолучитьЗначениеXDTO(DigitalAttorneyInfo, "CancelAdditionalInfo"));
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьСведенияОБумажнойДоверенности(Фабрика, Подписант, Content)
	
	// Сведения о доверенности, используемой для подтверждения полномочий в бумажном вид
	
	PaperAttorneyInfo = Content.PaperAttorneyInfo;
	
	Если НЕ ОбъектXDTOЗаполнен(PaperAttorneyInfo) Тогда
		Возврат;
	КонецЕсли;
	
	СвДоверБум = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "СвДоверБум");
	
	ДатаДовер = ПолучитьЗначениеXDTO(PaperAttorneyInfo, "Date");
	
	УстановитьЗначениеXDTO(СвДоверБум, "ДатаДовер", Дата1С_в_ДатаXML(ДатаДовер));
	УстановитьЗначениеXDTO(СвДоверБум, "ВнНомДовер", ПолучитьЗначениеXDTO(PaperAttorneyInfo, "InternalNumber"));
	УстановитьЗначениеXDTO(СвДоверБум, "СвИдДовер", ПолучитьЗначениеXDTO(PaperAttorneyInfo, "IssuerAdditionalInfo"));
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, СвДоверБум, "ФИО");
	
	Official = PaperAttorneyInfo.Official;
	
	УстановитьЗначениеXDTO(ФИО, "Фамилия", Official.Surname);
	УстановитьЗначениеXDTO(ФИО, "Имя", Official.FirstName);
	УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(Official, "Patronymic"));
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьСведенияОПодписанте(Фабрика, Подписант, Content)
	
	// Фамилия, имя, отчество (при наличии)
	
	Official = Content.Official;
	
	Если НЕ ОбъектXDTOЗаполнен(Official) Тогда
		Возврат;
	КонецЕсли;
	
	ФИО = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ФИО");
	
	УстановитьЗначениеXDTO(ФИО, "Фамилия", Official.Surname);
	УстановитьЗначениеXDTO(ФИО, "Имя", Official.FirstName);
	УстановитьЗначениеXDTO(ФИО, "Отчество", ПолучитьЗначениеXDTO(Official, "Patronymic"));
	
КонецПроцедуры

Процедура XML_АктСверки_ЗаполнитьОсновныеСведенияФайла(ИмяПакетаXDTO, Файл, Документ, Content, КНД, ВерсияФормата, ПараметрыФормированияФайла)
	
	ИдентификаторОтправителя = ПараметрыФормированияФайла.ИдентификаторОтправителя;
	ИдентификаторПолучателя = ПараметрыФормированияФайла.ИдентификаторПолучателя;
	
	Если Не ЗначениеЗаполнено(ИдентификаторОтправителя) Или Не ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		ИдентификаторПолучателя	 = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Recipient.FnsParticipantId;
		ИдентификаторОтправителя = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Sender.FnsParticipantId;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОтправителя)
		ИЛИ НЕ ЗначениеЗаполнено(ИдентификаторПолучателя) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не заполнены идентификаторы отправителя или получателя'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ВерсПрог = XML_ВерсияПрограммыФормированияФайла();
	ДопПрефикс = "";
	
	ИдФайл = XML_ИдФайл(
		ИмяПакетаXDTO,
		ДопПрефикс,
		ИдентификаторПолучателя,
		ИдентификаторОтправителя,
		ПараметрыФормированияФайла
	);
	
	УстановитьЗначениеXDTO(Файл, "ИдФайл", ИдФайл);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм", ВерсияФормата);
	УстановитьЗначениеXDTO(Файл, "ВерсПрог", ВерсПрог);
	УстановитьЗначениеXDTO(Документ, "КНД", КНД);
	
	// Дата и время формирования файла
	ДатаФормирования = Дата1С_в_ДатаXML(ПараметрыФормированияФайла.ДатаФормирования);
	ВремяФормирования = Время1С_в_ВремяXML(ПараметрыФормированияФайла.ДатаФормирования);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ДатаИнфОтпр") Тогда
		
		УстановитьЗначениеXDTO(Документ, "ДатаИнфОтпр", ДатаФормирования);
		УстановитьЗначениеXDTO(Документ, "ВрИнфОтпр", ВремяФормирования);
		
	КонецЕсли;
	
	ДатаНачПер = Дата1С_в_ДатаXML(Content.ReconcilationDateFrom);
