		УстановитьЗначениеXDTO(Результат, "DocumentNumber", Контент970.MainAssignMonetaryClaim.Number);
		УстановитьЗначениеXDTO(Результат, "DocumentDate", Контент970.MainAssignMonetaryClaim.Date);
		УстановитьЗначениеXDTO(Результат, "BaseDocumentId", Контент970.MainAssignMonetaryClaim.ID);
		УстановитьЗначениеXDTO(Результат, "DocumentInfo", Контент970.MainAssignMonetaryClaim.AdditionalInfo);
		
