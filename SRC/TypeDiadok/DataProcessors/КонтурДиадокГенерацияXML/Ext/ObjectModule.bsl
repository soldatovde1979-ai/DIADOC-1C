Функция ВалидацияТорг2_Участник(ExtendedOrganizationInfo_Torg2)
	
	СписокОшибок = Новый Массив;
	
	OrganizationDetails = ExtendedOrganizationInfo_Torg2.OrganizationDetails;
	
	Если OrganizationDetails.OrgType = "4" Тогда
		
		// Сведения о физическом лице
		
		Ошибки = ПроверитьФИО(OrganizationDetails.OrgName);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в ФИО физического лица");
		
		Если ЗначениеЗаполнено(OrganizationDetails.Inn) Тогда
			Ошибки = ПроверитьИННКонтрагента(OrganizationDetails.Inn, "ФизЛицо");
			ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(OrganizationDetails.OrganizationOrPersonInfo) Тогда
			ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.OrganizationOrPersonInfo, "Иные сведения, идентифицирующие физическое лицо", , 1, 255, , , "множ");
		КонецЕсли;
		
	ИначеЕсли OrganizationDetails.OrgType = "2" Тогда
		
		// Сведения об индивидуальном предпринимателе
		
		Ошибки = ПроверитьФИО(OrganizationDetails.OrgName);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в ФИО индивидуального предпринимателя");
		
		Ошибки = ПроверитьИННКонтрагента(OrganizationDetails.Inn, "ФизЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
		
		Если ЗначениеЗаполнено(OrganizationDetails.IndividualEntityRegistrationCertificate) Тогда
			ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.IndividualEntityRegistrationCertificate, "Реквизиты свидетельства о государственной регистрации ИП", , 1, 100, , , "множ");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(OrganizationDetails.OrganizationOrPersonInfo) Тогда
			ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.OrganizationOrPersonInfo, "Иные сведения, идентифицирующие физическое лицо", , 1, 255, , , "множ");
		КонецЕсли;
		
	Иначе
		
		ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.OrgName, "Наименование организации", Истина, 1, 1000, , "с");
		
		Если OrganizationDetails.OrgType = "1" Тогда
			
			// Сведения о юридическом лице, состоящем на учете в налоговых органах
			
			Ошибки = ПроверитьИННКонтрагента(OrganizationDetails.Inn, "ЮрЛицо");
			ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
			
			Если ЗначениеЗаполнено(OrganizationDetails.Kpp) Тогда
				Ошибки = ПроверитьКППКонтрагента(OrganizationDetails.Kpp);
				ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
			КонецЕсли;
			
		Иначе
			
			// Сведения об иностранном лице, не состоящем на учете в налоговых органах
			
			Если ЗначениеЗаполнено(OrganizationDetails.LegalEntityId) Тогда
				ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.LegalEntityId, "Идентификатор юридического лица", , 1, 255);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(OrganizationDetails.OrganizationOrPersonInfo) Тогда
				ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.OrganizationOrPersonInfo, "Иные сведения, идентифицирующие организацию", , 1, 255, , , "множ");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Ошибки = ВалидацияТорг2_Адрес(OrganizationDetails.Address);
	ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в адресе");
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.Okpo, "Код в общероссийском классификаторе предприятий и организаций", , 1, 10);
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.Phone, "Номер контактного телефона/факс", , 1, 255);
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.Email, "Адрес электронной почты", , 1, 255);
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.CorrespondentAccount, "Корреспондентский счёт", , 1, 20);
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.BankAccountNumber, "Номер банковского счета", , 1, 20);
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.BankName, "Название банка", , 1, 1000, , "с");
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.BankId, "БИК", , 1, 9);
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.Department, "Структурное подразделение", , 1, 1000, , "с");
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.OrganizationAdditionalInfo, "Информация для участника", , 1, 255, , "ж");
	ПроверитьФорматПоля(СписокОшибок, OrganizationDetails.Country, "Страна", , 1, 255, , "ж");
	
	Возврат СписокОшибок;
	
КонецФункции

