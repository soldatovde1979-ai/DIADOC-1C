Процедура XML_Торг2_ЗаполнитьСведенияОДокументе(Фабрика, Документ, Content)
	
	ПоФактХЖ = "Документ о приемке ценностей и (или) расхождениях, выявленных при их приемке";
	НаимДокОпр = НаименованиеПервичногоДокументаИзПрото(Content);
	
	УстановитьЗначениеXDTO(Документ, "ПоФактХЖ"		, ПоФактХЖ);
	УстановитьЗначениеXDTO(Документ, "НаимДокОпр"	, НаимДокОпр);
	
	// Обстоятельства составления документа
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "CircumDraft") Тогда
		УстановитьЗначениеXDTO(Документ, "ОбстСостДок", Content.CircumDraft);
	КонецЕсли;
	
	// Назначение и подписанты дополнительных сведений
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "AdditionalInfosPurpose") Тогда
		УстановитьЗначениеXDTO(Документ, "НазнДопСв", Content.AdditionalInfosPurpose);
	КонецЕсли;
	
	// Информация о формировании дополнительных сведений к документу
	Для Каждого DocumentAdditionalInfo Из Content.DocumentAdditionalInfos.DocumentAdditionalInfo Цикл
		Документ.ИнфДопСв.Добавить(DocumentAdditionalInfo);
	КонецЦикла;
	
	// Дата и номер документа о приемке и (или) расхождениях
	ИдентДокПР = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ИдентДокПР");
	УстановитьЗначениеXDTO(ИдентДокПР, "НомДокПР", Content.DocumentNumber);
	УстановитьЗначениеXDTO(ИдентДокПР, "ДатаДокПР", Дата_В_Формат(Content.DocumentDate, "ДФ=dd.MM.yyyy"));
	
	// Исправление документа о приемке и (или) расхождениях
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "RevisionInfo")
		И ОбъектXDTOЗаполнен(Content.RevisionInfo) Тогда
		ИспрДокПР = НовыйДочернийОбъектXDTO(Фабрика, Документ, "ИспрДокПР");
		УстановитьЗначениеXDTO(ИспрДокПР, "НомИспрДокПР", Content.RevisionInfo.RevisionNumber);
		УстановитьЗначениеXDTO(ИспрДокПР, "ДатаИспрДокПР", Дата_В_Формат(Content.RevisionInfo.RevisionDate, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
КонецПроцедуры

Функция НаименованиеПервичногоДокументаИзПрото(Content)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "DocumentName") Тогда // 820@, 423@ (Торг2)
		Результат = Content.DocumentName;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Content, "Name") Тогда // 155@, 189@
		Результат = Content.Name;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура XML_ЗаполнитьСведенияОКонтрагенте(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	// Основные сведения
	УстановитьЗначениеXDTO(ОбъектXDTO, "ОКПО"		, ПротоКонтент.Okpo);
	УстановитьЗначениеXDTO(ОбъектXDTO, "СтруктПодр"	, ПротоКонтент.Department);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИнфДляУчаст", ПротоКонтент.AdditionalInfo);
	
	ИдСв = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ИдСв");
	
	Если ПротоКонтент.Type = "LegalEntity" Тогда
		
		XML_ЗаполнитьЮридическоеЛицоКонтрагента(ИмяПакетаXDTO, ИдСв, ПротоКонтент);
		
	ИначеЕсли ПротоКонтент.Type = "IndividualEntity" Тогда
		
		XML_ЗаполнитьИндивидуальногоПредпринимателяКонтрагента_820(ИмяПакетаXDTO, ИдСв, ПротоКонтент);
		
	ИначеЕсли ПротоКонтент.Type = "PhysicalEntity" Тогда
		
		XML_ЗаполнитьФизическоеЛицоКонтрагента(ИмяПакетаXDTO, ИдСв, ПротоКонтент);
		
	ИначеЕсли ПротоКонтент.Type = "ForeignEntity" Тогда
		
		XML_ЗаполнитьИностранноеЛицоКонтрагента(ИмяПакетаXDTO, ИдСв, ПротоКонтент);
		
	КонецЕсли;
	
	// Адрес
	Адрес = XML_ПолучитьПустойОбъектXDTO("АдресТип", ИмяПакетаXDTO);
	Если XML_ЗаполнитьАдрес(ИмяПакетаXDTO, Адрес, ПротоКонтент.Address) Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "Адрес", Адрес);
	КонецЕсли;
	
	// Контакты: телефон и эл.почта
	Если ЗначениеЗаполнено(ПротоКонтент.Phone) ИЛИ ЗначениеЗаполнено(ПротоКонтент.Email) Тогда
		
		Контакт = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "Контакт");
		УстановитьЗначениеXDTO(Контакт, "Тлф"		, ПротоКонтент.Phone);
		УстановитьЗначениеXDTO(Контакт, "ЭлПочта"	, ПротоКонтент.Email);
		
	КонецЕсли;
	
	// Банковские реквизиты
	Если БанковскиеРеквизитыКонтрагентаЗаполнены(ПротоКонтент) Тогда
		
		БанкРекв = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO	, "БанкРекв");
		СвБанк	 = НовыйДочернийОбъектXDTO(Фабрика, БанкРекв	, "СвБанк");
		
		Если ЗначениеЗаполнено(ПротоКонтент.BankAccountNumber) Тогда
			УстановитьЗначениеXDTO(БанкРекв, "НомерСчета", ПротоКонтент.BankAccountNumber);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.BankName) Тогда
			УстановитьЗначениеXDTO(СвБанк, "НаимБанк", ПротоКонтент.BankName);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.BankId) Тогда
			УстановитьЗначениеXDTO(СвБанк, "БИК", ПротоКонтент.BankId);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.CorrespondentAccount) Тогда
			УстановитьЗначениеXDTO(СвБанк, "КорСчет", ПротоКонтент.CorrespondentAccount);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьСведенияОКонтрагенте_970(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ОКПО", ПротоКонтент.Okpo);
	УстановитьЗначениеXDTO(ОбъектXDTO, "КодОПФ", ПротоКонтент.Okopf);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ПолнНаимОПФ", ПротоКонтент.FullNameOPF);
	УстановитьЗначениеXDTO(ОбъектXDTO, "СтруктПодр", ПротоКонтент.Department);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ИнфДляУчаст", ПротоКонтент.AdditionalInfo);

	XML_ЗаполнитьИдСв(ОбъектXDTO, ПротоКонтент, ИмяПакетаXDTO);
	
	XML_ЗаполнитьАдрес_970(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент.Address);
	
	Если ПротоКонтент.Phone.Количество() > 0
		Или ПротоКонтент.Email.Количество() > 0
		Или ЗначениеЗаполнено(ПротоКонтент.OtherContactInfo) Тогда
		
		XML_ЗаполнитьКонтактТип(ОбъектXDTO, ПротоКонтент, ИмяПакетаXDTO);
		
	КонецЕсли;

	Если БанковскиеРеквизитыКонтрагентаЗаполнены(ПротоКонтент) Тогда
		XML_ЗаполнитьБанкРекв_970(ОбъектXDTO, ПротоКонтент, ИмяПакетаXDTO);
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьИдСв(ОбъектXDTO, ПротоКонтент, ИмяПакетаXDTO)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	ИдСв = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ИдСв");
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ПротоКонтент.Type = ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		XML_ЗаполнитьЮридическоеЛицоКонтрагента(ИмяПакетаXDTO, ИдСв, ПротоКонтент);
		
	ИначеЕсли ПротоКонтент.Type = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		
		СвИП = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвИП");
		XML_ЗаполнитьСведенияОбИндивидуальномПредпринимателе(ИмяПакетаXDTO, СвИП, ПротоКонтент);
		
	ИначеЕсли ПротоКонтент.Type = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		СвФЛУч = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвФЛУч");
		XML_ЗаполнитьСведенияОФизическомЛице(ИмяПакетаXDTO, СвФЛУч, ПротоКонтент);
		
	ИначеЕсли ПротоКонтент.Type = ВидыЮрФизЛиц.ИностраннаяОрганизация
		Или ПротоКонтент.Type = ВидыЮрФизЛиц.ИностранныйГражданин Тогда
		
		СвИнНеУчТип = НовыйДочернийОбъектXDTO(Фабрика, ИдСв, "СвИнНеУч");
		
		XML_УПД_970_ЗаполнитьСведенияОИностраннойОрганизации(СвИнНеУчТип, ПротоКонтент);
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Процедура XML_ЗаполнитьКонтактТип(ОбъектXDTO, ПротоКонтент, ИмяПакетаXDTO)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Контакт = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "Контакт");
	
	Для Каждого НомерТелефона Из ПротоКонтент.Phone Цикл
		Контакт.Тлф.Добавить(НомерТелефона);	
	КонецЦикла;
	
	Для Каждого АдресЭлПочты Из ПротоКонтент.Email Цикл
		Контакт.ЭлПочта.Добавить(АдресЭлПочты);
	КонецЦикла;
	
	УстановитьЗначениеXDTO(Контакт, "ИнКонт", ПротоКонтент.OtherContactInfo);
	
КонецПроцедуры

Процедура XML_ЗаполнитьБанкРекв_970(ОбъектXDTO, ПротоКонтент, ИмяПакетаXDTO)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	БанкРекв = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "БанкРекв");
	СвБанк = НовыйДочернийОбъектXDTO(Фабрика, БанкРекв, "СвБанк");
	
	Если ЗначениеЗаполнено(ПротоКонтент.BankAccountNumber) Тогда
		УстановитьЗначениеXDTO(БанкРекв, "НомерСчета", ПротоКонтент.BankAccountNumber);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоКонтент.BankName) Тогда
		УстановитьЗначениеXDTO(СвБанк, "НаимБанк", ПротоКонтент.BankName);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоКонтент.BankId) Тогда
		УстановитьЗначениеXDTO(СвБанк, "БИК", ПротоКонтент.BankId);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоКонтент.CorrespondentAccount) Тогда
		УстановитьЗначениеXDTO(СвБанк, "КорСчет", ПротоКонтент.CorrespondentAccount);
	КонецЕсли;
	
КонецПроцедуры

Функция БанковскиеРеквизитыКонтрагентаЗаполнены(ПротоКонтент)
	
	Результат = ЗначениеЗаполнено(ПротоКонтент.BankAccountNumber)
				Или ЗначениеЗаполнено(ПротоКонтент.BankName)
				Или ЗначениеЗаполнено(ПротоКонтент.BankId)
				Или ЗначениеЗаполнено(ПротоКонтент.CorrespondentAccount);
	Возврат Результат;
	
КонецФункции

Функция XML_ЗаполнитьАдрес(ИмяПакетаXDTO, ОбъектXDTO, Address)

	Результат = Истина;  // признак - был ли заполнен адрес
	
	Если ЗначениеЗаполнено(Address.AddressCode) Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "КодГАР", Address.AddressCode);
	
	ИначеЕсли Address.IsForeign = Ложь Тогда
		
		АдрРФ = XML_ПолучитьПустойОбъектXDTO("АдрРФТип", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(АдрРФ, "Индекс", 	Address.ZipCode);
		УстановитьЗначениеXDTO(АдрРФ, "КодРегион", 	Address.RegionCode);
		УстановитьЗначениеXDTO(АдрРФ, "Район", 		Address.Territory);
		УстановитьЗначениеXDTO(АдрРФ, "Город", 		Address.City);
		УстановитьЗначениеXDTO(АдрРФ, "НаселПункт", Address.Locality);
		УстановитьЗначениеXDTO(АдрРФ, "Улица", 		Address.Street);
		УстановитьЗначениеXDTO(АдрРФ, "Дом", 		Address.Building);
		УстановитьЗначениеXDTO(АдрРФ, "Корпус", 	Address.Block);
		УстановитьЗначениеXDTO(АдрРФ, "Кварт", 		Address.Apartment);
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "АдрРФ", АдрРФ);
		
	ИначеЕсли ЗначениеЗаполнено(Address.CountryCode) Или ЗначениеЗаполнено(Address.AddressText) Тогда
		
		АдрИнф = XML_ПолучитьПустойОбъектXDTO("АдрИнфТип", ИмяПакетаXDTO);
		
		УстановитьЗначениеXDTO(АдрИнф, "КодСтр",	Address.CountryCode);
		УстановитьЗначениеXDTO(АдрИнф, "АдрТекст",	Address.AddressText);
		
		Если ОбъектXDTO.Свойства().Получить("АдрИнф") <> Неопределено Тогда
			УстановитьЗначениеXDTO(ОбъектXDTO, "АдрИнф", АдрИнф);
		Иначе
			УстановитьЗначениеXDTO(ОбъектXDTO, "АдрИно", АдрИнф);
		КонецЕсли;
		
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Процедура XML_ЗаполнитьАдрес_970(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Адрес = Неопределено;

	ВидыАдресов = Перечисление_ВидыАдресов();
	
	Если ПротоКонтент.Type = ВидыАдресов.АдресРФ Тогда
		
		Адрес = XML_ЗаполнитьАдресРФ(ИмяПакетаXDTO, ПротоКонтент.AddressRF);	
		
	ИначеЕсли ПротоКонтент.Type = ВидыАдресов.АдресГАР Тогда
		
		Адрес = XML_ЗаполнитьАдресГАР(ИмяПакетаXDTO, ПротоКонтент.AddressSAR);
		
	ИначеЕсли ПротоКонтент.Type = ВидыАдресов.АдресСтрокой Тогда
		
		Адрес = XML_ЗаполнитьАдресСтрокой(ИмяПакетаXDTO, ПротоКонтент.AddressText);
		
	КонецЕсли;
	
	Если Адрес <> Неопределено Тогда
		
		УстановитьЗначениеXDTO(Адрес, "ГЛНМеста", ПротоКонтент.GLN);
		УстановитьЗначениеXDTO(ОбъектXDTO, "Адрес", Адрес);

	КонецЕсли;
	
КонецПроцедуры

Функция XML_ЗаполнитьАдресРФ(ИмяПакетаXDTO, ПротоКонтент)
	
	Перем АдресТип;
	
	Если ПротоКонтент <> Неопределено И ЗначениеЗаполнено(ПротоКонтент.Region) Тогда
		
		АдресТип = XML_ПолучитьПустойОбъектXDTO("АдресТип", ИмяПакетаXDTO);
		
		Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
		АдрРФ = НовыйДочернийОбъектXDTO(Фабрика, АдресТип, "АдрРФ");
		
		УстановитьЗначениеXDTO(АдрРФ, "Индекс", ПротоКонтент.ZipCode);
		УстановитьЗначениеXDTO(АдрРФ, "КодРегион", ПротоКонтент.RegionCode);
		УстановитьЗначениеXDTO(АдрРФ, "НаимРегион", АдаптацияНазванияРегиона(ПротоКонтент.Region));
		УстановитьЗначениеXDTO(АдрРФ, "Район", ПротоКонтент.Territory);
		УстановитьЗначениеXDTO(АдрРФ, "Город", ПротоКонтент.City);
		УстановитьЗначениеXDTO(АдрРФ, "НаселПункт", ПротоКонтент.Locality);
		УстановитьЗначениеXDTO(АдрРФ, "Улица", ПротоКонтент.Street);
		УстановитьЗначениеXDTO(АдрРФ, "Дом", ПротоКонтент.Building);
		УстановитьЗначениеXDTO(АдрРФ, "Корпус", ПротоКонтент.Block);
		УстановитьЗначениеXDTO(АдрРФ, "Кварт", ПротоКонтент.Apartment);
		УстановитьЗначениеXDTO(АдрРФ, "ИныеСвед", ПротоКонтент.AdditionalInfo);
		
	КонецЕсли;
	
	Возврат АдресТип;
	
КонецФункции

Функция XML_ЗаполнитьАдресГАР(ИмяПакетаXDTO, ПротоКонтент)
	
	Перем АдресТип;
	
	Если ПротоКонтент <> Неопределено И ЗначениеЗаполнено(ПротоКонтент.ID) Тогда
		
		АдресТип = XML_ПолучитьПустойОбъектXDTO("АдресТип", ИмяПакетаXDTO);
		
		Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
		АдрГАР = НовыйДочернийОбъектXDTO(Фабрика, АдресТип, "АдрГАР");
		
		УстановитьЗначениеXDTO(АдрГАР, "ИдНом", ПротоКонтент.ID);
		УстановитьЗначениеXDTO(АдрГАР, "Индекс", ПротоКонтент.ZipCode);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(АдрГАР, "КодРегион") Тогда
			УстановитьЗначениеXDTO(АдрГАР, "КодРегион", ПротоКонтент.RegionCode);
		Иначе
			УстановитьЗначениеXDTO(АдрГАР, "Регион", ПротоКонтент.RegionCode);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(АдрГАР, "НаимРегион", АдаптацияНазванияРегиона(ПротоКонтент.Region));
		
		Если ЗначениеЗаполнено(ПротоКонтент.MunicipalDistrictCode) Тогда
			ВидНаимКодТип = XML_НовыйВидНаимКодТип(ИмяПакетаXDTO, ПротоКонтент.MunicipalDistrictCode, ПротоКонтент.MunicipalDistrict);
			УстановитьЗначениеXDTO(АдрГАР, "МуниципРайон", ВидНаимКодТип);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.SettlementCode) Тогда
			ВидНаимКодТип = XML_НовыйВидНаимКодТип(ИмяПакетаXDTO, ПротоКонтент.SettlementCode, ПротоКонтент.Settlement);
			УстановитьЗначениеXDTO(АдрГАР, "ГородСелПоселен", ВидНаимКодТип);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.LocalityType) Тогда
			ВидНаимТип = XML_НовыйВидНаимТип(ИмяПакетаXDTO, ПротоКонтент.LocalityType, ПротоКонтент.Locality);
			УстановитьЗначениеXDTO(АдрГАР, "НаселенПункт", ВидНаимТип);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.PlanningElementType) Тогда
			ТипНаимТип = XML_НовыйТипНаимТип(ИмяПакетаXDTO, ПротоКонтент.PlanningElementType, ПротоКонтент.PlanningElement);
			УстановитьЗначениеXDTO(АдрГАР, "ЭлПланСтруктур", ТипНаимТип);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.StreetElementType) Тогда
			ТипНаимТип = XML_НовыйТипНаимТип(ИмяПакетаXDTO, ПротоКонтент.StreetElementType, ПротоКонтент.StreetElement);
			УстановитьЗначениеXDTO(АдрГАР, "ЭлУлДорСети", ТипНаимТип);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.StreetElementType) Тогда
			ТипНаимТип = XML_НовыйТипНаимТип(ИмяПакетаXDTO, ПротоКонтент.StreetElementType, ПротоКонтент.StreetElement);
			УстановитьЗначениеXDTO(АдрГАР, "ЭлУлДорСети", ТипНаимТип);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(АдрГАР, "ЗемелУчасток", ПротоКонтент.LandPlot);
		
		Для Каждого BuildingInfo Из ПротоКонтент.Buildings Цикл
			
			НовыйЭл = НовыйДочернийОбъектXDTO(Фабрика, АдрГАР, "Здание");
			
			УстановитьЗначениеXDTO(НовыйЭл, "Тип", BuildingInfo.Type);
			УстановитьЗначениеXDTO(НовыйЭл, "Номер", BuildingInfo.Number);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ПротоКонтент.HouseType) Тогда
			НомерТип = XML_НовыйНомерТип(ИмяПакетаXDTO, ПротоКонтент.HouseType, ПротоКонтент.House);
			УстановитьЗначениеXDTO(АдрГАР, "ПомещЗдания", НомерТип);
		КонецЕсли;
		
	Если ЗначениеЗаполнено(ПротоКонтент.ApartmentType) Тогда
			НомерТип = XML_НовыйНомерТип(ИмяПакетаXDTO, ПротоКонтент.ApartmentType, ПротоКонтент.Apartment);
			УстановитьЗначениеXDTO(АдрГАР, "ПомещКвартиры", НомерТип);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АдресТип;
	
КонецФункции

Функция XML_ЗаполнитьАдресСтрокой(ИмяПакетаXDTO, ПротоКонтент)
	
	Перем АдресТип;
	
	Если ПротоКонтент <> Неопределено И ЗначениеЗаполнено(ПротоКонтент.AddressText) Тогда
		
		АдресТип = XML_ПолучитьПустойОбъектXDTO("АдресТип", ИмяПакетаXDTO);

