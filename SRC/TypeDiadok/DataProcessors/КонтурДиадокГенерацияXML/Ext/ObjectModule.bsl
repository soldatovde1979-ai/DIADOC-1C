// Формирует описание номенклатуры по строке табличной части документов в формате 970@.
//
// Параметры:
//  СтрокаXDTO - ОбъектXDTO - элемент коллекции Документ.ТаблСчФакт.СведТов
//  Идентификатор - Строка - Идентификатор номенклатуры, полученный из дополнительной информации строки ТЧ.
// 
// Возвращаемое значение:
//  Структура - см. Контракт_НоменклатураЭлектронногоДокумента.
//
Функция НоменклатураЭлектронногоДокумента970(СтрокаXDTO, Идентификатор)
	
	Перем Код, Артикул, Характеристика, Сорт, ПризнакНоменклатуры, GTIN;
	
	Наименование = ПолучитьЗначениеXDTO(СтрокаXDTO, "НаимТов");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СтрокаXDTO, "ДопСведТов") Тогда
		
		ДопСведТов = СтрокаXDTO.ДопСведТов;
		
		Код = ПолучитьЗначениеXDTO(ДопСведТов, "КодТов");
		Артикул = ПолучитьЗначениеXDTO(ДопСведТов, "АртикулТов");
		Характеристика = ПолучитьЗначениеXDTO(ДопСведТов, "ХарактерТов");
		Сорт = ПолучитьЗначениеXDTO(ДопСведТов, "СортТов");
		ПризнакНоменклатуры = ПолучитьЗначениеXDTO(ДопСведТов, "ПрТовРаб");
		GTIN = ПолучитьЗначениеXDTO(ДопСведТов, "ГТИН");
		
	КонецЕсли;
	
	Результат = Новый_НоменклатураЭлектронногоДокумента(
		Идентификатор,
		Наименование,
		Артикул,
		Код,
		Характеристика
	);
	
	Результат.Сорт = Сорт;
	Результат.ЕдиницаИзмерения = ПолучитьЗначениеXDTO(СтрокаXDTO, "НаимЕдИзм");
	Результат.ЕдиницаИзмеренияКод = ПолучитьЗначениеXDTO(СтрокаXDTO, "ОКЕИ_Тов");
	Результат.СтавкаНДС = ПолучитьЗначениеXDTO(СтрокаXDTO, "НалСт");
	Результат.Тип = ОпределитьТипНоменклатурыЛок(ПризнакНоменклатуры);
	Результат.GTIN = GTIN;
	
	НормализоватьПоляНоменклатурыЭлектронногоДокумента(Результат);
	
	Возврат _ФиксированныеДанные(Результат);
	
КонецФункции

