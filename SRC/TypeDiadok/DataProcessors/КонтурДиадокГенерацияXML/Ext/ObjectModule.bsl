		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОснРеквДок, "РеквУРЛСистДок") Тогда
			УстановитьЗначениеXDTO(ProformaInvoiceBaseDocument, "SystemUrl", ОснРеквДок.РеквУРЛСистДок);
		КонецЕсли;
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОснРеквДок, "РеквДопСведДок") Тогда
			УстановитьЗначениеXDTO(ProformaInvoiceBaseDocument, "AdditionalInfo", ОснРеквДок.РеквДопСведДок);
		КонецЕсли;
		
		Заполнить_ProformaInvoice29IdentificationDetails(ProformaInvoiceBaseDocument, ОснРеквДок);
		
	КонецЕсли;
	
