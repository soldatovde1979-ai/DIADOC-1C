Функция УПД820_КонвертироватьСведенияУчастникаЭДО_в970(УчастникЭДО820)
	
	Перем Результат;
	
	Если НЕ УПД820_СведенияОБУчастникеЭДОЗаполнены(УчастникЭДО820) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НовыйProtoОбъектXDTO("ExtendedOrganizationInfo970");
	
	ИсключаемыеСвойства = Новый Массив;
	ИсключаемыеСвойства.Добавить("Phone");
	ИсключаемыеСвойства.Добавить("Email");

	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат, УчастникЭДО820, ИсключаемыеСвойства);
	
	Если ЗначениеЗаполнено(УчастникЭДО820.Phone) Тогда
		Результат.Phone.Добавить(УчастникЭДО820.Phone);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УчастникЭДО820.Email) Тогда
		Результат.Email.Добавить(УчастникЭДО820.Email);
	КонецЕсли;
	
	КодСтраны = КодСтраны(УчастникЭДО820.Country);
	УстановитьЗначениеXDTO(Результат, "CountryCode", КодСтраны);

	Address820 = УчастникЭДО820.Address;
	Если Address820 <> Неопределено Тогда
		
		Address = УПД820_КонвертироватьАдресУчастникаЭДО_в970(Address820);
		УстановитьЗначениеXDTO(Результат, "Address", Address);
		
	КонецЕсли;
	
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат.СлужебнаяИнформация, УчастникЭДО820);
	
	Возврат Результат;
	
