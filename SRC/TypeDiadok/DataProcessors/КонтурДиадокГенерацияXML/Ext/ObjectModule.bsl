Функция ВалидацияТорг2_РезультатыПриемки(AcceptanceResults)
	
	СписокОшибок = Новый Массив;
	
	Для Каждого AcceptanceResult Из AcceptanceResults.AcceptanceResult Цикл
		
		Assets = AcceptanceResult.Assets;
		
		ПроверитьФорматПоля(СписокОшибок, Assets.Product, "Наименование товара (ценности)", , 1, 1000, , "с");
		ПроверитьФорматПоля(СписокОшибок, Assets.ItemCharact, "Характеристика товара (ценности)", , 1, 1000, , "ж");
		ПроверитьФорматПоля(СписокОшибок, Assets.ItemKind, "Сорт товара (ценности)", , 1, 50);
		ПроверитьФорматПоля(СписокОшибок, Assets.ItemArticle, "Артикул товара (ценности)", , 1, 50);
		ПроверитьФорматПоля(СписокОшибок, Assets.ItemVendorCode, "Код товара (ценности)", , 1, 100);
		ПроверитьФорматПоля(СписокОшибок, Assets.PassportNumber, "Номер паспорта", , 1, 100);
		
		Если СтруктураЗаполнена(AcceptanceResult.AccordingToSellerDocument) Тогда
			Ошибки = ВалидацияТорг2_ДанныеОПринимаемомТоваре(AcceptanceResult.AccordingToSellerDocument);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в информация по документам поставщика");
		КонецЕсли;
		
		Если СтруктураЗаполнена(AcceptanceResult.ActuallyAccepted) Тогда
			Ошибки = ВалидацияТорг2_ДанныеОПринимаемомТоваре(AcceptanceResult.ActuallyAccepted);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в фактической информации");
		КонецЕсли;
		
		Если СтруктураЗаполнена(AcceptanceResult.Breakage) Тогда
			Ошибки = ВалидацияТорг2_ДанныеОРасхождениях(AcceptanceResult.Breakage);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в данных о бое");
		КонецЕсли;
		
		Если СтруктураЗаполнена(AcceptanceResult.Surplus) Тогда
			Ошибки = ВалидацияТорг2_ДанныеОРасхождениях(AcceptanceResult.Surplus);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в данных об излишках");
		КонецЕсли;
		
		Если СтруктураЗаполнена(AcceptanceResult.Shortfall) Тогда
			Ошибки = ВалидацияТорг2_ДанныеОРасхождениях(AcceptanceResult.Shortfall);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в данных о недостаче");
		КонецЕсли;
		
		Если СтруктураЗаполнена(AcceptanceResult.Reject) Тогда
			Ошибки = ВалидацияТорг2_ДанныеОРасхождениях(AcceptanceResult.Reject);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в данных о браке");
		КонецЕсли;
		
		ПроверитьФорматПоля(СписокОшибок, AcceptanceResult.Unit, "Единица измерения товара (код)", , 3, 4, Истина, "ж");
		ПроверитьФорматПоля(СписокОшибок, AcceptanceResult.AcceptanceDiscrepancyInfo, "Информация о расхождениях (претензиях), выявленных при приемке результатов выполненных работ (при документировании факта оказания услуг) или при получении имущественных прав", , 1, 2000, , "ж");
		ПроверитьФорматПоля(СписокОшибок, AcceptanceResult.UnitName, "Наименование единицы измерения товара", AcceptanceResult.Unit = "0000", 1, 255, , "с");
		
	КонецЦикла;
	
	Возврат СписокОшибок;
	
КонецФункции

