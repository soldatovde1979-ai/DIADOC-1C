	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ТаблКСчФ, "ВсегоУм") Тогда
		Заполнить_InvoiceTotalsDiff(Контент.TotalsDec, ТаблКСчФ.ВсегоУм);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвКСчФ, "ИнфПол") Тогда 
		Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, СвКСчФ.ИнфПол, "ТекстИнф");
	КонецЕсли;
	
	Для Каждого СчФ Из СписокXDTOИзЭлемента(СвКСчФ, "СчФ") Цикл
		Заполнить_OriginalInvoice(НовыйЭлементСпискаXDTO(Контент.OriginalInvoices), СчФ);
	КонецЦикла;
	
	Для Каждого СведТов Из СписокXDTOИзЭлемента(ТаблКСчФ, "СведТов") Цикл
		Заполнить_InvoiceCorrectionItem(НовыйЭлементСпискаXDTO(Контент.Items), СведТов);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_ProformaInvoiceSellerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СвСНО	 = Документ.СвСНО;
	
	УстановитьЗначениеXDTO(Контент, "DocumentDate"	, ДатаXML_в_Дата1С(СвСНО.ДатаДок));
	УстановитьЗначениеXDTO(Контент, "DocumentNumber", СвСНО.НомерДок);
	
