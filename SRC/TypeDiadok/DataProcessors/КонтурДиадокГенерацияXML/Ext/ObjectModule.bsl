//{ Методы преобразования контента одного типа в другой

// Преобразует InvoiceContent в UtdSellerContent с функцией СЧФ (Invoice)
// Предназначена для быстрого перехода с формата счетов-фактур 5.02 на формат УПД.
Функция ПолучитьUtdSellerContentИзInvoiceContent(InvoiceContent) Экспорт
	
	Контент = НовыйProtoОбъектXDTO(ТипПрото_ИнформацияПродавца155());
	
	ЗаполнитьСвойстваПриемникаXDTO(Контент, InvoiceContent);
	
	Маппинг = Новый СписокЗначений;
	Маппинг.Добавить("InvoiceRevisionNumber",	"RevisionNumber");
	Маппинг.Добавить("InvoiceRevisionDate",		"RevisionDate");
	ЗаполнитьСвойстваПриемникаXDTOПоМаппингу(Контент, InvoiceContent, Маппинг);
	
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Buyer,	InvoiceContent.Buyer);
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Buyer.Address,	InvoiceContent.Buyer.Address);
	ЗаполнитьТипКонтрагента(Контент.Buyer);
	
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Seller,	InvoiceContent.Seller);
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Seller.Address,	InvoiceContent.Seller.Address);
	ЗаполнитьТипКонтрагента(Контент.Seller);
	
	// Грузоотправитель
	Если InvoiceContent.Shipper.SameAsSellerOrBuyer = Истина Тогда
		
		Контент.Shipper.SameAsSeller = Истина;
		
	ИначеЕсли InvoiceContent.Shipper.SameAsSellerOrBuyer = Ложь Тогда
		
		Контент.Shipper.SameAsSeller = Ложь;
		ЗаполнитьСвойстваПриемникаXDTO(Контент.Shipper.OrganizationInfo,			InvoiceContent.Shipper);  // Основные поля - ИНН, КПП, ...
		ЗаполнитьСвойстваПриемникаXDTO(Контент.Shipper.OrganizationInfo,			InvoiceContent.Shipper);  // Наименование
		ЗаполнитьСвойстваПриемникаXDTO(Контент.Shipper.OrganizationInfo.Address,	InvoiceContent.Shipper.Address);
		
	Иначе
		
		// не заполняем
		
	КонецЕсли;

	// Грузополучатель
	Если InvoiceContent.Consignee.SameAsSellerOrBuyer = Истина Тогда
		
		// не заполняем в этом случае
		
	ИначеЕсли InvoiceContent.Consignee.SameAsSellerOrBuyer = Ложь Тогда
		
		ЗаполнитьСвойстваПриемникаXDTO(Контент.Consignee,			InvoiceContent.Seller);  // Основные поля - ИНН, КПП, ...
		ЗаполнитьСвойстваПриемникаXDTO(Контент.Consignee,			InvoiceContent.Consignee);  // Наименование
		ЗаполнитьСвойстваПриемникаXDTO(Контент.Consignee.Address,	InvoiceContent.Consignee.Address);
		ЗаполнитьТипКонтрагента(Контент.Consignee);
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Function",					"Invoice");
	УстановитьЗначениеXDTO(Контент, "Creator",					"" + Контент.Seller.Name + " / " + Контент.Seller.Inn + " / " + Контент.Seller.Kpp);
	
	Скопировать_StructedAdditionalInfos(Контент.AdditionalInfoId.StructedAdditionalInfos, InvoiceContent.StructedAdditionalInfos);

	// Заполним товары
	Для Каждого Item Из InvoiceContent.Items Цикл
		
		НовЭлемент = НовыйЭлементСпискаXDTO(Контент.InvoiceTable.Items);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент, Item);
		
		Маппинг = Новый СписокЗначений;
		Маппинг.Добавить("Total",					"Subtotal");
		Маппинг.Добавить("TotalWithVatExcluded",	"SubtotalWithVatExcluded");
		ЗаполнитьСвойстваПриемникаXDTOПоМаппингу(НовЭлемент, Item, Маппинг);
		
		Скопировать_StructedAdditionalInfos(НовЭлемент.StructedAdditionalInfos, Item.StructedAdditionalInfos);
		
		// Теперь заполним номера ГТД
		Если ЗначениеЗаполнено(Item.CountriesOfOrigin)
			Или ЗначениеЗаполнено(Item.CustomsDeclarationNumbers) Тогда
			
			// Страна происхождения - Строка (3), одна на все элементы
			// А номер ГТД разбиваем по запятым
			НомераГТД = РазложитьСтрокуВМассивСлов(Item.CustomsDeclarationNumbers, ",");
			
			Для Каждого НомерГТД Из НомераГТД Цикл
				
				НовЭлементГТД = НовыйЭлементСпискаXDTO(НовЭлемент.CustomDeclarations);
				УстановитьЗначениеXDTO(НовЭлементГТД, "CountryCode", Item.CountriesOfOrigin);
				УстановитьЗначениеXDTO(НовЭлементГТД, "DeclarationNumber", НомерГТД);
				
			КонецЦикла;
			
			Если НомераГТД.Количество() = 0 Тогда
				
				// Случай, когда указана страна происхождения, но отсутствует номер ГТД
				// Например, страны Таможенного Союза
				НовЭлементГТД = НовыйЭлементСпискаXDTO(НовЭлемент.CustomDeclarations);
				УстановитьЗначениеXDTO(НовЭлементГТД, "CountryCode", Item.CountriesOfOrigin);
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	
	ЗаполнитьИтогиУПД(Контент.InvoiceTable);
	
	Для Каждого Стр Из InvoiceContent.PaymentDocuments Цикл
		НовЭлемент = НовыйЭлементСпискаXDTO(Контент.PaymentDocuments);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент, Стр);
	КонецЦикла;
	
	Возврат Контент;
	
КонецФункции

// Преобразует UtdSellerContent в Utd820SellerContent
// Предназначена для быстрого перехода с формата УПД 155@ на формат 820@.
Функция ПолучитьUtd820SellerContentИзUtdSellerContent(UtdSellerContent) Экспорт
	
	Результат = НовыйProtoОбъектXDTO(ТипПрото_ИнформацияПродавца820());
	
	ЗаполнитьСвойстваПриемникаXDTO(Результат, UtdSellerContent);
	
	Маппинг = Новый СписокЗначений;
	Маппинг.Добавить("Creator",		"DocumentCreator");
	Маппинг.Добавить("CreatorBase",	"DocumentCreatorBase");
	Маппинг.Добавить("Name",		"DocumentName");
	Маппинг.Добавить("Date",		"DocumentDate");
	Маппинг.Добавить("Number",		"DocumentNumber");
	
	ЗаполнитьСвойстваПриемникаXDTOПоМаппингу(Результат, UtdSellerContent, Маппинг);
	
	Buyer = НовыйЭлементСпискаXDTO(Результат.Buyers);
	ЗаполнитьСвойстваПриемникаXDTO(Buyer, UtdSellerContent.Buyer);
	ЗаполнитьСвойстваПриемникаXDTO(Buyer.Address, UtdSellerContent.Buyer.Address);
	
	Seller = НовыйЭлементСпискаXDTO(Результат.Sellers);
	ЗаполнитьСвойстваПриемникаXDTO(Seller, UtdSellerContent.Seller);
	ЗаполнитьСвойстваПриемникаXDTO(Seller.Address, UtdSellerContent.Seller.Address);
	
	Shipper = НовыйЭлементСпискаXDTO(Результат.Shippers);
	УстановитьЗначениеXDTO(Shipper, "SameAsSeller", UtdSellerContent.Shipper.SameAsSeller);
	ЗаполнитьСвойстваПриемникаXDTO(Shipper.OrganizationInfo, UtdSellerContent.Shipper.OrganizationInfo);
	ЗаполнитьСвойстваПриемникаXDTO(Shipper.OrganizationInfo.Address, UtdSellerContent.Shipper.OrganizationInfo.Address);
	
	Consignee = НовыйЭлементСпискаXDTO(Результат.Consignees);
	ЗаполнитьСвойстваПриемникаXDTO(Consignee, UtdSellerContent.Consignee);
	ЗаполнитьСвойстваПриемникаXDTO(Consignee.Address, UtdSellerContent.Consignee.Address);
	
	УстановитьЗначениеXDTO(Результат.AdditionalInfoId, "InfoFileId", UtdSellerContent.AdditionalInfoId.InfoFileId);
	Скопировать_StructedAdditionalInfos(Результат.AdditionalInfoId.StructedAdditionalInfos, UtdSellerContent.AdditionalInfoId.StructedAdditionalInfos);
	
	Скопировать_StructedAdditionalInfos(Результат.PaymentDocuments, UtdSellerContent.PaymentDocuments);
	
	TransferInfo155 = UtdSellerContent.TransferInfo;
	TransferInfo820 = Результат.TransferInfo;
	
	ЗаполнитьСвойстваПриемникаXDTO(TransferInfo820, TransferInfo155);
	УстановитьЗначениеXDTO(TransferInfo820.AdditionalInfoId, "InfoFileId", TransferInfo155.AdditionalInfoId.InfoFileId);
	Скопировать_StructedAdditionalInfos(TransferInfo820.AdditionalInfoId.StructedAdditionalInfos, TransferInfo155.AdditionalInfoId.StructedAdditionalInfos);
	ЗаполнитьСвойстваПриемникаXDTO(TransferInfo820.Carrier, TransferInfo155.Carrier);
	ЗаполнитьСвойстваПриемникаXDTO(TransferInfo820.Carrier.Address, TransferInfo155.Carrier.Address);
	ЗаполнитьСвойстваПриемникаXDTO(TransferInfo820.Employee, TransferInfo155.Employee);
	ЗаполнитьСвойстваПриемникаXDTO(TransferInfo820.OtherIssuer, TransferInfo155.OtherIssuer);
	Скопировать_TransferBases(TransferInfo820.TransferBases, TransferInfo155.TransferBases);
	Скопировать_StructedAdditionalInfos(TransferInfo820.Waybills, TransferInfo155.Waybills);
	
	ЗаполнитьСвойстваПриемникаXDTO(Результат.Table, UtdSellerContent.InvoiceTable);
	
	МаппингСтрокиТЧ = Новый СписокЗначений;
	МаппингСтрокиТЧ.Добавить("ToRelease",	"ItemToRelease");
	МаппингСтрокиТЧ.Добавить("VendorCode",	"ItemVendorCode");
	МаппингСтрокиТЧ.Добавить("UnitCode",	"Unit");
	
	БезНДС = "true";
	
	Для Каждого Item Из UtdSellerContent.InvoiceTable.Items Цикл
		
		НовЭлемент = НовыйЭлементСпискаXDTO(Результат.Table.Items);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент, Item);
		ЗаполнитьСвойстваПриемникаXDTOПоМаппингу(НовЭлемент, Item, МаппингСтрокиТЧ);
		
		Скопировать_StructedAdditionalInfos(НовЭлемент.StructedAdditionalInfos, Item.StructedAdditionalInfos);
		Скопировать_StructedAdditionalInfos(НовЭлемент.CustomDeclarations, Item.CustomDeclarations);
		
		Если TaxRate_ЭтоЗначениеБезНДС(Item.TaxRate) Тогда
			НовЭлемент.WithoutVat = "true";
		Иначе
			БезНДС = "false";
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Table.WithoutVat = БезНДС;
	
	Возврат Результат;
	
КонецФункции

// Преобразует InvoiceCorrectionContent в UcdSellerContent с функцией КСЧФ (Invoice)
// Предназначена для быстрого перехода с формата КСФ 5.02 на формат УКД.
Функция ПолучитьUcdSellerContentИзInvoiceCorrectionContent(InvoiceContent) Экспорт
	
	Контент = НовыйProtoОбъектXDTO(ТипПрото_ИнформацияПродавца736());
	
	ЗаполнитьСвойстваПриемникаXDTO(Контент, InvoiceContent);
	
	Маппинг = Новый СписокЗначений;
	
	Маппинг.Добавить("InvoiceCorrectionRevisionNumber",	"CorrectionRevisionNumber");
	Маппинг.Добавить("InvoiceCorrectionRevisionDate",	"CorrectionRevisionDate");
	
	Маппинг.Добавить("InvoiceCorrectionNumber",	"Number");
	Маппинг.Добавить("InvoiceCorrectionDate",	"Date");
	
	ЗаполнитьСвойстваПриемникаXDTOПоМаппингу(Контент, InvoiceContent, Маппинг);
	
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Buyer,			InvoiceContent.Buyer);
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Buyer.Address,	InvoiceContent.Buyer.Address);
	ЗаполнитьТипКонтрагента(Контент.Buyer);
	
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Seller,			InvoiceContent.Seller);
	ЗаполнитьСвойстваПриемникаXDTO(Контент.Seller.Address,	InvoiceContent.Seller.Address);
	ЗаполнитьТипКонтрагента(Контент.Seller);
	
	УстановитьЗначениеXDTO(Контент, "Function",					"Invoice");
	УстановитьЗначениеXDTO(Контент, "Creator",					"" + Контент.Seller.Name + " / " + Контент.Seller.Inn + " / " + Контент.Seller.Kpp);
	
	Скопировать_StructedAdditionalInfos(Контент.AdditionalInfoId.StructedAdditionalInfos, InvoiceContent.StructedAdditionalInfos);

	// Заполним товары
	Для Каждого Item Из InvoiceContent.Items Цикл
		
		НовЭлемент = НовыйЭлементСпискаXDTO(Контент.InvoiceCorrectionTable.Items);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент, Item);
		
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент.AmountsDec,		Item.AmountsDec);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент.AmountsInc,		Item.AmountsInc);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент.CorrectedValues,	Item.CorrectedValues);
		ЗаполнитьСвойстваПриемникаXDTO(НовЭлемент.OriginalValues,	Item.OriginalValues);
		
		Скопировать_StructedAdditionalInfos(НовЭлемент.StructedAdditionalInfos, Item.StructedAdditionalInfos);
		
	КонецЦикла;
	
	Для Каждого OriginalInvoice Из InvoiceContent.OriginalInvoices Цикл
		
		ИсходныйСФ = НовыйЭлементСпискаXDTO(Контент.Invoices);
		
		ИсходныйСФ.InvoiceNumber	= OriginalInvoice.Number;
		ИсходныйСФ.InvoiceDate		= OriginalInvoice.Date;
		
		Если ЗначениеЗаполнено(OriginalInvoice.InvoiceRevisionDate) Тогда
			
			ОписаниеИСФ = НовыйЭлементСпискаXDTO(ИсходныйСФ.InvoiceRevisions);
			ОписаниеИСФ.RevisionDate		= OriginalInvoice.InvoiceRevisionDate;
			ОписаниеИСФ.RevisionNumber		= OriginalInvoice.InvoiceRevisionNumber;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьИтогиУКД(Контент.InvoiceCorrectionTable);
	
	Контент.EventContent.OperationContent	= "Уведомляю об изменении стоимости и/или количества";
	Контент.EventContent.TransferDocDetails	= "Отсутствует";
	
	CorrectionBase = НовыйЭлементСпискаXDTO(Контент.EventContent.CorrectionBases);
	CorrectionBase.BaseDocumentName		= "Отсутствует";
	
	Возврат Контент;
	
КонецФункции

