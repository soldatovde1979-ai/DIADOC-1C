		Заполнить_ExtendedOrganizationInfo29_ФизическоеЛицо(Контент, Параметры.ИдСв.СвФЛУч);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИнНеУч") Тогда
		
		Заполнить_ExtendedOrganizationInfo29_ИностранноеЛицо(Контент, Параметры.ИдСв.СвИнНеУч);
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	УстановитьЗначениеXDTO(Контент, "Okpo", ПолучитьЗначениеXDTO(Параметры, "ОКПО"));
	УстановитьЗначениеXDTO(Контент, "Okopf", ПолучитьЗначениеXDTO(Параметры, "КодОПФ"));
	УстановитьЗначениеXDTO(Контент, "FullNameOPF", ПолучитьЗначениеXDTO(Параметры, "ПолнНаимОПФ"));
	УстановитьЗначениеXDTO(Контент, "Department", ПолучитьЗначениеXDTO(Параметры, "СтруктПодр"));
	УстановитьЗначениеXDTO(Контент, "AdditionalInfo", ПолучитьЗначениеXDTO(Параметры, "ИнфДляУчаст"));
	УстановитьЗначениеXDTO(Контент, "ShortOrgName", ПолучитьЗначениеXDTO(Параметры, "СокрНаим"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "БанкРекв") Тогда
		Заполнить_BankInfo29(Контент, Параметры.БанкРекв);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Контакт") Тогда
		
		Для Каждого НомерТелефона Из СписокXDTOИзЭлемента(Параметры.Контакт, "Тлф") Цикл
			Контент.Phone.Добавить(НомерТелефона);
		КонецЦикла;
		
		Для Каждого ЭлПочта Из СписокXDTOИзЭлемента(Параметры.Контакт, "ЭлПочта") Цикл
			Контент.Email.Добавить(ЭлПочта);
		КонецЦикла;
		
		УстановитьЗначениеXDTO(Контент, "OtherContactInfo", ПолучитьЗначениеXDTO(Параметры.Контакт, "ИнКонт"));
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Адрес") Тогда
		Заполнить_AddressInfo970(Контент.Address, Параметры.Адрес);
	КонецЕсли;
	
КонецПроцедуры

