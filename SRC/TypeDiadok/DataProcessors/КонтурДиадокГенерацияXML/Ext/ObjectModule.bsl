Процедура Заполнить_ПризнакиПрослеживаемыхИМаркируемыхТоваровДокументаУПД970(Контент, ПризнакиТоваров) Экспорт
	
	ВидыТоваровДокумента = Контент.СлужебнаяИнформация.ContentsDocumentProductsType;
	
	ВидыТоваровДокумента.ContainsTraceableProducts = ПризнакиТоваров.ЕстьПрослеживаемаяПродукция;
	ВидыТоваровДокумента.ContainsMarkedProducts = ПризнакиТоваров.ЕстьМаркируемаяПродукция;
	ВидыТоваровДокумента.ContainsAlcoholeProducts = ПризнакиТоваров.ЕстьАлкогольнаяПродукция;
	ВидыТоваровДокумента.ContainsTobaccoProducts = ПризнакиТоваров.ЕстьТабачнаяПродукция;
	ВидыТоваровДокумента.ContainsPetroleumProducts = ПризнакиТоваров.ЕстьНефтепродукты;
	
КонецПроцедуры

Функция Новый_ПризнакиПрослеживаемыхИМаркируемыхТоваровУПД970(
	ЕстьПрослеживаемаяПродукция = Ложь,
	ЕстьМаркируемаяПродукция = Ложь,
	ЕстьАлкогольнаяПродукция = Ложь,
	ЕстьТабачнаяПродукция = Ложь,
	ЕстьНефтепродукты = Ложь) Экспорт
		
	Результат = Новый Структура;
	Результат.Вставить("ЕстьПрослеживаемаяПродукция", ЕстьПрослеживаемаяПродукция);
	Результат.Вставить("ЕстьМаркируемаяПродукция", ЕстьМаркируемаяПродукция);
	Результат.Вставить("ЕстьАлкогольнаяПродукция", ЕстьАлкогольнаяПродукция);
	Результат.Вставить("ЕстьТабачнаяПродукция", ЕстьТабачнаяПродукция);
	Результат.Вставить("ЕстьНефтепродукты", ЕстьНефтепродукты);
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_ItemMarks() Экспорт
	
	Результат = Кэш_Прочитать("ItemMarks");
	Если Результат = Неопределено Тогда
		Результат = Новый Структура;
		Кэш_Поместить("ItemMarks", Результат);
	КонецЕсли;
	
	Результат.Вставить("Имущество"			, "Property");
	Результат.Вставить("Работа"				, "Job");
	Результат.Вставить("Услуга"				, "Service");
	Результат.Вставить("ИмущественныеПрава"	, "PropertyRights");
	Результат.Вставить("Иное"				, "Other");
	Результат.Вставить("НеУказано"			, "NotSpecified");
	
	Возврат Результат;
	
КонецФункции

