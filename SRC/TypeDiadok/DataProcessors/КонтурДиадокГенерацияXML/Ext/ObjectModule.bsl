Процедура Заполнить_ShipperOrConsigneeInfo(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НаимГОП") Тогда
		
		// формат с/ф 5.02
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.НаимГОП, "НаимОрг") Тогда
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Ложь);
			УстановитьЗначениеXDTO(Контент, "Name", Параметры.НаимГОП.НаимОрг);
		Иначе
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Истина);
			УстановитьЗначениеXDTO(Контент, "Name", Параметры.НаимГОП.ФИОИП.Фамилия + " " + Параметры.НаимГОП.ФИОИП.Имя + " " + ПолучитьЗначениеXDTO(Параметры.НаимГОП.ФИОИП, "Отчество"));
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИдСв") Тогда
		
		// формат с/ф 5.01
		ИдСв = Параметры.ИдСв;
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ИдСв, "СвИП") Тогда
			СвИП = ИдСв.СвИП;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Истина);
			УстановитьЗначениеXDTO(Контент, "Name", СвИП.ФИО.Фамилия + " " + СвИП.ФИО.Имя + " " + ПолучитьЗначениеXDTO(СвИП.ФИО, "Отчество"));
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ИдСв, "СвЮЛУч") Тогда
			СвЮЛУч = ИдСв.СвЮЛУч;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Ложь);
			УстановитьЗначениеXDTO(Контент, "Name", СвЮЛУч.НаимОрг);
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ИдСв, "СвЮлНеУч") Тогда
			СвЮлНеУч = ИдСв.СвЮлНеУч;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Ложь);
			УстановитьЗначениеXDTO(Контент, "Name", СвЮлНеУч.НаимОрг);
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ИдСв, "СвИнНеУч") Тогда
			СвИнНеУч = ИдСв.СвИнНеУч;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Истина);
			УстановитьЗначениеXDTO(Контент, "Name", СвИнНеУч.НаимОрг);
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "SameAsSellerOrBuyer", Ложь);
	
	Заполнить_AddressInfo(Контент.Address, Параметры.Адрес);
	
КонецПроцедуры

Процедура Заполнить_Signer(Контент, Параметры, ИмяСвойства)
	
	Для Каждого Подписант Из СписокXDTOИзЭлемента(Параметры, ИмяСвойства) Цикл
		
		Signer = XML_ПолучитьПустойОбъектXDTO("Signer", "Proto");
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ЮЛ") Тогда
			
			УстановитьЗначениеXDTO(Signer, "IsSoleProprietor"	, Ложь);
			УстановитьЗначениеXDTO(Signer, "Inn"				, Подписант.ЮЛ.ИннЮЛ);
			
			Заполнить_Official(Signer, Подписант.ЮЛ);
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ФЛ") Тогда
			
			УстановитьЗначениеXDTO(Signer, "IsSoleProprietor"	, Истина);
			УстановитьЗначениеXDTO(Signer, "Inn"				, Подписант.ФЛ.ИннФЛ);
			УстановитьЗначениеXDTO(Signer, "SoleProprietorRegistrationCertificate", ПолучитьЗначениеXDTO(Подписант.ФЛ, "ГосРегИПВыдДов"));
			Заполнить_Official(Signer, Подписант.ФЛ);
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Подписант, "ИП") Тогда
			
			УстановитьЗначениеXDTO(Signer, "IsSoleProprietor"	, Истина);
			УстановитьЗначениеXDTO(Signer, "Inn"				, Подписант.ИП.ИННФЛ);
			УстановитьЗначениеXDTO(Signer, "SoleProprietorRegistrationCertificate", ПолучитьЗначениеXDTO(Подписант.ИП, "СвГосРегИП"));
			
			Заполнить_Official(Signer, Подписант.ИП);
			
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "Signer", Signer);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_Torg12BuyerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СвТНП	 = Документ.СвТНП;
	
	Заполнить_Signer(Контент, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвТНП, "ПолучилГруз") Тогда
		
		ПолучилГруз = СвТНП.ПолучилГруз;
		
		УстановитьЗначениеXDTO(Контент, "ShipmentReceiptDate", ДатаXML_в_Дата1С(ПолучилГруз.ДатаПолуч));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПолучилГруз, "Доверенность") Тогда
			Заполнить_Attorney(Контент.Attorney, ПолучилГруз.Доверенность);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПолучилГруз, "ГрузПолучил") Тогда
			Заполнить_Official(Контент.Receiver, ПолучилГруз.ГрузПолучил);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПолучилГруз, "ГрузПринял") Тогда
			Заполнить_Official(Контент.Accepter, ПолучилГруз.ГрузПринял);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвТНП, "ИнфПол") Тогда
		УстановитьЗначениеXDTO(Контент, "AdditionalInfo", ПолучитьЗначениеXDTO(СвТНП.ИнфПол, "ТекстИнф"));
	КонецЕсли;
	
КонецПроцедуры

