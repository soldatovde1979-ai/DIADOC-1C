// Возвращает тип контента и его Proto структуру.
//
// Параметры:
//	 ВходящиеДанные - Контент в формате ФНС, типы:
//					- ОбъектXDTO 			 - см. метод ОбъектXDTO_В_ProtoСтруктура
//					- Строка, ДвоичныеДанные - см. метод XML_В_ОбъектXDTO
//
// Возвращаемое значение:
//	 Структура	- Структура с типом контента и самим контентом.
//
// Состав структуры:
//	 Контент		- Структура	- см. метод ОбъектXDTO_В_ProtoСтруктура
//	 ТипКонтента	- Строка	- Строковое представление типа контента,
//							  	  например: Torg12SellerContent или Torg12BuyerContent.
//
Функция ПолучитьProto(ВходящиеДанные) Экспорт
	
	Если ТипЗнч(ВходящиеДанные) = Тип("ОбъектXDTO") Тогда
		ОбъектXDTO = ВходящиеДанные;
	Иначе
		ОбъектXDTO = XML_В_ОбъектXDTO(ВходящиеДанные);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Контент"	, ОбъектXDTO_В_ProtoСтруктура(ОбъектXDTO));
	Результат.Вставить("ТипКонтента", ПолучитьТипКонтентаОбъектаXDTO(ОбъектXDTO));
	
	Возврат Результат;
	
КонецФункции

// Возвращает объект XDTO по XML документу.
//
// Параметры:
//  ДокументXML - ДвоичныеДанные, Строка - Документ, по которому нужно создать объект XDTO.
//                                         Строкой можно передать текст xml либо путь к файлу.
//
// Возвращаемое значение:
//  ОбъектXDTO - объект созданный по xml документу.
//
Функция XML_В_ОбъектXDTO(ДокументXML) Экспорт
	
	СтрокаXML = Неопределено;
	
	Если ТипЗнч(ДокументXML) = Тип("ДвоичныеДанные") Тогда
		
		СтрокаXML = СодержимоеДвоичныхДанныхXML(ДокументXML);
		
	ИначеЕсли ЭтоСтрокаXML(ДокументXML) Тогда
		
		СтрокаXML = ДокументXML;
		
	ИначеЕсли ТипЗнч(ДокументXML) = Тип("Строка") Тогда
		
		СтрокаXML = СодержимоеФайлаXML(ДокументXML);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru = 'Недопустимый тип данных документа XML.
				|Текущий тип: %1.
				|Допустимые типы: ДвоичныеДанные, Строка.'");
		ТипЗначенияXML = ТипЗнч(ДокументXML);
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
				ШаблонТекстаОшибки,
				ТипЗначенияXML
			);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаXML) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось прочитать документ XML'");
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Возврат ОбъектXDTO;
	
КонецФункции

// Возвращает XDTO объект документа в терминах Proto структуры.
//
// Параметры:
//  ВходящиеДанные - Строка, ДвоичныеДанные - Контент документа в формате ФНС
//
// Возвращаемое значение:
//   Структура - Прото структура см. метод ОбъектXDTO_В_ProtoОбъектXDTO
//
Функция XML_В_ProtoСтруктура(ВходящиеДанные) Экспорт
	
	ОбъектXDTO = XML_В_ОбъектXDTO(ВходящиеДанные);
	
	ProtoОбъектXDTO = ОбъектXDTO_В_ProtoОбъектXDTO(ОбъектXDTO);
	
	Результат = ОбъектXDTOВСтруктуру(ProtoОбъектXDTO);
	
	Возврат Результат;
	
КонецФункции

// Возвращает XDTO объект документа в терминах Proto структуры.
//
// Параметры:
//	 ВходящиеДанные - Строка, ДвоичныеДанные - Контент документа в формате ФНС (см. метод XML_В_ОбъектXDTO)
//
// Возвращаемое значение:
//	 ОбъектXDTO - XDTO объект документа в терминах Proto (см. метод ОбъектXDTO_В_ProtoОбъектXDTO)
//
Функция XML_В_ProtoОбъектXDTO(ВходящиеДанные) Экспорт
	
	Возврат ОбъектXDTO_В_ProtoОбъектXDTO(XML_В_ОбъектXDTO(ВходящиеДанные));
	
КонецФункции

// Возвращает Proto структуру документа.
//
// Параметры:
//	 ОбъектXDTO - ОбъектXDTO - Контент документа в формате ФНС.
//
// Возвращаемое значение:
//	 Структура	- Объектная модель контента в терминах Proto структуры публичного API Диадока,
//				  например: http://api-docs.diadoc.ru/ru/latest/proto/TovTorgInfo.html?highlight=tovtorgsellertitleinfo
//
Функция ОбъектXDTO_В_ProtoСтруктура(ОбъектXDTO) Экспорт
	
	Возврат ОбъектXDTOВСтруктуру(ОбъектXDTO_В_ProtoОбъектXDTO(ОбъектXDTO), Истина);
	
КонецФункции	

// Возвращает XDTO объект документа в терминах Proto структуры.
//
// Параметры:
//	 ОбъектXDTO - ОбъектXDTO - Контент документа в формате ФНС.
//
// Возвращаемое значение:
//	 ОбъектXDTO	- XDTO объект документа в терминах Proto структуры публичного API Диадока.
//				  например: http://api-docs.diadoc.ru/ru/latest/proto/TovTorgInfo.html?highlight=tovtorgsellertitleinfo
//
Функция ОбъектXDTO_В_ProtoОбъектXDTO(ОбъектXDTO) Экспорт
	
	Результат = Неопределено;
	
	ТипКонтента = ПолучитьТипКонтентаОбъектаXDTO(ОбъектXDTO);
	
	Если Не ЗначениеЗаполнено(ТипКонтента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НовыйProtoОбъектXDTO(ТипКонтента);
	
	Если ТипКонтента = ТипПрото_ИнформацияПродавца970() Тогда
		
		Заполнить_Utd970SellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателя970() Тогда
		
		Заполнить_Utd970BuyerContent(Результат, ОбъектXDTO);
	
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца155() Тогда
		
		Заполнить_UtdSellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателя155() Тогда
		
		Заполнить_UtdBuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателя736() Тогда
		
		Заполнить_UcdBuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца820() Тогда
		
		Заполнить_Utd820SellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателя820() Тогда
		
		Заполнить_Utd820BuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца736() Тогда
		
		Если Найти(ОбъектXDTO.ИдФайл, "ON_NKORSCHFDOPPR") = 1 Тогда
			Заполнить_Ucd736SellerContent(Результат, ОбъектXDTO);
		Иначе
			Заполнить_UcdSellerContent(Результат, ОбъектXDTO);
		КонецЕсли;
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца552() Тогда
		
		Заполнить_Act552SellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателя552() Тогда
		
		Заполнить_Act552BuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца551() Тогда
		
		Заполнить_TovTorgSellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателя551() Тогда
		
		Заполнить_TovTorgBuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаНакладная172() Тогда
		
		Заполнить_Torg12SellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателяНакладная172() Тогда
		
		Заполнить_Torg12BuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаАкт172() Тогда
		
		Заполнить_AcceptanceCertificateSellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателяАкт172() Тогда
		
		Заполнить_AcceptanceCertificateBuyerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_СчетФактура93() Тогда
		
		Заполнить_InvoiceContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_КорректировочныйСчетФактура93() Тогда
		
		Заполнить_InvoiceCorrectionContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаСчетНаОплату() Тогда
		
		Заполнить_ProformaInvoiceSellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаСчетНаОплату29() Тогда
		
		Заполнить_ProformaInvoice29SellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияОтправителя423() Тогда
		
		Заполнить_Torg2SenderTitle(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПолучателя423() Тогда
		
		Заполнить_Torg2RecipientTitle(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияОтправителя405() Тогда
		
		Заполнить_ReconciliationActSenderTitle(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПолучателя405() Тогда
		
		Заполнить_ReconciliationActRecipientTitle(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаНакладнаяРБ01() Тогда
		
		Заполнить_TorgBlrSellerContent(Результат, ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПокупателяНакладнаяРБ01() Тогда
		
		Заполнить_TorgBlrBuyerContent(Результат, ОбъектXDTO);
		
	Иначе
		
		КомментарийЖР = Общее_ПодставитьПараметрыВСтроку(
			"Неизвестный тип протоконтента (%1): ИдФайл = %2",
			ТипКонтента,
			ОбъектXDTO.ИдФайл
		);
		
		ЗаписьЖурналаРегистрации(
			"Диадок.ПарсингXML",
			УровеньЖурналаРегистрации.Ошибка,
			Неопределено,
			Неопределено,
			КомментарийЖР
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция XML_В_XDTO(СтрокаXML)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтрокаXML);
	
	Возврат ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
КонецФункции

Функция XDTO_В_Таблицу(ОбъектXDTO)
	
	Таблица = Новый ТаблицаЗначений;
	
	СвойстваОбъектаXDTO = ОбъектXDTO.Свойства();
	
	Если СвойстваОбъектаXDTO.Получить("column") <> Неопределено Тогда
		Добавить_КолонкиXDTO_В_КоллекциюКолонок(ОбъектXDTO.column, Таблица.Колонки);
	КонецЕсли;
	
	Для Каждого СтрокаXDTO Из ОбъектXDTO.row Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		ИндексКолонки = -1;
		Для Каждого ЗначениеКолонки Из СтрокаXDTO.Value Цикл
			
			ИндексКолонки = ИндексКолонки + 1;
			
			Если ТипЗнч(ЗначениеКолонки) <> Тип("ОбъектXDTO") Тогда
				НоваяСтрока[ИндексКолонки] = ЗначениеКолонки;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если СвойстваОбъектаXDTO.Получить("index") <> Неопределено Тогда
		Добавить_ИндексыXDTO_В_ИндексыКоллекции(ОбъектXDTO.index, Таблица.Индексы);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция XDTO_В_Дерево(ОбъектXDTO)
	
	Дерево = Новый ДеревоЗначений;
	
	Добавить_КолонкиXDTO_В_КоллекциюКолонок(ОбъектXDTO.column, Дерево.Колонки);
	
	Добавить_СписокXDTO_В_Дерево(ОбъектXDTO.row, Дерево.Строки);
	
	Возврат Дерево;
	
КонецФункции

Процедура Добавить_КолонкиXDTO_В_КоллекциюКолонок(КолонкиXDTO, КоллекцияКолонок)
	
	Для Каждого КолонкаXDTO Из КолонкиXDTO Цикл
		
		СвойстваValueType = КолонкаXDTO.ValueType.Свойства();
		
		МассивТипов = Новый Массив;
		КвалификаторыЧисла  = Неопределено;
		КвалификаторыСтроки = Неопределено;
		КвалификаторыДаты 	= Неопределено;
		
		Если СвойстваValueType.Получить("NumberQualifiers") <> Неопределено
			И КолонкаXDTO.ValueType.NumberQualifiers <> Неопределено Тогда
			
			Разрядность 			= Число(КолонкаXDTO.ValueType.NumberQualifiers.Digits);
			РазрядностьДробнойЧасти = Число(КолонкаXDTO.ValueType.NumberQualifiers.FractionDigits);
			
			Если ТипЗнч(КолонкаXDTO.ValueType.NumberQualifiers.AllowedSign) = Тип("ДопустимыйЗнак") Тогда
				_ДопустимыйЗнак = КолонкаXDTO.ValueType.NumberQualifiers.AllowedSign;
			Иначе
				_ДопустимыйЗнак = ДопустимыйЗнак[КолонкаXDTO.ValueType.NumberQualifiers.AllowedSign];
			КонецЕсли;
			
			КвалификаторыЧисла = Новый КвалификаторыЧисла(Разрядность, РазрядностьДробнойЧасти, _ДопустимыйЗнак);
			
			МассивТипов.Добавить(Тип("Число"));
			
		КонецЕсли;
		
		
		Если СвойстваValueType.Получить("StringQualifiers") <> Неопределено 
			И КолонкаXDTO.ValueType.StringQualifiers <> Неопределено Тогда
			
			Длина = Число(КолонкаXDTO.ValueType.StringQualifiers.Length);
			
			Если ТипЗнч(КолонкаXDTO.ValueType.StringQualifiers.AllowedLength) = Тип("ДопустимаяДлина") Тогда
				_ДопустимаяДлина = КолонкаXDTO.ValueType.StringQualifiers.AllowedLength;
			Иначе
				_ДопустимаяДлина = ДопустимаяДлина[КолонкаXDTO.ValueType.StringQualifiers.AllowedLength];
			КонецЕсли;
			
			КвалификаторыСтроки = Новый КвалификаторыСтроки(Длина, _ДопустимаяДлина);
			
			МассивТипов.Добавить(Тип("Строка"));
			
		КонецЕсли;
		
		Если СвойстваValueType.Получить("DateQualifiers") <> Неопределено
			И КолонкаXDTO.ValueType.DateQualifiers <> Неопределено Тогда
			
			Если ТипЗнч(КолонкаXDTO.ValueType.DateQualifiers.DateFractions) = Тип("ЧастиДаты") Тогда
				_ЧастиДаты = КолонкаXDTO.ValueType.DateQualifiers.DateFractions;
			Иначе
				_ЧастиДаты = ЧастиДаты[КолонкаXDTO.ValueType.DateQualifiers.DateFractions];
			КонецЕсли;
			
			КвалификаторыДаты = Новый КвалификаторыДаты(_ЧастиДаты);
			
			МассивТипов.Добавить(Тип("Дата"));
			
		КонецЕсли;
		
		Если Найти(НРег(КолонкаXDTO.ValueType.Type), "boolean") > 0 Тогда
			МассивТипов.Добавить(Тип("Булево"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(МассивТипов) Тогда
			ОписаниеТипаКолонки = Новый ОписаниеТипов(МассивТипов, КвалификаторыЧисла, КвалификаторыСтроки, КвалификаторыДаты);
		Иначе
			ОписаниеТипаКолонки = Неопределено;
		КонецЕсли;
		
		КоллекцияКолонок.Добавить(КолонкаXDTO.Name, ОписаниеТипаКолонки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Добавить_ИндексыXDTO_В_ИндексыКоллекции(ИндексыXDTO, ИндексыКоллекции)
	
	Для Каждого ИндексXDTO Из ИндексыXDTO Цикл
		
		Если ТипЗнч(ИндексXDTO.column) = Тип("СписокXDTO") Тогда
			
			КолонкиИндекса = "";
			Разделитель = "";
			
			Для Каждого КолонкаИндекса Из ИндексXDTO.column Цикл
				КолонкиИндекса = КолонкиИндекса + Разделитель + КолонкаИндекса;
				Разделитель = ", ";
			КонецЦикла;
			
		Иначе
			КолонкиИндекса = ИндексXDTO.column;
		КонецЕсли;
		
		ИндексыКоллекции.Добавить(КолонкиИндекса);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Добавить_СписокXDTO_В_Дерево(СписокXDTO, СтрокиДерева)
	
	Для Каждого СтрокаXDTO Из СписокXDTO Цикл
		
		НоваяСтрока = СтрокиДерева.Добавить();
		
		ИндексКолонки = -1;
		Для Каждого ЗначениеКолонки Из СтрокаXDTO.Value Цикл
			
			ИндексКолонки = ИндексКолонки + 1;
			
			Если ТипЗнч(ЗначениеКолонки) <> Тип("ОбъектXDTO") Тогда
				НоваяСтрока[ИндексКолонки] = ЗначениеКолонки;
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокаXDTO.Свойства().Получить("row") <> Неопределено Тогда
			
			Добавить_СписокXDTO_В_Дерево(СтрокаXDTO.row, НоваяСтрока.Строки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Дерево_В_Таблицу(Дерево, СИерархией)
	
	Таблица = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из Дерево.Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	ЗаполнитьТаблицуИзДерева(Таблица, Дерево, СИерархией);
	
	Возврат Таблица;
	
КонецФункции

Процедура ЗаполнитьТаблицуИзДерева(Таблица, Дерево, СИерархией)
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.Строки) Тогда
			
			Если СИерархией Тогда
				ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаДерева);
			КонецЕсли;
			
			ЗаполнитьТаблицуИзДерева(Таблица, СтрокаДерева, СИерархией);
			
		Иначе
			ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаДерева);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РазложитьСтрокуВМассивСлов(Знач Строка, РазделителиСлов = ",")
	
	Слова = Новый Массив;
	
	Для Сч = 1 По СтрДлина(РазделителиСлов) Цикл
		Строка = СтрЗаменить(Строка, Сред(РазделителиСлов, Сч, 1), Символы.ПС);
	КонецЦикла;
	
	Для Сч = 1 По СтрЧислоСтрок(Строка) Цикл
		
		ТекСлово = СокрЛП(СтрПолучитьСтроку(Строка, Сч));
		Если ТекСлово <> "" Тогда
			Слова.Добавить(ТекСлово);
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Слова;
	
КонецФункции

Функция НовыйОбъектXDTO(мФабрика, Тип_Основной, СоздатьВложенныеОбъекты = Ложь)
	
	Результат = мФабрика.Создать(Тип_Основной);
	
	Если СоздатьВложенныеОбъекты Тогда
		
		Для Каждого Эл Из Тип_Основной.Свойства Цикл
			
	        флСвойствоНеСписковое =	(Эл.ВерхняяГраница = 1);
			
			Если Эл.Тип.URIПространстваИмен = Тип_Основной.URIПространстваИмен 
				И флСвойствоНеСписковое	Тогда
				
				Если ТипЗнч(Эл.Тип) = Тип("ТипОбъектаXDTO") Тогда // вложенные свойства создаем только для объектов
					Результат[Эл.Имя] = НовыйОбъектXDTO(мФабрика, Эл.Тип, СоздатьВложенныеОбъекты);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйДочернийОбъектXDTO(Фабрика, Родитель, ИмяЭлемента, ЗначениеЭлемента = Неопределено)
	
	СвойствоДочернего	 = Родитель.Тип().Свойства.Получить(ИмяЭлемента);
	ТипДочернего		 = СвойствоДочернего.Тип;
	ЭтоСписок			 = СвойствоДочернего.ВерхняяГраница <> 1;
	
	Если ЗначениеЭлемента = Неопределено Тогда
		Результат = Фабрика.Создать(ТипДочернего);
	Иначе
		Результат = Фабрика.Создать(ТипДочернего, ЗначениеЭлемента);
	КонецЕсли;
	
	Если ЭтоСписок Тогда
		Родитель[ИмяЭлемента].Добавить(Результат);
	Иначе
		Родитель[ИмяЭлемента] = Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначениеXDTO(Объект, ИмяСвойства, ЗначениеПоУмолчанию = Неопределено)
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Объект, ИмяСвойства) Тогда
		
		Попытка
			Результат = Объект[ИмяСвойства];
		Исключение
			Сообщить("Не удалось прочитать свойство " + ИмяСвойства);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обертка для отладки: перехватывает исключение при установке значения неподходящего типа в реквизит.
//
Процедура УстановитьЗначениеXDTO(Элемент, ИмяРеквизита, ЗначениеРеквизита, ЭтоСсылка = Ложь)

	Если ЗначениеРеквизита = Неопределено
		Или ЗначениеРеквизита = NULL Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		// здесь можно добавить проверки на заполненность, вывод сообщений и т.д.
		
		Если ЭтоСсылка Тогда
			Элемент[ИмяРеквизита] = ЗначениеВСтрокуВнутр(ЗначениеРеквизита);
		ИначеЕсли ТипЗнч(ЗначениеРеквизита) = Тип("Строка") Тогда
			Элемент[ИмяРеквизита] = СокрЛП(ЗначениеРеквизита);
		Иначе	
			Элемент[ИмяРеквизита] = ЗначениеРеквизита;
		КонецЕсли;
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		Сообщить("Исключение при заполнении реквизита """ + ИмяРеквизита + """:
				 |" + ОписаниеОшибки);
		
	КонецПопытки;

КонецПроцедуры

// Для совместимости с визуализацией печатных форм электронных документов
//
Функция ОбъектXDTOВСтруктуру(ОбъектXDTO, ПреобразовыватьСпискиВМассивы = Истина) Экспорт
	
	// второй параметр уже не имеет смысла, похоже
	
	Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		
		Результат = Новый Структура;
		
		Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
			
			Если Найти(Свойство.Имя, "_ReadOnly") > 0 Тогда
				ИмяСвойстваДляВставки = СтрЗаменить(Сред(Свойство.Имя, 2), "_ReadOnly", "");
			Иначе
				ИмяСвойстваДляВставки = Свойство.Имя;
			КонецЕсли;
			
			ЭтоСсылка = ЭтоТипОбъектаXDTOСсылка(Свойство.Тип);
			
			Если Найти(ИмяСвойстваДляВставки, "Ссылка") > 0 ИЛИ ЭтоСсылка Тогда
				
				мЗначение = ОбъектXDTO[Свойство.Имя];
				Если ЗначениеЗаполнено(мЗначение) Тогда
					мСсылка = ЗначениеИзСтрокиВнутр(ОбъектXDTO[Свойство.Имя]);
					Результат.Вставить(ИмяСвойстваДляВставки, мСсылка);
				Иначе
					Результат.Вставить(ИмяСвойстваДляВставки, Неопределено);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Свойство.Тип) = Тип("ТипЗначенияXDTO")
				Или Свойство.Тип.Имя = "anyType" Тогда // костыль для ссылок на справочники
				
				мЗначение = ОбъектXDTO[Свойство.Имя];
				
				Если ТипЗнч(мЗначение) = Тип("СписокXDTO") Тогда
					
					Если Не Результат.Свойство(ИмяСвойстваДляВставки) Тогда
						Результат.Вставить(ИмяСвойстваДляВставки, Новый Массив);
					КонецЕсли;
					
					Для Каждого ЭлементСписка Из мЗначение Цикл
						Результат[ИмяСвойстваДляВставки].Добавить(ЭлементСписка);
					КонецЦикла;
					
				Иначе
					
					Результат.Вставить(ИмяСвойстваДляВставки, мЗначение);
					
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Свойство.Тип) = Тип("ТипОбъектаXDTO") Тогда	
				
				Результат.Вставить(ИмяСвойстваДляВставки, ОбъектXDTOВСтруктуру(ОбъектXDTO[Свойство.Имя], ПреобразовыватьСпискиВМассивы));
				
			КонецЕсли;
			
		КонецЦикла;
	
	ИначеЕсли ТипЗнч(ОбъектXDTO) = Тип("СписокXDTO") Тогда
		
		Если ПреобразовыватьСпискиВМассивы Тогда
			
			Результат = Новый Массив;
			Для Каждого ЭлементСписка Из ОбъектXDTO Цикл
				Результат.Добавить(ОбъектXDTOВСтруктуру(ЭлементСписка, ПреобразовыватьСпискиВМассивы));
			КонецЦикла;
			
		Иначе	
			
			Результат = Новый ТаблицаЗначений;
			Для Каждого Свойство Из ОбъектXDTO.ВладеющееСвойство.Тип.Свойства Цикл
				Результат.Колонки.Добавить(Свойство.Имя);
			КонецЦикла;
			
			Для Каждого ЭлементСписка Из ОбъектXDTO Цикл
				
				НоваяСтрока = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементСписка);
				// хорошо бы еще вложенные таблицы тоже преобразовать
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйProtoОбъектXDTO(Знач ИмяКонтента, СоздатьВсеСвойства = Истина) Экспорт
	
	Если НРег(ИмяКонтента) = НРег(ТипПрото_ИнформацияПокупателя736()) Тогда
		// Контент ответного титула УКД аналогичен УПД
		ИмяКонтента = ТипПрото_ИнформацияПокупателя155();
	КонецЕсли;
	
	ProtoФабрикаXDTO = ProtoФабрикаXDTO();
	
	ТипXDTO = ProtoФабрикаXDTO.Тип(ПространствоИменПрото(), ИмяКонтента);
	
	Возврат НовыйОбъектXDTO(ProtoФабрикаXDTO, ТипXDTO, СоздатьВсеСвойства);
	
КонецФункции

Функция ProtoФабрикаXDTO() Экспорт
	
	Результат = XML_ФабрикаXDTO("Proto");
	
	Возврат Результат;
	
КонецФункции

