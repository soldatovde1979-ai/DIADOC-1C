Процедура ПроверитьФорматДаты(СписокОшибок, Значение, Представление, ОбязательноеЗаполнение = Ложь)
	
	ТекстОшибки = ОшибкаФорматаДаты(Значение, Представление, ОбязательноеЗаполнение);
	ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);

КонецПроцедуры

Функция ОшибкаФорматаДаты(Знач Значение, Представление, ОбязательноеЗаполнение = Ложь)
	
	Результат = "";
	
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("Дата");
		Значение = ОписаниеТипа.ПривестиЗначение(Значение);
	КонецЕсли;
	
	Если ОбязательноеЗаполнение И Не ЗначениеЗаполнено(Значение) Тогда 
		
		Результат = "не заполнена";
		
	ИначеЕсли Значение < '19000101' ИЛИ Значение >= '21000101' Тогда 
		
		Результат = "(" + Формат(Значение, "ДФ=dd.MM.yyyy") + ") должна находиться в интервале 01.01.1900 - 31.12.2099";
		
	КонецЕсли;
	
	Если Результат <> "" Тогда
		Результат = Представление + " " + Результат;
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

Процедура ПроверитьФорматПоля(СписокОшибок, Значение, Представление, Обязательность = Ложь, МинимальнаяДлина = 0, МаксимальнаяДлина = 0, ТолькоЦифры = Ложь, Род = "м", Число = "ед")
	
	ТекстОшибки = ОшибкаФорматаПоля(Значение, Представление, Обязательность, МинимальнаяДлина, МаксимальнаяДлина, ТолькоЦифры, Род, Число);
	ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
	
КонецПроцедуры

Функция ОшибкаФорматаПоля(Знач Значение, Представление, Обязательность = Ложь, МинимальнаяДлина = 0, МаксимальнаяДлина = 0, ТолькоЦифры = Ложь, Род = "м", Число = "ед")
	
	Результат = "";
	КоличествоСимволовОграниченияВидимости = 147;
	
	Значение = СокрЛП(Значение);
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда 
		
		Если Обязательность Тогда
			Результат = "не " + ГлаголВалидации_Заполнен(Род, Число);
		КонецЕсли;	
		
	ИначеЕсли МинимальнаяДлина = МаксимальнаяДлина И МинимальнаяДлина > 0 И СтрДлина(Значение) <> МинимальнаяДлина Тогда
		// частный случай - фиксированая длина поля
		
		Результат = "(" + Значение + ") " + ГлаголВалидации_Должен(Род, Число) + " состоять из " + МинимальнаяДлина;
		
		Если ТолькоЦифры Тогда
			Результат = Результат + " цифр";
		Иначе
			Результат = Результат + " символов";
		КонецЕсли;
		
	ИначеЕсли СтрДлина(Значение) < МинимальнаяДлина Тогда
		
		Результат = "(" + Значение + ") не " + ГлаголВалидации_Должен(Род, Число) + " быть короче " + МинимальнаяДлина + " символов";
		
	ИначеЕсли СтрДлина(Значение) > МаксимальнаяДлина И МаксимальнаяДлина > 0 Тогда  // по умолчанию длину не ограничиваем
		
		ВидимоеЗначение = Лев(Значение, КоличествоСимволовОграниченияВидимости) + "...";
		
		Результат =
			"(" + ВидимоеЗначение
			+ ") не " + ГлаголВалидации_Должен(Род, Число) + " быть длиннее " + МаксимальнаяДлина + " символов";
		
		// тут можно явно указывать требуемую по формату длину: от и до.
		
	ИначеЕсли ТолькоЦифры И НЕ СтрокаСодержитТолькоЦифры(Значение) Тогда
		
		Результат = ГлаголВалидации_Должен(Род, Число) + " состоять из цифр";
		
	КонецЕсли;
	
	Если Результат <> "" Тогда
		Результат = Представление + " " + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГлаголВалидации_Заполнен(Род, Число)
	
	Если Число = "ед" Тогда
		
		Если Род = "ж" Тогда
			Результат = "заполнена";
		ИначеЕсли Род = "м" Тогда
			Результат = "заполнен";
		ИначеЕсли Род = "с" Тогда
			Результат = "заполнено";
		КонецЕсли;
		
	Иначе
		Результат = "заполнены";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГлаголВалидации_Должен(Род, Число)
	
	Если Число = "ед" Тогда
		
		Если Род = "ж" Тогда
			Результат = "должна";
		ИначеЕсли Род = "м" Тогда
			Результат = "должен";
		ИначеЕсли Род = "с" Тогда
			Результат = "должно";
		КонецЕсли;
		
	Иначе
		Результат = "должны";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//Проверяет есть ли в строке символы отличные от "0123456789"
// Возвращаемое значение:
//	Булево
Функция СтрокаСодержитТолькоЦифры(СтрокаПроверки)
	
	Для й = 1 По СтрДлина(СтрокаПроверки) Цикл
		
		ПроверяемыйСимвол = Сред(СтрокаПроверки, й, 1);
		
		Если ПроверяемыйСимвол < "0" ИЛИ ПроверяемыйСимвол > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция УмножитьВектора(ИНН, Множители)
	Результат = 0;
	н = 0;
	Пока найти(Множители, ":") > 0 Цикл
		н = н + 1;
		Множитель = число(Лев(Множители, Найти(Множители, ":") - 1));
		Множители = прав(Множители, СтрДлина(Множители) - найти(Множители, ":"));
		
		Результат = Результат + Множитель * число(Сред(ИНН, н, 1));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


