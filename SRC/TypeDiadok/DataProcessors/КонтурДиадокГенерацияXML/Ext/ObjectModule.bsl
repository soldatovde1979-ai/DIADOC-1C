Процедура Заполнить_AddressInfo(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АдрРф") Тогда
		
		Контент.IsForeign	= Ложь;
		УстановитьЗначениеXDTO(Контент, "ZipCode",		ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Индекс"));
		УстановитьЗначениеXDTO(Контент, "RegionCode",	ПолучитьЗначениеXDTO(Параметры.АдрРф,	"КодРегион"));
		УстановитьЗначениеXDTO(Контент, "Locality",		ПолучитьЗначениеXDTO(Параметры.АдрРф,	"НаселПункт"));
		УстановитьЗначениеXDTO(Контент, "Territory",	ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Район"));
		УстановитьЗначениеXDTO(Контент, "City",			ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Город"));
		УстановитьЗначениеXDTO(Контент, "Street",		ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Улица"));
		УстановитьЗначениеXDTO(Контент, "Building",		ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Дом"));
		УстановитьЗначениеXDTO(Контент, "Block",		ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Корпус"));
		УстановитьЗначениеXDTO(Контент, "Apartment",	ПолучитьЗначениеXDTO(Параметры.АдрРф,	"Кварт"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АдрИно") Тогда	
		
		Контент.IsForeign	= Истина;
		УстановитьЗначениеXDTO(Контент, "CountryCode",	ПолучитьЗначениеXDTO(Параметры.АдрИно,	"КодСтр"));
		УстановитьЗначениеXDTO(Контент, "AddressText",	ПолучитьЗначениеXDTO(Параметры.АдрИно,	"АдрТекст"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АдрИнф") Тогда
		
		Контент.IsForeign	= Истина;
		УстановитьЗначениеXDTO(Контент, "CountryCode",	ПолучитьЗначениеXDTO(Параметры.АдрИнф,	"КодСтр"));
		УстановитьЗначениеXDTO(Контент, "AddressText",	ПолучитьЗначениеXDTO(Параметры.АдрИнф,	"АдрТекст"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АдрТекст") Тогда	
		
		Контент.IsForeign	= Ложь;
		УстановитьЗначениеXDTO(Контент, "AddressText",	ПолучитьЗначениеXDTO(Параметры,	"АдрТекст"));
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "КодГАР") Тогда
		
		Контент.IsForeign	= Ложь;
		УстановитьЗначениеXDTO(Контент, "AddressCode",	ПолучитьЗначениеXDTO(Параметры,	"КодГАР"));
		
	КонецЕсли;
	
КонецПроцедуры

