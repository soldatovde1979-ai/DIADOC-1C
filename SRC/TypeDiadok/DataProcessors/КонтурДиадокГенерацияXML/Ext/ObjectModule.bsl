//{	Методы для заполнения универсальной табличной части

Функция ЭДО_ПолучитьТабличнуюЧастьИзКонтентаXML(Контент, НеИспользуется_ЭтоКорректировка = Ложь) Экспорт
	
	Если ТипЗнч(Контент) = Тип("Строка")
		Или ТипЗнч(Контент) = Тип("ДвоичныеДанные") Тогда
		ОбъектXDTO = XML_В_ОбъектXDTO(Контент);
	Иначе
		ОбъектXDTO = Контент;
	КонецЕсли;
	
	ТипКонтента = ПолучитьТипКонтентаОбъектаXDTO(ОбъектXDTO);
	
	Если ТипКонтента = ТипПрото_ИнформацияПродавца155() Тогда
		
		Результат = ТабличнаяЧасть_UniversalTransferDocument(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца970() Тогда
		
		Результат = ТабличнаяЧасть_UniversalTransferDocument970(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца820() Тогда
		
		Результат = ТабличнаяЧасть_UniversalTransferDocument820(ОбъектXDTO);	
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца736() Тогда
		
		Результат = ТабличнаяЧасть_UniversalCorrectionDocument(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца552() Тогда
		
		Результат = ТабличнаяЧасть_XmlAcceptanceCertificate552(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавца551() Тогда
		
		Результат = ТабличнаяЧасть_TovTorg(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаНакладная172() Тогда
		
		Результат = ТабличнаяЧасть_XmlTorg12(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаАкт172() Тогда
		
		Результат = ТабличнаяЧасть_XmlAcceptanceCertificate(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаСчетНаОплату() Тогда
		
		Результат = ТабличнаяЧасть_ProformaInvoice(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияОтправителя423() Тогда
		
		Результат = ТабличнаяЧасть_Torg2(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаСчетНаОплату29() Тогда
		
		Результат = ТабличнаяЧасть_ProformaInvoice29(ОбъектXDTO);
		
	ИначеЕсли ТипКонтента = ТипПрото_ИнформацияПродавцаНакладнаяРБ01() Тогда
		
		Результат = ТабличнаяЧасть_НакладнаяРБ01(ОбъектXDTO);
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Невозможно получить табличную часть xml документа, неизвестный формат.'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧасть_UniversalTransferDocument(ОбъектXDTO)
	
	Результат	 = Новый_ТабличнаяЧасть();
	СписокXDTO	 = СписокXDTOИзЭлемента(ОбъектXDTO.Документ.ТаблСчФакт, "СведТов");
	
	Для Каждого СтрокаXDTO Из СписокXDTO Цикл
		
		ИнфоПоля = ПрочитатьТекстИнфТипUtd(СтрокаXDTO);
		ИдентификаторНоменклатуры = ПрочитатьИдентификаторНоменклатуры(ИнфоПоля);
		НоменклатураЭД = НоменклатураЭлектронногоДокумента155(СтрокаXDTO, ИдентификаторНоменклатуры);
		
		СтрокаТЧ = Результат.Добавить();
		
		ЭДО_ЗаполнитьДопИнформациюСтрокиТЧ(СтрокаТЧ, ИнфоПоля);
		ПередаточныеДокументы_ЗаполнитьСтрокуТабличнойЧастиПоНоменклатуреДокумента(
			СтрокаТЧ,
			НоменклатураЭД
		);
		
		СтрокаТЧ.Количество		 = ПолучитьЗначениеXDTO(СтрокаXDTO, "КолТов");
