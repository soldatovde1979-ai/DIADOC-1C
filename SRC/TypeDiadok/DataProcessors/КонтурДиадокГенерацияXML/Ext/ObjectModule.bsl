Процедура Заполнить_Item970(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Product", ПолучитьЗначениеXDTO(Параметры, "НаимТов"));
	УстановитьЗначениеXDTO(Контент, "Unit", ПолучитьЗначениеXDTO(Параметры, "ОКЕИ_Тов"));
	УстановитьЗначениеXDTO(Контент, "UnitName", ПолучитьЗначениеXDTO(Параметры, "НаимЕдИзм"));
	УстановитьЗначениеXDTO(Контент, "Quantity", ПолучитьЗначениеXDTO(Параметры, "КолТов"));
	УстановитьЗначениеXDTO(Контент, "Price", ПолучитьЗначениеXDTO(Параметры, "ЦенаТов"));
	УстановитьЗначениеXDTO(Контент, "SubtotalWithVatExcluded", ПолучитьЗначениеXDTO(Параметры, "СтТовБезНДС"));
	УстановитьЗначениеXDTO(Контент, "Subtotal", ПолучитьЗначениеXDTO(Параметры, "СтТовУчНал"));
	УстановитьЗначениеXDTO(Контент, "TaxRate", TaxRate_Из_НалСт(Параметры.НалСт));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Акциз") Тогда
		УстановитьЗначениеXDTO(Контент, "Excise", Акциз_Из_XML(Параметры.Акциз));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНал, "СумНал") Тогда
		УстановитьЗначениеXDTO(Контент, "Vat", Параметры.СумНал.СумНал);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНал, "БезНДС") Тогда
		УстановитьЗначениеXDTO(Контент, "WithoutVat", "true");
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСведТов") Тогда
		
		ДопСведТов = Параметры.ДопСведТов;
		
		ItemMark = ItemMark(ПолучитьЗначениеXDTO(ДопСведТов, "ПрТовРаб"));
		
		УстановитьЗначениеXDTO(Контент, "ItemMark",	ItemMark);
		УстановитьЗначениеXDTO(Контент, "AdditionalProperty", ПолучитьЗначениеXDTO(ДопСведТов, "ДопПризн"));
		УстановитьЗначениеXDTO(Контент, "ItemToRelease", ПолучитьЗначениеXDTO(ДопСведТов, "НадлОтп"));
		УстановитьЗначениеXDTO(Контент, "ItemCharact", ПолучитьЗначениеXDTO(ДопСведТов, "ХарактерТов"));
		УстановитьЗначениеXDTO(Контент, "ItemKind", ПолучитьЗначениеXDTO(ДопСведТов, "СортТов"));
		УстановитьЗначениеXDTO(Контент, "ItemArticle", ПолучитьЗначениеXDTO(ДопСведТов, "АртикулТов"));
		УстановитьЗначениеXDTO(Контент, "ItemVendorCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодТов"));
		УстановитьЗначениеXDTO(Контент, "CatalogCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодКат"));
		УстановитьЗначениеXDTO(Контент, "ItemTypeCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодВидТов"));
		
		КрНаимСтрПрЗнач = ПолучитьЗначениеXDTO(ДопСведТов, "КрНаимСтрПр");
		Если ЭтоСписокXDTO(КрНаимСтрПрЗнач) Тогда
			КрНаимСтрПрСтрока = ПолучитьЗначенияСпискаXDTOСтрокой(КрНаимСтрПрЗнач);
			УстановитьЗначениеXDTO(Контент, "Country", КрНаимСтрПрСтрока);
		Иначе
			УстановитьЗначениеXDTO(Контент, "Country", КрНаимСтрПрЗнач);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "GTIN", ПолучитьЗначениеXDTO(ДопСведТов, "ГТИН"));
		УстановитьЗначениеXDTO(Контент, "Series", ПолучитьЗначениеXDTO(ДопСведТов, "СерияТов"));
		УстановитьЗначениеXDTO(Контент, "ProductTypeCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодВидПр"));
		УстановитьЗначениеXDTO(Контент, "CodeRCPEA", ПолучитьЗначениеXDTO(ДопСведТов, "КодТовОКПД2"));
		УстановитьЗначениеXDTO(Контент, "AdditionalInfoTypeOperations", ПолучитьЗначениеXDTO(ДопСведТов, "ДопИнфПВидО"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСведТов, "СумНалВосст") Тогда
			
			СуммаНалога = ПолучитьЗначениеXDTO(ДопСведТов.СумНалВосст, "СумНал");
			
			ЗначениеТэгаБезНДС = ПолучитьЗначениеXDTO(ДопСведТов.СумНалВосст, "БезНДС");
			ЭтоСуммаНалогаБезНДС = (ЗначениеТэгаБезНДС = СтрокаБезНДС());
			
			УстановитьЗначениеXDTO(Контент, "RecoveredWithoutVat", ЭтоСуммаНалогаБезНДС);
			УстановитьЗначениеXDTO(Контент, "RecoveredVat", СуммаНалога);
			
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСведТов, "НалУчАморт") Тогда
			Заполнить_TaxDeprication(Контент.TaxDeprication, ДопСведТов.НалУчАморт);
		КонецЕсли;
		
		Для Каждого СведПрослеж Из СписокXDTOИзЭлемента(ДопСведТов, "СведПрослеж") Цикл
			НовыйЭлементСписка = НовыйЭлементСпискаXDTO(Контент.ItemTracingInfos); 
			Заполнить_ItemTracingInfo970(НовыйЭлементСписка, СведПрослеж);
		КонецЦикла;
		
		Для Каждого НомСредИдентТов Из СписокXDTOИзЭлемента(ДопСведТов, "НомСредИдентТов") Цикл
			НовыйЭлементСписка = НовыйЭлементСпискаXDTO(Контент.ItemIdentificationNumbers); 
			Заполнить_ItemIdentificationNumber970(НовыйЭлементСписка, НомСредИдентТов);
		КонецЦикла;
		
		Для Каждого СопрДокТов Из СписокXDTOИзЭлемента(ДопСведТов, "СопрДокТов") Цикл
			НовыйЭлементСписка = НовыйЭлементСпискаXDTO(Контент.ItemAccompanyingDocuments);
			Заполнить_DocumentDetails(НовыйЭлементСписка, СопрДокТов);
		КонецЦикла;
		
		Для Каждого СвГосСист Из СписокXDTOИзЭлемента(ДопСведТов, "СвГосСист") Цикл
			НовыйЭлементСписка = НовыйЭлементСпискаXDTO(Контент.AdditionalInfoStateSystem);
			Заполнить_AdditionalInfoStateSystem(НовыйЭлементСписка, СвГосСист);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СвДТ Из СписокXDTOИзЭлемента(Параметры, "СвДТ") Цикл
		НовыйЭлементСписка = НовыйЭлементСпискаXDTO(Контент.CustomDeclarations);
		Заполнить_CustomDeclaration(НовыйЭлементСписка, СвДТ);
	КонецЦикла;
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолФХЖ2");
	
КонецПроцедуры

