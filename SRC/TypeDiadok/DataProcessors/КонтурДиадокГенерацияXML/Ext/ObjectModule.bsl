// МЕТОДЫ РАБОТЫ С УС

// Возвращает заполненный контракт УС из XML
//
// Параметры:
//  КонтентУС - Строка, ДвоичныеДанные - Данные УС в формате XML
//  КонтрактУС - Структура - Контракт УС см. Ядро.Контракт_ДанныеУниверсальногоСообщенияРасширенный()
// 
// Возвращаемое значение:
//  Структура - Заполненный контракт УС см. Ядро.Контракт_ДанныеУниверсальногоСообщенияРасширенный()
//
Функция УС_ДанныеУниверсальногоСообщенияXML_ФНС(КонтентУС, КонтрактУС) Экспорт
	// BSLLS:Typo-off
	
	ContentXDTO	= XML_В_ОбъектXDTO(КонтентУС);
	
	ДокументУС = ПолучитьЗначениеXDTO(ContentXDTO, "Документ");
	СвСобытДок = ПолучитьЗначениеXDTO(ДокументУС, "СвСобытДок");
	
	КонтрактУС.Код = ПолучитьЗначениеXDTO(СвСобытДок, "СтатусУС");
	КонтрактУС.ТекстСообщения = ПолучитьЗначениеXDTO(СвСобытДок, "ТекстУС");
	
	ОтпрУС = ПолучитьЗначениеXDTO(ДокументУС, "ОтпрУС");
	СвЛицОтпрУС = ПолучитьЗначениеXDTO(ОтпрУС, "СвЛицОтпрУС");
	КонтрактУС.Отправитель = УС_ДанныеУниверсальногоСообщенияXML_Участник(СвЛицОтпрУС, КонтрактУС.Отправитель);
	
	КонтрактУС.ИдентификаторОтправителя = ПолучитьЗначениеXDTO(ОтпрУС, "ИдОтпрУС");
	
	ПолучУС = ПолучитьЗначениеXDTO(ДокументУС, "ПолучУС");
	СвЛицПолучУС = ПолучитьЗначениеXDTO(ПолучУС, "СвЛицПолучУС");
	КонтрактУС.Получатель = УС_ДанныеУниверсальногоСообщенияXML_Участник(СвЛицПолучУС, КонтрактУС.Получатель);

	КонтрактУС.ИдентификаторПолучателя = ПолучитьЗначениеXDTO(ПолучУС, "ИдПолучУС");
	
	Возврат КонтрактУС;

	// BSLLS:Typo-on
КонецФункции

Функция УС_ДанныеУниверсальногоСообщенияXML_Участник(КонтентУС_Участник, КонтрактУС_Участник)
	// BSLLS:Typo-off

	ФИО = ПолучитьЗначениеXDTO(КонтентУС_Участник, "ФИО");
	КонтрактУС_Участник.Фамилия = ПолучитьЗначениеXDTO(ФИО, "Фамилия");
	КонтрактУС_Участник.Имя = ПолучитьЗначениеXDTO(ФИО, "Имя");
	КонтрактУС_Участник.Отчество = ПолучитьЗначениеXDTO(ФИО, "Отчество", "");
	
	КонтрактУС_Участник.Должность = ПолучитьЗначениеXDTO(КонтрактУС_Участник, "Должн", "");
	
	Возврат КонтрактУС_Участник;

	// BSLLS:Typo-on
КонецФункции
