Процедура XML_ЗаполнитьАдресТип(ИмяПакетаXDTO, АдресТип, Address_Torg2)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЗначениеЗаполнено(Address_Torg2.RussianAddress.Region) Тогда
		
		RussianAddress = Address_Torg2.RussianAddress;
		АдрРФ = НовыйДочернийОбъектXDTO(Фабрика, АдресТип, "АдрРФ");
		
		УстановитьЗначениеXDTO(АдрРФ, "Индекс", ПолучитьЗначениеXDTO(RussianAddress, "ZipCode"));
		УстановитьЗначениеXDTO(АдрРФ, "КодРегион", RussianAddress.Region);
		УстановитьЗначениеXDTO(АдрРФ, "Район", ПолучитьЗначениеXDTO(RussianAddress, "Territory"));
		УстановитьЗначениеXDTO(АдрРФ, "Город", ПолучитьЗначениеXDTO(RussianAddress, "City"));
		УстановитьЗначениеXDTO(АдрРФ, "НаселПункт", ПолучитьЗначениеXDTO(RussianAddress, "Locality"));
		УстановитьЗначениеXDTO(АдрРФ, "Улица", ПолучитьЗначениеXDTO(RussianAddress, "Street"));
		УстановитьЗначениеXDTO(АдрРФ, "Дом", ПолучитьЗначениеXDTO(RussianAddress, "Building"));
		УстановитьЗначениеXDTO(АдрРФ, "Корпус", ПолучитьЗначениеXDTO(RussianAddress, "Block"));
		УстановитьЗначениеXDTO(АдрРФ, "Кварт", ПолучитьЗначениеXDTO(RussianAddress, "Apartment"));
		
	ИначеЕсли ЗначениеЗаполнено(Address_Torg2.ForeignAddress.Address) Тогда
		
		ForeignAddress = Address_Torg2.ForeignAddress;
		АдрИнф = НовыйДочернийОбъектXDTO(Фабрика, АдресТип, "АдрИнф");
		
		УстановитьЗначениеXDTO(АдрИнф, "КодСтр", ForeignAddress.Country);
		УстановитьЗначениеXDTO(АдрИнф, "АдрТекст", ForeignAddress.Address);
		
	Иначе
		
		УстановитьЗначениеXDTO(АдресТип, "КодГАР", Address_Torg2.AddressCode);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьТекстовуюИнформацию(ИмяПакетаXDTO, ОбъектXDTO, AdditionalInfos, ТипОбъектаКоллекции = "ТекстИнфТип")
	
	Если НЕ ЗначениеЗаполнено(AdditionalInfos) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого AdditionalInfo Из AdditionalInfos Цикл
		ТекстИнф = XML_ПолучитьПустойОбъектXDTO(ТипОбъектаКоллекции, ИмяПакетаXDTO);
		Заполнить_ЗначенИдентиф(ТекстИнф, AdditionalInfo);
		ОбъектXDTO.Добавить(ТекстИнф);
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ЗаполнитьПодписанта(ИмяПакетаXDTO, ОбъектXDTO, Content, ИмяСвойства)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого Signer Из СписокXDTOИзЭлемента(Content, ИмяСвойства) Цикл
		
		Если Не ЗначениеЗаполнено(Signer.FirstName) Тогда 
			Продолжить;
		КонецЕсли;
		
		Подписант = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "Подписант");
		
		Если Signer.IsSoleProprietor Тогда
			
			ИП = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ИП");
			XML_ЗаполнитьИндивидуальногоПредпринимателяПодписанта(ИмяПакетаXDTO, ИП, Signer);
			
		Иначе
			
			ЮЛ = НовыйДочернийОбъектXDTO(Фабрика, Подписант, "ЮЛ");
			XML_ЗаполнитьЮридическоеЛицоПодписанта(ИмяПакетаXDTO, ЮЛ, Signer);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ЗаполнитьРасширенныхПодписантов(ИмяПакетаXDTO, ОбъектXDTO, Content)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого ExtendedSigner Из СписокXDTOИзЭлемента(Content, "Signers") Цикл
		
		SignerDetails		 = ExtendedSigner.SignerDetails;
		Статус				 = XML_СтатусПодписанта(SignerDetails.Status);
		ОбластьПолномочий	 = XML_ОбластьПолномочийПодписанта(SignerDetails.Powers);
		
		// Сведения о лице, подписавшем информацию покупателя в электронном виде
		Подписант = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "Подписант");
		XML_ЗаполнитьРасширенногоПодписанта(ИмяПакетаXDTO, Подписант, SignerDetails, Статус, ОбластьПолномочий);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура XML_ЗаполнитьРасширенногоПодписанта(ИмяПакетаXDTO, ОбъектXDTO, SignerDetails, Статус, ОбластьПолномочий)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "Статус"		, Статус);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ОблПолн"	, ОбластьПолномочий);
	УстановитьЗначениеXDTO(ОбъектXDTO, "ОснПолнОрг"	, SignerDetails.OrganizationPowersBase);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ОснПолн") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснПолн", SignerDetails.PowersBase);
	Иначе
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснПолнПодп", SignerDetails.PowersBase);
	КонецЕсли;
	
	Если SignerDetails.SignerType = "PhysicalPerson" Тогда
		
		// Физическое лицо
		ФЛ = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ФЛ");
		XML_ЗаполнитьФизическоеЛицоПодписанта(ИмяПакетаXDTO, ФЛ, SignerDetails);
		
	ИначеЕсли SignerDetails.SignerType = "IndividualEntity" Тогда
		
		// Индивидуальный предприниматель
		ИП = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ИП");
		XML_ЗаполнитьИндивидуальногоПредпринимателяПодписанта(ИмяПакетаXDTO, ИП, SignerDetails);
		
	ИначеЕсли SignerDetails.SignerType = "LegalEntity" Тогда
		
		// Представитель юридического лица
		ЮЛ = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ЮЛ");
		XML_ЗаполнитьЮридическоеЛицоПодписанта(ИмяПакетаXDTO, ЮЛ, SignerDetails);
		
	КонецЕсли;
	
КонецПроцедуры

// Хранит соответствие значений перечисления SignerPowers и областей полномочий в схемах ФНС.
// см. https://diadoc-sdk.readthedocs.io/ru/latest/proto/utd/ExtendedSignerDetailsToPost.html
//
// Параметры:
//  ИдентификаторОбласти - Строка - Значение перечисления SignerPowers.
// 
// Возвращаемое значение:
//  Число - значение области полномочий в соответствии с форматом ФНС (ОблПолн).
//
Функция XML_ОбластьПолномочийПодписанта(ИдентификаторОбласти)
	
	// BSLLS:MagicNumber-off
	СоответствиеПолномочий = Новый Соответствие;
	
	// лицо, ответственное за подписание счетов-фактур
	СоответствиеПолномочий.Вставить("InvoiceSigner", 0);
	
	// лицо, совершившее сделку, операцию
	СоответствиеПолномочий.Вставить("PersonMadeOperation", 1);
	
	// лицо, совершившее сделку, операцию и ответственное за её оформление
	СоответствиеПолномочий.Вставить("MadeAndSignOperation", 2);
	
	// лицо, ответственное за оформление свершившегося события
	СоответствиеПолномочий.Вставить("PersonDocumentedOperation", 3);
	
	// лицо, совершившее сделку, операцию и ответственное за подписание счетов-фактур
	СоответствиеПолномочий.Вставить("MadeOperationAndSignedInvoice", 4);
	
	// лицо, совершившее сделку, операцию и ответственное за её оформление и за подписание счетов-фактур
	СоответствиеПолномочий.Вставить("MadeAndResponsibleForOperationAndSignedInvoice", 5);
	
	// лицо, ответственное за оформление свершившегося события и за подписание счетов-фактур
	СоответствиеПолномочий.Вставить("ResponsibleForOperationAndSignerForInvoice", 6);
	
	// председатель комиссии
	СоответствиеПолномочий.Вставить("ChairmanCommission", 7);
	
	// член комиссии
	СоответствиеПолномочий.Вставить("MemberCommission", 8);
	
	// лицо, в полномочия которого входит утверждение документа, оформляющего событие (факт хозяйственной жизни)
	СоответствиеПолномочий.Вставить("PersonApprovedDocument", 21);
	
	// лицо, в полномочия которого входит подтверждение оформленного события (факта хозяйственной жизни)
	СоответствиеПолномочий.Вставить("PersonConfirmedDocument", 22);
	
	// лицо, в полномочия которого входит согласование документа, оформляющего событие (факт хозяйственной жизни)
	СоответствиеПолномочий.Вставить("PersonAgreedOnDocument", 23);
	
	// лицо с иными полномочиями
	СоответствиеПолномочий.Вставить("PersonOtherPower", 29);
	// BSLLS:MagicNumber-on
	
	Результат = СоответствиеПолномочий.Получить(ИдентификаторОбласти);
	
	Возврат Результат;
	
КонецФункции

// Хранит соответствие значений перечисления SignerStatus и статусов подписанта в схемах ФНС.
// см. https://diadoc-sdk.readthedocs.io/ru/latest/proto/utd/ExtendedSignerDetailsToPost.html
//
// Параметры:
//  ИдентификаторСтатуса - Строка - Значение перечисления SignerStatus.
// 
// Возвращаемое значение:
//  Число - значение статуса подписанта в соответствии с форматом ФНС (Статус)
//
Функция XML_СтатусПодписанта(ИдентификаторСтатуса)
	
	СоответствиеСтатусов = Новый Соответствие;
	
	// BSLLS:MagicNumber-off
	// Работник организации продавца товаров (работ, услуг, имущественных прав)
	СоответствиеСтатусов.Вставить("SellerEmployee", 1);
	
	// Работник организации - составителя информации продавца
	СоответствиеСтатусов.Вставить("InformationCreatorEmployee", 2);
	
	// Работник иной уполномоченной организации
	СоответствиеСтатусов.Вставить("OtherOrganizationEmployee", 3);
	
	// Уполномоченное физическое лицо (в том числе индивидуальный предприниматель
	СоответствиеСтатусов.Вставить("AuthorizedPerson", 4);
	
	// Работник организации - покупателя
	СоответствиеСтатусов.Вставить("BuyerEmployee", 5);
	
	// Работник организации - составителя файла обмена информации покупателя, если составитель файла обмена информации покупателя не является покупателем
	СоответствиеСтатусов.Вставить("InformationCreatorBuyerEmployee", 6);
	// BSLLS:MagicNumber-on
	
	Результат = СоответствиеСтатусов.Получить(ИдентификаторСтатуса);
	
	Возврат Результат;
	
КонецФункции

Функция XML_ПолучитьПризнакНоменклатуры(ItemMark)
	
	СоответствиеПризнаков = Новый Соответствие;
	
	// BSLLS:MagicNumber-off
	СоответствиеПризнаков.Вставить("NotSpecified", Неопределено); // - не указано
	СоответствиеПризнаков.Вставить("Property", 1); // - имущество
	СоответствиеПризнаков.Вставить("Job", 2); // - работа
	СоответствиеПризнаков.Вставить("Service", 3); // - услуга
	СоответствиеПризнаков.Вставить("PropertyRights", 4); // - имущественные права
	СоответствиеПризнаков.Вставить("Other", 5); // - иное
	// BSLLS:MagicNumber-on
	
	Возврат СоответствиеПризнаков.Получить(ItemMark);
	
КонецФункции

