	УстановитьЗначениеXDTO(Контент, "DeliveryPoint", ДатаВремяXML_В_Дата1С(ПолучитьЗначениеXDTO(Параметры, "ВыдачГруз")));
	УстановитьЗначениеXDTO(Контент, "CargoOpeningDateTime", ДатаВремяXML_В_Дата1С(ПолучитьЗначениеXDTO(Параметры, "ВскрытГруз")));
