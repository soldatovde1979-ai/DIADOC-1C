		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <поставщике>", xmlAcceptanceCertificateContent.Seller.Ссылка);
	КонецЕсли;
	
	// валидируем строки
	номерСтроки = 0;
	
	Если xmlAcceptanceCertificateContent.Items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "отсутствует табличная часть документа");
	Иначе
		
		Для Каждого Строка Из xmlAcceptanceCertificateContent.Items Цикл
			
			НомерСтроки = НомерСтроки + 1;
			СписокОшибокСтроки = Новый Массив;
			
			ПроверитьФорматПоля(СписокОшибокСтроки, Строка.UnitCode, "Код единицы измерения", Ложь, 3, 4, Истина, "м");
			
			Если НЕ ЗначениеЗаполнено(Строка.Total) Тогда
				ДобавитьОшибкуВалидации(СписокОшибокСтроки, "Не указана общая сумма по строке");
			КонецЕсли;
			
			ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокОшибокСтроки, "Ошибки в строке " + НомерСтроки + " табличной части");
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияInvoiceContent(InvoiceContent) Экспорт
	
	СписокОшибок = Новый Массив;
	
	Если InvoiceContent.Signer.IsSoleProprietor = Истина Тогда
		ПроверитьСвидетельствоОРегистрацииИП(СписокОшибок, InvoiceContent.Signer.SoleProprietorRegistrationCertificate);
	КонецЕсли;
	
	Если InvoiceContent.items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствует табличная часть документа");
	КонецЕсли;
	
	// проверяем сведения об участниках сделки
	Если СтруктураЗаполнена(InvoiceContent.seller) Тогда
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(InvoiceContent.Seller, 1, Истина);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <продавце>", InvoiceContent.seller.Ссылка);
	Иначе 
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о продавце");
	КонецЕсли;	
	
	Если СтруктураЗаполнена(InvoiceContent.Shipper) Тогда 
		Если InvoiceContent.Shipper.SameAsSellerOrBuyer = Ложь Тогда
			ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(InvoiceContent.Shipper, 2, Истина);
			ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <грузоотправителе>", InvoiceContent.Shipper.Ссылка);
		КонецЕсли;	
	КонецЕсли;	
	
	Если СтруктураЗаполнена(InvoiceContent.Buyer) Тогда
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(InvoiceContent.Buyer, 1, Истина);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <покупателе>", InvoiceContent.Buyer.Ссылка);
	Иначе 
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о покупателе");
	КонецЕсли;	
	
	Если СтруктураЗаполнена(InvoiceContent.Consignee) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(InvoiceContent.Consignee, 2, Истина);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <грузополучателе>", InvoiceContent.Consignee.Ссылка);
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок, InvoiceContent.Number, "Номер счета-фактуры", Истина, 0, 256, Ложь, "м");
	ПроверитьФорматДаты(СписокОшибок, InvoiceContent.date, "Дата счета-фактуры", Истина);
	
	Если ЗначениеЗаполнено(InvoiceContent.InvoiceRevisionDate) ИЛИ ЗначениеЗаполнено(InvoiceContent.InvoiceRevisionNumber) Тогда 
		ПроверитьФорматПоля(СписокОшибок, InvoiceContent.InvoiceRevisionNumber, "Номер исправления счета-фактуры", Ложь, 0, 3, Истина, "м");
		ПроверитьФорматДаты(СписокОшибок, InvoiceContent.InvoiceRevisionDate, "Дата исправления счета-фактуры");
	КонецЕсли;
	
	Если InvoiceContent.PaymentDocuments.Количество() > 10 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Количество платежно-расчетных документов не может быть более 10");
	КонецЕсли;
		
	ПроверитьФорматПоля(СписокОшибок, InvoiceContent.Currency, "Код валюты счета-фактуры", Истина, 3, 3, Истина, "м");
	
	Для каждого стр Из InvoiceContent.PaymentDocuments Цикл 
		ПроверитьФорматПоля(СписокОшибок, стр.Number, "Номер платежно-расчетного документа", Ложь, 0, 30, Ложь, "м");
		ПроверитьФорматДаты(СписокОшибок, стр.Date, "Дата платежно-расчетного документа");
	КонецЦикла;
	
	// валидируем ТЧ
	ц = 0;
	
	Для Каждого item Из InvoiceContent.Items Цикл 
		ц = ц + 1;
		ОшибкиВСтроке = ПроверитьОшибкиВСтрокеСФ(item);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + ц + " табличной части");
	КонецЦикла;	
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, ПроверитьКлассификаторыСФ(InvoiceContent));
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияInvoiceCorrectionContent(InvoiceCorrectionContent) Экспорт
	
	СписокОшибок = Новый Массив;
	
	Если InvoiceCorrectionContent.Signer.IsSoleProprietor = Истина Тогда
		ПроверитьСвидетельствоОРегистрацииИП(СписокОшибок, InvoiceCorrectionContent.Signer.SoleProprietorRegistrationCertificate);
	КонецЕсли;
	
	Если InvoiceCorrectionContent.items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Нет строк, по которым происходит корректировка суммовых или количественных показателей");
	КонецЕсли;

	Если InvoiceCorrectionContent.TotalsDec.Total = 0
		И InvoiceCorrectionContent.TotalsInc.Total = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Нет увеличения или уменьшения суммы всего по документу");
	КонецЕсли;
	
	//проверяем сведения об участниках сделки
	Если СтруктураЗаполнена(InvoiceCorrectionContent.seller) Тогда
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(InvoiceCorrectionContent.Seller, 1, Истина);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <продавце>", InvoiceCorrectionContent.seller.Ссылка);
	Иначе
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о продавце");
	КонецЕсли;
	
	Если СтруктураЗаполнена(InvoiceCorrectionContent.Buyer) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(InvoiceCorrectionContent.Buyer, 1, Истина);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <покупателе>", InvoiceCorrectionContent.Buyer.Ссылка);
	Иначе 
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о покупателе");
	КонецЕсли;
	
	Если InvoiceCorrectionContent.OriginalInvoices.Количество() = 0 Тогда
	
		ДобавитьОшибкуВалидации(СписокОшибок, "Не указан исправляемый счет-фактура");
	
	Иначе
	
		OriginalInvoice = InvoiceCorrectionContent.OriginalInvoices[0];
		
		ПроверитьФорматПоля(СписокОшибок, OriginalInvoice.Number, "Номер счета-фактуры", Истина, 0, 256, Ложь, "м");
		ПроверитьФорматДаты(СписокОшибок, OriginalInvoice.Date, "Дата счета-фактуры", Истина);
	
		Если ЗначениеЗаполнено(OriginalInvoice.InvoiceRevisionNumber)
			ИЛИ ЗначениеЗаполнено(OriginalInvoice.InvoiceRevisionDate) Тогда 
			ПроверитьФорматПоля(СписокОшибок, OriginalInvoice.InvoiceRevisionNumber, "Номер исправления счета-фактуры", Истина, 0, 3, Истина, "м");
			ПроверитьФорматДаты(СписокОшибок, OriginalInvoice.InvoiceRevisionDate, "Дата исправления счета-фактуры", Истина);
		КонецЕсли;
	
	КонецЕсли;
	ПроверитьФорматПоля(СписокОшибок, InvoiceCorrectionContent.InvoiceCorrectionNumber, "Номер корректировочного счета-фактуры", Истина, 0, 256, Ложь, "м");
	ПроверитьФорматДаты(СписокОшибок, InvoiceCorrectionContent.InvoiceCorrectionDate, "Дата корректировочного счета-фактуры", Истина);
	
	Если ЗначениеЗаполнено(InvoiceCorrectionContent.InvoiceCorrectionRevisionNumber)
		ИЛИ ЗначениеЗаполнено(InvoiceCorrectionContent.InvoiceCorrectionRevisionDate) Тогда
		ПроверитьФорматПоля(СписокОшибок, InvoiceCorrectionContent.InvoiceCorrectionRevisionNumber, "Номер исправления корректировочного счета-фактуры", Истина, 0, 3, Ложь, "м");
		ПроверитьФорматДаты(СписокОшибок, InvoiceCorrectionContent.InvoiceCorrectionRevisionDate, "Дата исправления корректировочного счета-фактуры", Истина);
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок, InvoiceCorrectionContent.Currency, "Код валюты счета-фактуры", Истина, 3, 3, Истина, "м");
	
	ц = 0;
	Для Каждого item Из InvoiceCorrectionContent.items Цикл
		ц = ц + 1;
		ОшибкиВСтроке = ПроверитьОшибкиВСтрокеКСФ(Item, Ложь);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + ц + " табличной части");
	КонецЦикла;
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, ПроверитьКлассификаторыКСФ(InvoiceCorrectionContent, InvoiceCorrectionContent.items));
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD820(Content) Экспорт
	
	ФорматПриказа = "820";
	ФункцияУПД = XML_УПД_ПолучитьФункцию(Content.Function);
	
	СписокОшибок = Новый Массив;
	
	// Дата и номер документа
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentNumber, "Номер счета-фактуры"	, Истина, 1, 1000, Ложь, "м");
	ПроверитьФорматДаты(СписокОшибок, Content.DocumentDate	, "Дата счета-фактуры"	, Истина);
	
	// Дата и номер исправления
	Если ЗначениеЗаполнено(Content.RevisionNumber) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.RevisionNumber, "Номер исправления счета-фактуры", Ложь, 1, 3, Истина, "м");
		ПроверитьФорматДаты(СписокОшибок, Content.RevisionDate	, "Дата исправления счета-фактуры");
	КонецЕсли;
	
	// Наименование первичного документа, определенное организацией
	Если ЗначениеЗаполнено(Content.DocumentName) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.DocumentName, "Наименование первичного документа", Ложь, 1, 255, Ложь, "м");
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentCreator, "Наименование экономического субъекта - составителя файла обмена счета-фактуры (информации продавца)", Истина, 1, 1000, , "с");
	
	// Идентификатор государственного контракта
	Если ЗначениеЗаполнено(Content.GovernmentContractInfo) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.GovernmentContractInfo, "Идентификатор государственного контракта", Ложь, 20, 25, Ложь, "м");
	КонецЕсли;
	
	// Код валюты
	ПроверитьФорматПоля(СписокОшибок, Content.Currency, "Код валюты счета-фактуры", Истина, 3, 3, Истина, "м");
	
	МаксДлинаАдреса = 1000;
	
	// Продавцы
	Если Не ЗначениеЗаполнено(Content.Sellers) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют сведения о продавцах");
	КонецЕсли;
	
	Для Каждого Элемент Из Content.Sellers Цикл
		
		ИнформацияОбОрганизации = Элемент;
		ОшибкиКонтрагента = ВалидацияUTD820_УчастникТип(ИнформацияОбОрганизации, ФункцияУПД);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <продавце>", ИнформацияОбОрганизации.Ссылка);
		
	КонецЦикла;
	
	// Покупатели
	Если Не ЗначениеЗаполнено(Content.Buyers) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют сведения о покупателях");
	КонецЕсли;
	
	Для Каждого Элемент Из Content.Buyers Цикл
		
		ИнформацияОбОрганизации = Элемент;
		ОшибкиКонтрагента = ВалидацияUTD820_УчастникТип(ИнформацияОбОрганизации, ФункцияУПД);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <покупателе>", ИнформацияОбОрганизации.Ссылка);
		
	КонецЦикла;
	
	// Грузоотправители
	Для Каждого Элемент Из Content.Shippers Цикл
		
		Если Не СтруктураЗаполнена(Элемент)
			Или Элемент.SameAsSeller Тогда
			Продолжить;
		КонецЕсли;
		
		ИнформацияОбОрганизации = Элемент.OrganizationInfo; // TODO: уточнить имя свойства, возможно это OrganizationDetails
		ОшибкиКонтрагента = ВалидацияUTD820_УчастникТип(ИнформацияОбОрганизации, ФункцияУПД);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <грузоотправителе>", ИнформацияОбОрганизации.Ссылка);
		
	КонецЦикла;
	
	// Грузополучатели
	Для Каждого Элемент Из Content.Consignees Цикл
		
		Если Не СтруктураЗаполнена(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		ИнформацияОбОрганизации = Элемент;
		ОшибкиКонтрагента = ВалидацияUTD820_УчастникТип(ИнформацияОбОрганизации, ФункцияУПД);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <грузополучателе>", ИнформацияОбОрганизации.Ссылка);
		
	КонецЦикла;
	
	// Фактор
	Если СтруктураЗаполнена(Content.FactorInfo) Тогда
		
		ИнформацияОбОрганизации = Content.FactorInfo;
		ОшибкиКонтрагента = ВалидацияUTD820_УчастникТип(ИнформацияОбОрганизации, ФункцияУПД);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <факторе>", ИнформацияОбОрганизации.Ссылка);
		
	КонецЕсли;
	
	// Перевозчик
	Если СтруктураЗаполнена(Content.TransferInfo.Carrier) Тогда
		
		ИнформацияОбОрганизации = Content.TransferInfo.Carrier;
		ОшибкиКонтрагента = ВалидацияUTD820_УчастникТип(ИнформацияОбОрганизации, ФункцияУПД);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <перевозчике>", ИнформацияОбОрганизации.Ссылка);
		
	КонецЕсли;
	
	// Платежно-расчетные документы
	Для Каждого СведенияПРД Из Content.PaymentDocuments Цикл 
		ПроверитьФорматПоля(СписокОшибок, СведенияПРД.Number, "Номер платежно-расчетного документа", Истина, 1, 30, Ложь, "м");
		ПроверитьФорматДаты(СписокОшибок, СведенияПРД.Date, "Дата платежно-расчетного документа", Истина);
	КонецЦикла;
	
	// Основания передачи
	ПроверитьОшибкиОснованияПередачи(СписокОшибок, Content, "820");
	
	// Табличная часть
	ТабличнаяЧасть = Content.Table.Items;
	
	Если Не ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствует табличная часть документа");
	КонецЕсли;
	
	НомерСтроки = 0;
	
	МассивОшибокГТД = Новый Массив;
	
	ВДокументеЕстьПрослеживаемость	 = Ложь;
	ВДокументеЕстьМаркировка		 = Ложь;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ОшибкиВСтроке = Новый Массив;
		
		// Товар
		Если ЗначениеЗаполнено(СтрокаТЧ.Product) Тогда
			
			ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Product, "Наименование товара", Истина, 0, 1000, Ложь, "с");
			
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТЧ.ItemVendorCode) И Не ЗначениеЗаполнено(СтрокаТЧ.ItemCharact)
			И Не ЗначениеЗаполнено(СтрокаТЧ.ItemArticle) Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Наименование товара не заполнено");
			
		КонецЕсли;
		
		// Код ЕИ
		ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Unit, "Код единицы измерения", Ложь, 3, 4, Истина, "м");
		
		// Ставка НДС
		ВалидацияUTD820_ПроверитьСтавкуНДС(СтрокаТЧ.TaxRate, ОшибкиВСтроке);
		
		// Прослеживаемость и маркировка
		Если НЕ ВДокументеЕстьПрослеживаемость И ЗначениеЗаполнено(СтрокаТЧ.ItemTracingInfos) Тогда
			ВДокументеЕстьПрослеживаемость = Истина;
		КонецЕсли;
		
		Если НЕ ВДокументеЕстьМаркировка И ЗначениеЗаполнено(СтрокаТЧ.ItemIdentificationNumbers) Тогда
			ВДокументеЕстьМаркировка = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЧ.CustomDeclarations) Тогда
			
			Для Каждого CustomsDeclaration Из СтрокаТЧ.CustomDeclarations Цикл 
				
				ИнформацияОСтроке = "Строка №" + НомерСтроки + ": ";
				
				Если ЗначениеЗаполнено(CustomsDeclaration.DeclarationNumber)
					И Не ЗначениеЗаполнено(CustomsDeclaration.CountryCode)
					И Не ЭтоИстина(CustomsDeclaration.HyphenCountry) Тогда
					
					МассивОшибокГТД.Добавить(ИнформацияОСтроке + "Для номенклатуры """ + СтрокаТЧ.Product + """ не заполнена страна происхождения товара");
					
				ИначеЕсли Не ЗначениеЗаполнено(CustomsDeclaration.DeclarationNumber)
					И ЗначениеЗаполнено(CustomsDeclaration.CountryCode)
					И Не СтранаЧленТС(CustomsDeclaration.CountryCode) 			// код страны без указания код таможенной декларации допустимо только для стран ЕАЭС
					И НЕ ЗначениеЗаполнено(СтрокаТЧ.ItemTracingInfos) Тогда 	// для прослеживаемых товаров номер ГТД не проверяется
					
					МассивОшибокГТД.Добавить(ТекстОшибкиНеЗаполненГТД(СтрокаТЧ, ИнформацияОСтроке));

				КонецЕсли;
				
				Если (СтрДлина(СокрЛП(CustomsDeclaration.DeclarationNumber)) > 29) Тогда
					
					МассивОшибокГТД.Добавить(ИнформацияОСтроке + "Длина номера ГТД превышает максимальное ограничение в 29 символов");
					
				КонецЕсли;

			КонецЦикла;
			
		КонецЕсли;
		
		// Код ТН ВЭД
		ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.ItemTypeCode, "Код ТН ВЭД", Ложь, 10, 10, Истина, "м");
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + НомерСтроки + " табличной части");
		
	КонецЦикла;
	
	// Прослеживаемость и маркировка
	Если ВДокументеЕстьПрослеживаемость И ВДокументеЕстьМаркировка Тогда
		
		ТекстОшибкиПрослеживаемостьИМаркировкаВместе = 
		"В документе указаны сведения по маркировке и прослеживаемости товаров.
		|Оформите операции отдельными документами.";
		
		ОшибкиПрослеживаемостьИМаркировка = Новый Массив;
		ДобавитьОшибкуВалидации(ОшибкиПрослеживаемостьИМаркировка, ТекстОшибкиПрослеживаемостьИМаркировкаВместе);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиПрослеживаемостьИМаркировка, "Ошибки заполнения данных прослеживаемости и маркировки:");
		
	КонецЕсли;	
	
	Если МассивОшибокГТД.Количество() > 0 Тогда
		
		ОшибкиВСтроке = Новый Массив;

		ТекстИнструкции	= ПодставитьГиперссылкуВОшибкуВалидации("<Как заполнить?>", "ИНСТРУКЦИЯКАКЗАПОЛНИТЬГТД");
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, ТекстИнструкции);

		Для Каждого ОшибкаГТД Из МассивОшибокГТД Цикл
			
			Если ТипЗнч(ОшибкаГТД) = Тип("Массив") Тогда
				ДополнитьМассивОшибокВалидации(ОшибкиВСтроке, ОшибкаГТД);
			Иначе
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, ОшибкаГТД);
			КонецЕсли;
			
		КонецЦикла;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в заполнении номеров ГТД");
		
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

// Проверяет сведения об организации на соответствие требованиям приказа 820@
//
// Параметры:
//  OrganizationInfo - Структура - см. тип ExtendedOrganizationInfo970 в схеме Proto.xsd
// 
// Возвращаемое значение:
//  Массив из НовыйОшибкаВалидации.
//
Функция ВалидацияUTD820_УчастникТип(OrganizationInfo, ФункцияУПД)
	
	СписокОшибок = Новый Массив;
	
	// BSLLS:MagicNumber-off
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Name, "Наименование контрагента", Истина, 0, 1000, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okpo, "ОКПО контрагента", Ложь, 1, 10, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Department, "Структурное подразделение", Ложь, 1, 500, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок,
		OrganizationInfo.AdditionalInfo,
		"Информация для участника документооборота",
		Ложь,
		1,
		255,
		Ложь
	);
	
	// BSLLS:MagicNumber-on
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	ВидКонтрагента = OrganizationInfo.Type;
	
	Если ВидКонтрагента = ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		Ошибки = ВалидацияUTD820_УчастникТип_СвЮлУч(OrganizationInfo);
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		
		Ошибки = ВалидацияUTD820_УчастникТип_СвИП(OrganizationInfo);
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		Ошибки = ВалидацияUTD820_УчастникТип_СвФЛУчастФХЖ(OrganizationInfo);
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ИностраннаяОрганизация
		Или ВидКонтрагента = ВидыЮрФизЛиц.ИностранныйГражданин Тогда
		
		Ошибки = ВалидацияUTD820_УчастникТип_СвИнНеУч(OrganizationInfo);
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	ИначеЕсли ЗначениеЗаполнено(ВидКонтрагента) Тогда
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			"Неправильно указан тип контрагента (%1)",
			ВидКонтрагента
		);
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	Иначе
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			"Не указан тип контрагента",
			ВидКонтрагента
		);
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	КонецЕсли;
	
	Ошибки = ВалидацияUTD820_УчастникТип_Адрес(OrganizationInfo.Address, ФункцияУПД);
	ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD820_УчастникТип_Адрес(Address, ФункцияУПД)
	
	СписокОшибок = Новый Массив;
	
	АдресОбязателен = (ФункцияУПД <> Перечисление_ФункцииУПД().ДОП);
	МаксДлинаАдреса = 1000;
	Ошибки = ПроверитьСтруктуруАдреса(Address, МаксДлинаАдреса, АдресОбязателен);
	
	Если ЗначениеЗаполнено(Ошибки) Тогда 
		ДобавитьОшибкуВалидацииСОформлением(СписокОшибок, "Ошибки в адресе:", , "b");
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD820_УчастникТип_СвЮлУч(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	HyphenInn = ПолучитьЗначениеXDTO(OrganizationInfo, "HyphenInn");
	Если ЭтоИстина(HyphenInn) Тогда
		Возврат СписокОшибок;
	КонецЕсли;
	
	Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ЮрЛицо");
	ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		Ошибки = ПроверитьКППКонтрагента(OrganizationInfo.Kpp);
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD820_УчастникТип_СвИП(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	// BSLLS:MagicNumber-off
	
	ЧастиФИО = РазложитьСтрокуВМассивСлов(OrganizationInfo.Name, " ");
	Если ЧастиФИО.Количество() < 2 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя индивидуального предпринимателя");
	КонецЕсли;
	
	HyphenInn = ПолучитьЗначениеXDTO(OrganizationInfo, "HyphenInn");
	Если Не ЭтоИстина(HyphenInn) Тогда
		Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ФизЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Для физ. лиц КПП не указывается");
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок,
		OrganizationInfo.IndividualEntityRegistrationCertificate,
		"Свидетельство о гос. регистрации ИП",
		Ложь,
		1,
		100,
		Ложь
	);
	
	ПроверитьФорматПоля(СписокОшибок,
		OrganizationInfo.OrganizationOrPersonInfo,
		"иные сведения",
		Ложь,
		1,
		255,
		Ложь
	);
	
	// BSLLS:MagicNumber-on
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD820_УчастникТип_СвИнНеУч(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	Если ЗначениеЗаполнено(OrganizationInfo.Inn) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Для иностранной организации (иностранного гражданина) ИНН не указывается");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Для иностранной организации (иностранного гражданина) КПП не указывается");
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	
	ПроверитьФорматПоля(
		СписокОшибок,
		OrganizationInfo.LegalEntityId,
		"идентификатор иностранной организации",
		Ложь,
		1,
		255,
		Ложь
	);
	
	ПроверитьФорматПоля(
		СписокОшибок,
		OrganizationInfo.OrganizationOrPersonInfo,
		"иные сведения для однозначной идентификации иностранной организации",
		Ложь,
		1,
		255,
		Ложь
	);
	
	// BSLLS:MagicNumber-on
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD820_УчастникТип_СвФЛУчастФХЖ(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	ЧастиФИО = РазложитьСтрокуВМассивСлов(OrganizationInfo.Name, " ");
	
	// BSLLS:MagicNumber-off
	
	Если ЧастиФИО.Количество() < 2 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя физического лица");
	КонецЕсли;
	
	HyphenInn = ПолучитьЗначениеXDTO(OrganizationInfo, "HyphenInn");
	Если Не ЭтоИстина(HyphenInn) И ЗначениеЗаполнено(OrganizationInfo.Inn) Тогда
		Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ФизЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Для физ. лиц КПП не указывается");
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок,
		OrganizationInfo.OrganizationOrPersonInfo,
		"иные сведения",
		Ложь,
		1,
		255,
		Ложь
	);
	
	// BSLLS:MagicNumber-on
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD970(Content) Экспорт
	
	ФункцияУПД = XML_УПД_ПолучитьФункцию(Content.Function);

	СписокОшибок = Новый Массив;
	
	// Дата и номер документа
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentNumber, "Номер счета-фактуры"	, Истина, 1, 1000, Ложь, "м");
	ПроверитьФорматДаты(СписокОшибок, Content.DocumentDate	, "Дата счета-фактуры"	, Истина);
	
	// Дата и номер исправления
	Если ЗначениеЗаполнено(Content.RevisionNumber) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.RevisionNumber, "Номер исправления счета-фактуры", Ложь, 1, 3, Истина, "м");
		ПроверитьФорматДаты(СписокОшибок, Content.RevisionDate	, "Дата исправления счета-фактуры");
	КонецЕсли;
	
	// Наименование первичного документа, определенное организацией
	Если ЗначениеЗаполнено(Content.DocumentName) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.DocumentName, "Наименование первичного документа", Ложь, 1, 255, Ложь, "м");
	КонецЕсли;
	
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentCreator, "Наименование экономического субъекта - составителя файла обмена счета-фактуры (информации продавца)", Ложь, 1, 1000, , "с");
	
	// Идентификатор государственного контракта
	Если ЗначениеЗаполнено(Content.GovernmentContractInfo) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.GovernmentContractInfo, "Идентификатор государственного контракта", Ложь, 20, 25, Ложь, "м");
	КонецЕсли;
	
	// Валюта документа
	ВалидацияUTD970_ПроверитьВалюту(СписокОшибок, Content.Currency);
	
	// Продавцы
	Если Не ЗначениеЗаполнено(Content.Sellers) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют сведения о продавцах");
	КонецЕсли;
	
	Для Каждого Элемент Из Content.Sellers Цикл
		
		ИнформацияОбОрганизации = Элемент;
		
		ОшибкиКонтрагента = ВалидацияUTD970_УчастникТип(ИнформацияОбОрганизации);
		
		ОшибкиАдреса = УПД970_ПроверитьСтруктуруАдреса(ИнформацияОбОрганизации.Address, Content.Function);
		УПД970_ДополнитьСписокОшибкамиПроверкиЮридическогоАдреса(ОшибкиКонтрагента, ОшибкиАдреса);
		
		ОрганизацияСсылка = ПолучитьЗначениеXDTO(ИнформацияОбОрганизации.СлужебнаяИнформация, "Ссылка");
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <продавце>", ОрганизацияСсылка);
		
	КонецЦикла;
	
	// Покупатели
	Если Не ЗначениеЗаполнено(Content.Buyers) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют сведения о покупателях");
	КонецЕсли;
	
	Для Каждого Элемент Из Content.Buyers Цикл
		
		ИнформацияОбОрганизации = Элемент;
		
		ОшибкиКонтрагента = ВалидацияUTD970_УчастникТип(ИнформацияОбОрганизации);
		
		ОшибкиАдреса = УПД970_ПроверитьСтруктуруАдреса(ИнформацияОбОрганизации.Address, Content.Function);
		УПД970_ДополнитьСписокОшибкамиПроверкиЮридическогоАдреса(ОшибкиКонтрагента, ОшибкиАдреса);
		
		ОрганизацияСсылка = ПолучитьЗначениеXDTO(ИнформацияОбОрганизации.СлужебнаяИнформация, "Ссылка");
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <покупателе>", ОрганизацияСсылка);
		
	КонецЦикла;
	
	// Грузоотправители
	Для Каждого Элемент Из Content.Shippers Цикл
		
		Если Не СтруктураЗаполнена(Элемент)
			Или Элемент.SameAsSeller = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ИнформацияОбОрганизации = Элемент.OrganizationInfo;
		
		ОшибкиКонтрагента = ВалидацияUTD970_УчастникТип(ИнформацияОбОрганизации);
		
		ОшибкиАдреса = УПД970_ПроверитьСтруктуруАдреса(ИнформацияОбОрганизации.Address, Content.Function);
		УПД970_ДополнитьСписокОшибкамиПроверкиФактическогоАдреса(ОшибкиКонтрагента, ОшибкиАдреса);
		
		ОрганизацияСсылка = ПолучитьЗначениеXDTO(ИнформацияОбОрганизации.СлужебнаяИнформация, "Ссылка");
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <грузоотправителе>", ОрганизацияСсылка);
		
	КонецЦикла;
	
	// Грузополучатели
	Для Каждого Элемент Из Content.Consignees Цикл
		
		Если Не СтруктураЗаполнена(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		ИнформацияОбОрганизации = Элемент;
		
		ОшибкиКонтрагента = ВалидацияUTD970_УчастникТип(ИнформацияОбОрганизации);
		
		ОшибкиАдреса = УПД970_ПроверитьСтруктуруАдреса(ИнформацияОбОрганизации.Address, Content.Function);
		УПД970_ДополнитьСписокОшибкамиПроверкиФактическогоАдреса(ОшибкиКонтрагента, ОшибкиАдреса);
		
		ОрганизацияСсылка = ПолучитьЗначениеXDTO(ИнформацияОбОрганизации.СлужебнаяИнформация, "Ссылка");
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <грузополучателе>", ОрганизацияСсылка);
		
	КонецЦикла;
	
	// Фактор
	Если Content.FactorInfo <> Неопределено И СтруктураЗаполнена(Content.FactorInfo) Тогда
		
		ИнформацияОбОрганизации = Content.FactorInfo;
		
		ОшибкиКонтрагента = ВалидацияUTD970_УчастникТип(ИнформацияОбОрганизации);
		
		ОшибкиАдреса = УПД970_ПроверитьСтруктуруАдреса(ИнформацияОбОрганизации.Address, Content.Function);
		УПД970_ДополнитьСписокОшибкамиПроверкиЮридическогоАдреса(ОшибкиКонтрагента, ОшибкиАдреса);
		
		ОрганизацияСсылка = ПолучитьЗначениеXDTO(ИнформацияОбОрганизации.СлужебнаяИнформация, "Ссылка");
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в сведениях о <факторе>", ОрганизацияСсылка);
		
	КонецЕсли;
	
	// Платежно-расчетные документы
	Для Каждого СведенияПРД Из Content.PaymentDocuments Цикл 
		ПроверитьФорматПоля(СписокОшибок, СведенияПРД.Number, "Номер платежно-расчетного документа", Ложь, 1, 30, Ложь, "м");
		Если ЗначениеЗаполнено(СведенияПРД.Date) Тогда
			ПроверитьФорматДаты(СписокОшибок, СведенияПРД.Date, "Дата платежно-расчетного документа", Ложь);
		КонецЕсли;
	КонецЦикла;
	
	// Основания передачи
	ВалидацияUTD970_ПроверитьЗаполнениеОснованияПередачи(СписокОшибок, Content);
	
	// Табличная часть
	ТабличнаяЧасть = Content.Table.Items;
	
	Если Не ЗначениеЗаполнено(ТабличнаяЧасть) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствует табличная часть документа");
	КонецЕсли;
	
	НомерСтроки = 0;
	
	МассивОшибокГТД = Новый Массив;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ОшибкиВСтроке = ВалидацияUTD970_ПроверитьДанныеВСтрокеТаблицы(СтрокаТЧ, ФункцияУПД, Content.CircumFormatInvoice);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + НомерСтроки + " табличной части");

		ВалидацияUTD970_ПроверитьГТДвСтрокеТаблицы(СтрокаТЧ, НомерСтроки, МассивОшибокГТД);

	КонецЦикла;
	
	Валидация_ДополнитьСписокОшибкамиГТД(СписокОшибок, МассивОшибокГТД);
	
	// Документ отгрузки
	ВалидацияUTD970_ПроверитьЗаполнениеДокументаОтгрузки(СписокОшибок, Content);
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUTD970_ПроверитьДанныеВСтрокеТаблицы(СтрокаТЧ, ФункцияУПД, CircumFormatInvoice)
	
	ФункцииУПД = Перечисление_ФункцииУПД();
	
	ОшибкиВСтроке = Новый Массив;
	
	// Товар
	Если ЗначениеЗаполнено(СтрокаТЧ.Product) Тогда
		
		ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Product, "Наименование товара", Истина, 0, 2000, Ложь, "с");
		
	ИначеЕсли ФункцияУПД <> ФункцииУПД.ДОП Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Наименование товара не заполнено");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТЧ.ItemVendorCode)
		И НЕ ЗначениеЗаполнено(СтрокаТЧ.ItemCharact)
		И НЕ ЗначениеЗаполнено(СтрокаТЧ.ItemArticle) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Должно быть заполнено одно из полей наименование товара | характеристика | артикул | код товара");
		
	КонецЕсли;
	
	// Код ЕИ
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Unit, "Код единицы измерения", Ложь, 3, 4, Истина, "м");

	Если ЗначениеЗаполнено(СтрокаТЧ.Unit) Тогда
		Валидация_ПроверитьЕдиницуИзмеренияПоОКЕИ(ОшибкиВСтроке, СтрокаТЧ.Unit);
	КонецЕсли;
	
	ЭтоСФнаАванс = (ФункцияУПД = ФункцииУПД.СЧФ И CircumFormatInvoice = "2");
	
	// Количество
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Quantity) Тогда
		
		КоличествоОбязательно = Не ЭтоСФнаАванс 
								И ФункцияУПД <> ФункцииУПД.ДОП
								И ЗначениеЗаполнено(СтрокаТЧ.Unit);

		Если КоличествоОбязательно Тогда
			ДобавитьОшибкуВалидации(
				ОшибкиВСтроке,
				"Не заполнено количество. В соответствии с форматом ФНС количество должно быть больше ноля. " + 
				"Заполните в документе 1С количество");
		КонецЕсли;
			
	КонецЕсли;
	
	// Цена
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Price) Тогда
		
		ЦенаОбязательна = Не ЭтоСФнаАванс
						  И ФункцияУПД <> ФункцииУПД.ДОП
						  И (ЗначениеЗаполнено(СтрокаТЧ.Unit) Или ЗначениеЗаполнено(СтрокаТЧ.Quantity));
		
		Если ЦенаОбязательна Тогда
			ДобавитьОшибкуВалидации(
				ОшибкиВСтроке,
				"Не заполнена цена. В соответствии с форматом ФНС цена должна быть больше ноля. " +
				"Заполните в документе 1С цену");
		КонецЕсли;
	
	КонецЕсли;
	
	// Ставка НДС
	Валидация_ПроверитьСтавкуНДС(СтрокаТЧ.TaxRate, ОшибкиВСтроке);
	
	// Прослеживаемость и маркировка
	Если XML_УПД_970_ИспользуетсяФормат5_03() Тогда
		ВалидацияUTD970_ПрослеживаемостьИМаркировка5_03(СтрокаТЧ, ОшибкиВСтроке);
	Иначе
		ВалидацияUTD970_ПрослеживаемостьИМаркировка5_02(СтрокаТЧ, ОшибкиВСтроке);
	КонецЕсли;
	
	// Код ТН ВЭД
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.ItemTypeCode, "Код ТН ВЭД", Ложь, 10, 10, Истина, "м");
	
	Возврат ОшибкиВСтроке;
	
КонецФункции

Процедура ВалидацияUTD970_ПрослеживаемостьИМаркировка5_02(Знач СтрокаТЧ, ОшибкиВСтроке)
	
	МинимальнаяДлина = 27;
	МаксимальнаяДлина = 29;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ItemTracingInfos) Тогда
		Для Каждого ItemTracing Из СтрокаТЧ.ItemTracingInfos Цикл
			ПроверитьФорматПоля(
				ОшибкиВСтроке,
				ItemTracing.RegNumberUnit,
				"Регистрационный номер партии товаров",
				Истина,
				МинимальнаяДлина,
				МаксимальнаяДлина,
				Ложь,
				"м");
		КонецЦикла;
	КонецЕсли;
	
	ВалидацияUTD970_ПартияМаркируемойПродукции(СтрокаТЧ, ОшибкиВСтроке);
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПрослеживаемостьИМаркировка5_03(Знач СтрокаТЧ, ОшибкиВСтроке)
	
	МинимальнаяДлина = 25;
	МаксимальнаяДлина = 29;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ItemTracingInfos) Тогда
		Для Каждого ItemTracing Из СтрокаТЧ.ItemTracingInfos Цикл
			ПроверитьФорматПоля(
				ОшибкиВСтроке,
				ItemTracing.RegNumberUnit,
				"Регистрационный номер партии товаров",
				Истина,
				МинимальнаяДлина,
				МаксимальнаяДлина,
				Ложь,
				"м");
		КонецЦикла;
	КонецЕсли;
	
	ВалидацияUTD970_ПартияМаркируемойПродукции(СтрокаТЧ, ОшибкиВСтроке);
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПартияМаркируемойПродукции(СтрокаТЧ, ОшибкиВСтроке)
	
	МинимальнаяДлина = 0;
	МаксимальнаяДлина = 55;
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ItemIdentificationNumbers) Тогда
		Для Каждого ItemIdentificationNumber Из СтрокаТЧ.ItemIdentificationNumbers Цикл
			ПроверитьФорматПоля(
				ОшибкиВСтроке,
				ItemIdentificationNumber.BatchCode,
				"Партия маркируемых товаров",
				Ложь,
				МинимальнаяДлина,
				МаксимальнаяДлина,
				Ложь,
				"м");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияUTD820_ПроверитьСтавкуНДС(TaxRate, ОшибкиВСтроке)
	
	// Для 820@ проверки ставки точно такие же, как в 970@
	Валидация_ПроверитьСтавкуНДС(TaxRate, ОшибкиВСтроке);
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПроверитьГТДвСтрокеТаблицы(СтрокаТЧ, НомерСтроки, МассивОшибокГТД)
	
	Если ЗначениеЗаполнено(СтрокаТЧ.CustomDeclarations) Тогда
		
		Для Каждого CustomsDeclaration Из СтрокаТЧ.CustomDeclarations Цикл
			
			ИнформацияОСтроке = "Строка №" + НомерСтроки + ": ";
			
			Если НЕ ЗначениеЗаполнено(CustomsDeclaration.DeclarationNumber)
				И ЗначениеЗаполнено(CustomsDeclaration.CountryCode)
				И НЕ СтранаЧленТС(CustomsDeclaration.CountryCode) // код страны без указания код таможенной декларации допустимо только для стран ЕАЭС
				И НЕ ЗначениеЗаполнено(СтрокаТЧ.ItemTracingInfos) Тогда // для прослеживаемых товаров номер ГТД не проверяется
				
				МассивОшибокГТД.Добавить(ТекстОшибкиНеЗаполненГТД(СтрокаТЧ, ИнформацияОСтроке));
				
			КонецЕсли;
			
			Если (СтрДлина(СокрЛП(CustomsDeclaration.DeclarationNumber)) > 29) Тогда
				
				МассивОшибокГТД.Добавить(ИнформацияОСтроке + "Длина номера ГТД превышает максимальное ограничение в 29 символов");
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПроверитьЗаполнениеОснованияПередачи(СписокОшибок, Content)
	
	ФункцияУПД = XML_УПД_ПолучитьФункцию(Content.Function);
	ФункцииУПД = Перечисление_ФункцииУПД();
	
	ЭтоУПДСЧФ = (ФункцияУПД = ФункцииУПД.СЧФ);
	
	TransferInfo = Content.TransferInfo;
	
	Если TransferInfo.WithoutTransferBase <> Истина
		И TransferInfo.TransferBases.Количество() = 0
		И НЕ ЭтоУПДСЧФ Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Не заполнены основания передачи");
		Возврат;
	КонецЕсли;
	
	ДокументОснованиеОтсутствует = "Без документа-основания";
		
	Для Каждого TransferBase Из TransferInfo.TransferBases Цикл
		
		ОшибкиОснования = Новый Массив;
		
		Если TransferBase.Name = ДокументОснованиеОтсутствует Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(TransferBase.Date) 
			Или Не ЗначениеЗаполнено(TransferBase.Number) Тогда

			ДобавитьОшибкуВалидации(ОшибкиОснования, "Заполните дату и номер основания/договора");
			
		КонецЕсли;
		
		Если ОшибкиОснования.Количество() > 0 Тогда
			ТекстИнструкции	= ПодставитьГиперссылкуВОшибкуВалидации("<Как заполнить?>", "ИНСТРУКЦИЯКАКЗАПОЛНИТЬОСНОВАНИЕ");
			ДобавитьОшибкуВалидации(ОшибкиОснования, ТекстИнструкции);
		КонецЕсли;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиОснования, "Ошибки в основании. <Заполните дату и номер>", СвойствоСлужебнойИнформации(TransferBase, "ОснованиеСсылка"));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПроверитьЗаполнениеДокументаОтгрузки(СписокОшибок, Content)
	
	ФункцияУПД = XML_УПД_ПолучитьФункцию(Content.Function);
	ФункцииУПД = Перечисление_ФункцииУПД();
	
	ЭтоУПДСЧФ = (ФункцияУПД = ФункцииУПД.СЧФ);
	ЭтоУПДСЧФДОП = (ФункцияУПД = ФункцииУПД.СЧФДОП);
	
	ДокументыОтгрузки = Content.DocumentShipments;
	
	ОшибкиДокументаОтгрузки = Новый Массив;
	
	Если ЭтоУПДСЧФ И Content.CircumFormatInvoice <> "2" Тогда
		
		Если ДокументыОтгрузки.Количество() = 0 Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Заполните документ отгрузки. Это поле обязательно для функции СЧФ");	
			
		КонецЕсли;
		
		Для ИндексСтроки = 0 По ДокументыОтгрузки.Количество() - 1 Цикл
			
			НомерСтроки = ИндексСтроки + 1;
			
			ДокументОтгрузки = ДокументыОтгрузки[ИндексСтроки];
			
			Если Не ЗначениеЗаполнено(ДокументОтгрузки.Name) Тогда
				
				ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Не заполнены данные документа отгрузки в строке " + НомерСтроки + ". Не заполнено поле Name");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ДокументОтгрузки.Date) Тогда
				
				ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Не заполнены данные документа отгрузки в строке " + НомерСтроки + ". Не заполнено поле Date");
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ДокументОтгрузки.Number) Тогда
				
				ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Не заполнены данные документа отгрузки в строке " + НомерСтроки + ". Не заполнено поле Number");
				
			КонецЕсли;
			
		КонецЦикла;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиДокументаОтгрузки, "Ошибки в данных о документе отгрузки");
		
		
	ИначеЕсли ЭтоУПДСЧФДОП Тогда
		
		Если ДокументыОтгрузки.Количество() = 0 Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Заполните документ отгрузки. Это поле обязательно для функции СЧФДОП");	
			
			
		ИначеЕсли ДокументыОтгрузки.Количество() > 1 Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Для функции СЧФДОП предусмотрено заполнение только одного документа отгрузки");
			
		Иначе
			
			ДокументОтгрузки = ДокументыОтгрузки[0];
			
			Если Content.DocumentName <> ДокументОтгрузки.Name Тогда
				
				ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Реквизиты должны совпадать с реквизитами УПД. Ошибка заполнения реквизита Name");
				
			КонецЕсли;
			
			Если Content.DocumentDate <> ДокументОтгрузки.Date Тогда
				
				ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Реквизиты должны совпадать с реквизитами УПД. Ошибка заполнения реквизита Date");
				
			КонецЕсли;
			
			Если Content.DocumentNumber <> ДокументОтгрузки.Number Тогда
				
				ДобавитьОшибкуВалидации(ОшибкиДокументаОтгрузки, "Реквизиты должны совпадать с реквизитами УПД. Ошибка заполнения реквизита Number");
				
			КонецЕсли;
			
		КонецЕсли;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиДокументаОтгрузки, "Ошибки в данных о документе отгрузки");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияUTD970_ПроверитьВалюту(СписокОшибок, ВалютаКод)
	
	ОшибкиВалютаДокумента = Новый Массив;
	
	ПроверитьФорматПоля(ОшибкиВалютаДокумента, ВалютаКод, "Код валюты счета-фактуры", Истина, 3, 3, Истина, "м");
	
	Если ОшибкиВалютаДокумента.Количество() = 0 Тогда
		ПроверитьКодВалютыПоКлассификатору(ВалютаКод, ОшибкиВалютаДокумента);
	КонецЕсли;
	
	ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВалютаДокумента, "Ошибки в заполнении валюты");
	
КонецПроцедуры

