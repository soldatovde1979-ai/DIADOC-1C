Функция ВалидацияUTD(UTDContent) Экспорт
	
	списокОшибок = Новый Массив;
	
	ПроверитьОшибкиВШапкеУПД_УКД(СписокОшибок, UTDContent);
	
	МаксДлинаАдреса = 255;
	
	Если  СтруктураЗаполнена(UTDContent.Shipper.OrganizationInfo)
		И Не UTDContent.Shipper.SameAsSeller Тогда
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляУПД(UTDContent.Shipper.OrganizationInfo, 2, UTDContent.Function, МаксДлинаАдреса);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <грузоотправителе>", UTDContent.Shipper.OrganizationInfo.Ссылка);
	КонецЕсли;
	
	Если  СтруктураЗаполнена(UTDContent.Consignee) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляУПД(UTDContent.Consignee, 2, UTDContent.Function, МаксДлинаАдреса);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <грузополучателе>", UTDContent.Consignee.Ссылка);
	КонецЕсли;
	
	Для каждого стр Из UTDContent.PaymentDocuments Цикл 
		ПроверитьФорматПоля(СписокОшибок, стр.Number, "Номер платежно-расчетного документа", Ложь, 0, 30, Ложь, "м");
		ПроверитьФорматДаты(СписокОшибок, стр.Date, "Дата платежно-расчетного документа");
	КонецЦикла;
		
	ПроверитьОшибкиОснованияПередачи(СписокОшибок, UTDContent);
	
	// валидируем ТЧ
	
	Если UTDContent.InvoiceTable.Items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствует табличная часть документа");
	КонецЕсли;
	
	ц = 0;
	Для каждого item Из UTDContent.InvoiceTable.Items Цикл 
		ц = ц + 1;
		ОшибкиВСтроке = ПроверитьОшибкиВСтрокеУПД(item);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + ц + " табличной части");
	КонецЦикла;	
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, ПроверитьКлассификаторыУПД(UTDContent));
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияUCD(UCDContent) Экспорт
	
	СписокОшибок = Новый Массив;
	
	Если UCDContent.InvoiceCorrectionTable.Items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Нет строк, по которым происходит корректировка суммовых или количественных показателей");
	КонецЕсли;
	
	ПроверитьОшибкиВШапкеУПД_УКД(СписокОшибок, UCDContent);
	
	//валидируем ТЧ
	ц = 0;
	Для Каждого item Из UCDContent.InvoiceCorrectionTable.Items Цикл 
		ц = ц + 1;
		ОшибкиВСтроке = ПроверитьОшибкиВСтрокеКСФ(Item);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + ц + " табличной части");
	КонецЦикла;
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, ПроверитьКлассификаторыУКД(UCDContent, UCDContent.InvoiceCorrectionTable.Items));
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ПроверитьРеквизитыКорректируемогоСчетаФактуры(РеквизитыСчФ)
	
	Ошибки = Новый Массив;
	
	ПроверитьФорматПоля(
		Ошибки,
		РеквизитыСчФ.InvoiceDate,
		"ДатаСчФ",
		Истина
	);
	
	ПроверитьФорматПоля(
		Ошибки,
		РеквизитыСчФ.InvoiceNumber,
		"НомерСчФ",
		Истина,
		1,
		1000
	);
	
	Возврат Ошибки;
	
КонецФункции

Функция ВалидацияUCD736(UCDContent) Экспорт
	
	СписокОшибок = Новый Массив;
	
	Если Не ЗначениеЗаполнено(UCDContent.Invoices) Тогда
		
		ДобавитьОшибкуВалидации(
			СписокОшибок,
			"Не заполнен элемент Файл/Документ/СвКСчФ/СчФ"
		);
		
	КонецЕсли;
	
	Индекс = 0;
	
	Для Каждого РеквизитыСчФ Из UCDContent.Invoices Цикл
		
		ОшибкиСчФ = ПроверитьРеквизитыКорректируемогоСчетаФактуры(РеквизитыСчФ);
		
		ЗаголовокГруппыОшибок = "Файл/Документ/СвКСчФ/СчФ[" + XMLСтрока(Индекс) + "]";
		
		ДобавитьГруппуОшибокВалидации(
			СписокОшибок,
			ОшибкиСчФ,
			ЗаголовокГруппыОшибок
		);
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если UCDContent.InvoiceCorrectionTable.Items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Нет строк, по которым происходит корректировка суммовых или количественных показателей");
	КонецЕсли;
	
	ФорматПриказа = "736";
	
	ПроверитьОшибкиВШапкеУПД_УКД(СписокОшибок, UCDContent, ФорматПриказа);
	
	// валидируем ТЧ
	ВсеСтрокиНДС_ИсчНалАг = Истина;
	ц = 0;
	
	ЕстьСтрокиБезИзмененияСуммыНалога = Ложь;
	ОшибкиПоСтрокамТЧ = Новый Массив;
	
	Для Каждого item Из UCDContent.InvoiceCorrectionTable.Items Цикл 
		
		ц = ц + 1;
		
		ОшибкиВСтроке = Новый Массив;
		ПроверитьФорматПоля(ОшибкиВСтроке, Item.Product, "Наименование товара", Истина, 0, 1000, Ложь, "с");
		
		Если Item.AmountsDec.Total = 0 И Item.AmountsInc.Total = 0 Тогда
			ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Нет изменения стоимости товаров (работ, услуг), имущественных прав с налогом - всего");
		КонецЕсли;
		
		// Должно присутствовать хотя бы одно из полей @НаимТов, ДопСведТов/@ХарактерТов, ДопСведТов/@АртикулТов, ДопСведТов/@КодТов"
		Если Не ЗначениеЗаполнено(item.Product)
			И Не ЗначениеЗаполнено(item.ItemCharact)
			И Не ЗначениеЗаполнено(item.ItemArticle)
			И Не ЗначениеЗаполнено(item.ItemVendorCode) Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Должно быть заполнено хотя бы одно из полей: Наименование товара, характеристика, артикул, код");
			
		КонецЕсли;
		
		// @КолТовДо должен быть больше 0"
		КоличествоДоИзменения = item.OriginalValues.Quantity;
		Если КоличествоДоИзменения <> Неопределено
			И КоличествоДоИзменения <= 0 Тогда
			ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Количество товара до изменения должно быть больше 0");
		КонецЕсли;
		
		// СумНДС должна быть >= 0"
		СуммаНалогаДоИзменения = item.OriginalValues.Vat;
		Если ЗначениеЗаполнено(СуммаНалогаДоИзменения)
			И СуммаНалогаДоИзменения < 0 Тогда
			ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Сумма налога до изменения должна быть больше или равной 0");
		КонецЕсли;
		
		ВалидацияUCD736_ПроверитьСтавкиНДС(item, ОшибкиВСтроке);
		
		Если Не TaxRate_ЭтоЗначениеИсчНалАг(item.OriginalValues.TaxRate) Тогда
			
			ВсеСтрокиНДС_ИсчНалАг = Ложь;
			
			// СумНалПосле должен присутствовать при @НалСтДо != 'НДС исчисляется налоговым агентом'
			// СумНДС должна быть >= 0"
			СуммаНалогаПослеИзменения = item.CorrectedValues.Vat;
			Если ЗначениеЗаполнено(СуммаНалогаПослеИзменения)
				И СуммаНалогаПослеИзменения < 0 Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Сумма налога после изменения должна быть больше или равной 0");
			КонецЕсли;
			
			// СумНалРазн должен присутствовать при @НалСтДо != 'НДС исчисляется налоговым агентом'"
			Если НЕ ЗначениеЗаполнено(item.AmountsInc.Vat) 
				И НЕ ЗначениеЗаполнено(item.AmountsDec.Vat) 
				И ПроверятьСуммыНалогов(item.OriginalValues.TaxRate) Тогда 
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Сумма увеличения или уменьшения налога должна быть заполнена");
				ЕстьСтрокиБезИзмененияСуммыНалога = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// ДопСведТов/@НаимЕдИзмДо (ДопСведТов/@НаимЕдИзмДо=<value-of select=""ДопСведТов/@НаимЕдИзмДо""/>) должно быть заполнено при заполненном @ОКЕИ_ТовДо"
		Если ЗначениеЗаполнено(item.OriginalValues.UnitCode)
			И Не ЗначениеЗаполнено(item.OriginalValues.UnitName) Тогда
			ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Не заполнено наименование единицы измерения до изменения");
		КонецЕсли;
		
		// Код ТН ВЭД
		ПроверитьФорматПоля(ОшибкиВСтроке, item.ItemTypeCode, "Код вида товара (ТН ВЭД)", Ложь, 10, 10, Истина, "м");

		ДобавитьГруппуОшибокВалидации(ОшибкиПоСтрокамТЧ, ОшибкиВСтроке, "Ошибки в строке " + ц + " табличной части");
		
	КонецЦикла;
	
	Если ЕстьСтрокиБезИзмененияСуммыНалога Тогда
		ДобавитьОшибкуДолжныБытьТолькоСтрокиСКорректировкойНалога(СписокОшибок);
	КонецЕсли;
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, ОшибкиПоСтрокамТЧ);
	
	Если ВсеСтрокиНДС_ИсчНалАг Тогда
		ДополнитьМассивОшибокВалидации(СписокОшибок, ПроверитьИтоговыеСуммыУвеличенияУменьшенияУКД736(UCDContent.InvoiceCorrectionTable));
	КонецЕсли;
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, ПроверитьКлассификаторыУКД(UCDContent, UCDContent.InvoiceCorrectionTable.Items));
	
	Возврат СписокОшибок;
	
КонецФункции

Процедура ВалидацияUCD736_ПроверитьСтавкиНДС(Строка736, ОшибкиВСтроке)
	
	СтавкаДоИзменения = Строка736.OriginalValues.TaxRate;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если Не ЗначениеЗаполнено(СтавкаДоИзменения) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Ставка НДС до изменения не указана");
		
	ИначеЕсли Не TaxRate_ЭтоВалидноеЗначение(СтавкаДоИзменения) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Указана недопустимая ставка налога до изменения (" + СтавкаДоИзменения + ")");
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	СтавкаПослеИзменения = Строка736.CorrectedValues.TaxRate;
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если Не ЗначениеЗаполнено(СтавкаПослеИзменения) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Ставка НДС после изменения не указана");
		
	ИначеЕсли Не TaxRate_ЭтоВалидноеЗначение(СтавкаПослеИзменения) Тогда
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Указана недопустимая ставка налога после изменения (" + СтавкаПослеИзменения + ")");
		
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
КонецПроцедуры

Функция ВалидацияUCD736_ПроверитьВалюту(ВалютаСсылка, ВалютаКод)
	
	Результат = Новый Массив;
	
	ПроверитьФорматПоля(Результат, ВалютаКод, "Код валюты счета-фактуры", Истина, 3, 3, Истина, "м");
	
	НаименованиеВалюты = НаименованиеВалюты(ВалютаКод, Истина);
	Если НЕ ЗначениеЗаполнено(НаименованиеВалюты) Тогда
		
		ШаблонОшибкиКодНеНайден = НСтр("ru='В классификаторе валют не найден код ""<%1>"". Выберите валюту из классификатора'");
		ТекстОшибкиКодНеНайден = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибкиКодНеНайден, ВалютаКод);
		
		ДобавитьОшибкуВалидации(Результат, ТекстОшибкиКодНеНайден, ВалютаСсылка);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверятьСуммыНалогов(Ставка) 
	Результат = Истина;
	
	НеПроверяемыеСтавкиНалогов = Новый Массив;
	НеПроверяемыеСтавкиНалогов.Добавить(TaxRate_БезНДС());
	НеПроверяемыеСтавкиНалогов.Добавить(TaxRate_0());
	
	ПодходящаяСтавка = НеПроверяемыеСтавкиНалогов.Найти(Ставка);
	
	Если Не ПодходящаяСтавка = Неопределено Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ДобавитьОшибкуДолжныБытьТолькоСтрокиСКорректировкойНалога(Ошибки)
	
	ЧастиТекста = Новый Массив;
	ЧастиТекста.Добавить("В УКД 736@ формата в табличной части должны быть только те позиции,");
	ЧастиТекста.Добавить("по которым произошли изменения в сумме НДС.");
	ЧастиТекста.Добавить("<Подробнее>.");
	РазделительТекста = Символы.НПП;
	
	ТекстОшибки = Общее_СоединитьСтроку(ЧастиТекста, РазделительТекста);
	
	Гиперссылка = "https://support.kontur.ru/pages/viewpage.action?pageId=83865722";
	
	ДобавитьОшибкуВалидации(Ошибки, ТекстОшибки, Гиперссылка);
	
КонецПроцедуры

Функция ПроверитьИтоговыеСуммыУвеличенияУменьшенияУКД736(InvoiceCorrectionTable)
	
	Результат = Новый Массив;
	
	Если СтруктураЗаполнена(InvoiceCorrectionTable.TotalsInc) Тогда
		ДобавитьГруппуОшибокВалидации(Результат, ПроверитьInvoiceTotalsDiff(InvoiceCorrectionTable.TotalsInc), "Ошибки в заполнении итоговых сумм увеличения");
	Иначе
		ДобавитьГруппуОшибокВалидации(Результат, ПроверитьInvoiceTotalsDiff(InvoiceCorrectionTable.TotalsDec), "Ошибки в заполнении итоговых сумм уменьшения");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьInvoiceTotalsDiff(InvoiceTotalsDiff)
	
	Результат = Новый Массив;
	
	// @СумНал должен быть заполнен в случаях, когда все // СведТов/@НалСтДо = 'НДС исчисляется налоговым агентом'
	// СумНДС должна быть >= 0"
	СуммаНалога = InvoiceTotalsDiff.Vat;
	ЕстьБезНДС = ЭтоИстина(InvoiceTotalsDiff.WithoutVat);
	ЕстьСумНДС = (СуммаНалога <> Неопределено);
	
	// Должно быть что-то одно и только одно: либо @СумНДС, либо @БезНДС
	Если ЕстьБезНДС И ЕстьСумНДС 
		Или Не ЕстьБезНДС И Не ЕстьСумНДС Тогда
		
		ШаблонОшибки = "Должна быть указана итоговая сумма налога или значение ""%1""";
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки, СтрокаБезНДС());
		ДобавитьОшибкуВалидации(Результат, ТекстОшибки);
		
	ИначеЕсли ЕстьСумНДС Тогда
		
		Если СуммаНалога < 0 Тогда
			ДобавитьОшибкуВалидации(Результат, "Не указана итоговая сумма налога");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВалидацияАктСверки405ИнформацияОтправителя(Content) Экспорт
	
	СписокОшибок = Новый Массив;
	
	Sender = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Sender;
	Ошибки = ВалидацияАктСверки405_Участник(Sender,
		Content.СлужебнаяИнформация.Организация,
		"об отправителе",
		"организации");
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);

	Recipient = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Recipient;
	Ошибки = ВалидацияАктСверки405_Участник(Recipient,
		Content.СлужебнаяИнформация.Контрагент,
		"о получателе",
		"контрагента");
	
	ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);

	СписокОшибокДокумента = Новый Массив;

	Currency = Content.ReconciliationAct.AdditionalInfoReconciliationAct.Currency;
	
	ПроверитьФорматПоля(СписокОшибокДокумента, Currency,
		"Код валюты", Истина, 3, 3, Истина);
	
	Если СписокОшибокДокумента.Количество() > 0 Тогда
	
		ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокОшибокДокумента,
			"В <связанном документе 1С> не указана валюта.
			|Перейдите в документ 1С и заполните валюту",
			Content.СлужебнаяИнформация.Ссылка);
			
	Иначе
		
		Если Не ВалидацияАктСверки405_ПроверитьВалютуПоКлассификатору(Currency) Тогда
			ДобавитьОшибкуВалидации(СписокОшибокДокумента, "Перейдите в документ 1С и выберите валюту из классификатора");
			
			ШаблонОшибки = "В <связанном документе 1С> валюта с кодом %1 не найдена в классификаторе валют";
			СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки, Currency);
			
			ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокОшибокДокумента,
				СтрокаОшибка,
				Content.СлужебнаяИнформация.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	СписокОшибокДокумента = Новый Массив;

	ПроверитьФорматДаты(СписокОшибокДокумента, Content.ReconcilationDateFrom,
		"Дата начала периода взаимных расчетов (ДатаНачПер)", Истина);
	
	Если СписокОшибокДокумента.Количество() > 0 Тогда

		ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокОшибокДокумента,
			"В <связанном документе 1С> не указана дата начала периода взаимных расчетов.
			|Перейдите в документ 1С и заполните дату начала  периода взаимных расчетов",
			Content.СлужебнаяИнформация.Ссылка);
	
	КонецЕсли;
	
	СписокОшибокДокумента = Новый Массив;

	ПроверитьФорматДаты(СписокОшибокДокумента, Content.ReconcilationDateTo,
		"Дата окончания периода взаимных расчетов (ДатаОкПер)", Истина);
	
	Если СписокОшибокДокумента.Количество() > 0 Тогда

		ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокОшибокДокумента,
			"В <связанном документе 1С> не указана дата окончания периода взаимных расчетов.
			|Перейдите в документ 1С и заполните дату окончания периода взаимных расчетов",
			Content.СлужебнаяИнформация.Ссылка);
	
	КонецЕсли;
	
	СписокОшибокДокумента = Новый Массив;

	Ошибки = ВалидацияАктСверки405_ДокументыПоДоговору(Content.ReconciliationAct.ReconciliationActTable.ContractInfo);
	ДополнитьМассивОшибокВалидации(СписокОшибокДокумента, Ошибки);

	ДобавитьГруппуОшибокВалидации(СписокОшибок, СписокОшибокДокумента,
		"Ошибки в связанном документе. Перейдите в <документ 1С> и заполните",
		Content.СлужебнаяИнформация.Ссылка);

	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияАктСверки405_ПроверитьВалютуПоКлассификатору(ВалютаКод)
	
	ЕстьВалютаВКлассификаторе = Истина;
		
	НаименованиеВалюты = НаименованиеВалюты(ВалютаКод, Истина);
	Если НЕ ЗначениеЗаполнено(НаименованиеВалюты) Тогда
		
		ЕстьВалютаВКлассификаторе = Ложь;
		
	КонецЕсли;
	
	Возврат ЕстьВалютаВКлассификаторе;
	
КонецФункции

Функция ВалидацияАктСверки405_ДокументыПоДоговору(ContractInfo)
	
	СписокОшибок = Новый Массив;
	
	Для Каждого ДокументыПоДоговору Из ContractInfo Цикл
		
		Для Каждого ДокументПоДоговору Из ДокументыПоДоговору.DocumentInfo Цикл
			
			ПроверитьФорматПоля(СписокОшибок, ДокументПоДоговору.DocumentNumber,
				"Номер документа (НомДок)", Истина, 1, 255);
			ПроверитьФорматДаты(СписокОшибок, ДокументПоДоговору.DocumentDate,
				"Дата документа (ДатаДок)", Истина);
			
			Ошибки = ВалидацияАктСверки405_ОперацииПоДокументу(ДокументПоДоговору);
			ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
			
		КонецЦикла;
		
	КонецЦикла;

	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияАктСверки405_ОперацииПоДокументу(ДокументПоДоговору)
	
	СписокОшибок = Новый Массив;
	
	Для Каждого ОперацияПоДокументу Из ДокументПоДоговору.OperationInfo Цикл
		
		ПроверитьФорматДаты(СписокОшибок, ОперацияПоДокументу.OperationDate,
			"Дата операции (ДатаОпер)", Истина);
		
		ПроверитьФорматПоля(СписокОшибок, ОперацияПоДокументу.OperationName,
			"Наименование операции (НаимОпер)", Истина, 1, 255);
		
		Если ОперацияПоДокументу.SumAmount = Неопределено
			И ОперацияПоДокументу.SumDebit = Неопределено Тогда
			
			ДобавитьОшибкуВалидации(СписокОшибок,
				"не заполнено одно из полей: с суммой дебета (СумДебет) или суммой кредита (СумКредит)");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияАктСверки405_Участник(ExtendedOrganizationInfo, СсылкаУчастник,
	ПредставлениеУчастника, ВидУчастникаРодительныйПадеж)
	
	СписокОшибок = Новый Массив;

	ТипУчастника = ExtendedOrganizationInfo.Type;
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	Если ТипУчастника = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		
		// Сведения об индивидуальном предпринимателе (СвИП)
		
		Ошибки = ВалидацияАктСверки405_Участник_ФЛ(ExtendedOrganizationInfo,
			СсылкаУчастник,
			ПредставлениеУчастника,
			ВидУчастникаРодительныйПадеж);
		
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
		ОшибкаОГРН = ОшибкаФорматаПоля(ExtendedOrganizationInfo.Ogrn,
			"ОГРНИП", Истина, 15, 15, Истина);
		
		Если ЗначениеЗаполнено(ОшибкаОГРН) Тогда
			
			ШаблонОшибки = "Ошибки в сведениях <%1>.
			|%2.
			|Перейдите в карточку %3 и заполните ОГРН";
			
			СтрокаОшибка = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибки,
				ПредставлениеУчастника,
				ОшибкаОГРН,
				ВидУчастникаРодительныйПадеж);
			
			ДобавитьОшибкуВалидации(СписокОшибок, СтрокаОшибка, СсылкаУчастник);

		КонецЕсли;
		
	ИначеЕсли ТипУчастника = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		// Сведения о физическом лице СвФЛ
		
		Ошибки = ВалидацияАктСверки405_Участник_ФЛ(ExtendedOrganizationInfo,
			СсылкаУчастник,
			ПредставлениеУчастника,
			ВидУчастникаРодительныйПадеж);
		
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	ИначеЕсли ТипУчастника = ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		// Сведения о юридическом лице, состоящем на учете в налоговых органах СвЮЛУч
		
		Ошибки = ВалидацияАктСверки405_Участник_СвЮЛУч(ExtendedOrganizationInfo,
			СсылкаУчастник,
			ПредставлениеУчастника,
			ВидУчастникаРодительныйПадеж);
		
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	ИначеЕсли ТипУчастника = ВидыЮрФизЛиц.ИностраннаяОрганизация Тогда
		
		// Сведения об иностранном лице, не состоящем на учете в налоговых органах СвИнНеУч
		
		Ошибки = ВалидацияАктСверки405_Участник_СвИнНеУч(ExtendedOrganizationInfo,
			СсылкаУчастник,
			ПредставлениеУчастника,
			ВидУчастникаРодительныйПадеж);
		
		ДополнитьМассивОшибокВалидации(СписокОшибок, Ошибки);
		
	Иначе
		
		ШаблонТекстаОшибки = "Неожиданный идентификатор типа участника сверки: %1";
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТипУчастника);
		
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияАктСверки405_Участник_СвИнНеУч(ExtendedOrganizationInfo, СсылкаУчастник,
	ПредставлениеУчастника, ВидУчастникаРодительныйПадеж)

	СписокОшибок = Новый Массив;
	
	ОшибкаИдентификатора = ОшибкаФорматаПоля(ExtendedOrganizationInfo.LegalEntityId,
