// МЕТОДЫ РАБОТЫ С XDTO

Процедура ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Приемник, Источник, Знач ИсключаемыеСвойства = Неопределено)
	
	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СвойствоПриемника Из Приемник.Свойства() Цикл
		
		ИмяСвойства = СвойствоПриемника.Имя;
		
		Если ИсключаемыеСвойства <> Неопределено
			И ИсключаемыеСвойства.Найти(ИмяСвойства) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеИсточника = ЗначениеСвойстваОбъектаXDTO(Источник, ИмяСвойства);
		Если Не ЭтоОбъектXDTO(ЗначениеИсточника)
			И Не ЭтоСписокXDTO(ЗначениеИсточника) Тогда
			
			УстановитьЗначениеXDTO(Приемник, ИмяСвойства, ЗначениеИсточника);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает значения списка XDTO строкой, разделенные запятой
//
// Параметры:
//  Список	 - СписокXDTO - список, содержащий строковые значения
// 
// Возвращаемое значение:
//  Строка - значения списка строкой
//
Функция ПолучитьЗначенияСпискаXDTOСтрокой(Список)
	
	МассивЗначений = Новый Массив;
	
	Для Каждого ЗначениеСписка Из Список Цикл
		МассивЗначений.Добавить(ЗначениеСписка);
	КонецЦикла;
	
	Результат = Общее_СоединитьСтроку(МассивЗначений, ", ");
	
	Возврат Результат;

КонецФункции

Функция ЭтоОбъектXDTO(ПроверяемоеЗначение)

	Результат = (ТипЗнч(ПроверяемоеЗначение) = Тип("ОбъектXDTO"));
	Возврат Результат;
	
КонецФункции

Функция ЭтоСписокXDTO(ПроверяемоеЗначение)

	Результат = (ТипЗнч(ПроверяемоеЗначение) = Тип("СписокXDTO"));
	Возврат Результат;
	
КонецФункции

Функция ЗначениеСвойстваОбъектаXDTO(ОбъектXDTO, ИмяСвойства)
	
	Перем Результат;
	
	Свойство = ОбъектXDTO.Свойства().Получить(ИмяСвойства);
	Если Свойство <> Неопределено Тогда
		
		Если Свойство.ВерхняяГраница = -1 Тогда
			Результат = ОбъектXDTO.ПолучитьСписок(Свойство.Имя);
		Иначе
			Результат = ОбъектXDTO.Получить(Свойство.Имя);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

