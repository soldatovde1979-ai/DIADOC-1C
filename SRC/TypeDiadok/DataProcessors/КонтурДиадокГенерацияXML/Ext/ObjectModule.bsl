Процедура Заполнить_AmountsDiff(Контент, Параметры, ИмяКонтента)
	
	AmountsDiff = Новый Структура;
	
	Если ИмяКонтента = "AmountsInc" Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АкцизРазн") Тогда
			AmountsDiff.Вставить("Excise", ПолучитьЗначениеXDTO(Параметры.АкцизРазн, "СумУвел"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНалРазн") Тогда
			AmountsDiff.Вставить("Vat", ПолучитьЗначениеXDTO(Параметры.СумНалРазн, "СумУвел"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовУчНал") Тогда
			AmountsDiff.Вставить("Total", ПолучитьЗначениеXDTO(Параметры.СтТовУчНал, "СтоимУвел"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовБезНДС") Тогда
			AmountsDiff.Вставить("TotalWithVatExcluded", ПолучитьЗначениеXDTO(Параметры.СтТовБезНДС, "СтоимУвел"));
		КонецЕсли;
		
	Иначе
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "АкцизРазн") Тогда
			AmountsDiff.Вставить("Excise", ПолучитьЗначениеXDTO(Параметры.АкцизРазн, "СумУм"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНалРазн") Тогда
			AmountsDiff.Вставить("Vat", ПолучитьЗначениеXDTO(Параметры.СумНалРазн, "СумУм"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовУчНал") Тогда
			AmountsDiff.Вставить("Total", ПолучитьЗначениеXDTO(Параметры.СтТовУчНал, "СтоимУм"));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовБезНДС") Тогда
			AmountsDiff.Вставить("TotalWithVatExcluded", ПолучитьЗначениеXDTO(Параметры.СтТовБезНДС, "СтоимУм"));
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого КлючЗначение Из AmountsDiff Цикл
		УстановитьЗначениеXDTO(Контент, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

