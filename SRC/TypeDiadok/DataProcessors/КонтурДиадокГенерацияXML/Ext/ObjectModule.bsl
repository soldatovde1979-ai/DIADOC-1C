			Или ЗначениеЗаполнено(УчастникЭДО820.Name)
			Или ЗначениеЗаполнено(УчастникЭДО820.Inn)
			Или ЗначениеЗаполнено(УчастникЭДО820.BoxId)
			Или ЗначениеЗаполнено(УчастникЭДО820.FnsParticipantId));
	
