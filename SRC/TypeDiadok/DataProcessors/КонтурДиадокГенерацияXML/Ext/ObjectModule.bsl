		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимОргПер"		, OtherIssuer.OrganizationName);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснДоверОргПер"	, OtherIssuer.OrganizationBase);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснПолнПредПер"	, OtherIssuer.EmployeeBase);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "НаимОргПол") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимОргПол"		, OtherIssuer.OrganizationName);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснДоверОргПол"	, OtherIssuer.OrganizationBase);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснПолнПредПол"	, OtherIssuer.EmployeeBase);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "НаимОргПрин") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимОргПрин"	, OtherIssuer.OrganizationName);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснДоверОргПрин", OtherIssuer.OrganizationBase);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснПолнПредПрин", OtherIssuer.EmployeeBase);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьЮридическоеЛицоКонтрагента(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "СвЮЛУч") Тогда
		
		// 155@, 820@, 970@
		СвЮЛУч = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "СвЮЛУч");
		
		УстановитьЗначениеXDTO(СвЮЛУч, "НаимОрг", ПротоКонтент.Name);
		
		Если ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
			УстановитьЗначениеXDTO(СвЮЛУч, "ИННЮЛ", ПротоКонтент.Inn);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПротоКонтент.Kpp) Тогда
			УстановитьЗначениеXDTO(СвЮЛУч, "КПП", ПротоКонтент.Kpp);
		КонецЕсли;
		
		// 820@
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвЮЛУч, "ДефИННЮЛ") Тогда
			Если ЭтоИстина(ПротоКонтент.HyphenInn)
				Или Не ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
				УстановитьЗначениеXDTO(СвЮЛУч, "ДефИННЮЛ", СтрокаДефис());
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "СвОрг") Тогда
		
		// 551@, 552@
		СвОрг = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "СвОрг");
		СвЮЛ = НовыйДочернийОбъектXDTO(Фабрика, СвОрг, "СвЮЛ");
		
		УстановитьЗначениеXDTO(СвЮЛ, "НаимОрг"	, ПротоКонтент.Name);
		УстановитьЗначениеXDTO(СвЮЛ, "ИННЮЛ"	, ПротоКонтент.Inn);
		УстановитьЗначениеXDTO(СвЮЛ, "КПП"		, ПротоКонтент.Kpp);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьИндивидуальногоПредпринимателяКонтрагента_820(ИмяПакетаXDTO, ОбъектXDTO, ПротоКонтент)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	СвИП = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "СвИП");
	XML_ЗаполнитьОбщиеСведенияОбИндивидуальномПредпринимателе(ИмяПакетаXDTO, СвИП, ПротоКонтент);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвИП, "ДефИННФЛ") Тогда
		Если ЭтоИстина(ПротоКонтент.HyphenInn)
			Или Не ЗначениеЗаполнено(ПротоКонтент.Inn) Тогда
			УстановитьЗначениеXDTO(СвИП, "ДефИННФЛ", СтрокаДефис());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ЗаполнитьСумНал(СумНал, СуммаНДС, БезНДС = Ложь)
	
	Если БезНДС Тогда
		УстановитьЗначениеXDTO(СумНал, "БезНДС", СтрокаБезНДС());
	Иначе
		УстановитьЗначениеXDTO(СумНал, "СумНал", Привести_К_Числу(СуммаНДС));
	КонецЕсли;

КонецПроцедуры

Функция ЭтоИННЮрЛица(Значение)
	
	ДлинаИННЮрЛица = 10;
	Результат = СтрДлина(СокрЛП(Значение)) = ДлинаИННЮрЛица;
	Возврат Результат;
	
КонецФункции

