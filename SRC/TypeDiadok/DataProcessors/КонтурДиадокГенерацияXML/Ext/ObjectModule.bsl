			ОшибкиБанковскогоСчета = ВалидацияСчетаФНС29_ТекстОшибкиПриОтсутствииБанковскихСведенийВДокументе1С();
		КонецЕсли;
		
		ВалидацияСчетаФНС29_ДополнитьОшибкамиОБанковскомСчете(ОшибкиКонтрагента, ОшибкиБанковскогоСчета);

		ОрганизацияСсылка = ПолучитьЗначениеXDTO(MoneyRecipient.СлужебнаяИнформация, "Ссылка");
		
		ДобавитьГруппуОшибокВалидации(
			СписокОшибок,
			ОшибкиКонтрагента,
			"Ошибки в сведениях о <получателе денежных средств>",
			ОрганизацияСсылка);
		
	КонецЕсли;

КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьТабличныеДанныеДокумента(Table, СписокОшибок)
	
	Если Не ЗначениеЗаполнено(Table)
		Или Не ЗначениеЗаполнено(Table.Items) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствует табличная часть документа");
	КонецЕсли;
	
	НомерСтроки = 1;
	
	ВсеСтрокиСНулевойСуммойНДС = Истина;
	
	Для Каждого СтрокаТЧ Из Table.Items Цикл
		
		ОшибкиВСтроке = ВалидацияСчетаФНС29_ПроверитьДанныеВСтрокеТаблицы(СтрокаТЧ);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + НомерСтроки + " табличной части");
		
		ВСтрокеНулеваяСуммаНДС = Не TaxRate_ЭтоЗначениеБезНДС(СтрокаТЧ.TaxRate)
			И (TaxRate_ЭтоЗначение_0(СтрокаТЧ.TaxRate)
				Или TaxRate_ЭтоЗначениеИсчНалАг(СтрокаТЧ.TaxRate));
			
		Если Не ВСтрокеНулеваяСуммаНДС Тогда
			ВсеСтрокиСНулевойСуммойНДС = Ложь;
		КонецЕсли;
			
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	ОшибкиИтоговыхЗначений = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Table.TotalWithVatExcluded) Тогда
		ДобавитьОшибкуВалидации(ОшибкиИтоговыхЗначений, "Не заполнена итоговая стоимость товаров без НДС");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Table.Total) Тогда
		ДобавитьОшибкуВалидации(ОшибкиИтоговыхЗначений, "Не заполнена итоговая стоимость товаров с учетом НДС");
	КонецЕсли;
	
	ДолжнаБытьИтоговаяСуммаНДС = Не ВсеСтрокиСНулевойСуммойНДС И Не Table.WithoutVat;
	
	Если ДолжнаБытьИтоговаяСуммаНДС И Не ЗначениеЗаполнено(Table.Vat) Тогда
		ДобавитьОшибкуВалидации(ОшибкиИтоговыхЗначений, "Не заполнена итоговая сумма НДС");
	КонецЕсли;
	
	ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиИтоговыхЗначений, "Ошибки в итоговых значениях по таблице товаров");
	
КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьРеквизитыОснованийВыставленияСчета(ProformaInvoiceBases, СписокОшибок)

	Для Каждого ОснованиеВыставленияСчета Из ProformaInvoiceBases Цикл
		
		Если Не СтруктураЗаполнена(ОснованиеВыставленияСчета.ProformaInvoiceBaseDocument) Тогда
			Продолжить;
		КонецЕсли;
		
		РеквизитыДокумента = ОснованиеВыставленияСчета.ProformaInvoiceBaseDocument;
		
		НаименованиеОснования = РеквизитыДокумента.DocumentName;
		НомерОснования = РеквизитыДокумента.DocumentNumber;
		ДатаОснования = РеквизитыДокумента.DocumentDate;
		
		ОшибкиОснования = Новый Массив;
		
		Если Не ЗначениеЗаполнено(ДатаОснования)
			Или Не ЗначениеЗаполнено(НомерОснования) Тогда
			
			ДобавитьОшибкуВалидации(ОшибкиОснования, "Заполните дату и номер основания/договора");
			
		КонецЕсли;
		
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(ОшибкиОснования, НаименованиеОснования, "Наименование основания", Истина, 1, 255, Ложь, "с");
		// BSLLS:MagicNumber-on
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиОснования, "Ошибки в основании");
			
	КонецЦикла;
	
КонецПроцедуры

Функция ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастнике(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Name, "Наименование контрагента", Истина, 0, 1000, Ложь);
	
	ПредставлениеПоля = "Краткое наименование контрагента";
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.ShortOrgName, ПредставлениеПоля, Ложь, 1, 510, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okpo, "ОКПО контрагента", Ложь, 1, 10, Истина);
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Okopf, "ОКОПФ контрагента", Ложь, 2, 5, Истина);
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Ogrn, "ОГРН контрагента", Ложь, 13, 15, Истина);
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Department, "Структурное подразделение", Ложь, 1, 500, Ложь);
	
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.FullNameOPF, "Полное наименование ОПФ", Ложь, 4, 255, Ложь);
	
	ПредставлениеПоля = "Информация для участника документооборота";
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.AdditionalInfo, ПредставлениеПоля, Ложь, 1, 255, Ложь);
	// BSLLS:MagicNumber-on

	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	ВидКонтрагента = OrganizationInfo.Type;
	
	Если ВидКонтрагента = ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		
		ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастникеКакЮрЛицо(OrganizationInfo, СписокОшибок);
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель Тогда
		
		ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастникеКакИП(OrganizationInfo, СписокОшибок);
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		
		ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастникеКакФизЛице(OrganizationInfo, СписокОшибок);
		
	ИначеЕсли ВидКонтрагента = ВидыЮрФизЛиц.ИностраннаяОрганизация
		Или ВидКонтрагента = ВидыЮрФизЛиц.ИностранныйГражданин Тогда
		
		ВалидацияСчетаФНС29_ПроверитьСведенияОбИностранномУчастнике(OrganizationInfo, СписокОшибок);
			
	Иначе
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(
			"Неправильно указан тип контрагента (%1)",
			ВидКонтрагента);
			
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Процедура ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастникеКакЮрЛицо(OrganizationInfo, СписокОшибок)
	
	Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ЮрЛицо");
	ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		Ошибки = ПроверитьКППКонтрагента(OrganizationInfo.Kpp);
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастникеКакИП(OrganizationInfo, СписокОшибок)
	
	Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ФизЛицо");
	ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Для физ. лиц КПП не указывается");
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	Свидетельство =  OrganizationInfo.IndividualEntityRegistrationCertificate;
	ПроверитьФорматПоля(СписокОшибок, Свидетельство, "Свидетельство о гос. регистрации ИП", Ложь, 1, 100, Ложь);
	
	ОГРНИП = OrganizationInfo.IndividualEntityRegistrationNumber;
	ПроверитьФорматПоля(СписокОшибок, ОГРНИП, "ОГРНИП", Ложь, 15, 15, Истина);
	
	ИныеСведения = OrganizationInfo.OrganizationOrPersonInfo;
	ПроверитьФорматПоля(СписокОшибок, ИныеСведения, "иные сведения", Ложь, 1, 255, Ложь);
	// BSLLS:MagicNumber-on
	
	ЧастиФИО = РазложитьСтрокуВМассивСлов(OrganizationInfo.Name, " ");
	
	МинимальноеЧислоЭлементовФИО = 2;
	Если ЧастиФИО.Количество() < МинимальноеЧислоЭлементовФИО Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя индивидуального предпринимателя");
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьСведенияОбУчастникеКакФизЛице(OrganizationInfo, СписокОшибок)
	
	ИдРозничногоПокупателя = "0";
	ИдИногоЛица = "1";

	ЭтоРозничныйПокупатель = (OrganizationInfo.PhysicalEntityStatusID = ИдРозничногоПокупателя);
	ОбязательныеРеквизитыЗаполнены = (ЗначениеЗаполнено(OrganizationInfo.Inn)
		Или ЗначениеЗаполнено(OrganizationInfo.Name)
		Или ЗначениеЗаполнено(OrganizationInfo.OrganizationOrPersonInfo));
	
	Если Не ЭтоРозничныйПокупатель
		И Не ОбязательныеРеквизитыЗаполнены Тогда
		
		ДобавитьОшибкуВалидации(
			СписокОшибок,
			"Должно быть заполнено хотя бы одно поле для идентификации
			|физического лица: ФИО, ИНН или иные сведения");
		
	КонецЕсли;
	
	ИдСтатусаФизЛицаВалидный = (OrganizationInfo.PhysicalEntityStatusID = Неопределено)
		Или OrganizationInfo.PhysicalEntityStatusID = ИдРозничногоПокупателя
		Или OrganizationInfo.PhysicalEntityStatusID = ИдИногоЛица;
		
	Если Не ИдСтатусаФизЛицаВалидный Тогда
		ДобавитьОшибкуВалидации(
			СписокОшибок,
			"указано не валидное значение в статусе контрагента (допустимо ""0"" или ""1"")");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OrganizationInfo.Inn) Тогда
		Ошибки = ПроверитьИННКонтрагента(OrganizationInfo.Inn, "ФизЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, Ошибки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OrganizationInfo.Kpp) Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "Для физ. лиц КПП не указывается");
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ИныеСведения = OrganizationInfo.OrganizationOrPersonInfo;
	ПроверитьФорматПоля(СписокОшибок, ИныеСведения, "иные сведения", Ложь, 1, 255, Ложь);
	// BSLLS:MagicNumber-on
	
	ЧастиФИО = РазложитьСтрокуВМассивСлов(OrganizationInfo.Name, " ");
	
	МинимальноеЧислоЭлементовФИО = 2;
	Если ЧастиФИО.Количество() < МинимальноеЧислоЭлементовФИО Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "не указано имя физического лица");
	КонецЕсли;
	
КонецПроцедуры

Процедура ВалидацияСчетаФНС29_ПроверитьСведенияОбИностранномУчастнике(OrganizationInfo, СписокОшибок)
	
	ОдноОбязательноеПолеЗаполнено = ЗначениеЗаполнено(OrganizationInfo.LegalEntityId)
		Или ЗначениеЗаполнено(OrganizationInfo.OrganizationOrPersonInfo);
		
	Если Не ОдноОбязательноеПолеЗаполнено Тогда
		
		ТекстОшибки = "Должно быть заполнено хотя бы одно поле для идентификации
		|иностранной организации (иностранного гражданина): налоговый номер или регистрационный номер";
		
		ДобавитьОшибкуВалидации(СписокОшибок, ТекстОшибки);
		
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.CountryCode, "код страны", Истина, 3, 3, Истина);
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.Country, "наименование страны", Истина, 1, 255, Ложь);
	
	ИдентификаторОрганизации = OrganizationInfo.LegalEntityId;
	ПредставлениеПоля = "идентификатор иностранной организации";
	ПроверитьФорматПоля(СписокОшибок, ИдентификаторОрганизации, ПредставлениеПоля, Ложь, 1, 255, Ложь);
	
	ИныеСведения = OrganizationInfo.OrganizationOrPersonInfo;
	ПредставлениеПоля = "иные сведения для однозначной идентификации иностранной организации";
	ПроверитьФорматПоля(СписокОшибок, ИныеСведения, ПредставлениеПоля, Ложь, 1, 255, Ложь);
	// BSLLS:MagicNumber-on
	
КонецПроцедуры

Функция ВалидацияСчетаФНС29_ПроверитьСведенияОБанковскомСчете(OrganizationInfo)
	
	СписокОшибок = Новый Массив;
	
	НомерСчета = OrganizationInfo.BankAccountNumber;
	КоррСчет = OrganizationInfo.CorrespondentAccount;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(СписокОшибок, НомерСчета, "Номер банковского счета", Истина, 1, 20, Истина);
	ПроверитьФорматПоля(СписокОшибок, КоррСчет, "Корреспондентский счёт", Истина, 1, 20, Истина);
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.BankName, "Наименование банка", Ложь, 1, 1000, Ложь, "с");
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.BankId, "БИК", Истина, 9, 9, Истина);
	ПроверитьФорматПоля(СписокОшибок, OrganizationInfo.SwiftCode, "SWIFT-Код", Ложь, 8, 11, Ложь);
	// BSLLS:MagicNumber-on

	Если ЗначениеЗаполнено(OrganizationInfo.BankInn) Тогда
		ОшибкиИНН = ПроверитьИННКонтрагента(OrganizationInfo.BankInn, "ЮрЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, ОшибкиИНН);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(OrganizationInfo.BankKpp) Тогда
		ОшибкиКПП = ПроверитьКППКонтрагента(OrganizationInfo.BankKpp, "ЮрЛицо");
		ДобавитьОшибкуВалидации(СписокОшибок, ОшибкиКПП);
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияСчетаФНС29_ПроверитьСтруктуруАдреса(Address)
	
	Результат = ВалидацияСчетаФНС29_ОбщаяПроверкаЗаполненияАдреса(Address);
	
	Если Результат.Количество() = 0 Тогда
		
		ВидАдреса = Перечисление_ВидыАдресов();
		
		// BSLLS:IfElseIfEndsWithElse-off
		Если Address.Type = ВидАдреса.АдресРФ Тогда
			Результат = Валидация_ПроверитьСтруктуруАдресаРФ(Address.AddressRF);
		ИначеЕсли Address.Type = ВидАдреса.АдресГАР Тогда
			Результат = Валидация_ПроверитьСтруктуруАдресаГАР(Address.AddressSAR);
		ИначеЕсли Address.Type = ВидАдреса.АдресСтрокой Тогда
			Результат = Валидация_ПроверитьСтруктуруАдресаСтрокой(Address.AddressText);
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Address, "GLN") Тогда
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(Результат, Address.GLN, "GLN места", Ложь, 13, 13, Ложь, "м");
		// BSLLS:MagicNumber-on
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВалидацияСчетаФНС29_ОбщаяПроверкаЗаполненияАдреса(AddressInfo)
	
	Перем Address;
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(AddressInfo) Тогда
		
		ВидАдреса = Перечисление_ВидыАдресов();
		
		// BSLLS:IfElseIfEndsWithElse-off
		Если AddressInfo.Type = ВидАдреса.АдресРФ Тогда
			Address = AddressInfo.AddressRF;
		ИначеЕсли AddressInfo.Type = ВидАдреса.АдресГАР Тогда
			Address = AddressInfo.AddressSAR;
		ИначеЕсли AddressInfo.Type = ВидАдреса.АдресСтрокой Тогда
			Address = AddressInfo.AddressText;
		КонецЕсли;
		// BSLLS:IfElseIfEndsWithElse-on
		
	КонецЕсли;
	
	Если Address = Неопределено
		Или Не СтруктураЗаполнена(Address) Тогда
		ДобавитьОшибкуВалидации(Результат, "отсутствуют сведения об адресе");
	Иначе
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(Результат, AddressInfo.Type, "вид адреса", Истина, 0, 11, Ложь, "м");
		// BSLLS:MagicNumber-on
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВалидацияСчетаФНС29_ЕстьСведенияОБанковскомСчете(OrganizationInfo)

	Результат = ЗначениеЗаполнено(OrganizationInfo.BankId)
		Или ЗначениеЗаполнено(OrganizationInfo.BankAccountNumber)
		Или ЗначениеЗаполнено(OrganizationInfo.CorrespondentAccount)
		Или ЗначениеЗаполнено(OrganizationInfo.BankName)
		Или ЗначениеЗаполнено(OrganizationInfo.SwiftCode)
		Или ЗначениеЗаполнено(OrganizationInfo.BankInn)
		Или ЗначениеЗаполнено(OrganizationInfo.BankKpp);
		
	Возврат Результат;
	
КонецФункции

Процедура ВалидацияСчетаФНС29_ДополнитьОшибкамиОБанковскомСчете(ОшибкиКонтрагента, ОшибкиБанковскогоСчета)
	
	Если ЗначениеЗаполнено(ОшибкиБанковскогоСчета) Тогда
		ДобавитьОшибкуВалидацииСОформлением(ОшибкиКонтрагента, "Ошибка в банковских реквизитах:", , "b");
		ДополнитьМассивОшибокВалидации(ОшибкиКонтрагента, ОшибкиБанковскогоСчета);
	КонецЕсли;
		
КонецПроцедуры

Функция ВалидацияСчетаФНС29_ТекстОшибкиПриОтсутствииБанковскихСведенийВДокументе1С()
	
	Результат = Новый Массив;
	
	ДобавитьОшибкуВалидации(Результат, "заполните банковский счет в документе 1С");
	
	Возврат Результат;
	
КонецФункции

Функция ВалидацияСчетаФНС29_ПроверитьДанныеВСтрокеТаблицы(СтрокаТЧ)
	
	ОшибкиВСтроке = Новый Массив;
	
	ОдноОбязательноеПолеЗаполнено = ЗначениеЗаполнено(СтрокаТЧ.Product)
		Или ЗначениеЗаполнено(СтрокаТЧ.ItemVendorCode)
		Или ЗначениеЗаполнено(СтрокаТЧ.ItemCharact)
		Или ЗначениеЗаполнено(СтрокаТЧ.ItemArticle);
	
	Если НЕ ОдноОбязательноеПолеЗаполнено Тогда
		
		ДобавитьОшибкуВалидации(
			ОшибкиВСтроке,
			"Должно быть заполнено одно из полей наименование товара | характеристика | артикул | код товара");
		
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Product, "Наименование товара", Ложь, 1, 2000, Ложь, "с");
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.ItemVendorCode, "Код товара", Ложь, 1, 100, Ложь, "м");
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.ItemCharact, "Характеристика товара", Ложь, 1, 1000, Ложь, "ж");
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.ItemArticle, "Артикул товара", Ложь, 1, 50, Ложь, "м");
	
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Country, "Код страны происхождения товара", Ложь, 3, 3, Истина, "м");
	// BSLLS:MagicNumber-on
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Country) Тогда
		ПроверитьКодСтраныПоКлассификатору(СтрокаТЧ.Country, ОшибкиВСтроке);
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.Unit, "Код единицы измерения", Ложь, 3, 4, Истина, "м");
	// BSLLS:MagicNumber-on
	
	Если ЗначениеЗаполнено(СтрокаТЧ.Unit) Тогда
		
		Если СокрЛП(СтрокаТЧ.Unit) = "0000" Тогда
			
			// BSLLS:MagicNumber-off
			ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.UnitName, "Наименование единицы измерения", Истина, 1, 255, Ложь, "с");
			// BSLLS:MagicNumber-on
			
		Иначе
			
			Валидация_ПроверитьЕдиницуИзмеренияПоОКЕИ(ОшибкиВСтроке, СтрокаТЧ.Unit);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Quantity)
		И ЗначениеЗаполнено(СтрокаТЧ.Unit) Тогда
		
		ТекстОшибки = Новый Массив;
		ТекстОшибки.Добавить("Не заполнено количество.");
		ТекстОшибки.Добавить("В соответствии с форматом ФНС количество должно быть больше ноля.");
		ТекстОшибки.Добавить("Заполните в документе 1С количество");
		
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, Общее_СоединитьСтроку(ТекстОшибки, " "));
		
	КонецЕсли;
	
	ПроверитьИнуюСтавкуНДС = (ЗначениеЗаполнено(СтрокаТЧ.OtherTaxRate) И Не ЗначениеЗаполнено(СтрокаТЧ.TaxRate));
	Если ПроверитьИнуюСтавкуНДС Тогда
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.OtherTaxRate, "Ставка НДС", Ложь, 1, 35, Ложь, "ж");
		// BSLLS:MagicNumber-on
	Иначе
		Валидация_ПроверитьСтавкуНДС(СтрокаТЧ.TaxRate, ОшибкиВСтроке);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТЧ.SubtotalWithVatExcluded) Тогда
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Не заполнена стоимость товара без учета НДС");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТЧ.Subtotal) Тогда
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Не заполнена стоимость товара с учетом НДС");
	КонецЕсли;
	
	ДолжнаБытьСуммаНДС = Не TaxRate_ЭтоЗначениеИсчНалАг(СтрокаТЧ.TaxRate)
		И Не TaxRate_ЭтоЗначение_0(СтрокаТЧ.TaxRate)
		И Не TaxRate_ЭтоЗначениеБезНДС(СтрокаТЧ.TaxRate);
		
	Если ДолжнаБытьСуммаНДС И Не ЗначениеЗаполнено(СтрокаТЧ.Vat) Тогда
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Не заполнена сумма НДС");
	КонецЕсли;
	
	Если ДолжнаБытьСуммаНДС И Не ЗначениеЗаполнено(СтрокаТЧ.VatWithoutDiscount) Тогда
		ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Не заполнена сумма НДС без учета скидки");
	КонецЕсли;
	
	// BSLLS:MagicNumber-off
	ПроверитьФорматПоля(ОшибкиВСтроке, СтрокаТЧ.ItemTypeCode, "Код ТН ВЭД", Ложь, 10, 10, Истина, "м");
	// BSLLS:MagicNumber-on
	
	ВалидацияСчетаФНС29_ПроверитьСведенияПоУчетуТовараВГосударственнойИнформационнойСистеме(
		СтрокаТЧ.StateSystemItemInfos,
		ОшибкиВСтроке);
	
	Возврат ОшибкиВСтроке;
	
КонецФункции

Процедура ВалидацияСчетаФНС29_ПроверитьСведенияПоУчетуТовараВГосударственнойИнформационнойСистеме(
	StateSystemItemInfos,
	ОшибкиВСтрокеТЧ)
	
	ШаблонТекстаОшибки = "Ошибки в строке %1 сведений о товаре, подлежащем учету в гос. инф. системе: "
		+ "наименование государственной информационной системы";
	
	НомерСтроки = 1;
	Для Каждого StateSystemItemInfo Из StateSystemItemInfos Цикл
		
		НаименованиеГосСистемы = StateSystemItemInfo.StateSystemName;
		
		ТекстОшибки = Общее_ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, НомерСтроки);
		
		// BSLLS:MagicNumber-off
		ПроверитьФорматПоля(ОшибкиВСтрокеТЧ, НаименованиеГосСистемы, ТекстОшибки, Истина, 1, 255, Ложь, "с");
		// BSLLS:MagicNumber-on
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// ВАЛИДАЦИЯ СТАВОК НДС

Функция ВалидацияСтавокНДС_UTD970(Content) Экспорт
	
	Результат = Новый Массив;
	
	Если Content.Table = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТабличнаяЧасть = Content.Table.Items;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Если ЭтоВалиднаяСтавкаНДС(СтрокаТЧ.TaxRate) Тогда
			Продолжить;
		КонецЕсли;
		
		ВалидацияСтавокНДС_ДобавитьОшибку(Результат, СтрокаТЧ);
		
		Прервать;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВалидацияСтавокНДС_UCD736(Content) Экспорт
	
	Результат = Новый Массив;
	
	Если Content.InvoiceCorrectionTable = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТабличнаяЧасть = Content.InvoiceCorrectionTable.Items;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Если НЕ ЭтоВалиднаяСтавкаНДС(СтрокаТЧ.CorrectedValues.TaxRate) Тогда
			
			ВалидацияСтавокНДС_ДобавитьОшибку(Результат, СтрокаТЧ.CorrectedValues);
			
			Прервать;
			
		КонецЕсли;
		
		Если НЕ ЭтоВалиднаяСтавкаНДС(СтрокаТЧ.OriginalValues.TaxRate) Тогда
			
			ВалидацияСтавокНДС_ДобавитьОшибку(Результат, СтрокаТЧ.OriginalValues);
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВалидацияСтавокНДC_Invoice29(Content) Экспорт
	
