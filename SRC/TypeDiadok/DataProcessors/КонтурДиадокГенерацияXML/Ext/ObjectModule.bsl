Процедура Заполнить_AcceptanceCertificateSellerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СвАктИ	 = Документ.СвАктИ;
	
	Контент.Seller.FnsParticipantId = Параметры.СвУчДокОбор.ИдОтпр;
	
	УстановитьЗначениеXDTO(Контент, "Title",	СвАктИ.Заголовок);
	УстановитьЗначениеXDTO(Контент, "Number",	СвАктИ.НомАкт);
	УстановитьЗначениеXDTO(Контент, "Date",		ДатаXML_в_Дата1С(СвАктИ.ДатаАкт));
	
	Заполнить_OrganizationInfo(Контент.Seller, СвАктИ.Исполнитель);
	Заполнить_Signer(Контент, Документ, "Подписант");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвАктИ, "Сдал") Тогда
		
		Сдал = СвАктИ.Сдал;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Сдал, "ДатаИсполн") Тогда
			УстановитьЗначениеXDTO(Контент, "SignatureDate", ДатаXML_в_Дата1С(Сдал.ДатаИсполн));
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Сдал, "ПодписьИсполн") Тогда
			Заполнить_Official(Контент.Official, Сдал.ПодписьИсполн);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Сдал, "ДоверенИсполн") Тогда
			Заполнить_Attorney(Контент.Attorney, Сдал.ДоверенИсполн);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвАктИ, "ИнфПол") И ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвАктИ.ИнфПол, "ТекстИнф") Тогда
		УстановитьЗначениеXDTO(Контент, "AdditionalInfo", СвАктИ.ИнфПол.ТекстИнф);
	КонецЕсли;
	
	Для Каждого ОписРабот Из СписокXDTOИзЭлемента(СвАктИ, "ОписРабот") Цикл
		Для Каждого Работа Из СписокXDTOИзЭлемента(ОписРабот, "Работа") Цикл
			Заполнить_AcceptanceCertificateItem(НовыйЭлементСпискаXDTO(Контент.Items), Работа);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

