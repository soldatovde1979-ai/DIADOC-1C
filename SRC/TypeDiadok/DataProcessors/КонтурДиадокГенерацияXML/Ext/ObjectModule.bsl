Процедура Заполнить_TransferInfo970(Контент, Параметры)
	
	СвПер = Параметры.СвПер;
	
	УстановитьЗначениеXDTO(Контент, "OperationInfo", СвПер.СодОпер);
	
	ВидОпер = ПолучитьЗначениеXDTO(СвПер, "ВидОпер");
