Функция ВалидацияXmlTorg12Content(XmlTorg12Content) Экспорт
	
	СписокОшибок = Новый Массив;
	
	ПроверитьФорматДаты(СписокОшибок, XmlTorg12Content.Date, "Дата документа", Истина);
	
	ПроверитьФорматПоля(СписокОшибок, XmlTorg12Content.Number, "Номер документа", Ложь, 0, 256, Ложь, "м");
	
	Если СтруктураЗаполнена(XmlTorg12Content.Seller) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(XmlTorg12Content.Seller, 1);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <поставщике>", XmlTorg12Content.Seller.Ссылка);
	Иначе
		ДобавитьОшибкуВалидации(СписокОшибок, "Отсутствуют данные о поставщике");
	КонецЕсли;		
	
	Если СтруктураЗаполнена(XmlTorg12Content.Shipper) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(XmlTorg12Content.Shipper, 2);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <грузоотправителе>", XmlTorg12Content.Shipper.Ссылка);
	КонецЕсли;		
	
	Если СтруктураЗаполнена(XmlTorg12Content.Buyer) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(XmlTorg12Content.Buyer, 1);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <покупателе>", XmlTorg12Content.Buyer.Ссылка);
	КонецЕсли;		
	
	Если СтруктураЗаполнена(XmlTorg12Content.Consignee) Тогда 
		ОшибкиКонтрагента = ПроверитьСтруктуруКонтрагентаДляТОРГ12(XmlTorg12Content.Consignee, 2);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиКонтрагента, "Ошибки в данных о <грузополучателе>", XmlTorg12Content.Consignee.Ссылка);
	КонецЕсли;		
	
	// основание 
	Если ЗначениеЗаполнено( XmlTorg12Content.GroundDate) Тогда 
		ПроверитьФорматДаты(СписокОшибок, XmlTorg12Content.GroundDate, "Дата договора");
	КонецЕсли;
	
	Если XmlTorg12Content.Items.Количество() = 0 Тогда
		ДобавитьОшибкуВалидации(СписокОшибок, "отсутствует табличная часть документа");
	Иначе 
		ц = 0;
		
		КодыЕдиницДляПроверки = Новый Соответствие;
		
		Для каждого Item Из XmlTorg12Content.Items Цикл 
			
			ОшибкиВСтроке = Новый Массив;
			ц = ц + 1;
			
			Если ЗначениеЗаполнено(Item.UnitCode) Тогда
				КодыЕдиницДляПроверки.Вставить(Item.СсылкаНаЕИ, сокрЛП(Item.UnitCode));
			КонецЕсли;
	
			Если НЕ ЗначениеЗаполнено(Item.Product) Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "не указано наименование товара");
			КонецЕсли;	  
			
			Если НЕ ЗначениеЗаполнено(Item.UnitName) Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "не указано наименование единицы измерения товара");
			КонецЕсли;	
			
			ПроверитьФорматПоля(ОшибкиВСтроке, Item.UnitCode, "Код единицы измерения", Ложь, 3, 4, Истина, "м");
			
			Если НЕ ЗначениеЗаполнено(Item.Quantity) Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "не указано количество товара");
			ИначеЕсли Item.Quantity < 0 Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "количество не может быть отрицательным");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Item.Total) Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "не указана общая сумма по строке");
			КонецЕсли;
			
			Если TaxRate_ЭтоЗначениеИсчНалАг(Item.TaxRate) Тогда
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "Для данного формата документа недопустимо использовать ставку НДС ""НДС исчисляется налоговым агентом""");
 			ИначеЕсли Item.TaxRate = "##" Тогда 
				ДобавитьОшибкуВалидации(ОшибкиВСтроке, "указана недопустимая ставка налога");
			КонецЕсли;	  
			
			ДобавитьГруппуОшибокВалидации(СписокОшибок, ОшибкиВСтроке, "Ошибки в строке " + ц + " табличной части");
			
		КонецЦикла;
		
		ДобавитьГруппуОшибокВалидации(СписокОшибок, ПроверитьЕдиницыИзмерения(КодыЕдиницДляПроверки),	"Ошибки в классификаторе единиц измерения");
	
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции	

