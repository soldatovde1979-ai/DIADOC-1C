// СТАВКИ НДС в XML (НалСт)

// Преобразует значение ставки НДС из прото в представление для XML
//
// Параметры:
//  TaxRate - Строка - значение ставки в терминах proto.xsd (см. Перечисление_TaxRate())
// 
// Возвращаемое значение:
//  Строка - представление ставки в XML-файле
//
Функция НалСт_Из_TaxRate(Знач TaxRate)
	
	Маппинг = Новый Соответствие;
	Маппинг.Вставить(TaxRate_0(), НалСт_0());
	Маппинг.Вставить(TaxRate_5(), НалСт_5());
	Маппинг.Вставить(TaxRate_7(), НалСт_7());
	Маппинг.Вставить(TaxRate_9_09(), НалСт_9_09());
	Маппинг.Вставить(TaxRate_10(), НалСт_10());
	Маппинг.Вставить(TaxRate_16_67(), НалСт_16_67());
	Маппинг.Вставить(TaxRate_18(), НалСт_18());
	Маппинг.Вставить(TaxRate_20(), НалСт_20());
	Маппинг.Вставить(TaxRate_22(), НалСт_22());
	Маппинг.Вставить(TaxRate_5_105(), НалСт_5_105());
	Маппинг.Вставить(TaxRate_7_107(), НалСт_7_107());
	Маппинг.Вставить(TaxRate_10_110(), НалСт_10_110());
	Маппинг.Вставить(TaxRate_18_118(), НалСт_18_118());
	Маппинг.Вставить(TaxRate_20_120(), НалСт_20_120());
	Маппинг.Вставить(TaxRate_22_122(), НалСт_22_122());
	Маппинг.Вставить(TaxRate_БезНДС(), НалСт_БезНДС());
	Маппинг.Вставить(TaxRate_ИсчНалАг(), НалСт_НДСИсчисляетсяНалоговымАгентом());
	
	Результат = Маппинг.Получить(TaxRate);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		// исключение не генерим, т.к. полагаемся на валидацию документа перед отправкой
		Результат = TaxRate;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

