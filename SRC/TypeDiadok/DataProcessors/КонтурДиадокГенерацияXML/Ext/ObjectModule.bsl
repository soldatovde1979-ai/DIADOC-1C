Процедура XML_ОтветныйТитул_ЗаполнитьОсновныеСведенияФайла(ИмяПакетаXDTO
	, Файл
	, ВерсияФормата
	, ИдентификаторПолучателя
	, ИдентификаторОтправителя
	, ПараметрыФормированияФайла
	, ДопПрефикс = "")
	
	ВерсПрог	 = "Diadoc 1.0";
	ОператорЭДО	 = XML_ОператорЭДО();
	Фабрика		 = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ИдФайл		 = XML_ИдФайл(ИмяПакетаXDTO, ДопПрефикс, ИдентификаторПолучателя, ИдентификаторОтправителя, ПараметрыФормированияФайла);
	
	УстановитьЗначениеXDTO(Файл, "ИдФайл"	, ИдФайл);
	УстановитьЗначениеXDTO(Файл, "ВерсПрог"	, ВерсПрог);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм"	, ВерсияФормата);
	
	// Сведения об участниках электронного документооборота
	СвУчДокОбор = НовыйДочернийОбъектXDTO(Фабрика, Файл, "СвУчДокОбор");
	
	УстановитьЗначениеXDTO(СвУчДокОбор, "ИдОтпр", ИдентификаторОтправителя);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвУчДокОбор, "ИдПол") Тогда
		УстановитьЗначениеXDTO(СвУчДокОбор, "ИдПол", ИдентификаторПолучателя);
	Иначе
		УстановитьЗначениеXDTO(СвУчДокОбор, "ИдПок", ИдентификаторПолучателя);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвУчДокОбор, "СвОЭДОтпр") Тогда
		
		// Сведения об операторе
		СвОЭДОтпр = НовыйДочернийОбъектXDTO(Фабрика, СвУчДокОбор, "СвОЭДОтпр");
		УстановитьЗначениеXDTO(СвОЭДОтпр, "НаимОрг"	, ОператорЭДО.Имя);
		УстановитьЗначениеXDTO(СвОЭДОтпр, "ИННЮЛ"	, ОператорЭДО.ИНН);
		УстановитьЗначениеXDTO(СвОЭДОтпр, "ИдЭДО"	, ОператорЭДО.ID);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвУчДокОбор, "СвОЭДОтпрСФ") Тогда
		
		// Сведения об операторе приказ №172 (устарел)
		// 423@ (Торг2)
		СвОЭДОтпрСФ = НовыйДочернийОбъектXDTO(Фабрика, СвУчДокОбор, "СвОЭДОтпрСФ");
		УстановитьЗначениеXDTO(СвОЭДОтпрСФ, "НаимОрг"	, ОператорЭДО.Имя);
		УстановитьЗначениеXDTO(СвОЭДОтпрСФ, "ИННЮЛ"		, ОператорЭДО.ИНН);
		УстановитьЗначениеXDTO(СвОЭДОтпрСФ, "ИдЭДОСФ"	, ОператорЭДО.ID);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура XML_ОтветныйТитул_ЗаполнитьОсновныеСведенияПокупателя(ОбъектXDTO, ПротоКонтент, КНД, ПараметрыФормированияФайла)
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "КНД", КНД);
	
	ДатаФормирования	 = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=dd.MM.yyyy");
	ВремяФормирования	 = Дата_В_Формат(ПараметрыФормированияФайла.ДатаФормирования, "ДФ=HH.mm.ss");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ДатаИнфПок") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаИнфПок", ДатаФормирования);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремИнфПок", ВремяФормирования);
	
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ДатаИнфЗак") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаИнфЗак", ДатаФормирования);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремИнфЗак", ВремяФормирования);
	
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ДатаДок") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаДок", ДатаФормирования);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВремДок", ВремяФормирования);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ДатаИнфПол") Тогда
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаИнфПол", ДатаФормирования);
		УстановитьЗначениеXDTO(ОбъектXDTO, "ВрИнфПол", ВремяФормирования);
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "НаимЭконСубСост") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "DocumentCreator") Тогда
			СоставительФайла = ПротоКонтент.DocumentCreator;
		Иначе
			СоставительФайла = ПротоКонтент.Creator;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "НаимЭконСубСост", СоставительФайла);
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ОбъектXDTO, "ОснДоверОргСост") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПротоКонтент, "DocumentCreatorBase") Тогда
			ОснованиеСоставителя = ПротоКонтент.DocumentCreatorBase;
		Иначе
			ОснованиеСоставителя = ПротоКонтент.CreatorBase;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(ОбъектXDTO, "ОснДоверОргСост", ОснованиеСоставителя);
		
	КонецЕсли;
	
КонецПроцедуры

