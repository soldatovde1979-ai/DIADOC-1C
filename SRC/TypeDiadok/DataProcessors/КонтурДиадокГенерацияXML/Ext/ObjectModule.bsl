		Результат = ТипПрото_ИнформацияПокупателя155();
		
	ИначеЕсли Найти(ИдФайл, "ON_KORSCHFDOPPR_") = 1 // 189@
		Или Найти(ИдФайл, "ON_NKORSCHFDOPPR") = 1 Тогда // 736@
		
