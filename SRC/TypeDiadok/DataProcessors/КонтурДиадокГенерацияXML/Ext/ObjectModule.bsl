// Аналог процедуры ЗаполнитьЗначенияСвойств() для XDTO
//
Процедура ЗаполнитьСвойстваПриемникаXDTO(Приемник, Источник)
	
	Для Каждого Свойство Из Источник.Свойства() Цикл
		
		Если Приемник.Свойства().Получить(Свойство.Имя) <> Неопределено
			И Источник.Установлено(Свойство.Имя)
			И ТипЗнч(Источник[Свойство.Имя]) <> Тип("ОбъектXDTO")
			И ТипЗнч(Источник[Свойство.Имя]) <> Тип("СписокXDTO") Тогда
			
			// и еще бы проверить на совпадение типов
			Приемник[Свойство.Имя] = Источник[Свойство.Имя];
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Примерно как ЗаполнитьСвойстваПриемникаXDTO, только поля по-разному называются
//
Процедура ЗаполнитьСвойстваПриемникаXDTOПоМаппингу(Приемник, Источник, Маппинг)
	
	// Маппинг - это СписокЗначений
	// Представление = имя поля в приемнике
	// Значение = имя поля в источнике
	Для Каждого ЭлементСписка Из Маппинг Цикл
		
		Если Источник.Установлено(ЭлементСписка.Значение) Тогда
			Приемник[ЭлементСписка.Представление] = Источник[ЭлементСписка.Значение];
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Объект, ИмяСвойства)
	
	Результат = Ложь;
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Если ТипОбъекта = Тип("ОбъектXDTO") Тогда
		
		Результат = Объект.Свойства().Получить(ИмяСвойства) <> Неопределено;
		
	ИначеЕсли ТипОбъекта = Тип("Структура")
		Или ТипОбъекта = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Объект.Свойство(ИмяСвойства);
		
	ИначеЕсли ТипОбъекта = Тип("СтрокаТаблицыЗначений") Тогда
		
		Результат = Объект.Владелец().Колонки.Найти(ИмяСвойства) <> Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;

