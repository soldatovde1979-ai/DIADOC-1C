КонецФункции

Функция УПД970_КонвертироватьСведенияУчастникаЭДО_в820(УчастникЭДО970)
	
	Перем Результат;
	
	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	Если УчастникЭДО970.Type = ВидыЮрФизЛиц.ИностранныйГражданин Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НовыйProtoОбъектXDTO("ExtendedOrganizationInfo820");
	
	ИсключаемыеСвойства = Новый Массив;
	ИсключаемыеСвойства.Добавить("Phone");
	ИсключаемыеСвойства.Добавить("Email");
	
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат, УчастникЭДО970, ИсключаемыеСвойства);
	
	Phone = ПолучитьЗначенияСпискаXDTOСтрокой(УчастникЭДО970.Phone);
	УстановитьЗначениеXDTO(Результат, "Phone", Phone);
	
	Email = ПолучитьЗначенияСпискаXDTOСтрокой(УчастникЭДО970.Email);
	УстановитьЗначениеXDTO(Результат, "Email", Email);
	
	Address970 = УчастникЭДО970.Address;
	Если Address970 <> Неопределено
		И ЗначениеЗаполнено(Address970.Type) Тогда
		
