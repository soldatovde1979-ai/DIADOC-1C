Процедура XML_ДоверенностьТип(ИмяПакетаXDTO, ОбъектXDTO, Attorney)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	УстановитьЗначениеXDTO(ОбъектXDTO, "ДатаДоверен", Дата_В_Формат(Attorney.Date, ФорматДаты));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Attorney, "Number") Тогда
		УстановитьЗначениеXDTO(ОбъектXDTO, "НомДоверен", Attorney.Number);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Attorney.Issuer.Firstname) Тогда
		
		// Доверенность выдана кем
		ВыданаКем = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ВыданаКем");
		
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, ВыданаКем, "ФИО");
		XML_ЗаполнитьФИОТип(ФИО, Attorney.Issuer);
		
		УстановитьЗначениеXDTO(ВыданаКем, "ДолжнКем", Attorney.Issuer.JobTitle);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Attorney, "IssuerOrganizationName") Тогда
			УстановитьЗначениеXDTO(ВыданаКем, "НаимОргКем", Attorney.IssuerOrganizationName);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Attorney, "IssuerAdditionalInfo") Тогда
			УстановитьЗначениеXDTO(ВыданаКем, "ДопСведКем", Attorney.IssuerAdditionalInfo);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Attorney.Recipient.Firstname) Тогда
		
		// Доверенность выдана кому
		ВыданаКому = НовыйДочернийОбъектXDTO(Фабрика, ОбъектXDTO, "ВыданаКому");
		
		ФИО = НовыйДочернийОбъектXDTO(Фабрика, ВыданаКому, "ФИО");
		XML_ЗаполнитьФИОТип(ФИО, Attorney.Recipient);
		
		УстановитьЗначениеXDTO(ВыданаКому, "Должн", Attorney.Recipient.JobTitle);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Attorney, "RecipientAdditionalInfo") Тогда
			УстановитьЗначениеXDTO(ВыданаКому, "ДопСведКому", Attorney.RecipientAdditionalInfo);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

