	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО, "ИдГосКон") Тогда
		УстановитьЗначениеXDTO(Контент, "GovernmentContractInfo", СвСНО.ИдГосКон);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО, "НазначПлатеж") Тогда
		УстановитьЗначениеXDTO(Контент, "PaymentPurpose", СвСНО.НазначПлатеж);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО, "ДенИзм") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО.ДенИзм, "КодОКВ") Тогда
			УстановитьЗначениеXDTO(Контент, "Currency", СвСНО.ДенИзм.КодОКВ);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО.ДенИзм, "КурсВал") Тогда
			УстановитьЗначениеXDTO(Контент, "CurrencyRate", СвСНО.ДенИзм.КурсВал);
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО, "Договор") Тогда
		
		УстановитьЗначениеXDTO(Контент.Contract, "Name",	СвСНО.Договор.НаимДог);
		УстановитьЗначениеXDTO(Контент.Contract, "Number",	ПолучитьЗначениеXDTO(СвСНО.Договор, "НомерДог"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСНО.Договор, "ДатаДог") Тогда
			УстановитьЗначениеXDTO(Контент.Contract, "Date", ДатаXML_в_Дата1С(СвСНО.Договор.ДатаДог));
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ТаблСНО") Тогда
		
		Заполнить_ProformaInvoiceTable(Контент.ProformaInvoiceTable, Документ.ТаблСНО);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ.ТаблСНО, "СведЛицСчет") Тогда
			Заполнить_СписокKeyValue(Контент.PersonalAccountInfo, Документ.ТаблСНО.СведЛицСчет, "ЛицСчетИнф");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Документ, "ИнфПол") Тогда
		Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Документ, "ИнфПол");
	КонецЕсли;
	
