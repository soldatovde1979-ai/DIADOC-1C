Процедура Заполнить_Torg12SellerContent(Контент, Параметры)
	
	Документ = Параметры.Документ;
	СвТНО	 = Документ.СвТНО;
	ТН		 = СвТНО.ТН;
	
	Контент.Seller.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдОтпр;
	Контент.Buyer.FnsParticipantId	 = Параметры.СвУчДокОбор.ИдПок;
	
	УстановитьЗначениеXDTO(Контент, "Date"	, ДатаXML_в_Дата1С(ТН.ДатаТН));
	УстановитьЗначениеXDTO(Контент, "Number", ПолучитьЗначениеXDTO(ТН, "НомТН"));
	
	Заполнить_OrganizationInfo(Контент.Seller	, СвТНО.Поставщик);
