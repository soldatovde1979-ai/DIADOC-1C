// Конструктор структуры с полями "Ключ" и "Значение".
//
// Параметры:
//  Ключ - Строка - значение поля "Ключ".
//  Значение - Строка - значение поля "Значение".
// 
// Возвращаемое значение:
//  Структура:
//    * Ключ - Строка
//    * Значение - Строка
//
Функция НовыйКлючЗначение(Ключ, Значение)
	
	Результат = Новый Структура;
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Значение", Значение);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, заполнен ли идентификатор номенклатуры в описании номенклатуры электронного документа.
// Если нет, вычисляет его на основании наименования, характеристики, кода и артикула.
// Полученный идентификатор сокращается до 110 символом путем замены окончания строки
// на контрольную сумму, вычисленную по алгоритму MD5.
//
// Параметры:
//  НоменклатураЭД - Структура - см. Контракт_НоменклатураЭлектронногоДокумента.
// 
Процедура ПроверитьЗаполнитьИдентификаторНоменклатуры(НоменклатураЭД)
	
	Если ЗначениеЗаполнено(НоменклатураЭД.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	ФрагментыПредставления = Новый Массив;
	ФрагментыПредставления.Добавить(НоменклатураЭД.Наименование);
	ФрагментыПредставления.Добавить(НоменклатураЭД.Характеристика);
	ФрагментыПредставления.Добавить(НоменклатураЭД.Код);
	ФрагментыПредставления.Добавить(НоменклатураЭД.Артикул);
	
	Представление = "";
	ВсеПоляПустые = Истина;
	Разделитель = "";
	
	Для Каждого Фрагмент Из ФрагментыПредставления Цикл
		
		Если ЗначениеЗаполнено(Фрагмент) Тогда
			ВсеПоляПустые = Ложь;
		КонецЕсли;
		
		Представление = Представление + Разделитель + СокрЛП(Фрагмент);
		Разделитель = "#";
		
	КонецЦикла;
	
	Если ВсеПоляПустые Тогда
		Представление = "";
	КонецЕсли;
	
	МаксимальнаяДлинаИдентификатора = МаксимальнаяДлинаИдентификатораНоменклатуры();
	НоменклатураЭД.Идентификатор = ИдентификаторПоСтроке(Представление, МаксимальнаяДлинаИдентификатора);
	
КонецПроцедуры

// Определяет тип номенклатуры электронного документа по значению атрибута ПрТовРаб
//
// Параметры:
//  ПрТовРаб - Строка - значение атрибута ПрТовРаб (см. приказы 970@, 820@, 155@)
// 
// Возвращаемое значение:
//  Строка - см. описание поля "Тип" в Контракт_НоменклатураЭлектронногоДокумента
//
Функция ОпределитьТипНоменклатурыЛок(ПрТовРаб)
	
	Если ПрТовРаб = "1" Тогда
		Результат = ТипНоменклатурыИмущество();
	ИначеЕсли ПрТовРаб = "2" Тогда
		Результат = ТипНоменклатурыРабота();
	ИначеЕсли ПрТовРаб = "3" Тогда
		Результат = ТипНоменклатурыУслуга();
	ИначеЕсли ПрТовРаб = "4" Тогда
		Результат = ТипНоменклатурыИмущественныеПрава();
	ИначеЕсли ПрТовРаб = "5" Тогда
		Результат = ТипНоменклатурыИное();
	Иначе
		Результат = ТипНоменклатурыНеУказан();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Приводит поля номенклатуры электронного документа к строке.
//
// Параметры:
//  НоменклатураЭД - Структура - см. Контракт_НоменклатураЭлектронногоДокумента
//
Процедура НормализоватьПоляНоменклатурыЭлектронногоДокумента(НоменклатураЭД)
	
	Для Каждого Элемент Из НоменклатураЭД Цикл
		
		НормализованноеЗначение = СокрЛП(XMLСтрока(Элемент.Значение));
		НоменклатураЭД[Элемент.Ключ] = НормализованноеЗначение;
		
	КонецЦикла;
	
КонецПроцедуры

// Длина поля Идентификатор справочника НоменклатураПоставщиков в старых версиях типовых конфигураций.
// 
// Возвращаемое значение:
//  Число.
//
Функция МаксимальнаяДлинаИдентификатораНоменклатуры()
	Возврат 110;
КонецФункции

// Генерирует уникальный строковый идентификатор с ограниченной длиной.
// Входная строка приводится к верхнему регистру, из нее удаляются все пробелы.
// Если длина нормализованной строки превышает заданное ограничение,
// её "хвост" заменяется на хеш-строку, вычисленную по алгоритму MD5.
//
// Параметры:
//  ВходнаяСтрока - Строка - произвольная строка.
//  МаксимальнаяДлина - Число - (Необязательный) максимальная длина формируемого идентификатора.
// 
// Возвращаемое значение:
//  Строка - идентификатор входной строки.
//
Функция ИдентификаторПоСтроке(Знач ВходнаяСтрока, Знач МаксимальнаяДлина = Неопределено)
	
	Если Не ЗначениеЗаполнено(МаксимальнаяДлина) Тогда 
		МаксимальнаяДлина = 110;
	КонецЕсли;
	
	НормализованнаяСтрока = СокрЛП(ВходнаяСтрока);
	НормализованнаяСтрока = ВРег(НормализованнаяСтрока);
	НормализованнаяСтрока = СтрЗаменить(НормализованнаяСтрока, " ", "");
	
	Результат = СократитьСтрокуКонтрольнойСуммой(НормализованнаяСтрока, МаксимальнаяДлина);
	
	Возврат Результат;
	
КонецФункции

// Сокращает строку до нужной длины, при этом обрезанная часть хешируется,
// обеспечивая уникальность строки. Проверяет длину строки на входе и, в случае
// превышения максимальной длины, преобразует ее конец по алгоритму MD5 в
// уникальную строку из 32 символов.
//
// Параметры:
//  Строка            - Строка - исходная строка произвольной длины.
//  МаксимальнаяДлина - Число  - требуемое максимальное количество символов в строке,
//                               минимальное значение: 32.
// 
// Возвращаемое значение:
//   Строка - строка, не превышающая максимальную длину.
//
Функция СократитьСтрокуКонтрольнойСуммой(Знач Строка, Знач МаксимальнаяДлина)
	
	Результат = Строка;
	
	ДлинаИсходнойСтроки = СтрДлина(Строка);
	
	Если ДлинаИсходнойСтроки > МаксимальнаяДлина Тогда
		
		ХешСтрока = ХешСтрокиПоАлгоритмуMD5(Строка);
		ХешСтрока = СтрЗаменить(ХешСтрока, " ", "");
		
		ДлинаХешСтроки = СтрДлина(ХешСтрока);
		
		Если МаксимальнаяДлина < ДлинаХешСтроки Тогда
			
			Ошибка = НСтр("ru = 'Параметр МаксимальнаяДлина не может быть меньше %1 (длина строки, закодированной по алгоритму MD5)'");
			Ошибка = Общее_ПодставитьПараметрыВСтроку(Ошибка, ДлинаХешСтроки);
			ВызватьИсключение Ошибка;
			
		КонецЕсли;
		
		Результат = Лев(Результат, МаксимальнаяДлина - ДлинаХешСтроки) + ХешСтрока;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// ВычислитьХешСтрокиПоАлгоритмуMD5

Функция ХешСтрокиПоАлгоритмуMD5(Знач Строка)
	
	Если ИспользоватьХешированиеДанных() Тогда
		Результат = ХешСтрокиПоАлгоритмуMD5_Платформа(Строка);
	Иначе
		Результат = ХешСтрокиПоАлгоритмуMD5_БСП(Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ХешСтрокиПоАлгоритмуMD5_Платформа(Знач Строка)
	
	Хеширование = Вычислить("Новый ХешированиеДанных(ХешФункция.MD5)");
	Хеширование.Добавить(Строка);
	
	ХешСтрока = Строка(Хеширование.ХешСумма);
	
	Возврат ХешСтрока;
	
КонецФункции

// Возвращает хеш по алгоритму MD5 для произвольной строки.
//
// Параметры:
//  Строка - Строка - произвольная строка любой длины.
//
// Возвращаемое значение:
//  Строка - хеш, вычисленный из строки.
//
Функция ХешСтрокиПоАлгоритмуMD5_БСП(Знач Строка)
	
	a = ЧислоВБинарныйМассив(1732584193); // 01 23 45 67; (шестнадцатеричное представление, сначала младший байт)
	b = ЧислоВБинарныйМассив(4023233417); // 89 AB CD EF;
	c = ЧислоВБинарныйМассив(2562383102); // FE DC BA 98;
	d = ЧислоВБинарныйМассив(271733878);  // 76 54 32 10;
	
	X = Новый Массив(16); // X - блок данных размером 512 бит, массив из 32-битных слов
	
	// разбиваем строку на блоки по 512 бит
	МассивБлоковИзСтроки = ПолучитьМассивБлоковБайтовИзСтроки(Строка);
	
	// для каждого блока производим расчет
	Для НомерБлока = 0 По МассивБлоковИзСтроки.Количество() - 1 Цикл 
		Блок = МассивБлоковИзСтроки[НомерБлока];
		Для НомерСлова = 0 По 15 Цикл
			Слово = 0;
			Для НомерБайта = 1 По 4 Цикл
				Слово = Слово + Блок[НомерСлова * 4 + НомерБайта - 1] * Pow(256, НомерБайта - 1);
			КонецЦикла;
			X[НомерСлова] = Слово; 
		КонецЦикла;
		
		// в последний блок дописываем длину строки в битах
		Если НомерБлока = МассивБлоковИзСтроки.Количество() - 1 Тогда
			РазмерСтрокиВБитах = СтрДлина(Строка) * 8;
			X[14] = РазмерСтрокиВБитах % Pow(2, 32); // сначала младшие 4 байта
			X[15] = Цел(РазмерСтрокиВБитах / Pow(2, 32)) % Pow(2, 64); // если длина превосходит (2^64 - 1) бит, то старшие биты откидываем
		КонецЕсли;
		РассчитатьБлок(a, b, c, d, X);
	КонецЦикла;
	
	Результат = ЧислоВШестнадцатеричномПредставлении(БинарныйМассивВЧисло(a))
			  + ЧислоВШестнадцатеричномПредставлении(БинарныйМассивВЧисло(b))
			  + ЧислоВШестнадцатеричномПредставлении(БинарныйМассивВЧисло(c))
			  + ЧислоВШестнадцатеричномПредставлении(БинарныйМассивВЧисло(d));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивБлоковБайтовИзСтроки(Знач Строка)
	Результат = Новый Массив;
	Строка = Строка + Символ(128); // единичный бит + выравнивание нолями до байта
	Пока СтрДлина(Строка) > 0 Цикл
		БлокБайтов = ПолучитьБлокБайтовИзСтроки(Лев(Строка, 64));
		Результат.Добавить(БлокБайтов);
		
		// если последние 8 байт получились не нулевые, то добавляем еще один нулевой блок
		Если СтрДлина(Строка) > 56 И СтрДлина(Строка) < 64 Тогда
			Результат.Добавить(ПолучитьБлокБайтовИзСтроки(""));
		КонецЕсли;
		
		Строка = Сред(Строка, 65);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьБлокБайтовИзСтроки(Знач Строка)
	Результат = Новый Массив;
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Результат.Добавить(КодСимвола(Сред(Строка, Позиция, 1)));
	КонецЦикла;
	
	// дополняем блок нолями
	Для Индекс = Позиция По 64 Цикл
		Результат.Добавить(0);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

