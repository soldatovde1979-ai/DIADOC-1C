// Формирует массив структур по коллекции информационных полей.
//
// Параметры:
//  СписокИлиОбъектXDTO - СписокXDTO, ОбъектXDTO - информационные поля.
//  ПолеИдентификатор - Строка - Имя атрибута, содержащего идентификатор поля.
//  ПолеЗначение - Строка - Имя атрибута, содержащего значение поля.
// 
// Возвращаемое значение:
//  Массив из НовыйКлючЗначение.
//
Функция ТекстоваяИнформацияЭлектронногоДокумента(СписокИлиОбъектXDTO, ПолеИдентификатор, ПолеЗначение)
	
	Результат = Новый Массив;
	
	Если ТипЗнч(СписокИлиОбъектXDTO) = Тип("СписокXDTO") Тогда
		КоллекцияОбъектовXDTO = СписокИлиОбъектXDTO;
	ИначеЕсли ТипЗнч(СписокИлиОбъектXDTO) = Тип("ОбъектXDTO") Тогда
		КоллекцияОбъектовXDTO = Новый Массив;
		КоллекцияОбъектовXDTO.Добавить(СписокИлиОбъектXDTO);
	Иначе
		КоллекцияОбъектовXDTO = Новый Массив;
	КонецЕсли;
	
	Для Каждого СписокXDTO Из КоллекцияОбъектовXDTO Цикл
		
		Идентификатор = ПолучитьЗначениеXDTO(СписокXDTO, ПолеИдентификатор);
		Значение = ПолучитьЗначениеXDTO(СписокXDTO, ПолеЗначение);
		
		КлючЗначение = НовыйКлючЗначение(Идентификатор, Значение);
		Результат.Добавить(КлючЗначение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает сведения из типового элемента ТекстИнфТип с полями "Идентиф" и "Значен".
//
// Параметры:
//  ТекстИнфТип - СписокXDTO - текстовая информация.
