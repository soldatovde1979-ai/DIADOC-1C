		УстановитьЗначениеXDTO(СвГосСист, "НаимГосСист", StructedAdditionalInfo.SystemName);
		УстановитьЗначениеXDTO(СвГосСист, "УчетЕд", StructedAdditionalInfo.Unit);
  		УстановитьЗначениеXDTO(СвГосСист, "ИнаяИнф", StructedAdditionalInfo.OtherInfo);
		УстановитьЗначениеXDTO(СвГосСист, "ИдНомУчетЕд", StructedAdditionalInfo.IDUnit);

	КонецЦикла;
		
КонецПроцедуры

Процедура XML_УПД_970_ЗаполнитьСопрДокТов(ИмяПакетаXDTO, ОбъектXDTO, ItemAccompanyingDocuments, ИмяИнфоПоля)
	
	Фабрика = XML_ФабрикаXDTO(ИмяПакетаXDTO);
	
	Для Каждого AccompanyingDocument Из ItemAccompanyingDocuments Цикл
