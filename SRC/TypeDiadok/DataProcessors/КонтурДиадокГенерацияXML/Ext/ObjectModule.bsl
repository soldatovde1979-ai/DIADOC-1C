Процедура ЗаполнитьПротоКонтентXDTOПоСтруктуре(Контент, Структура) Экспорт
	
	Для Каждого Эл Из Структура Цикл
		
		Если ТипЗнч(Эл.Значение) = Тип("Структура") Тогда
			
			Если Эл.Ключ = "ЕдиницаИзмеренияСсылка"
				Или Эл.Ключ = "СсылкаНаЕИ" Тогда
				УстановитьЗначениеXDTO(Контент, Эл.Ключ, Эл.Значение.Ссылка, Истина);
				Продолжить;
			КонецЕсли;
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Контент, Эл.Ключ) Тогда
				ЗаполнитьПротоКонтентXDTOПоСтруктуре(Контент[Эл.Ключ], Эл.Значение);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Эл.Значение) = Тип("Массив")
			Или ТипЗнч(Эл.Значение) = Тип("ТаблицаЗначений") Тогда
			
			Если Не ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Контент, Эл.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			
			ТипСтроки = Контент.Свойства().Получить(Эл.Ключ).Тип.Имя;
			
			Если ТипЗнч(Эл.Значение) = Тип("ТаблицаЗначений") Тогда
				_Массив = ТаблицаЗначений_2_МассивСтруктур(Эл.Значение);
			Иначе
				_Массив = Эл.Значение;
			КонецЕсли;
			
			Для Каждого ЭлементМассива Из _Массив Цикл
				
				Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
					
					НовыйКонтентXDTO = НовыйProtoОбъектXDTO(ТипСтроки, Истина);
					НовЭлемент = Контент[Эл.Ключ].Добавить(НовыйКонтентXDTO);
					ЗаполнитьПротоКонтентXDTOПоСтруктуре(НовЭлемент, ЭлементМассива);
					
				Иначе
					
					Контент[Эл.Ключ].Добавить(ЭлементМассива);
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли Эл.Значение <> Неопределено И Эл.Значение <> NULL И Эл.Значение <> "" Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Контент, Эл.Ключ) Тогда
				
				Если Эл.Ключ = "Price" Тогда
					
					Попытка
						Контент.Price = Эл.Значение;
					Исключение
						Контент.Price = Число(Эл.Значение);
					КонецПопытки;
					
				ИначеЕсли Эл.Ключ = "DocumentDate"
					ИЛИ Эл.Ключ = "BaseDocumentDate" Тогда
					
					Попытка
						Контент[Эл.Ключ] = Дата(Эл.Значение);
					Исключение
						Контент[Эл.Ключ] = ДатаXML_в_Дата1С(Эл.Значение);
					КонецПопытки;
					
				ИначеЕсли Эл.Ключ = "Key" Или Эл.Ключ = "Value" Тогда
					
					Контент[Эл.Ключ] = Эл.Значение; // Записываем как есть, без сокращения пробелов
					
				Иначе
					
					ЭтоИмяСвойстваСсылки	 = ЭтоИмяСвойстваСсылки(Эл.Ключ);
					ЭтоОбъектXDTOСсылки		 = ЭтоОбъектXDTOСсылки(Контент, Эл.Ключ);
					ЭтоСсылка				 = ЭтоИмяСвойстваСсылки ИЛИ ЭтоОбъектXDTOСсылки;
					
					УстановитьЗначениеXDTO(Контент, Эл.Ключ, Эл.Значение, ЭтоСсылка);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаполнитьУКД736ПоДаннымУКД189(ProtoОбъектXDTO) Экспорт 
	
	Если ЗначениеЗаполнено(ProtoОбъектXDTO.EventContent.TransferDocDetails) 
		И Не ЗначениеЗаполнено(ProtoОбъектXDTO.EventContent.TransferDocDetails736) Тогда 
		
		ЗаполнитьПередаточныеДокументыУКД736ПоДаннымУКД189(ProtoОбъектXDTO.EventContent.TransferDocDetails736,
														   ProtoОбъектXDTO.EventContent.TransferDocDetails);
	КонецЕсли;
	
	Для Каждого CorrectionBase Из ProtoОбъектXDTO.EventContent.CorrectionBases Цикл
		
		Если CorrectionBase.BaseDocumentName = "Отсутствует" Тогда
			CorrectionBase.BaseDocumentName = "Без документа-основания";
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Item Из ProtoОбъектXDTO.InvoiceCorrectionTable.Items Цикл
		
		Если Не ЗначениеЗаполнено(Item.OriginalValues.UnitName)
			И ЗначениеЗаполнено(Item.OriginalValues.UnitCode) Тогда
			Item.OriginalValues.UnitName = НаименованиеЕдиницыИзмерения(Item.OriginalValues.UnitCode);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Item.CorrectedValues.UnitName)
			И ЗначениеЗаполнено(Item.CorrectedValues.UnitCode) Тогда
			Item.CorrectedValues.UnitName = НаименованиеЕдиницыИзмерения(Item.CorrectedValues.UnitCode);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПередаточныеДокументыУКД736ПоДаннымУКД189(TransferDocDetails736, TransferDocDetails)
	
	TransferDocDetails736.Очистить();
	
	Если Найти(TransferDocDetails, ",") Тогда
		ПередаточныеДокументы = РазложитьСтрокуВМассивСлов(TransferDocDetails, ",");
	ИначеЕсли Найти(TransferDocDetails, ";") Тогда
		ПередаточныеДокументы = РазложитьСтрокуВМассивСлов(TransferDocDetails, ";");
	Иначе
		ПередаточныеДокументы = Новый Массив;
		ПередаточныеДокументы.Добавить(TransferDocDetails);
	КонецЕсли;
	
	Для Каждого ПередаточныйДокумент Из ПередаточныеДокументы Цикл
		
		// поиск наименования, номера и даты документа в строке вида:
		// УПД №УП-3 от 27.01.2021
		
		НаименованиеДокумента = Неопределено;
		ДатаДокумента = Неопределено;
		
		ПозицияНомера = Найти(ПередаточныйДокумент, "№");
		ПозицияТочки = Найти(ПередаточныйДокумент, "."); // позиция первой точки в дате
		
		Если ПозицияНомера > 0 Тогда
			НаименованиеДокумента = СокрЛП(Лев(ПередаточныйДокумент, ПозицияНомера - 1));
		КонецЕсли;
		
		Если ПозицияТочки > 0
			И СтрДлина(ПередаточныйДокумент) >= ПозицияТочки + 7
			И Сред(ПередаточныйДокумент, ПозицияТочки + 3, 1) = "." Тогда
			
			НомерДокумента = СокрЛП(Сред(ПередаточныйДокумент, ПозицияНомера + 1, ПозицияТочки - ПозицияНомера - 7));
			
			Попытка
				ДатаДокумента = Дата(Сред(ПередаточныйДокумент, ПозицияТочки + 4, 4),
									 Сред(ПередаточныйДокумент, ПозицияТочки + 1, 2),
									 Сред(ПередаточныйДокумент, ПозицияТочки - 2, 2));
			Исключение
				Продолжить;
			КонецПопытки;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НаименованиеДокумента)
			И ЗначениеЗаполнено(ДатаДокумента) Тогда
			
			НовыйTransferDocDetails736 = НовыйЭлементСпискаXDTO(TransferDocDetails736);
			НовыйTransferDocDetails736.BaseDocumentNumber	= НомерДокумента;
			НовыйTransferDocDetails736.BaseDocumentDate		= ДатаДокумента;
			НовыйTransferDocDetails736.BaseDocumentName		= НаименованиеДокумента;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

