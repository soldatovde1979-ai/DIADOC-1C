Процедура Заполнить_AddressSARInfo(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "ID", Параметры.ИдНом);
	УстановитьЗначениеXDTO(Контент, "ZipCode", ПолучитьЗначениеXDTO(Параметры, "Индекс"));
	УстановитьЗначениеXDTO(Контент, "Region", Параметры.НаимРегион);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "КодРегион") Тогда
		УстановитьЗначениеXDTO(Контент, "RegionCode", Параметры.КодРегион);
	Иначе
		УстановитьЗначениеXDTO(Контент, "RegionCode", Параметры.Регион);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "МуниципРайон") Тогда
		УстановитьЗначениеXDTO(Контент, "MunicipalDistrict", Параметры.МуниципРайон.Наим);
		УстановитьЗначениеXDTO(Контент, "MunicipalDistrictCode", Параметры.МуниципРайон.ВидКод);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ГородСелПоселен") Тогда
		УстановитьЗначениеXDTO(Контент, "Settlement", Параметры.ГородСелПоселен.Наим);
		УстановитьЗначениеXDTO(Контент, "SettlementCode", Параметры.ГородСелПоселен.ВидКод);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НаселенПункт") Тогда
		УстановитьЗначениеXDTO(Контент, "Locality", Параметры.НаселенПункт.Наим);
		УстановитьЗначениеXDTO(Контент, "LocalityType", Параметры.НаселенПункт.Вид);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ЭлПланСтруктур") Тогда
		УстановитьЗначениеXDTO(Контент, "PlanningElement", Параметры.ЭлПланСтруктур.Наим);
		УстановитьЗначениеXDTO(Контент, "PlanningElementType", Параметры.ЭлПланСтруктур.Тип);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ЭлУлДорСети") Тогда
		УстановитьЗначениеXDTO(Контент, "StreetElement", Параметры.ЭлУлДорСети.Наим);
		УстановитьЗначениеXDTO(Контент, "StreetElementType", Параметры.ЭлУлДорСети.Тип);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "LandPlot", ПолучитьЗначениеXDTO(Параметры, "ЗемелУчасток"));
	
	Для Каждого СведенияОЗдании Из СписокXDTOИзЭлемента(Параметры, "Здание") Цикл
		
		BuildingInfo = НовыйЭлементСпискаXDTO(Контент.Buildings);
		
		УстановитьЗначениеXDTO(BuildingInfo, "Type", СведенияОЗдании.Тип);
		УстановитьЗначениеXDTO(BuildingInfo, "Number", СведенияОЗдании.Номер);
		
