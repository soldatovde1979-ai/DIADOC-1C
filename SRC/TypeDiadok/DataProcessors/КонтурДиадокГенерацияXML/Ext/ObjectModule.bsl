Процедура Заполнить_ProformaInvoice29Table(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ВсегоОпл") Тогда
		ВсегоОпл = Параметры.ВсегоОпл;
		
		УстановитьЗначениеXDTO(Контент, "TotalWithVatExcluded", ВсегоОпл.СтТовБезНДСВсего);
		УстановитьЗначениеXDTO(Контент, "Total", ВсегоОпл.СтТовУчНалВсего);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ВсегоОпл.СумНалВсего, "СумНал") Тогда
			УстановитьЗначениеXDTO(Контент, "Vat", ВсегоОпл.СумНалВсего.СумНал);
		Иначе
			УстановитьЗначениеXDTO(Контент, "WithoutVat", "true");
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "TotalDiscountSum", ПолучитьЗначениеXDTO(ВсегоОпл, "СумСкиВсего"));
	КонецЕсли;
	
	Для Каждого СведТовЦенПок Из СписокXDTOИзЭлемента(Параметры, "СведТовЦенПок") Цикл
		Заполнить_ProformaInvoice29Item(НовыйЭлементСпискаXDTO(Контент.Items), СведТовЦенПок);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_ProformaInvoice29Item(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Product", ПолучитьЗначениеXDTO(Параметры, "НаимТов"));
	УстановитьЗначениеXDTO(Контент, "Unit", ПолучитьЗначениеXDTO(Параметры, "ОКЕИ_Тов"));
	УстановитьЗначениеXDTO(Контент, "UnitName", ПолучитьЗначениеXDTO(Параметры, "НаимЕдИзм"));
	УстановитьЗначениеXDTO(Контент, "Quantity", ПолучитьЗначениеXDTO(Параметры, "КолТов"));
	УстановитьЗначениеXDTO(Контент, "Price", ПолучитьЗначениеXDTO(Параметры, "ЦенаТов"));
	УстановитьЗначениеXDTO(Контент, "PriceWithoutDiscount", ПолучитьЗначениеXDTO(Параметры, "ЦенаТовБезСки"));
	УстановитьЗначениеXDTO(Контент, "OtherTaxRate", ПолучитьЗначениеXDTO(Параметры, "НалСтИн"));
	УстановитьЗначениеXDTO(Контент, "DiscountSum", ПолучитьЗначениеXDTO(Параметры, "СумСки"));
	УстановитьЗначениеXDTO(Контент, "DiscountPercent", ПолучитьЗначениеXDTO(Параметры, "ПроцентСки"));
	УстановитьЗначениеXDTO(Контент, "SubtotalWithVatExcluded", ПолучитьЗначениеXDTO(Параметры, "СтТовБезНДС"));
	УстановитьЗначениеXDTO(Контент, "SubtotalWithoutVatAndDiscount", ПолучитьЗначениеXDTO(Параметры, "СтТовБезНДССки"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НалСт") Тогда
		УстановитьЗначениеXDTO(Контент, "TaxRate", TaxRate_Из_НалСт(Параметры.НалСт));
	КонецЕсли;
	
	БезНДС = Истина;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНал, "СумНал") Тогда
		УстановитьЗначениеXDTO(Контент, "Vat", Параметры.СумНал.СумНал);
		БезНДС = Ложь;
	КонецЕсли;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНалБезСки, "СумНал") Тогда
		УстановитьЗначениеXDTO(Контент, "VatWithoutDiscount", Параметры.СумНалБезСки.СумНал);
		БезНДС = Ложь;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "WithoutVat", ?(БезНДС, "true", "false"));
	
	УстановитьЗначениеXDTO(Контент, "Subtotal", ПолучитьЗначениеXDTO(Параметры, "СтТовУчНал"));
	УстановитьЗначениеXDTO(Контент, "SubtotalWithoutDiscount", ПолучитьЗначениеXDTO(Параметры, "СтТовУчНалБезСки"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСведТов") Тогда
		
		ДопСведТов = Параметры.ДопСведТов;
		
		ItemMark = ItemMark(ПолучитьЗначениеXDTO(ДопСведТов, "ПрТовРаб"));
		
		УстановитьЗначениеXDTO(Контент, "ItemMark", ItemMark);
		УстановитьЗначениеXDTO(Контент, "AdditionalProperty", ПолучитьЗначениеXDTO(ДопСведТов, "ДопПризн"));
		УстановитьЗначениеXDTO(Контент, "ItemVendorCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодТов"));
		УстановитьЗначениеXDTO(Контент, "Country", ПолучитьЗначениеXDTO(ДопСведТов, "КодПроисх"));
		УстановитьЗначениеXDTO(Контент, "ItemCharact", ПолучитьЗначениеXDTO(ДопСведТов, "ХарактерТов"));
		УстановитьЗначениеXDTO(Контент, "ItemArticle", ПолучитьЗначениеXDTO(ДопСведТов, "АртикулТов"));
		УстановитьЗначениеXDTO(Контент, "ItemKind", ПолучитьЗначениеXDTO(ДопСведТов, "СортТов"));
		УстановитьЗначениеXDTO(Контент, "ItemSeries", ПолучитьЗначениеXDTO(ДопСведТов, "СерияТов"));
		УстановитьЗначениеXDTO(Контент, "CatalogCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодКат"));
		УстановитьЗначениеXDTO(Контент, "ItemTypeCode", ПолучитьЗначениеXDTO(ДопСведТов, "КодВидТов"));
		
		Для Каждого СвГосСист Из СписокXDTOИзЭлемента(ДопСведТов, "СвГосСист") Цикл
			StateSystemItemInfo = НовыйЭлементСпискаXDTO(Контент.StateSystemItemInfos);
			Заполнить_StateSystemItemInfo(StateSystemItemInfo, СвГосСист);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ИнфПол Из СписокXDTOИзЭлемента(Параметры, "ИнфПол") Цикл
		AdditionalInfoId = НовыйЭлементСпискаXDTO(Контент.AdditionalInfoId);
		
		Заполнить_AdditionalInfoId(AdditionalInfoId, ИнфПол);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_StateSystemItemInfo(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "StateSystemName", Параметры.НаимГосСист);
	УстановитьЗначениеXDTO(Контент, "AccountingUnit", ПолучитьЗначениеXDTO(Параметры, "УчетЕд"));
	УстановитьЗначениеXDTO(Контент, "OtherInfo", ПолучитьЗначениеXDTO(Параметры, "ИнаяИнф"));
	
	Для Каждого ИдНомУчетЕд Из СписокXDTOИзЭлемента(Параметры, "ИдНомУчетЕд") Цикл
		Контент.StateSystemId.Добавить(ИдНомУчетЕд);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_InvoiceCorrectionItem(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Product", Параметры.НаимТов);
	
	Заполнить_InvoiceItemFields(Контент.OriginalValues	, Параметры, "OriginalValues");
	Заполнить_InvoiceItemFields(Контент.CorrectedValues	, Параметры, "CorrectedValues");
	
	Заполнить_AmountsDiff(Контент.AmountsInc, Параметры, "AmountsInc");
	Заполнить_AmountsDiff(Контент.AmountsDec, Параметры, "AmountsDec");
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолСтр");
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолФХЖ2");
	
КонецПроцедуры

Процедура Заполнить_ExtendedInvoiceCorrectionItem(Контент, Параметры)
	
	// Документация: http://diadocsdk-1c.readthedocs.io/ru/latest/ExtendedInvoiceCorrectionItem.html
	
	Заполнить_InvoiceCorrectionItem(Контент, Параметры);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ПорНомТовВСЧФ") Тогда
		УстановитьЗначениеXDTO(Контент, "OriginalNumber", Параметры.ПорНомТовВСЧФ);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСведТов") Тогда
		
		ДопСведТов = Параметры.ДопСведТов;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСведТов, "КорСчДебет") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemAccountDebit", ДопСведТов.КорСчДебет);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ДопСведТов, "КорСчКредит") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemAccountCredit", ДопСведТов.КорСчКредит);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "НаимЕдИзмДо") Тогда
			УстановитьЗначениеXDTO(Контент.OriginalValues, "UnitName", Параметры.ДопСведТов.НаимЕдИзмДо);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "НаимЕдИзмПосле") Тогда
			УстановитьЗначениеXDTO(Контент.CorrectedValues, "UnitName", Параметры.ДопСведТов.НаимЕдИзмПосле);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "АртикулТов") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemArticle", Параметры.ДопСведТов.АртикулТов);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "КодВидТов") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemTypeCode", Параметры.ДопСведТов.КодВидТов);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "КодТов") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemVendorCode", Параметры.ДопСведТов.КодТов);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "СортТов") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemKind", Параметры.ДопСведТов.СортТов);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "ХарактерТов") Тогда
			УстановитьЗначениеXDTO(Контент, "ItemCharact", Параметры.ДопСведТов.ХарактерТов);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НомСредИдентТовДо") Тогда
		Заполнить_ItemIdentificationNumbers(Контент.OriginalItemIdentificationNumbers,
											СписокXDTOИзЭлемента(Параметры, "НомСредИдентТовДо"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НомСредИдентТовПосле") Тогда
		Заполнить_ItemIdentificationNumbers(Контент.CorrectedItemIdentificationNumbers,
											СписокXDTOИзЭлемента(Параметры, "НомСредИдентТовПосле"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СведПрослеж") Тогда
		
		Для Каждого СведПрослеж Из СписокXDTOИзЭлемента(Параметры, "СведПрослеж") Цикл
			
			ItemTracingInfo = НовыйЭлементСпискаXDTO(Контент.ItemTracingInfos);
			
			УстановитьЗначениеXDTO(ItemTracingInfo, "ItemAddInfo", ПолучитьЗначениеXDTO(СведПрослеж, "ДопПрослеж"));
			УстановитьЗначениеXDTO(ItemTracingInfo, "RegNumberUnit", СведПрослеж.НомТовПрослеж);
			УстановитьЗначениеXDTO(ItemTracingInfo, "Unit", СведПрослеж.ЕдИзмПрослеж);
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СведПрослеж, "ИзмКолЕдПТ") Тогда
				УстановитьЗначениеXDTO(ItemTracingInfo.QuantityDiff, "OriginalQuantity", СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТДо);
				УстановитьЗначениеXDTO(ItemTracingInfo.QuantityDiff, "CorrectedQuantity", СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТПосле);
				
				Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СведПрослеж.ИзмКолЕдПТ, "КолТовЕдПТУвел") Тогда
					УстановитьЗначениеXDTO(ItemTracingInfo.QuantityDiff, "QuantityInc", СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТУвел);
				Иначе
					УстановитьЗначениеXDTO(ItemTracingInfo.QuantityDiff, "QuantityDec", СведПрослеж.ИзмКолЕдПТ.КолТовЕдПТУм);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_InvoiceCorrectionTable(Контент, Параметры)
	
	Для Каждого СведТов Из СписокXDTOИзЭлемента(Параметры, "СведТов") Цикл
		Заполнить_ExtendedInvoiceCorrectionItem(НовыйЭлементСпискаXDTO(Контент.Items), СведТов);
	КонецЦикла;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ВсегоУвел") Тогда
		Заполнить_InvoiceTotalsDiff(Контент.TotalsInc, Параметры.ВсегоУвел);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ВсегоУм") Тогда
		Заполнить_InvoiceTotalsDiff(Контент.TotalsDec, Параметры.ВсегоУм);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_InvoiceItem(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Product"				, Параметры.НаимТов);
	УстановитьЗначениеXDTO(Контент, "UnitCode"				, ПолучитьЗначениеXDTO(Параметры, "ОКЕИ_Тов"));
	УстановитьЗначениеXDTO(Контент, "Quantity"				, ПолучитьЗначениеXDTO(Параметры, "КолТов"));
	УстановитьЗначениеXDTO(Контент, "Price"					, ПолучитьЗначениеXDTO(Параметры, "ЦенаТов"));
	УстановитьЗначениеXDTO(Контент, "TaxRate"				, TaxRate_Из_НалСт(Параметры.НалСт));
	УстановитьЗначениеXDTO(Контент, "TotalWithVatExcluded"	, ПолучитьЗначениеXDTO(Параметры, "СтТовБезНДС"));
	УстановитьЗначениеXDTO(Контент, "Total"					, Параметры.СтТовУчНал);
	УстановитьЗначениеXDTO(Контент, "Excise"				, Акциз_Из_XML(Параметры.Акциз));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНал") Тогда
		УстановитьЗначениеXDTO(Контент, "Vat", СуммаНДС_Из_XML(Параметры.СумНал));
	КонецЕсли;
	
	Заполнить_InvoiceItem_CustomsDeclarationNumbers(Контент, Параметры);
	
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолСтр");
	Заполнить_СписокKeyValue(Контент.StructedAdditionalInfos, Параметры, "ИнфПолФХЖ2");
	
КонецПроцедуры

Процедура Заполнить_InvoiceItem_CustomsDeclarationNumbers(Контент, Параметры)
	
	КодПроисх	 = "";
	НомераГТД	 = "";
	Разделитель	 = "";
	
	Для Каждого СвТД Из СписокXDTOИзЭлемента(Параметры, "СвТД") Цикл
		
		КодПроисх	 = СвТД.КодПроисх;
		НомераГТД	 = НомераГТД + Разделитель + СвТД.НомерТД;
		Разделитель	 = ",";
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КодПроисх) Тогда
		УстановитьЗначениеXDTO(Контент, "CountriesOfOrigin", КодПроисх);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомераГТД) Тогда
		УстановитьЗначениеXDTO(Контент, "CustomsDeclarationNumbers", НомераГТД);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_InvoiceItemFields(Контент, Параметры, ИмяКонтента)
	
	InvoiceItemFields = Новый Структура;
	
	Если ИмяКонтента = "OriginalValues" Тогда
		
		InvoiceItemFields.Вставить("UnitCode", ПолучитьЗначениеXDTO(Параметры, "ОКЕИ_ТовДо"));
		InvoiceItemFields.Вставить("Quantity", ПолучитьЗначениеXDTO(Параметры, "КолТовДо"));
		InvoiceItemFields.Вставить("Price", ПолучитьЗначениеXDTO(Параметры, "ЦенаТовДо"));
		InvoiceItemFields.Вставить("TaxRate", TaxRate_Из_НалСт(Параметры.НалСтДо));
		InvoiceItemFields.Вставить("Excise", Акциз_Из_XML(Параметры.АкцизДо));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовБезНДС") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СтТовБезНДС, "СтоимДоИзм") Тогда
				
				InvoiceItemFields.Вставить("TotalWithVatExcluded", Параметры.СтТовБезНДС.СтоимДоИзм);
				
			Иначе
				
				InvoiceItemFields.Вставить("TotalWithVatExcluded", 0);
				
			КонецЕсли;
				
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСведТов") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "НаимЕдИзмДо") Тогда
				InvoiceItemFields.Вставить("UnitName", Параметры.ДопСведТов.НаимЕдИзмДо);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНалДо") Тогда
			InvoiceItemFields.Вставить("Vat", СуммаНДС_Из_XML(Параметры.СумНалДо));
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНалДо, "БезНДС") Тогда
				InvoiceItemFields.Вставить("WithoutVat", "true");
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовУчНал") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СтТовУчНал, "СтоимДоИзм") Тогда
				InvoiceItemFields.Вставить("Total", Параметры.СтТовУчНал.СтоимДоИзм);
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		InvoiceItemFields.Вставить("UnitCode", ПолучитьЗначениеXDTO(Параметры, "ОКЕИ_ТовПосле"));
		InvoiceItemFields.Вставить("Quantity", ПолучитьЗначениеXDTO(Параметры, "КолТовПосле"));
		InvoiceItemFields.Вставить("Price", ПолучитьЗначениеXDTO(Параметры, "ЦенаТовПосле"));
		InvoiceItemFields.Вставить("TaxRate", TaxRate_Из_НалСт(Параметры.НалСтПосле));
		InvoiceItemFields.Вставить("Excise", Акциз_Из_XML(Параметры.АкцизПосле));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовБезНДС") Тогда
			InvoiceItemFields.Вставить("TotalWithVatExcluded", Параметры.СтТовБезНДС.СтоимПослеИзм);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДопСведТов") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ДопСведТов, "НаимЕдИзмПосле") Тогда
				InvoiceItemFields.Вставить("UnitName", Параметры.ДопСведТов.НаимЕдИзмПосле);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СумНалПосле") Тогда
			InvoiceItemFields.Вставить("Vat", СуммаНДС_Из_XML(Параметры.СумНалПосле));
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СумНалПосле, "БезНДС") Тогда
				InvoiceItemFields.Вставить("WithoutVat", "true");
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СтТовУчНал") Тогда
			
			Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.СтТовУчНал, "СтоимПослеИзм") Тогда
				InvoiceItemFields.Вставить("Total", Параметры.СтТовУчНал.СтоимПослеИзм);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого КлючЗначение Из InvoiceItemFields Цикл
		УстановитьЗначениеXDTO(Контент, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

