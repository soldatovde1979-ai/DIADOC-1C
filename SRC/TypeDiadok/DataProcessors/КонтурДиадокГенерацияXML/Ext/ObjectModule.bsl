Функция КодыРегионов() Экспорт
	
	Результат = Кэш_Прочитать("КодыРегионов");
	
	Если Результат = Неопределено Тогда
		
		Результат = Новый Соответствие;
		
		// Сериализуем через произвольный ОбъектXDTO для совместимости с 8.1
		ОбъектXDTO = XML_В_XDTO(ПолучитьМакет("КодыРегионов").ПолучитьТекст());
		
		Для Каждого СтрокаXDTO Из ОбъектXDTO.pair Цикл
			Результат.Вставить(СтрокаXDTO.Key, СтрокаXDTO.Value);
		КонецЦикла;
		
		Кэш_Поместить("КодыРегионов", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОКВ() Экспорт
	
	Результат = Кэш_Прочитать("ОКВ");
	
	Если Результат = Неопределено Тогда
		
		Результат = Новый ТаблицаЗначений;
		
		// Сериализуем через произвольный ОбъектXDTO для совместимости с 8.1
		ОбъектXDTO = XML_В_XDTO(ПолучитьМакет("ОКВ").ПолучитьТекст());
		
		МассивКолонок = РазложитьСтрокуВМассивСлов(ОбъектXDTO.Columns);
		Для Каждого ИмяКолонки Из МассивКолонок Цикл
			
			Если ИмяКолонки = "RBCLoading" Тогда
				ТипКолонки = Новый ОписаниеТипов("Булево");
			Иначе
				ТипКолонки = Новый ОписаниеТипов("Строка");
			КонецЕсли;
			
			Результат.Колонки.Добавить(ИмяКолонки, ТипКолонки);
			
		КонецЦикла;
		
		Для Каждого СтрокаXDTO Из ОбъектXDTO.Item Цикл
			
			НоваяСтрока = Результат.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаXDTO, , "RBCLoading");
			
			НоваяСтрока.RBCLoading = НРег(СтрокаXDTO.RBCLoading) = "истина";
			
		КонецЦикла;
		
		Результат.Колонки.Code.Имя					= "Код";
		Результат.Колонки.CodeSymbol.Имя			= "КодСимвольный";
		Результат.Колонки.Name.Имя					= "Наименование";
		Результат.Колонки.Description.Имя			= "Описание";
		Результат.Колонки.RBCLoading.Имя			= "ЗагрузкаИзИнтернета";
		Результат.Колонки.NumerationItemOptions.Имя = "ПараметрыИсчисления";
		
		Результат.Индексы.Добавить("Код");
		
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "КодСимвольный");
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "Наименование");
		
		Кэш_Поместить("ОКВ", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОКСМ() Экспорт
	
	Результат = Кэш_Прочитать("ОКСМ");
	
	Если Результат = Неопределено Тогда
		
		// Сериализуем через произвольный ОбъектXDTO для совместимости с 8.1
		Результат = XDTO_В_Таблицу(XML_В_XDTO(ПолучитьМакет("ОКСМ").ПолучитьТекст()));
		
		Результат.Колонки.Наименование.Имя = "НаименованиеКраткое";
		
		ДобавитьСтрокуВ_ОКСМ(Результат, "Евросоюз",			"", "", "980", "Европейский союз");
		ДобавитьСтрокуВ_ОКСМ(Результат, "ЕС",				"", "", "980", "Европейский союз");
		ДобавитьСтрокуВ_ОКСМ(Результат, "Европейский союз",	"", "", "980", "Европейский союз");
		ДобавитьСтрокуВ_ОКСМ(Результат, "ЕАЭС",				"", "", "981", "Евразийский экономический союз");
		
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "НаименованиеКраткое");
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "НаименованиеПолное");
		
		Кэш_Поместить("ОКСМ", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОКЕИ() Экспорт
	
	Результат = Кэш_Прочитать("ОКЕИ");
	
	Если Результат = Неопределено Тогда
		
		// Сериализуем через произвольный ОбъектXDTO для совместимости с 8.1
		Дерево = XDTO_В_Дерево(XML_В_XDTO(ПолучитьМакет("ОКЕИ").ПолучитьТекст()));
		Дерево.Строки.Удалить(Дерево.Строки.Найти("Международные единицы измерения, не включенные в ОКЕИ"));
		
		Результат = Дерево_В_Таблицу(Дерево, Ложь);
		Дерево = Неопределено;
		
		Результат.Колонки.КодЧисловой.Имя					  = "Код";
		Результат.Колонки.Наименование.Имя					  = "НаименованиеПолное";
		Результат.Колонки.УсловноеОбозначениеНациональное.Имя = "НаименованиеКраткое";
		
		Для каждого СтрокаТЗ Из Результат Цикл
			СтрокаТЗ.НаименованиеПолное	 = СтрЗаменить(СтрокаТЗ.НаименованиеПолное , Символы.ПС, "/");
			СтрокаТЗ.НаименованиеКраткое = СтрЗаменить(СтрокаТЗ.НаименованиеКраткое, Символы.ПС, "/");
		КонецЦикла;
		
		Результат.Индексы.Добавить("Код");
		
		ДополнитьТаблицуОКЕИ(Результат);
		
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "НаименованиеКраткое");
		ДобавитьСтроковыйИндексВТаблицуЗначений(Результат, "НаименованиеПолное");
		
		Кэш_Поместить("ОКЕИ", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает наименование единицы измерения по коду.
//
// Параметры:
//	 КодОКЕИ			- Строка - Код единицы измерения.
//	 ПолноеНаименование - Булево - (необязательное) Признак того, что нужно вернуть полное наименование.
//
// Возвращаемое значение:
//	 Строка	- Наименование единицы измерения, пример:
//   	шт	  - Краткое Наименование
//		Штука - Полное наименование
//
Функция НаименованиеЕдиницыИзмерения(КодОКЕИ, ПолноеНаименование = Ложь) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(КодОКЕИ) Тогда
		
		СтрокаОКЕИ = ПолучитьОКЕИ().Найти(СокрЛП(КодОКЕИ), "Код");
		
		Если СтрокаОКЕИ <> Неопределено Тогда
			
			Если ПолноеНаименование = Истина Тогда
				Результат = СтрокаОКЕИ.НаименованиеПолное;
			Иначе
				Результат = СтрокаОКЕИ.НаименованиеКраткое;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции		

// Возвращает строки таблицы значения ОКЕИ подходящие по краткому или полному наименованию.
//
// Параметры:
//	 МассивСтрока - Строка, Массив - Краткое или полное наименование единицы измерения или массив таких строк.
//
// Возвращаемое значение:
//	 Массив	- Массив строк таблицы значений ОКЕИ
//
Функция ПодходящиеЕдиницыИзмерения(МассивСтрока) Экспорт
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(МассивСтрока) Тогда
		
		Если ТипЗнч(МассивСтрока) = Тип("Массив") Тогда
			МассивЗначений = МассивСтрока;
		Иначе
			МассивЗначений = Новый Массив;
			МассивЗначений.Добавить(МассивСтрока);
		КонецЕсли;
		
		Результат = СтрокиКлассификатораПоМассивуЗначений(ПолучитьОКЕИ(), МассивЗначений);
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции		

// Код единицы измерения по Общероссийскому классификатору единиц измерения 
// или "0000" (при отсутствии необходимой единицы измерения в ОКЕИ)
//
// Параметры:
//  КодЕдиницыИзмерения	 - Строка - Код единицы измерения.
//
// Возвращаемое значение:
//  Строка - Приведенный код единицы измерения к формату ФНС
//
Функция XML_КодЕдиницыИзмерения(КодЕдиницыИзмерения) Экспорт
	
	Результат = ?(ПолучитьОКЕИ().Найти(КодЕдиницыИзмерения, "Код") = Неопределено, "0000", КодЕдиницыИзмерения);
	Возврат Результат;
	
КонецФункции

// Возвращает наименование страны по коду.
//
// Параметры:
//	 КодСтраны		    - Строка - Код страны.
//	 ПолноеНаименование - Булево - (необязательное) Признак того, что нужно вернуть полное наименование.
//
// Возвращаемое значение:
//	 Строка	- Наименование страны, пример:
//   	РОССИЯ				 - Краткое Наименование
//		Российская Федерация - Полное наименование
//
Функция НаименованиеСтраны(КодСтраны, ПолноеНаименование = Ложь) Экспорт
	
	Результат = "";
	
	СтрокаОКСМ = ПолучитьОКСМ().Найти(КодСтраны, "Код");
	
	Если СтрокаОКСМ <> Неопределено Тогда
		
		Если ПолноеНаименование = Истина Тогда
			Результат = СтрокаОКСМ.НаименованиеПолное;
		Иначе
			Результат = СтрокаОКСМ.НаименованиеКраткое;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает код страны по краткому или полному наименованию.
//
// Параметры:
//	 НаименованиеСтраны - Строка - Краткое или полное наименование страны.
//
// Возвращаемое значение:
//	 Строка	- Код страны
//
Функция КодСтраны(НаименованиеСтраны) Экспорт
	
	Результат = "";
	
	ЗначениеИндекса = ВРег(СтрЗаменить(СтрЗаменить(НаименованиеСтраны, " ", ""), ".", ""));
	
	СтрокаОКСМ = ПолучитьОКСМ().Найти(ЗначениеИндекса, "Индекс_НаименованиеКраткое");
	
	Если СтрокаОКСМ = Неопределено Тогда
		СтрокаОКСМ = ПолучитьОКСМ().Найти(ЗначениеИндекса, "Индекс_НаименованиеПолное");
	КонецЕсли;
	
	Если СтрокаОКСМ <> Неопределено Тогда
		Результат = СтрокаОКСМ.Код;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строки таблицы значения ОКСМ подходящие по краткому или полному наименованию.
//
// Параметры:
//	 МассивСтрока - Строка, Массив - Краткое или полное наименование страны или массив таких строк.
//
// Возвращаемое значение:
//	 Массив	- Массив строк таблицы значений ОКСМ
//
Функция ПодходящиеСтраны(МассивСтрока) Экспорт
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(МассивСтрока) Тогда
		
		Если ТипЗнч(МассивСтрока) = Тип("Массив") Тогда
			МассивЗначений = МассивСтрока;
		Иначе
			МассивЗначений = Новый Массив;
			МассивЗначений.Добавить(МассивСтрока);
		КонецЕсли;
		
		Результат = СтрокиКлассификатораПоМассивуЗначений(ПолучитьОКСМ(), МассивЗначений);
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции		

