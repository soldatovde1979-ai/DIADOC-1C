	УстановитьЗначениеXDTO(Файл, "ИдФайл", ИдФайла);
	УстановитьЗначениеXDTO(Файл, "ВерсФорм", "5.01");
	УстановитьЗначениеXDTO(Файл, "ВерсПрог", "Diadoc 1.0");
	
