Функция УПД820_КонвертироватьСведенияОПередачеТоваров_в970(TransferInfo820, ОшибкиКонвертации)
	
	Перем Результат;
	
	Если TransferInfo820 = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НовыйProtoОбъектXDTO("TransferInfo970");
	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат, TransferInfo820);
	
	Если Не ЗначениеЗаполнено(Результат.TransferDate) Тогда
		ДатаОтгрузки = УПД820_ДатаОтгрузки(TransferInfo820);
		УстановитьЗначениеXDTO(Результат, "TransferDate", ДатаОтгрузки);
	КонецЕсли;
	
	Employee = УПД820_КонвертироватьСведенияОСотруднике_в970(TransferInfo820.Employee, ОшибкиКонвертации);
	УстановитьЗначениеXDTO(Результат, "Employee", Employee);

	OtherIssuer = УПД820_КонвертироватьСведенияОРаботникеИнойОрганизации_в970(
		TransferInfo820.OtherIssuer,
		ОшибкиКонвертации);
	УстановитьЗначениеXDTO(Результат, "OtherIssuer", OtherIssuer);

	AdditionalInfoId = УПД820_КонвертироватьИнформационныеПоляФХЖ_в970(TransferInfo820.AdditionalInfoId);
	УстановитьЗначениеXDTO(Результат, "AdditionalInfoId", AdditionalInfoId);
	
	Для Каждого TransferBase820 Из TransferInfo820.TransferBases Цикл
		
		Если TransferBase820.DocumentName = БезДокументаОснования() Тогда
			Результат.WithoutTransferBase = Истина;
			Прервать;
		Иначе
			TransferBase = УПД820_КонвертироватьРеквизитыОснованияОтгрузки_в970(TransferBase820);
			Результат.TransferBases.Добавить(TransferBase);
		КонецЕсли;
			
	КонецЦикла;

	УПД820_КонвертироватьСведенияОТранспортныхНакладных_в970(TransferInfo820, Результат);
	
	ЕстьСведенияОПеревозчике = (TransferInfo820.Carrier <> Неопределено
		И ЗначениеЗаполнено(TransferInfo820.Carrier.Type)
		И ЗначениеЗаполнено(TransferInfo820.Carrier.Name));
		
	Если ЕстьСведенияОПеревозчике Тогда
		УПД820_ДобавитьОшибкуКонвертацииСведенийОПеревозчике(ОшибкиКонвертации);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция УПД820_КонвертироватьСведенияОСотруднике_в970(Employee820, ОшибкиКонвертации)

	Перем Результат;
	
	Если Employee820 <> Неопределено Тогда
		
		Результат = НовыйProtoОбъектXDTO("Employee970");
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат, Employee820);
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция УПД820_КонвертироватьСведенияОРаботникеИнойОрганизации_в970(OtherIssuer820, ОшибкиКонвертации)

	Перем Результат;
	
	Если OtherIssuer820 <> Неопределено Тогда
		
		Результат = НовыйProtoОбъектXDTO("OtherIssuer970");
		
		ИсключаемыеСвойства = Новый Массив;
		ИсключаемыеСвойства.Добавить("EmployeeBase");
		ИсключаемыеСвойства.Добавить("OrganizationBase");

		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Результат, OtherIssuer820, ИсключаемыеСвойства);
		
		Если ЗначениеЗаполнено(OtherIssuer820.EmployeeBase) Тогда
			УПД820_ДобавитьОшибкуКонвертацииОснованияПолномочийПредставителяИнойОрганизации(ОшибкиКонвертации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(OtherIssuer820.OrganizationBase) Тогда
			Если ЗначениеЗаполнено(OtherIssuer820.EmployeePosition) Тогда
				УПД820_ДобавитьОшибкуКонвертацииОснованияПолномочийИнойОрганизации(ОшибкиКонвертации);
			Иначе
				УПД820_ДобавитьОшибкуКонвертацииОснованияПолномочийФизЛица(ОшибкиКонвертации);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

