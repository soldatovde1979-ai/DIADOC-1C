		УстановитьЗначениеXDTO(Контент, "EmployeeInfo", ИныеСведения);
		УстановитьЗначениеXDTO(Контент, "OrganizationName", ПредОргПрин.НаимОргПрин);
		УстановитьЗначениеXDTO(Контент, "Inn", ИНН);
		
		Заполнить_ФИО(Контент, ПредОргПрин.ФИО);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(ПредОргПрин, "ОснДоверОргПрин") Тогда
			Заполнить_DocumentDetails(Контент.OrganizationBase, ПредОргПрин.ОснДоверОргПрин);	
