Функция УПД970_КонвертироватьСтавкиНДС(Знач Контент970, СписокПредупреждений) Экспорт
	
	Table970 = Контент970.Table;
	
	Если Table970 = Неопределено Тогда
		Возврат Контент970;
	КонецЕсли;
	
	ЭтоСчетФактураНаАванс = (Контент970.Function = Перечисление_ФункцииУПД().СЧФ
		И Контент970.CircumFormatInvoice = "2");
	
	TaxRate = TaxRate_22();
	Если ЭтоСчетФактураНаАванс Тогда
		TaxRate = TaxRate_22_122();
	КонецЕсли;
	
	ПредупрежденияКонвертации = Новый Массив;
	НомерСтрокиTable970 = 1;
	
	Для Каждого Item970 Из Table970.Items Цикл
		
		Если НЕ ЭтоВалиднаяСтавкаНДС(Item970.TaxRate) Тогда
			
			Item970.TaxRate = TaxRate;
			ДобавитьПредупреждениеКонвертацииСтавкиНДС(ПредупрежденияКонвертации, НомерСтрокиTable970);
			
		КонецЕсли;
		
		НомерСтрокиTable970 = НомерСтрокиTable970 + 1;
		
	КонецЦикла;
	
	Если ПредупрежденияКонвертации.Количество() > 0 Тогда
		
		ДобавитьШапкуПредупрежденияКонвертацииTaxRate(СписокПредупреждений);
		
		Для Каждого Элемент Из ПредупрежденияКонвертации Цикл
			СписокПредупреждений.Добавить(Элемент);
		КонецЦикла;
		
		ДобавитьПодвалПредупрежденияКонвертацииTaxRate(СписокПредупреждений);
		
	КонецЕсли;
	
	Возврат Контент970;
	
КонецФункции

