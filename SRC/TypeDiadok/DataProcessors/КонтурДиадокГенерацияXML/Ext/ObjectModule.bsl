Процедура Заполнить_Employee_Torg2(Контент, Параметры)
	
	УстановитьЗначениеXDTO(Контент, "Position", Параметры.Должность);
	УстановитьЗначениеXDTO(Контент, "EmployeeInfo", ПолучитьЗначениеXDTO(Параметры, "ИныеСвед"));
	УстановитьЗначениеXDTO(Контент, "EmployeeBase", Параметры.ОснПолн);
	УстановитьЗначениеXDTO(Контент, "LastName", Параметры.ФИО.Фамилия);
	УстановитьЗначениеXDTO(Контент, "FirstName", Параметры.ФИО.Имя);
