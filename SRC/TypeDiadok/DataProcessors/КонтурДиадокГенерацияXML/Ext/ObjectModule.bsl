			Content.СлужебнаяИнформация.Ссылка);
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияТорг2(Content) Экспорт 
	
	СписокОшибок = Новый Массив;
	
	// Дата и номер документа о приемке и (или) расхождениях
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentNumber, "Номер документа о приемке и (или) расхождениях", Истина, 1, 255);
	ПроверитьФорматДаты(СписокОшибок, Content.DocumentDate, "Дата составления (выписки) документа о приемке и (или) расхождениях", Истина);
	
	// Исправление документа о приемке и (или) расхождениях
	Если СтруктураЗаполнена(Content.RevisionInfo) Тогда
		ПроверитьФорматПоля(СписокОшибок, Content.RevisionInfo.RevisionNumber, "Номер исправления документа", Истина, 1, 3, Истина);
		ПроверитьФорматДаты(СписокОшибок, Content.RevisionInfo.RevisionDate, "Дата исправления документа", Истина);
	КонецЕсли;
	
	// Наименование документа, определенное организацией (согласованное сторонами сделки)
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentName, "Наименование документа, определенное организацией (согласованное сторонами сделки)", Истина, 1, 255, , "с");
	
	// Сведения об обстоятельствах приемки
	Ошибки = ВалидацияТорг2_СведенияОбОбстоятельствахПриемки(Content.CircumstancesAcceptanceInfo);
	ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях об обстоятельствах приемки");
	
	// Сведения о факте приемки и (или) о расхождениях
	Ошибки = ВалидацияТорг2_СведенияОФактеПриемки(Content.EvidenceAcceptanceInfo);
	ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о факте приемки и (или) о расхождениях");
	
	ПроверитьФорматПоля(СписокОшибок, Content.SenderFnsParticipantId, "Идентификатор участника ЭДО (отправителя файла обмена информации покупателя)", , 4, 46);
	ПроверитьФорматПоля(СписокОшибок, Content.RecipientFnsParticipantId, "Идентификатор участника ЭДО (получателя файла обмена информации покупателя)", , 4, 46);
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentCreator, "Наименование экономического субъекта - составителя файла обмена информации покупателя", Истина, 1, 1000, , "с");
	ПроверитьФорматПоля(СписокОшибок, Content.DocumentCreatorBase, "Основание, по которому экономический субъект является составителем файла обмена информации покупателя", , 1, 120, , "с");
	ПроверитьФорматПоля(СписокОшибок, Content.AdditionalInfosPurpose, "Назначение и подписанты дополнительных сведений", , 1, 2000, , "с");
	ПроверитьФорматПоля(СписокОшибок, Content.IsInformed, " Признак ознакомления с правилами приемки и предупреждением об ответственности", , 1, 1);
	
	Возврат СписокОшибок;
	
КонецФункции

Функция ВалидацияТорг2_СведенияОбОбстоятельствахПриемки(CircumstancesAcceptanceInfo)
	
	СписокОшибок = Новый Массив;
	
	// Продавец (поставщик, исполнитель)
	Ошибки = ВалидацияТорг2_Участник(CircumstancesAcceptanceInfo.Seller);
	ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о <продавце (поставщике, исполнителе)>");
	
	// Покупатель (заказчик)
	Ошибки = ВалидацияТорг2_Участник(CircumstancesAcceptanceInfo.Buyer);
	ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о <покупателе (заказчике)>");
	
	// Грузоотправитель (отправитель)
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.Shipper) Тогда
		Ошибки = ВалидацияТорг2_Участник(CircumstancesAcceptanceInfo.Shipper);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о <грузоотправителе (отправителе)>");
	КонецЕсли;
	
	// Грузополучатель (получатель)
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.Consignee) Тогда
		Ошибки = ВалидацияТорг2_Участник(CircumstancesAcceptanceInfo.Consignee);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о <грузополучателе (получателе)>");
	КонецЕсли;
	
	// Страховая компания
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.InsuranceCompany) Тогда
		Ошибки = ВалидацияТорг2_Участник(CircumstancesAcceptanceInfo.InsuranceCompany);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о <страховой компании>");
	КонецЕсли;
	
	// Дата и номер приказа (распоряжения) о назначении комиссии
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.Order) Тогда
		Order = CircumstancesAcceptanceInfo.Order;
		ПроверитьФорматПоля(СписокОшибок, Order.Number, "Номер приказа (распоряжения)", Истина, 1, 255);
		ПроверитьФорматДаты(СписокОшибок, Order.Date, "Дата приказа (распоряжения)", Истина);
	КонецЕсли;
	
	// Сведения о событиях, связанных с осмотром груза
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.CargoInspectionInformation) Тогда
		Ошибки = ВалидацияТорг2_СведенияОРезультатахОсмотра(CircumstancesAcceptanceInfo.CargoInspectionInformation);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о событиях, связанных с осмотром груза");
	КонецЕсли;
	
	// Сведения о дате и времени событий, связанных с приемкой груза
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.ReceptionInformation) Тогда
		Ошибки = ВалидацияТорг2_СведенияОДатеИВремениПриемки(CircumstancesAcceptanceInfo.ReceptionInformation);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о дате и времени событий, связанных с приемкой груза");
	КонецЕсли;
	
	// Сведения о грузе по сопроводительным транспортным документам
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.AccompanyingDocumentTable) Тогда
		Ошибки = ВалидацияТорг2_СведенияОГрузе(CircumstancesAcceptanceInfo.AccompanyingDocumentTable);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о грузе по сопроводительным транспортным документам");
	КонецЕсли;
	
	// Сведения о лице, принявшем товар (получившем груз) (в том числе на ответственное хранение)
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.PersonAcceptedCargoInfo) Тогда
		Ошибки = ВалидацияТорг2_СведенияОЛицеПринявшемТовар(CircumstancesAcceptanceInfo.PersonAcceptedCargoInfo);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в сведениях о лице, принявшем товар (получившем груз) (в том числе на ответственное хранение)");
	КонецЕсли;
	
	// Другие обстоятельства приемки ценностей
	Если СтруктураЗаполнена(CircumstancesAcceptanceInfo.OtherCircumstancesAcceptanceInfo) Тогда
		Ошибки = ВалидацияТорг2_ДругиеОбстоятельстваПриемки(CircumstancesAcceptanceInfo.OtherCircumstancesAcceptanceInfo);
		ДобавитьГруппуОшибокВалидации(СписокОшибок, Ошибки, "Ошибки в других обстоятельства приемки ценностей");
	КонецЕсли;
	
	// Обозначение (код) обстоятельств формирования (использования) документа
	Если ЗначениеЗаполнено(CircumstancesAcceptanceInfo.CircumFormat) Тогда
		ПроверитьФорматПоля(СписокОшибок, CircumstancesAcceptanceInfo.CircumFormat, "Обозначение (код) обстоятельств формирования (использования) документа", , , 4);
	КонецЕсли;
	
	// Идентификатор государственного контракта
	Если ЗначениеЗаполнено(CircumstancesAcceptanceInfo.GovernmentContractInfo) Тогда
		ПроверитьФорматПоля(СписокОшибок, CircumstancesAcceptanceInfo.GovernmentContractInfo, "Идентификатор государственного контракта", , 1, 255);
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

