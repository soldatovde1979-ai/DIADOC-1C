Процедура Заполнить_DocumentDetails(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Name", ПолучитьЗначениеXDTO(Параметры, "РеквНаимДок"));
	УстановитьЗначениеXDTO(Контент, "Number", ПолучитьЗначениеXDTO(Параметры, "РеквНомерДок"));
	УстановитьЗначениеXDTO(Контент, "Date", ДатаXML_в_Дата1С(ПолучитьЗначениеXDTO(Параметры, "РеквДатаДок")));
	УстановитьЗначениеXDTO(Контент, "FileID", ПолучитьЗначениеXDTO(Параметры, "РеквИдФайлДок"));
	УстановитьЗначениеXDTO(Контент, "ID", ПолучитьЗначениеXDTO(Параметры, "РеквИдДок"));
	УстановитьЗначениеXDTO(Контент, "StorageID", ПолучитьЗначениеXDTO(Параметры, "РИдСистХранД"));
	УстановитьЗначениеXDTO(Контент, "URL", ПолучитьЗначениеXDTO(Параметры, "РеквУРЛСистДок"));
	УстановитьЗначениеXDTO(Контент, "AdditionalInfo", ПолучитьЗначениеXDTO(Параметры, "РеквДопСведДок"));
	
	Для Каждого РеквИдРекСост Из СписокXDTOИзЭлемента(Параметры, "РеквИдРекСост") Цикл
		EconomicEntity = НовыйЭлементСпискаXDTO(Контент.EconomicEntities);
		Заполнить_EconomicEntities(EconomicEntity, РеквИдРекСост);
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_EconomicEntities(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВидыЮрФизЛиц = Перечисление_ВидыЮрФизЛиц();
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИННЮЛ") Тогда
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидыЮрФизЛиц.ЮридическоеЛицо);
		УстановитьЗначениеXDTO(Контент, "Inn", Параметры.ИННЮЛ);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИННФЛ") Тогда
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидыЮрФизЛиц.ФизическоеЛицо);
		УстановитьЗначениеXDTO(Контент, "Inn", Параметры.ИННФЛ);
		
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДаннИно") Тогда
		
		ДаннИно = Параметры.ДаннИно;
		
		Если ДаннИно.ИдСтат = "ИО" Тогда
			ВидЮрФизЛица = ВидыЮрФизЛиц.ИностраннаяОрганизация;
		Иначе
			ВидЮрФизЛица = ВидыЮрФизЛиц.ИностранныйГражданин;
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидЮрФизЛица);
		
		УстановитьЗначениеXDTO(Контент, "Name", ДаннИно.Наим);
		УстановитьЗначениеXDTO(Контент, "OtherInfo", ПолучитьЗначениеXDTO(ДаннИно, "ИныеСвед"));
		УстановитьЗначениеXDTO(Контент, "LegalEntityId", ПолучитьЗначениеXDTO(ДаннИно, "Идентиф"));
		УстановитьЗначениеXDTO(Контент, "Country", ДаннИно.НаимСтран);
		УстановитьЗначениеXDTO(Контент, "CountryCode", ДаннИно.КодСтр);
			
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "НаимОИВ") Тогда
		
		УстановитьЗначениеXDTO(Контент, "Type", ВидыЮрФизЛиц.ОрганИсполнительнойВласти);
		УстановитьЗначениеXDTO(Контент, "Name", Параметры.НаимОИВ);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура Заполнить_AccompanyingDocumentTable(Контент, Параметры)
	
	Для Каждого СвСопрДок Из Параметры Цикл
		
		Item = НовыйЭлементСпискаXDTO(Контент.Item);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСопрДок, "МассаДок") Тогда
			Заполнить_WeightCargo(Item.DocumentWeight, СвСопрДок.МассаДок);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСопрДок, "МассаФакт") Тогда
			Заполнить_WeightCargo(Item.FactWeight, СвСопрДок.МассаФакт);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(СвСопрДок, "ИнфПолСопрДок") Тогда
			УстановитьЗначениеXDTO(Item.AdditionalInfo, "Id", СвСопрДок.ИнфПолСопрДок.Идентиф);
			УстановитьЗначениеXDTO(Item.AdditionalInfo, "Value", СвСопрДок.ИнфПолСопрДок.Значен);
		КонецЕсли;
		
		УстановитьЗначениеXDTO(Item, "SealingMark", ПолучитьЗначениеXDTO(СвСопрДок, "ОтмПломб"));
		УстановитьЗначениеXDTO(Item, "PackingType", ПолучитьЗначениеXDTO(СвСопрДок, "ВидУпак"));
		УстановитьЗначениеXDTO(Item, "Quantity", ПолучитьЗначениеXDTO(СвСопрДок, "КолМест"));
		УстановитьЗначениеXDTO(Item, "CargoName", СвСопрДок.НаимГруз);
		УстановитьЗначениеXDTO(Item, "Unit", ПолучитьЗначениеXDTO(СвСопрДок, "ОКЕИ_Тов"));
		УстановитьЗначениеXDTO(Item, "UnitName", ПолучитьЗначениеXDTO(СвСопрДок, "НаимЕдИзм"));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Заполнить_PersonAcceptedCargoInfo(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "РабОргПок") Тогда
		// Работник организации покупателя
		Заполнить_Employee_Torg2(Контент.Employee, Параметры.РабОргПок);
	Иначе
		// Иное лицо "ИнЛицо"
		Заполнить_OtherIssuer_Torg2(Контент.OtherIssuer, Параметры.ИнЛицо);
	КонецЕсли;
	
КонецПроцедуры

Процедура Заполнить_OtherCircumstancesAcceptanceInfo(Контент, Параметры)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Перевозчик") Тогда
		Заполнить_ExtendedOrganizationInfo_Torg2(Контент.Carrier, Параметры.Перевозчик);
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "СопрТрансДок") Тогда
		Заполнить_AccompanyingDocument(Контент.AccompanyingTransferDocumentInfo, Параметры.СопрТрансДок);
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "StorageConditions", ПолучитьЗначениеXDTO(Параметры, "УсловХран"));
	УстановитьЗначениеXDTO(Контент, "CargoActualState", ПолучитьЗначениеXDTO(Параметры, "СостТара"));
	УстановитьЗначениеXDTO(Контент, "MissingAssets", ПолучитьЗначениеXDTO(Параметры, "ОпредНедост"));
	УстановитьЗначениеXDTO(Контент, "AdditionalInfo", ПолучитьЗначениеXDTO(Параметры, "ДопСв"));
	
КонецПроцедуры

