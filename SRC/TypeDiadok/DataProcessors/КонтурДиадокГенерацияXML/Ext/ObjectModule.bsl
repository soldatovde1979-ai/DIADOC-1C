		УстановитьЗначениеXDTO(АдрИнф, "НаимСтран", ПротоКонтент.Country);
		УстановитьЗначениеXDTO(АдрИнф, "АдрТекст", ПротоКонтент.AddressText);
		
	КонецЕсли;
	
