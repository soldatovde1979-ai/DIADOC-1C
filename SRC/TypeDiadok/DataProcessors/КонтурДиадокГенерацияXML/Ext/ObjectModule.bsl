Процедура Заполнить_Official(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ФИО") Тогда
		УстановитьЗначениеXDTO(Контент, "FirstName"	, Параметры.ФИО.Имя);
		УстановитьЗначениеXDTO(Контент, "Surname"	, Параметры.ФИО.Фамилия);
		УстановитьЗначениеXDTO(Контент, "Patronymic", ПолучитьЗначениеXDTO(Параметры.ФИО, "Отчество"));
	Иначе
		УстановитьЗначениеXDTO(Контент, "FirstName"	, "");
		УстановитьЗначениеXDTO(Контент, "Surname"	, "");
		УстановитьЗначениеXDTO(Контент, "Patronymic", "");
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Должность") Тогда
		Должность = Параметры.Должность;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ДолжнКем") Тогда
		Должность = Параметры.ДолжнКем;
	ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Должн") Тогда
		Должность = Параметры.Должн;
	Иначе
		Должность = "";
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "JobTitle", Должность);
	
КонецПроцедуры

Процедура Заполнить_OrganizationInfo(Контент, Параметры)
	
	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеXDTO(Контент, "Okpo", ПолучитьЗначениеXDTO(Параметры, "ОКПО"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "ИдСв") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвЮЛ") Тогда
			
			СвЮЛ = Параметры.ИдСв.СвЮЛ;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Ложь);
			УстановитьЗначениеXDTO(Контент, "Name", СвЮл.НаимОрг);
			УстановитьЗначениеXDTO(Контент, "INN", ПолучитьЗначениеXDTO(СвЮЛ, "ИННЮЛ"));
			УстановитьЗначениеXDTO(Контент, "KPP", ПолучитьЗначениеXDTO(СвЮЛ, "КПП"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвФЛ") Тогда
			
			СвФЛ = Параметры.ИдСв.СвФЛ;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Истина);
			УстановитьЗначениеXDTO(Контент, "INN", ПолучитьЗначениеXDTO(СвФЛ, "ИННФЛ"));
			УстановитьЗначениеXDTO(Контент, "Name", СвФЛ.ФИОИП.Фамилия + " " + СвФЛ.ФИОИП.Имя + " " + ПолучитьЗначениеXDTO(СвФЛ.ФИОИП, "Отчество"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвЮЛУч") Тогда
			
			// в InvoiceContent СвЮЛУч - нет, оставлю для совместимости с другими контентами
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor",	Ложь);
			УстановитьЗначениеXDTO(Контент, "Name", ПолучитьЗначениеXDTO(Параметры.ИдСв.СвЮЛУч, "НаимОрг"));
			УстановитьЗначениеXDTO(Контент, "Inn", ПолучитьЗначениеXDTO(Параметры.ИдСв.СвЮЛУч, "ИННЮЛ"));
			УстановитьЗначениеXDTO(Контент, "Kpp", ПолучитьЗначениеXDTO(Параметры.ИдСв.СвЮЛУч, "КПП"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИП") Тогда
			
			СвИП = Параметры.ИдСв.СвИП;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor", Истина);
			УстановитьЗначениеXDTO(Контент, "INN", ПолучитьЗначениеXDTO(СвИП, "ИННФЛ"));
			УстановитьЗначениеXDTO(Контент, "Name", СвИП.ФИО.Фамилия + " " + СвИП.ФИО.Имя + " " + ПолучитьЗначениеXDTO(СвИП.ФИО, "Отчество"));
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвЮлНеУч") Тогда
			
			СвЮлНеУч = Параметры.ИдСв.СвЮлНеУч;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor",	Ложь);
			УстановитьЗначениеXDTO(Контент, "Name", СвЮлНеУч.НаимОрг);
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры.ИдСв, "СвИнНеУч") Тогда
			
			СвИнНеУч = Параметры.ИдСв.СвИнНеУч;
			УстановитьЗначениеXDTO(Контент, "IsSoleProprietor",	Истина);
			УстановитьЗначениеXDTO(Контент, "Name", СвИнНеУч.НаимОрг);
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Заполнить_AddressInfo(Контент.Address, ПолучитьЗначениеXDTO(Параметры, "Адрес"));
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "Контакт") Тогда
		УстановитьЗначениеXDTO(Контент, "Phone", ПолучитьЗначениеXDTO(Параметры.Контакт, "Тлф"));
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(Параметры, "БанкРекв") Тогда

		БанкРекв = Параметры.БанкРекв;
		УстановитьЗначениеXDTO(Контент, "BankAccountNumber", ПолучитьЗначениеXDTO(БанкРекв, "НомерСчета"));
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛокальная(БанкРекв, "СвБанк") Тогда
			СвБанк = БанкРекв.СвБанк;
			УстановитьЗначениеXDTO(Контент, "BankId", ПолучитьЗначениеXDTO(СвБанк, "БИК"));
			УстановитьЗначениеXDTO(Контент, "BankName", ПолучитьЗначениеXDTO(СвБанк, "НаимБанк"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

