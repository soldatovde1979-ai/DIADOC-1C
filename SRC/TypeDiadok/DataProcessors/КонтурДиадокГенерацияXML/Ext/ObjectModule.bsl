Процедура УПД820_КонвертироватьСведенияОТоварах_в970(Контент970, Контент820)
	
	Table820 = Контент820.Table;
	
	Если Table820 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидыНоменклатуры = Перечисление_ItemMarks();
	
	Table970 = НовыйProtoОбъектXDTO("InvoiceTable970");
	УстановитьЗначениеXDTO(Контент970, "Table", Table970);

	ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Table970, Table820);
	
	ЭтоСчетФактураНаАванс = (Контент970.Function = Перечисление_ФункцииУПД().СЧФ
		И Контент970.CircumFormatInvoice = "2");
	
	Для Каждого Item820 Из Table820.Items Цикл
		
		Item970 = НовыйProtoОбъектXDTO("Item970");
		Table970.Items.Добавить(Item970);
		
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(Item970, Item820);
		
		ЭтоУслугаИлиРабота = (Item970.ItemMark = ВидыНоменклатуры.Услуга
			Или Item970.ItemMark = ВидыНоменклатуры.Работа);
		
		Если Не ЗначениеЗаполнено(Item970.Quantity) Тогда
			
			КоличествоОбязательно = Не ЭтоСчетФактураНаАванс
				И Контент820.Function <> "Basic"
				И ЭтоУслугаИлиРабота
				И ЗначениеЗаполнено(Item820.Unit);

			Если КоличествоОбязательно Тогда
				Item970.Quantity = 1;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Item970.Price) Тогда
			
			ЦенаОбязательна = Не ЭтоСчетФактураНаАванс
				И Контент820.Function <> "Basic"
				И ЭтоУслугаИлиРабота
				И ЗначениеЗаполнено(Item820.Unit)
				И ЗначениеЗаполнено(Item820.Quantity);

			Если ЦенаОбязательна Тогда
				
				СуммаСНДС = Item820.Subtotal;
				Если Не ЗначениеЗаполнено(СуммаСНДС) Тогда
					СуммаСНДС = 0;
				КонецЕсли;
				
				СуммаНДС = Item820.Vat;
				Если Не ЗначениеЗаполнено(СуммаНДС) Тогда
					СуммаНДС = 0;
				КонецЕсли;
				
				Item970.Price = СуммаСНДС - СуммаНДС;
					
			КонецЕсли;
				
		КонецЕсли;
		
		Для Каждого CustomDeclaration820 Из Item820.CustomDeclarations Цикл
			CustomDeclaration = НовыйProtoОбъектXDTO("CustomDeclaration");
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(CustomDeclaration, CustomDeclaration820);
			Item970.CustomDeclarations.Добавить(CustomDeclaration);
		КонецЦикла;
		
		ИтогоКоличествоПрослеж = 0;
		
		Для Каждого ItemTracingInfo820 Из Item820.ItemTracingInfos Цикл
			
			ItemTracingInfo = НовыйProtoОбъектXDTO("ItemTracingInfo970");
			Item970.ItemTracingInfos.Добавить(ItemTracingInfo);
			
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(ItemTracingInfo, ItemTracingInfo820);
			
			ИтогоКоличествоПрослеж = ИтогоКоличествоПрослеж + ItemTracingInfo.Quantity;
			
		КонецЦикла;
		
		Если ИтогоКоличествоПрослеж > 0
			И ЗначениеЗаполнено(Item970.SubtotalWithVatExcluded) Тогда
			
			ЦенаПрослеж = Item970.SubtotalWithVatExcluded / ИтогоКоличествоПрослеж;
			
			Для Каждого ItemTracingInfo Из Item970.ItemTracingInfos Цикл
				ItemTracingInfo.SumWithoutVat = Окр(ЦенаПрослеж * ItemTracingInfo.Quantity, 2);
			КонецЦикла;
			
		КонецЕсли;

		Для Каждого ItemIdentificationNumber820 Из Item820.ItemIdentificationNumbers Цикл
			
			НоваяСтрока = НовыйProtoОбъектXDTO("ItemIdentificationNumber970");
			ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(НоваяСтрока, ItemIdentificationNumber820);
			
			Для Каждого Unit Из ItemIdentificationNumber820.Units Цикл
				НоваяСтрока.Units.Добавить(Unit);
			КонецЦикла;
			
			КолвоОСУ = 0;
			ГТИН = Неопределено;
			Для Каждого PackageId Из ItemIdentificationNumber820.PackageIds Цикл
				
				Если ЭтоКодОСУ(PackageId) Тогда
					
					ДанныеОСУ = РазложитьКодОСУ(PackageId);
					КолвоОСУ = КолвоОСУ + ДанныеОСУ.Количество;
					
					Если Не ЗначениеЗаполнено(ГТИН) Тогда
						ГТИН = ДанныеОСУ.GTIN;
					КонецЕсли;
					
				Иначе
					НоваяСтрока.PackageIds.Добавить(PackageId);
				КонецЕсли;
				
			КонецЦикла;
			
			УстановитьЗначениеXDTO(Item970, "GTIN", ГТИН);
			УстановитьЗначениеXDTO(НоваяСтрока, "MarkedItemsQuantity", КолвоОСУ);
			
			Item970.ItemIdentificationNumbers.Добавить(НоваяСтрока);
			
		КонецЦикла;
		
		Для Каждого AdditionalInfoItem820 Из Item820.StructedAdditionalInfos Цикл
			AdditionalInfoItem820 = УПД820_КонвертироватьAdditionalInfoItem_в970(AdditionalInfoItem820);
			Item970.StructedAdditionalInfos.Добавить(AdditionalInfoItem820);
		КонецЦикла;
		
		ItemСлужебнаяИнформация = НовыйProtoОбъектXDTO("ItemСлужебнаяИнформация");
		ЗаполнитьЗначенияПростыхТиповОдноименныхПолейОбъектовXDTO(ItemСлужебнаяИнформация, Item820.СлужебнаяИнформация);
		УстановитьЗначениеXDTO(Item970, "СлужебнаяИнформация", ItemСлужебнаяИнформация);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД820_КонвертироватьСведенияОТранспортныхНакладных_в970(TransferInfo820, TransferInfo970)
	
	Если Не ЗначениеЗаполнено(TransferInfo820.Waybills) Тогда
		Возврат;
	КонецЕсли;
	
	КлючПоля = "ТранНакл820";
	ШаблонЗначения = "%1 от %2";
	
	Для Каждого СведенияОНакладной Из TransferInfo820.Waybills Цикл
		
		ЗначениеПоля = Общее_ПодставитьПараметрыВСтроку(
			ШаблонЗначения,
			СведенияОНакладной.DocumentNumber,
			Дата1С_в_ДатаXML(СведенияОНакладной.DocumentDate));
			
		AdditionalInfoItem = НовыйProtoОбъектXDTO("AdditionalInfoItem");
		УстановитьЗначениеXDTO(AdditionalInfoItem, "Key", КлючПоля);
		УстановитьЗначениеXDTO(AdditionalInfoItem, "Value", ЗначениеПоля);
		
		TransferInfo970.AdditionalInfoId.StructedAdditionalInfos.Добавить(AdditionalInfoItem);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД820_КонвертироватьСведенияОбУчастникахЭДО_в970(Контент820, Контент970)

	Для Каждого Seller820 Из Контент820.Sellers Цикл
		Seller = УПД820_КонвертироватьСведенияУчастникаЭДО_в970(Seller820);
		Если Seller <> Неопределено Тогда
			Контент970.Sellers.Добавить(Seller);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Buyer820 Из Контент820.Buyers Цикл
		Buyer = УПД820_КонвертироватьСведенияУчастникаЭДО_в970(Buyer820);
		Если Buyer <> Неопределено Тогда
			Контент970.Buyers.Добавить(Buyer);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Consignee820 Из Контент820.Consignees Цикл
		Consignee = УПД820_КонвертироватьСведенияУчастникаЭДО_в970(Consignee820);
		Если Consignee <> Неопределено Тогда
			Контент970.Consignees.Добавить(Consignee);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Shipper820 Из Контент820.Shippers Цикл
		Shipper = УПД820_КонвертироватьСведенияГрузоотправителя_в970(Shipper820);
		Если Shipper <> Неопределено Тогда
			Контент970.Shippers.Добавить(Shipper);
		КонецЕсли;
	КонецЦикла;
	
	Если Контент820.FactorInfo <> Неопределено
		И ЗначениеЗаполнено(Контент820.FactorInfo.Type) Тогда
		FactorInfo = УПД820_КонвертироватьСведенияУчастникаЭДО_в970(Контент820.FactorInfo);
		УстановитьЗначениеXDTO(Контент970, "FactorInfo", FactorInfo);
	КонецЕсли;

КонецПроцедуры

Процедура УПД820_КонвертироватьСведенияОДокументахОтгрузки_в970(Контент820, Контент970, ОшибкиКонвертации)
	
	Если Контент970.Function = Перечисление_ФункцииУПД().СЧФДОП Тогда
		
		ДокументОтгрузки820 = Неопределено;
		Если Контент820.DocumentShipments.Количество() = 1 Тогда
			ДокументОтгрузки820 = Контент820.DocumentShipments[0];
		КонецЕсли;
		
		ДанныеДокументаОтгрузкиРазличаются = (ДокументОтгрузки820 = Неопределено
			Или ДокументОтгрузки820.Name <> ИмяДокументаОтгрузкиУПД()
			Или ДокументОтгрузки820.Number <> Контент970.DocumentNumber
			Или ДокументОтгрузки820.Date <> Контент970.DocumentDate
			Или Контент820.DocumentName <> ИмяДокументаОтгрузкиУПД());
			
		Если ДанныеДокументаОтгрузкиРазличаются Тогда
			
			DocumentShipment = НовыйЭлементСпискаXDTO(Контент970.DocumentShipments);
			DocumentShipment.Name = ИмяДокументаОтгрузкиУПД();
			DocumentShipment.Number = Контент970.DocumentNumber;
			DocumentShipment.Date = Контент970.DocumentDate;
			
			Контент970.DocumentName = ИмяДокументаОтгрузкиУПД();
			
		Иначе
			
			DocumentShipment = НовыйЭлементСпискаXDTO(Контент970.DocumentShipments);
			ЗаполнитьЗначенияСвойств(DocumentShipment, Контент820.DocumentShipments[0]);
			
		КонецЕсли;

	Иначе
		
		Для Каждого DocumentShipment820 Из Контент820.DocumentShipments Цикл
			DocumentShipment = УПД820_КонвертироватьСведенияОДокументеОтгрузки_в970(DocumentShipment820);
			Контент970.DocumentShipments.Добавить(DocumentShipment);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД820_ДатаОтгрузки(TransferInfo820)

	Контент820 = TransferInfo820.Владелец();
	
	Результат = Контент820.DocumentDate;
	
	Для Каждого ДокументОтгрузки Из Контент820.DocumentShipments Цикл
		Если ЗначениеЗаполнено(ДокументОтгрузки.Date)
			И ЗначениеЗаполнено(Результат) Тогда
			Результат = Мин(ДокументОтгрузки.Date, Результат);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

