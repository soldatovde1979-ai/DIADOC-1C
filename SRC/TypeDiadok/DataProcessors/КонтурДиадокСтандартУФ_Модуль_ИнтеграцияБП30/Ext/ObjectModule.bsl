	|	&НомерГТДПредставление КАК НомерГТДПредставление,
	|	Т.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Т.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|	Т.ЕдиницаИзмерения КАК ВидУпаковки,
	|	Т.Коэффициент КАК КоличествоВОдномМесте,
	|	Т.КоличествоМест КАК КоличествоМест,
	|	ЛОЖЬ КАК ЭтоУслуга,
	|	""Property"" КАК ПризнакТоварРаботаУслуга,
	|	0 КАК ВсегоВРублях,
	|	0 КАК НДСВРублях,
	|	Т.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЛОЖЬ КАК СуществуютЗаписиРублевыхСумм
	|ИЗ
	|	Документ.ОтчетКомиссионераОПродажах.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КлючПокупателя КАК КлючиСвязи
	|		ПО Т.КлючСтроки = КлючиСвязи.КлючСтроки
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Услуги),
	|	""Услуги"",
	|	2,
	|	Т.НомерСтроки,
	|	Т.Номенклатура,
	|	Т.Содержание,
	|	&КодНоменклатурыИзТЧ,
	|	Т.Количество,
	|	Т.Цена,
	|	Т.Сумма,
	|	Т.СтавкаНДС,
	|	Т.СуммаНДС,
	|	"""",
	|	Т.Ссылка.СуммаВключаетНДС,
	|	"""",
	|	"""",
	|	Т.Номенклатура.ЕдиницаИзмерения,
	|	Т.Номенклатура.ЕдиницаИзмерения.Код,
	|	"""",
	|	0,
	|	0,
	|	ИСТИНА,
	|	""Service"",
	|	0,
	|	0,
	|	"""",
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ОтчетКомиссионераОПродажах.Услуги КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КлючПокупателя КАК КлючиСвязи
	|		ПО Т.КлючСтроки = КлючиСвязи.КлючСтроки
	|ГДЕ
