Функция ОснованиеОтчетКомитентаОПродажах_ОтчетОЗакупках(ДокОснования, СчетФактура = Неопределено)
	
	Если СчетФактура = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДокОснования.Количество()= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(ДокОснования[0]) <> Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОтчетКомитентуОПродажах = ДокОснования[0];
	
	Если ОтчетКомитентуОПродажах.Метаданные().Реквизиты.Найти("ВидОперации") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОтчетКомитентуОПродажах.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;	
	
КонецФункции

