// Список возможных идентификаторов правил обработки входящих документов.
// 
// Возвращаемое значение:
//  Структура - см. тело функции.
//
Функция ИдентификаторыПравилОбработкиДокументов()
	
	ЗначенияПеречисления = Новый Массив;
	ЗначенияПеречисления.Добавить("ПоступлениеТоваровУслуг");
	ЗначенияПеречисления.Добавить("ПоступлениеТоваровУслуг_Оборудование");
	ЗначенияПеречисления.Добавить("ПоступлениеТоваровУслуг_ОсновныеСредства");
	ЗначенияПеречисления.Добавить("ПоступлениеТоваровУслуг_ОбъектыСтроительства");
	ЗначенияПеречисления.Добавить("ПоступлениеТоваровУслуг_УслугиЛизинга");
	ЗначенияПеречисления.Добавить("ПоступлениеТоваровУслуг_УслугиФакторинга");
	ЗначенияПеречисления.Добавить("ПоступлениеДенежныхДокументов");
	ЗначенияПеречисления.Добавить("ПоступлениеДопРасходов");
	ЗначенияПеречисления.Добавить("ПоступлениеВЛизинг");
	ЗначенияПеречисления.Добавить("ПоступлениеНМА");
	ЗначенияПеречисления.Добавить("ОперацияСБилетом_Покупка");
	ЗначенияПеречисления.Добавить("ВозвратТоваровОтПокупателя");
	ЗначенияПеречисления.Добавить("КорректировкаПоступления");
	ЗначенияПеречисления.Добавить("СчетФактураПолученный");
	ЗначенияПеречисления.Добавить("АктОРасхожденияхПолученный");
	ЗначенияПеречисления.Добавить("АктСверкиВзаиморасчетов");
	ЗначенияПеречисления.Добавить("СчетНаОплату");
	
	Результат = Новый Структура;
	
	Для Каждого Элемент Из ЗначенияПеречисления Цикл
		
		Результат.Вставить(Элемент, Элемент);
		
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Дополняет таблицу правил обработки товарных накладных.
//
Процедура ЗаполнитьПравилаОбработкиНакладных(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхДокументов = Ложь;
	ДляИсправительныхДокументов = Истина;
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	ВидДокумента = ВидыЭД.ТоварнаяНакладная;
	
	// Товары, услуги, комиссия
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПоступлениеТоваровУслуг
		, ВидДокумента
		, ДляПервичныхИИсправительныхДокументов);
	
	Если ВедетсяУчетОсновныхСредств() Тогда
		
		// Оборудование
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ПоступлениеТоваровУслуг_Оборудование
			, ВидДокумента
			, ДляПервичныхИИсправительныхДокументов);
		
		// Основные средства
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ПоступлениеТоваровУслуг_ОсновныеСредства
			, ВидДокумента
			, ДляПервичныхИИсправительныхДокументов);
		
		// Объекты строительства
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ПоступлениеТоваровУслуг_ОбъектыСтроительства
			, ВидДокумента
			, ДляПервичныхИИсправительныхДокументов);
		
	КонецЕсли;
	
	// Предметы лизинга
	Если ВедетсяУчетЛизинговогоИмущества() Тогда
		
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ПоступлениеВЛизинг
			, ВидДокумента
			, ДляПервичныхИИсправительныхДокументов);
		
	КонецЕсли;
	
	// Нематериальные активы
	Если ВедетсяУчетНМА() Тогда
		
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ПоступлениеНМА
			, ВидДокумента
			, ДляПервичныхИИсправительныхДокументов);
		
	КонецЕсли;
	
	// Денежные документы
	Если ВедетсяУчетДенежныхДокументов() Тогда
		
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ПоступлениеДенежныхДокументов
			, ВидДокумента
			, ДляПервичныхИИсправительныхДокументов);
	
	КонецЕсли;
	
	// Операции с билетами
	Если ИспользоватьОперацииСБилетами() Тогда
		
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.ОперацияСБилетом_Покупка
			, ВидДокумента
			, ДляПервичныхДокументов);
		
	КонецЕсли;
	
	// Возврат товаров от покупателя
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ВозвратТоваровОтПокупателя
		, ВидДокумента
		, ДляПервичныхДокументов);
	
	// Исправление накладной
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.КорректировкаПоступления
		, ВидДокумента
		, ДляИсправительныхДокументов);
	
	// Корректировка накладной, акта
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.КорректировкаПоступления
		, ВидыЭД.СоглашениеОбИзмененииСтоимости
		, ДляПервичныхИИсправительныхДокументов);
	
КонецПроцедуры

// Дополняет таблицу правил обработки актов об оказании услуг.
//
Процедура ЗаполнитьПравилаОбработкиАктов(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
