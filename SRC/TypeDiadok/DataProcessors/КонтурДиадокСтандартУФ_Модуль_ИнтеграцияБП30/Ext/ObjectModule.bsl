КонецФункции

Функция _РеквизитыОбособленногоПодразделения(ПодразделениеОрганизации)
	
	ТребуемыеРеквизиты = Новый Структура;
	//ТребуемыеРеквизиты.Вставить("Представление" , "Наименование");
	ТребуемыеРеквизиты.Вставить("НаименованиеПолное" , "НаименованиеПолное");
	ТребуемыеРеквизиты.Вставить("ИНН", "ГоловнаяОрганизация.ИНН");
	ТребуемыеРеквизиты.Вставить("КПП");
	ТребуемыеРеквизиты.Вставить("КодПоОКПО");
	
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПодразделениеОрганизации, ТребуемыеРеквизиты);
	АдресПодразделения = АдресЮрФизЛица(ПодразделениеОрганизации, Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций);
	
	Модель = _Контракт_РеквизитыЮрФизЛица();
	Модель.ТипЮрФизЛица = "ЮридическоеЛицо"; // ТипыЮрФизЛиц().ЮридическоеЛицо
	Модель.НаименованиеПолное = Данные.НаименованиеПолное;
	Модель.ИНН = Данные.ИНН;
	Модель.КПП = Данные.КПП;
	Модель.КодПоОКПО = Данные.КодПоОКПО;
	Модель.ФактическийАдрес = АдресПодразделения.Представление;
	Модель.ЗначенияПолейФактическийАдрес = АдресПодразделения.ЗначенияПолей;
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

Функция _РеквизитыОрганизации(Организация, Период, БанковскийСчет)
	
	Если ИспользуетсяФункционалКрупнейшийНалогоплатильщик() Тогда
		
		ЭтоКрупнейшийНалогоплательщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КрупнейшийНалогоплательщик");
		Данные = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Организация, Период, БанковскийСчет, , , ЭтоКрупнейшийНалогоплательщик);
		
	Иначе
		
		Данные = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Организация, Период, БанковскийСчет);
		
	КонецЕсли;
	
	ТипОрганизации = "ЮридическоеЛицо"; // ТипыЮрФизЛиц().ЮридическоеЛицо
	СвидетельствоОРегистрацииИП = "";
	ОГРН = "";
	ДатаРегистрации = "";
	
	Если Данные.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		
		ТипОрганизации = "ФизическоеЛицо"; // ТипыЮрФизЛиц().ФизическоеЛицо
		
		ЭтоСамозанятый = (
			ЕстьРеквизитИлиСвойствоОбъектаЛок(Организация, "СтатусФизическогоЛица")
			И Организация.СтатусФизическогоЛица = Перечисления.СтатусыФизическихЛиц.Самозанятый
		);
		
		Если НЕ ЭтоСамозанятый Тогда
			
			ТипОрганизации = "ИндивидуальныйПредприниматель"; // ТипыЮрФизЛиц().ИндивидуальныйПредприниматель
			
			СвидетельствоОРегистрацииИП = СокрЛП(Данные.Свидетельство);
			Если Не ЗначениеЗаполнено(СвидетельствоОРегистрацииИП) Тогда
				СвидетельствоОРегистрацииИП = Данные.СвидетельствоСерияНомер + " от " + Формат(Данные.СвидетельствоДатаВыдачи, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			
			ОГРН = Данные.ОГРН;
			ДатаРегистрации = Формат(Данные.ДатаРегистрации, "ДФ=dd.MM.yyyy");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Модель = _Контракт_РеквизитыЮрФизЛица();
	Модель.ТипЮрФизЛица = ТипОрганизации;
	Модель.НаименованиеПолное = СокрЛП(Данные.НаименованиеДляПечатныхФорм);
	Модель.ИНН = Данные.ИНН;
	Модель.КПП = Данные.КПП;
	Модель.КодПоОКПО = Данные.КодПоОКПО;
	Модель.Свидетельство = СвидетельствоОРегистрацииИП;
	Модель.ОГРН = ОГРН;
	Модель.ДатаРегистрации = ДатаРегистрации;
	
	Модель.НомерСчета = Данные.НомерСчета;
	Модель.БИК = Данные.БИК;
	Модель.Банк = СокрЛП(Данные.Банк);
	Модель.КоррСчет = Данные.КоррСчет;
	
	Модель.Телефоны = Данные.Телефоны;
