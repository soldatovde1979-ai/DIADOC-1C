#Область СчетФактура

// Конструктор дополнительных параметров заполнения счета-фактуры.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ДокументОснование - Неопределено, ДокументСсылка, Массив - документ-основание (список оснований) счета-фактуры.
//
Функция ПараметрыЗаполненияСчетаФактуры()
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументОснование", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияСчетаФактуры(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияСчетаФактуры();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеОбъекта = Новый Структура;
	
	// Даты, номера
	ДанныеОбъекта.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	ДанныеОбъекта.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	ДанныеОбъекта.Вставить("НомерИсходногоДокумента", "");
	ДанныеОбъекта.Вставить("ДатаИсходногоДокумента"	, '00010101');
	
	НомерИсправления = СвойствоСтруктуры(ШапкаЭД, "НомерИсправления");
	ДатаИсправления  = СвойствоСтруктуры(ШапкаЭД, "ДатаИсправления");
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ДанныеОбъекта.Вставить("Исправление", Истина);
		ДанныеОбъекта.Вставить("НомерИсправления", НомерИсправления);
		ДанныеОбъекта.Вставить("ДатаИсправления",  ДатаИсправления);
	КонецЕсли;
	
	// Участники сделки
	ДанныеОбъекта.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	ДанныеОбъекта.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	ДанныеОбъекта.Вставить("Комиссионер", Справочники.Контрагенты.ПустаяСсылка()); // TODO: Добавить в структуру ЭД сведения о комиссионере
	
	// Вид операции
	ЭтоАванс = ДанныеЭД.ЭтоАванс; // TODO: Заменить на вызов ЭтоЭлектронныйСчетФактураНаАванс()
	
	Если ЭтоАванс Тогда 
		
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаАванс;
		КодВидаОперации = "02";
		
	Иначе
		
		ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаПоступление;
		КодВидаОперации = ?(ЗначениеЗаполнено(ДанныеОбъекта.Комиссионер), "04", "01");
		
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("ВидСчетаФактуры", ВидСчетаФактуры);
	ДанныеОбъекта.Вставить("КодВидаОперации", КодВидаОперации);
	
	// Основания счета-фактуры
	ОснованиеСчетаФактуры = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ОснованиеСчетаФактуры) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ОснованиеСчетаФактуры = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	ДанныеОбъекта.Вставить("ДокументыОснования", ОснованиеСчетаФактуры);
	
	// Валюта, суммы
	ДанныеОбъекта.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	ДанныеОбъекта.Вставить("СуммаДокумента"		, ИтогиТЧ.СуммаСНДС);
	ДанныеОбъекта.Вставить("СуммаНДСДокумента"	, ИтогиТЧ.СуммаНДС);
	ДанныеОбъекта.Вставить("СуммаУменьшение"	, 0);
	ДанныеОбъекта.Вставить("СуммаНДСУменьшение"	, 0);
	ДанныеОбъекта.Вставить("СуммаУвеличение"	, 0);
	ДанныеОбъекта.Вставить("СуммаНДСУвеличение"	, 0);
	
	// Авансы
	Если ДанныеОбъекта.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.НаАванс Тогда
		
		Авансы = Новый ТаблицаЗначений;
		Авансы.Колонки.Добавить("Сумма");
		Авансы.Колонки.Добавить("СуммаНДС");
		Авансы.Колонки.Добавить("СтавкаНДС");
		
		Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
			
			ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
			
			НоваяСтрока = Авансы.Добавить();
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
			НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
			
		КонецЦикла;
		
		Если Авансы.Количество() > 0 Тогда
			ДанныеОбъекта.Вставить("Авансы", Авансы);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция СтруктураЗаполненияКорректировочногоСчетаФактуры(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияСчетаФактуры();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	ДанныеОбъекта.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	ДанныеОбъекта.Вставить("НомерИсходногоДокумента", СвойствоСтруктуры(ШапкаЭД, "НомерИсходногоДокумента"));
	ДанныеОбъекта.Вставить("ДатаИсходногоДокумента"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсходногоДокумента"));
	
	НомерИсправления = СвойствоСтруктуры(ШапкаЭД, "НомерИсправления");
	ДатаИсправления  = СвойствоСтруктуры(ШапкаЭД, "ДатаИсправления");
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		ДанныеОбъекта.Вставить("Исправление", Истина);
		ДанныеОбъекта.Вставить("НомерИсправления", НомерИсправления);
		ДанныеОбъекта.Вставить("ДатаИсправления",  ДатаИсправления);
	КонецЕсли;
	
	НомерИсправленияИсходногоДокумента = СвойствоСтруктуры(ШапкаЭД, "НомерИсправленияИсходногоДокумента");
	ДатаИсправленияИсходногоДокумента  = СвойствоСтруктуры(ШапкаЭД, "ДатаИсправленияИсходногоДокумента");
	
	Если ЗначениеЗаполнено(НомерИсправленияИсходногоДокумента) Тогда
		ДанныеОбъекта.Вставить("УчитыватьИсправлениеИсходногоДокумента", Истина);
		ДанныеОбъекта.Вставить("НомерИсправленияИсходногоДокумента", НомерИсправленияИсходногоДокумента);
		ДанныеОбъекта.Вставить("ДатаИсправленияИсходногоДокумента",  ДатаИсправленияИсходногоДокумента);
	Иначе
		ДанныеОбъекта.Вставить("УчитыватьИсправлениеИсходногоДокумента", Ложь);
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	ДанныеОбъекта.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	ДанныеОбъекта.Вставить("Комиссионер", Справочники.Контрагенты.ПустаяСсылка());
	
	ДанныеОбъекта.Вставить("ВидСчетаФактуры", Перечисления.ВидСчетаФактурыПолученного.Корректировочный);
	ДанныеОбъекта.Вставить("КодВидаОперации", "01");
	ДанныеОбъекта.Вставить("КодВидаОперацииНаУменьшение", "18");
	
	//Заполняем документы-основания
	ОснованиеСчетаФактуры = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ОснованиеСчетаФактуры) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ОснованиеСчетаФактуры = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	ДанныеОбъекта.Вставить("ДокументыОснования", ОснованиеСчетаФактуры);
	
	ДанныеОбъекта.Вставить("ВалютаДокумента", ШапкаЭД.Валюта.Ссылка);
	
	ДанныеОбъекта.Вставить("СуммаДокумента"		, 0);
	ДанныеОбъекта.Вставить("СуммаНДСДокумента"	, 0);
	
	ДанныеОбъекта.Вставить("СуммаУменьшение"	, ИтогиТЧ.СуммаСНДСУменьшение);
	ДанныеОбъекта.Вставить("СуммаНДСУменьшение"	, ИтогиТЧ.СуммаНДСУменьшение);
	ДанныеОбъекта.Вставить("СуммаУвеличение"	, ИтогиТЧ.СуммаСНДСУвеличение);
	ДанныеОбъекта.Вставить("СуммаНДСУвеличение"	, ИтогиТЧ.СуммаНДСУвеличение);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьСчетФактуруПолученный(ДокументОбъект, ДанныеДокумента)
	
	// вручную переопределим, если требуется
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеДокумента);
	
	// Заполнить реквизиты значениями по умолчанию.
	ЗаполнениеДокументов.Заполнить(ДокументОбъект);
	ДокументОбъект.ВидСчетаФактуры = ДанныеДокумента.ВидСчетаФактуры;
	ДокументОбъект.КодВидаОперации = ДанныеДокумента.КодВидаОперации;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.ДокументыОснования) Тогда
		
		Если ТипЗнч(ДанныеДокумента.ДокументыОснования) = Тип("Массив") Тогда
			КоллекцияОснований = ДанныеДокумента.ДокументыОснования;
		Иначе
			КоллекцияОснований = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеДокумента.ДокументыОснования);
		КонецЕсли;
		
		ДокументОбъект.ДокументыОснования.Очистить();
		
		Для Каждого ДокументОснование Из КоллекцияОснований Цикл
			
			Если ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный 
				И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ДокументОбъект.ДокументыОснования.Добавить().ДокументОснование = ДокументОснование;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДокументОбъект.ДокументОснование = ?(ДокументОбъект.ДокументыОснования.Количество()>0, ДокументОбъект.ДокументыОснования[0].ДокументОснование, Неопределено);
	Если ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		
		ДокументОбъект.ДоговорКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ДокументОснование, "ДоговорКонтрагента");
		
	КонецЕсли;
	
	ДокументОбъект.КодСпособаПолучения = 2;
	ДокументОбъект.НомерВходящегоДокумента = ДанныеДокумента.НомерВходящегоДокумента;
	ДокументОбъект.ДатаВходящегоДокумента  = ДанныеДокумента.ДатаВходящегоДокумента;
	ДокументОбъект.НомерИсходногоДокумента = ДанныеДокумента.НомерИсходногоДокумента;
	ДокументОбъект.ДатаИсходногоДокумента  = ДанныеДокумента.ДатаИсходногоДокумента;
	Если ДанныеДокумента.Свойство("Исправление") Тогда
		ДокументОбъект.Исправление       = ДанныеДокумента.Исправление;
		ДокументОбъект.НомерИсправления  = ДанныеДокумента.НомерИсправления;
		ДокументОбъект.ДатаИсправления   = ДанныеДокумента.ДатаИсправления;
	КонецЕсли;
	
	Если ДокументОбъект.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный 
		И ДокументОбъект.ДокументыОснования.Количество()>0 Тогда
		
		СтрокаОснование = ДокументОбъект.ДокументыОснования[0];
		СтрокаОснование.НомерИсходногоДокумента	 = ДанныеДокумента.НомерИсходногоДокумента;
		СтрокаОснование.ДатаИсходногоДокумента	 = ДанныеДокумента.ДатаИсходногоДокумента;
		СтрокаОснование.СуммаУвеличение		 = ДанныеДокумента.СуммаУвеличение;
		СтрокаОснование.СуммаУменьшение		 = ДанныеДокумента.СуммаУменьшение;
		СтрокаОснование.СуммаНДСУвеличение	 = ДанныеДокумента.СуммаНДСУвеличение;
		СтрокаОснование.СуммаНДСУменьшение	 = ДанныеДокумента.СуммаНДСУменьшение;
		
		СтрокаОснование.УчитыватьИсправлениеИсходногоДокумента = ДанныеДокумента.Свойство("УчитыватьИсправлениеИсходногоДокумента") И ДанныеДокумента.УчитыватьИсправлениеИсходногоДокумента;
		
		Если СтрокаОснование.УчитыватьИсправлениеИсходногоДокумента  Тогда
			СтрокаОснование.НомерИсправленияИсходногоДокумента = ДанныеДокумента.НомерИсправленияИсходногоДокумента;
			СтрокаОснование.ДатаИсправленияИсходногоДокумента  = ДанныеДокумента.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
		
	КонецЕсли;
	
	// Отражение вычета НДС по умолчанию
	СтруктураПараметров	= Новый Структура("Дата, Организация, ВидСчетаФактуры, ДокументОснование, Исправление");
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ДокументОбъект);
	ДокументОбъект.НДСПредъявленКВычету = Документы.СчетФактураПолученный.ПолучитьПорядокОтраженияВычетаПоУмолчанию(СтруктураПараметров);
	
	ДокументОбъект.СуммаУвеличение		 = ДанныеДокумента.СуммаУвеличение;
	ДокументОбъект.СуммаУменьшение		 = ДанныеДокумента.СуммаУменьшение;
	ДокументОбъект.СуммаНДСУвеличение	 = ДанныеДокумента.СуммаНДСУвеличение;
	ДокументОбъект.СуммаНДСУменьшение	 = ДанныеДокумента.СуммаНДСУменьшение;
	
	Если ДанныеДокумента.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыПолученного.Корректировочный Тогда
		ДокументОбъект.СуммаДокумента     = ?(ДанныеДокумента.СуммаУвеличение = Неопределено, 0, ДанныеДокумента.СуммаУвеличение)
											- ?(ДанныеДокумента.СуммаУменьшение = Неопределено, 0, ДанныеДокумента.СуммаУменьшение);
		ДокументОбъект.СуммаНДСДокумента     = ?(ДанныеДокумента.СуммаНДСУвеличение = Неопределено, 0, ДанныеДокумента.СуммаНДСУвеличение)
											- ?(ДанныеДокумента.СуммаНДСУменьшение = Неопределено, 0, ДанныеДокумента.СуммаНДСУменьшение);
	Иначе
		ДокументОбъект.СуммаДокумента     = ДанныеДокумента.СуммаДокумента;
		ДокументОбъект.СуммаНДСДокумента  = ДанныеДокумента.СуммаНДСДокумента;
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("Авансы") Тогда
		
		ДокументОбъект.Авансы.Загрузить(ДанныеДокумента.Авансы);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КорректировкаПоступления

Функция ПараметрыЗаполненияКорректировкиПоступления()
	
	Результат = Новый Структура;
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("ДокументОснование", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияКорректировкиПоступления();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	
	ПустаяСсылкаНаДокумент = Документы.КорректировкаПоступления.ПустаяСсылка();
	
	Товары = ПустаяСсылкаНаДокумент.Товары.ВыгрузитьКолонки();
	Услуги = ПустаяСсылкаНаДокумент.Услуги.ВыгрузитьКолонки();
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	СведенияПрослеживаемости = НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(ПустаяСсылкаНаДокумент, Истина);
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Участники сделки
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	
	// Валюта, суммы
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсДокумента"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьДокумента"	, ШапкаЭД.Кратность);
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Даты, номера
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	Шапка.Вставить("НомерИсходногоДокумента", СвойствоСтруктуры(ШапкаЭД, "НомерИсходногоДокумента"));
	Шапка.Вставить("ДатаИсходногоДокумента"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсходногоДокумента"));
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(ШапкаЭД, "НомерИсправления")) Тогда 
		Шапка.Вставить("ВидОперацииЭД"		, Перечисления.ВидыОперацийЭД.Исправление);
		Шапка.Вставить("Исправление"		, Истина);
		Шапка.Вставить("НомерИсправления"	, СвойствоСтруктуры(ШапкаЭД, "НомерИсправления"));
		Шапка.Вставить("ДатаИсправления"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсправления"));
	Иначе 
		Шапка.Вставить("ВидОперацииЭД"	, Перечисления.ВидыОперацийЭД.Корректировка);
		Шапка.Вставить("Исправление"	, Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(ШапкаЭД, "НомерИсправленияИсходногоДокумента")) Тогда
		Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента"	, Истина);
		Шапка.Вставить("НомерИсправленияИсходногоДокумента"		, СвойствоСтруктуры(ШапкаЭД, "НомерИсправленияИсходногоДокумента"));
		Шапка.Вставить("ДатаИсправленияИсходногоДокумента"		, СвойствоСтруктуры(ШапкаЭД, "ДатаИсправленияИсходногоДокумента"));
	Иначе
		Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента"	, Ложь);
	КонецЕсли;
	
	ДокументОснование = ПараметрыЗаполнения.ДокументОснование;
	
	Если Не ЗначениеЗаполнено(ДокументОснование)
		И ФорматЭД.ЭтоКорректировка Тогда
		
		// Основание корректировочного документа
		СвойстваОснования = СвойствоСтруктуры(ШапкаЭД, "КорректируемыйДокумент");
		ДокументОснование = СвойствоСтруктуры(СвойстваОснования, "ПервичныйДокумент");
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			ДокументОснование = ДокументОснованиеСчетаФактуры(ДокументОснование);
		КонецЕсли;
		
	КонецЕсли;
	
	Шапка.Вставить("Основание", ДокументОснование);
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда 
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "СуммаВключаетНДС");
		Шапка.СуммаВключаетНДС = РеквизитыОснования.СуммаВключаетНДС;
	КонецЕсли;
	
	// Табличная часть
	ИспользуетсяОбратноеНачислениеНДС = ИспользуетсяОбратноеНачислениеНДС();
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		ЭтоУслуга = ЭтоНоменклатураУслуга(НоменклатураИБ.Номенклатура);
		
		Если ЭтоУслуга Тогда 
			НоваяСтрока = Услуги.Добавить();
			НоваяСтрока.СодержаниеДоИзменения = НоменклатураКонтрагента.Наименование;
			НоваяСтрока.Содержание            = НоменклатураКонтрагента.Наименование;
		Иначе 
			НоваяСтрока = Товары.Добавить();
		КонецЕсли;
		
		НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		Если МенеджерИнтеграции_ЭтоСтавкаНДСИНА(ПредставлениеСтавки) Тогда
			
			Если ИспользуетсяОбратноеНачислениеНДС Тогда
				
				НоваяСтрока.СтавкаНДС = МенеджерИнтеграции_ОбщаяСтавкаНДС(ШапкаЭД.Дата);
				
				НоваяСтрока.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
					Стр.СуммаБезНДС,
					Ложь,
					УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
				
				Если ФорматЭД.ЭтоКорректировка Тогда
					
					НоваяСтрока.СуммаНДСДоКорректировки = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
						Стр.СуммаБезНДС_До,
						Ложь,
						УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
					
				КонецЕсли;
				
			Иначе
				
				НоваяСтрока.СтавкаНДС = Неопределено;
				НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
				
				Если ФорматЭД.ЭтоКорректировка Тогда
					НоваяСтрока.СуммаНДСДоКорректировки = Стр.СуммаНДС_До;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе 
			
			НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
			
			Если ФорматЭД.ЭтоКорректировка Тогда
				НоваяСтрока.СуммаНДСДоКорректировки = Стр.СуммаНДС_До;
			КонецЕсли;
			
		КонецЕсли;
		
		НоваяСтрока.Количество = Стр.Количество;
		НоваяСтрока.Цена = Стр.Цена;
		НоваяСтрока.Сумма = Стр.СуммаБезНДС;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			НоваяСтрока.КоличествоДоКорректировки = Стр.Количество_До;
			НоваяСтрока.ЦенаДоКорректировки = Стр.Цена_До;
			НоваяСтрока.СуммаДоКорректировки = Стр.СуммаБезНДС_До;
		КонецЕсли;
		
		Если Шапка.СуммаВключаетНДС Тогда
			
			// Включаем НДС в сумму
			НоваяСтрока.Сумма = НоваяСтрока.Сумма + НоваяСтрока.СуммаНДС;
			
			// Пересчитаем цену
			РасчетноеКоличество = ?(НоваяСтрока.Количество = 0, 1, НоваяСтрока.Количество);
			НоваяСтрока.Цена = НоваяСтрока.Сумма / РасчетноеКоличество;
			
		КонецЕсли;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке, НоменклатураКонтрагента.GTIN);
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "СтранаПроисхождения") Тогда
			НоваяСтрока.СтранаПроисхождения = СтранаПроисхожденияИзСведенийТаможеннойДекларации(Стр.ДанныеГТД);
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "НомерГТД") Тогда
			НоваяСтрока.НомерГТД = НомерГТДИзСведенийТаможеннойДекларации(Стр.ДанныеГТД);
		КонецЕсли;
		
		Если ИспользуетсяУчетПрослеживаемыхТоваров И НЕ ЭтоУслуга Тогда
			
			Если ФорматЭД.ЭтоКорректировка Тогда
				ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УКД(СведенияПрослеживаемости, Стр.СведенияОПрослеживаемости, НоваяСтрока);
			Иначе
				ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УПД(СведенияПрослеживаемости, Стр.СведенияОПрослеживаемости, НоваяСтрока);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Товары"	, Товары);
	ДанныеОбъекта.Вставить("Услуги"	, Услуги);
	ДанныеОбъекта.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	ДанныеОбъекта.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьКорректировкуПоступления(ДокументОбъект, ДанныеДокумента)
	
	ДанныеЗаполнения = ДанныеДокумента.Шапка;
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеЗаполнения);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ЭтоИсправление = (ДанныеЗаполнения.ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Исправление);
	ЕстьДанныеПрослеживаемости = ДанныеДокумента.СведенияПрослеживаемости <> Неопределено;
	
	Если ЭтоИсправление Тогда
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки;
	Иначе
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
	КонецЕсли;
	
	//ДокументОбъект.ЗаполнитьСвойстваШапки();
	
	Если ЭтоИсправление Тогда
		ДокументОбъект.НомерИсправления = ДанныеЗаполнения.НомерИсправления;
		ДокументОбъект.ДатаИсправления = ДанныеЗаполнения.ДатаИсправления;
	КонецЕсли;
	
	Если ДанныеЗаполнения.Свойство("НомерИсходногоДокумента")
		И ЗначениеЗаполнено(ДанныеЗаполнения.НомерИсходногоДокумента) Тогда
		ДокументОбъект.НомерИсходногоДокумента = ДанныеЗаполнения.НомерИсходногоДокумента;
		ДокументОбъект.ДатаИсходногоДокумента  = ДанныеЗаполнения.ДатаИсходногоДокумента;
		Если ДанныеЗаполнения.УчитыватьИсправлениеИсходногоДокумента Тогда
			ДокументОбъект.НомерИсправленияИсходногоДокумента = ДанныеЗаполнения.НомерИсправленияИсходногоДокумента;
			ДокументОбъект.ДатаИсправленияИсходногоДокумента  = ДанныеЗаполнения.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
	КонецЕсли;
	
	ДокументПоступления = ДокументОбъект.ДокументПоступления;
	Если Не ЗначениеЗаполнено(ДокументПоступления) И ДанныеЗаполнения.Свойство("Основание") Тогда
		ДокументПоступления = ДанныеЗаполнения.Основание;
	КонецЕсли;
	
	// Заполним корректировку поступления данными основания
	Если ЗначениеЗаполнено(ДокументПоступления) Тогда
		ДокументОбъект.Заполнить(ДокументПоступления);
	КонецЕсли;
	
	// Заполним табличные части данными корректировки
	ИменаТЧСтрокой = "Товары, Услуги";
	ИменаТЧ = Новый Массив;
	ИменаТЧ.Добавить("Товары");
	ИменаТЧ.Добавить("Услуги");
	
	РеквизитыТабличнойЧастиДляПерезаполнения = Новый Структура(ИменаТЧСтрокой);
	РеквизитыТабличнойЧастиДляПерезаполнения.Товары = "Количество, Цена, Сумма, СуммаНДС, НомерГТД, СтранаПроисхождения";
	РеквизитыТабличнойЧастиДляПерезаполнения.Услуги = "Количество, Цена, Сумма, СуммаНДС, Содержание";
	
	РеквизитыТабличнойЧастиДляЗаполненияНовойСтроки = Новый Структура(ИменаТЧСтрокой);
	
	Если ЭтоИсправление Тогда 
		РеквизитыТабличнойЧастиДляЗаполненияНовойСтроки.Товары = "";
		РеквизитыТабличнойЧастиДляЗаполненияНовойСтроки.Услуги = "";
	Иначе 
		РеквизитыТабличнойЧастиДляЗаполненияНовойСтроки.Товары = "КоличествоДоИзменения, ЦенаДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения, НомерГТДДоИзменения, СтранаПроисхожденияДоИзменения";
		РеквизитыТабличнойЧастиДляЗаполненияНовойСтроки.Услуги = "КоличествоДоИзменения, ЦенаДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения, СодержаниеДоИзменения";
	КонецЕсли;
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		
		ИмяТЧ = СокрЛП(ИмяТЧ);
		
		СтруктураПоиска = Новый Структура("Номенклатура, СтавкаНДС");
		
		Для Каждого СтрокаДокумента Из ДокументОбъект[ИмяТЧ] Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
			РезультатПоискаДанныхЗаполнения = ДанныеДокумента[ИмяТЧ].НайтиСтроки(СтруктураПоиска);
			
			Если РезультатПоискаДанныхЗаполнения.Количество() > 0 Тогда
				
				СтрокаДанныхЗаполнения = РезультатПоискаДанныхЗаполнения[0];
				ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДанныхЗаполнения, РеквизитыТабличнойЧастиДляПерезаполнения[ИмяТЧ]);
				
				Если ИмяТЧ = "Товары" И ЕстьДанныеПрослеживаемости Тогда
					
					ОбновитьИдентификаторыСтрокПрослеживаемости(ДанныеДокумента, СтрокаДанныхЗаполнения.ИдентификаторСтроки, СтрокаДокумента.ИдентификаторСтроки);
					
					// В регламенте УКД нет данных о стране происхождения, поэтому заполним данными документа поступления.
					Если НЕ ЗначениеЗаполнено(СтрокаДокумента.СтранаПроисхождения) Тогда
						СтрокаДокумента.СтранаПроисхождения = СтрокаДокумента.СтранаПроисхожденияДоИзменения;
					КонецЕсли;
					
				КонецЕсли;
				
				// Удалим обработанную строку из данных заполнения
				ДанныеДокумента[ИмяТЧ].Удалить(СтрокаДанныхЗаполнения);
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Добавим новые строки в документ
		Если ДанныеДокумента[ИмяТЧ].Количество() > 0 Тогда
			
			Для Каждого СтрокаДанныхЗаполнения Из ДанныеДокумента[ИмяТЧ] Цикл
				
				НоваяСтрока = ДокументОбъект[ИмяТЧ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаполнения, , РеквизитыТабличнойЧастиДляЗаполненияНовойСтроки[ИмяТЧ]);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДанныеДокумента.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДокумента.ШтрихкодыУпаковок);
	КонецЕсли;
	
	Если ЕстьДанныеПрослеживаемости Тогда
		
		ЗаполнитьСведенияОПрослеживаемостиВходящегоКорректировочногоДокумента(
					ДокументОбъект.СведенияПрослеживаемости, 
					ДанныеДокумента.СведенияПрослеживаемости, 
					ДокументОбъект.Товары);
					
	КонецЕсли;
	
	ЗаполнитьСчетаУчетаПередЗаписьюДокумента(ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти

// Конструктор дополнительных параметров заполнения документа учета.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ЦенаВключаетНДС - Булево - Истина, если цена включает НДС.
//
Функция ОбщиеПараметрыЗаполненияДокументовУчета()
	
	Результат = Новый Структура;
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	
	Возврат Результат;
	
КонецФункции

Процедура ПерезаполнениеЗначенийРеквизитовШапки(ТекущийОбъект, ДанныеЗаполнения)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ОбъектМетаданных = ТекущийОбъект.Метаданные();
	
	Для Каждого Строка Из ДанныеЗаполнения Цикл
		
		Если ЗначениеЗаполнено(Строка.Ключ) И ЕстьРеквизитМетаданных(ОбъектМетаданных, Строка.Ключ) Тогда
			Если ТекущийОбъект[Строка.Ключ] <> Строка.Значение Тогда
				ТекущийОбъект[Строка.Ключ] = Строка.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСчетаУчетаПередЗаписьюДокумента(ДокументОбъект)
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
	СчетаУчетаВДокументах.ЗаполнитьПередЗаписью(ДокументОбъект, РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура ЗаполнитьЦенуСуммуПоСтроке(СтрокаТЧ, СтрокаЭД, ЦенаВключаетНДС)
	
	Если ЦенаВключаетНДС Тогда
		СтрокаТЧ.Сумма = СтрокаЭД.СуммаСНДС;
	Иначе
		СтрокаТЧ.Сумма = СтрокаЭД.СуммаБезНДС;
	КонецЕсли;
	
	ЕстьЦенаКоличество = ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТЧ, "Количество");
	
	// В некоторых табличных частях ПТУ количество и цена отсутствуют
	Если Не ЕстьЦенаКоличество Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЧ.Цена = СтрокаЭД.Цена;
	СтрокаТЧ.Количество = СтрокаЭД.Количество;
	
	Если Не ЦенаВключаетНДС Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаТЧ.Количество = 0 Тогда
		СтрокаТЧ.Цена = 0;
	Иначе
		СтрокаТЧ.Цена = СтрокаТЧ.Сумма / СтрокаТЧ.Количество;
	КонецЕсли;
	
КонецПроцедуры

// Находит ссылку на элемент справочника номеров ГТД по номеру таможенной декларации.
// Если подходящий элемент не найден, будет создан новый. Для заполнения его реквизитов
// будут использованы данные из номера таможенной декларации.
//
// Параметры:
//  НомерТаможеннойДекларации - Строка - номер таможенной декларации.
// 
// Возвращаемое значение:
//  СправочникСсылка.НомераГТД - если номер таможенной декларации не пустой;
//  Неопределено - если не указан номер таможенной декларации.
//
Функция НайтиСоздатьНомерГТД(НомерТаможеннойДекларации)
	
	Если Не ЗначениеЗаполнено(НомерТаможеннойДекларации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Ссылка = Справочники.НомераГТД.НайтиПоКоду(НомерТаможеннойДекларации);
	
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		
		Результат = Ссылка;
		
	Иначе
		
		Объект = Справочники.НомераГТД.СоздатьЭлемент();
		Объект.Код = НомерТаможеннойДекларации;
		Объект.Комментарий = НСтр("ru = 'Загружен из Диадок'");
		
		Объект.Записать();
		
		Результат = Объект.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на элемент справочника номеров ГТД, код которого
// соответствует первому номеру таможенной декларации из коллекции
// таможенных деклараций.
//
// Параметры:
//  ДанныеГТД - Массив - содержит структуры с ключами:
//    * СтранаПроисхождения - Структура - см. НовыйКлючевыеСвойстваСтранаМира;
//    * НомерГТД - Структура - см. НовыйКлючевыеСвойстваНомерГТД;
// 
// Возвращаемое значение:
//  СправочникСсылка.НомераГТД - если заполнены сведения грузовой таможенной декларации.
//  Неопределено - если не заполнены данные ГТД.
//
Функция НомерГТДИзСведенийТаможеннойДекларации(ДанныеГТД)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеГТД) Тогда
		
		Результат = ДанныеГТД[0].НомерГТД.Ссылка;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = НайтиСоздатьНомерГТД(ДанныеГТД[0].НомерГТД.РегистрационныйНомер);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НомерГТДИзСведенийПрослеживаемости(РегистрационныйНомер)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(РегистрационныйНомер) Тогда
		Результат = НайтиСоздатьНомерГТД(РегистрационныйНомер);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на страну мира, код которой соответствует коду из
// первого элемента коллекции сведений грузовой таможенной декларации.
//
// Параметры:
//  ДанныеГТД - Массив - содержит структуры с ключами:
//    * СтранаПроисхождения - Структура - см. НовыйКлючевыеСвойстваСтранаМира;
//    * НомерГТД - Структура - см. НовыйКлючевыеСвойстваНомерГТД;
//
// Возвращаемое значение:
//  СправочникСсылка.СтраныМира - если заполнены сведения грузовой таможенной декларации.
//  Неопределено - если не заполнены данные ГТД.
//
Функция СтранаПроисхожденияИзСведенийТаможеннойДекларации(ДанныеГТД)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеГТД) Тогда
		
		Результат = ДанныеГТД[0].СтранаПроисхождения.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОсновнойДоговорКонтрагента(Объект, Организация, Контрагент, Валюта = Неопределено)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Организация)
		ИЛИ НЕ ЗначениеЗаполнено(Контрагент) Тогда
		// Не заполнены ключевые свойства
		// В этом случае ничего не делаем.
		Возврат Результат;
	КонецЕсли;
	
	ГоловнаяОрганизация = ОбщегоНазначенияБПВызовСервераПовтИсп.ГоловнаяОрганизация(Организация);
	
	// Найдем договор по умолчанию для данного вида договора
	ДополнительныеПараметры = Новый Структура();
	Если ЗначениеЗаполнено(Валюта) Тогда
		ДополнительныеПараметры.Вставить("ВалютаВзаиморасчетов", Новый Структура("ЗначениеОтбора", Валюта));
	КонецЕсли;
	
	ВидДоговора = РаботаСДоговорамиКонтрагентовБП.ВидДоговораПоОбъекту(Объект);
	ВидыДоговоров = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВидДоговора);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(Результат, Контрагент, ГоловнаяОрганизация, ВидыДоговоров, ДополнительныеПараметры);
	
	Возврат Результат;
	
КонецФункции

Функция ОснованияКорректировкиПоступления(ИзвестныеЗначения)
	
	Результат = Новый Массив;
	
	ЗначенияПолейПоиска = Новый Структура;
	ЗначенияПолейПоиска.Вставить("Организация"	, ИзвестныеЗначения.Организация);
	ЗначенияПолейПоиска.Вставить("Контрагент"	, ИзвестныеЗначения.Контрагент);
	ЗначенияПолейПоиска.Вставить("НомерВходящегоДокумента"	, ИзвестныеЗначения.Номер);
	ЗначенияПолейПоиска.Вставить("ДатаВходящегоДокумента"	, ИзвестныеЗначения.Дата);
	
	ТипыОснованийКорректировки = Метаданные.Документы.КорректировкаПоступления.Реквизиты.ДокументПоступления.Тип.Типы();
	
	Для Каждого ТипОснования Из ТипыОснованийКорректировки Цикл 
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипОснования);
		
		ЕстьРеквизитыПоиска = Истина;
		Для Каждого Поле Из ЗначенияПолейПоиска Цикл 
			
			Если Не ЕстьРеквизитМетаданных(ОбъектМетаданных, Поле.Ключ) Тогда 
				ЕстьРеквизитыПоиска = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЕстьРеквизитыПоиска Тогда 
			Продолжить;
		КонецЕсли;
		
		НайденныйДокумент = СсылкаОбъектаПоПолямПоиска(ЗначенияПолейПоиска, ОбъектМетаданных);
		
		Если ЗначениеЗаполнено(НайденныйДокумент) Тогда 
			Результат.Добавить(НайденныйДокумент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоНоменклатураУслуга(Номенклатура)
	
