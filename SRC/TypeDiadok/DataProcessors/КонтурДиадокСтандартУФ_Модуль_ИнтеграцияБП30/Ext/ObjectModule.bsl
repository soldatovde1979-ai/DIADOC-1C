// Обработчик получения правила отражения электронного документа в учетной системе.
// Вызывается из Модуль_ИнтеграцияУниверсальный.ПравилоОбработкиЭлектронныхДокументов.
//
// Параметры:
//  ПравилоОбработки	 - Структура - описание способа обработки электронного документа (см. ПравилоОбработкиЭлектронныхДокументов);
//  СтандартнаяОбработка - Булево - Истина, если специальная обработка не требуется,
//                                  а идентификатор совпадает с именем метаданных документа;
//
// Пример:
//
//	Если ПравилоОбработки.Идентификатор = "ПоступлениеВПереработку" Тогда
//		
//		СтандартнаяОбработка = Ложь;
//		
//		ДополнительныеПараметры = Новый Структура;
//		ДополнительныеПараметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ВПереработку);
//		
//		ПравилоОбработки.Представление = "Поступление материалов в переработку";
//		ПравилоОбработки.ОбъектМетаданных = Метаданные.Документы.ПоступлениеТоваровУслуг.ПолноеИмя();
//		ПравилоОбработки.ДополнительныеПараметры = ДополнительныеПараметры;
//		
//	КонецЕсли;
//
Процедура ПриПолученииПравилаОбработкиЭлектронногоДокумента(ПравилоОбработки, СтандартнаяОбработка) Экспорт
	
	ИдентификаторПравила = ПравилоОбработки.Идентификатор;
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ВидыОпераций = Перечисления.ВидыОперацийПоступлениеТоваровУслуг;
	ПоступлениеТоваровУслуг = Метаданные.Документы.ПоступлениеТоваровУслуг.ПолноеИмя();
	
	СтандартнаяОбработка = Ложь;
	
	Если ИдентификаторПравила = ИдентификаторыПравил.ПоступлениеТоваровУслуг_Оборудование Тогда
		
		ПредставлениеОперации = "Поступление оборудования";
		ОбъектМетаданных = ПоступлениеТоваровУслуг;
		ВидОперации = ВидыОпераций.Оборудование;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.ПоступлениеТоваровУслуг_УслугиЛизинга Тогда
		
		ПредставлениеОперации = "Поступление услуг лизинга";
		ОбъектМетаданных = ПоступлениеТоваровУслуг;
		ВидОперации = ВидыОпераций.УслугиЛизинга;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.ПоступлениеТоваровУслуг_УслугиФакторинга Тогда
		
		ПредставлениеОперации = "Поступление услуг факторинга";
		ОбъектМетаданных = ПоступлениеТоваровУслуг;
		ВидОперации = ВидыОпераций.УслугиФакторинга;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.ПоступлениеТоваровУслуг_ОсновныеСредства Тогда
		
		ПредставлениеОперации = "Поступление основных средств";
		ОбъектМетаданных = ПоступлениеТоваровУслуг;
		ВидОперации = ВидыОпераций.ОсновныеСредства;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.ПоступлениеТоваровУслуг_ОбъектыСтроительства Тогда
		
		ПредставлениеОперации = "Поступление объектов строительства";
		ОбъектМетаданных = ПоступлениеТоваровУслуг;
		ВидОперации = ВидыОпераций.ОбъектыСтроительства;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.ОперацияСБилетом_Покупка Тогда
		
		ПредставлениеОперации = "Покупка билета";
		ОбъектМетаданных = Метаданные.Документы.ОперацияСБилетом.ПолноеИмя();
		ВидОперации = Перечисления.ВидыОперацийСБилетами.Покупка;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.ПоступлениеВЛизинг Тогда
		
		ПредставлениеОперации = "Поступление в лизинг";
		ОбъектМетаданных = Метаданные.Документы[ИмяДокументаПоступлениеВАрендуЛизинг()].ПолноеИмя();
		ВидОперации = Неопределено;
		
	ИначеЕсли ИдентификаторПравила = ИдентификаторыПравил.СчетНаОплату Тогда
		
		ПредставлениеОперации = "Счет на оплату";
		ОбъектМетаданных = Метаданные.Документы.СчетНаОплатуПоставщика;
		ВидОперации = Неопределено;
		
	Иначе
		
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
	Если Не СтандартнаяОбработка Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидОперации", ВидОперации);
		
		ПравилоОбработки.Представление = ПредставлениеОперации;
		ПравилоОбработки.ОбъектМетаданных = ОбъектМетаданных;
		ПравилоОбработки.ДополнительныеПараметры = ДополнительныеПараметры;
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.НовыйДокументИнформационнойБазы.
//
// Параметры:
//  ДокументОбъект		 - ДокументОбъект	 - новый, еще не записанный, документ-объект;
//  ДанныеЭД			 - Структура		 - содержит данные электронного документа
//                                             (см. Модуль_ИнтеграцияУниверсальный.ДанныеЭлектронногоДокумента);
//  ПараметрыЗаполнения	 - Структура		 - содержит дополнительные параметры заполнения;
//  СтандартнаяОбработка - Булево			 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриСозданииДокументаИнформационнойБазы(ДокументОбъект, ДанныеЭД, ПараметрыЗаполнения, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Если МетаданныеДокумента = Метаданные.Документы.ПоступлениеТоваровУслуг Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияТоваровУслуг(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеТоваровУслуг(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ПоступлениеДопРасходов Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияДопРасходов(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеДопРасходов(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.КорректировкаПоступления Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьКорректировкуПоступления(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СчетФактураПолученный Тогда
		
		ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			СтруктураЗаполнения = СтруктураЗаполненияКорректировочногоСчетаФактуры(ДанныеЭД, ПараметрыЗаполнения);
		Иначе
			СтруктураЗаполнения = СтруктураЗаполненияСчетаФактуры(ДанныеЭД, ПараметрыЗаполнения);
		КонецЕсли;
		
		ЗаполнитьСчетФактуруПолученный(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ВозвратТоваровОтПокупателя Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияВозвратаТоваровОтПокупателя(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьВозвратТоваровОтПокупателя(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ПоступлениеНМА Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияНМА(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеНМА(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы[ИмяДокументаПоступлениеВАрендуЛизинг()] Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияВЛизинг(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеВЛизинг(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ПоступлениеДенежныхДокументов Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияДенежныхДокументов(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеДенежныхДокументов(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ОперацияСБилетом Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияОперацииСБилетом(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьОперациюСБилетом(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.АктОРасхожденияхПолученный Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияАктаОРасхожденияхПолученного(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьАктОРасхожденияхПолученный(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.АктСверкиВзаиморасчетов Тогда
		
		Если ИспользуетсяАктСверкиВзаиморасчетов3_0_131() Тогда
			
			СтруктураЗаполнения = СтруктураЗаполненияАктаСверкиВзаиморасчетов3_0_131(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьАктСверкиВзаиморасчетов3_0_131(ДокументОбъект, СтруктураЗаполнения);
			
		Иначе
			
			СтруктураЗаполнения = СтруктураЗаполненияАктаСверкиВзаиморасчетов(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьАктСверкиВзаиморасчетов(ДокументОбъект, СтруктураЗаполнения);
			
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СчетНаОплатуПоставщика Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияСчетаНаОплатуПоставщика(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьСчетНаОплатуПоставщика(ДокументОбъект, СтруктураЗаполнения);
		
	Иначе
		
		// Специальная обработка заполнения не реализована
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

