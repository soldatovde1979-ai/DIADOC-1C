Процедура ЗаполнитьСтруктурированноеОписаниеАдреса(AddressContent, СведенияОбОрганизации, ЮрФизЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса = "")
	
	ЗначенияПолей = ?(ЮрАдрес, СведенияОбОрганизации.ЗначенияПолейЮридическийАдрес, СведенияОбОрганизации.ЗначенияПолейФактическийАдрес);
	
	Если Не ЗначениеЗаполнено(ЗначенияПолей) Тогда 
		
		ВладелецКИ		 = ХранилищеКонтактнойИнформацииОбъекта(ЮрФизЛицо);
		ВидАдреса		 = ПолучитьВидКИ(ВладелецКИ, Юрадрес);
		Адрес			 = АдресЮрФизЛица(ВладелецКИ, ВидАдреса, ДатаДокумента);
		ЗначенияПолей	 = Адрес.ЗначенияПолей;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначенияПолей) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураАдреса = СведенияОбАдресе(ЗначенияПолей);
	
	// Обертка для корректного заполнения адреса доставки (грузополучателя) по данным документа:
	// код страны определяем по фактическому адресу грузополучателя, а представление подставляем из документа
	Если ЗначениеЗаполнено(ПредставлениеАдреса) Тогда 
		СтруктураАдреса.СохраненноеПредставление = ПредставлениеАдреса;
	// используем пользовательское представление адреса	
	Иначе
		СтруктураАдреса.СохраненноеПредставление = ?(ЮрАдрес, СведенияОбОрганизации.ЮридическийАдрес, СведенияОбОрганизации.ФактическийАдрес);
	КонецЕсли;
	
	Заполнить_AddressInfo(AddressContent, СтруктураАдреса);
	
КонецПроцедуры

Функция ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(Организация)
	
	Возврат МетодСервера("Модуль_ИнтеграцияУниверсальный", "ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП", Организация);
	
КонецФункции

Функция СформироватьПредставлениеКонтрагентаДляАкта(Организация, ДатаОперации)
	
	СведенияОбОрганизации = РеквизитыЮрФизЛица(Организация, ДатаОперации);
	Возврат ОтрезатьПравуюЗапятую(ДобавитьРазделитель(СведенияОбОрганизации.ПолноеНаименование) + ДобавитьРазделитель(СведенияОбОрганизации.ИНН, "ИНН: ") + ДобавитьРазделитель(СведенияОбОрганизации.КПП, "КПП: "));
	
КонецФункции

Функция ПолучитьБанковскийСчетПоДокументу(ДокСсылка)
	
	Если (ДокСсылка.Метаданные().Реквизиты.Найти("СтруктурнаяЕдиница") <> Неопределено) И
		 ЗначениеЗаполнено(Докссылка.СтруктурнаяЕдиница) И
		 (ТипЗнч(Докссылка.СтруктурнаяЕдиница) = Тип("СправочникСсылка.БанковскиеСчета")) Тогда 
		Возврат Докссылка.СтруктурнаяЕдиница;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

// Формирует структуру с данными, которые необходимы для визуализации ПФ счета на оплату. 
// Табличный документ формируется средствами Диадок
//
// Параметры:
//  СчетНаОплату - ДокументСсылка	- документ, на основании которого формируем печатную форму 
// 
// Возвращаемое значение:
//   Структура
//
Функция РезультатВизуализацииСчетаНаОплатуСредствамиДиадок(ДокументСсылка, ПараметрыОтправкиНаСогласование =  Неопределено, ФИОПодписанта = "") Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокументСсылка);
	ТабличнаяЧасть	 = ПолучитьДанныеТЧ(ДокументСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТабличнаяЧасть);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТабличнаяЧасть);
	КонецЕсли;
	
	ТабДок	 = Новый ТабличныйДокумент;
	Макет	 = ОбработкаОбъект.ПолучитьМакет("СчетНаОплату");
	
	ЗаполнитьШапкуПечатнойФормыСчетаНаОплату(ТабДок, Макет
	, ДанныеШапки, ТабличнаяЧасть);
	
	ЗаполнитьТабличнуюЧастьПечатнойФормыСчетаНаОплату(ТабДок, Макет
	, ДанныеШапки, ТабличнаяЧасть);
	
	ЗаполнитьПодвалПечатнойФормыСчетаНаОплату(ТабДок, Макет
	, ДанныеШапки, ТабличнаяЧасть, ПараметрыОтправкиНаСогласование, ФИОПодписанта);
	
	ДатаДокумента		 = ДатаНомер.ДатаДокумента;
	НомерДокумента		 = ДатаНомер.НомерДокумента;
	СуммаДокумента		 = ДанныеШапки.СуммаДокумента;
	СуммаНДСДокумента	 = ДанныеШапки.СуммаНДСДокумента;
	ЕстьСтавкаБезНДС	 = ЕстьСтавкаБезНДСВТабличнойЧасти(ТабличнаяЧасть);
	
	ИмяФайла = ИмяФайлаПечатнойФормы("Счет", НомерДокумента, ДатаДокумента);
	
	Результат = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НовыйРезультатВизуализацииСчетаНаОплату");
	Результат.Таблица		 = ТабДок;
	Результат.СписокОшибок	 = "";
	Результат.ИмяФайла		 = ИмяФайла;
	Результат.Дата			 = ДатаДокумента;
	Результат.Номер			 = НомерДокумента;
	Результат.Сумма			 = СуммаДокумента;
	Результат.СуммаНДС		 = СуммаНДСДокумента;
	Результат.ДокументБезНДС = (ЕстьСтавкаБезНДС И СуммаНДСДокумента = 0);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьШапкуПечатнойФормыСчетаНаОплату(ТабличныйДокумент, Макет
	, ДанныеШапки
	, ТабличнаяЧасть)
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	ДатаДокумента = ДатаНомер.ДатаДокумента;
	НомерДокумента = ДатаНомер.НомерДокумента;
	
	БанковскийСчет		 = ДанныеШапки.БанковскийСчетОрганизации;
	РеквизитыОрганизации = РеквизитыПродавца(ДанныеШапки.Организация, ДатаДокумента, БанковскийСчет, ДанныеШапки.ОбособленноеПодразделение);
	РеквизитыПолучателя	 = РеквизитыЮрФизЛица(ДанныеШапки.ОрганизацияПолучатель, ДатаДокумента, БанковскийСчет);
	РеквизитыКонтрагента = РеквизитыЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	ШаблонПредставления = "НаименованиеДляПечатныхФорм,ИНН,КПП,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет";
	ПредставлениеОрганизации = ПредставлениеЮрФизЛица(РеквизитыОрганизации, ШаблонПредставления);
	ПредставлениеКонтрагента = ПредставлениеЮрФизЛица(РеквизитыКонтрагента, ШаблонПредставления);
	
	ЕстьСкидкаВТабличнойЧасти = ЕстьСкидкаВТабличнойЧасти(ТабличнаяЧасть);
	
	СтрокаЗаголовка = СтрШаблон(НСтр("ru = 'Счет на оплату № %1 от %2 '")
	, НомерДокумента, Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
	
	Область = Макет.ПолучитьОбласть("ШапкаСчета1");
	Если ЗначениеЗаполнено(РеквизитыПолучателя.Банк) Тогда
		Область.Параметры.БанкПолучателя		 = РеквизитыПолучателя.Банк;
		Область.Параметры.БИКБанкаПолучателя	 = РеквизитыПолучателя.БИК;
		Область.Параметры.СчетБанкаПолучателя	 = РеквизитыПолучателя.КоррСчет;
		Область.Параметры.СчетПолучателя		 = РеквизитыПолучателя.НомерСчета;
		Область.Параметры.ИННПолучателя			 = РеквизитыПолучателя.ИНН;
		Область.Параметры.КПППолучателя			 = РеквизитыПолучателя.КПП;
		Область.Параметры.Получатель			 = РеквизитыПолучателя.НаименованиеДляПечатныхФорм;
	КонецЕсли;
	ТабличныйДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ШапкаСчета2");
	Область.Параметры.Заголовок = СтрокаЗаголовка;
	ТабличныйДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ШапкаСчета3");
	Область.Параметры.Поставщик = ПредставлениеОрганизации;
	ТабличныйДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ШапкаСчета4");
	Область.Параметры.Покупатель = ПредставлениеКонтрагента;
	ТабличныйДокумент.Вывести(Область);
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки"));
	ТабличныйДокумент.Присоединить(Макет.ПолучитьОбласть("ШапкаТаблицы|Данные"));
	Если ЕстьСкидкаВТабличнойЧасти Тогда
		ТабличныйДокумент.Присоединить(Макет.ПолучитьОбласть("ШапкаТаблицы|Скидка"));
	КонецЕсли;
	ТабличныйДокумент.Присоединить(Макет.ПолучитьОбласть("ШапкаТаблицы|Сумма"));
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьПечатнойФормыСчетаНаОплату(ТабличныйДокумент, Макет
	, ДанныеШапки
	, ТабличнаяЧасть)
	
	ЕстьСкидкаВТабличнойЧасти = ЕстьСкидкаВТабличнойЧасти(ТабличнаяЧасть);
	
	// Подгоняем ширину табличной части под ширину заголовка и подвала
	ОбластьКолонкаТовар = Макет.Область("Товар");
	ОбластьКолонкаТовар.ШиринаКолонки = ОбластьКолонкаТовар.ШиринаКолонки + Макет.Область("КолонкаКодов").ШиринаКолонки;
	Если Не ЕстьСкидкаВТабличнойЧасти Тогда
		ОбластьКолонкаТовар.ШиринаКолонки = ОбластьКолонкаТовар.ШиринаКолонки + Макет.Область("Скидка").ШиринаКолонки;
	КонецЕсли;
	
	ОбластьНомерСтроки	 = Макет.ПолучитьОбласть("Строка|НомерСтроки");
	ОбластьДанные		 = Макет.ПолучитьОбласть("Строка|Данные");
	ОбластьСкидка		 = Макет.ПолучитьОбласть("Строка|Скидка");
	ОбластьСумма		 = Макет.ПолучитьОбласть("Строка|Сумма");
	НомерСтроки			 = 0;
	
	Для каждого Стр Из ТабличнаяЧасть Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ОбластьНомерСтроки.Параметры.НомерСтроки = НомерСтроки;
		ТабличныйДокумент.Вывести(ОбластьНомерСтроки);
		
		ОбластьДанные.Параметры.Цена			 = Стр.Цена;
		ОбластьДанные.Параметры.Товар			 = Стр.НоменклатураПредставление;
		ОбластьДанные.Параметры.Количество		 = Стр.Количество;
		ОбластьДанные.Параметры.ЕдиницаИзмерения = Строка(Стр.ЕдиницаИзмерения);
		ТабличныйДокумент.Присоединить(ОбластьДанные);
		
		Если ЕстьСкидкаВТабличнойЧасти Тогда
			ОбластьСкидка.Параметры.СуммаСкидки = Формат(Стр.СуммаСкидки, "ЧЦ=15; ЧДЦ=2");
			ТабличныйДокумент.Присоединить(ОбластьСкидка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.СуммаСкидки) Тогда
			СуммаСтроки = Стр.Сумма - Стр.СуммаСкидки;
		Иначе
			СуммаСтроки = Стр.Сумма;
		КонецЕсли;
		
		ОбластьСумма.Параметры.Сумма = СуммаСтроки;
		ТабличныйДокумент.Присоединить(ОбластьСумма);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПодвалПечатнойФормыСчетаНаОплату(ТабличныйДокумент, Макет
	, ДанныеШапки
	, ТабличнаяЧасть
	, ПараметрСогласования
	, ФИОПодписанта)
	
	СуммаСкидки			 = ДанныеШапки.СуммаСкидки;
	СуммаДокумента		 = ДанныеШапки.СуммаДокумента;
	СуммаНДСДокумента	 = ТабличнаяЧасть.Итог("СуммаНДС");
	
	ВалютаДокумента	 = ДанныеШапки.ВалютаДокумента;
	КодВалюты		 = ДанныеШапки.ВалютаДокументаКод;
	
	Если ДанныеШапки.ЦенаВключаетНДС Тогда
		СуммаИтого = СуммаДокумента;
	Иначе
		СуммаИтого = СуммаДокумента - СуммаНДСДокумента;
	КонецЕсли;
	
	ПараметрыИсчисления = МетодСервера("ПечатныеФормы", "ПараметрыИсчисленияВалюты", КодВалюты);
	СуммаИтогоПрописью = ЧислоПрописью(СуммаДокумента, , ПараметрыИсчисления);
	
	СтрокаПодвала = СтрШаблон(НСтр("ru = 'Всего наименований %1, на сумму %2 %3'")
	, ТабличнаяЧасть.Количество(), Формат(СуммаДокумента, "ЧЦ=15; ЧДЦ=2"), СокрП(ВалютаДокумента));
	
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Подвал"));
	
	Если ЗначениеЗаполнено(СуммаСкидки) Тогда 
		Область = Макет.ПолучитьОбласть("СкидкаПоДокументу");
		Область.Параметры.СуммаСкидки = СуммаСкидки;
		ТабличныйДокумент.Вывести(Область);
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("ПодвалИтого");
	Область.Параметры.Всего = СуммаИтого;
	ТабличныйДокумент.Вывести(Область);
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		
		СтрокаСуммыНДС = "-";
		НадписьСуммыНДС = "НДС исчисляется налоговым агентом";
		
	ИначеЕсли ЗначениеЗаполнено(СуммаНДСДокумента) Тогда
		
		СтрокаСуммыНДС = Формат(СуммаНДСДокумента, "ЧЦ=15; ЧДЦ=2");
		
		Если ДанныеШапки.ЦенаВключаетНДС Тогда
			НадписьСуммыНДС = "В том числе НДС:";
		Иначе
			НадписьСуммыНДС = "Сумма НДС:";
		КонецЕсли;
		
	Иначе
		СтрокаСуммыНДС = "-";
		НадписьСуммыНДС = "Без налога (НДС)";
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("ПодвалНДС");
	Область.Параметры.НДС		 = НадписьСуммыНДС;
	Область.Параметры.ВсегоНДС	 = СтрокаСуммыНДС;
	ТабличныйДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ПодвалИтогоКОплате");
	Область.Параметры.ИтогоКОплате = СуммаДокумента;
	ТабличныйДокумент.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ПодвалСуммаПрописью");
	Область.Параметры.ИтоговаяСтрока = СтрокаПодвала;
	Область.Параметры.СуммаПрописью = СуммаИтогоПрописью;
	ТабличныйДокумент.Вывести(Область);
	
	Если Не ЗначениеЗаполнено(ПараметрСогласования) Тогда
		ФИОРуководителя = ФИОПодписанта;
	ИначеЕсли ЗначениеЗаполнено(ПараметрСогласования.ФИОПодписанта) Тогда
		ФИОРуководителя = ПараметрСогласования.ФИОПодписанта;
	ИначеЕсли ЗначениеЗаполнено(ПараметрСогласования.ФИОПолучателя) Тогда
		ФИОРуководителя = ПараметрСогласования.ФИОПолучателя;
	Иначе
		ФИОРуководителя = "_";
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("ПодвалСчета");
	Область.Параметры.ФИОРуководителя = ФИОРуководителя;
	ТабличныйДокумент.Вывести(Область);
	
КонецПроцедуры

Функция ЕстьСтавкаБезНДСВТабличнойЧасти(ТабличнаяЧасть)
	
	Результат = Ложь;
	
	Для каждого Стр Из ТабличнаяЧасть Цикл
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьСкидкаВТабличнойЧасти(ТабличнаяЧасть)
	
	Результат = Ложь;
	
	Для каждого Стр Из ТабличнаяЧасть Цикл
		
		Если ЗначениеЗаполнено(Стр.СуммаСкидки) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеДляФормированияАктаСверки(ДокСсылка)
	
	ДанныеДляАктаСверки = Новый Структура();
	
	ДанныеДляАктаСверки.вставить("ДатаНачалаСверки", ДокСсылка.ДатаНачала);
	ДанныеДляАктаСверки.Вставить("ДатаокончанияСверки", ДокСсылка.Датаокончания);
	
	СведенияОбОрганизации    = РеквизитыЮрФизЛица(ДокСсылка.Организация, ДокСсылка.Дата);
	ДанныеДляАктаСверки.Вставить("ПредставлениеОрганизации", ПредставлениеЮрФизЛица(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,"));
	
	СведенияОКонтрагенте     = РеквизитыЮрФизЛица(ДокСсылка.Контрагент, ДокСсылка.Дата);
	ДанныеДляАктаСверки.Вставить("ПредставлениеКонтрагента", ПредставлениеЮрФизЛица(СведенияОКонтрагенте, "НаименованиеДляПечатныхФорм,"));
	
	ДанныеДляАктаСверки.Вставить("ПредставительОрганизации",  ПолучитьПредставителяОрганизацииДляАктаСверки(ДокСсылка));
	ДанныеДляАктаСверки.Вставить("ПредставительКонтрагента",  ПолучитьПредставителяКонтрагентаДляАктаСверки(ДокСсылка));
	
	ДанныеДляАктаСверки.вставить("ВалютаДокумента", ДокСсылка.ВалютаДокумента);
	ДанныеДляАктаСверки.вставить("МассивДанныхПоДоговорам",  ПолучитьДанныеТЧАктаСверки(ДокСсылка));
	
	ДанныеДляАктаСверки.Вставить("СальдоНачальное",  ДокСсылка.ОстатокНаНачало);
	ДанныеДляАктаСверки.Вставить("СверкаСогласована", ДокСсылка.СверкаСогласована);
	ДанныеДляАктаСверки.Вставить("Расхождение", ДокСсылка.Расхождение);
	
	Возврат ДанныеДляАктаСверки;
	
КонецФункции

Функция ПолучитьПредставителяОрганизацииДляАктаСверки(ДокСсылка)
	ПредставительОрганизации = Новый Структура;
	ДанныеПредставителя = ОбщегоНазначенияБПВызовСервера.ДанныеФизЛица(ДокСсылка.Организация, ДокСсылка.ПредставительОрганизации, ДокСсылка.Дата);
	
	ПредставительОрганизации.Вставить("ФИО", сокрЛП(строка(ДанныеПредставителя.Фамилия) + " " + ДанныеПредставителя.Имя + " " + ДанныеПредставителя.Отчество));
	ПредставительОрганизации.Вставить("Должность", Строка(ДанныеПредставителя.Должность));
	
	Возврат ПредставительОрганизации;
КонецФункции

Функция ПолучитьПредставителяКонтрагентаДляАктаСверки(ДокСсылка)
	ПредставительКонтрагента = Новый Структура;
	ПредставительКонтрагента.Вставить("ФИО", ДокСсылка.ПредставительКонтрагента.наименование);
	ПредставительКонтрагента.Вставить("Должность", ДокСсылка.ПредставительКонтрагента.Должность);
	
	Возврат ПредставительКонтрагента;
КонецФункции

Функция ПолучитьДанныеТЧАктаСверки(ДокСсылка)
	запрос = Новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.НомерСтроки,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Дата,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Документ,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Представление,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Дебет,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Кредит,
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Договор,
	|	Истина КАК ЭтоДанныеОрганизации
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.ПоДаннымОрганизации КАК АктСверкиВзаиморасчетовПоДаннымОрганизации
	|ГДЕ
	|	АктСверкиВзаиморасчетовПоДаннымОрганизации.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.НомерСтроки,
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Дата,
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Документ,
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Представление,
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Дебет,
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Кредит,
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Договор,
	|	Ложь
	|ИЗ
	|	Документ.АктСверкиВзаиморасчетов.ПоДаннымКонтрагента КАК АктСверкиВзаиморасчетовПоДаннымКонтрагента
	|ГДЕ
	|	АктСверкиВзаиморасчетовПоДаннымКонтрагента.Ссылка = &Ссылка"; 
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Выборка = запрос.Выполнить().Выбрать();
	МассивДанныхПоДоговорам = Новый Массив;
	
	Пока выборка.Следующий() Цикл 
		СтруктураДанныхПоДоговору = ПолучитьСтруктуруДанныхТекущегоДоговораАктаСверки(МассивДанныхПоДоговорам, ?(Докссылка.РазбитьПоДоговорам, Выборка.Договор, Неопределено) );
		ТаблицаДанных = ?(выборка.ЭтоДанныеОрганизации, СтруктураДанныхПоДоговору.ДанныеОрганизации,  СтруктураДанныхПоДоговору.ДанныеКонтрагента);
		стр = ТаблицаДанных.Добавить();
		Стр.Дата = выборка.Дата;
		Стр.представлениеДокумента = выборка.Представление;
		стр.Дебет = Выборка.Дебет;
		стр.Кредит = выборка.кредит;
	КонецЦикла;	 
	
	Возврат МассивДанныхПоДоговорам;
КонецФункции	

Функция ПолучитьСтруктуруДанныхТекущегоДоговораАктаСверки(МассивДанныхПоДоговорам, ДоговорСсылка)
	Для Каждого элемент Из МассивДанныхПоДоговорам Цикл 
		Если Элемент.ДоговорСсылка = ДоговорСсылка Тогда
			Возврат Элемент
		КонецЕсли;
	КонецЦикла;
	
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("ДанныеОрганизации", ИнициализироватьТЧДляСверки());
	СтруктураДанных.Вставить("ДанныеКонтрагента", ИнициализироватьТЧДляСверки());
	СтруктураДанных.Вставить("ДоговорСсылка"    , ДоговорСсылка);
	
	МассивДанныхПоДоговорам.Добавить(СтруктураДанных);
	
	Возврат СтруктураДанных;
КонецФункции

Функция ИнициализироватьТЧДляСверки()
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Дата");
	ТЗ.Колонки.Добавить("ПредставлениеДокумента");
	ТЗ.Колонки.Добавить("Дебет");
	ТЗ.Колонки.Добавить("Кредит");
	
	Возврат ТЗ;
КонецФункции		

Функция ПредставлениеПредставителяДляШапки(ПредставительОрганизации, ПредставлениеОрганизации)
	Возврат ?(ЗначениеЗаполнено(ПредставительОрганизации.Должность), ПредставительОрганизации.Должность, "представитель") +
	" " + ПредставлениеОрганизации + " " + ?(ЗначениеЗаполнено(ПредставительОрганизации.ФИО), ПредставительОрганизации.ФИО, "");
КонецФункции	

Функция ПредставлениеРезультатовСверки(ДатаОкончанияСверки, ПредставлениеОрганизации, ПредставлениеКонтрагента, ОрганизацияИтогСальдо, валютаДокумента)
	
	результат = "на " + формат(ДатаОкончанияСверки, "ДФ=dd.MM.yyyy") + " задолженность ";
	Если ОрганизацияИтогСальдо > 0 Тогда
		результат = результат + "в пользу " + ПредставлениеОрганизации + " " +
		РазвернутоеПредставлениеСуммы(ОрганизацияИтогСальдо, ВалютаДокумента);
	ИначеЕсли ОрганизацияИтогСальдо < 0 Тогда
		результат = результат + "в пользу " + ПредставлениеКонтрагента + " " +
		РазвернутоеПредставлениеСуммы(-ОрганизацияИтогСальдо, ВалютаДокумента);
	Иначе
		результат = результат +"отсутствует";
	КонецЕсли;
	
	Возврат результат;
	
КонецФункции

Функция РазвернутоеПредставлениеСуммы(Сумма, Валюта)
	Возврат  формат(Сумма, "ЧДЦ=2")+" "+Валюта+
	" (" + ЧислоПрописью(Сумма
							,
							,
							МетодСервера("ПечатныеФормы", "ПараметрыИсчисленияВалюты", Валюта.Код))
			+ ")"
КонецФункции

Функция ЕстьСтавкаБезНДС(ТабличнаяЧасть)
	
	НайденныеСтроки = ТабличнаяЧасть.НайтиСтроки(Новый Структура("СтавкаНДС", МенеджерИнтеграции_СтавкаБезНДС()));
	Результат = ЗначениеЗаполнено(НайденныеСтроки);
	
	Возврат Результат;
	
КонецФункции

Функция МетаДокументаСТабличнойЧастью(ДокументСсылка)
	
	Шапка = ДанныеШапки(ДокументСсылка);
	ТабличнаяЧасть = ПолучитьДанныеТЧ(ДокументСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	СуммаНДСДокумента	 = ТабличнаяЧасть.Итог("СуммаНДС");
	ЕстьСтавкаБезНДС	 = ЕстьСтавкаБезНДС(ТабличнаяЧасть);
	
	Мета = Новый Структура;
	Мета.Вставить("Дата", 			ДатаНомер.ДатаДокумента);
	Мета.Вставить("Номер", 			ДатаНомер.НомерДокумента);
	Мета.Вставить("Сумма", 			Шапка.СуммаДокумента);
	Мета.Вставить("СуммаНДС", 		СуммаНДСДокумента);
	Мета.Вставить("ДокументБезНДС", ЕстьСтавкаБезНДС И СуммаНДСДокумента = 0);
	
	Возврат Мета;
	
КонецФункции

Функция СформироватьМетуСчетаНаОплату(ДокументСсылка) Экспорт
	
	Возврат МетаДокументаСТабличнойЧастью(ДокументСсылка);
	
КонецФункции

Функция СформироватьМетуАктаВыполненныхРабот(ДокументСсылка) Экспорт
	
	Возврат МетаДокументаСТабличнойЧастью(ДокументСсылка);
	
КонецФункции

Функция СформироватьМетуАктаСверки(ДокументСсылка) Экспорт
	
	МетаАктаСверки=	Новый Структура;
	МетаАктаСверки.Вставить("Дата", 	ДокументСсылка.Дата);
	МетаАктаСверки.Вставить("Номер", 	ПредставлениеНомераОбъекта(ДокументСсылка));
	
	Возврат МетаАктаСверки;
	
КонецФункции

Функция СтруктурированноеПредставлениеОснования(ДокСсылка)
	
	ДоговорКонтрагента = ДокСсылка.ДоговорКонтрагента;
	
	Ground = Новый Структура;
	Ground.Вставить("GroundName", "");
	Ground.Вставить("GroundNumber", "");
	Ground.Вставить("GroundDate", "");
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Ground.Вставить("GroundName", 	ДоговорКонтрагента.Наименование);
		Ground.Вставить("GroundNumber", ДоговорКонтрагента.Номер);
		Ground.Вставить("GroundDate", 	ДоговорКонтрагента.Дата);
	КонецЕсли;
	
	Возврат  Ground;
	
КонецФункции

Функция СтруктурированноеПредставлениеОснованияУПД(ДокументСсылка, ДокументОснование)
	
	Результат = Новый Структура;
	Результат.Вставить("GroundName", 	"");
	Результат.Вставить("GroundNumber", 	"");
	Результат.Вставить("GroundDate", 	Дата(1, 1, 1));
	
	Результат.Вставить("ОснованиеСсылка");
	Результат.Вставить("ПредставлениеВТекстеОшибки", "основании");
	
	Договор	= Неопределено;
	
	Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(ДокументОснование), "ДоговорКонтрагента") Тогда 
		Договор	= ДокументОснование.ДоговорКонтрагента;
	ИначеЕсли МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(ДокументСсылка), "ДоговорКонтрагента") Тогда 
		Договор	= ДокументСсылка.ДоговорКонтрагента;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		
		Если НРег(Договор.Наименование) = НРег("Без договора") Тогда
			Возврат Результат;
		Иначе
			Результат.GroundName		= "Договор"; 	
			Результат.GroundNumber		= Договор.Номер;
			Результат.GroundDate		= Договор.Дата;
			Результат.ОснованиеСсылка	= Договор;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат  Результат;
	
КонецФункции

Процедура ЗаполнитьСведенияОПередаче(Content, ДокументСсылка, ФункцияУПД, ДопПараметры)
	
	КоллекцияДокументНосительОснования	= Новый Массив;
	
	ДобавленныеОснования = Новый Массив;
				
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "СЧФ" Тогда
		// в этом случае параметр ДокументСсылка это Счет фактура выданный
		Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактураВыданный.ТабличнаяЧасть.ДокументыОснования") Тогда
			Для Каждого СтрокаТЧ Из ДокументСсылка.ДокументыОснования Цикл
				КоллекцияДокументНосительОснования.Добавить(ДокументОтгрузки(СтрокаТЧ.ДокументОснование));	
			КонецЦикла;			
		Иначе
			Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(ДокументСсылка), "ДокументОснование") Тогда
				КоллекцияДокументНосительОснования.Добавить(ДокументОтгрузки(ДокументСсылка.ДокументОснование));
			КонецЕсли;					
		КонецЕсли;
		
	Иначе
		// в этом случае параметр ДокументСсылка это документ реализации
		КоллекцияДокументНосительОснования.Добавить(ДокументОтгрузки(ДокументСсылка));
	КонецЕсли;
	
	УказыватьОтсутствиеОснованияУПД = СвойствоСтруктуры(ДопПараметры, "УказыватьОтсутствиеОснованияУПД", Ложь);
	
	// если в конфигурации нет ФО "ВестиУчетПоДоговорам", то вернется значение Неопределено,
	// если такая ФО есть, то вернется ее значение типа Булево
	ВестиУчетПоДоговорам = МетодСервера(, "ПолучитьФункциональнуюОпциюНаСервере", "ВестиУчетПоДоговорам");
	
	// Добавляем реальные основания только в случаях, когда договор в документе заполняется пользователем:
	// 1 - если ФО "ВестиУчетПоДоговорам" в конфигурации нет,
	// 2 - если ФО "ВестиУчетПоДоговорам" в конфигурации есть и ее значение = Истина.
	// В противном случае основание передачи = "Отсутствует".
	Если ВестиУчетПоДоговорам <> Ложь Тогда
	
		Для Каждого ДокументМассива Из КоллекцияДокументНосительОснования Цикл
			
			СтруктураОснования = СтруктурированноеПредставлениеОснованияУПД(ДокументСсылка, ДокументМассива);
			
			Если ЗначениеЗаполнено(СтруктураОснования.GroundName) Тогда
				
				Если ДобавленныеОснования.Найти(СтруктураОснования.ОснованиеСсылка) = Неопределено Тогда
					
					ДобавленныеОснования.Добавить(СтруктураОснования.ОснованиеСсылка);
					
					TransferBase = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_TransferBase");
					Content.TransferInfo.TransferBases.Добавить(TransferBase);
					
					Если Не ЗначениеЗаполнено(СтруктураОснования.GroundDate) И УказыватьОтсутствиеОснованияУПД Тогда
						ЗаполнитьTransferBaseКакОтсутствует(TransferBase);
					Иначе
						ЗаполнитьTransferBaseПоДаннымОснования(TransferBase, СтруктураОснования);
					КонецЕсли;
					
					СлужебнаяИнформация = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НоваяСлужебнаяИнформацияОснованияПередачи");
					СлужебнаяИнформация.ОснованиеСсылка				= СтруктураОснования.ОснованиеСсылка;
					СлужебнаяИнформация.ПредставлениеВТекстеОшибки	= СтруктураОснования.ПредставлениеВТекстеОшибки;
					
					ДополнитьКонтентСтрокиОснованийПередачиСлужебнойИнформацией(TransferBase, СлужебнаяИнформация);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; // ВестиУчетПоДоговорам
	
	Если ДобавленныеОснования.Количество() = 0 Тогда
				
		TransferBase = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_TransferBase");
		Content.TransferInfo.TransferBases.Добавить(TransferBase);
		
		ЗаполнитьTransferBaseКакОтсутствует(TransferBase);
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьTransferBaseПоДаннымОснования(TransferBase, СтруктураОснования)
	
	TransferBase.DocumentName	= СтруктураОснования.GroundName;
	TransferBase.DocumentNumber	= СтруктураОснования.GroundNumber;
	TransferBase.DocumentDate	= СтруктураОснования.GroundDate;
	TransferBase.DocumentInfo	= "";
	
КонецПроцедуры

Процедура ЗаполнитьTransferBaseКакОтсутствует(TransferBase)
	
	TransferBase.DocumentName	= МетодСервера("Модуль_ИнтеграцияУниверсальный", "ДокументОснованиеОтгрузкиОтсутствует");
	TransferBase.DocumentNumber	= "";
	TransferBase.DocumentDate	= Дата(1, 1, 1);
	TransferBase.DocumentInfo	= "";

КонецПроцедуры

Процедура ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(OrganizationInfo, ЮрФизЛицо, ДатаДокумента, ПредставлениеАдреса = "")
	
	СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента);
	Если стрДлина(СведенияОбОрганизации.ИНН) <> 12 Тогда
		
		НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		ЭтоИП = Ложь;
		
	Иначе
		
		Если ТипЗнч(юрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
			//для нашей организации - данные берем из нормализованного представления физлица
			НаименованиеОрганизации = юрФизЛицо.наименованиеПолное;
		Иначе
			НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		КонецЕсли;
		
		ЭтоИП = Истина;
		
	КонецЕсли;
	
	OrganizationInfo.Name = НаименованиеОрганизации;
	OrganizationInfo.IsSoleProprietor = ЭтоИП;
	OrganizationInfo.SameAsSellerOrBuyer = Ложь;
	OrganizationInfo.Ссылка = ЮрФизЛицо;
	
	ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, Ложь, ДатаДокумента, ПредставлениеАдреса);
	
КонецПроцедуры

Функция ПолучитьГоловноеЮрлицо(ЮрФизЛицо)
	
	Результат = ЮрФизЛицо;
	
	Если ЭтоОбособленноеПодразделение(ЮрФизЛицо) Тогда 
		
		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
			ИмяРеквизита = "ГоловнойКонтрагент";
		Иначе 
			ИмяРеквизита = "ГоловнаяОрганизация";
		КонецЕсли;
		
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, ИмяРеквизита);
		
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

Процедура ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(OrganizationInfo, ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации = Неопределено,  ЮрАдрес, АдресДляСФ = Ложь, КППГрузоотправителя = "", ПредставлениеАдреса = "")

	СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации);
	
	ЗаполнитьИнформациюОбОрганизации(OrganizationInfo, СведенияОбОрганизации);
	ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса);
	
	OrganizationInfo.вставить("Ссылка", ЮрФизЛицо);

КонецПроцедуры

Процедура Заполнить_ExtendedOrganizationInfo(ExtendedOrganizationInfo, ЮрФизЛицо, ДатаДокумента, ЭтоПродавец, БанковскийСчет = Неопределено, КППГрузоотправителя = "", ОбособленноеПодразделение = Неопределено, ПредставлениеАдреса = "")
	
	Если ЭтоПродавец Тогда
		
		СведенияОбОрганизации = РеквизитыПродавца(ЮрФизЛицо, ДатаДокумента, БанковскийСчет, ОбособленноеПодразделение);
		ИсточникСведений = ?(ЗначениеЗаполнено(ОбособленноеПодразделение), ОбособленноеПодразделение, ЮрФизЛицо);
		
	ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
		
		СведенияОбОрганизации = РеквизитыГрузоотправителя(ЮрФизЛицо, ДатаДокумента, БанковскийСчет, ОбособленноеПодразделение);
		ИсточникСведений = ?(ЗначениеЗаполнено(ОбособленноеПодразделение), ОбособленноеПодразделение, ЮрФизЛицо);
		
	Иначе 
		
		СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчет);
		ИсточникСведений = ЮрФизЛицо;
		
	КонецЕсли;
	
	ExtendedOrganizationInfo.Вставить("Ссылка", ИсточникСведений); // Вероятно, используется в ПМ
	
	Если ЗначениеЗаполнено(КППГрузоотправителя) Тогда
		СведенияОбОрганизации.КПП = КППГрузоотправителя;
	КонецЕсли;
	
	ЗаполнитьИнформациюОбОрганизации(ExtendedOrganizationInfo, СведенияОбОрганизации);
	ЗаполнитьСтруктурированноеОписаниеАдреса(ExtendedOrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, ЭтоПродавец, ДатаДокумента, ПредставлениеАдреса);
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда 
		ExtendedOrganizationInfo.Okdp = ЮрФизЛицо.КодОКВЭД;
	КонецЕсли;
	
	Если СведенияОбОрганизации.ТипЮрФизЛица = ТипыЮрФизЛиц().ИндивидуальныйПредприниматель
		И ДатаДокумента >= ДатаРедакции425() Тогда
		
		ExtendedOrganizationInfo.IndividualEntityRegistrationCertificate = СтрокаНомерСВ_2026(
			СведенияОбОрганизации.ОГРН,
			СведенияОбОрганизации.ДатаРегистрации
		);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаРедакции425()
	
	Возврат '20260101';
	
КонецФункции

Функция СтрокаНомерСВ_2026(ОГРН, ДатаРегистрации)
	
	ШаблонСтрокиНомерСВ = "%1;%2";
	
	Результат = СтрШаблон(
		ШаблонСтрокиНомерСВ,
		ОГРН,
		ДатаСтрокойЛок(ДатаРегистрации)
	);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаСтрокойЛок(ДатаСтрока)
	
	ПустоеЗначение = "";
	
	Если ПустаяСтрока(ДатаСтрока) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Попытка
		Значение = Дата(ДатаСтрока);
	Исключение
		Значение = ДатаСтрока;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	
КонецФункции

