// Конструктор дополнительных параметров заполнения операции с билетом.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ВидОперации - ПеречислениСсылка.ВидыОперацийСБилетами - вид операции с билетом.
//   * ЦенаВключаетНДС - Булево - Истина, если цена включает НДС.
//
Функция ПараметрыЗаполненияОперацииСБилетом()
	
	Результат = ОбщиеПараметрыЗаполненияДокументовУчета();
	Результат.Вставить("ВидОперации", ВидОперацииСБилетомПоУмолчанию());
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияОперацииСБилетом(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияОперацииСБилетом();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	СтавкаНДС = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеЭД.ТоварнаяЧасть) Тогда
		
		СтрокаТЧ = ДанныеЭД.ТоварнаяЧасть[0];
		
		ПредставлениеСтавки = СтрокаТЧ.НоменклатураКонтрагента.СтавкаНДС;
		СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
	КонецЕсли;
	
	ИтогиТЧ = ДанныеЭД.Итоги;
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Сумма"		, ИтогиТЧ.СуммаСНДС);
	Шапка.Вставить("СуммаНДС"	, ИтогиТЧ.СуммаНДС);
	Шапка.Вставить("СтавкаНДС"	, СтавкаНДС);
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьОперациюСБилетом(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ВалютаРегламентированногоУчета());
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ЗаполнитьСчетаУчетаПередЗаписьюДокумента(ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область АктОрасхожденияхПолученный

Функция НайтиОснованиеДокументаОРасхождениях(Организация, ДатаДокумента, НомерДокумента)

	Результат = Неопределено;
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеПервичныхДокументов.Документ КАК СФ,
	|	ДанныеПервичныхДокументов.Документ.ДокументОснование КАК Документ
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
	|ГДЕ
	|	ДанныеПервичныхДокументов.Организация = &Организация
	|	И ДанныеПервичныхДокументов.Номер В(&НомерДокумента)
	|	И НАЧАЛОПЕРИОДА(ДанныеПервичныхДокументов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ТИПЗНАЧЕНИЯ(ДанныеПервичныхДокументов.Документ) = ТИП(Документ.СчетФактураВыданный)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеПервичныхДокументов.Документ,
	|	ТЧСФ.ДокументОснование
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный.ДокументыОснования КАК ТЧСФ
	|		ПО (ТЧСФ.Ссылка = ДанныеПервичныхДокументов.Документ)
	|ГДЕ
	|	ДанныеПервичныхДокументов.Организация = &Организация
	|	И ДанныеПервичныхДокументов.Номер В(&НомерДокумента)
	|	И НАЧАЛОПЕРИОДА(ДанныеПервичныхДокументов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ТИПЗНАЧЕНИЯ(ДанныеПервичныхДокументов.Документ) = ТИП(Документ.СчетФактураПолученный)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НЕОПРЕДЕЛЕНО,
	|	ДанныеПервичныхДокументов.Документ
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
	|ГДЕ
	|	ДанныеПервичныхДокументов.Организация = &Организация
	|	И ДанныеПервичныхДокументов.Номер В(&НомерДокумента)
	|	И НАЧАЛОПЕРИОДА(ДанныеПервичныхДокументов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ТИПЗНАЧЕНИЯ(ДанныеПервичныхДокументов.Документ) В (ТИП(Документ.РеализацияТоваровУслуг), ТИП(Документ.ВозвратТоваровПоставщику))";
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ДатаДокумента",	ДатаДокумента);
	Запрос.УстановитьПараметр("НомерДокумента",	НомерДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Документ;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ПараметрыЗаполненияАктаОРасхожденияхПолученного()
	
	Результат = Новый Структура;
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияАктаОРасхожденияхПолученного(ДанныеЭД, ДополнительныеПараметры)

	ПараметрыЗаполнения = ПараметрыЗаполненияАктаОРасхожденияхПолученного();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	
	Товары = Документы.АктОРасхожденияхПолученный.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	Услуги = Документы.АктОРасхожденияхПолученный.ПустаяСсылка().Услуги.ВыгрузитьКолонки();
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Участники сделки
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	
	// Валюта, суммы
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Даты, номера
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	// Основание документа о расхождениях
	Организация		= Шапка.Организация;
	ДатаДокумента	= НачалоДня(ДанныеЭД.Шапка.Основание.Дата);
	НомерДокумента	= ДанныеЭД.Шапка.Основание.Номер;
	
	ДокументОснование = НайтиОснованиеДокументаОРасхождениях(Организация, ДатаДокумента, НомерДокумента);
		
	ДополнитьПараметрыЗаполненияАктаОРасхожденияхПоДокументуОснованию(ДокументОснование, Шапка);
	
	// Табличная часть
	ИспользуетсяОбратноеНачислениеНДС = ИспользуетсяОбратноеНачислениеНДС();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		ЭтоУслуга = ЭтоНоменклатураУслуга(НоменклатураИБ.Номенклатура);
		
		Если ЭтоУслуга Тогда 
			НоваяСтрока = Услуги.Добавить();
			НоваяСтрока.СодержаниеДоИзменения = НоменклатураКонтрагента.Наименование;
			НоваяСтрока.Содержание            = НоменклатураКонтрагента.Наименование;
		Иначе 
			НоваяСтрока = Товары.Добавить();
		КонецЕсли;
		
		НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		Если МенеджерИнтеграции_ЭтоСтавкаНДСИНА(ПредставлениеСтавки) Тогда
			
			Если ИспользуетсяОбратноеНачислениеНДС Тогда
				
				НоваяСтрока.СтавкаНДС = МенеджерИнтеграции_ОбщаяСтавкаНДС(ШапкаЭД.Дата);
				
				НоваяСтрока.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
					Стр.СуммаБезНДС,
					Ложь,
					УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
				    
				НоваяСтрока.СуммаНДСПоДокументу = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
					Стр.СуммаБезНДС_До,
					Ложь,
					УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
				
			Иначе
				
				НоваяСтрока.СтавкаНДС = Неопределено;
				НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
				НоваяСтрока.СуммаНДСПоДокументу = Стр.СуммаНДС_До;
				
			КонецЕсли;
			
		Иначе 
			
			НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
			НоваяСтрока.СуммаНДСПоДокументу = Стр.СуммаНДС_До;
			
		КонецЕсли;
		
		НоваяСтрока.Количество = Стр.Количество;
		НоваяСтрока.Цена = Стр.Цена;
		НоваяСтрока.Сумма = Стр.СуммаСНДС;
		
		НоваяСтрока.КоличествоПоДокументу = Стр.Количество_До;
		НоваяСтрока.ЦенаПоДокументу = Стр.Цена_До;
		НоваяСтрока.СуммаПоДокументу = Стр.СуммаСНДС_До;
		
		Если Шапка.СуммаВключаетНДС Тогда
			
			// Включаем НДС в сумму
			НоваяСтрока.СуммаПоДокументу = НоваяСтрока.СуммаПоДокументу + НоваяСтрока.СуммаНДСПоДокументу;
			
			// Пересчитаем цену
			РасчетноеКоличество = ?(НоваяСтрока.КоличествоПоДокументу = 0, 1, НоваяСтрока.КоличествоПоДокументу);
			НоваяСтрока.ЦенаПоДокументу = НоваяСтрока.СуммаПоДокументу / РасчетноеКоличество;
			
		КонецЕсли;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке);
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Товары"	, Товары);
	ДанныеОбъекта.Вставить("Услуги"	, Услуги);
	ДанныеОбъекта.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеОбъекта;

КонецФункции

Процедура ЗаполнитьАктОРасхожденияхПолученный(ДокументОбъект, ДанныеДокумента)

	ДанныеЗаполнения = ДанныеДокумента.Шапка;
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеЗаполнения);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументРеализации = ДокументОбъект.ДокументРеализации;
	Если Не ЗначениеЗаполнено(ДокументРеализации) И ДанныеЗаполнения.Свойство("Основание") Тогда
		ДокументРеализации = ДанныеЗаполнения.Основание;
	КонецЕсли;
	
	// Заполним корректировку поступления данными основания
	Если ЗначениеЗаполнено(ДокументРеализации) Тогда
		ДокументОбъект.Заполнить(ДокументРеализации);
	КонецЕсли;
	
	// Заполним табличные части данными корректировки
	ИменаТЧСтрокой = "Товары, Услуги";
	
	ИменаТЧ = Новый Массив;
	ИменаТЧ.Добавить("Товары");
	ИменаТЧ.Добавить("Услуги");
	
	РеквизитыТабличнойЧастиДляПерезаполнения = Новый Структура(ИменаТЧСтрокой);
	РеквизитыТабличнойЧастиДляПерезаполнения.Товары = "Количество, Цена, Сумма, СуммаНДС, НомерГТД, СтранаПроисхождения";
	РеквизитыТабличнойЧастиДляПерезаполнения.Услуги = "Количество, Цена, Сумма, СуммаНДС, Содержание";
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		
		ИмяТЧ = СокрЛП(ИмяТЧ);
		
		СтруктураПоиска = Новый Структура("Номенклатура, СтавкаНДС");
		
		Для Каждого СтрокаДокумента Из ДокументОбъект[ИмяТЧ] Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
			РезультатПоискаДанныхЗаполнения = ДанныеДокумента[ИмяТЧ].НайтиСтроки(СтруктураПоиска);
			
			Если РезультатПоискаДанныхЗаполнения.Количество() > 0 Тогда
				
				СтрокаДанныхЗаполнения = РезультатПоискаДанныхЗаполнения[0];
				ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДанныхЗаполнения, РеквизитыТабличнойЧастиДляПерезаполнения[ИмяТЧ]);
				
				// Удалим обработанную строку из данных заполнения
				ДанныеДокумента[ИмяТЧ].Удалить(СтрокаДанныхЗаполнения);
				
			КонецЕсли;
			
			СтрокаДокумента.ЕстьВДокументеРеализации = Истина;
			
		КонецЦикла;
		
		// Добавим новые строки в документ
		Если ДанныеДокумента[ИмяТЧ].Количество() > 0 Тогда
			
			Для Каждого СтрокаДанныхЗаполнения Из ДанныеДокумента[ИмяТЧ] Цикл
				
				НоваяСтрока = ДокументОбъект[ИмяТЧ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаполнения);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДанныеДокумента.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДокумента.ШтрихкодыУпаковок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьПараметрыЗаполненияАктаОРасхожденияхПоДокументуОснованию(ДокументОснование, Шапка)

	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Шапка.Вставить("Основание", ДокументОснование);
	Шапка.СуммаВключаетНДС = РазрешенноеЗначениеРеквизитаОбъекта(ДокументОснование, "СуммаВключаетНДС");

КонецПроцедуры

#КонецОбласти

#Область АктСверкиВзаиморасчетов3_0_131

Функция СтруктураЗаполненияАктаСверкиВзаиморасчетов3_0_131(ДанныеЭД, ДополнительныеПараметры)
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Стороны сверки
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Получатель));
	Шапка.Вставить("Контрагент", СсылкаНаУчастникаСделки(ШапкаЭД.Отправитель));
	
	// Валюта
	Шапка.Вставить("ВалютаДокумента", ШапкаЭД.Валюта.Ссылка);
	
	// Даты, номера, суммы
	ОстатокНаНачалоПоДаннымКонтрагента = ИтогиЭД.СальдоНачДеб - ИтогиЭД.СальдоНачКр;
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента", ШапкаЭД.Дата);
	Шапка.Вставить("ЭтоЭлектронныйДокумент", Истина);
	Шапка.Вставить("ЭтоДокументКонтрагента", Истина);
	Шапка.Вставить("РазбитьПоДоговорам", Истина);
	Шапка.Вставить("ДатаНачала", ШапкаЭД.ДатаНачала);
	Шапка.Вставить("ДатаОкончания", ШапкаЭД.ДатаОкончания);
	Шапка.Вставить("ОстатокНаНачалоПоДаннымКонтрагента", ОстатокНаНачалоПоДаннымКонтрагента);
	
	ТаблицаПоДаннымКонтрагента = Документы.АктСверкиВзаиморасчетов.ПустаяСсылка().ПоДаннымКонтрагента.ВыгрузитьКолонки();
	
	// Табличная часть ПоДаннымКонтрагента
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.Договор = ДоговорПоСтрокеАктаСверки(Шапка, СтрокаДоговора);
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.НаименованиеОперации = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.НаименованиеДокумента = СтрокаДокумента.Наименование;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				СтрокаПоДаннымКонтрагента.НомерДокумента = СтрокаДокумента.Номер;
				СтрокаПоДаннымКонтрагента.ДатаДокумента = СтрокаДокумента.Дата;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьАктСверкиВзаиморасчетов3_0_131(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	Документы.АктСверкиВзаиморасчетов.ЗаполнитьАктСверкиПоДаннымИБ(ДокументОбъект);
	ДокументОбъект.ПоДаннымКонтрагента.Загрузить(ДанныеДокумента.ПоДаннымКонтрагента);
	Документы.АктСверкиВзаиморасчетов.СопоставитьДанныеОрганизацииИКонтрагента(ДокументОбъект);
	
	Если ИспользуетсяУстановкаСтатусаСверки() Тогда
		
		УстановитьСтатусАктаСверкиВзаиморасчетов(ДокументОбъект);
		
	Иначе
		
		ДокументОбъект.СверкаСогласована = НЕ ДокументОбъект.ЕстьРасхождения;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьСтатусАктаСверкиВзаиморасчетов(ДокументОбъект)
	
	СверкаСогласована = Не ДокументОбъект.ЕстьРасхождения;
	
	ЗначениеСтатусАктаСверки = Перечисления.СтатусыДокументовРеализации.Подписан;
	
	Если НЕ СверкаСогласована Тогда
		ЗначениеСтатусАктаСверки = Перечисления.СтатусыДокументовРеализации.НеПодписан;
	КонецЕсли;
	
	СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
	СтатусыДокумента.Статус = ЗначениеСтатусАктаСверки;
	
	РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокумента(ДокументОбъект.Ссылка, СтатусыДокумента);
	
КонецПроцедуры

Функция ДоговорПоСтрокеАктаСверки(ДанныеДокумента, РеквизитыДоговора)
	
	ОтборПоВалюте = Новый Структура("ЗначениеОтбора", ДанныеДокумента.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	
	Если РеквизитыДоговора.Описание = "С покупателем" Тогда
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ИначеЕсли РеквизитыДоговора.Описание = "С поставщиком" Тогда
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Иначе
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	КонецЕсли;
		
	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДоговорКонтрагента,
		ДанныеДокумента.Контрагент, ДанныеДокумента.Организация, СписокВидовДоговоров, СтруктураПараметров);
		
	Возврат ДоговорКонтрагента;
	
КонецФункции

#КонецОбласти

#Область АктСверкиВзаиморасчетов

Функция СтруктураЗаполненияАктаСверкиВзаиморасчетов(ДанныеЭД, ДополнительныеПараметры)
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Стороны сверки
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Получатель));
	Шапка.Вставить("Контрагент", СсылкаНаУчастникаСделки(ШапкаЭД.Отправитель));
	
	// Валюта
	Шапка.Вставить("ВалютаДокумента", ШапкаЭД.Валюта.Ссылка);
	
	// Даты сверки, суммы
	ОстатокНаНачало = ИтогиЭД.СальдоНачДеб - ИтогиЭД.СальдоНачКр;
	
	Шапка.Вставить("ДатаНачала", ШапкаЭД.ДатаНачала);
	Шапка.Вставить("ДатаОкончания", ШапкаЭД.ДатаОкончания);
	Шапка.Вставить("ОстатокНаНачало", ОстатокНаНачало);
	
	ТаблицаПоДаннымКонтрагента = Документы.АктСверкиВзаиморасчетов.ПустаяСсылка().ПоДаннымКонтрагента.ВыгрузитьКолонки();
	
	// Табличная часть ПоДаннымКонтрагента
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.Договор = ДоговорПоСтрокеАктаСверки(Шапка, СтрокаДоговора);
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.Представление = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьАктСверкиВзаиморасчетов(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(
		ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент,
		ДокументОбъект.Организация
	);
	
	МенеджерОбъекта = Документы.АктСверкиВзаиморасчетов;
	
	ДокументОбъект.ПредставительОрганизации = МенеджерОбъекта.ПредставительОрганизации(ДокументОбъект.Организация, ДокументОбъект.Дата);
	ДокументОбъект.ПредставительКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Контрагент, "ОсновноеКонтактноеЛицо");
	
	ДокументОбъект.РазбитьПоДоговорам = Истина;
	
	ДокументОбъект.ПоДаннымКонтрагента.Загрузить(ДанныеДокумента.ПоДаннымКонтрагента);
	
	ЗаполнитьСчетамиПоУмолчаниюНаСервере(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьСчетамиПоУмолчаниюНаСервере(ДокументОбъект)

	ТаблицаСчетов = УчетВзаиморасчетов.ПолучитьТаблицуСчетовУчетаВзаиморасчетов(Истина, Ложь);
	ТаблицаСчетов.Колонки.СчетРасчетов.Имя = "Счет";
	ТаблицаСчетов.Колонки.Добавить("УчаствуетВРасчетах");
	ТаблицаСчетов.ЗаполнитьЗначения(Истина, "УчаствуетВРасчетах");
	
	ДокументОбъект.СписокСчетов.Загрузить(ТаблицаСчетов);
	
КонецПроцедуры

