Функция ПолучитьСФОснованиеПоИСФ_КСФ(ИСФ_КСФ) Экспорт
	
	ДокОснование= ИСФ_КСФ.ДокументыОснования[0].ДокументОснование;
	Если ДокОснование.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда 
		ДокОснование= ДокОснование.ДокументРеализации;
	Иначе 	
		Пока  ТипЗнч(ДокОснование) = Тип("ДокументСсылка.КорректировкаРеализации") 
			И ДокОснование.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Цикл 
			
			ДокОснование= ДокОснование.ДокументРеализации;
			
		КонецЦикла;
	КонецЕсли;	
	
	Запрос= Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
        |	СчетФактураВыданныйДокументыОснования.Ссылка
        |ИЗ
        |	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
        |ГДЕ
		|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
		|	И СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления = ЛОЖЬ";
        			
	Запрос.УстановитьПараметр("Документоснование", ДокОснование);
	Выборка= Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Неопределено;

КонецФункции

Функция ПолучитьДанныеДляФормированияУПД(ДокСсылка, ПараметрыФормирования)
	
	ФункцияУПД = ПараметрыФормирования.ФункцияДокумента; 
	
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "СЧФ" Тогда
		
		ДанныеДляФормированияСчетФактуры = СформироватьДанныеДляПечати(ДокСсылка, Ложь);
		
		ДанныеДляФормированияУПД = Новый Структура("ДанныеШапки", Новый Структура);
		
		Для Каждого КлючИЗначение Из ДанныеДляФормированияСчетФактуры Цикл
			
			Если КлючИЗначение.Ключ = "ТабличнаяЧасть" Тогда
				ДанныеДляФормированияУПД.Вставить("ТаблицаТоваров", КлючИЗначение.Значение);
			Иначе
				ДанныеДляФормированияУПД.ДанныеШапки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("СчетФактураСсылка", ДокСсылка);
		
		ТаблицаНакладных = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокСсылка);
		Если ЗначениеЗаполнено(ТаблицаНакладных) Тогда
			Если ФункцияУПД = "СЧФДОП" Тогда
				ДокРеализации = ПолучитьИсправляемыйДокументРеализации(ТаблицаНакладных[0].Ссылка);
				ДанныеДляФормированияУПД.ДанныеШапки.Вставить("ДатаОтгрузки", ДокРеализации.Дата);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Шапка			 = ДанныеШапки(ДокСсылка);
		ДокументОтгрузки = ДокументОтгрузки(ДокСсылка);
		ТабличнаяЧасть	 = ПолучитьДанныеТЧ(ДокументОтгрузки, , , , Ложь);
		ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
		//ЗаполнитьДанныеОбособленногоПодразделения(ДокСсылка, Шапка, Ложь);
		
		Если Шапка.НДСИсчисляетсяНалоговымАгентом Тогда
			МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТабличнаяЧасть);
		КонецЕсли;
		
		ДанныеДляФормированияУПД = Новый Структура;
		ДанныеДляФормированияУПД.Вставить("ДанныеШапки", Шапка);
		ДанныеДляФормированияУПД.Вставить("ТаблицаТоваров", ТабличнаяЧасть);
		
	КонецЕсли;
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("Функция", "InvoiceAndBasic");
	ИначеЕсли ФункцияУПД = "ДОП" Тогда
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("Функция", "Basic");
	ИначеЕсли ФункцияУПД = "СЧФ" Тогда
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("Функция", "Invoice");
	КонецЕсли;
	ДанныеДляФормированияУПД.ДанныеШапки.Вставить("ДатаНомерСвидетельстваОРегистрации", ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляФормированияУПД.ДанныеШапки.Организация));
	
	Возврат ДанныеДляФормированияУПД;
	
КонецФункции

Функция ДанныеДляФормированияУКД(ДокСсылка, ДопПараметры)
	
	Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "КСЧФ" Тогда
		
		СчетФактура 	 = ДокСсылка;
		ТаблицаНакладных = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокСсылка);
		Накладная		 = ТаблицаНакладных[0].Ссылка;
		
	Иначе
		
		СчетФактура = Неопределено;
		Накладная	= ДокументОтгрузки(ДокСсылка);
		
		ТаблицаНакладных = Новый ТаблицаЗначений;
		ТаблицаНакладных.Колонки.Добавить("Ссылка");
		ТаблицаНакладных.Колонки.Добавить("Дата");
		ТаблицаНакладных.Колонки.Добавить("Договор");
		
		НоваяСтрока = ТаблицаНакладных.Добавить();
		НоваяСтрока.Ссылка  = Накладная;
		НоваяСтрока.Дата  	= Накладная.Дата;
		НоваяСтрока.Договор = Накладная.ДоговорКонтрагента;
		
	КонецЕсли;
	
	СписокДокументыОснования = Новый СписокЗначений;
	СписокДокументыОснования.ЗагрузитьЗначения(ТаблицаНакладных.ВыгрузитьКолонку("Ссылка"));
	
	Шапка			 = ДанныеШапки(ДокСсылка);
	ТабличнаяЧасть	 = ПолучитьДанныеТЧ(СписокДокументыОснования, Истина, , , Ложь, СчетФактура);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	СписокДокументыОснования = Неопределено;
	
	Шапка.Вставить("Функция", ?(ДопПараметры.ФункцияУПД = "КСЧФДИС", "InvoiceAndBasic", ?(ДопПараметры.ФункцияУПД = "КСЧФ", "Invoice", "Basic")));
	
	Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "ДИС" Тогда
		ДатаУведомления = ТаблицаНакладных[0].Дата;
		Если ДатаУведомления <> Шапка.ДатаНомерДокумента.ДатаДокумента Тогда
			Шапка.Вставить("ДатаУведомления", ДатаУведомления);
		КонецЕсли;
	КонецЕсли;
	
	Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(Накладная), "СопроводительныеДокументы") Тогда
		Шапка.Вставить("ИныеСведенияОбИзмененииСтоимости", Накладная.СопроводительныеДокументы);
	КонецЕсли;
	
	ДобавленныеПередаточныеДокументы	= Новый Соответствие;
	
	ТипПередаточногоДокумента = "УПД ";
	
	Шапка.Вставить("ОснованияПередачи", Новый Массив);
	Шапка.Вставить("ПередаточныеДокументы", Новый Массив);
	Шапка.Вставить("РеквизитыПередаточныхДокументов", Новый Массив);
	
	ДобавленныеОснования = Новый Соответствие;
	
	Для Каждого СтрокаТЗ Из ТаблицаНакладных Цикл
		
		СтруктураОснования = ЗаполнитьСтруктуруОснования(СтрокаТЗ.Договор, Истина);
	
		Если ЗначениеЗаполнено(СтруктураОснования.GroundDate) И ЗначениеЗаполнено(СтруктураОснования.GroundName) Тогда
			
			Если ДобавленныеОснования[СтруктураОснования.Основание] <> Истина Тогда
				
				ДобавленныеОснования.Вставить(СтруктураОснования.Основание, Истина);
				
				ItemCorrectionBases = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CorrectionBase");
				ItemCorrectionBases.BaseDocumentName   = СтруктураОснования.GroundName;
				ItemCorrectionBases.BaseDocumentNumber = СокрЛП(СтруктураОснования.GroundNumber);
				ItemCorrectionBases.BaseDocumentDate   = СтруктураОснования.GroundDate;
				
				Шапка.ОснованияПередачи.Добавить(ItemCorrectionBases);
				
			КонецЕсли;
			
		КонецЕсли;
	
		ИсправляемыйДокументРеализации = ПолучитьИсправляемыйДокументРеализации(СтрокаТЗ.Ссылка);
		Если ТипЗнч(ИсправляемыйДокументРеализации) = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров") Тогда
			
			СФВыданный = ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ИсправляемыйДокументРеализации);
			
			Если СФВыданный <> Неопределено Тогда
				ПередаточныйДокумент = СФВыданный;
			Иначе
				ПередаточныйДокумент = ИсправляемыйДокументРеализации;
			КонецЕсли;
			
		ИначеЕсли ДопПараметры.ФункцияУПД = "КСЧФДИС" Или ДопПараметры.ФункцияУПД = "КСЧФ" Тогда 
			
			ПередаточныйДокумент = ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ИсправляемыйДокументРеализации);
			
		Иначе
			ПередаточныйДокумент = ИсправляемыйДокументРеализации;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПередаточныйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		
		Шапка.ПередаточныеДокументы.Добавить(ПередаточныйДокумент);
		
		Если ДобавленныеПередаточныеДокументы[ПередаточныйДокумент] <> Истина Тогда
			
			ДобавленныеПередаточныеДокументы.Вставить(ПередаточныйДокумент, Истина);
			
			Новый_BaseDocument = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_BaseDocumentName");
			
			Новый_BaseDocument.BaseDocumentName		= ТипПередаточногоДокумента;
			Новый_BaseDocument.BaseDocumentNumber 	= ПредставлениеНомераОбъекта(ПередаточныйДокумент);
			Новый_BaseDocument.BaseDocumentDate 	= Формат(ПередаточныйДокумент.Дата, "ДФ=dd.MM.yyyy");
			
			Шапка.РеквизитыПередаточныхДокументов.Добавить(Новый_BaseDocument);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Шапка.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТабличнаяЧасть);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", 			Шапка);
	Результат.Вставить("ТабличнаяЧасть", 	ТабличнаяЧасть);
	
	Возврат Результат;
	
КонецФункции

// Вызывается из Модуль_ИнтеграцияУниверсальный.ЗаполнитьОбстФормСЧФ820.
//
// Параметры:
//  СчетФактура			 - ДокументСсылка.СчетФактураВыданный	 - счет фактура на основании которой вычисляется ОбстФормСЧФ;
//
// Возвращаемое значение:
//  Строка - вычисленное значение ОбстФормСЧФ
//
Функция ПолучитьОбстоятельствоФормированияСчетФактуры(СчетФактура) Экспорт

	Результат		 = Неопределено;
	
	КонстантаОсуществляетсяРеализацияТоваровУслугЧерезКомиссионеров = Ложь;
	Если МетодСервера(, "ЕстьМетаданныеКонфигурации_ДД", "Константы.ОсуществляетсяРеализацияТоваровУслугЧерезКомиссионеров") Тогда
		КонстантаОсуществляетсяРеализацияТоваровУслугЧерезКомиссионеров = Константы.ОсуществляетсяРеализацияТоваровУслугЧерезКомиссионеров.Получить();
	КонецЕсли;
	
	КонстантаОсуществляетсяРеализацияТоваровУслугКомитентов = Ложь;
	Если МетодСервера(, "ЕстьМетаданныеКонфигурации_ДД", "Константы.ОсуществляетсяЗакупкаТоваровУслугДляКомитентов") Тогда
		КонстантаОсуществляетсяРеализацияТоваровУслугКомитентов = Константы.ОсуществляетсяЗакупкаТоваровУслугДляКомитентов.Получить();
	КонецЕсли;
	
	ВозможноЗаполнение = КонстантаОсуществляетсяРеализацияТоваровУслугКомитентов ИЛИ КонстантаОсуществляетсяРеализацияТоваровУслугЧерезКомиссионеров;
	
	Если ВозможноЗаполнение Тогда
		
		ДоговорКонтрагента = МетодСервера(, "ЗначениеРеквизитаОбъекта", СчетФактура, "ДоговорКонтрагента");
		
		Если НЕ ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
			
			ДокументОснование = ДокументОснованиеСчетаФактуры(СчетФактура);
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				МетодСервера( , "ЕстьРеквизитИлиСвойствоОбъектаЛок", ДокументОснование, "ДоговорКонтрагента", ДоговорКонтрагента);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		
			ВидДоговора = МетодСервера(, "ЗначениеРеквизитаОбъекта", ДоговорКонтрагента, "ВидДоговора");
			
			Если КонстантаОсуществляетсяРеализацияТоваровУслугЧерезКомиссионеров
				И ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером") Тогда
				
				Результат = "4";
				
			ИначеЕсли КонстантаОсуществляетсяРеализацияТоваровУслугКомитентов
				И ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку") Тогда
				
				Результат = "6";
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьСтруктуруОснования(ДоговорКонтрагента, ЭтоУПД)
	
	Ground = Новый Структура;
	Ground.Вставить("GroundName", 	"");
	Ground.Вставить("GroundNumber", "");
	Ground.Вставить("GroundDate", 	"");
	Ground.Вставить("Основание", 	"");
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
			
		Если ЭтоУПД Тогда
			ПредставлениеДоговора= "Договор";
		Иначе
			ПредставлениеДоговора= ДоговорКонтрагента.Наименование;
		КонецЕсли;
			
		Ground.Вставить("GroundName", 	ПредставлениеДоговора);
		Ground.Вставить("GroundNumber", ДоговорКонтрагента.Номер);
		Ground.Вставить("GroundDate", 	ДоговорКонтрагента.Дата);
		Ground.Вставить("Основание", 	ДоговорКонтрагента);
		
	КонецЕсли;
	
	Возврат Ground;
	
КонецФункции

Функция ПолучитьИсправляемыйДокументРеализации(ДокРеализации)
	
	Если Не ЗначениеЗаполнено(ДокРеализации) Тогда 
		
		Результат = Неопределено;
		
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Результат = ПолучитьИсправляемыйДокументРеализации(ДокРеализации.ДокументРеализации);
		
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
		И ЕстьРеквизитМетаданных(ДокРеализации.Метаданные(), "Сделка") 
		И (ТипЗнч(ДокРеализации.Сделка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			Или ТипЗнч(ДокРеализации.Сделка) = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров")) Тогда
		
		Результат = ДокРеализации.Сделка;
					
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
		
		// Корректировка реализации может быть сформирована на основании счета-фактуры, 
		// если этот счет-фактура был выписан посредником (через отчет комиссионера о продажах)
		Накладные = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокРеализации);
		
		Если Накладные.Количество() > 0 Тогда 
			Результат = Накладные[0].Ссылка;
		КонецЕсли;
		
	Иначе
		
		Результат = ДокРеализации;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

