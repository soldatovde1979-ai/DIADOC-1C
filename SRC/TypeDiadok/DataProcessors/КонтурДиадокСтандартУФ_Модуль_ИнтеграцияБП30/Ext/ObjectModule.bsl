	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Содержание КАК НоменклатураПредставление,
	|	&КодНоменклатурыИзТЧ КАК КодНоменклатуры,
	|	1 КАК Количество,
	|	Т.Сумма КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.СтавкаНДС КАК СтавкаНДС,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	"""" КАК НомерГТД,
	|	"""" КАК СтранаПроисхождения,
	|	"""" КАК НомерГТДПредставление,
	|	Т.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Т.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|	"""" КАК ВидУпаковки,
	|	0 КАК КоличествоВОдномМесте,
	|	0 КАК КоличествоМест,
	|	ИСТИНА КАК ЭтоУслуга,
	|	""Service"" КАК ПризнакТоварРаботаУслуга,
	|	ЕСТЬNULL(РублевыеСуммы.Всего, 0) КАК ВсегоВРублях,
	|	ЕСТЬNULL(РублевыеСуммы.НДС, 0) КАК НДСВРублях,
	|	ВЫБОР
	|		КОГДА РублевыеСуммы.Регистратор ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК СуществуютЗаписиРублевыхСумм
	|ИЗ
	|	Документ.АР_НачислениеПени.Состав КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РублевыеСуммыДокументовВВалюте КАК РублевыеСуммы
	|		ПО Т.Ссылка = РублевыеСуммы.Регистратор
	|			И (ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Состав) = РублевыеСуммы.ТабличнаяЧастьДокумента)
	|			И Т.НомерСтроки = РублевыеСуммы.НомерСтрокиДокумента
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТЧ_СчетНаАренду()
	
	Результат =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Состав) КАК ТабличнаяЧастьДокумента,
	|	""Состав"" КАК ИмяТабличнойЧасти,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Содержание КАК НоменклатураПредставление,
	|	&КодНоменклатурыИзТЧ КАК КодНоменклатуры,
	|	Т.Количество КАК Количество,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.СтавкаНДС КАК СтавкаНДС,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	0 КАК СуммаСкидки,
	|	"""" КАК НомерГТД,
	|	"""" КАК СтранаПроисхождения,
	|	"""" КАК НомерГТДПредставление,
	|	Т.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Т.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Т.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|	"""" КАК ВидУпаковки,
	|	"""" КАК КоличествоВОдномМесте,
	|	"""" КАК КоличествоМест,
	|	Т.Номенклатура.Услуга КАК ЭтоУслуга,
	|	ВЫБОР
	|		КОГДА Т.Номенклатура.Услуга
	|			ТОГДА ""Service""
	|		ИНАЧЕ ""Property""
	|	КОНЕЦ КАК ПризнакТоварРаботаУслуга,
	|	0 КАК ВсегоВРублях,
	|	0 КАК НДСВРублях,
	|	ЛОЖЬ КАК СуществуютЗаписиРублевыхСумм
	|ИЗ
	|	Документ.АР_СчетНаАренду.Состав КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТЧ_НомерГТДПредставление()
	
	Если МетодСервера(,"СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "3.0.59") >= 0 Тогда
		Результат = "Т.НомерГТД.РегистрационныйНомер";
	Иначе
		Результат = "Т.НомерГТД.Код";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодготовкаСпискаИсходящихДокументов

Функция ПодготовитьВТДляСпискаОтправкиДокументов(ТипыДокументов, Запрос) Экспорт
	
	МассивВременныхТаблиц = Новый Массив;
	
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "1" ИЛИ ТипыДокументов = "2" ИЛИ ТипыДокументов = "5" ИЛИ ТипыДокументов = "6" Тогда
		ПодготовитьВТ_СЧФ_Основная(Запрос, МассивВременныхТаблиц);
		ПодготовитьВТ_УПД_СЧФДОП(Запрос, МассивВременныхТаблиц, ТипыДокументов);
		ПодготовитьВТ_УКД_КСЧФДИС(Запрос, МассивВременныхТаблиц, ТипыДокументов);
	КонецЕсли;
	
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "1" Тогда
		ПодготовитьВТ_Накладные(Запрос, МассивВременныхТаблиц);
	КонецЕсли;
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "2" Тогда
		ПодготовитьВТ_СчетаФактуры(Запрос, МассивВременныхТаблиц, ТипыДокументов);
	КонецЕсли;
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "3" Тогда
		ПодготовитьВТ_СчетНаОплату(Запрос, МассивВременныхТаблиц);
	КонецЕсли;
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "4" Тогда
		ПодготовитьВТ_АктСверкиВзаиморасчетов(Запрос, МассивВременныхТаблиц);
	КонецЕсли;
	
	Возврат МассивВременныхТаблиц;
	
КонецФункции

Процедура ПодготовитьВТ_Накладные(Запрос, МассивВременныхТаблиц)
	
	ПодготовитьВТ_Накладные_РеализацияТоваровУслуг(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_КорректировкаРеализации(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_ВозвратПоставщику(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_РеализацияОтгруженныхТоваров(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_АктОбОказанииПроизводственныхУслуг(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_РеализацияУслугПоПереработке(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_ОтчетКомитенту(Запрос, МассивВременныхТаблиц);
	
	ПодготовитьВТ_Накладные_НачислениеАренднойПлаты(Запрос, МассивВременныхТаблиц);
	ПодготовитьВТ_Накладные_НачислениеПени(Запрос, МассивВременныхТаблиц);
	
КонецПроцедуры

Процедура ПодготовитьВТ_Накладные_РеализацияТоваровУслуг(Запрос, МассивВременныхТаблиц)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	&ТребуетсяСФ КАК ТребуетсяСФ,
	|	Документ.Организация КАК Организация,
	|	Документ.Контрагент КАК Контрагент,
	|	Документ.СуммаДокумента КАК СуммаДокументаЗначение,
	|	Документ.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ID,
	|	ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") КАК СостояниеОтправкиДополнительныхВПФ,
	|	Документ.Проведен КАК Проведен,
	|	Документ.Дата КАК Дата,
	|	Документ.Номер КАК Номер,
	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД,
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю,
	|	НастройкиЭДО.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиЭДО.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СтатусОтправляемыхВПФ
	|		ПО Документ.Ссылка = СтатусОтправляемыхВПФ.Объект
	|			И (СтатусОтправляемыхВПФ.Свойство = &СвойствоДокументаСтатусОтправляемыхВПФ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПД_СЧФДОП_ДокументыОснования КАК УПД_СЧФДОП_ДокументыОснования
	|		ПО Документ.Ссылка = УПД_СЧФДОП_ДокументыОснования.ДокументОснование
	|ГДЕ
	|	УПД_СЧФДОП_ДокументыОснования.ДокументОснование ЕСТЬ NULL
	|	И (ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|			ИЛИ ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") ПОДОБНО ""%[НУ]%"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьНДС) КАК ЕстьНДС,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьТовары) КАК ЕстьТовары,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьУслуги) КАК ЕстьУслуги,
	|	СУММА(ВложенныйЗапрос.СуммаНДСТовары) КАК СуммаНДСТовары,
	|	СУММА(ВложенныйЗапрос.СуммаНДСУслуги) КАК СуммаНДСУслуги
	|ПОМЕСТИТЬ СуммаНДСЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_Основная.Документ КАК Документ,
	|		ВЫБОР
	|			КОГДА Товары.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ИСТИНА КАК ЕстьТовары,
	|		ЛОЖЬ КАК ЕстьУслуги,
	|		Товары.СуммаНДС КАК СуммаНДСТовары,
	|		0 КАК СуммаНДСУслуги
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|			ПО ВТ_Основная.Документ = Товары.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_Основная.Документ,
	|		ВЫБОР
	|			КОГДА Услуги.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ЛОЖЬ,
	|		ИСТИНА,
	|		0,
	|		Услуги.СуммаНДС
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК Услуги
	|			ПО ВТ_Основная.Документ = Услуги.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_Основная.Документ,
	|		ВЫБОР
	|			КОГДА Услуги.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ЛОЖЬ,
	|		ИСТИНА,
	|		0,
	|		Услуги.СуммаНДС
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.АгентскиеУслуги КАК Услуги
	|			ПО ВТ_Основная.Документ = Услуги.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ";
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + ТекстЗапросаВременнаяТаблица_ЕстьСЧФ();
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВТ_Основная.СчетНаОплатуПокупателю КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_Накладные_РеализацияТоваровУслуг
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|ГДЕ
	|	ВТ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
	|	И НЕ ВТ_Основная.СчетНаОплатуПокупателю В (&ПустыеЗначенияСчет)";
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_ТЧРеализацияТоваровУслуг_СвязьСоСчетом("ВТ_Основная", "Документ");
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ,
	|	ВТ_Основная.Документ
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(СуммаНДСЗначение.ЕстьТовары, ЛОЖЬ)
	|			ТОГДА &ВидыЭД_АктОбОказанииУслуг
	|		ИНАЧЕ &ВидыЭД_ТоварнаяНакладная
	|	КОНЕЦ КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.Организация КАК Организация,
	|	ВТ_Основная.Контрагент КАК Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта КАК Валюта,
	|	ВТ_Основная.ID КАК ID_,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен КАК Проведен,
	|	ВТ_Основная.Дата КАК Дата,
	|	ВТ_Основная.Номер КАК Номер,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСТовары, 0) КАК СуммаНДСТовары,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСУслуги, 0) КАК СуммаНДСУслуги,
	|	""РеализацияТоваровУслуг"" КАК Тип,
	|	&ФункцияДокумента КАК ФункцияУПД
	|ПОМЕСТИТЬ Накладные_РеализацияТоваровУслуг
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьСЧФ КАК ВТ_ЕстьСЧФ
	|		ПО ВТ_Основная.Документ = ВТ_ЕстьСЧФ.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммаНДСЗначение КАК СуммаНДСЗначение
	|		ПО ВТ_Основная.Документ = СуммаНДСЗначение.Документ
	|ГДЕ
	|	(ВТ_ЕстьСЧФ.Документ ЕСТЬ НЕ NULL 
	|			ИЛИ НЕ ВТ_Основная.ТребуетсяСФ
	|			ИЛИ ВТ_Основная.ФормироватьУПД <> &КлючНастройки_СЧФДОП
	|			ИЛИ ВТ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|				И НЕ ЕСТЬNULL(СуммаНДСЗначение.ЕстьНДС, ЛОЖЬ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЕстьСЧФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммаНДСЗначение";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФункцияДокумента", ТекстЗапроса_ФункцияПервичногоДокумента("ВТ_Основная"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТребуетсяСФ", ТекстЗапроса_РТУ_ТребуетсяСчетФактура());
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПустыеЗначенияСчет", ПустыеЗначенияРеквизита("Документ.РеализацияТоваровУслуг.Реквизит.СчетНаОплатуПокупателю"));
	Запрос.УстановитьПараметр("Ставка_БезНДС", МенеджерИнтеграции_СтавкаБезНДС());
	
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ПустыеЗначенияСчет");
	
	МассивВременныхТаблиц.Добавить("Накладные_РеализацияТоваровУслуг");
	МассивВременныхТаблиц.Добавить("Связь_Накладные_РеализацияТоваровУслуг");
	
КонецПроцедуры

Процедура ПодготовитьВТ_Накладные_КорректировкаРеализации(Запрос, МассивВременныхТаблиц)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Документ,
	|	&ЭтоИсправление КАК ЭтоИсправление,
	|	&ЭтоКорректировка КАК ЭтоКорректировка,
	|	Документ.Организация КАК Организация,
	|	Документ.Контрагент КАК Контрагент,
	|	Документ.СуммаДокумента КАК СуммаДокументаЗначение,
	|	Документ.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ID,
	|	ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") КАК СостояниеОтправкиДополнительныхВПФ,
	|	Документ.Проведен КАК Проведен,
	|	Документ.Дата КАК Дата,
	|	Документ.ПредставлениеНомера КАК Номер,
	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД,
	|	НастройкиЭДО.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиЭДО.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.КорректировкаРеализации КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СтатусОтправляемыхВПФ
	|		ПО Документ.Ссылка = СтатусОтправляемыхВПФ.Объект
	|			И (СтатусОтправляемыхВПФ.Свойство = &СвойствоДокументаСтатусОтправляемыхВПФ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ УКД_КСЧФДИС_ДокументыОснования КАК УКД_КСЧФДИС_ДокументыОснования
	|		ПО Документ.Ссылка = УКД_КСЧФДИС_ДокументыОснования.ДокументОснование
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПД_СЧФДОП_ДокументыОснования КАК УПД_СЧФДОП_ДокументыОснования
	|		ПО Документ.Ссылка = УПД_СЧФДОП_ДокументыОснования.ДокументОснование
	|ГДЕ
	|	УКД_КСЧФДИС_ДокументыОснования.ДокументОснование ЕСТЬ NULL
	|	И УПД_СЧФДОП_ДокументыОснования.ДокументОснование ЕСТЬ NULL
	|	И (ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|			ИЛИ ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") ПОДОБНО ""%[НУ]%"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьНДС) КАК ЕстьНДС,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьТовары) КАК ЕстьТовары,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьУслуги) КАК ЕстьУслуги,
	|	СУММА(ВложенныйЗапрос.СуммаНДСТовары) КАК СуммаНДСТовары,
	|	СУММА(ВложенныйЗапрос.СуммаНДСУслуги) КАК СуммаНДСУслуги
	|ПОМЕСТИТЬ СуммаНДСЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_Основная.Документ КАК Документ,
	|		ВЫБОР
	|			КОГДА Товары.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ИСТИНА КАК ЕстьТовары,
	|		ЛОЖЬ КАК ЕстьУслуги,
	|		Товары.СуммаНДС КАК СуммаНДСТовары,
	|		0 КАК СуммаНДСУслуги
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.Товары КАК Товары
	|			ПО ВТ_Основная.Документ = Товары.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_Основная.Документ,
	|		ВЫБОР
	|			КОГДА Услуги.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ЛОЖЬ,
	|		ИСТИНА,
	|		0,
	|		Услуги.СуммаНДС
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.Услуги КАК Услуги
	|			ПО ВТ_Основная.Документ = Услуги.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_Основная.Документ,
	|		ВЫБОР
	|			КОГДА Услуги.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ЛОЖЬ,
	|		ИСТИНА,
	|		0,
	|		Услуги.СуммаНДС
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.АгентскиеУслуги КАК Услуги
	|			ПО ВТ_Основная.Документ = Услуги.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВТ_Основная.Документ КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_Накладные_КорректировкаРеализации
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная";
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + ТекстЗапросаВременнаяТаблица_ЕстьСЧФ();
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА ВТ_Основная.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_СоглашениеОбИзмененииСтоимости
	|		КОГДА НЕ ЕСТЬNULL(СуммаНДСЗначение.ЕстьТовары, ЛОЖЬ)
	|			ТОГДА &ВидыЭД_АктОбОказанииУслуг
	|		ИНАЧЕ &ВидыЭД_ТоварнаяНакладная
	|	КОНЕЦ КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.Организация КАК Организация,
	|	ВТ_Основная.Контрагент КАК Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта КАК Валюта,
	|	ВТ_Основная.ID КАК ID_,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен КАК Проведен,
	|	ВТ_Основная.Дата КАК Дата,
	|	ВТ_Основная.Номер КАК Номер,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСТовары, 0) КАК СуммаНДСТовары,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСУслуги, 0) КАК СуммаНДСУслуги,
	|	""КорректировкаРеализации"" КАК Тип,
	|	&ФункцияДокумента КАК ФункцияУПД
	|ПОМЕСТИТЬ Накладные_КорректировкаРеализации
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьСЧФ КАК ВТ_ЕстьСЧФ
	|		ПО ВТ_Основная.Документ = ВТ_ЕстьСЧФ.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммаНДСЗначение КАК СуммаНДСЗначение
	|		ПО ВТ_Основная.Документ = СуммаНДСЗначение.Документ
	|ГДЕ
	|	(ВТ_ЕстьСЧФ.Документ ЕСТЬ НЕ NULL 
	|			ИЛИ ВТ_Основная.ФормироватьУПД <> &КлючНастройки_СЧФДОП
	|			ИЛИ ВТ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|				И НЕ ЕСТЬNULL(СуммаНДСЗначение.ЕстьНДС, ЛОЖЬ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЕстьСЧФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммаНДСЗначение";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоИсправление", ТекстЗапроса_КРТУ_ЭтоИсправление());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоКорректировка", ТекстЗапроса_КРТУ_ЭтоКорректировка());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФункцияДокумента", ТекстЗапроса_ФункцияПервичногоДокумента("ВТ_Основная"));
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Ставка_БезНДС", МенеджерИнтеграции_СтавкаБезНДС());
	
	Запрос.Выполнить();
	
	МассивВременныхТаблиц.Добавить("Накладные_КорректировкаРеализации");
	МассивВременныхТаблиц.Добавить("Связь_Накладные_КорректировкаРеализации");
	
КонецПроцедуры

Процедура ПодготовитьВТ_Накладные_ВозвратПоставщику(Запрос, МассивВременныхТаблиц)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Документ,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка,
	|	Документ.Организация КАК Организация,
	|	Документ.Контрагент КАК Контрагент,
	|	Документ.СуммаДокумента КАК СуммаДокументаЗначение,
	|	Документ.ВалютаДокумента КАК Валюта,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ID,
	|	ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") КАК СостояниеОтправкиДополнительныхВПФ,
	|	Документ.Проведен КАК Проведен,
	|	Документ.Дата КАК Дата,
	|	Документ.Номер КАК Номер,
	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД,
	|	НастройкиЭДО.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиЭДО.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СтатусОтправляемыхВПФ
	|		ПО Документ.Ссылка = СтатусОтправляемыхВПФ.Объект
	|			И (СтатусОтправляемыхВПФ.Свойство = &СвойствоДокументаСтатусОтправляемыхВПФ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПД_СЧФДОП_ДокументыОснования КАК УПД_СЧФДОП_ДокументыОснования
	|		ПО Документ.Ссылка = УПД_СЧФДОП_ДокументыОснования.ДокументОснование
	|ГДЕ
	|	УПД_СЧФДОП_ДокументыОснования.ДокументОснование ЕСТЬ NULL
	|	И (ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|			ИЛИ ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") ПОДОБНО ""%[НУ]%"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС
	|ПОМЕСТИТЬ СуммаНДСЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_Основная.Документ КАК Документ,
	|		Товары.СуммаНДС КАК СуммаНДС
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары КАК Товары
	|			ПО ВТ_Основная.Документ = Товары.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ";
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + ТекстЗапросаВременнаяТаблица_ЕстьСЧФ();
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	&ВидыЭД_ТоварнаяНакладная КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.Организация КАК Организация,
	|	ВТ_Основная.Контрагент КАК Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта КАК Валюта,
	|	ВТ_Основная.ID КАК ID_,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен КАК Проведен,
	|	ВТ_Основная.Дата КАК Дата,
	|	ВТ_Основная.Номер КАК Номер,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДС, 0) КАК СуммаНДСТовары,
	|	0 КАК СуммаНДСУслуги,
	|	""ВозвратТоваровПоставщику"" КАК Тип,
	|	&ФункцияДокумента КАК ФункцияУПД
