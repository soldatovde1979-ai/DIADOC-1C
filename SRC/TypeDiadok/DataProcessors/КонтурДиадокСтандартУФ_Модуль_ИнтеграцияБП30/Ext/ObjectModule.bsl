#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Вызывается из Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента
//
// Параметры:
//  ТребуемыеРеквизиты	 - Структура	 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение.
//  СсылкаНаОбъект		 - ЛюбаяСсылка	 - ссылка на объект, описание которого надо получить.
//
Процедура ПриПолученииОписанияПрикладногоДокумента(ТребуемыеРеквизиты, СсылкаНаОбъект) Экспорт
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ПсевдонимОсновнойТаблицы = "";
	
	Если МетаданныеОбъекта = Метаданные.Документы.КорректировкаРеализации Тогда
		
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_КРТУ_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_КРТУ_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		
	ИначеЕсли МетаданныеОбъекта = Метаданные.Документы.СчетФактураВыданный Тогда
		
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_СчетФактура_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_СчетФактура_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидДокументаИнформационнойБазы
//
// Параметры:
//  ВидДокумента	 - Строка - (возвращаемый параметр) вид документа с точки зрения ЭДО (см. ВидыЭлектронныхДокументов);
//  СсылкаНаОбъект	 - ЛюбаяСсылка - объект информационной базы, вид которого необходимо определить;
//  ЭтоКорректировка - Булево - Истина, если объект отражает операцию корректировки;
//
Процедура ОпределитьВидДокумента(ВидДокумента, СсылкаНаОбъект, ЭтоКорректировка) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	МетаданныеДокументов = Метаданные.Документы;
	
	Если МетаданныеОбъекта = МетаданныеДокументов.СчетФактураВыданный И Не ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.СчетФактура;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.СчетФактураВыданный И ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.КорректировочныйСчетФактура;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.РеализацияТоваровУслуг 
		Или (МетаданныеОбъекта = МетаданныеДокументов.КорректировкаРеализации И Не ЭтоКорректировка) Тогда
		
		ТолькоУслуги = ДокументРеализацииСодержитТолькоУслуги(СсылкаНаОбъект);
		
		Если ТолькоУслуги Тогда
			ВидДокумента = ВидыЭД.АктОбОказанииУслуг;
		Иначе
			ВидДокумента = ВидыЭД.ТоварнаяНакладная;
		КонецЕсли;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.КорректировкаРеализации И ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.СоглашениеОбИзмененииСтоимости;
		
	Иначе
		
		СоответствиеМетаданных = Новый Соответствие;
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.АктСверкиВзаиморасчетов, ВидыЭД.АктСверки);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.СчетНаОплатуПокупателю, ВидыЭД.СчетНаОплату);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.АктОбОказанииПроизводственныхУслуг, ВидыЭД.АктОбОказанииУслуг);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.РеализацияУслугПоПереработке, ВидыЭД.АктОбОказанииУслуг);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.РеализацияОтгруженныхТоваров, ВидыЭД.ТоварнаяНакладная);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ВозвратТоваровПоставщику, ВидыЭД.ТоварнаяНакладная);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ОтчетКомитентуОПродажах, ВидыЭД.АктОбОказанииУслуг);
		
		ВидДокумента = СоответствиеМетаданных.Получить(МетаданныеОбъекта);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДатаНомерДокумента
//
// Параметры:
//  Результат		 	- Структура - (возвращаемый параметр) сведения о дате и номере документа;
//  ОписаниеДокумента	- Структура - параметры объекта ИБ (см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента);
//  ЦифровойИндексОП 	- Число 	- цифровой индекс обособленного подразделения;
//
Процедура ЗаполнитьСведенияОДатеИНомереДокумента(Результат, ОписаниеДокумента, ЦифровойИндексОП) Экспорт
	
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;

	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("Номер");
	РеквизитыДокумента.Вставить("Дата");
	
	Если ЭтоИсправление Тогда
		
		// Переопределим номер документа
		РеквизитыДокумента.Номер = "НомерИсходногоДокумента";
		РеквизитыДокумента.Дата	 = "ДатаИсходногоДокумента";
		
		// И добавим получение номера и даты исправления
		РеквизитыДокумента.Вставить("НомерИсправления");
		РеквизитыДокумента.Вставить("ДатаИсправления", "Дата");
		
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный")
		И ИспользуетсяПроизвольныйНомерСчетаФактурыВыданного() Тогда
		РеквизитыДокумента.Вставить("ИспользоватьПроизвольныйНомер", "ОтредактированНомерСчетаФактуры");
		РеквизитыДокумента.Вставить("ПроизвольныйНомер", "НомерВходящегоДокумента");
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыДокумента);
	
	Если ЗначенияРеквизитов.Свойство("ИспользоватьПроизвольныйНомер")
		И ЗначенияРеквизитов.ИспользоватьПроизвольныйНомер Тогда
		Результат.НомерДокумента = ЗначенияРеквизитов.ПроизвольныйНомер;
	Иначе
		Результат.НомерДокумента = ПредставлениеНомера(ЗначенияРеквизитов.Номер);
	КонецЕсли;
	
	Результат.ДатаДокумента	 = ЗначенияРеквизитов.Дата;
	
	Если ЭтоИсправление Тогда
		Результат.НомерИсправления	 = Формат(ЗначенияРеквизитов.НомерИсправления, "ЧГ=0");
		Результат.ДатаИсправления	 = ЗначенияРеквизитов.ДатаИсправления;
	КонецЕсли;
	
    ДополнитьНомерЦифровымИндексомОП(Результат, ЦифровойИндексОП, СсылкаНаОбъект);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку820
//
// Параметры:
//  ДокументыОбОтгрузке	- Массив - (возвращаемый параметр) Массив элементов "Новый_DocumentShipment";
//  СсылкаНаОбъект		- ДокументСсылка.СчетФактураВыданный - СФ для которой определяем реквизиты документов отгрузки.
//
Процедура ПриПолученииДанныхДокументовОбОтгрузке(Результат, СсылкаНаОбъект, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(СсылкаНаОбъект) <> Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СсылкаНаОбъект, "ДокументыОбОтгрузке") Тогда
		
		// ТЧ "ДокументыОбОтгрузке" появилась в версии "3.0.100.16"
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	СчетФактураВыданныйДокументыОбОтгрузке.НаименованиеДокумента КАК НаименованиеДокумента,
		                      |	СчетФактураВыданныйДокументыОбОтгрузке.НомерДокумента КАК НомерДокумента,
		                      |	СчетФактураВыданныйДокументыОбОтгрузке.ДатаДокумента КАК ДатаДокумента
		                      |ИЗ
		                      |	Документ.СчетФактураВыданный.ДокументыОбОтгрузке КАК СчетФактураВыданныйДокументыОбОтгрузке
		                      |ГДЕ
		                      |	СчетФактураВыданныйДокументыОбОтгрузке.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		
		ДанныеДокументовОбОтгрузке = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ДокументОтгрузки Из ДанныеДокументовОбОтгрузке Цикл
			
			ДокументыОтгрузкиСтруктура = Новый Структура;
			ДокументыОтгрузкиСтруктура.Вставить("Name"		, ДокументОтгрузки.НаименованиеДокумента);
			ДокументыОтгрузкиСтруктура.Вставить("Number"	, ДокументОтгрузки.НомерДокумента);
			ДокументыОтгрузкиСтруктура.Вставить("Date"		, ДокументОтгрузки.ДатаДокумента);
			
			Результат.Добавить(ДокументыОтгрузкиСтруктура);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Результат.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДатаНомерДокумента
//
// Параметры:
//  Результат		 	- Структура - (возвращаемый параметр) сведения о дате и номере документа;
//  ОписаниеДокумента	- Структура - параметры объекта ИБ (см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента);
//  ЦифровойИндексОП 	- Число 	- цифровой индекс обособленного подразделения;
//
Процедура ЗаполнитьСведенияОДатеИНомереКорректировочногоДокумента(Результат, ОписаниеДокумента, ЦифровойИндексОП) Экспорт

	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;

	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияРеквизитов = РеквизитыКорректировочногоСчетаФактуры(СсылкаНаОбъект, ЭтоИсправление);
		УчитыватьИсправлениеИсходногоДокумента = ЗначенияРеквизитов.УчитыватьИсправлениеИсходногоДокумента;
	Иначе
		ЗначенияРеквизитов = РеквизитыКорректировкиРеализации(СсылкаНаОбъект, ЭтоИсправление);
		УчитыватьИсправлениеИсходногоДокумента = ЗначениеЗаполнено(ЗначенияРеквизитов.ДатаИсправленияИсходногоДокумента) И ЗначениеЗаполнено(ЗначенияРеквизитов.НомерИсправленияИсходногоДокумента);
	КонецЕсли;
	
	Если ЗначенияРеквизитов.Свойство("ИспользоватьПроизвольныйНомер")
		И ЗначенияРеквизитов.ИспользоватьПроизвольныйНомер Тогда
		Результат.НомерДокумента = ЗначенияРеквизитов.ПроизвольныйНомер;
	Иначе
		Результат.НомерДокумента = ПредставлениеНомера(ЗначенияРеквизитов.Номер);
	КонецЕсли;
	
	Результат.ДатаДокумента	 = ЗначенияРеквизитов.Дата;
	
	Если ЭтоИсправление Тогда
		Результат.НомерИсправления	 = Формат(ЗначенияРеквизитов.НомерИсправления, "ЧГ=0");
		Результат.ДатаИсправления	 = ЗначенияРеквизитов.ДатаИсправления;
	КонецЕсли;
	
	ОписаниеРеквизитов = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ДатаНомерДокументаОснования");
	ОписаниеРеквизитов.НомерИсходногоДокумента = Формат(ЗначенияРеквизитов.НомерИсходногоДокумента, "ЧГ=0");
	ОписаниеРеквизитов.ДатаИсходногоДокумента  = ЗначенияРеквизитов.ДатаИсходногоДокумента;
	ОписаниеРеквизитов.УчитыватьИсправлениеИсходногоДокумента = УчитыватьИсправлениеИсходногоДокумента;
	
	Если УчитыватьИсправлениеИсходногоДокумента Тогда
		ОписаниеРеквизитов.НомерИсправленияИсходногоДокумента	 = Формат(ЗначенияРеквизитов.НомерИсправленияИсходногоДокумента, "ЧГ=0");
		ОписаниеРеквизитов.ДатаИсправленияИсходногоДокумента		 = ЗначенияРеквизитов.ДатаИсправленияИсходногоДокумента;
	КонецЕсли;
	
	Результат.ДатаНомерДокументовОснований.Добавить(ОписаниеРеквизитов);
	
	ДополнитьНомерЦифровымИндексомОП(Результат, ЦифровойИндексОП, СсылкаНаОбъект);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеШапки()
//
// Параметры:
//  Реквизиты			 - Структура		 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение.
//  МетаданныеИсточника	 - ОбъектМетаданных	 - Метаданные документа-источника
//
Процедура ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеИсточника) Экспорт
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Грузополучатель") Тогда 
		
		Реквизиты.Вставить("Грузополучатель", 
		"ВЫБОР
		|	КОГДА Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ТОГДА Контрагент
		|	ИНАЧЕ Грузополучатель
		|КОНЕЦ");
		
	КонецЕсли;
	
	Реквизиты.Вставить("СуммаСкидки", "0");
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "СуммаСкидки") Тогда 
		Реквизиты.СуммаСкидки = "СуммаСкидки";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "ДополнительныеУсловия") Тогда 
		Реквизиты.ДополнительныеУсловия = "ЕСТЬNULL(ДополнительныеУсловия.ТекстУсловий, """")";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "СведенияОТранспортировкеИГрузе") Тогда 
		Реквизиты.Вставить("СведенияОТранспортировкеИГрузе", "СведенияОТранспортировкеИГрузе");
	КонецЕсли;
	
	Реквизиты.Вставить("ДоговорКонтрагента");
	Реквизиты.Вставить("ПодразделениеОрганизации");
	
	Реквизиты.Вставить("СчетаФактурыОтИмениОрганизации", "ЛОЖЬ"); // Агент (Организация) закупает товары для Принципала (Контрагент) и перевыставляет ему СФ от своего имени
	Реквизиты.Вставить("Агент");
	Реквизиты.Вставить("ДоговорАгента");
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "ДоговорКонтрагента") Тогда 
		
		Реквизиты.РасчетыВУсловныхЕдиницах = "ЕСТЬNULL(ДоговорКонтрагента.РасчетыВУсловныхЕдиницах, ЛОЖЬ)";
		
		Если ЕстьРеквизитМетаданных(Метаданные.Справочники.ДоговорыКонтрагентов, "СчетаФактурыОтИмениОрганизации") Тогда
			Реквизиты.СчетаФактурыОтИмениОрганизации = "ЕСТЬNULL(ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации, ЛОЖЬ)";
		Иначе
			Реквизиты.СчетаФактурыОтИмениОрганизации = "ЛОЖЬ";
		КонецЕсли;
		
	Иначе
		Реквизиты.РасчетыВУсловныхЕдиницах = "ЛОЖЬ";
	КонецЕсли;
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "БанковскийСчетОрганизации") 
		И ЕстьРеквизитМетаданных(МетаданныеИсточника, "СтруктурнаяЕдиница") Тогда 
		Реквизиты.БанковскийСчетОрганизации = "СтруктурнаяЕдиница";
	КонецЕсли;
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "БанковскийСчетКонтрагента")
		И ЕстьРеквизитМетаданных(МетаданныеИсточника, "Контрагент") Тогда
		Реквизиты.БанковскийСчетКонтрагента = "Контрагент.ОсновнойБанковскийСчет";
	КонецЕсли;
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "ИдентификаторГосКонтракта")
		И ЕстьРеквизитМетаданных(МетаданныеИсточника, "ДоговорКонтрагента") Тогда 
		Реквизиты.ИдентификаторГосКонтракта = "ЕСТЬNULL(ДоговорКонтрагента.ГосударственныйКонтракт.Код, НЕОПРЕДЕЛЕНО)";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "СуммаВключаетНДС") Тогда 
		Реквизиты.ЦенаВключаетНДС = "СуммаВключаетНДС";
	Иначе
		Реквизиты.ЦенаВключаетНДС = "ЛОЖЬ";
	КонецЕсли;
	
	Реквизиты.КурсДокумента = "КурсВзаиморасчетов";
	Реквизиты.КратностьДокумента = "КратностьВзаиморасчетов";
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеШапки
// после формирования структуры шапки документа.
//
// Параметры:
//  ЗначенияРеквизитов - Структура - Структура со значениями реквизита документа
//
Процедура ПослеПолученияДанныхШапкиДокумента(ДанныеШапки) Экспорт
	
	СсылкаНаОбъект = ДанныеШапки.ОписаниеДокумента.Ссылка;
	ЭтоСФ	= ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный");
	ЭтоРОТ	= ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров");
	ЭтоСчет	= ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетНаОплатуПокупателю");
	ЭтоРТУ	= ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровУслуг");
	
	Если ЭтоСФ Тогда 
		ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеШапки);
	КонецЕсли;
	
	Если ЭтоРОТ Тогда 
		ДополнитьШапкуРеализацииОтгруженныхТоваров(ДанныеШапки);
	КонецЕсли;
	
	Если ЭтоСчет Тогда 
		ДополнитьШапкуСчетаНаОплатуПокупателю(ДанныеШапки);
	КонецЕсли;
	
	Если ЭтоРТУ Тогда // счет на оплату на основании реализации
		ДополнитьШапкуРеализацияТоваровУслуг(ДанныеШапки);
	КонецЕсли;
	
	Если ЭтоУправлениеАрендой() Тогда
		
		ЭтоСчетНаАренду	= ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.АР_СчетНаАренду");
		Если ЭтоСчетНаАренду Тогда
			ДополнитьШапкуСчетаНаАренду(ДанныеШапки);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетОрганизации) Тогда 
		ДанныеШапки.БанковскийСчетОрганизации = ПолучитьБанковскийСчет(СсылкаНаОбъект);
	КонецЕсли;
	
	Если СчетФактураНаАванс(СсылкаНаОбъект) Тогда
		ДанныеШапки.ЦенаВключаетНДС = Истина;
		ДанныеШапки.Вставить("СФНаАванс", Истина);
	КонецЕсли;
	
	ДанныеШапки.НДСИсчисляетсяНалоговымАгентом = НДСПоДокументуИсчисляетсяНалоговымАгентом(СсылкаНаОбъект);
	
	Если Не ЗначениеЗаполнено(ДанныеШапки.СрокОплаты) Тогда 
		ДанныеШапки.СрокОплаты = СрокиОплатыДокументов.УстановленныйСрокОплаты(СсылкаНаОбъект, ДанныеШапки.Организация);
	КонецЕсли;
	
	Если ЭтоОбособленноеПодразделение(ДанныеШапки.ПодразделениеОрганизации) Тогда 
		ДанныеШапки.ОбособленноеПодразделение = ДанныеШапки.ПодразделениеОрганизации;
	ИначеЕсли ЭтоОбособленноеПодразделение(ДанныеШапки.Организация) Тогда 
		ДанныеШапки.ОбособленноеПодразделение = ДанныеШапки.Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ОбособленноеПодразделение) Тогда 
		
		ДанныеШапки.ЦифровойИндексОбособленногоПодразделения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.ОбособленноеПодразделение, "ЦифровойИндексОбособленногоПодразделения");
		
		Если Не ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда 
			// При отгрузке от ОП грузоотправитель должен быть указан всегда (нельзя писать "он же")
			ДанныеШапки.Грузоотправитель = ДанныеШапки.Организация;
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеШапки.Вставить("ГрузоотправительКПП", КППГрузоотправителя(ДанныеШапки.Организация, ДанныеШапки.Грузоотправитель));
	
	Если Не ЗначениеЗаполнено(ДанныеШапки.ОрганизацияПолучатель) Тогда
		// Реквизит ОрганизацияПолучатель есть только в БП КОРП,
		// поэтому для остальный версий заполняем его данными организации.
		ДанныеШапки.ОрганизацияПолучатель = ДанныеШапки.Организация;
	КонецЕсли;
	
	ПослеПолученияДанныхШапкиКомиссионногоДокумента(ДанныеШапки);
	
КонецПроцедуры

Процедура ПослеПолученияДанныхШапкиКомиссионногоДокумента(ДанныеШапки)
	
	СсылкаНаОбъект = ДанныеШапки.ОписаниеДокумента.Ссылка;
	ИсходныйДокумент = Неопределено;
	
	Если ЭтоСчетФактура(СсылкаНаОбъект) Тогда
		
		Если ЭтоКСФ(СсылкаНаОбъект) Тогда
			
			ДокументыОснования = СсылкаНаОбъект.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование");
			Если ДокументыОснования.Количество() > 0 Тогда
				КорректирующийДокумент = ДокументыОснования[0];
				ИсходныйДокумент = ИсходныйКорректируемыйДокумент(КорректирующийДокумент);
			КонецЕсли;
			
		Иначе
			ИсходныйДокумент = СсылкаНаОбъект;
		КонецЕсли;
		
	Иначе
		ИсходныйДокумент = Неопределено;
	КонецЕсли;
	
	Если ЭтоСчетФактура(ИсходныйДокумент) Тогда
		
		ДокументыОснования = ИсходныйДокумент.ДокументыОснования.ВыгрузитьКолонку("ДокументОснование");
		
		Если ОснованиеОтчетКомитентаОПродажах_ОтчетОЗакупках(ДокументыОснования, ИсходныйДокумент) Тогда
			
			ПослеПолученияДанныхШапкиДокументаДополнительно(ДанныеШапки, ИсходныйДокумент);
			
		ИначеЕсли ОснованиеОтчетКомиссионераОПродажах(ДокументыОснования, ИсходныйДокумент) Тогда
			
			ДокументОснование = ДокументыОснования[0];
			ПослеПолученияДанныхШапкиОтчетаКомиссионераОПродажахДополнительно(
				ДанныеШапки,
				ДокументОснование,
				ИсходныйДокумент
			);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеПолученияДанныхШапкиДокументаДополнительно(Знач ДанныеШапки, СсылкаНаОбъект)
	
	Перем Выборка, ЗапросШапка;
	
	ЗапросШапка = Новый Запрос;
	ЗапросШапка.Текст =
	
	"ВЫБРАТЬ
	|	ТЧПоставщики.Поставщик КАК Поставщик,
	|	ВЫБОР
	|		КОГДА ТЧПоставщики.Партия.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ТЧПоставщики.Поставщик
	|		ИНАЧЕ ТЧПоставщики.Партия.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ТЧПоставщики.Партия.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ТЧПоставщики.Ссылка.Организация
	|		ИНАЧЕ ТЧПоставщики.Партия.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ТЧПоставщики.Ссылка.Организация КАК Агент,
	|	ТЧПоставщики.Ссылка.ДоговорКонтрагента КАК ДоговорАгента
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Поставщики КАК ТЧПоставщики
	|ГДЕ
	|	ТЧПоставщики.СчетФактура = &Ссылка";
	
	ЗапросШапка.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	Выборка = ЗапросШапка.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Не ДанныеШапки.СчетаФактурыОтИмениОрганизации Тогда 
			ДанныеШапки.Организация = Выборка.Поставщик;
			Если ЭтоОбособленноеПодразделение(ДанныеШапки.Организация) Тогда 
				ДанныеШапки.ОбособленноеПодразделение = ДанныеШапки.Организация;
			КонецЕсли;
		КонецЕсли;
		
		Если ДанныеШапки.СчетаФактурыОтИмениОрганизации 
			Или Выборка.Поставщик = Выборка.Грузополучатель Тогда 
			ДанныеШапки.Грузоотправитель = Неопределено; // должно быть "он же"
		Иначе
			ДанныеШапки.Грузоотправитель = Выборка.Грузоотправитель;
		КонецЕсли;
		
		ДанныеШапки.Грузополучатель	 = Выборка.Грузополучатель;
		ДанныеШапки.Агент			 = Выборка.Агент;
		ДанныеШапки.ДоговорАгента	 = Выборка.ДоговорАгента;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеПолученияДанныхШапкиОтчетаКомиссионераОПродажахДополнительно(Знач ДанныеШапки, СсылкаНаОснованиеСчетаФактуры, СсылкаНаСчетФактуру)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Реквизиты.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Реквизиты.Грузополучатель
	|		ИНАЧЕ ОтчетКомиссионераОПродажахПокупатели.Покупатель
	|	КОНЕЦ КАК Грузополучатель
	|ИЗ
	|	Документ.ОтчетКомиссионераОПродажах.Покупатели КАК ОтчетКомиссионераОПродажахПокупатели,
	|	Документ.ОтчетКомиссионераОПродажах КАК Реквизиты
	|ГДЕ
	|	ОтчетКомиссионераОПродажахПокупатели.Ссылка = &ДокументОснование
	|	И ОтчетКомиссионераОПродажахПокупатели.СчетФактура = &СчетФактура
	|	И Реквизиты.Ссылка = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", СсылкаНаОснованиеСчетаФактуры);
	Запрос.УстановитьПараметр("СчетФактура", СсылкаНаСчетФактуру);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ДанныеШапки.Грузополучатель = Выборка.Грузополучатель;
		
	КонецЕсли;
	
КонецПроцедуры

