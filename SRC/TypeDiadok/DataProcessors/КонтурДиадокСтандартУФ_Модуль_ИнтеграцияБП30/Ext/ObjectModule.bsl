Процедура ДобавитьДокументыОснованияВСлужебнуюИнформацию(Контент)
	
	СсылкаНаОбъект = Контент.СлужебнаяИнформация.Ссылка;
	
	Если Не ЭтоСчетФактура(СсылкаНаОбъект)
		Или СчетФактураНаАванс(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыОснования = ВсеДокументыОснования(СсылкаНаОбъект);
	Контент.СлужебнаяИнформация.Вставить("ДокументыОснования", ДокументыОснования);
	
КонецПроцедуры

Функция ВсеДокументыОснования(СсылкаНаОбъект)
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ИмяДокумента = МетаданныеОбъекта.Имя;
	
	ИмяМетаданныхТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Результат = Новый Массив;
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ИмяМетаданныхТаблицыОснований) Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ПолноеИмяТаблицы = СтрЗаменить("Документ.%ИмяДокумента%.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.ДокументОснование);
		КонецЦикла;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ДокументОснование") Тогда
		
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		Результат.Добавить(Основание);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает документ-основание счета-фактуры.
// Если оснований несколько, берется только первое.
//
// Параметры:
//  СчетФактура - ДокументСсылка.СчетФактураВыданный - Счет-фактура, основание которого требуется получить.
// 
// Возвращаемое значение:
//  ДокументСсылка - документ, на основании которого выписан счет-фактура.
//
Функция ДокументОснованиеСчетаФактуры(СчетФактура)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ИмяДокумента = СчетФактура.Метаданные().ПолноеИмя();
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ИмяДокумента + ".ТабличнаяЧасть.ДокументыОснования") Тогда
	
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &СчетФактура";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ИмяДокумента + ".ДокументыОснования");
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			Результат = Выборка.ДокументОснование;
		КонецЕсли;
		
	Иначе
		
		Результат = МетодСервера(, "ЗначениеРеквизитаОбъекта", СчетФактура, "ДокументОснование");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет реквизиты реализации отгруженных товаров значениями реквизитов документа отгрузки.
//
// Параметры:
//  ДанныеДокумента - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуРеализацииОтгруженныхТоваров(ДанныеДокумента)
	
	СсылкаНаОбъект = ДанныеДокумента.ОписаниеДокумента.Ссылка;
	
	Если Не ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров") Тогда 
		Возврат;
	КонецЕсли;
	
	ДокументОтгрузки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОтгрузки");
	ДанныеДокументаОтгрузки = ДанныеШапки(ДокументОтгрузки);
	
	КопируемыеРеквизиты = Новый Массив;
	КопируемыеРеквизиты.Добавить("Грузополучатель");
	КопируемыеРеквизиты.Добавить("Грузоотправитель");
	КопируемыеРеквизиты.Добавить("ВалютаДокумента");
	КопируемыеРеквизиты.Добавить("ВалютаДокументаКод");
	КопируемыеРеквизиты.Добавить("БанковскийСчетОрганизации");
	КопируемыеРеквизиты.Добавить("БанковскийСчетКонтрагента");
	КопируемыеРеквизиты.Добавить("ЦенаВключаетНДС");
	КопируемыеРеквизиты.Добавить("СведенияОТранспортировкеИГрузе");
	КопируемыеРеквизиты.Добавить("АдресДоставки");
	КопируемыеРеквизиты.Добавить("ОбособленноеПодразделение");
	КопируемыеРеквизиты.Добавить("ЦифровойИндексОбособленногоПодразделения");
	
	Для Каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл 
		
		Если ЗначениеЗаполнено(ДанныеДокументаОтгрузки[ИмяРеквизита]) Тогда 
			ДанныеДокумента.Вставить(ИмяРеквизита, ДанныеДокументаОтгрузки[ИмяРеквизита]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет сумму НДС с учетом скидки весь документ
//
// Параметры:
//  ДанныеДокумента - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаНаОплатуПокупателю(ДанныеДокумента)
	
	СсылкаНаОбъект = ДанныеДокумента.ОписаниеДокумента.Ссылка;
	
	Если Не ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		Возврат;
	КонецЕсли;
	
	СуммаНДСДокумента = СуммаНДССчетаНаОплату(СсылкаНаОбъект);
	
	ДанныеДокумента.Вставить("СуммаНДСДокумента", СуммаНДСДокумента);
	
КонецПроцедуры
                               
// Заполняет сумму НДС с учетом скидки весь документ
//
// Параметры:
//  ДанныеДокумента - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаНаАренду(ДанныеДокумента)
	
	СсылкаНаОбъект = ДанныеДокумента.ОписаниеДокумента.Ссылка;
	
	Если Не ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.АР_СчетНаАренду") Тогда
		Возврат;
	КонецЕсли;
	
	СуммаНДСДокумента = СсылкаНаОбъект.Состав.Итог("СуммаНДС");
	
	ДанныеДокумента.Вставить("СуммаНДСДокумента", СуммаНДСДокумента);
	
КонецПроцедуры

  // Заполняет сумму НДС по документу Реализация товаров услуг
//
// Параметры:
//  ДанныеДокумента - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуРеализацияТоваровУслуг(ДанныеДокумента)
	
	СсылкаНаОбъект = ДанныеДокумента.ОписаниеДокумента.Ссылка;
	
	Если Не ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат;
	КонецЕсли;
	
	СуммаНДСДокумента = СуммаНДСРеализацииТоваровУслуг(СсылкаНаОбъект);
	
	ДанныеДокумента.Вставить("СуммаНДСДокумента", СуммаНДСДокумента);
	
КонецПроцедуры

// Заполняет реквизиты шапки счета-фактуры значениями реквизитов документа-основания.
// Для печати счета-фактуры многие реквизиты берутся из его документа-основания.
//
// Параметры:
//  ДанныеСчетаФактуры - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеСчетаФактуры)
	
	СсылкаНаОбъект = ДанныеСчетаФактуры.ОписаниеДокумента.Ссылка;
	Если Не ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
		Возврат;
	КонецЕсли;
	
	ДокументОснование = ДокументОснованиеСчетаФактуры(СсылкаНаОбъект);
	
	ДанныеДокументаОснования = ДанныеШапки(ДокументОснование);
	
	КопируемыеРеквизиты = Новый Массив;
	КопируемыеРеквизиты.Добавить("Грузоотправитель");
	КопируемыеРеквизиты.Добавить("ВалютаДокумента");
	КопируемыеРеквизиты.Добавить("ВалютаДокументаКод");
	КопируемыеРеквизиты.Добавить("БанковскийСчетОрганизации");
	КопируемыеРеквизиты.Добавить("ЦенаВключаетНДС");
	КопируемыеРеквизиты.Добавить("СведенияОТранспортировкеИГрузе");
	КопируемыеРеквизиты.Добавить("АдресДоставки");
	КопируемыеРеквизиты.Добавить("ПодразделениеОрганизации");
	КопируемыеРеквизиты.Добавить("ОбособленноеПодразделение");
	КопируемыеРеквизиты.Добавить("ЦифровойИндексОбособленногоПодразделения");
	
	Если Не ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтчетКомиссионераОПродажах") Тогда
		КопируемыеРеквизиты.Добавить("Грузополучатель");
		КопируемыеРеквизиты.Добавить("БанковскийСчетКонтрагента");
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл 
		
		Если ЗначениеЗаполнено(ДанныеДокументаОснования[ИмяРеквизита]) Тогда 
			ДанныеСчетаФактуры.Вставить(ИмяРеквизита, ДанныеДокументаОснования[ИмяРеквизита]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументРеализацииСодержитТолькоУслуги(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВложенныйЗапрос.ЕстьУслуги), ЛОЖЬ) КАК ЕстьУслуги,
	|	ЕСТЬNULL(МАКСИМУМ(ВложенныйЗапрос.ЕстьТовары), ЛОЖЬ) КАК ЕстьТовары
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 1
	|		ИСТИНА КАК ЕстьТовары,
	|		ЛОЖЬ КАК ЕстьУслуги
	|	ИЗ
	|		&Товары КАК ТЧ
	|	ГДЕ
	|		ТЧ.Ссылка = &СсылкаНаОбъект
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		ЛОЖЬ,
	|		ИСТИНА
	|	ИЗ
	|		&Услуги КАК ТЧ
	|	ГДЕ
	|		ТЧ.Ссылка = &СсылкаНаОбъект
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ ПЕРВЫЕ 1
	|		ЛОЖЬ,
	|		ИСТИНА
	|	ИЗ
	|		&АгентскиеУслуги КАК ТЧ
	|	ГДЕ
	|		ТЧ.Ссылка = &СсылкаНаОбъект) КАК ВложенныйЗапрос";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	ИменаТЧ = Новый Массив;
	ИменаТЧ.Добавить("Товары");
	ИменаТЧ.Добавить("Услуги");
	ИменаТЧ.Добавить("АгентскиеУслуги");
	
	ПолноеИмяДокумента = СсылкаНаОбъект.Метаданные().ПолноеИмя();
	
	Для Каждого ИмяТЧ Из ИменаТЧ Цикл
		ПодстрокаПоиска = "&" + ИмяТЧ;
		ПодстрокаЗамены = ПолноеИмяДокумента + "." + ИмяТЧ;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ПодстрокаПоиска, ПодстрокаЗамены);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЕстьУслуги И Не Выборка.ЕстьТовары;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоОбособленноеПодразделение(ЮрФизЛицо)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ЮрФизЛицо) Тогда 
		
		МетаданныеОбъекта = ЮрФизЛицо.Метаданные();
		
		Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ОбособленноеПодразделение", Ложь) Тогда 
			Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "ОбособленноеПодразделение");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоОбособленноеПодразделениеНаОтдельномБалансе(ЮрФизЛицо)
	
    Результат = Ложь;
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
		Результат = ЭтоОбособленноеПодразделение(ЮрФизЛицо);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыПродавца(Организация, Период, БанковскийСчет, ОбособленноеПодразделение)
	
	РеквизитыОрганизации = РеквизитыЮрФизЛица(Организация, Период, БанковскийСчет);
	
	Если ЗначениеЗаполнено(ОбособленноеПодразделение) 
		И РеквизитыОрганизации.ТипЮрФизЛица <> ТипыЮрФизЛиц().ИндивидуальныйПредприниматель Тогда
		
		РеквизитыПодразделения = РеквизитыЮрФизЛица(ОбособленноеПодразделение, Период);
		
		РеквизитыОрганизации.КПП = РеквизитыПодразделения.КПП;
		
		Если ЭтоОбособленноеПодразделениеНаОтдельномБалансе(ОбособленноеПодразделение) Тогда
			ЗаполнитьЗначенияСвойств(РеквизитыОрганизации, РеквизитыПодразделения,
				"Банк, БИК, АдресБанка, НомерСчета, КоррСчет");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

Функция РеквизитыГрузоотправителя(Организация, Период, БанковскийСчет, ОбособленноеПодразделение)
	
	РеквизитыОрганизации = РеквизитыЮрФизЛица(Организация, Период, БанковскийСчет);
	
	Если ЗначениеЗаполнено(ОбособленноеПодразделение) Тогда 
		
		РеквизитыПодразделения = РеквизитыЮрФизЛица(ОбособленноеПодразделение, Период);
		
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("Представление");
		КопируемыеРеквизиты.Добавить("СокращенноеНаименование");
		КопируемыеРеквизиты.Добавить("ПолноеНаименование");
		КопируемыеРеквизиты.Добавить("НаименованиеДляПечатныхФорм");
		КопируемыеРеквизиты.Добавить("КПП");
		КопируемыеРеквизиты.Добавить("КодПоОКПО");
		КопируемыеРеквизиты.Добавить("ФактическийАдрес");
		КопируемыеРеквизиты.Добавить("ЗначенияПолейФактическийАдрес");
		
		Для Каждого ИмяСвойства Из КопируемыеРеквизиты Цикл 
			РеквизитыОрганизации[ИмяСвойства] = РеквизитыПодразделения[ИмяСвойства]
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

