КонецПроцедуры //ПередФормированиемПечатнойФормыСверкиВзаиморасчетов()

Функция ПараметрыСчетаФактуры(СчетФактура) Экспорт
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Результат = УчетНДСПереопределяемый.ПараметрыСчетаФактуры(СчетФактура);
	
	ВидСчетаФактуры = СчетФактура.ВидСчетаФактуры;
	
	Если ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАванс
		Или ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаАвансКомитента
		Или ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.НаСуммовуюРазницу Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, СчетФактура);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыСчетаНаОплату(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	СуммаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "СуммаДокумента");
	СуммаНДСДокумента = СуммаНДССчетаНаОплату(ДокументСсылка);
	
	Результат = Новый Структура;
	Результат.Вставить("СуммаДокумента", СуммаДокумента);
	Результат.Вставить("СуммаНДСДокумента", СуммаНДСДокумента);
	
	Возврат Результат;
	
КонецФункции

// Получает сумму НДС счета на оплату с учетом скидки на весь документ
//
// Параметры:
//  СчетНаОплату - ДокументСсылка.СчетНаОплатуПокупателю - документ, по которому нужно получить сумму НДС
// 
// Возвращаемое значение:
//  Число - Сумма НДС
//
Функция СуммаНДССчетаНаОплату(СчетНаОплату)
	
	Результат = 0;
	
	РеквизитыСчета	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетНаОплату, "СуммаСкидки, СуммаВключаетНДС");
	СуммаСкидки		 = РеквизитыСчета.СуммаСкидки;
	СуммаВключаетНДС = РеквизитыСчета.СуммаВключаетНДС;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка = &СчетНаОплату
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки");
	
	Запрос.УстановитьПараметр("СчетНаОплату", СчетНаОплату);
	
	ТабличнаяЧасть = Запрос.Выполнить().Выгрузить();
	
	Если СуммаСкидки > 0 Тогда
		
		// Необходимо распределить сумму общей скидки на табличную часть,
		// чтобы получить фактическую сумму НДС
		
		ОбщаяСумма = 0;
		Коэффициенты = Новый Массив;
		
		Для каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
			
			Если СуммаВключаетНДС Тогда
				СуммаВсего = СтрокаТЧ.Сумма;
			Иначе
				СуммаВсего = СтрокаТЧ.Сумма + СтрокаТЧ.СуммаНДС;
			КонецЕсли;
			
			Коэффициенты.Добавить(СуммаВсего);
			
			ОбщаяСумма = ОбщаяСумма + СуммаВсего;
			
		КонецЦикла;
		
		СуммаСоСкидкой = ОбщаяСумма - СуммаСкидки;
		
		Если СуммаСоСкидкой > 0 Тогда
			
			ТочностьСуммы = 2;
			
			НовыеСуммы = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СуммаСоСкидкой, Коэффициенты, ТочностьСуммы);
			
			Для Индекс = 0 По НовыеСуммы.ВГраница() Цикл
				
				
				СтрокаТЧ		 = ТабличнаяЧасть[Индекс];
				ПроцентСтавкиНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаТЧ.СтавкаНДС);
				НоваяСумма		 = НовыеСуммы[Индекс];
				НоваяСуммаНДС	 = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НоваяСумма, Истина, ПроцентСтавкиНДС);
				Результат		 = Результат + Окр(НоваяСуммаНДС, ТочностьСуммы);
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		Результат = ТабличнаяЧасть.Итог("СуммаНДС");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

