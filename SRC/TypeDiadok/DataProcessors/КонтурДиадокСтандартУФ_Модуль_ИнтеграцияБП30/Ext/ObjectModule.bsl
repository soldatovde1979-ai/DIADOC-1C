Функция СформироватьДанныеДляПечати(СсылкаНаОбъект, ЭтоКСФ)
	
	ВалютаРегламентированногоУчета = ВалютаРегламентированногоУчета();
	
	ЭтоСФ = ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный");
				
	//сформируем список документов-оснований
	СпДокументовОснований = Новый СписокЗначений;
	
	Если ЭтоСФ Тогда
		Для Каждого Строка Из СсылкаНаОбъект.ДокументыОснования Цикл 
			Если ЗначениеЗаполнено(Строка.ДокументОснование)
				И (СпДокументовОснований.НайтиПоЗначению(Строка.ДокументОснование) = Неопределено) Тогда 
				СпДокументовОснований.Добавить(ДокументОтгрузки(Строка.ДокументОснование));
			КонецЕсли;	
		КонецЦикла;	
	Иначе
		СпДокументовОснований.Добавить(ДокументОтгрузки(СсылкаНаОбъект));
	КонецЕсли;
	
	ДанныеДляПечати		 = ДанныеШапки(СсылкаНаОбъект); // Шапку всегда заполняем по переданному объекту
	ДанныеТабличнойЧасти = ПолучитьДанныеТЧ(СпДокументовОснований, ЭтоКСФ, , , Истина, ?(ЭтоСФ, СсылкаНаОбъект, Неопределено));
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеДляПечати, ДанныеТабличнойЧасти);
	
	Если СпДокументовОснований.Количество() > 0 Тогда
		НаОснованииОтчетаКомитенту = ?(ТипЗнч(СпДокументовОснований[0].Значение ) = Тип("Документссылка.ОтчетКомитентуОПродажах"), Истина, Ложь);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеДляПечати.ВалютаДокумента) Тогда
		ДанныеДляПечати.ВалютаДокументаКод = "";
	КонецЕсли; 
	
	Если ДанныеДляПечати.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ДанныеТабличнойЧасти);
	КонецЕсли;
	
	ДанныеДляПечати.Вставить("ТабличнаяЧасть", ТаблицаЗначений_2_МассивСтруктур(ДанныеТабличнойЧасти));
	
	//формируем список ПРС
	Запрос = Новый запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПРС.ДатаДокумента КАК ДатаПлатежноРасчетногоДокумента,
	|	ПРС.НомерДокумента КАК НомерПлатежноРасчетногоДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК ПРС
	|ГДЕ
	|	ПРС.Ссылка = &Ссылка
	|	И ПРС.НомерДокумента <> """"
	|	И ПРС.ДатаДокумента <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("Ссылка", ссылкаНаОбъект);
	
	ТаблицаДатаНомерДокументовОплаты=	Запрос.Выполнить().Выгрузить();
	
	ДанныеДляПечати.Вставить("ДатаНомерДокументовОплаты", ТаблицаЗначений_2_МассивСтруктур(ТаблицаДатаНомерДокументовОплаты));
	
	Возврат ДанныеДляПечати;
	
КонецФункции 	

// Параметры:
//  Организация 		- СправочникСсылка.Организации - организация, для которой необходимо получить 
//														 настройку модуля "ПодставлятьКППГрузоотправителя"
//  Грузоотправитель 	- СправочникСсылка.Организации или СправочникСсылка.Контрагенты 
//
Функция КППГрузоотправителя(Организация, Грузоотправитель)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Грузоотправитель) Тогда
		
		ПодставлятьКППГрузоотправителя = МетодСервера(,"ПолучитьЗначениеСвойства", Организация, "ДиадокПодставлятьКППГрузоотправителя");
		
		Если ПодставлятьКППГрузоотправителя = Истина Тогда
			Результат = СокрЛП(Грузоотправитель.КПП);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает информацию о стране происхождения товара в виде структуры.
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - Строка табличной части Товары.
//
// Возвращаемое значение:
//   Структура - Сведения о стране происхождения товара для поля StructedAdditionalInfo:
//      * СтранаПроисхождения - СправочникСсылка.СтраныМира - Страна происхождения товара.
//      * НомерГТД            - СправочникСсылка.НомераГТД - Номер грузовой таможенной декларации.
//
Функция КоллекцияСведенийОСтранеПроисхождения(СтрокаДанных)
	
	Результат = Новый Структура;
	Результат.Вставить("СтранаПроисхождения", СтрокаДанных.СтранаПроисхождения);
	
	НомерГТД = СтрокаДанных.НомерГТД;
	Если ЗначениеЗаполнено(НомерГТД)
		И ЕстьРеквизитИлиСвойствоОбъектаЛок(НомерГТД, "РегистрационныйНомер") Тогда
		НомерГТД = НомерГТД.РегистрационныйНомер;	
	КонецЕсли;
	
	Результат.Вставить("НомерГТД", НомерГТД);
	
	Возврат Результат;

КонецФункции

Процедура Заполнить_Item_CustomDeclarations(Item, Знач СтранаПроисхождения, Знач НомерГТД)
	
	Если Не ЗначениеЗаполнено(СтранаПроисхождения)
		И Не ЗначениеЗаполнено(НомерГТД) Тогда
		Возврат;
	КонецЕсли;
	
	CountryCode = "";
	HyphenCountry = Истина;
	Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		CountryCode = СокрЛП(СтранаПроисхождения.Код);
		HyphenCountry = Ложь;
	КонецЕсли;
	
	Если ТипЗнч(НомерГТД) = Тип("Строка") Тогда
		DeclarationNumber = СокрЛП(НомерГТД);
	ИначеЕсли ЗначениеЗаполнено(НомерГТД) Тогда
		DeclarationNumber = СокрЛП(НомерГТД.Код);
	Иначе
		DeclarationNumber = "";
	КонецЕсли;
	
	СтранаЧленТС = МетодСервера(, "СтранаЧленТС", CountryCode);
	СтранаПроисхожденияСсылка = Справочники.СтраныМира.ПустаяСсылка();
	Если ЗначениеЗаполнено(DeclarationNumber) И Не СтранаЧленТС Тогда
		СтранаПроисхожденияСсылка = СтранаПроисхождения;
	КонецЕсли;
	
	CustomDeclaration = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CustomDeclaration");
	CustomDeclaration.CountryCode = CountryCode;
	CustomDeclaration.HyphenCountry = HyphenCountry;
	CustomDeclaration.DeclarationNumber = DeclarationNumber;
	CustomDeclaration.СтранаПроисхожденияСсылка = СтранаПроисхожденияСсылка;
	
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

Функция ЕстьРеквизитОбъектаЛок(ИмяРеквизита, ОбъектМетаданных)
	
	Результат = (ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	Возврат Результат;
	
КонецФункции

