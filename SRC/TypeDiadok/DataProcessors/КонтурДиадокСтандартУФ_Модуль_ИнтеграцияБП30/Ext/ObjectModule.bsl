Процедура ДополнитьТекстыЗапросовПоТабличнойЧастиАренда(ТекстыЗапросов)
	
	Если Не ЭтоУправлениеАрендой() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстыЗапросов.Вставить(Тип("ДокументСсылка.АР_НачислениеАренднойПлаты"),
		ТекстЗапросаТЧ_НачислениеАренднойПлаты());
	
	ТекстыЗапросов.Вставить(Тип("ДокументСсылка.АР_НачислениеПени"),
		ТекстЗапросаТЧ_НачислениеПени());
	
	ТекстыЗапросов.Вставить(Тип("ДокументСсылка.АР_СчетНаАренду"),
		ТекстЗапросаТЧ_СчетНаАренду());
	
КонецПроцедуры

Функция ТекстЗапросаПоТабличнойЧасти(СсылкаНаОбъект, СчетФактура)
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипСсылки = Тип("ДокументСсылка.ОтчетКомитентуОПродажах")
		И ЗначениеЗаполнено(СчетФактура) Тогда
		
		Результат = ТекстЗапросаТЧ_ОтчетКомитентуОПродажах(СсылкаНаОбъект, СчетФактура);
		
	Иначе
		
		ТекстыЗапросов = Новый Соответствие;
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.РеализацияТоваровУслуг"),
			ТекстЗапросаТЧ_РеализацияТоваровУслуг());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.КорректировкаРеализации"),
			ТекстЗапросаТЧ_КорректировкаРеализации());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг"),
			ТекстЗапросаТЧ_АктОбОказанииПроизводственныхУслуг());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.ОказаниеУслуг"),
			ТекстЗапросаТЧ_ОказаниеУслуг());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.ОтчетКомиссионераОПродажах"),
			ТекстЗапросаТЧ_ОтчетКомиссионераОПродажах());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.ВозвратТоваровПоставщику"),
			ТекстЗапросаТЧ_ВозвратТоваровПоставщику());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.РеализацияУслугПоПереработке"),
			ТекстЗапросаТЧ_РеализацияУслугПоПереработке());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.СчетФактураВыданный"),
			ТекстЗапросаТЧ_СчетФактураВыданный_Авансы());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.СчетНаОплатуПокупателю"),
			ТекстЗапросаТЧ_СчетНаОплатуПокупателю());
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.ПередачаОС"),
			?(ИспользуетсяУчетПрослеживаемыхТоваров(), ТекстЗапросаТЧ_ПередачаОС_Прослеживаемость(), ТекстЗапросаТЧ_ПередачаОС()));
		
		ТекстыЗапросов.Вставить(Тип("ДокументСсылка.ОтчетКомитентуОПродажах"),
			ТекстЗапросаТЧ_ОтчетКомитентуОПродажах_Вознаграждение());
		
		ДополнитьТекстыЗапросовПоТабличнойЧастиАренда(ТекстыЗапросов);
		
		Результат = ТекстыЗапросов.Получить(ТипСсылки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧастьДокумента(СсылкаНаОбъект, СчетФактура)
	
	ТекстЗапроса = ТекстЗапросаПоТабличнойЧасти(СсылкаНаОбъект, СчетФактура);
	
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		
		Ошибка = "Не удалось получить данные табличной части документа (%1)!";
		
		Ошибка = СтрШаблон(Ошибка, СсылкаНаОбъект);
		
		ИмяСобытия = НСтр("ru = 'Диадок'; en = 'Diadoc'");
		
		ЗаписьЖурналаРегистрации(ИмяСобытия,
			УровеньЖурналаРегистрации.Ошибка,
			СсылкаНаОбъект.Метаданные(),
			СсылкаНаОбъект,
			Ошибка);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	КолонкаКодаТовараИзТЧ			 = "НЕОПРЕДЕЛЕНО";
	КолонкаКодаТовараИзШапки		 = "НЕОПРЕДЕЛЕНО"; // Для случая, когда номенклатура в шапке (ОказаниеУслуг)
	КолонкаИдентификаторСтрокиИзТЧ	 = "НЕОПРЕДЕЛЕНО"; // Для прослеживаемости
	
	ИмяКолонкиКод = ИмяКолонкиКодТовара();
	Если ЗначениеЗаполнено(ИмяКолонкиКод) Тогда 
		КолонкаКодаТовараИзТЧ	 = "Т.Номенклатура." + ИмяКолонкиКод;
		КолонкаКодаТовараИзШапки = "Т.Ссылка.Номенклатура." + ИмяКолонкиКод;
	КонецЕсли;
	
	ТабличныеЧастиРеализации = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти;
	Если ЕстьРеквизитМетаданных(ТабличныеЧастиРеализации.Товары, "ИдентификаторСтроки") Тогда
		КолонкаИдентификаторСтрокиИзТЧ = "Т.ИдентификаторСтроки";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КодНоменклатурыИзТЧ"			 , КолонкаКодаТовараИзТЧ);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КодНоменклатурыИзШапки"		 , КолонкаКодаТовараИзШапки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерГТДПредставление"		 , ТекстЗапросаТЧ_НомерГТДПредставление());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторСтрокиИзТЧ"		 , КолонкаИдентификаторСтрокиИзТЧ);
	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ЭтоИсправление = ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.КорректировкаРеализации");
	Если ЭтоИсправление Тогда
		//про формировании ИСФ, торг-12 или акта на основании корректировки
		//удалим строки с пустой суммой
		УдалитьСтрокиТабличнойЧастиБезСуммы(Результат);
	КонецЕсли;
	
	ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоРеализации(Результат, СсылкаНаОбъект);
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьСтрокиТабличнойЧастиБезСуммы(ТоварыПоДокументу)
	
	Индекс = 0;
	Пока Индекс < ТоварыПоДокументу.Количество() Цикл
		ВыборкаТЧ = ТоварыПоДокументу[Индекс];
		Если ВыборкаТЧ.Сумма = 0 Тогда 
			ТоварыПоДокументу.Удалить(Индекс);
		Иначе 
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Формирует текст запроса для получения табличной части корректировочного документа.
// Аналог функции УчетНДС.ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур
//
// Параметры:
//  НомераТаблиц - Структура - содержит:
//    * Ключ - имя таблицы
//    * Значение - индекс результата запроса при выполнении пакета запросов
// 
// Возвращаемое значение:
//  Строка.
//
Функция ТекстЗапросаТаблицаКорректировочногоДокумента(НомераТаблиц)
	
	НомераТаблиц.Вставить("ТаблицаДокумента", НомераТаблиц.Количество());
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.НомерТабЧасти КАК НомерТабЧасти,
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДокумента.Товар КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &ДополнительнаяКолонкаПечатныхФормДокументов = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул)
	|			ТОГДА ТаблицаДокумента.ТоварАртикул
	|		ИНАЧЕ ТаблицаДокумента.ТоварКод
	|	КОНЕЦ КАК НоменклатураКод,
	|	ТаблицаДокумента.ТоварНаименование КАК НоменклатураПредставление,
	|	ТаблицаДокумента.ТоварКодТНВЭД КАК ТоварКодТНВЭД,
	|	ТаблицаДокумента.ТоварКодТНВЭДДоИзменения КАК ТоварКодТНВЭДДоИзменения,
	|	ТаблицаДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК ЕдиницаИзмеренияНаименование,
	|	ТаблицаДокумента.КоличествоДоИзменения КАК КоличествоДоИзменения,
	|	ТаблицаДокумента.КоличествоПослеИзменения КАК КоличествоПослеИзменения,
	|	ТаблицаДокумента.ЦенаДоИзменения КАК ЦенаДоИзменения,
	|	ТаблицаДокумента.ЦенаПослеИзменения КАК ЦенаПослеИзменения,
	|	ТаблицаДокумента.СтоимостьБезНДСДоИзменения КАК СтоимостьБезНДСДоИзменения,
	|	ТаблицаДокумента.СтоимостьБезНДСПослеИзменения КАК СтоимостьБезНДСПослеИзменения,
	|	&СтавкаНДСДоИзменения КАК СтавкаНДСДоИзменения,
	|	&СтавкаНДСПослеИзменения КАК СтавкаНДСПослеИзменения,
	|	ТаблицаДокумента.СуммаНДСДоИзменения КАК СуммаНДСДоИзменения,
	|	ТаблицаДокумента.СуммаНДСПослеИзменения КАК СуммаНДСПослеИзменения,
	|	ТаблицаДокумента.СтоимостьСНДСДоИзменения КАК СтоимостьСНДСДоИзменения,
	|	ТаблицаДокумента.СтоимостьСНДСПослеИзменения КАК СтоимостьСНДСПослеИзменения,
	|	ТаблицаДокумента.РазницаБезНДСУвеличение КАК РазницаБезНДСУвеличение,
	|	ТаблицаДокумента.РазницаБезНДСУменьшение КАК РазницаБезНДСУменьшение,
	|	ТаблицаДокумента.РазницаНДСУвеличение КАК РазницаНДСУвеличение,
	|	ТаблицаДокумента.РазницаНДСУменьшение КАК РазницаНДСУменьшение,
	|	ТаблицаДокумента.РазницаСНДСУвеличение КАК РазницаСНДСУвеличение,
	|	ТаблицаДокумента.РазницаСНДСУменьшение КАК РазницаСНДСУменьшение,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.НомерГТД = ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)
	|				ИЛИ ТаблицаДокумента.НомерГТД = НЕОПРЕДЕЛЕНО
	|			ТОГДА NULL
	|		ИНАЧЕ ТаблицаДокумента.НомерГТД
	|	КОНЕЦ КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.СтранаПроисхождения = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|				ИЛИ ТаблицаДокумента.СтранаПроисхождения = НЕОПРЕДЕЛЕНО
	|			ТОГДА NULL
	|		ИНАЧЕ ТаблицаДокумента.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	&ИдентификаторСтрокиТовары КАК ИдентификаторСтроки,
	|	&СуммаАкцизаДоИзменения КАК АкцизДоИзменения,
	|	&СуммаАкцизаПослеИзменения КАК Акциз
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ТаблицаДокумента.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ТаблицаДокумента.Товар = Номенклатура.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабЧасти,
	|	НомерСтроки";
	
	ВерсияБП = ВерсияБухгалтерскойПодсистемы();
	
	Выражение_СтавкаНДСДоИзменения = "ТаблицаДокумента.СтавкаНДС";
	Выражение_СтавкаНДСПослеИзменения = "ТаблицаДокумента.СтавкаНДС";
	Если СравнитьВерсии(ВерсияБП, "3.0.67") >= 0 Тогда
		Выражение_СтавкаНДСДоИзменения = "ТаблицаДокумента.СтавкаНДСДоИзменения";
		Выражение_СтавкаНДСПослеИзменения = "ТаблицаДокумента.СтавкаНДСПослеИзменения";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтавкаНДСДоИзменения", Выражение_СтавкаНДСДоИзменения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтавкаНДСПослеИзменения", Выражение_СтавкаНДСПослеИзменения);
	
	Если МетодСервера(,"СуществуетОбъектМетаданных", "Документ.КорректировкаРеализации.ТабличнаяЧасть.Товары.Реквизит.ИдентификаторСтроки") Тогда
		КолонкаИдентификаторСтрокиТовары = "ТаблицаДокумента.ИдентификаторСтроки";
	Иначе
		КолонкаИдентификаторСтрокиТовары = "НЕОПРЕДЕЛЕНО";
	КонецЕсли; 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторСтрокиТовары", КолонкаИдентификаторСтрокиТовары);
	
	МетаданныеТчТоварыКорректировкиРеализации = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Товары;
	
	ЕстьАкцизДоИзменения = ЕстьРеквизитОбъектаЛок("СуммаАкцизаДоИзменения", МетаданныеТчТоварыКорректировкиРеализации);
	ЕстьАкциз = ЕстьРеквизитОбъектаЛок("СуммаАкциза", МетаданныеТчТоварыКорректировкиРеализации);
	ЕстьКодыВидовПодакцизныхТоваров = Метаданные.Справочники.Найти("КодыВидовПодакцизныхТоваров") <> Неопределено;
	
	Если ЕстьАкцизДоИзменения
		И ЕстьКодыВидовПодакцизныхТоваров Тогда
		Выражение_СуммаАкцизаДоИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.Товар.КодВидаПодакцизногоТовара <> ЗНАЧЕНИЕ(Справочник.КодыВидовПодакцизныхТоваров.ПустаяСсылка)
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	ИначеЕсли ЕстьАкцизДоИзменения Тогда
		Выражение_СуммаАкцизаДоИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения <> 0
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаДоИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	Иначе
		Выражение_СуммаАкцизаДоИзменения = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	Если ЕстьАкциз
		И ЕстьКодыВидовПодакцизныхТоваров Тогда
		Выражение_СуммаАкцизаПослеИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.Товар.КодВидаПодакцизногоТовара <> ЗНАЧЕНИЕ(Справочник.КодыВидовПодакцизныхТоваров.ПустаяСсылка)
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	ИначеЕсли ЕстьАкциз Тогда
		Выражение_СуммаАкцизаПослеИзменения =
			"ВЫБОР
			|	КОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения <> 0
			|		ТОГДА ТаблицаДокумента.СуммаАкцизаПослеИзменения
			|	ИНАЧЕ НЕОПРЕДЕЛЕНО
			|КОНЕЦ";
	Иначе
		Выражение_СуммаАкцизаПослеИзменения = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаАкцизаДоИзменения", Выражение_СуммаАкцизаДоИзменения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаАкцизаПослеИзменения", Выражение_СуммаАкцизаПослеИзменения);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаКорректируемыеНомераСтрок(НомераТаблиц)
	
	НомераТаблиц.Вставить("КорректируемыеНомераСтрок", НомераТаблиц.Количество());
	
	ТекстЗапроса = РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.Ссылка КАК СчетФактура,
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.НомерСтроки КАК НомерСтроки,
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.НомерИсходнойСтроки КАК НомерИсходнойСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.КорректируемыеНомераСтрок КАК СчетФактураВыданныйКорректируемыеНомераСтрок
	|ГДЕ
	|	СчетФактураВыданныйКорректируемыеНомераСтрок.Ссылка = &СчетФактура
	|	И СчетФактураВыданныйКорректируемыеНомераСтрок.Ссылка.ВидСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ДобавитьПараметрыЗапросаПоТабличнойЧастиКорректировочногоДокументаАренда(Запрос, ДокументОснование)
	
	Если Не ЭтоУправлениеАрендой()
		Или ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Возврат;
	КонецЕсли;
	
	ЕдиницаПоУмолчанию = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	СчетФактураСводный = Ложь;
	
	Если ТипЗнч(ДокументОснование.ДокументРеализации) = Тип("ДокументСсылка.АР_НачислениеАренднойПлаты") Тогда
		
		ЭтоПени = Ложь;
		ЭтоАренда = Истина;
		
		НачалоПериода = ДокументОснование.ДокументРеализации.НачалоПериода;
		ОкончаниеПериода = КонецДня(ДокументОснование.ДокументРеализации.ОкончаниеПериода);
		ПредставлениеПериода = ПредставлениеПериода(НачалоПериода, ОкончаниеПериода);
		
	ИначеЕсли ТипЗнч(ДокументОснование.ДокументРеализации) = Тип("ДокументСсылка.АР_НачислениеПени") Тогда
		
		ЭтоПени = Истина;
		ЭтоАренда = Истина;
		ПредставлениеПериода = Формат(ДокументОснование.Дата, "ДФ='дд.ММ.гггг'");
		
	Иначе
		
		ЭтоПени = Ложь;
		ЭтоАренда = Ложь;
		ПредставлениеПериода = "";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЭтоПени", ЭтоПени);
	Запрос.УстановитьПараметр("ЭтоАренда", ЭтоАренда);
	Запрос.УстановитьПараметр("СчетФактураСводный", СчетФактураСводный);
	Запрос.УстановитьПараметр("ПредставлениеПериода", ПредставлениеПериода);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияШтука", ЕдиницаПоУмолчанию);
	
КонецПроцедуры

Функция ТабличнаяЧастьКорректировочногоДокумента(СсылкаНаОбъект, СчетФактура)
	
	НомераТаблиц = Новый Структура;
	
	ИмяОбъекта = СсылкаНаОбъект.Метаданные().Имя;
	МенеджерОбъекта = Документы[ИмяОбъекта];
	
	ЕстьТЧКорректируемыеНомераСтрок = ЕстьКорректируемыеНомераСтрокВСчетФактураВыданный();
	ЕстьПередачаТоваровВСоставеРабот = ИспользуетсяПередачаПрослеживаемыхМатериаловВСоставеРабот();
	ЭтоКорректировка = ЭтоКорректировкаРеализации(СсылкаНаОбъект);
	
	ЧастиЗапроса = Новый Массив;
	
	Если ЭтоКорректировка
		И ЕстьПередачаТоваровВСоставеРабот Тогда
		
		// Игнорируем флаг в КРТУ, чтобы исключить добавление товаров, передаваемых в составе работ
		ПередачаТоваровВСоставеРабот = Ложь;
		ЧастиЗапроса.Добавить(МенеджерОбъекта.ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур(НомераТаблиц, ПередачаТоваровВСоставеРабот));
		
	Иначе
		
		ЧастиЗапроса.Добавить(МенеджерОбъекта.ТекстЗапросаДанныеДляПечатиКорректировочныхСчетовФактур(НомераТаблиц));
		
	КонецЕсли;
	
	ЧастиЗапроса.Добавить(ТекстЗапросаТаблицаКорректировочногоДокумента(НомераТаблиц));
	Если ЕстьТЧКорректируемыеНомераСтрок Тогда
		ЧастиЗапроса.Добавить(ТекстЗапросаТаблицаКорректируемыеНомераСтрок(НомераТаблиц));
	КонецЕсли;
	
	ПредставлениеПоставщика = "";
	ИННКПППоставщика = "";
	АдресПоставщика = "";
	ДопКолонкаПФ = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();

	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, Символы.ПС);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("ДокументОснование", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ПредставлениеПоставщика", ПредставлениеПоставщика);
	Запрос.УстановитьПараметр("ИННКПППоставщика", ИННКПППоставщика);
	Запрос.УстановитьПараметр("АдресПоставщика", АдресПоставщика);
	Запрос.УстановитьПараметр("ДополнительнаяКолонкаПечатныхФормДокументов", ДопКолонкаПФ);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	ДобавитьПараметрыЗапросаПоТабличнойЧастиКорректировочногоДокументаАренда(Запрос, СсылкаНаОбъект);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатЗапросаПоТЧ = РезультатыЗапроса[НомераТаблиц.ТаблицаДокумента];
	ВыгрузкаТЧ = РезультатЗапросаПоТЧ.Выгрузить();
	
	СведенияОПрослеживаемости = Неопределено;
	Если ИспользуетсяУчетПрослеживаемыхТоваров 
		И НомераТаблиц.Свойство("СведенияОПрослеживаемости") Тогда
		СведенияОПрослеживаемости = РезультатыЗапроса[НомераТаблиц.СведенияОПрослеживаемости].Выгрузить();
	КонецЕсли;
	
	КорректируемыеНомераСтрок = Неопределено;
	Если ЕстьТЧКорректируемыеНомераСтрок Тогда
		КорректируемыеНомераСтрок = РезультатыЗапроса[НомераТаблиц.КорректируемыеНомераСтрок].Выгрузить();
	КонецЕсли;
	
	Результат = ИнициализацияТаблицыСтрокТовары(Истина);
	
	НомерСтроки = 1;
	
	Для каждого СтрокаТЧ Из ВыгрузкаТЧ Цикл
		
		Если СтрокаТЧ.КоличествоДоИзменения = 0 Тогда
			СтрокаТЧ.ЦенаДоИзменения = 0;
		ИначеЕсли СтрокаТЧ.ЦенаДоИзменения = 0 Тогда
			СтрокаТЧ.ЦенаДоИзменения = Окр(СтрокаТЧ.СтоимостьБезНДСДоИзменения / СтрокаТЧ.КоличествоДоИзменения, 2);
		КонецЕсли;
		
		Если СтрокаТЧ.КоличествоПослеИзменения = 0 Тогда
			СтрокаТЧ.ЦенаПослеИзменения = СтрокаТЧ.ЦенаДоИзменения;
		ИначеЕсли СтрокаТЧ.ЦенаПослеИзменения = 0 Тогда
			СтрокаТЧ.ЦенаПослеИзменения = Окр(СтрокаТЧ.СтоимостьБезНДСПослеИзменения / СтрокаТЧ.КоличествоПослеИзменения, 2);
		КонецЕсли;
		
		СтрокаТовары = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовары, СтрокаТЧ);
		
		СтрокаТовары.НомерИсходнойСтроки = СтрокаТЧ.НомерСтроки;
		
		СтрокаТовары.КодНоменклатуры	= СтрокаТЧ.НоменклатураКод;
		СтрокаТовары.Количество			= СтрокаТЧ.КоличествоПослеИзменения;
		СтрокаТовары.Цена				= СтрокаТЧ.ЦенаПослеИзменения;
		СтрокаТовары.Сумма				= СтрокаТЧ.СтоимостьБезНДСПослеИзменения;
		СтрокаТовары.СуммаНДС			= СтрокаТЧ.СуммаНДСПослеИзменения;
		СтрокаТовары.СтавкаНДС			= СтрокаТЧ.СтавкаНДСПослеИзменения;
		СтрокаТовары.СуммаДоИзменения	= СтрокаТЧ.СтоимостьБезНДСДоИзменения;
		СтрокаТовары.СуммаВключаетНДС	= Ложь;
		СтрокаТовары.ДокументОтгрузки	= СсылкаНаОбъект;
		
		СтрокаТовары.ЕдиницаИзмеренияДоИзменения = СтрокаТЧ.ЕдиницаИзмерения;
		СтрокаТовары.ЭтоУслуга = ЭтоНоменклатураУслуга(СтрокаТЧ.Номенклатура);
		
		Если СведенияОПрослеживаемости <> Неопределено Тогда
			ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(СтрокаТовары, СтрокаТЧ, СведенияОПрослеживаемости);
		КонецЕсли;
		
		СтрокаТовары.НомерИсходнойСтроки = 0;
		Если КорректируемыеНомераСтрок <> Неопределено Тогда
			СтрокаСНомером = КорректируемыеНомераСтрок.Найти(НомерСтроки, "НомерСтроки");
			Если СтрокаСНомером <> Неопределено Тогда
				СтрокаТовары.НомерИсходнойСтроки = СтрокаСНомером.НомерИсходнойСтроки;
			КонецЕсли;
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВидКИ(ЮрФизЛицо, ЮрАдрес, УДАЛИТЬ_ИндивидуальныйПредприниматель = Ложь) Экспорт
	
	ВидАдреса = Неопределено;
	
	ТипЮрФизЛица = ТипЗнч(ЮрФизЛицо);
	
	Если ТипЮрФизЛица = Тип("СправочникСсылка.Организации") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресОрганизации", "ФактАдресОрганизации");
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.Контрагенты") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресКонтрагента", "ФактАдресКонтрагента");
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "АдресПоПропискеФизическиеЛица", "АдресМестаПроживанияФизическиеЛица");
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда 
		
		ВидАдреса = "ФактическийАдресПодразделенияОрганизаций";
		
	Иначе 
		ВызватьИсключение НСтр("ru = 'Некорректный параметр функции ""ПолучитьВидКИ""'");
	КонецЕсли;
	
	Результат = Справочники.ВидыКонтактнойИнформации[ВидАдреса];
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеТЧ(Документы,
	ЭтоКСФ = Ложь,
	НеИспользуется_ВалютаРегламентированногоУчета = Неопределено,
	НеИспользуется_КолонкаКодаТовараИзТЧ = Неопределено,
	НеИспользуется_ФормированиеСФ = Неопределено,
	СчетФактура = Неопределено) Экспорт
	
	//Документы - список документов либо одичночнй документ
	Если СчетФактуранаАванс(СчетФактура) Тогда 
		ДокументыИтератор= Новый списокЗначений;
		ДокументыИтератор.Добавить(СчетФактура);
	ИначеЕсли ТипЗнч(Документы) = Тип("СписокЗначений") Тогда 
		ДокументыИтератор= Документы;
	Иначе 
		ДокументыИтератор= Новый СписокЗначений;
		ДокументыИтератор.Добавить(Документы);
	КонецЕсли;
	
	Товары = ИнициализацияТаблицыСтрокТовары(ЭтоКСФ);
	
	Для Каждого Элемент из ДокументыИтератор Цикл
		
		СсылкаНаОбъект = Элемент.Значение;
		
		Если ЭтоКСФ Тогда
			ТоварыПоДокументу = ТабличнаяЧастьКорректировочногоДокумента(СсылкаНаОбъект, СчетФактура);
		Иначе
			ТоварыПоДокументу = ТабличнаяЧастьДокумента(СсылкаНаОбъект, СчетФактура);
		КонецЕсли;
		
		ЕстьКолонка_НомерГТДПредставление = (ТоварыПоДокументу.Колонки.Найти("НомерГТДПредставление") <> Неопределено);
		
		Для каждого Стр из ТоварыПоДокументу Цикл 
			
			Стр2 = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Стр2, Стр);
			
			Если Не ЗначениеЗаполнено(Стр2.НоменклатураПредставление) Тогда 
				Стр2.НоменклатураПредставление = ПредставлениеНоменклатуры(Стр2.Номенклатура, Стр2.Характеристика);
			КонецЕсли;
			
			Если ЕстьКолонка_НомерГТДПредставление И ЗначениеЗаполнено(Стр.НомерГТДПредставление) Тогда
				Стр2.НомерГТД = Стр.НомерГТДПредставление;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Стр.СтранаПроисхождения) Тогда
				Если (НЕ ЗначениеЗаполнено(Стр.НомерГТД) ИЛИ ПустаяСтрока(Стр.НомерГТД.Код)) 
					И МетодСервера(,"СтранаЧленТС", Стр.СтранаПроисхождения.Код)
					И НЕ Стр2.ПрослеживаемыйТовар Тогда
					Стр2.СтранаПроисхождения = Справочники.СтраныМира.ПустаяСсылка();
				КонецЕсли;
			//Иначе
			//	Стр2.НомерГТД = Справочники.НомераГТД.ПустаяСсылка();
			КонецЕсли;
			
			Стр2.ДокументОтгрузки = СсылкаНаОбъект;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Товары;
	
КонецФункции

Функция ПолучитьБанковскийСчет(Док)
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ДокТоварный = Док.ДокументРеализации;
		
		Пока ТипЗнч(ДокТоварный) = Тип("ДокументСсылка.КорректировкаРеализации") Цикл
			ДокТоварный = ДокТоварный.ДокументРеализации;
		КонецЦикла;
		
	ИначеЕсли Метаданные.Документы.Найти("АР_НачислениеАренднойПлаты") <> Неопределено
		И ТипЗнч(Док) = Тип("ДокументСсылка.АР_НачислениеАренднойПлаты") Тогда
		
		Результат = Док.СчетОрганизации;
		
		Возврат Результат;
		
	Иначе
		
		ДокТоварный = Док;
		
	КонецЕсли;
	
	Возврат ?(ДокТоварный.Метаданные().Реквизиты.найти("БанковскийСчетОрганизации") = Неопределено, Неопределено, ДокТоварный.БанковскийСчетОрганизации);
	
КонецФункции

Функция ПолучитьПодразделениеИзДокумента(ДокСсылка)
	Возврат ?(ДокСсылка.ПодразделениеОрганизации.ОбособленноеПодразделение, ДокСсылка.ПодразделениеОрганизации.НаименованиеПолное, "");
КонецФункции

Функция ПолучитьМассивСсылокРТУПоСчетуНаОплату(СчетСсылка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
  		|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
      	|ИЗ
      	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
     	|ГДЕ
      	|	РеализацияТоваровУслуг.СчетНаОплатуПокупателю = &СчетНаОплатуПокупателю
      	|	И РеализацияТоваровУслуг.ПометкаУдаления = ЛОЖЬ";
				  
	Запрос.УстановитьПараметр("СчетНаОплатуПокупателю", СчетСсылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ссылка");		
	
КонецФункции

Функция ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(СчетФактура) Экспорт
	
	ТекстЗапроса =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.ДоговорКонтрагента КАК Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.ДоговорКонтрагента
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
