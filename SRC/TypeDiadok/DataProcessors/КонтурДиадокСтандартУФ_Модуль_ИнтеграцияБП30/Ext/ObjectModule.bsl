Функция ТекстЗапроса_СчетФактура_ЭтоКорректировка(ПсевдонимТаблицы = "ДанныеДокументов")
	
	ВидыКСФ = Новый Массив;
	ВидыКСФ.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.Корректировочный)");
	Если ИспользуетсяКорректировкаСчетаФактурыНаАванс() Тогда
		ВидыКСФ.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидСчетаФактурыВыставленного.КорректировочныйНаАванс)");
	КонецЕсли;
	
	Результат =
	"ВЫБОР
	|	КОГДА ПсевдонимТаблицы.ВидСчетаФактуры В (&ВидыКСФ)
	|		ТОГДА ИСТИНА
	|	ИНАЧЕ ЛОЖЬ
	|КОНЕЦ";
	
	Результат = СтрЗаменить(Результат, "&ВидыКСФ", СтрСоединить(ВидыКСФ, ","));
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Процедура ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Выражение, ПсевдонимТаблицы)
	
	ПодстрокаПоиска = "ПсевдонимТаблицы";
	Если Не ЗначениеЗаполнено(ПсевдонимТаблицы) Тогда
		ПодстрокаПоиска = ПодстрокаПоиска + ".";
	КонецЕсли;
	
	Выражение = СтрЗаменить(Выражение, ПодстрокаПоиска, ПсевдонимТаблицы);
	
КонецПроцедуры

Функция ТекстЗапроса_ТЧРеализацияТоваровУслуг_СвязьСоСчетом(ПсевдонимТаблицы, ПолеСоединения)
	
	Результат = "";
	
	ТабличныеЧастиРеализации = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти;
	
	Если ЕстьРеквизитМетаданных(ТабличныеЧастиРеализации.Товары, "СчетНаОплатуПокупателю") Тогда
		
		Результат = Результат + "
		|
		|ОБЪЕДИНИТЬ
		|	
		|ВЫБРАТЬ
		|	ПсевдонимТаблицы.Документ,
		|	РеализацияТоваровУслугТовары.СчетНаОплатуПокупателю
		|ИЗ
		|	ПсевдонимТаблицы КАК ПсевдонимТаблицы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|		ПО ПсевдонимТаблицы.ПолеСоединения = РеализацияТоваровУслугТовары.Ссылка
		|			И (НЕ РеализацияТоваровУслугТовары.СчетНаОплатуПокупателю В (&ПустыеЗначенияСчет))
		|ГДЕ
		|	ПсевдонимТаблицы.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
		|";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(ТабличныеЧастиРеализации.Услуги, "СчетНаОплатуПокупателю") Тогда
		
		Результат = Результат + "
		|
		|ОБЪЕДИНИТЬ
		|	
		|ВЫБРАТЬ
		|	ПсевдонимТаблицы.Документ,
		|	РеализацияТоваровУслугУслуги.СчетНаОплатуПокупателю
		|ИЗ
		|	ПсевдонимТаблицы КАК ПсевдонимТаблицы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
		|		ПО ПсевдонимТаблицы.ПолеСоединения = РеализацияТоваровУслугУслуги.Ссылка
		|			И (НЕ РеализацияТоваровУслугУслуги.СчетНаОплатуПокупателю В (&ПустыеЗначенияСчет))
		|ГДЕ
		|	ПсевдонимТаблицы.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
		|";
		
	КонецЕсли;
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	Результат = СтрЗаменить(Результат, "ПолеСоединения", ПолеСоединения); 
	
	Возврат Результат;
	
КонецФункции

Функция ИменаТабличныхЧастейОснованийСчетаФактуры()
	
	Результат = Новый Массив;
	Результат.Добавить("Документ.РеализацияТоваровУслуг.Товары");
	Результат.Добавить("Документ.РеализацияТоваровУслуг.Услуги");
	Результат.Добавить("Документ.РеализацияТоваровУслуг.АгентскиеУслуги");
	
	Результат.Добавить("Документ.КорректировкаРеализации.Товары");
	Результат.Добавить("Документ.КорректировкаРеализации.Услуги");
	Результат.Добавить("Документ.КорректировкаРеализации.АгентскиеУслуги");
	
	Результат.Добавить("Документ.ВозвратТоваровПоставщику.Товары");
	Результат.Добавить("Документ.АктОбОказанииПроизводственныхУслуг.Услуги");
	Результат.Добавить("Документ.РеализацияУслугПоПереработке.Услуги");
	Результат.Добавить("Документ.ОтчетКомитентуОПродажах.Товары");
	
	Если ЭтоУправлениеАрендой() Тогда
		Результат.Добавить("Документ.АР_НачислениеАренднойПлаты.Состав");
		Результат.Добавить("Документ.АР_НачислениеПени.Состав");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_Поместить_ДанныеДокументаИДокументыОснования()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетаФактуры.Документ КАК Документ,
	|	СчетаФактуры.ЭтоИсправление КАК ЭтоИсправление,
	|	СчетаФактуры.ЭтоКорректировка КАК ЭтоКорректировка,
	|	СчетаФактуры.ЭтоАванс КАК ЭтоАванс,
	|	СчетаФактуры.Организация КАК Организация,
	|	СчетаФактуры.Контрагент КАК Контрагент,
	|	СчетаФактуры.Валюта КАК Валюта,
	|	СчетаФактуры.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	СчетаФактуры.ID КАК ID,
	|	СчетаФактуры.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	СчетаФактуры.Проведен КАК Проведен,
	|	СчетаФактуры.Дата КАК Дата,
	|	СчетаФактуры.Номер КАК Номер,
	|	СчетаФактуры.ФормироватьУПД КАК ФормироватьУПД,
	|	ДокументыОснования.ДокументОснование КАК ДокументОснование,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ДокументОснованиеID,
	|	СчетаФактуры.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета
	|ПОМЕСТИТЬ ДанныеДокументаИДокументыОснования
	|ИЗ
	|	ВТ_Основная КАК СчетаФактуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК ДокументыОснования
	|		ПО СчетаФактуры.Документ = ДокументыОснования.Ссылка
	|			И (ДокументыОснования.ДокументОснование <> НЕОПРЕДЕЛЕНО)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (ДокументыОснования.ДокументОснование = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_Поместить_СуммыДокОснованийЗначение()
	
	ПолныеИменаТабличныхЧастей = ИменаТабличныхЧастейОснованийСчетаФактуры();
	
	ШаблонВложенногоЗапроса = 
	"ВЫБРАТЬ
	|	ДанныеСФ.Документ КАК Документ,
	|	ТабличнаяЧастьОснованияСФ.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	ДанныеДокументаИДокументыОснования КАК ДанныеСФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИмяТабличнойЧасти КАК ТабличнаяЧастьОснованияСФ
	|		ПО ДанныеСФ.ДокументОснование = ТабличнаяЧастьОснованияСФ.Ссылка";
	
	ВложенныеЗапросы = Новый Массив;
	
	Для Каждого ИмяТЧ Из ПолныеИменаТабличныхЧастей Цикл
		ТекстЗапроса = СтрЗаменить(ШаблонВложенногоЗапроса, "ИмяТабличнойЧасти", ИмяТЧ);
		ВложенныеЗапросы.Добавить(ТекстЗапроса);
	КонецЦикла;
	
	ВложенныйЗапрос = СтрСоединить(ВложенныеЗапросы, РазделительОбъединенияЗапросов());
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС
	|ПОМЕСТИТЬ СуммыДокОснованийЗначение
	|ИЗ
	|	(ТекстВложенногоЗапроса) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ";
	
	Результат = СтрЗаменить(Результат, "ТекстВложенногоЗапроса", ВложенныйЗапрос);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_Поместить_СЧФ_Основная()
	
	Результат =
	"ВЫБРАТЬ
	|	СЧФ_Предварительная.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА СЧФ_Предварительная.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_КорректировочныйСчетФактура
	|		ИНАЧЕ &ВидыЭД_СчетФактура
	|	КОНЕЦ КАК ВидЭД,
	|	СЧФ_Предварительная.ЭтоИсправление КАК ЭтоИсправление,
	|	СЧФ_Предварительная.ЭтоКорректировка КАК ЭтоКорректировка,
