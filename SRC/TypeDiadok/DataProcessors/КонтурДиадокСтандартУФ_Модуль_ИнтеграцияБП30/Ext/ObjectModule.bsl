// Вызывается из Модуль_ИнтеграцияУниверсальный.ХранилищеКонтактнойИнформацииОбъекта.
//
// Параметры:
//  ХранилищеКИ			 - ЛюбаяСсылка	 - место хранения контактной информации;
//  СсылкаНаОбъект		 - ЛюбаяСсылка	 - объект-владелец контактной информации;
//  СтандартнаяОбработка - Булево		 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриОпределенииМестаХраненияКонтактнойИнформацииОбъекта(ХранилищеКИ, СсылкаНаОбъект, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ХранилищеКИ = СсылкаНаОбъект;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.Организации") 
		И МетодСервера(,"СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "3.0.43.148") < 0 Тогда 
		// До указанной версии контактная информация индивидуального предпринимателя
		// хранилась в карточке физического лица
	
		СписокРеквизитов = Новый Структура;
		СписокРеквизитов.Вставить("ЮридическоеФизическоеЛицо");
		СписокРеквизитов.Вставить("ИндивидуальныйПредприниматель");
		
		РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, СписокРеквизитов);
		
		Если РеквизитыОрганизации.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			ХранилищеКИ = РеквизитыОрганизации.ИндивидуальныйПредприниматель;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидыИсходящихДокументов.
//
// Параметры:
//  ВидыДокументов - ТаблицаЗначений - см. функцию Модуль_ИнтеграцияУниверсальный.ВидыИсходящихДокументов;
//
Процедура ПриПолученииВидовИсходящихДокументов(ВидыДокументов) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	
	ПсевдонимТаблицы = "ОсновнаяТаблица";
	ОтборКорректировочныхСчетовФактур = ТекстЗапроса_СчетФактура_ЭтоКорректировка(ПсевдонимТаблицы);
	ОтборКорректировокРеализаций = ТекстЗапроса_КРТУ_ЭтоКорректировка(ПсевдонимТаблицы);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.СчетФактураВыданный, 
		ВидыЭД.СчетФактура,
		"НЕ " + ОтборКорректировочныхСчетовФактур);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.СчетФактураВыданный,
		ВидыЭД.КорректировочныйСчетФактура,
		ОтборКорректировочныхСчетовФактур);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.СчетНаОплатуПокупателю,
		ВидыЭД.СчетНаОплату,
		Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.РеализацияТоваровУслуг,
		ВидыЭД.СчетНаОплату,
		Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.РеализацияТоваровУслуг,
		ВидыЭД.ТоварнаяНакладная,
		"ОсновнаяТаблица.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.Услуги)");
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.РеализацияТоваровУслуг,
		ВидыЭД.АктОбОказанииУслуг,
		"ОсновнаяТаблица.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.Услуги)");
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.АктОбОказанииПроизводственныхУслуг,
		ВидыЭД.АктОбОказанииУслуг,
		Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.ОтчетКомитентуОПродажах,
		ВидыЭД.АктОбОказанииУслуг,
		Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.КорректировкаРеализации,
		ВидыЭД.ТоварнаяНакладная,
		"ВЫРАЗИТЬ(ОсновнаяТаблица.ИсправляемыйДокументРеализации КАК Документ.РеализацияТоваровУслуг).ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеализацияТоваров.Услуги)
		|	И НЕ " + ОтборКорректировокРеализаций);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.КорректировкаРеализации, 
		ВидыЭД.АктОбОказанииУслуг,
		"НЕ " + ОтборКорректировокРеализаций);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов,
		Метаданные.Документы.КорректировкаРеализации,
		ВидыЭД.СоглашениеОбИзмененииСтоимости,
		ОтборКорректировокРеализаций);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидыВходящихДокументов.
//
// Параметры:
//  ВидыДокументов - ТаблицаЗначений - см. функцию Модуль_ИнтеграцияУниверсальный.ВидыВходящихДокументов;
//
Процедура ПриПолученииВидовВходящихДокументов(ВидыДокументов) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураПолученный
		, ВидыЭД.СчетФактура
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетНаОплатуПоставщика
		, ВидыЭД.СчетНаОплату
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеТоваровУслуг
		, ВидыЭД.ТоварнаяНакладная
		, Неопределено);
		
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеНМА
		, ВидыЭД.ТоварнаяНакладная
		, Неопределено);
		
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеТоваровУслуг
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПоступлениеДопРасходов
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураПолученный
		, ВидыЭД.КорректировочныйСчетФактура
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.КорректировкаПоступления
		, ВидыЭД.СоглашениеОбИзмененииСтоимости
		, Неопределено);
	
КонецПроцедуры

