#Область СчетНаОплатуПоставщика

Функция СтруктураЗаполненияСчетаНаОплатуПоставщика(ДанныеЭД, ДополнительныеПараметры)
	
	ПустаяСсылкаНаДокумент = Документы.СчетНаОплатуПоставщика.ПустаяСсылка();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Контрагент = СсылкаНаУчастникаСделки(ШапкаЭД.Продавец);
	НомерБанковскогоСчета = ШапкаЭД.Продавец.НомерСчета;
	БанковскийСчетКонтрагента = БанковскийСчетКонтрагента(Контрагент, НомерБанковскогоСчета);
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент", Контрагент);
	
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов", 1);
	Шапка.Вставить("СуммаВключаетНДС", ДополнительныеПараметры.ЦенаВключаетНДС);
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	Шапка.Вставить("БанковскийСчетКонтрагента", БанковскийСчетКонтрагента);
	Шапка.Вставить("СуммаДокумента", ДанныеЭД.Итоги.СуммаСНДС);
	
	Товары = ПустаяСсылкаНаДокумент.Товары.ВыгрузитьКолонки();
	
	Для Каждого СтрокаТовара Из ДанныеЭД.ТоварнаяЧасть Цикл
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура.Номенклатура;
		НоваяСтрока.Содержание = СтрокаТовара.НоменклатураКонтрагента.Наименование;
		НоваяСтрока.Количество = СтрокаТовара.Количество;
		
		ЗаполнитьЦенуСуммуПоСтроке(НоваяСтрока, СтрокаТовара, ДополнительныеПараметры.ЦенаВключаетНДС);
		
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(СтрокаТовара.НоменклатураКонтрагента.СтавкаНДС);
		НоваяСтрока.СуммаНДС = СтрокаТовара.СуммаНДС;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("Товары", Товары);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция БанковскийСчетКонтрагента(Контрагент, НомерБанковскогоСчета)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК БанковскийСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Контрагент
	|	И БанковскиеСчета.НомерСчета = &НомерБанковскогоСчета";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НомерБанковскогоСчета", НомерБанковскогоСчета);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ЗначениеЗаполнено(РезультатЗапроса) Тогда
		Результат = РезультатЗапроса[0].БанковскийСчет;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСчетНаОплатуПоставщика(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ДокументОбъект.Ответственный = Пользователи.АвторизованныйПользователь();
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СФакторинговойКомпанией);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);	
		
	ДокументОбъект.Товары.Загрузить(ДанныеДокумента.Товары);
		
КонецПроцедуры

