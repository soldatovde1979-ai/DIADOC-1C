	Модель.ЗначенияПолейЮридическийАдрес = Данные.ЗначенияПолейЮридическийАдрес;
	Модель.ФактическийАдрес = Данные.ФактическийАдрес;
	Модель.ЗначенияПолейФактическийАдрес = Данные.ЗначенияПолейФактическийАдрес;
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

Функция _РеквизитыКонтрагента(Контрагент, Период, БанковскийСчет)
	
	Данные = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Контрагент, Период, БанковскийСчет);
	
	Модель = _Контракт_РеквизитыЮрФизЛица();
	
	Модель.НаименованиеПолное = СокрЛП(Данные.НаименованиеДляПечатныхФорм);
	
	Модель.НомерСчета = Данные.НомерСчета;
	Модель.БИК = Данные.БИК;
	Модель.Банк = СокрЛП(Данные.Банк);
	Модель.КоррСчет = Данные.КоррСчет;
	
	Модель.Телефоны = Данные.Телефоны;
	Модель.Email = Данные.Email;
	
	Модель.ЮридическийАдрес = Данные.ЮридическийАдрес;
	Модель.ЗначенияПолейЮридическийАдрес = Данные.ЗначенияПолейЮридическийАдрес;
	Модель.ФактическийАдрес = Данные.ФактическийАдрес;
	Модель.ЗначенияПолейФактическийАдрес = Данные.ЗначенияПолейФактическийАдрес;
	
	Модель.СтранаРегистрации = Справочники.СтраныМира.Россия;
	Если ЗначениеЗаполнено(Данные.СтранаРегистрации) Тогда
		Модель.СтранаРегистрации = Данные.СтранаРегистрации;
	КонецЕсли;
	
	Если Модель.СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
		
		Модель.ИНН = СокрЛП(Данные.ИНН);
		
		Если Данные.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
			
			Модель.ТипЮрФизЛица = "ЮридическоеЛицо"; // ТипыЮрФизЛиц().ЮридическоеЛицо
			Модель.КПП = СокрЛП(Данные.КПП);
			Модель.КодПоОКПО = СокрЛП(Данные.КодПоОКПО);
			
		ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ИндивидуальныйПредприниматель") Тогда
			
			Модель.ТипЮрФизЛица = "ИндивидуальныйПредприниматель"; // ТипыЮрФизЛиц().ИндивидуальныйПредприниматель
			Модель.Свидетельство = СокрЛП(Данные.Свидетельство);
			
			Если Не ЗначениеЗаполнено(Модель.Свидетельство) Тогда
				Модель.Свидетельство = Данные.СвидетельствоСерияНомер + " от " + Формат(Данные.СвидетельствоДатаВыдачи, "ДФ=dd.MM.yyyy");
			КонецЕсли;
			
		Иначе
			Модель.ТипЮрФизЛица = "ФизическоеЛицо"; // ТипыЮрФизЛиц().ФизическоеЛицо
		КонецЕсли;
		
	Иначе
		Модель.ТипЮрФизЛица = "ИностраннаяКомпания"; // ТипыЮрФизЛиц().ИностраннаяКомпания
		Модель.НалоговыйНомерВСтранеРегистрации = СокрЛП(Данные.НалоговыйНомерВСтранеРегистрации);
	КонецЕсли;
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьИнформациюОбОрганизации(СведенияОбОрганизации, РеквизитыОрганизации)
	
	#Область ОбщиеСвойства
	СведенияОбОрганизации.Name	 = РеквизитыОрганизации.НаименованиеДляПечатныхФорм;
	СведенияОбОрганизации.Inn	 = РеквизитыОрганизации.ИНН;
	СведенияОбОрганизации.Kpp	 = РеквизитыОрганизации.КПП;
	СведенияОбОрганизации.Okpo	 = РеквизитыОрганизации.КодПоОкпо;
	СведенияОбОрганизации.Phone	 = ПолучитьТелефон(РеквизитыОрганизации.Телефоны);
	
	СведенияОбОрганизации.BankAccountNumber		 = СокрЛП(РеквизитыОрганизации.НомерСчета);
	СведенияОбОрганизации.BankId				 = СокрЛП(РеквизитыОрганизации.БИК);
	СведенияОбОрганизации.BankName				 = ?(ЗначениеЗаполнено(РеквизитыОрганизации.Банк), Строка(РеквизитыОрганизации.Банк), ""); // в некоторых случаях Банк возвращается как ссылка на справочник и компонента игнорирует такое значение, теряя данные, поэтому значение Банк преобразовано к строке 
	#КонецОбласти
	
	ТипОрганизации = ЮрФизЛицо_ТипОрганизацииДляКонтента(РеквизитыОрганизации);
	
	#Область Свойства_ExtendedOrganizationInfo
	Если СведенияОбОрганизации.Свойство("CorrespondentAccount") Тогда 
		СведенияОбОрганизации.CorrespondentAccount = РеквизитыОрганизации.КоррСчет;
	КонецЕсли;
	
	Если СведенияОбОрганизации.Свойство("Email") Тогда
		СведенияОбОрганизации.Email = РеквизитыОрганизации.Email;
	КонецЕсли;
	
	Если СведенияОбОрганизации.Свойство("Type") Тогда 
		СведенияОбОрганизации.Type = ТипОрганизации;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыОрганизации.Свидетельство)
		И СведенияОбОрганизации.Свойство("IndividualEntityRegistrationCertificate") Тогда
		СведенияОбОрганизации.IndividualEntityRegistrationCertificate = РеквизитыОрганизации.Свидетельство;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыОрганизации.НалоговыйНомерВСтранеРегистрации)
		И СведенияОбОрганизации.Свойство("LegalEntityId") Тогда
		СведенияОбОрганизации.LegalEntityId = РеквизитыОрганизации.НалоговыйНомерВСтранеРегистрации;
	КонецЕсли;
	#КонецОбласти
	
	#Область Свойства_OrganizationInfo
	Если СведенияОбОрганизации.Свойство("IsSoleProprietor") Тогда 
		СведенияОбОрганизации.IsSoleProprietor = (ТипОрганизации = "IndividualEntity");
	КонецЕсли;
	#КонецОбласти
	
КонецПроцедуры

// Получает документ отгрузки.
// Если переданное значение имеет тип "ДокументСсылка.РеализацияОтгруженныхТоваров",
// то возвращается значение реквизита "ДокументОтгрузки" переданного значения,
// в противном случае возвращается само переданное значение.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.РеализацияОтгруженныхТоваров, ДокументСсылка.* - Документ, значение которого требуется обработать.
// 
// Возвращаемое значение:
//  ДокументСсылка - документ отгрузки.
//
Функция ДокументОтгрузки(ДокументСсылка)
	
	Результат = Неопределено;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РеализацияОтгруженныхТоваров") Тогда
		Результат = ДокументСсылка.ДокументОтгрузки;
	Иначе
		Результат = ДокументСсылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыКорректировкиРеализации(СсылкаНаОбъект, ЭтоИсправление)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Номер");
	Реквизиты.Вставить("Дата");
	Реквизиты.Вставить("НомерИсходногоДокумента");
	Реквизиты.Вставить("ДатаИсходногоДокумента");
	Реквизиты.Вставить("НомерИсправленияИсходногоДокумента");
	Реквизиты.Вставить("ДатаИсправленияИсходногоДокумента");
	
	Если ЭтоИсправление Тогда
		
		// Переопределим номер документа
		Реквизиты.Номер	 = "НомерИсправляемогоКорректировочногоДокумента";
		Реквизиты.Дата	 = "ДатаИсправляемогоКорректировочногоДокумента";
		
		// И добавим получение номера и даты исправления
		Реквизиты.Вставить("НомерИсправления");
		Реквизиты.Вставить("ДатаИсправления", "Дата");
		
	КонецЕсли;
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, Реквизиты);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыКорректировочногоСчетаФактуры(СсылкаНаОбъект, ЭтоИсправление)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	&ПолеНомерДокумента КАК Номер,
	|	&ПолеПроизвольныйНомер КАК ПроизвольныйНомер,
	|	&ПолеИспользоватьПроизвольныйНомер КАК ИспользоватьПроизвольныйНомер,
	|	&ПолеДатаДокумента КАК Дата,
	|	&ПолеНомерИсправления КАК НомерИсправления,
	|	&ПолеДатаИсправления КАК ДатаИсправления,
	|	Таблица.УчитыватьИсправлениеИсходногоДокумента КАК УчитыватьИсправлениеИсходногоДокумента,
	|	Таблица.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	Таблица.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	Таблица.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
	|	Таблица.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
	|	Таблица.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ПолеНомерДокумента = "Таблица.Ссылка.Номер";
	ПолеДатаДокумента = "Таблица.Ссылка.Дата";
	ПолеНомерИсправления = "НЕОПРЕДЕЛЕНО";
	ПолеДатаИсправления	 = "НЕОПРЕДЕЛЕНО";
	ПолеПроизвольныйНомер = """""";
	ПолеИспользоватьПроизвольныйНомер = "ЛОЖЬ";
	
	Если ЭтоИсправление Тогда
		
		ПолеНомерДокумента	 = "Таблица.Ссылка.НомерИсправляемогоКорректировочногоДокумента";
		ПолеДатаДокумента	 = "Таблица.Ссылка.ДатаИсправляемогоКорректировочногоДокумента";
		ПолеНомерИсправления = "Таблица.Ссылка.НомерИсправления";
		ПолеДатаИсправления	 = "Таблица.Ссылка.Дата";
		
	КонецЕсли;
	
	Если ИспользуетсяПроизвольныйНомерСчетаФактурыВыданного() Тогда
		
		ПолеПроизвольныйНомер = "Таблица.Ссылка.НомерВходящегоДокумента";
		ПолеИспользоватьПроизвольныйНомер = "Таблица.Ссылка.ОтредактированНомерСчетаФактуры";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНомерДокумента"	, ПолеНомерДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДатаДокумента" 	, ПолеДатаДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНомерИсправления", ПолеНомерИсправления);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДатаИсправления"	, ПолеДатаИсправления);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПроизвольныйНомер", ПолеПроизвольныйНомер);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИспользоватьПроизвольныйНомер", ПолеИспользоватьПроизвольныйНомер);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

