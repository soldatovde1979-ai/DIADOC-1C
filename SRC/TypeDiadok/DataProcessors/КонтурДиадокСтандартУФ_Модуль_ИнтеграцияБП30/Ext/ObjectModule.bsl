Функция ТекстЗапросаТЧ_РеализацияТоваровУслуг()
	
	Результат = 
	"ВЫБРАТЬ
	|	подзапрос.Ссылка КАК Ссылка,
	|	подзапрос.ТабличнаяЧастьДокумента КАК ТабличнаяЧастьДокумента,
	|	подзапрос.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	подзапрос.порядок КАК порядок,
	|	подзапрос.НомерСтроки КАК НомерСтроки,
	|	подзапрос.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	подзапрос.Номенклатура КАК Номенклатура,
	|	подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
	|	подзапрос.КодНоменклатуры КАК КодНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	НЕОПРЕДЕЛЕНО КАК Серия,
	|	подзапрос.Количество КАК Количество,
	|	подзапрос.Цена КАК Цена,
	|	подзапрос.Сумма КАК Сумма,
	|	подзапрос.СтавкаНДС КАК СтавкаНДС,
	|	подзапрос.СуммаНДС КАК СуммаНДС,
	|	подзапрос.НомерГТД КАК НомерГТД,
	|	подзапрос.СтранаПроисхождения КАК СтранаПроисхождения,
	|	подзапрос.НомерГТДПредставление КАК НомерГТДПредставление,
	|	подзапрос.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	подзапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	подзапрос.КодЕдиницыИзмерения КАК КодЕдиницыИзмерения,
	|	подзапрос.ВидУпаковки КАК ВидУпаковки,
	|	подзапрос.КоличествоВОдномМесте КАК КоличествоВОдномМесте,
	|	подзапрос.КоличествоМест КАК КоличествоМест,
	|	подзапрос.ЭтоУслуга КАК ЭтоУслуга,
	|	подзапрос.ПризнакТоварРаботаУслуга КАК ПризнакТоварРаботаУслуга,
	|	ЕСТЬNULL(РублевыеСуммы.Всего, 0) КАК ВсегоВРублях,
	|	ЕСТЬNULL(РублевыеСуммы.НДС, 0) КАК НДСВРублях,
	|	ВЫБОР
	|		КОГДА РублевыеСуммы.Регистратор ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК СуществуютЗаписиРублевыхСумм
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.Ссылка КАК Ссылка,
	|		ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Товары) КАК ТабличнаяЧастьДокумента,
	|		""Товары"" КАК ИмяТабличнойЧасти,
	|		1 КАК порядок,
	|		Т.НомерСтроки КАК НомерСтроки,
	|		&ИдентификаторСтрокиИзТЧ КАК ИдентификаторСтроки,
	|		Т.Номенклатура КАК Номенклатура,
	|		Т.Номенклатура.НаименованиеПолное КАК НоменклатураПредставление,
	|		&КодНоменклатурыИзТЧ КАК КодНоменклатуры,
	|		Т.Количество КАК Количество,
	|		Т.Цена КАК Цена,
	|		Т.Сумма КАК Сумма,
	|		Т.СтавкаНДС КАК СтавкаНДС,
	|		Т.СуммаНДС КАК СуммаНДС,
	|		Т.НомерГТД КАК НомерГТД,
	|		Т.СтранаПроисхождения КАК СтранаПроисхождения,
	|		&НомерГТДПредставление Как НомерГТДПредставление,
	|		Т.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|		Т.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		Т.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|		Т.Номенклатура.ЕдиницаИзмерения КАК ВидУпаковки,
	|		Т.Коэффициент КАК КоличествоВОдномМесте,
	|		Т.КоличествоМест КАК КоличествоМест,
	|		ЛОЖЬ КАК ЭтоУслуга,
	|		""Property"" КАК ПризнакТоварРаботаУслуга
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.Товары КАК Т
	|	ГДЕ
	|		Т.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.Ссылка,
	|		ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.Услуги),
	|		""Услуги"",
	|		2,
	|		Т.НомерСтроки,
	|		НЕОПРЕДЕЛЕНО,
	|		Т.Номенклатура,
	|		Т.Содержание,
	|		&КодНоменклатурыИзТЧ,
	|		Т.Количество,
	|		Т.Цена,
	|		Т.Сумма,
	|		Т.СтавкаНДС,
	|		Т.СуммаНДС,
	|		"""",
	|		"""",
	|		"""",
	|		Т.Ссылка.СуммаВключаетНДС,
	|		Т.Номенклатура.ЕдиницаИзмерения,
	|		Т.Номенклатура.ЕдиницаИзмерения.Код,
	|		"""",
	|		0,
	|		0,
	|		ИСТИНА,
	|		""Service""
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.Услуги КАК Т
	|	ГДЕ
	|		Т.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Т.Ссылка,
	|		ЗНАЧЕНИЕ(Перечисление.ТабличныеЧастиДокументов.АгентскиеУслуги),
	|		""АгентскиеУслуги"",
	|		3,
	|		Т.НомерСтроки,
	|		НЕОПРЕДЕЛЕНО,
	|		Т.Номенклатура,
	|		Т.Содержание,
	|		&КодНоменклатурыИзТЧ,
	|		Т.Количество,
	|		Т.Цена,
	|		Т.Сумма,
	|		Т.СтавкаНДС,
	|		Т.СуммаНДС,
	|		"""",
	|		"""",
	|		"""",
	|		Т.Ссылка.СуммаВключаетНДС,
	|		Т.Номенклатура.ЕдиницаИзмерения,
	|		Т.Номенклатура.ЕдиницаИзмерения.Код,
	|		"""",
	|		0,
	|		0,
	|		ИСТИНА,
	|		""Service""
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.АгентскиеУслуги КАК Т
	|	ГДЕ
	|		Т.Ссылка = &Ссылка) КАК подзапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РублевыеСуммыДокументовВВалюте КАК РублевыеСуммы
	|		ПО подзапрос.Ссылка = РублевыеСуммы.Регистратор
	|			И подзапрос.ТабличнаяЧастьДокумента = РублевыеСуммы.ТабличнаяЧастьДокумента
	|			И подзапрос.НомерСтроки = РублевыеСуммы.НомерСтрокиДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	порядок,
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

