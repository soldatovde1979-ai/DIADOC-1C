#КонецОбласти

#Область СборПротоконтента

Процедура ЗаполнитьКонтентXmlUTD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати = ПолучитьДанныеДляФормированияУПД(ДокСсылка, ПараметрыФормирования);
	ДанныеШапки     = ДанныеДляПечати.ДанныеШапки;
	ТаблицаТоваров  = ДанныеДляПечати.ТаблицаТоваров;
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.Number	 = ДатаНомер.НомерДокумента;
	Content.Date	 = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("СчетФактураСсылка") Тогда
		Content.СчетФактураСсылка = ДанныеШапки.СчетФактураСсылка;
	КонецЕсли;
	
	Покупатель = ПолучитьГоловноеЮрлицо(ДанныеШапки.Контрагент);
	
	Если ЗначениеЗаполнено(ДатаНомер.ДатаИсправления) Тогда
		
		ДатаРеквизитов = ДатаНомер.ДатаИсправления;
		
	Иначе
		
		ДатаРеквизитов = ДатаНомер.ДатаДокумента;
		
	КонецЕсли;
	
	Заполнить_ExtendedOrganizationInfo(Content.Buyer, Покупатель, ДатаРеквизитов, Истина, ДанныеШапки.БанковскийСчетКонтрагента);

	Если  Content.Свойство("ОшибкиВДанных")
		И ЗначениеЗаполнено(Content.СчетФактураСсылка) 
		И ЭтоСводныйКомиссионныйСФ(Content.СчетФактураСсылка) Тогда
		
		Если НЕ Найти(ПараметрыКлиентСервер.СинонимКонфигурации, "Бухгалтерия предприятия КОРП") = 0
			И МетодСервера(, "ЕстьРеквизитИлиСвойствоОбъектаЛок", Content.СчетФактураСсылка, "ДоговорКонтрагента")
			И МетодСервера(, "ЕстьРеквизитИлиСвойствоОбъектаЛок", Content.СчетФактураСсылка.ДоговорКонтрагента, "СчетаФактурыОтИмениОрганизации")
			И НЕ Content.СчетФактураСсылка.ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации
		Тогда
		
			МетодСервера(, "ДобавитьОшибкуВалидации",
				Content.ОшибкиВДанных,
				"Отправка сводной комиссионной счет-фактуры возможно только при наличии признака ""Счета-фактуры перевыставляются от имени организации в <договоре>""", 
				Content.СчетФактураСсылка.ДоговорКонтрагента);
			
		ИначеЕсли Найти(ПараметрыКлиентСервер.СинонимКонфигурации, "Бухгалтерия предприятия КОРП") = 0 Тогда
			
			МетодСервера(, "ДобавитьОшибкуВалидации",
				Content.ОшибкиВДанных,
				"Интеграционный модуль электронного документооборота не поддерживает обмен сводными счетами-фактурами.");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыФормирования.Свойство("Получатель_FnsParticipantId") Тогда
		Content.Buyer.FnsParticipantId = ПараметрыФормирования.Получатель_FnsParticipantId;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.КонтрагентКПП) Тогда
		Content.Buyer.kpp =  ДанныеШапки.КонтрагентКПП;
	КонецЕсли;
	
	КППГрузоотправителя = "";
	
	Если ДанныеШапки.ЕстьТовары Тогда
		
		КППГрузоотправителя = ДанныеШапки.ГрузоотправительКПП;
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
			Заполнить_ExtendedOrganizationInfo(Content.Shipper.OrganizationInfo, ДанныеШапки.Грузоотправитель, ДатаРеквизитов, Ложь, , , ДанныеШапки.ОбособленноеПодразделение);
			Content.Shipper.SameAsSeller = Ложь;
		Иначе
			Content.Shipper.SameAsSeller = Истина;
		КонецЕсли;
		
		Грузополучатель = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
		Заполнить_ExtendedOrganizationInfo(Content.Consignee, Грузополучатель, ДатаРеквизитов, Ложь, , , , ДанныеШапки.АдресДоставки);
		
	КонецЕсли;
	
	Продавец = ПолучитьГоловноеЮрлицо(ДанныеШапки.Организация);
	ДоговорКонтрагента = ДанныеШапки.ДоговорКонтрагента;
	
	Если ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку И ДанныеШапки.Организация = ДанныеШапки.Контрагент Тогда
		
		Заполнить_ExtendedOrganizationInfo(Content.Seller, Продавец, ДатаРеквизитов, Истина, ДанныеШапки.БанковскийСчетОрганизации, Неопределено);
		
	Иначе
		
		Заполнить_ExtendedOrganizationInfo(Content.Seller, Продавец, ДатаРеквизитов, Истина, ДанныеШапки.БанковскийСчетОрганизации, Неопределено, ДанныеШапки.ОбособленноеПодразделение);
		
	КонецЕсли;
	
	Если ПараметрыФормирования.Свойство("Отправитель_FnsParticipantId") Тогда
		Content.Seller.FnsParticipantId = ПараметрыФормирования.Отправитель_FnsParticipantId; 	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ДоговорАгента) Тогда
		Content.Creator  	= ДанныеШапки.Агент.НаименованиеПолное + ", " + МетодСервера(, "СформироватьПредставлениеИННКПП", ДанныеШапки.Агент.ИНН, ДанныеШапки.Агент.КПП);
		Content.CreatorBase = ДанныеШапки.ДоговорАгента.Наименование;
	Иначе
		Content.Creator  = Content.seller.name + ", ИНН/КПП: " + МетодСервера(, "ПредставлениеИННКПП", Content.seller);
	КонецЕсли;
	
	Content.Function = ДанныеШапки.Функция;
	
	Если ДанныеШапки.Свойство("ДатаНомерДокументовОплаты") Тогда
		
		СтруктураPaymentDocuments= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_PaymentDocument");
		
		Для Каждого ПРД из ДанныеШапки.ДатаНомерДокументовОплаты Цикл
			ЗаполненнаяСтруктураPaymentDocuments = СкопироватьСтруктуру(СтруктураPaymentDocuments);
			ЗаполненнаяСтруктураPaymentDocuments.Number = ПРД.НомерПлатежноРасчетногоДокумента;
			ЗаполненнаяСтруктураPaymentDocuments.Date   = ПРД.ДатаПлатежноРасчетногоДокумента;
			Content.PaymentDocuments.Добавить(ЗаполненнаяСтруктураPaymentDocuments);
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеШапки.Свойство("ИдентификаторГосконтракта", Content.GovernmentContractInfo);
	
	ЗаполнитьStructedAdditionalInfos(Content.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	Курс      = 1;				
	Кратность = 1;
	НуженПересчетВРубли = (ДанныеШапки.РасчетыВУсловныхЕдиницах И ДанныеШапки.ВалютаДокумента <> ВалютаРеглУчета);
	НужноПересчитатьСуммыВСтроке = Ложь;
	
	Content.ВалютаСсылка = ?(ДанныеШапки.РасчетыВУсловныхЕдиницах, ВалютаРеглУчета, ДанныеШапки.ВалютаДокумента);
	Content.Currency = ?(ЗначениеЗаполнено(Content.ВалютаСсылка), Строка(Content.ВалютаСсылка.Код), "");
	
	Если НуженПересчетВРубли И ОписаниеДокумента.Проведен Тогда
		КурсИКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеШапки.ВалютаДокумента, ДатаНомер.ДатаДокумента);
		Курс      = КурсИКратность.Курс;
		Кратность = ?(КурсИКратность.Кратность = 0, 1, КурсИКратность.Кратность);
		НужноПересчитатьСуммыВСтроке = Истина;
	КонецЕсли;
	
	СФНаАванс = СчетФактуранаАванс(ДокСсылка);
	
	TotalNet = 0;
	Total 	 = 0;
	Vat 	 = 0;
	TotalWithVatExcluded = 0;
	
	ВсеСтроки_СтавкаНДС_БезНДС	 = Истина;
	ВсеСтроки_СтавкаНДС_ИсчНалАг = Истина;
	
	СтавкаНДС_БезНДС   = МетодСервера(, "СтавкаНДС_БезНДС");
	СтавкаНДС_ИсчНалАг = МетодСервера(, "СтавкаНДС_ИсчНалАг");
	
	Для Каждого СтрокаДанных Из ТаблицаТоваров Цикл 
		
		Если НужноПересчитатьСуммыВСтроке Тогда
			
			Если СтрокаДанных.СуществуютЗаписиРублевыхСумм Тогда
				СуммаБезНДС 		  = СтрокаДанных.ВсегоВРублях - СтрокаДанных.НДСВРублях;
				СтрокаДанных.СуммаНДС = СтрокаДанных.НДСВРублях;
			Иначе
				СуммаБезНДС           = (?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.Сумма - СтрокаДанных.СуммаНДС, СтрокаДанных.Сумма)) * Курс / Кратность;
				СтрокаДанных.СуммаНДС = СтрокаДанных.СуммаНДС * Курс / Кратность;
			КонецЕсли;
			
			СтрокаДанных.Цена  = ?(СтрокаДанных.Количество = 0, СуммаБезНДС, Окр(СуммаБезНДС / СтрокаДанных.Количество, Точность));
			СтрокаДанных.Сумма = СуммаБезНДС + ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);
			
		КонецЕсли;
		
		Item = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ExtendedInvoiceItem");
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		Content.InvoiceTable.items.Добавить(Item);
		
		Item.Product 	= СтрокаДанных.НоменклатураПредставление;
		Item.VendorCode = СтрокаДанных.КодНоменклатуры;
		Item.ItemMark   = СтрокаДанных.ПризнакТоварРаботаУслуга;
		Item.TaxRate 	= ПредставлениеСтавкиНДС(СтрокаДанных.СтавкаНДС);
		
		НДС_БезНДС	 = (НРег(Item.TaxRate) = НРег(СтавкаНДС_БезНДС));
		НДС_ИсчНалАг = (Item.TaxRate = СтавкаНДС_ИсчНалАг);
		
		Если НЕ НДС_БезНДС Тогда
			ВсеСтроки_СтавкаНДС_БезНДС = Ложь;
		КонецЕсли;
		Если НЕ НДС_ИсчНалАг Тогда
			ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
		КонецЕсли;
		
		// Сумма без НДС
		Если НДС_ИсчНалАг Тогда
			Item.SubtotalWithVatExcluded = СтрокаДанных.Сумма;
		ИначеЕсли НЕ СФНаАванс Тогда 	
			Item.SubtotalWithVatExcluded = СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);
		КонецЕсли;
		
		// Сумма НДС
		Если НДС_ИсчНалАг Тогда
			Item.Vat = 0;
		ИначеЕсли НЕ НДС_БезНДС Тогда 	
			Item.Vat = СтрокаДанных.СуммаНДС;
		КонецЕсли;
		
		// Сумма всего
		Если НДС_ИсчНалАг Тогда
			Item.Subtotal = 0;
		Иначе 	
			Item.Subtotal = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.Количество) Тогда
			
			Item.Quantity = ?(СФНаАванс И СтрокаДанных.Количество = 0, Неопределено, СтрокаДанных.Количество); //для отображения прочерка в вэбе
			
			Если ДанныеШапки.ЦенаВключаетНДС И ЗначениеЗаполнено(СтрокаДанных.СуммаНДС) Тогда 
				// Расчет цены без НДС
				Item.Price = ?(ЗначениеЗаполнено(Item.Quantity), Окр(Item.SubtotalWithVatExcluded / Item.Quantity, Точность), Неопределено);
			Иначе
				// Без пересчета, т.к. цена уже без НДС
				Item.Price = СтрокаДанных.Цена;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
				
				Item.UnitName = СокрЛП(СтрокаДанных.ЕдиницаИзмерения);
				Item.UnitCode = XML_КодЕдиницыИзмерения(СокрЛП(СтрокаДанных.КодЕдиницыИзмерения));
				Item.ЕдиницаИзмеренияССылка = СтрокаДанных.ЕдиницаИзмерения;
				
			КонецЕсли;
			
		КонецЕсли;
		
		TotalNet = TotalNet + МетодСервера(, "ПривестиКЧислу", Item.Quantity);
		Total 	 = Total 	+ МетодСервера(, "ПривестиКЧислу", Item.Subtotal);
		Vat 	 = Vat 		+ МетодСервера(, "ПривестиКЧислу", Item.Vat);
		
		Если НЕ СФНаАванс ИЛИ НДС_ИсчНалАг Тогда
			TotalWithVatExcluded = TotalWithVatExcluded + МетодСервера(, "ПривестиКЧислу", Item.SubtotalWithVatExcluded);
		КонецЕсли;
		
		Заполнить_Item_CustomDeclarations(
			Item,
			СтрокаДанных.СтранаПроисхождения,
			СтрокаДанных.НомерГТД
		);
		
	КонецЦикла;
	
	Content.InvoiceTable.TotalNet = TotalNet;
	Content.InvoiceTable.Total 	  = Total;
	Content.InvoiceTable.Vat 	  = ?(ВсеСтроки_СтавкаНДС_БезНДС, Неопределено, ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, 0, Vat));
	
	Если Не СФНаАванс ИЛИ ВсеСтроки_СтавкаНДС_ИсчНалАг Тогда
		Content.InvoiceTable.TotalWithVatExcluded = TotalWithVatExcluded;
	КонецЕсли;
	
	Content.TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	
	//TransferDate заполняем только, если дата отгрузки не совпадает с датой счета-фактуры.
	Если ДанныеШапки.Свойство("ДатаОтгрузки") И НачалоДня(ДанныеШапки.ДатаОтгрузки) <> НачалоДня(ДатаНомер.ДатаДокумента) Тогда 
		Content.TransferInfo.TransferDate = ДанныеШапки.ДатаОтгрузки;
	КонецЕсли;
	
	ДанныеШапки.Свойство("СведенияОТранспортировкеИГрузе", Content.TransferInfo.TransferTextInfo);
	
	ЗаполнитьСведенияОПередаче(Content, ДокСсылка, ПараметрыФормирования.ФункцияДокумента, ПараметрыФормирования);
	
	МетодСервера("Модуль_ИнтеграцияУниверсальный", "ЗаполнитьСведенияОЛицеПередавшемТовар"
		, Content
		, ДанныеШапки
		, ПараметрыФормирования);
	
	Если ДанныеШапки.Функция = "InvoiceAndBasic" Тогда
		Content.Name = "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	ИначеЕсли ДанныеШапки.Функция = "Basic" Тогда
		Content.Name = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	КонецЕсли;
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	ДобавитьДокументыОснованияВСлужебнуюИнформацию(Content);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlUCD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеДляПечати = ДанныеДляФормированияУКД(ДокСсылка, Новый Структура("ФункцияУПД", ПараметрыФормирования.ФункцияДокумента));
	
	ШапкаУКД 		= ДанныеДляПечати.Шапка;
	ТаблицаТоваров  = ДанныеДляПечати.ТабличнаяЧасть;
	
	Content.Function = ШапкаУКД.Функция;
	
	Если ШапкаУКД.Функция = "InvoiceAndBasic" Тогда
		Content.Name = "Корректировочный счет-фактура и документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	ИначеЕсли ШапкаУКД.Функция = "Basic" Тогда
		Content.Name = "Документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	КонецЕсли;
	
	ДатаНомер = ШапкаУКД.ДатаНомерДокумента;
	ОписаниеДокумента = ШапкаУКД.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.Number	 = ДатаНомер.НомерДокумента;
	Content.Date	 = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	Для каждого ДатаНомерДокументаОснования Из ДатаНомер.ДатаНомерДокументовОснований Цикл
		ЗаполнитьInvoiceForCorrectionInfo(Content.Invoices, ДатаНомерДокументаОснования);
	КонецЦикла;
	
	Продавец = ПолучитьГоловноеЮрлицо(ШапкаУКД.Организация);
	
	Если ЗначениеЗаполнено(ДатаНомер.ДатаИсправления) Тогда
		
		ДатаРеквизитов = ДатаНомер.ДатаИсправления;
		
	Иначе
		
		ДатаРеквизитов = ДатаНомер.ДатаДокумента;
		
	КонецЕсли;
	
	Заполнить_ExtendedOrganizationInfo(Content.Seller, Продавец, ДатаРеквизитов, Истина, ШапкаУКД.БанковскийСчетОрганизации, Неопределено, ШапкаУКД.ОбособленноеПодразделение);
	Если ПараметрыФормирования.Свойство("Отправитель_FnsParticipantId") Тогда
		Content.Seller.FnsParticipantId = ПараметрыФормирования.Отправитель_FnsParticipantId;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаУКД.ДоговорАгента) Тогда
										
		Content.Creator  	= ШапкаУКД.Агент.НаименованиеПолное + ", " + МетодСервера(, "СформироватьПредставлениеИННКПП", ШапкаУКД.Агент.ИНН, ШапкаУКД.Агент.КПП);
		Content.CreatorBase = ШапкаУКД.ДоговорАгента.Наименование;
		
	Иначе
		Content.Creator = Content.Seller.Name + ", ИНН/КПП: " + МетодСервера(, "ПредставлениеИННКПП", Content.Seller);
	КонецЕсли;
	
	Покупатель = ПолучитьГоловноеЮрлицо(ШапкаУКД.Контрагент);
	Заполнить_ExtendedOrganizationInfo(Content.Buyer, Покупатель, ДатаРеквизитов, Истина);
	Если ПараметрыФормирования.Свойство("Получатель_FnsParticipantId") Тогда
		Content.Buyer.FnsParticipantId = ПараметрыФормирования.Получатель_FnsParticipantId;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаУКД.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ШапкаУКД.КонтрагентКПП;
	КонецЕсли;
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	
	Content.ВалютаСсылка 	= ?(ШапкаУКД.РасчетыВУсловныхЕдиницах, ВалютаРеглУчета, ШапкаУКД.ВалютаДокумента);
	Content.Currency 		= ?(ЗначениеЗаполнено(Content.ВалютаСсылка), Строка(Content.ВалютаСсылка.Код), "");
	
	ШапкаУКД.Свойство("ИдентификаторГосконтракта", Content.GovernmentContractInfo);
	
	ЗаполнитьStructedAdditionalInfos(Content.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	ЗаполнитьInvoiceCorrectionTable(Content.InvoiceCorrectionTable, ТаблицаТоваров);
	
	ЗаполнитьEventContent(Content.EventContent, ШапкаУКД);
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ШапкаУКД);
	
	Content.СлужебнаяИнформация.Вставить("ПередаточныеДокументы", ШапкаУКД.ПередаточныеДокументы);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlTorg12(Content, Знач ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДокСсылка = ДокументОтгрузки(ДокСсылка);
	
	ДанныеШапки = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров = ПолучитьДанныеТЧ(ДокСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date = ДатаНомер.ДатаДокумента;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(
		Content.Seller,
		ДанныеШапки.Организация,
		ДатаНомер.ДатаДокумента,
		ДанныеШапки.БанковскийСчетОрганизации,
		Истина
	);
	
	ГрузоотправительСсылка = ?(Не ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель), ДанныеШапки.Организация, ДанныеШапки.Грузоотправитель);
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Shipper, ГрузоотправительСсылка, ДатаНомер.ДатаДокумента, , Ложь);
	
	Content.ShipperDepartment = ПолучитьПодразделениеИзДокумента(ДокСсылка);
	
	ГрузополучательСсылка = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Consignee, ГрузополучательСсылка, ДатаНомер.ДатаДокумента, , Ложь, , , ДанныеШапки.АдресДоставки);
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента, , Истина);
	
	НомерЗаказа = ПараметрыФормирования.НомерЗаказа;
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда
		Content.GroundName = "Заказ";
		Content.GroundNumber = СокрЛП(НомерЗаказа);
	Иначе
		СтруктураДоговора = СтруктурированноеПредставлениеОснования(ДокСсылка);
		Content.GroundName = СтруктураДоговора.GroundName;
		Content.GroundDate = СтруктураДоговора.GroundDate;
		Content.GroundNumber = СтруктураДоговора.GroundNumber;
	КонецЕсли;
	
	ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ИдКонтрагента = ОбработкаОбъект.Контрагент_2_CounteragentBoxID(ДанныеШапки.Контрагент);
	Если ОбработкаОбъект.НужноФормироватьДопИнфоПоШаблону(ИдКонтрагента) = Истина Тогда
		content.AdditionalInfo = ОбработкаОбъект.СформироватьСтрокуДопИнфоПоШаблону(ДопСведения);
	Иначе
		content.AdditionalInfo = ДопСведения;
	КонецЕсли;
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТаблицаТоваров);
	КонецЕсли;
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	ВалютаВзаиморасчетов = ДанныеШапки.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	НуженПересчетВРубли = НЕ (ДанныеШапки.ВалютаДокумента = ВалютаРеглУчета);
	
	Если НЕ ВалютаВзаиморасчетов = ВалютаРеглУчета И НуженПересчетВРубли И ОписаниеДокумента.Проведен Тогда
		
		КурсИКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеШапки.ВалютаДокумента, ДатаНомер.ДатаДокумента);
		
		Курс = КурсИКратность.Курс;
		Кратность = КурсИКратность.Кратность;
		
		Для Каждого СтрокаТаблицы Из ТаблицаТоваров Цикл
			
			Если СтрокаТаблицы.СуществуютЗаписиРублевыхСумм Тогда
				СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.НДСВРублях;
				СуммаБезНДС = СтрокаТаблицы.ВсегоВРублях - СтрокаТаблицы.НДСВРублях;
			Иначе
				Кратность= ?(Кратность = 0, 1, Кратность);
				СтрокаТаблицы.СуммаНДС = СтрокаТаблицы.СуммаНДС * Курс / Кратность;
				СуммаБезНДС = (СтрокаТаблицы.СуммаБезНДС + СтрокаТаблицы.СуммаНДС) * Курс / Кратность - СтрокаТаблицы.СуммаНДС;
			КонецЕсли;
			
			СтрокаТаблицы.Сумма = СуммаБезНДС + СтрокаТаблицы.СуммаНДС;
			
			Если СтрокаТаблицы.СуммаВключаетНДС И СтрокаТаблицы.СуммаНДС <> 0 Тогда
				СтрокаТаблицы.Цена = ?(СтрокаТаблицы.Количество = 0, СуммаБезНДС, СуммаБезНДС / СтрокаТаблицы.Количество);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	TotalParcelsQuantity 	= 0;
	TotalGrossQuantity 		= 0;
	TotalMassQuantity		= 0;
	TotalWithVatExcluded 	= 0;
	Total 					= 0;
	Vat 					= 0;
	
	СтруктураItems = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_Torg12Item");
	ЕстьСтрокиСНДС = Ложь;
	
	Для каждого СтрокаТаблицы из ТаблицаТоваров Цикл 
		
		Item = СкопироватьСтруктуру(СтруктураItems);
		
		Item.Product = СтрокаТаблицы.НоменклатураПредставление;
		Item.ProductCode = СтрокаТаблицы.КодНоменклатуры;
		Item.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаТаблицы.ЕдиницаИзмерения, СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
		Item.UnitName = Строка(СтрокаТаблицы.ЕдиницаИзмерения);
		Item.Quantity = СтрокаТаблицы.Количество;
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
		
		Если Не МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			ЕстьСтрокиСНДС = Истина;
		КонецЕсли;
		
		Item.Vat = СтрокаТаблицы.СуммаНДС;
		Item.Total = СтрокаТаблицы.Сумма + ?(СтрокаТаблицы.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
		Item.TotalWithVatExcluded = Item.Total - Item.Vat;
		Item.Price = Окр(Item.TotalWithVatExcluded / ?(Item.Quantity = 0, 1, Item.Quantity), 2);
		
		Item.СсылкаНаЕИ= СтрокаТаблицы.ЕдиницаИзмерения;
		
		Если НуженПересчетВРубли И ОписаниеДокумента.Проведен Тогда
			Если СтрокаТаблицы.СуществуютЗаписиРублевыхСумм Тогда
				Item.Vat= СтрокаТаблицы.НДСВРублях;
				Item.TotalWithVatExcluded = СтрокаТаблицы.ВсегоВРублях - СтрокаТаблицы.НДСВРублях;
			Иначе
				Кратность = ?(Кратность = 0, 1, Кратность);
				
				Item.Vat = СтрокаТаблицы.СуммаНДС * Курс / Кратность;
				Item.TotalWithVatExcluded = (СтрокаТаблицы.СуммаБезНДС + СтрокаТаблицы.СуммаНДС) * Курс / Кратность - СтрокаТаблицы.СуммаНДС;
			КонецЕсли;
			
			Item.Total= Item.TotalWithVatExcluded + Item.Vat;
			
		КонецЕсли;
		
		Если (НуженПересчетВРубли ИЛИ (СтрокаТаблицы.СуммаВключаетНДС И СтрокаТаблицы.СуммаНДС <> 0)) И ОписаниеДокумента.Проведен Тогда
			
			Item.Price = ?(Item.Quantity = 0, Item.TotalWithVatExcluded, Окр(Item.TotalWithVatExcluded/Item.Quantity, 2));
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(строкаТаблицы.КоличествоМест) Тогда
			Item.ParcelsQuantity = СтрокаТаблицы.КоличествоМест;
			Item.ParcelCapacity = СтрокаТаблицы.КоличествоВОдномМесте;
			Item.ParcelType = ?(ЗначениеЗаполнено(строкаТаблицы.ВидУпаковки), строкаТаблицы.ВидУпаковки.Наименование, "");
			Item.GrossQuantity = СтрокаТаблицы.Масса;
			TotalGrossQuantity = TotalGrossQuantity + ?(ЗначениеЗаполнено(Item.GrossQuantity), Item.GrossQuantity, 0);
			TotalParcelsQuantity = TotalParcelsQuantity + Item.ParcelsQuantity;
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.items.Добавить(Item);
		
		TotalMassQuantity = TotalMassQuantity + Item.Quantity;
		TotalWithVatExcluded = TotalWithVatExcluded + Item.TotalWithVatExcluded;
		Total = Total + Item.Total;
		Vat = Vat + Item.Vat;
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			Item.Vat = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Content.Totals.ParcelsQuantity 		= TotalParcelsQuantity;
	Content.Totals.GrossQuantity 		= TotalGrossQuantity;
	Content.Totals.Quantity 			= TotalMassQuantity;
	Content.Totals.TotalWithVatExcluded = TotalWithVatExcluded;
	Content.Totals.Total 				= Total;
	Content.Totals.Vat 					= ?(ЕстьСтрокиСНДС, Vat, Неопределено);
	
	Content.SupplyDate 					= Content.Date;
	
	Если НуженПересчетВРубли И ОписаниеДокумента.Проведен Тогда
		Content.commons.TotalSumInWords = РаботаСКурсамиВалют.СформироватьСуммуПрописью(Content.Totals.Total, ВалютаРеглУчета);
	Иначе
		Content.commons.TotalSumInWords = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ДанныеШапки.СуммаДокумента, ДанныеШапки.ВалютаДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(TotalParcelsQuantity) Тогда
		Content.commons.TotalParcelsQuantityInWords
			= Стрзаменить(ЧислоПрописью(TotalParcelsQuantity, "ДП = Ложь"), "  00", "");
	КонецЕсли;
	
	ФИОСогласователя = "";
	
	ДолжностьСогласователя = "";
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОСогласователя 		= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
			ДолжностьСогласователя 	= ПараметрыОтправкиНаСогласование.ДолжностьПодписанта;
		Иначе
			Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПолучателя) Тогда
				ФИОСогласователя 	= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			КонецЕсли;
			ДолжностьСогласователя 	= ПараметрыОтправкиНаСогласование.ДолжностьПолучателя;
		КонецЕсли;
	КонецЕсли;
	
	Если ФИОСогласователя = "" Тогда
		
		ПараметрыПодписания = МетодСервера(,"ПолучитьПараметрыПодписанияТ12вДиадок", ДанныеШапки.Организация);
		
		Если ПараметрыПодписания.СпособПодписания = "4" Тогда
			ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(Content.SupplyPerformedBy, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
			ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(Content.SupplyAllowedBy, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
			
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(Content.ChiefAccountant, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
			
		ИначеЕсли параметрыПодписания.СпособПодписания = "2" Тогда
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(Content.ChiefAccountant, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
		ИначеЕсли параметрыПодписания.СпособПодписания = "3" Тогда
			ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(Content.SupplyPerformedBy, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
		Иначе	
			ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(Content.SupplyAllowedBy, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
		КонецЕсли;
		
	Иначе 
		ОбработкаОбъект.ЗаполнитьФИОПодписанта(Content.SupplyAllowedBy, ФИОСогласователя);
		Content.SupplyAllowedBy.JobTitle = СокрЛП(?(НЕ ПустаяСтрока(ДолжностьСогласователя), ДолжностьСогласователя, "_"));
	КонецЕсли;
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlAcceptanceCertificate(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров	 = ПолучитьДанныеТЧ(ДокСсылка, , , , Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	
	Content.Number	 = ДатаНомер.НомерДокумента;
	Content.Date	 = ДатаНомер.ДатаДокумента;
	
	//поставщик: организация-продавец
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеШапки.Организация,  ДатаНомер.ДатаДокумента, ДанныеШапки.БанковскийСчетОрганизации, Истина);
	
	ПредставлениеИсполнителя = СформироватьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Организация, ДатаНомер.ДатаДокумента);
	ПредставлениеЗаказчика   = СформироватьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента);
	
	СтруктураДоговора = СтруктурированноеПредставлениеОснования(ДокСсылка);
	
	НомерДоговора 	= ?(СтруктураДоговора.GroundNumber = "", "", " по договору № " + СтруктураДоговора.GroundNumber);
	ДатаДоговора 	= ?(СтруктураДоговора.GroundDate = Дата(1, 1, 1), "", " от " + Формат(СтруктураДоговора.GroundDate, "ДФ=dd.MM.yyyy"));
	ДатаДоговора 	= ?((СтруктураДоговора.GroundNumber = "" И СтруктураДоговора.GroundDate <> Дата(1, 1, 1)), " по договору " + ДатаДоговора, ДатаДоговора); 
	
	ТекстАкта = "Мы, нижеподписавшиеся, представитель " + ПредставлениеИсполнителя + " (далее «Исполнитель»), с одной стороны, и представитель " + ПредставлениеЗаказчика + " (далее «Заказчик»), с другой стороны," +
				" составили настоящий акт о том, что «Исполнитель» выполнил, а  «Заказчик» принял следующие работы (услуги)" + НомерДоговора + ДатаДоговора + ":";
	
	Content.Title = ТекстАкта;
	
	ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	ИдКонтрагента = ОбработкаОбъект.Контрагент_2_CounteragentBoxID(ДанныеШапки.Контрагент);
	Если ОбработкаОбъект.НужноФормироватьДопИнфоПоШаблону(ИдКонтрагента) = Истина Тогда
		Content.AdditionalInfo = ОбработкаОбъект.СформироватьСтрокуДопИнфоПоШаблону(ДопСведения);
	Иначе
		Content.AdditionalInfo = ДопСведения;
	КонецЕсли;
	
	Content.SignatureDate =	Content.Date;
	
	СтруктураItems = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AcceptanceCertificateItem");
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТаблицаТоваров);
	КонецЕсли;
	
	ВалютаРеглУчета 		= ВалютаРегламентированногоУчета();
	ВалютаВзаиморасчетов	= ДанныеШапки.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	НуженПересчетВРубли 	= ДанныеШапки.РасчетыВУсловныхЕдиницах И НЕ (ДанныеШапки.ВалютаДокумента = ВалютаРеглУчета);
					
	Если НЕ ВалютаВзаиморасчетов = ВалютаРеглУчета Тогда
		Если НуженПересчетВРубли И ОписаниеДокумента.Проведен Тогда
			
			КурсИКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеШапки.ВалютаДокумента, ДатаНомер.ДатаДокумента);
									
			Курс      = КурсИКратность.Курс;
			Кратность = КурсИКратность.Кратность;

			Для каждого СтрокаТаблицы Из ТаблицаТоваров Цикл
											
				Если СтрокаТаблицы.СуществуютЗаписиРублевыхСумм Тогда
					СтрокаТаблицы.СуммаНДС 	= СтрокаТаблицы.НДСВРублях;
					СуммаБезНДС				= СтрокаТаблицы.ВсегоВРублях - СтрокаТаблицы.НДСВРублях;
				Иначе
					Кратность = ?(Кратность = 0, 1, Кратность);
					СтрокаТаблицы.СуммаНДС	= СтрокаТаблицы.СуммаНДС * Курс / Кратность;
					СуммаБезНДС				= (СуммаБезНДС + СтрокаТаблицы.СуммаНДС) * Курс / Кратность - СтрокаТаблицы.СуммаНДС;
				КонецЕсли;
												
				СтрокаТаблицы.Сумма = СуммаБезНДС + СтрокаТаблицы.СуммаНДС;
				
				Если НуженПересчетВРубли ИЛИ (СтрокаТаблицы.СуммаВключаетНДС И СтрокаТаблицы.СуммаНДС <> 0) Тогда
					
					СтрокаТаблицы.Цена = ?( СтрокаТаблицы.Количество = 0,
											СуммаБезНДС,
											СуммаБезНДС / СтрокаТаблицы.Количество);
						
				КонецЕсли;
					
			КонецЦикла;
			
		КонецЕсли;						
	КонецЕсли;
					
	Для каждого СтрокаТаблицы из ТаблицаТоваров Цикл 
		
		Item = СкопироватьСтруктуру(СтруктураItems);
		Если 	НЕ ЗначениеЗаполнено(СтрокаТаблицы.Количество) 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.КодЕдиницыИзмерения) Тогда 
			
			Item.Description = СтрокаТаблицы.НоменклатураПредставление;
		Иначе 
			Item.Name = СтрокаТаблицы.НоменклатураПредставление;
		КонецЕсли;	 
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			Item.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаТаблицы.ЕдиницаИзмерения, СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
			Если Item.UnitCode = "" И ЗначениеЗаполнено(Item.Name) Тогда
				Item.Description	= Item.Name;
				Item.Name			= Неопределено;
			КонецЕсли;
		Иначе
			Item.UnitCode = "";
		КонецЕсли;
							
		Item.UnitName 	= Строка(СтрокаТаблицы.ЕдиницаИзмерения);
		Item.Quantity	= СтрокаТаблицы.Количество;
							
		Item.Vat		= СтрокаТаблицы.СуммаНДС;
		Item.Total		= СтрокаТаблицы.Сумма + ?(СтрокаТаблицы.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
		Item.TotalWithVatExcluded = Item.Total - Item.Vat;
		Item.Price		= ?(НЕ ЗначениеЗаполнено(item.Quantity), Неопределено, Окр(item.TotalWithVatExcluded / item.Quantity, 2));
		Item.СсылкаНаЕИ	= СтрокаТаблицы.ЕдиницаИзмерения;
		
		Если НуженПересчетВРубли И ОписаниеДокумента.Проведен Тогда
			Если СтрокаТаблицы.СуществуютЗаписиРублевыхСумм Тогда
				Item.Vat					= СтрокаТаблицы.НДСВРублях;
				Item.TotalWithVatExcluded	= СтрокаТаблицы.ВсегоВРублях - СтрокаТаблицы.НДСВРублях;
			Иначе
				Кратность = ?(Кратность = 0, 1, Кратность);
										
				Item.Vat					= СтрокаТаблицы.СуммаНДС * Курс / Кратность;
				Item.TotalWithVatExcluded	= (СтрокаТаблицы.СуммаБезНДС + СтрокаТаблицы.СуммаНДС) * Курс / Кратность - СтрокаТаблицы.СуммаНДС;
			КонецЕсли;
			
			Item.Total = Item.TotalWithVatExcluded + Item.Vat;
									
		КонецЕсли;
		
		Если (НуженПересчетВРубли ИЛИ (СтрокаТаблицы.СуммаВключаетНДС И СтрокаТаблицы.СуммаНДС <> 0)) И ОписаниеДокумента.Проведен И Item.Quantity <> Неопределено Тогда
			
			Item.Price = ?(Item.Quantity = 0, Item.TotalWithVatExcluded, Окр(Item.TotalWithVatExcluded/Item.Quantity, 2));
									
		КонецЕсли;
		
		Item.Vat = ?(СтрокаТаблицы.СтавкаНДС = МенеджерИнтеграции_СтавкаБезНДС(), Неопределено, Item.Vat);
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.items.Добавить(Item);
		
	КонецЦикла;
	
	ПараметрыПодписания = МетодСервера(,"ПолучитьПараметрыПодписанияТ12вДиадок", ДанныеШапки.Организация);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ПараметрыПодписания.ФИОПодписанта 		= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
			ПараметрыПодписания.ДолжностьПодписанта = ПараметрыОтправкиНаСогласование.ДолжностьПодписанта;
		Иначе
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			ПараметрыПодписания.ФИОПодписанта 		= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			ПараметрыПодписания.ДолжностьПодписанта = ПараметрыОтправкиНаСогласование.ДолжностьПолучателя;
		КонецЕсли;
	КонецЕсли;
					
	ОбработкаОбъект.ЗаполнитьПодписантаДляXmlTorg12(content.Official, ОбработкаОбъект.ПредставлениеВизирующегоСтруктурой(ПараметрыПодписания));
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентInvoice(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати = СформироватьДанныеДляПечати(ДокСсылка, Ложь);
	
	ДатаНомер = ДанныеДляПечати.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеДляПечати.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.Number	 = ДатаНомер.НомерДокумента;
	Content.Date	 = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.InvoiceRevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.InvoiceRevisionDate		 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	СтруктураPaymentDocuments= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_PaymentDocument");
	
	Для Каждого ПРД Из ДанныеДляПечати.ДатаНомерДокументовОплаты Цикл
		
		PaymentDocumentContent=	СкопироватьСтруктуру(СтруктураPaymentDocuments);
		
		PaymentDocumentContent.Number = ПРД.НомерПлатежноРасчетногоДокумента;
		PaymentDocumentContent.date   = ПРД.ДатаПлатежноРасчетногоДокумента;
		
		Content.PaymentDocuments.Добавить(PaymentDocumentContent);
		
	КонецЦикла;	
	
	Content.currency = ?(ЗначениеЗаполнено(ДанныеДляПечати.ВалютаДокумента), Строка(ДанныеДляПечати.ВалютаДокументаКод), "");
	Content.ВалютаСсылка =   ДанныеДляПечати.ВалютаДокумента;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеДляПечати.Контрагент, ДатаНомер.ДатаДокумента, , Истина, Истина);
	Если ЗначениеЗаполнено(ДанныеДляПечати.КонтрагентКПП) Тогда
		Content.Buyer.kpp =  ДанныеДляПечати.КонтрагентКПП;
	КонецЕсли;

	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеДляПечати.Организация, ДатаНомер.ДатаДокумента, , Истина, Истина, ДанныеДляПечати.ГрузоотправительКПП);
	
	Если ДанныеДляПечати.ЕстьТовары Тогда 
		
		Если ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель) Тогда  
			ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(Content.Shipper, ДанныеДляПечати.Грузоотправитель, ДатаНомер.ДатаДокумента); 
			Content.Shipper.SameAsSellerOrBuyer = Ложь;
		Иначе 
			Content.Shipper.SameAsSellerOrBuyer = Истина;
		КонецЕсли;
		
		Грузополучатель = ?(ЗначениеЗаполнено(ДанныеДляПечати.Грузополучатель), ДанныеДляПечати.Грузополучатель, ДанныеДляПечати.Контрагент);
		ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(Content.Consignee, ДанныеДляПечати.Грузополучатель, ДатаНомер.ДатаДокумента, ДанныеДляПечати.АдресДоставки);
		
	КонецЕсли;
	
	ЗаполнитьStructedAdditionalInfos(Content.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	СтруктураItemInvoice=	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItem");
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	
	НуженПересчетВРубли = (ДанныеДляПечати.РасчетыВУсловныхЕдиницах И ДанныеДляПечати.ВалютаДокумента <> ВалютаРеглУчета);
	
	Если НуженПересчетВРубли = Истина И ДанныеДляПечати.Проведен Тогда
		
		КурсИКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеДляПечати.ВалютаДокумента, ДатаНомер.ДатаДокумента);
		
		Курс      = КурсИКратность.Курс;
		Кратность = КурсИКратность.Кратность;
		
		Для каждого СтрМассива из ДанныеДляПечати.ТабличнаяЧасть Цикл
        	
			Если СтрМассива.СуществуютЗаписиРублевыхСумм Тогда
				СтрМассива.СуммаНДС	= СтрМассива.НДСВРублях;
				СуммаБезНДС 		= СтрМассива.ВсегоВРублях - СтрМассива.НДСВРублях;
			Иначе
				Кратность = ?(Кратность = 0, 1, Кратность);
				СтрМассива.СуммаНДС = СтрМассива.СуммаНДС * Курс / Кратность;
				СуммаБезНДС 		= (СуммаБезНДС + СтрМассива.СуммаНДС) * Курс / Кратность - СтрМассива.СуммаНДС;
			КонецЕсли;
										
			СтрМассива.Сумма = СуммаБезНДС + СтрМассива.СуммаНДС;
			
			Если НуженПересчетВРубли ИЛИ (СтрМассива.СуммаВключаетНДС И СтрМассива.СуммаНДС <> 0) Тогда
				
				СтрМассива.Цена = ?(СтрМассива.Количество = 0,
					СуммаБезНДС,
					СуммаБезНДС / СтрМассива.Количество);
					
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Vat= 0;
	TotalWithVatExcluded= 0;
	Total= 0;
	Для каждого Стр из ДанныеДляПечати.ТабличнаяЧасть Цикл
		
		Item= СкопироватьСтруктуру(СтруктураItemInvoice);
		
		Item.Product= 	Стр.НоменклатураПредставление;
		
		Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Item.UnitCode= МетодСервера(, "Item_UnitCode", Стр.ЕдиницаИзмерения, СокрЛП(Стр.КодЕдиницыИзмерения));
		Иначе
			Item.UnitCode= "";
		КонецЕсли;
							
		Item.ЕдиницаИзмеренияСсылка= Стр.ЕдиницаИзмерения;
		
		Если СчетФактуранаАванс(ДокСсылка) = Ложь Тогда 
			Item.TotalWithVatExcluded= Стр.Сумма - ?(Стр.СуммаВключаетНДС, Стр.СуммаНДС, 0);
		КонецЕсли;	
		
		Если СчетФактуранаАванс(ДокСсылка) = Ложь И ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) И ЗначениеЗаполнено(Стр.КодЕдиницыИзмерения) Тогда 
			Item.Quantity= Стр.Количество;
			Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
				Item.price= Строка(Стр.Цена);
			Иначе	
				Item.price= Строка(?(Item.Quantity = 0, Неопределено, Окр(Item.TotalWithVatExcluded / Item.Quantity, Точность)));
			КонецЕсли;
		Иначе 
			//Item.Quantity = 0;
			//Item.price =  0;
		КонецЕсли;
							
		Item.Vat= 		Стр.СуммаНДС;
		Item.Total= 	Стр.Сумма + ?(Стр.СуммаВключаетНДС, 0, Стр.СуммаНДС);
		Item.TaxRate = ПредставлениеСтавкиНДС(Стр.СтавкаНДС);
		Item.CountriesOfOrigin= 		?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), Стр.СтранаПроисхождения.Код, "");
		Item.СтранаПроисхожденияСсылка= ?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), Стр.СтранаПроисхождения, Справочники.СтраныМира.ПустаяСсылка());
		Item.CustomsDeclarationNumbers= ?(ЗначениеЗаполнено(Стр.НомерГТД), ?(ТипЗнч(Стр.НомерГТД) = Тип("Строка"), СокрЛП(Стр.НомерГТД), СокрЛП(Стр.НомерГТД.Код)), "");
							
		Если НуженПересчетВРубли И ДанныеДляПечати.Проведен Тогда
			Если Стр.СуществуютЗаписиРублевыхСумм Тогда
				Item.Vat= Стр.НДСВРублях;
				Item.TotalWithVatExcluded= Стр.ВсегоВРублях - Стр.НДСВРублях;
			Иначе
				Кратность= ?(Кратность = 0, 1, Кратность);
				
				Item.Vat= Стр.СуммаНДС * Курс / Кратность;
				Item.TotalWithVatExcluded= (Стр.СуммаБезНДС + Стр.СуммаНДС) * Курс / Кратность - Стр.СуммаНДС;
			КонецЕсли;
			
			Item.Total= Item.TotalWithVatExcluded + Item.Vat;
									
		КонецЕсли;
		
		Если (НуженПересчетВРубли ИЛИ (Стр.СуммаВключаетНДС И Стр.СуммаНДС <> 0)) И ДанныеДляПечати.ОписаниеДокумента.Проведен Тогда
			
			Если НЕ Item.Price = Неопределено Тогда 
				Item.Price= Строка(?(Item.Quantity = 0, Item.TotalWithVatExcluded, Окр(Item.TotalWithVatExcluded/Item.Quantity, Точность)));
			КонецЕсли;
			
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, Стр);
		
		Content.items.Добавить(Item);
		
		Vat= 					Vat 					+ Item.Vat;
		TotalWithVatExcluded= 	TotalWithVatExcluded	+ ?(Item.TotalWithVatExcluded = Неопределено, 0, Item.TotalWithVatExcluded);
		Total=					Total					+ Item.Total;
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			Item.Vat = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Content.Totals.Vat 					= Vat;
	Content.Totals.TotalWithVatExcluded = TotalWithVatExcluded;
	Content.Totals.Total 				= Total;

	стПодписант = МетодСервера(, "СформироватьПараметрыПодписанта", ПараметрыФормирования.ФИОПодписанта);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПодписанта;
		Иначе	
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПолучателя;
		КонецЕсли;
		
		ПодписантФамилия=				ВыделитьСлово(ФИОПолучателя);
		ПодписантИмя= 					ВыделитьСлово(ФИОПолучателя);
		ПодписантОтчество= 				ВыделитьСлово(ФИОПолучателя);
		
		стПодписант.ПодписантФамилия=	?(НЕ ПустаяСтрока(ПодписантФамилия), ПодписантФамилия, " ");
		стПодписант.ПодписантИмя= 		?(НЕ ПустаяСтрока(ПодписантИмя), ПодписантИмя, " ");
		стПодписант.ПодписантОтчество= 	?(НЕ ПустаяСтрока(ПодписантОтчество), ПодписантОтчество, "");
		
	КонецЕсли;
					
	Content.Signer.Surname 		= стПодписант.ПодписантФамилия;
	Content.Signer.FirstName 	= стПодписант.ПодписантИмя;
	Content.Signer.Patronymic 	= стПодписант.ПодписантОтчество;
	Content.Signer.Inn 			= Content.seller.inn;
	Content.Signer.IsSoleProprietor	= Content.seller.IsSoleProprietor;
	Content.Signer.SoleProprietorRegistrationCertificate = ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляПечати.Организация);	
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеДляПечати);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентInvoiceCorrection(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати	 = СформироватьДанныеДляПечати(ДокСсылка, Истина);
	
	ДатаНомер = ДанныеДляПечати.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеДляПечати.ОписаниеДокумента;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Content.InvoiceCorrectionNumber	 = ДатаНомер.НомерДокумента;
	Content.InvoiceCorrectionDate	 = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	ДанныеОснований = ДатаНомер.ДатаНомерДокументовОснований;
	
	Если ЗначениеЗаполнено(ДанныеОснований) Тогда
		
		ДанныеОснования = ДанныеОснований[0];
		
		OriginalInvoices = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_OriginalInvoice");
		OriginalInvoices.Number	 = ДанныеОснования.НомерИсходногоДокумента;
		OriginalInvoices.Date	 = ДанныеОснования.ДатаИсходногоДокумента;
		
		Если ДанныеОснования.УчитыватьИсправлениеИсходногоДокумента Тогда
			OriginalInvoices.InvoiceRevisionNumber	 = ДанныеОснования.НомерИсправленияИсходногоДокумента;
			OriginalInvoices.InvoiceRevisionDate	 = ДанныеОснования.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
		Content.OriginalInvoices.Добавить(OriginalInvoices);
	
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеДляПечати.Контрагент,  ДатаНомер.ДатаДокумента, , Истина, Истина);
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КонтрагентКПП
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеДляПечати.Организация, ДатаНомер.ДатаДокумента, , Истина, Истина, ДанныеДляПечати.ГрузоотправительКПП);
	
	content.currency = ?(ЗначениеЗаполнено(ДанныеДляПечати.ВалютаДокумента), Строка(ДанныеДляПечати.ВалютаДокументаКод), "");
	content.ВалютаСсылка =   ДанныеДляПечати.ВалютаДокумента;
	
	ЗаполнитьStructedAdditionalInfos(Content.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);

	СтруктураItemInvoiceCorrection= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceCorrectionItem");

	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	
	Для каждого СтрокаДанных из ДанныеДляпечати.ТабличнаяЧасть Цикл 
						
		Item= СкопироватьСтруктуру(СтруктураItemInvoiceCorrection);
		Item.AmountsDec = 		МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.AmountsInc = 		МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.OriginalValues = 	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		Item.CorrectedValues =	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		
		Item.Product =	СтрокаДанных.НоменклатураПредставление;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения) Тогда
			Item.OriginalValues.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаДанных.ЕдиницаИзмеренияДоИзменения, СокрЛП(СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Код));
			Item.OriginalValues.ЕдиницаИзмеренияСсылка = СтрокаДанных.ЕдиницаИзмеренияДоИзменения;
		Иначе
			Item.OriginalValues.UnitCode = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
			Item.CorrectedValues.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаДанных.ЕдиницаИзмерения, СокрЛП(СтрокаДанных.ЕдиницаИзмерения.Код));
			Item.CorrectedValues.ЕдиницаИзмеренияСсылка = СтрокаДанных.ЕдиницаИзмерения;
		Иначе
			Item.CorrectedValues.UnitCode = "";	
		КонецЕсли;
							
		Item.OriginalValues.TotalWithVatExcluded=	СтрокаДанных.СуммаДоИзменения - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДСДоИзменения, 0);
		Item.CorrectedValues.TotalWithVatExcluded= 	СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения) И ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Код) Тогда
			Item.OriginalValues.Quantity =	СтрокаДанных.КоличествоДоИзменения;
			Item.CorrectedValues.Quantity = 	СтрокаДанных.Количество;
			
			Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(СтрокаДанных.СтавкаНДСДоИзменения) Тогда
				Item.OriginalValues.Price = СтрокаДанных.ЦенаДоИзменения;
			Иначе	
				Item.OriginalValues.Price = Строка(?(Item.OriginalValues.Quantity = 0, 0, Окр(Item.OriginalValues.TotalWithVatExcluded / Item.OriginalValues.Quantity, Точность)));
			КонецЕсли;
			Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(СтрокаДанных.СтавкаНДС) Тогда
				Item.CorrectedValues.Price = СтрокаДанных.Цена;
			Иначе	
				Item.CorrectedValues.Price = Строка(?(Item.CorrectedValues.Quantity = 0, 0, Окр(Item.CorrectedValues.TotalWithVatExcluded / Item.CorrectedValues.Quantity, Точность)));
			КонецЕсли;
			
		Иначе 
			Item.OriginalValues.Quantity =  0;
			Item.CorrectedValues.Quantity = 0;
		
			Item.OriginalValues.Price =	 0;
			Item.CorrectedValues.Price =  0;
		КонецЕсли;	
		
		СтавкаДоИзменения = СтрокаДанных.СтавкаНДСДоИзменения;
		Если Не ЗначениеЗаполнено(СтавкаДоИзменения) Тогда
			СтавкаДоИзменения = СтрокаДанных.СтавкаНДС;
		КонецЕсли;
		
		Item.OriginalValues.TaxRate = ПредставлениеСтавкиНДС(СтавкаДоИзменения);
		Item.CorrectedValues.TaxRate = ПредставлениеСтавкиНДС(СтрокаДанных.СтавкаНДС);
		
		
		Item.OriginalValues.Vat =	СтрокаДанных.СуммаНДСДоИзменения;
		Item.CorrectedValues.Vat =	СтрокаДанных.СуммаНДС;
		
		Item.OriginalValues.Total =	СтрокаДанных.СуммаДоИзменения + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДСДоИзменения);
		Item.CorrectedValues.Total = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		
		Content.items.Добавить(Item);
		
	КонецЦикла;

	стПодписант = МетодСервера(, "СформироватьПараметрыПодписанта", ПараметрыФормирования.ФИОПодписанта);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПодписанта;
		Иначе
			ФИОПолучателя =	ПараметрыОтправкиНаСогласование.ФИОПолучателя;
		КонецЕсли;
		
		ПодписантФамилия =				ВыделитьСлово(ФИОПолучателя);
		ПодписантИмя = 					ВыделитьСлово(ФИОПолучателя);
		ПодписантОтчество = 				ВыделитьСлово(ФИОПолучателя);
		стПодписант.ПодписантФамилия =	?(НЕ ПустаяСтрока(ПодписантФамилия), ПодписантФамилия, " ");
		стПодписант.ПодписантИмя = 		?(НЕ ПустаяСтрока(ПодписантИмя), ПодписантИмя, " ");
		стПодписант.ПодписантОтчество = 	?(НЕ ПустаяСтрока(ПодписантОтчество), ПодписантОтчество, "");
		
	КонецЕсли;	
					
	Content.Signer.Surname 		= стПодписант.ПодписантФамилия;
	Content.Signer.FirstName 	= стПодписант.ПодписантИмя;
	Content.Signer.Patronymic 	= стПодписант.ПодписантОтчество;
	Content.Signer.Inn 			= Content.seller.inn;
	Content.Signer.IsSoleProprietor	= Content.seller.IsSoleProprietor;
	Content.Signer.SoleProprietorRegistrationCertificate = ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляПечати.Организация);	
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеДляПечати);
	
КонецПроцедуры

