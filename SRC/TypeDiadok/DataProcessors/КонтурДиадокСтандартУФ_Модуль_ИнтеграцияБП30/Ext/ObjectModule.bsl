// Вызывается из Модуль_ИнтеграцияУниверсальный.ПредставлениеНоменклатуры.
//
// Параметры:
//  Представление			 - Строка - параметр, в который возвращается полученное представление номенклатуры;
//  Номенклатура			 - Строка, СправочникСсылка.Номенклатура				 - ссылка на номенклатуру;
//  Характеристика			 - Строка, СправочникСсылка.ХарактеристикиНоменклатуры	 - характеристика номенклатуры;
//  ДополнительныеПараметры	 - Неопределено, Структура								 - см. функцию Модуль_ИнтеграцияУниверсальный.ДополнительныеПараметрыПредставленияНоменклатуры;
//  СтандартнаяОбработка	 - Булево - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииПредставленияНоменклатуры(Представление, Номенклатура, Характеристика, ДополнительныеПараметры, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Номенклатура) = Тип("Строка") Тогда 
		
		Представление = СокрЛП(Номенклатура);
		Возврат;
		
	КонецЕсли;
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Наименование");
	ТребуемыеРеквизиты.Вставить("НаименованиеПолное");
	
	Если Не ЕстьРеквизитМетаданных(Номенклатура.Метаданные(), "НаименованиеПолное") Тогда
		ТребуемыеРеквизиты.НаименованиеПолное = "Наименование";
	КонецЕсли;
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ТребуемыеРеквизиты);
	
	Представление = РеквизитыНоменклатуры.НаименованиеПолное;
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = РеквизитыНоменклатуры.Наименование;
	КонецЕсли;
		
	Представление = СокрЛП(Представление);
	
КонецПроцедуры

