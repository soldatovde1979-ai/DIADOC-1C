#Область ПоступлениеТоваровУслуг

Функция ВидОперацииПоступленияТоваровУслугПоУмолчанию()
	
	МетаданныеРеквизита = Метаданные.Документы.ПоступлениеТоваровУслуг.Реквизиты.ВидОперации;
	
	Результат = МетаданныеРеквизита.ЗначениеЗаполнения;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор дополнительных параметров заполнения поступления товаров и услуг.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ВидОперации - ПеречислениСсылка.ВидыОперацийПоступлениеТоваровУслуг - вид операции поступления.
//   * ЦенаВключаетНДС - Булево - Истина, если цена включает НДС.
//
Функция ПараметрыЗаполненияПоступленияТоваровУслуг()
	
	Результат = Новый Структура;
	Результат.Вставить("УчитыватьИсправлениеИсходногоДокумента", Ложь);
	Результат.Вставить("ПередачаТовараКомитентом", Ложь);
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("Корректировка", Ложь);
	Результат.Вставить("ВидОперации", ВидОперацииПоступленияТоваровУслугПоУмолчанию());
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьВидОперацииПоступлениеТоваровУслуг(ДокументОбъект, ДанныеДокумента, ПередачаТовараКомитентом)
	
	Если ПередачаТовараКомитентом Или ДанныеДокумента.ВозвратнаяТара.Количество() > 0 Тогда
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
	Иначе
		Если ДанныеДокумента.Товары.Количество() = 0 Тогда
			ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги;
		ИначеЕсли ДанныеДокумента.Услуги.Количество() = 0 Тогда
			ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары;
		Иначе
			ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СтруктураЗаполненияПоступленияТоваровУслуг(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияПоступленияТоваровУслуг();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ПустаяСсылкаНаДокумент = Документы.ПоступлениеТоваровУслуг.ПустаяСсылка();
	ВидОперации = ПараметрыЗаполнения.ВидОперации;
	
	Товары				 = ПустаяСсылкаНаДокумент.Товары.ВыгрузитьКолонки();
	Услуги				 = ПустаяСсылкаНаДокумент.Услуги.ВыгрузитьКолонки();
	Оборудование		 = ПустаяСсылкаНаДокумент.Оборудование.ВыгрузитьКолонки();
	ВозвратнаяТара		 = ПустаяСсылкаНаДокумент.ВозвратнаяТара.ВыгрузитьКолонки();
	ОсновныеСредства	 = ПустаяСсылкаНаДокумент.ОсновныеСредства.ВыгрузитьКолонки();
	ОбъектыСтроительства = ПустаяСсылкаНаДокумент.ОбъектыСтроительства.ВыгрузитьКолонки();
	СведенияПрослеживаемости = НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(ПустаяСсылкаНаДокумент);
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента", ПараметрыЗаполнения.УчитыватьИсправлениеИсходногоДокумента);
	Шапка.Вставить("ПередачаТовараКомитентом", ПараметрыЗаполнения.ПередачаТовараКомитентом);
	Шапка.Вставить("СуммаВключаетНДС", ПараметрыЗаполнения.ЦенаВключаетНДС);
	Шапка.Вставить("Корректировка", ПараметрыЗаполнения.Корректировка);
	Шапка.Вставить("ВидОперации", ВидОперации);
	
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов", ШапкаЭД.Кратность);
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Шапка.Вставить("НомерИсходногоДокумента", СвойствоСтруктуры(ШапкаЭД, "НомерИсходногоДокумента"));
	Шапка.Вставить("ДатаИсходногоДокумента"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсходногоДокумента"));
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(ШапкаЭД, "НомерИсправления")) Тогда
		Шапка.Вставить("Исправление"		, Истина);
		Шапка.Вставить("НомерИсправления"	, СвойствоСтруктуры(ШапкаЭД, "НомерИсправления"));
		Шапка.Вставить("ДатаИсправления"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсправления"));
	Иначе
		Шапка.Вставить("Исправление", Ложь);
	КонецЕсли;
	
	НДСИсчисляетсяНалоговымАгентом = Ложь;
	ИспользуетсяОбратноеНачислениеНДС = ИспользуетсяОбратноеНачислениеНДС();
	
	ВидыОперацийПТУ = Перечисления.ВидыОперацийПоступлениеТоваровУслуг;
	
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		ЭтоУслуга = ЭтоНоменклатураУслуга(НоменклатураИБ.Номенклатура);
					
		Если ЭтоУслуга Тогда
			НоваяСтрока = Услуги.Добавить();
		ИначеЕсли ВидОперации = ВидыОперацийПТУ.ОбъектыСтроительства Тогда
			НоваяСтрока = ОбъектыСтроительства.Добавить();
		ИначеЕсли ВидОперации = ВидыОперацийПТУ.ОсновныеСредства Тогда
			НоваяСтрока = ОсновныеСредства.Добавить();
		ИначеЕсли ВидОперации = ВидыОперацийПТУ.Оборудование Тогда
			НоваяСтрока = Оборудование.Добавить();
		ИначеЕсли Не ЗначениеЗаполнено(НоменклатураИБ.Номенклатура) Тогда
			НоваяСтрока = Услуги.Добавить();
		Иначе
			НоваяСтрока = Товары.Добавить();
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "Номенклатура") Тогда
			НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "Содержание") Тогда
			НоваяСтрока.Содержание = НоменклатураКонтрагента.Наименование;
		КонецЕсли;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "ЕдиницаИзмерения") Тогда
			
			НоваяСтрока.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
			
			Если ЗначениеЗаполнено(НоменклатураИБ.Номенклатура)
				И Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураИБ.Номенклатура, "ЕдиницаИзмерения");
				НоваяСтрока.ЕдиницаИзмерения = РеквизитыНоменклатуры.ЕдиницаИзмерения;
			КонецЕсли;
			
			НоваяСтрока.Коэффициент = 0;
			Если ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
				НоваяСтрока.Коэффициент = 1;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЦенуСуммуПоСтроке(НоваяСтрока, Стр, ПараметрыЗаполнения.ЦенаВключаетНДС);
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		Если МенеджерИнтеграции_ЭтоСтавкаНДСИНА(ПредставлениеСтавки) Тогда
			
			НДСИсчисляетсяНалоговымАгентом = Истина;
			
			Если ИспользуетсяОбратноеНачислениеНДС Тогда
				
				НоваяСтрока.СтавкаНДС	 = МенеджерИнтеграции_ОбщаяСтавкаНДС(ШапкаЭД.Дата);
				НоваяСтрока.СуммаНДС	 = УчетНДСКлиентСервер.РассчитатьСуммуНДС(
					Стр.СуммаБезНДС,
					Ложь,
					УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
				
			Иначе 
				
				НоваяСтрока.СтавкаНДС	 = Неопределено;
				НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
				
			КонецЕсли;
			
		Иначе 
			
			НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
			
		КонецЕсли;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке, НоменклатураКонтрагента.GTIN);
		
		ЕстьСведенияПрослеживаемости_ЭД		= ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(Стр);
		ЕстьРеквизит_ПрослеживаемыйТовар_1С	= ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "ПрослеживаемыйТовар");
		
		ЗаполнитьКакПрослеживаемыйТовар = ИспользуетсяУчетПрослеживаемыхТоваров
											И ЕстьСведенияПрослеживаемости_ЭД
											И ЕстьРеквизит_ПрослеживаемыйТовар_1С;
		
		Если ЗаполнитьКакПрослеживаемыйТовар Тогда 
					
			ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УПД(СведенияПрослеживаемости, Стр.СведенияОПрослеживаемости, НоваяСтрока);
			ЗаполнятьСтрануПроисхождения = ЗначениеЗаполнено(Стр.ДанныеГТД)
											И Стр.ДанныеГТД.Количество() = 1 
											И ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "СтранаПроисхождения");
		Иначе
			Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "НомерГТД") Тогда
				НоваяСтрока.НомерГТД = НомерГТДИзСведенийТаможеннойДекларации(Стр.ДанныеГТД);
			КонецЕсли;
			ЗаполнятьСтрануПроисхождения = ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "СтранаПроисхождения");
		КонецЕсли;
		
		Если ЗаполнятьСтрануПроисхождения Тогда
			НоваяСтрока.СтранаПроисхождения = СтранаПроисхожденияИзСведенийТаможеннойДекларации(Стр.ДанныеГТД);
		КонецЕсли;
								
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Товары"	, Товары);
	ДанныеОбъекта.Вставить("Услуги"	, Услуги);
	ДанныеОбъекта.Вставить("Оборудование", Оборудование);
	ДанныеОбъекта.Вставить("ВозвратнаяТара", ВозвратнаяТара);
	ДанныеОбъекта.Вставить("ОсновныеСредства", ОсновныеСредства);
	ДанныеОбъекта.Вставить("ОбъектыСтроительства", ОбъектыСтроительства);
	ДанныеОбъекта.Вставить("НДСИсчисляетсяНалоговымАгентом", НДСИсчисляетсяНалоговымАгентом);
	ДанныеОбъекта.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	ДанныеОбъекта.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьПоступлениеТоваровУслуг(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ПередачаТовараКомитентом = ДанныеШапки.ПередачаТовараКомитентом;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	Если ПередачаТовараКомитентом Тогда
		
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
		
	ИначеЕсли ДанныеДокумента.Свойство("НДСИсчисляетсяНалоговымАгентом")
		И ДанныеДокумента.НДСИсчисляетсяНалоговымАгентом Тогда
		
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		СтруктураПараметров.Вставить("УчетАгентскогоНДС", Новый Структура("ЗначениеОтбора", Истина));
		СтруктураПараметров.Вставить("ВидАгентскогоДоговора",
			Новый Структура("ЗначениеОтбора", Перечисления.ВидыАгентскихДоговоров.РеализацияТоваров));
		
	Иначе
		
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СФакторинговойКомпанией);
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
		СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку);
		
	КонецЕсли;
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВидОперации) Тогда
		ЗаполнитьВидОперацииПоступлениеТоваровУслуг(ДокументОбъект, ДанныеДокумента, ПередачаТовараКомитентом);
	КонецЕсли;
			
	ТипСклада   = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Склад, "ТипСклада");
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ДоговорКонтрагента, "ВидДоговора");
	УчетВПродажныхЦенах = УчетнаяПолитика.СпособОценкиТоваровВРознице(ДокументОбъект.Организация, ДокументОбъект.Дата) = Перечисления.СпособыОценкиТоваровВРознице.ПоПродажнойСтоимости;
	РассчитыватьСуммаВРознице = ТипСклада <> Перечисления.ТипыСкладов.ОптовыйСклад
								И УчетВПродажныхЦенах
								И (ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия
									ИЛИ ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары)
								И ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;

	НТТ = ТипСклада = Перечисления.ТипыСкладов.НеавтоматизированнаяТорговаяТочка;
	СвойстваСчета4112 = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(
		ПланыСчетов.Хозрасчетный.ТоварыВРозничнойТорговлеВПродажныхЦенахНТТ);
	РазделениеПоСтавкамВРознице = СвойстваСчета4112.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтавкиНДС
		ИЛИ СвойстваСчета4112.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтавкиНДС
		ИЛИ СвойстваСчета4112.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтавкиНДС;
	
	ЗаполнятьСтавкуНДСВРознице = НТТ И УчетВПродажныхЦенах И РазделениеПоСтавкамВРознице;
	
	ПлательщикНДС	 = УчетнаяПолитика.ПлательщикНДС(ДокументОбъект.Организация, ДокументОбъект.Дата);
	ЭтоКомиссия		 = ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;
	ОтражениеВУСН	 = ПоступлениеТоваровУслугФормыКлиентСервер.ОтражениеВУСН(ДокументОбъект.ВидОперации, ЭтоКомиссия);
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.Товары Цикл
		
		СтрокаТЧ = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
		Если РассчитыватьСуммаВРознице Тогда
			ОбработкаТабличныхЧастей.ЗаполнитьЦенуВРозницеТабЧасти(СтрокаТЧ, ДокументОбъект, ДокументОбъект.Метаданные());
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуВРозницеТабЧасти(СтрокаТЧ);
		КонецЕсли;
		
		Если ЗаполнятьСтавкуНДСВРознице Тогда
			СтрокаТЧ.СтавкаНДСВРознице = ?(ПлательщикНДС, СтрокаТЧ.СтавкаНДС, МенеджерИнтеграции_СтавкаБезНДС());
		КонецЕсли;
		
		СтрокаТЧ.ОтражениеВУСН = ОтражениеВУСН;
		
		Если ДокументОбъект.НДСНеВыделять И ЗначениеЗаполнено(СтрокаТЧ.СуммаНДС) Тогда
			ДокументОбъект.НДСНеВыделять = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.Услуги.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.Услуги Цикл
		
		СтрокаТЧ = ДокументОбъект.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
		СтрокаТЧ.ОтражениеВУСН = ОтражениеВУСН;
		
		Если ДокументОбъект.НДСНеВыделять И ЗначениеЗаполнено(СтрокаТЧ.СуммаНДС) Тогда
			ДокументОбъект.НДСНеВыделять = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.ВозвратнаяТара.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.ВозвратнаяТара Цикл
		
		СтрокаТЧ = ДокументОбъект.ВозвратнаяТара.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
	КонецЦикла;
	
	ДокументОбъект.Оборудование.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.Оборудование Цикл
		
		СтрокаТЧ = ДокументОбъект.Оборудование.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
	КонецЦикла;
	
	ДокументОбъект.ОсновныеСредства.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.ОсновныеСредства Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаНакладной.ОсновноеСредство) Тогда
			// В типовом обработчике документа "ПередЗаписью" выполняется обновление
			// амортизационной группы ОС, что приводит к ошибке "Элемент не выбран", 
			// если основное средство не заполнено.
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧ = ДокументОбъект.ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
	КонецЦикла;
	
	ДокументОбъект.ОбъектыСтроительства.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.ОбъектыСтроительства Цикл
		
		СтрокаТЧ = ДокументОбъект.ОбъектыСтроительства.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
	КонецЦикла;
	
	Если ДанныеДокумента.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДокумента.ШтрихкодыУпаковок);
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("СведенияПрослеживаемости")
		И ДанныеДокумента.СведенияПрослеживаемости <> Неопределено 
		И ЕстьМетаданныеСведенияПрослеживаемости(ДокументОбъект.Метаданные()) Тогда
		
		ДокументОбъект.СведенияПрослеживаемости.Очистить();
		ДокументОбъект.СведенияПрослеживаемости.Загрузить(ДанныеДокумента.СведенияПрослеживаемости);
		
	КонецЕсли;
	
	ЗаполнитьСчетаУчетаПередЗаписьюДокумента(ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ВозвратТоваровОтПокупателя

Функция ВидОперацииВозвратаТоваровОтПокупателя()
	
	МетаданныеРеквизита = Метаданные.Документы.ВозвратТоваровОтПокупателя.Реквизиты.ВидОперации;
	
	Результат = МетаданныеРеквизита.ЗначениеЗаполнения;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.Товары;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор дополнительных параметров заполнения возврата товаров от покупателя.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ВидОперации - ПеречислениСсылка.ВидыОперацийВозвратТоваровОтПокупателя - вид операции возврата.
//   * ЦенаВключаетНДС - Булево - Истина, если цена включает НДС.
//
Функция ПараметрыЗаполненияВозвратаТоваровОтПокупателя()
	
	Результат = Новый Структура;
	Результат.Вставить("ВидОперации", ВидОперацииВозвратаТоваровОтПокупателя());
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("ПокупателемВыставляетсяСчетФактураНаВозврат", Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияВозвратаТоваровОтПокупателя(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияВозвратаТоваровОтПокупателя();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ПустаяСсылкаНаДокумент = Документы.ВозвратТоваровОтПокупателя.ПустаяСсылка();
	
	Товары = ПустаяСсылкаНаДокумент.Товары.ВыгрузитьКолонки();
	СведенияПрослеживаемости = НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(ПустаяСсылкаНаДокумент);
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	
	Шапка.Вставить("ВалютаДокумента"		, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов", ШапкаЭД.Кратность);
	
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	Шапка.Вставить("ВидОперации"		, ПараметрыЗаполнения.ВидОперации);
	
	Шапка.Вставить("ПокупателемВыставляетсяСчетФактураНаВозврат", ПараметрыЗаполнения.ПокупателемВыставляетсяСчетФактураНаВозврат);
	
	ЗаполнятьСведенияПрослеживаемости = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		
		ЭтоУслуга = ЭтоНоменклатураУслуга(НоменклатураИБ.Номенклатура);
		
		Если ЭтоУслуга Тогда 
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура		 = НоменклатураИБ.Номенклатура;
				
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
		НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
		
		ЗаполнитьЦенуСуммуПоСтроке(НоваяСтрока, Стр, ПараметрыЗаполнения.ЦенаВключаетНДС);
		
		ЕстьСведенияПрослеживаемости = ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(Стр);
		
		Если ЗаполнятьСведенияПрослеживаемости И ЕстьСведенияПрослеживаемости Тогда
			ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УПД(СведенияПрослеживаемости, Стр.СведенияОПрослеживаемости, НоваяСтрока);
			ЗаполнятьСтрануПроисхождения = ЗначениеЗаполнено(Стр.ДанныеГТД)
											И Стр.ДанныеГТД.Количество() = 1 
											И ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "СтранаПроисхождения");
		Иначе
			НоваяСтрока.НомерГТД = НомерГТДИзСведенийТаможеннойДекларации(Стр.ДанныеГТД);
			ЗаполнятьСтрануПроисхождения = ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "СтранаПроисхождения");
		КонецЕсли;
						
		Если ЗаполнятьСтрануПроисхождения Тогда
			НоваяСтрока.СтранаПроисхождения = СтранаПроисхожденияИзСведенийТаможеннойДекларации(Стр.ДанныеГТД);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Товары"	, Товары);
	ДанныеОбъекта.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьВозвратТоваровОтПокупателя(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ОтражениеВУСН = Неопределено;
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаНакладной Из ДанныеДокумента.Товары Цикл
		
		СтрокаТЧ = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаНакладной);
		
		СтрокаТЧ.ОтражениеВУСН = ОтражениеВУСН;
		
	КонецЦикла;
	
	Если ДанныеДокумента.Свойство("ШтрихкодыУпаковок") Тогда 
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДокумента.ШтрихкодыУпаковок);
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("СведенияПрослеживаемости")
		И ДанныеДокумента.СведенияПрослеживаемости <> Неопределено 
		И ЕстьМетаданныеСведенияПрослеживаемости(ДокументОбъект.Метаданные()) Тогда
		
		ДокументОбъект.СведенияПрослеживаемости.Очистить();
		ДокументОбъект.СведенияПрослеживаемости.Загрузить(ДанныеДокумента.СведенияПрослеживаемости);
		
	КонецЕсли;
	
	ЗаполнитьСчетаУчетаПередЗаписьюДокумента(ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ПоступлениеДопРасходов

Функция СтруктураЗаполненияПоступленияДопРасходов(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	СтавкаНДС = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеЭД.ТоварнаяЧасть) Тогда
		
		СтрокаТЧ = ДанныеЭД.ТоварнаяЧасть[0];
		
		ПредставлениеСтавки = СтрокаТЧ.НоменклатураКонтрагента.СтавкаНДС;
		СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
	КонецЕсли;
	
	ИтогиТЧ = ДанныеЭД.Итоги;
	СуммаДокумента = ИтогиТЧ.СуммаБезНДС;
	ЦенаВключаетНДС = ПараметрыЗаполнения.ЦенаВключаетНДС;
	
	Если ЦенаВключаетНДС Тогда
		СуммаДокумента = ИтогиТЧ.СуммаСНДС;
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов", ШапкаЭД.Кратность);
	Шапка.Вставить("СуммаВключаетНДС"	, ЦенаВключаетНДС);
	Шапка.Вставить("Сумма"		, СуммаДокумента);
	Шапка.Вставить("СуммаНДС"	, ИтогиТЧ.СуммаНДС);
	Шапка.Вставить("СтавкаНДС"	, СтавкаНДС);
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьПоступлениеДопРасходов(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СФакторинговойКомпанией);
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ЗаполнитьСчетаУчетаПередЗаписьюДокумента(ДокументОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ПоступлениеНМА

Функция СтруктураЗаполненияПоступленияНМА(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	НематериальныеАктивы = Документы.ПоступлениеНМА.ПустаяСсылка().НематериальныеАктивы.ВыгрузитьКолонки();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов", ШапкаЭД.Кратность);
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоваяСтрока = НематериальныеАктивы.Добавить();
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
		НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
		
		НоваяСтрока.Сумма = Стр.СуммаБезНДС;
		Если ПараметрыЗаполнения.ЦенаВключаетНДС Тогда
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("НематериальныеАктивы", НематериальныеАктивы);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьПоступлениеНМА(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ОтражениеВУСН = Неопределено;
	
	ДокументОбъект.НематериальныеАктивы.Очистить();
	Для Каждого СтрокаТЧ Из ДанныеДокумента.НематериальныеАктивы Цикл
		
		НоваяСтрока = ДокументОбъект.НематериальныеАктивы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НоваяСтрока.ОтражениеВУСН = ОтражениеВУСН;
		
	КонецЦикла;
	
	Документы.ПоступлениеНМА.ЗаполнитьСчетаУчетаРасчетов(ДокументОбъект);
	
	ДокументОбъект.СпособЗачетаАвансов = Перечисления.СпособыЗачетаАвансов.Автоматически;
	ДокументОбъект.ЗачетАвансов.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область ПоступлениеВЛизинг

Функция СтруктураЗаполненияПоступленияВЛизинг(ДанныеЭД, ДополнительныеПараметры)
	
	Если ЕстьДокументПоступлениеВАренду() Тогда
		
		ДанныеОбъекта = ЗаполнитьСтруктуруПоступленияВАренду(ДанныеЭД, ДополнительныеПараметры);
		
	Иначе
		
		ДанныеОбъекта = ЗаполнитьСтруктуруПоступленияВЛизинг(ДанныеЭД, ДополнительныеПараметры);
		
	КонецЕсли;
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция ЗаполнитьСтруктуруПоступленияВЛизинг(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;

	Шапка = Новый Структура;
	Шапка.Вставить("Организация",				СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент",				СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ВалютаДокумента",			ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов",		ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов",	ШапкаЭД.Кратность);
	Шапка.Вставить("СуммаВключаетНДС",			ПараметрыЗаполнения.ЦенаВключаетНДС);
	Шапка.Вставить("НомерВходящегоДокумента",	ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента",	ШапкаЭД.Дата);
	
	МенеджерОбъекта = Документы["ПоступлениеВЛизинг"];
	ПредметыЛизинга = МенеджерОбъекта.ПустаяСсылка().ПредметыЛизинга.ВыгрузитьКолонки();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоваяСтрока = ПредметыЛизинга.Добавить();
		
		НоменклатураИБ = Стр.Номенклатура;
		
		НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
		НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
		
		ЗаполнитьЦенуСуммуПоСтроке(НоваяСтрока, Стр, ПараметрыЗаполнения.ЦенаВключаетНДС);
		
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура)
			И Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураИБ.Номенклатура, "ЕдиницаИзмерения");
			НоваяСтрока.ЕдиницаИзмерения = РеквизитыНоменклатуры.ЕдиницаИзмерения;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	
	ДанныеОбъекта.Вставить("Шапка",				Шапка);
	ДанныеОбъекта.Вставить("ПредметыЛизинга",	ПредметыЛизинга);
	
	Возврат ДанныеОбъекта;	
	
КонецФункции

Функция ЗаполнитьСтруктуруПоступленияВАренду(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;

	ШапкаЭД = ДанныеЭД.Шапка;

	Шапка = Новый Структура;
	Шапка.Вставить("Организация",				СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент",				СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ВалютаДокумента",			ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов",		ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов",	ШапкаЭД.Кратность);
	Шапка.Вставить("СуммаВключаетНДС",			ПараметрыЗаполнения.ЦенаВключаетНДС);
	Шапка.Вставить("НомерВходящегоДокумента",	ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента",	ШапкаЭД.Дата);
	
	ПрименяетсяФСБУ25 = УчетнаяПолитика.ПрименяетсяФСБУ25(Шапка.Организация, Шапка.ДатаВходящегоДокумента);

	Шапка.Вставить("НалоговыйУчетИмуществаВедетЛизингополучатель",	Не ПрименяетсяФСБУ25);

	Шапка.Вставить("ПринятьКУчету",			Истина);
	Шапка.Вставить("ВидОперации",			Перечисления.ВидыОперацийПоступлениеВАренду.ПоступлениеВЛизинг);
	Шапка.Вставить("СпособОценкиАрендыБУ",	СпособыОценкиБУ_РавнаСуммеДоговора());
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьПоступлениеВЛизинг(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ОтражениеВУСН = Неопределено;
	
	Если ДанныеДокумента.Свойство("ПредметыЛизинга") Тогда
		
		ДокументОбъект.ПредметыЛизинга.Очистить();
		
		Для Каждого СтрокаТЧ Из ДанныеДокумента.ПредметыЛизинга Цикл
			
			НоваяСтрока = ДокументОбъект.ПредметыЛизинга.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьСчетаУчетаПоступленияВЛизинг(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьСчетаУчетаПоступленияВЛизинг(ДокументОбъект)
	
	ВалютаРегл = ВалютаРегламентированногоУчета();
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументОбъект.ДоговорКонтрагента, "ВалютаВзаиморасчетов, РасчетыВУсловныхЕдиницах");
		
	ДоговорУказан = ЗначениеЗаполнено(ДокументОбъект.ДоговорКонтрагента);
		
	РасчетыВУЕ = ДоговорУказан И РеквизитыДоговора.РасчетыВУсловныхЕдиницах;
	
	Если РасчетыВУЕ Тогда
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.АрендныеОбязательстваУЕ;
	ИначеЕсли ДокументОбъект.ВалютаДокумента <> ВалютаРегл Тогда
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.АрендныеОбязательстваВал;
	Иначе
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.АрендныеОбязательства;
	КонецЕсли;
	
	ДанныеОбъекта = Новый Структура("Организация, Склад");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, ДокументОбъект);
	ДанныеОбъекта.Вставить("РасчетыВУЕ", РасчетыВУЕ);
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.ПредметыЛизинга Цикл
		МенеджерОбъекта = Документы[ИмяДокументаПоступлениеВАрендуЛизинг()];
		МенеджерОбъекта.ЗаполнитьСчетаУчетаВСтрокеТабличнойЧасти(ДанныеОбъекта, СтрокаТаблицы, "ПредметыЛизинга");
	КонецЦикла;
	
КонецПроцедуры

