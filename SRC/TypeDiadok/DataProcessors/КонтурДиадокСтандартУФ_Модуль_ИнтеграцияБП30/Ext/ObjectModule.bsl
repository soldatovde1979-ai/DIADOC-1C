КонецФункции

Функция ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(СтрокаТЧ)
	
	Результат = СтрокаТЧ.СведенияОПрослеживаемости <> Неопределено
				И СтрокаТЧ.СведенияОПрослеживаемости.Количество() > 0;
				
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область Прослеживаемость_Создание

Функция НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(ПустаяСсылкаНаДокумент, ДляУКД = Ложь)
	
	Результат = Неопределено;
		
	Если ЕстьМетаданныеСведенияПрослеживаемости(ПустаяСсылкаНаДокумент.Метаданные()) Тогда
		Результат = ПустаяСсылкаНаДокумент.СведенияПрослеживаемости.ВыгрузитьКолонки();
		
		Если ДляУКД Тогда
			ОписаниеЧисло	 = Новый ОписаниеТипов("Число");
			Результат.Колонки.Добавить("КоличествоУвеличение", ОписаниеЧисло);
			Результат.Колонки.Добавить("КоличествоУменьшение", ОписаниеЧисло);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет СведенияОПрослеживаемости документа по данным строки товара электронного документа
// Аналог ОбменСконтрагентамиБП.ЗаполнитьСведенияОПрослеживаемостиВДокументеИБ_УКД()
//
// Параметры
//  Приемник				- ТабличнаяЧасть		- таблица СведенияОПрослеживаемости документа 1С
//  Источник				- ТаблицаЗначений		- см ПрочитатьСвойства_СведенияОПрослеживаемостиКорректировочногоДокумента()
//  Товары 					- ТаблицаЗначений	 	- таблица товаров документа
//
Процедура ЗаполнитьСведенияОПрослеживаемостиВходящегоКорректировочногоДокумента(Приемник, Источник, Товары)

	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Приемник.ВыгрузитьКолонки();

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СведПрослежИБ", Приемник.Выгрузить());
	Запрос.УстановитьПараметр("СведПрослежЭД", Источник);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.Количество КАК Количество,
		|	СведПрослежИБ.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ КАК ЭтоСтрокаСИсходнымиРНПТ
		|ПОМЕСТИТЬ СведПрослежИБ
		|ИЗ
		|	&СведПрослежИБ КАК СведПрослежИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежЭД.КоличествоУвеличение КАК КоличествоУвеличение,
		|	СведПрослежЭД.КоличествоУменьшение КАК КоличествоУменьшение,
		|	СведПрослежЭД.РНПТ КАК РНПТ,
		|	СведПрослежЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведПрослежЭД.ЭтоСтрокаСИсходнымиРНПТ КАК ЭтоСтрокаСИсходнымиРНПТ
		|ПОМЕСТИТЬ СведПрослежЭД
		|ИЗ
		|	&СведПрослежЭД КАК СведПрослежЭД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.КоличествоПрослеживаемости - СведПрослежЭД.КоличествоУменьшение + СведПрослежЭД.КоличествоУвеличение КАК КоличествоПрослеживаемости,
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ КАК ЭтоСтрокаСИсходнымиРНПТ
		|ПОМЕСТИТЬ СкорректированныеСтрокиПоДаннымЭД
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СведПрослежЭД КАК СведПрослежЭД
		|		ПО СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки
		|			И СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ
		|ГДЕ
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ,
		|	СведПрослежИБ.КоличествоПрослеживаемости,
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ СведПрослежЭД КАК СведПрослежЭД
		|		ПО СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки
		|			И СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ
		|ГДЕ
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ = ЛОЖЬ
		|	И СведПрослежЭД.ИдентификаторСтроки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежЭД.РНПТ КАК РНПТ,
		|	СведПрослежЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведПрослежЭД.ЭтоСтрокаСИсходнымиРНПТ КАК ЭтоСтрокаСИсходнымиРНПТ
		|ПОМЕСТИТЬ НовыеСтрокиПоДаннымЭД
		|ИЗ
		|	СведПрослежЭД КАК СведПрослежЭД
		|		ЛЕВОЕ СОЕДИНЕНИЕ СведПрослежИБ КАК СведПрослежИБ
		|		ПО (СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки)
		|			И (СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ)
		|			И (СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ = ЛОЖЬ)
		|ГДЕ
		|	СведПрослежИБ.РНПТ ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.Количество КАК Количество,
		|	СведПрослежИБ.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ КАК ЭтоСтрокаСИсходнымиРНПТ
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|ГДЕ
		|	СведПрослежИБ.ЭтоСтрокаСИсходнымиРНПТ = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СкорректированныеСтрокиПоДаннымЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СкорректированныеСтрокиПоДаннымЭД.РНПТ КАК РНПТ,
		|	0 КАК Количество,
		|	СкорректированныеСтрокиПоДаннымЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
		|	СкорректированныеСтрокиПоДаннымЭД.ЭтоСтрокаСИсходнымиРНПТ КАК ЭтоСтрокаСИсходнымиРНПТ
		|ИЗ
		|	СкорректированныеСтрокиПоДаннымЭД КАК СкорректированныеСтрокиПоДаннымЭД
		|ГДЕ
		|	СкорректированныеСтрокиПоДаннымЭД.КоличествоПрослеживаемости <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НовыеСтрокиПоДаннымЭД.ИдентификаторСтроки,
		|	НовыеСтрокиПоДаннымЭД.РНПТ,
		|	0,
		|	НовыеСтрокиПоДаннымЭД.КоличествоПрослеживаемости,
		|	НовыеСтрокиПоДаннымЭД.ЭтоСтрокаСИсходнымиРНПТ
		|ИЗ
		|	НовыеСтрокиПоДаннымЭД КАК НовыеСтрокиПоДаннымЭД
		|ИТОГИ ПО
		|	ИдентификаторСтроки";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаИдентификаторСтроки = РезультатЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИдентификаторСтроки.Следующий() Цикл
		
		СведенияПрослеживаемости = Результат.СкопироватьКолонки();
		
		Выборка = ВыборкаИдентификаторСтроки.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;
		
		СтрокиТоваров = Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаИдентификаторСтроки.ИдентификаторСтроки));
		Для каждого СтрокаТовара Из СтрокиТоваров Цикл
			СтрокаТовара.ПрослеживаемыйТовар = Истина;
		КонецЦикла;
		
		ПроизвестиРассчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, СтрокиТоваров[0].Количество);
		ДополнитьТаблицу(Результат, СведенияПрослеживаемости);
		
		
	КонецЦикла;
	
	СведенияПрослеживаемостиИБСИсходнымиРНПТ = РезультатЗапроса[4].Выгрузить();
	ДополнитьТаблицу(Результат, СведенияПрослеживаемостиИБСИсходнымиРНПТ);
	
	Приемник.Загрузить(Результат);
	
КонецПроцедуры

// Дополняет таблицу прослеживаемости данными ЭД для переданной строки товара
//
// Параметры
//  Приемник					- ТаблицаЗначений			- см НоваяТаблицаСведенияПрослеживаемости()
//  ДанныеЭД					- Массив	 				- массив структур, СведенияОПрослеживаемости электронного документа
//  СтрокаТовары				- СтрокаТаблицыЗначений		- старый ИдентификаторСтроки
//
Процедура ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УКД(Приемник, ДанныеЭД, СтрокаТовары)
	
	СтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	
	СведенияПрослеживаемости = Приемник.СкопироватьКолонки();
	Для Каждого СтрокаДанных Из ДанныеЭД Цикл
		СтрокаПрослеживаемости = СведенияПрослеживаемости.Добавить();
		СтрокаПрослеживаемости.РНПТ							= НомерГТДИзСведенийПрослеживаемости(СтрокаДанных.НомерГТДРегистрационныйНомер);
		СтрокаПрослеживаемости.КоличествоПрослеживаемости	= СтрокаДанных.КоличествоПослеИзменения;
		СтрокаПрослеживаемости.КоличествоУвеличение			= СтрокаДанных.КоличествоУвеличение;
		СтрокаПрослеживаемости.КоличествоУменьшение			= СтрокаДанных.КоличествоУменьшение;
		СтрокаПрослеживаемости.ИдентификаторСтроки			= СтрокаТовары.ИдентификаторСтроки;
	КонецЦикла;
	
	ДополнитьТаблицу(Приемник, СведенияПрослеживаемости);
	
КонецПроцедуры

// Дополняет таблицу прослеживаемости данными ЭД для переданной строки товара
//
// Параметры
//  Приемник					- ТаблицаЗначений			- см НоваяТаблицаСведенияПрослеживаемости()
//  ДанныеЭД 					- Массив	 				- массив структур, СведенияОПрослеживаемости электронного документа
//  СтрокаТовары				- СтрокаТаблицыЗначений		- старый ИдентификаторСтроки
//
Процедура ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УПД(Приемник, ДанныеЭД, СтрокаТовары)
	
	Если Приемник = Неопределено
		Или ДанныеЭД.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТовары.ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = СтрокаТовары.ИдентификаторСтроки;
	Иначе
		ИдентификаторСтроки = Новый УникальныйИдентификатор;
		СтрокаТовары.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЕсли;
	
	СтрокаТовары.ПрослеживаемыйТовар = Истина;
	
	СведенияПрослеживаемости = Приемник.СкопироватьКолонки();
	
	Для Каждого ЭлементИсточника Из ДанныеЭД Цикл
				
		НоваяПрослеживаемость = СведенияПрослеживаемости.Добавить();
		
		НоваяПрослеживаемость.ИдентификаторСтроки 			= ИдентификаторСтроки;
		НоваяПрослеживаемость.РНПТ 							= НомерГТДИзСведенийПрослеживаемости(ЭлементИсточника.НомерГТДРегистрационныйНомер);
		НоваяПрослеживаемость.КоличествоПрослеживаемости 	= ЭлементИсточника.КоличествоПоРНПТ;
		НоваяПрослеживаемость.Сумма						 	= ЭлементИсточника.СтоимостьБезНДСПрослеживаемости;
		                                                                       
	КонецЦикла;
	
	ПроизвестиРассчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, СтрокаТовары.Количество);
	
	ДополнитьТаблицу(Приемник, СведенияПрослеживаемости);
	
КонецПроцедуры

Процедура ПроизвестиРассчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, КоличествоТовара)
	
	// Обрабатываем по аналогии с типовой БП.
	// Возможные варианты:
	
	// 1. Учетное количество было заполнено из данных электронного документа. Рассчитывать не нужно.
	// Данный сценарий на текущий момент не поддерживается.
	Если СведенияПрослеживаемости.Итог("Количество") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоКоличествоПрослеживаемости = СведенияПрослеживаемости.Итог("КоличествоПрослеживаемости");
	
	// 2. Если общее количество прослеживаемости совпадает с количеством товара, то предполагаем, что единица измерения прослеживаемости совпадает
	// с учетной единицей измерения. В этом случае количество учетное приравниваем количеству прослеживаемости.
	Если ВсегоКоличествоПрослеживаемости = КоличествоТовара Тогда
		Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
			ЭлементКоллекции.Количество = ЭлементКоллекции.КоличествоПрослеживаемости;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	// 3. Требуется произвести пропорциональное распределение
	СведенияПрослеживаемости.Колонки.Добавить("Порядок");
	
	Порядок = 0;
	Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
		Порядок = Порядок + 1;
		ЭлементКоллекции.Порядок = Порядок;
	КонецЦикла;
	
	СведенияПрослеживаемости.Сортировать("КоличествоПрослеживаемости");
	Распределено = 0;
	Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
		Если СведенияПрослеживаемости.Индекс(ЭлементКоллекции) + 1 = СведенияПрослеживаемости.Количество() Тогда
			ЭлементКоллекции.Количество = КоличествоТовара - Распределено;
		Иначе 
			ЭлементКоллекции.Количество = ?(ВсегоКоличествоПрослеживаемости = 0, 0,
				ЭлементКоллекции.КоличествоПрослеживаемости * КоличествоТовара / ВсегоКоличествоПрослеживаемости);
			Распределено = Распределено + ЭлементКоллекции.Количество;
		КонецЕсли;
	КонецЦикла;
	
	СведенияПрослеживаемости.Сортировать("Порядок");
		
КонецПроцедуры

// Обновляет ИдентификаторСтроки в ДанныеДокумента и ДанныеДокумента.СведенияПрослеживаемости
// Для корректной связи при перезаполнение ИдентификаторСтроки по дпнным исходной строки корректировки
//
// Параметры
//  ДанныеДокумента			- Структура		- строка ДанныеЗаполнения.Товары
//  СтарыйИДСтроки			- Строка		- старый ИдентификаторСтроки
//  НовыйИДСтроки 			- Строка	 	- новый ИдентификаторСтроки
//
Процедура ОбновитьИдентификаторыСтрокПрослеживаемости(ДанныеДокумента, СтарыйИДСтроки, НовыйИДСтроки)
	
	Если СтарыйИДСтроки <> НовыйИДСтроки Тогда
	
		Если ДанныеДокумента.Свойство("СведенияПрослеживаемости")
			И ДанныеДокумента.СведенияПрослеживаемости <> Неопределено Тогда
			
			Отбор = Новый Структура("ИдентификаторСтроки", СтарыйИДСтроки);
			
			СтрокиСоСтарымИД = ДанныеДокумента.СведенияПрослеживаемости.НайтиСтроки(Отбор);
			Для каждого СтрокаСоСтарымИД Из СтрокиСоСтарымИД Цикл
				СтрокаСоСтарымИД.ИдентификаторСтроки = НовыйИДСтроки;
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
 
#Область Прослеживаемость_Отправка

Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоРеализации(ТаблицаТоваров, СсылкаНаОбъект)
	
	Если НЕ ИспользуетсяУчетПрослеживаемыхТоваров()
		ИЛИ НЕ МожноЗаполнитьПрослеживаемость(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров.Колонки.Добавить("ДанныеПрослеживаемости");
	ТаблицаТоваров.Колонки.Добавить("ПрослеживаемыйТовар");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СведенияПрослеживаемости.Ссылка КАК Ссылка,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТТаблицаПрослеживаемостиОснования
	|ИЗ
	|	&ИмяМетаданныхТаблицыПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка
	|	И СведенияПрослеживаемости.ИдентификаторСтроки В(&ИдентификаторыСтрок)
	|	И &ДопУсловиеТаблицыПрослеживаемости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НомераГТД.Ссылка, &ПустойНомерГТД) = &ПустойНомерГТД
	|			ТОГДА """"
	|		ИНАЧЕ НомераГТД.Код
	|	КОНЕЦ КАК НомерГТДРегистрационныйНомер,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПоРНПТ,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	&ИмяМетаданныхНоменклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТСведенияПрослеживаемостиБезИЕ
	|ИЗ
	|	&ИмяМетаданныхТаблицыТоваров КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаПрослеживаемостиОснования КАК СведенияПрослеживаемости
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|			ПО СведенияПрослеживаемости.РНПТ = НомераГТД.Ссылка
	|		ПО ТаблицаТоваров.Ссылка = СведенияПрослеживаемости.Ссылка
	|			И ТаблицаТоваров.ИдентификаторСтроки = СведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаТоваров.Ссылка = &Ссылка
	|	И ТаблицаТоваров.ИдентификаторСтроки В(&ИдентификаторыСтрок)
	|	И ТаблицаТоваров.ИдентификаторСтроки <> """"
	|	И ТаблицаТоваров.ПрослеживаемыйТовар = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.НомерГТДРегистрационныйНомер КАК НомерГТДРегистрационныйНомер,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификаторЕдиницИзмерения.Ссылка, &ПустаяЕИ) = &ПустаяЕИ
	|			ТОГДА ""шт""
	|		ИНАЧЕ КлассификаторЕдиницИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияПрослеживаемости,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификаторЕдиницИзмерения.Ссылка, &ПустаяЕИ) = &ПустаяЕИ
	|			ТОГДА ""796""
	|		ИНАЧЕ КлассификаторЕдиницИзмерения.Код
	|	КОНЕЦ КАК КодЕдиницыИзмеренияПрослеживаемости,
	|	ТаблицаТоваров.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВТСведенияПрослеживаемости
	|ИЗ
	|	ВТСведенияПрослеживаемостиБезИЕ КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|				ПО КлассификаторТНВЭД.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|			ПО СправочникНоменклатура.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|		ПО ТаблицаТоваров.Номенклатура = СправочникНоменклатура.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСведенияПрослеживаемости.НомерГТДРегистрационныйНомер КАК НомерГТДРегистрационныйНомер,
	|	ВТСведенияПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости КАК ЕдиницаИзмеренияПрослеживаемости,
	|	ВТСведенияПрослеживаемости.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ВТСведенияПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости КАК КодЕдиницыИзмеренияПрослеживаемости,
	|	ВТСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ВТСведенияПрослеживаемости КАК ВТСведенияПрослеживаемости";
	
	ИмяДокумента = СсылкаНаОбъект.Метаданные().Имя;
	
	Если ЭтоПередачаОС(СсылкаНаОбъект) Тогда
		ИмяМетаданныхТаблицыТоваров	= "Документ.ПередачаОС.ОС";
		ИмяМетаданныхНоменклатура	= "ТаблицаТоваров.ОсновноеСредство";
		ИмяТабличнойЧасти			= "ОС";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Номенклатура"	, "Справочник.ОсновныеСредства"); //для условия связи в 3 таблице
	Иначе
		ИмяМетаданныхТаблицыТоваров	= СтрЗаменить("Документ.%ИмяДокумента%.Товары", "%ИмяДокумента%", ИмяДокумента);
		ИмяМетаданныхНоменклатура	= "ТаблицаТоваров.Номенклатура";
		ИмяТабличнойЧасти			= "Товары";
	КонецЕсли;
	
	ИмяМетаданныхТаблицыПрослеживаемости = СтрЗаменить("Документ.%ИмяДокумента%.СведенияПрослеживаемости", "%ИмяДокумента%", ИмяДокумента);
	
	ДопУсловиеТаблицыПрослеживаемости = "Истина";
	Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ." + ИмяДокумента + ".ТабличнаяЧасть.СведенияПрослеживаемости.Реквизит.ЭтоСтрокаСИсходнымиРНПТ") Тогда
		ДопУсловиеТаблицыПрослеживаемости = ДопУсловиеТаблицыПрослеживаемости + " И СведенияПрослеживаемости.ЭтоСтрокаСИсходнымиРНПТ = Ложь"; 	
	КонецЕсли;	
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловиеТаблицыПрослеживаемости"		, ДопУсловиеТаблицыПрослеживаемости);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяМетаданныхТаблицыТоваров"				, ИмяМетаданныхТаблицыТоваров);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяМетаданныхТаблицыПрослеживаемости"	, ИмяМетаданныхТаблицыПрослеживаемости);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяМетаданныхНоменклатура"				, ИмяМетаданныхНоменклатура);
	
	СтрокиТоваров		 = ТаблицаТоваров.НайтиСтроки(Новый Структура("ИмяТабличнойЧасти, ЭтоУслуга", ИмяТабличнойЧасти, Ложь)); 
	ИдентификаторыСтрок	 = ОбщегоНазначения.ВыгрузитьКолонку(СтрокиТоваров, "ИдентификаторСтроки");
	
	Запрос.УстановитьПараметр("ПустаяЕИ"			 , Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойНомерГТД"		 , Справочники.НомераГТД.ПустаяСсылка());
	Запрос.УстановитьПараметр("Ссылка"				 , СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИдентификаторыСтрок"	 , ИдентификаторыСтрок);
	
	СведенияПрослеживаемости = Запрос.Выполнить().Выгрузить();
	СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
	
	Для Каждого СтрокаТЧ Из СтрокиТоваров Цикл
		
		СтрокиПрослеживаемости = СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтроки));
		
		Если СтрокиПрослеживаемости.Количество() > 0 Тогда
			
			СтрокаТЧ.ДанныеПрослеживаемости	 = Новый Массив;
			СтрокаТЧ.ПрослеживаемыйТовар	 = Истина;
			
			Для каждого СтрокаПрослеживаемости Из СтрокиПрослеживаемости Цикл
				
				ЭлементПрослеживаемости = НовыеСвойстваЭлементаПрослеживаемости();
				ЗаполнитьЗначенияСвойств(ЭлементПрослеживаемости, СтрокаПрослеживаемости);
				СтрокаТЧ.ДанныеПрослеживаемости.Добавить(ЭлементПрослеживаемости);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет реквизит ДанныеПрослеживаемости и ПрослеживаемыйТовар в СтрокаТовары
//
// Параметры
//  СтрокаТовары	- СтрокаТаблицыЗначенй	 	- см. ИнициализацияТаблицыСтрокТовары()
//  Источник		- СтрокаТаблицыЗначенй	
//  СведенияОПрослеживаемости	- ТаблицаЗначений	
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(СтрокаТовары, Источник, СведенияОПрослеживаемости)
	
	Если СведенияОПрослеживаемости.Колонки.Найти("ИдентификаторСтроки") = Неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Товар"							, Источник.Номенклатура);
		Отбор.Вставить("СтранаПроисхождения"			, Источник.СтранаПроисхождения);
		Отбор.Вставить("НаименованиеЕдиницыИзмерения"	, Источник.ЕдиницаИзмерения);
		Отбор.Вставить("ЦенаДоИзменения"				, Источник.ЦенаДоИзменения);
		Отбор.Вставить("ЦенаПослеИзменения"				, Источник.ЦенаПослеИзменения);
		Отбор.Вставить("СтавкаНДСПослеИзменения"		, Источник.СтавкаНДСПослеИзменения);
		
	Иначе
		
		Отбор = Новый Структура("ИдентификаторСтроки", Источник.ИдентификаторСтроки);
		
	КонецЕсли;
	
	СтрокиПрослеживаемости = СведенияОПрослеживаемости.НайтиСтроки(Отбор);
	
	Если СтрокиПрослеживаемости.Количество() Тогда
		
		СтрокаТовары.ДанныеПрослеживаемости	 = Новый Массив;
		СтрокаТовары.ПрослеживаемыйТовар	 = Истина;
		
		Для каждого СтрокаПрослеживаемости Из СтрокиПрослеживаемости Цикл
			
			ЭлементПрослеживаемости = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НовыеСвойстваЭлементаПрослеживаемостиПоКорректировке");
			
			ЭлементПрослеживаемости.НомерГТДРегистрационныйНомер		 = СтрокаПрослеживаемости.НомерТовара;
			ЭлементПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости	 = СтрокаПрослеживаемости.ЕдиницаИзмеренияПрослеживаемостиКод;
			ЭлементПрослеживаемости.КоличествоДоИзменения				 = СтрокаПрослеживаемости.КоличествоТовараДоИзменения;
			ЭлементПрослеживаемости.КоличествоПослеИзменения			 = СтрокаПрослеживаемости.КоличествоТовараПослеИзменения;
			
			ЭтоУменьшение = ЭлементПрослеживаемости.КоличествоДоИзменения > ЭлементПрослеживаемости.КоличествоПослеИзменения; 
			Если ЭтоУменьшение Тогда
				КоличествоУменьшение = ЭлементПрослеживаемости.КоличествоДоИзменения - ЭлементПрослеживаемости.КоличествоПослеИзменения;
				ЭлементПрослеживаемости.КоличествоУменьшение = КоличествоУменьшение;
			КонецЕсли; 
			
			ЭтоУвеличение = ЭлементПрослеживаемости.КоличествоПослеИзменения > ЭлементПрослеживаемости.КоличествоДоИзменения;
			Если ЭтоУвеличение Тогда
				КоличествоУвеличение = ЭлементПрослеживаемости.КоличествоПослеИзменения - ЭлементПрослеживаемости.КоличествоДоИзменения;
				ЭлементПрослеживаемости.КоличествоУвеличение = КоличествоУвеличение;
			КонецЕсли;
			
			СтрокаТовары.ДанныеПрослеживаемости.Добавить(ЭлементПрослеживаемости);
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Функция МожноЗаполнитьПрослеживаемость(СсылкаНаОбъект)
	
	ПоддерживаемыеТипы = Новый Массив;
	ПоддерживаемыеТипы.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	ПоддерживаемыеТипы.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
	ПоддерживаемыеТипы.Добавить(Тип("ДокументСсылка.ПередачаОС"));
	ПоддерживаемыеТипы.Добавить(Тип("ДокументСсылка.ОтчетКомиссионераОПродажах"));
	ПоддерживаемыеТипы.Добавить(Тип("ДокументСсылка.ОтчетКомитентуОПродажах"));
	
	Результат = ПоддерживаемыеТипы.Найти(ТипЗнч(СсылкаНаОбъект)) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

