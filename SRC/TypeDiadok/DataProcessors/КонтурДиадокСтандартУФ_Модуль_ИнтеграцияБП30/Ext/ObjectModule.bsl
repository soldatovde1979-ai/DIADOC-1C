Функция ТекстЗапросаТЧ_ОтчетКомитентуОПродажах(ОтчетКомитенту, СчетФактура)
	
	ТребуемыеРеквизитыОтчета = Новый Структура;
	ТребуемыеРеквизитыОтчета.Вставить("СчетаФактурыОтИмениОрганизации", "ДоговорКонтрагента.СчетаФактурыОтИмениОрганизации");
	ТребуемыеРеквизитыОтчета.Вставить("ВидОперации");
	
	РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетКомитенту, ТребуемыеРеквизитыОтчета);
	
	ТребуемыеРеквизитыСФ = Новый Структура;
	ТребуемыеРеквизитыСФ.Вставить("Контрагент");
	ТребуемыеРеквизитыСФ.Вставить("Продавец");
	ТребуемыеРеквизитыСФ.Вставить("КодВидаОперации");
	
	РеквизитыСФ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, ТребуемыеРеквизитыСФ);
	
	ЭтоСводныйКомиссионныйСФ = (РеквизитыСФ.КодВидаОперации = "27"); // п 3.1 статьи 169 НК
	СФОтИмениОрганизации = РеквизитыСФ.Контрагент = СчетФактура.Продавец И РеквизитыОтчета.СчетаФактурыОтИмениОрганизации;
	
	Если РеквизитыОтчета.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках 
		И ЗначениеЗаполнено(РеквизитыСФ.Продавец)
		И (РеквизитыСФ.Контрагент <> РеквизитыСФ.Продавец
			ИЛИ СФОтИмениОрганизации
			ИЛИ ЭтоСводныйКомиссионныйСФ) Тогда
			
		Результат = ТекстЗапросаТЧ_ОтчетКомитентуОПродажах_Товары();
		 
	Иначе
		
		Результат = ТекстЗапросаТЧ_ОтчетКомитентуОПродажах_Вознаграждение();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТЧ_ОтчетКомитентуОПродажах_Товары()
	
	Результат =
	"ВЫБРАТЬ
	|	Т.Количество КАК Количество,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	Т.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Т.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	"""" КАК СтранаПроисхождения,
	|	"""" КАК НомерГТД,
	|	"""" КАК НомерГТДПредставление,
	|	Т.СтавкаНДС КАК СтавкаНДС,
	|	Т.СуммаНДС КАК СуммаНДС,
	|	Т.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Т.Номенклатура.Услуга КАК ЭтоУслуга,
	|	&КодНоменклатурыИзТЧ КАК КодНоменклатуры,
	|	Т.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|	"""" КАК ВидУпаковки,
	|	"""" КАК КоличествоВОдномМесте,
	|	"""" КАК КоличествоМест,
	|	Т.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Т.Содержание <> """"
	|			ТОГДА Т.Содержание
	|		КОГДА ПОДСТРОКА(Т.Номенклатура.НаименованиеПолное, 1, 10) = """"
	|			ТОГДА Т.Номенклатура.Наименование
	|		ИНАЧЕ Т.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НоменклатураПредставление,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	0 КАК ВсегоВРублях,
	|	0 КАК НДСВРублях,
	|	ЛОЖЬ КАК СуществуютЗаписиРублевыхСумм,
	|	ВЫБОР
	|		КОГДА Т.Номенклатура.Услуга
	|			ТОГДА ""Service""
	|		ИНАЧЕ ""Property""
	|	КОНЕЦ КАК ПризнакТоварРаботаУслуга
	|ИЗ
	|	Документ.ОтчетКомитентуОПродажах.Товары КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомитентуОПродажах.Поставщики КАК ТЧПоставщики
	|		ПО Т.КлючСтроки = ТЧПоставщики.КлючСтроки
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|	И ТЧПоставщики.СчетФактура = &СчетФактура";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТЧ_ОтчетКомитентуОПродажах_Вознаграждение()
	
	Результат =
	"ВЫБРАТЬ
	|	подзапрос.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА подзапрос.Номенклатура = ЗНАЧЕНИЕ(Справочник.номенклатура.ПустаяСсылка)
	|			ТОГДА ""Комиссионное вознаграждение""
	|		КОГДА ПОДСТРОКА(подзапрос.Номенклатура.НаименованиеПолное, 1, 10) = """"
	|			ТОГДА подзапрос.Номенклатура.Наименование
	|		ИНАЧЕ подзапрос.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НоменклатураПредставление,
	|	ВЫБОР
	|		КОГДА подзапрос.Номенклатура = ЗНАЧЕНИЕ(Справочник.номенклатура.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ подзапрос.Номенклатура.Код
	|	КОНЕЦ КАК КодНоменклатуры,
	|	подзапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	"""" КАК КодЕдиницыИзмерения,
	|	""Услуги"" КАК ИмяТабличнойЧасти,
	|	подзапрос.Количество КАК Количество,
	|	подзапрос.Цена КАК Цена,
	|	подзапрос.Ссылка.СтавкаНДСВознаграждения КАК СтавкаНДС,
	|	подзапрос.Сумма КАК Сумма,
	|	подзапрос.СуммаНДС КАК СуммаНДС,
	|	подзапрос.НомерГТД КАК НомерГТД,
	|	подзапрос.СтранаПроисхождения КАК СтранаПроисхождения,
	|	подзапрос.НомерГТДПредставление КАК НомерГТДПредставление,
	|	подзапрос.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	"""" КАК ВидУпаковки,
	|	0 КАК КоличествоВОдномМесте,
	|	0 КАК КоличествоМест,
	|	ИСТИНА КАК ЭтоУслуга,
	|	""Service"" КАК ПризнакТоварРаботаУслуга,
	|	0 КАК ВсегоВРублях,
	|	0 КАК НДСВРублях,
	|	ЛОЖЬ КАК СуществуютЗаписиРублевыхСумм
	|ИЗ
	|	(ВЫБРАТЬ
	|		СУММА(Т.СуммаВознаграждения) КАК Сумма,
	|		СУММА(Т.СуммаНДСВознаграждения) КАК СуммаНДС,
	|		Т.Ссылка.УслугаПоВознаграждению КАК Номенклатура,
	|		Т.Ссылка КАК Ссылка,
	|		0 КАК Количество,
	|		"""" КАК Цена,
	|		"""" КАК НомерГТД,
	|		"""" КАК СтранаПроисхождения,
	|		"""" КАК НомерГТДПредставление,
	|		Т.Ссылка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|		"""" КАК ЕдиницаИзмерения
	|	ИЗ
	|		Документ.ОтчетКомитентуОПродажах.Товары КАК Т
	|	ГДЕ
	|		Т.Ссылка = &Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Т.Ссылка,
	|		Т.Ссылка.УслугаПоВознаграждению,
	|		Т.Ссылка.СуммаВключаетНДС) КАК подзапрос";
	
	Возврат Результат;
	
КонецФункции

