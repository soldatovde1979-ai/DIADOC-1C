КонецФункции

Функция СтруктураЗаполненияПоступленияДенежныхДокументов(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияПоступленияДенежныхДокументов();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ДенежныеДокументы = Документы.ПоступлениеДенежныхДокументов.ПустаяСсылка().ДенежныеДокументы.ВыгрузитьКолонки();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("ВидОперации", ПараметрыЗаполнения.ВидОперации);
	
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсВзаиморасчетов"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьВзаиморасчетов", ШапкаЭД.Кратность);
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоваяСтрока = ДенежныеДокументы.Добавить();
		
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Сумма		 = Стр.СуммаСНДС;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("ДенежныеДокументы", ДенежныеДокументы);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Процедура ЗаполнитьПоступлениеДенежныхДокументов(ДокументОбъект, ДанныеДокумента)
	
	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ЗаполнениеДокументов.Заполнить(ДокументОбъект, ДанныеШапки);
	
	ОтборПоВалюте       = Новый Структура("ЗначениеОтбора", ДокументОбъект.ВалютаДокумента);
	СтруктураПараметров = Новый Структура("ВалютаВзаиморасчетов", ОтборПоВалюте);
	
	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
	
	РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ДокументОбъект.ДоговорКонтрагента,
		ДокументОбъект.Контрагент, ДокументОбъект.Организация, СписокВидовДоговоров, СтруктураПараметров);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ОтражениеВУСН = Неопределено;
	
	ДокументОбъект.ДенежныеДокументы.Очистить();
	
	Для Каждого СтрокаТЧ Из ДанныеДокумента.ДенежныеДокументы Цикл
		
		НоваяСтрока = ДокументОбъект.ДенежныеДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
	КонецЦикла;
	
	ЗаполнитьСчетаУчетаПоступленияДенежныхДокументов(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьСчетаУчетаПоступленияДенежныхДокументов(ДокументОбъект)
	
	ВалютаРегл = ВалютаРегламентированногоУчета();
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументОбъект.ДоговорКонтрагента, "ВалютаВзаиморасчетов, РасчетыВУсловныхЕдиницах");
	
	ДоговорУказан = ЗначениеЗаполнено(ДокументОбъект.ДоговорКонтрагента);
	
	РасчетыВУЕ = ДоговорУказан И РеквизитыДоговора.РасчетыВУсловныхЕдиницах;
	
	Если РасчетыВУЕ Тогда
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчикамиУЕ;
		ДокументОбъект.СчетУчетаДенежныхДокументов = ПланыСчетов.Хозрасчетный.ДенежныеДокументыВал;
	ИначеЕсли ДокументОбъект.ВалютаДокумента <> ВалютаРегл Тогда
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчикамиВал;
		ДокументОбъект.СчетУчетаДенежныхДокументов = ПланыСчетов.Хозрасчетный.ДенежныеДокументыВал;
	Иначе
		ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыСПрочимиПоставщикамиИПодрядчиками;
		ДокументОбъект.СчетУчетаДенежныхДокументов = ПланыСчетов.Хозрасчетный.ДенежныеДокументы;
	КонецЕсли;
	
КонецПроцедуры

