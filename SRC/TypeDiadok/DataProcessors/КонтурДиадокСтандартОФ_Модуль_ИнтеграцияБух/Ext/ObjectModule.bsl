Процедура ЗаполнитьШапкуПоступленияТоваровУслуг(ДокументОбъект, ПараметрыСоздания, РеквизитыЭлектронногоДокумента)
	
	УстановитьОрганизациюДокумента(ДокументОбъект, ПараметрыСоздания.Организация);
	УстановитьКонтрагентаДокумента(ДокументОбъект, ПараметрыСоздания.Контрагент);
	УстановитьРеквизитыВходящегоДокумента(ДокументОбъект, РеквизитыЭлектронногоДокумента);
	УстановитьДоговорСПоставщиком(ДокументОбъект);
	
	УстановитьОсновныеРеквизитыДокумента(ДокументОбъект);
	УстановитьВалютуДокумента(ДокументОбъект);
	УстановитьПараметрыУчетаНДС(ДокументОбъект, ПараметрыСоздания.ЦенаВключаетНДС);
	УстановитьСкладДокумента(ДокументОбъект);
	УстановитьСпособЗачетаАвансов(ДокументОбъект);
	УстановитьВидПоступленияПокупка(ДокументОбъект);
	
	ЗаполнитьСчетаУчетаРасчетов(ДокументОбъект);
	
КонецПроцедуры

Функция НоменклатураЯвляетсяУслугойВЭД(ВидНоменклатурыЭД)
	
	Результат = Ложь;
	
	Если ВидНоменклатурыЭД = "2" Или ВидНоменклатурыЭД = "3" Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьПоступленияТоваровУслуг(ДокументОбъект, ТабличнаяЧасть)
	
	ВладелецНоменклатуры = ДокументОбъект.Контрагент;
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров(ДокументОбъект.Дата);
	
	ВТоварахЕстьРНПТ = ЕстьРеквизитРНПТ(ДокументОбъект, "Товары");
	
	Для Каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		НоменклатураИБ = СтрокаДанных.НоменклатураИнформационнойБазы;
		
		Если ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура = НоменклатураИБ.Номенклатура;
			Характеристика = НоменклатураИБ.Характеристика;
		Иначе
			Номенклатура = Неопределено;
			Характеристика = Неопределено;
		КонецЕсли;
		
		ЭтоУслуга = ЭтоНоменклатураУслуга(Номенклатура);
		НоменклатураЯвляетсяУслугойВЭД = НоменклатураЯвляетсяУслугойВЭД(СтрокаДанных.ВидНоменклатуры);
		
		Если (Номенклатура <> Неопределено И ЭтоУслуга) ИЛИ (Номенклатура = Неопределено И НоменклатураЯвляетсяУслугойВЭД) Тогда
			
			ИмяТЧ = "Услуги";
			
			СтрокаТЧ = ДокументОбъект.Услуги.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.Содержание = СтрокаДанных.Наименование;
			
		Иначе
			
			ИмяТЧ = "Товары";
			
			СтрокаТЧ = ДокументОбъект.Товары.Добавить();
			СтрокаТЧ.Номенклатура = Номенклатура;
			СтрокаТЧ.ЕдиницаИзмерения = ЕдиницаИзмеренияПоКлассификатору(СтрокаДанных.КодЕдИзм);
			СтрокаТЧ.Коэффициент = 1;
			
			СтрокаТЧ.СтранаПроисхождения = НайтиСоздатьСтрануПроисхождения(СтрокаДанных.КодСтраны);
			
			Если ИспользуетсяУчетПрослеживаемыхТоваров
				И ВТоварахЕстьРНПТ
				И ЗначениеЗаполнено(СтрокаДанных.СведенияПрослеживаемости) Тогда
				ДополнитьСтрокуТовараДаннымиПрослеживаемости(СтрокаТЧ, СтрокаДанных);
			ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.НомерГТД) Тогда
				СтрокаТЧ.НомерГТД = НайтиСоздатьНомерГТД(СтрокаДанных.НомерГТД);
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаТЧ.Количество = СтрокаДанных.Количество;
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Количество) Тогда
			СтрокаТЧ.Количество = 1;
		КонецЕсли;
		
		Сумма = СтрокаДанных.СуммаБезНДС;
		Цена = СтрокаДанных.Цена;
		
		Если ДокументОбъект.СуммаВключаетНДС Тогда
			Сумма = СтрокаДанных.СуммаСНДС;
			Цена = Сумма / СтрокаТЧ.Количество;
		КонецЕсли;

		СтрокаТЧ.Цена = Цена;
		СтрокаТЧ.Сумма = Сумма;
		СтрокаТЧ.СуммаНДС = СтрокаДанных.СуммаНДС;
		СтрокаТЧ.СтавкаНДС = ПолучитьСтавкуНДСДиадок(СтрокаДанных.СтавкаНДС);
		
		ЗаполнитьСчетаУчетаСтрокиТабличнойЧасти(СтрокаТЧ, ДокументОбъект);
		
		ЗаполнитьОтражениеВУСН(СтрокаТЧ, ДокументОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

