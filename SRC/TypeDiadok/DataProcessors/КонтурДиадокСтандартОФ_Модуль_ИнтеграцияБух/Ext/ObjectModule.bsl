Процедура ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность)
	
	Для Каждого ТекСтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Сумма		= ТекСтрокаТЧ.Сумма * Курс / Кратность;
		СуммаНДС	= ТекСтрокаТЧ.СуммаНДС * Курс / Кратность;
		
		ТекСтрокаТЧ.Сумма		= Окр(Сумма, 2);
		ТекСтрокаТЧ.СуммаНДС	= Окр(СуммаНДС, 2);
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаРегл)
	
	РасчетСуммыНДСПоСтавке	= УчетНДС.РасчетНДСвРубляхПоСтавкеДокумента(ДанныеШапки.Дата);
	
	Если СуммаРегл <> 0 Тогда
		
		ТабличнаяЧасть.Колонки.Добавить("СуммаБезНДС");
		ТабличнаяЧасть.Колонки.Добавить("СуммаРублевая");
		
		//1. Распределяем сумму регл пропорционально Сумме с НДС
		МассивРаспределения = Новый Массив;
		
		Для Каждого СтрокаТовар Из ТабличнаяЧасть Цикл
			
			СуммаСНДС	= СтрокаТовар.Сумма + ?(ДанныеШапки.СуммаВключаетНДС, 0, СтрокаТовар.СуммаНДС);
			СуммаБезНДС	= СуммаСНДС - СтрокаТовар.СуммаНДС;
			
			СтрокаТовар.СуммаБезНДС = СуммаБезНДС;
			
			МассивРаспределения.Добавить(СуммаСНДС);
			
		КонецЦикла;
		
		УчетНДС.РаспределитьСуммуПоСтолбцу(МассивРаспределения, СуммаРегл, ТабличнаяЧасть, "СуммаРублевая");
		
		//2. Пересчитываем СуммаНДС и Сумму
		Для Каждого СтрокаТовар Из ТабличнаяЧасть Цикл
			
			Если РасчетСуммыНДСПоСтавке Тогда
				
				ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(СтрокаТовар.СтавкаНДС);
				
				СтрокаТовар.СуммаНДС	= ?(ЗначениеСтавкиНДС = 0, 0, Окр(СтрокаТовар.СуммаРублевая * ЗначениеСтавкиНДС / (100 + ЗначениеСтавкиНДС), 2));
				СтрокаТовар.Сумма		= СтрокаТовар.СуммаРублевая - СтрокаТовар.СуммаНДС;
				
			Иначе
				
				МассивРаспределения.Очистить();
				МассивРаспределения.Добавить(СтрокаТовар.СуммаБезНДС);
				МассивРаспределения.Добавить(СтрокаТовар.СуммаНДС);
				
				МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьПропорционально(СтрокаТовар.СуммаРублевая, МассивРаспределения);
				
				Если МассивРаспределенныхСумм <> Неопределено Тогда
					СтрокаТовар.Сумма		= МассивРаспределенныхСумм[0];
					СтрокаТовар.СуммаНДС	= МассивРаспределенныхСумм[1];
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДанныеШапки.СуммаВключаетНДС Тогда
				СтрокаТовар.Сумма = СтрокаТовар.Сумма + СтрокаТовар.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

Функция ОснованиеОтчетКомитентаОПродажах_ОтчетОЗакупках(ДокументСсылка, СчетФактура)
	
	Если СчетФактура = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ОтчетКомитентуОПродажах") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДокументСсылка.Метаданные().Реквизиты.Найти("ВидОперации") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ДокументСсылка.ВидОперации = Перечисления.ВидыОперацийОтчетКомитентуОПродажах.ОтчетОЗакупках
		И ЗначениеЗаполнено(СчетФактура.Продавец)
		И СчетФактура.Контрагент <> СчетФактура.Продавец Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
