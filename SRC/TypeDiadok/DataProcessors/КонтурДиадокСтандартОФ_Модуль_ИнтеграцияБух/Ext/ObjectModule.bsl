	Результат.Вставить("Контрагент");
	Результат.Вставить("ДоговорКонтрагента");
	Результат.Вставить("Руководитель");
	Результат.Вставить("ГлавныйБухгалтер");
	Результат.Вставить("ВалютаРегламентированногоУчета");
	Результат.Вставить("Подразделение");
	Результат.Вставить("ДокументОснование");
	Результат.Вставить("Ссылка");
	Результат.Вставить("ДокументСсылка");
