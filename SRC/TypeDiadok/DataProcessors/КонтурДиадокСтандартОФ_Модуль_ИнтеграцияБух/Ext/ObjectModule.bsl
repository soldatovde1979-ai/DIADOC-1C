Процедура УстановитьВидКорректировкиСогласованноеИзменение(ДокументОбъект)
	
	ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
	
КонецПроцедуры

Процедура ПроверитьЗаполнитьОснованиеКорректировкиПоступления(ПараметрыСоздания, ШапкаЭД, ФорматЭД)
	
	Если ЗначениеЗаполнено(ПараметрыСоздания.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ФорматыЭД = МодульФорматыЭлектронныхДокументов();
	
	ТипыОснований = Новый Массив;
	
	Если ФорматыЭД.ЭтоУниверсальныйКорректировочныйДокумент(ФорматЭД)
		Или ФорматыЭД.ЭтоКорректировочныйСчетФактура(ФорматЭД) Тогда
		
		ТипыОснований.Добавить("СчетФактураПолученный");
		
	ИначеЕсли ФорматыЭД.ЭтоСоглашениеОбИзмененииСтоимости(ФорматЭД) Тогда
		
		ТипыОснований.Добавить("ПоступлениеТоваровУслуг");
		ТипыОснований.Добавить("ПоступлениеДопРасходов");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипыОснований) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОснования = ШапкаЭД.РеквизитыОснования;
	Если Не ЗначениеЗаполнено(РеквизитыОснования) Тогда
		ЗаписатьОшибкуСозданияДокумента(ШапкаЭД, ФорматЭД, "Не заполнены реквизиты основания Корректировочного документа"); 
		Возврат;
	ИначеЕсли РеквизитыОснования.Количество() > 1 Тогда
		ЗаписатьОшибкуСозданияДокумента(ШапкаЭД, ФорматЭД, "Не найден документ основания, т.к. в электронном документе указаны реквизиты нескольких оснований");
		Возврат;
	Иначе
		Основание = РеквизитыОснования[0];
		НомерЭД = Основание.Номер;
		ДатаЭД = Основание.Дата;
	КонецЕсли;
	
	Организация = ПараметрыСоздания.Организация;
	Контрагент = ПараметрыСоздания.Контрагент;
	
	Для Каждого ВидДокумента Из ТипыОснований Цикл
		
		СсылкаНаОбъект = НайтиДокументПоРеквизитам(
			ВидДокумента,
			Организация,
			Контрагент,
			ДатаЭД,
			НомерЭД
		);
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			
			Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СсылкаНаОбъект = СсылкаНаОбъект.ДокументОснование;
			КонецЕсли;
			
			ПараметрыСоздания.ДокументОснование = СсылкаНаОбъект;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиДокументПоРеквизитам(ВидДокумента, Организация, Контрагент, ДатаВходящегоДокумента, НомерВходящегоДокумента)
	
	ШаблонЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.Дата КАК Дата
	|ИЗ
	|	&ПолноеИмяТаблицы КАК Таблица
	|ГДЕ
	|	НЕ Таблица.ПометкаУдаления
	|	И Таблица.Организация = &Организация
	|	И Таблица.Контрагент = &Контрагент
	|	И Таблица.ДатаВходящегоДокумента = &ДатаДокумента
	|	И Таблица.НомерВходящегоДокумента = &НомерДокумента
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	ПолноеИмяТаблицы = "Документ." + ВидДокумента;
	ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаВходящегоДокумента);
	Запрос.УстановитьПараметр("НомерДокумента", НомерВходящегоДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСчетаУчетаРасчетов(ДокументОбъект)
	
	СчетаРасчетов = БухгалтерскийУчетРасчетовСКонтрагентами.ПолучитьСчетаРасчетовСКонтрагентом(
		ДокументОбъект.Организация,
		ДокументОбъект.Контрагент,
		ДокументОбъект.ДоговорКонтрагента
	);
	
	ДокументОбъект.СчетУчетаРасчетовСКонтрагентом = СчетаРасчетов.СчетРасчетов;
	ДокументОбъект.СчетУчетаРасчетовПоАвансам = СчетаРасчетов.СчетАвансов;
	
КонецПроцедуры

Процедура ЗаполнитьСчетаУчетаСтрокиТабличнойЧасти(СтрокаТЧ, ДокументОбъект)
	
	СчетаУчетаНоменклатуры = БухгалтерскийУчет.ПолучитьСчетаУчетаНоменклатуры(ДокументОбъект.Организация, СтрокаТЧ.Номенклатура, ДокументОбъект.Склад);
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, СчетаУчетаНоменклатуры);
	
	СчетУчета = СчетаУчетаНоменклатуры.СчетУчета;
	СчетаУчетаЗатрат = Новый Структура;
	СчетаУчетаЗатрат.Вставить("СчетЗатрат", СчетУчета);
	СчетаУчетаЗатрат.Вставить("СчетЗатратНУ", СчетУчета);
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, СчетаУчетаЗатрат);
	
КонецПроцедуры

Процедура ЗаполнитьОтражениеВУСН(СтрокаТЧ, ДокументОбъект)
	
	ПрименяетсяУСН = НалоговыйУчетУСН.ПрименениеУСН(ДокументОбъект.Организация, ДокументОбъект.Дата);
	ПрименяетсяОсобыйПорядокНалогообложения = НалоговыйУчетУСН.ПрименениеОсобогоПорядкаНалогообложения(ДокументОбъект.Организация, ДокументОбъект.Дата);
	
	Если НЕ ПрименяетсяУСН ИЛИ ПрименяетсяОсобыйПорядокНалогообложения Тогда
		Возврат;
	КонецЕсли;
		
	ОтражениеВУСН_Товары = ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ОтражениеВУСН", ДокументОбъект.Метаданные(), "Товары");
	ОтражениеВУСН_Услуги = ОбщегоНазначения.ЕстьРеквизитТабЧастиДокумента("ОтражениеВУСН", ДокументОбъект.Метаданные(), "Услуги");
	
	Если ОтражениеВУСН_Товары ИЛИ ОтражениеВУСН_Услуги Тогда
		
		Если (ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия 
			И ДокументОбъект.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом) Тогда
			
			СтрокаТЧ.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			
		ИначеЕсли ДокументОбъект.ВидОперации <> Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ВПереработку Тогда
			
			СтрокаТЧ.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

