Функция ПолучитьОбщиеДанныеДляПечатиПередаточногоДокумента(ДокументСсылка)
	
	ДанныеДокумента = Новый_ДанныеПередаточногоДокументаДляПечати();
	
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДокументСсылка);
	
	ДанныеДокумента.ДокументОснование = ДокументСсылка;
	ДанныеДокумента.Ссылка = Документы.СчетФактураВыданный.ПустаяСсылка();
	ДанныеДокумента.ДокументСсылка = ДокументСсылка;
	ДанныеДокумента.ИдентификаторГосКонтракта = "";
	
	Результат = УчетНДС.ПодготовитьДанныеДляПечатиУниверсальногоПередаточногоДокумента(ДанныеДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКПППродавца(ДокументСсылка) Экспорт
	
	Результат = Неопределено;
	
	Если ЭтоСФ(ДокументСсылка)
		ИЛИ ЭтоКСФ(ДокументСсылка) Тогда
		
		ОбщиеДанныеДляПечати = ПолучитьОбщиеДанныеДляПечатиСФ(ДокументСсылка);
		
	Иначе
		
		ОбщиеДанныеДляПечати = ПолучитьОбщиеДанныеДляПечатиПередаточногоДокумента(ДокументСсылка);
		
	КонецЕсли;
	
	ПодразделениеДляПечати = ОсновнойМодуль.СвойствоСтруктуры(ОбщиеДанныеДляПечати, "Подразделение");
	
	Если ЗначениеЗаполнено(ПодразделениеДляПечати)
		И ПодразделениеДляПечати.ОбособленноеПодразделение Тогда
		
		Результат = ПодразделениеДляПечати.КПП;
		
	ИначеЕсли ОбщегоНазначения.ЭтоОбособленноеПодразделение(ОбщиеДанныеДляПечати.Организация) Тогда
		
		СведенияОбОрганизации = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(
			ОбщиеДанныеДляПечати.Организация,
			ДокументСсылка.Дата
		);
		
		Результат = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОбОрганизации, "КПП" , Ложь);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

