Функция ПолучитьНомераДляСФ(СчетФактура) Экспорт
	
	Если Метаданные.Имя = "БухгалтерияПредприятияКОРП" Тогда
		
		Результат = ЗаполнитьДанныеДляПечатиШапки(СчетФактура);
		
	Иначе
		
		Результат = ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").ПолучитьНомераДляСФ(СчетФактура);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ДанныеДляПечатиШапкиСФ()
	
	Результат = Новый Структура;
	Результат.Вставить("НомерДокумента", Неопределено);
	Результат.Вставить("ДатаДокумента", Неопределено);
	Результат.Вставить("ЭтоИСФ", Ложь);
	Результат.Вставить("НомерИсправления", Неопределено);
	Результат.Вставить("ДатаИсправления", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьДанныеДляПечатиШапки(СчетФактура)
	
	Результат = Новый_ДанныеДляПечатиШапкиСФ();
	
	ЭтоИсправление = (
		СчетФактура.Метаданные().Реквизиты.Найти("Исправление") <> Неопределено
		И СчетФактура.Исправление
	);
	
	ОбщиеДанныеДляПечати = ПолучитьОбщиеДанныеДляПечатиСФ(СчетФактура);
	
	ДатаСрезаДанных = СчетФактура.Дата;
	
	ИндексПодразделения = ПолучитьИндексОбособленногоПодразделенияНаДату(ОбщиеДанныеДляПечати, ДатаСрезаДанных);
	
	Если ИндексПодразделения <> 0 Тогда
		ОбщиеДанныеДляПечати.Номер = ОбщиеДанныеДляПечати.Номер + "/" + ИндексПодразделения;
	КонецЕсли;
	
	Результат.НомерДокумента = ОбщегоНазначения.ПолучитьНомерНаПечать(ОбщиеДанныеДляПечати);
	Результат.ДатаДокумента = СчетФактура.Дата;
	Результат.ЭтоИСФ = ЭтоИсправление;
	
	Если ЭтоИсправление Тогда
		
		Результат.НомерИсправления = Строка(СчетФактура.НомерИсправления);
		Результат.ДатаИсправления = СчетФактура.Дата;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИндексОбособленногоПодразделенияНаДату(ОбщиеДанныеДляПечати, ДатаСрезаДанных)
	
	Результат = 0;
	
	Если ЗначениеЗаполнено(ОбщиеДанныеДляПечати.Подразделение)
		И ОбщиеДанныеДляПечати.Подразделение.ОбособленноеПодразделение Тогда
		
		Результат = ОбщиеДанныеДляПечати.Подразделение.ЦифровойИндексОбособленногоПодразделения;
		
	ИначеЕсли ОбщегоНазначения.ЭтоОбособленноеПодразделение(ОбщиеДанныеДляПечати.Организация) Тогда
		
		СведенияОбОрганизации = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(
			ОбщиеДанныеДляПечати.Организация,
			ДатаСрезаДанных
		);
		
		Результат = ОбщиеДанныеДляПечати.Организация.ЦифровойИндексОбособленногоПодразделения;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОбщиеДанныеДляПечатиСФ(СчетФактура)
	
	СчетФактураОбъект = СчетФактура.ПолучитьОбъект();
	
	ЭтоКорректировка = (
		СчетФактура.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.Корректировочный
		ИЛИ СчетФактура.ВидСчетаФактуры = Перечисления.ВидСчетаФактурыВыставленного.КорректировочныйНаАванс
	);
	
	Если ЭтоКорректировка Тогда
		Результат = СчетФактураОбъект.ПодготовитьОбщиеДанныеДляПечатиКорректировочногоСчетаФактуры();
	Иначе
		Результат = СчетФактураОбъект.ПодготовитьОбщиеДанныеДляПечатиСчетаФактуры();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ДанныеПередаточногоДокументаДляПечати()
	
	Результат = Новый Структура();
	Результат.Вставить("Номер");
