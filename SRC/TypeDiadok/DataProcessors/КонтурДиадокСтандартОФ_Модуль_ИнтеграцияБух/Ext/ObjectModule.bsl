Процедура ПерезаполнитьСуммыПоУЕвРублях(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки) Экспорт 
	
	Если ДанныеШапки.Свойство("СчетФактура") Тогда
		
		ДанныеШапки.Вставить("ТабличнаяЧасть", ТабличнаяЧасть);
		ПересчетВалюты_УПД(ДанныеШапки.СчетФактура, ТекущееОснование, ДанныеШапки);
		
	ИначеЕсли ТипЗнч(ТекущееОснование) = Тип("ДокументСсылка.АктОбОказанииПроизводственныхУслуг") Тогда 
		
		ПересчетВалюты_АктОбОказанииПроизводственныхУслуг(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки);
		
	ИначеЕсли ТипЗнч(ТекущееОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда 
		
		ПересчетВалюты_ВозвратТоваровПоставщику(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки);
		
	ИначеЕсли ТипЗнч(ТекущееОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда 
		
		ПересчетВалюты_РеализацияТоваровУслуг(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересчетВалюты_АктОбОказанииПроизводственныхУслуг(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки)
	
	//1. Рассчитываем по курсу документа
	Курс		= ЗаполнениеДокументов.КурсДокумента(ТекущееОснование, ПолучитьВалютуРегламентированногоУчета());
	Кратность	= ЗаполнениеДокументов.КратностьДокумента(ТекущееОснование, ПолучитьВалютуРегламентированногоУчета());
	
	ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность);	
	
	//2. Считаем сумму в рублях с учетом аванса и распределяем
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ТекущееОснование);
	Запрос.УстановитьПараметр("СчетУчетаРасчетовСКонтрагентом", ТекущееОснование.СчетУчетаРасчетовСКонтрагентом);
	Текст = 
	"ВЫБРАТЬ
	|	СУММА(Хозрасчетный.Сумма) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Регистратор = &Ссылка
	|	И Хозрасчетный.СчетДт = &СчетУчетаРасчетовСКонтрагентом
	|	И Хозрасчетный.СчетКт В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				АктОбОказанииПроизводственныхУслуг.СчетДоходов
	|			ИЗ
	|				Документ.АктОбОказанииПроизводственныхУслуг.Услуги КАК АктОбОказанииПроизводственныхУслуг
	|			ГДЕ
	|				АктОбОказанииПроизводственныхУслуг.Ссылка = &Ссылка)
	|";
	Запрос.Текст = Текст;
	СуммаВзаиморасчетов = Запрос.Выполнить().Выгрузить()[0].Сумма;
	
	ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаВзаиморасчетов);
	
	ДанныеШапки.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	
КонецПроцедуры	

Процедура ПересчетВалюты_ВозвратТоваровПоставщику(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки)
	
	Курс		= ТекущееОснование.КурсВзаиморасчетов;
	Кратность	= ТекущееОснование.КратностьВзаиморасчетов;
	
	СуммаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	
	Для Каждого ТекСтрокаТЧ Из ТабличнаяЧасть Цикл
		
		ЗначениеСтавкиНДС = УчетНДС.ПолучитьСтавкуНДС(ТекСтрокаТЧ.СтавкаНДС);
		УчитыватьНДС = ЗначениеСтавкиНДС <> 0;
		
		Сумма		= ТекСтрокаТЧ.Сумма * Курс / Кратность;
		СуммаНДС	= Окр(УчетНДС.РассчитатьСуммуНДС(Сумма, УчитыватьНДС, СуммаВключаетНДС, ЗначениеСтавкиНДС), 2);
		
		ТекСтрокаТЧ.Сумма		= Окр(Сумма, 2);
		ТекСтрокаТЧ.СуммаНДС	= Окр(СуммаНДС, 2);
		
	КонецЦикла;
	
	ДанныеШапки.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	
КонецПроцедуры

Процедура ПересчетВалюты_РеализацияТоваровУслуг(ТабличнаяЧасть, ТекущееОснование, ДанныеШапки)
	
	//1. Рассчитываем по курсу документа
	Курс		= ЗаполнениеДокументов.КурсДокумента(ТекущееОснование, ПолучитьВалютуРегламентированногоУчета());
	Кратность	= ЗаполнениеДокументов.КратностьДокумента(ТекущееОснование, ПолучитьВалютуРегламентированногоУчета());
	
	ПересчетВалюты_ПоКурсуДокумента(ТабличнаяЧасть, Курс, Кратность);	
	
	//2. Считаем сумму в рублях с учетом аванса и распределяем
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка"							, ТекущееОснование);
	Запрос.УстановитьПараметр("Содержание"						, "Реализация услуг");
	Запрос.УстановитьПараметр("СчетУчетаРасчетовСКонтрагентом"	, ТекущееОснование.СчетУчетаРасчетовСКонтрагентом);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СУММА(Хозрасчетный.Сумма) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Регистратор = &Ссылка
	|	И Хозрасчетный.СчетДт = &СчетУчетаРасчетовСКонтрагентом
	|	И Хозрасчетный.СчетКт В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				РеализацияТоваровУслугТовары.СчетДоходов
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|			ГДЕ
	|				РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	|		
	|			ОБЪЕДИНИТЬ
	|		
	|			ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				РеализацияТоваровУслугУслуги.СчетДоходов
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|			ГДЕ
	|				РеализацияТоваровУслугУслуги.Ссылка = &Ссылка)
	|	И Хозрасчетный.Содержание = &Содержание
	|
	|ИМЕЮЩИЕ
	|	СУММА(Хозрасчетный.Сумма) ЕСТЬ НЕ NULL ";
	
	Если НЕ ДанныеШапки.Свойство("ЭтоАкт") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Хозрасчетный.Содержание = &Содержание", ""); 
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	СуммаВзаиморасчетов = ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").ПолучитьРезультатЗапроса(Запрос, "Сумма", 0);	
	
	ПересчетВалюты_РаспределениеСуммы(ТабличнаяЧасть, ДанныеШапки, СуммаВзаиморасчетов);
		
	ДанныеШапки.ВалютаДокумента = ПолучитьВалютуРегламентированногоУчета();
	
КонецПроцедуры

