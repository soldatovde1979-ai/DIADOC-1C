КонецПроцедуры

//{ Прослеживаемость

// Возвращает признак применения Федерального Закона 
// который вводит понятие прослеживаемости для определенных групп товаров
// Параметры:
// Дата - тип дата, в данном параметре передается
//        дата на которую необходимо определить признак применения ФЗ
// Возвращаемое значение:
//  Булево - признак применения
//           Истина - ФЗ применяется
//           Ложь   - ФЗ не применяется
Функция ИспользуетсяУчетПрослеживаемыхТоваров(Дата) Экспорт
		
	Результат = Ложь;
	
	ЕстьПрослеживаемостьВКонфигурации = КонфигурацияСПрослеживаемостью();
	Если ЕстьПрослеживаемостьВКонфигурации Тогда
		
		Если ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		
			ДатаНачалаУчета = ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров();
			Если Дата > ДатаНачалаУчета Тогда
				Результат = Истина;
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции 

Функция КонфигурацияСПрослеживаемостью()

	Результат = ОсновнойМодуль.СуществуетОбъектМетаданных("Константа.ВестиУчетПрослеживаемыхТоваров")
	            И ОсновнойМодуль.СуществуетОбъектМетаданных("Константа.ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров")
				И ОсновнойМодуль.СуществуетОбъектМетаданных("ФункциональнаяОпция.ВестиУчетПрослеживаемыхТоваров");
	
	Возврат Результат;

КонецФункции

Функция ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров()
	
	Результат = Константы.ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров.Получить();
	
	Возврат Результат;
	
КонецФункции

// Заполняет колонки "ДанныеПрослеживаемости" и "ПрослеживаемыйТовар" в строках таблицы товаров
// если колонок нет, то они добавляются
// Параметры:
// ТаблицаТоваров - ТаблицаЗначений - в данном параметре передается
// СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг,
//					 ДокументСсылка.КорректировкаРеализации - владелец таблицы товаров
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправки(ТаблицаТоваров, СсылкаНаОбъект) Экспорт
	
	Если ИспользуетсяУчетПрослеживаемыхТоваров(СсылкаНаОбъект.Дата) Тогда
		
		Если ТаблицаТоваров.Колонки.Найти("ДанныеПрослеживаемости") = Неопределено Тогда
			ТаблицаТоваров.Колонки.Добавить("ДанныеПрослеживаемости");
		КонецЕсли;
		
		Если ТаблицаТоваров.Колонки.Найти("ПрослеживаемыйТовар") = Неопределено Тогда
			ТаблицаТоваров.Колонки.Добавить("ПрослеживаемыйТовар");
		КонецЕсли;
		
		Если ЭтоРТУ_ДД(СсылкаНаОбъект)
			ИЛИ ЭтоКорректировкаИсправление(СсылкаНаОбъект) Тогда
			
			ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоРеализации(ТаблицаТоваров, СсылкаНаОбъект);
			
		ИначеЕсли ЭтоКорректировкаРеализации(СсылкаНаОбъект) Тогда
			
			ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(ТаблицаТоваров, СсылкаНаОбъект);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет колонки "ДанныеПрослеживаемости" и "ПрослеживаемыйТовар" в строках таблицы товаров
// если колонок нет, то они добавляются
// Параметры:
// ТаблицаТоваров - ТаблицаЗначений - в данном параметре передается
// СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг,
//					 ДокументСсылка.КорректировкаРеализации - владелец таблицы товаров
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоРеализации(ТаблицаТоваров, СсылкаНаОбъект)
	
	СтрокиТоваров			 = ТаблицаТоваров.НайтиСтроки(Новый Структура("ЭтоУслуга", Ложь)); 
	ИдентификаторыСтрок		 = ОсновнойМодуль.ВыгрузитьКолонку(СтрокиТоваров, "ИдентификаторСтроки");
	ОсновнойМодуль.УдалитьВсеВхожденияЗначенияИзМассива(ИдентификаторыСтрок, Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяЕИ"				 , Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Ссылка"					 , СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИдентификаторыСтрок"		 , ИдентификаторыСтрок);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.РНПТ КАК РНПТ,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТТаблицаТоваров
	|ИЗ
	|	&ИмяМетаданныхТаблицыТоваров КАК ТаблицаТоваров
	|ГДЕ
	|	ТаблицаТоваров.Ссылка = &Ссылка
	|	И ТаблицаТоваров.НомерСтроки В(&ИдентификаторыСтрок)
	|	И ТаблицаТоваров.РНПТ <> ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(НомераГТД.Код, """") КАК НомерГТДРегистрационныйНомер,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК ЕдиницаИзмеренияПрослеживаемости,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК КодЕдиницыИзмеренияПрослеживаемости,
	|	ТаблицаТоваров.Количество КАК КоличествоПоРНПТ,
	|	ТаблицаТоваров.НомерСтроки КАК ИдентификаторСтроки
	|ИЗ
	|	ВТТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО (ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура).БазоваяЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|		ПО ТаблицаТоваров.РНПТ = НомераГТД.Ссылка";
	
	ИмяДокумента = СсылкаНаОбъект.Метаданные().Имя;
	ИмяМетаданныхТаблицыТоваров = СтрЗаменить("Документ.%ИмяДокумента%.Товары", "%ИмяДокумента%", ИмяДокумента);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяМетаданныхТаблицыТоваров" , ИмяМетаданныхТаблицыТоваров);
	
	СведенияПрослеживаемости = Запрос.Выполнить().Выгрузить();
	СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
	
	Для Каждого СтрокаТЧ Из СтрокиТоваров Цикл
		
		СтрокиПрослеживаемости = СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТЧ.ИдентификаторСтроки));
		
		Если СтрокиПрослеживаемости.Количество() > 0 Тогда
		
			СтрокаТЧ.ДанныеПрослеживаемости	 = Новый Массив;
			СтрокаТЧ.ПрослеживаемыйТовар	 = Истина;
			
			Для каждого СтрокаПрослеживаемости Из СтрокиПрослеживаемости Цикл
				
				ЭлементПрослеживаемости = ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").НовыеСвойстваЭлементаПрослеживаемости();
				ЗаполнитьЗначенияСвойств(ЭлементПрослеживаемости, СтрокаПрослеживаемости);
				СтрокаТЧ.ДанныеПрослеживаемости.Добавить(ЭлементПрослеживаемости);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет колонки "ДанныеПрослеживаемости" и "ПрослеживаемыйТовар" в строках таблицы товаров
// 
// Параметры:
// ТаблицаТоваров - ТаблицаЗначений - в данном параметре передается
// СсылкаНаОбъект - ДокументСсылка.КорректировкаРеализации - владелец таблицы товаров
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(ТаблицаТоваров, СсылкаНаОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.РНПТ КАК РНПТ,
	|	СУММА(ТаблицаДокумента.Количество) КАК Количество,
	|	СУММА(ТаблицаДокумента.Количество) КАК КоличествоПрослеживаемости,
	|	ТаблицаДокумента.НомерСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.Ссылка = &Ссылка
	|	И ТаблицаДокумента.НомерСтроки В(&ИдентификаторыСтрок)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.РНПТ,
	|	ТаблицаДокумента.Ссылка,
	|	ТаблицаДокумента.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокументаДоИзменения.Ссылка КАК Ссылка,
	|	ТаблицаДокументаДоИзменения.РНПТДо КАК РНПТ,
	|	СУММА(ТаблицаДокументаДоИзменения.КоличествоДоКорректировки) КАК Количество,
	|	СУММА(ТаблицаДокументаДоИзменения.КоличествоДоКорректировки) КАК КоличествоПрослеживаемости,
	|	ТаблицаДокументаДоИзменения.НомерСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ДанныеОснований
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК ТаблицаДокументаДоИзменения
	|ГДЕ
	|	ТаблицаДокументаДоИзменения.Ссылка = &Ссылка
	|	И ТаблицаДокументаДоИзменения.НомерСтроки В(&ИдентификаторыСтрок)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокументаДоИзменения.Ссылка,
	|	ТаблицаДокументаДоИзменения.РНПТДо,
	|	ТаблицаДокументаДоИзменения.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ТаблицаДокумента.РНПТ, ДанныеОснований.РНПТ) КАК НомерГТДРегистрационныйНомер,
	|	ЕСТЬNULL(ТаблицаДокумента.Количество, 0) КАК КоличествоПослеИзменения,
	|	ЕСТЬNULL(ДанныеОснований.Количество, 0) КАК КоличествоДоИзменения,
	|	ЕСТЬNULL(ТаблицаДокумента.ИдентификаторСтроки, ДанныеОснований.ИдентификаторСтроки) КАК ИдентификаторСтроки
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеОснований КАК ДанныеОснований
	|		ПО ТаблицаДокумента.РНПТ = ДанныеОснований.РНПТ
	|			И ТаблицаДокумента.Ссылка = ДанныеОснований.Ссылка
	|			И ТаблицаДокумента.ИдентификаторСтроки = ДанныеОснований.ИдентификаторСтроки
	|ГДЕ
	|	ЕСТЬNULL(ТаблицаДокумента.РНПТ, ДанныеОснований.РНПТ) <> &ПустойРНПТ
	|ИТОГИ
	|	СУММА(КоличествоПослеИзменения),
	|	СУММА(КоличествоДоИзменения)
	|ПО
	|	ИдентификаторСтроки,
	|	НомерГТДРегистрационныйНомер";

	СтрокиТоваров			 = ТаблицаТоваров.НайтиСтроки(Новый Структура("ЭтоУслуга", Ложь)); 
	ИдентификаторыСтрок		 = ОсновнойМодуль.ВыгрузитьКолонку(СтрокиТоваров, "ИдентификаторСтроки");
	Запрос.УстановитьПараметр("Ссылка"				 , СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ИдентификаторыСтрок"	 , ИдентификаторыСтрок);
	Запрос.УстановитьПараметр("ДокументОснование"	 , СсылкаНаОбъект.ДокументРеализации);
	Запрос.УстановитьПараметр("ПустойРНПТ"			 , Справочники.НомераГТД.ПустаяСсылка());

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИдентификаторСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИдентификаторСтроки.Следующий() Цикл
		
		СтрокаТовара = ТаблицаТоваров.Найти(ВыборкаИдентификаторСтроки.ИдентификаторСтроки, "ИдентификаторСтроки");
		
		Если СтрокаТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовара.ДанныеПрослеживаемости		 = Новый Массив;
		СтрокаТовара.ПрослеживаемыйТовар		 = Истина;
		
		ВыборкаРегистрационныйНомер = ВыборкаИдентификаторСтроки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаРегистрационныйНомер.Следующий() Цикл

			СтрокаПрослеживаемости =  ПолучитьМодульПрог("Модуль_ИнтеграцияУниверсальнаяЛогика").НовыеСвойстваЭлементаПрослеживаемостиПоКорректировке();
			ЗаполнитьЗначенияСвойств(СтрокаПрослеживаемости, ВыборкаРегистрационныйНомер);
			СтрокаПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости = СтрокаТовара.КодЕдиницыИзмерения;
			
			ЭтоУменьшение = СтрокаПрослеживаемости.КоличествоДоИзменения > СтрокаПрослеживаемости.КоличествоПослеИзменения; 
			Если ЭтоУменьшение Тогда
				КоличествоУменьшение = СтрокаПрослеживаемости.КоличествоДоИзменения - СтрокаПрослеживаемости.КоличествоПослеИзменения;
				СтрокаПрослеживаемости.КоличествоУменьшение = КоличествоУменьшение;
			КонецЕсли; 
			
			ЭтоУвеличение = СтрокаПрослеживаемости.КоличествоПослеИзменения > СтрокаПрослеживаемости.КоличествоДоИзменения;
			Если ЭтоУвеличение Тогда
				КоличествоУвеличение = СтрокаПрослеживаемости.КоличествоПослеИзменения - СтрокаПрослеживаемости.КоличествоДоИзменения;
				СтрокаПрослеживаемости.КоличествоУвеличение = КоличествоУвеличение;
			КонецЕсли; 
			
			СтрокаТовара.ДанныеПрослеживаемости.Добавить(СтрокаПрослеживаемости);
			
		КонецЦикла;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ДополнитьСтрокуТовараДаннымиПрослеживаемости(СтрокаТовара, ДанныеСтроки, ЭтоУКД = Ложь)
	
	СведенияПрослеживаемости = ДанныеСтроки.СведенияПрослеживаемости;
	
	НеТребуетсяЗаполнение = (СведенияПрослеживаемости = Неопределено
							Или СведенияПрослеживаемости.Количество() <> 1);
	
	Если НеТребуетсяЗаполнение Тогда
		
		Если ЭтоУКД Тогда
			СтрокаТовара.РНПТ = Неопределено;
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПрослеживаемости Из СведенияПрослеживаемости Цикл
		НомерТовара = СтрокаПрослеживаемости.НомТовПрослеж;
		СтрокаТовара.РНПТ = НайтиСоздатьРНПТ(НомерТовара);
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСоздатьРНПТ(РегистрационныйНомер)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(РегистрационныйНомер) Тогда
		
		Результат = НайтиСсылкуНаОбъектПоРеквизиту(Метаданные.Справочники.НомераГТД, "РегистрационныйНомер", РегистрационныйНомер);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = НайтиСсылкуНаОбъектПоРеквизиту(Метаданные.Справочники.НомераГТД, "Код", РегистрационныйНомер);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			НовыйРНПТ = Справочники.НомераГТД.СоздатьЭлемент();
			НовыйРНПТ.Код = РегистрационныйНомер;
			НовыйРНПТ.РегистрационныйНомер = РегистрационныйНомер;
			НовыйРНПТ.Записать();
			Результат = НовыйРНПТ.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции


