Функция ПроверитьЧтоДокументУжеПодписан(ДокументДД)
		
	Результат = Ложь;
	
	//Если пакет документов уже подписан ранее, например, не из модуля.
    Если СтандартныйПакет().НайтиПоЗначению(НРег(ДокументДД.ТипДокумента)) <> Неопределено 
        И (ДокументДД.Статус = "Подписан" ИЛИ ДокументДД.Статус = "Аннулирован") Тогда
        Возврат Истина;
    КонецЕсли;
	
