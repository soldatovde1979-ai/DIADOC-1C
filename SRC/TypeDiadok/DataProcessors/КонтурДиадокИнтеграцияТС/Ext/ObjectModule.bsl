КонецПроцедуры

Функция ПропуститьДействиеПоДокументу(ТекстОшибки, ДокументДД)

	//Если обнаружены следующие ошибки, документ необходимо игнорировать, не нужно отказывать\подписывать	
	Если Найти(ТекстОшибки, "Неверно сопоставлен головной контрагент") = 0
		И Найти(ТекстОшибки, "Не сопоставлен контрагент") = 0
		И Найти(ТекстОшибки, "Неверный КПП поставщика") = 0
		И Найти(ТекстОшибки, "Документ подписан") = 0
		И Найти(ТекстОшибки, "В документе не указан номер акта приемки") = 0 Тогда
		Результат = Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	//Документ ждет 7 дней, если не найдено ПТУ по номеру акта приемки
	Если Найти(ТекстОшибки, "Не найдено поступление с номером акта приемки") > 0 Тогда
		ТекущееЧислоДнейОжидания = (НачалоДня(ТекущаяДата()) - НачалоДня(ДокументДД.ДатаЗагрузки)) / (60 * 60 * 24);
		Если ТекущееЧислоДнейОжидания < 7 Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьКонтентОтвета(ДокументДД, Content, МассивОшибок, Документ1С)
		
	СтруктураДляКонтента	= СтруктураМетаданныхДляКонтента();
	СтруктураПТУ			= СтруктураМетаданныхПоступление();
	СтруктураКорректировки 	= СтруктураМетаданныхКорректировки();
	СтруктураСпр			= СтруктураМетаданныхСправочники();
	
	//КОНТЕНТ ТИТУЛА ПОКУПАТЕЛЯ 155 И 820 ПРИКАЗА
	Если НРег(Content.Тип().Имя) = "utdbuyercontent" ИЛИ НРег(Content.Тип().Имя) = "utd820buyercontent" Тогда
		
		Если ДокументДД.ТипДокумента <> "UniversalCorrectionDocument" Тогда
			ЗаполнитьEmployee(Content, СтруктураДляКонтента, СтруктураПТУ, Документ1С);			
		КонецЕсли;
		
		СтрокаКПП = ?(ЗначениеЗаполнено(Документ1С[СтруктураПТУ.Организация][СтруктураСпр.КПП]), "-"
					+ Документ1С[СтруктураПТУ.Организация][СтруктураСпр.КПП], "");
		
		ИмяСвойстваCreator =?(НРег(Content.Тип().Имя) = "utd820buyercontent", "DocumentCreator", "Creator");		
		Content[ИмяСвойстваCreator] = Документ1С[СтруктураПТУ.Организация][СтруктураСпр.НаимПолное] + ", " 
			+ Документ1С[СтруктураПТУ.Организация][СтруктураСпр.ИНН] + СтрокаКПП;
		
		Content.AcceptanceDate		= Документ1С[СтруктураПТУ.Дата];
		
		//Номер_акта из ПТУ или номер документа "КорректировкаПоступления"
		Если ТипЗнч(Документ1С) = Тип("ДокументСсылка." + СтруктураПТУ.ИмяДокумента) Тогда
			Content.OperationContent = "Акт приема-передачи №" + Документ1С[СтруктураПТУ.НомерАктаПриемки];
		ИначеЕсли ТипЗнч(Документ1С) = Тип("ДокументСсылка."+СтруктураКорректировки.ИмяДокумента) Тогда
			Content.OperationContent = "Акт приема-передачи №" + Документ1С[СтруктураКорректировки.Номер];
		КонецЕсли;	
		
	//КОНТЕНТ ПРИ ОТКАЗЕ В ПОДПИСИ	
	ИначеЕсли НРег(Content.Тип().Имя) = "correctionrequestcontent"  // запрос на уточнение по СФ
		Или НРег(Content.Тип().Имя) = "formalizedrejectioncontent"  // отказ по формализованному
		Или НРег(Content.Тип().Имя) = "rejectioncontent" Тогда  // отказ по неформализованному
		
		ИтоговыйТекстОшибки = "";
		Для Каждого Ошибка Из МассивОшибок Цикл
			ИтоговыйТекстОшибки = ИтоговыйТекстОшибки + Ошибка + Символы.ПС;
		КонецЦикла;
		Content.Comment = ИтоговыйТекстОшибки;
		
	КонецЕсли;	
	
	Возврат Content;
	
КонецФункции

Процедура ЗаполнитьEmployee(Content, СтруктураДляКонтента, СтруктураПТУ, Документ1С)
	
	ЗаполнятьИзОтветственных = Истина;			
	Если ЗначениеЗаполнено(СтруктураДляКонтента.ФИОГрузПринял) Тогда
		
		ФИО = ОсновнойМодуль.ЭДО_Служебные_РазложитьСтрокуВМассивСлов(Документ1С[СтруктураДляКонтента.ФИОГрузПринял], " ");
		Если ФИО.Количество() > 2 Тогда
			Content.Employee.Surname			= ФИО[0];
			Content.Employee.FirstName			= ФИО[1];
			Content.Employee.Patronymic			= ФИО[2];
			Content.Employee.EmployeePosition	= Документ1С[СтруктураДляКонтента.ДолжностьГрузПринял];
			
			ЗаполнятьИзОтветственных = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаполнятьИзОтветственных Тогда	
		//если нет ФИО в документе - заполняем из ответственных лиц организации
		НаборРеквизитов = Новый Структура;
		НаборРеквизитов.Вставить("ФИО");
		НаборРеквизитов.Вставить("Должность");		
		
		
		//Если Документ1С[СтруктураПТУ.Организация][СтруктураМетаданныхСправочники().ЮрФизЛицо] <> СтруктураРегистры.ФизическоеЛицо Тогда		
		///		Реквизиты = ЗаполнитьРеквизитыПодписантаПоСкладу1С(НаборРеквизитов, Документ1С[СтруктураПТУ.Склад]);
		//Иначе
	
	
		Реквизиты = ЗаполнитьРеквизитыПодписантаПоОрганизации1С(НаборРеквизитов, Документ1С[СтруктураПТУ.Организация]);			
		//КонецЕсли;
			
		ФИО = ОсновнойМодуль.ЭДО_Служебные_РазложитьСтрокуВМассивСлов(Реквизиты.ФИО, " ");			
		
		Если ФИО.Количество() > 2 Тогда
			Content.Employee.Surname			= ФИО[0];
			Content.Employee.FirstName			= ФИО[1];
			Content.Employee.Patronymic			= ФИО[2];
			Content.Employee.EmployeePosition	= Реквизиты.Должность;
		Иначе
			ВызватьИсключение "Неверные ФИО в справочнике ""Ответственные лица организаций"" для " + Документ1С[СтруктураПТУ.Организация];
		КонецЕсли;
		
	КонецЕсли;
	Content.Employee.EmployeeBase = "Должностные обязанности";
	
КонецПроцедуры

Функция ЗаполнитьРеквизитыПодписантаПоОрганизации1С(Реквизиты, Организация)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ОтветственныеЛицаОрганизаций.ФизическоеЛицо.Наименование КАК ФИО,
	               |	ОтветственныеЛицаОрганизаций.Должность.Представление КАК Должность
	               |ИЗ
	               |	РегистрСведений.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	               |ГДЕ
	               |	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = &Руководитель
	               |	И ОтветственныеЛицаОрганизаций.СтруктурнаяЕдиница = &Организация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОтветственныеЛицаОрганизаций.Период УБЫВ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОтветственныеЛицаОрганизаций", СтруктураМетаданныхРегистрыПеречисления().ОтветственныеЛица); 
	Запрос.Текст = ТекстЗапроса;                                             
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Руководитель", СтруктураМетаданныхРегистрыПеречисления().Руководитель);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Для каждого Значение Из Выборка Цикл
		ЗаполнитьЗначенияСвойств(Реквизиты, Значение);
	КонецЦикла;
	
	Возврат Реквизиты;
	
КонецФункции	

Функция ПолучитьДатуУчетаСФ(ДатаПоставки, ДатаСФ, ДатаПолученияСФ, ОрганизацияСсылка)
	
	//дата учета вычилсяется по закрытому периоду
	НомерДняЗакрытияПериода = СтруктураЗначениеПеременных().КоличествоДнейОтсрочки;
	
	Если НЕ ЗначениеЗаполнено(ДатаПолученияСФ) = Истина Тогда 
		Возврат ТекущаяДата(); //Если вдруг нет даты получения, учитываем по текущей
	КонецЕсли;
	
	ДатаЗакрытияМесяцаПоставки		= КонецМесяца(ДатаПоставки)		+ НомерДняЗакрытияПериода * 24 * 60 * 60; 
	ДатаЗакрытияМесяцаПолучения		= КонецМесяца(ДатаПолученияСФ)	+ НомерДняЗакрытияПериода * 24 * 60 * 60;
	ДатаЗакрытияКварталаПоставки	= КонецКвартала(ДатаПоставки)	+ НомерДняЗакрытияПериода * 24 * 60 * 60;
	
	МесяцПоставкиОткрыт		= ?(НачалоДня(ТекущаяДата()) < НачалоДня(ДатаЗакрытияМесяцаПоставки), Истина, Ложь);
	МесяцПолученияОткрыт	= ?(НачалоДня(ТекущаяДата()) < НачалоДня(ДатаЗакрытияМесяцаПолучения), Истина, Ложь);
	КварталПоставкиОткрыт	= ?(НачалоДня(ТекущаяДата()) < НачалоДня(ДатаЗакрытияКварталаПоставки), Истина, Ложь);
	
	Если (ДатаПоставки <> Неопределено) И (ДатаСФ >= '20150101') И МесяцПоставкиОткрыт Тогда		
		Возврат  ДатаПоставки;
	ИначеЕсли КварталПоставкиОткрыт и (ТекущаяДата() > КонецКвартала(ДатаПоставки)) Тогда 
		Возврат КонецКвартала(ДатаПоставки);
	ИначеЕсли МесяцПолученияОткрыт Тогда  
		Возврат ДатаПолученияСФ;
	Иначе 
		Возврат ТекущаяДата();
	КонецЕсли;
	
КонецФункции

