		//Иначе
			СтруктураПеременные.Вставить("ОтклонениеСуммыСНДС",	Число(Параметр.РитейлМаксимальноеОтклонениеСуммыСНДС));
		КонецЕсли; 
		
	КонецЕсли; 	

	Возврат СтруктураПеременные;

