Функция ПроверитьУчет(ДокументДД, КонтентДокумента, Документ1С)
		
	Результат = Новый Массив;
	
	ТипыДокументов = Новый Массив;
	
	Если ДокументДД.ТипДокумента = "UniversalTransferDocument" Тогда
		ТипыДокументов.Добавить("UniversalTransferDocument");
		ТипыДокументов.Добавить("UniversalTransferDocumentRevision");
	ИначеЕсли ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда
		ТипыДокументов.Добавить("UniversalTransferDocument");
		ТипыДокументов.Добавить("UniversalTransferDocumentRevision");
	ИначеЕсли ДокументДД.ТипДокумента = "UniversalCorrectionDocument" Тогда
		ТипыДокументов.Добавить("UniversalCorrectionDocument");		
	КонецЕсли;
	
	Статусы  = Новый Массив;
	Статусы.Добавить("Подписан");
	Статусы.Добавить("Требуется подпись");
	Статусы.Добавить("Исправлен");
	Статусы.Добавить("Откорректирован");
	
	// 1. Ищем УПД\УКД\ИУПД, относящийся к другому (не к текущему) пакету, 
	//    и находящийся в статусе "Требуется подпись" или "Подписан".
	//    Если такой есть, будем будем по нему отказывать.	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Диадок_Документы.Ссылка,
	|	Диадок_Документы.АнализПроведен КАК АнализПроведен,
	|	Диадок_Документы.ТекстОшибки КАК ОшибкиПроверкиТекст
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ДопРеквизиты1
	|		ПО (ДопРеквизиты1.Ссылка = Диадок_Документы.Ссылка)
	|ГДЕ
	|	(ДопРеквизиты1.Значение = ИСТИНА
	|			ИЛИ Диадок_Документы.АнализПроведен = ИСТИНА)
	|	И (ВЫРАЗИТЬ(Диадок_Документы.ТекстОшибки КАК СТРОКА(1024))) = """"
	|	И Диадок_Документы.Ссылка <> &ТекущийДокументДД
	|	И Диадок_Документы.Документ = &Документ1С
	|	И Диадок_Документы.Направление = &Направление
	|	И Диадок_Документы.ТипДокумента В(&ТипДокумента)
	|	И Диадок_Документы.Статус В(&Статусы)
	|	И Диадок_Документы.LetterId <> &LetterId
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диадок_Документы.ДатаЗагрузки";
	
	Запрос.УстановитьПараметр("ТекущийДокументДД",	ДокументДД);
	Запрос.УстановитьПараметр("Документ1С",			Документ1С);
	Запрос.УстановитьПараметр("ТипДокумента",		ТипыДокументов);
	Запрос.УстановитьПараметр("Направление",		"Входящее");
	Запрос.УстановитьПараметр("Статусы",			Статусы);
	Если ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда
		УсловиеПакет = "И Диадок_Документы.LetterId <> &LetterId";
        Запрос.Текст = СтрЗаменить(Запрос.Текст, УсловиеПакет, "И Диадок_Документы.PacketId = &PacketId");
		Запрос.УстановитьПараметр("PacketId", ДокументДД.PacketId);
	Иначе
		Запрос.УстановитьПараметр("LetterId", ДокументДД.LetterId);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выгрузить();
	Если Выборка.Количество() > 0 И ЗначениеЗаполнено(Выборка[0].Ссылка) Тогда
		Док = Выборка[0].Ссылка;
		Результат.Добавить("Данный документ уже был учтен в электронном виде (дата " + формат(Док.ДатаДокумента, "ДФ=dd.MM.yyyy")
		+ ", номер " + Док.НомерДокумента + ", загружен из Диадок " + Док.ДатаЗагрузки + ")");
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ПроверитьОрганизацию(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат		= Новый Массив;
	СтруктураПТУ	= СтруктураМетаданныхПоступление();
	СтруктураСпр	= СтруктураМетаданныхСправочники();
	
	// 1. Подразделение + Организация - совпадает ли юр.лицо в документе и 1С
	Если ДокументДД.ОрганизацияДиадок.СвязанныйСправочник1 <> Документ1С[СтруктураПТУ.Организация] Тогда
		Если ДокументДД.ОрганизацияДиадок.СвязанныйСправочник1 <> Документ1С[СтруктураПТУ.Организация][СтруктураСпр.ГоловнаяОрганизация] Тогда
			Результат.Добавить("Разные организации документа 1С и Диадока");
		КонецЕсли;
	КонецЕсли;
	
	// 2. Организация в документе 1С - ИНН и КПП
	ИНН = Документ1С[СтруктураПТУ.Организация][СтруктураСпр.ИНН];
	КПП = Документ1С[СтруктураПТУ.Организация][СтруктураСпр.КПП];
	
	//Получить ИНН и КПП из контента для 820\155 формата
	Если КонтентДокумента.Свойства().Получить("Buyer") <> Неопределено Тогда
		ИННизКонтента = КонтентДокумента.Buyer.Inn;
		КППизКонтента = КонтентДокумента.Buyer.Kpp;
	ИначеЕсли КонтентДокумента.Свойства().Получить("Buyers") <> Неопределено Тогда
		ИННизКонтента = КонтентДокумента.Buyers[0].Inn;
		КППизКонтента = КонтентДокумента.Buyers[0].Kpp;
	КонецЕсли;
	
	//Проверка ИНН
	Если СокрЛП(ИНН) <> ИННизКонтента Тогда
		Результат.Добавить("Неверный ИНН у покупателя. Ожидаемое значение: " + ИНН);
	КонецЕсли;	
	
	//{КМЕ, 2019-07-29, Проверка КПП, если нужна	
	Если Документ1С[СтруктураПТУ.Организация][СтруктураСпр.ЮрФизЛицо] <> СтруктураМетаданныхРегистрыПеречисления().ФизическоеЛицо Тогда // Для ИП не проверяем КПП
		Если СокрЛП(КПП) <> КППизКонтента Тогда 
			Результат.Добавить("Неверный КПП у покупателя. Ожидаемое значение: " + КПП);
		КонецЕсли;
	КонецЕсли;

	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьКонтрагента(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат		= Новый Массив;
	СтруктураПТУ	= СтруктураМетаданныхПоступление();
	СтруктураСпр	= СтруктураМетаданныхСправочники();
	КонтрагентДД	= ДокументДД.КонтрагентДиадок.СвязанныйСправочник1;
	
	// 1. Подразделение + Организация - совпадает ли юр.лицо в документе и 1С	
	Если ЗначениеЗаполнено(КонтрагентДД) И КонтрагентДД <> Документ1С[СтруктураПТУ.Контрагент] Тогда
		//проверка с учетом обособки поставщика
		Если НЕ Документ1С[СтруктураПТУ.Контрагент][СтруктураСпр.ОбособленноеПодразделение] Тогда 
			Результат.Добавить("Разные контрагенты документа 1С и Диадока");
		ИначеЕсли КонтрагентДД <> Документ1С[СтруктураПТУ.Контрагент][СтруктураСпр.ГоловнойКонтрагент] Тогда
			Результат.Добавить("Неверно сопоставлен головной контрагент");		   
		КонецЕсли;	   
	КонецЕсли;
	
	// 2. Организация в документе 1С - ИНН и КПП
	ИНН = Документ1С[СтруктураПТУ.Контрагент][СтруктураСпр.ИНН];
	КПП = Документ1С[СтруктураПТУ.Контрагент][СтруктураСпр.КПП];
	
	//Получить ИНН и КПП Seller из контента для 820\155 формата
	Если КонтентДокумента.Свойства().Получить("Seller") <> Неопределено Тогда
		ИННизКонтента = КонтентДокумента.Seller.Inn;
		КППизКонтента = КонтентДокумента.Seller.Kpp;
	ИначеЕсли КонтентДокумента.Свойства().Получить("Sellers") <> Неопределено Тогда
		ИННизКонтента = КонтентДокумента.Sellers[0].Inn;
		КППизКонтента = КонтентДокумента.Sellers[0].Kpp;
	КонецЕсли;
	
	Если СокрЛП(ИНН) <> ИННизКонтента Тогда
		Результат.Добавить("Неверный ИНН поставщика. Ожидаемое значение: " + ИНН);  
	КонецЕсли;	
	
	Если НЕ КппСоответствуетКонтрагентуИлиФилиалу(Документ1С[СтруктураПТУ.Контрагент], КППизКонтента, КПП) Тогда  // КПП может не быть
		Результат.Добавить("Неверный КПП поставщика. Ожидаемое значение: " + КПП);
		// немного странный результат и проверка
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьВалюту(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат = Новый Массив;
	
	Если (ДокументДД.ТипДокумента = "UniversalTransferDocument" 
		ИЛИ ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision"
		ИЛИ ДокументДД.ТипДокумента = "UniversalCorrectionDocument") И КонтентДокумента.Currency <> "643" Тогда 
		Результат.Добавить("Неверно заполнено поле ""код валюты"". Ожидаемое значение: 643");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьИПшника(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат = Новый Массив;
	
	//Получить объект Seller из контента для 820\155 формата
	Если КонтентДокумента.Свойства().Получить("Seller") <> Неопределено Тогда
		Seller = КонтентДокумента.Seller;
	ИначеЕсли КонтентДокумента.Свойства().Получить("Sellers") <> Неопределено Тогда
		Seller = КонтентДокумента.Sellers[0];
	КонецЕсли;
	
	//Проверка заполненности СвГосРегИП
	Если Seller.Type = "IndividualEntity" И
		(ДокументДД.ТипДокумента = "UniversalTransferDocument" 
		ИЛИ ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision"
		ИЛИ ДокументДД.ТипДокумента = "UniversalCorrectionDocument") Тогда
		
		Если НЕ ЗначениеЗаполнено(Seller.IndividualEntityRegistrationCertificate) Тогда
			Результат.Добавить("Не заполнено поле ""Свидетельство о регистрации Индивидуального Предпринимателя""");	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДатуУПД(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат	= Новый Массив;
	ДатаУПД		= Документ1С[СтруктураМетаданныхПоступление().Дата];
	ФункцияУПД	= КонтентДокумента.Function;
	
	ДатаИзКонтента =?(КонтентДокумента.Свойства().Получить("DocumentDate") = Неопределено, КонтентДокумента.Date, КонтентДокумента.DocumentDate);
	
	//Для УПД с функциями СЧФДОП или ДОП определяющим фактором является дата накладной 
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "ДОП"  Тогда 	
		
		Если ДокументДД.ТипДокумента = "UniversalTransferDocument"
			И НачалоДня(ДокументДД.ДатаДокумента) > НачалоДня(ДатаУПД) Тогда
			
			Результат.Добавить("Дата электронного документа больше даты фактического получения груза (" + Формат(ДатаУПД, "ДФ=dd.MM.yyyy") + ")");
			
		ИначеЕсли ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision"
			И НачалоДня(ДатаИзКонтента) > НачалоДня(ДатаУПД) Тогда
			
			Результат.Добавить("Дата электронного документа больше даты фактического получения груза (" + Формат(ДатаУПД, "ДФ=dd.MM.yyyy") + ")");
		КонецЕсли;
		
	ИначеЕсли ФункцияУПД = "СЧФ" Тогда
		//Здесь должен быть другой алгоритм проверки
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьФункциюУПД(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат = Новый Массив;
		
	Если ДокументДД.ТипДокумента = "UniversalTransferDocument" ИЛИ ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда
		
		СтруктураПТУ 	= СтруктураМетаданныхПоступление(); 
		ТоварыСуммаНДС	= Документ1С[СтруктураПТУ.Товары].Итог(СтруктураПТУ.СуммаНДС);
		УслугиСуммаНДС	= Документ1С[СтруктураПТУ.Услуги].Итог(СтруктураПТУ.СуммаНДС);
		
		СтруктураРегистры = СтруктураМетаданныхРегистрыПеречисления();				
		КонтрагентЮрЛицо = Документ1С[СтруктураПТУ.Контрагент][СтруктураМетаданныхСправочники().ЮрФизЛицо] <> СтруктураРегистры.ФизическоеЛицо;		
		КонтрагентПлательщикНДС = (ТоварыСуммаНДС + УслугиСуммаНДС > 0);
		
		Если НЕ КонтрагентПлательщикНДС И КонтентДокумента.Function <> "ДОП" Тогда
			Результат.Добавить("Неверная функция УПД. Ожидается УПД.ДОП"); 	
		ИначеЕсли КонтрагентПлательщикНДС И КонтентДокумента.Function <> "СЧФДОП" Тогда
			Результат.Добавить("Неверная функция УПД. Ожидается УПД.СЧФДОП"); 	
		КонецЕсли;
		
		//Проверка наличия 820 формата после 01.01.2020
		ДатаИзКонтента =?(КонтентДокумента.Свойства().Получить("DocumentDate") = Неопределено, КонтентДокумента.Date, КонтентДокумента.DocumentDate);
		Если ДатаИзКонтента > НачалоДня(Дата(2020, 01, 01)) И КонтентДокумента.Свойства().Получить("Buyers") = Неопределено Тогда
			Результат.Добавить("После 01.01.2020 ожидается формат УПД согласну приказу ФНС №820");
		КонецЕсли;		
		
		
	ИначеЕсли ДокументДД.ТипДокумента = "UniversalCorrectionDocument" Тогда
		
		Если НЕ КонтрагентПлательщикНДС И КонтентДокумента.Function <> "ДИС" Тогда
			Результат.Добавить("Неверная функция УКД. Ожидается УКД.ДИС"); 	
		ИначеЕсли КонтрагентПлательщикНДС И КонтентДокумента.Function <> "КСЧФДИС" Тогда
			Результат.Добавить("Неверная функция УКД. Ожидается УКД.КСЧФДИС"); 	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;		
	
КонецФункции

Функция ПроверитьСуммыУПД(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат					= Новый Массив;
	СуммаТары 					= Документ1С[СтруктураМетаданныхПоступление().ВозвратнаяТара].Итог("Сумма");
	СуммаДокумента1С			= Документ1С[СтруктураМетаданныхПоступление().СуммаДокумента] + СуммаТары;
	Организация1С				= Документ1С[СтруктураМетаданныхПоступление().Организация];
	МаксимальноеОтклонениеСуммы = СтруктураЗначениеПеременных(Организация1С).ОтклонениеСуммыСНДС;
	ВсегдаОтображатьОтклонениеНДС = СтруктураЗначениеПеременных(Организация1С).ВсегдаОтображатьОтклонениеНДС;
	
	Если ДокументДД.ТипДокумента = "UniversalTransferDocument" ИЛИ ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда
		
		ОтклонениеСуммы = Окр(СуммаДокумента1С, 2) - Окр(ДокументДД.СуммаДокумента, 2);
		
		Если Макс(ОтклонениеСуммы, -ОтклонениеСуммы) > МаксимальноеОтклонениеСуммы Тогда
			Результат.Добавить("Ошибка в сумме с НДС. Ожидаемое значение: " + СуммаДокумента1С);
		КонецЕсли;
		Если Макс(ОтклонениеСуммы, -ОтклонениеСуммы) > 0 Тогда
			ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "ОтклонениеСуммы",	ОтклонениеСуммы);
		КонецЕсли;		
				
		//вычислим сумму по ставкам ндс ТОЛЬКО ДЛЯ ОРГАНИЗАЦИЙ на ОСНО
		Если НЕ ОрганизацияНаУСН(Организация1С) Тогда
			
			ТаблицаНДС = ПолучитьТаблицуСуммНДСдляУПД(КонтентДокумента, Документ1С);
			ОтклонениеНДС = Окр(ТаблицаНДС.Итог("СуммаНДС_1С"), 2) - Окр(ТаблицаНДС.Итог("СуммаНДС"), 2);
			
			Если Макс(ОтклонениеНДС, -ОтклонениеНДС) > МаксимальноеОтклонениеСуммы Тогда
				Результат.Добавить("Ошибка в сумме НДС. Ожидаемое значение: " + Окр(ТаблицаНДС.Итог("СуммаНДС_1С"), 2));
			КонецЕсли;	
			Если Макс(ОтклонениеНДС, -ОтклонениеНДС) > 0 Тогда
				ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "ОтклонениеНДС", ОтклонениеНДС);
			КонецЕсли;
			
			//Отображать колонку "Отклонение НДС", даже если допустимое отклонение = 0
			Если ВсегдаОтображатьОтклонениеНДС Тогда
				ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "ОтклонениеНДС", ОтклонениеНДС);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьГТДизУПД(ДокументДД, КонтентДокумента, Документ1С)
	
	Результат = Новый Массив;
	
	//Получить InvoiceTable из контента для 820\155 формата
	Если КонтентДокумента.Свойства().Получить("InvoiceTable") <> Неопределено Тогда
		InvoiceTable = КонтентДокумента.InvoiceTable;
	ИначеЕсли КонтентДокумента.Свойства().Получить("Table") <> Неопределено Тогда
		InvoiceTable = КонтентДокумента.Table;
	КонецЕсли;

	//Проверка ГТД
	Если ДокументДД.ТипДокумента = "UniversalTransferDocument" ИЛИ ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда 		
		Для каждого Item Из InvoiceTable.Items Цикл //по позициям

			Для каждого GTD Из Item.CustomDeclarations Цикл
				Если НЕ СтранаПроисхожденияЧленТС(GTD.CountryCode) Тогда // для стран-членов ТС заполнение номера ГТД не проверяем
					
					Если НЕ ПустаяСтрока(GTD.CountryCode) И СтрДлина(GTD.DeclarationNumber) < 2 Тогда
						Результат.Добавить("Для товара " + Item.Product + " указана страна происхождения, но не указан номер ГТД");
					ИначеЕсли ПустаяСтрока(GTD.CountryCode) И ЗначениеЗаполнено(GTD.DeclarationNumber) Тогда 
						Результат.Добавить("Для товара " + Item.Product + " указан номер ГТД, но не указана страна происхождения");
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;			
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьУКД(ДокументДД, КонтентДокумента, УПД, Корректировка, РазобранныйКонтентУПД)
	
	Результат = Новый Массив;
	ПодходящийУПД_ДД = УПД;
	Если Не ПодходящийУПД_ДД.АнализПроведен Тогда
		ОсновнойМодуль.ЭДО_ПровестиАнализВходящегоДокумента(ПодходящийУПД_ДД, ПодходящийУПД_ДД.Пакет);
	КонецЕсли;
	
	//ПРОВЕРКИ, КОГДА УКД НА ВОЗВРАТ
	Если ЗначениеЗаполнено(Корректировка) Тогда				
		ДобавитьВМассив(Результат, ПроверитьСуммыУКД(ДокументДД, КонтентДокумента, РазобранныйКонтентУПД, Корректировка));				
		// Дата УКД не должна превышать дату корректировки более чем на 5 дней
		ДобавитьВМассив(Результат, ПроверитьДатуУКД(ДокументДД, КонтентДокумента, РазобранныйКонтентУПД, Корректировка));				
		
	//ПРОВЕРКА, КОГДА УКД НА ОБЫЧНУЮ КОРРЕКТИРОВКУ ОШИБОК
	Иначе
		ДобавитьВМассив(Результат, ПроверитьСуммыУКД(ДокументДД, КонтентДокумента, РазобранныйКонтентУПД, ПодходящийУПД_ДД.Документ));				
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьСуммыУКД(ДокументДД, КонтентУКД, КонтентУПД, Документ1С)

	Результат					= Новый Массив;
	СтруктураПТУ				= СтруктураМетаданныхПоступление();
	МаксимальноеОтклонениеСуммы	= СтруктураЗначениеПеременных().ОтклонениеСуммы;
	
	Организация1C		= Документ1С[СтруктураПТУ.Организация];
	ТоварыСуммаНДС		= Документ1С[СтруктураПТУ.Товары].Итог(СтруктураПТУ.СуммаНДС);
	ТоварыСумма			= Документ1С[СтруктураПТУ.Товары].Итог(СтруктураПТУ.Сумма);
	
	//Если Документ1С - это поступление, то смотрим на таб.часть ВозвратнаяТара 
	ВозвратнаяТараСумма =?(ТипЗнч(Документ1С)= Тип("ДокументСсылка." + СтруктураПТУ.ИмяДокумента), Документ1С[СтруктураПТУ.ВозвратнаяТара].Итог(СтруктураПТУ.Сумма), 0);
	//КонецЕсли;
	
	СуммаНДС_1С		= ТоварыСуммаНДС;
	СуммаБезНДС_1С	= ?(Документ1С[СтруктураПТУ.СуммаВключаетНДС],
					   ТоварыСумма + ВозвратнаяТараСумма - СуммаНДС_1С,
					   ТоварыСумма + ВозвратнаяТараСумма);
	СуммаВсего_1С	= СуммаБезНДС_1С + СуммаНДС_1С;
		
	//Получить InvoiceTable из контента для 820\155 формата
	InvoiceTable = ?(КонтентУПД.Свойства().Получить("InvoiceTable") = Неопределено, КонтентУПД.Table, КонтентУПД.InvoiceTable);
	
	СуммаНДС        = ?(InvoiceTable.Vat = Неопределено, 0, InvoiceTable.Vat) +
	?(КонтентУКД.InvoiceCorrectionTable.TotalsInc.Vat = Неопределено, 0, КонтентУКД.InvoiceCorrectionTable.TotalsInc.Vat) -
	?(КонтентУКД.InvoiceCorrectionTable.TotalsDec.Vat = Неопределено, 0, КонтентУКД.InvoiceCorrectionTable.TotalsDec.Vat);
	
	СуммаБезНДС     = InvoiceTable.Total - ?(InvoiceTable.Vat = Неопределено, 0, InvoiceTable.Vat) +
	?(КонтентУКД.InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded = Неопределено, 0, КонтентУКД.InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded) -
	?(КонтентУКД.InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded = Неопределено, 0, КонтентУКД.InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded);
	
	СуммаВсего      = InvoiceTable.Total +
	?(КонтентУКД.InvoiceCorrectionTable.TotalsInc.Total = Неопределено, 0, КонтентУКД.InvoiceCorrectionTable.TotalsInc.Total) -
	?(КонтентУКД.InvoiceCorrectionTable.TotalsDec.Total = Неопределено, 0, КонтентУКД.InvoiceCorrectionTable.TotalsDec.Total);
	
	
	ОтклонениеСуммыНДС		= СуммаНДС_1С - СуммаНДС;
	ОтклонениеСуммыБезНДС	= СуммаБезНДС_1С - СуммаБезНДС;
	ОтклонениеСуммыВсего	= СуммаВсего_1С - СуммаВсего;
	
	Если Макс(ОтклонениеСуммыВсего, -ОтклонениеСуммыВсего) > МаксимальноеОтклонениеСуммы Тогда
		Результат.Добавить("Ошибка в сумме с НДС. Ожидаемое значение: " + СуммаВсего_1С);
	КонецЕсли;	
	
	//проверим Сумму НДС и безНДС ТОЛЬКО ДЛЯ ОРГАНИЗАЦИЙ на ОСНО
	Если НЕ ОрганизацияНаУСН(Организация1C) Тогда
		Если Макс(ОтклонениеСуммыНДС, -ОтклонениеСуммыНДС) > МаксимальноеОтклонениеСуммы Тогда
			Результат.Добавить("Ошибка в сумме НДС. Ожидаемое значение: " + СуммаНДС_1С);
		КонецЕсли;
		
		Если Макс(ОтклонениеСуммыБезНДС, -ОтклонениеСуммыБезНДС) > МаксимальноеОтклонениеСуммы Тогда
			Результат.Добавить("Ошибка в сумме без НДС. Ожидаемое значение: " + СуммаБезНДС_1С);
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьДатуУКД(ДокументДД, КонтентДокумента, РазобранныйКонтентУПД, Корректировка)
	
	Результат	= Новый Массив;
	СтруктураПТУ = СтруктураМетаданныхПоступление();
	СтруктураКорректировки = СтруктураМетаданныхКорректировки();
	
	ДатаОснования	= Корректировка[СтруктураКорректировки.Дата];
	ДатаУКД 		= ДокументДД.ДатаДокумента;
	
	Если НачалоДня(ДатаУКД) > НачалоДня(ДатаОснования) + 5*24*60*60 Тогда
		Результат.Добавить("Дата УКД (" + формат(ДатаУКД, "ДФ=dd.MM.yyyy") + ") превышает дату возвратной накладной более чем на 5 дней:" + формат(ДатаОснования, "ДФ=dd.MM.yyyy"));
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

//ищем УПД находящееся в одном пакете с УКД
Функция НайтиПодходящийУПД_В_СвязанныхДокументахПакета_ПоPacketId(ДокументДД)
	
	Результат = Новый Массив;	
	Если СокрЛП(ДокументДД.PacketId) <> "" Тогда	
		
		//Есть ситуации, кодга в пакете может быть УПД и ИУПД.
		Запрос = Новый Запрос(
		"ВЫБРАТЬ 
		|	Диадок_Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Диадок_Документы КАК Диадок_Документы
		|ГДЕ
		|	Диадок_Документы.Ссылка <> &Ссылка
		|	И Диадок_Документы.PacketId = &PacketId
		|	И Диадок_Документы.ТипДокумента В (""UniversalTransferDocument"", ""UniversalTransferDocumentRevision"")
		|	И Диадок_Документы.Статус В (""Откорректирован"", ""ЗапроситьУточнение"", ""Подписан"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	Диадок_Документы.ДатаЗагрузки УБЫВ"
		);
		Запрос.УстановитьПараметр("PacketId",	ДокументДД.PacketId);
		Запрос.УстановитьПараметр("Ссылка",		ДокументДД);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Результат.Добавить(Выборка.Ссылка);
			
		КонецЦикла;
		
	КонецЕсли;	
	
	Возврат Результат;  
	
КонецФункции

Функция НайтиПодходящийУПД_В_СвязанныхДокументахПакета_ПоПоступлению(ДокументДД)
	
	// УПД и иУПД объединяем в "пакет" не по packetId, а по сопоставленному Поступлению.
	Результат = Новый Массив;	
	Если ЗначениеЗаполнено(ДокументДД.Документ) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Диадок_Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Диадок_Документы КАК Диадок_Документы
		|ГДЕ
		|	Диадок_Документы.Ссылка <> &Ссылка
		|	И Диадок_Документы.Документ = &Документ
		|	И Диадок_Документы.ТипДокумента В (""UniversalTransferDocument"", ""UniversalTransferDocumentRevision"")
		|	И Диадок_Документы.ТребуемоеДействиеВДД = ""ЗапроситьУточнение"""
		);
		Запрос.УстановитьПараметр("Документ",	ДокументДД.Документ);
		Запрос.УстановитьПараметр("Ссылка",		ДокументДД);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		
		Пока Выборка.Следующий() Цикл
			
			Результат.Добавить(Выборка.Ссылка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;  
	
КонецФункции

Функция НайтиПодходящийУПДдляУКД(ДокументДД)
	
	InitialDocumentIDs = ОсновнойМодуль.ЭДО_СправочникМенеджер_ЗначениеДопРеквизита(ДокументДД, "ХранилищеInitialDocumentIDs");
	Если InitialDocumentIDs = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Строка36 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36));
	ТаблицаДокументовОснований = Новый ТаблицаЗначений;
	ТаблицаДокументовОснований.Колонки.Добавить("EntityId", Строка36);
	ТаблицаДокументовОснований.Колонки.Добавить("MessageId", Строка36);
	Для Каждого Элемент Из InitialDocumentIDs Цикл
		СтрокаТЗ = ТаблицаДокументовОснований.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, Элемент);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("т", ТаблицаДокументовОснований);
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.EntityId,
	               |	т.MessageId
	               |ПОМЕСТИТЬ вт_Идентификаторы
	               |ИЗ
	               |	&т КАК т
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Диадок_Документы.Ссылка
	               |ИЗ
	               |	вт_Идентификаторы КАК вт_Идентификаторы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы КАК Диадок_Документы
	               |		ПО вт_Идентификаторы.EntityId = Диадок_Документы.DocumentId
	               |			И вт_Идентификаторы.MessageId = Диадок_Документы.LetterId";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиПодходящийСчетФактуруИзРНК(ПНК) Экспорт
	
	Запрос		= Новый Запрос;
	СтруктураСФ	= СтруктураМетаданныхСФ();
	
	Если ЗначениеЗаполнено(СтруктураСФ.ДокументыОснования) Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ТЧ.Ссылка
			|ИЗ
			|	Документ.СчетФактураПолученный.ДокументыОснования КАК ТЧ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный КАК Т
			|		ПО ТЧ.Ссылка = Т.Ссылка
			|			И (НЕ Т.ПометкаУдаления)
			|ГДЕ
			|	ТЧ.ДокументОснование = (&ПНК)";
		
	Иначе 
					
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	СчетФактура.Ссылка 
			|ИЗ
			|	Документ.СчетФактураПолученный КАК СчетФактура
			|ГДЕ
			|	СчетФактура.ДокументОснование = (&ПНК)";
		
	КонецЕсли;    	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СчетФактураПолученный",	СтруктураСФ.ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументОснование",		СтруктураСФ.ДокументОснование);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументыОснования",		СтруктураСФ.ДокументыОснования);
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПНК", ПНК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);
	
КонецФункции

Функция НайтиСуществующуюКорректировкуПоступления(ПоступлениеСсылка, НомерКорректировки)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КорректировкаПоступления КАК Док
		|ГДЕ
		|	Док.ДокументПоступления = &ПоступлениеСсылка
		|	И Док.НомерКорректировки = &НомерКорр
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.ПометкаУдаления,
		|	Док.Проведен УБЫВ,
		|	Док.Дата";
	
	СтруктураКорректировки = СтруктураМетаданныхКорректировки();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КорректировкаПоступления", СтруктураКорректировки.ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДокументПоступления",		СтруктураКорректировки.ДокументПоступления);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Дата",					СтруктураКорректировки.Дата);	
	Если ЗначениеЗаполнено(НомерКорректировки) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НомерКорректировки",	СтруктураКорректировки.НомерКорректировки);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Док.НомерКорректировки = &НомерКорр", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПоступлениеСсылка", ПоступлениеСсылка);
	Запрос.УстановитьПараметр("НомерКорр", НомерКорректировки);
	
	ВыборкаИзЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаИзЗапроса.Следующий() Тогда
		ДокументКорр = ВыборкаИзЗапроса.Ссылка;
	Иначе
		ДокументКорр = Неопределено;
	КонецЕсли;
	
	Возврат ДокументКорр;
	
КонецФункции

//Пример поиска связанного документа (Елисей)
Функция ПолучитьУПДдляТТН(ДокИзAPI, BoxID)

	LetterID = "";
	DocumentID = "";	
	
	Если ДокИзAPI.SubordinateDocumentIds.количество() > 0 Тогда
		
		Для i = 0 по ДокИзAPI.SubordinateDocumentIds.Количество() - 1 Цикл 
			Попытка
				СвязанныйДок = ОсновнойМодуль.API_GetDocument(BoxID, ДокИзAPI.SubordinateDocumentIds[i].MessageId, ДокИзAPI.SubordinateDocumentIds[i].EntityId);
			Исключение 
				СвязанныйДок = Неопределено;
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
			
			Если ЗначениеЗаполнено(СвязанныйДок) Тогда
				Если СвязанныйДок.DocumentType = "UniversalTransferDocument" ИЛИ СвязанныйДок.DocumentType = "UniversalTransferDocumentRevision" Тогда
					LetterID = СвязанныйДок.MessageId;
					DocumentID = СвязанныйДок.EntityId;
				КонецЕсли;			
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Для i = 0 По ДокИзAPI.InitialDocumentIds.Количество() - 1 Цикл
			Попытка
				СвязанныйДок = ОсновнойМодуль.API_GetDocument(BoxID, ДокИзAPI.InitialDocumentIds[i].MessageId, ДокИзAPI.InitialDocumentIds[i].EntityId);
			Исключение 
				СвязанныйДок = Неопределено;
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
			
			Если ЗначениеЗаполнено(СвязанныйДок) Тогда
				Если СвязанныйДок.DocumentType = "UniversalTransferDocument" ИЛИ СвязанныйДок.DocumentType = "UniversalTransferDocumentRevision" Тогда
					LetterID = СвязанныйДок.MessageId;
					DocumentID = СвязанныйДок.EntityId;
				КонецЕсли;			
			КонецЕсли;			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(LetterID) И ЗначениеЗаполнено(DocumentID) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Диадок_Документы.Ссылка
		|ИЗ
		|	Справочник.Диадок_Документы КАК Диадок_Документы
		|ГДЕ
		|	Диадок_Документы.LetterId = &LetterId
		|	И Диадок_Документы.DocumentId = &DocumentId"
		);
		Запрос.УстановитьПараметр("LetterId", LetterID);
		Запрос.УстановитьПараметр("DocumentId", DocumentID);
		СвязанныеДокументы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		Если СвязанныеДокументы.Количество() = 1 Тогда
			Возврат СвязанныеДокументы[0]
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

