	// Для подписания\отказа по документам, выборка по дате загрузки за больший период:
	// 31 дней назад от текущей, но не ранее 31.12.2019
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПроверкаДатаЗагрузки", 
		
		 	"	Диадок_Документы.ДатаЗагрузки МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -31) И ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, 1)
			|	И Диадок_Документы.ДатаЗагрузки >= ДатаВремя(2019, 12, 31)"
		);
		
	// на всякий случай упорядочим документы внутри пакета
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПриоритетОбработки", 
	
		"	ВЫБОР
		|		КОГДА Диадок_Документы.ТипДокумента = ""UniversalTransferDocument""
		|			ТОГДА 1
		|		ИНАЧЕ 9
		|	КОНЕЦ"
	);
	
КонецПроцедуры	

Функция МассивОбрабатываемыхТиповДокументов()
	
	// массив типов документов, которые подпадают под автоматическую обработку регламентным заданием
	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить("UniversalTransferDocument");
	ТипыДокументов.Добавить("UniversalTransferDocumentRevision");
	ТипыДокументов.Добавить("UniversalCorrectionDocument");
	Возврат ТипыДокументов;
	
КонецФункции

Функция СогласоватьИлиОтказатьДокумент(ДокументДД, Действие, Комментарий)
	
	MessagePatchToPost = Новый Структура;
	MessagePatchToPost.Вставить("BoxId",		ДокументДД.BoxId);
	MessagePatchToPost.Вставить("MessageId",	ДокументДД.LetterId);
	
	ResolutionAttachment = Новый Структура;
	ResolutionAttachment.Вставить("InitialDocumentId",	ДокументДД.DocumentId);
	ResolutionAttachment.Вставить("Comment",			Комментарий);
	Если Действие = "Approve" Тогда
		ResolutionAttachment.Вставить("ResolutionType",	1);
	ИначеЕсли Действие = "Disapprove" Тогда	
		ResolutionAttachment.Вставить("ResolutionType",	2);
	КонецЕсли;
	
	Resolutions = Новый Массив;
	Resolutions.Добавить(ResolutionAttachment);
	
	MessagePatchToPost.Вставить("Resolutions",	Resolutions);
	
	ТелоЗапроса = ОсновнойМодуль.ЭДО_Служебные_СтруктураВJSON(MessagePatchToPost);
	
	Ответ = ОсновнойМодуль.ЭДО_Транспорт_ВызватьМетодAPI("/V3/PostMessagePatch", "POST", ТелоЗапроса);
	
	// может вернуться "Вы уже согласовали документ" (и для отказа, видимо, тоже)
	//РазобранныйОтвет = ОсновнойМодуль.ЭДО_Транспорт_РазобратьОтветAPI(Ответ);
	
	Возврат Истина;
	
КонецФункции

Функция ПереместитьДокументВПодразделение(ДокументДД, ИДПодразделения)
	
	DocumentsMoveOperation = Новый Структура;
	DocumentsMoveOperation.Вставить("BoxId",			ДокументДД.BoxId);
	DocumentsMoveOperation.Вставить("ToDepartmentId",	ИДПодразделения);
	 
	DocumentIds = Новый Массив;
	DocumentIds.Добавить(Новый Структура("MessageId, EntityId", ДокументДД.LetterId, ДокументДД.DocumentId));  
	DocumentsMoveOperation.Вставить("DocumentIds",	DocumentIds);
	
	Ответ = ОсновнойМодуль.ЭДО_Транспорт_ВызватьМетодAPI("/MoveDocuments", "POST", ОсновнойМодуль.ЭДО_Служебные_СтруктураВJSON(DocumentsMoveOperation));
	
	Возврат Истина;
	
