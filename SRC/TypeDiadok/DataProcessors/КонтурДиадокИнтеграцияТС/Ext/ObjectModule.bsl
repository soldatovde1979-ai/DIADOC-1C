// Выполняет регламентные действия, требующие инициализацию основного модуля
Функция ВыполнитьРегламентныеДействия(Параметры) Экспорт
	
	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Vypolnit%27_Reglamentnyye_Deystviya.html

	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.НачалоРегламентнойОбработки");
	
	// 1. Авторизуемся, прогрузим новые сообщения
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись().Логин) Тогда
		Сообщить("Не указана служебная учетная запись для выполнения регламентных действий.");
		Возврат Ложь;
	КонецЕсли;
	
	// АВТОРИЗАЦИЯ ПО ЛОГИНУ И ПАРОЛЮ 
	
	ОсновнойМодуль.ЭДО_АвторизоватьсяПодЛогином(УчетнаяЗапись().Логин, УчетнаяЗапись().Пароль);
	
	
	// ОБРАБОТКА СОБЫТИЙ ЛЕНТЫ, В Т.Ч. ЗАГРУЗКА НОВЫХ ДОКУМЕНТОВ
	
	КоличествоПорцийСобытий = 10; // Кол-во вычитываемых порций событий (каждая порция содержит не более 100 событий)
	Для Каждого СтрокаОрганизации Из ОсновнойМодуль.ЭДО_Модуль_ТаблицаОрганизацийПользователя() Цикл
		
		//Авторизация под сертификатом организации
		ОсновнойМодуль.ЭДО_АвторизоватьсяПодСертификатомНаСервере1С();
		КонтекстСеанса = ОсновнойМодуль.ЭДО_КонтекстСеансаКлиентСервер();
		
		//ИоПы    
        ИоПы = ОсновнойМодуль.ЭДО_ПодготовитьИзвещенияОПолучении();
        ОсновнойМодуль.ЭДО_ПодписатьИзвещенияОПолучении(ИоПы);
        ОсновнойМодуль.ЭДО_ОтправитьПодписанныеИзвещенияОПолучении(ИоПы);
		
		//Чтение ленты
		ОсталосьСобытийВЛенте = ОсновнойМодуль.ЭДО_Модуль_ОбработатьНовыеСобытияДокументов(СтрокаОрганизации, КоличествоПорцийСобытий);		
	КонецЦикла;
	
	// если анализ и дальнейшие действия опасно запускать без полной вычитки ленты, то понадобится данный блок:
	//Если Не ВсеСобытияПрочитаны Тогда
	//	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.ОкончаниеРегламентнойОбработки");
	//	Возврат Неопределено;
	//КонецЕсли;	
	
	
	// Еще хорошо бы прогрузить новых контрагентов на всякий случай.
	// Хотя можно пока и оставить для ручной прогрузки.
	
	
	// 2. Проведем анализ для новых сообщений
	РеглЗадание_ПровестиАнализНовыхДокументов();
	
	// 3. Проанализированные документы согласуем
	//РеглЗадание_СогласоватьПроанализированныеДокументы();	
	РеглЗадание_ОтправитьГотовыеответыПоПроанализированнымДокументам();
	
	
	// 4. Выполнить требуемое действие, согласно значению поля "ДействиеВ1С".
	РеглЗадание_ВыполнитьТребуемоеДействие();
	
	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.ОкончаниеРегламентнойОбработки");
	
	Возврат Неопределено;
	
КонецФункции

//? Нет процедуры УстановитьФильтрПоДатеЗагрузки
Процедура РеглЗадание_ПровестиАнализНовыхДокументов()
	
	// Выбираем новые документы с фильтром по дате (устанавливается в процедуре УстановитьФильтрПоДатеЗагрузки())
	//   причем только те, у которых еще не установлен реквизит "АнализПроведен"
	//   и отправляем на анализ.
	// Сам реквизит "АнализПроведен" записывается внутри метода "ПровестиАнализДокумента"
	// Выбираем порцию из 1000 документов, чтобы не завешивать базу.
	
	ЗапросПоНовымСообщениям = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	Диадок_Документы.LetterId КАК LetterId
	|ПОМЕСТИТЬ ВТ_ИдентификаторыНеобработанныхПакетов
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	&ПроверкаДатаЗагрузки
	|	И НЕ Диадок_Документы.ПометкаУдаления
	|	И Диадок_Документы.ТипДокумента В(&ТипыДокументов)
	|	И (НЕ Диадок_Документы.АнализПроведен
	|			ИЛИ Диадок_Документы.ТребуемоеДействиеВ1С = ""ПовторитьАнализ"")
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	LetterId
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Диадок_Документы.Ссылка КАК ДокументДД,
	|	Диадок_Документы.Пакет КАК ПакетДД,
	|	&ПриоритетОбработки КАК ПриоритетОбработки,
	|	Диадок_Документы.ДатаЗагрузки КАК ДатаЗагрузки,
	|	Диадок_Документы.ТипДокумента,
	|	ВТ_ИдентификаторыНеобработанныхПакетов.LetterId КАК LetterId
	|ИЗ
	|	ВТ_ИдентификаторыНеобработанныхПакетов КАК ВТ_ИдентификаторыНеобработанныхПакетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы КАК Диадок_Документы
	|		ПО ВТ_ИдентификаторыНеобработанныхПакетов.LetterId = Диадок_Документы.LetterId
	|ГДЕ
	|	&ПроверкаДатаЗагрузки
	|	И НЕ Диадок_Документы.ПометкаУдаления
	|	И Диадок_Документы.ТипДокумента В(&ТипыДокументов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗагрузки,
	|	ПриоритетОбработки
	|ИТОГИ ПО
	|	LetterId"
	);
	
	ЗапросПоНовымСообщениям.УстановитьПараметр("ТипыДокументов",	МассивОбрабатываемыхТиповДокументов());
	ЗапросПоНовымСообщениям.УстановитьПараметр("Период",			НачалоДня(ТекущаяДата()));
	
	ДополнитьТекстЗапросаПоДокументам(ЗапросПоНовымСообщениям.Текст);
	
	ВыборкаПакеты = ЗапросПоНовымСообщениям.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.НачалоАнализаДокументов", , , , "Выбрано пакетов для анализа: " + ВыборкаПакеты.Количество());
	
	Пока ВыборкаПакеты.Следующий() Цикл
		
		ВыборкаДокументыПакета = ВыборкаПакеты.Выбрать();

		Попытка
			
			Пока ВыборкаДокументыПакета.Следующий() Цикл
			
				ОсновнойМодуль.ЭДО_ПровестиАнализВходящегоДокумента(ВыборкаДокументыПакета.ДокументДД, ВыборкаДокументыПакета.ПакетДД);  
				// ПакетДД на самом деле пока не используется, но в планах такое есть
			КонецЦикла;

		Исключение
			
			мОшибка = ОписаниеОшибки();
			Сообщить("При анализе / согласовании документа " + ВыборкаДокументыПакета.ДокументДД + " произошли ошибки: " + Символы.ПС + мОшибка);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РеглЗадание_СогласоватьПроанализированныеДокументы()
	
	// Выбираем документы, которые были проанализированы на предыдущем шаге, но действие согласования (отказа в согласовании) по ним еще не выполнено
	// И выполняем
	
	ЗапросПоНовымСообщениям = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	Диадок_Документы.Ссылка КАК ДокументДД,
	|	Диадок_Документы.Пакет КАК ПакетДД,
	|	&ПриоритетОбработки КАК ПриоритетОбработки
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ДопРеквизиты_АнализПроведен
	|		ПО (ДопРеквизиты_АнализПроведен.Ссылка = Диадок_Документы.Ссылка)
	|			И (ДопРеквизиты_АнализПроведен.ИмяРеквизита = ""АнализПроведен"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ДопРеквизиты_СогласованиеВыполнено
	|		ПО (ДопРеквизиты_СогласованиеВыполнено.Ссылка = Диадок_Документы.Ссылка)
	|			И (ДопРеквизиты_СогласованиеВыполнено.ИмяРеквизита = ""СогласованиеВыполнено"")
	|ГДЕ
	|	&ПроверкаДатаЗагрузки
	|	И НЕ Диадок_Документы.ПометкаУдаления
	|	И Диадок_Документы.ТипДокумента В(&ТипыДокументов)
	|	И ДопРеквизиты_СогласованиеВыполнено.Значение ЕСТЬ NULL 
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диадок_Документы.ДатаЗагрузки,
	|	ПриоритетОбработки"
	);
	
	ЗапросПоНовымСообщениям.УстановитьПараметр("ТипыДокументов",	МассивОбрабатываемыхТиповДокументов());
	ЗапросПоНовымСообщениям.УстановитьПараметр("Период",			НачалоДня(ТекущаяДата()));
	
	ДополнитьТекстЗапросаПоДокументам(ЗапросПоНовымСообщениям.Текст);
	
	Выборка = ЗапросПоНовымСообщениям.Выполнить().Выбрать();
	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.НачалоСогласованияДокументов", , , , "Выбрано документов для согласования: " + Выборка.Количество());
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ТекстОшибкиСтрокой = ОсновнойМодуль.ЭДО_СправочникМенеджер_ЗначениеДопРеквизита(Выборка.ДокументДД, "ОшибкиПроверкиТекст");
			
			// надо счет-фактуру тоже научиться перемещать.
			
			Если Не ЗначениеЗаполнено(ТекстОшибкиСтрокой) Тогда
				
				Успешно = СогласоватьИлиОтказатьДокумент(Выборка.ДокументДД, "Approve", "Проверка выполнена");
				// но это выполняется только для ТОРГ12!
				ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(Выборка.ДокументДД, "СогласованиеВыполнено", Истина);
				
			Иначе
				
				Если ПропуститьДействиеПоДокументу(ТекстОшибкиСтрокой, Выборка.ДокументДД) Тогда
					Продолжить; //Не отклоняем для ошибок, по которым должно быть действие "Пропустить"
				КонецЕсли;
				Успешно = СогласоватьИлиОтказатьДокумент(Выборка.ДокументДД, "Disapprove", ТекстОшибкиСтрокой);
				ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(Выборка.ДокументДД, "СогласованиеВыполнено", Истина);
				
			КонецЕсли;

		Исключение
			
			мОшибка = ОписаниеОшибки();
			Сообщить("При согласовании документа " + Выборка.ДокументДД + " произошли ошибки: " + Символы.ПС + мОшибка);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РеглЗадание_ОтправитьГотовыеответыПоПроанализированнымДокументам()
	
	Статусы  = Новый Массив;
	Статусы.Добавить("Требуется подпись");
	Статусы.Добавить("Откорректирован");

	
	Действия  = Новый Массив;
	Действия.Добавить("Подписать");
	Действия.Добавить("ЗапроситьУточнение");
	Действия.Добавить("ОтказатьВПодписи");
	
	// Выбираем документы, которые были проанализированы на предыдущем шаге, но ответы по ним еще не отправлены	
	ЗапросПоНовымСообщениям = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	Диадок_Документы.Ссылка КАК ДокументДД,
	|	Диадок_Документы.Пакет КАК ПакетДД,
	|	&ПриоритетОбработки КАК ПриоритетОбработки
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	&ПроверкаДатаЗагрузки И
	|	НЕ Диадок_Документы.ПометкаУдаления
	|	И Диадок_Документы.АнализПроведен
	|	И Диадок_Документы.ТребуемоеДействиеВДД В(&Действия)
	|	И Диадок_Документы.ТипДокумента В(&ТипыДокументов)
	|	И Диадок_Документы.Статус В(&Статусы)	
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диадок_Документы.ДатаЗагрузки,
	|	ПриоритетОбработки"
	);
	
	ЗапросПоНовымСообщениям.УстановитьПараметр("Период",			НачалоДня(ТекущаяДата()));
	ЗапросПоНовымСообщениям.УстановитьПараметр("ТипыДокументов",	МассивОбрабатываемыхТиповДокументов());
	ЗапросПоНовымСообщениям.УстановитьПараметр("Статусы",			Статусы);
	ЗапросПоНовымСообщениям.УстановитьПараметр("Действия",			Действия);	

	ДополнитьТекстЗапросаПоДокументам_Подписание(ЗапросПоНовымСообщениям.Текст); //Расширенный период обработки
	
	Выборка = ЗапросПоНовымСообщениям.Выполнить().Выбрать();
	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.НачалоПодписанияДокументов", , , , "Выбрано документов для подписания: " + Выборка.Количество());
	
	Пока Выборка.Следующий() Цикл
		
		Попытка			
			Если ПропуститьДействиеПоДокументу(Выборка.ДокументДД.ТекстОшибки, Выборка.ДокументДД) Тогда
				Продолжить; //Не отклоняем для ошибок, по которым должно быть действие "Пропустить"
			КонецЕсли;
			
			ОсновнойМодуль.ЭДО_ПодготовитьИОтправитьОтветНаДокумент(Выборка.ДокументДД, Выборка.ПакетДД);
			
			//Сбросить действие в ДД после подписания\отказа
			ДокОбъект = Выборка.ДокументДД.ПолучитьОбъект();
			ДокОбъект.ТребуемоеДействиеВДД = "";
			ДокОбъект.Метка = "РаботаЗавершена";
			ДокОбъект.Записать();
		Исключение
			мОшибка = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РеглЗадание_ВыполнитьТребуемоеДействие()
	
	// 1. Выбираем подписанные\отказанные документы
	// 2. Выполняем требуемое действие в 1С
	// 3. Помечаем как завершенные 
	
	Статусы  = Новый Массив;
	Статусы.Добавить("Подписан");
	Статусы.Добавить("Ожидается уточнение");
	Статусы.Добавить("Ожидается уточнение. Ожидается извещение о получении");
	
	Действия1С  = Новый Массив;
	// Пустое действие, для дополнительной пометки как завершенные (в процедуре "ВыполнитьТребуемоеДействие()" есть такая обработка)
	Действия1С.Добавить("");
	Действия1С.Добавить("ПодписатьСвязанныйУПД");
	Действия1С.Добавить("ЗапроситьАннулирование");
	
	// Выбираем документы, которые были подписаны\отказаны на предыдущем шаге, но ответы по ним еще не отправлены	
	ЗапросПоНовымСообщениям = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	Диадок_Документы.Ссылка КАК ДокументДД,
	|	Диадок_Документы.Пакет КАК ПакетДД,
	|	&ПриоритетОбработки КАК ПриоритетОбработки
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|ГДЕ
	|	&ПроверкаДатаЗагрузки
	|	И НЕ Диадок_Документы.ПометкаУдаления
	|	И Диадок_Документы.АнализПроведен
	|	И Диадок_Документы.ТребуемоеДействиеВ1С В(&Действия1С)
	|	И Диадок_Документы.ТипДокумента В(&ТипыДокументов)
	|	И Диадок_Документы.Статус В(&Статусы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диадок_Документы.ДатаЗагрузки,
	|	ПриоритетОбработки"
	);
	
	ЗапросПоНовымСообщениям.УстановитьПараметр("Период",			НачалоДня(ТекущаяДата()));
	ЗапросПоНовымСообщениям.УстановитьПараметр("ТипыДокументов",	МассивОбрабатываемыхТиповДокументов());
	ЗапросПоНовымСообщениям.УстановитьПараметр("Статусы",			Статусы);
	ЗапросПоНовымСообщениям.УстановитьПараметр("Действия1С",		Действия1С);	

	ДополнитьТекстЗапросаПоДокументам_Подписание(ЗапросПоНовымСообщениям.Текст); //Расширенный период обработки
	
	Выборка = ЗапросПоНовымСообщениям.Выполнить().Выбрать();
	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.НачалоВыполненияДействий", , , , "Выбрано документов для действий в 1С: " + Выборка.Количество());
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Результат = ВыполнитьТребуемоеДействие(Новый Структура("ДокументДД, ПакетДД", Выборка.ДокументДД, Выборка.ПакетДД));
		Исключение
			мОшибка = ОписаниеОшибки();
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РеглЗадание_ПереместитьСогласованныеДокументы()
	
	// Выбираем документы, которые помечены как согласованные (или отказанные в согласовании), но еще не перемещенные в подразделение "Обработанные"
	// И перемещаем.
	
	ЗапросПоНовымСообщениям = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
	|	Диадок_Документы.Ссылка КАК ДокументДД,
	|	Диадок_Документы.Пакет КАК ПакетДД,
	|	&ПриоритетОбработки КАК ПриоритетОбработки
	|ИЗ
	|	Справочник.Диадок_Документы КАК Диадок_Документы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ДопРеквизиты_СогласованиеВыполнено
	|		ПО (ДопРеквизиты_СогласованиеВыполнено.Ссылка = Диадок_Документы.Ссылка)
	|			И (ДопРеквизиты_СогласованиеВыполнено.ИмяРеквизита = ""СогласованиеВыполнено"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ДопРеквизиты_ДокументПеремещен
	|		ПО (ДопРеквизиты_ДокументПеремещен.Ссылка = Диадок_Документы.Ссылка)
	|			И (ДопРеквизиты_ДокументПеремещен.ИмяРеквизита = ""ДокументПеремещен"")
	|ГДЕ
	|	&ПроверкаДатаЗагрузки
	|	И НЕ Диадок_Документы.ПометкаУдаления
	|	И Диадок_Документы.ТипДокумента В(&ТипыДокументов)
	|	И ДопРеквизиты_ДокументПеремещен.Значение ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диадок_Документы.LetterId,
	|	ПриоритетОбработки"
	);
	
	ЗапросПоНовымСообщениям.УстановитьПараметр("ТипыДокументов",	МассивОбрабатываемыхТиповДокументов());
	ЗапросПоНовымСообщениям.УстановитьПараметр("Период", 			НачалоДня(ТекущаяДата()));
	
	ДополнитьТекстЗапросаПоДокументам(ЗапросПоНовымСообщениям.Текст);
	
	Выборка = ЗапросПоНовымСообщениям.Выполнить().Выбрать();
	ОсновнойМодуль.ДобавитьЗаписьЖурналаРегистрации("Диадок.НачалоПеремещенияДокументов", , , , "Выбрано документов для перемещения: " + Выборка.Количество());
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ИДПодразделения = ПолучитьПодразделениеДляПеремещения(Выборка.ДокументДД.BoxId, Выборка.ДокументДД.ТипДокумента);
			ПереместитьДокументВПодразделение(Выборка.ДокументДД, ИДПодразделения);
			ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(Выборка.ДокументДД, "ДокументПеремещен", Истина);
			
		Исключение
			
			мОшибка = ОписаниеОшибки();
			Сообщить("При перемещении документа " + Выборка.ДокументДД + " произошли ошибки: " + Символы.ПС + мОшибка);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

//вспомогательные

Процедура ДополнитьТекстЗапросаПоДокументам(ТекстЗапроса)
	
	// во всех запросах выборка документов по дате получения (реквизит "ДатаЗагрузки):
	// 15 дней назад от текущей
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПроверкаДатаЗагрузки", 
		
		 	"	Диадок_Документы.ДатаЗагрузки МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -15) И ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, 1)
			|	И Диадок_Документы.ДатаЗагрузки >= ДатаВремя(2019, 12, 31)"
		);
		
	// на всякий случай упорядочим документы внутри пакета
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПриоритетОбработки", 
	
		"	ВЫБОР
		|		КОГДА Диадок_Документы.ТипДокумента = ""UniversalTransferDocument""
		|			ТОГДА 1
		|		ИНАЧЕ 9
		|	КОНЕЦ"
	);
	
КонецПроцедуры	

