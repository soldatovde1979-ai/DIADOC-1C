	СтруктураМетаданных.Вставить("СуммаВключаетНДС",			"СуммаВключаетНДС");
	
	//табличные части
	СтруктураМетаданных.Вставить("Товары",						"Товары");
	СтруктураМетаданных.Вставить("Услуги",						"Услуги");
	СтруктураМетаданных.Вставить("ВозвратнаяТара",				"ВозвратнаяТара");
	
	//колонки табличных частей
	СтруктураМетаданных.Вставить("Сумма",						"Сумма");
	//колонки табличных частей Товары и Услуги
	СтруктураМетаданных.Вставить("СуммаНДС",					"СуммаНДС");
