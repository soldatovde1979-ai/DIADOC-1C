Процедура ЗаполнитьРезультатАнализа(РезультатАнализа, УчетныйДокумент = Неопределено
	, ДействиеВ1С = Неопределено
	, ДействиеВДД = Неопределено
	, Ошибки = Неопределено
	, КонтентОтвета = Неопределено)
	
	РезультатАнализа.Вставить("ДокументДляСопоставления", УчетныйДокумент);
	РезультатАнализа.Вставить("ДействиеВДД", ДействиеВДД);
	РезультатАнализа.Вставить("ДействиеВ1С", ДействиеВ1С);
	РезультатАнализа.Вставить("Ошибки", Ошибки);
	
	Если КонтентОтвета <> Неопределено Тогда
		РезультатАнализа.Вставить("КонтентОтвета", КонтентОтвета);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДействиеВ1С) Тогда
		РезультатАнализа.ДействиеВ1С = ВозможныеДействияСДокументамиВ1С().ПустоеДействие;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДействиеВДД) Тогда
		РезультатАнализа.ДействиеВДД = ВозможныеДействияСДокументамиВ1С().ПустоеДействие;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ошибки) Тогда
		РезультатАнализа.Ошибки = Новый Массив;
	КонецЕсли;
	
КонецПроцедуры

Функция ПровестиАнализДокумента(Параметры) Экспорт 
		
	Ошибки = Новый Массив;	
	ДокументДД		= Параметры.ДокументДД;
	ТипДокумента	= НРег(ДокументДД.ТипДокумента);
	ТипКонтента		= НРег(ДокументДД.ТипКонтента);
	СтруктураДопСведений	= СтруктураДопСведенияКонтента();
	
	Действия1С = ВозможныеДействияСДокументамиВ1С();
	ДействияДД = ВозможныеДействияСДокументамиВДиадоке();
	
	УчетныйДокумент = ДокументДД.Документ;
	
	Результат = Параметры.РезультатАнализа;
	
	Если ТребуетсяПродолжитьАнализПослеПроверкиКодовМаркировки(ДокументДД) Тогда
		
		ПродолжитьАнализПослеПроверкиКодовМаркировки(ДокументДД, Результат);
		Возврат Результат;
		
	КонецЕсли;
	
	Контрагент	= ДокументДД.КонтрагентДиадок.СвязанныйСправочник1; // Неопределено?
	Организация	= ДокументДД.ОрганизацияДиадок.СвязанныйСправочник1; // Неопределено?
	
	ЭтоУПД = (ТипДокумента = "universaltransferdocument");
	ЭтоИсправлениеУПД = (ТипДокумента = "universaltransferdocumentrevision");
	ЭтоУКД = (ТипДокумента = "universalcorrectiondocument");
	
	//не сопоставлен контрагент (любой тип документа)
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Ошибки.Добавить("Не сопоставлен контрагент");		
	КонецЕсли;	
	РазобранныйКонтент = ОсновнойМодуль.ЭДО_ПолучитьСтруктурированныйКонтентВходящегоДокумента(ДокументДД);
	
	//СОПОСТАВЛЕНИЕ УПД/ИУПД
	Если ЭтоУПД Или ЭтоИсправлениеУПД Тогда
		
		//НомерАктаПриемки = ОсновнойМодуль.ПолучитьДопСвойствоШапкиДокумента(СтруктураДопСведений.НомерАкта, РазобранныйКонтент, "universaltransferdocument");
		НомерЗаказа = ПолучитьДопСвойствоИзКонтента(РазобранныйКонтент, ТипДокумента, СтруктураДопСведений.НомерЗаказа);
		НомерАктаПриемки = ПолучитьДопСвойствоИзКонтента(РазобранныйКонтент, ТипДокумента, СтруктураДопСведений.НомерАкта);
		
		Если ЗначениеЗаполнено(НомерАктаПриемки) ИЛИ ЗначениеЗаполнено(НомерЗаказа) Тогда
			ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "НомерАктаПриемки", НомерАктаПриемки);
			ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "НомерЗаказа",	НомерЗаказа);
			
			ПодходящийДокумент = НайтиПодходящееПоступление(Контрагент, Организация, НомерАктаПриемки, ДокументДД.ДатаДокумента, НомерЗаказа);
			Если НЕ ЗначениеЗаполнено(ПодходящийДокумент) Тогда
				//Ошибки.Добавить("Не найдено поступление с номером акта приемки: " + НомерАктаПриемки + " или номером");
				Ошибки.Добавить("Не найдено поступление с номером акта приемки: " + НомерАктаПриемки + " или номером заказа: " + НомерЗаказа);
			КонецЕсли;			
			
		Иначе
			Ошибки.Добавить("В документе не указан номер акта приемки или номер заказа");
		КонецЕсли;		
		
		
	//СОПОСТАВЛЕНИЕ УКД
	ИначеЕсли ЭтоУКД Тогда
		
		//сопоставление УКД на возврат, поиск документа "Корректировка поступления" по инфополю "номер_корректировки"
		НомерКорр = ПолучитьДопСвойствоИзКонтента(РазобранныйКонтент, "universalcorrectiondocument", СтруктураДопСведений.НомерКорректировки); 
		Если ЗначениеЗаполнено(НомерКорр) Тогда
			ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "НомерКорректировки", НомерКорр);
			//Поиск корректировки выполняется далее, по пакету и по номеру
		КонецЕсли;
		
		//по УКД ищем подписанный УПД
		ПодписанныеУПДвПакете = НайтиПодходящийУПД_В_СвязанныхДокументахПакета_ПоPacketId(ДокументДД);		
		Если (ПодписанныеУПДвПакете.Количество() > 1) Тогда 
			Ошибки.Добавить("В пакете с УКД больше одного УПД. Должен быть только один");
		ИначеЕсли (ПодписанныеУПДвПакете.Количество() < 1) Тогда 
			Ошибки.Добавить("В пакете с УКД нет УПД");			
		КонецЕсли;
		
		//Для подписанного УПД ищем документ ПТУ в 1С
		Если (ПодписанныеУПДвПакете.Количество() = 1) Тогда			
			УПД = ПодписанныеУПДвПакете[0];
			Если УПД.Документ = NULL или УПД.Документ = Неопределено Тогда
				Ошибки.Добавить("Основание УКД - УПД №" + УПД.Документ.Номер + " от " + УПД.Документ.Дата + " не связан с ПТУ в 1С");
			Иначе
				//Проверки УКД выполняем по ПТУ, связанному с УПД, но в сопоставлении сохраняем Корректировку(см далее).
				ПодходящийДокумент = УПД.Документ;
				РазобранныйКонтентУПД = ОсновнойМодуль.ЭДО_ПолучитьСтруктурированныйКонтентВходящегоДокумента(УПД);
			КонецЕсли;
		КонецЕсли;
		
		
	//НЕИЗВЕСТНЫЙ ТИП ДОКУМЕНТА	
	Иначе		
		Ошибки.Добавить("Обработка " + ТипДокумента + " не предусмотрена");
	КонецЕсли;
		
	
	//БЛОК ПРОВЕРОК УПД/ИУПД/УКД по найденному поступлению либо корректировке	
	Если ЗначениеЗаполнено(ПодходящийДокумент) И СтандартныйПакет().НайтиПоЗначению(ТипДокумента) <> Неопределено Тогда	
		
		//основные проверки для всех типов документов, включая УКД
		ДобавитьВМассив(Ошибки, ПроверитьУчет		(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		ДобавитьВМассив(Ошибки, ПроверитьОрганизацию(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		ДобавитьВМассив(Ошибки, ПроверитьКонтрагента(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));				
		ДобавитьВМассив(Ошибки, ПроверитьВалюту		(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		ДобавитьВМассив(Ошибки, ПроверитьИПшника 	(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		
		//следующие проверки только для УПД, игнорируется УКД
		ДобавитьВМассив(Ошибки, ПроверитьДатуУПД		(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		ДобавитьВМассив(Ошибки, ПроверитьФункциюУПД 	(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		ДобавитьВМассив(Ошибки, ПроверитьСуммыУПД		(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		ДобавитьВМассив(Ошибки, ПроверитьГТДизУПД		(ДокументДД, РазобранныйКонтент, ПодходящийДокумент));
		
		//основная проверка УКД - сравнение с Корректировкой, сопоставление сохраняется в справочник "Диадок_документы" 
		Если ЭтоУКД Тогда
			Корректировка = НайтиСуществующуюКорректировкуПоступления(ПодходящийДокумент, НомерКорр);
			Если ЗначениеЗаполнено(НомерКорр) И НЕ ЗначениеЗаполнено(Корректировка) Тогда
				Ошибки.Добавить("Не найдена корректировка с номером: " + НомерКорр);
			КонецЕсли;			
			ДобавитьВМассив(Ошибки, ПроверитьУКД 	(ДокументДД, РазобранныйКонтент, УПД,  Корректировка, РазобранныйКонтентУПД));
			ПодходящийДокумент = ?(ЗначениеЗаполнено(Корректировка), Корректировка, ПодходящийДокумент);
		КонецЕсли;
		
	КонецЕсли;
		
	//Вывод результатов проверки, если документ был сопоставлен
	ТекстОшибок = ОсновнойМодуль.ЭДО_Служебные_МассивВСтроку(Ошибки, Символы.ПС);
	ЕстьОшибки = ЗначениеЗаполнено(Ошибки);
	
	Если ПропуститьДействиеПоДокументу(ТекстОшибок, ДокументДД) Тогда
		
		ЗаполнитьРезультатАнализа(Результат,
			Неопределено,
			Действия1С.ПовторитьАнализ,
			ДействияДД.ПустоеДействие,
			Ошибки);
		
		Возврат Результат;
		
	КонецЕсли;
	
	ШтрихкодыУпаковок = ШтрихкодыУпаковокЭлектронногоДокумента(ДокументДД);
	ЕстьКодыМаркировки = ЗначениеЗаполнено(ШтрихкодыУпаковок);
	
	Если ЕстьКодыМаркировки
		И Не ЕстьОшибки Тогда
		ЗагрузитьШтрихкодыИСопоставитьДокументы(ДокументДД, ПодходящийДокумент, ШтрихкодыУпаковок);
		Возврат Неопределено;
	КонецЕсли;
	
	//Определяем действие для УПД, ИУПД, УКД. Если действие в Диадоке не требуется, то необходимо оставить пустым.
	//Возможные варианты для ДействиеВ1С перечислены в функции ВозможныеДействияСДокументамиВ1С()	
	Если ЭтоУПД Или ЭтоИсправлениеУПД Тогда
		
		Если ЕстьОшибки Тогда
			
			ДействиеВДД = ДействияДД.ЗапроситьУточнение;
			ДействиеВ1С = Действия1С.ПустоеДействие;
			
		Иначе
			
			ДействиеВДД = ДействияДД.Подписать;
			ДействиеВ1С = Действия1С.СоздатьСчетФактуру;
			
		КонецЕсли;
		
	ИначеЕсли ЭтоУКД Тогда
		
		//ДействиеПриОшибках = ?(Найти(ТекстОшибок, "Данный документ уже был учтен в электронном виде") = 0, "ЗапроситьУточнение", "ОтказатьВПодписи");
		Если ЕстьОшибки Тогда
			ДействиеВДД = ДействияДД.ОтказатьВПодписи;
			ДействиеВ1С = Действия1С.ПустоеДействие;
		Иначе
			ДействиеВДД = ДействияДД.Подписать;
			ДействиеВ1С = Действия1С.ПодписатьСвязанныйУПД;
		КонецЕсли;
		
	КонецЕсли;
	
	КонтентОтвета = Неопределено;
	Если ЗначениеЗаполнено(ДействиеВДД) Тогда
		КонтентОтвета = ОсновнойМодуль.ЭДО_ПолучитьПустойКонтентОтвета(ТипКонтента, ДействиеВДД);
		ПодготовитьКонтентОтвета(ДокументДД, КонтентОтвета, Ошибки, ПодходящийДокумент);
	КонецЕсли;
	
	ЗаполнитьРезультатАнализа(Результат
		, ПодходящийДокумент
		, ДействиеВ1С
		, ДействиеВДД
		, Ошибки
		, КонтентОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПодходящееПоступление(Контрагент, Организация, НомерАктаПриемки, ДатаДокумента, НомерЗаказа)
	
	
	//Запрос с использованием "UNION ALL" повышает быстродействие при поиске
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.НомерАктаПриемки = &НомерАктаПриемки
	|	И ПоступлениеТоваровУслуг.Контрагент = &Контрагент
	|	И ПоступлениеТоваровУслуг.Организация = &Организация
	|	И ПоступлениеТоваровУслуг.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -4) И ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 1)
	|	И НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.НомерАктаПриемки = &НомерАктаПриемки
	|	И ПоступлениеТоваровУслуг.Контрагент.ГоловнойКонтрагент = &Контрагент
	|	И ПоступлениеТоваровУслуг.Организация = &Организация
	|	И ПоступлениеТоваровУслуг.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -4) И ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 1)
	|	И НЕ ПоступлениеТоваровУслуг.ПометкаУдаления
	|
	|&ЗапросПоискаПоНомеруЗаказа		
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт.Ссылка КАК Ссылка
	|ИЗ
	|	Вт КАК Вт
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт.Ссылка"
	);
	
	СтруктураПоступления = СтруктураМетаданныхПоступление();	
	
	ТекстЗапроса = СтрЗаменить(Запрос.Текст, "ПоступлениеТоваровУслуг",	СтруктураПоступления.ИмяДокумента);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Дата",							"." + СтруктураПоступления.Дата);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Организация",					"." + СтруктураПоступления.Организация);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Контрагент.ГоловнойКонтрагент",	"." + СтруктураПоступления.ГоловнойКонтрагент);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Контрагент",						"." + СтруктураПоступления.Контрагент);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".НомерАктаПриемки",				"." + СтруктураПоступления.НомерАктаПриемки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЗапросПоискаПоНомеруЗаказа", ЗапросПоискаПоНомеруЗаказа(СтруктураПоступления));	
	
	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("Контрагент",			Контрагент);
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("НомерАктаПриемки",	НомерАктаПриемки);
	Запрос.УстановитьПараметр("НомерЗаказа",		НомерЗаказа);
	Запрос.УстановитьПараметр("Дата",				ДатаДокумента);	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ЗапросПоискаПоНомеруЗаказа(СтруктураПоступления)

	Если СтруктураПоступления.Свойство("НомерЗаказа") Тогда
		Если ЗначениеЗаполнено(СтруктураПоступления.НомерЗаказа) Тогда
			
			ТекстЗапроса = "ОБЪЕДИНИТЬ ВСЕ
			|	
			|ВЫБРАТЬ
			|	ПоступлениеТоваровУслуг.Ссылка
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
			|ГДЕ
			|	ПоступлениеТоваровУслуг.НомерЗаказа = &НомерЗаказа
			|	И ПоступлениеТоваровУслуг.Контрагент = &Контрагент
			|	И ПоступлениеТоваровУслуг.Организация = &Организация
			|	И ПоступлениеТоваровУслуг.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -4) И ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 1)
			|	И НЕ ПоступлениеТоваровУслуг.ПометкаУдаления";
			
			Возврат СтрЗаменить(ТекстЗапроса, ".НомерЗаказа", "." + СтруктураПоступления.НомерЗаказа);
			
		Иначе
			Возврат "";	
		КонецЕсли;
		
	Иначе
		Возврат "";	
	КонецЕсли;

КонецФункции

Процедура ЗагрузитьШтрихкодыИСопоставитьДокументы(ДокументЭДО, УчетныйДокумент, ТаблицаКМ)
	
	НачатьТранзакцию();
	
	Попытка
		
		ЗагрузитьКодыМаркировки(УчетныйДокумент, ТаблицаКМ);
		ПометитьДляПроверкиКодовМаркировки(ДокументЭДО, УчетныйДокумент);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		Событие = "Диадок";
		Комментарий = "Не удалось загрузить коды маркировки из электронного документа:
		|" + ПодробноеПредставлениеОшибки(Ошибка);
		
		ЗаписьЖурналаРегистрации(Событие
			, УровеньЖурналаРегистрации.Ошибка
			, УчетныйДокумент.Метаданные()
			, УчетныйДокумент
			, Комментарий);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьДопСвойствоИзКонтента(КонтентXDTO, ТипДокумента, ИмяПоля)
	
	Попытка
		Если ТипДокумента = "invoice" ИЛИ ТипДокумента = "invoicerevision"  Тогда
			Для каждого ЭлементСписка Из СписокXDTOИзЭлемента(КонтентXDTO.StructedAdditionalInfos) Цикл
				Если НРег(ЭлементСписка.Key) = ИмяПоля Тогда
					Возврат ЭлементСписка.Value;
				КонецЕсли;	
			КонецЦикла;
			
		ИначеЕсли ТипДокумента = "universaltransferdocument" 
			ИЛИ ТипДокумента = "universaltransferdocumentrevision" 
			ИЛИ ТипДокумента = "universalcorrectiondocument" Тогда
			Для каждого ЭлементСписка Из СписокXDTOИзЭлемента(КонтентXDTO.AdditionalInfoId.StructedAdditionalInfos) Цикл
				Если НРег(ЭлементСписка.Key) = ИмяПоля Тогда
					Возврат ЭлементСписка.Value;
				КонецЕсли;	
			КонецЦикла;
			
		КонецЕсли;
		
	Исключение
		//Для старых типов документов в формате УПД
		Для каждого ЭлементСписка Из СписокXDTOИзЭлемента(КонтентXDTO.AdditionalInfoId.StructedAdditionalInfos) Цикл
			Если НРег(ЭлементСписка.Key) = ИмяПоля Тогда
				Возврат ЭлементСписка.Value;
			КонецЕсли;	
		КонецЦикла;		
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

