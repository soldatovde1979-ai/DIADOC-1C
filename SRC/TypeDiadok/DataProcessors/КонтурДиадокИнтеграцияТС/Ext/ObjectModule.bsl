Функция ВозможныеДействияСДокументамиВ1С()
	
	Результат = Новый Структура;
	Результат.Вставить("ПустоеДействие", "");
	Результат.Вставить("Отказать", "Отказать");
	Результат.Вставить("Сопоставить", "Сопоставить");
	Результат.Вставить("ПовторитьАнализ", "ПовторитьАнализ");
	Результат.Вставить("СоздатьСчетФактуру", "СоздатьСчетФактуру");
	Результат.Вставить("СоздатьКорректировки", "СоздатьКорректировки");
	Результат.Вставить("ПодписатьСвязанныйУПД", "ПодписатьСвязанныйУПД");
	Результат.Вставить("ЗапроситьАннулирование", "ЗапроситьАннулирование");
	Результат.Вставить("ПродолжитьАнализПослеПроверкиКодовМаркировки", "ПродолжитьАнализПослеПроверкиКодовМаркировки");
	
	Возврат Результат;
	
КонецФункции

Функция ВозможныеДействияСДокументамиВДиадоке()
	
	Результат = Новый Структура;
	Результат.Вставить("ПустоеДействие", "");
	Результат.Вставить("Подписать", "Подписать");
	Результат.Вставить("ОтказатьВПодписи", "ОтказатьВПодписи");
	Результат.Вставить("ЗапроситьУточнение", "ЗапроситьУточнение");
	
	Возврат Результат;
	
КонецФункции

Процедура ПометитьДляПроверкиКодовМаркировки(ДокументДД, УчетныйДокумент)
	
	ЗначенияРеквизитов = Новый Структура;
	ЗначенияРеквизитов.Вставить("ТребуемоеДействиеВ1С", ВозможныеДействияСДокументамиВ1С().ПродолжитьАнализПослеПроверкиКодовМаркировки);
	ЗначенияРеквизитов.Вставить("ТребуемоеДействиеВДД", ВозможныеДействияСДокументамиВДиадоке().ПустоеДействие);
	ЗначенияРеквизитов.Вставить("ДокументУчета", УчетныйДокумент);
	
	ОсновнойМодуль.ЭДО_ЗаписатьРеквизитыДокумента(ДокументДД, ЗначенияРеквизитов);
	
КонецПроцедуры

Функция ВыполнитьТребуемоеДействие(Параметры) Экспорт
	
	ДокументДД			= Параметры.ДокументДД;
	ТребуемоеДействие	= ДокументДД.ТребуемоеДействиеВ1С; 	
	СтруктураКорректировки 	= СтруктураМетаданныхКорректировки();
	СтруктураРегистры		= СтруктураМетаданныхРегистрыПеречисления();
	
	Действия1С = ВозможныеДействияСДокументамиВ1С();
	
	//СОЗДАНИЕ\СОПОСТАВЛЕНИЕ ДОКУМЕНТА СФ (возможно СОЗДАНИЕ ДОКУМЕНТОВ "КОРРЕКТИРОВКА ПОСТУПЛЕНИЯ" для учета расхождений в суммах)
	Если ТребуемоеДействие = Действия1С.СоздатьСчетФактуру 
		ИЛИ ТребуемоеДействие = Действия1С.Сопоставить Тогда
		
		ДокОбъект = ДокументДД.ПолучитьОбъект();		
		ДокументДляСопоставления = ДокОбъект.Документ;
		
		//резервный сценарий для действия "Сопоставить", если сопоставление с ПТУ пропало
		Если Не ЗначениеЗаполнено(ДокументДляСопоставления) Тогда			
			Контрагент	= ДокументДД.КонтрагентДиадок.СвязанныйСправочник1; 
			Организация	= ДокументДД.ОрганизацияДиадок.СвязанныйСправочник1; 
			НомерАкта	= ОсновнойМодуль.ЭДО_СправочникМенеджер_ЗначениеДопРеквизита(ДокументДД, "НомерАктаПриемки");
			ДокументДляСопоставления = НайтиПодходящееПоступление(Контрагент, Организация, НомерАкта, ДокументДД.ДатаДокумента, Неопределено);
			Если ЗначениеЗаполнено(ДокументДляСопоставления) Тогда
				ДокОбъект.Документ = ДокументДляСопоставления.Ссылка;
			Иначе
				ВызватьИсключение "Документ для сопоставления не найден";
			КонецЕсли;			
		КонецЕсли;
		
		//выполенений действий с документами 1С:
		// 1. установка признака "электронный" в ПТУ
		// 2. создание СФ, либо корректировки поступления и СФ на ее основании
		// 3. запись статуса документа в специальный регистр
		Попытка			
			ПтуОбъект = ДокументДляСопоставления.ПолучитьОбъект();
			//Признак "Электронно" в самом поступлении
			Если ЗначениеЗаполнено(СтруктураМетаданныхПоступление().КодСпособаПолучения) Тогда
				ПтуОбъект[СтруктураМетаданныхПоступление().КодСпособаПолучения] = 2;				
				ПтуОбъект.ОбменДанными.Загрузка = Истина;
				ПтуОбъект.Записать();
			КонецЕсли;
			Успешно = Истина;			
			
			//Запись статуса документа в регистр "СтатусыДокументов"
			Если СтруктураРегистры.Свойство("СтатусыДокументов") Тогда
				СтатусПТУ 			= Перечисления.СтатусыДокументовПоступления.ОригиналПолучен;
				СтатусСчетаФактуры	= Перечисления.СтатусыСчетаФактуры.Проведен;
				Успешно = РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокумента(ДокументДляСопоставления, СтатусПТУ, Неопределено, СтатусСчетаФактуры);
			КонецЕсли;
			
		Исключение
			Успешно = Ложь;
			Сообщить("Не удалось записать поступление " + ДокументДляСопоставления + ":" + ОписаниеОшибки());
		КонецПопытки;
		
		Контент = ОсновнойМодуль.ЭДО_ПолучитьСтруктурированныйКонтентВходящегоДокумента(ДокументДД);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("СоздатьСчетФактуру", "СоздатьСФ");
		СтруктураДействий.Вставить("Обработан", "Обработан");
		
		ОтклонениеСуммы	= ОсновнойМодуль.ЭДО_СправочникМенеджер_ЗначениеДопРеквизита(ДокументДД, "ОтклонениеСуммы");
		ОтклонениеНДС	= ОсновнойМодуль.ЭДО_СправочникМенеджер_ЗначениеДопРеквизита(ДокументДД, "ОтклонениеНДС");		
		//Если НЕ ОрганизацияНаУСН(ДокументДляСопоставления.Организация) И ДокументДД.Статус <> "Подписан" И ДокументДД.Статус <> "Откорректирован" Тогда
		Если НЕ ОрганизацияНаУСН(ДокументДляСопоставления.Организация) Тогда
			Успешно		= СоздатьСчетФактуру(ДокОбъект, Контент, СтруктураДействий);	
		КонецЕсли;
		
		//Для учета копеечных расхождений в документах "КорректировкаПоступления"
		Если ЗначениеЗаполнено(ОтклонениеСуммы) ИЛИ ЗначениеЗаполнено(ОтклонениеНДС) Тогда
			ТаблицаНДС	= ПолучитьТаблицуСуммНДСдляУПД(Контент, ДокОбъект.Документ);
			Успешно		= Истина; //СоздатьКорректировкуПоступления(Контент, ДокОбъект, ТаблицаНДС, СтруктураДействий);			
		КонецЕсли;						

		Если Успешно Тогда
			ДокОбъект.ТребуемоеДействиеВ1С = "";
			ДокОбъект.ТребуемоеДействиеВДД = "";
			ДокОбъект.Метка = "РаботаЗавершена";  
			ДокОбъект.Записать();
		КонецЕсли;
		
		
	//ОТКАЗ В ПОДПИСИ ИЛИ ЗАПРОС НА УТОЧНЕНИЕ СФ
	ИначеЕсли ТребуемоеДействие = Действия1С.Отказать Тогда
		
		ДокОбъект = ДокументДД.ПолучитьОбъект();
		ДокОбъект.ТребуемоеДействиеВ1С = "";
		ДокОбъект.ТребуемоеДействиеВДД = "";
		ДокОбъект.Метка = "ЗапрошеноУточнение";  
		ДокОбъект.Записать();
		
		
	//ДЕЙСТВИЯ ПРИ ПОДПИСАНИИ УКД (создание\патч счета-фактуры и подписание связанного УПД)
	ИначеЕсли ТребуемоеДействие = Действия1С.ПодписатьСвязанныйУПД Тогда	
		
		//Если обычный УКД по ошибкам, то нужно найти единственный документ КорректировкаПоступления
		Если ТипЗнч(ДокументДД.Документ)<> Тип("ДокументСсылка." + СтруктураКорректировки.ИмяДокумента) Тогда
			Корректировка = НайтиСуществующуюКорректировкуПоступления(ДокументДД.Документ, Неопределено);
		Иначе
			Корректировка = ДокументДД.Документ; 
		КонецЕсли;		
		
		//Для обычных корректировок по ошибкам - подписание связанного УПД, если он еще не подписан.
		ДокументДД_УПД = НайтиПодходящийУПДдляУКД(ДокументДД);		
		Если ДокументДД_УПД = Неопределено Тогда
			Сообщить("В пакете не найден документ УПД");
		ИначеЕсли ДокументДД_УПД.Статус <> "Подписан" Тогда
			Успешно = ПодписатьСвязанныйДокументДД(ДокументДД_УПД, ДокументДД, ДокументДД_УПД.Документ);
		КонецЕсли;
		
		ДокОбъект = ДокументДД.ПолучитьОбъект();
		ДокОбъект.ТребуемоеДействиеВДД = "";
		ДокОбъект.ТребуемоеДействиеВ1С = ?(Успешно, "", "ПодписатьСвязанныйУПД");		
		ДокОбъект.Метка = ?(Успешно, "РаботаЗавершена", "Получен");
		ДокОбъект.Записать();

		
	//ДЕЙСТВИЕ РУЧНОГО АННУЛИРОВАНИЯ
	ИначеЕсли ТребуемоеДействие = Действия1С.ЗапроситьАннулирование Тогда
		
		Успешно = ЗапроситьАннулированиеДокумента(ДокументДД);
		Если Успешно Тогда
			ДокОбъект = ДокументДД.ПолучитьОбъект();
			ДокОбъект.ТребуемоеДействиеВ1С = "";
			ДокОбъект.ТребуемоеДействиеВДД = "";
			ДокОбъект.ТребуетсяОбработка = Ложь;
			ДокОбъект.ТребуетсяДействие = Ложь;
			ДокОбъект.Метка = "ЗапрошенаАннуляция";  
			ДокОбъект.Записать();			
		КонецЕсли;
		
	//ДЕЙСТВИЕ ДЛЯ ПОМЕТКИ НА ЗАВЕРШЕНИЕ	
	ИначеЕсли ТребуемоеДействие = Действия1С.ПустоеДействие Тогда
		
		Если (ДокументДД.Статус = "Подписан" И ДокументДД.ТребуемоеДействиеВДД = "Подписать")
			ИЛИ (ДокументДД.Статус = "Ожидается уточнение" И ДокументДД.ТребуемоеДействиеВДД = "ЗапроситьУточнение")
			ИЛИ (ДокументДД.Статус = "Ожидается уточнение. Ожидается извещение о получении" И ДокументДД.ТребуемоеДействиеВДД = "ЗапроситьУточнение") 
			ИЛИ (ДокументДД.Статус = "Отказано в подписи контрагенту" И ДокументДД.ТребуемоеДействиеВДД = "ОтказатьВПодписи") Тогда 
			ДокОбъект = ДокументДД.ПолучитьОбъект();
			ДокОбъект.ТребуемоеДействиеВ1С = "";
			ДокОбъект.ТребуемоеДействиеВДД = "";
			ДокОбъект.Метка = "РаботаЗавершена";  
			ДокОбъект.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаполнитьПодписантаВКонтентеДокументаПоДаннымПодписанта(ContentXDTO, ДанныеПодписанта, ПолномочияПодписанта)
				
			ContentXDTO.Signers.Очистить();
			//ExtendedSigner = ContentXDTO.Signers.Добавить(ContentXDTO.Signers.ВладеющееСвойство.Тип.Имя);
            ExtendedSigner = НовыйЭлементСпискаXDTO(ContentXDTO.Signers);
			
			Signer = ExtendedSigner.SignerDetails;
			
			Signer.Status		= ПолномочияПодписанта.SignerStatus;
			Signer.SignerType	= ПолномочияПодписанта.SignerType;
			Signer.Powers		= ПолномочияПодписанта.SignerPowers;
			
			Если ПолномочияПодписанта.Свойство("SignerPowersBase") Тогда
				Signer.PowersBase	= ПолномочияПодписанта.SignerPowersBase;
			КонецЕсли;
			
			Если ПолномочияПодписанта.Свойство("SignerOrganizationName") Тогда
				Signer.OrganizationName	= ПолномочияПодписанта.SignerOrganizationName;
			КонецЕсли;
			
			Если ПолномочияПодписанта.Свойство("SignerOrgPowersBase") 
				И ЗначениеЗаполнено(ПолномочияПодписанта.SignerOrgPowersBase) Тогда
				Signer.OrganizationPowersBase = ПолномочияПодписанта.SignerOrgPowersBase;
			КонецЕсли;
			
			Signer.Surname		= ПолномочияПодписанта.Surname;
			Signer.FirstName	= ПолномочияПодписанта.FirstName;
			
			Если ПолномочияПодписанта.Свойство("Patronymic") Тогда
				Signer.Patronymic		= ПолномочияПодписанта.Patronymic;
			КонецЕсли;
			
			Если ПолномочияПодписанта.Свойство("Inn") Тогда
				//Signer.Inn			= ДанныеПодписанта.ИннСертификата;
				Signer.Inn			= ПолномочияПодписанта.Inn;
			КонецЕсли;
		
			Если ПолномочияПодписанта.Свойство("JobTitle") Тогда
				Signer.JobTitle		= ДанныеПодписанта.Должность;
			КонецЕсли;
				
КонецПроцедуры

Функция ПодписатьСвязанныйДокументДД(ДокументДД_УПД, ДокументДД, ДокументПоступление)
	
	ПакетДД = ДокументДД_УПД.Пакет;
	МассивОшибок = Новый Массив;
	// Формирование контента ответа	
	КонтентОтвета = ОсновнойМодуль.ЭДО_ПолучитьПустойКонтентОтвета(ДокументДД_УПД.ТипКонтента, "Подписать");
	ПодготовитьКонтентОтвета(ДокументДД_УПД, КонтентОтвета, МассивОшибок, ДокументПоступление);	
	
	//Запись контента ответа
	ДокОбъектУПД = ДокументДД_УПД.ПолучитьОбъект();
	Если КонтентОтвета <> Неопределено Тогда
		ДокОбъектУПД.ТребуемоеДействиеВДД = "Подписать";
		ДокОбъектУПД.ТекстОшибки = "";		
		ОсновнойМодуль.ЭДО_ЗаполнитьХранилищеОтвета(ДокОбъектУПД, ОсновнойМодуль.ОбъектXDTOВСтруктуру(КонтентОтвета));
		ДокОбъектУПД.Записать();
		
		//Отправка ответа			
		Попытка
			ОсновнойМодуль.ЭДО_ПодготовитьИОтправитьОтветНаДокумент(ДокументДД_УПД, ПакетДД);	
			Возврат Истина;
		Исключение
			//Сообщить("Не удалось подписать УПД, связанный с УКД "+ ДокументДД + ОписаниеОшибки());
			ДокОбъектУПД.ТребуемоеДействиеВДД = "";
			ДокОбъектУПД.ТекстОшибки = "Возможно УПД уже подписан ранее";
			ДокОбъектУПД.Метка = "РаботаЗавершена";
			ДокОбъектУПД.Записать();
			Возврат Ложь;
		КонецПопытки;	
	КонецЕсли;
	
КонецФункции

