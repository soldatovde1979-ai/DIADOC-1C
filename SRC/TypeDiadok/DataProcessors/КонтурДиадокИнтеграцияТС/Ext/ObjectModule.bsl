Функция ОрганизацияНаУСН(Организация)
	
	СтруктураМетаданных = СтруктураМетаданныхРегистрыПеречисления();
	
	Если ЗначениеЗаполнено(СтруктураМетаданных.УчетнаяПолитика) Тогда
		
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ
		               |	УчетнаяПолитикаОрганизацийСрезПоследних.СистемаНалогообложения
		               |ИЗ
		               |	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "УчетнаяПолитикаОрганизаций",	СтруктураМетаданных.УчетнаяПолитика);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".СистемаНалогообложения",		"." + СтруктураМетаданных.СистемаНалогообложения + " КАК СистемаНалогообложения");
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("Организация", Организация);
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если РезультатЗапроса.Следующий() Тогда
			Возврат РезультатЗапроса.СистемаНалогообложения = СтруктураМетаданных.Упрощенная;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Ложь; 	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТаблицуСуммНДСдляУПД(КонтентДокумента, Документ1С)
	
	СтруктураПТУ = СтруктураМетаданныхПоступление();
	
	//вычислим сумму по ставкам ндс
	ТаблицаНДС = Новый ТаблицаЗначений;
	ТаблицаНДС.Колонки.Добавить("СтавкаНДС");
	ТаблицаНДС.Колонки.Добавить("СуммаНДС");
	ТаблицаНДС.Колонки.Добавить("СуммаСНДС");
	ТаблицаНДС.Колонки.Добавить("СуммаБезНДС");
	ТаблицаНДС.Колонки.Добавить("СуммаНДС_1С");
	
	//Получить InvoiceTable из контента для 820\155 формата
	Если КонтентДокумента.Свойства().Получить("InvoiceTable") <> Неопределено Тогда
		InvoiceTable = КонтентДокумента.InvoiceTable;
	ИначеЕсли КонтентДокумента.Свойства().Получить("Table") <> Неопределено Тогда
		InvoiceTable = КонтентДокумента.Table;
	КонецЕсли;
	
	//Получить суммы из контента
	для Каждого Item Из InvoiceTable.Items Цикл
		стр = ТаблицаНДС.Добавить();
		стр.СтавкаНДС	= Item.TaxRate;
		стр.СуммаНДС	= Item.Vat;
		стр.СуммаБезНДС	= Item.SubtotalWithVatExcluded;
		стр.СуммаСНДС	= Item.Subtotal; 
	КонецЦикла;
	
	Для каждого стрДок Из Документ1С[СтруктураПТУ.Товары] Цикл 
		стр = ТаблицаНДС.Добавить();
		стр.ставкаНДС	= ПривестиСтавкуНДС(стрДок[СтруктураПТУ.СтавкаНДС]);
		стр.СуммаНДС_1С	= стрДок[СтруктураПТУ.СуммаНДС];
	КонецЦикла;
	
	///Проверка наличия табличной части "Услуги"
	Если ЗначениеЗаполнено(СтруктураПТУ.Услуги) Тогда
		Для каждого стрДок Из Документ1С[СтруктураПТУ.Услуги] Цикл 
			стр = ТаблицаНДС.Добавить();
			стр.СтавкаНДС	= ПривестиСтавкуНДС(стрДок[СтруктураПТУ.СтавкаНДС]);
			стр.СуммаНДС_1С	= СтрДок[СтруктураПТУ.СуммаНДС];
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаНДС.Свернуть("СтавкаНДС", "СуммаНДС, СуммаСНДС, СуммаБезНДС, СуммаНДС_1С");
	
	Возврат ТаблицаНДС;
	
КонецФункции

Функция СтранаПроисхожденияЧленТС(КодСтраны)
	
	Возврат ЗначениеЗаполнено(КодСтраны)
	И (КодСтраны = "051"  //Армения
	Или КодСтраны = "112"  //Беларусь
	Или КодСтраны = "398"  //Казахстан
	Или КодСтраны = "417"  //Киргизия
	Или КодСтраны = "643");  //Россия
	
КонецФункции

Функция ПривестиСтавкуНДС(СтавкаНДС)
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда 
		Возврат "18"
	ИначеЕсли 	СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда 
		Возврат "10"
	ИначеЕсли 	СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда 
		Возврат "0"
	ИначеЕсли 	СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда 
		Возврат "БезНДС"
	Иначе 
		Возврат "некорректнаяставка ндс"
	КонецЕсли;
	
КонецФункции	

//#Область Маркировка

// Создает новую таблицу значений для штрихкодов упаковок.
// В прикладных документах должна существовать табличная часть с аналогичным набором колонок.
// См. ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок()
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица значений штрихкодов упаковок:
//    * ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров - Штрихкод упаковки
//    * ЗначениеШтрихкода - Строка - Значение штрихкода
//
Функция НоваяТаблицаШтрихкодыУпаковок()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ШтрихкодУпаковки");
	Результат.Колонки.Добавить("ЗначениеШтрихкода");
	
	Возврат Результат;
	
КонецФункции

// Получает таблицу со всеми кодами маркировки из электронного документа
//
// Параметры:
//  ДокументЭДО - Структура - сведения об электронном документе (см. ХранениеДанных.Документы_ДанныеДокумента)
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. НоваяТаблицаШтрихкодыУпаковок
//
Функция ШтрихкодыУпаковокЭлектронногоДокумента(ДокументЭДО)
	
	Результат = НоваяТаблицаШтрихкодыУпаковок();
	
	Контент = ОсновнойМодуль.ЭДО_ПолучитьХранилищеКонтента(ДокументЭДО);
	ТабличнаяЧасть = ОсновнойМодуль.ЭДО_ПолучитьТабличнуюЧастьИзКонтентаXML(Контент);
	
	Для Каждого СтрокаДокумента Из ТабличнаяЧасть Цикл
		
		ДополнитьТаблицуШтрихкодов(Результат, СтрокаДокумента.СведенияОМаркировке);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет коды маркировки из строки электронного документа в общую таблицу штрихкодов ЭД.
//
// Параметры:
//  ШтрихкодыУпаковок	 - ТаблицаЗначений - таблица с кодами маркировки (см НоваяТаблицаШтрихкодыУпаковок)
//  СведенияОМаркировке	 - Структура - сведения о маркировке (см. НовыйСведенияОМаркировке)
//
Процедура ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, СведенияОМаркировке)
	
	Если Не ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ИндивидуальныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ТранспортныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, встроена ли в конфигурацию библиотека интеграции с ИС МП.
// 
// Возвращаемое значение:
//  Булево - Истина, если подсистема есть.
//
Функция ИспользуетсяБиблиотекаИнтеграцииИСМП()
	
	Результат = Ложь;
	
	ПодсистемаГосИС = Метаданные.Подсистемы.Найти("ГосИС");
	
	Если ПодсистемаГосИС <> Неопределено
		И ПодсистемаГосИС.Подсистемы.Найти("ИСМП") <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор новой таблицы для записи расхождений между физическими кодами маркировки
// и кодами из электронного документа.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//    * ЗначениеШтрихкода - Строка - код маркировки
//    * ЭтоИзлишек - Булево - Истина, если код отсутствует в электронном документе.
//
Функция НоваяТаблицаРасхожденийКодовМаркировки()
	
	ПараметрыСтроки200 = Новый КвалификаторыСтроки(200);
	ТипСтрока200 = Новый ОписаниеТипов("Строка", ПараметрыСтроки200);
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТаблицаРасхождений = Новый ТаблицаЗначений;
	ТаблицаРасхождений.Колонки.Добавить("ЗначениеШтрихкода", ТипСтрока200);
	ТаблицаРасхождений.Колонки.Добавить("ЭтоИзлишек", ТипБулево);
	
	Возврат ТаблицаРасхождений;
	
КонецФункции

// Анализирует результаты проверки кодов маркировки и заполняет таблицу
// расхождений между физическими кодами и кодами из ЭД.
//
// Параметры:
//  СсылкаНаОбъект - Произвольный - объект-владелец штрихкодов (учетный документ)
// 
// Возвращаемое значение:
//  ТаблицаРасхождений - ТаблицаЗначений - расшифровка расхождений по кодам (см. НоваяТаблицаРасхожденийКодовМаркировки)
//
Функция ТаблицаРасхожденийПоРезультатамПроверкиКодовМаркировки(СсылкаНаОбъект)
	
	ТаблицаРасхождений = НоваяТаблицаРасхожденийКодовМаркировки();
	
	Если ИспользуетсяБиблиотекаИнтеграцииИСМП() Тогда
		ЗаполнитьТаблицуРасхожденийКодовМаркировкиИСМП(СсылкаНаОбъект, ТаблицаРасхождений);
	Иначе
		ЗаполнитьТаблицуРасхожденийКодовМаркировкиПереопределяемый(СсылкаНаОбъект, ТаблицаРасхождений);
	КонецЕсли;
	
	Возврат ТаблицаРасхождений;
	
КонецФункции

// Загружает коды маркировки из электронного документа в информационную базу.
//
// Параметры:
//  СсылкаНаОбъект - Произвольный - объект-владелец штрихкодов (учетный документ)
//  ШтрихкодыУпаковок - ТаблицаЗначений - см. НоваяТаблицаШтрихкодыУпаковок
//
Процедура ЗагрузитьКодыМаркировки(СсылкаНаОбъект, ШтрихкодыУпаковок)
	
	Если Не ЗначениеЗаполнено(ШтрихкодыУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяБиблиотекаИнтеграцииИСМП() Тогда
		ЗагрузитьКодыМаркировкиИСМП(СсылкаНаОбъект, ШтрихкодыУпаковок);
	Иначе
		ЗагрузитьКодыМаркировкиПереопределяемый(СсылкаНаОбъект, ШтрихкодыУпаковок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьКодыМаркировкиИСМП(СсылкаНаОбъект, ШтрихкодыУпаковок)
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	Если МетаданныеОбъекта.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект = СсылкаНаОбъект.ПолучитьОбъект();
	Объект.Заблокировать();
	Объект.ШтрихкодыУпаковок.Загрузить(ШтрихкодыУпаковок);
	Объект.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура ЗагрузитьКодыМаркировкиПереопределяемый(СсылкаНаОбъект, ШтрихкодыУпаковок)
	
	Ошибка = "Загрузка кодов маркировки не реализована!";
	ВызватьИсключение Ошибка;
	
КонецПроцедуры

// Получает состояние проверки кодов маркировки по документу.
//
// Параметры:
//  СсылкаНаОбъект - Произвольный - объект-владелец штрихкодов (учетный документ)
// 
// Возвращаемое значение:
//  Булево - Истина, если проверка кодов маркировки завершена.
//
Функция ПроверкаКодовМаркировкиВыполнена(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	Если ИспользуетсяБиблиотекаИнтеграцииИСМП() Тогда
		ПолучитьСтатусПроверкиКодовМаркировкиИСМП(СсылкаНаОбъект, Результат);
	Иначе
		ПолучитьСтатусПроверкиКодовМаркировкиПереопределяемый(СсылкаНаОбъект, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФинальныеСтатусыПроверкиКодовМаркировкиИСМП()
	
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.СтатусыПроверкиИПодбораИС.Завершено);
	
	Возврат Результат;
	
КонецФункции

Процедура ПолучитьСтатусПроверкиКодовМаркировкиИСМП(СсылкаНаОбъект, ПроверкаВыполнена = Ложь)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МИНИМУМ(ВЫБОР
	|				КОГДА СтатусыПроверки.СтатусПроверкиИПодбора В (&ДопустимыеСтатусы)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ), ЛОЖЬ) КАК ПроверкаВыполнена
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиИПодбораДокументовИСМП КАК СтатусыПроверки
	|ГДЕ
	|	СтатусыПроверки.Документ = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДопустимыеСтатусы", ФинальныеСтатусыПроверкиКодовМаркировкиИСМП());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПроверкаВыполнена = Выборка.ПроверкаВыполнена;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьСтатусПроверкиКодовМаркировкиПереопределяемый(СсылкаНаОбъект, ПроверкаВыполнена = Ложь)
	
	Ошибка = "Получение статуса проверки кодов маркировки не реализовано!";
	ВызватьИсключение Ошибка;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуРасхожденийКодовМаркировкиИСМП(СсылкаНаОбъект, ТаблицаРасхождений)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СтатусыПроверки.Документ КАК Документ,
	|	СтатусыПроверки.ВидМаркируемойПродукции КАК ВидМаркируемойПродукции,
	|	СтатусыПроверки.ДанныеПроверкиИПодбора КАК ДанныеПроверкиИПодбора,
	|	СтатусыПроверки.СтатусПроверкиИПодбора КАК СтатусПроверкиИПодбора,
	|	СтатусыПроверки.ТребуемоеДействиеЭДО КАК ТребуемоеДействиеЭДО
	|ИЗ
	|	РегистрСведений.СтатусыПроверкиИПодбораДокументовИСМП КАК СтатусыПроверки
	|ГДЕ
	|	СтатусыПроверки.Документ = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеПроверки = Выборка.ДанныеПроверкиИПодбора.Получить();
		
		Если ТипЗнч(ДанныеПроверки) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		ДеревоМаркированнойПродукции = ДанныеПроверки.ДеревоМаркированнойПродукции;
		
		Для Каждого СтрокаДерева Из ДеревоМаркированнойПродукции.Строки Цикл
			
			ЗаполнитьТаблицуРасхожденийПоСтрокеДерева(СтрокаДерева, ТаблицаРасхождений);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// См. Обработки.Обработки.ПроверкаИПодборПродукцииИСМП.ЗаполнитьТаблицуРасхожденийПоСтрокеДерева
//
Процедура ЗаполнитьТаблицуРасхожденийПоСтрокеДерева(СтрокаДерева, ТаблицаРасхождений)
	
	ЭтоИзлишек = (СтрокаДерева.СтатусПроверки = Перечисления.СтатусыПроверкиНаличияПродукцииИС.НеЧислилась
	             Или СтрокаДерева.СтатусПроверки = СтрокаДерева.НеСодержитсяВДанныхДокумента);
	
	ЭтоНедостача = СтрокаДерева.СтатусПроверки = Перечисления.СтатусыПроверкиНаличияПродукцииИС.Отсутствует;
	
	ЭтоТипУпаковкиПоКоторомуФиксируютсяРасхождения = (СтрокаДерева.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка
	                                                  Или СтрокаДерева.ТипУпаковки = Перечисления.ТипыУпаковок.МаркированныйТовар);
	
	ВозможнаПроверкаПодчиненныхСтрок = (СтрокаДерева.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка
	                                   Или СтрокаДерева.ТипУпаковки = Перечисления.ТипыУпаковок.МультитоварнаяУпаковка
	                                   Или СтрокаДерева.ТипУпаковки = Перечисления.ПрочиеЗоныПересчетаПродукцииИСМП.ПродукцияБезУпаковки); 
	
	Если ЭтоТипУпаковкиПоКоторомуФиксируютсяРасхождения
		И (ЭтоИзлишек Или ЭтоНедостача) Тогда
		
		НоваяСтрокаТаблицы = ТаблицаРасхождений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаДерева);
		НоваяСтрокаТаблицы.ЗначениеШтрихкода = СтрокаДерева.Штрихкод;
		НоваяСтрокаТаблицы.ЭтоИзлишек = ЭтоИзлишек;
		
		Возврат;
		
	КонецЕсли; 
	
	Если ВозможнаПроверкаПодчиненныхСтрок Тогда
		
		Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
			
			ЗаполнитьТаблицуРасхожденийПоСтрокеДерева(ПодчиненнаяСтрока, ТаблицаРасхождений);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуРасхожденийКодовМаркировкиПереопределяемый(СсылкаНаОбъект, ТаблицаРасхождений)
	
	Ошибка = "Заполнение таблицы расхождений кодов маркировки не реализовано!";
	ВызватьИсключение Ошибка;
	
КонецПроцедуры

