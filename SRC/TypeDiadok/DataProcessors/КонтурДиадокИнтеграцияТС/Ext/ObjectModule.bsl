Функция ТребуетсяПродолжитьАнализПослеПроверкиКодовМаркировки(ДокументДД)
	
	ДействияВ1С = ВозможныеДействияСДокументамиВ1С();
	Результат = (ДокументДД.ТребуемоеДействиеВ1С = ДействияВ1С.ПродолжитьАнализПослеПроверкиКодовМаркировки);
	
	Возврат Результат;
	
КонецФункции

Процедура ПродолжитьАнализПослеПроверкиКодовМаркировки(ДокументДД, РезультатАнализа)
	
	УчетныйДокумент = ДокументДД.Документ;
	
	Если Не ПроверкаКодовМаркировкиВыполнена(УчетныйДокумент) Тогда
		// Анализ продолжать нельзя
		РезультатАнализа = Неопределено;
		Возврат;
	КонецЕсли;
	
	ДействияВ1С = ВозможныеДействияСДокументамиВ1С();
	ДействияВДД = ВозможныеДействияСДокументамиВДиадоке();
	
	ТаблицаРасхождений = ТаблицаРасхожденийПоРезультатамПроверкиКодовМаркировки(УчетныйДокумент);
	
	ДействиеВДД = ДействияВДД.Подписать;
	ДействиеВ1С = ДействияВ1С.ПустоеДействие;
	Ошибки = Новый Массив;
	
	Если ЗначениеЗаполнено(ТаблицаРасхождений) Тогда
		
		КомментарийУоУ = ТекстУведомленияОбУточнении(ТаблицаРасхождений);
		
		ДействиеВДД = ДействияВДД.ЗапроситьУточнение;
		Ошибки.Добавить(КомментарийУоУ);
		
	КонецЕсли;
	
	ТипКонтента = ДокументДД.ТипКонтента;
	КонтентОтвета = ОсновнойМодуль.ЭДО_ПолучитьПустойКонтентОтвета(ТипКонтента, ДействиеВДД);
	ПодготовитьКонтентОтвета(ДокументДД, КонтентОтвета, Ошибки, УчетныйДокумент);
	
	ЗаполнитьРезультатАнализа(РезультатАнализа
		, УчетныйДокумент
		, ДействиеВ1С
		, ДействиеВДД
		, Ошибки
		, КонтентОтвета);
	
КонецПроцедуры

Функция ТекстУведомленияОбУточнении(ТаблицаРасхождений)
	
	Результат = "";
	
	Излишки = Новый Массив;
	Недостатки = Новый Массив;
	
	Для Каждого Стр Из ТаблицаРасхождений Цикл
		
		ТекущийКод = Стр.ЗначениеШтрихкода;
		Если Стр.ЭтоИзлишек Тогда
			Излишки.Добавить(ТекущийКод);
		Иначе
			Недостатки.Добавить(ТекущийКод);
		КонецЕсли;
		
	КонецЦикла;
	
	НомерСтрокиЭД = "NUMSTR1";
	
	Если ЗначениеЗаполнено(Излишки) Тогда
		Результат = Результат + "MARKACCEPTED:" + НомерСтрокиЭД + КодыМаркировкиСтрокой(Излишки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Недостатки) Тогда
		Результат = Результат + "MARKDECLINED:" + НомерСтрокиЭД + КодыМаркировкиСтрокой(Недостатки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодыМаркировкиСтрокой(КоллекцияКодов)
	
	Результат = "";
	
	Для Каждого Код Из КоллекцияКодов Цикл
		
		Результат = Результат + "|" + Код + "|";
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//счет фактура
Функция СоздатьСчетФактуру(ДокументДД, Контент, СтруктураДействийПоДокументу)
	
	ДокументПТУ		= ДокументДД.Документ;
	СтруктураПТУ	= СтруктураМетаданныхПоступление();
	
	Если ЗначениеЗаполнено(СтруктураПТУ.ПредъявленСчетФактура) 
	   	И ДокументПТУ[СтруктураПТУ.ПредъявленСчетФактура] Тогда
		
		ПНК_Объект = ДокументПТУ.ПолучитьОбъект();
		ПНК_Объект[СтруктураПТУ.ПредъявленСчетФактура] = Ложь;
		ПНК_Объект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;	 
	
	//Если поставщик без НДС - не создаем СФ
	//Если организация на УСН - не создаем СФ (в процедуре СоздатьКорректировкуПоступления)

	//КонтрагентПлательщикНДС = ДокументПТУ[СтруктураМетаданныхПоступление().Контрагент][СтруктураМетаданныхСправочники().ЮрФизЛицо] <> СтруктураМетаданныхРегистрыПеречисления().ФизическоеЛицо;		
	
	////Плательщик НДС определяется по сумме НДС в ПТУ	
	КонтрагентПлательщикНДС = (ДокументПТУ.Товары.Итог("СуммаНДС") > 0);
	
	Если КонтрагентПлательщикНДС Тогда 
		СФПолученный = СоздатьНовыйСчетФактуру(ДокументДД, Контент);
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Если СФПолученный <> Неопределено Тогда
    	Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СоздатьНовыйСчетФактуру(ДокументДД, Контент)
	
	СтруктураСФ 	= СтруктураМетаданныхСФ();
	
	ЭДОбъект		= Контент;
	СФПолученный	= Документы[СтруктураСФ.ИмяДокумента].СоздатьДокумент();	
	ДокументОснование = ДокументДД.Документ;
	
	Если ДокументОснование = Неопределено Тогда
		Сообщить("По документу Диадока" + ДокументДД + "не найдено соответствующее поступление");
		Возврат Неопределено;
	Иначе
		
		СФ = НайтиПодходящийСчетФактуруИзРНК(ДокументОснование);
		Если СФ <> Неопределено Тогда
			СФПолученный = СФ.ПолучитьОбъект();			
			Если ЗначениеЗаполнено(СтруктураСФ.ДокументыОснования) Тогда
				СФПолученный[СтруктураСФ.ДокументыОснования].Очистить();
			КонецЕсли;			
			Если ЗначениеЗаполнено(СтруктураСФ.ДокументОснование) Тогда
				СФПолученный[СтруктураСФ.ДокументОснование] = Неопределено;
			КонецЕсли;
			
			//Промежуточная запись документа СФ
			//Не всегда работает в режиме загрузки данных
			//СФПолученный.ОбменДанными.Загрузка = Истина;
			СФПолученный.Записать(РежимЗаписиДокумента.Проведение);
			СФПолученный.ОбменДанными.Загрузка = Ложь;
		КонецЕсли;
		
		СФПолученный.Заполнить(ДокументОснование);
		ПараметрыСФ = Неопределено;		
		Если ЗначениеЗаполнено(СтруктураСФ.ВыполнитьЗаполнитьПараметрыСФ) Тогда
			Выполнить(СтруктураСФ.ВыполнитьЗаполнитьПараметрыСФ);
		ИначеЕсли ЗначениеЗаполнено(СтруктураСФ.ВычислитьЗаполнитьПараметрыСФ) Тогда
			ПараметрыСФ = Вычислить(СтруктураСФ.ВычислитьЗаполнитьПараметрыСФ);
		КонецЕсли; 
		
		Если ПараметрыСФ <> Неопределено Тогда			
			СФПолученный[СтруктураСФ.СуммаДокумента] = ПараметрыСФ.СуммаДокумента;
			
			Если ЗначениеЗаполнено(СтруктураСФ.СуммаНДСДокумента) Тогда
				СФПолученный[СтруктураСФ.СуммаНДСДокумента] = ПараметрыСФ.СуммаНДСДокумента;
			КонецЕсли;			
		КонецЕсли; 
	КонецЕсли;
	
	Если ДокументДД.Направление = "Inbound" ИЛИ ДокументДД.Направление = "Входящее" Тогда
		
		Если ЗначениеЗаполнено(СтруктураСФ.НомерВходящегоДокумента) Тогда
			Если ДокументДД.ТипДокумента = "UniversalTransferDocument" Тогда   				
				СФПолученный[СтруктураСФ.НомерВходящегоДокумента]	= ДокументДД.НомерДокумента;
				СФПолученный[СтруктураСФ.ДатаВходящегоДокумента]	= ДокументДД.ДатаДокумента;
				
			ИначеЕсли ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда 
				СФПолученный[СтруктураСФ.НомерИсправления]	= ДокументДД.НомерДокумента;
				СФПолученный[СтруктураСФ.ДатаИсправления]	= ДокументДД.ДатаДокумента;
				СФПолученный[СтруктураСФ.Исправление]		= Истина;
				//для ИСФ установка галки "Отразить вычет НДС в книге покупок"
				СФПолученный[СтруктураСФ.НДСПредъявленКВычету]		= Истина;
				СФПолученный[СтруктураСФ.НомерВходящегоДокумента]	= ЭДОбъект.Number;
				СФПолученный[СтруктураСФ.ДатаВходящегоДокумента] 	= ЭДОбъект.Date;
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураСФ.ВхДокНомер) Тогда			
			СФПолученный[СтруктураСФ.ВхДокНомер]	= ЭДОбъект.DocumentNumber;
			СФПолученный[СтруктураСФ.ВхДокДата]		= ЭДОбъект.DocumentDate;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтруктураСФ.КодВидаОперации) Тогда 
		СФПолученный[СтруктураСФ.КодВидаОперации] = "01"
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураСФ.КодСпособаПолучения) Тогда 
		СФПолученный[СтруктураСФ.КодСпособаПолучения] = 2
	КонецЕсли;	 
	
	УстановитьДоговорВСчетеФактуреДляДиадок(СФПолученный);
	Попытка
		//для ИУПД учет по дате исправления, а не по дате сделки
		ДатаПоставки		= ?(СФПолученный[СтруктураСФ.ДокументыОснования].Количество() > 0, СФПолученный[СтруктураСФ.ДокументыОснования][0].ДокументОснование.Дата, Неопределено);
		ДатаПоставкиИспр	= ?(ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision", СФПолученный[СтруктураСФ.ДатаИсправления], ДатаПоставки);
		
		СФПолученный[СтруктураСФ.Дата]	= ПолучитьДатуУчетаСФ(ДатаПоставкиИспр, СФПолученный[СтруктураСФ.ДатаВходящегоДокумента], ДокументДД.ДатаЗагрузки, СФПолученный[СтруктураСФ.Организация]);
		СФПолученный.Записать(РежимЗаписиДокумента.Проведение);
		
		Возврат СФПолученный;	
	Исключение
		Сообщить("Ошибка! Не удалось записать счет-фактуру" + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

//корректировка
Функция СоздатьКорректировкуПоступления(Контент, ДокументДД, ТаблицаНДС, СтруктураДействийПоДокументу)
	
	//Пример процедуры создания документа "Корректировка поступления" 
	//Используется в ТС Елисей для учета допустимых расхождений, меньще 1 руб.
	ДокументПоступления =   ДокументДД.Документ;
	СуммаБезНДС10 = 0;
	СуммаБезНДС18 = 0;
	СуммаБезНДС20 = 0;
	СуммаСНДС10 = 0;
	СуммаСНДС18 = 0;
	СуммаСНДС20 = 0;
	СуммаБезНДС = 0;

	Для Каждого стр Из ТаблицаНДС Цикл 
		Если стр.СтавкаНДС = "20" Тогда 
			СуммаСНДС20 	= стр.СуммаСНДС;
			СуммаБезНДС20 	= стр.СуммаСНДС - стр.СуммаНДС;
		ИначеЕсли стр.СтавкаНДС = "18" Тогда 
			СуммаСНДС18 	= стр.СуммаСНДС;
			СуммаБезНДС18 	= стр.СуммаСНДС - стр.СуммаНДС;
		ИначеЕсли стр.СтавкаНДС = "10" Тогда 
			СуммаСНДС10 	= стр.СуммаСНДС;
			СуммаБезНДС10	= стр.СуммаСНДС - стр.СуммаНДС;
		ИначеЕсли стр.СтавкаНДС = "0" Тогда 
			СуммаБезНДС 	= стр.СуммаСНДС;			
		ИначеЕсли стр.СтавкаНДС = "без НДС" Тогда 
			СуммаБезНДС 	= стр.СуммаСНДС;
		Иначе
			ДокОбъект = ДокументДД.ПолучитьОбъект();
			ДокОбъект.ТекстОшибки = "Некорректная ставка НДС "+стр.СтавкаНДС;
			ДокОбъект.Записать();
			Возврат Ложь;
		КонецЕсли;	  
	КонецЦикла;
	 
	Параметры = Новый Структура;
	Параметры.Вставить("ДокументПоступления", ДокументПоступления);
	Параметры.Вставить("СуммаБезНДС10", СуммаБезНДС10);
	Параметры.Вставить("СуммаБезНДС18", СуммаБезНДС18);
	Параметры.Вставить("СуммаБезНДС20", СуммаБезНДС20);	
	Параметры.Вставить("СуммаСНДС10", СуммаСНДС10);
	Параметры.Вставить("СуммаСНДС18", СуммаСНДС18);
	Параметры.Вставить("СуммаСНДС20", СуммаСНДС20);	
	Параметры.Вставить("СуммаБезНДС", СуммаБезНДС);     //Сумма по ставке БезНДС
	
	ДатаКорректировки = ПолучитьДатуУчетаСФ(ДокументПоступления.Дата, ДокументДД.ДатаДокумента, ДокументДД.ДатаЗагрузки, ДокументПоступления.Организация);
	Если ДокументДД.ТипДокумента = "UniversalTransferDocument" Тогда
		Параметры.Вставить("ЭтоИСФ", Ложь); 		
		Параметры.Вставить("СоздаватьСчетФактуру", ?(ОрганизацияНаУСН(ДокументДД.Документ.Организация), Ложь, Истина));    
		Параметры.Вставить("НомерСчФ", ДокументДД.НомерДокумента);     
		Параметры.Вставить("ДатаСчФ", ДокументДД.ДатаДокумента);  		
		
	ИначеЕсли  ДокументДД.ТипДокумента = "UniversalTransferDocumentRevision" Тогда
		Параметры.Вставить("ЭтоИСФ", Истина);     
		Параметры.Вставить("СоздаватьСчетФактуру", ?(ОрганизацияНаУСН(ДокументДД.Документ.Организация), Ложь, Истина));		
		Параметры.Вставить("НомерСчФ", Контент.Number);     
		Параметры.Вставить("ДатаСчФ", Контент.Date);  
		Параметры.Вставить("НомерИСФ", ДокументДД.НомерДокумента);     
		Параметры.Вставить("ДатаИСФ", ДокументДД.ДатаДокумента);
										//ДатаКорректировки - для ИУПД по дате исправления
		ДатаКорректировки = ПолучитьДатуУчетаСФ(ДокументДД.ДатаДокумента, ДокументДД.ДатаДокумента, ДокументДД.ДатаЗагрузки, ДокументПоступления.Организация);
	КонецЕсли;
	
	Параметры.Вставить("ДатаКорректировки", ДатаКорректировки);
	Параметры.Вставить("ОрганизацияНаУСН", ?(ОрганизацияНаУСН(ДокументДД.Документ.Организация), Истина, Ложь));
	
	Сообщение = "";	
	ДокументКоррСсылка = СоздатьДокументКорректировкаПоступления(Параметры, Сообщение, Истина);
	
	Если ДокументКоррСсылка = Неопределено ИЛИ ДокументКоррСсылка = Ложь Тогда
		Сообщение = "Не удалось создать корректировку.
					| " + Сообщение + "
					| " + ИнформацияОбОшибке().Описание;								
		//ОсновнойМодуль.ЭДО_СправочникМенеджер_УстановитьЗначениеДопРеквизита(ДокументДД, "ОшибкиПроверкиТекст", Сообщение);
		ДокОбъект = ДокументДД.ПолучитьОбъект();
		ДокОбъект.ТекстОшибки = Сообщение;
		ДокОбъект.Записать();
		
	ИначеЕсли Параметры.СоздаватьСчетФактуру Тогда
		СчетФактура = НайтиПодходящийСчетФактуруИзРНК(ДокументКоррСсылка);
		Если ЗначениеЗаполнено(СчетФактура) = Ложь Тогда
			ОбъектСчетаФактуры = СоздатьПодчиненнуюСчетФактуру(ДокументКоррСсылка, Параметры);
			
			Если ОбъектСчетаФактуры = Неопределено Тогда
				Сообщение = "Не удалось создать документ " + ОбъектСчетаФактуры + " 
				| " + ИнформацияОбОшибке().Описание;
				ДокОбъект = ДокументДД.ПолучитьОбъект();
				ДокОбъект.ТекстОшибки = Сообщение;
				ДокОбъект.Записать();
				
				Результат = Ложь;
			Иначе
				Результат = Истина;
			КонецЕсли;		
		Иначе
			Результат = Истина;
		КонецЕсли;
		
	Иначе //Для организаций на УСН (Параметры.СоздаватьСчетФактуру = Ложь)
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат; //Истина - на основании корректировки поступления создан документ СФ
	
КонецФункции

Функция СоздатьДокументКорректировкаПоступления(Параметры, Сообщение, ПереписыватьКорректировку = Ложь) Экспорт
	
	ДокументПТУ	= Параметры.ДокументПоступления;
	
	Если НЕ ЗначениеЗаполнено(ДокументПТУ) Тогда
		Сообщение = "Не выбран документ поступления. ";
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураПТУ		= СтруктураМетаданныхПоступление();
	СтруктураКор		= СтруктураМетаданныхКорректировки();
	ИсправлениеОшибки	= СтруктураМетаданныхРегистрыПеречисления().ИсправлениеОшибки;
	
	ДокументКорр		= НайтиСуществующуюКорректировкуПоступления(ДокументПТУ.Ссылка, Неопределено);
			
	Если ЗначениеЗаполнено(ДокументКорр) 
		И ДокументКорр[СтруктураКор.ВидОперации] = ИсправлениеОшибки Тогда
		
		Если НЕ ПереписыватьКорректировку Тогда
			Сообщить("Между документом в Диадок и ПТУ в 1С есть расхождение по Сумме НДС. В базе 1С существует корректировка поступления № "
						+ ДокументКорр[СтруктураКор.Номер] + " от " + ДокументКорр[СтруктураКор.Дата] + ". " + Символы.ПС + "Автоматическое создание Счета-фактуры не возможно.");			
			Возврат Ложь;
		Иначе
			ОбъектДокументКорр = ДокументКорр.ПолучитьОбъект();
		КонецЕсли;
		
	Иначе
		
		ОбъектДокументКорр = Документы[СтруктураКор.ИмяДокумента].СоздатьДокумент();
		
		ОбъектДокументКорр[СтруктураКор.Дата]			= Параметры.ДатаКорректировки;
		ОбъектДокументКорр[СтруктураКор.ВидОперации]	= ИсправлениеОшибки;
        ОбъектДокументКорр[СтруктураКор.Комментарий]	= "Получен из ДИАДОК"; 
		
		Если ЗначениеЗаполнено(СтруктураКор.НомерИсправления) Тогда
			ОбъектДокументКорр[СтруктураКор.НомерИсправления]	= "1";
			ОбъектДокументКорр[СтруктураКор.ДатаИсправления]	= Параметры.ДатаКорректировки;
		КонецЕсли;
		
		ОбъектДокументКорр.Заполнить(ДокументПТУ.Ссылка); 
		
	КонецЕсли;
	
	//  Если идет сумма с НДС, то на самом деле в параметрах сумма не содержит НДС.
	//  Для организаций на УСН наоборот - в параметрах идет сумма без НДС, хотя СуммаВключаетНДС=Истина 	
	//  НО при этом в корректировку не передается СуммаНДС, ее нужно рассчитывать

	СтруктураСумм = Новый Структура;
	СтруктураСумм.Вставить("СуммаВключаетНДС",	ДокументПТУ[СтруктураПТУ.СуммаВключаетНДС]);
	СтруктураСумм.Вставить("СуммаПТУ", 			ДокументПТУ[СтруктураПТУ.СуммаДокумента]);
	
	Если ЗначениеЗаполнено(СтруктураКор.Товары) Тогда
		ЗаполнитьТЧКорректировки(ОбъектДокументКорр[СтруктураКор.Товары], Параметры, СтруктураСумм);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(СтруктураКор.Услуги) Тогда
		ЗаполнитьТЧКорректировки(ОбъектДокументКорр[СтруктураКор.Услуги], Параметры, СтруктураСумм);
	КонецЕсли; 
	
	Попытка
		ОбъектДокументКорр.Записать(РежимЗаписиДокумента.Проведение);		
		Возврат ОбъектДокументКорр.Ссылка;
	Исключение
		Сообщение = "Невозможно записать и провести документ." + ОбъектДокументКорр + " 
					|" + ИнформацияОбОшибке().Описание;
		Возврат Неопределено;
	КонецПопытки;
		
КонецФункции

Процедура ЗаполнитьТЧКорректировки(ТЧ, Параметры, СтруктураСумм)
	
	СтруктураКор = СтруктураМетаданныхКорректировки();
	
	СуммаНДСизПТУ = 0;
	
	Для Каждого Товар Из ТЧ Цикл
		СуммаНДСизПТУ = СуммаНДСизПТУ + Товар[СтруктураКор.СуммаНДСДоИзменения];
	КонецЦикла;
	
	Для Каждого Строка Из ТЧ Цикл
		
		Если Строка[СтруктураКор.СтавкаНДС] = Перечисления.СтавкиНДС.БезНДС Тогда
			
			Если Параметры.ОрганизацияНаУСН Тогда				
				//корректировка поступления - рассчет дельты	
				СуммаЭТОРГ12СНДС 	= Параметры.СуммаСНДС20 + Параметры.СуммаСНДС18 + Параметры.СуммаСНДС10;
				СуммаЭТОРГ12БезНДС 	= Параметры.СуммаБезНДС20 + Параметры.СуммаБезНДС18 + Параметры.СуммаБезНДС10 + Параметры.СуммаБезНДС;
				СуммаЭТОРГ12_НДС	= СуммаЭТОРГ12СНДС - СуммаЭТОРГ12БезНДС;
				
				Если Строка.НомерСтроки = 1 Тогда
					ДельтаНДС = СуммаНДСизПТУ - СуммаЭТОРГ12_НДС;
					Строка[СтруктураКор.СуммаНДС] = Строка[СтруктураКор.СуммаНДС] - ДельтаНДС;
					
					Дельта = СтруктураСумм.СуммаПТУ - СуммаЭТОРГ12СНДС;
					Строка[СтруктураКор.Сумма] = Строка[СтруктураКор.СуммаДоИзменения] + Строка[СтруктураКор.СуммаНДСДоИзменения] - Строка[СтруктураКор.СуммаНДС] - Дельта;
				КонецЕсли;
				Строка[СтруктураКор.Цена] = ?(Строка[СтруктураКор.Количество] = 0, Строка[СтруктураКор.Сумма], Строка[СтруктураКор.Сумма] / Строка[СтруктураКор.Количество]);
				
			Иначе
				Строка[СтруктураКор.Сумма] = Параметры.СуммаБезНДС;
			КонецЕсли;
			
		ИначеЕсли Строка[СтруктураКор.СтавкаНДС] = Перечисления.СтавкиНДС.НДС10 Тогда 	
			
			Строка[СтруктураКор.Сумма] 	= ?(СтруктураСумм.СуммаВключаетНДС, Параметры.СуммаСНДС10, Параметры.СуммаБезНДС10);
			Строка[СтруктураКор.СуммаНДС] = Параметры.СуммаСНДС10 - Параметры.СуммаБезНДС10;	
			
		ИначеЕсли Строка[СтруктураКор.СтавкаНДС] = Перечисления.СтавкиНДС.НДС18 Тогда
			
			Строка[СтруктураКор.Сумма] 	= ?(СтруктураСумм.СуммаВключаетНДС, Параметры.СуммаСНДС18,  Параметры.СуммаБезНДС18);
			Строка[СтруктураКор.СуммаНДС] = Параметры.СуммаСНДС18 - Параметры.СуммаБезНДС18;			
			Строка[СтруктураКор.Цена] = ?(Строка[СтруктураКор.Количество] = 0, Строка[СтруктураКор.Сумма], Строка[СтруктураКор.Сумма] / Строка[СтруктураКор.Количество]);
			
		ИначеЕсли Строка[СтруктураКор.СтавкаНДС] = Перечисления.СтавкиНДС.НДС20 Тогда
			
			Строка[СтруктураКор.Сумма] 	= ?(СтруктураСумм.СуммаВключаетНДС, Параметры.СуммаСНДС20,  Параметры.СуммаБезНДС20);
			Строка[СтруктураКор.СуммаНДС] = Параметры.СуммаСНДС20 - Параметры.СуммаБезНДС20;			
			Строка[СтруктураКор.Цена] = ?(Строка[СтруктураКор.Количество] = 0, Строка[СтруктураКор.Сумма], Строка[СтруктураКор.Сумма] / Строка[СтруктураКор.Количество]);
			
		Иначе //НДС 0%
			
			Строка[СтруктураКор.Сумма] 	= Параметры.СуммаБезНДС;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция СоздатьПодчиненнуюСчетФактуру(ДокументКоррСсылка, Параметры)
	
	СтруктураСФ = СтруктураМетаданныхСФ();
	
	СФ = НайтиПодходящийСчетФактуруИзРНК(ДокументКоррСсылка);
	
	Если СФ <> Неопределено Тогда
		
		ОбъектСчетаФактуры = СФ.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(СтруктураСФ.ДокументыОснования) Тогда
			ОбъектСчетаФактуры[СтруктураСФ.ДокументыОснования].Очистить();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураСФ.ДокументОснование) Тогда
			ОбъектСчетаФактуры[СтруктураСФ.ДокументОснование] = Неопределено;
		КонецЕсли;
		
		ОбъектСчетаФактуры.ОбменДанными.Загрузка = Истина;
		ОбъектСчетаФактуры.Записать();
		ОбъектСчетаФактуры.ОбменДанными.Загрузка = Ложь;
		
	Иначе
		ОбъектСчетаФактуры = Документы[СтруктураСФ.ИмяДокумента].СоздатьДокумент();
	КонецЕсли;
	
	ОбъектСчетаФактуры[СтруктураСФ.ВидСчетаФактуры] = СтруктураМетаданныхРегистрыПеречисления().НаПоступление;
	ОбъектСчетаФактуры.Заполнить(ДокументКоррСсылка);
	
	//Если требуется заполнить номер и дату документа основания
	Если ОбъектСчетаФактуры[СтруктураСФ.ДокументыОснования].Количество()>0 Тогда 
		ОбъектСчетаФактуры[СтруктураСФ.ДокументыОснования][0].НомерИсходногоДокумента = Параметры.НомерСчФ;
		ОбъектСчетаФактуры[СтруктураСФ.ДокументыОснования][0].ДатаИсходногоДокумента =  Параметры.ДатаСчФ;
	КонецЕсли;	
	ОбъектСчетаФактуры[СтруктураСФ.ДатаВходящегоДокумента] 	= Параметры.ДатаСчФ;
	ОбъектСчетаФактуры[СтруктураСФ.НомерВходящегоДокумента]	= Параметры.НомерСчФ;
	ОбъектСчетаФактуры[СтруктураСФ.Исправление] 			= Параметры.ЭтоИСФ;
	
	Если ОбъектСчетаФактуры[СтруктураСФ.Исправление] Тогда 
		ОбъектСчетаФактуры[СтруктураСФ.ДатаИсправления]		= Параметры.ДатаИСФ;
		ОбъектСчетаФактуры[СтруктураСФ.НомерИсправления]	= Параметры.НомерИСФ;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтруктураСФ.КодСпособаПолучения) Тогда 
		ОбъектСчетаФактуры[СтруктураСФ.КодСпособаПолучения] = 2;
	КонецЕсли;
	
	Попытка
		ОбъектСчетаФактуры.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ОбъектСчетаФактуры;
	
КонецФункции

//ЗАВИСИТ ОТ КОНФИГУРАЦИИ
Процедура УстановитьДоговорВСчетеФактуреДляДиадок(СчетФактура) Экспорт
	
	мСписокВидовДоговоров					= Новый СписокЗначений;
	СтруктураПараметровДляПолученияДоговора = Новый Структура;
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументОбъект." + СтруктураМетаданныхСФ().ИмяДокумента) Тогда
		мСписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		мСписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	Иначе 
		мСписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		мСписокВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером);
	КонецЕсли;
	
	СтруктураПараметровДляПолученияДоговора.Вставить("СписокДопустимыхВидовДоговоров", мСписокВидовДоговоров);
	
	Выполнить(СтруктураМетаданныхСФ().ВыполнитьУстановкуДоговора);
	
КонецПроцедуры

