// Определение доп. колонок списка документов/пакетов (не более 5 штук)
Функция ПолучитьНастройкиДополнительныхКолонокСпискаДокументов(Параметры)
	
	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Poluchit%27_Nastroyki_Dopolnitel%27nykh_Kolonok_Spiska_Dokumentov.html

	Режим = Параметры.Режим;
	
	Если Режим = "ПолученныеДокументы" Тогда
		
		// Возможно, стоит переделать в ТаблицуЗначений
		ДопКолонки = Новый Массив;  // не более 5. Индекс элемента в массиве, увеличенный на единицу, совпадает с порядковым номером колонки
		ДопКолонки.Добавить(Новый Структура("Заголовок, Тип, ДопустимыеЗначения", "Номер Акта", Новый ОписаниеТипов("Строка")));  // колонка 0
		ДопКолонки.Добавить(Новый Структура("Заголовок, Тип, ДопустимыеЗначения", "Откл Суммы", Новый ОписаниеТипов("Число")));  // колонка 1		
		ДопКолонки.Добавить(Новый Структура("Заголовок, Тип, ДопустимыеЗначения", "Откл НДС", Новый ОписаниеТипов("Число")));  // колонка 2
		
		Возврат ДопКолонки;
		
	КонецЕсли;
	
КонецФункции

// Обработчики заполнения доп. колонок, которые задали в ПолучитьНастройкиДополнительныхКолонокСпискаДокументов
Функция ПослеОбновленияСпискаДокументов(Параметры)
	
	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Posle_Obnovleniya_Spiska_Dokumentov.html

	СписокДокументов	= Параметры.СписокДокументов;
	Режим				= Параметры.Режим;
	
	Если Режим = "ПолученныеДокументы" Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Парам.НомерСтроки,
		|	Парам.ДокументЭДО КАК ДокументЭДО
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&СписокДокументов КАК Парам
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументЭДО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.НомерСтроки,
		|	ТЧ_НомерАкта.Значение КАК НомерАктаПриемки,
		|	ТЧ_ОтклонениеСуммы.Значение КАК ОтклонениеСуммы,
		|	ТЧ_ОтклонениеНДС.Значение КАК ОтклонениеНДС
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ТЧ_НомерАкта
		|		ПО ВТ.ДокументЭДО = ТЧ_НомерАкта.Ссылка
		|			И (ТЧ_НомерАкта.ИмяРеквизита = ""НомерАктаПриемки"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ТЧ_ОтклонениеСуммы
		|		ПО ВТ.ДокументЭДО = ТЧ_ОтклонениеСуммы.Ссылка
		|			И (ТЧ_ОтклонениеСуммы.ИмяРеквизита = ""ОтклонениеСуммы"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Диадок_Документы.ДополнительныеРеквизиты КАК ТЧ_ОтклонениеНДС
		|		ПО ВТ.ДокументЭДО = ТЧ_ОтклонениеНДС.Ссылка
		|			И (ТЧ_ОтклонениеНДС.ИмяРеквизита = ""ОтклонениеНДС"")"
		);
		
		Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов.Выгрузить(, "НомерСтроки, ДокументЭДО"));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокДокументов[Выборка.НомерСтроки - 1].ДопРеквизит1 = Выборка.НомерАктаПриемки;
			СписокДокументов[Выборка.НомерСтроки - 1].ДопРеквизит2 = Выборка.ОтклонениеСуммы;
			СписокДокументов[Выборка.НомерСтроки - 1].ДопРеквизит3 = Выборка.ОтклонениеНДС;
		КонецЦикла;
		
		Возврат ПолучитьНастройкиДополнительныхКолонокСпискаДокументов(Новый Структура("Режим", Режим));  
		// костыль на переходный период
		
	КонецЕсли;
	
КонецФункции

Функция ЗаполнитьСписокДополнительныхКнопок(Параметры)
	
	РежимОтображенияДокументов = Параметры.РежимОтображенияДокументов;
	Если РежимОтображенияДокументов = "ПолученныеДокументы" Тогда
		ТаблицаКнопок = Параметры.ТаблицаКнопок;
		НовСтрока = ТаблицаКнопок.Добавить();
		НовСтрока.Имя       = "КнопкаАннулировать";
		НовСтрока.Заголовок = "АННУЛИРОВАНИЕ ДОКУМЕНТА";
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция НажатиеДополнительнойКнопки(Параметры)
	
	РежимОтображенияДокументов = Параметры.РежимОтображенияДокументов;
	ВыделенныеСтроки = Параметры.ВыделенныеСтроки;
	ИмяКнопки = Параметры.ИмяКнопки;
	РезультатФункции = Новый Структура("ОписаниеОшибки", Неопределено);
	
	//{КМЕ, 2020-02-17, Установка действия в ДД "Аннулировать" для отмеченных документов	
	Если РежимОтображенияДокументов = "ПолученныеДокументы" И ИмяКнопки = "КнопкаАннулировать" Тогда
		
		Для Каждого ВыбраннаяСтрока Из ВыделенныеСтроки Цикл
			
			Попытка
				Если ЗначениеЗаполнено(ВыбраннаяСтрока.ДокументЭДО) Тогда
					ДокументДД = ВыбраннаяСтрока.ДокументЭДО;
					ДокОбъект = ДокументДД.ПолучитьОбъект();
					ДокОбъект.ТребуемоеДействиеВ1С = "ЗапроситьАннулирование";
					ДокОбъект.ТребуемоеДействиеВДД = "";
					ДокОбъект.ТребуетсяДействие = Истина;
					ДокОбъект.Метка = "ОжидаетАннулирования"; 
					ДокОбъект.Записать();
				КонецЕсли;
			Исключение
				РезультатФункции.ОписаниеОшибки = РезультатФункции.ОписаниеОшибки + ОписаниеОшибки() + Символы.ПС;
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	ОсновнойМодуль.ОбработатьРезультатФункции(РезультатФункции);					
	//КМЕ}
	
	Возврат Истина;
	
КонецФункции

Функция ПриПолученииДанныхТабличнойЧасти(Параметры)
	
	Форма           = Параметры.Форма;
	ИмяФормы        = Параметры.ИмяФормы;
	Элемент         = Параметры.Элемент;
	ОформленияСтрок = Параметры.ОформленияСтрок;
	
	//Всевозможные статусы пакетов
	//|Отправлен
	//|Не отправлен
	//|Ожидается извещение о получении
	//|Доставлен
	//|Требуется подпись
	//|Подписан
	//|Подписан контрагентом
	//|Ожидается подпись контрагента
	//|Отказано в подписи
	//|Отказано в подписи контрагенту
	//|Ошибка подписи
	//|Ожидается извещение от покупателя
	//|Документооборот не завершен
	//|Документооборот завершен
	//|Исправлен
	//|Откорректирован
	//|Аннулирован
	//|Ожидается аннулирование
	//|Требуется аннулирование
	//|Ожидается уточнение
	//|Требуется уточнение
	//|Контрагент отказал в подписи
	//|Требуется подписать и отправить
	//|Требуется подписать извещение
	//|Отказано в аннулировании

	
	Для Каждого Эл Из ОформленияСтрок Цикл
		
	    Если Эл.ДанныеСтроки.Статус = "Требуется подпись" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.БледноЗеленый;
	        Эл.ЦветФона = WebЦвета.БледноЗеленый;
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Исправлен" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.СветлоЗеленый;
	        Эл.ЦветФона = WebЦвета.СветлоЗеленый;
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Откорректирован" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.Лимонный;
	        Эл.ЦветФона = WebЦвета.Лимонный;			
			
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Подписан" Тогда		
				Запрос = Новый Запрос;				
				Запрос.Текст = 			
					"ВЫБРАТЬ
					|	КОЛИЧЕСТВО(Диадок_Документы.Ссылка) КАК Ссылка
					|ИЗ
					|	Справочник.Диадок_Документы КАК Диадок_Документы
					|ГДЕ
					|	Диадок_Документы.НомерДокумента = &НомерДокумента";				
				Запрос.УстановитьПараметр("НомерДокумента", Эл.ДанныеСтроки.НомерДокумента);
		
			РезультатЗапроса = Запрос.Выполнить();

			Если РезультатЗапроса.Выгрузить()[0].Ссылка > 1 Тогда
				Эл.Ячейки.Документ.ЦветФона = WebЦвета.СветлоЗеленый;		
				Эл.ЦветФона = WebЦвета.СветлоЗеленый;		
			КонецЕсли;
		
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Отказано в подписи" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.Томатный;
	        Эл.ЦветФона = WebЦвета.Томатный;
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Ошибка подписи" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.Томатный;
	        Эл.ЦветФона = WebЦвета.Томатный;
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Аннулирован" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.БледноБирюзовый;
	        Эл.ЦветФона = WebЦвета.БледноБирюзовый;	
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Требуется аннулирование" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.Сливовый;
	        Эл.ЦветФона = WebЦвета.Сливовый;	
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Отказано в подписи контрагенту" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.Персиковый;
	        Эл.ЦветФона = WebЦвета.Персиковый;		
		ИначеЕсли Эл.ДанныеСтроки.Статус = "Требуется уточнение" Тогда
	        Эл.Ячейки.Документ.ЦветФона = WebЦвета.Томатный;
	        Эл.ЦветФона = WebЦвета.Томатный;		
			
		// проверить производительность на большом кол-ве документов		
		ИначеЕсли Найти(Эл.ДанныеСтроки.Статус, "Ожидается уточнение") Тогда
			Запрос = Новый Запрос;				
				Запрос.Текст = 			
					"ВЫБРАТЬ
					|	КОЛИЧЕСТВО(Диадок_Документы.Ссылка) КАК Ссылка
					|ИЗ
					|	Справочник.Диадок_Документы КАК Диадок_Документы
					|ГДЕ
					|	Диадок_Документы.НомерДокумента = &НомерДокумента";				
				Запрос.УстановитьПараметр("НомерДокумента", Эл.ДанныеСтроки.НомерДокумента);
		
			РезультатЗапроса = Запрос.Выполнить();

			Если РезультатЗапроса.Выгрузить()[0].Ссылка > 1 Тогда
				Эл.Ячейки.Документ.ЦветФона = WebЦвета.Розовый;		
				Эл.ЦветФона = WebЦвета.Розовый;	
			Иначе			
				Эл.Ячейки.Документ.ЦветФона = WebЦвета.Персиковый;		
				Эл.ЦветФона = WebЦвета.Персиковый;
			КонецЕсли;
										
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

