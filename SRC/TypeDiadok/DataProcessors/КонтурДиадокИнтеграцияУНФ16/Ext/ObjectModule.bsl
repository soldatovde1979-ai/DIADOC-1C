Процедура АктСверки405_ЗаполнитьТабличнуюЧастьТитулаОтправителя(Content, ВыборкаПоДоговорам, ДокСсылка)
	
	ReconciliationActTable = Новый_SenderReconciliationActTable();
	
	Пока ВыборкаПоДоговорам.Следующий() Цикл
		
		ContractInfo = Новый_SenderContractInfo_ReconciliationAct();
		
		АктСверки405_ЗаполнитьContractInfoТитулаОтправителя(
			ContractInfo,
			ВыборкаПоДоговорам,
			ДокСсылка.ВалютаДокумента,
			ДокСсылка.НачалоПериода,
			ДокСсылка.КонецПериода
		);
		
		ReconciliationActTable.ContractInfo.Добавить(ContractInfo);
		
		ВыборкаПоДокументам = ВыборкаПоДоговорам.Выбрать();
		
		Пока ВыборкаПоДокументам.Следующий() Цикл
			
			DocumentInfo = Новый_SenderDocumentInfo_ReconciliationAct();
			OperationInfo = Новый_SenderOperationInfo_ReconciliationAct();
			
			АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(DocumentInfo, ВыборкаПоДокументам);
			АктСверки405_ЗаполнитьOperationInfoТитулаОтправителя(OperationInfo, ВыборкаПоДокументам);
			
			ContractInfo.DocumentInfo.Добавить(DocumentInfo);
			DocumentInfo.OperationInfo.Добавить(OperationInfo);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьContractInfoТитулаОтправителя(ContractInfo, ВыборкаПоДоговорам, ВалютаДокумента, НачалоПериода, КонецПериода)
	
	НачальноеСальдоПоДоговору = АктСверки405_СальдоПоДоговоруНаДату(
		ВыборкаПоДоговорам.Договор,
		ВалютаДокумента,
		НачалоПериода
	);
	
	КонечноеСальдоПоДоговору = АктСверки405_СальдоПоДоговоруНаДату(
		ВыборкаПоДоговорам.Договор,
		ВалютаДокумента,
		КонецПериода
	);
	
	НачОстатокПоДоговоруДт = Макс(НачальноеСальдоПоДоговору, 0);
	НачОстатокПоДоговоруКт = Макс(-НачальноеСальдоПоДоговору, 0);
	
	КонОстатокПоДоговоруДт = Макс(КонечноеСальдоПоДоговору, 0);
	КонОстатокПоДоговоруКт = Макс(-КонечноеСальдоПоДоговору, 0);
	
	СуммаОборотДт = КонОстатокПоДоговоруДт - НачОстатокПоДоговоруДт;
	СуммаОборотКт = КонОстатокПоДоговоруКт - НачОстатокПоДоговоруКт;
	
	ContractInfo.ContractAdditionalInfo = Строка(ВыборкаПоДоговорам.ВидДоговора);
	ContractInfo.ContractNumber = ВыборкаПоДоговорам.НомерДоговора;
	ContractInfo.ContractDate = ВыборкаПоДоговорам.ДатаДоговора;
	ContractInfo.BalanceDebitFrom = НачОстатокПоДоговоруДт;
	ContractInfo.BalanceAmountFrom = НачОстатокПоДоговоруКт;
	ContractInfo.TurnoverDebit = СуммаОборотДт;
	ContractInfo.TurnoverAmount = СуммаОборотКт;
	ContractInfo.BalanceDebitEnd = ?(КонечноеСальдоПоДоговору > 0, КонечноеСальдоПоДоговору, 0);
	ContractInfo.BalanceAmountEnd = ?(КонечноеСальдоПоДоговору < 0, -КонечноеСальдоПоДоговору, 0);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(Content, ВыборкаПоДокументам)
	
	Content.DocumentName = ВыборкаПоДокументам.НаименованиеДокумента;
