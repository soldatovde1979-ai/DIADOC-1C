Функция УПД970_ПодготовитьДанныеПервичногоДокумента(
	РезультатЗапросаПоШапке,
	РезультатЗапросаПоТаблицам,
	РезультатЗапросаПоПрослеживаемости,
	СчетФактура)
	
	ДанныеШапкиТаблица = РезультатЗапросаПоШапке.Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеШапкиТаблица[0]);
	
	ТабличныеДанные = РезультатЗапросаПоТаблицам.Выгрузить();
	
	УПД970_УстановитьНомерСтрокиВТабличнойЧастиДляДоставки(ТабличныеДанные);
	
	Если УПД970_НеобходимоВыполнитьПересчетСуммВВалютеРегУчета(ДанныеШапки, СчетФактура) Тогда
		УПД970_ПерезаполнитьСуммыДокументаВВалютеРегУчета(ДанныеШапки, ТабличныеДанные);
		УПД970_ПерезаполнитьВалютуДокумента(ДанныеШапки);
	КонецЕсли;
	
	Если РезультатЗапросаПоПрослеживаемости = Неопределено Тогда
		СведенияПрослеживаемости = Неопределено;
	Иначе
		СведенияПрослеживаемости = РезультатЗапросаПоПрослеживаемости.Выгрузить();
	КонецЕсли;
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомитентом);
	ЭтоДоговорСКомиссионером = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером);
	
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО(ДанныеШапки);
	
	Если УПД970_ВТабличныхДанныхДокументаНетТоваров(ТабличныеДанные) Тогда
		СведенияОбУчастникахЭДО.Грузоотправитель = Неопределено;
		СведенияОбУчастникахЭДО.Грузополучатель = Неопределено;
	КонецЕсли;
	
	ДокументыПередачиТоваров = ЗначениеВМассив(ДанныеШапки.Ссылка);
	
	ОснованияПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваровПоОснованиюСчетФактураВыданный(
		ДокументыПередачиТоваров
	);
	
	Результат = УПД970_Контракт_ДанныеПервичногоДокумента();
	
	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ТабличныеДанные = ТабличныеДанные;
	Результат.СведенияПрослеживаемости = СведенияПрослеживаемости;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.ЭтоДоговорСКомиссионером = ЭтоДоговорСКомиссионером;
	Результат.СчетФактура = СчетФактура;
	Результат.СведенияОбУчастникахЭДО = СведенияОбУчастникахЭДО;
	Результат.ОснованияПередачиТоваров = ОснованияПередачиТоваров;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьДанныеПокупателяГрузополучателяПоОтчетуКомиссионера(СведенияОбУчастникахЭДО, ДанныеДокументаПокупателя)
	
	ДанныеДокументаПокупателяТаблица = ДанныеДокументаПокупателя.Выгрузить();
	Данные = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДокументаПокупателяТаблица[0]);
	
	СведенияОПокупателе = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Данные.Покупатель,
		Данные.ДатаСФ
	);
	
	СведенияОбУчастникахЭДО.Контрагент = СведенияОПокупателе;
	
	Если ЗначениеЗаполнено(СведенияОбУчастникахЭДО.Грузополучатель) Тогда
		СведенияОбУчастникахЭДО.Грузополучатель = СведенияОПокупателе;
	КонецЕсли;
	
КонецПроцедуры

