Функция УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента)
	
	Результат = Неопределено;
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФ() Тогда
		
		Результат = УПД970_ОбстоятельстваФормированияСчетФактуры(ДанныеПоДокументу);
		
	Иначе
		
		Результат = УПД970_ОбстоятельстваФормированияУПД(ДанныеПоДокументу);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияУПД(ДанныеПоДокументу)
	
	Результат = Неопределено;
	
	Если ДанныеПоДокументу.ЭтоДоговорСКомиссионером Тогда
		Результат = "00005";
	КонецЕсли;
	
	Если ДанныеПоДокументу.ЭтоДоговорСКомитентом Тогда
		Результат = "00007";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияСчетФактуры(ДанныеПоДокументу)
	
	Перем Результат;
	
	ЭтоПродажа = ДанныеПоДокументу.ВидОперации = Перечисления.ВидыОперацийСчетФактура.Продажа;
	ЭтоКомиссионнаяТорговля = (ДанныеПоДокументу.ЭтоДоговорСКомитентом Или ДанныеПоДокументу.ЭтоДоговорСКомиссионером);
	
	Если ДанныеПоДокументу.ЭтоСчетФактураНаАванс Тогда
		Результат = "2";
	ИначеЕсли ЭтоПродажа И ЭтоКомиссионнаяТорговля Тогда
		Результат = "1";
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияПередачиТоваровПоОснованиюСчетФактураВыданный(ДокументыОснования)
	
	Результат = Новый Массив;
	
	Для Каждого ДокументОснования Из ДокументыОснования Цикл
		
		ДоговорДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснования, "Договор");
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорДокумента, "НомерДоговора, ДатаДоговора");
		
		РеквизитыОснования = Новый Структура;
		РеквизитыОснования.Вставить("Наименование", "Договор");
		РеквизитыОснования.Вставить("Номер", РеквизитыДоговора.НомерДоговора);
		РеквизитыОснования.Вставить("Дата", РеквизитыДоговора.ДатаДоговора);
		
		Результат.Добавить(РеквизитыОснования);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияЗаполнены(РеквизитыОснования)
	
	ОбязательныеРеквизитыЗаполнены = (РеквизитыОснования <> Неопределено
		И ЗначениеЗаполнено(РеквизитыОснования.Наименование)
		И ЗначениеЗаполнено(РеквизитыОснования.Номер)
		И ЗначениеЗаполнено(РеквизитыОснования.Дата));
	
	Возврат ОбязательныеРеквизитыЗаполнены;
	
КонецФункции

Функция УПД970_СведенияОбУчастникахЭДО(ДанныеШапки)
	
	// Продавец
	
	Если ЗначениеЗаполнено(ДанныеШапки.ГоловнаяОрганизация)
		И ДанныеШапки.Организация <> ДанныеШапки.ГоловнаяОрганизация Тогда
		ЭтоОПНаОтдельномБалансе = Истина;
	Иначе
		ЭтоОПНаОтдельномБалансе = Ложь;
	КонецЕсли;
	
	ЭтоОПНаОбщемБалансе = ЗначениеЗаполнено(ДанныеШапки.ГоловноеПодразделение);
	
	Если ЭтоОПНаОтдельномБалансе Тогда
		Организация = ДанныеШапки.ГоловнаяОрганизация;
	Иначе
		Организация = ДанныеШапки.Организация;
	КонецЕсли;
	
	СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Организация,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации
	);
	
	Если ЭтоОПНаОтдельномБалансе Тогда
		КППОрганизации = ДанныеШапки.ОрганизацияКПП;
	ИначеЕсли ЭтоОПНаОбщемБалансе Тогда
		КППОрганизации = ДанныеШапки.ПодразделениеКПП;
	Иначе
		КППОрганизации = СведенияОбОрганизации.КПП;
	КонецЕсли;
	
	СведенияОбОрганизации.КПП = КППОрганизации;
	
	// Покупатель
	Если ЗначениеЗаполнено(ДанныеШапки.ГоловнойКонтрагент) Тогда
		Контрагент = ДанныеШапки.ГоловнойКонтрагент;
	Иначе
		Контрагент = ДанныеШапки.Контрагент;
	КонецЕсли;
	
	СведенияОКонтрагенте = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		Контрагент,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетКонтрагента
	);
	
	Если ЗначениеЗаполнено(ДанныеШапки.КонтрагентКПП) Тогда
		СведенияОКонтрагенте.КПП = ДанныеШапки.КонтрагентКПП;
	КонецЕсли;
	
	// Грузоотправитель
	Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата
		);
		
	ИначеЕсли ЭтоОПНаОтдельномБалансе Тогда
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Организация,
			ДанныеШапки.Дата
		);
		
	ИначеЕсли ЭтоОПНаОбщемБалансе Тогда
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДО(ДанныеШапки.Организация, ДанныеШапки.Дата);
		
		СведенияОГрузоотправителе.Ссылка = ДанныеШапки.Подразделение;
		СведенияОГрузоотправителе.Адрес = УПД970_СведенияОФактическомАдресе(ДанныеШапки.Подразделение, ДанныеШапки.Дата);
		СведенияОГрузоотправителе.Наименование = ДанныеШапки.ПодразделениеНаименование;
		СведенияОГрузоотправителе.КПП = ДанныеШапки.ПодразделениеКПП;
		
	Иначе
		
		СведенияОГрузоотправителе = Неопределено;
		
	КонецЕсли;
	
	// Грузополучатель
	СведенияОГрузополучателе = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		
		СведенияОГрузополучателе = УПД970_ДанныеГрузополучателя(
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата,
			ДанныеШапки.АдресДоставки,
			ДанныеШапки.АдресДоставкиЗначение
		);
		
	КонецЕсли;
	
	Результат = УПД970_Контракт_УчастникиЭДО();
	Результат.Организация = СведенияОбОрганизации;
	Результат.Контрагент = СведенияОКонтрагенте;
	Результат.Грузоотправитель = СведенияОГрузоотправителе;
	Результат.Грузополучатель = СведенияОГрузополучателе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсЮрАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсФактАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
	СведенияОбАдресе = УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений);
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_Контракт_ДанныеУчастникаЭДО();
	
	МодульЭлектронныеДокументы = ОбщийМодульПоИмениЛок("УправлениеНебольшойФирмойЭлектронныеДокументыСервер");
	
	СведенияОЮрФизЛице = МодульЭлектронныеДокументы.ПолучитьДанныеЮрФизЛица(Ссылка, ДатаСведений, БанковскийСчет);
	
	Результат.Ссылка = Ссылка;
	
	Результат.Наименование = СведенияОЮрФизЛице.ПолноеНаименование;
	Результат.ИНН = СведенияОЮрФизЛице.ИНН;
	Результат.КПП = СведенияОЮрФизЛице.КПП;
	Результат.КодПоОКПО = СведенияОЮрФизЛице.КодПоОКПО;
	
	Если ЗначениеЗаполнено(СведенияОЮрФизЛице.Банк) Тогда
		Результат.НаименованиеБанка = СведенияОЮрФизЛице.Банк.Наименование;
	Иначе
		Результат.НаименованиеБанка = "";
	КонецЕсли;
	
	Результат.НомерСчета = СведенияОЮрФизЛице.НомерСчета;
	Результат.КоррСчет = СведенияОЮрФизЛице.КоррСчет;
	Результат.БИК = СведенияОЮрФизЛице.БИК;
	Результат.Телефоны = СведенияОЮрФизЛице.Телефоны;
	Результат.ЭлектроннаяПочта = СведенияОЮрФизЛице.ЭлектроннаяПочта;
	Результат.ЭтоЮрЛицо = (СведенияОЮрФизЛице.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	
	Если СведенияОЮрФизЛице.Свойство("ВидКонтрагента") Тогда
		Результат.ЭтоФизЛицо = (СведенияОЮрФизЛице.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо);
	Иначе
		Результат.ЭтоФизЛицо = Ложь;
	КонецЕсли;
	
	Если СведенияОЮрФизЛице.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		
		Если СведенияОЮрФизЛице.Свойство("ОГРН") Тогда
			ОГРНИП = СведенияОЮрФизЛице.ОГРН;
		ИначеЕсли Ссылка.Метаданные().Реквизиты.Найти("ОГРН") <> Неопределено Тогда
			ОГРНИП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ОГРН");
		ИначеЕсли Ссылка.Метаданные().Реквизиты.Найти("РегистрационныйНомер") <> Неопределено Тогда
			ОГРНИП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "РегистрационныйНомер");
		Иначе
			ОГРНИП = "";
		КонецЕсли;
		
		Результат.ОГРНИП = ОГРНИП;
		
		Если Ссылка.Метаданные().Реквизиты.Найти("ДатаРегистрации") <> Неопределено Тогда
			Результат.ДатаОГРНИП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ДатаРегистрации");
		КонецЕсли;
		
		Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
			Результат.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "НаименованиеПолное");
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОЮрФизЛице.СтранаРегистрации) Тогда
		ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СведенияОЮрФизЛице.СтранаРегистрации, "Код, Наименование");
		
		Результат.СтранаКод = ДанныеСтраны.Код;
		Результат.СтранаНаименование = ДанныеСтраны.Наименование;
	Иначе
		Результат.СтранаКод = ОсновнаяСтрана().Код;
		Результат.СтранаНаименование = ОсновнаяСтрана().Наименование;
	КонецЕсли;
	
	Если Результат.СтранаКод <> ОсновнаяСтрана().Код Тогда
		Результат.Нерезидент = Истина;
		
		СведенияОЮрФизЛице.Свойство("РегистрационныйНомер", Результат.НалоговыйНомерВСтранеРегистрации);
	Иначе
		Результат.Нерезидент = Ложь;
	КонецЕсли;
	
	Результат.Свидетельство = УПД970_СвидетельствоОГосРегистрации(
		СведенияОЮрФизЛице.СвидетельствоСерияНомер,
		СведенияОЮрФизЛице.СвидетельствоДатаВыдачи
	);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СвидетельствоОГосРегистрации(СвидетельствоСерияНомер, СвидетельствоДатаВыдачи)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(СвидетельствоСерияНомер) Тогда
		Результат = "свидетельство " + СвидетельствоСерияНомер;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвидетельствоДатаВыдачи) Тогда
		Результат = Результат + " от " + Формат(СвидетельствоДатаВыдачи, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеГрузополучателя(Ссылка, ДатаСведений, АдресДоставки, АдресДоставкиЗначение)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений);
	
	СведенияОбАдресе = УПД970_СведенияОбАдресеДоставки(
		АдресДоставки,
		АдресДоставкиЗначение);
		
	Если Не ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		СведенияОбАдресе = УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений);
	КонецЕсли;
	
	Результат.Адрес = СведенияОбАдресе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбАдресеДоставки(АдресДоставки, АдресДоставкиЗначение)

	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(АдресДоставки) Тогда
		
		Если ЗначениеЗаполнено(АдресДоставкиЗначение) Тогда
			Результат = УПД970_СведенияОбАдресе(АдресДоставкиЗначение);
		КонецЕсли;
		
		ПредставлениеАдресаПоJSON = УПД970_ПредставлениеАдресаИзСтруктуры(Результат);
		
		ПредставленияАдресаРазличаются = (НРег(АдресДоставки) <> НРег(ПредставлениеАдресаПоJSON));
		
		СведенияОбАдресеПоПредставлениюИзДокумента = (Не ЗначениеЗаполнено(Результат)
			Или ПредставленияАдресаРазличаются);
			
		Если СведенияОбАдресеПоПредставлениюИзДокумента Тогда
			
			МодульУправлениеКонтактнойИнформацией = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
			
			АдресСтрокойJSON = МодульУправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(
				АдресДоставки,
				ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес")
			);
			
			Результат = УПД970_СведенияОбАдресе(АдресСтрокойJSON);
			
			Результат.Представление = АдресДоставки;
			Результат.ТипАдреса = ТипАдресаВСвободнойФорме();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбАдресе(АдресСтрокойJSON)
	
	Перем Результат;
	
	Если Не ЗначениеЗаполнено(АдресСтрокойJSON) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = СведенияОбАдресеЛок(АдресСтрокойJSON);
	
	СохраненноеПредставление = ПредставлениеАдреса(АдресСтрокойJSON);
	Результат.Вставить("СохраненноеПредставление", СохраненноеПредставление);
	
	ЭтоАдминистративноТерриториальныйАдрес = УПД970_АдресСоответствуетСтруктуреAddressRF(Результат);
	
	ЭтоМуниципальныйАдрес = Ложь;
	Если Не ЭтоАдминистративноТерриториальныйАдрес Тогда
		ЭтоМуниципальныйАдрес = УПД970_АдресСоответствуетСтруктуреAddressSAR(Результат);
	КонецЕсли;
	
	Если Не ЭтоМуниципальныйАдрес
		И Не ЭтоАдминистративноТерриториальныйАдрес Тогда
		
		Результат.Представление = Результат.СохраненноеПредставление;
		Результат.ТипАдреса = ТипАдресаВСвободнойФорме();
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция УПД970_ПредставлениеАдресаИзСтруктуры(СведенияОбАдресе)
	
	Перем Результат;
	
	Если Не ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		Результат = СвойствоСтруктурыЛок(СведенияОбАдресе, "МуниципальноеПредставление");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = СведенияОбАдресе.Представление;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений)
	
	ВидыКИ = Перечисление_ВидыКонтактнойИнформации();
	
	Результат = УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидыКИ.ЮридическийАдрес, ДатаСведений);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений)
	
	ВидыКИ = Перечисление_ВидыКонтактнойИнформации();
	
	Результат = УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидыКИ.ФактическийАдрес, ДатаСведений);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресИзКонтактнойИнформации(Ссылка, ВидАдреса, ДатаСведений)
	
	Результат = Неопределено;
	
	ВидКИ = ВидАдресаЮрФизЛица(Ссылка, ВидАдреса);
	ТолькоПредставлениеКИ = Ложь;
	
	МодульУправлениеКонтактнойИнформацией = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
	
	КонтактнаяИнформация = МодульУправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Ссылка,
		ВидКИ,
		ДатаСведений,
		ТолькоПредставлениеКИ
	);
	
	Если ЗначениеЗаполнено(КонтактнаяИнформация) Тогда
		
		АдресСтрокойJSON = КонтактнаяИнформация[0].Значение;
		
		Результат = УПД970_СведенияОбАдресе(АдресСтрокойJSON);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСоответствуетСтруктуреAddressRF(СведенияОбАдресе)
	
	ЕстьКодРегиона = ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона);
	ЭтоКодГородаФедеральногоЗначения = УПД970_ЭтоКодГородаФедеральногоЗначения(СведенияОбАдресе.КодРегиона);
	
	ПомещенияНеЗаполнены = (СведенияОбАдресе.Помещения.Количество() = 0);
	ТипПомещенияСоответствуетАдрРФ = (СведенияОбАдресе.Помещения.Количество() = 1
		И ВРЕГ(СведенияОбАдресе.Помещения[0].ТипПомещения) = ВРЕГ(ТипПомещенияАдрРФ()));
		
	ПомещенияСоответствуютАдрРФ = (ПомещенияНеЗаполнены Или ТипПомещенияСоответствуетАдрРФ);
	
	КорпусаНеЗаполнены = (СведенияОбАдресе.Корпуса.Количество() = 0);
	ТипКорпусаСоответствуетАдрРФ = (СведенияОбАдресе.Корпуса.Количество() = 1
		И ВРЕГ(СведенияОбАдресе.Корпуса[0].ТипКорпуса) = ВРЕГ(ТипКорпусаАдрРФ()));
		
	КорпусаСоответствуютАдрРФ = (КорпусаНеЗаполнены Или ТипКорпусаСоответствуетАдрРФ);
		
	ТипЗданияСоответствуетАдрРФ = Не ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания)
		Или ВРЕГ(СведенияОбАдресе.Здание.ТипЗдания) = ВРЕГ(ТипЗданияАдрРФ());
		
	АдресНеСоответствуетСтруктуреАдрРФ = ЕстьНесоответствующиеСтруктуреАдрРФПоля(СведенияОбАдресе);
		
	ПредставлениеАдреса = СведенияОбАдресе.Представление;
	ПредставленияАдресаСовпадают = (ПредставлениеАдреса = СведенияОбАдресе.СохраненноеПредставление);

	Результат = ЭтоАдминистративноТерриториальныйАдресЛок(СведенияОбАдресе.ТипАдреса)
		И ЕстьКодРегиона
		И ПомещенияСоответствуютАдрРФ
		И КорпусаСоответствуютАдрРФ
		И ТипЗданияСоответствуетАдрРФ
		И ПредставленияАдресаСовпадают
		И Не АдресНеСоответствуетСтруктуреАдрРФ
		И Не ЭтоКодГородаФедеральногоЗначения;

	Возврат Результат;
	
КонецФункции

Функция УПД970_ЭтоКодГородаФедеральногоЗначения(КодРегиона)

	КодыРегионов = Новый Массив;
	КодыРегионов.Добавить("77"); // г. Москва
	КодыРегионов.Добавить("78"); // г. Санкт-Петербург
	КодыРегионов.Добавить("92"); // г. Севастополь
	КодыРегионов.Добавить("99"); // иные территории, включая город и космодром Байконур

	Результат = (КодыРегионов.Найти(КодРегиона) <> Неопределено);
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСоответствуетСтруктуреAddressSAR(СведенияОбАдресе)
	
	Результат = Ложь;
	
	Если Не ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьКодРегиона = ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона);
	ЕстьНаименованиеМуниципальногоРайона = ЗначениеЗаполнено(СведенияОбАдресе.МуниципальныйРайон);
	
	ЕстьКодМуниципальногоРайона = ЗначениеЗаполнено(СведенияОбАдресе.КодМуниципальногоРайона);
	Если Не ЕстьКодМуниципальногоРайона Тогда
		КодМуниципальногоРайона = УПД970_КодМуниципальногоРайона(СведенияОбАдресе.МуниципальныйРайонСокращение);
		ЕстьКодМуниципальногоРайона = ЗначениеЗаполнено(КодМуниципальногоРайона);
	КонецЕсли;
	
	ЕстьИдентификаторАдресногоОбъекта = ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторАдресногоОбъекта);
	
	ЕстьНесколькоТиповПомещений = УПД970_АдресСодержитНесколькоТиповПомещений(СведенияОбАдресе);
	ЕстьНесколькоТиповАпартаментов = УПД970_АдресСодержитНесколькоТиповАпартаментов(СведенияОбАдресе);
	
	МуниципальноеПредставление = СвойствоСтруктурыЛок(СведенияОбАдресе, "МуниципальноеПредставление");
	ПредставленияАдресаСовпадают = (МуниципальноеПредставление = СведенияОбАдресе.СохраненноеПредставление);
	
	Результат = ЕстьКодРегиона
		И ЕстьНаименованиеМуниципальногоРайона
		И ЕстьКодМуниципальногоРайона
		И ЕстьИдентификаторАдресногоОбъекта
		И ПредставленияАдресаСовпадают
		И Не ЕстьНесколькоТиповПомещений
		И Не ЕстьНесколькоТиповАпартаментов;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСодержитНесколькоТиповПомещений(СведенияОбАдресе)
	
	Результат = Ложь;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	
	КоличествоТиповПомещений = 0;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		Если ТипыПомещенийЗдания.Найти(Элемент.ТипПомещения) <> Неопределено Тогда
			КоличествоТиповПомещений = КоличествоТиповПомещений + 1;
		КонецЕсли;
		
		Если КоличествоТиповПомещений > 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСодержитНесколькоТиповАпартаментов(СведенияОбАдресе)
	
	Результат = Ложь;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();
	
	КоличествоТиповПомещений = 0;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		ТипПомещения = Элемент.ТипПомещения;
		
		ЭтоПомещениеЗдания = (ТипыПомещенийЗдания.Найти(ТипПомещения) <> Неопределено);
		ЭтоПомещениеКвартиры = (ТипыПомещенийКвартиры.Найти(ТипПомещения) <> Неопределено);
		
		ЭтоНеклассифицированноеПомещениеКвартиры = (Не ЭтоПомещениеЗдания И Не ЭтоПомещениеКвартиры);
		
		Если ЭтоПомещениеКвартиры Или ЭтоНеклассифицированноеПомещениеКвартиры Тогда
			КоличествоТиповПомещений = КоличествоТиповПомещений + 1;
		КонецЕсли;
		
		Если КоличествоТиповПомещений > 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

