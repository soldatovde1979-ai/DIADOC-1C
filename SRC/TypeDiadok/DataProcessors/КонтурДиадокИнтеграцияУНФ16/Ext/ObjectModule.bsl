// Заполняет мету электронных актов и накладных
//
// Параметры:
//  Мета - Структура - модель меты передаточного документа
//  УчетныйДокумент - ЛюбаяСсылка - основание электронного акта или накладной
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартный обработчик заполнения меты
//
Процедура ПередаточныеДокументы_ЗаполнитьМету(Мета, УчетныйДокумент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТипОснования = ТипЗнч(УчетныйДокумент);
	
	Если ТипОснования = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоРасходнойНакладной(Мета, УчетныйДокумент);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоАктуВыполненныхРабот(Мета, УчетныйДокумент);
		
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередаточныеДокументы_ЗаполнитьМетуПоРасходнойНакладной(Мета, РасходнаяНакладная)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ВалютаДокумента.Код КАК ВалютаКод,
	|	Шапка.НалогообложениеНДС = &ТипНалогообложения_НеОблагаетсяНДС КАК БезНДС,
	|	Шапка.СуммаДокумента КАК СуммаДокумента,
	|	Шапка.СуммаНДСДоставки КАК СуммаНДСДоставки,
	|	СУММА(ТЧ.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	Документ.РасходнаяНакладная КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная.Запасы КАК ТЧ
	|		ПО Шапка.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Ссылка,
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.ВалютаДокумента.Код,
	|	Шапка.СуммаДокумента,
	|	Шапка.СуммаНДСДоставки,
	|	Шапка.НалогообложениеНДС = &ТипНалогообложения_НеОблагаетсяНДС";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", РасходнаяНакладная);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Мета.Дата = Выборка.Дата;
	Мета.Номер = ПредставлениеНомера(Выборка.Номер);
	Мета.Сумма = Выборка.СуммаДокумента;
	Мета.СуммаНДС = Выборка.СуммаНДС + Выборка.СуммаНДСДоставки;
	Мета.ДокументБезНДС = Выборка.БезНДС;
	Мета.КодВалюты = Выборка.ВалютаКод;
	
КонецПроцедуры

Процедура ПередаточныеДокументы_ЗаполнитьМетуПоАктуВыполненныхРабот(Мета, АктВыполненныхРабот)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.ВалютаДокумента.Код КАК ВалютаКод,
	|	Шапка.НалогообложениеНДС = &ТипНалогообложения_НеОблагаетсяНДС КАК БезНДС,
	|	Шапка.СуммаДокумента КАК СуммаДокумента,
	|	СУММА(ТЧ.СуммаНДС) КАК СуммаНДС
	|ИЗ
	|	Документ.АктВыполненныхРабот КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот.РаботыИУслуги КАК ТЧ
	|		ПО Шапка.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Ссылка,
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.ВалютаДокумента.Код,
	|	Шапка.СуммаДокумента,
	|	Шапка.НалогообложениеНДС = &ТипНалогообложения_НеОблагаетсяНДС";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", АктВыполненныхРабот);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Мета.Дата = Выборка.Дата;
	Мета.Номер = ПредставлениеНомера(Выборка.Номер);
	Мета.Сумма = Выборка.СуммаДокумента;
	Мета.СуммаНДС = Выборка.СуммаНДС;
	Мета.ДокументБезНДС = Выборка.БезНДС;
	Мета.КодВалюты = Выборка.ВалютаКод;
	
КонецПроцедуры

