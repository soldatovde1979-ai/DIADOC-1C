Функция УПД970_НеобходимоВыполнитьПересчетСуммВВалютеРегУчета(ДанныеШапки, СчетФактура)
	
	Перем Результат;
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	
	Если ЭтоСчетФактураНаАванс(СчетФактура) Тогда
		
		Результат = Истина;
		
	ИначеЕсли ДанныеШапки.РасчетыВУсловныхЕдиницах
		И ДанныеШапки.ВалютаДокумента <> ВалютаРеглУчета Тогда
		
		Результат = Истина;
		
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ПерезаполнитьСуммыДокументаВВалютеРегУчета(ДанныеШапки, ТабличныеДанные)
	
	СуммыДокументаВВалютеРегУчета = УПД970_СуммыДокументаВВалютеРегУчетаПоДаннымРегистра(ДанныеШапки.Ссылка);
	ПересчитатьПоКурсу = Ложь;
	ТочностьЦены = 2;
	
	Если Не ЗначениеЗаполнено(СуммыДокументаВВалютеРегУчета) Тогда
		ПересчитатьПоКурсу = Истина;
		КоэффициентПересчета = ДанныеШапки.КурсВзаиморасчетов / ДанныеШапки.КратностьВзаиморасчетов;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		Если ПересчитатьПоКурсу Тогда
			
			ВсегоРегл = Окр(СтрокаТаблицы.СуммаВсего * КоэффициентПересчета, ТочностьЦены);
			НДСРегл = Окр(СтрокаТаблицы.СуммаНДС * КоэффициентПересчета, ТочностьЦены);
			
		Иначе
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ТабличнаяЧастьДокумента", ИдентификаторТабличнойЧасти(СтрокаТаблицы.ИмяТабличнойЧасти));
			ПараметрыОтбора.Вставить("НомерСтрокиДокумента", СтрокаТаблицы.НомерСтроки);
			
			НайденныеСтроки = СуммыДокументаВВалютеРегУчета.НайтиСтроки(ПараметрыОтбора);
			
			Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Продолжить;
			КонецЕсли;
			
			ВсегоРегл = НайденныеСтроки[0].Всего;
			НДСРегл = НайденныеСтроки[0].НДС;
			
		КонецЕсли;
		
		СтрокаТаблицы.СуммаВсего = ВсегоРегл;
		СтрокаТаблицы.СуммаНДС = НДСРегл;
		СтрокаТаблицы.СуммаБезНДС = ВсегоРегл - НДСРегл;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			СтрокаТаблицы.Цена = Окр(СтрокаТаблицы.СуммаБезНДС / СтрокаТаблицы.Количество, ТочностьЦены);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция УПД970_СуммыДокументаВВалютеРегУчетаПоДаннымРегистра(ДокСсылка)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СуммыДокументовРегл.ТабличнаяЧастьДокумента КАК ТабличнаяЧастьДокумента,
	|	СуммыДокументовРегл.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	СуммыДокументовРегл.Всего КАК Всего,
	|	СуммыДокументовРегл.НДС КАК НДС
	|ИЗ
	|	РегистрСведений.СуммыДокументовРегламентированныйУчет КАК СуммыДокументовРегл
	|ГДЕ
	|	СуммыДокументовРегл.Регистратор = &ДокСсылка
	|	И СуммыДокументовРегл.Активность";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокСсылка", ДокСсылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Индексы.Добавить("ТабличнаяЧастьДокумента, НомерСтрокиДокумента");
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ПерезаполнитьВалютуДокумента(ДанныеШапки)
	
	ДанныеШапки.ВалютаДокумента = ВалютаРегламентированногоУчета();
	
	РеквизитыВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеШапки.ВалютаДокумента, "Код, НаименованиеПолное");
	
	ДанныеШапки.ВалютаДокументаКод = РеквизитыВалюты.Код;
	ДанныеШапки.ВалютаДокументаНаименование = РеквизитыВалюты.НаименованиеПолное;
	
КонецПроцедуры

Функция УПД970_ЕстьТабличнаяЧастьДокументыРасчетовСКонтрагентом(Документ)
	
