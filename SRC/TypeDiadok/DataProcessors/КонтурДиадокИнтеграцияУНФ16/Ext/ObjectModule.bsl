// Очищает колонку "СуммаСкидки" в модели табличной части счета на оплату.
// В интеграционном модуле текущей конфигурации скидка уже учтена в цене и
// сумме документа, поэтому выводить её в печатную форму не следует.
//
// Параметры:
//  ТабличнаяЧасть - ТаблицаЗначений - см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату
//
Процедура СчетаНаОплату_ОчиститьСкидки(ТабличнаяЧасть)
	
	ТабличнаяЧасть.ЗаполнитьЗначения(0, "СуммаСкидки");
	
КонецПроцедуры

// Получает код валюты в соответствии с ОКВ
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта, код которой требуется определить
// 
// Возвращаемое значение:
//  Строка - код валюты по ОКВ
//
Функция КодВалютыПоКлассификатору(Валюта)
	
	РеквизитыВалюты = Новый Структура;
	РеквизитыВалюты.Вставить("Код");
	РеквизитыВалюты.Вставить("ЗагружаетсяИзИнтернета");
	РеквизитыВалюты.Вставить("ОсновнаяВалютаКод", "ОсновнаяВалюта.Код");
	
	ЗначенияРеквизитов = БСП_ЗначенияРеквизитовОбъекта(Валюта, РеквизитыВалюты);
	
	Результат = СокрЛП(ЗначенияРеквизитов.Код);
	Если Не ЗначенияРеквизитов.ЗагружаетсяИзИнтернета
		И ЗначениеЗаполнено(ЗначенияРеквизитов.ОсновнаяВалютаКод) Тогда
		Результат = СокрЛП(ЗначенияРеквизитов.ОсновнаяВалютаКод);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция БСП_ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, Реквизиты)
	
	ВыбиратьРазрешенные = Истина;
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СсылкаНаОбъект,
		Реквизиты,
		ВыбиратьРазрешенные
	);
	
	Возврат Результат;
	
КонецФункции

Функция АктыСверок_ПечатнаяФорма1С(СсылкаНаОбъект) Экспорт
	
	ТипОбъекта = ТипЗнч(СсылкаНаОбъект);
	Если ТипОбъекта <> Тип("ДокументСсылка.СверкаВзаиморасчетов") Тогда
		
		Ошибка = СтрШаблон(
			"Неожиданный тип параметра 'СсылкаНаОбъект' (%1)",
			Строка(ТипОбъекта)
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(СсылкаНаОбъект);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	КоллекцияПечатныхФорм = НовыйКоллекцияПечатныхФормДляПечатиДокумента();
	
	АктыСверок_ЗаполнитьКоллекциюПечатныхФорм(КоллекцияПечатныхФорм);
	
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Контракт_ПараметрыВывода_Печать();
	
	МенеджерПечати = Документы.СверкаВзаиморасчетов;
	МенеджерПечати.Печать(
		ДокументПечати,
		ПараметрыПечати,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода
	);
	
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			
			ТабличныйДокумент = Стр.ТабличныйДокумент;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;

	Возврат ТабличныйДокумент;
	
КонецФункции

Функция Контракт_ПараметрыОтправки_Печать()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Получатель", "");
	Результат.Вставить("Тема", "");
	Результат.Вставить("Текст", "");
	
	Возврат Результат;
	
КонецФункции

Функция Контракт_ПараметрыВывода_Печать()
	
	ПараметрыОтправки = Контракт_ПараметрыОтправки_Печать();
	
	Результат = Новый Структура;
	
	
	Результат.Вставить("ПараметрыОтправки", ПараметрыОтправки);
