	Результат = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СФДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК СФДокументыОснования
	|ГДЕ
	|	СФДокументыОснования.ДокументОснование = &ДокументПродажи
	|	И НЕ СФДокументыОснования.Ссылка.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
