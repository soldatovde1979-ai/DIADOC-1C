// Возвращает заполненную протоструктуру титула продавца в формате 970 по данным документа 1С
//
// Параметры:
//  ДокСсылка - ДокументСсылка - ссылка на учетный документ 1С,
//                               по которому заполняется протоконтент титула продавца 970@
//  ФункцияДокумента - Строка - функция УПД (возможные значения: СЧФ, СЧФДОП, ДОП)
//  ДополнительныеПараметры - Структура - Модуль_Ядро.ДополнительныеПараметрыПолученияКонтента
// 
// Возвращаемое значение:
//  Структура - заполненный протоконтент УПД (см. Контракт_ПротоСтруктураУПД970)
//
Функция УПД970_КонтентТитулаПродавца(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры) Экспорт
	
	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактура") Тогда
		
		Если ЭтоСчетФактураНаАванс(ДокСсылка) Тогда
			
			Результат = УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураНаАванс(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
				
		Иначе
			
			Результат = УПД970_КонтентТитулаПродавцаПоДокументуСчетФактура(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
				
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуРасходнаяНакладная(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуКорректировкаРеализации(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуАктВыполненныхРабот(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуЗаказПокупателя(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуОтчетКомитенту(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуОтчетКомиссионера(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПеремещениеЗапасов") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуПеремещениеЗапасов(
			ДокСсылка,
			ДополнительныеПараметры);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетОПереработке") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоДокументуОтчетОПереработке(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
			
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

