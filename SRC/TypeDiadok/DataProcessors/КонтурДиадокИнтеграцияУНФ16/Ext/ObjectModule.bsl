Функция СчетаНаОплату_ПечатнаяФорма1С(ДокСсылка) Экспорт
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(ДокСсылка);
	
	СтруктураТипов = Новый Соответствие;
	СтруктураТипов.Вставить(ДокСсылка.Метаданные().ПолноеИмя(), ДокументПечати);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	КоллекцияПечатныхФорм = СчетаНаОплату_НовыйКоллекцияПечатныхФормДляПечатиДокумента();
	
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Новый Структура;
	
	ПараметрыОтправки = Новый Структура;
	
	ПараметрыОтправки.Вставить("Получатель"	, "");
	ПараметрыОтправки.Вставить("Тема"		, "");
	ПараметрыОтправки.Вставить("Текст"		, "");
	
	ПараметрыВывода.Вставить("ПараметрыОтправки", ПараметрыОтправки);
	
	Документы.СчетНаОплату.Печать(
		ДокументПечати,
		ПараметрыПечати,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода
	);
	
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			
			ТабличныйДокумент = Стр.ТабличныйДокумент;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

// Метод является констркутором служебной коллекции "КоллекцияПечатныхФорм"
