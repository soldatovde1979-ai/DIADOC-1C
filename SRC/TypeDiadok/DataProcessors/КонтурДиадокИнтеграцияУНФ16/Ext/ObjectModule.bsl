	Если НЕ ЭтоПеремещениеЗапасов(ДокСсылка) Тогда
		
		ТекстОшибки = НСтр("ru='Отправка ТОРГ-13 поддержана только для видом операции ""Перемещение""'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = ВалютаРегламентированногоУчета();
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Контент = Контракт_ПротоструктураУПД970();
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокументаПеремещениеЗапасов(ДокСсылка);
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	
	Контент.Function = ФункцияДокументаУПД_ДОП();
