Функция ДокументСодержитТолькоУслуги(Документ1С)
	
	Результат = Истина;
	
	ЕстьТовары = Документ1С.Метаданные().ТабличныеЧасти.Найти("Запасы") <> Неопределено;
	ЭтоОтчетКомитенту = ТипЗнч(Документ1С) = Тип("ДокументСсылка.ОтчетКомитенту");
	
	Если ЕстьТовары И Не ЭтоОтчетКомитенту Тогда
		
		ШаблонЗапроса =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК ВсегоСтрок,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьУслуги,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА НЕ ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьТовары
		|ИЗ
		|	&ПолноеИмяТаблицы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &СсылкаНаОбъект";
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СсылкаНаОбъект", Документ1С);
		Запрос.УстановитьПараметр("ТипыНоменклатурыУслуги", ТипыНоменклатурыУслуги());
		
		ПолноеИмяТаблицы = СтрШаблон("%1.%2", Документ1С.Метаданные().ПолноеИмя(), "Запасы");
		
		Запрос.Текст = СтрЗаменить(ШаблонЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.ВсегоСтрок > 0 Тогда
				Результат = Выборка.ЕстьУслуги И Не Выборка.ЕстьТовары;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТипыНоменклатурыУслуги()
	
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
