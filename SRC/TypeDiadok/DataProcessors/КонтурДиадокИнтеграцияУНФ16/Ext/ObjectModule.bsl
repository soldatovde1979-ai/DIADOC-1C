Функция УПД970_ТекстЗапросаДанныхШапкиДокументаОтчетОПереработке()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеШапки.Ссылка КАК Ссылка,
	|	ДанныеШапки.Номер КАК Номер,
	|	ДанныеШапки.Дата КАК Дата,
	|	ДанныеШапки.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеШапки.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	ДанныеШапки.ВалютаДокумента.НаименованиеПолное КАК ВалютаДокументаНаименование,
	|	ДанныеШапки.Организация КАК Организация,
	|	ДанныеШапки.Организация.КПП КАК ОрганизацияКПП,
	|	ДанныеШапки.Организация.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ДанныеШапки.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(Подразделения.ГоловнаяОрганизация, НЕОПРЕДЕЛЕНО) КАК ГоловноеПодразделение,
	|	ЕСТЬNULL(Подразделения.КПП, """") КАК ПодразделениеКПП,
	|	ЕСТЬNULL(Подразделения.НаименованиеПолное, """") КАК ПодразделениеНаименование,
	|	ДанныеШапки.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА ДанныеШапки.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ ДанныеШапки.Контрагент
	|	КОНЕЦ КАК ГоловнойКонтрагент,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузополучатель.ГоловнойКонтрагент = ДанныеШапки.Контрагент ТОГДА
	|			ЕСТЬNULL(ДанныеШапки.Грузополучатель.КПП, """")
	|		ИНАЧЕ ЕСТЬNULL(ДанныеШапки.Контрагент.КПП, """")
	|	КОНЕЦ КАК КонтрагентКПП,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			И НЕ ДанныеШапки.Организация = ДанныеШапки.Организация.ГоловнаяОрганизация
	|			ТОГДА ДанныеШапки.Организация.ЦифровойИндексОбособленногоПодразделения
	|		КОГДА Подразделения.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			И Подразделения.ГоловнаяОрганизация = ДанныеШапки.Организация
	|			ТОГДА Подразделения.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЦифровойИндексОП,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация
	|		ИНАЧЕ ДанныеШапки.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент
	|		ИНАЧЕ ДанныеШапки.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ДанныеШапки.АдресДоставки КАК АдресДоставки,
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ДанныеШапки.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.БанковскийСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация.БанковскийСчетПоУмолчанию
	|		ИНАЧЕ ДанныеШапки.БанковскийСчет
	|	КОНЕЦ КАК БанковскийСчетОрганизации,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.БанковскийСчетКонтрагента = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент.БанковскийСчетПоУмолчанию
	|		ИНАЧЕ ДанныеШапки.БанковскийСчетКонтрагента
	|	КОНЕЦ КАК БанковскийСчетКонтрагента,
	|	ДанныеШапки.Договор КАК ДоговорКонтрагента,
	|	ДанныеШапки.Курс КАК КурсВзаиморасчетов,
	|	ДанныеШапки.Кратность КАК КратностьВзаиморасчетов,
	|	ДоговорыКонтрагентов.ДатаДоговора КАК ДоговорДата,
	|	ДоговорыКонтрагентов.НомерДоговора КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ДоговорыКонтрагентов.ВалютаРасчетов КАК ВалютаВзаиморасчетов
	|ИЗ
	|	Документ.ОтчетОПереработке КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ДанныеШапки.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК Подразделения
	|		ПО ДанныеШапки.Подразделение = Подразделения.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	ВыражениеАдресДоставкиЗначение = "ДанныеШапки.АдресДоставкиЗначение";
	
	Если НЕ ЕстьРеквизитОбъектаЛок("АдресДоставкиЗначение", Метаданные.Документы.КорректировкаРеализации) Тогда
		 ВыражениеАдресДоставкиЗначение = """"""; // 1.6.26 и ниже
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&АдресДоставкиЗначение", ВыражениеАдресДоставкиЗначение);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаОтчетОПереработке()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товар"" КАК ТипНоменклатуры,
	|	""Продукция"" КАК ИмяТабличнойЧасти,
	|	1 КАК Порядок,
	|	3 КАК ИдентификаторСтроки,
	|	ТчПродукция.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	"""" КАК ТоварСодержание,
	|	ВЫБОР
	|		КОГДА &ПредставлениеКодовВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.КодыНоменклатурыВДокументах.Артикул)
	|			ТОГДА СпрНоменклатура.Артикул
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	ТчПродукция.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.НаименованиеДляПечати, """") КАК ХарактеристикаНоменклатурыНаименование,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	ТчПродукция.СерииНоменклатуры КАК СерияНоменклатурыНаименование,
	|	СпрНоменклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(СпрНоменклатура.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(СпрНоменклатура.СтранаПроисхождения.УчастникЕАЭС, ЛОЖЬ) КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ВЫБОР
	|		КОГДА ТчПродукция.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчПродукция.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчПродукция.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТчПродукция.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчПродукция.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчПродукция.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Наименование, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА ТчПродукция.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчПродукция.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчПродукция.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Код, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	НЕОПРЕДЕЛЕНО КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ТчПродукция.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И НЕ &ИспользоватьБазовыеЕИ
	|			ТОГДА ТчПродукция.Количество * ТчПродукция.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТчПродукция.Количество
	|	КОНЕЦ КАК Количество,
	|	ТчПродукция.Цена КАК Цена,
	|	ТчПродукция.СтавкаНДС КАК СтавкаНДС,
	|	ТчПродукция.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчПродукция.Сумма - ТчПродукция.СуммаНДС
	|		ИНАЧЕ ТчПродукция.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчПродукция.Сумма + ТчПродукция.СуммаНДС
	|		ИНАЧЕ ТчПродукция.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	НЕОПРЕДЕЛЕНО КАК СуммаАкциза,
	|	ТчПродукция.НомерСтроки КАК НомерСтроки,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	ЛОЖЬ КАК ПрослеживаемыйКомплект,
	|	СпрНоменклатура.ТоварнаяНоменклатураВЭД КАК НоменклатураТНВЭД,
	|	ТчПродукция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетОПереработке.Продукция КАК ТчПродукция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетОПереработке КАК ДанныеШапки
	|		ПО ТчПродукция.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчПродукция.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО ТчПродукция.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|ГДЕ
	|	ТчПродукция.Ссылка = &Ссылка";
	
	ИспользоватьБазовыеЕИ = ИспользоватьБазовыеЕдиницыИзмеренияВТабличнойЧастиДокумента();
	
	Результат = СтрЗаменить(Результат, "&ИспользоватьБазовыеЕИ", ИспользоватьБазовыеЕИ);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаСведенийОПрослеживаемостиОбщее(ТипДокумента)
	
	Результат =
	"ВЫБРАТЬ
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.Количество КАК Количество,
	|	СведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	&ПрослеживаемостьСтрана КАК СтранаПроисхождения,
	|	&ПрослеживаемостьСтранаКод КАК СтранаПроисхожденияКод,
	|	&ПрослеживаемостьСтранаУчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	&НоменклатураТНВЭД КАК НоменклатураТНВЭД,
	|	&СведенияПрослеживаемостиСумма КАК Сумма,
	|	НомераГТД.Код КАК НомерРНПТ,
	|	""Прослеж"" КАК НомерГТД
	|ИЗ
	|	Документ.РасходнаяНакладная.СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|		ПО СведенияПрослеживаемости.РНПТ = НомераГТД.Ссылка
	|
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка";
	
	БазовыйТипДокумента = "РасходнаяНакладная";
	Результат = СтрЗаменить(Результат, БазовыйТипДокумента, ТипДокумента);
	
	УПД970_УстановитьВТекстЗапросаСведенияПрослеживаемостиСтрана(Результат, ТипДокумента);
	УПД970_УстановитьВТекстЗапросаСведенияПрослеживаемостиСумма(Результат, ТипДокумента);
	УПД970_УстановитьВТекстЗапросаСведенияПрослеживаемостиТНВЭД(Результат, ТипДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаУслугиДоставкиОбщее(ТипДокумента)
	
	Результат = "
	|ВЫБРАТЬ
	|	""Услуга"" КАК ТипНоменклатуры,
	|	""Запасы"" КАК ИмяТабличнойЧасти,
	|	2 КАК Порядок,
	|	0 КАК ИдентификаторСтроки,
	|	ДанныеШапки.НоменклатураДоставки КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	"""" КАК ТоварСодержание,
	|	ВЫБОР
	|		КОГДА &ПредставлениеКодовВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.КодыНоменклатурыВДокументах.Артикул)
	|			ТОГДА СпрНоменклатура.Артикул
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК ХарактеристикаНоменклатуры,
	|	"""" КАК ХарактеристикаНоменклатурыНаименование,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	"""" КАК СерияНоменклатурыНаименование,
	|	СпрНоменклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	СтраныМира.Код КАК СтранаПроисхожденияКод,
	|	СтраныМира.УчастникЕАЭС КАК СтранаПроисхожденияУчастникЕАЭС,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СпрНоменклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмеренияНаименование,
	|	СпрНоменклатура.ЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод,
	|	"""" КАК НомерГТД,
	|	1 КАК Количество,
	|	ДанныеШапки.СтоимостьДоставки КАК Цена,
	|	ДанныеШапки.СтавкаНДСДоставки КАК СтавкаНДС,
	|	ДанныеШапки.СуммаНДСДоставки КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ДанныеШапки.СтоимостьДоставки - ДанныеШапки.СуммаНДСДоставки
	|		ИНАЧЕ ДанныеШапки.СтоимостьДоставки
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ДанныеШапки.СтоимостьДоставки + ДанныеШапки.СуммаНДСДоставки
	|		ИНАЧЕ ДанныеШапки.СтоимостьДоставки
	|	КОНЕЦ КАК СуммаВсего,
	|	"""" КАК СуммаАкциза,
	|	0 КАК НомерСтроки,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар,
	|	ЛОЖЬ КАК ПрослеживаемыйКомплект,
	|	СпрНоменклатура.ТоварнаяНоменклатураВЭД КАК НоменклатураТНВЭД,
	|	ДанныеШапки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасходнаяНакладная КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ДанныеШапки.НоменклатураДоставки = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО СпрНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка
	|	И ДанныеШапки.НоменклатураДоставки <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И &ВыводитьБесплатнуюДоставку";
	
	БазовыйТипДокумента = "РасходнаяНакладная";
	Результат = СтрЗаменить(Результат, БазовыйТипДокумента, ТипДокумента);
	
	ЗначениеКонстанты = Константы.ВариантПечатиДоставки.Получить();
	Если ЗначениеКонстанты = Перечисления.ВариантыПечатиДоставки.НеВыводитьБесплатнуюДоставку Тогда
		ВыводитьБесплатнуюДоставку = "ДанныеШапки.СтоимостьДоставки > 0";
	Иначе
		ВыводитьБесплатнуюДоставку = "ИСТИНА";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&ВыводитьБесплатнуюДоставку", ВыводитьБесплатнуюДоставку);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныеПоДокументуПеремещениеЗапасов()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номер КАК Номер,
	|	Т.Дата КАК Дата,
	|	Т.Организация КАК Организация,
	|	Т.СтруктурнаяЕдиница КАК ПодразделениеОтправитель,
	|	Т.СтруктурнаяЕдиницаПолучатель КАК ПодразделениеПолучатель,
	|	Т.ВидОперации КАК ВидОперации
	|ИЗ
	|	Документ.ПеремещениеЗапасов КАК Т
	|ГДЕ
	|	Т.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата,
	|	Т.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Т.ВидЦен.ВалютаЦены КАК ВалютаЦены,
	|	Т.ВидЦен КАК ВидЦен,
	|	Т.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_ЦеныНоменклатурыСрезПоследних
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|		&ДатаДокумента,
	|		Номенклатура В (&СписокНоменклатура)
	|			И Характеристика В (&СписокХарактеристика)
	|			И ВидЦен = &ВидЦен) КАК Т;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Валюта КАК Валюта,
	|	Т.Курс КАК Курс,
	|	Т.Кратность КАК Кратность
	|ПОМЕСТИТЬ ВТ_КурсыУпрВалюты
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(
	|		&ДатаДокумента,
	|		Валюта В
	|			(ВЫБРАТЬ
	|				Константы.ВалютаУчета КАК ВалютаУчета
	|			ИЗ
	|				Константы КАК Константы)) КАК Т;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Валюта КАК Валюта,
	|	Т.Курс КАК Курс,
	|	Т.Кратность КАК Кратность
	|ПОМЕСТИТЬ ВТ_КурсыЦенВалюты
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(
	|		&ДатаДокумента,
	|		Валюта В
	|			(ВЫБРАТЬ
	|				ЦеныНоменклатурыСрезПоследних.ВалютаЦены КАК ВалютаЦены
	|			ИЗ
	|				ВТ_ЦеныНоменклатурыСрезПоследних КАК ЦеныНоменклатурыСрезПоследних)) КАК Т;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товар"" КАК ТипНоменклатуры,
	|	Запасы.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	"""" КАК ТоварСодержание,
	|	ВЫБОР
	|		КОГДА &ПредставлениеКодовВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.КодыНоменклатурыВДокументах.Артикул)
	|			ТОГДА СпрНоменклатура.Артикул
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	Запасы.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.НаименованиеДляПечати, """") КАК ХарактеристикаНоменклатурыНаименование,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	Запасы.СерииНоменклатуры КАК СерияНоменклатурыНаименование,
	|	Запасы.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(Запасы.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(Запасы.СтранаПроисхождения.УчастникЕАЭС, ЛОЖЬ) КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ВЫБОР
	|		КОГДА Запасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И НЕ &ИспользоватьБазовыеЕИ
	|			ТОГДА Запасы.Количество * Запасы.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ Запасы.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА Запасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И Запасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА Запасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА Запасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И Запасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Запасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Наименование, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА Запасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И Запасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(Запасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Код, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ЦеныНоменклатурыСрезПоследних.Цена * Запасы.Количество * КурсыЦенВалюты.Курс * КурсыУпрВалюты.Кратность /
	|		(КурсыУпрВалюты.Курс * КурсыЦенВалюты.Кратность) / ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.ЕдиницаИзмерения.Коэффициент, 1) КАК ЧИСЛО(15, 2)), 0) КАК Сумма,
	|	Запасы.ИдентификаторСтроки КАК НомерСтроки,
	|	Запасы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПеремещениеЗапасов.Запасы КАК Запасы
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО Запасы.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО Запасы.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЦеныНоменклатурыСрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|		ПО Запасы.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И Запасы.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
	|			И Запасы.Ссылка.СтруктурнаяЕдиницаПолучатель.РозничныйВидЦен = ЦеныНоменклатурыСрезПоследних.ВидЦен
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсыУпрВалюты КАК КурсыУпрВалюты
	|		ПО (ИСТИНА)
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсыЦенВалюты КАК КурсыЦенВалюты
	|		ПО ЦеныНоменклатурыСрезПоследних.ВалютаЦены = КурсыЦенВалюты.Валюта
	|ГДЕ
	|	Запасы.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_УстановитьВТекстЗапросаНомерСчетФактуры(ТекстЗапроса)
	
	МетаданныеСчетФактура = Метаданные.Документы.СчетФактура;
	
	Если Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеСчетФактура, "НомерНаПечать") Тогда
		
		НомерСчетФактуры = 
		"ВЫБОР
		|		КОГДА ДЛИНАСТРОКИ(СчетФактура.НомерНаПечать) > 0
		|			ТОГДА СчетФактура.НомерНаПечать
		|		ИНАЧЕ СчетФактура.Номер
		|	КОНЕЦ";
		
		НомерИсправляемогоСчетФактуры =
		"ВЫБОР
		|		КОГДА ДЛИНАСТРОКИ(ВЫРАЗИТЬ(СчетФактура.ИсправляемыйСчетФактура КАК Документ.СчетФактура).НомерНаПечать) > 0
		|			ТОГДА ВЫРАЗИТЬ(СчетФактура.ИсправляемыйСчетФактура КАК Документ.СчетФактура).НомерНаПечать
		|		ИНАЧЕ ВЫРАЗИТЬ(СчетФактура.ИсправляемыйСчетФактура КАК Документ.СчетФактура).Номер
		|	КОНЕЦ";
		
	Иначе
		НомерСчетФактуры = "СчетФактура.Номер";
		НомерИсправляемогоСчетФактуры = "ВЫРАЗИТЬ(СчетФактура.ИсправляемыйСчетФактура КАК Документ.СчетФактура).Номер";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерСчетФактуры", НомерСчетФактуры);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерИсправляемогоСчетФактуры", НомерИсправляемогоСчетФактуры);
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаПрослеживаемыйКомплект(ТекстЗапроса, ТипДокумента, ИмяТабЧасти)
	
	МетаданныеТабЧасти = Метаданные.Документы[ТипДокумента].ТабличныеЧасти[ИмяТабЧасти];
	
	Если НЕ Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеТабЧасти, "ПрослеживаемыйКомплект") Тогда
		ЗаменяемоеПоле = СтрШаблон("Тч%1.ПрослеживаемыйКомплект", ИмяТабЧасти);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаменяемоеПоле, "Ложь");
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаПрослеживаемыйТовар(ТекстЗапроса, ТипДокумента, ИмяТабЧасти)
	
	МетаданныеТабЧасти = Метаданные.Документы[ТипДокумента].ТабличныеЧасти[ИмяТабЧасти];
	
	Если НЕ Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеТабЧасти, "ПрослеживаемыйТовар") Тогда
		ЗаменяемоеПоле = СтрШаблон("Тч%1.ПрослеживаемыйТовар", ИмяТабЧасти);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаменяемоеПоле, "Ложь");
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаИдентификаторСтроки(ТекстЗапроса, ТипДокумента, ИмяТабЧасти)
	
	МетаданныеТабЧасти = Метаданные.Документы[ТипДокумента].ТабличныеЧасти[ИмяТабЧасти];
	
	Если НЕ Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеТабЧасти, "ИдентификаторСтроки") Тогда
		ЗаменяемоеПоле = СтрШаблон("Тч%1.ИдентификаторСтроки", ИмяТабЧасти);
		ЗаменяющееПоле = СтрШаблон("Тч%1.НомерСтроки", ИмяТабЧасти);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаменяемоеПоле, ЗаменяющееПоле);
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаСведенияПрослеживаемостиСтрана(ТекстЗапроса, ТипДокумента)
	
	МетаданныеПрослеживаемости = Метаданные.Документы[ТипДокумента].ТабличныеЧасти.СведенияПрослеживаемости;
	
	ЕстьСтрана = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеПрослеживаемости, "СтранаПроисхождения");
	ЕстьНоменклатура = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеПрослеживаемости, "Номенклатура");
	
	Если ЕстьСтрана И ЕстьНоменклатура Тогда
		ПрослеживаемостьСтрана = "ВЫБОР
			|		КОГДА СведенияПрослеживаемости.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
			|			ТОГДА СведенияПрослеживаемости.СтранаПроисхождения
			|		ИНАЧЕ СведенияПрослеживаемости.Номенклатура.СтранаПроисхождения
			|	КОНЕЦ";
		ПрослеживаемостьСтранаКод = "ВЫБОР
			|		КОГДА СведенияПрослеживаемости.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
			|			ТОГДА СведенияПрослеживаемости.СтранаПроисхождения.Код
			|		ИНАЧЕ СведенияПрослеживаемости.Номенклатура.СтранаПроисхождения.Код
			|	КОНЕЦ";
		ПрослеживаемостьСтранаУчастникЕАЭС = "ВЫБОР
			|		КОГДА СведенияПрослеживаемости.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
			|			ТОГДА СведенияПрослеживаемости.СтранаПроисхождения.УчастникЕАЭС
			|		ИНАЧЕ СведенияПрослеживаемости.Номенклатура.СтранаПроисхождения.УчастникЕАЭС
			|	КОНЕЦ";
	ИначеЕсли ЕстьНоменклатура Тогда
		ПрослеживаемостьСтрана = "СведенияПрослеживаемости.Номенклатура.СтранаПроисхождения";
		ПрослеживаемостьСтранаКод = "СведенияПрослеживаемости.Номенклатура.СтранаПроисхождения.Код";
		ПрослеживаемостьСтранаУчастникЕАЭС = "СведенияПрослеживаемости.Номенклатура.СтранаПроисхождения.УчастникЕАЭС";
	Иначе
		ПрослеживаемостьСтрана = "НЕОПРЕДЕЛЕНО";
		ПрослеживаемостьСтранаКод = """""";
		ПрослеживаемостьСтранаУчастникЕАЭС = "ЛОЖЬ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПрослеживаемостьСтранаУчастникЕАЭС", ПрослеживаемостьСтранаУчастникЕАЭС);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПрослеживаемостьСтранаКод", ПрослеживаемостьСтранаКод);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПрослеживаемостьСтрана", ПрослеживаемостьСтрана);
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаСведенияПрослеживаемостиСумма(ТекстЗапроса, ТипДокумента)
	
	МетаданныеПрослеживаемости = Метаданные.Документы[ТипДокумента].ТабличныеЧасти.СведенияПрослеживаемости;
	
	Если Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеПрослеживаемости, "Сумма") Тогда
		СведенияПрослеживаемостиСумма = "СведенияПрослеживаемости.Сумма";
	Иначе
		СведенияПрослеживаемостиСумма = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СведенияПрослеживаемостиСумма", СведенияПрослеживаемостиСумма);
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаСведенияПрослеживаемостиТНВЭД(ТекстЗапроса, ТипДокумента)
	
	МетаданныеПрослеживаемости = Метаданные.Документы[ТипДокумента].ТабличныеЧасти.СведенияПрослеживаемости;
	
	ЕстьНоменклатура = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеПрослеживаемости, "Номенклатура");
	
	Если ЕстьНоменклатура Тогда
		
		НоменклатураТНВЭД = "СведенияПрослеживаемости.Номенклатура.ТоварнаяНоменклатураВЭД";
		
	Иначе
		
		НоменклатураТНВЭД = "НЕОПРЕДЕЛЕНО";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НоменклатураТНВЭД", НоменклатураТНВЭД);
	
КонецПроцедуры

Процедура УПД970_УстановитьВТекстЗапросаСуммуАкциза(ТекстЗапроса, ТипДокумента, ИмяТабЧасти)
	
	ЗаменяемоеПоле = "&СуммаАкциза";
	МетаданныеТабЧасти = Метаданные.Документы[ТипДокумента].ТабличныеЧасти[ИмяТабЧасти];
	
	Если Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеТабЧасти, "СуммаАкциза") Тогда
		
		Если Ядро.Общее_ЕстьРеквизитМетаданных(Метаданные.Справочники.Номенклатура, "ПодакцизныйТовар") Тогда
			ШаблонЗаменяющегоПоля = 
			"ВЫБОР
			|		КОГДА СпрНоменклатура.ПодакцизныйТовар
			|			ТОГДА Тч%1.СуммаАкциза
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ";
		Иначе
			ШаблонЗаменяющегоПоля = "Тч%1.СуммаАкциза";
		КонецЕсли;
		
		ЗаменяющееПоле = СтрШаблон(ШаблонЗаменяющегоПоля, ИмяТабЧасти);
		
	Иначе
		ЗаменяющееПоле = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЗаменяемоеПоле, ЗаменяющееПоле);
	
КонецПроцедуры

