Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаОтчетКомиссионера()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Товар"" КАК ТипНоменклатуры,
	|	""Запасы"" КАК ИмяТабличнойЧасти,
	|	1 КАК Порядок,
	|	ТчЗапасы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТчЗапасы.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	"""" КАК ТоварСодержание,
	|	ВЫБОР
	|		КОГДА &ПредставлениеКодовВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.КодыНоменклатурыВДокументах.Артикул)
	|			ТОГДА СпрНоменклатура.Артикул
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	ТчЗапасы.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.НаименованиеДляПечати, """") КАК ХарактеристикаНоменклатурыНаименование,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	ТчЗапасы.СерииНоменклатуры КАК СерияНоменклатурыНаименование,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА ТчЗапасы.СтранаПроисхождения
	|		ИНАЧЕ СпрНоменклатура.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА СтраныМираЗапасы.Код
	|		ИНАЧЕ СтраныМира.Код
	|	КОНЕЦ КАК СтранаПроисхожденияКод,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА СтраныМираЗапасы.УчастникЕАЭС
	|		ИНАЧЕ СтраныМира.УчастникЕАЭС
	|	КОНЕЦ КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Наименование, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Код, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	ТчЗапасы.НомерГТД.Код КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И НЕ &ИспользоватьБазовыеЕИ
	|			ТОГДА ТчЗапасы.Количество * ТчЗапасы.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТчЗапасы.Количество
	|	КОНЕЦ КАК Количество,
	|	ТчЗапасы.Цена КАК Цена,
	|	ТчЗапасы.СтавкаНДС КАК СтавкаНДС,
	|	ТчЗапасы.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчЗапасы.Сумма - ТчЗапасы.СуммаНДС
	|		ИНАЧЕ ТчЗапасы.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчЗапасы.Сумма + ТчЗапасы.СуммаНДС
	|		ИНАЧЕ ТчЗапасы.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	0 КАК СуммаАкциза,
	|	ТчЗапасы.НомерСтроки КАК НомерСтроки,
	|	ТчЗапасы.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТчЗапасы.ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	СпрНоменклатура.ТоварнаяНоменклатураВЭД КАК НоменклатураТНВЭД,
	|	ТчЗапасы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОтчетКомиссионера.Запасы КАК ТчЗапасы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионера.Покупатели КАК ТчПокупатели
	|		ПО ТчЗапасы.Ссылка = ТчПокупатели.Ссылка
	|			И ТчЗапасы.КлючСвязи = ТчПокупатели.КлючСвязи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионера КАК ДанныеШапки
	|		ПО ТчЗапасы.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчЗапасы.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО ТчЗапасы.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО (СпрНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМираЗапасы
	|		ПО ТчЗапасы.СтранаПроисхождения = СтраныМираЗапасы.Ссылка
	|ГДЕ
	|	ТчЗапасы.Ссылка = &Ссылка
	|	И ТчПокупатели.СчетФактура = &СчетФактура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки";
	
	ИспользоватьБазовыеЕИ = ИспользоватьБазовыеЕдиницыИзмеренияВТабличнойЧастиДокумента();
	
	Результат = СтрЗаменить(Результат, "&ИспользоватьБазовыеЕИ", ИспользоватьБазовыеЕИ);
	
	УПД970_УстановитьВТекстЗапросаПрослеживаемыйКомплект(Результат, "ОтчетКомиссионера", "Запасы");
	
	Возврат Результат;
	
КонецФункции

