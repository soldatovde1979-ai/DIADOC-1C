	);
	
	Контент.DocumentShipments.Добавить(DocumentShipment);
	
	УПД970_ЗаполнитьСведенияОбУчастникахВнутреннегоЭДО(Контент, ДанныеШапки);
	
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымПеремещения(
		Контент,
		ДанныеПоДокументу.ТаблицаДокумента,
		ДополнительныеПараметры
	);
	
	УПД970_ЗаполнитьРеквизитыОснованияПеремещенияЗапасов(Контент, ДополнительныеПараметры);
