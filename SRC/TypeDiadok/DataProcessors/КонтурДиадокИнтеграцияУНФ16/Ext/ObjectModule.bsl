	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.БанковскийСчетПоУмолчанию КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	ВЫРАЗИТЬ(ДанныеДокумента.ПодписьРуководителя.РасшифровкаПодписи КАК СТРОКА(1000)) КАК ПодписантФамилияИО,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.НалогообложениеНДС <> &ТипНалогообложения_НеОблагаетсяНДС КАК УчитыватьНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ОтчетОПереработке КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ДанныеДокумента.Содержание КАК СодержаниеУслуги,
	|	ДанныеДокумента.Характеристика КАК Характеристика,
	|	&ПолеХарактеристикаНаименование КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	&ПолеСуммаСкидки КАК СуммаСкидки,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ОтчетОПереработке.Продукция КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	ЗаполнитьВыраженияЗапросаПоУмолчанию(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументПродажи);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	МодельШапка.РуководительФИО = ДанныеШапки.ПодписантФамилияИО;
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			Запись.НоменклатураНаименование,
			Запись.ХарактеристикаНаименование,
			Запись.СодержаниеУслуги
		);
		
		Если Запись.СуммаСкидки <> 0 Тогда
			СчетаНаОплату_ПересчитатьЦену(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СчетаНаОплату_ДокументПродажи_ОтчетКомитенту(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.БанковскийСчетПоУмолчанию КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	ВЫРАЗИТЬ(ДанныеДокумента.ПодписьРуководителя.РасшифровкаПодписи КАК СТРОКА(1000)) КАК ПодписантФамилияИО,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.НалогообложениеНДС <> &ТипНалогообложения_НеОблагаетсяНДС КАК УчитыватьНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ОтчетКомитенту КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	1 КАК НомерСтроки,
	|	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	|	"""" КАК НоменклатураАртикул,
	|	""Комиссионное вознаграждение"" КАК НоменклатураНаименование,
	|	""Комиссионное вознаграждение"" КАК СодержаниеУслуги,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	"""" КАК ХарактеристикаНаименование,
	|	&ЕдиницаИзмеренияШтука КАК ЕдиницаИзмерения,
	|	1 КАК Количество,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	0 КАК СуммаСкидки,
	|	СУММА(ДанныеДокумента.СуммаВознаграждения) КАК Цена,
	|	СУММА(ДанныеДокумента.СуммаВознаграждения) КАК Сумма,
	|	СУММА(ДанныеДокумента.СуммаНДСВознаграждения) КАК СуммаНДС
	|ИЗ
	|	Документ.ОтчетКомитенту.Запасы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеДокумента.СтавкаНДС
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументПродажи);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияШтука", Справочники.КлассификаторЕдиницИзмерения.Шт);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	МодельШапка.РуководительФИО = ДанныеШапки.ПодписантФамилияИО;
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			Запись.НоменклатураНаименование,
			Запись.ХарактеристикаНаименование,
			Запись.СодержаниеУслуги
		);
		
		Если Запись.СуммаСкидки <> 0 Тогда
			СчетаНаОплату_ПересчитатьЦену(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВыраженияЗапросаПоУмолчанию(ТекстЗапроса)
	
	Подстановки = Новый Соответствие;
	Подстановки.Вставить(
		"&ПолеНоменклатураНаименование",
		ВыражениеЗапросаНоменклатураНаименование("ДанныеДокумента.Номенклатура")
	);
	Подстановки.Вставить(
		"&ПолеНоменклатураДоставкиНаименование",
		ВыражениеЗапросаНоменклатураНаименование("ДанныеДокумента.НоменклатураДоставки")
	);
	Подстановки.Вставить(
		"&ПолеНоменклатураАртикул",
		ВыражениеЗапросаНоменклатураАртикул("ДанныеДокумента.Номенклатура")
	);
	Подстановки.Вставить(
		"&ПолеНоменклатураДоставкиАртикул",
		ВыражениеЗапросаНоменклатураАртикул("ДанныеДокумента.НоменклатураДоставки")
	);
	Подстановки.Вставить(
		"&ПолеХарактеристикаНаименование",
		ВыражениеЗапросаХарактеристикаНаименование("ДанныеДокумента.Характеристика")
	);
	Подстановки.Вставить(
		"&ПолеСуммаСкидки",
		ВыражениеЗапросаСуммаСкидки("ДанныеДокумента.СуммаСкидкиНаценки", "ДанныеДокумента.СуммаАвтоматическойСкидки")
	);
	Подстановки.Вставить(
		"&УсловиеВыводитьДоставку",
		ВыражениеЗапросаУсловиеВыводитьДоставку("ДанныеДокумента.НоменклатураДоставки", "ДанныеДокумента.СтоимостьДоставки")
	);
	
	Для Каждого Элемент Из Подстановки Цикл
		
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			Элемент.Ключ,
			Элемент.Значение
		);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВыражениеЗапросаНоменклатураАртикул(ПолеНоменклатура)
	
	ЗначениеКонстанты = Константы.ПредставлениеКодовВПечатныхФормах.Получить();
	
	Если ЗначениеКонстанты = Перечисления.КодыНоменклатурыВДокументах.Артикул Тогда
		Выражение = "ПсевдонимТаблицы.Номенклатура.Артикул";
	ИначеЕсли ЗначениеКонстанты = Перечисления.КодыНоменклатурыВДокументах.Код Тогда
		Выражение = "ПсевдонимТаблицы.Номенклатура.Код";
	ИначеЕсли ЗначениеКонстанты = Перечисления.КодыНоменклатурыВДокументах.Штрихкод Тогда
		Выражение = "ПсевдонимТаблицы.Номенклатура.Штрихкод";
	Иначе
		Выражение = """""";
	КонецЕсли;
	
	Результат = СтрЗаменить(
		Выражение,
		"ПсевдонимТаблицы.Номенклатура",
		ПолеНоменклатура
	);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеЗапросаНоменклатураНаименование(ПолеНоменклатура)
	
	Выражение = 
	"ВЫБОР
	|		КОГДА НЕ (ПсевдонимТаблицы.Номенклатура.НаименованиеПолное ПОДОБНО """")
	|			ТОГДА ПсевдонимТаблицы.Номенклатура.НаименованиеПолное
	|		ИНАЧЕ ПсевдонимТаблицы.Номенклатура.Наименование
	|	КОНЕЦ";
	
	Результат = СтрЗаменить(
		Выражение,
		"ПсевдонимТаблицы.Номенклатура",
		ПолеНоменклатура
	);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеЗапросаХарактеристикаНаименование(ПолеХарактеристика)
	
	Выражение = 
	"ВЫБОР
	|		КОГДА НЕ (ПсевдонимТаблицы.Характеристика.НаименованиеДляПечати ПОДОБНО """")
	|			ТОГДА ПсевдонимТаблицы.Характеристика.НаименованиеДляПечати
	|		ИНАЧЕ ПсевдонимТаблицы.Характеристика.Наименование
	|	КОНЕЦ";
	
	Результат = СтрЗаменить(Выражение, "ПсевдонимТаблицы.Характеристика", ПолеХарактеристика);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеЗапросаСуммаСкидки(ПолеСуммаСкидкиНаценки, ПолеСуммаАвтоматическойСкидки)
	
	Результат = "ПсевдонимТаблицы.СуммаСкидкиНаценки + ПсевдонимТаблицы.СуммаАвтоматическойСкидки";
	
	Результат = СтрЗаменить(Результат, "ПсевдонимТаблицы.СуммаСкидкиНаценки", ПолеСуммаСкидкиНаценки);
	Результат = СтрЗаменить(Результат, "ПсевдонимТаблицы.СуммаАвтоматическойСкидки", ПолеСуммаАвтоматическойСкидки);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеЗапросаУсловиеВыводитьДоставку(ПолеНоменклатураДоставки, ПолеСтоимостьДоставки)
	
	ЗначениеКонстанты = Константы.ВариантПечатиДоставки.Получить();
	
	Результат = "ПсевдонимТаблицы.НоменклатураДоставки <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	
	Если ЗначениеКонстанты = Перечисления.ВариантыПечатиДоставки.НеВыводитьБесплатнуюДоставку Тогда
		Результат = "ПсевдонимТаблицы.СтоимостьДоставки > 0";
	КонецЕсли;
	
	Результат = СтрЗаменить(
		Результат,
		"ПсевдонимТаблицы.НоменклатураДоставки",
		ПолеНоменклатураДоставки
	);
	
	Результат = СтрЗаменить(
		Результат,
		"ПсевдонимТаблицы.СтоимостьДоставки",
