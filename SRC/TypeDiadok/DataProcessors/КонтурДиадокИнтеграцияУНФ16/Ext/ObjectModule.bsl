	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПредставлениеКодовВПечатныхФормах", ПредставлениеКодовВПечатныхФормах);
	Запрос.УстановитьПараметр("ВидЦен", ДокСсылка.СтруктурнаяЕдиницаПолучатель.РозничныйВидЦен);
	Запрос.УстановитьПараметр("ДатаДокумента", ДокСсылка.Дата);
	Запрос.УстановитьПараметр("СписокНоменклатура", ДокСсылка.Запасы.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("СписокХарактеристика", ДокСсылка.Запасы.ВыгрузитьКолонку("Характеристика"));
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки = РезультатЗапроса[0].Выгрузить()[0];
	ТаблицаДокумента = РезультатЗапроса[4].Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТаблицаДокумента", ТаблицаДокумента);
	
	Возврат Результат;
	
