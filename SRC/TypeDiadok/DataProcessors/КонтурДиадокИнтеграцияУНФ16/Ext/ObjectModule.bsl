Функция УПД970_ИсходныеДанныеДокументаСчетФактура(ДокСсылка)
	
	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиСчетФактура();
	ТекстЗапросаДанныхОДокументахОплаты = УПД970_ТекстЗапросаДанныхОДокументахОплатыСчетФактуры();
	ТекстЗапросаДокументыОснования = УПД970_ТекстЗапросаДокументовОснованияСчетФактура();
	ТекстЗапросаАвансовыхДокументов = УПД970_ТекстЗапросаАвансовыхДокументовСчетФактуры();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхОДокументахОплаты);
	ТекстыЗапросов.Добавить(ТекстЗапросаДокументыОснования);
	ТекстыЗапросов.Добавить(ТекстЗапросаАвансовыхДокументов);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ТабДанныеШапки = РезультатыЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТабДанныеШапки[0]);
	
	СведенияОДокументахОплаты = РезультатыЗапроса[1].Выгрузить();
	ДокументыОснования = РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку(0);
	АвансовыеДокументы = РезультатыЗапроса[3].Выгрузить();
	
	ОснованияПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваровПоОснованиюСчетФактураВыданный(
		ДокументыОснования
	);
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомитентом);
	ЭтоДоговорСКомиссионером = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером);
	
	Результат = УПД970_Контракт_ДанныеСчетФактура();
	
	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ДокументыОснования = ДокументыОснования;
	Результат.СведенияОДокументахОплаты = СведенияОДокументахОплаты;
	Результат.ЭтоСчетФактураНаАванс = Ложь;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.ЭтоДоговорСКомиссионером = ЭтоДоговорСКомиссионером;
	Результат.ОснованияПередачиТоваров = ОснованияПередачиТоваров;
	Результат.АвансовыеДокументы = АвансовыеДокументы;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеДокументаОснованияСчетаФактуры(ДокументСсылка, СчетФактура)
	
	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаРасходнаяНакладная(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаКорректировкаРеализации(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаАктВыполненныхРабот(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаЗаказПокупателя(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетКомитенту(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетКомиссионера(ДокументСсылка, СчетФактура);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетОПереработке") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетОПереработке(ДокументСсылка, СчетФактура);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа-основания счета-фактура выданный: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокументСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеДокументаСчетФактураВыданныйНаАванс(ДокСсылка)
	
	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиСчетФактураНаАванс();
