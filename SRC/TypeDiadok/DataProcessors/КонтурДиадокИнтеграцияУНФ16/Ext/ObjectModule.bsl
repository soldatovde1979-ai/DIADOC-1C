Функция УПД970_ТекстЗапросаДанныхШапкиДокументаРасходнаяНакладная()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеШапки.Ссылка КАК Ссылка,
	|	ДанныеШапки.Номер КАК Номер,
	|	ДанныеШапки.Дата КАК Дата,
	|	ДанныеШапки.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеШапки.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	ДанныеШапки.ВалютаДокумента.НаименованиеПолное КАК ВалютаДокументаНаименование,
	|	ДанныеШапки.Организация КАК Организация,
	|	ДанныеШапки.Организация.КПП КАК ОрганизацияКПП,
	|	ДанныеШапки.Организация.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ДанныеШапки.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(Подразделения.ГоловнаяОрганизация, НЕОПРЕДЕЛЕНО) КАК ГоловноеПодразделение,
	|	ЕСТЬNULL(Подразделения.КПП, """") КАК ПодразделениеКПП,
	|	ЕСТЬNULL(Подразделения.НаименованиеПолное, """") КАК ПодразделениеНаименование,
	|	ДанныеШапки.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА ДанныеШапки.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ ДанныеШапки.Контрагент
	|	КОНЕЦ КАК ГоловнойКонтрагент,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузополучатель.ГоловнойКонтрагент = ДанныеШапки.Контрагент ТОГДА
	|			ЕСТЬNULL(ДанныеШапки.Грузополучатель.КПП, """")
	|		ИНАЧЕ ЕСТЬNULL(ДанныеШапки.Контрагент.КПП, """")
	|	КОНЕЦ КАК КонтрагентКПП,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			И НЕ ДанныеШапки.Организация = ДанныеШапки.Организация.ГоловнаяОрганизация
	|			ТОГДА ДанныеШапки.Организация.ЦифровойИндексОбособленногоПодразделения
	|		КОГДА Подразделения.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			И Подразделения.ГоловнаяОрганизация = ДанныеШапки.Организация
	|			ТОГДА Подразделения.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЦифровойИндексОП,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация
	|		ИНАЧЕ ДанныеШапки.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент
	|		ИНАЧЕ ДанныеШапки.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ДанныеШапки.АдресДоставки КАК АдресДоставки,
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ДанныеШапки.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.БанковскийСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация.БанковскийСчетПоУмолчанию
	|		ИНАЧЕ ДанныеШапки.БанковскийСчет
	|	КОНЕЦ КАК БанковскийСчетОрганизации,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.БанковскийСчетКонтрагента = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент.БанковскийСчетПоУмолчанию
	|		ИНАЧЕ ДанныеШапки.БанковскийСчетКонтрагента
	|	КОНЕЦ КАК БанковскийСчетКонтрагента,
	|	ДанныеШапки.Договор КАК ДоговорКонтрагента,
	|	ДанныеШапки.Курс КАК КурсВзаиморасчетов,
	|	ДанныеШапки.Кратность КАК КратностьВзаиморасчетов,
	|	ДоговорыКонтрагентов.ДатаДоговора КАК ДоговорДата,
	|	ДоговорыКонтрагентов.НомерДоговора КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ДоговорыКонтрагентов.ВалютаРасчетов КАК ВалютаВзаиморасчетов
	|ИЗ
	|	Документ.РасходнаяНакладная КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ДанныеШапки.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК Подразделения
	|		ПО ДанныеШапки.Подразделение = Подразделения.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	ВыражениеАдресДоставкиЗначение = "ДанныеШапки.АдресДоставкиЗначение";
	
	Если НЕ ЕстьРеквизитОбъектаЛок("АдресДоставкиЗначение", Метаданные.Документы.КорректировкаРеализации) Тогда
		 ВыражениеАдресДоставкиЗначение = """"""; // 1.6.26 и ниже
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&АдресДоставкиЗначение", ВыражениеАдресДоставкиЗначение);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаРасходнаяНакладная()
	
	ТекстЗапросаЗапасы =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ТипНоменклатурыЗапас
	|			ТОГДА ""Товар""
	|		ИНАЧЕ ""Услуга""
	|	КОНЕЦ КАК ТипНоменклатуры,
	|	""Запасы"" КАК ИмяТабличнойЧасти,
	|	1 КАК Порядок,
	|	ТчЗапасы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТчЗапасы.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	ВЫРАЗИТЬ(ТчЗапасы.Содержание КАК СТРОКА(1000)) КАК ТоварСодержание,
	|	ВЫБОР
	|		КОГДА &ПредставлениеКодовВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.КодыНоменклатурыВДокументах.Артикул)
	|			ТОГДА СпрНоменклатура.Артикул
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	ТчЗапасы.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.НаименованиеДляПечати, """") КАК ХарактеристикаНоменклатурыНаименование,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	ТчЗапасы.СерииНоменклатуры КАК СерияНоменклатурыНаименование,
	|	ТчЗапасы.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ТчЗапасы.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ЕСТЬNULL(ТчЗапасы.СтранаПроисхождения.УчастникЕАЭС, ЛОЖЬ) КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Наименование, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Код, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	ТчЗапасы.НомерГТД.Код КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И НЕ &ИспользоватьБазовыеЕИ
	|			ТОГДА ТчЗапасы.Количество * ТчЗапасы.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТчЗапасы.Количество
	|	КОНЕЦ КАК Количество,
	|	ТчЗапасы.Цена КАК Цена,
	|	ТчЗапасы.СтавкаНДС КАК СтавкаНДС,
	|	ТчЗапасы.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчЗапасы.Сумма - ТчЗапасы.СуммаНДС
	|		ИНАЧЕ ТчЗапасы.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчЗапасы.Сумма + ТчЗапасы.СуммаНДС
	|		ИНАЧЕ ТчЗапасы.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	&СуммаАкциза КАК СуммаАкциза,
	|	ТчЗапасы.НомерСтроки КАК НомерСтроки,
	|	ТчЗапасы.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТчЗапасы.ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	СпрНоменклатура.ТоварнаяНоменклатураВЭД КАК НоменклатураТНВЭД,
	|	ТчЗапасы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасходнаяНакладная.Запасы КАК ТчЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК ДанныеШапки
	|		ПО ТчЗапасы.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчЗапасы.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО ТчЗапасы.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|ГДЕ
	|	ТчЗапасы.Ссылка = &Ссылка";
	
	ТекстЗапросаУпорядочить = "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки
	|";
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаЗапасы);
	ТекстыЗапросов.Добавить(ТекстЗапроса_ОбъединитьВсе());
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаУслугиДоставкиОбщее("РасходнаяНакладная"));
	ТекстыЗапросов.Добавить(ТекстЗапросаУпорядочить);
	
	Результат = СтрСоединить(ТекстыЗапросов);
	
	ИспользоватьБазовыеЕИ = ИспользоватьБазовыеЕдиницыИзмеренияВТабличнойЧастиДокумента();
	
	Результат = СтрЗаменить(Результат, "&ИспользоватьБазовыеЕИ", ИспользоватьБазовыеЕИ);
	
	УПД970_УстановитьВТекстЗапросаПрослеживаемыйКомплект(Результат, "РасходнаяНакладная", "Запасы");
	УПД970_УстановитьВТекстЗапросаСуммуАкциза(Результат, "РасходнаяНакладная", "Запасы");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаСведенийОПрослеживаемостиДокументаРасходнаяНакладная()
	
	ТипДокумента = "РасходнаяНакладная";
	Результат = УПД970_ТекстЗапросаСведенийОПрослеживаемостиОбщее(ТипДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиДокументаКорректировкаРеализации()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеШапки.Ссылка КАК Ссылка,
	|	ДанныеШапки.Номер КАК Номер,
	|	ДанныеШапки.Дата КАК Дата,
	|	ДанныеШапки.НомерИсправления КАК НомерИсправления,
	|	ДанныеШапки.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	ДанныеШапки.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	ДанныеШапки.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеШапки.ВалютаДокумента.Код КАК ВалютаДокументаКод,
	|	ДанныеШапки.ВалютаДокумента.НаименованиеПолное КАК ВалютаДокументаНаименование,
	|	ДанныеШапки.Организация КАК Организация,
	|	ДанныеШапки.Организация.КПП КАК ОрганизацияКПП,
	|	ДанныеШапки.Организация.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ДанныеШапки.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(Подразделения.ГоловнаяОрганизация, НЕОПРЕДЕЛЕНО) КАК ГоловноеПодразделение,
	|	ЕСТЬNULL(Подразделения.КПП, """") КАК ПодразделениеКПП,
	|	ЕСТЬNULL(Подразделения.НаименованиеПолное, """") КАК ПодразделениеНаименование,
	|	ДанныеШапки.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|			ТОГДА ДанныеШапки.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ ДанныеШапки.Контрагент
	|	КОНЕЦ КАК ГоловнойКонтрагент,
	|	ДанныеШапки.Контрагент.КПП КАК КонтрагентКПП,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			И НЕ ДанныеШапки.Организация = ДанныеШапки.Организация.ГоловнаяОрганизация
	|			ТОГДА ДанныеШапки.Организация.ЦифровойИндексОбособленногоПодразделения
	|		КОГДА Подразделения.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			И Подразделения.ГоловнаяОрганизация = ДанныеШапки.Организация
	|			ТОГДА Подразделения.ЦифровойИндексОбособленногоПодразделения
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЦифровойИндексОП,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузоотправитель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация
	|		ИНАЧЕ ДанныеШапки.Грузоотправитель
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент
	|		ИНАЧЕ ДанныеШапки.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ДанныеШапки.АдресДоставки КАК АдресДоставки,
	|	&АдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	ДанныеШапки.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.БанковскийСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Организация.БанковскийСчетПоУмолчанию
	|		ИНАЧЕ ДанныеШапки.БанковскийСчет
	|	КОНЕЦ КАК БанковскийСчетОрганизации,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.БанковскийСчетКонтрагента = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	|			ТОГДА ДанныеШапки.Контрагент.БанковскийСчетПоУмолчанию
	|		ИНАЧЕ ДанныеШапки.БанковскийСчетКонтрагента
	|	КОНЕЦ КАК БанковскийСчетКонтрагента,
	|	ДанныеШапки.Договор КАК ДоговорКонтрагента,
	|	ДанныеШапки.Курс КАК КурсВзаиморасчетов,
	|	ДанныеШапки.Кратность КАК КратностьВзаиморасчетов,
	|	ДоговорыКонтрагентов.ДатаДоговора КАК ДоговорДата,
	|	ДоговорыКонтрагентов.НомерДоговора КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах КАК РасчетыВУсловныхЕдиницах,
	|	ДоговорыКонтрагентов.ВалютаРасчетов КАК ВалютаВзаиморасчетов,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Справочник.ХозяйственныеОперации.ИсправлениеОшибки)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Исправление
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ДанныеШапки.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктурныеЕдиницы КАК Подразделения
	|		ПО ДанныеШапки.Подразделение = Подразделения.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	ВыражениеАдресДоставкиЗначение = "ДанныеШапки.АдресДоставкиЗначение";
	
	Если НЕ ЕстьРеквизитОбъектаЛок("АдресДоставкиЗначение", Метаданные.Документы.КорректировкаРеализации) Тогда
		 ВыражениеАдресДоставкиЗначение = """"""; // 1.6.27 и ниже
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&АдресДоставкиЗначение", ВыражениеАдресДоставкиЗначение);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхТабличныхЧастейДокументаКорректировкаРеализации()
	
	ТекстЗапросаЗапасы =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ТипНоменклатурыЗапас
	|			ТОГДА ""Товар""
	|		ИНАЧЕ ""Услуга""
	|	КОНЕЦ КАК ТипНоменклатуры,
	|	""Запасы"" КАК ИмяТабличнойЧасти,
	|	1 КАК Порядок,
	|	ТчЗапасы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТчЗапасы.Номенклатура КАК Товар,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК ТоварПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК ТоварНаименование,
	|	ВЫРАЗИТЬ(ТчЗапасы.Содержание КАК СТРОКА(1000)) КАК ТоварСодержание,
	|	ВЫБОР
	|		КОГДА &ПредставлениеКодовВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.КодыНоменклатурыВДокументах.Артикул)
	|			ТОГДА СпрНоменклатура.Артикул
	|		ИНАЧЕ СпрНоменклатура.Код
	|	КОНЕЦ КАК КодИлиАртикулНоменклатуры,
	|	ТчЗапасы.Характеристика КАК ХарактеристикаНоменклатуры,
	|	ЕСТЬNULL(СпрХарактеристикиНоменклатуры.НаименованиеДляПечати, """") КАК ХарактеристикаНоменклатурыНаименование,
	|	НЕОПРЕДЕЛЕНО КАК СерияНоменклатуры,
	|	ТчЗапасы.СерииНоменклатуры КАК СерияНоменклатурыНаименование,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА ТчЗапасы.СтранаПроисхождения
	|		ИНАЧЕ СпрНоменклатура.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА СтраныМираЗапасы.Код
	|		ИНАЧЕ СтраныМира.Код
	|	КОНЕЦ КАК СтранаПроисхожденияКод,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.СтранаПроисхождения <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|			ТОГДА СтраныМираЗапасы.УчастникЕАЭС
	|		ИНАЧЕ СтраныМира.УчастникЕАЭС
	|	КОНЕЦ КАК СтранаПроисхожденияУчастникЕАЭС,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Наименование, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Наименование
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И &ИспользоватьБазовыеЕИ
	|				И ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(ТчЗапасы.ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Код, """")
	|		ИНАЧЕ СпрНоменклатура.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	ТчЗапасы.НомерГТД.Код КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ТчЗапасы.ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
	|				И НЕ &ИспользоватьБазовыеЕИ
	|			ТОГДА ТчЗапасы.Количество * ТчЗапасы.ЕдиницаИзмерения.Коэффициент
	|		ИНАЧЕ ТчЗапасы.Количество
	|	КОНЕЦ КАК Количество,
	|	ТчЗапасы.Цена КАК Цена,
	|	ТчЗапасы.СтавкаНДС КАК СтавкаНДС,
	|	ТчЗапасы.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчЗапасы.Сумма - ТчЗапасы.СуммаНДС
	|		ИНАЧЕ ТчЗапасы.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчЗапасы.Сумма + ТчЗапасы.СуммаНДС
	|		ИНАЧЕ ТчЗапасы.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	&СуммаАкциза КАК СуммаАкциза,
	|	ТчЗапасы.НомерСтроки КАК НомерСтроки,
	|	ТчЗапасы.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТчЗапасы.ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	СпрНоменклатура.ТоварнаяНоменклатураВЭД КАК НоменклатураТНВЭД,
	|	ТчЗапасы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРеализации.Запасы КАК ТчЗапасы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК ДанныеШапки
	|		ПО ТчЗапасы.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчЗапасы.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО ТчЗапасы.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО (СпрНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМираЗапасы
	|		ПО ТчЗапасы.СтранаПроисхождения = СтраныМираЗапасы.Ссылка
	|ГДЕ
	|	ТчЗапасы.Ссылка = &Ссылка";
	
	ТекстЗапросаУпорядочить = "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки";
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаЗапасы);
	ТекстыЗапросов.Добавить(ТекстЗапроса_ОбъединитьВсе());
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаУслугиДоставкиОбщее("КорректировкаРеализации"));
	ТекстыЗапросов.Добавить(ТекстЗапросаУпорядочить);
	
	Результат = СтрСоединить(ТекстыЗапросов);
	
	ИспользоватьБазовыеЕИ = ИспользоватьБазовыеЕдиницыИзмеренияВТабличнойЧастиДокумента();
	
	Результат = СтрЗаменить(Результат, "&ИспользоватьБазовыеЕИ", ИспользоватьБазовыеЕИ);
	
	УПД970_УстановитьВТекстЗапросаПрослеживаемыйКомплект(Результат, "КорректировкаРеализации", "Запасы");
	УПД970_УстановитьВТекстЗапросаСуммуАкциза(Результат, "КорректировкаРеализации", "Запасы");
	
	Возврат Результат;
	
КонецФункции

