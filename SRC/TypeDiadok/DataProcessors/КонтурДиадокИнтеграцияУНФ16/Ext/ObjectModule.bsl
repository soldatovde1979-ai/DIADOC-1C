Процедура АктСверки405_ЗаполнитьРеквизитыУчастника(Content, Участник, ДатаСведений)
	
	СведенияОбУчастнике = ДанныеЮрФизЛица(Участник, ДатаСведений);
	
	Content = Новый_ExtendedOrganizationInfo_ReconciliationAct();
	
	Content.Name = СведенияОбУчастнике.ПолноеНаименование;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		Content.Phone = СведенияОбУчастнике.Телефоны;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.ЭлектроннаяПочта) Тогда
		Content.Email = СведенияОбУчастнике.ЭлектроннаяПочта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.СтранаРегистрации)
		И СведенияОбУчастнике.СтранаРегистрации <> Справочники.СтраныМира.Россия Тогда
		
		Content.LegalEntityId = СведенияОбУчастнике.РегистрационныйНомер;
		Content.Type = "ForeignEntity";
		
	ИначеЕсли СведенияОбУчастнике.ЮрФизЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		
		Content.Inn = СведенияОбУчастнике.ИНН;
		Content.Kpp = СведенияОбУчастнике.КПП;
		Content.Ogrn = СведенияОбУчастнике.ОГРН;
		Content.Type = "LegalEntity";
		
	Иначе
		
		Content.Type = "IndividualEntity";
		Content.Inn = СведенияОбУчастнике.ИНН;
		Content.Ogrn = СведенияОбУчастнике.ОГРН;
		
	КонецЕсли;
	
КонецПроцедуры

