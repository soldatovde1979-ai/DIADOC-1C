	);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыБанковскогоСчета(БанковскийСчет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	БанковскиеСчета.Банк.Код КАК БИК,
	|	БанковскиеСчета.Банк КАК Банк,
	|	БанковскиеСчета.Банк.Наименование КАК БанкНаименование,
	|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Ссылка = &БанковскийСчет";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Результат[0]);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПредставлениеНоменклатурыЛок(Номенклатура, Характеристика, Содержание)
	
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("ПредставлениеНоменклатуры", СокрЛП(Номенклатура));
	ПараметрыНоменклатуры.Вставить("ПредставлениеХарактеристики", СокрЛП(Характеристика));
	ПараметрыНоменклатуры.Вставить("Содержание", СокрЛП(Содержание));
	
	ИнтерфейсУНФ = ОбщийМодульПоИмениЛок("ПечатьДокументовУНФ");
	Результат = ИнтерфейсУНФ.ПредставлениеНоменклатуры(ПараметрыНоменклатуры);
	
	Возврат Результат;
	
КонецФункции

Функция АртикулНоменклатуры(Номенклатура)
	
	ДополнительнаяКолонкаНоменклатуры = Константы.ПредставлениеКодовВПечатныхФормах.Получить();
	
	Если ДополнительнаяКолонкаНоменклатуры = Перечисления.КодыНоменклатурыВДокументах.Артикул Тогда
		
		Результат = Номенклатура.Артикул;
		
	ИначеЕсли ДополнительнаяКолонкаНоменклатуры = Перечисления.КодыНоменклатурыВДокументах.Код Тогда
		
		Результат = Номенклатура.Код;
		
	ИначеЕсли ДополнительнаяКолонкаНоменклатуры = Перечисления.КодыНоменклатурыВДокументах.Штрихкод Тогда
		
		Результат = Номенклатура.ШтрихКод;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает реквизиты участника сделки с учетом истории изменения и настроек
//
// Параметры:
//  Участник - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - участник сделки
//  ДатаСведений - Дата - дата, на которую нужно получить реквизиты
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - значения реквизитов:
//    * ПолноеНаименование - Строка - Общество с ограниченной ответственностью "Ромашка"
//    * СокращенноеНаименование - Строка - ООО "Ромашка"
//    * НаименованиеДляПечатныхФорм - Строка - Полное или сокращенное наименование (определяется настройкой организации)
//    * ИНН - Строка - ИНН участника
//    * КПП - Строка - КПП участника
//    * Телефоны - Строка - Телефоны участника
//    * ЮридическийАдрес - Строка - Юридический адрес участника
//
Функция СчетаНаОплату_ДанныеЮрФизЛица(Участник, ДатаСведений)
	
	Модель = Новый Структура;
	Модель.Вставить("ПолноеНаименование", "");
	Модель.Вставить("СокращенноеНаименование", "");
	Модель.Вставить("НаименованиеДляПечатныхФорм", "");
	Модель.Вставить("ИНН", "");
	Модель.Вставить("КПП", "");
	Модель.Вставить("Телефоны", "");
	Модель.Вставить("ЮридическийАдрес", "");
	
	МодульЭлектронныеДокументы = ОбщийМодульПоИмениЛок("УправлениеНебольшойФирмойЭлектронныеДокументыСервер");
	
	Данные = МодульЭлектронныеДокументы.ПолучитьДанныеЮрФизЛица(Участник, ДатаСведений);
	
	Модель.ПолноеНаименование = Данные.ПолноеНаименование;
	Модель.НаименованиеДляПечатныхФорм = Данные.ОфициальноеНаименование;
	Модель.ИНН = Данные.ИНН;
	Модель.КПП = Данные.КПП;
	Модель.Телефоны = Данные.Телефоны;
	Модель.ЮридическийАдрес = Данные.ЮридическийАдрес;
	
	Если Данные.Свойство("СокращенноеНаименование") Тогда
		Модель.СокращенноеНаименование = Данные.СокращенноеНаименование;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Модель.СокращенноеНаименование) Тогда
		Модель.СокращенноеНаименование = Данные.Представление;
	КонецЕсли;
	
	Если ТипЗнч(Участник) = Тип("СправочникСсылка.Контрагенты") Тогда
		// функция Справочники.Контрагенты.НаименованияНаДату возвращает
		// наименование элемента, а не официальное наименование
		Модель.СокращенноеНаименование = Модель.ПолноеНаименование;
	КонецЕсли;
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_ПредставлениеЮрФизЛица(РеквизитыЮрФизЛица)
	
	Результат = РеквизитыЮрФизЛица.НаименованиеДляПечатныхФорм;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = РеквизитыЮрФизЛица.СокращенноеНаименование;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует строку с наименованием и реквизитами юридического или физического лица
//
// Параметры:
//   Реквизиты - Структура - см. СчетаНаОплату_ДанныеЮрФизЛица
//
// Возвращаемое значение:
//   Строка - строковое представление реквизитов
//
Функция СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(Реквизиты)
	
	ШаблонПредставления = "СокращенноеНаименование,ИНН,КПП,ЮридическийАдрес,Телефоны";
	Результат = ПредставлениеЮрФизЛицаСлужебный(Реквизиты, ШаблонПредставления);
	
	Возврат Результат;

КонецФункции

Функция ПредставлениеЮрФизЛицаСлужебный(Реквизиты, ШаблонПредставления)
	
	Перем Префикс, СтрокаДополнения;
	
	СоответствиеПараметров = Новый Структура;
	СоответствиеПараметров.Вставить("ПолноеНаименование", " ");
	СоответствиеПараметров.Вставить("СокращенноеНаименование", " ");
	СоответствиеПараметров.Вставить("НаименованиеДляПечатныхФорм", " ");
	СоответствиеПараметров.Вставить("ИНН", " ИНН ");
	СоответствиеПараметров.Вставить("КПП", " КПП ");
	СоответствиеПараметров.Вставить("Свидетельство", " ");
	СоответствиеПараметров.Вставить("СвидетельствоДатаВыдачи", " от ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес", " ");
	СоответствиеПараметров.Вставить("ФактическийАдрес", " ");
	СоответствиеПараметров.Вставить("Телефоны", " тел.: ");
	СоответствиеПараметров.Вставить("Факс", " факс: ");
	СоответствиеПараметров.Вставить("НомерСчета", " р/с ");
	СоответствиеПараметров.Вставить("Банк", " в банке ");
	СоответствиеПараметров.Вставить("БИК", " БИК ");
	СоответствиеПараметров.Вставить("КоррСчет", " к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО", " Код по ОКПО ");
	
	ПропускатьПустыеСтроки = Истина;
	Разделитель = ",";
	СписокПараметров = СтрРазделить(
		ШаблонПредставления,
		Разделитель,
		ПропускатьПустыеСтроки
	);
	
	Результат = Новый Массив;
	
	Для Каждого ИмяПараметра Из СписокПараметров Цикл
		
		Если Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения) Тогда
			
			Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения);
			Если ПустаяСтрока(СтрокаДополнения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СоответствиеПараметров.Свойство(ИмяПараметра, Префикс) Тогда
				Результат.Добавить(Префикс + СтрокаДополнения);
			Иначе
				Результат.Добавить(СтрокаДополнения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаРезультата = СтрСоединить(Результат, ",");
	СтрокаРезультата = СтрЗаменить(СтрокаРезультата, "  ", " ");
	
	Возврат СокрЛП(СтрокаРезультата);
	
КонецФункции

// Пересчитывает цену в строке модели табличной части счета на оплату
//
// Параметры:
//  СтрокаСчетаНаОплату - СтрокаТабличнойЧасти - см. СчетаНаОплату_Данные.ТабличнаяЧасть
//
Процедура СчетаНаОплату_ПересчитатьЦену(СтрокаСчетаНаОплату)
	
	Знаменатель = СтрокаСчетаНаОплату.Количество;
	Если СтрокаСчетаНаОплату.Количество = 0 Тогда
		Знаменатель = 1;
	КонецЕсли;
	
	ТочностьЦены = 2;
	
	СтрокаСчетаНаОплату.Цена = Окр(
		СтрокаСчетаНаОплату.Сумма / Знаменатель,
		ТочностьЦены
	);
	
КонецПроцедуры

Функция СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента)
	
