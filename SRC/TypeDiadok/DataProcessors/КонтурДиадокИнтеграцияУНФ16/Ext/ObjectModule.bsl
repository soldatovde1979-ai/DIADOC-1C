// Заполняет модель данных электронного счета на оплату.
//
// Параметры:
//	Шапка - Контракт шапки неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - Контракт табличной части неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату() 
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанные(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета) Экспорт
	
	Если ЭтоСчетНаОплату(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоСчетуНаОплату(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоЗаказПокупателя(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоЗаказуПокупателя(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанныеПоДокументуПродажи(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ОснованиеЭлектронногоСчета));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	СчетаНаОплату_ОчиститьСкидки(МодельТабличнаяЧасть);
		
КонецПроцедуры

// Формирует модель данных электронного счета на оплату на основании счета.
//
// Параметры:
//  СчетНаОплату - ДокументСсылка.СчетНаОплату - основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанныеПоСчетуНаОплату(МодельШапка, МодельТабличнаяЧасть, Счет)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.БанковскийСчетПоУмолчанию КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	ВЫРАЗИТЬ(ДанныеДокумента.ПодписьРуководителя.РасшифровкаПодписи КАК СТРОКА(1000)) КАК ПодписантФамилияИО,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.НалогообложениеНДС <> &ТипНалогообложения_НеОблагаетсяНДС КАК УчитыватьНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетНаОплату КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ДанныеДокумента.Содержание КАК СодержаниеУслуги,
	|	ДанныеДокумента.Характеристика КАК Характеристика,
	|	&ПолеХарактеристикаНаименование КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	&ПолеСуммаСкидки КАК СуммаСкидки,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.СчетНаОплату.Запасы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2 КАК НомерТабличнойЧасти,
	|	1 КАК НомерСтроки,
	|	ДанныеДокумента.НоменклатураДоставки КАК Номенклатура,
	|	&ПолеНоменклатураДоставкиАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураДоставкиНаименование КАК НоменклатураНаименование,
	|	"""" КАК СодержаниеУслуги,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	"""" КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.НоменклатураДоставки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	0 КАК Количество,
	|	ДанныеДокумента.СтоимостьДоставки КАК Цена,
	|	ДанныеДокумента.СтавкаНДСДоставки КАК СтавкаНДС,
	|	0 КАК СуммаСкидки,
	|	ДанныеДокумента.СтоимостьДоставки КАК Сумма,
	|	ДанныеДокумента.СуммаНДСДоставки КАК СуммаНДС
	|ИЗ
	|	Документ.СчетНаОплату КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|	И &УсловиеВыводитьДоставку
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	ЗаполнитьВыраженияЗапросаПоУмолчанию(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", Счет);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	МодельШапка.РуководительФИО = ДанныеШапки.ПодписантФамилияИО;
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
		
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			Запись.НоменклатураНаименование,
			Запись.ХарактеристикаНаименование,
			Запись.СодержаниеУслуги
		);
		
		Если Запись.СуммаСкидки <> 0 Тогда
			СчетаНаОплату_ПересчитатьЦену(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

// Формирует модель данных электронного счета на оплату на основании заказа.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанныеПоЗаказуПокупателя(МодельШапка, МодельТабличнаяЧасть, Заказ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.БанковскийСчетПоУмолчанию КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	ВЫРАЗИТЬ(ДанныеДокумента.ПодписьРуководителя.РасшифровкаПодписи КАК СТРОКА(1000)) КАК ПодписантФамилияИО,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.НалогообложениеНДС <> &ТипНалогообложения_НеОблагаетсяНДС КАК УчитыватьНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ДанныеДокумента.Содержание КАК СодержаниеУслуги,
	|	ДанныеДокумента.Характеристика КАК Характеристика,
	|	&ПолеХарактеристикаНаименование КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	&ПолеСуммаСкидки КАК СуммаСкидки,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ЗаказПокупателя.Запасы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ДанныеДокумента.Содержание КАК СодержаниеУслуги,
	|	ДанныеДокумента.Характеристика КАК Характеристика,
	|	&ПолеХарактеристикаНаименование КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ДанныеДокумента.СуммаСкидкиНаценки + СуммаАвтоматическойСкидки КАК СуммаСкидки,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.ЗаказПокупателя.Работы КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	3 КАК НомерТабличнойЧасти,
	|	1 КАК НомерСтроки,
	|	ДанныеДокумента.НоменклатураДоставки КАК Номенклатура,
	|	&ПолеНоменклатураДоставкиАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураДоставкиНаименование КАК НоменклатураНаименование,
	|	"""" КАК СодержаниеУслуги,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	"""" КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.НоменклатураДоставки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	0 КАК Количество,
	|	ДанныеДокумента.СтоимостьДоставки КАК Цена,
	|	ДанныеДокумента.СтавкаНДСДоставки КАК СтавкаНДС,
	|	0 КАК СуммаСкидки,
	|	ДанныеДокумента.СтоимостьДоставки КАК Сумма,
	|	ДанныеДокумента.СуммаНДСДоставки КАК СуммаНДС
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|	И &УсловиеВыводитьДоставку
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	ЗаполнитьВыраженияЗапросаПоУмолчанию(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", Заказ);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	МодельШапка.РуководительФИО = ДанныеШапки.ПодписантФамилияИО;
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			Запись.НоменклатураНаименование,
			Запись.ХарактеристикаНаименование,
			Запись.СодержаниеУслуги
		);
		
		Если Запись.СуммаСкидки <> 0 Тогда
			СчетаНаОплату_ПересчитатьЦену(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует модель данных электронного счета на оплату на основании документа продажи.
//
// Параметры:
//  ДокументПродажи - ДокументСсылка.АктВыполненныхРабот, ДокументСсылка.ОтчетОПереработке
//                    ДокументСсылка.РасходнаяНакладная, ДокументСсылка.КорректировкаРеализации - основание электронного счета
// 
// Возвращаемое значение:
//  Структура - см. СчетаНаОплату_Данные
//
Процедура СчетаНаОплату_ЗаполнитьДанныеПоДокументуПродажи(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи)
	
	ТипСсылки = ТипЗнч(ДокументПродажи);
	
	Если ТипСсылки = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		СчетаНаОплату_ДокументПродажи_АктВыполненныхРабот(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ОтчетОПереработке") Тогда
		
		СчетаНаОплату_ДокументПродажи_ОтчетОПереработке(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		
		СчетаНаОплату_ДокументПродажи_РасходнаяНакладная(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи);
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		СчетаНаОплату_ДокументПродажи_ОтчетКомитенту(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипСсылки);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ДокументПродажи_АктВыполненныхРабот(МодельШапка, МодельТабличнаяЧасть, ДокументПродажи)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.ВалютаДокумента КАК Валюта,
	|	ДанныеДокумента.ВалютаДокумента.Код КАК ВалютаКод,
	|	ДанныеДокумента.Организация КАК Организация,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация.БанковскийСчетПоУмолчанию КАК БанковскийСчетОрганизацииПоУмолчанию,
	|	ДанныеДокумента.Контрагент КАК Контрагент,
	|	ЛОЖЬ КАК УчетАгентскогоНДС,
	|	ВЫРАЗИТЬ(ДанныеДокумента.ПодписьРуководителя.РасшифровкаПодписи КАК СТРОКА(1000)) КАК ПодписантФамилияИО,
	|	ДанныеДокумента.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	ДанныеДокумента.НалогообложениеНДС <> &ТипНалогообложения_НеОблагаетсяНДС КАК УчитыватьНДС,
	|	ДанныеДокумента.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.АктВыполненныхРабот КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 КАК НомерТабличнойЧасти,
	|	ДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ДанныеДокумента.Номенклатура КАК Номенклатура,
	|	&ПолеНоменклатураАртикул КАК НоменклатураАртикул,
	|	&ПолеНоменклатураНаименование КАК НоменклатураНаименование,
	|	ДанныеДокумента.Содержание КАК СодержаниеУслуги,
	|	ДанныеДокумента.Характеристика КАК Характеристика,
	|	&ПолеХарактеристикаНаименование КАК ХарактеристикаНаименование,
	|	ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДанныеДокумента.Количество КАК Количество,
	|	ДанныеДокумента.Цена КАК Цена,
	|	ДанныеДокумента.СтавкаНДС КАК СтавкаНДС,
	|	&ПолеСуммаСкидки КАК СуммаСкидки,
	|	ДанныеДокумента.Сумма КАК Сумма,
	|	ДанныеДокумента.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.АктВыполненныхРабот.РаботыИУслуги КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	ЗаполнитьВыраженияЗапросаПоУмолчанию(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументПродажи);
	Запрос.УстановитьПараметр("ТипНалогообложения_НеОблагаетсяНДС", Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	ДанныеШапки = РезультатыЗапроса[0].Выгрузить()[0];
	
	ДатаДокумента = ДанныеШапки.Дата;
	НомерДокумента = ПредставлениеНомера(ДанныеШапки.Номер);
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.Заголовок = СчетаНаОплату_ЗаголовокПечатнойФормы(НомерДокумента, ДатаДокумента);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	МодельШапка.ЦенаВключаетНДС = ДанныеШапки.СуммаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.УчетАгентскогоНДС;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	МодельШапка.ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	МодельШапка.РуководительФИО = ДанныеШапки.ПодписантФамилияИО;
	
	БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизации;
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = ДанныеШапки.БанковскийСчетОрганизацииПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		
		МодельШапка.ПродавецБанк = РеквизитыСчета.Банк;
		МодельШапка.ПродавецБанкБИК = РеквизитыСчета.БИК;
		МодельШапка.ПродавецБанкПредставление = РеквизитыСчета.БанкНаименование;
		МодельШапка.ПродавецБанковскийСчетНомер = РеквизитыСчета.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = РеквизитыСчета.КоррСчет;
		
	КонецЕсли;
	
	ДанныеТабличнойЧасти = РезультатыЗапроса[1].Выгрузить();
	
	Для Каждого Запись Из ДанныеТабличнойЧасти Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Запись);
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатурыЛок(
			Запись.НоменклатураНаименование,
			Запись.ХарактеристикаНаименование,
			Запись.СодержаниеУслуги
		);
		
		Если Запись.СуммаСкидки <> 0 Тогда
			СчетаНаОплату_ПересчитатьЦену(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

