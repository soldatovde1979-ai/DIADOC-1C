	|	"""" КАК СтранаПроисхожденияКод,
	|	ИСТИНА КАК СтранаПроисхожденияУчастникЕАЭС,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СпрНоменклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмеренияНаименование,
	|	СпрНоменклатура.ЕдиницаИзмерения.Код КАК ЕдиницаИзмеренияКод,
	|	"""" КАК НомерГТД,
	|	ТчРаботы.Количество КАК Количество,
	|	ТчРаботы.Цена КАК Цена,
	|	ТчРаботы.СтавкаНДС КАК СтавкаНДС,
	|	ТчРаботы.СуммаНДС КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчРаботы.Сумма - ТчРаботы.СуммаНДС
	|		ИНАЧЕ ТчРаботы.Сумма
	|	КОНЕЦ КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеШапки.СуммаВключаетНДС
	|			ТОГДА ТчРаботы.Сумма + ТчРаботы.СуммаНДС
	|		ИНАЧЕ ТчРаботы.Сумма
	|	КОНЕЦ КАК СуммаВсего,
	|	0 КАК СуммаАкциза,
	|	ТчРаботы.НомерСтроки КАК НомерСтроки,
	|	ТчРаботы.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТчРаботы.ПрослеживаемыйКомплект КАК ПрослеживаемыйКомплект,
	|	СпрНоменклатура.ТоварнаяНоменклатураВЭД КАК НоменклатураТНВЭД,
	|	ТчРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя.Работы КАК ТчРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ДанныеШапки
	|		ПО ТчРаботы.Ссылка = ДанныеШапки.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТчРаботы.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК СпрХарактеристикиНоменклатуры
	|		ПО ТчРаботы.Характеристика = СпрХарактеристикиНоменклатуры.Ссылка
	|ГДЕ
	|	ТчРаботы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки";
	
	ИспользоватьБазовыеЕИ = ИспользоватьБазовыеЕдиницыИзмеренияВТабличнойЧастиДокумента();
	
	Результат = СтрЗаменить(Результат, "&ИспользоватьБазовыеЕИ", ИспользоватьБазовыеЕИ);
	
	УПД970_УстановитьВТекстЗапросаПрослеживаемыйКомплект(Результат, "ЗаказПокупателя", "Запасы");
	УПД970_УстановитьВТекстЗапросаПрослеживаемыйКомплект(Результат, "ЗаказПокупателя", "Работы");
	УПД970_УстановитьВТекстЗапросаИдентификаторСтроки(Результат, "ЗаказПокупателя", "Работы");
	УПД970_УстановитьВТекстЗапросаПрослеживаемыйТовар(Результат, "ЗаказПокупателя", "Работы");
	
