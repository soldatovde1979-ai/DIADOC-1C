Функция ПолучитьМассивСсылокРТУПоСчетуНаОплату(ДокументСсылка) Экспорт
			
	МассивРТУ = Новый Массив;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетНаОплату") 
		И НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("ДокументОснование") = Неопределено Тогда
		
		Если  ЗначениеЗаполнено(ДокументСсылка.ДокументОснование)
			И ТипЗнч(ДокументСсылка.ДокументОснование) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
			
			// счет создан на основании расходной накладной
			МассивРТУ.Добавить(ДокументСсылка.ДокументОснование);
			
		Иначе
			
			// расходная накладная создана на основании счета
			Запрос = Новый Запрос;
			
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	РасходнаяНакладная.Ссылка КАК РеализацияСсылка
				|ИЗ
				|	Документ.РасходнаяНакладная КАК РасходнаяНакладная
				|ГДЕ
				|	РасходнаяНакладная.ДокументОснование = &ЭтотСчет
				|	И РасходнаяНакладная.ПометкаУдаления = ЛОЖЬ";
			
			Запрос.УстановитьПараметр("ЭтотСчет", ДокументСсылка);
			
			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			
			МассивРТУ = РезультатЗапроса.ВыгрузитьКолонку("РеализацияСсылка");
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РасходнаяНакладная.Ссылка КАК РеализацияСсылка
			|ИЗ
			|	Документ.РасходнаяНакладная КАК РасходнаяНакладная
			|ГДЕ
			|	РасходнаяНакладная.Заказ = &Заказ
			|	И РасходнаяНакладная.ПометкаУдаления = ЛОЖЬ";
			
		Запрос.УстановитьПараметр("Заказ", ДокументСсылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		МассивРТУ = РезультатЗапроса.ВыгрузитьКолонку("РеализацияСсылка");
		
	КонецЕсли;
	
	Возврат МассивРТУ;
	
КонецФункции

Функция ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(СчетФактура) Экспорт
	
	ТекстЗапроса =
	
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.Договор КАК Договор
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетОПереработке КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомитенту КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура";
	
	Если МетодСервера(,"СуществуетОбъектМетаданных", "Документ.КорректировкаРеализации") Тогда
	
		ТекстЗапроса = ТекстЗапроса + МетодСервера(,"РазделительОбъединенияЗапросов") +
		
		"ВЫБРАТЬ
		|	Документ.Ссылка,
		|	Документ.Дата,
		|	Документ.Договор
		|ИЗ
		|	Документ.СчетФактура.ДокументыОснования КАК Таблица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Документ
		|		ПО Таблица.ДокументОснование = Документ.Ссылка
		|ГДЕ
		|	Таблица.Ссылка = &СчетФактура";
		
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса +
	"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ДокументСсылка) Экспорт
	
	СФСсылка= 	Неопределено;
	Запрос= 	Новый Запрос;
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактура.ТабличнаяЧасть.ДокументыОснования") Тогда
		Запрос.Текст= 
			"ВЫБРАТЬ
			|	СчетФактураВыданныйДокументыОснования.Ссылка
			|ИЗ
			|	Документ.СчетФактура.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
			|	И СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления = ЛОЖЬ";
	Иначе 
		Запрос.Текст= 
			"ВЫБРАТЬ
			|	СчетФактураВыданный.Ссылка
			|ИЗ
			|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			|ГДЕ
			|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
			|	И СчетФактураВыданный.ПометкаУдаления = ЛОЖЬ";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СФСсылка= Выборка.Ссылка;
	КонецЕсли;
	
	Возврат СФСсылка;
	
КонецФункции

Функция ПолучитьДокОснованиеКорректировкиРеализации(ДокументСсылка) Экспорт
	
	ДокументОснование= Неопределено;
	
	Если НЕ Метаданные.Документы.Найти("КорректировкаРеализации") = Неопределено
		И НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("ДокументОснование") = Неопределено Тогда
		
		ДокументОснование= ДокументСсылка.ДокументОснование;
					
	КонецЕсли;
	
	Возврат ДокументОснование;
	
КонецФункции

Функция ПолучитьСчетНаОплатуНаОснованииРТУ(ДокументСсылка) Экспорт
	
	Запрос= Новый Запрос;
	
	Запрос.Текст=
		"ВЫБРАТЬ
		|	СчетНаОплату.Ссылка
		|ИЗ
		|	Документ.СчетНаОплату КАК СчетНаОплату
		|ГДЕ
		|	СчетНаОплату.ДокументОснование = &ДокументОснование
		|	И СчетНаОплату.ПометкаУдаления = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	
	Выборка= Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
