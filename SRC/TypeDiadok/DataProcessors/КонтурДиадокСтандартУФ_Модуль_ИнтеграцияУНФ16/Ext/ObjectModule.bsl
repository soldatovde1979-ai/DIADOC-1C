// Вызывается из Модуль_ИнтеграцияУниверсальный.СчетаФактурыПоОснованию.
//
// Параметры:
//  НайденныеДокументы	 - Массив	 - Ссылки на найденные счета-фактуры;
//  ПараметрыРегистрации - Структура - см. Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактуры();
//  СтандартнаяОбработка - Булево	 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииСчетовФактурПоОснованию(НайденныеДокументы, ПараметрыРегистрации, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ИспользуетсяПодсистема_1_6_26() Тогда
		МодульСчетаФактурыУНФ = ОбщегоНазначения.ОбщийМодуль("СчетаФактурыУНФ");
	Иначе
		МодульСчетаФактурыУНФ = ОбщегоНазначения.ОбщийМодуль("УправлениеНебольшойФирмойСервер");
	КонецЕсли;
	
	ОснованиеСФ = ПараметрыРегистрации.Ссылка;
	ИскатьПолученныйСФ = Истина;
	ДанныеСчетаФактуры = МодульСчетаФактурыУНФ.ПолучитьПодчиненныйСчетФактуру(ОснованиеСФ, ИскатьПолученныйСФ);
	
	Если ЗначениеЗаполнено(ДанныеСчетаФактуры) Тогда
		НайденныеДокументы.Добавить(ДанныеСчетаФактуры.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

