// Вызывается из Модуль_ИнтеграцияУниверсальный.ИмяКолонкиКодТовара()
//
// Параметры:
//  ИмяКолонки			 - 	 - 
//  СтандартнаяОбработка - 	 - 
//
Процедура ПриОпределенииДополнительнойКолонкиПечатныхФормДокументов(ИмяКолонки, СтандартнаяОбработка) Экспорт
	
	Если Не МетодСервера(, "СуществуетОбъектМетаданных", "Константа.ПредставлениеКодовВПечатныхФормах") Тогда 
		// Актуально для 1.6.11 и выше: https://its.1c.ru/db/updinfo#content:524:1:issogl2_14
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ЗначениеКонстанты	 = Константы.ПредставлениеКодовВПечатныхФормах.Получить();
	
	Если ЗначениеКонстанты = ПредопределенноеЗначение("Перечисление.КодыНоменклатурыВДокументах.Код") Тогда 
		ИмяКолонки = "Код";
		
	ИначеЕсли ЗначениеКонстанты = ПредопределенноеЗначение("Перечисление.КодыНоменклатурыВДокументах.Артикул") Тогда 
		ИмяКолонки = "Артикул";
		
	Иначе
		ИмяКолонки = "";
	КонецЕсли;
	
КонецПроцедуры

