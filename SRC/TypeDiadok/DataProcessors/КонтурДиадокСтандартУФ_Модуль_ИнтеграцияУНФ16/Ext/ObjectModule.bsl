// Формирует представление номенклатуры с помощью программного интерфейса актуальной версии конфигурации.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура, Строка - Номенклатура или её наименование
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Строка - Характеристика или её наименование
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры.
//
Функция ПредставлениеНоменклатурыУНФ(Номенклатура, Характеристика = Неопределено)
	
	Если ТипЗнч(Номенклатура) = Тип("Строка") Тогда
		
		ПараметрыНоменклатуры = Новый Структура;
		ПараметрыНоменклатуры.Вставить("ПредставлениеНоменклатуры"		, Номенклатура);
		ПараметрыНоменклатуры.Вставить("ПредставлениеХарактеристики"	, Характеристика);
		ПараметрыНоменклатуры.Вставить("ПредставлениеСерииНоменклатуры"	, "");
		
		МодульПечатьДокументовУНФ = ОбщегоНазначения.ОбщийМодуль("ПечатьДокументовУНФ");
		Представление = МодульПечатьДокументовУНФ.ПредставлениеНоменклатуры(ПараметрыНоменклатуры);
		
	Иначе
		
		МодульТабличныеЧастиУНФ = ОбщегоНазначения.ОбщийМодуль("ТабличныеЧастиУНФ");
		Представление = МодульТабличныеЧастиУНФ.ТекстСодержания(Номенклатура, Характеристика);
		
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Формирует представление номенклатуры с помощью программного интерфейса конфигурации до версии 1.6.25 включительно.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура, Строка - Номенклатура или её наименование
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Строка - Характеристика или её наименование
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры.
//
Функция ПредставлениеНоменклатурыУНФ_1_6_25(Номенклатура, Характеристика = Неопределено)
	
	МодульУНФ = ОбщегоНазначения.ОбщийМодуль("УправлениеНебольшойФирмойСервер");
	
	Если ТипЗнч(Номенклатура) = Тип("Строка") Тогда
		Представление = МодульУНФ.ПолучитьПредставлениеНоменклатурыДляПечати(Номенклатура, Характеристика);
	Иначе
		Представление = МодульУНФ.ПолучитьТекстСодержания(Номенклатура, Характеристика);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Формирует представление номенклатуры с помощью программного интерфейса конфигурации.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура, Строка - Номенклатура или её наименование
//  Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры, Строка - Характеристика или её наименование
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры.
//
Функция ПредставлениеНоменклатуры(Номенклатура, Характеристика = Неопределено)
	
	ИспользуетсяПодсистема_1_6_26 =  ИспользуетсяПодсистема_1_6_26();
	
	Если ИспользуетсяПодсистема_1_6_26 Тогда
		
		Представление = ПредставлениеНоменклатурыУНФ(
			Номенклатура,
			Характеристика
		);
		
	Иначе
		
		Представление = ПредставлениеНоменклатурыУНФ_1_6_25(
			Номенклатура,
			Характеристика
		);
		
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

