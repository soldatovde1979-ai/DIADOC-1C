	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.Договор = ДоговорПоСтрокеАктаСверки(Шапка, СтрокаДоговора);
				СтрокаПоДаннымКонтрагента.ДатаОперации = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.НаименованиеОперации = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.ОписаниеДокумента = СтрокаДокумента.Наименование;
				СтрокаПоДаннымКонтрагента.СуммаДолгКонтрагента = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.СуммаДолгОрганизации = СтрокаОперации.СуммаКредит;
				СтрокаПоДаннымКонтрагента.ВхНомерДокумента = СтрокаДокумента.Номер;
				СтрокаПоДаннымКонтрагента.ВхДатаДокумента = СтрокаДокумента.Дата;
				СтрокаПоДаннымКонтрагента.ВалютаДокумента = СтрокаПоДаннымКонтрагента.Договор.ВалютаРасчетов;
				
				Если НЕ ЗначениеЗаполнено(СтрокаПоДаннымКонтрагента.ВалютаДокумента) Тогда
					СтрокаПоДаннымКонтрагента.ВалютаДокумента = Шапка.ВалютаДокумента;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура();
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("ДанныеКонтрагента", ТаблицаПоДаннымКонтрагента);
	
