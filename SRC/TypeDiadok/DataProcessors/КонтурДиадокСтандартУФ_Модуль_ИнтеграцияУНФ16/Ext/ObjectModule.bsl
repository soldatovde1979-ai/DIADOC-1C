Функция НайтиОснованиеДокументаОРасхождениях(Организация, ДатаДокумента, НомерДокумента)

	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДокументРасходнаяНакладная.Ссылка КАК Документ
	|ИЗ
	|	Документ.РасходнаяНакладная КАК ДокументРасходнаяНакладная
	|ГДЕ
	|	ДокументРасходнаяНакладная.Организация = &Организация
	|	И ДокументРасходнаяНакладная.Номер ПОДОБНО &НомерДокумента
	|	И НАЧАЛОПЕРИОДА(ДокументРасходнаяНакладная.Дата, ДЕНЬ) = &ДатаДокумента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетФактураДокументыОснования.ДокументОснование
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК СчетФактураДокументыОснования
	|ГДЕ
	|	СчетФактураДокументыОснования.ДокументОснование.Организация = &Организация
	|	И СчетФактураДокументыОснования.ДокументОснование.Номер ПОДОБНО &НомерДокумента
	|	И НАЧАЛОПЕРИОДА(СчетФактураДокументыОснования.ДокументОснование.Дата, ДЕНЬ) = &ДатаДокумента";
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ДатаДокумента",	НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("НомерДокумента",	"%" + НомерДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Документ;
	КонецЕсли;
	
	Возврат Результат;

