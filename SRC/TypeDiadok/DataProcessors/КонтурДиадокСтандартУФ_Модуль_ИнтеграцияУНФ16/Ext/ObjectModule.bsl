// Проверяет наличие реквизита ОтменаДоставки у документа Корректировка реализации.
// Данный реквизит был добавлен в 1.6.24.
// 
// Возвращаемое значение:
//  Булево - Истина, если есть реквизит, Ложь - нет реквизита. 
//
Функция ЕстьФункцияОтменыДоставки()
	
	МинимальнаяВерсия 	= "1.6.24";
	ТекущаяВерсия 		= ВерсияПодсистемыУНФ();
	
	Результат = (СравнитьВерсии(ТекущаяВерсия, МинимальнаяВерсия) >= 0); 
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяУчетПрослеживаемыхТоваров()
	
	Результат = Ложь;
	
	ЕстьПрослеживаемостьВКонфигурации = МетодСервера(, "СуществуетОбъектМетаданных", "ФункциональнаяОпция.ВестиУчетПрослеживаемыхТоваров");
	Если ЕстьПрослеживаемостьВКонфигурации Тогда
		
		Результат = ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяНомерНаПечатьСчетаФактуры()
	
	Результат = Ложь;
	
	ВерсияПодсистемыУНФ = ВерсияПодсистемыУНФ();
	
	Если СравнитьВерсии(ВерсияПодсистемыУНФ, "3.0.9") >= 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ЗагрузкаДанных

// Список возможных идентификаторов способов обработки входящих документов.
// 
// Возвращаемое значение:
//  Структура - см. тело функции.
//
Функция ИдентификаторыПравилОбработкиДокументов()
	
	ЗначенияПеречисления = Новый Массив;
	ЗначенияПеречисления.Добавить("ПриходнаяНакладная");
	ЗначенияПеречисления.Добавить("ПриходнаяНакладная_ВозвратОтПокупателя");
	ЗначенияПеречисления.Добавить("ДополнительныеРасходы");
	ЗначенияПеречисления.Добавить("КорректировкаПоступления");
	ЗначенияПеречисления.Добавить("СчетФактураПолученный");
	ЗначенияПеречисления.Добавить("АктОРасхожденияхПолученный");
	ЗначенияПеречисления.Добавить("СверкаВзаиморасчетов");
	
	Результат = Новый Структура;
	Для Каждого Элемент Из ЗначенияПеречисления Цикл
		Результат.Вставить(Элемент, Элемент);
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Дополняет таблицу правил обработки товарных накладных.
//
Процедура ЗаполнитьПравилаОбработкиПервичныхДокументов(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхДокументов = Ложь;
	ДляИсправительныхДокументов = Истина;
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Приходная накладная (поступление от поставщика)
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриходнаяНакладная
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхДокументов);
	
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриходнаяНакладная
		, ВидыЭД.АктОбОказанииУслуг
		, ДляПервичныхИИсправительныхДокументов);
	
	// Приходная накладная (возврат от покупателя)
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриходнаяНакладная_ВозвратОтПокупателя
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхИИсправительныхДокументов);
	
	// Дополнительные расходы
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ДополнительныеРасходы
		, ВидыЭД.АктОбОказанииУслуг
		, ДляПервичныхИИсправительныхДокументов);
	
	// Исправление накладных, актов
	Если ИспользоватьКорректировкиПоступлений() Тогда
		
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.КорректировкаПоступления
			, ВидыЭД.ТоварнаяНакладная
			, ДляИсправительныхДокументов);
		
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.КорректировкаПоступления
			, ВидыЭД.АктОбОказанииУслуг
			, ДляИсправительныхДокументов);
	
		// Корректировка поступления
		ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
			, ИдентификаторыПравил.КорректировкаПоступления
			, ВидыЭД.СоглашениеОбИзмененииСтоимости
			, ДляПервичныхИИсправительныхДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

// Дополняет таблицу правил обработки счетов-фактур и корректировочных счетов-фактур.
//
Процедура ЗаполнитьПравилаОбработкиСчетовФактур(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Счет-фактура
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.СчетФактураПолученный
		, ВидыЭД.СчетФактура
		, ДляПервичныхИИсправительныхДокументов);
	
	// Корректировочный счет-фактура
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.СчетФактураПолученный
		, ВидыЭД.КорректировочныйСчетФактура
		, ДляПервичныхИИсправительныхДокументов);
	
КонецПроцедуры

// Дополняет таблицу правил обработки Актов о расхождениях (полученных).
//
Процедура ЗаполнитьПравилаОбработкиДокументовОРасхождении(ПравилаОбработки)

	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Акт о расхождениях
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.АктОРасхожденияхПолученный
		, ВидыЭД.ДокументОРасхождениях
		, ДляПервичныхИИсправительныхДокументов);

КонецПроцедуры

Процедура ЗаполнитьПравилаОбработкиАктовСверки(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Акт сверки
	ДобавитьПравилоОбработкиДокументов(
		ПравилаОбработки,
		ИдентификаторыПравил.СверкаВзаиморасчетов,
		ВидыЭД.АктСверки,
		ДляПервичныхИИсправительныхДокументов
	);

КонецПроцедуры

Функция ВидОперацииПриходнойНакладнойПоУмолчанию()
	
	МетаданныеРеквизита = Метаданные.Документы.ПриходнаяНакладная.Реквизиты.ВидОперации;
	
	Результат = МетаданныеРеквизита.ЗначениеЗаполнения;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыЗаполненияУчетногоДокумента()
	
	Результат = Новый Структура;
	Результат.Вставить("ВидОперации", ВидОперацииПриходнойНакладнойПоУмолчанию());
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("ДокументОснование", Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыЗаполненияАктаОРасхожденияхПолученного()
	
	Результат = Новый Структура;
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияДляУПД(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияУчетногоДокумента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД	 = ДанныеЭД.Шапка;
	ИтогиТЧ	 = ДанныеЭД.Итоги;
	
	Запасы	= Документы.ПриходнаяНакладная.ПустаяСсылка().Запасы.ВыгрузитьКолонки();
	Расходы = Документы.ПриходнаяНакладная.ПустаяСсылка().Расходы.ВыгрузитьКолонки();
	Расходы.Колонки.Добавить("Характеристика");
	
	СведенияПрослеживаемости = НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(Документы.ПриходнаяНакладная.ПустаяСсылка());
	
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	Шапка = Новый Структура;
	Шапка.Вставить("Дата"		, ТекущаяДата());
	Шапка.Вставить("Организация", ШапкаЭД.Покупатель.Ссылка);
	Шапка.Вставить("Контрагент"	, ШапкаЭД.Продавец.Ссылка);
	Шапка.Вставить("Валюта"		, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Курс"		, ШапкаЭД.Курс);
	Шапка.Вставить("Кратность"	, ШапкаЭД.Кратность);
	
	Шапка.Вставить("ВидОперации"		, ПараметрыЗаполнения.ВидОперации);
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	Шапка.Вставить("Корректировка"		, Ложь);
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	Шапка.Вставить("НомерИсходногоДокумента", СвойствоСтруктуры(ШапкаЭД, "НомерИсходногоДокумента"));
	Шапка.Вставить("ДатаИсходногоДокумента"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсходногоДокумента"));
	
	Шапка.Вставить("Исправление", ФорматЭД.ЭтоИсправление);
	Если ФорматЭД.ЭтоИсправление Тогда 
		Шапка.Вставить("НомерИсправления"	, ШапкаЭД.НомерИсправления);
		Шапка.Вставить("ДатаИсправления"	, ШапкаЭД.ДатаИсправления);
	КонецЕсли;
	
	Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента", Ложь);
	Шапка.Вставить("ПередачаТовараКомитентом", Ложь);
	
	ЭтоАванс = ДанныеЭД.ЭтоАванс;
	
	Если ЭтоАванс Тогда
		Шапка.Вставить("ВидСчетаФактуры", Перечисления.ВидыОперацийСчетФактураПолученный.Аванс);
	Иначе
		Шапка.Вставить("ВидСчетаФактуры", Перечисления.ВидыОперацийСчетФактураПолученный.Поступление);
	КонецЕсли;
	
	Шапка.Вставить("КодСпособаВыставления", 2); // 1 - на бумаге, 2 - в электронном виде
	Шапка.Вставить("ВыставленСтатус", 2); // 1 - не выставляется, 2 - выставлен
	
	//Заполняем документы-основания
	ДокументыОснования = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументыОснования) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ДокументыОснования = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	Шапка.Вставить("ДокументОснование", ДокументыОснования);
	
	Шапка.Вставить("ПоложениеЗаказаПоставщику", Перечисления.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти);
	
	Если Не ПолучитьФункциональнуюОпцию("УчетПоНесколькимСкладам") Тогда
		Шапка.Вставить("СтруктурнаяЕдиница", Справочники.СтруктурныеЕдиницы.ОсновнойСклад);
	КонецЕсли;
	
	Пользователь = Пользователи.АвторизованныйПользователь();
	Подразделение = ПодразделениеПользователя(Пользователь);
	
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
						
		Если ЭтоНоменклатураЗапас(НоменклатураИБ.Номенклатура)
			Или ЗначениеЗаполнено(Стр.ДанныеГТД) Тогда
			
			НоваяСтрока = Запасы.Добавить();
						
		Иначе
			
			НоваяСтрока = Расходы.Добавить();
			НоваяСтрока.Содержание			= НоменклатураКонтрагента.Наименование;
			НоваяСтрока.СтруктурнаяЕдиница	= Подразделение;
			
		КонецЕсли;
		
		НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		НоваяСтрока.Характеристика = НоменклатураИБ.Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Всего		 = Стр.СуммаСНДС;
		
		ПроверитьЗаполнитьЦенуКоличество(НоваяСтрока);
		ПроверитьЗаполнитьЕдиницуИзмерения(НоваяСтрока);
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке, НоменклатураКонтрагента.GTIN);
		
		ЕстьСведенияПрослеживаемости = ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(Стр);
		
		Если ИспользуетсяУчетПрослеживаемыхТоваров И ЕстьСведенияПрослеживаемости Тогда
			
			ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УПД(СведенияПрослеживаемости, Стр.СведенияОПрослеживаемости, НоваяСтрока);
			
			ЗаполнятьСтрануПроисхождения = ЗначениеЗаполнено(Стр.ДанныеГТД)
											И Стр.ДанныеГТД.Количество() = 1
											И ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "СтранаПроисхождения");
			
			Если ЗаполнятьСтрануПроисхождения Тогда
				СведенияТД = Стр.ДанныеГТД[0];
		 		НоваяСтрока.СтранаПроисхождения = СведенияТД.СтранаПроисхождения.Ссылка;
		 	КонецЕсли;
																	
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "НомерГТД") Тогда
											
			ЗаполнитьСведенияТаможеннойДекларации(НоваяСтрока, Стр.ДанныеГТД);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Запасы"	, Запасы);
	ДанныеОбъекта.Вставить("Расходы", Расходы);
	ДанныеОбъекта.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	ДанныеОбъекта.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияУчетногоДокумента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД	 = ДанныеЭД.Шапка;
	ИтогиТЧ	 = ДанныеЭД.Итоги;

	ПустаяСсылкаНаДокумент = Документы.КорректировкаПоступления.ПустаяСсылка();
	Запасы	= ПустаяСсылкаНаДокумент.Запасы.ВыгрузитьКолонки();
	Расходы = ПустаяСсылкаНаДокумент.Расходы.ВыгрузитьКолонки();
	Расходы.Колонки.Добавить("Характеристика");
	СведенияПрослеживаемости = НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(ПустаяСсылкаНаДокумент, Истина);
	
	Шапка = Новый Структура;
	Шапка.Вставить("Дата"				, ТекущаяДата());
	Шапка.Вставить("Организация"		, ШапкаЭД.Покупатель.Ссылка);
	Шапка.Вставить("Контрагент"			, ШапкаЭД.Продавец.Ссылка);
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("КурсДокумента"		, ШапкаЭД.Курс);
	Шапка.Вставить("КратностьДокумента"	, ШапкаЭД.Кратность);
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Шапка.Вставить("НомерИсходногоДокумента", СвойствоСтруктуры(ШапкаЭД, "НомерИсходногоДокумента"));
	Шапка.Вставить("ДатаИсходногоДокумента"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсходногоДокумента"));
	
	Если ФорматЭД.ЭтоИсправление Тогда 
		Шапка.Вставить("ВидОперацииЭД"		, Перечисления.ВидыОперацийЭД.Исправление);
		Шапка.Вставить("Исправление"		, Истина);
		Шапка.Вставить("НомерИсправления"	, ШапкаЭД.НомерИсправления);
		Шапка.Вставить("ДатаИсправления"	, ШапкаЭД.ДатаИсправления);
	Иначе 
		Шапка.Вставить("ВидОперацииЭД"	, Перечисления.ВидыОперацийЭД.Корректировка);
		Шапка.Вставить("Исправление"	, Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(ШапкаЭД, "НомерИсправленияИсходногоДокумента")) Тогда
		Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента"	, Истина);
		Шапка.Вставить("НомерИсправленияИсходногоДокумента"		, СвойствоСтруктуры(ШапкаЭД, "НомерИсправленияИсходногоДокумента"));
		Шапка.Вставить("ДатаИсправленияИсходногоДокумента"		, СвойствоСтруктуры(ШапкаЭД, "ДатаИсправленияИсходногоДокумента"));
	Иначе
		Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента"	, Ложь);
	КонецЕсли;
	
	Шапка.Вставить("ОтражатьВУчете", Истина);
	
	// Основание корректировочного документа
	ДокументОснование = Неопределено;
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Если ФорматЭД.ЭтоКорректировка Тогда
		
		СвойстваОснования = ШапкаЭД.КорректируемыйДокумент;
		ДокументОснование = СвойствоСтруктуры(СвойстваОснования, "ПервичныйДокумент");
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			ДокументОснование = ДокументОснование.ДокументОснование;
		КонецЕсли;
		
	КонецЕсли;
	
	Шапка.Вставить("Основание", ДокументОснование);
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		
		ЭтоЗапас = ЭтоНоменклатураЗапас(НоменклатураИБ.Номенклатура);
		
		Если ЭтоЗапас Тогда 
			НоваяСтрока = Запасы.Добавить();
		Иначе
			НоваяСтрока = Расходы.Добавить();
		КонецЕсли;
		
		НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		НоваяСтрока.Характеристика = НоменклатураИБ.Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
		НоваяСтрока.Количество	= Стр.Количество;
		НоваяСтрока.Цена		= Стр.Цена;
		НоваяСтрока.СуммаНДС 	= Стр.СуммаНДС;
		НоваяСтрока.Сумма 		= Стр.СуммаБезНДС;
		НоваяСтрока.Всего 		= Стр.СуммаСНДС;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			
			НоваяСтрока.КоличествоДоИзменения	= Стр.Количество_До;
			НоваяСтрока.ЦенаДоИзменения			= Стр.Цена_До;
			НоваяСтрока.СуммаНДСДоИзменения		= Стр.СуммаНДС_До;
			НоваяСтрока.СуммаДоИзменения		= Стр.СуммаБезНДС_До;
			НоваяСтрока.ВсегоДоИзменения		= Стр.СуммаСНДС_До;
			
		КонецЕсли;
		
		Если ИспользуетсяУчетПрослеживаемыхТоваров И ЭтоЗапас Тогда
			
			ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УКД(СведенияПрослеживаемости, Стр.СведенияОПрослеживаемости, НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Запасы"	, Запасы);
	ДанныеОбъекта.Вставить("Расходы", Расходы);
	ДанныеОбъекта.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция СтруктураЗаполненияКорректировочногоСчетаФактуры(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияУчетногоДокумента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД	 = ДанныеЭД.Шапка;
	ИтогиТЧ	 = ДанныеЭД.Итоги;
	
	ДанныеОбъекта = Новый Структура;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("Дата", ТекущаяДата());
	
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Шапка.Вставить("НомерИсходногоДокумента", СвойствоСтруктуры(ШапкаЭД, "НомерИсходногоДокумента"));
	Шапка.Вставить("ДатаИсходногоДокумента"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсходногоДокумента"));
	
	Если ФорматЭД.ЭтоИсправление Тогда
		Шапка.Вставить("Исправление", Истина);
		Шапка.Вставить("НомерИсправления", ШапкаЭД.НомерИсправления);
		Шапка.Вставить("ДатаИсправления",  ШапкаЭД.ДатаИсправления);
	КонецЕсли;
	
	НомерИсправленияИсходногоДокумента = СвойствоСтруктуры(ШапкаЭД, "НомерИсправленияИсходногоДокумента");
	ДатаИсправленияИсходногоДокумента  = СвойствоСтруктуры(ШапкаЭД, "ДатаИсправленияИсходногоДокумента");
	
	Если ЗначениеЗаполнено(НомерИсправленияИсходногоДокумента) Тогда
		Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента", Истина);
		Шапка.Вставить("НомерИсправленияИсходногоДокумента", НомерИсправленияИсходногоДокумента);
		Шапка.Вставить("ДатаИсправленияИсходногоДокумента",  ДатаИсправленияИсходногоДокумента);
	Иначе
		Шапка.Вставить("УчитыватьИсправлениеИсходногоДокумента", Ложь);
	КонецЕсли;
	
	Шапка.Вставить("Организация", ШапкаЭД.Покупатель.Ссылка);
	Шапка.Вставить("Контрагент"	, ШапкаЭД.Продавец.Ссылка);
	
	Шапка.Вставить("ВидСчетаФактуры", Перечисления.ВидыОперацийСчетФактураПолученный.Корректировка);
	
	//Заполняем документы-основания
	ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
	МассивДокументовОснований = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	Шапка.Вставить("ДокументОснование", МассивДокументовОснований);
	
	Шапка.Вставить("ВалютаДокумента", ШапкаЭД.Валюта.Ссылка);
	
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("ИтогиТЧ", ИтогиТЧ);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция СтруктураЗаполненияАктаОРасхожденияхПолученного(ДанныеЭД, ДополнительныеПараметры)

	ПараметрыЗаполнения = ПараметрыЗаполненияАктаОРасхожденияхПолученного();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	
	Запасы = Документы.АктОРасхожденияхПолученный.ПустаяСсылка().Запасы.ВыгрузитьКолонки();
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Участники сделки
	Шапка.Вставить("Организация"		, ШапкаЭД.Покупатель.Ссылка);
	Шапка.Вставить("Контрагент"			, ШапкаЭД.Продавец.Ссылка);
	Шапка.Вставить("Грузоотправитель"	, ШапкаЭД.Грузоотправитель.Ссылка);
	Шапка.Вставить("Грузополучатель"	, ШапкаЭД.Грузополучатель.Ссылка);
	
	// Валюта, суммы
	Шапка.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("СуммаВключаетНДС"	, ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Даты, номера
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	Шапка.Вставить("НомерАкта"				, ПредставлениеНомера(ШапкаЭД.Номер));
	
	// Основание документа о расхождениях
	Организация		= Шапка.Организация;
	ДатаДокумента	= НачалоДня(ДанныеЭД.Шапка.Основание.Дата);
	НомерДокумента	= ДанныеЭД.Шапка.Основание.Номер;
	
	НомерДокументаБезПрефиксов = НомерДокументаБезПрефикса(НомерДокумента);
	НомерДокументаБезПрефиксов = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НомерДокументаБезПрефиксов, 6, "0");
	
	ДокументОснование = НайтиОснованиеДокументаОРасхождениях(Организация, ДатаДокумента, НомерДокументаБезПрефиксов);
		
	ДополнитьПараметрыЗаполненияАктаОРасхожденияхПоДокументуОснованию(ДокументОснование, Шапка);
	
	СуммаВключаетНДС = Шапка.СуммаВключаетНДС;
	
	// Табличная часть
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		 
		НоваяСтрока = Запасы.Добавить();
		
		НоваяСтрока.Номенклатура = НоменклатураИБ.Номенклатура;
		НоваяСтрока.Характеристика = НоменклатураИБ.Характеристика;
		НоваяСтрока.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
		
		НоваяСтрока.Количество	= Стр.Количество;
		НоваяСтрока.Цена		= Стр.Цена;
		НоваяСтрока.СуммаНДС 	= Стр.СуммаНДС;
		НоваяСтрока.Сумма 		= ?(СуммаВключаетНДС, Стр.СуммаСНДС, Стр.СуммаСНДС - Стр.СуммаНДС);
		НоваяСтрока.Всего 		= Стр.СуммаСНДС;
		
		НоваяСтрока.КоличествоДоИзменения	= Стр.Количество_До;
		НоваяСтрока.ЦенаДоИзменения			= Стр.Цена_До;
		НоваяСтрока.СуммаНДСДоИзменения		= Стр.СуммаНДС_До;
		НоваяСтрока.СуммаДоИзменения		= ?(СуммаВключаетНДС, Стр.СуммаСНДС_До, Стр.СуммаСНДС_До - Стр.СуммаНДС_До);
		НоваяСтрока.ВсегоДоИзменения		= Стр.СуммаСНДС_До;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке);
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка"	, Шапка);
	ДанныеОбъекта.Вставить("Запасы"	, Запасы);
	ДанныеОбъекта.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеОбъекта;

КонецФункции

