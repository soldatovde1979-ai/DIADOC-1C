	ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если ЮрАдрес Тогда
			ВидАдреса = "ЮрАдресКонтрагента";
		Иначе
			ВидАдреса = "ФактАдресКонтрагента";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
		
		ВидАдреса = "ФактАдресСтруктурнойЕдиницы";
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Некорректный параметр функции ""ПолучитьВидКИ""'");
		
	КонецЕсли;
	
	Результат = Справочники.ВидыКонтактнойИнформации[ВидАдреса];
	
	Возврат Результат;
	
КонецФункции

// Получает по счету-фактуре список документов-оснований.
//
// Параметры:
//  СФ - ДокументСсылка.СчетФактура - счет-фактура, основания которого требуется получить.
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на документы-основания счета-фактуры.
//
Функция ОснованияСчетаФактуры(СФ)
	
	Результат = Неопределено;
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактура.ТабличнаяЧасть.ДокументыОснования") Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.СчетФактура.ДокументыОснования КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СФ);
		
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДокументОснование");
		
	Иначе
		Результат = Новый Массив;
		Результат.Добавить(МетодСервера(, "ЗначениеРеквизитаОбъекта", СФ, "ДокументОснование"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

