// Обработчик получения правила отражения электронного документа в учетной системе.
// Вызывается из Модуль_ИнтеграцияУниверсальный.ПравилоОбработкиЭлектронныхДокументов.
//
// Параметры:
//  ПравилоОбработки	 - Структура - описание способа обработки электронного документа (см. ПравилоОбработкиЭлектронныхДокументов);
//  СтандартнаяОбработка - Булево - Истина, если специальная обработка не требуется,
//                                  а идентификатор совпадает с именем метаданных документа;
//
// Пример:
//
//	Если ПравилоОбработки.Идентификатор = "ПоступлениеВПереработку" Тогда
//		
//		СтандартнаяОбработка = Ложь;
//		
//		ДополнительныеПараметры = Новый Структура;
//		ДополнительныеПараметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ВПереработку);
//		
//		ПравилоОбработки.Представление = "Поступление материалов в переработку";
//		ПравилоОбработки.ОбъектМетаданных = Метаданные.Документы.ПоступлениеТоваровУслуг.ПолноеИмя();
//		ПравилоОбработки.ДополнительныеПараметры = ДополнительныеПараметры;
//		
//	КонецЕсли;
//
Процедура ПриПолученииПравилаОбработкиЭлектронногоДокумента(ПравилоОбработки, СтандартнаяОбработка) Экспорт
	
	ИдентификаторПравила = ПравилоОбработки.Идентификатор;
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	Если ИдентификаторПравила = ИдентификаторыПравил.ПриходнаяНакладная_ВозвратОтПокупателя Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПриходнаяНакладная.ВозвратОтПокупателя);
		
		ПравилоОбработки.Представление = "Возврат от покупателя";
		ПравилоОбработки.ОбъектМетаданных = Метаданные.Документы.ПриходнаяНакладная.ПолноеИмя();
		ПравилоОбработки.ДополнительныеПараметры = ДополнительныеПараметры;
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.НовыйДокументИнформационнойБазы.
//
// Параметры:
//  ДокументОбъект		 - ДокументОбъект	 - новый, еще не записанный, документ-объект;
//  ДанныеЭД			 - Структура		 - содержит данные электронного документа
//                                             (см. Модуль_ИнтеграцияУниверсальный.ДанныеЭлектронногоДокумента);
//  ПараметрыЗаполнения	 - Структура		 - содержит дополнительные параметры заполнения;
//  СтандартнаяОбработка - Булево			 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриСозданииДокументаИнформационнойБазы(ДокументОбъект, ДанныеЭД, ПараметрыЗаполнения, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Если МетаданныеДокумента = Метаданные.Документы.ПриходнаяНакладная Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияДляУПД(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПриходнуюНакладную(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ДополнительныеРасходы Тогда 
		
		СтруктураЗаполнения = СтруктураЗаполненияДляУПД(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьДополнительныеРасходы(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.КорректировкаПоступления Тогда 
		
		СтруктураЗаполнения = СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьКорректировкуПоступления(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СчетФактураПолученный Тогда 
		
		ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			СтруктураЗаполнения = СтруктураЗаполненияКорректировочногоСчетаФактуры(ДанныеЭД, ПараметрыЗаполнения);
		Иначе
			СтруктураЗаполнения = СтруктураЗаполненияДляУПД(ДанныеЭД, ПараметрыЗаполнения);
		КонецЕсли;
		
		ЗаполнитьСчетФактуруПолученный(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.АктОРасхожденияхПолученный Тогда 
		
		СтруктураЗаполнения = СтруктураЗаполненияАктаОРасхожденияхПолученного(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьАктОРасхожденияхПолученный(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СверкаВзаиморасчетов Тогда
		
		Если ИспользуетсяСверкаВзаиморасчетов3_0_2() Тогда
			
			СтруктураЗаполнения = СтруктураЗаполненияСверкиВзаиморасчетов3_0_2(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьСверкуВзаиморасчетов3_0_2(ДокументОбъект, СтруктураЗаполнения);
			
		Иначе
			
			СтруктураЗаполнения = СтруктураЗаполненияСверкиВзаиморасчетов(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьСверкуВзаиморасчетов(ДокументОбъект, СтруктураЗаполнения);
			
		КонецЕсли;
		
	Иначе
		
		// Специальная обработка заполнения не реализована
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

