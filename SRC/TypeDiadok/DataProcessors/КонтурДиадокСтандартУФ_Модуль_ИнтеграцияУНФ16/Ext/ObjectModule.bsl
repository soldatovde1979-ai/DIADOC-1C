	ОписаниеПолей.Вставить("ЕдиницаИзмерения");
	ОписаниеПолей.Вставить("ЕдиницаИзмеренияКод");
	
	ОписаниеПолей.Вставить("ЕдиницаИзмеренияДоИзменения");
	ОписаниеПолей.Вставить("ЕдиницаИзмеренияДоИзмененияКод");

	ОписаниеПолей.Вставить("Количество");
	ОписаниеПолей.Вставить("Цена");
	ОписаниеПолей.Вставить("Сумма");
	ОписаниеПолей.Вставить("СтавкаНДС");
	ОписаниеПолей.Вставить("СуммаНДС");
	ОписаниеПолей.Вставить("СуммаСНДС");
	
	ОписаниеПолей.Вставить("КоличествоДоИзменения");
	ОписаниеПолей.Вставить("ЦенаДоИзменения");
	ОписаниеПолей.Вставить("СуммаДоИзменения");
	ОписаниеПолей.Вставить("СтавкаНДСДоИзменения");
	ОписаниеПолей.Вставить("СуммаНДСДоИзменения");
	ОписаниеПолей.Вставить("СуммаСНДСДоИзменения");

	ОписаниеПолей.Вставить("ЕстьДоставка");
	
	Возврат ОписаниеПолей;
	
КонецФункции

