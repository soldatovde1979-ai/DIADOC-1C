		Если Документ.Метаданные().Реквизиты.Найти("Грузополучатель") <> Неопределено Тогда
			Грузополучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Грузополучатель");
		Иначе
			Грузополучатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Контрагент");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактура") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Грузополучатель");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
