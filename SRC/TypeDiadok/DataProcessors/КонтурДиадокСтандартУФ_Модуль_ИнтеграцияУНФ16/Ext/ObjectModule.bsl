КонецФункции

Процедура ПроверитьЗаполнитьЦенуКоличество(СтрокаТабличнойЧасти)
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Количество) Тогда
		СтрокаТабличнойЧасти.Количество = 1;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена) Тогда
		СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.Сумма / СтрокаТабличнойЧасти.Количество;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнитьЕдиницуИзмерения(СтрокаТабличнойЧасти)
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЕдиницаИзмерения) Тогда
		СтрокаТабличнойЧасти.ЕдиницаИзмерения = ЕдиницаИзмеренияНоменклатуры(СтрокаТабличнойЧасти.Номенклатура);
	КонецЕсли;
	
КонецПроцедуры

Функция ЕдиницаИзмеренияНоменклатуры(Номенклатура)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПересчитатьЦеныСУчетомНДС(ДокументОбъект, ИмяТабличнойЧасти)
	
	Если Не ДокументОбъект.СуммаВключаетНДС Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитыватьЦенуДоКорректировки = Ложь;
	Если ДокументОбъект.Метаданные() = Метаданные.Документы.КорректировкаПоступления
		И ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение Тогда
		ПересчитыватьЦенуДоКорректировки = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ДокументОбъект[ИмяТабличнойЧасти] Цикл
		
		Если СтрокаТЧ.Количество = 0 Тогда
			СтрокаТЧ.Цена	= 0;
			СтрокаТЧ.Сумма	= 0;
		Иначе
			СтрокаТЧ.Цена	= СтрокаТЧ.Всего / СтрокаТЧ.Количество;
			СтрокаТЧ.Сумма	= СтрокаТЧ.Всего;
		КонецЕсли;
		
		Если Не ПересчитыватьЦенуДоКорректировки Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЧ.КоличествоДоИзменения = 0 Тогда
			СтрокаТЧ.ЦенаДоИзменения 	= 0;
			СтрокаТЧ.СуммаДоИзменения 	= 0;
		Иначе
			СтрокаТЧ.ЦенаДоИзменения	= СтрокаТЧ.ВсегоДоИзменения / СтрокаТЧ.КоличествоДоИзменения;
			СтрокаТЧ.СуммаДоИзменения	= СтрокаТЧ.ВсегоДоИзменения;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьЦеныТабличнойЧастиПоВалюте(Документ, ПредыдущаяВалюта, ИмяТабличнойЧасти)
	
	ИспользуетсяПодсистема_1_6_26 = ИспользуетсяПодсистема_1_6_26();
	
	Если ИспользуетсяПодсистема_1_6_26() Тогда
		МодульЦенообразованиеСервер = ОбщегоНазначения.ОбщийМодуль("ЦенообразованиеСервер");
	Иначе
		МодульЦенообразованиеСервер = ОбщегоНазначения.ОбщийМодуль("УправлениеНебольшойФирмойСервер");
	КонецЕсли;
	
	СтруктураКурсы = МодульЦенообразованиеСервер.ПолучитьКурсыВалют(
		ПредыдущаяВалюта,
		Документ.ВалютаДокумента,
		Документ.Дата
	);
	
	Для каждого СтрокаТабличнойЧасти Из Документ[ИмяТабличнойЧасти] Цикл
		
		СтрокаТабличнойЧасти.Цена = МодульЦенообразованиеСервер.ПересчитатьИзВалютыВВалюту(
			СтрокаТабличнойЧасти.Цена,
			СтруктураКурсы.КурсНач,
			СтруктураКурсы.Курс,
			СтруктураКурсы.КратностьНач,
			СтруктураКурсы.Кратность
		);
		
		СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
		
		СтавкаНДС = УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС);
		Если Документ.СуммаВключаетНДС Тогда
			СтрокаТабличнойЧасти.СуммаНДС = ?(
				Документ.СуммаВключаетНДС, 
				СтрокаТабличнойЧасти.Сумма - (СтрокаТабличнойЧасти.Сумма) / ((СтавкаНДС + 100) / 100),
				СтрокаТабличнойЧасти.Сумма * СтавкаНДС / 100
			);
			СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + ?(Документ.СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
		Иначе
			СтрокаТабличнойЧасти.СуммаНДС = СтрокаТабличнойЧасти.Сумма * СтавкаНДС / 100;
			СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + СтрокаТабличнойЧасти.СуммаНДС;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДоговорКонтрагента(ДокументОбъект)

	Если Не ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Возврат;
	ИначеЕсли Не ДокументОбъект.Контрагент.ВестиРасчетыПоДоговорам Тогда
		ДокументОбъект.Договор = Справочники.ДоговорыКонтрагентов.ДоговорПоУмолчанию(ДокументОбъект.Контрагент);
		Возврат;
	КонецЕсли;
	
	МенеджерСправочника = Справочники.ДоговорыКонтрагентов;
	МетаданныеОбъекта = ДокументОбъект.Метаданные();
	
	ВидОперации = Неопределено;
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ВидОперации") Тогда
		ВидОперации = ДокументОбъект.ВидОперации;
	КонецЕсли;
	
	СписокВидовДоговоров = МенеджерСправочника.ПолучитьСписокВидовДоговораДляДокумента(ДокументОбъект.Ссылка, ВидОперации);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Контрагент
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорыКонтрагентов.ВалютаРасчетов = &ВалютаРасчетов
	|	И ДоговорыКонтрагентов.ВидДоговора В(&СписокВидовДоговора)
	|	И (ДоговорыКонтрагентов.ДатаДоговора <= &ДатаДоговора
	|			ИЛИ ДоговорыКонтрагентов.ДатаДоговора = ДАТАВРЕМЯ(1, 1, 1))
	|	И (ДоговорыКонтрагентов.СрокДействия >= &ДатаДоговора
	|			ИЛИ ДоговорыКонтрагентов.СрокДействия = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Контрагент", ДокументОбъект.Контрагент);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СписокВидовДоговора", СписокВидовДоговоров);
	Запрос.УстановитьПараметр("ВалютаРасчетов", ДокументОбъект.ВалютаДокумента);
	Запрос.УстановитьПараметр("ДатаДоговора", ДокументОбъект.Дата); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДокументОбъект.Договор = Выборка.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПерезаполнениеЗначенийРеквизитовШапки(ТекущийОбъект, ДанныеЗаполнения)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ОбъектМетаданных = ТекущийОбъект.Метаданные();
	
	Для Каждого Строка Из ДанныеЗаполнения Цикл
		
		Если ЗначениеЗаполнено(Строка.Ключ) И ЕстьРеквизитМетаданных(ОбъектМетаданных, Строка.Ключ, Истина) Тогда
			Если ТекущийОбъект[Строка.Ключ] <> Строка.Значение Тогда
				ТекущийОбъект[Строка.Ключ] = Строка.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, заполнен ли номер таможенной декларации. Номер декларации
// считается пустым, если содержит только из незначащие символы.
//
// Параметры:
//  НомерДекларации - Строка - номер таможенной декларации.
// 
// Возвращаемое значение:
//  Булево - Истина, если номер не заполнен или состоит только из разделителей.
//
Функция ЭтоПустойНомерТаможеннойДекларации(НомерДекларации)
	
	Результат = Истина;
	
	Если Не ЗначениеЗаполнено(НомерДекларации) Тогда
		Возврат Результат;
	КонецЕсли;
	
	РазделительДекларации = РазделительТаможеннойДекларации();
	
	Для Индекс = 1 По СтрДлина(НомерДекларации) Цикл
		
		Символ = Сред(НомерДекларации, Индекс, 1);
		
		Если Символ <> РазделительДекларации Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает символ, использующийся в качестве разделителя в номере ГТД.
// 
// Возвращаемое значение:
//  Строка.
//
Функция РазделительТаможеннойДекларации()
	
	Возврат "/";
	
КонецФункции

// Заменяет в номере ГТД вторичные символы-разделители на основной разделитель.
//
// Параметры:
//  НомерДекларации - Строка - номер таможенной декларации.
//
Процедура НормализоватьНомерТаможеннойДекларации(НомерДекларации)
	
	РазделительДекларации = РазделительТаможеннойДекларации();
	
	ДопустимыеРазделители = Новый Массив;
	ДопустимыеРазделители.Добавить("-");
	ДопустимыеРазделители.Добавить("\");
	ДопустимыеРазделители.Добавить("|");
	ДопустимыеРазделители.Добавить("~");
	
	Для Каждого ВторичныйРазделитель Из ДопустимыеРазделители Цикл
		
		НомерДекларации = СтрЗаменить(НомерДекларации, ВторичныйРазделитель, РазделительДекларации);
		
	КонецЦикла;
	
КонецПроцедуры

// Находит ссылку на элемент справочника номеров ГТД по номеру таможенной декларации.
// Если подходящий элемент не найден, будет создан новый. Для заполнения его реквизитов
// будут использованы данные из номера таможенной декларации.
//
// Параметры:
//  НомерТаможеннойДекларации - Строка - номер таможенной декларации.
// 
// Возвращаемое значение:
//  СправочникСсылка.НомераГТД - если номер таможенной декларации не пустой;
//  Неопределено - если не указан номер таможенной декларации.
//
Функция НайтиСоздатьНомерГТД(НомерТаможеннойДекларации)
	
	НормализоватьНомерТаможеннойДекларации(НомерТаможеннойДекларации);
	
	Если ЭтоПустойНомерТаможеннойДекларации(НомерТаможеннойДекларации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Ссылка = Справочники.НомераГТД.НайтиПоКоду(НомерТаможеннойДекларации);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Результат = Ссылка;
		
	Иначе
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Код", НомерТаможеннойДекларации);
		ЗначенияЗаполнения.Вставить("Комментарий", НСтр("ru = 'Загружен из Диадок'"));
		ЗначенияЗаполнения.Вставить("ДопускаетсяЗаписьСОшибкой", Истина);
		
		Объект = Справочники.НомераГТД.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(Объект, ЗначенияЗаполнения);
		
		Объект.Записать();
		
		Результат = Объект.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет номер ГТД и страну происхождения в строке табличной части документа.
//
// Параметры:
//  НоваяСтрока			 - СтрокаТабличнойЧасти - заполняемая строка документа;
//  КоллекцияСведенийТД	 - Массив - содержит структуры с ключами:
//    * СтранаПроисхождения - Структура - см. НовыйКлючевыеСвойстваСтранаМира;
//    * НомерГТД - Структура - см. НовыйКлючевыеСвойстваНомерГТД;
//
Процедура ЗаполнитьСведенияТаможеннойДекларации(НоваяСтрока, КоллекцияСведенийТД)
	
	Если Не ЗначениеЗаполнено(КоллекцияСведенийТД) Тогда
		Возврат;
	КонецЕсли;
	
	СведенияТД = КоллекцияСведенийТД[0];
	НоваяСтрока.СтранаПроисхождения = СведенияТД.СтранаПроисхождения.Ссылка;
	
	НоваяСтрока.НомерГТД = СведенияТД.НомерГТД.Ссылка;
	Если Не ЗначениеЗаполнено(НоваяСтрока.НомерГТД) Тогда
		РегНомерГТД = СведенияТД.НомерГТД.РегистрационныйНомер;
		НоваяСтрока.НомерГТД = НайтиСоздатьНомерГТД(РегНомерГТД);
	КонецЕсли;
	
КонецПроцедуры

Функция НомерГТДИзСведенийПрослеживаемости(РегистрационныйНомер)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(РегистрационныйНомер) Тогда
		Результат = НайтиСоздатьНомерГТД(РегистрационныйНомер);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Прослеживаемость_Создание

Функция НоваяТаблицаСведенияПрослеживаемостиДокументаИБ(ПустаяСсылкаНаДокумент, ДляУКД = Ложь)
	
	Результат = Неопределено;
		
	Если ЕстьМетаданныеСведенияПрослеживаемости(ПустаяСсылкаНаДокумент.Метаданные()) Тогда
		Результат = ПустаяСсылкаНаДокумент.СведенияПрослеживаемости.ВыгрузитьКолонки();
		
		Если ДляУКД Тогда
			ОписаниеЧисло	 = Новый ОписаниеТипов("Число");
			Результат.Колонки.Добавить("КоличествоУвеличение", ОписаниеЧисло);
			Результат.Колонки.Добавить("КоличествоУменьшение", ОписаниеЧисло);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет СведенияОПрослеживаемости документа по данным строки товара электронного документа
// Аналог ОбменСконтрагентамиБП.ЗаполнитьСведенияОПрослеживаемостиВДокументеИБ_УКД()
//
// Параметры
//  Приемник				- ТабличнаяЧасть		- таблица СведенияОПрослеживаемости документа 1С
//  Источник				- ТаблицаЗначений		- см ПрочитатьСвойства_СведенияОПрослеживаемостиКорректировочногоДокумента()
//  Товары 					- ТаблицаЗначений	 	- таблица товаров документа
//
Процедура ЗаполнитьСведенияОПрослеживаемостиВходящегоКорректировочногоДокумента(Приемник, Источник, Товары)
	
	Если Источник.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Приемник.ВыгрузитьКолонки();
	
	СведПрослежИБ = Приемник.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СведПрослежИБ", СведПрослежИБ);
	Запрос.УстановитьПараметр("СведПрослежЭД", Источник);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.Количество КАК Количество,
		|	СведПрослежИБ.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ СведПрослежИБ
		|ИЗ
		|	&СведПрослежИБ КАК СведПрослежИБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежЭД.КоличествоУвеличение КАК КоличествоУвеличение,
		|	СведПрослежЭД.КоличествоУменьшение КАК КоличествоУменьшение,
		|	СведПрослежЭД.РНПТ КАК РНПТ,
		|	СведПрослежЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ СведПрослежЭД
		|ИЗ
		|	&СведПрослежЭД КАК СведПрослежЭД
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ КАК РНПТ,
		|	СведПрослежИБ.КоличествоПрослеживаемости - СведПрослежЭД.КоличествоУменьшение + СведПрослежЭД.КоличествоУвеличение КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ СкорректированныеСтрокиПоДаннымЭД
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СведПрослежЭД КАК СведПрослежЭД
		|		ПО СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки
		|			И СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведПрослежИБ.ИдентификаторСтроки,
		|	СведПрослежИБ.РНПТ,
		|	СведПрослежИБ.КоличествоПрослеживаемости
		|ИЗ
		|	СведПрослежИБ КАК СведПрослежИБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ СведПрослежЭД КАК СведПрослежЭД
		|		ПО СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки
		|			И СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ
		|ГДЕ
		|	СведПрослежЭД.ИдентификаторСтроки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведПрослежЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СведПрослежЭД.РНПТ КАК РНПТ,
		|	СведПрослежЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ПОМЕСТИТЬ НовыеСтрокиПоДаннымЭД
		|ИЗ
		|	СведПрослежЭД КАК СведПрослежЭД
		|		ЛЕВОЕ СОЕДИНЕНИЕ СведПрослежИБ КАК СведПрослежИБ
		|		ПО (СведПрослежИБ.ИдентификаторСтроки = СведПрослежЭД.ИдентификаторСтроки)
		|			И (СведПрослежИБ.РНПТ = СведПрослежЭД.РНПТ)
		|ГДЕ
		|	СведПрослежИБ.РНПТ ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СкорректированныеСтрокиПоДаннымЭД.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	СкорректированныеСтрокиПоДаннымЭД.РНПТ КАК РНПТ,
		|	0 КАК Количество,
		|	СкорректированныеСтрокиПоДаннымЭД.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
		|ИЗ
		|	СкорректированныеСтрокиПоДаннымЭД КАК СкорректированныеСтрокиПоДаннымЭД
		|ГДЕ
		|	СкорректированныеСтрокиПоДаннымЭД.КоличествоПрослеживаемости <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НовыеСтрокиПоДаннымЭД.ИдентификаторСтроки,
		|	НовыеСтрокиПоДаннымЭД.РНПТ,
		|	0,
		|	НовыеСтрокиПоДаннымЭД.КоличествоПрослеживаемости
		|ИЗ
		|	НовыеСтрокиПоДаннымЭД КАК НовыеСтрокиПоДаннымЭД
		|ИТОГИ ПО
		|	ИдентификаторСтроки";
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ВыборкаИдентификаторСтроки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИдентификаторСтроки.Следующий() Цикл
		
		СведенияПрослеживаемости = Результат.СкопироватьКолонки();
		
		Выборка = ВыборкаИдентификаторСтроки.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;
		
		СтрокиТоваров = Товары.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ВыборкаИдентификаторСтроки.ИдентификаторСтроки));
		Для каждого СтрокаТовара Из СтрокиТоваров Цикл
			СтрокаТовара.ПрослеживаемыйТовар = Истина;
		КонецЦикла;
		
		ПроизвестиРассчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, СтрокиТоваров[0].Количество);
		ДополнитьТаблицу(Результат, СведенияПрослеживаемости);
		
		
	КонецЦикла;
	
	Приемник.Загрузить(Результат);
	
КонецПроцедуры

// Дополняет таблицу прослеживаемости данными ЭД для переданной строки товара
//
// Параметры
//  Приемник					- ТаблицаЗначений			- см НоваяТаблицаСведенияПрослеживаемости()
//  ДанныеЭД					- Массив	 				- массив структур, СведенияОПрослеживаемости электронного документа
//  СтрокаТовары				- СтрокаТаблицыЗначений		- старый ИдентификаторСтроки
//
Процедура ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УКД(Приемник, ДанныеЭД, СтрокаТовары)
	
	СтрокаТовары.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	
	СведенияПрослеживаемости = Приемник.СкопироватьКолонки();
	Для Каждого СтрокаДанных Из ДанныеЭД Цикл
		СтрокаПрослеживаемости = СведенияПрослеживаемости.Добавить();
		СтрокаПрослеживаемости.РНПТ							= НомерГТДИзСведенийПрослеживаемости(СтрокаДанных.НомерГТДРегистрационныйНомер);
		СтрокаПрослеживаемости.КоличествоПрослеживаемости	= СтрокаДанных.КоличествоПослеИзменения;
		СтрокаПрослеживаемости.КоличествоУвеличение			= СтрокаДанных.КоличествоУвеличение;
		СтрокаПрослеживаемости.КоличествоУменьшение			= СтрокаДанных.КоличествоУменьшение;
		СтрокаПрослеживаемости.ИдентификаторСтроки			= СтрокаТовары.ИдентификаторСтроки;
	КонецЦикла;
	
	ДополнитьТаблицу(Приемник, СведенияПрослеживаемости);
	
КонецПроцедуры

// Дополняет таблицу прослеживаемости данными ЭД для переданной строки товара
//
// Параметры
//  Приемник					- ТаблицаЗначений			- см НоваяТаблицаСведенияПрослеживаемости()
//  ДанныеЭД 					- Массив	 				- массив структур, СведенияОПрослеживаемости электронного документа
//  СтрокаТовары				- СтрокаТаблицыЗначений		- старый ИдентификаторСтроки
//
Процедура ПодготовитьСведенияОПрослеживаемостиДляДокументаИБ_УПД(Приемник, ДанныеЭД, СтрокаТовары)
	
	Если Приемник = Неопределено
		Или ДанныеЭД.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТовары.ИдентификаторСтроки) Тогда
		ИдентификаторСтроки = СтрокаТовары.ИдентификаторСтроки;
	Иначе
		ИдентификаторСтроки = Новый УникальныйИдентификатор;
		СтрокаТовары.ИдентификаторСтроки = ИдентификаторСтроки;
	КонецЕсли;
	
	СтрокаТовары.ПрослеживаемыйТовар = Истина;
	
	СведенияПрослеживаемости = Приемник.СкопироватьКолонки();
	
	Для Каждого ЭлементИсточника Из ДанныеЭД Цикл
				
		НоваяПрослеживаемость = СведенияПрослеживаемости.Добавить();
		
		НоваяПрослеживаемость.ИдентификаторСтроки 			= ИдентификаторСтроки;
		НоваяПрослеживаемость.РНПТ 							= НомерГТДИзСведенийПрослеживаемости(ЭлементИсточника.НомерГТДРегистрационныйНомер);
		НоваяПрослеживаемость.КоличествоПрослеживаемости 	= ЭлементИсточника.КоличествоПоРНПТ;

	КонецЦикла;
	
	ПроизвестиРассчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, СтрокаТовары.Количество);
	
	ДополнитьТаблицу(Приемник, СведенияПрослеживаемости);
	
КонецПроцедуры

Процедура ПроизвестиРассчетУчетногоКоличестваПрослеживаемогоТовара(СведенияПрослеживаемости, КоличествоТовара)
	
	// Обрабатываем по аналогии с типовой БП.
	// Возможные варианты:
	
	// 1. Учетное количество было заполнено из данных электронного документа. Рассчитывать не нужно.
	// Данный сценарий на текущий момент не поддерживается.
	Если СведенияПрослеживаемости.Итог("Количество") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВсегоКоличествоПрослеживаемости = СведенияПрослеживаемости.Итог("КоличествоПрослеживаемости");
	
	// 2. Если общее количество прослеживаемости совпадает с количеством товара, то предполагаем, что единица измерения прослеживаемости совпадает
	// с учетной единицей измерения. В этом случае количество учетное приравниваем количеству прослеживаемости.
	Если ВсегоКоличествоПрослеживаемости = КоличествоТовара Тогда
		Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
			ЭлементКоллекции.Количество = ЭлементКоллекции.КоличествоПрослеживаемости;
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	// 3. Требуется произвести пропорциональное распределение
	СведенияПрослеживаемости.Колонки.Добавить("Порядок");
	
	Порядок = 0;
	Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
		Порядок = Порядок + 1;
		ЭлементКоллекции.Порядок = Порядок;
	КонецЦикла;
	
	СведенияПрослеживаемости.Сортировать("КоличествоПрослеживаемости");
	Распределено = 0;
	Для Каждого ЭлементКоллекции Из СведенияПрослеживаемости Цикл
		Если СведенияПрослеживаемости.Индекс(ЭлементКоллекции) + 1 = СведенияПрослеживаемости.Количество() Тогда
			ЭлементКоллекции.Количество = КоличествоТовара - Распределено;
		Иначе 
			ЭлементКоллекции.Количество = ?(ВсегоКоличествоПрослеживаемости = 0, 0,
				ЭлементКоллекции.КоличествоПрослеживаемости * КоличествоТовара / ВсегоКоличествоПрослеживаемости);
			Распределено = Распределено + ЭлементКоллекции.Количество;
		КонецЕсли;
	КонецЦикла;
	
	СведенияПрослеживаемости.Сортировать("Порядок");
		
КонецПроцедуры

// Обновляет ИдентификаторСтроки в ДанныеДокумента и ДанныеДокумента.СведенияПрослеживаемости
// Для корректной связи при перезаполнение ИдентификаторСтроки по дпнным исходной строки корректировки
//
// Параметры
//  ДанныеДокумента			- Структура		- строка ДанныеЗаполнения.Товары
//  СтарыйИДСтроки			- Строка		- старый ИдентификаторСтроки
//  НовыйИДСтроки 			- Строка	 	- новый ИдентификаторСтроки
//
Процедура ОбновитьИдентификаторыСтрокПрослеживаемости(ДанныеДокумента, СтарыйИДСтроки, НовыйИДСтроки)
	
	Если СтарыйИДСтроки <> НовыйИДСтроки Тогда
	
		Если ДанныеДокумента.Свойство("СведенияПрослеживаемости")
			И ДанныеДокумента.СведенияПрослеживаемости <> Неопределено Тогда
			
			Отбор = Новый Структура("ИдентификаторСтроки", СтарыйИДСтроки);
			
			СтрокиСоСтарымИД = ДанныеДокумента.СведенияПрослеживаемости.НайтиСтроки(Отбор);
			Для каждого СтрокаСоСтарымИД Из СтрокиСоСтарымИД Цикл
				СтрокаСоСтарымИД.ИдентификаторСтроки = НовыйИДСтроки;
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

