Функция ТаблицаЗначений_2_МассивСтруктур(ТаблЗнач)
	
	Результат = Новый Массив;
	СтрокаКлючей = "";
	Для Каждого Колонка Из ТаблЗнач.Колонки Цикл
		СтрокаКлючей = СтрокаКлючей + ?(ПустаяСтрока(СтрокаКлючей), "", ",") + Колонка.Имя;
	КонецЦикла;
	
	Если ТипЗнч(ТаблЗнач) = Тип("ТаблицаЗначений") Тогда
		
		Для Каждого Стр Из ТаблЗнач Цикл
			ЭлементСписка = Новый Структура(СтрокаКлючей);
			ЗаполнитьЗначенияСвойств(ЭлементСписка, Стр);
			Результат.Добавить(ЭлементСписка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВыделитьСлово(ИсходнаяСтрока)
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");
	
	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции

Функция СократитьПредставлениеТелефона(телефонСтрока)
	
	Если (СтрДлина(телефонСтрока) <= 20) Или (Найти(ТелефонСтрока, ";") = 0) Тогда
		//резать нечего
		Возврат ТелефонСтрока;
	КонецЕсли;	
	
	НовыйТелефон = "";
	СтарыйТелефон = ТелефонСтрока;
	Пока Найти(СтарыйТелефон, ";") > 0 Цикл
		Если (НовыйТелефон = "") Или (СтрДлина(НовыйТелефон) + Найти(СтарыйТелефон, ";") <= 20) Тогда
			//добавим кусок
			НовыйТелефон = ?(НовыйТелефон = "", "",  НовыйТелефон + ";") + Лев(СтарыйТелефон, Найти(СтарыйТелефон, ";") - 1);
			СтарыйТелефон = Прав(СтарыйТелефон, СтрДлина(СтарыйТелефон) - Найти(СтарыйТелефон, ";"));
		Иначе 
			СтарыйТелефон = "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовыйТелефон;
	
КонецФункции	

// Сворачивает таблицу товаров по всем несуммовым колонкам
//
// Параметры:
//  Товары - ТаблицаЗначений - сворачиваемая таблица
//
Процедура СвернутьТаблицуТовары(Товары)
	
	КолонкиГруппировокСтрокой 		= "";
	КолонкиСуммированияСтрокой 		= "Количество, КоличествоМест, СуммаНДС, Сумма, СуммаСНДС, Масса, МассаНетто";
	КолонкиСуммированияСтруктурой 	= Новый Структура(КолонкиСуммированияСтрокой);
	
	Разделитель = "";
	Для каждого Колонка Из Товары.Колонки Цикл
		Если НЕ КолонкиСуммированияСтруктурой.Свойство(Колонка.Имя) Тогда
			КолонкиГруппировокСтрокой = КолонкиГруппировокСтрокой + Разделитель + Колонка.Имя;
			Разделитель = ", ";
		КонецЕсли; 
	КонецЦикла;
	
	Товары.Свернуть(КолонкиГруппировокСтрокой, КолонкиСуммированияСтрокой);
	
КонецПроцедуры

