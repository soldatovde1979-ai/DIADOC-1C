	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЕстьСЧФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммаНДСЗначение";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФункцияДокумента", ТекстЗапроса_ФункцияПервичногоДокумента("ВТ_Основная"));
	
	Запрос.УстановитьПараметр("ПустыеЗначенияЗаказПокупателя"	, ПустыеЗначенияРеквизита("Документ.АктВыполненныхРабот.Реквизит.ЗаказПокупателя"));
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснование"	, ПустыеЗначенияРеквизита("Документ.АктВыполненныхРабот.Реквизит.ДокументОснование"));
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ПустыеЗначенияЗаказПокупателя");
	Запрос.Параметры.Удалить("ПустыеЗначенияДокументОснование");
	
	МассивВременныхТаблиц.Добавить("Накладные_АктВыполненныхРабот");
	МассивВременныхТаблиц.Добавить("Связь_Накладные_АктВыполненныхРабот");
	
КонецПроцедуры

