Процедура ЗаполнитьПриходнуюНакладную(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	ВидОперации = СвойствоСтруктуры(ДанныеДляЗагрузки.Шапка, "ВидОперации");
	Если ВидОперации = Неопределено Тогда
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
	Иначе
		ДокументОбъект.ВидОперации = ВидОперации;
	КонецЕсли;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.УстановитьНовыйНомер();
	
	// Заполним реквизиты шапки на основании структуры данных заполнения
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	// Загрузим табличные части
	ДокументОбъект.Запасы.Загрузить(ДанныеДляЗагрузки.Запасы);
	ДокументОбъект.Расходы.Загрузить(ДанныеДляЗагрузки.Расходы);
	Если ДанныеДляЗагрузки.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДляЗагрузки.ШтрихкодыУпаковок);
	КонецЕсли;
	
	ПересчитатьЦеныСУчетомНДС(ДокументОбъект, "Запасы");
	ПересчитатьЦеныСУчетомНДС(ДокументОбъект, "Расходы");
	
	// Заполним курс и кратность
	КурсВалюты				 = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументОбъект.ВалютаДокумента, ДокументОбъект.Дата);
	ДокументОбъект.Курс		 = КурсВалюты.Курс;
	ДокументОбъект.Кратность = КурсВалюты.Кратность;
	
	НациональнаяВалюта = ВалютаРегламентированногоУчета();
	Если ДокументОбъект.ВалютаДокумента <> НациональнаяВалюта Тогда
		ПересчитатьЦеныТабличнойЧастиПоВалюте(ДокументОбъект, НациональнаяВалюта, "Запасы");
		ПересчитатьЦеныТабличнойЧастиПоВалюте(ДокументОбъект, НациональнаяВалюта, "Расходы");
	КонецЕсли;
	
	// Установим вручную некоторые реквизиты шапки
	ЗаполнитьДоговорКонтрагента(ДокументОбъект);
	
	ЭтоЗачет = Истина;
	
	ДокументОбъект.СпособЗачетаПредоплаты = РасчетыРаботаСФормамиВызовСервера.ПолучитьСпособЗачетаДляДоговора(
		ДокументОбъект.Договор,
		ДокументОбъект.Контрагент,
		ЭтоЗачет
	);
	
	Если ДанныеЗаполнения.Свойство("СуммаНДС")
		И ДанныеЗаполнения.СуммаНДС > 0
		ИЛИ ДокументОбъект.Запасы.Итог("СуммаНДС") > 0
		ИЛИ ДокументОбъект.Расходы.Итог("СуммаНДС") > 0 Тогда
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
	Иначе
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС;
	КонецЕсли;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.Запасы.Итог("Всего") + ДокументОбъект.Расходы.Итог("Всего");
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
		ДокументОбъект.ВалютаДокумента = НациональнаяВалюта;
	КонецЕсли;
	
	Если ДанныеДляЗагрузки.Свойство("СведенияПрослеживаемости")
		И ДанныеДляЗагрузки.СведенияПрослеживаемости <> Неопределено
		И ЕстьМетаданныеСведенияПрослеживаемости(ДокументОбъект.Метаданные()) Тогда
		
		ДокументОбъект.СведенияПрослеживаемости.Очистить();
		ДокументОбъект.СведенияПрослеживаемости.Загрузить(ДанныеДляЗагрузки.СведенияПрослеживаемости);
		
	КонецЕсли;

	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеРасходы(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.УстановитьНовыйНомер();
	
	// Заполним реквизиты шапки на основании структуры данных заполнения
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	// Загрузим табличные части
	ДокументОбъект.Расходы.Загрузить(ДанныеДляЗагрузки.Расходы);
	
	ПересчитатьЦеныСУчетомНДС(ДокументОбъект, "Расходы");
	
	// Заполним курс и кратность
	КурсВалюты				 = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументОбъект.ВалютаДокумента, ДокументОбъект.Дата);
	ДокументОбъект.Курс		 = КурсВалюты.Курс;
	ДокументОбъект.Кратность = КурсВалюты.Кратность;
	
	НациональнаяВалюта = ВалютаРегламентированногоУчета();
	Если ДокументОбъект.ВалютаДокумента <> НациональнаяВалюта Тогда
		ПересчитатьЦеныТабличнойЧастиПоВалюте(ДокументОбъект, НациональнаяВалюта, "Расходы");
	КонецЕсли;
	
	// Установим вручную некоторые реквизиты шапки
	ЗаполнитьДоговорКонтрагента(ДокументОбъект);
	
	Если ДанныеЗаполнения.Свойство("СуммаНДС")
		И ДанныеЗаполнения.СуммаНДС > 0
		ИЛИ ДокументОбъект.Расходы.Итог("СуммаНДС") > 0 Тогда
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
	Иначе
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС;
	КонецЕсли;
	
	ДокументОбъект.СуммаДокумента = ДокументОбъект.Расходы.Итог("Всего");
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
		ДокументОбъект.ВалютаДокумента = НациональнаяВалюта;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКорректировкуПоступления(ДокументОбъект, ДанныеДокумента)
	
	ДанныеЗаполнения = ДанныеДокумента.Шапка;
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ЭтоИсправление = (ДанныеЗаполнения.ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Исправление);
	ЕстьДанныеПрослеживаемости = ДанныеДокумента.СведенияПрослеживаемости <> Неопределено;
	
	Если ЭтоИсправление Тогда
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки;
	Иначе
		ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение;
	КонецЕсли;
	
	//ДокументОбъект.ЗаполнитьСвойстваШапки();
	
	Если ЭтоИсправление Тогда
		ДокументОбъект.НомерИсправления = ДанныеЗаполнения.НомерИсправления;
		ДокументОбъект.ДатаИсправления = ДанныеЗаполнения.ДатаИсправления;
	КонецЕсли;
	
	Если ДанныеЗаполнения.Свойство("НомерИсходногоДокумента")
		И ЗначениеЗаполнено(ДанныеЗаполнения.НомерИсходногоДокумента) Тогда
		ДокументОбъект.НомерИсходногоДокумента = ДанныеЗаполнения.НомерИсходногоДокумента;
		ДокументОбъект.ДатаИсходногоДокумента  = ДанныеЗаполнения.ДатаИсходногоДокумента;
		Если ДанныеЗаполнения.УчитыватьИсправлениеИсходногоДокумента Тогда
			ДокументОбъект.НомерИсправленияИсходногоДокумента = ДанныеЗаполнения.НомерИсправленияИсходногоДокумента;
			ДокументОбъект.ДатаИсправленияИсходногоДокумента  = ДанныеЗаполнения.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
	КонецЕсли;
	
	ДокументПоступления = ДокументОбъект.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументПоступления) И ДанныеЗаполнения.Свойство("Основание") Тогда
		ДокументПоступления = ДанныеЗаполнения.Основание;
	КонецЕсли;
	
	// Заполним корректировку поступления данными основания
	Если ЗначениеЗаполнено(ДокументПоступления) Тогда
		ДокументОбъект.Заполнить(ДокументПоступления);
	КонецЕсли;
	
	// Заполним табличные части данными корректировки
	ТабличныеЧастиДляЗаполения = Новый Структура("Запасы, Расходы");
	СтрокиТабличнойЧастиДляПерезаполнения = Новый Структура("Запасы, Расходы",
															"Количество, Цена, Сумма, СуммаНДС, Всего", 
															"Количество, Цена, Сумма, СуммаНДС, Всего, Содержание");
			
	Если ДанныеЗаполнения.ВидОперацииЭД = Перечисления.ВидыОперацийЭД.Исправление Тогда
		СтрокиТабличнойЧастиДляПерезаполненияНового = Новый Структура("Запасы, Расходы", "", "");
	Иначе
		СтрокиТабличнойЧастиДляПерезаполненияНового = Новый Структура("Запасы, Расходы",
				"КоличествоДоИзменения, ЦенаДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения, ВсегоДоИзменения", 
				"КоличествоДоИзменения, ЦенаДоИзменения, СуммаДоИзменения, СуммаНДСДоИзменения, ВсегоДоИзменения, СодержаниеДоИзменения");
	КонецЕсли;
			
	Для Каждого ТабличнаяЧасть Из ТабличныеЧастиДляЗаполения Цикл
		
		ИмяТЧ = ТабличнаяЧасть.Ключ;
			
		СтруктураПоиска = Новый Структура("Номенклатура, СтавкаНДС");
		
		Для Каждого СтрокаДокумента Из ДокументОбъект[ИмяТЧ] Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
			РезультатПоискаДанныхЗаполнения = ДанныеДокумента[ИмяТЧ].НайтиСтроки(СтруктураПоиска);
			
			Если РезультатПоискаДанныхЗаполнения.Количество() > 0 Тогда
				
				СтрокаДанныхЗаполнения = РезультатПоискаДанныхЗаполнения[0];
				ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДанныхЗаполнения, СтрокиТабличнойЧастиДляПерезаполнения[ИмяТЧ]);
				
				Если ИмяТЧ = "Запасы" И ЕстьДанныеПрослеживаемости Тогда
					ОбновитьИдентификаторыСтрокПрослеживаемости(ДанныеДокумента, СтрокаДанныхЗаполнения.ИдентификаторСтроки, СтрокаДокумента.ИдентификаторСтроки);
				КонецЕсли;
				
				// Удалим обработанную строку из данных заполнения
				ДанныеДокумента[ИмяТЧ].Удалить(СтрокаДанныхЗаполнения);
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Добавим новые строки в документ
		Если ДанныеДокумента[ИмяТЧ].Количество() > 0 Тогда
			
			Для Каждого СтрокаДанныхЗаполнения Из ДанныеДокумента[ИмяТЧ] Цикл
				
				НоваяСтрока = ДокументОбъект[ИмяТЧ].Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаполнения, , СтрокиТабличнойЧастиДляПерезаполненияНового[ИмяТЧ]);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПересчитатьЦеныСУчетомНДС(ДокументОбъект, "Запасы");
	ПересчитатьЦеныСУчетомНДС(ДокументОбъект, "Расходы");
	
	Если ДанныеЗаполнения.Свойство("СуммаНДС")
		И ДанныеЗаполнения.СуммаНДС > 0
		ИЛИ ДокументОбъект.Запасы.Итог("СуммаНДС") > 0
		ИЛИ ДокументОбъект.Расходы.Итог("СуммаНДС") > 0 Тогда
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
	Иначе
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
		ДокументОбъект.ВалютаДокумента = ВалютаРегламентированногоУчета();
	КонецЕсли;
	
	Если ЕстьДанныеПрослеживаемости Тогда
		
		ЗаполнитьСведенияОПрослеживаемостиВходящегоКорректировочногоДокумента(
					ДокументОбъект.СведенияПрослеживаемости, 
					ДанныеДокумента.СведенияПрослеживаемости, 
					ДокументОбъект.Запасы);
					
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСчетФактуруПолученный(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	// вручную переопределим, если требуется
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, Шапка);
	
	// Заполнение документа-основания
	ДокументОснование = Неопределено;
	Если ЗначениеЗаполнено(Шапка.ДокументОснование) Тогда
		ДокументОснование = Шапка.ДокументОснование[0];
	КонецЕсли;
	
	РеквизитыОснования = Новый Структура;
	РеквизитыОснования.Вставить("ДокументОснование", ДокументОснование);
	РеквизитыОснования.Вставить("НомерИсходногоДокумента", Шапка.НомерИсходногоДокумента);
	РеквизитыОснования.Вставить("ДатаИсходногоДокумента", Шапка.ДатаИсходногоДокумента);
	
	Если Шапка.ВидСчетаФактуры = Перечисления.ВидыОперацийСчетФактураПолученный.Корректировка Тогда
		
		УчитыватьИсправлениеИсходногоДокумента = Шапка.Свойство("УчитыватьИсправлениеИсходногоДокумента") И Шапка.УчитыватьИсправлениеИсходногоДокумента;
		
		РеквизитыОснования.Вставить("УчитыватьИсправлениеИсходногоДокумента", УчитыватьИсправлениеИсходногоДокумента);
		
		Если УчитыватьИсправлениеИсходногоДокумента Тогда
			РеквизитыОснования.Вставить("НомерИсправленияИсходногоДокумента", Шапка.НомерИсправленияИсходногоДокумента);
			РеквизитыОснования.Вставить("ДатаИсправленияИсходногоДокумента", Шапка.ДатаИсправленияИсходногоДокумента);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		Если ОснованиеСчетаФактурыУказываетсяВТабличнойЧасти() Тогда
			НоваяСтрока = ДокументОбъект.ДокументыОснования.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыОснования);
		Иначе
			ЗаполнитьЗначенияСвойств(ДокументОбъект, РеквизитыОснования);
		КонецЕсли;
		
		ДокументОбъект.Заполнить(ДокументОснование);
		
	КонецЕсли;
	
	ДокументОбъект.ВидОперации = Шапка.ВидСчетаФактуры;
	ДокументОбъект.НомерВходящегоДокумента = Шапка.НомерВходящегоДокумента;
	ДокументОбъект.ДатаВходящегоДокумента  = Шапка.ДатаВходящегоДокумента;
	
	Если ДанныеДокумента.Свойство("Запасы") Тогда
		
		ДокументОбъект.СуммаНДСДокумента =
		(ДанныеДокумента.Запасы.Итог("СуммаНДС") + ДанныеДокумента.Расходы.Итог("СуммаНДС"));
		ДокументОбъект.СуммаДокумента =
		(ДанныеДокумента.Запасы.Итог("Всего") + ДанныеДокумента.Расходы.Итог("Всего")) - ДокументОбъект.СуммаНДСДокумента;
		
	Иначе
		
		Если ЗначениеЗаполнено(ДанныеДокумента.ИтогиТЧ.СуммаНДСУвеличение) Тогда
			СуммаНДСДокумента = ДанныеДокумента.ИтогиТЧ.СуммаНДСУвеличение;
			СуммаДокумента = ДанныеДокумента.ИтогиТЧ.СуммаБезНДСУвеличение;
		Иначе
			СуммаНДСДокумента = ДанныеДокумента.ИтогиТЧ.СуммаНДСУменьшение;
			СуммаДокумента = ДанныеДокумента.ИтогиТЧ.СуммаБезНДСУменьшение;
		КонецЕсли;
		
		ДокументОбъект.СуммаНДСДокумента = СуммаНДСДокумента;
		ДокументОбъект.СуммаДокумента = СуммаДокумента;
		
	КонецЕсли;
		
	Если Шапка.Свойство("Исправление") И Шапка.Исправление Тогда
		ДокументОбъект.Исправление       = Шапка.Исправление;
		ДокументОбъект.НомерИсправления  = Шапка.НомерИсправления;
		ДокументОбъект.ДатаИсправления   = Шапка.ДатаИсправления;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Договор)
		И ЗначениеЗаполнено(ДокументОснование)
		И ЗначениеЗаполнено(ДокументОснование.Договор) Тогда
		
		ДокументОбъект.Договор = ДокументОснование.Договор;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьАктОРасхожденияхПолученный(ДокументОбъект, ДанныеДокумента)

	ДанныеЗаполнения = ДанныеДокумента.Шапка;
	
	Если ДанныеЗаполнения.Свойство("ДокументОснование")
		И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование) Тогда
		ДокументОбъект.Заполнить(ДанныеЗаполнения.ДокументОснование);
	Иначе
		ДокументОбъект.Заполнить(ДанныеЗаполнения);
	КонецЕсли;
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.УстановитьНовыйНомер();
	
	// Заполним табличные части данными о расхождениях
	ЗаполнитьТабличнуюЧасть_ДокументОРасхождениях(ДокументОбъект, ДанныеДокумента);
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
		ДокументОбъект.ВалютаДокумента = ВалютаРегламентированногоУчета();
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДокумента.ШтрихкодыУпаковок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧасть_ДокументОРасхождениях(ДокументОбъект, ДанныеДокумента)
	
	РеквизитыТабличнойЧастиДляПерезаполнения = "Количество, Цена, Сумма, СуммаНДС, Всего, НомерГТД, СтранаПроисхождения";
	ТабличнаяЧастьЗапасы = Новый Структура("Запасы", РеквизитыТабличнойЧастиДляПерезаполнения);
	
	СтруктураПоиска = Новый Структура("Номенклатура, СтавкаНДС");
	
	Для Каждого СтрокаДокумента Из ТабличнаяЧастьЗапасы Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
		РезультатПоискаДанныхЗаполнения = ДанныеДокумента.Запасы.НайтиСтроки(СтруктураПоиска);
		
		Если РезультатПоискаДанныхЗаполнения.Количество() > 0 Тогда
			
			СтрокаДанныхЗаполнения = РезультатПоискаДанныхЗаполнения[0];
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДанныхЗаполнения, РеквизитыТабличнойЧастиДляПерезаполнения);
			
			// Удалим обработанную строку из данных заполнения
			ДанныеДокумента.Запасы.Удалить(СтрокаДанныхЗаполнения);
			
			СтрокаДокумента.ЕстьВДокументеРеализации = Истина;
			
		КонецЕсли;
		
		// Добавим новые строки в документ
		Если ДанныеДокумента.Запасы.Количество() > 0 Тогда
			
			Для Каждого СтрокаДанныхЗаполнения Из ДанныеДокумента.Запасы Цикл
				
				НоваяСтрока = ДокументОбъект.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаполнения);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПересчитатьЦеныСУчетомНДС(ДокументОбъект, "Запасы");

КонецПроцедуры

Процедура ЗаполнитьСверкуВзаиморасчетов3_0_2(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.УстановитьНовыйНомер();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДоговорыИзДокументаУчета = ДанныеДокумента.ДанныеКонтрагента.ВыгрузитьКолонку("Договор");
	
	Для каждого ДоговорИзСтрокиТЧ Из ДоговорыИзДокументаУчета Цикл
		СтрокаТаблицы = ДокументОбъект.ДоговорыКонтрагентов.Добавить();
		СтрокаТаблицы.Отметка = Истина;
		СтрокаТаблицы.Договор = ДоговорИзСтрокиТЧ;
	КонецЦикла;
	
	ДокументОбъект.Статус = Перечисления.СтатусыСверокВзаиморасчетов.Создана;
	
	Документы.СверкаВзаиморасчетов.НачальноеСальдоПоДоговорам(
		ДокументОбъект.Организация, 
		ДокументОбъект.НачалоПериода,
		ДокументОбъект.ДоговорыКонтрагентов,
		ДокументОбъект.ВалютаДокумента,
		ДокументОбъект.СальдоНачалоПериода
	);
	
	ЗаполнятьПоВходящимДатам = Истина;
	
	РеквизитыДокументаСверки = Документы.СверкаВзаиморасчетов.ПолучитьСтруктуруДанныхДокумента(
		ДокументОбъект,
		ЗаполнятьПоВходящимДатам
	);
	
	РеквизитыДокументаСверки.Вставить("Ссылка", Неопределено);
	
	Документы.СверкаВзаиморасчетов.ЗаполнитьДанныеПоОрганизации(
		РеквизитыДокументаСверки,
		ДокументОбъект.ДанныеОрганизации
	);
	
	ДокументОбъект.ДанныеКонтрагента.Загрузить(ДанныеДокумента.ДанныеКонтрагента);
	
КонецПроцедуры

Процедура ЗаполнитьСверкуВзаиморасчетов(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.УстановитьНовыйНомер();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Статус = Перечисления.СтатусыСверокВзаиморасчетов.Создана;
	
	РеквизитыДокументаСверки = ПолучитьРеквизитыДокументаСверкаВзаиморасчетов(ДокументОбъект);
	
	Документы.СверкаВзаиморасчетов.ЗаполнитьДанныеПоОрганизации(РеквизитыДокументаСверки, ДокументОбъект.ДанныеОрганизации);
	
	ДокументОбъект.ДанныеКонтрагента.Загрузить(ДанныеДокумента.ДанныеКонтрагента);
	
КонецПроцедуры

Функция ПолучитьРеквизитыДокументаСверкаВзаиморасчетов(ДокументОбъект)
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("Дата", ДокументОбъект.Дата);
	ДанныеДокумента.Вставить("НачалоПериода", ДокументОбъект.НачалоПериода);
	ДанныеДокумента.Вставить("КонецПериода", ДокументОбъект.КонецПериода);
	ДанныеДокумента.Вставить("Организация", Константы.УчетПоКомпании.Компания(ДокументОбъект.Организация));
	ДанныеДокумента.Вставить("Ссылка", Неопределено);
	ДанныеДокумента.Вставить("СортироватьПоДоговорам", ДокументОбъект.СортироватьПоДоговорам);
	ДанныеДокумента.Вставить("ВалютаДокумента", ДокументОбъект.ВалютаДокумента);
	ДанныеДокумента.Вставить("ОрганизациюВПредставление", ДокументОбъект.ДобавлятьОрганизациюВПредставлениеДокумента);
	ДанныеДокумента.Вставить("УказатьСчетФактуру", ДокументОбъект.ДобавлятьСчетФактуруВПредставлениеДокумента);
	ДанныеДокумента.Вставить("ВхНомерВПоступлениеНаСчет", ДокументОбъект.ВходящийНомерВПредставлениеПоступленияНаСчет);
	ДанныеДокумента.Вставить("ВхНомерВРасходСоСчета", ДокументОбъект.ВходящийНомерВПредставлениеРасходаСоСчета);
	ДанныеДокумента.Вставить("ПоВходящимДатам", Истина);
	ДанныеДокумента.Вставить("Контрагент", ДокументОбъект.Контрагент);
	ДанныеДокумента.Вставить("ВестиРасчетыПоДоговорам", Истина);
	ДанныеДокумента.Вставить("ДоговорыКонтрагентов", ДокументОбъект.ДоговорыКонтрагентов.Выгрузить());
	
	Возврат ДанныеДокумента;
	
КонецФункции

Функция ЭтоНоменклатураРасход(Номенклатура)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда 
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
		Результат = ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга")
				ИЛИ ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоНоменклатураЗапас(Номенклатура)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда 
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
		Результат = (ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Запас"));
