// Возвращает версию подсистемы УНФ
//
// Возвращаемое значение:
//  Строка - Версия конфигурации (подсистемы) в формате "x.x.x.x"
//
Функция ВерсияПодсистемыУНФ()
	
	Результат = "0.0.0.0";
	
	ВозможныеИменаПодсистем = Новый Массив;
	ВозможныеИменаПодсистем.Добавить("УправлениеНебольшойФирмой");
	ВозможныеИменаПодсистем.Добавить("УправлениеНебольшойФирмойБазовая");
	ВозможныеИменаПодсистем.Добавить("ПОЛИГРАФИЯ"); // отраслевое решение на базе УНФ
	ВозможныеИменаПодсистем.Добавить("УправлениеСервиснымЦентром"); // отраслевое решение на базе УНФ
	
	ПодсистемыКонфигурации = МенеджерИнтеграции_ОписанияПодсистемКонфигурации();
	
	Для Каждого ИмяПодсистемы Из ВозможныеИменаПодсистем Цикл
		
		ПодсистемаУНФ = ПодсистемыКонфигурации.Получить(ИмяПодсистемы);
		Если ПодсистемаУНФ <> Неопределено Тогда
			Результат = ПодсистемаУНФ.Версия;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат = "0.0.0.0" Тогда
		ВерсияРозницы = "0.0.0.0";
		ВерсияРозницы = ВерсияПодсистемыРозница();
		Если СравнитьВерсии(ВерсияРозницы, "3.0") >= 0 Тогда
			Результат = ВерсияРозницы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВерсияПодсистемыРозница()
	
	Результат = "0.0.0.0";
	
	ВозможныеИменаПодсистем = Новый Массив;
	ВозможныеИменаПодсистем.Добавить("Розница");
	ВозможныеИменаПодсистем.Добавить("РозницаБазовая");
	ВозможныеИменаПодсистем.Добавить("РозницаМагазинОдеждыИОбуви"); // отраслевое решение на базе Розница 3.0
	
	ПодсистемыКонфигурации = МенеджерИнтеграции_ОписанияПодсистемКонфигурации();
	
	Для Каждого ИмяПодсистемы Из ВозможныеИменаПодсистем Цикл
		
		ПодсистемаРозница = ПодсистемыКонфигурации.Получить(ИмяПодсистемы);
		Если ПодсистемаРозница <> Неопределено Тогда
			Результат = ПодсистемаРозница.Версия;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Определяет, где заполняется информация о документе-основании счета-фактуры:
// в шапке или в табличной части. Табличная часть для указания оснований
// появилась в версии УНФ 1.6.18.
// 
// Возвращаемое значение:
//  Булево - Истина, если основание указывается в ТЧ.
//
Функция ОснованиеСчетаФактурыУказываетсяВТабличнойЧасти()
	
	Результат = Ложь;
	
	Если СравнитьВерсии(ВерсияПодсистемыУНФ(), "1.6.18") >= 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
