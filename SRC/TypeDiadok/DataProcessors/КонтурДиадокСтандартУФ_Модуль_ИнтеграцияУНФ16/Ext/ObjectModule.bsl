//{ УСТАРЕЛИ

	// Устарела. Следует использовать ДанныеТабличныхЧастей()
	//
	Функция ПолучитьДанныеТЧ(Документы, ВалютаРегламентированногоУчета, КолонкаКодаТовара = "Код", ФормированиеСФ = Неопределено, СчетФактура = Неопределено, РасчетыВУЕ = Ложь) Экспорт
		
		Если Не ЗначениеЗаполнено(Документы) И Не ЗначениеЗаполнено(СчетФактура) Тогда 
			ОписаниеОш = НСтр("ru = 'Метод ""ПолучитьДанныеТЧ"" получил неверные параметры!
	                           |Обратитесь в тех. поддержку.'");
			ВызватьИсключение ОписаниеОш;
		КонецЕсли;
		
		Если ТипЗнч(Документы) = Тип("Массив") Тогда
			МассивДокументов = Документы;
		ИначеЕсли ТипЗнч(Документы) = Тип("СписокЗначений") Тогда
			МассивДокументов = Документы.ВыгрузитьЗначения();
		Иначе 
			МассивДокументов = Новый Массив;                               
			МассивДокументов.Добавить(Документы);
		КонецЕсли;
		
		Если СчетФактураНаАванс(СчетФактура) Тогда 
			МассивДокументов.Добавить(СчетФактура);
		КонецЕсли;
		
		Результат = Новый Соответствие;
		
		Для Каждого Ссылка Из МассивДокументов Цикл 
			Шапка	 = ДанныеШапки(Ссылка);
			ДанныеТЧ = ДанныеТабличныхЧастей(Шапка);
			ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ДанныеТЧ);
			Результат.Вставить(Ссылка, ДанныеТЧ);
		КонецЦикла;
		
		Возврат Результат;
		
	КонецФункции

//} УСТАРЕЛИ
