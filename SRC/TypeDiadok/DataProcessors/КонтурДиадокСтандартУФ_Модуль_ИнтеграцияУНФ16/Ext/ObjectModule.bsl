#Область СлужебныйПрограммныйИнтерфейс

// Вызывается из Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента
//
// Параметры:
//  ТребуемыеРеквизиты	 - Структура	 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение.
//  СсылкаНаОбъект		 - ЛюбаяСсылка	 - ссылка на объект, описание которого надо получить.
//
Процедура ПриПолученииОписанияПрикладногоДокумента(ТребуемыеРеквизиты, СсылкаНаОбъект) Экспорт
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ПсевдонимОсновнойТаблицы = "";
	
	Если МетаданныеОбъекта = Метаданные.Документы.КорректировкаРеализации Тогда
		
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_КРТУ_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_КРТУ_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		
	ИначеЕсли МетаданныеОбъекта = Метаданные.Документы.СчетФактура Тогда
		
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_СчетФактура_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_СчетФактура_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидДокументаИнформационнойБазы
//
// Параметры:
//  ВидДокумента	 - Строка - (возвращаемый параметр) вид документа с точки зрения ЭДО (см. ВидыЭлектронныхДокументов);
//  СсылкаНаОбъект	 - ЛюбаяСсылка - объект информационной базы, вид которого необходимо определить;
//  ЭтоКорректировка - Булево - Истина, если объект отражает операцию корректировки;
//
Процедура ОпределитьВидДокумента(ВидДокумента, СсылкаНаОбъект, ЭтоКорректировка) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	МетаданныеДокументов = Метаданные.Документы;
	
	Если МетаданныеОбъекта = МетаданныеДокументов.СчетФактура И Не ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.СчетФактура;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.СчетФактура И ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.КорректировочныйСчетФактура;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.РасходнаяНакладная
		Или (МетаданныеОбъекта = МетаданныеДокументов.КорректировкаРеализации И Не ЭтоКорректировка) Тогда
		
		ТолькоУслуги = ДокументРеализацииСодержитТолькоУслуги(СсылкаНаОбъект);
		
		Если ТолькоУслуги Тогда
			ВидДокумента = ВидыЭД.АктОбОказанииУслуг;
		Иначе
			ВидДокумента = ВидыЭД.ТоварнаяНакладная;
		КонецЕсли;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.КорректировкаРеализации И ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.СоглашениеОбИзмененииСтоимости;
		
	Иначе
		
		СоответствиеМетаданных = Новый Соответствие;
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.СверкаВзаиморасчетов, ВидыЭД.АктСверки);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.СчетНаОплату, ВидыЭД.СчетНаОплату);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ЗаказПокупателя, ВидыЭД.СчетНаОплату);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.АктВыполненныхРабот, ВидыЭД.АктОбОказанииУслуг);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ОтчетОПереработке, ВидыЭД.ТоварнаяНакладная);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ОтчетКомитенту, ВидыЭД.АктОбОказанииУслуг);
		
		ВидДокумента = СоответствиеМетаданных.Получить(МетаданныеОбъекта);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДатаНомерДокумента
//
// Параметры:
//  Результат		 	- Структура - (возвращаемый параметр) сведения о дате и номере документа;
//  ОписаниеДокумента	- Структура - параметры объекта ИБ (см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента);
//  ЦифровойИндексОП 	- Число 	- цифровой индекс обособленного подразделения;
//
Процедура ЗаполнитьСведенияОДатеИНомереДокумента(Результат, ОписаниеДокумента, ЦифровойИндексОП) Экспорт
	
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;

	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("Номер");
	РеквизитыДокумента.Вставить("Дата");
	
	Если ЭтоИсправление Тогда
		
		// Переопределим номер документа
		РеквизитыДокумента.Номер = "НомерИсходногоДокумента";
		РеквизитыДокумента.Дата	 = "ДатаИсходногоДокумента";
		
		// И добавим получение номера и даты исправления
		РеквизитыДокумента.Вставить("НомерИсправления");
		РеквизитыДокумента.Вставить("ДатаИсправления", "Дата");
		
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактура")
		И ИспользуетсяНомерНаПечатьСчетаФактуры() Тогда
		
		РеквизитыДокумента.Вставить("НомерНаПечать");
		РеквизитыДокумента.Вставить("ОтредактированНомерСчетаФактуры");
		
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыДокумента);
	
	Если ЗначенияРеквизитов.Свойство("ОтредактированНомерСчетаФактуры")
		И ЗначенияРеквизитов.ОтредактированНомерСчетаФактуры 
		И ЗначениеЗаполнено(ЗначенияРеквизитов.НомерНаПечать) Тогда
		
		Результат.НомерДокумента = ЗначенияРеквизитов.НомерНаПечать;
	Иначе
		Результат.НомерДокумента = ПредставлениеНомера(ЗначенияРеквизитов.Номер);
	КонецЕсли;
	
	Результат.ДатаДокумента	 = ЗначенияРеквизитов.Дата;
	
	Если ЭтоИсправление Тогда
		Результат.НомерИсправления	 = Формат(ЗначенияРеквизитов.НомерИсправления, "ЧГ=0");
		Результат.ДатаИсправления	 = ЗначенияРеквизитов.ДатаИсправления;
	КонецЕсли;
	
	ДополнитьНомерЦифровымИндексомОП(Результат, ЦифровойИндексОП, СсылкаНаОбъект);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку820
//
// Параметры:
//  ДокументыОбОтгрузке	- Массив - (возвращаемый параметр) Массив элементов "Новый_DocumentShipment";
//  СсылкаНаОбъект		- ДокументСсылка.СчетФактураВыданный - СФ для которой определяем реквизиты документов отгрузки.
//
Процедура ПриПолученииДанныхДокументовОбОтгрузке(Результат, СсылкаНаОбъект, СтандартнаяОбработка) Экспорт

КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДатаНомерДокумента
//
// Параметры:
//  Результат		 	- Структура - (возвращаемый параметр) сведения о дате и номере документа;
//  ОписаниеДокумента	- Структура - параметры объекта ИБ (см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента);
//  ЦифровойИндексОП 	- Число 	- цифровой индекс обособленного подразделения;
//
Процедура ЗаполнитьСведенияОДатеИНомереКорректировочногоДокумента(Результат, ОписаниеДокумента, ЦифровойИндексОП) Экспорт
	
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактура") Тогда
		ЗначенияРеквизитов = РеквизитыКорректировочногоСчетаФактуры(СсылкаНаОбъект, ЭтоИсправление);
		УчитыватьИсправлениеИсходногоДокумента = ЗначенияРеквизитов.УчитыватьИсправлениеИсходногоДокумента;
	Иначе
		ЗначенияРеквизитов = РеквизитыКорректировкиРеализации(СсылкаНаОбъект, ЭтоИсправление);
		УчитыватьИсправлениеИсходногоДокумента = ЗначениеЗаполнено(ЗначенияРеквизитов.ДатаИсправленияИсходногоДокумента);
	КонецЕсли;
	
	Если ЗначенияРеквизитов.Свойство("ОтредактированНомерСчетаФактуры")
		И ЗначенияРеквизитов.ОтредактированНомерСчетаФактуры
		И ЗначениеЗаполнено(ЗначенияРеквизитов.НомерНаПечать) Тогда
		
		Результат.НомерДокумента = ЗначенияРеквизитов.НомерНаПечать;
	Иначе
		Результат.НомерДокумента = ПредставлениеНомера(ЗначенияРеквизитов.Номер);
	КонецЕсли;
	
	Результат.ДатаДокумента	 = ЗначенияРеквизитов.Дата;
	
	Если ЭтоИсправление Тогда
		Результат.НомерИсправления	 = Формат(ЗначенияРеквизитов.НомерИсправления, "ЧГ=0");
		Результат.ДатаИсправления	 = ЗначенияРеквизитов.ДатаИсправления;
	КонецЕсли;
	
	ОписаниеРеквизитов = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ДатаНомерДокументаОснования");
	ОписаниеРеквизитов.НомерИсходногоДокумента = Формат(ЗначенияРеквизитов.НомерИсходногоДокумента, "ЧГ=0");
	ОписаниеРеквизитов.ДатаИсходногоДокумента  = ЗначенияРеквизитов.ДатаИсходногоДокумента;
	ОписаниеРеквизитов.УчитыватьИсправлениеИсходногоДокумента = УчитыватьИсправлениеИсходногоДокумента;
	
	Если УчитыватьИсправлениеИсходногоДокумента Тогда
		ОписаниеРеквизитов.НомерИсправленияИсходногоДокумента	 = Формат(ЗначенияРеквизитов.НомерИсправленияИсходногоДокумента, "ЧГ=0");
		ОписаниеРеквизитов.ДатаИсправленияИсходногоДокумента	 = ЗначенияРеквизитов.ДатаИсправленияИсходногоДокумента;
	КонецЕсли;
	
	Результат.ДатаНомерДокументовОснований.Добавить(ОписаниеРеквизитов);
	
	ДополнитьНомерЦифровымИндексомОП(Результат, ЦифровойИндексОП, СсылкаНаОбъект);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеШапки()
//
// Параметры:
//  Реквизиты			 - Структура		 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение.
//  МетаданныеИсточника	 - ОбъектМетаданных	 - Метаданные документа-источника
//
Процедура ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеИсточника) Экспорт
	
	#Область Организация
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Организация") Тогда 
		
		Реквизиты.Организация =
		"ВЫБОР
		|	КОГДА Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И НЕ Организация = Организация.ГоловнаяОрганизация
		|		ТОГДА Организация.ГоловнаяОрганизация
		|	ИНАЧЕ Организация
		|КОНЕЦ";
		
	КонецЕсли;
	#КонецОбласти
	
	#Область Контрагент
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Контрагент") Тогда 
		
		Реквизиты.Контрагент =
		"ВЫБОР
		|	КОГДА Контрагент.ГоловнойКонтрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			И Контрагент.ГоловнойКонтрагент.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|		ТОГДА Контрагент.ГоловнойКонтрагент
		|	ИНАЧЕ Контрагент
		|КОНЕЦ";
		
		Реквизиты.КонтрагентКПП = "Контрагент.КПП";
		
	КонецЕсли;
	#КонецОбласти
	
	#Область Грузоотправитель
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Грузоотправитель")
		И ЕстьРеквизитМетаданных(МетаданныеИсточника, "Подразделение") Тогда
		
		Реквизиты.Грузоотправитель =
		"ВЫБОР
		|	КОГДА Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ТОГДА Грузоотправитель
		|	КОГДА Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И НЕ Организация = Организация.ГоловнаяОрганизация
		|		ТОГДА Организация
		|	КОГДА Подразделение.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И Подразделение.ГоловнаяОрганизация = Организация
		|		ТОГДА Подразделение
		|	ИНАЧЕ """"
		|КОНЕЦ";
		
	КонецЕсли;
	#КонецОбласти
	
	#Область ЦифровойИндексОбособленногоПодразделения
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Организация")
		И ЕстьРеквизитМетаданных(МетаданныеИсточника, "Подразделение") Тогда
		
		Реквизиты.ЦифровойИндексОбособленногоПодразделения =
		"ВЫБОР
		|	КОГДА Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И НЕ Организация = Организация.ГоловнаяОрганизация
		|		ТОГДА Организация.ЦифровойИндексОбособленногоПодразделения
		|	КОГДА Подразделение.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И Подразделение.ГоловнаяОрганизация = Организация
		|		ТОГДА Подразделение.ЦифровойИндексОбособленногоПодразделения
		|	ИНАЧЕ """"
		|КОНЕЦ";
		
	КонецЕсли;
	#КонецОбласти
	
	#Область ОбособленноеПодразделение
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Подразделение") Тогда
		
		Реквизиты.ОбособленноеПодразделение =
		"ВЫБОР
		|	КОГДА Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И НЕ Организация = Организация.ГоловнаяОрганизация
		|		ТОГДА Организация
		|	КОГДА Подразделение.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			И Подразделение.ГоловнаяОрганизация = Организация
		|		ТОГДА Подразделение
		|	ИНАЧЕ Организация
		|КОНЕЦ";
		
	КонецЕсли;
	#КонецОбласти
	
	#Область Грузополучатель
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Грузополучатель") Тогда
		
		Реквизиты.Грузополучатель =
		"ВЫБОР
		|	КОГДА Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|		ТОГДА Контрагент
		|	ИНАЧЕ Грузополучатель
		|КОНЕЦ";
		
	КонецЕсли;
	#КонецОбласти
	
	#Область ВалютаИКурсы
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "ВалютаДокумента") 
		И ЕстьРеквизитМетаданных(МетаданныеИсточника, "Валюта") Тогда 
		
		Реквизиты.ВалютаДокумента = "Валюта";
		
	КонецЕсли;
	
	Реквизиты.КурсДокумента		 = "Курс";
	Реквизиты.КратностьДокумента = "Кратность";
	
	#КонецОбласти
	
	#Область Прочее
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "Договор") Тогда 
		Реквизиты.РасчетыВУсловныхЕдиницах = "ЕСТЬNULL(Договор.РасчетыВУсловныхЕдиницах, ЛОЖЬ)";
	Иначе 
		Реквизиты.РасчетыВУсловныхЕдиницах = "ЛОЖЬ";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "БанковскийСчет") Тогда 
		Реквизиты.БанковскийСчетОрганизации = "БанковскийСчет";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "СуммаВключаетНДС") Тогда 
		Реквизиты.ЦенаВключаетНДС = "СуммаВключаетНДС";
	ИначеЕсли Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "ЦенаВключаетНДС") Тогда 
		Реквизиты.ЦенаВключаетНДС = "ИСТИНА";
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеШапки
// после формирования структуры шапки документа.
//
// Параметры:
//  ЗначенияРеквизитов - Структура - Структура со значениями реквизита документа
//
Процедура ПослеПолученияДанныхШапкиДокумента(ДанныеШапки) Экспорт
	
	СсылкаНаОбъект = ДанныеШапки.ОписаниеДокумента.Ссылка;
	
	Если СчетФактураНаАванс(СсылкаНаОбъект) Тогда 
		ДанныеШапки.БанковскийСчетОрганизации = БанковскийСчетСчетаФактурыНаАванс(СсылкаНаОбъект);
	ИначеЕсли ЭтоСчетФактура(СсылкаНаОбъект) Тогда 
		ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеШапки);
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей()
//
// Параметры:
//  МетаданныеОбъекта	 - ОбъектМетаданных - объект метаданных.
//  ТабличныеЧасти		 - Массив - массив, в который необходимо добавить имена табличных частей, из которых нужно получить данные.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриПолученииИменТабличныхЧастей(МетаданныеОбъекта, ТабличныеЧасти, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ИмяДокумента = ВРег(МетаданныеОбъекта.Имя);
	
	Если ИмяДокумента = ВРег("АктВыполненныхРабот") Тогда 
		
		ТабличныеЧасти.Добавить("РаботыИУслуги");
		
	ИначеЕсли ИмяДокумента = ВРег("ОтчетОПереработке") Тогда 
		
		ТабличныеЧасти.Добавить("Продукция");
		
	ИначеЕсли ИмяДокумента = ВРег("ЗаказПокупателя") Тогда 
		
		ТабличныеЧасти.Добавить("Запасы");
		ТабличныеЧасти.Добавить("Работы");
		
	ИначеЕсли ИмяДокумента = ВРег("СчетФактура") Тогда 
		
		Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактура.ТабличнаяЧасть.Авансы") Тогда 
			ТабличныеЧасти.Добавить("Авансы");
		КонецЕсли;
		
		Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактура.ТабличнаяЧасть.Запасы") Тогда 
			ТабличныеЧасти.Добавить("Запасы");
		КонецЕсли;
		
		Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактура.ТабличнаяЧасть.УдалитьЗапасы") Тогда 
			ТабличныеЧасти.Добавить("УдалитьЗапасы");
		КонецЕсли;
		
	ИначеЕсли МетодСервера(, "СуществуетОбъектМетаданных", "Документ." + ИмяДокумента + ".ТабличнаяЧасть.Запасы") Тогда 
		
		ТабличныеЧасти.Добавить("Запасы");
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей()
//
// Параметры:
//  Шапка				 - Структура - см. Модуль_ИнтеграцияУниверсальный.ДанныеШапки()
//  ИмяТабличнойЧасти	 - Строка	 - имя табличной части объекта.
//  РеквизитыТЧ			 - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//                                     псевдоним поля, а в качестве значения (опционально) фактическое имя поля в таблице или произвольное выражение.
//                                     Если значение не определено, то имя поля берется из ключа.
//  ПараметрыЗапроса	 - Структура - дополнительные параметры, будут переданы в исполняемый запрос.
//
Процедура ПриПодготовкеЗапросаПоТоварнойЧастиДокумента(Шапка, ИмяТабличнойЧасти, РеквизитыТЧ, ПараметрыЗапроса) Экспорт
	
	СсылкаНаОбъект = Шапка.ОписаниеДокумента.Ссылка;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	
	Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "ЕдиницаИзмерения") Тогда
		
		НастройкаПользовательскаяЕИ = Константы.ПечатьПользовательскихЕдиницИзмерения.Получить();
		ЗначениеПользовательскаяЕИ = Перечисления.ПечатьПользовательскихЕдиницИзмерения.ФормироватьПечатныйДокументВПользовательскойЕдинице;
		ИспользоватьБазовыеЕИ = (НастройкаПользовательскаяЕИ = ЗначениеПользовательскаяЕИ);
		ИспользоватьБазовыеЕИ = Формат(ИспользоватьБазовыеЕИ, "БИ='ИСТИНА'; БЛ='ЛОЖЬ'");
		
		РеквизитыТЧ.Упаковка =
		"ВЫБОР
		|	КОГДА ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
		|		И " + ИспользоватьБазовыеЕИ + "
		|		И ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> Значение(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
		|			ТОГДА ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
		|	ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
		|КОНЕЦ";
		
		РеквизитыТЧ.ЕдиницаИзмерения =
		"ВЫБОР
		|	КОГДА ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
		|		И " + ИспользоватьБазовыеЕИ + "
		|		И ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> Значение(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
		|			ТОГДА ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору
		|	ИНАЧЕ Номенклатура.ЕдиницаИзмерения
		|КОНЕЦ";
		
		РеквизитыТЧ.ЕдиницаИзмеренияКод =
		"ВЫБОР
		|	КОГДА ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
		|		И " + ИспользоватьБазовыеЕИ + "
		|		И ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору <> Значение(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
		|			ТОГДА ЕСТЬNULL(ЕдиницаИзмерения.ЕдиницаИзмеренияПоКлассификатору.Код, """")
		|	ИНАЧЕ Номенклатура.ЕдиницаИзмерения.Код
		|КОНЕЦ";
		
		РеквизитыТЧ.Количество =
		"ВЫБОР
		|	КОГДА ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
		|		И НЕ " + ИспользоватьБазовыеЕИ + "
		|			ТОГДА Количество * ЕдиницаИзмерения.Коэффициент
		|	ИНАЧЕ Количество
		|КОНЕЦ";
		
		Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "КоличествоДоИзменения") Тогда
			
			РеквизитыТЧ.КоличествоДоИзменения =
			"ВЫБОР
			|	КОГДА ЕдиницаИзмерения ССЫЛКА Справочник.ЕдиницыИзмерения
			|		И НЕ " + ИспользоватьБазовыеЕИ + "
			|			ТОГДА КоличествоДоИзменения * ЕдиницаИзмерения.Коэффициент
			|	ИНАЧЕ КоличествоДоИзменения
			|КОНЕЦ";
			
		КонецЕсли;

	Иначе
		
		РеквизитыТЧ.Упаковка = "ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)";
		РеквизитыТЧ.ЕдиницаИзмерения = "ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)";
		РеквизитыТЧ.ЕдиницаИзмеренияКод = "";
		
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "СуммаАкциза") Тогда
		РеквизитыТЧ.СуммаАкциза =
			"ВЫБОР
			|		КОГДА Номенклатура.ПодакцизныйТовар
			|			ТОГДА СуммаАкциза
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "СуммаАкцизаДоИзменения") Тогда
		РеквизитыТЧ.СуммаАкцизаДоИзменения =
			"ВЫБОР
			|		КОГДА Номенклатура.ПодакцизныйТовар
			|			ТОГДА СуммаАкцизаДоИзменения
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ";
	КонецЕсли;
	
	#Область СуммаСНДС
	
	// Стандартное имя реквизита суммы с налогами - "Всего"
	РеквизитыТЧ.СуммаСНДС			 = "Всего";
	РеквизитыТЧ.СуммаСНДСДоИзменения = "ВсегоДоИзменения";
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеТЧ, "Всего") И ВРег(ИмяТабличнойЧасти) = ВРег("Авансы") Тогда
		// У авансового СФ в ТЧ "Авансы" хранится сумма с НДС.
		РеквизитыТЧ.СуммаСНДС = "Сумма";
	КонецЕсли;
	
	#КонецОбласти
	
	#Область РеквизитыКоторыеНеИзменяютсяКорректировочнымиДокументами
	
	// Следующие реквизиты не могут быть скорректированы:
	// изменение любого из них можно считать удалением старой строки и добавлением новой
	
	РеквизитыТЧ.СтранаПроисхожденияДоИзменения		 = "СтранаПроисхождения";
	РеквизитыТЧ.СтранаПроисхожденияДоИзмененияКод	 = "СтранаПроисхожденияКод";
	РеквизитыТЧ.НомерГТДДоИзменения					 = "НомерГТД";
	РеквизитыТЧ.КодТНВЭДДоИзменения					 = "КодТНВЭД";
	
	РеквизитыТЧ.УпаковкаДоИзменения = РеквизитыТЧ.Упаковка;
	РеквизитыТЧ.ЕдиницаИзмеренияДоИзменения = РеквизитыТЧ.ЕдиницаИзмерения;
	РеквизитыТЧ.ЕдиницаИзмеренияДоИзмененияКод = РеквизитыТЧ.ЕдиницаИзмеренияКод;
	
	#КонецОбласти
	
	#Область РеквизитыИсправленийКорректировочныхДокументов
	
	ЭтоИКСФ = Ложь;
	Если Истина
		И ЗначениеЗаполнено(Шапка.ХозяйственнаяОперация)
		И Шапка.ХозяйственнаяОперация = ПредопределенноеЗначение("Справочник.ХозяйственныеОперации.ИсправлениеОшибки")
		Тогда 
		ЭтоИКСФ = Истина;
	КонецЕсли;
	
	Если ЭтоИКСФ Тогда
		
		// Для обычного исправления (ИСФ или УПД) значения до изменения не важны,
		// т.к. всегда выводится только новая версия документа.
		// Для корректировочного документа (КСФ или УКД) значения до изменения берем из реквизитов "<ИмяРеквизита>ДоИзменения".
		// А вот для исправления корректировочного документа (ИКСФ/ИУПД) все немного сложнее:
		// значения до изменения хранятся в реквизитах "<ИмяРеквизита>ДоКорректировки", а не в "<ИмяРеквизита>ДоИзменения"
		РеквизитыТЧ.КоличествоДоИзменения	 = "КоличествоДоКорректировки";
		РеквизитыТЧ.ЦенаДоИзменения			 = "ЦенаДоКорректировки";
		РеквизитыТЧ.СуммаДоИзменения		 = "СуммаДоКорректировки";
		РеквизитыТЧ.СуммаНДСДоИзменения		 = "СуммаНДСДоКорректировки";
		РеквизитыТЧ.СуммаСНДСДоИзменения	 = "ВсегоДоКорректировки";
		
		// Реквизит "СтавкаНДСДоКорректировки" отсутствуют, поэтому берем значение из поля "СтавкаНДСДоИзменения"
		РеквизитыТЧ.СтавкаНДСДоИзменения				 = "СтавкаНДСДоИзменения";
		РеквизитыТЧ.СтавкаНДСДоИзмененияПредставление	 = "СтавкаНДСДоИзмененияПредставление";
		
		Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "СуммаАкцизаДоКорректировки") Тогда
			РеквизитыТЧ.СуммаАкцизаДоИзменения =
				"ВЫБОР
				|		КОГДА Номенклатура.ПодакцизныйТовар
				|			ТОГДА СуммаАкцизаДоКорректировки
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ";
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область РеквизитыСчетаФактурыНаАванс
	
	Если СчетФактуранаАванс(СсылкаНаОбъект) Тогда 
		РеквизитыТЧ.Количество	 = "НЕОПРЕДЕЛЕНО";
		РеквизитыТЧ.Цена		 = "НЕОПРЕДЕЛЕНО";
		РеквизитыТЧ.Сумма		 = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ОпределениеТипаНоменклатуры
	
	Если СчетФактураНаАванс(СсылкаНаОбъект) Тогда
		
		РеквизитыТЧ.ПризнакТоварРаботаУслуга = "Service";
		РеквизитыТЧ.ЭтоУслуга = "ИСТИНА";
		
	Иначе
		
		РеквизитыТЧ.ПризнакТоварРаботаУслуга = 
		"ВЫБОР
		|	КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас)
		|		ТОГДА ""Property""
		|	КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
		|		ТОГДА ""Service""
		|	КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|		ТОГДА ""Job""
		|	ИНАЧЕ ""Other""
		|КОНЕЦ";
		
		РеквизитыТЧ.ЭтоУслуга = 
		"ВЫБОР
		|	КОГДА Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
		|		ИЛИ Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
		|		ТОГДА ИСТИНА
		|	ИНАЧЕ ЛОЖЬ
		|КОНЕЦ";
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Прочее
	
	РеквизитыТЧ.ВидУпаковки = РеквизитыТЧ.ЕдиницаИзмерения;
	
	Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "НомерГТД") Тогда
		
		Если МетодСервера(,"СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "1.6.13") >= 0 Тогда
			
			РеквизитыТЧ.НомерГТДПредставление = "НомерГТД.РегистрационныйНомер";
			
		Иначе
			РеквизитыТЧ.НомерГТДПредставление = "НомерГТД";
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЕстьРеквизитМетаданных(МетаданныеТЧ, "ИдентификаторСтроки") Тогда
		РеквизитыТЧ.ИдентификаторСтроки = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;

	РеквизитыТЧ.ДокументОтгрузки = "Ссылка";
	
	Если ЕстьРеквизитМетаданных(МетаданныеТЧ, "КлючСвязи") Тогда
		РеквизитыТЧ.Вставить("КлючСвязи", "КлючСвязи");
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей()
//
// Параметры:
//  Шапка			 - Структура	 - см. Модуль_ИнтеграцияУниверсальный.ДанныеШапки.
//  ТабличнаяЧасть	 - ТаблицаЗначений	 - см. Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей.
//
Процедура ПослеПолученияТоварнойЧастиДокумента(Шапка, ТабличнаяЧасть) Экспорт
	
	ЗаполненоПоОснованию = ЗаполнитьТабличнуюЧастьПоДаннымДокументовОснований(Шапка, ТабличнаяЧасть);
	
	ДополнитьДаннымиПоДоставке(ТабличнаяЧасть, Шапка);
	
	УдалитьНеизмененныеСтрокиКорректировочногоДокумента(Шапка, ТабличнаяЧасть);
	УдалитьОтмененныеСтрокиИсправительногоДокумента(Шапка, ТабличнаяЧасть);
	УдалитьСтрокиОтчетКомиссионераОтДругихСчетФактур(Шапка, ТабличнаяЧасть);
	
	ТочностьЦены = ПараметрыКлиентСервер.ТочностьЦены;
	
	Если Не ЗаполненоПоОснованию 
		И Шапка.РасчетыВУсловныхЕдиницах 
		И Шапка.ВалютаДокумента <> ВалютаРегламентированногоУчета() Тогда
		
		ПересчитатьСуммыВВалютуРегл(Шапка, ТабличнаяЧасть);
		
	КонецЕсли;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл 
		
		// Некоторые колонки требуют ручной обработки
		СтрокаТЧ.СтавкаНДСПредставление = ПредставлениеСтавкиНДС(СтрокаТЧ.СтавкаНДС);
		СтрокаТЧ.СтавкаНДСДоИзмененияПредставление = ПредставлениеСтавкиНДС(СтрокаТЧ.СтавкаНДСДоИзменения);
		
		Если Не ЗначениеЗаполнено(СтрокаТЧ.НоменклатураПредставление) Тогда 
			СтрокаТЧ.НоменклатураПредставление = ПредставлениеНоменклатуры(СтрокаТЧ.Номенклатура, СтрокаТЧ.Характеристика);
		КонецЕсли;
		
		СтрокаТЧ.НомерГТД = СтрокаТЧ.НомерГТДПредставление;
		
		Если Шапка.ЦенаВключаетНДС 
			И ЗначениеЗаполнено(СтрокаТЧ.СуммаНДС)
			И ЗначениеЗаполнено(СтрокаТЧ.Количество) Тогда
			
			СтрокаТЧ.Цена = Окр((СтрокаТЧ.СуммаСНДС - СтрокаТЧ.СуммаНДС) / СтрокаТЧ.Количество, ТочностьЦены);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Шапка.ОписаниеДокумента.ЭтоКорректировка Тогда
	
		ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(ТабличнаяЧасть, Шапка.ОписаниеДокумента.Ссылка);
		
	Иначе
		
		ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоРеализации(ТабличнаяЧасть, Шапка.ОписаниеДокумента.Ссылка);
		
	КонецЕсли;
	
	
КонецПроцедуры

