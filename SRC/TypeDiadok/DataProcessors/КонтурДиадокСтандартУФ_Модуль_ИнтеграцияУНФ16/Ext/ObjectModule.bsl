Процедура ЗаполнитьСтруктурированноеОписаниеАдреса(AddressContent, СведенияОбОрганизации, ЮрФизЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса = "")
	
	ВладелецКИ	 = ХранилищеКонтактнойИнформацииОбъекта(ЮрФизЛицо);
	ВидАдреса	 = ПолучитьВидКИ(ВладелецКИ, Юрадрес);
	Адрес		 = АдресЮрФизЛица(ВладелецКИ, ВидАдреса, ДатаДокумента);
	
	Если Не ЗначениеЗаполнено(Адрес.ЗначенияПолей) Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураАдреса = СведенияОбАдресе(Адрес.ЗначенияПолей);
	
	// Обертка для корректного заполнения адреса доставки (грузополучателя) по данным документа:
	// код страны определяем по фактическому адресу грузополучателя, а представление подставляем из документа
	Если ЗначениеЗаполнено(ПредставлениеАдреса) Тогда 
		СтруктураАдреса.СохраненноеПредставление = ПредставлениеАдреса;
	// используем пользовательское представление адреса	
	Иначе
		СтруктураАдреса.СохраненноеПредставление = ?(ЮрАдрес, СведенияОбОрганизации.ЮридическийАдрес, СведенияОбОрганизации.ФактическийАдрес);	
	КонецЕсли;
	
	Заполнить_AddressInfo(AddressContent, СтруктураАдреса);
	
КонецПроцедуры

