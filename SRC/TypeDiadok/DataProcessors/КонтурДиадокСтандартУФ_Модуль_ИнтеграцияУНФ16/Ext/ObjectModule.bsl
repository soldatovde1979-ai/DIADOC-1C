// Формирует сводную таблицу, содержащую сведения о товарной части каждого документа из переданного списка.
//
// Параметры:
//  ДокументИлиМассив - ДокументСсылка, Массив - содержит ссылки на документы, табличные части которых нужно получить.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей()
//
Функция ДанныеТабличныхЧастейМассиваДокументов(ДокументИлиМассив)
	
	Если ТипЗнч(ДокументИлиМассив) = Тип("Массив") Тогда
		МассивДокументов = ДокументИлиМассив;
	Иначе
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(ДокументИлиМассив);
	КонецЕсли;
	
	ДанныеТЧ = Неопределено;
	
	Для Каждого Ссылка Из МассивДокументов Цикл 
		
		Шапка = ДанныеШапки(Ссылка);
		Буфер = ДанныеТабличныхЧастей(Шапка);
		
		Если ДанныеТЧ = Неопределено Тогда 
			ДанныеТЧ = Буфер.Скопировать();
		Иначе 
			ДополнитьТаблицу(ДанныеТЧ, Буфер);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеТЧ;
	
КонецФункции

Процедура ДобавитьДокументыОснованияВСлужебнуюИнформацию(Контент)
	
	СсылкаНаОбъект = Контент.СлужебнаяИнформация.Ссылка;
	
	Если Не ЭтоСчетФактура(СсылкаНаОбъект)
		Или СчетФактураНаАванс(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыОснования = ВсеДокументыОснования(СсылкаНаОбъект);
	Контент.СлужебнаяИнформация.Вставить("ДокументыОснования", ДокументыОснования);
	
КонецПроцедуры

Функция ВсеДокументыОснования(СсылкаНаОбъект)
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ИмяДокумента = МетаданныеОбъекта.Имя;
	
	ИмяМетаданныхТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Результат = Новый Массив;
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ИмяМетаданныхТаблицыОснований) Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ПолноеИмяТаблицы = СтрЗаменить("Документ.%ИмяДокумента%.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.ДокументОснование);
		КонецЦикла;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ДокументОснование") Тогда
		
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		Результат.Добавить(Основание);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает документ-основание произвольного документа.
// Если оснований несколько, берется только первое.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - произвольный документ, основание которого требуется получить.
// 
// Возвращаемое значение:
//  ДокументСсылка - документ-основание.
//
Функция ПервыйДокументОснование(СсылкаНаДокумент)
	
	Результат = Неопределено;
	
	МетаданныеДокумента	 = СсылкаНаДокумент.Метаданные();
	ИмяДокумента		 = МетаданныеДокумента.Имя;
	
	ПолноеИмяТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ПолноеИмяТаблицыОснований) Тогда 
	
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.%ИмяДокумента%.ДокументыОснования КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяДокумента%", ИмяДокумента);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			Результат = Выборка.ДокументОснование;
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "ДокументОснование") Тогда 
		
		Результат = МетодСервера(, "ЗначениеРеквизитаОбъекта", СсылкаНаДокумент, "ДокументОснование");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет реквизиты шапки счета-фактуры значениями реквизитов документа-основания.
// Для печати счета-фактуры многие реквизиты берутся из его документа-основания.
//
// Параметры:
//  ДанныеСчетаФактуры - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеСчетаФактуры)
	
	СсылкаНаОбъект = ДанныеСчетаФактуры.ОписаниеДокумента.Ссылка;
	ДокументОснование = ПервыйДокументОснование(СсылкаНаОбъект);
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда 
		Возврат;
	КонецЕсли;
	
	ДанныеДокументаОснования = ДанныеШапки(ДокументОснование);
	
	КопируемыеРеквизиты = Новый Массив;
	КопируемыеРеквизиты.Добавить("ХозяйственнаяОперация");
	КопируемыеРеквизиты.Добавить("Грузополучатель");
	КопируемыеРеквизиты.Добавить("Грузоотправитель");
	КопируемыеРеквизиты.Добавить("БанковскийСчетОрганизации");
	КопируемыеРеквизиты.Добавить("БанковскийСчетКонтрагента");
	КопируемыеРеквизиты.Добавить("БанковскийСчетГрузоотправителя");
	КопируемыеРеквизиты.Добавить("БанковскийСчетГрузополучателя");
	КопируемыеРеквизиты.Добавить("ЦенаВключаетНДС");
	КопируемыеРеквизиты.Добавить("АдресДоставки");
	КопируемыеРеквизиты.Добавить("ОбособленноеПодразделение");
	КопируемыеРеквизиты.Добавить("ЦифровойИндексОбособленногоПодразделения");
	
	Для Каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл 
		
		Если ЗначениеЗаполнено(ДанныеДокументаОснования[ИмяРеквизита]) Тогда 
			ДанныеСчетаФактуры.Вставить(ИмяРеквизита, ДанныеДокументаОснования[ИмяРеквизита]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументРеализацииСодержитТолькоУслуги(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТЧ.ТипНоменклатурыЗапас, Ложь)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ), Ложь) КАК ЕстьТовары,
	|	ЕСТЬNULL(МАКСИМУМ(ВЫБОР
	|			КОГДА НЕ ТЧ.ТипНоменклатурыЗапас
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ), Ложь) КАК ЕстьУслуги
	|ИЗ
	|	&ПолноеИмяТаблицы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект";
	
	ПолноеИмяТаблицы = СтрШаблон("%1.%2"
		, СсылкаНаОбъект.Метаданные().ПолноеИмя()
		, "Запасы");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Запрос.Текст = СтрЗаменить(ШаблонЗапроса
		, "&ПолноеИмяТаблицы"
		, ПолноеИмяТаблицы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЕстьУслуги И Не Выборка.ЕстьТовары;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет существование объекта метаданных по его полному имени.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
// 
// Возвращаемое значение:
//  Булево - Истина, если объект с заданным именем существует.
//
// Пример:
//   ЕстьКорректировкиРТУ	 = СуществуетОбъектМетаданных("Документ.КорректировкаРеализации");
//   ЕстьГрузооотправитель	 = СуществуетОбъектМетаданных("Документ.РеализацияТоваровУслуг.Реквизит.Грузоотправитель");
//   ЕстьРеквизитКодТНВЭД	 = СуществуетОбъектМетаданных("Документ.РасходнаяНакладная.ТабличнаяЧасть.Запасы.Реквизит.КодТНВЭД");
//
Функция СуществуетОбъектМетаданных(ПолноеИмяОбъекта)
	
	Возврат МетодСервера(, "СуществуетОбъектМетаданных", ПолноеИмяОбъекта);
	
КонецФункции

Функция ЭтоСчетФактура(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СчетФактура") Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьТабличнуюЧастьПоДаннымДокументовОснований(Шапка, ТабличнаяЧасть)
	
	Результат = Ложь;
	
	СсылкаНаОбъект = Шапка.ОписаниеДокумента.Ссылка;
	
	// В старых версиях конфигурации товарная часть СФ хранилась в самом СФ.
	// Это также может быть справедливо и для документов, сформированных до
	// обновления конфигурации до версии 1.6.14+
	Если Не ЗначениеЗаполнено(ТабличнаяЧасть) 
		И ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактура")
		И (Шапка.ВидОперации = Перечисления.ВидыОперацийСчетФактура.Продажа Или Шапка.ВидОперации = Перечисления.ВидыОперацийСчетФактура.Корректировка)
		Тогда // Пробуем достать товарную часть из документов-оснований
		
		Основания		 = ОснованияСчетаФактуры(СсылкаНаОбъект);
		ТабличнаяЧасть	 = ДанныеТабличныхЧастейМассиваДокументов(Основания); // Заполним товарную часть по данным всех документов-оснований
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СуммыДокументаРегл(СсылкаНаОбъект)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СуммыДокументовРегл.ТабличнаяЧастьДокумента КАК ТабличнаяЧастьДокумента,
	|	СуммыДокументовРегл.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	СуммыДокументовРегл.Всего КАК Всего,
	|	СуммыДокументовРегл.НДС КАК НДС
	|ИЗ
	|	РегистрСведений.СуммыДокументовРегламентированныйУчет КАК СуммыДокументовРегл
	|ГДЕ
	|	СуммыДокументовРегл.Регистратор = &СсылкаНаОбъект
	|	И СуммыДокументовРегл.Активность";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Индексы.Добавить("ТабличнаяЧастьДокумента, НомерСтрокиДокумента");
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторТабличнойЧасти(ИмяТабличнойЧасти)
	
	Результат = Перечисления.ТабличныеЧастиДокументов[ИмяТабличнойЧасти];
	
	Возврат Результат;
	
КонецФункции

Процедура ПересчитатьСуммыВВалютуРегл(Шапка, ТабличнаяЧасть)
	
	СсылкаНаОбъект = Шапка.ОписаниеДокумента.Ссылка;
	ВладелецТЧ = СсылкаНаОбъект;
	
	Если ЭтоСчетФактура(СсылкаНаОбъект) Тогда
		ВладелецТЧ = ПервыйДокументОснование(СсылкаНаОбъект);
	КонецЕсли;
	
	ПересчитатьПоКурсу = Ложь;
	СуммыРегл = СуммыДокументаРегл(ВладелецТЧ);
	
	Если Не ЗначениеЗаполнено(СуммыРегл) Тогда
		ПересчитатьПоКурсу = Истина;
		КоэффициентПересчета = Шапка.КурсДокумента / Шапка.КратностьДокумента;
	КонецЕсли;
	
	ТочностьЦены = ПараметрыКлиентСервер.ТочностьЦены;
	
	ЭтоКорректировка = Шапка.ОписаниеДокумента.ЭтоКорректировка;
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		
		Если ПересчитатьПоКурсу Тогда
			
			ВсегоРегл = Окр(СтрокаТЧ.СуммаСНДС * КоэффициентПересчета, ТочностьЦены);
			НДСРегл = Окр(СтрокаТЧ.СуммаНДС * КоэффициентПересчета, ТочностьЦены);
			
			Если ЭтоКорректировка Тогда
				
				ВсегоДоИзмененияРегл = Окр(СтрокаТЧ.СуммаСНДСДоИзменения * КоэффициентПересчета, ТочностьЦены);
				НДСДоИзмененияРегл = Окр(СтрокаТЧ.СуммаНДСДоИзменения * КоэффициентПересчета, ТочностьЦены);
				
			КонецЕсли;
			
		Иначе
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ТабличнаяЧастьДокумента", ИдентификаторТабличнойЧасти(СтрокаТЧ.ИмяТабличнойЧасти));
			ПараметрыОтбора.Вставить("НомерСтрокиДокумента", СтрокаТЧ.НомерСтроки);
			
			НайденныеСтроки = СуммыРегл.НайтиСтроки(ПараметрыОтбора);
			
			Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Продолжить;
			КонецЕсли;
			
			ВсегоРегл = НайденныеСтроки[0].Всего;
			НДСРегл = НайденныеСтроки[0].НДС;
			
		КонецЕсли;
		
		СтрокаТЧ.СуммаСНДС = ВсегоРегл;
		СтрокаТЧ.СуммаНДС = НДСРегл;
		СтрокаТЧ.Сумма = ВсегоРегл - НДСРегл;
				
		Если ЗначениеЗаполнено(СтрокаТЧ.Количество) Тогда
			СтрокаТЧ.Цена = Окр(СтрокаТЧ.Сумма / СтрокаТЧ.Количество, ТочностьЦены);
		КонецЕсли;
		
		Если ЭтоКорректировка Тогда
			
			СтрокаТЧ.СуммаСНДСДоИзменения 	= ВсегоДоИзмененияРегл;
			СтрокаТЧ.СуммаНДСДоИзменения 	= НДСДоИзмененияРегл;
			СтрокаТЧ.СуммаДоИзменения		= ВсегоДоИзмененияРегл - НДСДоИзмененияРегл;
			
			Если ЗначениеЗаполнено(СтрокаТЧ.КоличествоДоИзменения) Тогда
				СтрокаТЧ.ЦенаДоИзменения = Окр(СтрокаТЧ.СуммаДоИзменения / СтрокаТЧ.КоличествоДоИзменения, ТочностьЦены);
			КонецЕсли;
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНеизмененныеСтрокиКорректировочногоДокумента(Шапка, ТабличнаяЧасть)
	
	Если Шапка.ВидОперации <> Перечисления.ВидыОперацийИсправленияПоступленияРеализации.СогласованноеИзменение 
		И Шапка.ВидОперации <> Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда 
		Возврат;
	КонецЕсли;
	
	КорректируемыеПоля = Новый Структура;
	КорректируемыеПоля.Вставить("Количество", "КоличествоДоИзменения");
	КорректируемыеПоля.Вставить("Цена"		, "ЦенаДоИзменения");
	КорректируемыеПоля.Вставить("Сумма"		, "СуммаДоИзменения");
	КорректируемыеПоля.Вставить("СуммаНДС"	, "СуммаНДСДоИзменения");
	КорректируемыеПоля.Вставить("СуммаСНДС"	, "СуммаСНДСДоИзменения");
	
	Индекс = 0;
	Пока Индекс < ТабличнаяЧасть.Количество() Цикл 
		
		Стр = ТабличнаяЧасть[Индекс];
		
		ЕстьИзменения = Ложь;
		Для Каждого ИменаПолей Из КорректируемыеПоля Цикл 
			
			ЗначениеТекущее		 = Стр[ИменаПолей.Ключ];
			ЗначениеДоИзменения	 = Стр[ИменаПолей.Значение];
			
			Если ЗначениеТекущее <> ЗначениеДоИзменения Тогда 
				ЕстьИзменения = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЕстьИзменения Тогда 
			ТабличнаяЧасть.Удалить(Индекс);
		Иначе 
			Индекс = Индекс + 1; 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьОтмененныеСтрокиИсправительногоДокумента(Шапка, ТабличнаяЧасть)
	
	Если Шапка.ВидОперации <> Перечисления.ВидыОперацийИсправленияПоступленияРеализации.ИсправлениеОшибки Тогда 
		Возврат;
	КонецЕсли;
	
	Индекс = 0;
	Пока Индекс < ТабличнаяЧасть.Количество() Цикл 
		
		Стр = ТабличнаяЧасть[Индекс];
		
		Если Стр.СуммаСНДС = 0 И Стр.СуммаСНДСДоИзменения = 0 Тогда 
			ТабличнаяЧасть.Удалить(Индекс);
		Иначе 
			Индекс = Индекс + 1; 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтрокиОтчетКомиссионераОтДругихСчетФактур(Шапка, ТабличнаяЧасть)
	
	Если НЕ ЭтоСчетФактура(Шапка.ОписаниеДокумента.Ссылка) Тогда 
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтчетКомиссионераПокупатели.КлючСвязи КАК КлючСвязи,
		|	ОтчетКомиссионераПокупатели.СчетФактура КАК СчетФактура
		|ИЗ
		|	Документ.СчетФактура КАК ДокументСчетФактура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомиссионера.Покупатели КАК ОтчетКомиссионераПокупатели
		|		ПО ДокументСчетФактура.Ссылка = ОтчетКомиссионераПокупатели.СчетФактура
		|ГДЕ
		|	ДокументСчетФактура.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Шапка.ОписаниеДокумента.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
	
		ТаблицаСФ = РезультатЗапроса.Выгрузить();
		ТаблицаСФ.Свернуть("КлючСвязи");
		СписокРазрешенныхКлючей = ТаблицаСФ.ВыгрузитьКолонку("КлючСвязи");
		
		Индекс = 0;
		Пока Индекс < ТабличнаяЧасть.Количество() Цикл 
			
			Стр = ТабличнаяЧасть[Индекс];
			
			Если СписокРазрешенныхКлючей.Найти(Стр.КлючСвязи) = Неопределено Тогда 
				ТабличнаяЧасть.Удалить(Индекс);
			Иначе 
				Индекс = Индекс + 1; 
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

Функция РеквизитыКорректировкиРеализации(СсылкаНаОбъект, ЭтоИсправление)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Номер");
	Реквизиты.Вставить("Дата");
	Реквизиты.Вставить("НомерИсходногоДокумента");
	Реквизиты.Вставить("ДатаИсходногоДокумента");
	Реквизиты.Вставить("НомерИсправленияИсходногоДокумента");
	Реквизиты.Вставить("ДатаИсправленияИсходногоДокумента");
	
	Если ЭтоИсправление Тогда
		
		// Переопределим номер документа
		Реквизиты.Номер	 = "НомерИсправляемогоКорректировочногоДокумента";
		Реквизиты.Дата	 = "ДатаИсправляемогоКорректировочногоДокумента";
		
		// И добавим получение номера и даты исправления
		Реквизиты.Вставить("НомерИсправления");
		Реквизиты.Вставить("ДатаИсправления", "Дата");
		
	КонецЕсли;
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, Реквизиты);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыКорректировочногоСчетаФактуры(СсылкаНаОбъект, ЭтоИсправление)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	&ПолеНомерДокумента КАК Номер,
	|	&ПолеДатаДокумента КАК Дата,
	|	&ПолеНомерИсправления КАК НомерИсправления,
	|	&ПолеДатаИсправления КАК ДатаИсправления,
	|	&ПолеНомерНаПечать КАК НомерНаПечать,
	|	&ПолеОтредактированНомерСчетаФактуры КАК ОтредактированНомерСчетаФактуры,
	|	Таблица.УчитыватьИсправлениеИсходногоДокумента КАК УчитыватьИсправлениеИсходногоДокумента,
	|	Таблица.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
	|	Таблица.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
	|	Таблица.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
	|	Таблица.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
	|	Таблица.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетФактура.ДокументыОснования КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &СсылкаНаОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ПолеНомерДокумента = "Таблица.Ссылка.Номер";
	ПолеДатаДокумента = "Таблица.Ссылка.Дата";
	ПолеНомерИсправления = "НЕОПРЕДЕЛЕНО";
	ПолеДатаИсправления	 = "НЕОПРЕДЕЛЕНО";
	ПолеНомерНаПечать = "НЕОПРЕДЕЛЕНО";
	ПолеОтредактированНомерСчетаФактуры	 = "ЛОЖЬ";
	
	Если ЭтоИсправление Тогда
		
		ПолеНомерДокумента	 = "Таблица.Ссылка.НомерИсправляемогоКорректировочногоДокумента";
		ПолеДатаДокумента	 = "Таблица.Ссылка.ДатаИсправляемогоКорректировочногоДокумента";
		ПолеНомерИсправления = "Таблица.Ссылка.НомерИсправления";
		ПолеДатаИсправления	 = "Таблица.Ссылка.Дата";
		
	КонецЕсли;
	
	Если ИспользуетсяНомерНаПечатьСчетаФактуры() Тогда
		ПолеНомерНаПечать = "Таблица.Ссылка.НомерНаПечать";
		ПолеОтредактированНомерСчетаФактуры	 = "Таблица.Ссылка.ОтредактированНомерСчетаФактуры";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНомерДокумента"	, ПолеНомерДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДатаДокумента" 	, ПолеДатаДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНомерИсправления", ПолеНомерИсправления);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеДатаИсправления"	, ПолеДатаИсправления);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНомерНаПечать"	, ПолеНомерНаПечать);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОтредактированНомерСчетаФактуры"	, ПолеОтредактированНомерСчетаФактуры);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Новый Структура;
	
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает шаблон текста для объединения запросов.
//
// Параметры:
//  ТолькоНовые - Булево - Истина, если из результата присоединяемого запроса нужно получить
//                         только те строки, которых еще нет в общем результате.
// 
// Возвращаемое значение:
//   Строка
//
Функция РазделительОбъединенияЗапросов(ТолькоНовые = Ложь)
	
	Если ТолькоНовые Тогда
		
		Результат = "
		|
		|ОБЪЕДИНИТЬ
		|
		|";
		
	Иначе
		
		Результат = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазделительПакетаЗапросов()
	
	Возврат
	"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
КонецФункции

// Добавляет в ТабличнаяЧасть строку с услугой доставки,
// информация о которой хранится в реквизитах документа информационной базы
//
// Параметры:
//  Шапка			 - Структура		 - см. Модуль_ИнтеграцияУниверсальный.ДанныеШапки.
//  ТабличнаяЧасть	 - ТаблицаЗначений	 - см. Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей.
//
Процедура ДополнитьДаннымиПоДоставке(ТабличнаяЧасть, Шапка)
	
	СсылкаНаДокумент = Шапка.ОписаниеДокумента.Ссылка;
	
	Если Не ЕстьРеквизитыДоставки(СсылкаНаДокумент) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДоставки = ВыбратьДанныеДоставкиИзШапкиДокумента(Шапка.ОписаниеДокумента);
	
	Если ДанныеДоставки.ЕстьДоставка Тогда
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеДоставки);
		
		НоваяСтрока.ЭтоУслуга					= Истина;
		НоваяСтрока.ПризнакТоварРаботаУслуга 	= "Service";
		НоваяСтрока.НомерСтроки 				= ТабличнаяЧасть.Количество();
		НоваяСтрока.ИмяТабличнойЧасти			= ИмяТабличнойЧастиДоставка();
		
	КонецЕсли;
	
КонецПроцедуры

// Проверяет наличие у документа реквизитов доставки
//
// Параметры:
//  СсылкаНаДокумент - Ссылка - ссылка на проверяемый документ
// 
// Возвращаемое значение:
//  Булево 
//
Функция ЕстьРеквизитыДоставки(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеДокумента, "НоменклатураДоставки") Тогда 
		
		Результат = Истина;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Проверяет наличие у документа реквизитов способа доставки
//
// Параметры:
//  СсылкаНаДокумент - Ссылка - ссылка на проверяемый документ
// 
// Возвращаемое значение:
//  Булево 
//
Функция ЕстьРеквизитыСпособаДоставки(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеДокумента, "СпособДоставки") Тогда 
		
		Результат = Истина;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Возвращает данные по услуге доставки, указанной в реквизитах (шапке) документа.
//
// Параметры:
//  ОписаниеДокумента		 - Структура 	- см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента
//  МаксНомерСтрокиТаблицы	 - Число 		- количество строк в табличной части, в которую добавляется услуга доставки
// 
// Возвращаемое значение:
//  Структура - содержит значения реквизитов доставки документа.
//				Имена ключей приведены к именам колонок табличной части (см. Модуль_ИнтеграцияУниверсальный.ДанныеТабличныхЧастей)
//				Также добавлено поле "ЕстьДоставка": Истина, если есть данные о доставке, Ложь - нет.
//
Функция ВыбратьДанныеДоставкиИзШапкиДокумента(ОписаниеДокумента)
	
	СсылкаНаДокумент = ОписаниеДокумента.Ссылка;
	
	МетаданныеДокумента 	= СсылкаНаДокумент.Метаданные();
	ИмяДокумента 			= МетаданныеДокумента.Имя; 
	
	ЭтоКорректировка 	= ОписаниеДокумента.ЭтоКорректировка;
	ЭтоИсправление 		= ОписаниеДокумента.ЭтоИсправление;
	ЕстьСпособДостаки	= ЕстьРеквизитыСпособаДоставки(СсылкаНаДокумент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_ДанныеПоДоставке(ИмяДокумента, ЭтоКорректировка, ЭтоИсправление, ЕстьСпособДостаки);
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	
	Результат = НовоеОписаниеПолейЗапросаДанныхПоДоставке();
	Результат.ЕстьДоставка = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

// Возвращает текст запроса выборки данных о доставке из реквизитов документа
//
// Параметры:
//  ИмяДокумента	 - Строка	- имя документа как оно задано в конфигураторе.
//  ЭтоКорректировка - Булево	- Истина, если документ "Корректировка реализации", в противном случае - Ложь.
//  ЭтоИсправление	 - Булево	- Истина, если вид 
// 
// Возвращаемое значение:
//  Строка - строка текста запроса по реквизитам документов 
//
Функция ТекстЗапроса_ДанныеПоДоставке(ИмяДокумента, ЭтоКорректировка = Ложь, ЭтоИсправление = Ложь, ЕстьСпособДостаки = Ложь)
	
	ОписаниеПолей = НовоеОписаниеПолейЗапросаДанныхПоДоставке();
	
	ОписаниеПолей.Номенклатура 				= "НоменклатураДоставки";
	ОписаниеПолей.НоменклатураКод 			= "НоменклатураДоставки.Код";
	ОписаниеПолей.НоменклатураПредставление = "НоменклатураДоставки.НаименованиеПолное";
	
	ОписаниеПолей.ЕдиницаИзмерения 			= "НоменклатураДоставки.ЕдиницаИзмерения";
	ОписаниеПолей.ЕдиницаИзмеренияКод 		= "НоменклатураДоставки.ЕдиницаИзмерения.Код";

	ОписаниеПолей.СтавкаНДС					= "СтавкаНДСДоставки";
	
	Если ЭтоКорректировка Тогда
		
		ПолеОтменаДоставки = "ОтменаДоставки";
		
		Если Не ЕстьФункцияОтменыДоставки() Тогда
			ПолеОтменаДоставки = "СтоимостьДоставки = 0";
		КонецЕсли;
		
		ШаблонПоляНовыеЗначения = 
		"ВЫБОР
		|	КОГДА " + ПолеОтменаДоставки + "
		|		ТОГДА 0
		|	ИНАЧЕ %1
		|КОНЕЦ";
		
		ОписаниеПолей.Количество 	= СтрШаблон(ШаблонПоляНовыеЗначения, "1");
		ОписаниеПолей.Цена 			= СтрШаблон(ШаблонПоляНовыеЗначения, "СтоимостьДоставки");
		ОписаниеПолей.Сумма 		= СтрШаблон(ШаблонПоляНовыеЗначения, "СтоимостьДоставки");
		ОписаниеПолей.СуммаНДС 		= СтрШаблон(ШаблонПоляНовыеЗначения, "СуммаНДСДоставки");
		ОписаниеПолей.СуммаСНДС 	= СтрШаблон(ШаблонПоляНовыеЗначения, "СтоимостьДоставки");

		ШаблонПоляЕдиницаИзмеренияДоИзменения =
		"ВЫБОР
		|	КОГДА ИсправляемыйДокументРеализации ССЫЛКА Документ.РасходнаяНакладная
		|			ИЛИ ИсправляемыйДокументРеализации ССЫЛКА Документ.КорректировкаРеализации
		|		ТОГДА ИсправляемыйДокументРеализации.НоменклатураДоставки.%1
		|	ИНАЧЕ НЕОПРЕДЕЛЕНО
		|КОНЕЦ";
		
		ОписаниеПолей.ЕдиницаИзмеренияДоИзменения 		= СтрШаблон(ШаблонПоляЕдиницаИзмеренияДоИзменения, "ЕдиницаИзмерения");
		ОписаниеПолей.ЕдиницаИзмеренияДоИзмененияКод 	= СтрШаблон(ШаблонПоляЕдиницаИзмеренияДоИзменения, "ЕдиницаИзмерения.Код");

		ОписаниеПолей.КоличествоДоИзменения = 
		"ВЫБОР
		|	КОГДА ИсправляемыйДокументРеализации.НоменклатураДоставки = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА 0
		|	ИНАЧЕ 1
		|КОНЕЦ";

		Если ЭтоИсправление Тогда
			ПостфиксИмениПоля = "ДоКорректировки";
		Иначе
			ПостфиксИмениПоля = "ДоИзменения";
		КонецЕсли;
		
		ОписаниеПолей.ЦенаДоИзменения 		= СтрШаблон("СтоимостьДоставки%1", ПостфиксИмениПоля);
		ОписаниеПолей.СуммаДоИзменения 		= СтрШаблон("СтоимостьДоставки%1", ПостфиксИмениПоля);
		ОписаниеПолей.СтавкаНДСДоИзменения 	= СтрШаблон("СтавкаНДСДоставки%1", ПостфиксИмениПоля);
		ОписаниеПолей.СуммаНДСДоИзменения 	= СтрШаблон("СуммаНДСДоставки%1", ПостфиксИмениПоля);
		ОписаниеПолей.СуммаСНДСДоИзменения 	= СтрШаблон("СтоимостьДоставки%1", ПостфиксИмениПоля);
		
		ОписаниеПолей.ЕстьДоставка =
		"ВЫБОР
		|	КОГДА СтоимостьДоставки = 0
		|		И СтоимостьДоставкиДоИзменения = 0
		|		И СтоимостьДоставкиДоКорректировки = 0
		|		И НоменклатураДоставки = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		И ЕСТЬNULL(ИсправляемыйДокументРеализации.НоменклатураДоставки, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА ЛОЖЬ
		|	ИНАЧЕ ИСТИНА
		|КОНЕЦ";
		
	Иначе
		
		ОписаниеПолей.ЕдиницаИзмеренияДоИзменения 		= "НоменклатураДоставки.ЕдиницаИзмерения";
		ОписаниеПолей.ЕдиницаИзмеренияДоИзмененияКод 	= "НоменклатураДоставки.ЕдиницаИзмерения.Код";
		
		ОписаниеПолей.Количество 	= "1";
		ОписаниеПолей.СуммаНДС 		= "СуммаНДСДоставки";
		ОписаниеПолей.СуммаСНДС 	= "СтоимостьДоставки";
		ОписаниеПолей.Цена 			= "СтоимостьДоставки";
		ОписаниеПолей.Сумма 		= "СтоимостьДоставки";
		
		ЗначениеОтсутствующихПолей = "НЕОПРЕДЕЛЕНО";
		
		ОписаниеПолей.КоличествоДоИзменения = ЗначениеОтсутствующихПолей;
		ОписаниеПолей.ЦенаДоИзменения 		= ЗначениеОтсутствующихПолей;
		ОписаниеПолей.СуммаДоИзменения 		= ЗначениеОтсутствующихПолей;
		ОписаниеПолей.СтавкаНДСДоИзменения 	= ЗначениеОтсутствующихПолей;
		ОписаниеПолей.СуммаНДСДоИзменения 	= ЗначениеОтсутствующихПолей;
		ОписаниеПолей.СуммаСНДСДоИзменения 	= ЗначениеОтсутствующихПолей;
		
		ОписаниеПолей.ЕстьДоставка =
		"ВЫБОР
		|	КОГДА НоменклатураДоставки = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА ЛОЖЬ
		|	ИНАЧЕ ИСТИНА
		|КОНЕЦ";
		
	КонецЕсли;
	
	Если ЕстьСпособДостаки Тогда
		
		ОписаниеПолей.ЕстьДоставка = ОписаниеПолей.ЕстьДоставка + 
		"	И (СпособДоставки <> ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ПустаяСсылка))
		|	И (СпособДоставки <> ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Самовывоз))";
		
	КонецЕсли; 
	
	ТекстЗапроса = "";
	
	Для Каждого ЭлементОписания Из ОписаниеПолей Цикл
		
		ВыражениеПоляЗапроса = ЭлементОписания.Значение;
		ПсевдонимПоляЗапроса = ЭлементОписания.Ключ;
		
		ВыражениеЗапроса = ВыражениеПоляЗапроса + " КАК " + ПсевдонимПоляЗапроса;
		
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			ТекстЗапроса = "ВЫБРАТЬ " + ВыражениеЗапроса;
		Иначе
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "," + ВыражениеЗапроса;	
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ИЗ
	|	Документ." + ИмяДокумента + "
	|ГДЕ
	|	Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает описание полей запроса данных по доставке
//
// Возвращаемое значение:
//  Структура - содержит описание полей для формирования текста запросаэ
//			  - в качестве ключа передается псевдоним поля запроса, а в качестве
//              значения (опционально) фактическое имя поля в таблице или выражение на языке запроса. 
