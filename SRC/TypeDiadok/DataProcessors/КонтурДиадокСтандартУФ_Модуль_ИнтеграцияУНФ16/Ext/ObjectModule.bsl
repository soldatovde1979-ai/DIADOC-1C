Функция СформироватьДанныеДляПечати(СсылкаНаОбъект, ЭтоКСФ)
	
	ВалютаРегламентированногоУчета= ВалютаРегламентированногоУчета();
	
	//сформируем список документов-оснований
	ЭтоСФ = ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактура");
	ЭтоСФНаАванс = СчетФактураНаАванс(СсылкаНаОбъект);
	
	ДанныеДляПечати	 = ДанныеШапки(СсылкаНаОбъект); // Шапку всегда заполняем по переданному объекту
	ДанныеТЧ		 = ДанныеТабличныхЧастей(ДанныеДляПечати);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеДляПечати, ДанныеТЧ);
	
	Если Не ЗначениеЗаполнено(ДанныеТЧ) Тогда 
		
		ОписаниеОш = НСтр("ru = 'Нет данных по товарной части документа %1'");
		ОписаниеОш = СтрЗаменить(ОписаниеОш, "%1", Строка(СсылкаНаОбъект));
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	Если ЭтоСФ Тогда
		ДанныеДляПечати.Вставить("СФНаАванс", ЭтоСФНаАванс);
	КонецЕсли;
	
	//формируем ТЧ
	ДанныеДляПечати.Вставить("ТабличнаяЧасть", ТаблицаЗначений_2_МассивСтруктур(ДанныеТЧ));
				
	//формируем список ПРС
	Запрос= Новый Запрос;
	
	Запрос.Текст= "ВЫБРАТЬ
		|	ПРС.ДатаПлатежноРасчетногоДокумента 	КАК ДатаПлатежноРасчетногоДокумента,
		|	ПРС.НомерПлатежноРасчетногоДокумента 	КАК НомерПлатежноРасчетногоДокумента
		|ИЗ
		|	Документ.СчетФактура.ДатаНомерДокументовОплаты КАК ПРС
		|ГДЕ
		|	ПРС.Ссылка = &Ссылка
		|	И ПРС.НомерПлатежноРасчетногоДокумента 	<> """"
		|	И ПРС.ДатаПлатежноРасчетногоДокумента	<> ДАТАВРЕМЯ(1, 1, 1)";
		
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	ТаблицаДатаНомерДокументовОплаты= Запрос.Выполнить().Выгрузить();
	
	ДанныеДляПечати.Вставить("ДатаНомерДокументовОплаты", ТаблицаЗначений_2_МассивСтруктур(ТаблицаДатаНомерДокументовОплаты));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

// Возвращает информацию о стране происхождения товара в виде структуры.
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - Строка табличной части Товары.
//
// Возвращаемое значение:
//   Структура - Сведения о стране происхождения товара для поля StructedAdditionalInfo:
//      * СтранаПроисхождения - СправочникСсылка.СтраныМира - Страна происхождения товара.
//      * НомерГТД            - СправочникСсылка.НомераГТД - Номер грузовой таможенной декларации.
//
Функция КоллекцияСведенийОСтранеПроисхождения(СтрокаДанных)
	
	Результат = Новый Структура;
	Результат.Вставить("СтранаПроисхождения"	, СтрокаДанных.СтранаПроисхождения);
	Результат.Вставить("НомерГТД"				, СтрокаДанных.НомерГТД);
	
	Возврат Результат;

КонецФункции

