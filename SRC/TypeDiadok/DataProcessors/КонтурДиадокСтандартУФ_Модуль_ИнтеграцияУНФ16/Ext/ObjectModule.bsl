	|		ПО Документ.Ссылка = СтатусОтправляемыхВПФ.Объект
	|			И (СтатусОтправляемыхВПФ.Свойство = &СвойствоДокументаСтатусОтправляемыхВПФ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПД_СЧФДОП_ДокументыОснования КАК УПД_СЧФДОП_ДокументыОснования
	|		ПО Документ.Ссылка = УПД_СЧФДОП_ДокументыОснования.ДокументОснование
	|ГДЕ
	|	УПД_СЧФДОП_ДокументыОснования.ДокументОснование ЕСТЬ NULL
	|	И (ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|			ИЛИ ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") ПОДОБНО ""%[НУ]%"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Основная.Документ КАК Документ,
	|	ИСТИНА КАК ЕстьТовары,
	|	ЛОЖЬ КАК ЕстьУслуги,
	|	СУММА(ТЧ.СуммаНДС) КАК СуммаНДС
	|ПОМЕСТИТЬ СуммаНДСЗначение
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетОПереработке.Продукция КАК ТЧ
	|		ПО ВТ_Основная.Документ = ТЧ.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Основная.Документ";
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + ТекстЗапросаВременнаяТаблица_ЕстьСЧФ();
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВТ_Основная.Заказ КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_Накладные_ОтчетОПереработке
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|ГДЕ
	|	ВТ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Заказ
	|	И НЕ ВТ_Основная.Заказ В (&ПустыеЗначенияЗаказ)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ,
	|	ВТ_Основная.Документ
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	&ВидыЭД_ТоварнаяНакладная КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.Организация КАК Организация,
	|	ВТ_Основная.Контрагент КАК Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта КАК Валюта,
	|	ВТ_Основная.ID КАК ID_,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен КАК Проведен,
	|	ВТ_Основная.Дата КАК Дата,
	|	ВТ_Основная.Номер КАК Номер,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДС, 0) КАК СуммаНДСТовары,
	|	0 КАК СуммаНДСУслуги,
	|	""ОтчетОПереработке"" КАК Тип,
	|	&ФункцияДокумента КАК ФункцияУПД
	|ПОМЕСТИТЬ Накладные_ОтчетОПереработке
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьСЧФ КАК ВТ_ЕстьСЧФ
	|		ПО ВТ_Основная.Документ = ВТ_ЕстьСЧФ.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммаНДСЗначение КАК СуммаНДСЗначение
	|		ПО ВТ_Основная.Документ = СуммаНДСЗначение.Документ
	|ГДЕ
	|	(ВТ_ЕстьСЧФ.Документ ЕСТЬ НЕ NULL 
	|			ИЛИ ВТ_Основная.ФормироватьУПД <> &КлючНастройки_СЧФДОП
	|			ИЛИ ВТ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|				И ЕСТЬNULL(СуммаНДСЗначение.СуммаНДС, 0) = 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЕстьСЧФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммаНДСЗначение";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФункцияДокумента", ТекстЗапроса_ФункцияПервичногоДокумента("ВТ_Основная"));
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПустыеЗначенияЗаказ", ПустыеЗначенияРеквизита("Документ.ОтчетОПереработке.Реквизит.ЗаказПокупателя"));
	
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ПустыеЗначенияЗаказ");
	
	МассивВременныхТаблиц.Добавить("Накладные_ОтчетОПереработке");
	МассивВременныхТаблиц.Добавить("Связь_Накладные_ОтчетОПереработке");
	
КонецПроцедуры

Процедура ПодготовитьВТ_СЧФ_Основная(Запрос, МассивВременныхТаблиц)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Документ.Ссылка 			КАК Документ,
	|	&ЭтоКорректировка КАК ЭтоКорректировка,
	|	&ЭтоИсправление КАК ЭтоИсправление,
	|	&ЭтоАванс КАК ЭтоАванс,
	|	Документ.Организация 		КАК Организация,
	|	Документ.Контрагент 		КАК Контрагент,
	|	&СуммаДокумента КАК СуммаДокументаЗначение,
	|	Документ.ВалютаДокумента 	КАК Валюта,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") 	КАК ID,
	|	"""" 						КАК СостояниеОтправкиДополнительныхВПФ,
	|	Документ.Проведен 			КАК Проведен,
	|	Документ.Дата 				КАК Дата,
	|	Документ.Номер 				КАК Номер,
	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД,
	|	НастройкиЭДО.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиЭДО.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.СчетФактура КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|ГДЕ
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_Основная.*,
	|	ДокументыОснования.ДокументОснование,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ДокументОснованиеID
	|ПОМЕСТИТЬ ДанныеДокументаИДокументыОснования
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура.ДокументыОснования КАК ДокументыОснования
	|		ПО ВТ_Основная.Документ = ДокументыОснования.Ссылка
	|			И ДокументыОснования.ДокументОснование <> НЕОПРЕДЕЛЕНО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (ДокументыОснования.ДокументОснование = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС,
	|	""СчетФактураВыданный"" КАК Тип
	|ПОМЕСТИТЬ СуммыДокОснованийЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		Запасы.СуммаНДС КАК СуммаНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная.Запасы КАК Запасы
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Запасы.Ссылка
	|";
	
	Если НЕ Метаданные.Документы.Найти("КорректировкаРеализации") = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + РазделительОбъединенияЗапросов() +
		"	ВЫБРАТЬ
		|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
		|		Запасы.СуммаНДС КАК СуммаНДС
		|	ИЗ
		|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.Запасы КАК Запасы
		|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Запасы.Ссылка";
		
	КонецЕсли;
	
	Если НЕ Метаданные.Документы.Найти("ОтчетОПереработке") = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + РазделительОбъединенияЗапросов() +
		"	ВЫБРАТЬ
		|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
		|		Запасы.СуммаНДС КАК СуммаНДС
		|	ИЗ
		|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетОПереработке.Продукция КАК Запасы
		|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Запасы.Ссылка";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + РазделительОбъединенияЗапросов() +
	"	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		РаботыИУслуги.СуммаНДС КАК СуммаНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот.РаботыИУслуги КАК РаботыИУслуги
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = РаботыИУслуги.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ";
	
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИДокументыОснования.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_КорректировочныйСчетФактура
	|		ИНАЧЕ &ВидыЭД_СчетФактура
	|	КОНЕЦ КАК ВидЭД,
	|	ДанныеДокументаИДокументыОснования.ЭтоИсправление КАК ЭтоИсправление,
	|	ДанныеДокументаИДокументыОснования.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ДанныеДокументаИДокументыОснования.ЭтоАванс КАК ЭтоАванс,
	|	ДанныеДокументаИДокументыОснования.Организация КАК Организация,
	|	ДанныеДокументаИДокументыОснования.Контрагент КАК Контрагент,
	|	ДанныеДокументаИДокументыОснования.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	ДанныеДокументаИДокументыОснования.Валюта КАК Валюта,
	|	ДанныеДокументаИДокументыОснования.ID КАК ID_,
	|	ДанныеДокументаИДокументыОснования.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ДанныеДокументаИДокументыОснования.Проведен КАК Проведен,
	|	ДанныеДокументаИДокументыОснования.Дата КАК Дата,
	|	ДанныеДокументаИДокументыОснования.Номер КАК Номер,
	|	ЕСТЬNULL(СуммыДокОснованийЗначение.СуммаНДС, 0) КАК СуммаНДСТовары,
	|	0 КАК СуммаНДСУслуги,
	|	""СчетФактураВыданный"" КАК Тип,
	|	ДанныеДокументаИДокументыОснования.ФормироватьУПД КАК ФормироватьУПД,
	|	ДанныеДокументаИДокументыОснования.ДокументОснование КАК ДокументОснование,
	|	ДанныеДокументаИДокументыОснования.ДокументОснованиеID КАК ДокументОснованиеID,
	|	ДанныеДокументаИДокументыОснования.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета
	|ПОМЕСТИТЬ СЧФ_Основная
	|ИЗ
	|	ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыДокОснованийЗначение КАК СуммыДокОснованийЗначение
	|		ПО ДанныеДокументаИДокументыОснования.Документ = СуммыДокОснованийЗначение.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДанныеДокументаИДокументыОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммыДокОснованийЗначение";
	
	// До какой-то версии в реквизите "СуммаДокумента" была сумма с НДС.
	// Позднее был добавлен реквизит "СуммаНДСДокумента", а из суммы документа исключили сумму НДС.
	ВыражениеСумма = "Документ.СуммаДокумента + Документ.СуммаНДСДокумента";
	Если Не МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактура.Реквизит.СуммаНДСДокумента") Тогда 
		ВыражениеСумма = "Документ.СуммаДокумента";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаДокумента", ВыражениеСумма);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоАванс", ТекстЗапроса_СчетФактура_ЭтоАванс());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоИсправление", ТекстЗапроса_СчетФактура_ЭтоИсправление());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоКорректировка", ТекстЗапроса_СчетФактура_ЭтоКорректировка());
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
	
	ПодготовитьВТ_Связь_СчетаФактуры(Запрос, МассивВременныхТаблиц);
	
КонецПроцедуры

Процедура ПодготовитьВТ_Связь_СчетаФактуры(Запрос, МассивВременныхТаблиц)
	
	Разделитель					 = РазделительОбъединенияЗапросов(Истина);
	ЕстьОтчетОПереработке		 = СуществуетОбъектМетаданных("Документ.ОтчетОПереработке");
	ЕстьКорректировкаРеализации	 = СуществуетОбъектМетаданных("Документ.КорректировкаРеализации");
	
	ТекстЗапроса =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СЧФ_Основная.Документ КАК Документ,
	|	СчетНаОплату.Ссылка КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_СчетаФактуры
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетНаОплату КАК СчетНаОплату
	|		ПО СЧФ_Основная.ДокументОснование = СчетНаОплату.ДокументОснование
	|ГДЕ
	|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Счет
	|	И НЕ СЧФ_Основная.ДокументОснование В (&ПустыеЗначенияДокументОснованиеСЧФ)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	РасходнаяНакладная.ДокументОснование
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РасходнаяНакладная
	|		ПО СЧФ_Основная.ДокументОснование = РасходнаяНакладная.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	СЧФ_Основная.ДокументОснование
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	НЕ СЧФ_Основная.ДокументОснование В (&ПустыеЗначенияДокументОснованиеСЧФ)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	РасходнаяНакладная.Заказ
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РасходнаяНакладная
	|		ПО СЧФ_Основная.ДокументОснование = РасходнаяНакладная.Ссылка
	|ГДЕ
	|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Заказ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	АктВыполненныхРабот.ЗаказПокупателя
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот КАК АктВыполненныхРабот
	|		ПО СЧФ_Основная.ДокументОснование = АктВыполненныхРабот.Ссылка
	|ГДЕ
	|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Заказ";
	
	Если ЕстьКорректировкаРеализации Тогда
		
		ТекстЗапроса = ТекстЗапроса + Разделитель +
		
		"ВЫБРАТЬ
		|	СЧФ_Основная.Документ КАК Документ,
		|	КорректировкаРеализации.Заказ КАК Заказ
		|ИЗ
		|	СЧФ_Основная КАК СЧФ_Основная
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК КорректировкаРеализации
		|		ПО СЧФ_Основная.ДокументОснование = КорректировкаРеализации.Ссылка
		|ГДЕ
		|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Заказ";
		
	КонецЕсли;
	
	Если ЕстьОтчетОПереработке Тогда
		
		ТекстЗапроса = ТекстЗапроса + Разделитель +
		
		"ВЫБРАТЬ
		|	СЧФ_Основная.Документ КАК Документ,
		|	ОтчетОПереработке.ЗаказПокупателя КАК ЗаказПокупателя
		|ИЗ
		|	СЧФ_Основная КАК СЧФ_Основная
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетОПереработке КАК ОтчетОПереработке
		|		ПО СЧФ_Основная.ДокументОснование = ОтчетОПереработке.Ссылка
		|ГДЕ
		|	СЧФ_Основная.ОснованиеФормированияСчета = &ОснованиеСчета_Заказ";
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснованиеСЧФ", ПустыеЗначенияРеквизита(
	"Документ.СчетФактура.ТабличнаяЧасть.ДокументыОснования.Реквизит.ДокументОснование"));
	
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ПустыеЗначенияДокументОснованиеСЧФ");
	
	МассивВременныхТаблиц.Добавить("Связь_СчетаФактуры");
	
КонецПроцедуры

Процедура ПодготовитьВТ_УПД_СЧФДОП(Запрос, МассивВременныхТаблиц, ТипыДокументов)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СЧФ_Основная.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_ПодходящиеСЧФ
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	СЧФ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|	И НЕ СЧФ_Основная.ЭтоКорректировка
	|
	|СГРУППИРОВАТЬ ПО
	|	СЧФ_Основная.Документ
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СЧФ_Основная.ID_ = СЧФ_Основная.ДокументОснованиеID
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.Документ КАК Документ,
	|	&ВидыЭД_СчетФактура КАК ВидЭД,
	|	СЧФ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	СЧФ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	СЧФ_Основная.Организация КАК Организация,
	|	СЧФ_Основная.Контрагент КАК Контрагент,
	|	СЧФ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	СЧФ_Основная.СуммаНДСТовары КАК СуммаНДСТовары,
	|	СЧФ_Основная.СуммаНДСУслуги КАК СуммаНДСУслуги,
	|	СЧФ_Основная.Валюта КАК Валюта,
	|	СЧФ_Основная.Проведен КАК Проведен,
	|	СЧФ_Основная.Дата КАК Дата,
	|	СЧФ_Основная.Номер КАК Номер,
	|	СЧФ_Основная.ID_ КАК ID_,
	|	ВЫБОР
	|		КОГДА СЧФ_Основная.ЭтоАванс
	|			ТОГДА &ФункцияЭД_СЧФ
	|		ИНАЧЕ &ФункцияЭД_СЧФДОП
	|	КОНЕЦ КАК ФункцияУПД,
	|	""СчетФактураВыданный"" КАК Тип,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	ЛОЖЬ КАК ЭтоСчет
	|ПОМЕСТИТЬ УПД_СЧФДОП
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
	|		ПО ВТ_ПодходящиеСЧФ.Документ = СЧФ_Основная.Документ
	|ГДЕ
	|	НЕ СЧФ_Основная.ЭтоАванс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ УПД_СЧФДОП_ДокументыОснования
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
	|		ПО ВТ_ПодходящиеСЧФ.Документ = СЧФ_Основная.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПодходящиеСЧФ";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "5" Тогда
		МассивВременныхТаблиц.Добавить("УПД_СЧФДОП");
	КонецЕсли;
	
КонецПроцедуры

