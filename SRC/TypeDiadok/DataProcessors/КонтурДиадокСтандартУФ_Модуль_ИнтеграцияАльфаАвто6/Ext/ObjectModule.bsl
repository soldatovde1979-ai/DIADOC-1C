		Прото.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОбУчастниках155(Прото, Шапка, ЕстьТовары)
	
	ДатаДокумента = Шапка.Дата;
	
	Продавец = Шапка.ГоловнаяОрганизация;
	СчетПродавца = Шапка.БанковскийСчетОрганизации;
	Грузоотправитель = Шапка.Грузоотправитель;
	РеквизитыПродавца = МенеджерИнтеграции_РеквизитыЮрФизЛица(Продавец, ДатаДокумента, СчетПродавца, Грузоотправитель);
	ЗаполнитьИнформациюОбОрганизации155(Прото.Seller, РеквизитыПродавца, Продавец, ДатаДокумента);
	
	Покупатель = Шапка.ГоловнойКонтрагент;
	СчетПокупателя = Шапка.БанковскийСчетКонтрагента;
	РеквизитыПокупателя = МенеджерИнтеграции_РеквизитыЮрФизЛица(Покупатель, ДатаДокумента, СчетПокупателя);
	ЗаполнитьИнформациюОбОрганизации155(Прото.Buyer, РеквизитыПокупателя, Покупатель, ДатаДокумента);
	
	ЗаполнитьКППДляПокупателяОбособленноеПодразделение(Прото.Buyer, Шапка);
	
	Если ЕстьТовары Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Шапка, "ГрузоотправительИзДанныхДляПечати") Тогда
			ГрузоотправительИзДанныхДляПечати = Шапка.ГрузоотправительИзДанныхДляПечати;
		Иначе
			ГрузоотправительИзДанныхДляПечати = Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Грузоотправитель) И ГрузоотправительИзДанныхДляПечати Тогда
			
			Прото.Shipper.SameAsSeller = Ложь;
			СчетГрузоотправителя = Неопределено;
			РеквизитыГрузоотправителя = МенеджерИнтеграции_РеквизитыЮрФизЛица(Грузоотправитель, ДатаДокумента, СчетГрузоотправителя);
			
			Если НЕ ЗначениеЗаполнено(РеквизитыГрузоотправителя.ФактическийАдрес)
				И НЕ ЗначениеЗаполнено(РеквизитыГрузоотправителя.ЗначенияПолейФактическийАдрес) Тогда
				
				РеквизитыГрузоотправителя.ФактическийАдрес = РеквизитыПродавца.ФактическийАдрес;
				РеквизитыГрузоотправителя.ЗначенияПолейФактическийАдрес = РеквизитыПродавца.ЗначенияПолейФактическийАдрес;
				
			КонецЕсли;
			
			ЗаполнитьИнформациюОГрузоотправителеГрузополучателе(Прото.Shipper.OrganizationInfo, РеквизитыГрузоотправителя, Грузоотправитель);
			
		Иначе
			
			Прото.Shipper.SameAsSeller = Истина;
			
		КонецЕсли;
		
		Грузополучатель = Шапка.Грузополучатель;
		Если Не ЗначениеЗаполнено(Грузополучатель) Тогда
			Грузополучатель = Покупатель;
		КонецЕсли;
		
		СчетГрузополучателя = Неопределено;
		РеквизитыГрузополучателя = МенеджерИнтеграции_РеквизитыЮрФизЛица(Грузополучатель, ДатаДокумента, СчетГрузополучателя);
		ЗаполнитьИнформациюОГрузоотправителеГрузополучателе(Прото.Consignee, РеквизитыГрузополучателя, Грузополучатель);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОрганизацияОбособленногоПодразделения(ОбособленноеПодразделение)
	
	Результат = ОбособленноеПодразделение;
	
	Если ТипЗнч(ОбособленноеПодразделение) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
		Результат = ОбособленноеПодразделение.Организация;
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции


Процедура ЗаполнитьКППДляПокупателяОбособленноеПодразделение(СведенияОПокупателе, ДанныеДокумента)

	Покупатель = ДанныеДокумента.Контрагент;
	
	Если ТипЗнч(Покупатель) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Грузополучатель = ДанныеДокумента.Грузополучатель;
		
		Если Покупатель.ФормаСобственности = Перечисления.ФормыСобственности.ОбособленноеПодразделение Тогда
			
			СведенияОПокупателе.Kpp = ?(ЗначениеЗаполнено(Покупатель.КПП), Покупатель.КПП, "--");
			
		ИначеЕсли ЗначениеЗаполнено(Грузополучатель)
			И ТипЗнч(Грузополучатель) = Тип("СправочникСсылка.Контрагенты")
			И Грузополучатель.ФормаСобственности = Перечисления.ФормыСобственности.ОбособленноеПодразделение Тогда
			
			СведенияОПокупателе.Kpp = ?(ЗначениеЗаполнено(Грузополучатель.КПП), Грузополучатель.КПП, "--");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

