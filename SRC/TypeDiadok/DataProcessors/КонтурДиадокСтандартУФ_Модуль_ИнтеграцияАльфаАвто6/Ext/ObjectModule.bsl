// Вызывается из Модуль_ИнтеграцияУниверсальный.НовыйДокументИнформационнойБазы.
//
// Параметры:
//  ДокументОбъект		 - ДокументОбъект	 - новый, еще не записанный, документ-объект;
//  ДанныеЭД			 - Структура		 - содержит данные электронного документа
//                                             (см. Модуль_ИнтеграцияУниверсальный.ДанныеЭлектронногоДокумента);
//  ПараметрыЗаполнения	 - Структура		 - содержит дополнительные параметры заполнения;
//  СтандартнаяОбработка - Булево			 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриСозданииДокументаИнформационнойБазы(ДокументОбъект, ДанныеЭД, ПараметрыЗаполнения, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Если МетаданныеДокумента = Метаданные.Документы.ПоступлениеТоваров Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияТоваров(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеТоваров(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ПоступлениеАвтомобилей Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияАвтомобилей(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеАвтомобилей(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ПоступлениеДопРасходов Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПоступленияДопРасходов(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПоступлениеДопРасходов(ДокументОбъект, СтруктураЗаполнения);	
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ВозвратОтПокупателя Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияВозвратаОтПокупателя(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьВозвратОтПокупателя(ДокументОбъект, СтруктураЗаполнения);	
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.КорректировкаПоступления Тогда
		
		ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			СтруктураЗаполнения = СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьКорректировкуПоступления(ДокументОбъект, СтруктураЗаполнения);
		Иначе 
			СтруктураЗаполнения = СтруктураЗаполненияИсправленияПоступления(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьИсправлениеПоступления(ДокументОбъект, СтруктураЗаполнения);
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.КорректировкаПоступленияАвтомобилей Тогда
		
		ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			СтруктураЗаполнения = СтруктураЗаполненияКорректировкиПоступленияАвтомобилей(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьКорректировкуПоступленияАвтомобилей(ДокументОбъект, СтруктураЗаполнения);
		Иначе
			СтруктураЗаполнения = СтруктураЗаполненияИсправлениеПоступленияАвтомобилей(ДанныеЭД, ПараметрыЗаполнения);
			ЗаполнитьИсправлениеПоступленияАвтомобилей(ДокументОбъект, СтруктураЗаполнения);
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СчетФактураПолученный Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияСчетаФактурыПолученного(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьСчетФактуруПолученный(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.АктСверкиВзаиморасчетов Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияАктаСверкиВзаиморасчетов(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьАктСверкиВзаиморасчетов(ДокументОбъект, СтруктураЗаполнения);
		
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

