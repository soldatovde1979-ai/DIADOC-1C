	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД,
	|	НастройкиЭДО.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиЭДО.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.РеализацияТоваров КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК СтатусОтправляемыхВПФ
	|		ПО Документ.Ссылка = СтатусОтправляемыхВПФ.Объект
	|			И (СтатусОтправляемыхВПФ.Свойство = &СвойствоДокументаСтатусОтправляемыхВПФ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ УПД_СЧФДОП_ДокументыОснования КАК УПД_СЧФДОП_ДокументыОснования
	|		ПО Документ.Ссылка = УПД_СЧФДОП_ДокументыОснования.ДокументОснование
	|ГДЕ
	|	УПД_СЧФДОП_ДокументыОснования.ДокументОснование ЕСТЬ NULL
	|	И (ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|			ИЛИ ЕСТЬNULL(СтатусОтправляемыхВПФ.Значение, """") ПОДОБНО ""%[НУ]%"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьНДС) КАК ЕстьНДС,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьТовары) КАК ЕстьТовары,
	|	МАКСИМУМ(ВложенныйЗапрос.ЕстьУслуги) КАК ЕстьУслуги,
	|	СУММА(ВложенныйЗапрос.СуммаНДСТовары) КАК СуммаНДСТовары,
	|	СУММА(ВложенныйЗапрос.СуммаНДСУслуги) КАК СуммаНДСУслуги
	|ПОМЕСТИТЬ СуммаНДСЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_Основная.Документ КАК Документ,
	|		ВЫБОР
	|			КОГДА ТЧ.СтавкаНДС <> &Ставка_БезНДС
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНДС,
	|		ВЫБОР
	|			КОГДА НЕ ТЧ.Номенклатура.ВидНоменклатуры В (&ВидыНоменклатурыУслуги)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьТовары,
	|		ВЫБОР
	|			КОГДА ТЧ.Номенклатура.ВидНоменклатуры В (&ВидыНоменклатурыУслуги)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьУслуги,
	|		ТЧ.СуммаНДС КАК СуммаНДСТовары,
	|		0 КАК СуммаНДСУслуги
	|	ИЗ
	|		ВТ_Основная КАК ВТ_Основная
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров.Товары КАК ТЧ
	|			ПО ВТ_Основная.Документ = ТЧ.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ";
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + ТекстЗапросаВременнаяТаблица_ЕстьСЧФ();
	
	ТекстЗапроса = ТекстЗапроса + РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВТ_Основная.ДокументОснование КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_Накладные_РеализацияТоваров
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|ГДЕ
	|	НЕ ВТ_Основная.ДокументОснование В (&ПустыеЗначенияДокументОснование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ,
	|	ВТ_Основная.Документ
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(СуммаНДСЗначение.ЕстьТовары, ЛОЖЬ)
	|			ТОГДА &ВидыЭД_АктОбОказанииУслуг
	|		ИНАЧЕ &ВидыЭД_ТоварнаяНакладная
	|	КОНЕЦ КАК ВидЭД,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.Организация КАК Организация,
	|	ВТ_Основная.Контрагент КАК Контрагент,
	|	ВТ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	ВТ_Основная.Валюта КАК Валюта,
	|	ВТ_Основная.ID КАК ID_,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен КАК Проведен,
	|	ВТ_Основная.Дата КАК Дата,
	|	ВТ_Основная.Номер КАК Номер,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСТовары, 0) КАК СуммаНДСТовары,
	|	ЕСТЬNULL(СуммаНДСЗначение.СуммаНДСУслуги, 0) КАК СуммаНДСУслуги,
	|	""РеализацияТоваровУслуг"" КАК Тип,
	|	&ФункцияДокумента КАК ФункцияУПД
	|ПОМЕСТИТЬ Накладные_РеализацияТоваров
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьСЧФ КАК ВТ_ЕстьСЧФ
	|		ПО ВТ_Основная.Документ = ВТ_ЕстьСЧФ.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммаНДСЗначение КАК СуммаНДСЗначение
	|		ПО ВТ_Основная.Документ = СуммаНДСЗначение.Документ
	|ГДЕ
	|	(ВТ_ЕстьСЧФ.Документ ЕСТЬ НЕ NULL 
	|			ИЛИ НЕ ВТ_Основная.ТребуетсяСФ
	|			ИЛИ ВТ_Основная.ФормироватьУПД <> &КлючНастройки_СЧФДОП
	|			ИЛИ ВТ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|				И НЕ ЕСТЬNULL(СуммаНДСЗначение.ЕстьНДС, ЛОЖЬ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ЕстьСЧФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммаНДСЗначение";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ФункцияДокумента", ТекстЗапроса_ФункцияПервичногоДокумента("ВТ_Основная"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТребуетсяСФ", ТекстЗапроса_Реализация_ТребуетсяСчетФактура());
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ВидыНоменклатурыУслуги", ВидыНоменклатурыУслуги());
	Запрос.УстановитьПараметр("Ставка_БезНДС", МенеджерИнтеграции_СтавкаБезНДС());
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснование", ПустыеЗначенияРеквизита("Документ.РеализацияТоваров.Реквизит.ДокументОснование"));
	
	Запрос.Выполнить();
	
	МассивВременныхТаблиц.Добавить("Накладные_РеализацияТоваров");
	МассивВременныхТаблиц.Добавить("Связь_Накладные_РеализацияТоваров");
	
КонецПроцедуры

Функция ТекстЗапроса_Реализация_ТребуетсяСчетФактура(ПсевдонимТаблицы = "Документ")
	
	Результат =
	"ВЫБОР
	|	КОГДА ПсевдонимТаблицы.ДоговорВзаиморасчетов.ВидДоговора <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СКомиссионером)
	|		ТОГДА ИСТИНА
	|	ИНАЧЕ ЛОЖЬ
	|КОНЕЦ";
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ФункцияПервичногоДокумента(ПсевдонимТаблицы = "ВТ_Основная")
	
	Результат = 
	"	ВЫБОР
	|		КОГДА ПсевдонимТаблицы.ЭтоКорректировка
	|				И ПсевдонимТаблицы.ФормироватьУПД В (&КлючНастройки_СЧФДОП, &КлючНастройки_ДОП, &КлючНастройки_СЧФ_ДОП)
	|			ТОГДА &ФункцияЭД_ДИС
	|		КОГДА ПсевдонимТаблицы.ФормироватьУПД В (&КлючНастройки_СЧФДОП, &КлючНастройки_ДОП, &КлючНастройки_СЧФ_ДОП)
	|			ТОГДА &ФункцияЭД_ДОП
	|		ИНАЧЕ &ФункцияЭД_ПоУмолчанию
	|	КОНЕЦ";
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаВременнаяТаблица_ЕстьСЧФ()
	
	Результат =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Основная.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_ЕстьСЧФ
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СЧФ
	|		ПО ВТ_Основная.Документ = СЧФ.ДокументОснование
	|ГДЕ
	|	СЧФ.Ссылка ЕСТЬ НЕ NULL 
	|	И НЕ СЧФ.ПометкаУдаления
	|	И (СЧФ.Проведен
	|			ИЛИ ВТ_Основная.ОтправлятьНепроведенные = ИСТИНА)";
	
	Возврат Результат;
	
КонецФункции

Процедура ПодготовитьВТ_СЧФ_Основная(Запрос, МассивВременныхТаблиц)
	
	Поместить_ВТ_Основная =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокументов.Ссылка КАК Документ,
	|	&ЭтоИсправление КАК ЭтоИсправление,
	|	&ЭтоКорректировка КАК ЭтоКорректировка,
	|	&ЭтоАванс КАК ЭтоАванс,
	|	ДанныеДокументов.Организация КАК Организация,
	|	ДанныеДокументов.Контрагент КАК Контрагент,
	|	ДанныеДокументов.ВалютаДокумента КАК Валюта,
	|	ДанныеДокументов.СуммаДокумента КАК СуммаДокументаЗначение,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ID,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	ДанныеДокументов.Проведен КАК Проведен,
	|	ДанныеДокументов.Дата КАК Дата,
	|	ДанныеДокументов.Номер КАК Номер,
	|	ДанныеДокументов.ДокументОснование КАК ДокументОснование,
	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД,
	|	НастройкиЭДО.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиЭДО.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.СчетФактураВыданный КАК ДанныеДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО ДанныеДокументов.Организация = НастройкиЭДО.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО ДанныеДокументов.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|ГДЕ
	|	ДанныеДокументов.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|	И НЕ ДанныеДокументов.ПометкаУдаления
	|	И ДанныеДокументов.Контрагент = НастройкиЭДО.Контрагент
	|	И (ДанныеДокументов.Проведен
	|			ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент";
	
	Подзапросы = Новый Массив;
	Подзапросы.Добавить(Поместить_ВТ_Основная);
	Подзапросы.Добавить(ТекстЗапроса_Поместить_ДанныеДокументаИДокументыОснования());
	Подзапросы.Добавить(ТекстЗапроса_Поместить_СуммыДокОснованийЗначение());
	Подзапросы.Добавить(ТекстЗапроса_Поместить_СЧФ_Основная());
	Подзапросы.Добавить("УНИЧТОЖИТЬ ВТ_Основная");
	Подзапросы.Добавить("УНИЧТОЖИТЬ СуммыДокОснованийЗначение");
	Подзапросы.Добавить("УНИЧТОЖИТЬ ДанныеДокументаИДокументыОснования");
	
	ТекстЗапроса = СтрСоединить(Подзапросы, РазделительПакетаЗапросов());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоАванс", ВыражениеЭтоСчетФактураНаАванс());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоИсправление", ТекстЗапроса_СчетФактура_ЭтоИсправление());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоКорректировка", ТекстЗапроса_СчетФактура_ЭтоКорректировка());
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПодготовитьВТ_УПД_СЧФДОП(Запрос, МассивВременныхТаблиц, ТипыДокументов)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СЧФ_Основная.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_ПодходящиеСЧФ
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	СЧФ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|	И НЕ СЧФ_Основная.ЭтоКорректировка
	|
	|СГРУППИРОВАТЬ ПО
	|	СЧФ_Основная.Документ
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СЧФ_Основная.ID_ = СЧФ_Основная.ДокументОснованиеID
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.Документ КАК Документ,
	|	&ВидыЭД_СчетФактура КАК ВидЭД,
	|	СЧФ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	СЧФ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	СЧФ_Основная.Организация КАК Организация,
	|	СЧФ_Основная.Контрагент КАК Контрагент,
	|	СЧФ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	СЧФ_Основная.СуммаНДСТовары КАК СуммаНДСТовары,
	|	СЧФ_Основная.СуммаНДСУслуги КАК СуммаНДСУслуги,
	|	СЧФ_Основная.Валюта КАК Валюта,
	|	СЧФ_Основная.Проведен КАК Проведен,
	|	СЧФ_Основная.Дата КАК Дата,
	|	СЧФ_Основная.Номер КАК Номер,
	|	СЧФ_Основная.ID_ КАК ID_,
	|	ВЫБОР
	|		КОГДА СЧФ_Основная.ЭтоАванс
	|			ТОГДА &ФункцияЭД_СЧФ
	|		ИНАЧЕ &ФункцияЭД_СЧФДОП
	|	КОНЕЦ КАК ФункцияУПД,
	|	""СчетФактураВыданный"" КАК Тип,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	ЛОЖЬ КАК ЭтоСчет
	|ПОМЕСТИТЬ УПД_СЧФДОП
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
