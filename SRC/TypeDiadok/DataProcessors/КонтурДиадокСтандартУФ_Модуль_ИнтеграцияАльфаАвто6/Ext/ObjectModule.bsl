// Вызывается из Модуль_ИнтеграцияУниверсальный.МетаданныеПрикладногоСправочника.
//
// Параметры:
//  СоответствиеСправочников - Соответствие - ключом является имя справочника в терминах сервиса, а значением - метаданные прикладного справочника;
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииСоответствияСправочников(СоответствиеСправочников, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	СоответствиеСправочников.Вставить("Валюты"			, Метаданные.Справочники.Валюты);
	СоответствиеСправочников.Вставить("СтраныМира"		, Метаданные.Справочники.СтраныМира);
	СоответствиеСправочников.Вставить("ЕдиницыИзмерения", Метаданные.Справочники.КлассификаторЕдиницИзмерения);
	
	СоответствиеСправочников.Вставить("Организации"				, Метаданные.Справочники.Организации);
	СоответствиеСправочников.Вставить("Контрагенты"				, Метаданные.Справочники.Контрагенты);
	СоответствиеСправочников.Вставить("Партнеры"				, Неопределено);
	СоответствиеСправочников.Вставить("ДоговорыКонтрагентов"	, Метаданные.Справочники.ДоговорыВзаиморасчетов);
	СоответствиеСправочников.Вставить("Номенклатура"			, Метаданные.Справочники.Номенклатура);
	СоответствиеСправочников.Вставить("УпаковкиНоменклатуры"	, Метаданные.Справочники.КлассификаторЕдиницИзмерения);
	
	СоответствиеСправочников.Вставить("БанковскиеСчетаОрганизаций"	, Метаданные.Справочники.БанковскиеСчета);
	СоответствиеСправочников.Вставить("БанковскиеСчетаКонтрагентов"	, Метаданные.Справочники.БанковскиеСчета);
	
	Если ИспользуетсяСправочникКлассификаторБанков() Тогда
		СоответствиеСправочников.Вставить("Банки", Метаданные.Справочники.КлассификаторБанков);
	Иначе
		СоответствиеСправочников.Вставить("Банки", Метаданные.Справочники.КлассификаторБанковРФ);
	КонецЕсли;
	
КонецПроцедуры

