	КодыМаркировки = Документы.ПоступлениеТоваров.ПустаяСсылка().КодыМаркировки.ВыгрузитьКолонки();
	
	ЗаполнитьТабличныеЧасти(Товары, КодыМаркировки, ТоварнаяЧастьЭД);
	
