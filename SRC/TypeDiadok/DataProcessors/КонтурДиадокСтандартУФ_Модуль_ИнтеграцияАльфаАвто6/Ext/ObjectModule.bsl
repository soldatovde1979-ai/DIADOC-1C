Процедура ЗаполнитьСведенияОСоставителе155(Прото, Шапка)
	
	ДатаДокумента = Шапка.Дата;
	Составитель = Шапка.ГоловнаяОрганизация;
	СчетСоставителя = Неопределено;
	Грузоотправитель = Шапка.Грузоотправитель;
	РеквизитыСоставителя = МенеджерИнтеграции_РеквизитыЮрФизЛица(Составитель, ДатаДокумента, СчетСоставителя, Грузоотправитель);
	
	Прочерк = "-";
	
	ИНН = СокрЛП(РеквизитыСоставителя.ИНН);
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		ИНН = Прочерк;
	КонецЕсли;
	
	КПП = СокрЛП(РеквизитыСоставителя.КПП);
	Если Не ЗначениеЗаполнено(КПП) Тогда
		КПП = Прочерк;
	КонецЕсли;
	
	Наименование = СокрЛП(РеквизитыСоставителя.НаименованиеДляПечатныхФорм);
	
	Прото.Creator = СтрШаблон("%1, ИНН/КПП: %2/%3",
		Наименование,
		ИНН,
		КПП);
	
