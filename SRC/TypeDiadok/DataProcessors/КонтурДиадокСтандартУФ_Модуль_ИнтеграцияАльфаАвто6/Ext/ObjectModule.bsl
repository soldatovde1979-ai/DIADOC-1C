Функция ПлатежноРасчетныеДокументы(СсылкаНаОбъект)
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект)
		Или ТипЗнч(СсылкаНаОбъект) <> Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПРД.Номер КАК Номер,
	|	ПРД.Дата КАК Дата
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК ПРД
	|ГДЕ
	|	ПРД.Ссылка = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьInvoiceForCorrectionInfo(Invoices, ДатаНомерДокумента)
				
	Item_InvoiceForCorrectionInfo = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceForCorrectionInfo");
	
	Item_InvoiceForCorrectionInfo.InvoiceNumber	 = ДатаНомерДокумента.НомерИсходногоДокумента;
	Item_InvoiceForCorrectionInfo.InvoiceDate	 = ДатаНомерДокумента.ДатаИсходногоДокумента;
	
	Если ДатаНомерДокумента.УчитыватьИсправлениеИсходногоДокумента Тогда 
		
		Item_InvoiceRevisionInfo = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceRevisionInfo");
		
		Item_InvoiceRevisionInfo.RevisionNumber	 = ДатаНомерДокумента.НомерИсправленияИсходногоДокумента;
		Item_InvoiceRevisionInfo.RevisionDate	 = ДатаНомерДокумента.ДатаИсправленияИсходногоДокумента;
		
		Item_InvoiceForCorrectionInfo.InvoiceRevisions.Добавить(Item_InvoiceRevisionInfo);
		
	КонецЕсли;
	
	Invoices.Добавить(Item_InvoiceForCorrectionInfo);
	
КонецПроцедуры

Процедура ЗаполнитьInvoiceCorrectionTable(InvoiceCorrectionTable, ТаблицаТоваров)
	
	ВсеСтроки_СтавкаНДС_БезНДС	 = Истина;
	ВсеСтроки_СтавкаНДС_ИсчНалАг = Истина;
	
	ЕстьУвеличение = Ложь;
	ЕстьУменьшение = Ложь;
	
	TotalsDec_Total 				= 0;
	TotalsDec_TotalWithVatExcluded 	= 0;
	TotalsDec_Vat 					= 0;
	
	TotalsInc_Total 				= 0;
	TotalsInc_TotalWithVatExcluded 	= 0;
	TotalsInc_Vat 					= 0;
	
	СтруктураItemInvoiceCorrection = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ExtendedInvoiceCorrectionItem");
	
	СтавкаНДС_БезНДС   = МетодСервера(, "СтавкаНДС_БезНДС");
	СтавкаНДС_ИсчНалАг = МетодСервера(, "СтавкаНДС_ИсчНалАг");
	
	Для Каждого СтрокаДанных из ТаблицаТоваров Цикл 
		
		Item = СкопироватьСтруктуру(СтруктураItemInvoiceCorrection);
		МенеджерИнтеграции_ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		InvoiceCorrectionTable.Items.Добавить(Item);
		
		Item.AmountsDec			= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.AmountsInc			= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.OriginalValues		= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		Item.CorrectedValues	= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		
		Item.Product		= СтрокаДанных.НоменклатураПредставление;
		Item.ItemVendorCode	= СокрЛП(СтрокаДанных.КодНоменклатуры);
		
		СтавкаДоИзменения = СтрокаДанных.СтавкаНДСДоИзменения;
		Если Не ЗначениеЗаполнено(СтавкаДоИзменения) Тогда
			СтавкаДоИзменения = СтрокаДанных.СтавкаНДС;
		КонецЕсли;
		
		Item.CorrectedValues.TaxRate = ПредставлениеСтавкиНДС(СтрокаДанных.СтавкаНДС);
		Item.OriginalValues.TaxRate  = ПредставлениеСтавкиНДС(СтавкаДоИзменения);
		
		Если Item.CorrectedValues.TaxRate <> СтавкаНДС_БезНДС Тогда
			ВсеСтроки_СтавкаНДС_БезНДС = Ложь;
		КонецЕсли;
		Если Item.CorrectedValues.TaxRate <> СтавкаНДС_ИсчНалАг Тогда
			ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
		КонецЕсли;
		
		Item.OriginalValues.TotalWithVatExcluded  = СтрокаДанных.СуммаДоИзменения - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДСДоИзменения, 0);
		Item.CorrectedValues.TotalWithVatExcluded = СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);
		
		Если  ЗначениеЗаполнено(СтрокаДанных.КоличествоДоИзменения)
			И ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения)
			И ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Код) Тогда
			
			Item.OriginalValues.Quantity = СтрокаДанных.КоличествоДоИзменения;
			Item.OriginalValues.UnitCode = XML_КодЕдиницыИзмерения(СокрЛП(СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Код));
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Наименование) Тогда
				Item.OriginalValues.UnitName = СтрокаДанных.ЕдиницаИзмеренияДоИзменения.Наименование;
			Иначе
				Item.OriginalValues.UnitName = НаименованиеЕдиницыИзмеренияПоКодуОКЕИ(Item.OriginalValues.UnitCode);
			КонецЕсли;
			
			Если Item.OriginalValues.TaxRate = СтавкаНДС_БезНДС Или Не СтрокаДанных.СуммаВключаетНДС Тогда
				// Без пересчета, т.к. цена уже без НДС
				Item.OriginalValues.Price = СтрокаДанных.ЦенаДоИзменения;
			Иначе
				// Расчет цены без НДС
				Item.OriginalValues.Price = ?(ЗначениеЗаполнено(Item.OriginalValues.Quantity), Окр(Item.OriginalValues.TotalWithVatExcluded / Item.OriginalValues.Quantity, 2), 0);
			КонецЕсли;
			
			Item.OriginalValues.ЕдиницаИзмеренияСсылка = СтрокаДанных.ЕдиницаИзмеренияДоИзменения;
			
		Иначе
			//не инициируем поля UnitCode, UnitName, Quantity, Price, чтобы в печатной форме ЭД были прочерки   
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(СтрокаДанных.Количество)
			И ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения)
			И ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения.Код) Тогда
			
			Item.CorrectedValues.UnitCode = XML_КодЕдиницыИзмерения(СокрЛП(СтрокаДанных.ЕдиницаИзмерения.Код));
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения.Наименование) Тогда
				Item.CorrectedValues.UnitName = СтрокаДанных.ЕдиницаИзмерения.Наименование;
			Иначе
				Item.CorrectedValues.UnitName = НаименованиеЕдиницыИзмеренияПоКодуОКЕИ(Item.CorrectedValues.UnitCode);
			КонецЕсли;
			
			// если до количество было, а теперь его не стало - заполняем 0, а не "-"!!!
			Если ЗначениеЗаполнено(СтрокаДанных.КоличествоДоИзменения) И Не ЗначениеЗаполнено(СтрокаДанных.Количество) Тогда
				
				Item.CorrectedValues.Quantity = 0;
				
			Иначе
				
				Item.CorrectedValues.Quantity = СтрокаДанных.Количество;
				
				Если Item.CorrectedValues.TaxRate = СтавкаНДС_БезНДС Или Не СтрокаДанных.СуммаВключаетНДС Тогда
					// Без пересчета, т.к. цена уже без НДС
					Item.CorrectedValues.Price = СтрокаДанных.Цена;
				Иначе
					// Расчет цены без НДС
					Item.CorrectedValues.Price = ?(ЗначениеЗаполнено(Item.CorrectedValues.Quantity), Окр(Item.CorrectedValues.TotalWithVatExcluded / Item.CorrectedValues.Quantity, 2), 0);
				КонецЕсли;
				
			КонецЕсли;
			
			Item.CorrectedValues.ЕдиницаИзмеренияСсылка = СтрокаДанных.ЕдиницаИзмерения;
			
		Иначе
			//не инициируем поля UnitCode, UnitName, Quantity, Price, чтобы в печатной форме ЭД были прочерки   
		КонецЕсли;
		
		
		// НДС и сумма с НДС до изменения
		Если Item.OriginalValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
			Item.OriginalValues.Vat = 0;
			Item.OriginalValues.Total = 0;
		Иначе
			
			Если Item.OriginalValues.TaxRate = СтавкаНДС_БезНДС Тогда
				Item.OriginalValues.Vat = Неопределено;
			Иначе
				Item.OriginalValues.Vat = СтрокаДанных.СуммаНДСДоИзменения;
			КонецЕсли;
			
			Item.OriginalValues.Total   = СтрокаДанных.СуммаДоИзменения + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДСДоИзменения);
			
		КонецЕсли;
		
		// НДС и сумма с НДС после изменения
		Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
			Item.CorrectedValues.Vat = 0;
			Item.CorrectedValues.Total = 0;
		Иначе
			
			Если Item.CorrectedValues.TaxRate = СтавкаНДС_БезНДС Тогда
				Item.CorrectedValues.Vat = Неопределено;
			Иначе
				Item.CorrectedValues.Vat = СтрокаДанных.СуммаНДС;
			КонецЕсли;
			
			Item.CorrectedValues.Total = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
			
		КонецЕсли;
		
		
		Если Item.CorrectedValues.TotalWithVatExcluded >= Item.OriginalValues.TotalWithVatExcluded Тогда
			
			// Увеличение
			ЕстьУвеличение = Истина;
			
			Item.AmountsDec.TotalWithVatExcluded = Неопределено;
			Item.AmountsDec.Vat = Неопределено;
			Item.AmountsDec.Total = Неопределено;
			
			Item.AmountsInc.TotalWithVatExcluded = Item.CorrectedValues.TotalWithVatExcluded - Item.OriginalValues.TotalWithVatExcluded;
			
			Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
				Item.AmountsInc.Vat = Неопределено;
				Item.AmountsInc.Total = Неопределено;
			Иначе
				
				Если Item.CorrectedValues.TaxRate = СтавкаНДС_БезНДС Тогда
					Item.AmountsInc.Vat = 0;
				Иначе
					Item.AmountsInc.Vat = МетодСервера(, "ПривестиКЧислу", Item.CorrectedValues.Vat) - МетодСервера(, "ПривестиКЧислу", Item.OriginalValues.Vat);
				КонецЕсли;
				
				Item.AmountsInc.Total = Item.CorrectedValues.Total - Item.OriginalValues.Total;
				
			КонецЕсли;
			
		Иначе
			
			// Уменьшение
			ЕстьУменьшение = Истина;
			
			Item.AmountsInc.TotalWithVatExcluded = Неопределено;
			Item.AmountsInc.Vat = Неопределено;
			Item.AmountsInc.Total = Неопределено;
			
			Item.AmountsDec.TotalWithVatExcluded = - Item.CorrectedValues.TotalWithVatExcluded + Item.OriginalValues.TotalWithVatExcluded;
			
			Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
				Item.AmountsDec.Vat = Неопределено;
				Item.AmountsDec.Total = Неопределено;
			Иначе
				
				Если Item.CorrectedValues.TaxRate = СтавкаНДС_БезНДС Тогда
					Item.AmountsDec.Vat = 0;
				Иначе
					Item.AmountsDec.Vat = - МетодСервера(, "ПривестиКЧислу", Item.CorrectedValues.Vat) + МетодСервера(, "ПривестиКЧислу", Item.OriginalValues.Vat);
				КонецЕсли;
				
				Item.AmountsDec.Total = -Item.CorrectedValues.Total + Item.OriginalValues.Total;
				
			КонецЕсли;
			
		КонецЕсли;
		
		TotalsDec_Total 				= TotalsDec_Total + МетодСервера(, "ПривестиКЧислу", Item.AmountsDec.Total);
		TotalsDec_TotalWithVatExcluded 	= TotalsDec_TotalWithVatExcluded + МетодСервера(, "ПривестиКЧислу", Item.AmountsDec.TotalWithVatExcluded);
		TotalsDec_Vat 					= TotalsDec_Vat + МетодСервера(, "ПривестиКЧислу", Item.AmountsDec.Vat);
		
		TotalsInc_Total 				= TotalsInc_Total + МетодСервера(, "ПривестиКЧислу", Item.AmountsInc.Total);
		TotalsInc_TotalWithVatExcluded 	= TotalsInc_TotalWithVatExcluded + МетодСервера(, "ПривестиКЧислу", Item.AmountsInc.TotalWithVatExcluded);
		TotalsInc_Vat 					= TotalsInc_Vat + МетодСервера(, "ПривестиКЧислу", Item.AmountsInc.Vat);
		
		СведенияОСтранеПроисхожденияТовара	= КоллекцияСведенийОСтранеПроисхождения(СтрокаДанных);
		ДопИнформацияОСтранеПроисхождения	= МетодСервера("Модуль_ИнтеграцияУниверсальный", "СведенияОСтранеПроисхожденияСтрокой", СведенияОСтранеПроисхожденияТовара);
		
		ЗаполнитьStructedAdditionalInfos(Item.StructedAdditionalInfos, ДопИнформацияОСтранеПроисхождения);
		
	КонецЦикла;	  
	
	Если ЕстьУвеличение Тогда
		InvoiceCorrectionTable.TotalsInc.Total 					= TotalsInc_Total; 
		InvoiceCorrectionTable.TotalsInc.TotalWithVatExcluded	= TotalsInc_TotalWithVatExcluded; 
		InvoiceCorrectionTable.TotalsInc.Vat 					= ?(ВсеСтроки_СтавкаНДС_БезНДС, Неопределено, ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, 0, TotalsInc_Vat)); 
	КонецЕсли;
	
	Если ЕстьУменьшение Тогда
		InvoiceCorrectionTable.TotalsDec.Total					= TotalsDec_Total; 
		InvoiceCorrectionTable.TotalsDec.TotalWithVatExcluded	= TotalsDec_TotalWithVatExcluded; 
		InvoiceCorrectionTable.TotalsDec.Vat 					= ?(ВсеСтроки_СтавкаНДС_БезНДС, Неопределено, ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, 0, TotalsDec_Vat)); 
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьEventContent(EventContent, ШапкаУКД)
	
	Для Каждого ПередаточныйДокумент Из ШапкаУКД.РеквизитыПередаточныхДокументов Цикл	
		Новый_BaseDocument = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_BaseDocumentName");
		ЗаполнитьЗначенияСвойств(Новый_BaseDocument, ПередаточныйДокумент);
		EventContent.TransferDocDetails736.Добавить(Новый_BaseDocument);	
	КонецЦикла;
	Если ШапкаУКД.Свойство("ИныеСведенияОбИзмененииСтоимости") Тогда
		EventContent.CostChangeInfo = ШапкаУКД.ИныеСведенияОбИзмененииСтоимости;
	КонецЕсли;
	Если ШапкаУКД.Свойство("ДатаУведомления") Тогда
		EventContent.NotificationDate = ШапкаУКД.ДатаУведомления;
	КонецЕсли;
	
	EventContent.OperationContent = "Изменение стоимости товаров и услуг";
	
	CorrectionBases 				= Новый Массив;
	СтруктураItemCorrectionBases 	= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CorrectionBase");
	
	ОснованияПередачи = ШапкаУКД.ОснованияПередачи;
	Если ОснованияПередачи.Количество() > 0 Тогда
		СкопироватьСтруктуру(СтруктураItemCorrectionBases);
		Для Каждого ОснованиеПередачи Из ОснованияПередачи Цикл
			ItemCorrectionBases = СкопироватьСтруктуру(СтруктураItemCorrectionBases);
			ЗаполнитьЗначенияСвойств(ItemCorrectionBases, ОснованиеПередачи);
			CorrectionBases.Добавить(ItemCorrectionBases);
		КонецЦикла;
	Иначе
		СтруктураItemCorrectionBases.BaseDocumentName = МетодСервера("Модуль_ИнтеграцияУниверсальный", "ОснованиеПередачи_БезДокументаОснования");
		CorrectionBases.Добавить(СтруктураItemCorrectionBases);
	КонецЕсли;
	
	EventContent.CorrectionBases = CorrectionBases;
	
КонецПроцедуры

