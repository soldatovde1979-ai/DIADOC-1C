// Конструктор дополнительных параметров заполнения поступления товаров и услуг.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ВидОперации - ПеречислениСсылка.ВидыОперацийПоступлениеТоваровУслуг - вид операции поступления.
//   * ЦенаВключаетНДС - Булево - Истина, если цена включает НДС.
//
Функция ПараметрыЗаполненияПоступленияТоваров()
	
	Результат = Новый Структура;
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	Результат.Вставить("ХозОперация", ХозяйственнаяОперацияПоступлениеТоваров());
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияПоступленияТоваров(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияПоступленияТоваров();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТоварнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗаполнятьПоСтуктуре", Истина);
	ДанныеЗаполнения.Вставить("ХозОперация", ПараметрыЗаполнения.ХозОперация);
	
	ДобавитьВалюту(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьДатуНомерВходящего(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьРеквизитыИсправления(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьОрганизацию(ДанныеЗаполнения, ШапкаЭД);
