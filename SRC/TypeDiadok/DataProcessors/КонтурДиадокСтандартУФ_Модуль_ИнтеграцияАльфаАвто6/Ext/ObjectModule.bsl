	ДокументОбъект.Заполнить(ДанныеЗаполнения.ПервичныйДокумент);
	
	СтруктураПоиска				= Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СтавкаНДС");
	СтруктураПоискаМаркировки	= Новый Структура("ИдентификаторТовара");
	
	РеквизитыТабличнойЧастиДляПерезаполнения = "Количество, КоличествоПоДокументуПоступления, КоличествоДоКорректировки, КоличествоРазница,												
												|СуммаНДС, СуммаНДСПоДокументуПоступления, СуммаНДСДоКорректировки, СуммаНДСРазница,
												|СуммаВсего, СуммаВсегоДоКорректировки, СуммаВсегоПоДокументуПоступления, СуммаВсегоРазница,
												|Цена, Сумма, СтавкаНДС";
	
	Для Каждого СтрокаДокумента Из ДокументОбъект.Товары Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
		РезультатПоискаДанныхЗаполнения = ДанныеЗаполнения.Товары.НайтиСтроки(СтруктураПоиска);
		
		Если РезультатПоискаДанныхЗаполнения.Количество() > 0 Тогда
			
			СтрокаДанныхЗаполнения = РезультатПоискаДанныхЗаполнения[0];
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДанныхЗаполнения, РеквизитыТабличнойЧастиДляПерезаполнения);
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаМаркировки, СтрокаДанныхЗаполнения);
			РезультатПоискаМаркировки = ДанныеЗаполнения.КодыМаркировки.НайтиСтроки(СтруктураПоискаМаркировки);
			Для Каждого СтрокаМаркировки Из РезультатПоискаМаркировки Цикл
				СтрокаМаркировки.ИдентификаторТовара = СтрокаДокумента.ИдентификаторТовара;
			КонецЦикла;
			
			// Удалим обработанную строку из данных заполнения
			ДанныеЗаполнения.Товары.Удалить(СтрокаДанныхЗаполнения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавим новые строки в документ
	Если ДанныеЗаполнения.Товары.Количество() > 0 Тогда
		
		Для Каждого СтрокаДанныхЗаполнения Из ДанныеЗаполнения.Товары Цикл
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаполнения);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДокументОбъект.КодыМаркировки.Загрузить(ДанныеЗаполнения.КодыМаркировки);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ОтключитьПроверкуЗаполненияОбъекта(ДокументОбъект);
	
КонецПроцедуры

Процедура ЗаполнитьИсправлениеПоступления(ДокументОбъект, ДанныеЗаполнения)
	
	ДокументОбъект.Заполнить(ДанныеЗаполнения.ПервичныйДокумент);
	
	СтруктураПоиска				= Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, СтавкаНДС");
	СтруктураПоискаМаркировки	= Новый Структура("ИдентификаторТовара");
	
	РеквизитыТабличнойЧастиДляПерезаполнения = "Количество, СуммаНДС, СуммаВсего, Цена, Сумма, СтавкаНДС";
	
	Для Каждого СтрокаДокумента Из ДокументОбъект.Товары Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаДокумента);
		РезультатПоискаДанныхЗаполнения = ДанныеЗаполнения.Товары.НайтиСтроки(СтруктураПоиска);
		
		Если РезультатПоискаДанныхЗаполнения.Количество() > 0 Тогда
			
			СтрокаДанныхЗаполнения = РезультатПоискаДанныхЗаполнения[0];
			ЗаполнитьЗначенияСвойств(СтрокаДокумента, СтрокаДанныхЗаполнения, РеквизитыТабличнойЧастиДляПерезаполнения);
			
			Документы.КорректировкаПоступления.РасчетРазницы(ДокументОбъект, СтрокаДокумента);
			
			ЗаполнитьЗначенияСвойств(СтруктураПоискаМаркировки, СтрокаДанныхЗаполнения);
			РезультатПоискаМаркировки = ДанныеЗаполнения.КодыМаркировки.НайтиСтроки(СтруктураПоискаМаркировки);
			Для Каждого СтрокаМаркировки Из РезультатПоискаМаркировки Цикл
				СтрокаМаркировки.ИдентификаторТовара = СтрокаДокумента.ИдентификаторТовара;
			КонецЦикла;
			
			// Удалим обработанную строку из данных заполнения
			ДанныеЗаполнения.Товары.Удалить(СтрокаДанныхЗаполнения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавим новые строки в документ
	Если ДанныеЗаполнения.Товары.Количество() > 0 Тогда
		
		Для Каждого СтрокаДанныхЗаполнения Из ДанныеЗаполнения.Товары Цикл
			
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаполнения);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДокументОбъект.КодыМаркировки.Загрузить(ДанныеЗаполнения.КодыМаркировки);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ОтключитьПроверкуЗаполненияОбъекта(ДокументОбъект);
	
КонецПроцедуры

