Функция СтруктураЗаполненияСчетаФактурыПолученного(ДанныеЭД, ДополнительныеПараметры)
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТоварнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗаполнятьПоСтуктуре", Истина);
	
	ДобавитьВалюту(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьДатуНомерВходящего(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьРеквизитыИсправления(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьОрганизацию(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьКонтрагента(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьПодразделениеКомпании(ДанныеЗаполнения);
	ДобавитьДоговорВзаиморасчетов(ДанныеЗаполнения);
	ДобавитьСкладКомпании(ДанныеЗаполнения);
	
	Товары = Документы.СчетФактураПолученный.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	КодыМаркировки = Неопределено;
	
	ЗаполнитьТабличныеЧасти(Товары, КодыМаркировки, ТоварнаяЧастьЭД);
	
	ДанныеЗаполнения.Вставить("Товары", Товары);
	ДанныеЗаполнения.Вставить("КодыМаркировки", Неопределено);
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

Процедура ЗаполнитьСчетФактуруПолученный(ДокументОбъект, ДанныеЗаполнения)
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
	ДокументОбъект.ПодразделениеКомпании = ДанныеЗаполнения.ПодразделениеКомпании;
	
	Основание = Неопределено;
	ДанныеЗаполнения.Свойство("Основание", Основание);
	ДокументОбъект.Заполнить(Основание);
	
	ДокументОбъект.Товары.Загрузить(ДанныеЗаполнения.Товары);
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ОтключитьПроверкуЗаполненияОбъекта(ДокументОбъект);
	
КонецПроцедуры

