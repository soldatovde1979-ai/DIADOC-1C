Функция МенеджерИнтеграции_РеквизитыЮрФизЛица(ЮрФизЛицо, Период = '00010101', БанковскийСчет = Неопределено, ОбособленноеПодразделение = Неопределено)
	
	Результат = РеквизитыЮрФизЛица(ЮрФизЛицо, Период, БанковскийСчет);
	
	ОрганизацияПодразделения = ОрганизацияОбособленногоПодразделения(ОбособленноеПодразделение);
		
	Если ОрганизацияПодразделения = ЮрФизЛицо Тогда
		
		РеквизитыПодразделения = РеквизитыЮрФизЛица(ОбособленноеПодразделение, Период);
		ПодразделениеКПП = РеквизитыПодразделения.КПП;
		
		Если ЗначениеЗаполнено(ПодразделениеКПП)
			И Результат.КПП <> ПодразделениеКПП Тогда
			
			Результат.КПП = ПодразделениеКПП;		
			ЗаполнитьЗначенияСвойств(Результат, РеквизитыПодразделения,	"Банк, БИК, АдресБанка, НомерСчета, КоррСчет");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

