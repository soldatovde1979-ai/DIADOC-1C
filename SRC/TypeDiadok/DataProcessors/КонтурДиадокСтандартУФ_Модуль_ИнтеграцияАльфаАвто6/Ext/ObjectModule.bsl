Функция НайтиСоздатьНомерГТД(НомерТаможеннойДекларации, КодСтраны = Неопределено)
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(НомерТаможеннойДекларации) Тогда
		
		СтранаПроисхождения = НайтиСтрану(КодСтраны);
		
		Результат = НайтиНомерГТД(НомерТаможеннойДекларации, СтранаПроисхождения);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = СоздатьНомерГТД(НомерТаможеннойДекларации, СтранаПроисхождения);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиНомерГТД(НомерТаможеннойДекларации, СтранаПроисхождения)
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГТД КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Наименование = &НомерТД
	|	И (&БезУчетаСтраны
	|			ИЛИ Т.Страна = &Страна)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НомерТД", НомерТаможеннойДекларации);
	Запрос.УстановитьПараметр("Страна", СтранаПроисхождения);
	Запрос.УстановитьПараметр("БезУчетаСтраны", Не ЗначениеЗаполнено(СтранаПроисхождения));
	
	Результат = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоздатьНомерГТД(НомерТаможеннойДекларации, СтранаПроисхождения)
	
	Запись = Справочники.ГТД.СоздатьЭлемент();
	Запись.УстановитьНовыйКод();
	Запись.Наименование = НомерТаможеннойДекларации;
	Запись.Страна = СтранаПроисхождения;
	Запись.ОбменДанными.Загрузка = Истина;
	
	Попытка
		
		Запись.Записать();
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ТекстОшибки = НСтр("ru = 'Не удалось записать элемент справочника ""ГТД"" по причине:
	                       |%1'");
		ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаЗагрузка()
			, УровеньЖурналаРегистрации.Ошибка
			, Запись.Метаданные()
			,
			, ТекстОшибки);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	Результат = Запись.Ссылка;
	
	Возврат Результат;
	
КонецФункции

