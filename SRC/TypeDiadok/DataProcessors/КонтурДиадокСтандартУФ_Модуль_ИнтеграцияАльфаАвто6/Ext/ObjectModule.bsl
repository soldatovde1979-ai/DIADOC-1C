// Вызывается из Модуль_ИнтеграцияУниверсальный.РеквизитыЮрФизЛица.
//
// Параметры:
//  Реквизиты			 - Структура - возвращаемые сведения.
//  ЮрФизЛицо			 - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - компания, реквизиты которой нужно получить
//  Период				 - Дата - дата, на которую нужно получить значения периодических реквизитов
//  БанковскийСчет		 - СправочникСсылка.БанковскиеСчета - банковский счет, реквизиты которого нужно включить в реквизиты компании.
//                         Если не передан, будут включены реквизиты основного банковского счета.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриПолученииРеквизитовЮрФизЛица(Реквизиты, ЮрФизЛицо, Период, БанковскийСчет, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ЗначенияРеквизитов = РеквизитыОрганизацииКонтрагента(ЮрФизЛицо, Период, БанковскийСчет);
	
	ЗаполнитьЗначенияСвойств(Реквизиты, ЗначенияРеквизитов);
	
	НаименованиеЮрФизЛица = СокрЛП(ЗначенияРеквизитов.НаименованиеПолное);
	Реквизиты.Представление = НаименованиеЮрФизЛица;
	Реквизиты.ПолноеНаименование = НаименованиеЮрФизЛица;
	Реквизиты.СокращенноеНаименование = НаименованиеЮрФизЛица;
	Реквизиты.НаименованиеДляПечатныхФорм = НаименованиеЮрФизЛица;
	
	Если ЗначенияРеквизитов.ФормаСобственности = Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель
		Или ЗначенияРеквизитов.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		Реквизиты.ТипЮрФизЛица = ТипЮрФизЛица_ФизическоеЛицо();
	Иначе
		Реквизиты.ТипЮрФизЛица = ТипЮрФизЛица_ЮридическоеЛицо();
	КонецЕсли;
	
КонецПроцедуры

// Заполняет развернутую таблицу кодов маркировки штатными средствами конфигурации.
// В этой процедуре можно отключить стандартную обработку получения таблицы
// с помощью подсистемы БиблиотекаИнтеграцииИСМП.
//
// Параметры:
//  Результат - ТаблицаЗначений - Заполняемая таблица (см. МенеджерИнтеграции.НоваяРазвернутаяТаблицаУпаковок)
//  СсылкаНаДокумент - ЛюбаяСсылка - объект-владелец штрихкода
//  СтандартнаяОбработка - Булево - если установить Ложь, то заполнение таблицы кодов средствами
//                                  типовой библиотеки интеграции с ИС МП будет отключено.
//
Процедура ЗаполнитьРазвернутуюТаблицуКодов(Результат, СсылкаНаОбъект, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ДокументыПередачи = ДокументыВладельцыКодовМаркировки(СсылкаНаОбъект);
	
	Для Каждого ДокументПередачи Из ДокументыПередачи Цикл
		ДополнитьТаблицуКодовМаркировки(Результат, ДокументПередачи);
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументыВладельцыКодовМаркировки(СсылкаНаОбъект)
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ДокументПередачи = СсылкаНаОбъект.ДокументОснование;
	Иначе
		ДокументПередачи = СсылкаНаОбъект;
	КонецЕсли;
	
	Результат = Новый Массив;
	Результат.Добавить(ДокументПередачи);
	
	Возврат Результат;
	
КонецФункции

Процедура ДополнитьТаблицуКодовМаркировки(ТаблицаКодов, ДокументПередачи)
	
	МетаданныеОбъекта = ДокументПередачи.Метаданные();
	
	Если Не ЕстьКодыМаркировки(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыНоменклатуры = ПараметрыУчетаНоменклатуры();
	
	ТекстЗапроса = ТекстЗапросаРазвернутаяТаблицаКодов(МетаданныеОбъекта.ПолноеИмя());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументыПередачи", ДокументПередачи);
	Запрос.УстановитьПараметр("УпаковкаПотребительская", "Потребительская");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаКодов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ИспользоватьХарактеристики = ПараметрыНоменклатуры.ИспользоватьХарактеристики;
		НоваяСтрока.ИспользоватьСерии = ПараметрыНоменклатуры.ИспользоватьСерии;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, есть ли у объекта метаданных табличная часть с штрихкодами упаковок товаров.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - проверяемый объект метаданных.
// 
// Возвращаемое значение:
//  Булево - Истина, если у объекта есть табличная часть "КодыМаркировки".
//
Функция ЕстьКодыМаркировки(ОбъектМетаданных)
	
	Результат = (ОбъектМетаданных.ТабличныеЧасти.Найти("КодыМаркировки") <> Неопределено);
	Возврат Результат;
	
КонецФункции

// Возвращает параметры учета номенклатуры в текущей информационной базе.
// 
// Возвращаемое значение:
//  ФикисированнаяСтруктура - содержит ключи:
//    * ИспользоватьХарактеристики - Булево - Истина, если используются характеристики номенклатуры
//    * ИспользоватьСерии - Булево - Истина, если используются серии номенклатуры
//
Функция ПараметрыУчетаНоменклатуры()
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьХарактеристики", Ложь);
	Результат.Вставить("ИспользоватьСерии", Ложь);
	
	Если Метаданные.Справочники.Найти("ХарактеристикиНоменклатуры") <> Неопределено Тогда
		Результат.ИспользоватьХарактеристики = Истина;
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("СерииНоменклатуры") <> Неопределено Тогда
		Результат.ИспользоватьСерии = Истина;
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция ТекстЗапросаРазвернутаяТаблицаКодов(ПолноеИмяТаблицы)
	
	Результат =
	"ВЫБРАТЬ
	|	КМ.Ссылка КАК Ссылка,
	|	КМ.ИдентификаторТовара КАК ИдентификаторТовара,
	|	КМ.КодМаркировки КАК КодМаркировки
	|ПОМЕСТИТЬ КодыМаркировки
	|ИЗ
	|	&ТЧКодыМаркировки КАК КМ
	|ГДЕ
	|	КМ.Ссылка В(&ДокументыПередачи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.ХарактеристикаНоменклатуры КАК Характеристика,
	|	Т.ИдентификаторТовара КАК ИдентификаторТовара
	|ПОМЕСТИТЬ Товары
	|ИЗ
	|	&ТЧТовары КАК Т
	|ГДЕ
	|	Т.Ссылка В(&ДокументыПередачи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	КодыМаркировки.КодМаркировки КАК ЗначениеШтрихкода,
	|	&УпаковкаПотребительская КАК ВидУпаковки
	|ИЗ
	|	Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыМаркировки КАК КодыМаркировки
	|		ПО Товары.Ссылка = КодыМаркировки.Ссылка
	|			И Товары.ИдентификаторТовара = КодыМаркировки.ИдентификаторТовара";
	
	Результат = СтрЗаменить(Результат, "&ТЧКодыМаркировки", ПолноеИмяТаблицы + ".КодыМаркировки");
	Результат = СтрЗаменить(Результат, "&ТЧТовары", ПолноеИмяТаблицы + ".Товары");
	
	Возврат Результат;
	
КонецФункции

// Вызывается из Модуль_ИнтеграцияУниверсальный.РеквизитыДоговора.
