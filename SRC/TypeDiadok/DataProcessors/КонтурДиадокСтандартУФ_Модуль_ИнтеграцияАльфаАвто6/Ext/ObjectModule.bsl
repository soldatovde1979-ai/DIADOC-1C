Функция ВерсияПодсистемыАА()
	
	Результат = "0.0.0.0";
	
	ВозможныеИменаПодсистем = Новый Массив;
	ВозможныеИменаПодсистем.Добавить("Автосалон6");
	ВозможныеИменаПодсистем.Добавить("Автосалон6Базовая");
	
	Для Каждого ИмяПодсистемы Из ВозможныеИменаПодсистем Цикл
		
		ПодсистемаАА = ОбновлениеИнформационнойБазы.ВерсияИБ(ИмяПодсистемы);
		Если ПодсистемаАА <> "0.0.0.0" Тогда
			Результат = ПодсистемаАА;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
