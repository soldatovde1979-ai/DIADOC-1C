Процедура ЗаполнитьИнформациюОбОрганизации155(СведенияОбОрганизации, РеквизитыОрганизации, Организация, ДатаДокумента)
	
	СведенияОбОрганизации.Ссылка = Организация;
	СведенияОбОрганизации.Name	 = РеквизитыОрганизации.НаименованиеДляПечатныхФорм;
	СведенияОбОрганизации.Inn	 = РеквизитыОрганизации.ИНН;
	СведенияОбОрганизации.Kpp	 = РеквизитыОрганизации.КПП;
	СведенияОбОрганизации.Okpo	 = РеквизитыОрганизации.КодПоОкпо;
	СведенияОбОрганизации.Phone	 = РеквизитыОрганизации.Телефоны;
	
	СведенияОбОрганизации.BankAccountNumber		 = СокрЛП(РеквизитыОрганизации.НомерСчета);
	СведенияОбОрганизации.BankId				 = СокрЛП(РеквизитыОрганизации.БИК);
	СведенияОбОрганизации.BankName				 = СокрЛП(РеквизитыОрганизации.Банк);
	
	СведенияОбОрганизации.CorrespondentAccount = РеквизитыОрганизации.КоррСчет;
	СведенияОбОрганизации.Email = РеквизитыОрганизации.Email;
	
	ТипЮрФизЛица = РеквизитыОрганизации.ТипЮрФизЛица;
	Если ТипЮрФизЛица = ТипЮрФизЛица_ЮридическоеЛицо() Тогда
		СведенияОбОрганизации.Type = "LegalEntity";
	ИначеЕсли ТипЮрФизЛица = ТипЮрФизЛица_ФизическоеЛицо() Тогда
		СведенияОбОрганизации.Type = "IndividualEntity";
	Иначе
		СведенияОбОрганизации.Type = "ForeignEntity";
	КонецЕсли;
	
	Если СведенияОбОрганизации.Type = "IndividualEntity" Тогда
		
		Если ДатаДокумента >= ДатаРедакции425() Тогда
			
			РеквизитыИП = ЗначенияРеквизитовОбъектаЛокальная(Организация, "ОГРН,ДатаРегистрации");
			
			СведенияОбОрганизации.IndividualEntityRegistrationCertificate = СтрокаНомерСВ_2026(
				РеквизитыИП.ОГРН,
				РеквизитыИП.ДатаРегистрации
			);
			
		Иначе
			СведенияОбОрганизации.IndividualEntityRegistrationCertificate = РеквизитыОрганизации.Свидетельство;
		КонецЕсли;
		
	КонецЕсли;
	
	ПредставлениеАдреса = РеквизитыОрганизации.ЮридическийАдрес;
	ЗначенияПолейАдреса = РеквизитыОрганизации.ЗначенияПолейЮридическийАдрес;
	
	МенеджерИнтеграции_ЗаполнитьАдресУчастникаЭДО(СведенияОбОрганизации.Address, ПредставлениеАдреса, ЗначенияПолейАдреса);
	
КонецПроцедуры

