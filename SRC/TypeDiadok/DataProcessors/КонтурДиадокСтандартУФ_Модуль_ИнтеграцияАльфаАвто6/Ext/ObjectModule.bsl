	Результат = Новый Структура;
	Результат.Вставить("ХозОперация", ХозяйственнаяОперацияАктСверкиВзаиморасчетов());
	
	Возврат Результат;
	
КонецФункции

Функция ДоговорПоСтрокеАктаСверки(ДанныеДокумента, РеквизитыДоговора)
	
	ВидДоговора = Неопределено;
	
	Если РеквизитыДоговора.Описание = "С покупателем" Тогда
		ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
	ИначеЕсли РеквизитыДоговора.Описание = "С поставщиком" Тогда
		ВидДоговора = Перечисления.ВидыДоговоров.Покупка;
	КонецЕсли;
		
	ДоговорКонтрагента = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Если ВидДоговора = Неопределено Тогда
		
		Возврат ДоговорКонтрагента;
		
	КонецЕсли;
		
	ДоговорКонтрагента = ОбработкаРеквизитовДокументаСервер.ПолучитьДоговорВзаиморасчетов(ДанныеДокумента.Контрагент, ВидДоговора);
		
	Возврат ДоговорКонтрагента;
	
КонецФункции

Функция ИспользоватьЗаполнениеАктаСверкиПоДаннымОрганизации()
	
	Версия = ВерсияПодсистемыАА();
	Результат = (СравнитьВерсии(Версия, "6.0.39.08") >= 0);
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураЗаполненияАктаСверкиВзаиморасчетов(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияАктСверкиВзаиморасчетов();
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗаполнятьПоСтуктуре", Истина);	
	ДанныеЗаполнения.Вставить("ХозОперация", ПараметрыЗаполнения.ХозОперация);
	
	// Стороны сверки
	ДобавитьОрганизацию(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьКонтрагента(ДанныеЗаполнения, ШапкаЭД);
	ДобавитьПодразделениеКомпании(ДанныеЗаполнения);
	ДобавитьДоговорВзаиморасчетов(ДанныеЗаполнения);
	
	//// Валюта
	ЗаполнитьДанныеВалютыАктСверки(ДанныеЗаполнения, ШапкаЭД);

	// Даты сверки, суммы
	ОстатокНаНачало = ИтогиЭД.СальдоНачДеб - ИтогиЭД.СальдоНачКр;
	
	ДанныеЗаполнения.Вставить("ДатаНачала", ШапкаЭД.ДатаНачала);
	ДанныеЗаполнения.Вставить("ДатаОкончания", ШапкаЭД.ДатаОкончания);
	ДанныеЗаполнения.Вставить("ОстатокНаНачало", ОстатокНаНачало);
	
	ТаблицаПоДаннымКонтрагента = Документы.АктСверкиВзаиморасчетов.ПустаяСсылка().ПоДаннымКонтрагента.ВыгрузитьКолонки();
	
	// Табличная часть ПоДаннымКонтрагента
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				СтрокаПоДаннымКонтрагента = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.ДоговорВзаиморасчетов = ДоговорПоСтрокеАктаСверки(ДанныеЗаполнения, СтрокаДоговора);
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.Дата;
				СтрокаПоДаннымКонтрагента.Представление = СтрокаОперации.Наименование;
				СтрокаПоДаннымКонтрагента.УвеличениеДолга = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.УменьшениеДолга = СтрокаОперации.СуммаКредит;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", ДанныеЗаполнения);
	ДанныеОбъекта.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция СформироватьПараметрыЗаполненияДокумента(ДокументОбъект)
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Организация", ДокументОбъект.Организация);
	ПараметрыВыполненияКоманды.Вставить("ДоговорВзаиморасчетов", ДокументОбъект.ДоговорВзаиморасчетов);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПараметрыВыполненияКоманды", ПараметрыВыполненияКоманды);
	
	ОписаниеКоманды = Новый Структура;
	ОписаниеКоманды.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	ПараметрыКоманды = Новый Структура;
	ПараметрыКоманды.Вставить("ОписаниеКоманды", ОписаниеКоманды);
	ПараметрыКоманды.Вставить("Источник", ДокументОбъект);
	
	Возврат ПараметрыКоманды;
	
КонецФункции

Процедура ЗаполнитьАктСверкиВзаиморасчетов(ДокументОбъект, ДанныеДокумента)
	
	Шапка = ДанныеДокумента.Шапка;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка);
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ДокументОбъект.ПоДаннымКонтрагента.Загрузить(ДанныеДокумента.ПоДаннымКонтрагента);
	
	ПараметрыКоманды = СформироватьПараметрыЗаполненияДокумента(ДокументОбъект);
	
	Если ИспользоватьЗаполнениеАктаСверкиПоДаннымОрганизации() Тогда
		
		ПараметрыКоманды.Вставить("ДоговорВзаиморасчетов", ДокументОбъект.ДоговорВзаиморасчетов);
		ПараметрыКоманды.Вставить("Организация", ДокументОбъект.Организация);
		
		Документы.АктСверкиВзаиморасчетов.ПоДаннымОрганизацииЗаполнитьПоВзаиморасчетам(ДокументОбъект, ПараметрыКоманды);
		
	КонецЕсли;
	
	ДокументОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	
КонецПроцедуры

#КонецОбласти

#Область ПодготовкаДанныхЗаполнения

Процедура ДобавитьВалюту(ЗначенияЗаполнения, ШапкаЭД)
	
	ЗначенияЗаполнения.Вставить("ВалютаДокумента"	, ШапкаЭД.Валюта.Ссылка);
	ЗначенияЗаполнения.Вставить("Курс"			, ШапкаЭД.Курс);
	ЗначенияЗаполнения.Вставить("Кратность"		, ШапкаЭД.Кратность);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеВалютыАктСверки(ЗначенияЗаполнения, ШапкаЭД)
	
	Валюта = ШапкаЭД.Валюта.Ссылка;
	
	Курс = 1;
	
	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ШапкаЭД.Дата);
	
	Если ЗначениеЗаполнено(КурсВалюты.Курс) Тогда
		Курс = КурсВалюты.Курс;
	КонецЕсли;
	
	ЗначенияЗаполнения.Вставить("ВалютаДокумента"	, Валюта);
	ЗначенияЗаполнения.Вставить("КурсДокумента", Курс);
	
КонецПроцедуры

Процедура ДобавитьДатуНомерВходящего(ЗначенияЗаполнения, ШапкаЭД)
	
	ЗначенияЗаполнения.Вставить("ВхДокНомер"	, ШапкаЭД.Номер);
	ЗначенияЗаполнения.Вставить("ВхДокДата"	, ШапкаЭД.Дата);
	
КонецПроцедуры

Процедура ДобавитьРеквизитыИсправления(ЗначенияЗаполнения, ШапкаЭД)
	
	ЗначенияЗаполнения.Вставить("Исправление", Ложь);
	
	НомерИсправления = СвойствоСтруктуры(ШапкаЭД, "НомерИсправления");
	
	Если ЗначениеЗаполнено(НомерИсправления) Тогда
		
		ЗначенияЗаполнения.Исправление = Истина;
		ЗначенияЗаполнения.Вставить("НомерИсправления", НомерИсправления);
		ЗначенияЗаполнения.Вставить("ДатаИсправления", ШапкаЭД.ДатаИсправления);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОрганизацию(ЗначенияЗаполнения, ШапкаЭД)
	
	Если ШапкаЭД.Свойство("Покупатель") Тогда
		
		ЗначенияЗаполнения.Вставить("Организация", ШапкаЭД.Покупатель.Ссылка);
		
	Иначе
		
		ЗначенияЗаполнения.Вставить("Организация", ШапкаЭД.Получатель.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКонтрагента(ЗначенияЗаполнения, ШапкаЭД)
	
	Если ШапкаЭД.Свойство("Продавец") Тогда
		
		ЗначенияЗаполнения.Вставить("Контрагент", ШапкаЭД.Продавец.Ссылка);
		
	Иначе
		
		ЗначенияЗаполнения.Вставить("Контрагент", ШапкаЭД.Отправитель.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПодразделениеКомпании(ЗначенияЗаполнения)
	
	ПодразделениеКомпании	 = Неопределено;
	Организация				 = ЗначенияЗаполнения.Организация;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ПодразделениеКомпании = ПервоеПодразделениеОрганизации(Организация);
	КонецЕсли;
	
	ЗначенияЗаполнения.Вставить("ПодразделениеКомпании", ПодразделениеКомпании);
	
КонецПроцедуры

Процедура ДобавитьСкладКомпании(ЗначенияЗаполнения)
	
	Организация = ЗначенияЗаполнения.Организация;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	
	Подразделение = СвойствоСтруктуры(ЗначенияЗаполнения, "ПодразделениеКомпании");
	ЗначенияЗаполнения.Вставить("СкладКомпании", ПервыйСкладОрганизации(Организация, Подразделение));
	
КонецПроцедуры

Процедура ДобавитьДоговорВзаиморасчетов(ЗначенияЗаполнения)
	
	Контрагент = ЗначенияЗаполнения.Контрагент;
	Организация = ЗначенияЗаполнения.Организация;
	Подразделение = СвойствоСтруктуры(ЗначенияЗаполнения, "ПодразделениеКомпании");
	
	Договор = ПервыйДоговорВзаиморасчетов(Контрагент, Организация, Подразделение);
	
	ЗначенияЗаполнения.Вставить("ДоговорВзаиморасчетов", Договор);
	
КонецПроцедуры

Процедура ПерезаполнениеЗначенийРеквизитовШапки(ТекущийОбъект, ЗначенияЗаполнения)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ОбъектМетаданных = ТекущийОбъект.Метаданные();
	
	Для Каждого Строка Из ЗначенияЗаполнения Цикл
		
		ЕстьРеквизит = ЕстьРеквизитМетаданных(ОбъектМетаданных, Строка.Ключ) Или ЕстьОбщийРеквизит(ОбъектМетаданных, Строка.Ключ);
		
		Если ЗначениеЗаполнено(Строка.Ключ) И ЕстьРеквизит Тогда
			Если ТекущийОбъект[Строка.Ключ] <> Строка.Значение Тогда
				ТекущийОбъект[Строка.Ключ] = Строка.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныеЧасти(Товары, КодыМаркировки, ТоварнаяЧастьЭД)
	
	Для Каждого Стр Из ТоварнаяЧастьЭД Цикл
		
		НоваяСтрока = Товары.Добавить();
		
		ИдентификаторСтроки = НовыйИдентификаторСтроки();
		
		ЗаполнитьИдентификаторТовара(НоваяСтрока, ИдентификаторСтроки);
		
		ЗаполнитьНоменклатуруПоставщика(НоваяСтрока, Стр.НоменклатураКонтрагента);
		
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, Стр.Номенклатура);
		
		ЗаполнитьНомерГТД(НоваяСтрока, Стр.ДанныеГТД);
		
		ЗаполнитьКоличествоЦенуСуммыНалоги(НоваяСтрока, Стр);
		
		ЗаполнитьКодыМаркировки(
			КодыМаркировки,
			ИдентификаторСтроки,
			Стр.СведенияОМаркировке,
			Стр.НоменклатураКонтрагента.GTIN)
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныеЧастиКорректировкиПоступления(Товары, КодыМаркировки, ТоварнаяЧастьЭД)
	
	Для Каждого Стр Из ТоварнаяЧастьЭД Цикл
		
		НоваяСтрока = Товары.Добавить();
		
		ИдентификаторСтроки = НовыйИдентификаторСтроки();
		
		ЗаполнитьИдентификаторТовара(НоваяСтрока, ИдентификаторСтроки);
		
		ЗаполнитьНоменклатуруПоставщика(НоваяСтрока, Стр.НоменклатураКонтрагента);
		
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, Стр.Номенклатура);
		
		ЗаполнитьНомерГТД(НоваяСтрока, Стр.ДанныеГТД);
		
		ЗаполнитьКоличествоЦенуСуммыНалогиКорректировкиПоступления(НоваяСтрока, Стр);
		
		ЗаполнитьКодыМаркировки(КодыМаркировки
			, ИдентификаторСтроки
			, Стр.СведенияОМаркировке)
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныеЧастиИсправленияПоступления(Товары, КодыМаркировки, ТоварнаяЧастьЭД)
	
	Для Каждого Стр Из ТоварнаяЧастьЭД Цикл
		
		НоваяСтрока = Товары.Добавить();
		
		ИдентификаторСтроки = НовыйИдентификаторСтроки();
		
		ЗаполнитьИдентификаторТовара(НоваяСтрока, ИдентификаторСтроки);
		
		ЗаполнитьНоменклатуруПоставщика(НоваяСтрока, Стр.НоменклатураКонтрагента);
		
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, Стр.Номенклатура);
		
		ЗаполнитьНомерГТД(НоваяСтрока, Стр.ДанныеГТД);
		
		ЗаполнитьКоличествоЦенуСуммыНалогиИсправленияПоступления(НоваяСтрока, Стр);
		
		ЗаполнитьКодыМаркировки(
			КодыМаркировки,
			ИдентификаторСтроки,
			Стр.СведенияОМаркировке,
			Стр.НоменклатураКонтрагента.GTIN)
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИдентификаторТовара(НоваяСтрока, ИдентификаторТовара)
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "ИдентификаторТовара") Тогда
		НоваяСтрока.ИдентификаторТовара = ИдентификаторТовара;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруПоставщика(НоваяСтрока, НоменклатураКонтрагента)
	
	Если Не ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "НоменклатураПоставщика") Тогда
		Возврат;
	КонецЕсли;
	
	ВладелецНоменклатуры = НоменклатураКонтрагента.Владелец;
	ИдентификаторНоменклатуры = НоменклатураКонтрагента.Идентификатор;
	НоваяСтрока.НоменклатураПоставщика = НайтиНоменклатуруПоставщика(ВладелецНоменклатуры, ИдентификаторНоменклатуры);
	
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, НоменклатураИБ)
	
	Номенклатура = НоменклатураИБ.Номенклатура;
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыНоменклатуры = Новый Структура;
	РеквизитыНоменклатуры.Вставить("ЕдиницаИзмерения", "ОсновнаяЕдиницаИзмерения");
	РеквизитыНоменклатуры.Вставить("Коэффициент", "ОсновнаяЕдиницаИзмерения.Коэффициент");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛокальная(Номенклатура, РеквизитыНоменклатуры);
	
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.ХарактеристикаНоменклатуры = НоменклатураИБ.Характеристика;
	НоваяСтрока.ЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
	НоваяСтрока.Коэффициент = ЗначенияРеквизитов.Коэффициент;
	
КонецПроцедуры

Процедура ЗаполнитьКоличествоЦенуСуммыНалогиКорректировкиПоступления(НоваяСтрока, СтрокаЭД)
	
	НоваяСтрока.Количество							= СтрокаЭД.Количество;
	НоваяСтрока.КоличествоДоКорректировки			= СтрокаЭД.Количество_До;
	НоваяСтрока.КоличествоПоДокументуПоступления	= ?(НоваяСтрока.КоличествоДоКорректировки > 0, НоваяСтрока.КоличествоДоКорректировки, 0);
	НоваяСтрока.КоличествоРазница					= НоваяСтрока.Количество - НоваяСтрока.КоличествоДоКорректировки;
	
	НоваяСтрока.Цена	= СтрокаЭД.Цена;
	НоваяСтрока.Сумма	= СтрокаЭД.СуммаБезНДС;
	
	НоваяСтрока.СуммаНДС						= СтрокаЭД.СуммаНДС;
	НоваяСтрока.СуммаНДСДоКорректировки			= СтрокаЭД.СуммаНДС_До;
	НоваяСтрока.СуммаНДСПоДокументуПоступления	= ?(НоваяСтрока.СуммаНДСДоКорректировки > 0, НоваяСтрока.СуммаНДСДоКорректировки, 0);
	НоваяСтрока.СуммаНДСРазница					= НоваяСтрока.СуммаНДС - НоваяСтрока.СуммаНДСДоКорректировки;
	
	НоваяСтрока.СуммаВсего							= СтрокаЭД.СуммаСНДС;
	НоваяСтрока.СуммаВсегоДоКорректировки			= СтрокаЭД.СуммаСНДС_До;
	НоваяСтрока.СуммаВсегоПоДокументуПоступления	= ?(НоваяСтрока.СуммаВсегоДоКорректировки>0, НоваяСтрока.СуммаВсегоДоКорректировки, 0);
	НоваяСтрока.СуммаВсегоРазница					= СтрокаЭД.СуммаСНДС - СтрокаЭД.СуммаСНДС_До;
	
	ПредставлениеСтавки = СтрокаЭД.НоменклатураКонтрагента.СтавкаНДС;
	НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
	
	Если НоваяСтрока.КоличествоПоДокументуПоступления > 0 Тогда
		ПредставлениеСтавкиДо = СтрокаЭД.НоменклатураКонтрагента_До.СтавкаНДС;
		НоваяСтрока.СтавкаНДСПоДокументуПоступления = ЗначениеСтавкиНДС(ПредставлениеСтавкиДо);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКоличествоЦенуСуммыНалогиИсправленияПоступления(НоваяСтрока, СтрокаЭД)
	
	НоваяСтрока.Количество	= СтрокаЭД.Количество;
	НоваяСтрока.Цена		= СтрокаЭД.Цена;
	НоваяСтрока.Сумма		= СтрокаЭД.СуммаБезНДС;	
	НоваяСтрока.СуммаНДС	= СтрокаЭД.СуммаНДС;
	НоваяСтрока.СуммаВсего	= СтрокаЭД.СуммаСНДС;

	ПредставлениеСтавки = СтрокаЭД.НоменклатураКонтрагента.СтавкаНДС;
	НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
	
КонецПроцедуры

Процедура ЗаполнитьКоличествоЦенуСуммыНалоги(НоваяСтрока, СтрокаЭД)
	
	НоваяСтрока.Количество = СтрокаЭД.Количество;
	НоваяСтрока.Цена = СтрокаЭД.Цена;
	НоваяСтрока.Сумма = СтрокаЭД.СуммаБезНДС;
	НоваяСтрока.СуммаНДС = СтрокаЭД.СуммаНДС;
	НоваяСтрока.СуммаВсего = СтрокаЭД.СуммаСНДС;
	
	ПредставлениеСтавки = СтрокаЭД.НоменклатураКонтрагента.СтавкаНДС;
	НоваяСтрока.СтавкаНДС = ЗначениеСтавкиНДС(ПредставлениеСтавки);
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировки(ШтрихкодыУпаковок, ИдентификаторТовара, СведенияОМаркировке, GTIN = "")
	
	Если ШтрихкодыУпаковок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(GTIN)
		И ЗначениеЗаполнено(СведенияОМаркировке.КоличествоТовараВУпаковке) Тогда
		
		КоличествоТовараВУпаковке = СведенияОМаркировке.КоличествоТовараВУпаковке;

		ЗначениеШтрихкода = НовыйКодОСУ(GTIN, КоличествоТовараВУпаковке);
		
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ИдентификаторТовара = ИдентификаторТовара;
		НоваяСтрока.КодМаркировки = ЗначениеШтрихкода;

	КонецЕсли;

	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ИдентификаторТовара = ИдентификаторТовара;
		НоваяСтрока.КодМаркировки		= ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ИндивидуальныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ИдентификаторТовара = ИдентификаторТовара;
		НоваяСтрока.КодМаркировки		= ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ТранспортныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ИдентификаторТовара = ИдентификаторТовара;
		НоваяСтрока.КодМаркировки		= ЗначениеШтрихкода;
	КонецЦикла;
	
КонецПроцедуры

Функция НовыйКодОСУ(GTIN, Количество)
	
	КоличествоСтрокой = XMLСтрока(Цел(Количество));
	
	Результат = "02" + GTIN + "37"+КоличествоСтрокой;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьНомерГТД(НоваяСтрока, ДанныеГТД)
	
	Если Не ЗначениеЗаполнено(ДанныеГТД) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "ГТД") Тогда
		Возврат;
	КонецЕсли;
	
	СведенияТД = ДанныеГТД[0];
	
	НомерТаможеннойДекларации = СведенияТД.НомерГТД.РегистрационныйНомер;
	КодСтраны = СведенияТД.СтранаПроисхождения.Код;
	
	НоваяСтрока.ГТД = НайтиСоздатьНомерГТД(НомерТаможеннойДекларации, КодСтраны);
	
КонецПроцедуры

