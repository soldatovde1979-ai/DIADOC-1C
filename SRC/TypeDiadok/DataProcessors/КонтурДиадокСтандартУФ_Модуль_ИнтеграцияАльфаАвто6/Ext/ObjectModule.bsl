Функция ТекстЗапросаТЧ_ВыбратьДанныеТабличныхЧастей()
	
	Результат =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка,
	|	ТЧ.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТЧ.ПорядокТабличнойЧасти КАК ПорядокТабличнойЧасти,
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	&НоменклатураТип КАК НоменклатураТип,
	|	ТЧ.Номенклатура.Код КАК НоменклатураКод,
	|	ЕСТЬNULL(ТЧ.Номенклатура.Артикул, """") КАК НоменклатураАртикул,
	|	ТЧ.Номенклатура.НаименованиеПолное КАК НоменклатураНаименование,
	|	ТЧ.Характеристика КАК Характеристика,
	|	ТЧ.Характеристика.Наименование КАК ХарактеристикаНаименование,
	|	&УпаковкаСсылка КАК Упаковка,
	|	&ЕдиницаИзмеренияСсылка КАК ЕдиницаИзмерения,
	|	&ЕдиницаИзмеренияКод КАК ЕдиницаИзмеренияКод,
	|	&ЕдиницаИзмеренияНаименование КАК ЕдиницаИзмеренияНаименование,
	|	ТЧ.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТЧ.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	ТЧ.НомерГТД КАК НомерГТД,
	|	ТЧ.НомерГТД.Наименование КАК РегистрационныйНомерГТД,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаБезНДС КАК СуммаБезНДС,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ТЧ.СуммаСНДС КАК СуммаСНДС,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТЧ.ДокументОтгрузки КАК ДокументОтгрузки
	|ИЗ
	|	ДанныеТабличныхЧастей КАК ТЧ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ПорядокТабличнойЧасти,
	|	НомерСтроки";
	
	ПсевдонимТаблицыТовары = "ТЧ";
	
	Результат = СтрЗаменить(Результат, "&НоменклатураТип", ВыражениеНоменклатураТип(ПсевдонимТаблицыТовары));
	
	Результат = СтрЗаменить(Результат, "&УпаковкаСсылка", ВыражениеУпаковка(ПсевдонимТаблицыТовары));
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияСсылка", ВыражениеЕдиницаИзмерения(ПсевдонимТаблицыТовары));
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияКод", ВыражениеЕдиницаИзмеренияКод(ПсевдонимТаблицыТовары));
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияНаименование", ВыражениеЕдиницаИзмеренияНаименование(ПсевдонимТаблицыТовары));
	
	Возврат Результат;
	
КонецФункции

