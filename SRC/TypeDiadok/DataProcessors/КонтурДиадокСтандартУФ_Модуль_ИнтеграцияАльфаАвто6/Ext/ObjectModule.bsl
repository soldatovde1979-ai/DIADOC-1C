Процедура ДобавитьДокументыОснованияВСлужебнуюИнформацию(Контент)
	
	СсылкаНаОбъект = Контент.СлужебнаяИнформация.Ссылка;
	
	Если НЕ ЭтоСчетФактура(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов = ЗначенияРеквизитовОбъектаЛокальная(СсылкаНаОбъект, "ДокументОснование");
	ДокументОснование = СтруктураРеквизитов.ДокументОснование;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ЭтоАванс = ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекНаОплату")
				ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.Выписка");
					
		Если НЕ ЭтоАванс Тогда
		
			ДокументыОснования = Новый Массив;
			ДокументыОснования.Добавить(ДокументОснование);
			Контент.СлужебнаяИнформация.Вставить("ДокументыОснования", ДокументыОснования);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоСчетФактура(СсылкаНаОбъект)
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	Результат = (ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный"));
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоНакладная(СсылкаНаОбъект) Экспорт
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(Тип("ДокументСсылка.РеализацияАвтомобилей"));
	ПодходящиеТипы.Добавить(Тип("ДокументСсылка.РеализацияАктивов"));
	ПодходящиеТипы.Добавить(Тип("ДокументСсылка.РеализацияТоваров"));
	
	Результат = (ПодходящиеТипы.Найти(ТипСсылки) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетНаОплату(СсылкаНаОбъект) Экспорт
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	
	ПодходящиеТипы = Новый Массив;
	ПодходящиеТипы.Добавить(Тип("ДокументСсылка.СчетНаОплату"));
