Функция ШапкаУчетногоДокумента(СсылкаНаОбъект)
	
	ПсевдонимТаблицы = "";
	
	Реквизиты = Новый Структура;
	
	Реквизиты.Вставить("Организация");
	Реквизиты.Вставить("ГоловнаяОрганизация", ВыражениеГоловнаяОрганизация(ПсевдонимТаблицы));
	Реквизиты.Вставить("БанковскийСчетОрганизации", "НЕОПРЕДЕЛЕНО");
	
	Реквизиты.Вставить("Контрагент");
	Реквизиты.Вставить("ГоловнойКонтрагент", ВыражениеГоловнойКонтрагент(ПсевдонимТаблицы));
	Реквизиты.Вставить("БанковскийСчетКонтрагента", "НЕОПРЕДЕЛЕНО");
	
	Реквизиты.Вставить("ОснованиеПередачи", "ДоговорВзаиморасчетов");
	Реквизиты.Вставить("ОснованиеПередачиВид", """Договор""");
	Реквизиты.Вставить("ОснованиеПередачиДата", "ДоговорВзаиморасчетов.ДатаНачала");
	Реквизиты.Вставить("ОснованиеПередачиНомер", "ДоговорВзаиморасчетов.НомерДоговора");
	Реквизиты.Вставить("ОснованиеПередачиНаименование", "ДоговорВзаиморасчетов.Наименование");
	
	Реквизиты.Вставить("Валюта", "ВалютаДокумента");
	Реквизиты.Вставить("ВалютаКод", "ВалютаДокумента.Код");
	Реквизиты.Вставить("ВалютаНаименование", "ВалютаДокумента.Наименование");
	
	Реквизиты.Вставить("Курс", "КурсДокумента");
	Реквизиты.Вставить("РасчетыВУсловныхЕдиницах", "ЛОЖЬ");
	
	Реквизиты.Вставить("ИдентификаторГосударственногоКонтракта", ВыражениеИдентификаторГосударственногоКонтракта(СсылкаНаОбъект));
	
	Реквизиты.Вставить("Дата");
	Реквизиты.Вставить("Номер");
	
	Реквизиты.Вставить("ЭтоАванс", "ЛОЖЬ");
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Реквизиты.ЭтоАванс = ВыражениеЭтоСчетФактураНаАванс(ПсевдонимТаблицы);
	КонецЕсли;
	
	Результат  = ЗначенияРеквизитовОбъектаЛокальная(СсылкаНаОбъект, Реквизиты); 
	
	ДополнитьДополнительнымиРеквизитамиИСведениями(Результат, СсылкаНаОбъект);
	
	Результат.Вставить("ОписаниеДокумента"	, МенеджерИнтеграции_ОписаниеПрикладногоДокумента(СсылкаНаОбъект));
	Результат.Вставить("ДатаНомерДокумента"	, МенеджерИнтеграции_ДатаНомерДокумента(Результат.ОписаниеДокумента));
	
	Возврат Результат;

КонецФункции

Функция ДополнитьДополнительнымиРеквизитамиИСведениями(Шапка, СсылкаНаОбъект)
	
	Подразделение = СсылкаНаОбъект.ПодразделениеКомпании;
	Грузоотправитель = Неопределено;
	Грузополучатель = Неопределено;
	ГрузоотправительИзДанныхДляПечати = Ложь;
	
	СвойстваНеобходимыеПриВыгрузке = Новый Массив(4);
	СвойстваНеобходимыеПриВыгрузке[0] = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.Грузоотправитель;
	СвойстваНеобходимыеПриВыгрузке[1] = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.Грузополучатель;
	СвойстваНеобходимыеПриВыгрузке[2] = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.Доверенность;
	СвойстваНеобходимыеПриВыгрузке[3] = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаОтгрузки;
	
	ЗначенияСвойств = УправлениеСвойствами.ПолучитьЗначенияСвойств(
			СсылкаНаОбъект,
			Истина,
			Истина,
			СвойстваНеобходимыеПриВыгрузке
		);
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СсылкаНаОбъект, "Грузоотправитель") Тогда
		Грузоотправитель = СсылкаНаОбъект.Грузоотправитель;
		ГрузоотправительИзДанныхДляПечати = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Грузоотправитель) Тогда
		Грузоотправитель = УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства(
				"Грузоотправитель",
				ЗначенияСвойств,
				Подразделение);
		
		ГрузоотправительИзДанныхДляПечати = Ложь;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СсылкаНаОбъект, "Грузополучатель") Тогда
		Грузополучатель = СсылкаНаОбъект.Грузополучатель;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Грузополучатель) Тогда
		Грузополучатель = УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства(
				"Грузополучатель",
				ЗначенияСвойств);
	КонецЕсли;
	
	ДатаОтгрузки = УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("ДатаОтгрузки", ЗначенияСвойств);
	Доверенность = УправлениеСвойствамиПлатформа.ПолучитьЗначениеСвойства("Доверенность", ЗначенияСвойств);
	
	ГлавныйБухгалтер = УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(СсылкаНаОбъект, "ГлавныйБухгалтер");
	Руководитель = УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(СсылкаНаОбъект, "Руководитель");
	Отпустил = УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(СсылкаНаОбъект, "Отпустил");
	Получил = УправлениеПечатьюПлатформа.ДанныеОтветственногоЛица(СсылкаНаОбъект, "ПолучилКонтрагент", "Получил");
	
	Шапка.Вставить("Грузоотправитель", Грузоотправитель);
	Шапка.Вставить("ГрузоотправительИзДанныхДляПечати", ГрузоотправительИзДанныхДляПечати);
	Шапка.Вставить("Грузополучатель", Грузополучатель);
	Шапка.Вставить("ДатаОтгрузки", ДатаОтгрузки);
	Шапка.Вставить("ГлавныйБухгалтер", ГлавныйБухгалтер);
	Шапка.Вставить("Руководитель", Руководитель);
	Шапка.Вставить("Отпустил", Отпустил);
	Шапка.Вставить("Получил", Получил);
	Если ЗначениеЗаполнено(Доверенность) Тогда
		Шапка.Вставить("Доверенность", Доверенность);
	КонецЕсли;
	
	Возврат Шапка;
	
КонецФункции

Функция ПолучитьВидКИ(СсылкаНаОбъект, ЮрАдрес = Истина) Экспорт
	
	ВидАдреса = Неопределено;
	
	ТипОбъекта = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипОбъекта = Тип("СправочникСсылка.Организации") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресОрганизации", "ФактАдресОрганизации");
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресКонтрагента", "ФактАдресКонтрагента");
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресПодразделенияКомпании", "ФактАдресПодразделенияКомпании");
		
	Иначе 
		ВызватьИсключение НСтр("ru = 'Некорректный параметр функции ""ПолучитьВидКИ""'");
	КонецЕсли;
	
	Результат = Справочники.ВидыКонтактнойИнформации[ВидАдреса];
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляФормированияУПД(СсылкаНаОбъект)
	
	Шапка = ШапкаУчетногоДокумента(СсылкаНаОбъект);
	Товары = ТабличнаяЧастьДокумента(СсылкаНаОбъект);
	ДокументыОснования = Неопределено;
	ПРД = ПлатежноРасчетныеДокументы(СсылкаНаОбъект);
	КодыМаркировки = Неопределено;
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", Шапка);
	Результат.Вставить("Товары", Товары);
	Результат.Вставить("ДокументыОснования", ДокументыОснования);
	Результат.Вставить("ПРД", ПРД);
	Результат.Вставить("КодыМаркировки", КодыМаркировки);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеДляФормированияУКД(ДокСсылка, ДопПараметры)
		
	Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "КСЧФ" Тогда
		
		СчетФактура 	 = ДокСсылка;
		ТаблицаНакладных = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокСсылка);
		Накладная		 = ТаблицаНакладных[0].Ссылка;
		
	Иначе
		
		СчетФактура = Неопределено;
		Накладная	= ДокСсылка;
		
		ТаблицаНакладных = Новый ТаблицаЗначений;
		ТаблицаНакладных.Колонки.Добавить("Ссылка");
		ТаблицаНакладных.Колонки.Добавить("Дата");
		ТаблицаНакладных.Колонки.Добавить("Договор");
		
		НоваяСтрока = ТаблицаНакладных.Добавить();
		НоваяСтрока.Ссылка  = Накладная;
		НоваяСтрока.Дата  	= Накладная.Дата;
		НоваяСтрока.Договор = Накладная.ДоговорВзаиморасчетов;

	КонецЕсли;
	
	Шапка = ШапкаУчетногоДокумента(ДокСсылка);
	ТабличнаяЧасть = ТабличнаяЧастьДокументаУКД(Накладная);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	Шапка.Вставить("Функция", ?(ДопПараметры.ФункцияУПД = "КСЧФДИС", "InvoiceAndBasic", ?(ДопПараметры.ФункцияУПД = "КСЧФ", "Invoice", "Basic")));
	
	Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "ДИС" Тогда
		ДатаУведомления = ТаблицаНакладных[0].Дата;
		Если ДатаУведомления <> Шапка.Дата Тогда
			Шапка.Вставить("ДатаУведомления", ДатаУведомления);
		КонецЕсли;
	КонецЕсли;
	
	Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(Накладная), "СопроводительныеДокументы") Тогда
		Шапка.Вставить("ИныеСведенияОбИзмененииСтоимости", Накладная.СопроводительныеДокументы);
	КонецЕсли;
	
	РеквизитыПередаточныхДокументов 	= Новый Массив;
	ДобавленныеПередаточныеДокументы	= Новый Соответствие;
	
	ТипПередаточногоДокумента = "УПД "; 
	
	Шапка.Вставить("ОснованияПередачи", Новый Массив);
	Шапка.Вставить("ПередаточныеДокументы", Новый Массив);
	
	ДобавленныеОснования = Новый Соответствие;
	
	Для Каждого СтрокаТЗ Из ТаблицаНакладных Цикл
		
		СтруктураОснования = ЗаполнитьСтруктуруОснования(СтрокаТЗ.Договор, Истина);
	
		Если ЗначениеЗаполнено(СтруктураОснования.GroundDate) И ЗначениеЗаполнено(СтруктураОснования.GroundName) Тогда
			
			Если ДобавленныеОснования[СтруктураОснования.Основание] <> Истина Тогда
				
				ДобавленныеОснования.Вставить(СтруктураОснования.Основание, Истина);
				
				ItemCorrectionBases = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CorrectionBase");
				ItemCorrectionBases.BaseDocumentName   = СтруктураОснования.GroundName;
				ItemCorrectionBases.BaseDocumentNumber = СокрЛП(СтруктураОснования.GroundNumber);
				ItemCorrectionBases.BaseDocumentDate   = СтруктураОснования.GroundDate;
				
				Шапка.ОснованияПередачи.Добавить(ItemCorrectionBases);
				
			КонецЕсли;
			
		КонецЕсли;
	
		ИсправляемыйДокументРеализации = ПолучитьИсправляемыйДокументРеализации(СтрокаТЗ.Ссылка);
			
		Если ДопПараметры.ФункцияУПД = "КСЧФДИС" Или ДопПараметры.ФункцияУПД = "КСЧФ" Тогда 
			
			ПередаточныйДокумент = ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ИсправляемыйДокументРеализации);
			
		Иначе
			ПередаточныйДокумент = ИсправляемыйДокументРеализации;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПередаточныйДокумент)
			Или ДобавленныеПередаточныеДокументы[ПередаточныйДокумент] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Шапка.ПередаточныеДокументы.Добавить(ПередаточныйДокумент);
		
		ДобавленныеПередаточныеДокументы.Вставить(ПередаточныйДокумент, Истина);
		
		Новый_BaseDocument = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_BaseDocumentName");
		
		Новый_BaseDocument.BaseDocumentName		= ТипПередаточногоДокумента;
		Новый_BaseDocument.BaseDocumentNumber 	= ПредставлениеНомераОбъекта(ПередаточныйДокумент);
		Новый_BaseDocument.BaseDocumentDate 	= Формат(ПередаточныйДокумент.Дата, "ДФ=dd.MM.yyyy");
		
		РеквизитыПередаточныхДокументов.Добавить(Новый_BaseDocument);
								
	КонецЦикла;
	
	Шапка.Вставить("РеквизитыПередаточныхДокументов", РеквизитыПередаточныхДокументов);
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", 			Шапка);
	Результат.Вставить("ТабличнаяЧасть", 	ТабличнаяЧасть);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомераОбъекта(СсылкаНаОбъект)
	
	РеквизитыОбъекта = Новый Структура;
	РеквизитыОбъекта.Вставить("Номер");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛокальная(СсылкаНаОбъект, РеквизитыОбъекта);
	
	Результат = ПредставлениеНомера(ЗначенияРеквизитов.Номер);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьСтруктуруОснования(ДоговорКонтрагента, ЭтоУПД)
	
	Ground = Новый Структура;
	Ground.Вставить("GroundName", 	"");
	Ground.Вставить("GroundNumber", "");
	Ground.Вставить("GroundDate", 	"");
	Ground.Вставить("Основание", 	"");
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
			
		Если ЭтоУПД Тогда
			ПредставлениеДоговора= "Договор";
		Иначе
			ПредставлениеДоговора= ДоговорКонтрагента.Наименование;
		КонецЕсли;
			
		Ground.Вставить("GroundName", 	ПредставлениеДоговора);
		Ground.Вставить("GroundNumber", ДоговорКонтрагента.НомерДоговора);
		Ground.Вставить("GroundDate", 	ДоговорКонтрагента.ДатаНачала);
		Ground.Вставить("Основание", 	ДоговорКонтрагента);
		
	КонецЕсли;
	
	Возврат Ground;
	
КонецФункции

Функция ПолучитьИсправляемыйДокументРеализации(ДокРеализации)
	
	Если Не ЗначениеЗаполнено(ДокРеализации) Тогда 
		
		Результат = Неопределено;
		
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Результат = ПолучитьИсправляемыйДокументРеализации(ДокРеализации.ДокументОснование);
		
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.ВозвратОтПокупателя")
			И ТипЗнч(ДокРеализации.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваров") Тогда
		
		Результат = ДокРеализации.ДокументОснование;
					
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
		
		// Корректировка реализации может быть сформирована на основании счета-фактуры, 
		// если этот счет-фактура был выписан посредником (через отчет комиссионера о продажах)
		Накладные = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокРеализации);
		
		Если Накладные.Количество() > 0 Тогда 
			Результат = Накладные[0].Ссылка;
		КонецЕсли;
		
	Иначе
		
		Результат = ДокРеализации;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧастьДокумента(СсылкаНаОбъект)
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	ДокументОснование = Неопределено;
	
	ЧастиЗапроса = Новый Массив;
	ИндивидуальныйЗапрос = Ложь;
	
	Если ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_СчетФактураВыданный();
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РеализацияТоваров") Тогда
		
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_РеализацияТоваров();
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РеализацияАвтомобилей") Тогда
		
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_РеализацияАвтомобилей();
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РеализацияАктивов") Тогда
		
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_РеализацияАктивов();
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ЗаказНаряд") Тогда
		
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_ЗаказНаряд();
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЧекНаОплату") Тогда
		
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_ЧекНаОплату();
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда

		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_КорректировкаРеализации();
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.КорректировкаРеализацииАвтомобилей") Тогда
		
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		ТекстЗапроса_ПоместитьДанныеТЧ = ТекстЗапросаТЧ_КорректировкаРеализацииАвтомобилей();	
		ИндивидуальныйЗапрос = Истина;
		
	Иначе
		
		Ошибка = СтрШаблон("Невозможно получить табличную часть документа (%1)", СсылкаНаОбъект);
		ВызватьИсключение Ошибка;
		
	КонецЕсли;

	Если ИндивидуальныйЗапрос Тогда 
		ТекстЗапроса = ТекстЗапроса_ПоместитьДанныеТЧ;
	Иначе
		ЧастиЗапроса.Добавить(ТекстЗапроса_ПоместитьДанныеТЧ);
		ЧастиЗапроса.Добавить(РазделительПакетаЗапросов());
		ЧастиЗапроса.Добавить(ТекстЗапросаТЧ_ВыбратьДанныеТабличныхЧастей());
		ЧастиЗапроса.Добавить(РазделительПакетаЗапросов());
		ЧастиЗапроса.Добавить(ТекстЗапросаТЧ_УничтожитьДанныеТабличныхЧастей());
		
		ТекстЗапроса = СтрСоединить(ЧастиЗапроса);
	КонецЕсли;	
	
	ВалютаРегл = ВалютаРеглУчета();
	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаРегл, СсылкаНаОбъект.Дата);
	КоэффициентПересчета = КурсВалюты.Курс / КурсВалюты.Кратность;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("КоэффициентПересчета", КоэффициентПересчета);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧастьДокументаУКД(СсылкаНаОбъект)

	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
	
	Если ТипСсылки = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		ТекстЗапроса = ТекстЗапросаТЧ_УКД_КорректировкаРеализации();
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.КорректировкаРеализацииАвтомобилей") Тогда
		
		ТекстЗапроса = ТекстЗапросаТЧ_УКД_КорректировкаРеализацииАвтомобилей();
		
	Иначе
		
		Ошибка = СтрШаблон("Невозможно получить табличную часть документа (%1)", СсылкаНаОбъект);
		ВызватьИсключение Ошибка;
		
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции	

Функция ТекстЗапросаТЧ_СчетФактураВыданный()
	
	Результат =
	"ВЫБРАТЬ
	|	ПередаточныйДокументТовары.Номенклатура КАК Номенклатура,
	|	ПередаточныйДокументТовары.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ПередаточныйДокументТовары.ИдентификаторТовара КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ИдентификаторыНоменклатуры
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК ПередаточныйДокументТовары
	|ГДЕ
	|	ПередаточныйДокументТовары.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетФактураТовары.Ссылка КАК Ссылка,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	0 КАК ПорядокТабличнойЧасти,
	|	СчетФактураТовары.НомерСтроки КАК НомерСтроки,
	|	СчетФактураТовары.Номенклатура КАК Номенклатура,
	|	СчетФактураТовары.ХарактеристикаНоменклатуры КАК Характеристика,
	|	СчетФактураТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(СчетФактураТовары.ГТД.Страна, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхождения,
	|	СчетФактураТовары.ГТД КАК НомерГТД,
	|	СчетФактураТовары.Количество КАК Количество,
	|	ЕСТЬNULL(СчетФактураРеквизиты.ТипЦен.ЦенаВключаетНДС, ЛОЖЬ) КАК ЦенаВключаетНДС,
	|	СчетФактураТовары.Цена КАК Цена,
	|	СчетФактураТовары.СуммаВсего - СчетФактураТовары.СуммаНДС КАК СуммаБезНДС,
	|	СчетФактураТовары.СуммаНДС КАК СуммаНДС,
	|	СчетФактураТовары.СуммаВсего КАК СуммаСНДС,
	|	СчетФактураТовары.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ИдентификаторСтроки, """") КАК ИдентификаторСтроки,
	|	&ДокументОснование КАК ДокументОтгрузки
	|ПОМЕСТИТЬ ДанныеТабличныхЧастей
	|ИЗ
	|	Документ.СчетФактураВыданный.Товары КАК СчетФактураТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИдентификаторыНоменклатуры КАК ИдентификаторыНоменклатуры
	|		ПО СчетФактураТовары.Номенклатура = ИдентификаторыНоменклатуры.Номенклатура
	|			И СчетФактураТовары.ХарактеристикаНоменклатуры = ИдентификаторыНоменклатуры.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураРеквизиты
	|		ПО СчетФактураТовары.Ссылка = СчетФактураРеквизиты.Ссылка
	|ГДЕ
	|	СчетФактураТовары.Ссылка = &СсылкаНаОбъект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ИдентификаторыНоменклатуры";
	
	Возврат Результат;
	
КонецФункции

