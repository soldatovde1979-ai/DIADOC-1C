Функция ПервоеПодразделениеОрганизации(Организация)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПодразделенияКомпании.Ссылка КАК Подразделение
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	НЕ ПодразделенияКомпании.ПометкаУдаления
	|	И ПодразделенияКомпании.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение ИЕРАРХИЯ УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Неопределено;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Подразделение;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПервыйСкладОрганизации(Организация, Подразделение = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВсеСклады.Ссылка КАК Склад
	|ИЗ
	|	Справочник.СкладыКомпании КАК ВсеСклады
	|ГДЕ
	|	НЕ ВсеСклады.ПометкаУдаления
	|	И ВсеСклады.Организация = &Организация
	|	И (&БезОтбораПоПодразделению
	|			ИЛИ ВсеСклады.ПодразделениеКомпании = &Подразделение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад ИЕРАРХИЯ УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("БезОтбораПоПодразделению", Не ЗначениеЗаполнено(Подразделение));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Неопределено;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Склад;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПервыйДоговорВзаиморасчетов(Контрагент, Организация, Подразделение = Неопределено)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВсеДоговоры.Ссылка КАК Договор
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ВсеДоговоры
	|ГДЕ
	|	НЕ ВсеДоговоры.ПометкаУдаления
	|	И ВсеДоговоры.Владелец = &Контрагент
	|	И ВсеДоговоры.Организация = &Организация
	|	И (&БезОтбораПоПодразделению
	|			ИЛИ ВсеДоговоры.ПодразделениеКомпании = &Подразделение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договор УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("БезОтбораПоПодразделению", Не ЗначениеЗаполнено(Подразделение));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Неопределено;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Договор;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомера(НомерОбъекта)
	
	ВыводитьПолныйНомерНаПечать = Константы.ПолныйНомерДокументаВПечатныхФормах.Получить();
	
	Если ВыводитьПолныйНомерНаПечать Тогда
		
		Возврат НомерОбъекта;
		
	КонецЕсли;
	
	Если ЭтоРедакция6_1() Тогда
		
		МенеджерПрефиксации = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовКлиентСервер");
		Результат = МенеджерПрефиксации.НомерНаПечать(НомерОбъекта, Истина, Истина);
		
	Иначе
		
		МенеджерПрефиксации = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовПлатформа");
		Результат = МенеджерПрефиксации.ПолучитьНомерНаПечать(НомерОбъекта, Истина, Ложь);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодчиненныйСчетФактура(ДокументОснование)
	
	Результат = Неопределено;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СФ.Ссылка КАК Ссылка,
	|	СФ.Проведен КАК Проведен,
	|	СФ.Номер КАК Номер,
	|	СФ.Дата КАК Дата
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СФ
	|ГДЕ
	|	СФ.ДокументОснование = &ДокументОснование
	|	И НЕ СФ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Проведен УБЫВ,
	|	Дата УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МетаСчетаНаОплату(СсылкаНаОбъект)
	
	Результат = Новый Структура;
	Результат.Вставить("СуммаСНалогом", 0);
	Результат.Вставить("СуммаНалога", 0);
	Результат.Вставить("СуммаБезНалога", 0);
	Результат.Вставить("ЕстьНалог", Ложь);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.СуммаВсего КАК СуммаСНалогом,
	|	ТЧ.СуммаНДС КАК СуммаНалога,
	|	ВЫБОР
	|		КОГДА ТЧ.СтавкаНДС <> &Ставка_БезНДС
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьНалог
	|ПОМЕСТИТЬ ПоказателиСчетаНаОплату
	|ИЗ
	|	Документ.СчетНаОплату.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.СуммаВсего,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.СтавкаНДС <> &Ставка_БезНДС
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|ИЗ
	|	Документ.СчетНаОплату.Автоработы КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.СуммаВсего,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.СтавкаНДС <> &Ставка_БезНДС
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|ИЗ
	|	Документ.СчетНаОплатуЗаАвтомобили.Автомобили КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.СуммаВсего,
	|	ТЧ.СуммаНДС,
	|	ВЫБОР
	|		КОГДА ТЧ.СтавкаНДС <> &Ставка_БезНДС
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|ИЗ
	|	Документ.СчетНаОплатуЗаАвтомобили.Товары КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ.СуммаСНалогом) КАК СуммаСНалогом,
	|	СУММА(ВТ.СуммаНалога) КАК СуммаНалога,
	|	МАКСИМУМ(ВТ.ЕстьНалог) КАК ЕстьНалог
	|ИЗ
	|	ПоказателиСчетаНаОплату КАК ВТ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("Ставка_БезНДС", МенеджерИнтеграции_СтавкаБезНДС());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
		Результат.СуммаБезНалога = Результат.СуммаСНалогом - Результат.СуммаНалога;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

