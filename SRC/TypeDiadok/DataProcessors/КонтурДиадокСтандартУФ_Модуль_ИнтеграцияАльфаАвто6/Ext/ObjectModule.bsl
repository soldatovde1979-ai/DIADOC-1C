Функция РеквизитыОрганизацииКонтрагента(ЮрФизЛицо, Знач Период = '00010101', Знач БанковскийСчет = Неопределено)
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		БанковскийСчет = БанковскийСчетПоУмолчанию(ЮрФизЛицо);
	КонецЕсли;
	
	ЭтоПодразделение = ЭтоПодразделениеКомпании(ЮрФизЛицо);
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("НаименованиеПолное");
	Реквизиты.Вставить("ИНН");
	Реквизиты.Вставить("КПП");
	Реквизиты.Вставить("ФормаСобственности");
	
	Если ЭтоПодразделение Тогда
		Реквизиты.ИНН = "Организация.ИНН";
		Реквизиты.ФормаСобственности = "Организация.ФормаСобственности";
	КонецЕсли;
	
	Результат = ЗначенияРеквизитовОбъектаЛокальная( ЮрФизЛицо, Реквизиты); 
	
	Если ЭтоРедакция6_1() Тогда
		МенеджерРеквизитовИстории = ОбщегоНазначения.ОбщийМодуль("РеквизитыСИсторией");
	Иначе
		МенеджерРеквизитовИстории = ОбщегоНазначения;
	КонецЕсли;
	
	Результат.КПП = МенеджерРеквизитовИстории.ПолучитьКППНаДату(ЮрФизЛицо, Период);
	
	Если ЭтоПодразделение И Не ЗначениеЗаполнено(Результат.КПП) Тогда
		Результат.КПП = МенеджерРеквизитовИстории.ПолучитьКППНаДату(ЮрФизЛицо.Организация, Период);
	КонецЕсли;
	
	ЮрАдрес = ЮридическийАдресЮрФизЛица(ЮрФизЛицо, Период);
	Если ЗначениеЗаполнено(ЮрАдрес) Тогда
		Результат.Вставить("ЮридическийАдрес", ЮрАдрес.Представление);
		Результат.Вставить("ЗначенияПолейЮридическийАдрес", ЮрАдрес.ЗначенияПолей);
	КонецЕсли;
	
	ФактАдрес = ФактическийАдресЮрФизЛица(ЮрФизЛицо, Период);
	Если ЗначениеЗаполнено(ФактАдрес) Тогда
		Результат.Вставить("ФактическийАдрес", ФактАдрес.Представление);
		Результат.Вставить("ЗначенияПолейФактическийАдрес", ФактАдрес.ЗначенияПолей);
	КонецЕсли;
	
	// Реквизиты счета
	Результат.Вставить("НомерСчета", "");
	Результат.Вставить("БИК", "");
	Результат.Вставить("Банк", "");
	Результат.Вставить("АдресБанка", "");
	Результат.Вставить("КоррСчет", "");
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		РеквизитыСчета = РеквизитыБанковскогоСчета(БанковскийСчет);
		ЗаполнитьЗначенияСвойств(Результат, РеквизитыСчета);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НовыйКонтактнаяИнформация(Представление = Неопределено, ЗначенияПолей = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("Представление", Представление);
	Результат.Вставить("ЗначенияПолей", ЗначенияПолей);
	
	Возврат Результат;
	
КонецФункции

Функция КонтактнаяИнформацияОбъекта(СсылкаНаОбъект, ВидКИ, Знач НаДату = Неопределено)
	
	ОбъектыКИ = Новый Массив;
	ОбъектыКИ.Добавить(СсылкаНаОбъект);
	
	ВидыКИ = Новый Массив;
	ВидыКИ.Добавить(ВидКИ);
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(ОбъектыКИ, , ВидыКИ, НаДату);
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ТаблицаКИ) Тогда
		
		СтрокаКИ = ТаблицаКИ[0];
		Результат = НовыйКонтактнаяИнформация(СтрокаКИ.Представление, СтрокаКИ.ЗначенияПолей);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПодразделениеКомпании(ЮрФизЛицо)
	
	Результат = (ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.ПодразделенияКомпании"));
	Возврат Результат;
	
КонецФункции

Функция ЮридическийАдресЮрФизЛица(ЮрФизЛицо, Знач Период = Неопределено)
	
	ОбъектКИ = ЮрФизЛицо;
	ВидАдреса = ПолучитьВидКИ(ОбъектКИ, Истина);
	Результат = КонтактнаяИнформацияОбъекта(ОбъектКИ, ВидАдреса, Период);
	
	Если Не ЗначениеЗаполнено(Результат)
		И ЭтоПодразделениеКомпании(ЮрФизЛицо) Тогда
		
		ОбъектКИ = ЮрФизЛицо.Организация;
		ВидАдреса = ПолучитьВидКИ(ОбъектКИ, Истина);
		Результат = КонтактнаяИнформацияОбъекта(ОбъектКИ, ВидАдреса, Период);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ФактическийАдресЮрФизЛица(ЮрФизЛицо, Знач Период = Неопределено)
	
	ОбъектКИ = ЮрФизЛицо;
	ВидАдреса = ПолучитьВидКИ(ОбъектКИ, Ложь);
	Результат = КонтактнаяИнформацияОбъекта(ОбъектКИ, ВидАдреса, Период);
	
	Если Не ЗначениеЗаполнено(Результат)
		И ЭтоПодразделениеКомпании(ЮрФизЛицо) Тогда
		
		ОбъектКИ = ЮрФизЛицо.Организация;
		ВидАдреса = ПолучитьВидКИ(ОбъектКИ, Ложь);
		Результат = КонтактнаяИнформацияОбъекта(ОбъектКИ, ВидАдреса, Период);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТелефоныЮрФизЛица(ЮрФизЛицо)
	
	ТребуемыеПараметры = Новый Структура;
	ТребуемыеПараметры.Вставить("ТелефонРабочий", "");
	
	Результат = УправлениеПечатьюПлатформа.ПолучитьПредставлениеСправочника(ЮрФизЛицо, ТребуемыеПараметры);
	
	Возврат Результат;
	
КонецФункции

