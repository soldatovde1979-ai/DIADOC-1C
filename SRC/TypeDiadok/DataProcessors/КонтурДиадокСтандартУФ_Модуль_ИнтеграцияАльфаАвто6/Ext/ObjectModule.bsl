Функция ВыражениеНоменклатураТип(ПсевдонимТаблицы = "")
	
	ВидыТоваров = Новый Массив;
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Тара)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Шины)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Диски)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.НомерныеАгрегаты)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.ЛКМ)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Опции)");
	ВидыТоваров.Добавить("ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Автомобили)");
	
	ВидыТоваровСтрокой = СтрСоединить(ВидыТоваров, ",");
	
	Результат =
	"ВЫБОР
	|	КОГДА ТИПЗНАЧЕНИЯ(ПсевдонимТаблицы.Номенклатура) = ТИП(Справочник.Автомобили)
	|		ТОГДА &ТипНоменклатурыТовар
	|	КОГДА ТИПЗНАЧЕНИЯ(ПсевдонимТаблицы.Номенклатура) = ТИП(Справочник.Автоработы)
	|		ТОГДА &ТипНоменклатурыРабота
	|	КОГДА ПсевдонимТаблицы.Номенклатура.ВидНоменклатуры В(&ВидыТоваров)
	|		ТОГДА &ТипНоменклатурыТовар
	|	ИНАЧЕ &ТипНоменклатурыУслуга
	|КОНЕЦ";
	
	Результат = СтрЗаменить(Результат, "&ВидыТоваров", ВидыТоваровСтрокой);
	Результат = СтрЗаменить(Результат, "&ТипНоменклатурыТовар", """" + ТипНоменклатурыТовар() + """");
	Результат = СтрЗаменить(Результат, "&ТипНоменклатурыУслуга", """" + ТипНоменклатурыУслуга() + """");
	Результат = СтрЗаменить(Результат, "&ТипНоменклатурыРабота", """" + ТипНоменклатурыРабота() + """");
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеУпаковка(ПсевдонимТаблицы = "", ПсевдонимПоляЕдиница = "ЕдиницаИзмерения")
	
	Результат =
	"ВЫБОР
	|	КОГДА ТИПЗНАЧЕНИЯ(ПсевдонимТаблицы.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|		ТОГДА ПсевдонимТаблицы.ЕдиницаИзмерения
	|	ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)
	|КОНЕЦ";
	
	Результат = СтрЗаменить(Результат, "ПсевдонимТаблицы.ЕдиницаИзмерения", "ПсевдонимТаблицы." + ПсевдонимПоляЕдиница);
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеЕдиницаИзмерения(ПсевдонимТаблицы = "", ПсевдонимПоляЕдиница = "ЕдиницаИзмерения")
	
	Результат =
	"ВЫБОР
	|	КОГДА ТИПЗНАЧЕНИЯ(ПсевдонимТаблицы.ЕдиницаИзмерения) = ТИП(Справочник.КлассификаторЕдиницИзмерения)
	|		ТОГДА ПсевдонимТаблицы.ЕдиницаИзмерения
	|	КОГДА ТИПЗНАЧЕНИЯ(ПсевдонимТаблицы.ЕдиницаИзмерения) = ТИП(Справочник.ЕдиницыИзмерения)
	|		ТОГДА ЕСТЬNULL(ПсевдонимТаблицы.ЕдиницаИзмерения.ЕдиницаПоКлассификатору, &ЕдиницаИзмеренияПустая)
	|	КОГДА ТИПЗНАЧЕНИЯ(ПсевдонимТаблицы.ЕдиницаИзмерения) = ТИП(Справочник.Нормочасы)
	|		ТОГДА &ЕдиницаИзмеренияЧас
	|	ИНАЧЕ &ЕдиницаИзмеренияПустая
	|КОНЕЦ";
	
	Результат = СтрЗаменить(Результат, "ПсевдонимТаблицы.ЕдиницаИзмерения", "ПсевдонимТаблицы." + ПсевдонимПоляЕдиница);
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияПустая", "ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)");
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияЧас", "ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.Час)");
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

