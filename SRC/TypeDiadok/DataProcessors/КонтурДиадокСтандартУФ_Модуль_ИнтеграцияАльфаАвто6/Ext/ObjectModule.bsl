Функция ТекстЗапросаТЧ_УКД_КорректировкаРеализации()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПередаточныйДокументТовары.Номенклатура КАК Номенклатура,
	|	ПередаточныйДокументТовары.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ПередаточныйДокументТовары.ИдентификаторТовара КАК ИдентификаторСтроки,
	|	ПередаточныйДокументТовары.ГТД КАК ГТД
	|ПОМЕСТИТЬ ИдентификаторыНоменклатуры
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК ПередаточныйДокументТовары
	|ГДЕ
	|	ПередаточныйДокументТовары.Ссылка = &ДокументОснование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПередаточныйДокументАвтоработы.Авторабота,
	|	НЕОПРЕДЕЛЕНО,
	|	ПередаточныйДокументАвтоработы.ИдентификаторРаботы,
	|	НЕОПРЕДЕЛЕНО
	|ИЗ
	|	Документ.ЗаказНаряд.Автоработы КАК ПередаточныйДокументАвтоработы
	|ГДЕ
	|	ПередаточныйДокументАвтоработы.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка КАК Ссылка,
	|	""Товары"" КАК ИмяТабличнойЧасти,
	|	0 КАК ПорядокТабличнойЧасти,
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Номенклатура.Код КАК НоменклатураКод,
	|	ТЧ.ХарактеристикаНоменклатуры КАК Характеристика,
	|	&УпаковкаСсылка КАК Упаковка,
	|	&ЕдиницаИзмеренияСсылка КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ГТД.Страна, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ГТД, ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка)) КАК ГТД,
	|	ТЧ.Количество КАК Количество,
	|	ЛОЖЬ КАК ЦенаВключаетНДС,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаВсего - ТЧ.СуммаНДС КАК СуммаБезНДС,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ТЧ.СуммаВсего КАК СуммаСНДС,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ТЧ.ИдентификаторТовара КАК ИдентификаторСтроки,
	|	ТЧ.Ссылка КАК ДокументОтгрузки,
	|	ПРЕДСТАВЛЕНИЕ(ТЧ.Номенклатура) КАК НоменклатураПредставление,
	|	ТЧ.Номенклатура.Код КАК КодНоменклатуры,
	|	ИСТИНА КАК СуммаВключаетНДС,
	|	ТЧ.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга) КАК ЭтоУслуга,
	|	ТЧ.ЕдиницаИзмерения.Вес * ТЧ.Количество КАК Масса,
	|	ТЧ.ЕдиницаИзмерения КАК ВидУпаковки,
	|	ТЧ.Коэффициент КАК КоличествоВОдномМесте,
	|	ТЧ.Количество КАК КоличествоМест,
	|	ВЫБОР
	|		КОГДА ТЧ.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)
	|			ТОГДА ""Service""
	|		КОГДА ТЧ.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
	|			ТОГДА ""Property""
	|	КОНЕЦ КАК ПризнакТоварРаботаУслуга,
	|	ТЧ.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код КАК КодЕдиницыИзмерения,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ГТД.Страна, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхожденияДоИзменения,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ГТД, ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка)) КАК НомерГТДДоИзменения,
	|	ТЧ.КоличествоДоКорректировки КАК КоличествоДоИзменения,
	|	&УпаковкаДоИзмененияСсылка КАК УпаковкаДоИзменения,
	|	&ЕдиницаИзмеренияДоИзмененияСсылка КАК ЕдиницаИзмеренияДоИзменения,
	|	ВЫБОР
	|		КОГДА ТЧ.КоличествоДоКорректировки <> 0
	|			ТОГДА ТЧ.СуммаВсегоДоКорректировки / ТЧ.КоличествоДоКорректировки
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЦенаДоИзменения,
	|	ТЧ.СтавкаНДСПоДокументуРеализации КАК СтавкаНДСДоИзменения,
	|	ТЧ.СуммаНДСДоКорректировки КАК СуммаНДСДоИзменения,
	|	ТЧ.СуммаВсего КАК Сумма,
	|	ТЧ.СуммаВсегоДоКорректировки КАК СуммаДоИзменения,
	|	ТЧ.СуммаВсего КАК ВсегоВРубляхДоИзменения,
	|	ТЧ.СуммаНДСДоКорректировки КАК НДСВРубляхДоИзменения,
	|	ИСТИНА КАК СуществуютЗаписиРублевыхСумм,
	|	&НоменклатураТип КАК НоменклатураТип,
	|	ТЧ.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	ТЧ.Номенклатура.НаименованиеПолное КАК НоменклатураНаименование,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ГТД.Страна.Код, """") КАК СтранаПроисхожденияКод,
	|	&ЕдиницаИзмеренияКод КАК ЕдиницаИзмеренияКод,
	|	&ЕдиницаИзмеренияНаименование КАК ЕдиницаИзмеренияНаименование,
	|	ТЧ.СуммаВсего КАК ВсегоВРублях
	|ИЗ
	|	Документ.КорректировкаРеализации.Товары КАК ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИдентификаторыНоменклатуры КАК ИдентификаторыНоменклатуры
	|		ПО ТЧ.Номенклатура = ИдентификаторыНоменклатуры.Номенклатура
	|			И ТЧ.ХарактеристикаНоменклатуры = ИдентификаторыНоменклатуры.Характеристика
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СуммаВсегоРазница <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.Ссылка,
	|	""Автоработы"",
	|	1,
	|	ТЧ.НомерСтроки,
	|	ТЧ.Авторабота,
	|	ТЧ.Авторабота.Код,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.Час),
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка),
	|	ТЧ.Количество,
	|	ЛОЖЬ,
	|	ТЧ.Цена,
	|	ТЧ.СуммаВсего - ТЧ.СуммаНДС,
	|	ТЧ.СуммаНДС,
	|	ТЧ.СуммаВсего,
	|	ТЧ.СтавкаНДС,
	|	НЕОПРЕДЕЛЕНО,
	|	ТЧ.Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ТЧ.Авторабота),
	|	ТЧ.Авторабота.Код,
	|	ИСТИНА,
	|	ИСТИНА,
	|	ТЧ.Количество,
	|	ТЧ.Нормочас,
	|	ТЧ.Коэффициент,
	|	ТЧ.Количество,
	|	""Service"",
	|	""356"",
	|	ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка),
	|	ТЧ.КоличествоДоКорректировки,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.Час),
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.Час),
	|	ВЫБОР
	|		КОГДА ТЧ.КоличествоДоКорректировки <> 0
	|			ТОГДА ТЧ.СуммаВсегоДоКорректировки / ТЧ.КоличествоДоКорректировки
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ТЧ.СтавкаНДСПоДокументуРеализации,
	|	ТЧ.СуммаНДСДоКорректировки,
	|	ТЧ.СуммаВсего,
	|	ТЧ.СуммаВсегоДоКорректировки,
	|	ТЧ.СуммаВсего,
	|	ТЧ.СуммаНДСДоКорректировки,
	|	ИСТИНА,
	|	""Работа"",
	|	ТЧ.Авторабота.Артикул,
	|	ТЧ.Авторабота.НаименованиеПолное,
	|	"""",
	|	""356"",
	|	""ч"",
	|	ТЧ.СуммаВсего
	|ИЗ
	|	Документ.КорректировкаРеализации.Автоработы КАК ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИдентификаторыНоменклатуры КАК ИдентификаторыНоменклатуры
	|		ПО ТЧ.Авторабота = ИдентификаторыНоменклатуры.Номенклатура
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СуммаВсегоРазница <> 0";
	
	ПсевдонимТаблицыТовары = "ТЧ";
	
	Результат = СтрЗаменить(Результат, "&НоменклатураТип", ВыражениеНоменклатураТип(ПсевдонимТаблицыТовары));
	
	Результат = СтрЗаменить(Результат, "&УпаковкаСсылка", ВыражениеУпаковка(ПсевдонимТаблицыТовары, "ЕдиницаИзмерения"));
	Результат = СтрЗаменить(Результат, "&УпаковкаДоИзмененияСсылка", ВыражениеУпаковка(ПсевдонимТаблицыТовары, "ЕдиницаИзмеренияПоДокументуРеализации"));
	
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияСсылка", ВыражениеЕдиницаИзмерения(ПсевдонимТаблицыТовары, "ЕдиницаИзмерения"));
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияДоИзмененияСсылка", ВыражениеЕдиницаИзмерения(ПсевдонимТаблицыТовары, "ЕдиницаИзмеренияПоДокументуРеализации"));
	
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияКод", ВыражениеЕдиницаИзмеренияКод(ПсевдонимТаблицыТовары));
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияНаименование", ВыражениеЕдиницаИзмеренияНаименование(ПсевдонимТаблицыТовары));
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТЧ_УКД_КорректировкаРеализацииАвтомобилей()
	
	Результат =
	"ВЫБРАТЬ
	|	ПередаточныйДокументТовары.Автомобиль КАК Автомобиль,	
	|	ПередаточныйДокументТовары.ИдентификаторАвтомобиля КАК ИдентификаторСтроки	
	|ПОМЕСТИТЬ ИдентификаторыНоменклатуры
	|ИЗ
	|	Документ.РеализацияАвтомобилей.Автомобили КАК ПередаточныйДокументТовары
	|ГДЕ
	|	ПередаточныйДокументТовары.Ссылка = &ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка,
	|	""Автомобили"" КАК ИмяТабличнойЧасти,
	|	0 КАК ПорядокТабличнойЧасти,
	|	ТЧ.НомерСтроки КАК НомерСтроки,
	|	ТЧ.Автомобиль КАК Номенклатура,
	|	ТЧ.Автомобиль.Код КАК НоменклатураКод,
	|	ТЧ.Автомобиль.Код КАК КодНоменклатуры,	
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт) КАК ЕдиницаИзмерения,	
	|	ТЧ.Автомобиль.ГТД КАК НомерГТД,
	|	ТЧ.Автомобиль.ГТД КАК ГТД,	
	|	ЕСТЬNULL(ТЧ.Автомобиль.ГТД.Страна, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхождения,	
	|	ТЧ.Количество КАК Количество,
	|	ЛОЖЬ КАК ЦенаВключаетНДС,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.СуммаВсего - ТЧ.СуммаНДС КАК СуммаБезНДС,
	|	ТЧ.СуммаНДС КАК СуммаНДС,
	|	ТЧ.СуммаВсего КАК СуммаСНДС,
	|	ТЧ.СтавкаНДС КАК СтавкаНДС,
	|	ЕСТЬNULL(ИдентификаторыНоменклатуры.ИдентификаторСтроки,"""") КАК ИдентификаторСтроки,
	|	ТЧ.Ссылка КАК ДокументОтгрузки,
	|	ПРЕДСТАВЛЕНИЕ(ТЧ.Автомобиль) КАК НоменклатураПредставление,
	|	ИСТИНА КАК СуммаВключаетНДС,
	|	Ложь КАК ЭтоУслуга,
	|	0 КАК Масса,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт) КАК ВидУпаковки,
	|	1 КАК КоличествоВОдномМесте,
	|	ТЧ.Количество КАК КоличествоМест,
	|	""Property"" КАК ПризнакТоварРаботаУслуга,
	|	""796"" КАК КодЕдиницыИзмерения,
	|	ЕСТЬNULL(ТЧ.Автомобиль.ГТД.Страна, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхожденияДоИзменения,
	|	ТЧ.Автомобиль.ГТД КАК НомерГТДДоИзменения,
	|	ТЧ.КоличествоПоДокументуРеализации КАК КоличествоДоИзменения,
	|	ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка) КАК УпаковкаДоИзменения,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.шт) КАК ЕдиницаИзмеренияДоИзменения,
	|	ВЫБОР
	|		КОГДА ТЧ.КоличествоПоДокументуРеализации <> 0
	|			ТОГДА ТЧ.СуммаВсегоДоКорректировки / ТЧ.КоличествоПоДокументуРеализации
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЦенаДоИзменения,
	|	ТЧ.СтавкаНДСПоДокументуРеализации КАК СтавкаНДСДоИзменения,
	|	ТЧ.СуммаНДСДоКорректировки КАК СуммаНДСДоИзменения,
	|	ТЧ.СуммаВсего КАК Сумма,
	|	ТЧ.СуммаВсегоДоКорректировки КАК СуммаДоИзменения,
	|	ТЧ.СуммаВсего КАК ВсегоВРубляхДоИзменения,
	|	ТЧ.СуммаНДСДоКорректировки КАК НДСВРубляхДоИзменения,
	|	ИСТИНА КАК СуществуютЗаписиРублевыхСумм,
	|	""Товар"" КАК НоменклатураТип,
	|	ТЧ.Автомобиль.VIN КАК НоменклатураАртикул,
	|	ТЧ.Автомобиль.НаименованиеПолное КАК НоменклатураНаименование,
	|	ЕСТЬNULL(ТЧ.Автомобиль.ГТД.Страна.Код, """") КАК СтранаПроисхожденияКод,
	|	""796"" КАК ЕдиницаИзмеренияКод,
	|	""шт"" КАК ЕдиницаИзмеренияНаименование,
	|	ТЧ.СуммаВсего КАК ВсегоВРублях
	|ИЗ
	|	Документ.КорректировкаРеализацииАвтомобилей.Автомобили КАК ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИдентификаторыНоменклатуры КАК ИдентификаторыНоменклатуры
	|		ПО ТЧ.Автомобиль = ИдентификаторыНоменклатуры.Автомобиль
	
	|ГДЕ
	|	ТЧ.Ссылка = &СсылкаНаОбъект
	|	И ТЧ.СуммаВсегоРазница <> 0";
	
	
	ПсевдонимТаблицыТовары = "ТЧ";
	
	Результат = СтрЗаменить(Результат, "&НоменклатураТип", ВыражениеНоменклатураТип(ПсевдонимТаблицыТовары));
	
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияКод", ВыражениеЕдиницаИзмеренияКод(ПсевдонимТаблицыТовары));
	Результат = СтрЗаменить(Результат, "&ЕдиницаИзмеренияНаименование", ВыражениеЕдиницаИзмеренияНаименование(ПсевдонимТаблицыТовары));
	
	Возврат Результат;
	
КонецФункции

