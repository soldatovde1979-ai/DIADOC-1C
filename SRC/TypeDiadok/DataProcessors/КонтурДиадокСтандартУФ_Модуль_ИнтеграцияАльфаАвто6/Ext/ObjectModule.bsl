Процедура ЗаполнитьКонтентXmlUTD(Прото, СсылкаНаОбъект, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ОписаниеФормата = ПараметрыФормирования.ФорматОтправки;
	
	МенеджерИнтеграции_ЗаполнитьНаименованиеФункцию155(Прото, ОписаниеФормата);
	
	ДанныеДокумента = ДанныеДляФормированияУПД(СсылкаНаОбъект);
	Шапка	= ДанныеДокумента.Шапка;
	Товары	= ДанныеДокумента.Товары;
	ПРД		= ДанныеДокумента.ПРД;
	
	ОписаниеДокумента	= Шапка.ОписаниеДокумента;
	ЭтоИсправление		= ОписаниеДокумента.ЭтоИсправление;
	
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	ЗаполнитьДатуНомер155(Прото, ДатаНомер, ЭтоИсправление);
		
	СтрокиСТоварами = Товары.НайтиСтроки(Новый Структура("НоменклатураТип", ТипНоменклатурыТовар()));
	ЕстьТовары = ЗначениеЗаполнено(СтрокиСТоварами);
	ЗаполнитьСведенияОбУчастниках155(Прото, Шапка, ЕстьТовары);
	
	ИдентификаторПродавца = ПараметрыФормирования.Отправитель_FnsParticipantId;
	УстановитьИдентификаторПродавца155(Прото, ИдентификаторПродавца);
	
	ИдентификаторПокупателя = ПараметрыФормирования.Получатель_FnsParticipantId;
	УстановитьИдентификаторПокупателя155(Прото, ИдентификаторПокупателя);
	
	ЗаполнитьСведенияОСоставителе155(Прото, Шапка);
	
	ЗаполнитьПлатежноРасчетныеДокументы155(Прото, ПРД);
	
	ЗаполнитьГосударственныйКонтракт155(Прото, Шапка);
	
	ЗаполнитьВалюту155(Прото, Шапка);
	
	ЗаполнитьСведенияОПередаче155(Прото, Шапка);
	
	ИспользоватьБезДокументаОснования = ПараметрыФормирования.УказыватьОтсутствиеОснованияУПД;
	ЗаполнитьОснованияПередачи155(Прото, Шапка, ИспользоватьБезДокументаОснования);
	
	ЗаполнитьStructedAdditionalInfos(Прото.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	ЗаполнитьТабличнуюЧасть155(Прото, Товары, Шапка.ЭтоАванс, Точность);
	
	ЕстьФункцияПД = (Прото.Function = "InvoiceAndBasic" ИЛИ Прото.Function = "Basic");
	
	Если ЕстьТовары И ЕстьФункцияПД Тогда
		Сотрудник = ПараметрыФормирования.ДанныеСотрудника;
		ЗаполнитьСведенияОЛицеПередавшемТовар155(Прото, Сотрудник);
	КонецЕсли;
	
	МенеджерИнтеграции_ДобавитьСлужебнуюИнформациюВШапку(Прото, Шапка);
	ДобавитьДокументыОснованияВСлужебнуюИнформацию(Прото);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlUCD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеДляПечати = ДанныеДляФормированияУКД(ДокСсылка, Новый Структура("ФункцияУПД", ПараметрыФормирования.ФункцияДокумента));
	
	ШапкаУКД 		= ДанныеДляПечати.Шапка;
	ТаблицаТоваров  = ДанныеДляПечати.ТабличнаяЧасть;
	
	Content.Function = ШапкаУКД.Функция;
	
	Если ШапкаУКД.Функция = "InvoiceAndBasic" Тогда
		Content.Name = "Корректировочный счет-фактура и документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	ИначеЕсли ШапкаУКД.Функция = "Basic" Тогда
		Content.Name = "Документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	КонецЕсли;
	
	ОписаниеДокумента	= ШапкаУКД.ОписаниеДокумента;
	ЭтоИсправление		= ОписаниеДокумента.ЭтоИсправление;
	
	ДатаНомер = ШапкаУКД.ДатаНомерДокумента;
	
	Content.Number	 = ДатаНомер.НомерДокумента;
	Content.Date	 = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	Для каждого ДатаНомерДокументаОснования Из ДатаНомер.ДатаНомерДокументовОснований Цикл
		ЗаполнитьInvoiceForCorrectionInfo(Content.Invoices, ДатаНомерДокументаОснования);
	КонецЦикла;
	
	СтрокиСТоварами	= ТаблицаТоваров.НайтиСтроки(Новый Структура("НоменклатураТип", ТипНоменклатурыТовар()));
	ЕстьТовары		= ЗначениеЗаполнено(СтрокиСТоварами);
	
	ЗаполнитьСведенияОбУчастникахУКД(Content, ШапкаУКД, ЕстьТовары);
	
	ИдентификаторПродавца = ПараметрыФормирования.Отправитель_FnsParticipantId;
	УстановитьИдентификаторПродавца155(Content, ИдентификаторПродавца);
	
	ИдентификаторПокупателя = ПараметрыФормирования.Получатель_FnsParticipantId;
	УстановитьИдентификаторПокупателя155(Content, ИдентификаторПокупателя);
	
	ЗаполнитьСведенияОСоставителе155(Content, ШапкаУКД);
		
	ВалютаРеглУчета = ВалютаРеглУчета();
	
	Content.ВалютаСсылка 	= ?(ШапкаУКД.РасчетыВУсловныхЕдиницах, ВалютаРеглУчета, ШапкаУКД.Валюта);
	Content.Currency 		= ?(ЗначениеЗаполнено(Content.ВалютаСсылка), Строка(Content.ВалютаСсылка.Код), "");
	
	ШапкаУКД.Свойство("ИдентификаторГосконтракта", Content.GovernmentContractInfo);
	
	ЗаполнитьStructedAdditionalInfos(Content.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	ЗаполнитьInvoiceCorrectionTable(Content.InvoiceCorrectionTable, ТаблицаТоваров);
	
	ЗаполнитьEventContent(Content.EventContent, ШапкаУКД);
	
	МенеджерИнтеграции_ДобавитьСлужебнуюИнформациюВШапку(Content, ШапкаУКД);
	
	Content.СлужебнаяИнформация.Вставить("ПередаточныеДокументы", ШапкаУКД.ПередаточныеДокументы);
	
КонецПроцедуры

