Процедура ЗаполнитьТабличнуюЧасть155(Прото, Товары, ЭтоАванс, ТочностьЦены = 2)
	
	ВсеСтроки_СтавкаНДС_БезНДС	 = Истина;
	ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
	
	ВсегоНДС = 0;
	ВсегоСНДС = 0;
	ВсегоБезНДС = 0;
	ВсегоКоличество = 0;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		ПрикладнаяСтавкаНДС = СтрокаТовары.СтавкаНДС;
		
		СтрокаНДСИНА = ЭтоСтавкаНДСИНА(ПрикладнаяСтавкаНДС);
		СтрокаБезНДС = ЭтоСтавкаБезНДС(ПрикладнаяСтавкаНДС);
		
		Если Не СтрокаБезНДС Тогда
			ВсеСтроки_СтавкаНДС_БезНДС = Ложь;
		КонецЕсли;
		
		Если Не СтрокаНДСИНА Тогда
			ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
		КонецЕсли;
		
		Item = НоваяСтрокаТовары155();
		МенеджерИнтеграции_ДобавитьСлужебнуюИнформациюВСтроку(Item, СтрокаТовары);
		
		Item.Product = ПредставлениеНоменклатуры(СтрокаТовары.НоменклатураНаименование, СтрокаТовары.ХарактеристикаНаименование);
		Item.ItemMark = ПризнакНоменклатуры155(СтрокаТовары.НоменклатураТип);
		Item.VendorCode = СокрЛП(СтрокаТовары.НоменклатураКод);
		
		Item.TaxRate = ПредставлениеСтавкиНДС(ПрикладнаяСтавкаНДС);
		
		Если СтрокаНДСИНА Тогда
			
			Item.Vat = 0;
			Item.Subtotal = 0;
			Item.SubtotalWithVatExcluded = СтрокаТовары.СуммаСНДС;
			
		Иначе
			
			Item.Vat = ?(СтрокаБезНДС, Неопределено, СтрокаТовары.СуммаНДС);
			Item.Subtotal = СтрокаТовары.СуммаСНДС;
			Item.SubtotalWithVatExcluded = ?(ЭтоАванс, Неопределено, СтрокаТовары.СуммаБезНДС);
			
		КонецЕсли;
		
		Количество = ?(ЭтоАванс, Неопределено, СтрокаТовары.Количество);
		Цена = Неопределено;
		ЕдиницаИзмерения = Неопределено;
		ЕдиницаИзмеренияКод = Неопределено;
		ЕдиницаИзмеренияНаименование = Неопределено;
		
		Если ЗначениеЗаполнено(Количество) Тогда
			
			ИсключитьИзЦеныНДС = СтрокаТовары.ЦенаВключаетНДС И ЗначениеЗаполнено(СтрокаТовары.СуммаНДС);
			
			Если ИсключитьИзЦеныНДС Тогда
				Цена = СтрокаТовары.СуммаБезНДС / Количество;
			Иначе
				Цена = СтрокаТовары.Цена;
			КонецЕсли;
			
			Цена = Окр(Цена, ТочностьЦены);
			
			Если ЗначениеЗаполнено(СтрокаТовары.ЕдиницаИзмерения) Тогда
				ЕдиницаИзмерения = СтрокаТовары.ЕдиницаИзмерения;
				ЕдиницаИзмеренияКод = МетодСервера(, "XML_КодЕдиницыИзмерения", СокрЛП(СтрокаТовары.ЕдиницаИзмеренияКод));
				ЕдиницаИзмеренияНаименование = СокрЛП(СтрокаТовары.ЕдиницаИзмеренияНаименование);
			КонецЕсли;
			
		КонецЕсли;
		
		Item.Quantity = Количество;
		Item.Price = Цена;
		Item.UnitCode = ЕдиницаИзмеренияКод;
		Item.UnitName = ЕдиницаИзмеренияНаименование;
		Item.ЕдиницаИзмеренияСсылка = ЕдиницаИзмерения; // Для совместимости со старыми ПМ
		
		Если ЗначениеЗаполнено(СтрокаТовары.СтранаПроисхождения) Тогда
			
			CustomDeclaration = МенеджерИнтеграции_Новый_CustomDeclaration();
			
			CustomDeclaration.CountryCode = СокрЛП(СтрокаТовары.СтранаПроисхожденияКод);
			
			Если ЗначениеЗаполнено(СтрокаТовары.РегистрационныйНомерГТД) Тогда
				CustomDeclaration.DeclarationNumber = СтрокаТовары.РегистрационныйНомерГТД;
			КонецЕсли; 
			
			Item.CustomDeclarations.Добавить(CustomDeclaration);
			
		КонецЕсли;
		
		МенеджерИнтеграции_ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТовары);
		Прото.InvoiceTable.Items.Добавить(Item);
		
		ВсегоНДС = ВсегоНДС + СтрокаТовары.СуммаНДС;
		ВсегоБезНДС = ВсегоБезНДС + СтрокаТовары.СуммаБезНДС;
		ВсегоСНДС = ВсегоСНДС + СтрокаТовары.СуммаСНДС;
		
	КонецЦикла;
	
	Если ВсеСтроки_СтавкаНДС_БезНДС Тогда
		ВсегоНДС = Неопределено;
	КонецЕсли;
	
	Если ВсеСтроки_СтавкаНДС_ИсчНалАг Тогда
		ВсегоНДС = 0;
		ВсегоСНДС = 0;
	КонецЕсли;
	
	Если ЭтоАванс Тогда
		ВсегоБезНДС = Неопределено;
	КонецЕсли;
	
	Прото.InvoiceTable.TotalWithVatExcluded = ВсегоБезНДС;
	Прото.InvoiceTable.TotalNet = ВсегоКоличество;
	Прото.InvoiceTable.Total = ВсегоСНДС;
	Прото.InvoiceTable.Vat = ВсегоНДС;
	
КонецПроцедуры

