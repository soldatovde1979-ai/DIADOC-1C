Функция ТекстЗапросаТЧ_РеализацияАктивов()
	
	Результат =
	"ВЫБРАТЬ
	|	Таб.Ссылка КАК Ссылка,
	|	""Активы"" КАК ИмяТабличнойЧасти,
	|	0 КАК ПорядокТабличнойЧасти,
	|	Таб.НомерСтроки КАК НомерСтроки,
	|	Таб.ПрочийАктив.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	Таб.ПрочийАктив.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(Таб.ПрочийАктив.Номенклатура.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхождения,
	|	ЕСТЬNULL(Таб.ПрочийАктив.Номенклатура.ГТД, ЗНАЧЕНИЕ(Справочник.ГТД.ПустаяСсылка)) КАК НомерГТД,
	|	Таб.Количество КАК Количество,
	|	ЛОЖЬ КАК ЦенаВключаетНДС,
	|	ВЫБОР
	|		КОГДА Таб.Количество > 0
	|			ТОГДА (Таб.Сумма - Таб.СуммаНДС) / Таб.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена,
	|	Таб.Сумма - Таб.СуммаНДС КАК СуммаБезНДС,
	|	Таб.СуммаНДС КАК СуммаНДС,
	|	Таб.Сумма КАК СуммаСНДС,
	|	Таб.СтавкаНДС КАК СтавкаНДС,
	|	"""" КАК ИдентификаторСтроки,
	|	Таб.Ссылка КАК ДокументОтгрузки
	|ПОМЕСТИТЬ ДанныеТабличныхЧастей
	|ИЗ
	|	Документ.РеализацияАктивов.Активы КАК Таб
	|ГДЕ
	|	Таб.Ссылка = &СсылкаНаОбъект";
	
	Возврат Результат;
	
КонецФункции

