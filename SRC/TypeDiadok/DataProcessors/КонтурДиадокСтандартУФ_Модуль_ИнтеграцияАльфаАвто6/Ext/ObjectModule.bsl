// См. метод "ПередФормированиемПечатнойФормыСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- см. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	СсылкаНаОбъект = ПараметрыМетодаПечати.МассивОбъектов[0];
	
	ИмяМакета = "ПФ_MXL_СчетНаОплату";
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетНаОплатуЗаАвтомобили") Тогда
		ИмяМакета = "СчетНаОплатуЗаАвтомобили";
	КонецЕсли;
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаНаОбъект);
	
	НовыйЭлементТаблицы = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета 	= ИмяМакета;
	НовыйЭлементТаблицы.ИмяВРЕГ 	= ВРег(НовыйЭлементТаблицы.ИмяМакета);
	
КонецПроцедуры //ПередФормированиемПечатнойФормыСчетаНаОплату()

// См. метод "ПриЗаполненииМетыНеформализованногоСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  СчетНаОплату	- ДокументСсылка	- документ, на основании которого формируем печатную форму
//  Мета			- Структура			- см. метод "НовыйРезультатВизуализацииСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Мета) Экспорт
	
	ПараметрыСчета = МетаСчетаНаОплату(СчетНаОплату);
	
	Мета.Сумма = ПараметрыСчета.СуммаСНалогом;
	Мета.СуммаНДС = ПараметрыСчета.СуммаНалога;
	Мета.ДокументБезНДС = Не ПараметрыСчета.ЕстьНалог;
	
КонецПроцедуры // ПриЗаполненииМетыНеформализованногоСчетаНаОплату()

// См. метод "ПередФормированиемПечатнойФормыСверкиВзаиморасчетов" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- см. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПередФормированиемПечатнойФормыСверкиВзаиморасчетов(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.АктСверкиВзаиморасчетов");
	
	НоваяПФ = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	
	НоваяПФ.ИмяМакета 	= "ПФ_MXL_АктСверки";
	НоваяПФ.ИмяВРЕГ		= ВРЕГ(НоваяПФ.ИмяМакета);
	НоваяПФ.Экземпляров	= 1;
	
КонецПроцедуры //ПередФормированиемПечатнойФормыСверкиВзаиморасчетов()


#Область СопоставлениеНоменклатуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.СвойстваНоменклатурыИнформационнойБазы.
// Определяет свойства набора номенклатур информационной базы.
// Устанавливает обязательность использования характеристик и упаковок номенклатуры.
//
// Параметры:
//  НаборНоменклатуры - Массив из ОпределяемыйТип.НоменклатураБЭД - ссылки на номенклатуру ИБ, для которой требуется определить свойства.
//  СвойстваНоменклатурИБ - Соответствие - содержит:
//  * Ключ     - ОпределяемыйТип.НоменклатураБЭД - ссылка на номенклатуру ИБ.
//  * Значение - Структура                       - содержит свойства номенклатуры ИБ. См. Модуль_ИнтеграцияУниверсальный.НовыеСвойстваНоменклатурыИБ.
//
Процедура ПриОпределенииСвойствНоменклатурыИнформационнойБазы(Знач НаборНоменклатуры, СвойстваНоменклатурИБ) Экспорт
	
	ВариантыИспользованияХарактестик = Новый Массив;
	ВариантыИспользованияХарактестик.Добавить(ВариантИспользованияХарактеристик_ОбщиеДляТипаНоменклатуры());
	ВариантыИспользованияХарактестик.Добавить(ВариантИспользованияХарактеристик_ИндивидуальныеДляНоменклатуры());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ТипыНоменклатуры.ИспользованиеХарактеристик В (&ВариантыИспользованияХарактестик)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИспользоватьХарактеристики,
	|	ИСТИНА КАК ИспользоватьУпаковки,
	|	ИСТИНА КАК ОбязательноеЗаполнениеХарактеристики
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыНоменклатуры КАК ТипыНоменклатуры
	|		ПО Номенклатура.ТипНоменклатуры = ТипыНоменклатуры.Ссылка
	|ГДЕ
	|	Номенклатура.Ссылка В(&НаборНоменклатуры)";
	
	Запрос.УстановитьПараметр("НаборНоменклатуры", НаборНоменклатуры);
	Запрос.УстановитьПараметр("ВариантыИспользованияХарактестик", ВариантыИспользованияХарактестик);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СвойстваНоменклатуры = МенеджерИнтеграции_НовыеСвойстваНоменклатурыИБ();
		ЗаполнитьЗначенияСвойств(СвойстваНоменклатуры, Выборка);
		
		СвойстваНоменклатурИБ.Вставить(Выборка.Номенклатура, СвойстваНоменклатуры);
		
	КонецЦикла;
	
КонецПроцедуры

// Выполняется при подборе недостающих данных о номенклатуре информационной базы по уже имеющимся,
// а также номенклатуре контрагента.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - данные номенклатуры контрагента (см. НоваяНоменклатураКонтрагента)
//  НоменклатураИБ - Структура - данные о номенклатуре информационной базы (имеющиеся или требующие подбора).
//                               См. НоваяНоменклатураИнформационнойБазы.
//
Процедура ПриПодбореНоменклатурыИнформационнойБазы(Знач НоменклатураКонтрагента, НоменклатураИБ) Экспорт
	
	РеквизитыНоменклатуры = Новый Структура;
	РеквизитыНоменклатуры.Вставить("ОсновнаяЕдиницаИзмерения");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛокальная(НоменклатураИБ.Номенклатура, РеквизитыНоменклатуры);
	
	ЕдиницаИзмерения = РеквизитыНоменклатуры.ОсновнаяЕдиницаИзмерения;
	Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
		НоменклатураИБ.Упаковка = ЕдиницаИзмерения;
	КонецЕсли;
	
КонецПроцедуры

// Выполяется при записи соответствия номенклатуры контрагента и номенклатуры информационной базы.
// Позволяет переопределить место хранения соответствия номенклатуры в текущей конфигурации.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - данные номенклатуры контрагента (см. НоваяНоменклатураКонтрагента)
//  НоменклатураИБ - Структура - данные о номенклатуре информационной базы (имеющиеся или требующие подбора).
//                               См. НоваяНоменклатураИнформационнойБазы.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриЗаписиСоответствияНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ЭтоРедакция6_1() Тогда
		ЗаписатьСоответствиеНоменклатурыБЭД(НоменклатураКонтрагента, НоменклатураИБ);
	Иначе 
		ПриЗаписиСоответствияНоменклатуры_Редакция60(НоменклатураКонтрагента, НоменклатураИБ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиСоответствияНоменклатуры_Редакция60(НоменклатураКонтрагента, НоменклатураИБ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.ХарактеристикаНоменклатуры КАК Характеристика,
	|	Т.ЕдиницаИзмерения КАК Упаковка,
	|	Т.Идентификатор КАК Идентификатор,
	|	Т.Владелец КАК Владелец
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Владелец = &Владелец
	|	И Т.Идентификатор = &Идентификатор";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", НоменклатураКонтрагента.Владелец);
	Запрос.УстановитьПараметр("Идентификатор", НоменклатураКонтрагента.Идентификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		
		Запись = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		Запись.УстановитьНовыйКод();
		
	ИначеЕсли Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		
		Запись = Выборка.Ссылка.ПолучитьОбъект();
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Запись.Владелец = НоменклатураКонтрагента.Владелец;
	Запись.Идентификатор = НоменклатураКонтрагента.Идентификатор;
	Запись.Наименование = НоменклатураКонтрагента.Наименование;
	Запись.Артикул = НоменклатураКонтрагента.Артикул;
	
	Запись.Номенклатура = НоменклатураИБ.Номенклатура;
	Запись.ХарактеристикаНоменклатуры = НоменклатураИБ.Характеристика;
	Запись.ЕдиницаИзмерения = НоменклатураИБ.Упаковка;
	
	Запись.ОбменДанными.Загрузка = Истина;
	
	Попытка
		
		Запись.Записать();
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ТекстОшибки = НСтр("ru = 'Не удалось записать элемент справочника ""Номенклатура поставщиков"" по причине:
							|%1'");
		ТекстОшибки = КраткоеПредставлениеОшибки(Ошибка);
		
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаЗагрузка()
			, УровеньЖурналаРегистрации.Ошибка
			, Запись.Метаданные()
			,
			, ТекстОшибки);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

// Выполяется при чтении соответствия номенклатуры контрагента и номенклатуры информационной базы.
//
// Параметры:
//  Результат - Соответствие - (возвращаемый параметр) содержит элементы:
//    * Ключ - Строка - идентификатор номенклатуры контрагента;
//    * Значение - Структура - номенклатура информационной базы (см. НоваяНоменклатураИнформационнойБазы)
//  ВладелецНоменклатуры - ЛюбаяСсылка - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Массив из Строка - идентификаторы номенклатуры контрагентов.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриЧтенииСоответствияНоменклатуры(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ЭтоРедакция6_1() Тогда
		
		ПриЧтенииСоответствияНоменклатуры_6_1(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры);
		
	Иначе
		
		ПриЧтенииСоответствияНоменклатуры_6_0(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЧтенииСоответствияНоменклатуры_6_0(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры)
	
	ТекстЗапроса = ПриЧтенииСоответствияНоменклатуры_ТекстЗапроса60();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", ВладелецНоменклатуры);
	Запрос.УстановитьПараметр("ИдентификаторыНоменклатуры", ИдентификаторыНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоменклатураИБ = МенеджерИнтеграции_НоваяНоменклатураИнформационнойБазы();
		ЗаполнитьЗначенияСвойств(НоменклатураИБ, Выборка);
		Результат.Вставить(Выборка.Идентификатор, НоменклатураИБ);
		
	КонецЦикла;

КонецПроцедуры

Процедура ПриЧтенииСоответствияНоменклатуры_6_1(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры)
	
	Результат = ПрочитатьСоответствиеНоменклатурыБЭД(ВладелецНоменклатуры, ИдентификаторыНоменклатуры);
	
	НесопоставленныеИдентификаторы = Новый Массив;
	Для Каждого Идентификатор Из ИдентификаторыНоменклатуры Цикл
		Если Результат.Получить(Идентификатор) = Неопределено Тогда
			НесопоставленныеИдентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НесопоставленныеИдентификаторы) Тогда
		
		РезультатПереноса = ПеренестиСопоставлениеНоменклатуры_НоменклатураКонтрагентов(ВладелецНоменклатуры, НесопоставленныеИдентификаторы);
		
		Если ЗначениеЗаполнено(РезультатПереноса) Тогда
			Результат = ПрочитатьСоответствиеНоменклатурыБЭД(ВладелецНоменклатуры, ИдентификаторыНоменклатуры);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПеренестиСопоставлениеНоменклатуры_НоменклатураКонтрагентов(ВладелецНоменклатуры, НесопоставленныеИдентификаторы)
	
	Результат = Новый Соответствие;
	
	ПриЧтенииСоответствияНоменклатуры_НоменклатураКонтрагентов(Результат, ВладелецНоменклатуры, НесопоставленныеИдентификаторы);
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Для Каждого ЭлементЗаписи Из Результат Цикл 
			
			КлючевыеПоля = Новый Структура;
			КлючевыеПоля.Вставить("Владелец", ВладелецНоменклатуры);
			КлючевыеПоля.Вставить("Идентификатор", ЭлементЗаписи.Ключ);
			ЗаписатьСоответствиеНоменклатурыБЭД(КлючевыеПоля, ЭлементЗаписи.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат; 

КонецФункции

Процедура ПриЧтенииСоответствияНоменклатуры_НоменклатураКонтрагентов(Результат, ВладелецНоменклатуры, ИдентификаторыНоменклатуры)
	
	ТекстЗапроса = ПриЧтенииСоответствияНоменклатуры_ТекстЗапроса61();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", ВладелецНоменклатуры);
	Запрос.УстановитьПараметр("ИдентификаторыНоменклатуры", ИдентификаторыНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоменклатураИБ = МенеджерИнтеграции_НоваяНоменклатураИнформационнойБазы();
		ЗаполнитьЗначенияСвойств(НоменклатураИБ, Выборка);
		Результат.Вставить(Выборка.Идентификатор, НоменклатураИБ);
		
	КонецЦикла;

КонецПроцедуры

Функция ПриЧтенииСоответствияНоменклатуры_ТекстЗапроса60()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СопоставленнаяНоменклатура.Идентификатор КАК Идентификатор,
	|	СопоставленнаяНоменклатура.Номенклатура КАК Номенклатура,
	|	СопоставленнаяНоменклатура.ХарактеристикаНоменклатуры КАК Характеристика,
	|	СопоставленнаяНоменклатура.ЕдиницаИзмерения КАК Упаковка
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК СопоставленнаяНоменклатура
	|ГДЕ
	|	СопоставленнаяНоменклатура.Владелец = &Владелец
	|	И СопоставленнаяНоменклатура.Идентификатор В(&ИдентификаторыНоменклатуры)
	|	И НЕ СопоставленнаяНоменклатура.ПометкаУдаления";
	
	Возврат Результат;

КонецФункции

Функция ПриЧтенииСоответствияНоменклатуры_ТекстЗапроса61()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СопоставленнаяНоменклатура.ИдентификаторНоменклатуры КАК Идентификатор,
	|	СопоставленнаяНоменклатура.Номенклатура КАК Номенклатура,
	|	СопоставленнаяНоменклатура.Характеристика КАК Характеристика,
	|	СопоставленнаяНоменклатура.Упаковка КАК Упаковка
	|ИЗ
	|	Справочник.НоменклатураКонтрагентов КАК СопоставленнаяНоменклатура
	|ГДЕ
	|	СопоставленнаяНоменклатура.ВладелецНоменклатуры = &Владелец
	|	И СопоставленнаяНоменклатура.ИдентификаторНоменклатуры В(&ИдентификаторыНоменклатуры)
	|	И НЕ СопоставленнаяНоменклатура.ПометкаУдаления";
	
	Возврат Результат;

