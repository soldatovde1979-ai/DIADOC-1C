	ЗаполнитьТабличныеЧастиПоступленияТоваров(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ОтключитьПроверкуЗаполненияОбъекта(ДокументОбъект);
	
КонецПроцедуры

// Заполняет табличные части "Товары" и "КодыМаркировки" в поступлении товаров.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ПоступлениеТоваров - заполняемый документ
//  ДанныеЗаполнения - Структура - см. СтруктураЗаполненияПоступленияТоваров
//
Процедура ЗаполнитьТабличныеЧастиПоступленияТоваров(ДокументОбъект, ДанныеЗаполнения)
	
	ЦенаВключаетНДС = Истина;
	Если ЗначениеЗаполнено(ДокументОбъект.ТипЦен) Тогда
		ЦенаВключаетНДС = ДокументОбъект.ТипЦен.ЦенаВключаетНДС;
	КонецЕсли;
	
	ДокументОбъект.Товары.Очистить();
	Для Каждого СтрокаДанных Из ДанныеЗаполнения.Товары Цикл
		
		НоваяСтрокаТЧ = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаДанных);
		
		Если ЦенаВключаетНДС Тогда
			ЗаполнитьЦенуСуммуСУчетомНДС(НоваяСтрокаТЧ);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументОбъект.КодыМаркировки.Загрузить(ДанныеЗаполнения.КодыМаркировки);
	
КонецПроцедуры

// Перезаполняет цену и сумму в строке ТЧ "Товары" документа "ПоступлениеТоваров"
// с учетом флага "ЦенаВключаетНДС"
//
// Параметры:
//  СтрокаТовары - ДокументТабличнаяЧастьСтрока.ПоступлениеТоваров.Товары - строка поступления товаров.
//
Процедура ЗаполнитьЦенуСуммуСУчетомНДС(СтрокаТовары)
	
	Если Не ЗначениеЗаполнено(СтрокаТовары.СуммаНДС) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТовары.Сумма = СтрокаТовары.СуммаВсего;
	СтрокаТовары.Цена = СтрокаТовары.Сумма;
	Если ЗначениеЗаполнено(СтрокаТовары.Количество) Тогда
		СтрокаТовары.Цена = СтрокаТовары.Сумма / СтрокаТовары.Количество;
	КонецЕсли;
	
КонецПроцедуры

