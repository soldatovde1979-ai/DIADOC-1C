Процедура ЗаполнитьОснованияПередачи155(Прото, Шапка, УказыватьОтсутствиеОснованияУПД)
	
	TransferBase = НовоеОснованиеПередачи155();
	
	Если Не ЗначениеЗаполнено(Шапка.ОснованиеПередачиДата) И УказыватьОтсутствиеОснованияУПД Тогда
		
		TransferBase.DocumentName	= ОснованиеПередачиОтсутвует155();
		TransferBase.DocumentNumber	= "";
		TransferBase.DocumentDate	= Дата(1, 1, 1);
		TransferBase.DocumentInfo	= "";
		
	Иначе
		
		TransferBase.DocumentName	= Шапка.ОснованиеПередачиВид;
		TransferBase.DocumentNumber	= Шапка.ОснованиеПередачиНомер;
		TransferBase.DocumentDate	= Шапка.ОснованиеПередачиДата;
		TransferBase.DocumentInfo	= "";
		
	КонецЕсли;
	
	СлужебнаяИнформация = МенеджерИнтеграции_НоваяСлужебнаяИнформацияОснованияПередачи();
	СлужебнаяИнформация.ОснованиеСсылка = Шапка.ОснованиеПередачи;
	СлужебнаяИнформация.ПредставлениеВТекстеОшибки = "договоре";
	
	ИмяСвойства = МенеджерИнтеграции_ИмяСвойстваСлужебнаяИнформация();
	TransferBase.Вставить(ИмяСвойства, СлужебнаяИнформация);
	
	Прото.TransferInfo.TransferBases.Добавить(TransferBase);
	
