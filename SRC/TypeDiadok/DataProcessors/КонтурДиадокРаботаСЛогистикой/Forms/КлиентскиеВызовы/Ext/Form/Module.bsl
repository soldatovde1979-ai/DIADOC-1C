&НаКлиенте
Функция ИмяМодуляИнтеграцииКлиент()
	
	Возврат "КонтурЛогистика_ИнтеграцияКонтурКлиент";
	
КонецФункции

&НаКлиенте
Функция ОбщийМодульКонтурЛогистикиКлиент()
	
	ИмяМодуля = ИмяМодуляИнтеграцииКлиент();
	
	Результат = Вычислить(ИмяМодуля);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЖурналРегистрации_ЗаписатьОшибку(Знач ИмяСобытия, Знач Комментарий)
	
	ИдентификаторСобытия = "Диадок.ИнтеграцияСЛогистикой." + ИмяСобытия;
	
	ЗаписьЖурналаРегистрации(
		ИдентификаторСобытия,
		УровеньЖурналаРегистрации.Ошибка,
		Неопределено,
		Неопределено,
		Комментарий
	);
	
КонецПроцедуры