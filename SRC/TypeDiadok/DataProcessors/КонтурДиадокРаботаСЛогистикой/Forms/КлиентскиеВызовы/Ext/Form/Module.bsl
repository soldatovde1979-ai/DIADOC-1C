// BSLLS:MissingReturnedValueDescription-off
// Открывает Рабочий стол модуля Логистики
//
// Параметры:
//  Период - СтандартныйПериод - Период для Рабочего стола
//
&НаКлиенте
Функция ОткрытьРабочийСтол(Период) Экспорт
	
	Результат = "";
	
	ОбщийМодульКонтурЛогистики = ОбщийМодульКонтурЛогистикиКлиент();
	
	Попытка
		
		ОбщийМодульКонтурЛогистики.ОткрытьРабочийСтол(Период);
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЖурналРегистрации_ЗаписатьОшибку("ОткрытьРабочийСтол", ТекстОшибки);
		
		Результат = ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Открывает форму с перевозочными документами
//
// Параметры:
//  ФормаВызова		 - Форма	 - Форма, из которой происходит вызов
//  ДокументыУчета	 - Массив	 - Коллекция ссылок на учетные документы пакета
//
&НаКлиенте
Функция ОткрытьПеревозочныеДокументы(ФормаВызова, ДокументыУчета) Экспорт
	
	Результат = "";
	
	ОбщийМодульКонтурЛогистики = ОбщийМодульКонтурЛогистикиКлиент();
	
	Попытка
		
		ОбщийМодульКонтурЛогистики.ПеревозочныеНажатие(ФормаВызова, ДокументыУчета);
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЖурналРегистрации_ЗаписатьОшибку("ПеревозочныеНажатие", ТекстОшибки);
		
		Результат = ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции
