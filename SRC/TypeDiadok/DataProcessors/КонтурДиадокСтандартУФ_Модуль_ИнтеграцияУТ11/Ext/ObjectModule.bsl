КонецПроцедуры

Функция ЮрФизЛицо_АдресЭлектроннойПочты(ЮрФизЛицо, ДатаДокумента, ЭтоОрганизация)
	
	ВидКИ = ?(ЭтоОрганизация
				, Справочники.ВидыКонтактнойИнформации.EmailОрганизации
				, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента);
	
	Результат = ПредставлениеКонтактнойИнформацииОбъекта(ЮрФизЛицо, ВидКИ, , ДатаДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьДанныеДляПечати(ДокументСсылка, ЭтоКСФ)
	
	ЭтоСФ = ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданный");
	ЭтоСФНаАванс = СчетФактуранаАванс(ДокументСсылка);
	
	//сформируем список документов-оснований
	ДокументыОснования = Новый СписокЗначений;
	
	Если ЭтоСФ Тогда
		
		Если ОснованиеСчетаФактурыУказываетсяВТабличнойЧасти() Тогда
			МассивОснований = ОбщегоНазначения.ВыгрузитьКолонку(ДокументСсылка.ДокументыОснования, "ДокументОснование", Истина);
			ДокументыОснования.ЗагрузитьЗначения(МассивОснований);
		Иначе
			ДокументыОснования.Добавить(ДокументСсылка.ДокументОснование);
		КонецЕсли;
		
	Иначе
		ДокументыОснования.Добавить(ДокументСсылка);
	КонецЕсли;
	
	Результат = ДанныеШапки(ДокументСсылка);
	
	ЭтоИСФ = Ложь;
	
	ЭтоИСФ = ЭтоСФ И ЭтоИсправление(ДокументСсылка);
			
	//формируем ТЧ
	Если ЭтоКСФ Тогда 
		
		ДанныеТабличнойЧасти = ТабличнаяЧастьКорректировочногоДокумента(ДокументСсылка);
		
	ИначеЕсли ЭтоИСФ Тогда
		
		ДанныеТабличнойЧасти = ТабличнаяЧастьИсправительногоСчетаФактуры(ДокументСсылка);
		
	Иначе
			
		ДанныеТабличнойЧасти = ПолучитьДанныеТЧ(ДокументыОснования, Неопределено, Неопределено, Истина, ?(ЭтоСФ ИЛИ ЭтоСФНаАванс, ДокументСсылка, Неопределено));
				
	КонецЕсли;
	
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Результат, ДанныеТабличнойЧасти);
	
	//формируем шапку
	Если ЭтоСФ ИЛИ ЭтоСФНаАванс Тогда
		Результат.Вставить("СФНаАванс", ЭтоСФНаАванс);
	КонецЕсли;
	
	Если Результат.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ДанныеТабличнойЧасти);
	КонецЕсли;
	
	ПроверитьЗаполнитьВалюту(Результат);
	
	Результат.Вставить("ТабличнаяЧасть", ТаблицаЗначений_2_МассивСтруктур(ДанныеТабличнойЧасти));
	
	//формируем платежно расчетные документы
	ПлатежноРасчетныеДокументы = ПолучитьПлатежноРасчетныеДокументы(ДокументСсылка, СписокЗначений_В_Массив(ДокументыОснования));
	Результат.Вставить("ДатаНомерДокументовОплаты", ТаблицаЗначений_2_МассивСтруктур(ПлатежноРасчетныеДокументы));
	
	Возврат Результат;
	
КонецФункции

// Возвращает информацию о стране происхождения товара в виде структуры.
//
// Параметры:
//  СтрокаДанных - СтрокаТаблицыЗначений - Строка табличной части Товары.
//
// Возвращаемое значение:
//   Структура - Сведения о стране происхождения товара для поля StructedAdditionalInfo:
//      * СтранаПроисхождения - СправочникСсылка.СтраныМира - Страна происхождения товара.
//      * НомерГТД            - СправочникСсылка.НомераГТД - Номер грузовой таможенной декларации.
//
Функция КоллекцияСведенийОСтранеПроисхождения(СтрокаДанных)
	
	Результат = Новый Структура;
	Результат.Вставить("СтранаПроисхождения"	, СтрокаДанных.СтранаПроисхождения);
	Результат.Вставить("НомерГТД"				, СтрокаДанных.НомерГТД);
	
	Возврат Результат;

КонецФункции

