Функция СтруктураЗаполненияЗаказаПоставщику(ДанныеЭД, ДополнительныеПараметры)
	
	ПустаяСсылкаНаДокумент = Документы.ЗаказПоставщику.ПустаяСсылка();
	
	ШапкаЭД = ДанныеЭД.Шапка;
	
	Контрагент = СсылкаНаУчастникаСделки(ШапкаЭД.Продавец);
	Организация = СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель);
	НомерСчетаОрганизации = ШапкаЭД.Покупатель.НомерСчета;
	БанковскийСчетОрганизации = БанковскийСчетОрганизацииПоНомеру(Организация, НомерСчетаОрганизации);
	
	ОплатаВВалюте = Ложь;
	Если ШапкаЭД.Валюта.Код <> "643" Тогда
		ОплатаВВалюте = Истина;
	КонецЕсли;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("Организация", Организация);
	Шапка.Вставить("Контрагент", Контрагент);
	Шапка.Вставить("Партнер" , ПартнерПоКонтрагенту(Шапка.Контрагент));
	
	Шапка.Вставить("Валюта", ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("ЦенаВключаетНДС", ДополнительныеПараметры.ЦенаВключаетНДС);
	Шапка.Вставить("СуммаВключаетНДС", ДополнительныеПараметры.ЦенаВключаетНДС);
	Шапка.Вставить("СуммаДокумента", ДанныеЭД.Итоги.СуммаСНДС);
	Шапка.Вставить("БанковскийСчет", БанковскийСчетОрганизации);
	Шапка.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика);
	Шапка.Вставить("НомерПоДаннымПоставщика", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаПоДаннымПоставщика", ШапкаЭД.Дата);
	Шапка.Вставить("РегистрироватьЦеныПоставщика", Ложь);
	Шапка.Вставить("ВернутьМногооборотнуюТару", Ложь);
	Шапка.Вставить("СрокВозвратаМногооборотнойТары", 0);
	Шапка.Вставить("ТребуетсяЗалогЗаТару", Ложь);
	Шапка.Вставить("СуммаВозвратнойТары", 0);
	
	// BSLLS:UsingFindElementByString-off
	Шапка.Вставить("Приоритет", Справочники.Приоритеты.НайтиПоНаименованию("Средний"));
	// BSLLS:UsingFindElementByString-on
	
	Шапка.Вставить("СпособДоставки", Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада);
	Шапка.Вставить("ЕстьКиЗГИСМ", Ложь);
