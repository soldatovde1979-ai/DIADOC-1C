// См. метод "ПередФормированиемПечатнойФормыСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- см. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Обработка.ПечатьСчетовНаОплату");
							
	НовыйЭлементТаблицы = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета 	= "СчетНаОплату";
	НовыйЭлементТаблицы.ИмяВРЕГ 	= ВРег(НовыйЭлементТаблицы.ИмяМакета);
	
	ПараметрыОтправки = Новый Структура;
	
	ПараметрыОтправки.Вставить("Получатель"	, "");
	ПараметрыОтправки.Вставить("Тема"		, "");
	ПараметрыОтправки.Вставить("Текст"		, "");
							
	ПараметрыМетодаПечати.ПараметрыВывода.Вставить("ДоступнаПечатьПоКомплектно"	, Ложь);
	ПараметрыМетодаПечати.ПараметрыВывода.Вставить("ПараметрыОтправки"			, ПараметрыОтправки);
	
КонецПроцедуры //ПередФормированиемПечатнойФормыСчетаНаОплату()

// См. метод "ПриЗаполненииМетыНеформализованногоСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  СчетНаОплату	- ДокументСсылка	- документ, на основании которого формируем печатную форму
//  Мета			- Структура			- см. метод "НовыйРезультатВизуализацииСчетаНаОплату" в "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Мета) Экспорт

	ИмяТипаДокумента = СчетНаОплату.Метаданные().Имя;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(СчетНаОплату);
	
	СтруктураДанныхДляПечати = Документы[ИмяТипаДокумента].ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(, МассивОбъектов);
	
	ТабличнаяЧасть = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выгрузить();
	
	ЕстьСтавкаБезНДС = Ложь;
	Для Каждого ЭлементТЗ Из ТабличнаяЧасть Цикл
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(ЭлементТЗ.СтавкаНДС) Тогда
			ЕстьСтавкаБезНДС = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ШапкаСчета = СтруктураДанныхДляПечати.РезультатПоШапке.Выгрузить()[0];
	ВсегоНДС = ТабличнаяЧасть.Итог("СуммаНДС");
	
	Если ВсегоНДС > 0 И ШапкаСчета.ЧастичнаяОплата Тогда
		Точность = 2;
		ВсегоНДС = Окр(ВсегоНДС * ШапкаСчета.ПроцентОплаты / 100, Точность);
	КонецЕсли;
	
	Мета.СуммаНДС		= ВсегоНДС;
	Мета.ДокументБезНДС	= (ЕстьСтавкаБезНДС И ВсегоНДС = 0);
	Мета.Сумма			= ШапкаСчета.СуммаДокумента;

КонецПроцедуры // ПриЗаполненииМетыНеформализованногоСчетаНаОплату()

// См. метод "ПередФормированиемПечатнойФормыСверкиВзаиморасчетов" в "Модуль_ИнтеграцияУниверсальный"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- См. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "Модуль_ИнтеграцияУниверсальный"
//
Процедура ПередФормированиемПечатнойФормыСверкиВзаиморасчетов(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	Если ТипЗнч(ПараметрыМетодаПечати.МассивОбъектов[0]) = Тип("ДокументСсылка.СверкаВзаиморасчетов") Тогда
		МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.СверкаВзаиморасчетов");
	ИначеЕсли ИспользуетсяСверкаВзаиморасчетов2_5_11()
		И ТипЗнч(ПараметрыМетодаПечати.МассивОбъектов[0]) = Тип("ДокументСсылка.СверкаВзаиморасчетов2_5_11") Тогда
		МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.СверкаВзаиморасчетов2_5_11");
	Иначе
		Возврат;
	КонецЕсли;
	
	НоваяПФ = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	
	НоваяПФ.ИмяМакета 	= "АктСверкиВзаимныхРасчетов";
	НоваяПФ.ИмяВРЕГ		= ВРЕГ(НоваяПФ.ИмяМакета);
	НоваяПФ.Экземпляров = 1;
	
	ПараметрыОтправки = Новый Структура;
	
	ПараметрыОтправки.Вставить("Получатель"	, "");
	ПараметрыОтправки.Вставить("Тема"		, "");
	ПараметрыОтправки.Вставить("Текст"		, "");
	
	ПараметрыМетодаПечати.ПараметрыВывода.Вставить("ДоступнаПечатьПоКомплектно"	, Ложь);
	ПараметрыМетодаПечати.ПараметрыВывода.Вставить("ПараметрыОтправки"			, ПараметрыОтправки);
	
КонецПроцедуры // ПередФормированиемПечатнойФормыСверкиВзаиморасчетов()

