// Вызывается из Модуль_ИнтеграцияУниверсальный.РеквизитыДоговора.
//
// Параметры:
//  Реквизиты			 - Структура - возвращаемые сведения.
//  Шапка				 - Структура - реквизиты шапки документа (см. Модуль_ИнтеграцияУниверсальный.ДанныеШапки).
//  СтандартнаяОбработка - Булево	 - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриПолученииРеквизитовДоговора(Реквизиты, Шапка, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеДокумента = Шапка.ОписаниеДокумента;
	ДокументСсылка = ОписаниеДокумента.Ссылка;
	
	Основание = СтруктурированноеПредставлениеОснования(ДокументСсылка);
	
	Если Не ЗначениеЗаполнено(Основание)
		И ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда 
		ОснованиеСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ДокументОснование");
		Основание = СтруктурированноеПредставлениеОснования(ОснованиеСчета);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты.Представление	 = Основание.Presentation;
	Реквизиты.Номер			 = Основание.GroundNumber;
	Реквизиты.Дата			 = Основание.GroundDate;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ЭтапыГрафикаОплатПоДокументу.
//
// Параметры:
//  ЭтапыОплаты			 - ТаблицаЗначений	 - возвращаемые сведения;
//  Шапка				 - Структура		 - реквизиты шапки документа (см. Модуль_ИнтеграцияУниверсальный.ДанныеШапки);
//  СтандартнаяОбработка - Булево			 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииЭтаповГрафикаОплат(ЭтапыОплаты, Шапка, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеДокумента = Шапка.ОписаниеДокумента;
	ДокументСсылка = ОписаниеДокумента.Ссылка;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ДокументСсылка);
	
	ПараметрыПечати = Новый Структура;
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументСсылка);
	ДанныеДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(ПараметрыПечати, МассивОбъектов);
	
	ТаблицаЭтаповОплаты = ДанныеДляПечати.РезультатПоЭтапамОплаты.Выгрузить();
	
	Для Каждого Стр Из ТаблицаЭтаповОплаты Цикл 
		ЗаполнитьЗначенияСвойств(ЭтапыОплаты.Добавить(), Стр);
	КонецЦикла;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ПредставлениеНоменклатуры.
//
// Параметры:
//  Представление			 - Строка - параметр, в который возвращается полученное представление номенклатуры;
//  Номенклатура			 - Строка, СправочникСсылка.Номенклатура				 - ссылка на номенклатуру;
//  Характеристика			 - Строка, СправочникСсылка.ХарактеристикиНоменклатуры	 - характеристика номенклатуры;
//  ДополнительныеПараметры	 - Неопределено, Структура								 - см. функцию Модуль_ИнтеграцияУниверсальный.ДополнительныеПараметрыПредставленияНоменклатуры;
//  СтандартнаяОбработка	 - Булево - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииПредставленияНоменклатуры(Представление, Номенклатура, Характеристика, ДополнительныеПараметры, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Номенклатура) = Тип("Строка") Тогда 
		
		НоменклатураНаименование = СокрЛП(Номенклатура);
												
	ИначеЕсли ЗначениеЗаполнено(Номенклатура) Тогда
										
		РеквизитыНоменклатуры	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "НаименованиеПолное, Наименование");
		НоменклатураНаименование = ?(ЗначениеЗаполнено(РеквизитыНоменклатуры.НаименованиеПолное)
										, РеквизитыНоменклатуры.НаименованиеПолное
										, РеквизитыНоменклатуры.Наименование);
										
	Иначе
		
		НоменклатураНаименование = "";
		
	КонецЕсли;
	
	Если ТипЗнч(Характеристика) = Тип("Строка") Тогда 
		
		ХарактеристикаНаименование	 = СокрЛП(Характеристика);
		
	ИначеЕсли ЗначениеЗаполнено(Характеристика) Тогда 
		
		РеквизитыХарактеристики		 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Характеристика, "НаименованиеПолное, Наименование");
		ХарактеристикаНаименование	 = ?(ЗначениеЗаполнено(РеквизитыХарактеристики.НаименованиеПолное)
											, РеквизитыХарактеристики.НаименованиеПолное
											, РеквизитыХарактеристики.Наименование);
		
	Иначе 
		ХарактеристикаНаименование = "";
	КонецЕсли;
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	Если СравнитьВерсии(ВерсияУТ, "11.3") > 0 Тогда 
		
		Представление = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(НоменклатураНаименование
																				  , ХарактеристикаНаименование
																				  , ДополнительныеПараметры.Упаковка
																				  , ДополнительныеПараметры.Серия
																				  , ДополнительныеПараметры);
		
	Иначе 
		
		Представление = НоменклатураКлиентСервер.ПредставлениеНоменклатурыДляПечати(НоменклатураНаименование
																				  , ХарактеристикаНаименование
																				  , ДополнительныеПараметры.Упаковка
																				  , ДополнительныеПараметры.Серия
																				  , ДополнительныеПараметры.Содержание
																				  , ДополнительныеПараметры.ВозвратнаяТара);
		
	КонецЕсли;
	
КонецПроцедуры

