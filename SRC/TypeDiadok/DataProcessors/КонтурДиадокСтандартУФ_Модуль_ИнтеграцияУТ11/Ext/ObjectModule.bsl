Функция ПараметрыСправочникаНоменклатурыПартнеров()
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если ЭтоРедакция11_5() Тогда
		
		ИмяТаблицы = "НоменклатураКонтрагентов";
		Если СравнитьВерсии(ВерсияУТ, "11.5.6") < 0 Тогда
			ИмяТаблицы = "НоменклатураПоставщиков";
		КонецЕсли;
		
	Иначе
		
		ИмяТаблицы = "НоменклатураКонтрагентов";
		Если СравнитьВерсии(ВерсияУТ, "11.4.13") < 0 Тогда
			ИмяТаблицы = "НоменклатураПоставщиков";
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", ИмяТаблицы);
	Результат.Вставить("ПолноеИмя", "Справочник." + ИмяТаблицы);
	
	Возврат Результат;
	
КонецФункции
	
