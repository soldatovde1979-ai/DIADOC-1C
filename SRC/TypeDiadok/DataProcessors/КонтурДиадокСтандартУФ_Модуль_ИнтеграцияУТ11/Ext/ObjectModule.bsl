	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|ГДЕ
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_Основная.Документ КАК Документ,
	|	ВТ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ВТ_Основная.ЭтоАванс КАК ЭтоАванс,
	|	ВТ_Основная.Организация КАК Организация,
	|	ВТ_Основная.Контрагент КАК Контрагент,
	|	ВТ_Основная.Валюта КАК Валюта,
	|	ВТ_Основная.ID КАК ID,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен КАК Проведен,
	|	ВТ_Основная.Дата КАК Дата,
	|	ВТ_Основная.Номер КАК Номер,
	|	ВТ_Основная.ФормироватьУПД КАК ФормироватьУПД,
	|	ДокументыОснования.ДокументОснование КАК ДокументОснование,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ДокументОснованиеID
	|ПОМЕСТИТЬ ДанныеДокументаИДокументыОснования
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК ДокументыОснования
	|		ПО ВТ_Основная.Документ = ДокументыОснования.Ссылка
	|			И (ДокументыОснования.ДокументОснование <> НЕОПРЕДЕЛЕНО)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (ДокументыОснования.ДокументОснование = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Основная.Документ,
	|	ВТ_Основная.ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка,
	|	ВТ_Основная.ЭтоАванс,
	|	ВТ_Основная.Организация,
	|	ВТ_Основная.Контрагент,
	|	ВТ_Основная.Валюта,
	|	ВТ_Основная.ID,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен,
	|	ВТ_Основная.Дата,
	|	ВТ_Основная.Номер,
	|	ВТ_Основная.ФормироватьУПД,
	|	НЕОПРЕДЕЛЕНО,
	|	""""
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданныйАванс КАК ДокументыОснования
	|		ПО ВТ_Основная.Документ = ДокументыОснования.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Основная.Документ,
	|	ВТ_Основная.ЭтоИсправление,
	|	ВТ_Основная.ЭтоКорректировка,
	|	ВТ_Основная.ЭтоАванс,
	|	ВТ_Основная.Организация,
	|	ВТ_Основная.Контрагент,
	|	ВТ_Основная.Валюта,
	|	ВТ_Основная.ID,
	|	ВТ_Основная.СостояниеОтправкиДополнительныхВПФ,
	|	ВТ_Основная.Проведен,
	|	ВТ_Основная.Дата,
	|	ВТ_Основная.Номер,
	|	ВТ_Основная.ФормироватьУПД,
	|	НЕОПРЕДЕЛЕНО,
	|	""""
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураКомиссионеру КАК ДокументыОснования
	|		ПО ВТ_Основная.Документ = ДокументыОснования.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	СУММА(ВложенныйЗапрос.СуммаСНДС) КАК СуммаДокументаЗначение,
	|	СУММА(ВложенныйЗапрос.СуммаНДС) КАК СуммаНДС
	|ПОМЕСТИТЬ СуммыДокОснованийЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		РасшифровкаТЧ.СуммаНДС КАК СуммаНДС,
	|		РасшифровкаТЧ.Сумма КАК СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданныйАванс.Авансы КАК РасшифровкаТЧ
	|			ПО ДанныеДокументаИДокументыОснования.Документ = РасшифровкаТЧ.Ссылка
	|	
	|	//##Метка_ОтчетДавальцу##
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ,
	|		Товары.СуммаНДС,
	|		Товары.СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Товары.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ,
	|		Товары.СуммаНДС,
	|		Товары.СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.Товары КАК Товары
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Товары.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ,
	|		Услуги.СуммаНДС,
	|		Услуги.СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот.Услуги КАК Услуги
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Услуги.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ,
	|		Доходы.СуммаНДС,
	|		Доходы.СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияУслугПрочихАктивов.Доходы КАК Доходы
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Доходы.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ,
	|		Товары.СуммаНДС,
	|		Товары.СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары КАК Товары
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Товары.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИДокументыОснования.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_КорректировочныйСчетФактура
	|		ИНАЧЕ &ВидыЭД_СчетФактура
	|	КОНЕЦ КАК ВидЭД,
	|	ДанныеДокументаИДокументыОснования.ЭтоИсправление КАК ЭтоИсправление,
	|	ДанныеДокументаИДокументыОснования.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ДанныеДокументаИДокументыОснования.ЭтоАванс КАК ЭтоАванс,
	|	ДанныеДокументаИДокументыОснования.Организация КАК Организация,
	|	ДанныеДокументаИДокументыОснования.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(СуммыДокОснованийЗначение.СуммаДокументаЗначение, 0) КАК СуммаДокументаЗначение,
	|	ДанныеДокументаИДокументыОснования.Валюта КАК Валюта,
	|	ДанныеДокументаИДокументыОснования.ID КАК ID_,
	|	ДанныеДокументаИДокументыОснования.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ДанныеДокументаИДокументыОснования.Проведен КАК Проведен,
	|	ДанныеДокументаИДокументыОснования.Дата КАК Дата,
	|	ДанныеДокументаИДокументыОснования.Номер КАК Номер,
	|	ЕСТЬNULL(СуммыДокОснованийЗначение.СуммаНДС, 0) КАК СуммаНДСТовары,
	|	0 КАК СуммаНДСУслуги,
	|	""СчетФактураВыданный"" КАК Тип,
	|	ДанныеДокументаИДокументыОснования.ФормироватьУПД КАК ФормироватьУПД,
	|	ДанныеДокументаИДокументыОснования.ДокументОснование КАК ДокументОснование,
	|	ДанныеДокументаИДокументыОснования.ДокументОснованиеID КАК ДокументОснованиеID
	|ПОМЕСТИТЬ СЧФ_Основная
	|ИЗ
	|	ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыДокОснованийЗначение КАК СуммыДокОснованийЗначение
	|		ПО ДанныеДокументаИДокументыОснования.Документ = СуммыДокОснованийЗначение.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДанныеДокументаИДокументыОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммыДокОснованийЗначение";
	
	ТекстЗапроса_ОтчетДавальцу = "";
	
	Если ИспользуетсяОтчетДавальцу() Тогда
		
		ТекстЗапроса_ОтчетДавальцу = 
		"ОБЪЕДИНИТЬ ВСЕ
		|		
		|	ВЫБРАТЬ
		|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
		|		Продукция.СуммаНДС  КАК СуммаНДС,
		|		Продукция.СуммаСНДС КАК СуммаСНДС
		|	ИЗ
		|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетДавальцу.Продукция КАК Продукция
		|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Продукция.Ссылка
		|";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//##Метка_ОтчетДавальцу##", ТекстЗапроса_ОтчетДавальцу);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЭтоИсправление", ТекстЗапроса_СчетФактура_ЭтоИсправление());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СФ_ЭтоКорректировка", ТекстЗапроса_СчетФактура_ЭтоКорректировка());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СФАванс_ЭтоКорректировка", ТекстЗапроса_СчетФактураАванс_ЭтоКорректировка());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СФКомиссионеру_ЭтоКорректировка", ТекстЗапроса_СчетФактураКомиссионеру_ЭтоКорректировка());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СФКомиссионеру_Контрагент", ТекстЗапроса_СчетФактураКомиссионеру_Контрагент());
	
	Запрос.УстановитьПараметр("ВалютаРегл", ВалютаРегламентированногоУчета());
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ВалютаРегл");
	
КонецПроцедуры

Процедура ПодготовитьВТ_СЧФ_ОсновнаяДокументОснованиеВ_Шапке(Запрос)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Документ.Ссылка КАК Документ,
	|	Документ.Исправление КАК ЭтоИсправление,
	|	Документ.Корректировочный КАК ЭтоКорректировка,
	|	Документ.Организация КАК Организация,
	|	Документ.Валюта КАК Валюта,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ID,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	Документ.Проведен КАК Проведен,
	|	Документ.Дата КАК Дата,
	|	Документ.Номер КАК Номер,
	|	Документ.ДокументОснование КАК ДокументОснование,
	|	НастройкиЭДО.ФормироватьУПД КАК ФормироватьУПД
	|ПОМЕСТИТЬ ВТ_Основная
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Документ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиЭДО
	|		ПО (Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|			И (НЕ Документ.ПометкаУдаления)
	|			И Документ.Организация = НастройкиЭДО.Организация
	|			И Документ.Контрагент = НастройкиЭДО.Контрагент
	|			И (Документ.Проведен
	|				ИЛИ НастройкиЭДО.ОтправлятьНепроведенные = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО Документ.Ссылка = ИдентификаторДокументаВДиадок.Объект
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|ГДЕ
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТИПЗНАЧЕНИЯ(ВТ_Основная.ДокументОснование) КАК ДокументОснованиеТип
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная";
	
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	
	ТекстЗапросаКонтрагенты= "";
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка= РезультатЗапроса.Выбрать();
		РезультатЗапроса= Неопределено;
		
		Пока Выборка.Следующий() Цикл
			
			МетаданныеДокумента= Метаданные.НайтиПоТипу(Выборка.ДокументОснованиеТип);
			
			Если МетаданныеДокумента <> Неопределено И МетаданныеДокумента.Реквизиты.Найти("Контрагент") <> Неопределено Тогда
				
				ТекстЗапросаКонтрагенты= ТекстЗапросаКонтрагенты + "
				|	
				|	ОБЪЕДИНИТЬ
				|	
				|ВЫБРАТЬ
				|	ВТ_Основная.ДокументОснование,
				|	ДанныеДокументаОснования.Контрагент,
				|	ОтборКонтрагенты.ФормироватьУПД
				|ИЗ
				|	ВТ_Основная КАК ВТ_Основная
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + МетаданныеДокумента.ПолноеИмя() + " КАК ДанныеДокументаОснования
				|		ПО ВТ_Основная.ДокументОснование = ДанныеДокументаОснования.Ссылка
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборКонтрагенты КАК ОтборКонтрагенты
				|		ПО ДанныеДокументаОснования.Контрагент = ОтборКонтрагенты.Контрагент";
				
			КонецЕсли;
			
			МетаданныеДокумента= Неопределено;
			
		КонецЦикла;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Документ,
	|	МАКСИМУМ(ВложенныйЗапрос.Контрагент) КАК Контрагент,
	|	МАКСИМУМ(ВложенныйЗапрос.ФормироватьУПД) КАК ФормироватьУПД
	|ПОМЕСТИТЬ ВТ_ДокументыС_ОтборомПоКонтрагентам
	|ИЗ
	|	(ВЫБРАТЬ
	|		NULL КАК Документ,
	|		NULL КАК Контрагент,
	|		NULL КАК ФормироватьУПД
	|	ГДЕ
	|		ЛОЖЬ " + ТекстЗапросаКонтрагенты + ") КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_Основная.*,
	|	ВТ_ДокументыС_ОтборомПоКонтрагентам.Контрагент,
	|	ЕСТЬNULL(ВТ_ДокументыС_ОтборомПоКонтрагентам.ФормироватьУПД, ВТ_Основная.ОрганизацияФормироватьУПД) КАК ФормироватьУПД,
	|	ЕСТЬNULL(ИдентификаторДокументаВДиадок.Значение, """") КАК ДокументОснованиеID
	|ПОМЕСТИТЬ ДанныеДокументаИДокументыОснования
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ПО ВТ_Основная.Документ = СчетФактураВыданный.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыС_ОтборомПоКонтрагентам КАК ВТ_ДокументыС_ОтборомПоКонтрагентам
	|		ПО ВТ_Основная.ДокументОснование = ВТ_ДокументыС_ОтборомПоКонтрагентам.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ИдентификаторДокументаВДиадок
	|		ПО (ВТ_Основная.ДокументОснование = ИдентификаторДокументаВДиадок.Объект)
	|			И (ИдентификаторДокументаВДиадок.Свойство = &СвойствоДокументаИдентификатор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_Основная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДокументыС_ОтборомПоКонтрагентам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Документ КАК Документ,
	|	СУММА(ВложенныйЗапрос.СуммаСНДС) КАК СуммаДокументаЗначение,
	|	СУММА(ВложенныйЗапрос.СуммаНДС)  КАК СуммаНДС
	|ПОМЕСТИТЬ СуммыДокОснованийЗначение
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		Товары.СуммаНДС  КАК СуммаНДС,
	|		Товары.СуммаСНДС КАК СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Товары.Ссылка
	|
	|   ОБЪЕДИНИТЬ ВСЕ
	|
	|   ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		Товары.СуммаНДС  КАК СуммаНДС,
	|		Товары.СуммаСНДС КАК СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации.Товары КАК Товары
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Товары.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|		
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		Услуги.СуммаНДС  КАК СуммаНДС,
	|		Услуги.СуммаСНДС КАК СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот.Услуги КАК Услуги
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Услуги.Ссылка
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ДанныеДокументаИДокументыОснования.Документ КАК Документ,
	|		Товары.СуммаНДС  КАК СуммаНДС,
	|		Товары.СуммаСНДС КАК СуммаСНДС
	|	ИЗ
	|		ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику.Товары КАК Товары
	|			ПО ДанныеДокументаИДокументыОснования.ДокументОснование = Товары.Ссылка) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокументаИДокументыОснования.Документ,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИДокументыОснования.ЭтоКорректировка
	|			ТОГДА &ВидыЭД_КорректировочныйСчетФактура
	|		ИНАЧЕ &ВидыЭД_СчетФактура
	|	КОНЕЦ КАК ВидЭД,
	|	ДанныеДокументаИДокументыОснования.ЭтоИсправление КАК ЭтоИсправление,
	|	ДанныеДокументаИДокументыОснования.ЭтоКорректировка КАК ЭтоКорректировка,
	|	ДанныеДокументаИДокументыОснования.Организация,
	|	ДанныеДокументаИДокументыОснования.Контрагент,
	|	ЕСТЬNULL(СуммыДокОснованийЗначение.СуммаДокументаЗначение, 0) КАК СуммаДокументаЗначение,
	|	ДанныеДокументаИДокументыОснования.Валюта,
	|	ДанныеДокументаИДокументыОснования.ID КАК ID_,
	|	ДанныеДокументаИДокументыОснования.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	ДанныеДокументаИДокументыОснования.Проведен 	КАК Проведен,
	|	ДанныеДокументаИДокументыОснования.Дата 		КАК Дата,
	|	ДанныеДокументаИДокументыОснования.Номер 		КАК Номер,
	|	ЕСТЬNULL(СуммыДокОснованийЗначение.СуммаНДС, 0) КАК СуммаНДСТовары,
	|	0 КАК СуммаНДСУслуги,
	|	""СчетФактураВыданный"" КАК Тип,
	|	ДанныеДокументаИДокументыОснования.ФормироватьУПД      КАК ФормироватьУПД,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИДокументыОснования.ФормироватьУПД = &КлючНастройки_СЧФДОП И ДанныеДокументаИДокументыОснования.ЭтоКорректировка
	|			ТОГДА &ФункцияЭД_КСЧФДИС
	|		КОГДА ДанныеДокументаИДокументыОснования.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|			ТОГДА &ФункцияЭД_СЧФДОП
	|		КОГДА ДанныеДокументаИДокументыОснования.ФормироватьУПД = &КлючНастройки_СЧФ_ДОП И ДанныеДокументаИДокументыОснования.ЭтоКорректировка
	|			ТОГДА &ФункцияЭД_КСЧФ
	|		КОГДА ДанныеДокументаИДокументыОснования.ФормироватьУПД = &КлючНастройки_СЧФ_ДОП
	|			ТОГДА &ФункцияЭД_СЧФ
	|		ИНАЧЕ &ФункцияЭД_ПоУмолчанию
	|	КОНЕЦ КАК ФункцияУПД,
	|	ДанныеДокументаИДокументыОснования.ДокументОснование   КАК ДокументОснование,
	|	ДанныеДокументаИДокументыОснования.ДокументОснованиеID КАК ДокументОснованиеID
	|ПОМЕСТИТЬ СЧФ_Основная
	|ИЗ
	|	ДанныеДокументаИДокументыОснования КАК ДанныеДокументаИДокументыОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыДокОснованийЗначение КАК СуммыДокОснованийЗначение
	|		ПО ДанныеДокументаИДокументыОснования.Документ = СуммыДокОснованийЗначение.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДанныеДокументаИДокументыОснования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СуммыДокОснованийЗначение";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПодготовитьВТ_Связь_СчетаФактуры(Запрос, МассивВременныхТаблиц)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СЧФ_Основная.Документ КАК Документ,
	|	СЧФ_Основная.ДокументОснование КАК ДокументСвязь
	|ПОМЕСТИТЬ Связь_СчетаФактуры
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	НЕ СЧФ_Основная.ДокументОснование В (&ПустыеЗначенияДокументОснованиеСЧФ)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	РеализацияТоваровУслуг.ЗаказКлиента
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО СЧФ_Основная.ДокументОснование = РеализацияТоваровУслуг.Ссылка
	|			И (НЕ РеализацияТоваровУслуг.ЗаказКлиента В (&ПустыеЗначенияЗаказКлиентаРТУ))
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СЧФ_Основная.Документ,
	|	АктВыполненныхРабот.ЗаказКлиента
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот КАК АктВыполненныхРабот
	|		ПО СЧФ_Основная.ДокументОснование = АктВыполненныхРабот.Ссылка
	|			И (НЕ АктВыполненныхРабот.ЗаказКлиента В (&ПустыеЗначенияЗаказКлиентаАкт))";
	
	Запрос.УстановитьПараметр("ПустыеЗначенияДокументОснованиеСЧФ"	, ПустыеЗначенияРеквизита("Документ.СчетФактураВыданный.Реквизит.ДокументОснование"));
	Запрос.УстановитьПараметр("ПустыеЗначенияЗаказКлиентаРТУ"		, ПустыеЗначенияРеквизита("Документ.РеализацияТоваровУслуг.Реквизит.ЗаказКлиента"));
	Запрос.УстановитьПараметр("ПустыеЗначенияЗаказКлиентаАкт"		, ПустыеЗначенияРеквизита("Документ.АктВыполненныхРабот.Реквизит.ЗаказКлиента"));
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Запрос.Параметры.Удалить("ПустыеЗначенияДокументОснованиеСЧФ");
	Запрос.Параметры.Удалить("ПустыеЗначенияЗаказКлиентаРТУ");
	Запрос.Параметры.Удалить("ПустыеЗначенияЗаказКлиентаАкт");
	
	МассивВременныхТаблиц.Добавить("Связь_СчетаФактуры");
	
КонецПроцедуры

Процедура ПодготовитьВТ_СЧФ_Основная(Запрос, МассивВременныхТаблиц)
	
	Если ОснованиеСчетаФактурыУказываетсяВТабличнойЧасти() Тогда
		ПодготовитьВТ_СЧФ_ОсновнаяДокументОснованиеВ_ТЧ(Запрос);
	Иначе
		ПодготовитьВТ_СЧФ_ОсновнаяДокументОснованиеВ_Шапке(Запрос);
	КонецЕсли;
	
	ПодготовитьВТ_Связь_СчетаФактуры(Запрос, МассивВременныхТаблиц);
	
КонецПроцедуры

Процедура ПодготовитьВТ_УПД_СЧФДОП(Запрос, МассивВременныхТаблиц, ТипыДокументов)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СЧФ_Основная.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_ПодходящиеСЧФ
	|ИЗ
	|	СЧФ_Основная КАК СЧФ_Основная
	|ГДЕ
	|	СЧФ_Основная.ФормироватьУПД = &КлючНастройки_СЧФДОП
	|	И НЕ СЧФ_Основная.ЭтоКорректировка
	|
	|СГРУППИРОВАТЬ ПО
	|	СЧФ_Основная.Документ
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА СЧФ_Основная.ID_ = СЧФ_Основная.ДокументОснованиеID
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.Документ КАК Документ,
	|	&ВидыЭД_СчетФактура КАК ВидЭД,
	|	СЧФ_Основная.ЭтоИсправление КАК ЭтоИсправление,
	|	СЧФ_Основная.ЭтоКорректировка КАК ЭтоКорректировка,
	|	СЧФ_Основная.Организация КАК Организация,
	|	СЧФ_Основная.Контрагент КАК Контрагент,
	|	СЧФ_Основная.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	СЧФ_Основная.СуммаНДСТовары КАК СуммаНДСТовары,
	|	СЧФ_Основная.СуммаНДСУслуги КАК СуммаНДСУслуги,
	|	СЧФ_Основная.Валюта КАК Валюта,
	|	СЧФ_Основная.Проведен КАК Проведен,
	|	СЧФ_Основная.Дата КАК Дата,
	|	СЧФ_Основная.Номер КАК Номер,
	|	СЧФ_Основная.ID_ КАК ID_,
	|	ВЫБОР
	|		КОГДА СЧФ_Основная.ЭтоАванс
	|			ТОГДА &ФункцияЭД_СЧФ
	|		ИНАЧЕ &ФункцияЭД_СЧФДОП
	|	КОНЕЦ КАК ФункцияУПД,
	|	""СчетФактураВыданный"" КАК Тип,
	|	"""" КАК СостояниеОтправкиДополнительныхВПФ,
	|	ЛОЖЬ КАК ЭтоСчет
	|ПОМЕСТИТЬ УПД_СЧФДОП
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
	|		ПО ВТ_ПодходящиеСЧФ.Документ = СЧФ_Основная.Документ
	|ГДЕ
	|	НЕ СЧФ_Основная.ЭтоАванс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СЧФ_Основная.ДокументОснование КАК ДокументОснование
	|ПОМЕСТИТЬ УПД_СЧФДОП_ДокументыОснования
	|ИЗ
	|	ВТ_ПодходящиеСЧФ КАК ВТ_ПодходящиеСЧФ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СЧФ_Основная КАК СЧФ_Основная
	|		ПО ВТ_ПодходящиеСЧФ.Документ = СЧФ_Основная.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ПодходящиеСЧФ";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	Если ПустаяСтрока(ТипыДокументов) ИЛИ ТипыДокументов = "5" Тогда
		МассивВременныхТаблиц.Добавить("УПД_СЧФДОП");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодготовитьВТ_УКД_КСЧФДИС(Запрос, МассивВременныхТаблиц, ТипыДокументов)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СЧФ_Основная.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_ПодходящиеСЧФ
