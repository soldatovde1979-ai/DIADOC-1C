КонецФункции

Процедура ПерезаполнениеЗначенийРеквизитовШапки(ТекущийОбъект, ДанныеЗаполнения)
	
	МетаданныеОбъекта = ТекущийОбъект.Метаданные();
	
	Для Каждого Строка Из ДанныеЗаполнения Цикл
		
		Если ЗначениеЗаполнено(Строка.Ключ) 
			 И МетаданныеОбъекта.Реквизиты.Найти(Строка.Ключ) <> Неопределено
			 И ТекущийОбъект[Строка.Ключ] <> Строка.Значение Тогда
			ТекущийОбъект[Строка.Ключ] = Строка.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСоглашениеПоСтатистике(Объект)
	
	Если ЭтоРедакция11_5() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполняемыеРеквизиты = Новый Структура("Соглашение");
	
	РеквизитыДляОтбора = Новый Структура;
	РеквизитыДляОтбора.Вставить("Партнер", Объект.Партнер);
	РеквизитыДляОтбора.Вставить("Валюта", Объект.Валюта);
	РеквизитыДляОтбора.Вставить("ЦенаВключаетНДС", Объект.ЦенаВключаетНДС);
	
	МодульЗаполнениеСвойствПоСтатистикеСервер = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеСвойствПоСтатистикеСервер");
	МодульЗаполнениеСвойствПоСтатистикеСервер.ПолучитьЗначенияСвойств(
			Объект.Ссылка, ЗаполняемыеРеквизиты, РеквизитыДляОтбора);
	
	Если ЗначениеЗаполнено(ЗаполняемыеРеквизиты.Соглашение) Тогда
		Объект.Соглашение = ЗаполняемыеРеквизиты.Соглашение;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьДоговорСПоставщиком(Объект)
	
	Если Не ИспользоватьДоговорыСПоставщиками()
		Или ЗначениеЗаполнено(Объект.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика");
	
	ДопПараметры = ЗакупкиСервер.ДополнительныеПараметрыОтбораДоговоров();
	
	Если ЭтоПлатежныйДокумент(Объект) Тогда
		ДопПараметры.ВалютаВзаиморасчетов = Объект.Валюта;
	Иначе
		ДопПараметры.ВалютаВзаиморасчетов = Объект.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	ДопПараметры.Налогообложение = Объект.НалогообложениеНДС;
	
	Объект.Договор = ЗакупкиСервер.ПолучитьДоговорПоУмолчанию(Объект, ХозяйственнаяОперация, ДопПараметры);
	
КонецПроцедуры

Функция ЭтоПлатежныйДокумент(Объект)
	
	ТипыПлатежныхДокументов = Новый Массив;
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств"));
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств"));
	ТипыПлатежныхДокументов.Добавить(Тип("ДокументСсылка.РасходныйКассовыйОрдер"));
	
	Возврат (ТипыПлатежныхДокументов.Найти(ТипЗнч(Объект.Ссылка)) <> Неопределено);
	
КонецФункции

Процедура ЗаполнитьДоговорСКлиентом(Объект)
	
	Если Не ИспользоватьДоговорыСКлиентами()
		Или ЗначениеЗаполнено(Объект.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ВалютаВзаиморасчетов") Тогда
		ВалютаДляОтбора = Объект.ВалютаВзаиморасчетов;
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеОбъекта, "Валюта") Тогда
		ВалютаДляОтбора = Объект.Валюта;
	Иначе
		ВалютаДляОтбора = Неопределено;
	КонецЕсли;
	
	ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");
	
	Объект.Договор = ПродажиСервер.ПолучитьДоговорПоУмолчанию(Объект, ХозяйственнаяОперация, ВалютаДляОтбора);
	
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруПартнера(СтрокаТЧ, НоменклатураКонтрагента, ПараметрыСправочника = Неопределено)
	
	Если Не ЗначениеЗаполнено(ПараметрыСправочника) Тогда
		ПараметрыСправочника = ПараметрыСправочникаНоменклатурыПартнеров();
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК НоменклатураПартнера
	|ИЗ
	|	ПолноеИмяТаблицы КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И Т.Владелец = &Владелец
	|	И Т.Идентификатор = &Идентификатор";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПолноеИмяТаблицы", ПараметрыСправочника.ПолноеИмя);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", НоменклатураКонтрагента.Владелец);
	Запрос.УстановитьПараметр("Идентификатор", НоменклатураКонтрагента.Идентификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	НоменклатураПартнераСсылка = Выборка.НоменклатураПартнера;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("НоменклатураПоставщика", НоменклатураПартнераСсылка); // До 11.4.12 включительно
	ДанныеЗаполнения.Вставить("НоменклатураПартнера", НоменклатураПартнераСсылка); // 11.4.13+
	
	ЗаполнитьЗначенияСвойств(СтрокаТЧ, ДанныеЗаполнения);
	
КонецПроцедуры

// Заполняет сведения о номенклатуре информационной базы в строке табличной части учетного документа.
//
// Параметры:
//  СтрокаТЧ - СтрокаТабличнойЧасти - строка табличной части документа.
//  НоменклатураИБ - Структура - данные о номенклатуре информационной базы (см. НоваяНоменклатураИнформационнойБазы).
//
Процедура ЗаполнитьНоменклатуруИнформационнойБазы(СтрокаТЧ, НоменклатураИБ)
	
	Если Не ЗначениеЗаполнено(НоменклатураИБ.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЧ.Номенклатура	 = НоменклатураИБ.Номенклатура;
	СтрокаТЧ.Характеристика	 = НоменклатураИБ.Характеристика;
	СтрокаТЧ.Упаковка		 = НоменклатураИБ.Упаковка;
	
	ЕдиницаХранения = ЕдиницаХраненияНоменклатуры(НоменклатураИБ.Номенклатура);
	Если СтрокаТЧ.Упаковка = ЕдиницаХранения Тогда
		СтрокаТЧ.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

Функция ЕдиницаХраненияНоменклатуры(Номенклатура)
	
	Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	Возврат Результат;
	
КонецФункции

// Инициализирует и возвращает структуру дополнительных параметров отбора соглашений.
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//   * ТолькоДействующее - Булево - Истина, если подбирать только действующие соглашения
//   * УчитыватьГруппыСкладов - Булево
//   * ИсключитьГруппыСкладовДоступныеВЗаказах - Булево
//   * ХозяйственныеОперации - ПеречислениеСсылка.ХозяйственныеОперации, Массив
//   * ВыбранноеСоглашение
//
Функция ДополнительныеПараметрыОтбораСоглашений()
	
	Результат = Новый Структура();
	Результат.Вставить("ТолькоДействующее",                       Истина);
	Результат.Вставить("УчитыватьГруппыСкладов",                  Истина);
	Результат.Вставить("ИсключитьГруппыСкладовДоступныеВЗаказах", Истина);
	Результат.Вставить("ХозяйственныеОперации",                   Неопределено);
	Результат.Вставить("ВыбранноеСоглашение",   Справочники.СоглашенияСПоставщиками.ПустаяСсылка());
	
	Возврат Результат;
	
КонецФункции

