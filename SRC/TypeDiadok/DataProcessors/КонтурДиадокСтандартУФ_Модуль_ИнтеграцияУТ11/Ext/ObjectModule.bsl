// Вызывается из Модуль_ИнтеграцияУниверсальный.НовыйДокументИнформационнойБазы.
//
// Параметры:
//  ДокументОбъект		 - ДокументОбъект	 - новый, еще не записанный, документ-объект;
//  ДанныеЭД			 - Структура		 - содержит данные электронного документа
//                                             (см. Модуль_ИнтеграцияУниверсальный.ДанныеЭлектронногоДокумента);
//  ПараметрыЗаполнения	 - Структура		 - содержит дополнительные параметры заполнения;
//  СтандартнаяОбработка - Булево			 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриСозданииДокументаИнформационнойБазы(ДокументОбъект, ДанныеЭД, ПараметрыЗаполнения, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Если МетаданныеДокумента = Метаданные.Документы.ПриобретениеТоваровУслуг Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПриобретенияТоваровУслуг(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПриобретениеТоваровУслуг(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ПриобретениеУслугПрочихАктивов Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияПриобретенияУслугПрочихАктивов(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьПриобретениеУслугПрочихАктивов(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ВозвратТоваровОтКлиента Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияВозвратаТоваровОтКлиента(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьВозвратТоваровОтКлиента(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.КорректировкаПриобретения Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьКорректировкуПоступления(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СчетФактураПолученный Тогда
		
		ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
		
		Если ФорматЭД.ЭтоКорректировка Тогда
			СтруктураЗаполнения = СтруктураЗаполненияКорректировочногоСчетаФактуры(ДанныеЭД, ПараметрыЗаполнения);
		Иначе
			СтруктураЗаполнения = СтруктураЗаполненияСчетаФактуры(ДанныеЭД, ПараметрыЗаполнения);
		КонецЕсли;
		
		ЗаполнитьСчетФактуруПолученный(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СчетФактураПолученныйАванс Тогда
		
		//ПроверитьВозможностьЗаполненияСчетаФактурыНаАванс(ДанныеЭД);
		Если Не ДанныеЭД.ЭтоАванс Тогда
			Сообщить("Электронный документ не является счетом-фактурой на аванс!");
			СтандартнаяОбработка = Истина;
			Возврат;
		КонецЕсли;
		
		СтруктураЗаполнения = СтруктураЗаполненияСчетаФактуры(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьСчетФактуруПолученныйНаАванс(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.АктОРасхожденияхПослеОтгрузки Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияАктаОРасхожденияхПослеОтгрузки(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьАктОРасхожденияхПослеОтгрузки(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = МетаданныеДокументаСверкаВзаиморасчетов() Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияСверкиВзаиморасчетов(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьСверкуВзаиморасчетов(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли ИспользуетсяСверкаВзаиморасчетов2_5_11()
		И МетаданныеДокумента = Метаданные.Документы.СверкаВзаиморасчетов2_5_11 Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияСверкиВзаиморасчетов2_5_11(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьСверкуВзаиморасчетов2_5_11(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ЗаказПоставщику Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияЗаказаПоставщику(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьЗаказПоставщику(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияЗаявкиНаРасходованиеДС(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьЗаявкуНаРасходованиеДС(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.СписаниеБезналичныхДенежныхСредств Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияСписанияБезналичныхДС(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьСписаниеБезналичныхДС(ДокументОбъект, СтруктураЗаполнения);
		
	ИначеЕсли МетаданныеДокумента = Метаданные.Документы.РасходныйКассовыйОрдер Тогда
		
		СтруктураЗаполнения = СтруктураЗаполненияРасходногоКассовогоОрдера(ДанныеЭД, ПараметрыЗаполнения);
		ЗаполнитьРасходныйКассовыйОрдер(ДокументОбъект, СтруктураЗаполнения);
		
	Иначе
		
		// Специальная обработка заполнения не реализована
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ИмяСправочникаВладельцаНоменклатуры.
//
// Параметры:
//  ИмяСправочника		 - Строка - имя справочника, которому подчинен справочник "НоменклатураПоставщиков";
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриОпределенииИмениСправочникаВладельцаНоменклатуры(ИмяСправочника, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ИмяСправочника = "Партнеры";
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.МетаданныеПрикладногоСправочника.
//
// Параметры:
//  СоответствиеСправочников - Соответствие - ключом является имя справочника в терминах сервиса, а значением - метаданные прикладного справочника;
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииСоответствияСправочников(СоответствиеСправочников, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	СоответствиеСправочников.Вставить("Валюты"			, Метаданные.Справочники.Валюты);
	СоответствиеСправочников.Вставить("СтраныМира"		, Метаданные.Справочники.СтраныМира);
	
	СоответствиеСправочников.Вставить("Организации"				, Метаданные.Справочники.Организации);
	СоответствиеСправочников.Вставить("Контрагенты"				, Метаданные.Справочники.Контрагенты);
	СоответствиеСправочников.Вставить("Партнеры"				, Метаданные.Справочники.Партнеры);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.СсылкаОбъектаПоПолямПоиска.
//
// Параметры:
//  СсылкаНаОбъект		 - Произвольный - ссылка на искомый объект;
//  ПоляПоиска			 - Структура - содержит параметры поиска;
//  ОбъектМетаданных	 - ОбъектМетаданных - метаданные искомого объекта;
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события;
//
// Пример:
//
//  НаименованиеПолное = Неопределено;
//  Если ПоляПоиска.Свойство("НаименованиеПолное", НаименованиеПолное) 
//      И Не ЕстьРеквизитМетаданных(ОбъектМетаданных, "НаименованиеПолное") 
//      И ЕстьРеквизитМетаданных(ОбъектМетаданных, "ПолноеНаименование") Тогда
//          
//          ПоляПоиска.Удалить("НаименованиеПолное");
//          ПоляПоиска.Вставить("ПолноеНаименование", НаименованиеПолное);
//          
//  КонецЕсли;
//
Процедура ПриПолученииСсылкиПоПолямПоиска(СсылкаНаОбъект, ПоляПоиска, ОбъектМетаданных, СтандартнаяОбработка) Экспорт
	
	
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.СчетаФактурыПоОснованию.
//
// Параметры:
//  НайденныеДокументы	 - Массив	 - Ссылки на найденные счета-фактуры;
//  ПараметрыРегистрации - Структура - см. Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактуры();
//  СтандартнаяОбработка - Булево	 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПолученииСчетовФактурПоОснованию(НайденныеДокументы, ПараметрыРегистрации, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	ТаблицаСчетовФактур	 = Документы.СчетФактураПолученный.СчетаФактурыПоОснованию(ПараметрыРегистрации.Ссылка, , , Ложь);
	
	Если ЗначениеЗаполнено(ТаблицаСчетовФактур) Тогда 
		НайденныеДокументы = ТаблицаСчетовФактур.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактурыПоОснованию.
//
// Параметры:
//  ПараметрыРегистрации - Структура	 - см. Модуль_ИнтеграцияУниверсальный.ПараметрыРегистрацииСчетаФактуры();
//  ДокументОснование	 - ЛюбаяСсылка	 - документ, на основании которого необходимо получить параметры;
//  СтандартнаяОбработка - Булево		 - Ложь, чтобы отключить стандартную обработку события;
//
Процедура ПриПодготовкеПараметровРегистрацииСчетаФактуры(ПараметрыРегистрации, ДокументОснование, СтандартнаяОбработка) Экспорт
	
	
	
КонецПроцедуры

#КонецОбласти

#Область СборПротоконтента

Процедура ЗаполнитьКонтентXmlUTD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ФункцияУПД = ПараметрыФормирования.ФункцияДокумента;
	
	ДанныеДляПечати = ПолучитьДанныеДляФормированияУПД(ДокСсылка, ФункцияУПД);
	ДанныеШапки     = ДанныеДляПечати.ДанныеШапки;
	ТаблицаТоваров  = ДанныеДляПечати.ТаблицаТоваров;
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	
	ДобавитьОшибкиВалидацииИзДанныхШапки(ДанныеШапки, Content);
	
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	
	Content.Number 	= ДатаНомер.НомерДокумента;
	Content.Date 	= ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	Если ДанныеШапки.Свойство("СчетФактураСсылка") Тогда
		Content.СчетФактураСсылка = ДанныеШапки.СчетФактураСсылка;
	КонецЕсли;
	
	Покупатель = ПолучитьГоловноеЮрлицо(ДанныеШапки.Контрагент);
	Заполнить_ExtendedOrganizationInfo(Content.Buyer, Покупатель, ДатаНомер.ДатаДокумента, Истина, ДанныеШапки.БанковскийСчетКонтрагента);
	
	Если ЗначениеЗаполнено(ПараметрыФормирования.Получатель_FnsParticipantId) Тогда
		Content.Buyer.FnsParticipantId = ПараметрыФормирования.Получатель_FnsParticipantId;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.КонтрагентКПП) Тогда
		Content.Buyer.kpp =  ДанныеШапки.КонтрагентКПП;
	КонецЕсли;
	
	КППГрузоотправителя = "";
	
	Если ДанныеШапки.ЕстьТовары Тогда
	
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) И НЕ ТипЗнч(ДанныеШапки.Грузоотправитель) = Тип("Строка") Тогда
			ПодставлятьКППГрузоотправителя = МетодСервера(,"ПолучитьЗначениеСвойства", ДанныеШапки.Организация, МетодСервера(,"ИдентификаторСвойстваПодставлятьКППГрузоотправителя"));
			Если (НЕ ПодставлятьКППГрузоотправителя = Неопределено И ПодставлятьКППГрузоотправителя) Тогда
				КППГрузоотправителя = ?(ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель.КПП), ДанныеШапки.Грузоотправитель.КПП, "");
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда 
			Заполнить_ExtendedOrganizationInfo(Content.Shipper.OrganizationInfo, ДанныеШапки.Грузоотправитель, ДатаНомер.ДатаДокумента, Ложь, ДанныеШапки.БанковскийСчетГрузоотправителя, , ДанныеШапки.ОбособленноеПодразделение);
			Content.Shipper.SameAsSeller = Ложь;
		Иначе
			Content.Shipper.SameAsSeller = Истина;
		КонецЕсли;
		
		ГрузополучательСсылка = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
		Заполнить_ExtendedOrganizationInfo(Content.Consignee, ГрузополучательСсылка, ДатаНомер.ДатаДокумента, Ложь, ДанныеШапки.БанковскийСчетГрузополучателя);
							
	КонецЕсли;
	
	Продавец = ПолучитьГоловноеЮрлицо(ДанныеШапки.Организация);
	Заполнить_ExtendedOrganizationInfo(Content.Seller, Продавец, ДатаНомер.ДатаДокумента, Истина, ДанныеШапки.БанковскийСчетОрганизации, КППГрузоотправителя, ДанныеШапки.ОбособленноеПодразделение);
	
	Если ЗначениеЗаполнено(ПараметрыФормирования.Отправитель_FnsParticipantId) Тогда
		Content.Seller.FnsParticipantId = ПараметрыФормирования.Отправитель_FnsParticipantId;
	КонецЕсли;
	
	Content.Creator = Content.seller.name + ", ИНН/КПП " + МетодСервера(, "ПредставлениеИННКПП", Content.seller);
	Content.Function = ДанныеШапки.Функция;
	
	Если ДанныеШапки.Свойство("ДатаНомерДокументовОплаты") Тогда
		СтруктураPaymentDocuments= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_PaymentDocument");
		Для Каждого ПРД Из ДанныеШапки.ДатаНомерДокументовОплаты Цикл
			ЗаполненнаяСтруктураPaymentDocuments = СкопироватьСтруктуру(СтруктураPaymentDocuments);
			ЗаполненнаяСтруктураPaymentDocuments.Number = ПРД.НомерПлатежноРасчетногоДокумента;
			ЗаполненнаяСтруктураPaymentDocuments.Date   = ПРД.ДатаПлатежноРасчетногоДокумента;
			Content.PaymentDocuments.Добавить(ЗаполненнаяСтруктураPaymentDocuments);
		КонецЦикла;	
	КонецЕсли;
	
	Content.currency = ДанныеШапки.ВалютаДокумента.Код;
	Content.ВалютаСсылка = ДанныеШапки.ВалютаДокумента;
	
	ДанныеШапки.Свойство("ИдентификаторГосконтракта", Content.GovernmentContractInfo);
	
	ЗаполнитьStructedAdditionalInfos(Content.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	TotalNet = 0;
	Total 	 = 0;
	Vat 	 = 0;
	TotalWithVatExcluded = 0;
	
	СФНаАванс = ДанныеШапки.Свойство("СФНаАванс") И ДанныеШапки.СФНаАванс;
	
	ВсеСтроки_СтавкаНДС_БезНДС	 = Истина;
	ВсеСтроки_СтавкаНДС_ИсчНалАг = Истина;
	
	СтавкаНДС_БезНДС   = МетодСервера(, "СтавкаНДС_БезНДС");
	СтавкаНДС_ИсчНалАг = МетодСервера(, "СтавкаНДС_ИсчНалАг");
	
	ПересчитыватьВВалютуРегл = ПересчитыватьВВалютуРегламентированногоУчета(ДокСсылка);
	
	Для Каждого СтрокаДанных Из ТаблицаТоваров Цикл 
		
		Item = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ExtendedInvoiceItem");
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		Content.InvoiceTable.items.Добавить(Item);
		
		Item.Product 	=  СтрокаДанных.НоменклатураПредставление;
		Item.VendorCode =  СтрокаДанных.КодНоменклатуры;
		Item.ItemMark   =  СтрокаДанных.ПризнакТоварРаботаУслуга;
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаДанных.СтавкаНДС);
		
		НДС_БезНДС	 = (НРег(Item.TaxRate) = НРег(СтавкаНДС_БезНДС));
		НДС_ИсчНалАг = (Item.TaxRate = СтавкаНДС_ИсчНалАг);
		
		Если НЕ НДС_БезНДС Тогда
			ВсеСтроки_СтавкаНДС_БезНДС = Ложь;
		КонецЕсли;
		Если НЕ НДС_ИсчНалАг Тогда
			ВсеСтроки_СтавкаНДС_ИсчНалАг = Ложь;
		КонецЕсли;
		
		// Сумма без НДС
		Если НДС_ИсчНалАг Тогда
			Item.SubtotalWithVatExcluded = СтрокаДанных.Сумма;
		ИначеЕсли НЕ СФНаАванс Тогда 	
			Item.SubtotalWithVatExcluded = СтрокаДанных.Сумма - ?(СтрокаДанных.СуммаВключаетНДС, СтрокаДанных.СуммаНДС, 0);	
		КонецЕсли;
		
		// Сумма НДС
		Если НДС_ИсчНалАг Тогда
			Item.Vat = 0;
		ИначеЕсли НЕ НДС_БезНДС Тогда 	
			Item.Vat = СтрокаДанных.СуммаНДС;
		КонецЕсли;
		
		// Сумма всего
		Если НДС_ИсчНалАг Тогда
			Item.Subtotal = 0;
		Иначе 	
			Item.Subtotal = СтрокаДанных.Сумма + ?(СтрокаДанных.СуммаВключаетНДС, 0, СтрокаДанных.СуммаНДС);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.Количество) Тогда
			
			Item.Quantity	 = ?(СФНаАванс И СтрокаДанных.Количество = 0, Неопределено, СтрокаДанных.Количество); //для отображения прочерка в вэбе
			
			ИсключитьИзЦеныНДС = ДанныеШапки.ЦенаВключаетНДС И ЗначениеЗаполнено(СтрокаДанных.СуммаНДС);
			ПересчитатьЦенуСУчетомСкидок = ЗначениеЗаполнено(СтрокаДанных.СуммаСкидок);
			
			Если ИсключитьИзЦеныНДС
				Или ПересчитыватьВВалютуРегл
				Или ПересчитатьЦенуСУчетомСкидок Тогда
				// Цены вычисляем расчетным путем, если нужно исключить НДС или пересчитать из валюты в рубли
				Item.Price = ?(ЗначениеЗаполнено(Item.Quantity), Окр(Item.SubtotalWithVatExcluded / Item.Quantity, Точность), Неопределено);
			Иначе
				// Без пересчета, т.к. цена уже без НДС
				Item.Price = Окр(СтрокаДанных.Цена, Точность);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
				
				Item.UnitName = СокрЛП(СтрокаДанных.ЕдиницаИзмерения);
				Item.UnitCode = МетодСервера(, "XML_КодЕдиницыИзмерения", СокрЛП(СтрокаДанных.КодЕдиницыИзмерения));
				Item.ЕдиницаИзмеренияССылка = СтрокаДанных.ЕдиницаИзмерения;
				
			КонецЕсли;
			
		КонецЕсли;
		
		TotalNet = TotalNet + МетодСервера(, "ПривестиКЧислу", Item.Quantity);
		Total 	 = Total 	+ МетодСервера(, "ПривестиКЧислу", Item.Subtotal);
		Vat 	 = Vat 		+ МетодСервера(, "ПривестиКЧислу", Item.Vat);
		
		Если НЕ СФНаАванс ИЛИ НДС_ИсчНалАг Тогда
			TotalWithVatExcluded = TotalWithVatExcluded + МетодСервера(, "ПривестиКЧислу", Item.SubtotalWithVatExcluded);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(СтрокаДанных.СтранаПроисхождения) Тогда
			
			CustomDeclaration = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CustomDeclaration");
			Item.CustomDeclarations.Добавить(CustomDeclaration);
			
			CustomDeclaration.CountryCode = СокрЛП(СтрокаДанных.СтранаПроисхождения.Код);
			
			Если ЗначениеЗаполнено(СтрокаДанных.НомерГТД) Тогда
				
				CustomDeclaration.DeclarationNumber = ?(ТипЗнч(СтрокаДанных.НомерГТД) = Тип("Строка"),
														СокрЛП(СтрокаДанных.НомерГТД),
														СокрЛП(СтрокаДанных.НомерГТД.Код));
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(СтрокаДанных.НомерГТД) И НЕ МетодСервера(, "СтранаЧленТС", СтрокаДанных.СтранаПроисхождения.Код) Тогда
				CustomDeclaration.СтранаПроисхожденияСсылка = СтрокаДанных.СтранаПроисхождения;
			Иначе
				CustomDeclaration.СтранаПроисхожденияСсылка = Справочники.СтраныМира.ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Content.InvoiceTable.TotalNet = TotalNet;
	Content.InvoiceTable.Total 	  = Total;
	Content.InvoiceTable.Vat 	  = ?(ВсеСтроки_СтавкаНДС_БезНДС, Неопределено, ?(ВсеСтроки_СтавкаНДС_ИсчНалАг, 0, Vat));
	
	Если Не СФНаАванс ИЛИ ВсеСтроки_СтавкаНДС_ИсчНалАг Тогда
		Content.InvoiceTable.TotalWithVatExcluded = TotalWithVatExcluded;
	КонецЕсли;
	
	Content.TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	
	//TransferDate заполняем только, если дата отгрузки не совпадает с датой счета-фактуры.
	Если ДанныеШапки.Свойство("ДатаОтгрузки") И НачалоДня(ДанныеШапки.ДатаОтгрузки) <> НачалоДня(ДатаНомер.ДатаДокумента) Тогда 
		Content.TransferInfo.TransferDate = ДанныеШапки.ДатаОтгрузки;
	КонецЕсли;
	
	ЗаполнитьСведенияОПередаче(Content, ДокСсылка, ФункцияУПД, ПараметрыФормирования);
	
	МетодСервера("Модуль_ИнтеграцияУниверсальный", "ЗаполнитьСведенияОЛицеПередавшемТовар"
		, Content
		, ДанныеШапки
		, ПараметрыФормирования);
	
	Если ДанныеШапки.Функция = "InvoiceAndBasic" Тогда
		Content.Name = "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	ИначеЕсли ДанныеШапки.Функция = "Basic" Тогда
		Content.Name = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	КонецЕсли;
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	ДобавитьДокументыОснованияВСлужебнуюИнформацию(Content);
	
КонецПроцедуры

Процедура ДобавитьДокументыОснованияВСлужебнуюИнформацию(Контент)
	
	СсылкаНаОбъект = Контент.СлужебнаяИнформация.Ссылка;
	
	Если Не ЭтоСчетФактура(СсылкаНаОбъект)
		Или СчетФактураНаАванс(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыОснования = ВсеДокументыОснования(СсылкаНаОбъект);
	Контент.СлужебнаяИнформация.Вставить("ДокументыОснования", ДокументыОснования);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlUCD(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ФункцияУПД = ПараметрыФормирования.ФункцияДокумента;
	
	ДанныеДляПечати = ДанныеДляФормированияУКД(ДокСсылка, Новый Структура("ФункцияУПД", ФункцияУПД));
	
	ШапкаУКД 		= ДанныеДляПечати.Шапка;
	ТаблицаТоваров  = ДанныеДляПечати.ТабличнаяЧасть;
	ОписаниеДокумента = ШапкаУКД.ОписаниеДокумента;
	
	Если ПараметрыФормирования.ФорматОтправки.БазовыйФормат = "ucd736" Тогда
		УдалитьСтрокиНеСоответствующие736Формату(ТаблицаТоваров);
	КонецЕсли;
	
	ДобавитьОшибкиВалидацииИзДанныхШапки(ШапкаУКД, Content);
	
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	ДатаНомер = ШапкаУКД.ДатаНомерДокумента;
	
	Content.Number 	= ДатаНомер.НомерДокумента;
	Content.Date	= ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	Для каждого ДатаНомерДокументаОснования Из ДатаНомер.ДатаНомерДокументовОснований Цикл
		ЗаполнитьInvoiceForCorrectionInfo(Content.Invoices, ДатаНомерДокументаОснования);
	КонецЦикла;
	
	Content.Function = ШапкаУКД.Функция;
	
	Если ШапкаУКД.Функция = "InvoiceAndBasic" Тогда
		Content.Name = "Корректировочный счет-фактура и документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	ИначеЕсли ШапкаУКД.Функция = "Basic" Тогда
		Content.Name = "Документ об изменении стоимости отгруженных товаров (выполненных работ, оказанных услуг), переданных имущественных прав";
	КонецЕсли;
	
	Продавец = ПолучитьГоловноеЮрлицо(ШапкаУКД.Организация);
	Заполнить_ExtendedOrganizationInfo(Content.Seller, Продавец, ДатаНомер.ДатаДокумента, Истина, ШапкаУКД.БанковскийСчетОрганизации, Неопределено, ШапкаУКД.ОбособленноеПодразделение);
	Если ЗначениеЗаполнено(ПараметрыФормирования.Отправитель_FnsParticipantId) Тогда
		Content.Seller.FnsParticipantId = ПараметрыФормирования.Отправитель_FnsParticipantId;
	КонецЕсли;
	
	Если ШапкаУКД.Свойство("ДоговорАгента") И ЗначениеЗаполнено(ШапкаУКД.ДоговорАгента) Тогда
										
		Content.Creator  	= ШапкаУКД.Агент.НаименованиеПолное + ", " + МетодСервера(, "СформироватьПредставлениеИННКПП", ШапкаУКД.Агент.ИНН, ШапкаУКД.Агент.КПП);
		Content.CreatorBase = ШапкаУКД.ДоговорАгента.Наименование;
		
	Иначе
		Content.Creator = Content.Seller.Name + ", ИНН/КПП: " + МетодСервера(, "ПредставлениеИННКПП", Content.Seller);
	КонецЕсли;
	
	Покупатель = ПолучитьГоловноеЮрлицо(ШапкаУКД.Контрагент);
	Заполнить_ExtendedOrganizationInfo(Content.Buyer, Покупатель, ДатаНомер.ДатаДокумента, Истина);
	Если ЗначениеЗаполнено(ПараметрыФормирования.Получатель_FnsParticipantId) Тогда
		Content.Buyer.FnsParticipantId = ПараметрыФормирования.Получатель_FnsParticipantId;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШапкаУКД.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ШапкаУКД.КонтрагентКПП;
	КонецЕсли;
	
	Content.ВалютаСсылка 	= ШапкаУКД.ВалютаДокумента;
	Content.Currency 		= ?(ЗначениеЗаполнено(Content.ВалютаСсылка), Строка(Content.ВалютаСсылка.Код), "");
					
	ШапкаУКД.Свойство("ИдентификаторГосконтракта", Content.GovernmentContractInfo);
							
	ЗаполнитьStructedAdditionalInfos(Content.AdditionalInfoId.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);
	
	Если ЭтоСчетФактура(ДокСсылка) Тогда
		ДокументОтгрузки = ПервыйДокументОснование(ДокСсылка);
	Иначе
		ДокументОтгрузки = ДокСсылка;
	КонецЕсли;
	
	ЗаполнитьInvoiceCorrectionTable(Content.InvoiceCorrectionTable, ТаблицаТоваров, Точность, ДокументОтгрузки);
	
	ЗаполнитьEventContent(Content.EventContent, ШапкаУКД);
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ШапкаУКД);
	
	Content.СлужебнаяИнформация.Вставить("ПередаточныеДокументы", ШапкаУКД.ПередаточныеДокументы);
	Content.СлужебнаяИнформация.Вставить("ИсправляемыеДокументы", ШапкаУКД.ИсправляемыеДокументы);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlTorg12(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров	 = ПолучитьДанныеТЧ(ДокСсылка, Неопределено, Неопределено, Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date   = ДатаНомер.ДатаДокумента;
	
	Если (Метаданные.Имя = "УправлениеТорговлей" И МетодСервера(, "СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "11.2") < 0)
		Или (Метаданные.Имя = "УправлениеПредприятием" И МетодСервера(, "СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "2.1") < 0) Тогда
		КоэффициентПересчетаВТонны = Константы.КоэффициентПересчетаВТонны.Получить();
	Иначе
		КоэффициентПересчетаВТонны = НоменклатураСервер.КоэффициентПересчетаВТонны(Константы.ЕдиницаИзмеренияВеса.Получить());
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеШапки.Организация, ДатаНомер.ДатаДокумента, ДанныеШапки.БанковскийСчетОрганизации, Истина);
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer, ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента, ДанныеШапки.БанковскийСчетКонтрагента, Истина);
	
	Грузоотправитель = ?(ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель), ДанныеШапки.Грузоотправитель, ДанныеШапки.Организация);
	СчетГрузоотправителя = ?(ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетГрузоотправителя), ДанныеШапки.БанковскийСчетГрузоотправителя, ДанныеШапки.БанковскийСчетОрганизации);
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Shipper, Грузоотправитель, ДатаНомер.ДатаДокумента, СчетГрузоотправителя, Ложь);
	
	Content.ShipperDepartment = ПолучитьПодразделениеИзДокумента(ДокСсылка);
	
	Грузополучатель = ?(ЗначениеЗаполнено(ДанныеШапки.Грузополучатель), ДанныеШапки.Грузополучатель, ДанныеШапки.Контрагент);
	СчетГрузополучателя = ДанныеШапки.БанковскийСчетГрузополучателя;
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Consignee,  Грузополучатель, ДатаНомер.ДатаДокумента, СчетГрузополучателя, Ложь, , , ДанныеШапки.АдресДоставки);
	
	НомерЗаказа = ПараметрыФормирования.НомерЗаказа;
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда 
		Content.GroundName = "Заказ";
		Content.GroundNumber = СокрЛП(НомерЗаказа);
	Иначе
		СтруктураДоговора = СтруктурированноеПредставлениеОснования(ДокСсылка);
		Если ЗначениеЗаполнено(СтруктураДоговора) Тогда
			ЗаполнитьЗначенияСвойств(Content, СтруктураДоговора);
		КонецЕсли;
	КонецЕсли;
	
	ИдКонтрагента = МетодСервера(,"Контрагент_2_CounteragentBoxID", ДанныеШапки.Контрагент);
	
	ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	Если МетодСервера(, "НужноФормироватьДопИнфоПоШаблону", ИдКонтрагента) = Истина Тогда
		content.AdditionalInfo = МетодСервера(, "СформироватьСтрокуДопИнфоПоШаблону", ДопСведения);
	Иначе
		content.AdditionalInfo = ДопСведения;
	КонецЕсли;
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТаблицаТоваров);
	КонецЕсли;
	
	TotalParcelsQuantity 	= 0;
	TotalGrossQuantity 		= 0;
	TotalNetQuantity 		= 0;
	TotalMassQuantity		= 0;
	TotalWithVatExcluded 	= 0;
	Total 					= 0;
	Vat 					= 0;

	СтруктураItems = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_Torg12Item");
	ЕстьСтрокиСНДС = Ложь;
					
	Для Каждого СтрокаТаблицы Из ТаблицаТоваров Цикл 
		
		Item = СкопироватьСтруктуру(СтруктураItems);
		
		Item.Product =		СтрокаТаблицы.НоменклатураПредставление;
		Item.ProductCode =	СтрокаТаблицы.КодНоменклатуры;
		Item.UnitCode = 		МетодСервера(, "Item_UnitCode", СтрокаТаблицы.ЕдиницаИзмерения, СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
		Item.UnitName =  	Строка(СтрокаТаблицы.ЕдиницаИзмерения);
		Item.Quantity =		СтрокаТаблицы.Количество;
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
		
		Если ЗначениеЗаполнено(Item.TaxRate) И НЕ МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			ЕстьСтрокиСНДС = Истина;	
		КонецЕсли;
		
		Item.Vat =			СтрокаТаблицы.СуммаНДС;
		Item.Total =			СтрокаТаблицы.Сумма + ?(СтрокаТаблицы.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
		Item.TotalWithVatExcluded =	Item.Total - Item.Vat;
		Item.Price =			окр(Item.TotalWithVatExcluded / ?(Item.Quantity = 0, 1, Item.Quantity), 2);
		
		Item.СсылкаНаЕИ =	СтрокаТаблицы.ЕдиницаИзмерения;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КоличествоМест) Тогда
			Item.ParcelsQuantity = СтрокаТаблицы.КоличествоМест;
			Item.ParcelCapacity  = СтрокаТаблицы.КоличествоВОдномМесте;
			Item.ParcelType      = ?(ЗначениеЗаполнено(строкаТаблицы.ВидУпаковки), строкаТаблицы.ВидУпаковки.Наименование, "");
			Item.GrossQuantity   = СтрокаТаблицы.Масса;
			TotalGrossQuantity   = TotalGrossQuantity + ?(ЗначениеЗаполнено(Item.GrossQuantity), Item.GrossQuantity, 0);
			TotalNetQuantity     = TotalNetQuantity + ?(ЗначениеЗаполнено(строкаТаблицы.МассаНетто), строкаТаблицы.МассаНетто, 0);
			TotalParcelsQuantity = TotalParcelsQuantity + Item.ParcelsQuantity;
		КонецЕсли;	
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.items.Добавить(Item);
		
		TotalMassQuantity	 	= TotalMassQuantity + Item.Quantity;
		TotalWithVatExcluded 	= TotalWithVatExcluded + Item.TotalWithVatExcluded;
		Total 					= Total + Item.Total;
		Vat 					= Vat + Item.Vat;
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Item.TaxRate) Тогда
			Item.Vat = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Content.Totals.ParcelsQuantity 		= TotalParcelsQuantity;
	Content.Totals.GrossQuantity 		= TotalGrossQuantity;
	Content.Totals.Quantity 			= TotalMassQuantity;
	Content.Totals.TotalWithVatExcluded = TotalWithVatExcluded;
	Content.Totals.Total 				= Total;
	Content.Totals.Vat 					= ?(ЕстьСтрокиСНДС, Vat, Неопределено);
				
	Content.SupplyDate 					= Content.Date;
	
	Content.commons.TotalSumInWords = РаботаСКурсамиВалют.СформироватьСуммуПрописью(Total, ДанныеШапки.ВалютаДокумента);
	Если ЗначениеЗаполнено(TotalParcelsQuantity) Тогда
		Content.commons.TotalParcelsQuantityInWords
			= Стрзаменить(ЧислоПрописью(TotalParcelsQuantity, "ДП = Ложь"), "  00", "");
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(TotalGrossQuantity) Тогда
		ПараметрыМассыПрописью = ПараметрыМассыПрописью(TotalGrossQuantity, КоэффициентПересчетаВТонны);
		Content.commons.TotalGrossQuantityInWords
			= ЧислоПрописью(TotalGrossQuantity * ПараметрыМассыПрописью.Коэффициент, "ДП=Истина", ПараметрыМассыПрописью.Формат);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(TotalNetQuantity) Тогда
		ПараметрыМассыПрописью = ПараметрыМассыПрописью(TotalNetQuantity, КоэффициентПересчетаВТонны);
		Content.commons.TotalQuantityInWords
			= ЧислоПрописью(TotalNetQuantity * ПараметрыМассыПрописью.Коэффициент, "ДП=Истина", ПараметрыМассыПрописью.Формат);
	КонецЕсли;	
	
	ФИОСогласователя = "";
	
	ДолжностьСогласователя = "";
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОСогласователя 		= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
			ДолжностьСогласователя 	= ПараметрыОтправкиНаСогласование.ДолжностьПодписанта;
		Иначе
			Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПолучателя) Тогда 
				ФИОСогласователя 	= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			КонецЕсли;
			ДолжностьСогласователя 	= ПараметрыОтправкиНаСогласование.ДолжностьПолучателя;
		КонецЕсли;
	КонецЕсли;	
	
	
	Если ФИОСогласователя = "" Тогда
		ПараметрыПодписания = МетодСервера(, "ПолучитьПараметрыПодписанияТ12вДиадок", ДанныеШапки.Организация);
		
		Если ПараметрыПодписания.СпособПодписания = "4" Тогда
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyPerformedBy, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyAllowedBy, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
			
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.ChiefAccountant, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		ИначеЕсли параметрыПодписания.СпособПодписания = "2" Тогда 
			ПараметрыПодписания.ДолжностьПодписанта = "Главный (старший) бухгалтер";
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.ChiefAccountant, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		ИначеЕсли параметрыПодписания.СпособПодписания = "3" Тогда
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyPerformedBy, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		Иначе	
			МетодСервера(,"ЗаполнитьПодписантаДляXmlTorg12", Content.SupplyAllowedBy, МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания));
		КонецЕсли;
							
	Иначе 
		МетодСервера(,"ЗаполнитьФИОПодписанта", Content.SupplyAllowedBy, ФИОСогласователя);
		Content.SupplyAllowedBy.JobTitle = СокрЛП(?(НЕ ПустаяСтрока(ДолжностьСогласователя), ДолжностьСогласователя, "_"));
	КонецЕсли;
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентXmlAcceptanceCertificate(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ДанныеШапки		 = ДанныеШапки(ДокСсылка);
	ТаблицаТоваров	 = ПолучитьДанныеТЧ(ДокСсылка, Неопределено, Неопределено, Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	Content.Number = ДатаНомер.НомерДокумента;
	Content.Date   = ДатаНомер.ДатаДокумента;
	
	//поставщик: организация-продавец
	БанковскийСчетОрганизации = ДанныеШапки.БанковскийСчетОрганизации;
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller
		, ДанныеШапки.Организация
		, ДатаНомер.ДатаДокумента
		, БанковскийСчетОрганизации
		, Истина);
	
	content.SignatureDate = content.Date;
	
	ЗаполнитьЗаголовокАкта172(Content, ДанныеШапки);
	ЗаполнитьДополнительныеСведения(Content, ДанныеШапки, ПараметрыФормирования);
	
	СтруктураItems = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AcceptanceCertificateItem");
	
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТаблицаТоваров);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаТоваров Цикл
		
		Item = СкопироватьСтруктуру(СтруктураItems);
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Количество)
			Или Не ЗначениеЗаполнено(СтрокаТаблицы.КодЕдиницыИзмерения) Тогда
			Item.Description = СтрокаТаблицы.НоменклатураПредставление;
		Иначе 
			Item.Name = СтрокаТаблицы.НоменклатураПредставление;
		КонецЕсли;
		
		Item.UnitCode = "";
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			
			Item.UnitCode = МетодСервера(, "Item_UnitCode"
				, СтрокаТаблицы.ЕдиницаИзмерения
				, СокрЛП(СтрокаТаблицы.КодЕдиницыИзмерения));
			
			Если Item.UnitCode = "" И ЗначениеЗаполнено(Item.Name) Тогда
				Item.Description = Item.Name;
				Item.Name		 = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		Item.UnitName = Строка(СтрокаТаблицы.ЕдиницаИзмерения);
		Если ЗначениеЗаполнено(Item.Name) Тогда
			Item.Quantity = СтрокаТаблицы.Количество;
		КонецЕсли;
		
		Если Не МенеджерИнтеграции_ЭтоСтавкаБезНДС(СтрокаТаблицы.СтавкаНДС) Тогда
			Item.Vat = СтрокаТаблицы.СуммаНДС;
		КонецЕсли;
	
		Item.Total					 = СтрокаТаблицы.Сумма + ?(СтрокаТаблицы.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
		Item.TotalWithVatExcluded	 = Item.Total - СтрокаТаблицы.СуммаНДС;
		Item.СсылкаНаЕИ				 = СтрокаТаблицы.ЕдиницаИзмерения;
		
		Если ЗначениеЗаполнено(item.Quantity) Тогда
			Item.Price = Окр(item.TotalWithVatExcluded / item.Quantity, 2);
		КонецЕсли;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаТаблицы);
		
		Content.items.Добавить(Item);
		
	КонецЦикла;
	
	ЗаполнитьПодписантаАкта172(Content, ДанныеШапки, ПараметрыФормирования);
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентInvoice(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати = СформироватьДанныеДляПечати(ДокСсылка, Ложь);
	ОписаниеДокумента = ДанныеДляПечати.ОписаниеДокумента;
	
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	ДатаНомер = ДанныеДляПечати.ДатаНомерДокумента;
	
	Content.Number 	= ДатаНомер.НомерДокумента;
	Content.Date	= ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.InvoiceRevisionNumber = ДатаНомер.НомерИсправления;
		Content.InvoiceRevisionDate = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	СтруктураPaymentDocuments=	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_PaymentDocument");

	Для Каждого ПРД Из ДанныеДляПечати.ДатаНомерДокументовОплаты Цикл
		
		PaymentDocumentContent=	СкопироватьСтруктуру(СтруктураPaymentDocuments);
		
		PaymentDocumentContent.Number = ПРД.НомерПлатежноРасчетногоДокумента;
		PaymentDocumentContent.date   = ПРД.ДатаПлатежноРасчетногоДокумента;
		
		Content.PaymentDocuments.Добавить(PaymentDocumentContent);
		
	КонецЦикла;
	
	Content.currency = ДанныеДляПечати.ВалютаДокумента.Код;
	Content.ВалютаСсылка = ДанныеДляПечати.ВалютаДокумента;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer,
		ДанныеДляПечати.Контрагент, ДатаНомер.ДатаДокумента, , Истина, Истина);
	Если ЗначениеЗаполнено(ДанныеДляПечати.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КонтрагентКПП;
	КонецЕсли;
	
	КППГрузоотправителя = "";
	Если ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель) И НЕ ТипЗнч(ДанныеДляПечати.Грузоотправитель) = Тип("Строка") Тогда
		ПодставлятьКППГрузоотправителя = МетодСервера(,"ПолучитьЗначениеСвойства", ДанныеДляПечати.Организация, МетодСервера(, "ИдентификаторСвойстваПодставлятьКППГрузоотправителя"));
		Если (НЕ ПодставлятьКППГрузоотправителя = Неопределено И ПодставлятьКППГрузоотправителя) Тогда
			КППГрузоотправителя = ?(ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель.КПП), ДанныеДляПечати.Грузоотправитель.КПП, "");
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller, ДанныеДляПечати.Организация, ДатаНомер.ДатаДокумента, , Истина, Истина, КППГрузоотправителя);
	
	// Грузоотправителя и грузополучателя заполняем только если в ТЧ есть товары
	Если ДанныеДляПечати.ЕстьТовары Тогда 
		
		Если ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель) Тогда 
			ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(Content.Shipper, ДанныеДляПечати.Грузоотправитель, ДатаНомер.ДатаДокумента); 
			Content.Shipper.SameAsSellerOrBuyer= Ложь;
		Иначе
			Content.Shipper.SameAsSellerOrBuyer= Истина;
		КонецЕсли;
		
		ГрузополучательСсылка = ?(ЗначениеЗаполнено(ДанныеДляПечати.Грузополучатель), ДанныеДляПечати.Грузополучатель, ДанныеДляПечати.Контрагент);
		ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(Content.Consignee, ГрузополучательСсылка, ДатаНомер.ДатаДокумента, ДанныеДляПечати.АдресДоставки);
		
	КонецЕсли;
	
	ЗаполнитьStructedAdditionalInfos(Content.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);

	СтруктураItemInvoice=	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItem");
	
	Vat= 	0;
	Total= 	0;
	TotalWithVatExcluded= 0;
	
	Для каждого Стр из ДанныеДляПечати.ТабличнаяЧасть Цикл
		
		Item = СкопироватьСтруктуру(СтруктураItemInvoice);
		
		Item.Product= Стр.НоменклатураПредставление;
		
		Если ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) Тогда
			Item.UnitCode= МетодСервера(, "Item_UnitCode", Стр.ЕдиницаИзмерения, СокрЛП(Стр.КодЕдиницыИзмерения));
		Иначе
			Item.UnitCode= "";
		КонецЕсли;
		
		Item.ЕдиницаИзмеренияСсылка= Стр.ЕдиницаИзмерения;
		
		Если СчетФактуранаАванс(ДокСсылка) = Ложь Тогда 
			Item.TotalWithVatExcluded= Стр.Сумма - ?(Стр.СуммаВключаетНДС, Стр.СуммаНДС, 0);
		КонецЕсли;
		
		Если СчетФактуранаАванс(ДокСсылка) = Ложь И ЗначениеЗаполнено(Стр.ЕдиницаИзмерения) И ЗначениеЗаполнено(Стр.ЕдиницаИзмерения.Код) Тогда
			Item.Quantity= 	?(ЗначениеЗаполнено(Стр.ЕдиницаИзмерения), Стр.Количество, 0);
			Item.price= 	Строка(?(Item.Quantity = 0, Неопределено, Окр(Item.TotalWithVatExcluded/Item.Quantity, Точность)));
		Иначе 
			//Item.Quantity = 0;
			//Item.price =  0;
		КонецЕсли; 
		
		Если Не МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
			Item.Vat = Стр.СуммаНДС;
		КонецЕсли;
		
		Item.Total = Стр.Сумма + ?(Стр.СуммаВключаетНДС, 0, Стр.СуммаНДС);
		Item.TaxRate = ПредставлениеСтавкиНДС(Стр.СтавкаНДС);
		Item.CountriesOfOrigin = ?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), Стр.СтранаПроисхождения.Код, "");
		Item.СтранаПроисхожденияСсылка = ?(ЗначениеЗаполнено(Стр.СтранаПроисхождения), Стр.СтранаПроисхождения, Справочники.СтраныМира.ПустаяСсылка());
		Item.CustomsDeclarationNumbers = ?(ЗначениеЗаполнено(Стр.НомерГТД), ?(ТипЗнч(Стр.НомерГТД) = Тип("Строка"), СокрЛП(Стр.НомерГТД), СокрЛП(Стр.НомерГТД.Код)), "");
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, Стр);
		
		Content.items.Добавить(Item);
		
		Vat = Vat + Стр.СуммаНДС;
		TotalWithVatExcluded= TotalWithVatExcluded + ?(Item.TotalWithVatExcluded = Неопределено, 0, Item.TotalWithVatExcluded);
		Total = Total + Item.Total;
		
	КонецЦикла;
	
	Content.Totals.Vat = Vat;
	Content.Totals.TotalWithVatExcluded = TotalWithVatExcluded;
	Content.Totals.Total = Total;

	стПодписант= МетодСервера(, "СформироватьПараметрыПодписанта", ПараметрыФормирования.ФИОПодписанта);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОПолучателя= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
		Иначе	
			ФИОПолучателя= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
		КонецЕсли;
		
		ПодписантФамилия = ВыделитьСлово(ФИОПолучателя);
		ПодписантИмя = ВыделитьСлово(ФИОПолучателя);
		ПодписантОтчество = ВыделитьСлово(ФИОПолучателя);
		
		стПодписант.ПодписантФамилия = ?(НЕ ПустаяСтрока(ПодписантФамилия), ПодписантФамилия, " ");
		стПодписант.ПодписантИмя = ?(НЕ ПустаяСтрока(ПодписантИмя), ПодписантИмя, " ");
		стПодписант.ПодписантОтчество = ?(НЕ ПустаяСтрока(ПодписантОтчество), ПодписантОтчество, "");
		
	КонецЕсли;
	
	Content.Signer.Surname = стПодписант.ПодписантФамилия;
	Content.Signer.FirstName = стПодписант.ПодписантИмя;
	Content.Signer.Patronymic = стПодписант.ПодписантОтчество;
	Content.Signer.Inn = Content.seller.inn;
	Content.Signer.IsSoleProprietor = Content.seller.IsSoleProprietor;
	Content.Signer.SoleProprietorRegistrationCertificate = ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляПечати.Организация);
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеДляПечати);
	
КонецПроцедуры

Процедура ЗаполнитьКонтентInvoiceCorrection(Content, ДокСсылка, ПараметрыФормирования) Экспорт
	
	ПараметрыФормированияXML = ПараметрыФормирования.ПараметрыФормированияФайла;
	Точность = ПараметрыФормированияXML.ТочностьЦены;
	
	ДанныеДляПечати = СформироватьДанныеДляПечати(ДокСсылка, Истина);
	ОписаниеДокумента = ДанныеДляПечати.ОписаниеДокумента;
		
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;
	ДатаНомер = ДанныеДляПечати.ДатаНомерДокумента;
	
	Content.InvoiceCorrectionNumber	 = ДатаНомер.НомерДокумента;
	Content.InvoiceCorrectionDate	 = ДатаНомер.ДатаДокумента;
	
	Если ЭтоИсправление Тогда
		Content.RevisionNumber	 = ДатаНомер.НомерИсправления;
		Content.RevisionDate	 = ДатаНомер.ДатаИсправления;
	КонецЕсли;
	
	ДанныеОснований = ДатаНомер.ДатаНомерДокументовОснований;
	
	Если ЗначениеЗаполнено(ДанныеОснований) Тогда
		
		ДанныеОснования = ДанныеОснований[0];
		
		OriginalInvoices = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_OriginalInvoice");
		OriginalInvoices.Number	 = ДанныеОснования.НомерИсходногоДокумента;
		OriginalInvoices.Date	 = ДанныеОснования.ДатаИсходногоДокумента;
		
		Если ДанныеОснования.УчитыватьИсправлениеИсходногоДокумента Тогда 
			OriginalInvoices.InvoiceRevisionNumber	 = ДанныеОснования.НомерИсправленияИсходногоДокумента;
			OriginalInvoices.InvoiceRevisionDate	 = ДанныеОснования.ДатаИсправленияИсходногоДокумента;
		КонецЕсли;
		Content.OriginalInvoices.Добавить(OriginalInvoices);
	
	КонецЕсли;
	
	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Buyer,
		ДанныеДляПечати.Контрагент, ДатаНомер.ДатаДокумента, , Истина, Истина);
	
	Если ЗначениеЗаполнено(ДанныеДляПечати.КонтрагентКПП) Тогда
		Content.Buyer.kpp = ДанныеДляПечати.КонтрагентКПП;
	КонецЕсли;
	
	КППГрузоотправителя =	"";
	Если ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель) И НЕ ТипЗнч(ДанныеДляПечати.Грузоотправитель) = Тип("Строка") Тогда
		ПодставлятьКППГрузоотправителя=	МетодСервера(,"ПолучитьЗначениеСвойства", ДокСсылка.Организация, МетодСервера(, "ИдентификаторСвойстваПодставлятьКППГрузоотправителя"));
		Если (НЕ ПодставлятьКППГрузоотправителя = Неопределено И ПодставлятьКППГрузоотправителя) Тогда
			КППГрузоотправителя =	?(ЗначениеЗаполнено(ДанныеДляПечати.Грузоотправитель.КПП), ДанныеДляПечати.Грузоотправитель.КПП, "");
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(Content.Seller,  ДанныеДляПечати.Организация, ДатаНомер.ДатаДокумента, , Истина, Истина, КППГрузоотправителя);
	
	content.currency = ДанныеДляПечати.ВалютаДокумента.Код;
	content.ВалютаСсылка = ДанныеДляПечати.ВалютаДокумента;
	
	ЗаполнитьStructedAdditionalInfos(Content.StructedAdditionalInfos, ПараметрыФормирования.ДополнительныеСведенияСтрокой);

	СтруктураItemInvoiceCorrection= МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceCorrectionItem");

	Для каждого СтрокаДанных из ДанныеДляпечати.ТабличнаяЧасть Цикл 
						
		Item = СкопироватьСтруктуру(СтруктураItemInvoiceCorrection);
		Item.AmountsDec = 		МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.AmountsInc = 		МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_AmountsDiff");
		Item.OriginalValues = 	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		Item.CorrectedValues = 	МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_InvoiceItemFields");
		
		Item.Product = СтрокаДанных.НоменклатураПредставление;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмеренияДоИзменения) Тогда
			Item.OriginalValues.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаДанных.ЕдиницаИзмеренияДоИзменения, СокрЛП(СтрокаДанных.КодЕдиницыИзмеренияДоИзменения));
		Иначе
			Item.OriginalValues.UnitCode = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ЕдиницаИзмерения) Тогда
			Item.CorrectedValues.UnitCode = МетодСервера(, "Item_UnitCode", СтрокаДанных.ЕдиницаИзмерения, СокрЛП(СтрокаДанных.КодЕдиницыИзмерения));
		Иначе
			Item.CorrectedValues.UnitCode = "";	
		КонецЕсли;
							
		Item.OriginalValues.ЕдиницаИзмеренияСсылка =		СтрокаДанных.ЕдиницаИзмеренияДоИзменения;
		Item.CorrectedValues.ЕдиницаИзмеренияСсылка = 	СтрокаДанных.ЕдиницаИзмерения;
		
		Item.OriginalValues.TotalWithVatExcluded = 	СтрокаДанных.СуммаСНДСДоИзменения - СтрокаДанных.СуммаНДСДоИзменения;
		Item.CorrectedValues.TotalWithVatExcluded =	СтрокаДанных.СуммаСНДС - СтрокаДанных.СуммаНДС;
		
		Item.OriginalValues.Quantity =	СтрокаДанных.КоличествоДоИзменения;
		Item.CorrectedValues.Quantity = 	СтрокаДанных.Количество;
		
		Item.OriginalValues.Price =	Строка(?(Item.OriginalValues.Quantity = 0, 0, Окр(Item.OriginalValues.TotalWithVatExcluded / Item.OriginalValues.Quantity, Точность)));
		Item.CorrectedValues.Price =	Строка(?(Item.CorrectedValues.Quantity = 0, 0, Окр(Item.CorrectedValues.TotalWithVatExcluded / Item.CorrectedValues.Quantity, Точность)));
		
		СтавкаДоИзменения = СтрокаДанных.СтавкаНДСДоИзменения;
		Если Не ЗначениеЗаполнено(СтавкаДоИзменения) Тогда
			СтавкаДоИзменения = СтрокаДанных.СтавкаНДС;
		КонецЕсли;
		
		Item.OriginalValues.TaxRate = ПредставлениеСтавкиНДС(СтавкаДоИзменения);
		Item.CorrectedValues.TaxRate = ПредставлениеСтавкиНДС(СтрокаДанных.СтавкаНДС);
		
		Item.OriginalValues.Vat =	СтрокаДанных.СуммаНДСДоИзменения;
		Item.CorrectedValues.Vat =	СтрокаДанных.СуммаНДС;
		
		Item.OriginalValues.Total =	СтрокаДанных.СуммаСНДСДоИзменения;
		Item.CorrectedValues.Total = СтрокаДанных.СуммаСНДС;
		
		ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Item, СтрокаДанных);
		
		Content.items.Добавить(Item);
		
	КонецЦикла;
	
	стПодписант = МетодСервера(, "СформироватьПараметрыПодписанта", ПараметрыФормирования.ФИОПодписанта);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ФИОПолучателя = ПараметрыОтправкиНаСогласование.ФИОПодписанта;
		Иначе
			ФИОПолучателя = ПараметрыОтправкиНаСогласование.ФИОПолучателя;
		КонецЕсли;
		
		ПодписантФамилия =				ВыделитьСлово(ФИОПолучателя);
		ПодписантИмя = 					ВыделитьСлово(ФИОПолучателя);
		ПодписантОтчество = 				ВыделитьСлово(ФИОПолучателя);
		стПодписант.ПодписантФамилия =	?(НЕ ПустаяСтрока(ПодписантФамилия), ПодписантФамилия, " ");
		стПодписант.ПодписантИмя = 		?(НЕ ПустаяСтрока(ПодписантИмя), ПодписантИмя, " ");
		стПодписант.ПодписантОтчество = 	?(НЕ ПустаяСтрока(ПодписантОтчество), ПодписантОтчество, "");
		
	КонецЕсли;	
					
	Content.Signer.Surname = 	стПодписант.ПодписантФамилия;
	Content.Signer.FirstName = 	стПодписант.ПодписантИмя;
	Content.Signer.Patronymic = 	стПодписант.ПодписантОтчество;
	Content.Signer.Inn = 		Content.seller.inn;
	Content.Signer.IsSoleProprietor = Content.seller.IsSoleProprietor;
	Content.Signer.SoleProprietorRegistrationCertificate = ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляПечати.Организация);
	
	ДополнитьКонтентДокументаСлужебнойИнформацией(Content, ДанныеДляПечати);
	
КонецПроцедуры

