			ЭлементСписка = Новый  Структура(СтрокаКлючей);
			ЗаполнитьЗначенияСвойств(ЭлементСписка, Стр);
			Результат.Добавить(ЭлементСписка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
