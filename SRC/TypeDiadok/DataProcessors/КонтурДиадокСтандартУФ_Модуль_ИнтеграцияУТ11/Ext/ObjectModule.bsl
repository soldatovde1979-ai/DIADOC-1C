Функция ПолучитьБанковскийСчет(ДокументСсылка)
	
	ДокТоварный= ПолучитьДокТоварный(ДокументСсылка);
			
	Возврат ?(ДокТоварный.Метаданные().Реквизиты.Найти("БанковскийСчетОрганизации") = Неопределено, Неопределено, ДокТоварный.БанковскийСчетОрганизации);
	
КонецФункции

Функция ПолучитьБанковскийСчетГрузоотправителя(ДокументСсылка)
	
	ДокТоварный= ПолучитьДокТоварный(ДокументСсылка);
					
	Возврат ?(ДокТоварный.Метаданные().Реквизиты.Найти("БанковскийСчетГрузоотправителя") = Неопределено, Неопределено, ДокТоварный.БанковскийСчетГрузоотправителя);
	
КонецФункции

Функция ПолучитьБанковскийСчетПокупателя(ДокументСсылка)
	
	ДокТоварный = ПолучитьДокТоварный(ДокументСсылка);
	
	Возврат ?(ДокТоварный.Метаданные().Реквизиты.Найти("БанковскийСчетКонтрагента") = Неопределено, Неопределено, ДокТоварный.БанковскийСчетКонтрагента);
	
КонецФункции

Функция ПолучитьБанковскийСчетГрузополучателя(ДокументСсылка)
	
	ДокТоварный= ПолучитьДокТоварный(ДокументСсылка);
					
	Возврат ?(ДокТоварный.Метаданные().Реквизиты.Найти("БанковскийСчетГрузополучателя") = Неопределено, Неопределено, ДокТоварный.БанковскийСчетГрузополучателя);
	
КонецФункции

Функция ПолучитьДокТоварный(ДокументСсылка)
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ДокТоварный= ДокументСсылка.ДокументОснование;
		Пока ТипЗнч(ДокТоварный) = Тип("ДокументСсылка.КорректировкаРеализации") Цикл 
			ДокТоварный= ДокТоварный.ДокументОснование;
		КонецЦикла;
	Иначе
		ДокТоварный= ДокументСсылка;
	КонецЕсли;
	
	Возврат ДокТоварный;
	
КонецФункции

Функция ПолучитьПодразделениеИзДокумента(ДокСсылка)
	Возврат ""; // в типовой конфе обособленное подразделение указывается как Неопределено
	//Возврат ДокСсылка.Подразделение.Наименование;
КонецФункции

Функция ПолучитьМассивСсылокРТУПоСчетуНаОплату(ДокументСсылка) Экспорт
	
	МассивРТУ = Новый Массив;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") 
		И НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("ДокументОснование") = Неопределено Тогда
		
		Если  ЗначениеЗаполнено(ДокументСсылка.ДокументОснование)
			И ТипЗнч(ДокументСсылка.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			МассивРТУ.Добавить(ДокументСсылка.ДокументОснование);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	РеализацияТоваровУслуг.Ссылка КАК РеализацияСсылка
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			|ГДЕ
			|	РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента
			|	И РеализацияТоваровУслуг.ПометкаУдаления = ЛОЖЬ";
			
		Запрос.УстановитьПараметр("ЗаказКлиента", ДокументСсылка);
		
		РезультатЗапроса= Запрос.Выполнить().Выгрузить();
		
		МассивРТУ = РезультатЗапроса.ВыгрузитьКолонку("РеализацияСсылка");
		
	КонецЕсли;
	
	Возврат МассивРТУ;		
	
КонецФункции

Функция ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(СчетФактура) Экспорт
	
	ТекстЗапроса = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.Договор КАК Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтКлиента КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровПоставщику КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияУслугПрочихАктивов КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Договор
	|ИЗ
	|	Документ.СчетФактураВыданный КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетКомитенту КАК Документ
	|		ПО Таблица.ДокументОснование = Документ.Ссылка
	|ГДЕ
	|	Таблица.Ссылка = &СчетФактура";
	
	Если ИспользуетсяОтчетДавальцу() Тогда
		
		ТекстЗапроса = ТекстЗапроса + РазделительОбъединенияЗапросов() +
			"ВЫБРАТЬ
			|	Документ.Ссылка КАК Ссылка,
			|	Документ.Дата КАК Дата,
			|	Документ.Договор КАК Договор
			|ИЗ
			|	Документ.СчетФактураВыданный КАК Таблица
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтчетДавальцу КАК Документ
			|		ПО Таблица.ДокументОснование = Документ.Ссылка
			|ГДЕ
			|	Таблица.Ссылка = &СчетФактура";
			
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Если ОснованиеСчетаФактурыУказываетсяВТабличнойЧасти() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.СчетФактураВыданный", "Документ.СчетФактураВыданный.ДокументыОснования");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РазделительОбъединенияЗапросов()
	
	Результат = Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ДокументСсылка) Экспорт
	
	СФСсылка= 	Неопределено;
	Запрос= 	Новый Запрос;
	
	Если ОснованиеСчетаФактурыУказываетсяВТабличнойЧасти() Тогда
		Запрос.Текст= 
			"ВЫБРАТЬ
			|	СчетФактураВыданныйДокументыОснования.Ссылка
			|ИЗ
			|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
			|ГДЕ
			|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
			|	И СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления = ЛОЖЬ";
	Иначе 
		Запрос.Текст= 
			"ВЫБРАТЬ
			|	СчетФактураВыданный.Ссылка
			|ИЗ
			|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			|ГДЕ
			|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
			|	И СчетФактураВыданный.ПометкаУдаления = ЛОЖЬ";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	
	Выборка= Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СФСсылка= Выборка.Ссылка;
	КонецЕсли;
	
	Возврат СФСсылка;
	
КонецФункции

Функция ПолучитьДокОснованиеКорректировкиРеализации(ДокументСсылка) Экспорт
	
	ДокументОснование= Неопределено;
	
	Если НЕ ДокументСсылка.Метаданные().Реквизиты.Найти("ДокументРеализации") = Неопределено Тогда
		ДокументОснование= ДокументСсылка.ДокументРеализации;
	Иначе
		ДокументОснование= ДокументСсылка.ДокументОснование;
	КонецЕсли;
	
	Возврат ДокументОснование;
	
КонецФункции

Функция ПолучитьСчетНаОплатуНаОснованииРТУ(ДокументСсылка) Экспорт
	
	Запрос= Новый Запрос;
	
	Запрос.Текст=
		"ВЫБРАТЬ
		|	СчетНаОплатуКлиенту.Ссылка
		|ИЗ
		|	Документ.СчетНаОплатуКлиенту КАК СчетНаОплатуКлиенту
		|ГДЕ
		|	СчетНаОплатуКлиенту.ДокументОснование = &ДокументОснование
