Функция ИспользуетсяРеализацияЧерезКомиссионера()
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	Результат = СравнитьВерсии(ВерсияУТ, "11.5.8") >= 0;
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяРегистрационныйНомерТД()
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	Результат = СравнитьВерсии(ВерсияУТ, "11.4.2") >= 0;
	
	Возврат Результат;
	
КонецФункции

// В редакции 11.1 в табличную часть "ВидыЗапасов" добавили реквизит "АналитикаУчетаНоменклатуры",
// а реквизиты "Номенклатура" и "Характеристика" помечены на удаление (удалены в редакции 11.2)
// 
// Возвращаемое значение:
//  Булево - Истина, если для передачи сведений о номенклатуре используется реквизит "АналитикаУчетаНоменклатуры".
//
Функция ИспользуетсяАналитикаУчетаНоменклатуры()
	
	ЕстьРеквизитНоменклатура = МетодСервера( , "СуществуетОбъектМетаданных", "Документ.РеализацияТоваровУслуг.ТабличнаяЧасть.ВидыЗапасов.Реквизит.Номенклатура");
	Результат = Не ЕстьРеквизитНоменклатура;
	
	Возврат Результат;
	
КонецФункции

#Область ЗагрузкаДанных

// Список возможных идентификаторов способов обработки входящих документов.
// 
// Возвращаемое значение:
//  Структура - см. тело функции.
//
Функция ИдентификаторыПравилОбработкиДокументов()
	
	ЗначенияПеречисления = Новый Массив;
	ЗначенияПеречисления.Добавить("ПриобретениеТоваровУслуг");
	ЗначенияПеречисления.Добавить("ПриобретениеУслугПрочихАктивов");
	ЗначенияПеречисления.Добавить("ВозвратТоваровОтКлиента");
	ЗначенияПеречисления.Добавить("КорректировкаПриобретения");
	ЗначенияПеречисления.Добавить("СчетФактураПолученный");
	ЗначенияПеречисления.Добавить("СчетФактураПолученныйАванс");
	ЗначенияПеречисления.Добавить("АктОРасхожденияхПослеОтгрузки");
	ЗначенияПеречисления.Добавить("СверкаВзаиморасчетов");
	ЗначенияПеречисления.Добавить("СверкаВзаиморасчетов2_5_11");
	ЗначенияПеречисления.Добавить("ЗаказПоставщику");
	ЗначенияПеречисления.Добавить("ЗаявкаНаРасходованиеДенежныхСредств");
	ЗначенияПеречисления.Добавить("СписаниеБезналичныхДенежныхСредств");
	ЗначенияПеречисления.Добавить("РасходныйКассовыйОрдер");
	
	Результат = Новый Структура;
	Для Каждого Элемент Из ЗначенияПеречисления Цикл
		Результат.Вставить(Элемент, Элемент);
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Заполняет правила обработки входящих товарных накладных и актов об оказании услуг.
//
Процедура ЗаполнитьПравилаОбработкиПервичныхДокументов(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхДокументов = Ложь;
	ДляИсправительныхДокументов = Истина;
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Приобретение товаров, услуг
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриобретениеТоваровУслуг
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхДокументов);
	
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриобретениеТоваровУслуг
		, ВидыЭД.АктОбОказанииУслуг
		, ДляПервичныхДокументов);
	
	// Приобретение услуг и прочих активов
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриобретениеУслугПрочихАктивов
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхДокументов);
	
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ПриобретениеУслугПрочихАктивов
		, ВидыЭД.АктОбОказанииУслуг
		, ДляПервичныхДокументов);
	
	// Возврат товаров от клиента
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.ВозвратТоваровОтКлиента
		, ВидыЭД.ТоварнаяНакладная
		, ДляПервичныхДокументов);
	
	// Исправление накладной, акта
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.КорректировкаПриобретения
		, ВидыЭД.ТоварнаяНакладная
		, ДляИсправительныхДокументов);
	
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.КорректировкаПриобретения
		, ВидыЭД.АктОбОказанииУслуг
		, ДляИсправительныхДокументов);
	
	// Корректировка накладной, акта
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.КорректировкаПриобретения
		, ВидыЭД.СоглашениеОбИзмененииСтоимости
		, ДляПервичныхИИсправительныхДокументов);
	
КонецПроцедуры

// Заполняет правила обработки входящих счетов-фактур и корректировочных счетов-фактур.
//
Процедура ЗаполнитьПравилаОбработкиСчетовФактур(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Счет-фактура
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.СчетФактураПолученный
		, ВидыЭД.СчетФактура
		, ДляПервичныхИИсправительныхДокументов);
	
	// Счет-фактура (аванс)
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.СчетФактураПолученныйАванс
		, ВидыЭД.СчетФактура
		, ДляПервичныхИИсправительныхДокументов);
	
	// Корректировочный счет-фактура
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.СчетФактураПолученный
		, ВидыЭД.КорректировочныйСчетФактура
		, ДляПервичныхИИсправительныхДокументов);
	
КонецПроцедуры

// Заполняет правила обработки входящих Актов о расхождениях после приемки.
//
Процедура ЗаполнитьПравилаОбработкиДокументовОРасхождении(ПравилаОбработки)

	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Акт о расхождениях после приемки
	ДобавитьПравилоОбработкиДокументов(ПравилаОбработки
		, ИдентификаторыПравил.АктОРасхожденияхПослеОтгрузки
		, ВидыЭД.ДокументОРасхождениях
		, ДляПервичныхИИсправительныхДокументов);

КонецПроцедуры

Процедура ЗаполнитьПравилаОбработкиАктовСверки(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	// Акт сверки расчетов
	ДобавитьПравилоОбработкиДокументов(
		ПравилаОбработки,
		ИдентификаторыПравил.СверкаВзаиморасчетов,
		ВидыЭД.АктСверки,
		ДляПервичныхИИсправительныхДокументов
	);
	
	Если ИспользуетсяСверкаВзаиморасчетов2_5_11() Тогда
		
		// Акт сверки расчетов (2.5.11)
		ДобавитьПравилоОбработкиДокументов(
			ПравилаОбработки,
			ИдентификаторыПравил.СверкаВзаиморасчетов2_5_11,
			ВидыЭД.АктСверки,
			ДляПервичныхИИсправительныхДокументов
		);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПравилаОбработкиСчетовНаОплату(ПравилаОбработки)
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	ИдентификаторыПравил = ИдентификаторыПравилОбработкиДокументов();
	
	ДляПервичныхИИсправительныхДокументов = Неопределено;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаказыПоставщикам") Тогда
		ДобавитьПравилоОбработкиДокументов(
			ПравилаОбработки,
			ИдентификаторыПравил.ЗаказПоставщику,
			ВидыЭД.СчетНаОплату,
			ДляПервичныхИИсправительныхДокументов);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЗаявкиНаРасходованиеДенежныхСредств") Тогда
		ДобавитьПравилоОбработкиДокументов(
			ПравилаОбработки,
			ИдентификаторыПравил.ЗаявкаНаРасходованиеДенежныхСредств,
			ВидыЭД.СчетНаОплату,
			ДляПервичныхИИсправительныхДокументов);
	КонецЕсли;
	
	ДобавитьПравилоОбработкиДокументов(
		ПравилаОбработки,
		ИдентификаторыПравил.СписаниеБезналичныхДенежныхСредств,
		ВидыЭД.СчетНаОплату,
		ДляПервичныхИИсправительныхДокументов);
	
	ДобавитьПравилоОбработкиДокументов(
		ПравилаОбработки,
		ИдентификаторыПравил.РасходныйКассовыйОрдер,
		ВидыЭД.СчетНаОплату,
		ДляПервичныхИИсправительныхДокументов);
	
КонецПроцедуры

Функция ПартнерПоКонтрагенту(Контрагент)
	
	Результат = Справочники.Партнеры.НеизвестныйПартнер;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда 
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоНоменклатураУслуга(Номенклатура)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда 
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
		Результат = (ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьНалогообложениеНДС(ДокументОбъект, ДанныеЗаполнения)
	
	Если ДанныеЗаполнения.Свойство("Сумма") И ДанныеЗаполнения.Сумма = 0 Тогда
		
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя;
		
		Для Каждого Запись Из ДокументОбъект.Товары Цикл
			Запись.СуммаСНДС = Запись.Сумма;
		КонецЦикла;
		
	ИначеЕсли Не ЕстьСтрокиСНДС(ДокументОбъект.Товары) Тогда
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	Иначе
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНалогообложениеНДСПлатежныхДокументов(ДокументОбъект, НДСИсчисляетсяНалоговымАгентом)
	
	Если НДСИсчисляетсяНалоговымАгентом Тогда
		НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НалоговыйАгентПоНДС;
	Иначе
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
			ТабличнаяЧасть = ДокументОбъект.Товары;
		Иначе
			ТабличнаяЧасть = ДокументОбъект.РасшифровкаПлатежа;
		КонецЕсли;
		
		Если Не ЕстьСтрокиСНДС(ТабличнаяЧасть) Тогда
			НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
		Иначе
			НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументОбъект.НалогообложениеНДС = НалогообложениеНДС;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		ДокументОбъект.ЗакупкаПодДеятельность = НалогообложениеНДС;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьНалогообложениеНДСПУиПА(ДокументОбъект)
	
	Если Не ЕстьСтрокиСНДС(ДокументОбъект.Расходы) Тогда
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	Иначе
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьСтрокиСНДС(ТабличнаяЧасть)

	Результат = Ложь;
	
	ТабСтавкиНДС = ТабличнаяЧасть.Выгрузить(,"СтавкаНДС");
	ТабСтавкиНДС.Свернуть("СтавкаНДС");
	
	СтавкаБезНДС = СтавкаНДСПоПредставлению("без НДС");
	
	Для Каждого СтрокаТЧ Из ТабСтавкиНДС Цикл 
		Если СтрокаТЧ.СтавкаНДС <> СтавкаБезНДС Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет вид деятельности раздельного учета НДС по переданным параметрам заполнения.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - Обрабатываемый документ;
//  ИмяРеквизитаДляЗаполнения - ИмяРеквизитаДляЗаполнения - имя заполняемого реквизита;
//
Процедура ЗаполнитьВидДеятельностиНДС(ДокументОбъект, ИмяРеквизитаДляЗаполнения = "ЗакупкаПодДеятельность")
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, ИмяРеквизитаДляЗаполнения)
		Или ЗначениеЗаполнено(ДокументОбъект[ИмяРеквизитаДляЗаполнения]) Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	ТипНалогообложения = Неопределено;
	
	Если СравнитьВерсии(ВерсияУТ, "11.4.6") > 0 Тогда
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ДокументОбъект.Метаданные().ПолноеИмя());
		ПараметрыЗаполнения = МенеджерОбъекта.ПараметрыЗаполненияВидаДеятельностиНДС(ДокументОбъект);
		
		МодульУчетНДС = ОбщегоНазначения.ОбщийМодуль("УчетНДСУП");
		МодульУчетНДС.ЗаполнитьВидДеятельностиНДС(ТипНалогообложения, ПараметрыЗаполнения);
		
	Иначе
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Организация");
		ПараметрыЗаполнения.Вставить("Склад");
		ПараметрыЗаполнения.Вставить("Дата");
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДокументОбъект);
		
		ТипНалогообложения = Справочники.Организации.ЗакупкаПодДеятельность(ПараметрыЗаполнения.Организация
			, ПараметрыЗаполнения.Склад
			, ПараметрыЗаполнения.Дата);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипНалогообложения) Тогда
		ДокументОбъект[ИмяРеквизитаДляЗаполнения] = ТипНалогообложения;
	КонецЕсли;
	
КонецПроцедуры

Функция СтруктураЗаполненияПриобретенияТоваровУслуг(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеДляЗаполнения = Новый Структура;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("ЦенаВключаетНДС", ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Участники сделки
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	Шапка.Вставить("Партнер"			, ПартнерПоКонтрагенту(Шапка.Контрагент));
	
	// Валюта, сумма
	Шапка.Вставить("Валюта"		, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Курс"		, ШапкаЭД.Курс);
	Шапка.Вставить("Кратность"	, ШапкаЭД.Кратность);
	Шапка.Вставить("Сумма"		, ИтогиТЧ.СуммаСНДС);
	
	// Номера, даты
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	// Табличная часть
	Товары = Документы.ПриобретениеТоваровУслуг.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	Товары.Колонки.Добавить("НомерПоДаннымПоставщика");
	Товары.Колонки.Добавить("ДатаПоДаннымПоставщика");
	Товары.Колонки.Добавить("НомерПоДаннымКлиента");
	Товары.Колонки.Добавить("ДатаПоДаннымКлиента");
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	ЗаполнятьСведенияПрослеживаемости = ЗаполнятьСведенияПрослеживаемости();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 

		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;

		НоваяСтрока = Товары.Добавить();
		
		ЗаполнитьНоменклатуруПартнера(НоваяСтрока, НоменклатураКонтрагента);
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, НоменклатураИБ);
		
		Если ЭтоНоменклатураУслуга(НоваяСтрока.Номенклатура) Тогда
			НоваяСтрока.СписатьНаРасходы = Истина;
		КонецЕсли;
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
		
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаСНДС	 = Стр.СуммаСНДС;
		
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Количество = 1;
			Если НоваяСтрока.Цена = 0 Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		Если ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
			ТекКоэффициент = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(НоваяСтрока.Упаковка, НоваяСтрока.Номенклатура);
		Иначе
			ТекКоэффициент = 1;
		КонецЕсли;
		НоваяСтрока.Количество = НоваяСтрока.КоличествоУпаковок * ТекКоэффициент;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке, НоменклатураКонтрагента.GTIN);
		
		ЕстьСведенияПрослеживаемости = ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(Стр);
						
		Если ЗаполнятьСведенияПрослеживаемости И ЕстьСведенияПрослеживаемости Тогда
			ПодготовитьСведенияОПрослеживаемости(Стр.СведенияОПрослеживаемости, Стр.ДанныеГТД, НоваяСтрока);
		Иначе
			НоваяСтрока.НомерГТД = НомерГТДПоДаннымЭлектронногоДокумента(Стр.ДанныеГТД);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДляЗаполнения.Вставить("Шапка"	, Шапка);
	ДанныеДляЗаполнения.Вставить("Товары"	, Товары);
	ДанныеДляЗаполнения.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ПодготовитьСведенияОПрослеживаемости(ДанныеПрослеживаемостиЭД, ДанныеГТД, НоваяСтрока)
	
	Если ДанныеПрослеживаемостиЭД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитСКоличеством = "КоличествоПоРНПТ";
	
	Если ДанныеПрослеживаемостиЭД.Количество() = 1 Тогда
		НоваяСтрока.КоличествоПоРНПТ = ДанныеПрослеживаемостиЭД[0][РеквизитСКоличеством];
	Иначе
		ВсегоПоРНПТ = 0;
		Для Каждого ЭлементПрослеживаемости Из ДанныеПрослеживаемостиЭД Цикл
			ВсегоПоРНПТ = ВсегоПоРНПТ + ЭлементПрослеживаемости[РеквизитСКоличеством];
		КонецЦикла;
		НоваяСтрока.КоличествоПоРНПТ = ВсегоПоРНПТ; 
	КонецЕсли;
		
	РегистрационныеНомера = РегистрационныеНомераДекларацииИлиРНПТ_820(ДанныеПрослеживаемостиЭД, ДанныеГТД); 
		
	Если РегистрационныеНомера.Количество() = 1 Тогда
		НоваяСтрока.НомерГТД = РегистрационныеНомера[0];
	Иначе
		// предполагается, что пользователь сам выберет нужный номер РНПТ
		НоваяСтрока.НомерГТД = Справочники.НомераГТД.ПустаяСсылка();
	КонецЕсли;
			
КонецПроцедуры

Функция РегистрационныеНомераДекларацииИлиРНПТ_820(СведенияПрослеживаемости, ДанныеГТД)
	
	Результат = Новый Массив;
	
	ВсеПартииИзОднойСтраны = (ДанныеГТД.Количество() = 1);
													
	Если ВсеПартииИзОднойСтраны Тогда
		
		// даже, если не нашли ссылку в ИБ
		СтранаПроисхождения = ДанныеГТД[0].СтранаПроисхождения.Ссылка;
		
	Иначе
		
		// чтобы не вносить путаницу будем создавать регистрационный номер с незаполненной страной
		СтранаПроисхождения = Справочники.СтраныМира.ПустаяСсылка();
		
	КонецЕсли;	
						
	Для Каждого ЭлементПрослеживаемости Из СведенияПрослеживаемости Цикл
		
		// ищем регистрационный номер в коллекции "СведПрослеж", т.к. согласно 820@ в коллекции "СвТД" вместо номера будет строка "Прослеж"
		// или создаем все элементы в справочнике НомераГТД
		РегистрационныйНомер = НайтиСоздатьНомерГТД(ЭлементПрослеживаемости.НомерГТДРегистрационныйНомер, СтранаПроисхождения, Истина);
		
		Результат.Добавить(РегистрационныйНомер);
						
	КонецЦикла;
					
	Возврат Результат;
	
КонецФункции

Процедура ПодготовитьСведенияОПрослеживаемостиУКД(Источник, НоваяСтрока)
	
	ДанныеПрослеживаемостиЭД = Источник.СведенияОПрослеживаемости;
	
	Если ДанныеПрослеживаемостиЭД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитСКоличеством = "КоличествоПослеИзменения";
	
	Если ДанныеПрослеживаемостиЭД.Количество() = 1 Тогда
		НоваяСтрока.КоличествоПоРНПТ = ДанныеПрослеживаемостиЭД[0][РеквизитСКоличеством];
	Иначе
		ВсегоПоРНПТ = 0;
		Для Каждого ЭлементПрослеживаемости Из ДанныеПрослеживаемостиЭД Цикл
			ВсегоПоРНПТ = ВсегоПоРНПТ + ЭлементПрослеживаемости[РеквизитСКоличеством];
		КонецЦикла;
		НоваяСтрока.КоличествоПоРНПТ = ВсегоПоРНПТ; 
	КонецЕсли;
		
	РегистрационныеНомера = РегистрационныеНомераДекларацииИлиРНПТ_736(ДанныеПрослеживаемостиЭД, Источник); 
		
	Если РегистрационныеНомера.Количество() = 1 Тогда
		НоваяСтрока.НомерГТД = РегистрационныеНомера[0];
	Иначе
		// предполагается, что пользователь сам выберет нужный номер РНПТ
		НоваяСтрока.НомерГТД = Справочники.НомераГТД.ПустаяСсылка();
	КонецЕсли;
			
КонецПроцедуры

Функция РегистрационныеНомераДекларацииИлиРНПТ_736(ДанныеПрослеживаемостиЭД, Источник)
	
	Результат = Новый Массив;
	
	СтранаПроисхождения = Неопределено;
	
	Если ЗначениеЗаполнено(Источник.ДанныеГТД) Тогда
		
		ВсеПартииИзОднойСтраны = (Источник.ДанныеГТД.Количество() = 1);
		Если ВсеПартииИзОднойСтраны Тогда
			// даже, если не нашли ссылку в ИБ
			СтранаПроисхождения = Источник.ДанныеГТД[0].СтранаПроисхождения.Ссылка;
		Иначе
			// чтобы не вносить путаницу будем создавать регистрационный номер с незаполненной страной
			СтранаПроисхождения = Справочники.СтраныМира.ПустаяСсылка();
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Источник.ДопИнфо) Тогда
		
		СтранаПроисхождения = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НайтиСтрануПроисхожденияПоДаннымДопИнфо", Источник.ДопИнфо);
	
	КонецЕсли;
	
	Для Каждого ЭлементПрослеживаемости Из ДанныеПрослеживаемостиЭД Цикл
		
		// ищем регистрационный номер в коллекции "СведПрослеж", т.к. согласно 820@ в коллекции "СвТД" вместо номера будет строка "Прослеж"
		// или создаем все элементы в справочнике НомераГТД
		РегистрационныйНомер = НайтиСоздатьНомерГТД(ЭлементПрослеживаемости.НомерГТДРегистрационныйНомер, СтранаПроисхождения, Истина);
		
		Результат.Добавить(РегистрационныйНомер);
						
	КонецЦикла;
					
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПриобретениеТоваровУслуг(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	// Начальное заполнение
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Автор = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	// вручную переопределим, если требуется
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	// заполнение соглашения
	ЗаполнитьСоглашениеСПоставщиком(ДокументОбъект);
	
	// заполнение договора
	ЗаполнитьДоговорСПоставщиком(ДокументОбъект);
	
	// заполнение порядка расчетов из договора
	ЗаполнитьПорядокРасчетовИзДоговора(ДокументОбъект);
	
	ДокументОбъект.Товары.Загрузить(ДанныеДляЗагрузки.Товары);
	
	Если ДанныеДляЗагрузки.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДляЗагрузки.ШтрихкодыУпаковок);
	КонецЕсли;
	
	Отказ = Ложь;
	
	ЗакупкиСервер.СвязатьНоменклатуруСНоменклатуройПоставщика(ДокументОбъект.Товары, Отказ);
	
	// склады в ТЧ
	СкладГруппа = Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовЗакупки(ДокументОбъект.Склад);
	СкладыСервер.ЗаполнитьСкладыВТабличнойЧасти(ДокументОбъект.Склад, СкладГруппа, ДокументОбъект.Товары, Истина);
	
	// Тип налогообложения
	ЗаполнитьНалогообложениеНДС(ДокументОбъект, ДанныеЗаполнения);
	
	// заполнение реквизита ЗакупкаПодДеятельность
	ЗаполнитьВидДеятельностиНДС(ДокументОбъект, "ЗакупкаПодДеятельность");
	
	// пересчет цен и сумм в зависимости от включения НДС в цену
	ПересчитатьЦенуСуммуПриУстановкеФлагаЦенаВключаетНДС(ДокументОбъект, "Товары");
	
	// сумма документа
	ДокументОбъект.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(
		ДокументОбъект.Товары,
		ДокументОбъект.ЦенаВключаетНДС
	);
	
	Если ЭтоРедакция11_5() Тогда
		ОбщегоНазначенияУТ.ЗаполнитьИдентификаторыДокумента(ДокументОбъект, "Товары");
	Иначе
		ВзаиморасчетыСервер.ЗаполнитьИдентификаторыСтрокВТабличнойЧасти(ДокументОбъект.Товары);
	КонецЕсли;
	
КонецПроцедуры

Функция СтруктураЗаполненияПриобретенияУслугПрочихАктивов(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеДляЗаполнения = Новый Структура;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("ЦенаВключаетНДС", ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Участники сделки
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Партнер"	, ПартнерПоКонтрагенту(Шапка.Контрагент));
	
	// Валюта, сумма
	Шапка.Вставить("Валюта"		, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Курс"		, ШапкаЭД.Курс);
	Шапка.Вставить("Кратность"	, ШапкаЭД.Кратность);
	Шапка.Вставить("Сумма"		, ИтогиТЧ.СуммаСНДС);
	
	// Номера, даты
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	// Табличная часть
	ТабличнаяЧасть = Документы.ПриобретениеУслугПрочихАктивов.ПустаяСсылка().Расходы.ВыгрузитьКолонки();
	ТабличнаяЧасть.Колонки.Добавить("НомерПоДаннымПоставщика");
	ТабличнаяЧасть.Колонки.Добавить("ДатаПоДаннымПоставщика");
	ТабличнаяЧасть.Колонки.Добавить("НомерПоДаннымКлиента");
	ТабличнаяЧасть.Колонки.Добавить("ДатаПоДаннымКлиента");
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		НоваяСтрока.Содержание = НоменклатураКонтрагента.Описание;
		Если Не ЗначениеЗаполнено(НоваяСтрока.Содержание) Тогда
			НоваяСтрока.Содержание = НоменклатураКонтрагента.Наименование;
		КонецЕсли;
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
		
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаСНДС	 = Стр.СуммаСНДС;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Цена) Тогда
			
			Количество = НоваяСтрока.Количество;
			Если Не ЗначениеЗаполнено(Количество) Тогда
				Количество = 1;
			КонецЕсли;
			
			НоваяСтрока.Цена = НоваяСтрока.Сумма / Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДляЗаполнения.Вставить("Шапка"	, Шапка);
	ДанныеДляЗаполнения.Вставить("Расходы"	, ТабличнаяЧасть);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ЗаполнитьПриобретениеУслугПрочихАктивов(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	// Начальное заполнение
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	// вручную переопределим, если требуется
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	// заполнение соглашения
	ЗаполнитьСоглашениеСПоставщиком(ДокументОбъект);
	
	// заполнение договора
	ЗаполнитьДоговорСПоставщиком(ДокументОбъект);
	
	// заполнение порядка расчетов из договора
	ЗаполнитьПорядокРасчетовИзДоговора(ДокументОбъект);
	
	ДокументОбъект.Расходы.Загрузить(ДанныеДляЗагрузки.Расходы);
	
	Отказ = Ложь;
	
	// Тип налогообложения
	ЗаполнитьНалогообложениеНДСПУиПА(ДокументОбъект);
	
	// заполнение реквизита ЗакупкаПодДеятельность
	ЗаполнитьВидДеятельностиНДС(ДокументОбъект, "ЗакупкаПодДеятельность");
	
	// пересчет цен и сумм в зависимости от включения НДС в цену
	ПересчитатьЦенуСуммуПриУстановкеФлагаЦенаВключаетНДС(ДокументОбъект, "Расходы");
	
	// сумма документа
	ДокументОбъект.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(ДокументОбъект.Расходы, ДокументОбъект.ЦенаВключаетНДС);
	
КонецПроцедуры

Функция СтруктураЗаполненияВозвратаТоваровОтКлиента(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ОбщиеПараметрыЗаполненияДокументовУчета();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеДляЗаполнения = Новый Структура;
	
	Шапка = Новый Структура;
	
	Шапка.Вставить("ЦенаВключаетНДС", ПараметрыЗаполнения.ЦенаВключаетНДС);
	
	// Участники сделки
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	Шапка.Вставить("Партнер"			, ПартнерПоКонтрагенту(Шапка.Контрагент));
	
	// Валюта, сумма
	Шапка.Вставить("Валюта"		, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Курс"		, ШапкаЭД.Курс);
	Шапка.Вставить("Кратность"	, ШапкаЭД.Кратность);
	Шапка.Вставить("Сумма"		, ИтогиТЧ.СуммаСНДС);
	
	// Номера, даты
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	// Табличная часть
	Товары = Документы.ВозвратТоваровОтКлиента.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	Товары.Колонки.Добавить("НомерПоДаннымПоставщика");
	Товары.Колонки.Добавить("ДатаПоДаннымПоставщика");
	Товары.Колонки.Добавить("НомерПоДаннымКлиента");
	Товары.Колонки.Добавить("ДатаПоДаннымКлиента");
	
	Если Товары.Колонки.Найти("НомерГТД") = Неопределено Тогда
		Товары.Колонки.Добавить("НомерГТД");
	КонецЕсли;
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	ЗаполнятьСведенияПрослеживаемости = ЗаполнятьСведенияПрослеживаемости();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоваяСтрока = Товары.Добавить();
		
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, Стр.Номенклатура);
		
		НоваяСтрока.НомерГТД = НомерГТДПоДаннымЭлектронногоДокумента(Стр.ДанныеГТД);
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
		
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаСНДС	 = Стр.СуммаСНДС;
		
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Количество = 1;
			Если НоваяСтрока.Цена = 0 Тогда
				НоваяСтрока.Цена = НоваяСтрока.Сумма;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		Если ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
			ТекКоэффициент = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(НоваяСтрока.Упаковка, НоваяСтрока.Номенклатура);
		Иначе
			ТекКоэффициент = 1;
		КонецЕсли;
		НоваяСтрока.Количество = НоваяСтрока.КоличествоУпаковок * ТекКоэффициент;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке);
		
		ЕстьСведенияПрослеживаемости = ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(Стр);
						
		Если ЗаполнятьСведенияПрослеживаемости И ЕстьСведенияПрослеживаемости Тогда
			ПодготовитьСведенияОПрослеживаемости(Стр.СведенияОПрослеживаемости, Стр.ДанныеГТД, НоваяСтрока);
		Иначе
			НоваяСтрока.НомерГТД = НомерГТДПоДаннымЭлектронногоДокумента(Стр.ДанныеГТД);
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДляЗаполнения.Вставить("Шапка"	, Шапка);
	ДанныеДляЗаполнения.Вставить("Товары"	, Товары);
	ДанныеДляЗаполнения.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ЗаполнитьВозвратТоваровОтКлиента(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	// Начальное заполнение
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Менеджер = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Заполнить(ДанныеЗаполнения);
	
	// Стандартная процедура заполнения по какой то причине
	// устанавливает пустую ссылку в реквизит
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ДокументРеализации) Тогда
		ДокументОбъект.ДокументРеализации = Неопределено;
	КонецЕсли;
	
	// вручную переопределим, если требуется
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	// заполнение соглашения
	ЗаполнитьСоглашениеСКлиентом(ДокументОбъект);
	
	// заполнение договора
	ЗаполнитьДоговорСКлиентом(ДокументОбъект);
	
	// заполнение порядка расчетов из договора
	ЗаполнитьПорядокРасчетовИзДоговора(ДокументОбъект);
	
	ДокументОбъект.Товары.Загрузить(ДанныеДляЗагрузки.Товары);
	
	Если ДанныеДляЗагрузки.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДляЗагрузки.ШтрихкодыУпаковок);
	КонецЕсли;
	
	// Тип налогообложения
	ЗаполнитьНалогообложениеНДС(ДокументОбъект, ДанныеЗаполнения);
	
	// пересчет цен и сумм в зависимости от включения НДС в цену
	ПересчитатьЦенуСуммуПриУстановкеФлагаЦенаВключаетНДС(ДокументОбъект, "Товары");
	
	// сумма документа
	ДокументОбъект.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(
			ДокументОбъект.Товары,
			ДокументОбъект.ЦенаВключаетНДС);
	
КонецПроцедуры

Функция СтруктураЗаполненияСчетаФактуры(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияСчетаФактуры();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	
	// Номера, даты
	Шапка.Вставить("Номер", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаСоставления", ШапкаЭД.Дата);
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	Если ФорматЭД.ЭтоИсправление Тогда
		Шапка.Вставить("Исправление"		, Истина);
		Шапка.Вставить("НомерИсправления"	, СвойствоСтруктуры(ШапкаЭД, "НомерИсправления"));
		Шапка.Вставить("ДатаИсправления"	, СвойствоСтруктуры(ШапкаЭД, "ДатаИсправления"));
	КонецЕсли;
	
	ЭтоАванс = ДанныеЭД.ЭтоАванс;
	
	// Вид операции
	Шапка.Вставить("КодВидаОперации", ?(ЭтоАванс, "02", "01"));
	Шапка.Вставить("ПолученВЭлектронномВиде", Истина);
	
	// Участники сделки
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ИННКонтрагента"	, ШапкаЭД.Продавец.ИНН);
	Шапка.Вставить("КППКонтрагента"	, ШапкаЭД.Продавец.КПП);
	
	// Документы-основания
	ДокументыОснования = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументыОснования) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ДокументыОснования = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументыОснования) Тогда
		Шапка.Вставить("ДокументОснование", ДокументыОснования);
	КонецЕсли;
	
	// Валюта, сумма
	Шапка.Вставить("Валюта"		, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Сумма"		, ИтогиТЧ.СуммаСНДС);
	Шапка.Вставить("СуммаНДС"	, ИтогиТЧ.СуммаНДС);
	
	ДанныеДляЗаполнения = Новый Структура;
	ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
	
	// Авансы
	Если ЭтоАванс Тогда
		
		Авансы = Документы.СчетФактураПолученныйАванс.ПустаяСсылка().Авансы.Выгрузить();
		
		Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
			
			ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
			
			НоваяСтрока = Авансы.Добавить();
			НоваяСтрока.Сумма = Стр.СуммаСНДС;
			НоваяСтрока.СуммаНДС = Стр.СуммаНДС;
			НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
			
		КонецЦикла;
		
		Если Авансы.Количество() > 0 Тогда
			ДанныеДляЗаполнения.Вставить("Авансы", Авансы);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Функция СтруктураЗаполненияКорректировкиПоступления(ДанныеЭД, ДополнительныеПараметры)
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеДляЗаполнения = Новый Структура;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Организация"		, СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"			, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель"	, СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	Шапка.Вставить("Валюта"				, ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("ВалютаВзаиморасчетов", ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Партнер"	, ПартнерПоКонтрагенту(Шапка.Контрагент));
	Шапка.Вставить("Курс"		, ШапкаЭД.Курс);
	Шапка.Вставить("Кратность"	, ШапкаЭД.Кратность);
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента"	, ШапкаЭД.Дата);
	
	Если ФорматЭД.ЭтоКорректировка Тогда
		СуммаДокумента		= ИтогиТЧ.СуммаСНДСУвеличение + ИтогиТЧ.СуммаСНДСУменьшение;
		ВидКорректировки	= Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
		
		ДокументыОснования	= СвойствоСтруктуры(ШапкаЭД, "КорректируемыйДокумент.ПервичныйДокумент");
		Если Не ТипЗнч(ДокументыОснования) = Тип("Массив") Тогда 
			ДокументыОснования = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументыОснования);
		КонецЕсли;
	Иначе
		СуммаДокумента		= ИтогиТЧ.СуммаСНДС;
		ВидКорректировки	= Перечисления.ХозяйственныеОперации.ИсправлениеОшибок;
		
		ДокументОснование	= СвойствоСтруктуры(ДополнительныеПараметры, "ДокументОснование");
		ДокументыОснования	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
	КонецЕсли;
	
	Шапка.Вставить("Сумма", СуммаДокумента);
	Шапка.Вставить("ВидКорректировки", ВидКорректировки);
	
	Для Каждого Основание Из ДокументыОснования Цикл
		
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.КорректировкаПриобретения") Тогда
			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "ДокументОснование");
			ДокОснование = РеквизитыОснования.ДокументОснование;
		Иначе
			ДокОснование = Основание;
		КонецЕсли;
		
		Если ТипЗнч(ДокОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			Шапка.Вставить("ДокументОснование"	, ДокОснование);
			Шапка.Вставить("НалогообложениеНДС"	, ДокОснование.НалогообложениеНДС);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Товары = Документы.ПриобретениеТоваровУслуг.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	Товары.Колонки.Добавить("НомерПоДаннымПоставщика");
	Товары.Колонки.Добавить("ДатаПоДаннымПоставщика");
	Товары.Колонки.Добавить("НомерПоДаннымКлиента");
	Товары.Колонки.Добавить("ДатаПоДаннымКлиента");
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	ЗаполнятьСведенияПрослеживаемости = ЗаполнятьСведенияПрослеживаемости();
	
	ТоварыДокументаОснования = ТабличнаяЧастьТоварыДоКорректировки(ДокОснование);
	
	НомерСтроки = 1;
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		НоваяСтрока = Товары.Добавить();
		
		ЗаполнитьНоменклатуруПартнера(НоваяСтрока, НоменклатураКонтрагента);
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, НоменклатураИБ);
		
		ПредставлениеСтавки = НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
		
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаСНДС	 = Стр.СуммаСНДС;
		
		СтрокаТовары_ПересчитатьКоличество(НоваяСтрока);
		
		Если ЭтоИсправлениеПоступленияТоваровУслуг(ФорматЭД) Тогда
			
			НоваяСтрока.НомерСтроки = НомерСтроки;
			
			НомерСтроки = НомерСтроки + 1;
			
		Иначе
			
			НоваяСтрока.НомерСтроки = УбратьСкорректированноеКоличествоИзИсходнойТаблицы(
				ТоварыДокументаОснования,
				Стр
			);
			
		КонецЕсли;
		
		Если НоваяСтрока.Количество = 0 Тогда
			Товары.Удалить(НоваяСтрока);
			Продолжить;
		КонецЕсли;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке, НоменклатураКонтрагента.GTIN);
		
		Если ЗаполнятьСведенияПрослеживаемости 
			И ВТабличнойЧастиЭДЕстьСведенияПрослеживаемости(Стр) Тогда
			
			ПодготовитьСведенияОПрослеживаемостиУКД(Стр, НоваяСтрока);
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "НомерГТД") Тогда
			
			НоваяСтрока.НомерГТД = НомерГТДПоДаннымЭлектронногоДокумента(Стр.ДанныеГТД);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЭтоИсправлениеПоступленияТоваровУслуг(ФорматЭД) Тогда
		
		ПараметрыПересчетаСумм = ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокОснование);
		
		Для Каждого СтрокаТЧоснования Из ТоварыДокументаОснования Цикл
			
			ДобавляемаяСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ДобавляемаяСтрока, СтрокаТЧоснования);
			
			СтрокаТовары_ПересчитатьКоличество(ДобавляемаяСтрока);
			СтрокаТовары_ПересчитатьСуммы(ДобавляемаяСтрока, ПараметрыПересчетаСумм);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Товары.Сортировать("НомерСтроки, Номенклатура, Характеристика, Серия, Упаковка");
	
	ДанныеДляЗаполнения.Вставить("Шапка"	, Шапка);
	ДанныеДляЗаполнения.Вставить("Товары"	, Товары);
	ДанныеДляЗаполнения.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Функция ЭтоИсправлениеПоступленияТоваровУслуг(ФорматЭД)
	
	Результат = (ФорматЭД.ЭтоИсправление И НЕ ФорматЭД.ЭтоКорректировка);
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧастьТоварыДоКорректировки(ДокументПриобретения)
	
	ТабличнаяЧастьКорректировки = Документы.КорректировкаПриобретения.ПустаяСсылка().Товары;
	
	Если ЗначениеЗаполнено(ДокументПриобретения) Тогда
		
		Документы.КорректировкаПриобретения.ЗаполнитьТоварыПоИсходнымДанным(
			ДокументПриобретения,
			ТабличнаяЧастьКорректировки
		);
		
	КонецЕсли;
	
	Результат = ТабличнаяЧастьКорректировки.Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Убирает из исходной таблицы товаров количество, уже отраженное по данным электронного УКД
//
// Параметры:
//  ТоварыДокументаОснования - ТаблицаЗначений - содержимое ТЧ "Товары" до корректировки
//  СтрокаУКД - СтрокаТаблицыЗначений - строка электронного УКД
// 
// Возвращаемое значение:
//  Число - номер скорректированной строки.
//
Функция УбратьСкорректированноеКоличествоИзИсходнойТаблицы(ТоварыДокументаОснования, СтрокаУКД)
	
	Результат = 9999;
	
	НоменклатураИБ = СтрокаУКД.Номенклатура;
	БазовыеПараметрыОтбора = ПараметрыПоискаСтрокТабличнойЧастиПоНоменклатуре(НоменклатураИБ);
	
	ПараметрыОтбора = Новый Структура(БазовыеПараметрыОтбора);
	ПараметрыОтбора.Вставить("Количество", СтрокаУКД.Количество_До);
	ПараметрыОтбора.Вставить("СуммаСНДС", СтрокаУКД.СуммаСНДС_До);
	НайденныеСтрокиТоваров = ТоварыДокументаОснования.НайтиСтроки(ПараметрыОтбора);
	
	Если Не ЗначениеЗаполнено(НайденныеСтрокиТоваров) Тогда
		
		ПараметрыОтбора = Новый Структура(БазовыеПараметрыОтбора);
		ПараметрыОтбора.Вставить("Цена", СтрокаУКД.Цена_До);
		НайденныеСтрокиТоваров = ТоварыДокументаОснования.НайтиСтроки(ПараметрыОтбора);
		
	КонецЕсли;
	
	ТребуетсяРаспределить = СтрокаУКД.Количество_До;
	
	Для Каждого СтрокаТовары Из НайденныеСтрокиТоваров Цикл
		
		Если ТребуетсяРаспределить <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		Распределено = Мин(ТребуетсяРаспределить, СтрокаТовары.Количество);
		ТребуетсяРаспределить = ТребуетсяРаспределить - Распределено;
		СтрокаТовары.Количество = СтрокаТовары.Количество - Распределено;
		
		Результат = СтрокаТовары.НомерСтроки;
		
		Если СтрокаТовары.Количество <= 0 Тогда
			ТоварыДокументаОснования.Удалить(СтрокаТовары);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыПоискаСтрокТабличнойЧастиПоНоменклатуре(НоменклатураИБ)
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура", НоменклатураИБ.Номенклатура);
	
	Если ЗначениеЗаполнено(НоменклатураИБ.Характеристика) Тогда
		Результат.Вставить("Характеристика", НоменклатураИБ.Характеристика);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоменклатураИБ.Упаковка) Тогда
		ЕдиницаХраненияНоменклатуры = ЭлектронноеВзаимодействиеУТВызовСервера.ЕдиницаХраненияНоменклатуры(НоменклатураИБ.Номенклатура);
		Если НоменклатураИБ.Упаковка <> ЕдиницаХраненияНоменклатуры Тогда
			Результат.Вставить("Упаковка", НоменклатураИБ.Упаковка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Процедура СтрокаТовары_ПересчитатьКоличество(СтрокаТовары)
	
	СтрокаТовары.КоличествоУпаковок = СтрокаТовары.Количество;
	
	Если ЗначениеЗаполнено(СтрокаТовары.Упаковка) Тогда
		ТекКоэффициент = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(СтрокаТовары.Упаковка, СтрокаТовары.Номенклатура);
	Иначе
		ТекКоэффициент = 1;
	КонецЕсли;
	
	СтрокаТовары.Количество = СтрокаТовары.КоличествоУпаковок * ТекКоэффициент;
	
КонецПроцедуры

Процедура СтрокаТовары_ПересчитатьСуммы(СтрокаТовары, ПараметрыПересчетаСумм)
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", ПараметрыПересчетаСумм);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", ПараметрыПересчетаСумм);
	СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
	
	КэшированныеЗначения = Неопределено;
	
	МодульОбработкаТабличнойЧастиСервер = ОбщийМодульОбработкаТабличнойЧастиСервер();
	
	МодульОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(
		СтрокаТовары,
		СтруктураДействий,
		КэшированныеЗначения
	);
	
КонецПроцедуры

Процедура ЗаполнитьКорректировкуПоступления(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	
	ДокументОснование = СвойствоСтруктуры(ДанныеЗаполнения, "ДокументОснование");
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда 
		ДокументОбъект.Заполнить(ДокументОснование);
	Иначе 
		ДокументОбъект.Заполнить(ДанныеЗаполнения);
	КонецЕсли;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ДокументОбъект.Товары.Загрузить(ДанныеДляЗагрузки.Товары);
	Для Каждого Строка Из ДокументОбъект.Товары Цикл 
		Если ДокументОбъект.ЦенаВключаетНДС И Строка.Сумма <> Строка.СуммаСНДС Тогда
			Строка.Сумма = Строка.СуммаСНДС;
			Если Строка.Количество <> 0 Тогда
				Строка.Цена = Окр(Строка.Сумма/Строка.Количество, 2);
			Иначе
				Строка.Цена = Строка.Сумма;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//СтруктураПоискаСтроки = Новый Структура("Номенклатура, Характеристика, СтавкаНДС, Упаковка");
	//ТаблицаТоваровДокумента = ДокументОбъект.Товары;
	//
	//// Пересчет цен и сумм в зависимости от включения НДС в цену
	//СтруктураПересчетаСуммы = ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
	//
	//СтруктураДействий = Новый Структура;
	//СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	//
	//Если ДокументОбъект.ЦенаВключаетНДС Тогда
	//	СтруктураДействий.Вставить("ПересчитатьСумму");
	//	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	//	СтруктураДействий.Вставить("ПересчитатьЦенуСНДС");
	//КонецЕсли;
	//
	//Для Каждого Стр Из ДанныеДляЗагрузки.Товары Цикл 
	//	ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки, Стр);
	//	СтрокиКорректировки = ТаблицаТоваровДокумента.НайтиСтроки(СтруктураПоискаСтроки);
	//	Если СтрокиКорректировки.Количество() > 0 Тогда
	//		ЗаполняемаяСтрока = СтрокиКорректировки[0];
	//		Если Стр.Количество = 0 Тогда
	//			ТаблицаТоваровДокумента.Удалить(ЗаполняемаяСтрока);
	//			Продолжить;
	//		КонецЕсли;
	//	Иначе
	//		ЗаполняемаяСтрока = ТаблицаТоваровДокумента.Добавить();
	//	КонецЕсли; 
	//	
	//	ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, Стр); 
	//	
	//	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ЗаполняемаяСтрока, СтруктураДействий, Неопределено);
	//	
	//КонецЦикла;
	
	Если ДанныеДляЗагрузки.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДляЗагрузки.ШтрихкодыУпаковок);
	КонецЕсли;
	
	Отказ = Ложь;
	ЗакупкиСервер.СвязатьНоменклатуруСНоменклатуройПоставщика(ДокументОбъект.Товары, Отказ);
	
	// заполнение соглашения
	ЗаполнитьСоглашениеСПоставщиком(ДокументОбъект);
	
	// заполнение договора
	ЗаполнитьДоговорСПоставщиком(ДокументОбъект);
	
	// заполнение порядка расчетов из договора
	ЗаполнитьПорядокРасчетовИзДоговора(ДокументОбъект);
	
	// Склады в ТЧ
	Если ЗначениеЗаполнено(ДокументОснование) И Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЗаполнения.ДокументОснование, "Склад");
		Если ЗначениеЗаполнено(РеквизитыОснования.Склад) Тогда
			ДокументОбъект.Склад = ДанныеЗаполнения.ДокументОснование.Склад;
		КонецЕсли
	КонецЕсли;
	СкладГруппа = Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовЗакупки(ДокументОбъект.Склад);
	СкладыСервер.ЗаполнитьСкладыВТабличнойЧасти(ДокументОбъект.Склад, СкладГруппа, ДокументОбъект.Товары, Истина);
	
	// Заполним расхождения
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
		ИспользуетсяДокументПоступлениеТоваров = Ложь;
		Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
			ВариантОформленияЗакупок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Договор, "ВариантОформленияЗакупок");
			ИспользуетсяДокументПоступлениеТоваров = ВариантОформленияЗакупок <> Перечисления.ВариантыОформленияЗакупок.НеРазделять;
		КонецЕсли;
		
		Если ЭтоРедакция11_5() Тогда
			ДокументОбъект.ЗаполнитьРасхождения(ИспользуетсяДокументПоступлениеТоваров);
		Иначе
			Документы.КорректировкаПриобретения.ЗаполнитьРасхождения(ДокументОбъект, ИспользуетсяДокументПоступлениеТоваров);
		КонецЕсли;
	КонецЕсли;
	
	// Сумма документа
	ДокументОбъект.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(ДокументОбъект.Товары, ДокументОбъект.ЦенаВключаетНДС);
	
КонецПроцедуры

Функция СтруктураЗаполненияКорректировочногоСчетаФактуры(ДанныеЭД, ДополнительныеПараметры)
	
	ПараметрыЗаполнения = ПараметрыЗаполненияСчетаФактуры();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Номер", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаСоставления", ШапкаЭД.Дата);
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	Шапка.Вставить("Корректировочный", Истина);
	
	Шапка.Вставить("Валюта", ШапкаЭД.Валюта.Ссылка);
	
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент"	, СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("ИННКонтрагента"	, ШапкаЭД.Продавец.ИНН);
	Шапка.Вставить("КППКонтрагента"	, ШапкаЭД.Продавец.КПП);
	
	КодВидаОперации = "01";
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	Шапка.Вставить("ПолученВЭлектронномВиде", Истина);
	
	Если ФорматЭД.ЭтоИсправление Тогда 
		Шапка.Вставить("Исправление"		, Истина);
		Шапка.Вставить("НомерИсправления"	, ШапкаЭД.НомерИсправления);
		Шапка.Вставить("ДатаИсправления"	, ШапкаЭД.ДатаИсправления);
	КонецЕсли;
	
	Шапка.Вставить("Сумма", ИтогиТЧ.СуммаСНДСУвеличение + ИтогиТЧ.СуммаСНДСУменьшение);
	
	// Документы-основания
	ДокументыОснования = ПараметрыЗаполнения.ДокументОснование;
	Если Не ЗначениеЗаполнено(ДокументыОснования) Тогда
		ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
		ДокументыОснования = СопоставленныеУчетныеДокументы(ИдентификаторЭД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументыОснования) Тогда
		Шапка.Вставить("ДокументОснование", ДокументыОснования);
	КонецЕсли;
	
	СчетФактураОснование = СвойствоСтруктуры(ШапкаЭД, "КорректируемыйДокумент.СчетФактура");
	Если ТипЗнч(СчетФактураОснование) = Тип("Массив") Тогда 
		СчетФактураОснование = ?(ЗначениеЗаполнено(СчетФактураОснование), СчетФактураОснование[0], Неопределено);
	КонецЕсли;
	Шапка.Вставить("СчетФактураОснование", СчетФактураОснование);
	
	ДанныеДляЗаполнения = Новый Структура;
	ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ЗаполнитьСчетФактуруПолученный(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеШапки = ДанныеДляЗагрузки.Шапка;
	
	ДокументОбъект.Заполнить(ДанныеШапки);
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапки);
	
КонецПроцедуры

Процедура ЗаполнитьСчетФактуруПолученныйНаАванс(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДанныеШапки = ДанныеДляЗагрузки.Шапка;
	
	ДокументОбъект.Заполнить(ДанныеШапки);
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапки);
	
	ДокументОбъект.Авансы.Загрузить(ДанныеДляЗагрузки.Авансы);
	
КонецПроцедуры

Функция СтруктураЗаполненияАктаОРасхожденияхПослеОтгрузки(ДанныеЭД, ДополнительныеПараметры)

	ФорматЭД = ДанныеЭД.ЭлектронныйДокумент.Формат;
	ШапкаЭД = ДанныеЭД.Шапка;
	ИтогиТЧ = ДанныеЭД.Итоги;
	
	ДанныеДляЗаполнения = Новый Структура;
	
	Шапка = Новый Структура;
	Шапка.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Покупатель));
	Шапка.Вставить("Контрагент", СсылкаНаУчастникаСделки(ШапкаЭД.Продавец));
	Шапка.Вставить("Грузоотправитель", СсылкаНаУчастникаСделки(ШапкаЭД.Грузоотправитель));
	Шапка.Вставить("Грузополучатель", СсылкаНаУчастникаСделки(ШапкаЭД.Грузополучатель));
	Шапка.Вставить("Валюта", ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("Партнер", ПартнерПоКонтрагенту(Шапка.Контрагент));
	Шапка.Вставить("НомерВходящегоДокумента", ШапкаЭД.Номер);
	Шапка.Вставить("ДатаВходящегоДокумента", ШапкаЭД.Дата);
	Шапка.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	
	НомерДокументаБезПрефикса = НомерДокументаБезПрефикса(ДанныеЭД.Шапка.Основание.Номер);
	
	НомераДокументов = Новый Массив;
	НомераДокументов.Добавить(ДанныеЭД.Шапка.Основание.Номер);
	НомераДокументов.Добавить(НомерДокументаБезПрефикса);
	
	Организация		= Шапка.Организация;
	ДатаДокумента	= НачалоДня(ДанныеЭД.Шапка.Основание.Дата);
	
	ДокументОснование = НайтиОснованиеДокументаОРасхождениях(Организация, ДатаДокумента, НомераДокументов);
	
	ДополнитьПараметрыЗаполненияАктаОРасхожденияхПоДокументуОснованию(ДокументОснование, Шапка);
	
	Товары = Документы.АктОРасхожденияхПослеОтгрузки.ПустаяСсылка().Товары.ВыгрузитьКолонки();
	Товары.Колонки.Добавить("НомерПоДаннымПоставщика");
	Товары.Колонки.Добавить("ДатаПоДаннымПоставщика");
	Товары.Колонки.Добавить("НомерПоДаннымКлиента");
	Товары.Колонки.Добавить("ДатаПоДаннымКлиента");
	
	// Маркировка
	ШтрихкодыУпаковок = НоваяТаблицаШтрихкодыУпаковок();
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоваяСтрока = Товары.Добавить();
		
		ЗаполнитьНоменклатуруИнформационнойБазы(НоваяСтрока, Стр.Номенклатура);
		
		ПредставлениеСтавки = Стр.НоменклатураКонтрагента.СтавкаНДС;
		НоваяСтрока.СтавкаНДС = СтавкаНДСПоПредставлению(ПредставлениеСтавки, ШапкаЭД.Дата);
		
		НоваяСтрока.СуммаНДС	 = Стр.СуммаНДС;
		НоваяСтрока.Количество	 = Стр.Количество;
		НоваяСтрока.Цена		 = Стр.Цена;
		НоваяСтрока.Сумма		 = Стр.СуммаБезНДС;
		НоваяСтрока.СуммаСНДС	 = Стр.СуммаСНДС;
		
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Упаковка) Тогда
			ТекКоэффициент = Справочники.УпаковкиЕдиницыИзмерения.КоэффициентУпаковки(НоваяСтрока.Упаковка, НоваяСтрока.Номенклатура);
		Иначе
			ТекКоэффициент = 1;
		КонецЕсли;
		
		НоваяСтрока.Количество = НоваяСтрока.КоличествоУпаковок * ТекКоэффициент;
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(НоваяСтрока, "НомерГТД") Тогда
			НоваяСтрока.НомерГТД = НомерГТДПоДаннымЭлектронногоДокумента(Стр.ДанныеГТД);
		КонецЕсли;
		
		ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, Стр.СведенияОМаркировке);
		
	КонецЦикла;
	
	ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
	ДанныеДляЗаполнения.Вставить("Товары", Товары);
	ДанныеДляЗаполнения.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	
	Возврат ДанныеДляЗаполнения;

КонецФункции

Процедура ДополнитьПараметрыЗаполненияАктаОРасхожденияхПоДокументуОснованию(ДокументОснование, Шапка)

	Если НЕ ЗначениеЗаполнено(ДокументОснование)
		ИЛИ ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат;
	КонецЕсли;
	
	НаборРеквизитов = "НалогообложениеНДС, ЦенаВключаетНДС, Валюта";
	РеквизитыДокументаОснования = РазрешенныеЗначенияРеквизитовОбъекта(ДокументОснование, НаборРеквизитов);
	
	Шапка.Вставить("ДокументОснование",		ДокументОснование);
	Шапка.Вставить("НалогообложениеНДС",	РеквизитыДокументаОснования.НалогообложениеНДС);
	Шапка.Вставить("ЦенаВключаетНДС",		РеквизитыДокументаОснования.ЦенаВключаетНДС);
	Шапка.Вставить("Валюта",				РеквизитыДокументаОснования.Валюта);

КонецПроцедуры

// Возвращает структуру, содержащую значения реквизитов, прочитанные из информационной базы по ссылке на объект.
// Рекомендуется использовать вместо обращения к реквизитам объекта через точку от ссылки на объект
// для быстрого чтения отдельных реквизитов объекта из базы данных.
//
// Если необходимо зачитать реквизит независимо от прав текущего пользователя,
// то следует использовать предварительный переход в привилегированный режим.
//
// Параметры:
//  Ссылка    - ЛюбаяСсылка - объект, значения реквизитов которого необходимо получить.
//            - Строка      - полное имя предопределенного элемента, значения реквизитов которого необходимо получить.
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//                       требований к свойствам структуры.
//                       Например, "Код, Наименование, Родитель".
//            - Структура
//            - ФиксированнаяСтруктура - в качестве ключа передается
//                       псевдоним поля для возвращаемой структуры с результатом, а в качестве
//                       значения (опционально) фактическое имя поля в таблице.
//                       Если ключ задан, а значение не определено, то имя поля берется из ключа.
//                       Допускается указание имени поля через точку, но при этом параметр КодЯзыка для такого поля
//                       учитываться не будет.
//            - Массив
//            - ФиксированныйМассив - имена реквизитов в формате требований к свойствам структуры.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//              Если в параметр Реквизиты передана пустая строка, то возвращается пустая структура.
//              Если в параметр Ссылка передана пустая ссылка, то возвращается структура, 
//              соответствующая именам реквизитов со значениями Неопределено.
//              Если в параметр Ссылка передана ссылка несуществующего объекта (битая ссылка), 
//              то все реквизиты вернутся со значением Неопределено.
//
Функция РазрешенныеЗначенияРеквизитовОбъекта(Ссылка, Реквизиты)
	
	ВыбратьРазрешенныеЗначения	= Истина;
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты, ВыбратьРазрешенныеЗначения);
	
	Возврат Результат;

КонецФункции

// Возвращает значения реквизита, прочитанного из информационной базы по ссылке на объект.
// Рекомендуется использовать вместо обращения к реквизитам объекта через точку от ссылки на объект
// для быстрого чтения отдельных реквизитов объекта из базы данных.
//
// Если необходимо зачитать реквизит независимо от прав текущего пользователя,
// то следует использовать предварительный переход в привилегированный режим.
//
// Параметры:
//  Ссылка    - ЛюбаяСсылка - объект, значения реквизитов которого необходимо получить.
//            - Строка      - полное имя предопределенного элемента, значения реквизитов которого необходимо получить.
//  ИмяРеквизита - Строка - имя получаемого реквизита.
//                          Допускается указание имени реквизита через точку, но при этом параметр КодЯзыка для
//                          такого реквизита учитываться не будет.
//
// Возвращаемое значение:
//  Произвольный - если в параметр Ссылка передана пустая ссылка, то возвращается Неопределено.
//                 Если в параметр Ссылка передана ссылка несуществующего объекта (битая ссылка), то возвращается Неопределено.
//
Функция РазрешенноеЗначениеРеквизитаОбъекта(Ссылка, Реквизиты)

	ВыбратьРазрешенныеЗначения	= Истина;
	Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Реквизиты, ВыбратьРазрешенныеЗначения);
	
	Возврат Результат;

КонецФункции

Функция ЗначенияРеквизитовОбъектаЛокальная(Ссылка, Реквизиты)
	
	Результат = МетодСервера("Модуль_ИнтеграцияУниверсальный", "ЗначенияРеквизитовОбъектаЛокальная", Ссылка, Реквизиты);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьАктОРасхожденияхПослеОтгрузки(ДокументОбъект, ДанныеДокумента)

	ДанныеШапки = ДанныеДокумента.Шапка;
	
	ДокументОснование = Неопределено;
	
	Если ДанныеШапки.Свойство("ДокументОснование") Тогда
		
		ДокументОснование = ДанныеШапки.ДокументОснование;
		
		ДокументОбъект.Заполнить(ДокументОснование);
		
	Иначе
		
		ДокументОбъект.Заполнить(ДанныеШапки);
		
	КонецЕсли;
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеШапки);
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ЗаполнитьТабличнуюЧасть_ДокументОРасхождениях(ДанныеДокумента, ДокументОбъект, ДокументОснование);
	
	Если ДанныеДокумента.Свойство("ШтрихкодыУпаковок")
		И ЕстьШтрихкодыУпаковок(ДокументОбъект.Метаданные()) Тогда
		ДокументОбъект.ШтрихкодыУпаковок.Загрузить(ДанныеДокумента.ШтрихкодыУпаковок);
	КонецЕсли;
	
	// заполнение соглашения
	ЗаполнитьСоглашениеСКлиентом(ДокументОбъект);
	
	// заполнение договора
	ЗаполнитьДоговорСКлиентом(ДокументОбъект);
	
	// Склады в ТЧ
	ЗаполнитьСклады_ДокументОРасхождениях(ДокументОбъект, ДокументОснование);
	
	// Пересчет цен и сумм в зависимости от включения НДС в цену
	ОбработатьСтрокитабличнойЧасти_ДокументОРасхождениях(ДокументОбъект);

	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧасть_ДокументОРасхождениях(ДанныеДокумента, ДокументОбъект, ДокументОснование)
	
	СтруктураПоискаСтроки = Новый Структура("Номенклатура, Характеристика, СтавкаНДС, Упаковка");
	ТаблицаТоваровДокумента = ДокументОбъект.Товары;
	
	Для Каждого Стр Из ДанныеДокумента.Товары Цикл 
		
		ЗаполнитьЗначенияСвойств(СтруктураПоискаСтроки, Стр);
		СтрокиКорректировки = ТаблицаТоваровДокумента.НайтиСтроки(СтруктураПоискаСтроки);
		
		Если СтрокиКорректировки.Количество() > 0 Тогда
			
			ЗаполняемаяСтрока = СтрокиКорректировки[0];
			
			Если Стр.Количество = 0 Тогда
				ТаблицаТоваровДокумента.Удалить(ЗаполняемаяСтрока);	
				Продолжить;
			КонецЕсли;
			
		Иначе
			
			ЗаполняемаяСтрока = ТаблицаТоваровДокумента.Добавить();
			
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, Стр, , "КоличествоПоДокументу, КоличествоУпаковокПоДокументу, СуммаПоДокументу, СуммаНДСПоДокументу, СуммаСНДСПоДокументу");
		
		Если Не ЗначениеЗаполнено(ЗаполняемаяСтрока.Реализация) Тогда
			ЗаполняемаяСтрока.Реализация = ДокументОснование;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьСтрокитабличнойЧасти_ДокументОРасхождениях(ДокументОбъект)
	
	НастройкаПересчетаСуммы = ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
	
	ВыполняемыеДействия = Новый Структура;
	ВыполняемыеДействия.Вставить("ПересчитатьСуммуСНДС", НастройкаПересчетаСуммы);
	ВыполняемыеДействия.Вставить("ПересчитатьСумму");
	ВыполняемыеДействия.Вставить("ПересчитатьСуммуНДС", НастройкаПересчетаСуммы);
	
	МодульОбработкаТабличнойЧастиСервер = ОбщийМодульОбработкаТабличнойЧастиСервер();
	
	Для Каждого Строка Из ДокументОбъект.Товары Цикл 
		МодульОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Строка, ВыполняемыеДействия, Неопределено);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСклады_ДокументОРасхождениях(ДокументОбъект, ДокументОснование)

	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	СкладДокументаОснования = РазрешенноеЗначениеРеквизитаОбъекта(ДокументОснование, "Склад");
	СкладГруппаВШапке = Истина;
	
	СкладГруппа = Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовПродажи(СкладДокументаОснования);
	СкладыСервер.ЗаполнитьСкладыВТабличнойЧасти(ДокументОснование.Склад, СкладГруппа, ДокументОбъект.Товары, СкладГруппаВШапке);

КонецПроцедуры

Функция НайтиОснованиеДокументаОРасхождениях(Организация, ДатаДокумента, НомерДокумента)

	Результат = Неопределено;
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеПервичныхДокументов.Документ КАК СФ,
	|	ДанныеПервичныхДокументов.Документ.ДокументОснование КАК Документ
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
	|ГДЕ
	|	ДанныеПервичныхДокументов.Организация = &Организация
	|	И ДанныеПервичныхДокументов.Номер В(&НомерДокумента)
	|	И НАЧАЛОПЕРИОДА(ДанныеПервичныхДокументов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ТИПЗНАЧЕНИЯ(ДанныеПервичныхДокументов.Документ) = ТИП(Документ.СчетФактураВыданный)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеПервичныхДокументов.Документ,
	|	ТЧСФ.ДокументОснование
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураПолученный.ДокументыОснования КАК ТЧСФ
	|		ПО (ТЧСФ.Ссылка = ДанныеПервичныхДокументов.Документ)
	|ГДЕ
	|	ДанныеПервичныхДокументов.Организация = &Организация
	|	И ДанныеПервичныхДокументов.Номер В(&НомерДокумента)
	|	И НАЧАЛОПЕРИОДА(ДанныеПервичныхДокументов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ТИПЗНАЧЕНИЯ(ДанныеПервичныхДокументов.Документ) = ТИП(Документ.СчетФактураПолученный)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	НЕОПРЕДЕЛЕНО,
	|	ДанныеПервичныхДокументов.Документ
	|ИЗ
	|	РегистрСведений.ДанныеПервичныхДокументов КАК ДанныеПервичныхДокументов
	|ГДЕ
	|	ДанныеПервичныхДокументов.Организация = &Организация
	|	И ДанныеПервичныхДокументов.Номер В(&НомерДокумента)
	|	И НАЧАЛОПЕРИОДА(ДанныеПервичныхДокументов.Дата, ДЕНЬ) = &ДатаДокумента
	|	И ТИПЗНАЧЕНИЯ(ДанныеПервичныхДокументов.Документ) В (ТИП(Документ.РеализацияТоваровУслуг), ТИП(Документ.ВозвратТоваровПоставщику))";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	Запрос.УстановитьПараметр("НомерДокумента", НомерДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Документ;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат = РазрешенноеЗначениеРеквизитаОбъекта(Результат, "ДокументОснование");
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция СтруктураЗаполненияСверкиВзаиморасчетов2_5_11(ДанныеЭД, ДополнительныеПараметры)
	
	ШапкаЭД = ДанныеЭД.Шапка;
	ТабличнаяЧастьЭД = ДанныеЭД.ТоварнаяЧасть;
	ИтогиЭД = ДанныеЭД.Итоги;
	
	ДанныеОбъекта = НовыйДанныеДляЗаполненияАктаСверкиВзаиморасчетов2_5_11();
	
	// Заполнение шапки документа
	ДанныеОбъекта.ДанныеШапки = ДанныеШапкиАктаСверкиВзаиморасчетовПоДаннымОтправителя(ШапкаЭД);
	
	// Заполнение сведений табличных частей
	ЗаполнитьТаблицыДанныхДляЗаполненияАктаСверкиВзаиморасчетов(
		ДанныеОбъекта,
		ТабличнаяЧастьЭД
	);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция НовыйДанныеДляЗаполненияАктаСверкиВзаиморасчетов2_5_11()
	
	МенеджерСверкаВзаиморасчетов2_5_11 = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.СверкаВзаиморасчетов2_5_11");
	
	ИтоговыеЗаписи = МенеджерСверкаВзаиморасчетов2_5_11.ПустаяСсылка().ИтоговыеЗаписи.ВыгрузитьКолонки();
	ДетальныеЗаписи = МенеджерСверкаВзаиморасчетов2_5_11.ПустаяСсылка().ДетальныеЗаписи.ВыгрузитьКолонки();
	
	ДобавитьКолонкуИдентификатораВТаблицуАктаСверкиВзаиморасчетов(ИтоговыеЗаписи);
	ДобавитьКолонкуИдентификатораВТаблицуАктаСверкиВзаиморасчетов(ДетальныеЗаписи);
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", Новый Структура);
	Результат.Вставить("ИтоговыеЗаписи", ИтоговыеЗаписи);
	Результат.Вставить("ДетальныеЗаписи", ДетальныеЗаписи);
	
	Возврат Результат;
	
КонецФункции

// Добавляет в таблицу колонку, которая хранит данные об идентификаторе ключевого свойства строки.
//
// Параметры:
//	ТаблицаАкта - ТаблицаЗначений - таблица документа.
//
Процедура ДобавитьКолонкуИдентификатораВТаблицуАктаСверкиВзаиморасчетов(ТаблицаАкта)
	
	ОписаниеТипаИдентификатора = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100));
	
	ТаблицаАкта.Колонки.Добавить("ИдентификаторОбъекта", ОписаниеТипаИдентификатора);
	
КонецПроцедуры

Функция ДанныеШапкиАктаСверкиВзаиморасчетовПоДаннымОтправителя(ШапкаЭД)
	
	Результат = Новый Структура;
	
	// Стороны сверки
	Результат.Вставить("Организация", СсылкаНаУчастникаСделки(ШапкаЭД.Получатель));
	Результат.Вставить("Контрагент", СсылкаНаУчастникаСделки(ШапкаЭД.Отправитель));
	Результат.Вставить("Партнер", ПартнерПоКонтрагенту(Результат.Контрагент));
	
	// Валюта
	Результат.Вставить("Валюта", ШапкаЭД.Валюта.Ссылка);
	
	// Даты, номера, суммы
	Результат.Вставить("НомерКонтрагента", ШапкаЭД.Номер);
	Результат.Вставить("НачалоПериода", ШапкаЭД.ДатаНачала);
	Результат.Вставить("КонецПериода", ШапкаЭД.ДатаОкончания);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТаблицыДанныхДляЗаполненияАктаСверкиВзаиморасчетов(ДанныеОбъекта, ТабличнаяЧастьЭД)
	
	ИтоговыеЗаписи = ДанныеОбъекта.ИтоговыеЗаписи;
	ДетальныеЗаписи = ДанныеОбъекта.ДетальныеЗаписи;
	
	Для Каждого СтрокаДоговора Из ТабличнаяЧастьЭД.Договор Цикл
		
		СтрокаИтогов = ИтоговыеЗаписи.Добавить();
		
		ЗаполнитьСтрокуТаблицыИтоговыеЗаписиАктаСверкиВзаиморасчетов(СтрокаИтогов, СтрокаДоговора);
		
		Для Каждого СтрокаДокумента Из СтрокаДоговора.Документ Цикл
			
			Для Каждого СтрокаОперации Из СтрокаДокумента.Операция Цикл
				
				Если СтрокаОперации.СуммаДебет = 0
					И СтрокаОперации.СуммаКредит = 0 Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				СтрокаЗаписи = ДетальныеЗаписи.Добавить();
				
				ЗаполнитьСтрокуТаблицыДетальныеЗаписиАктаСверкиВзаиморасчетов(
					СтрокаЗаписи,
					СтрокаДокумента,
					СтрокаОперации
				);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет строку таблицы Итогов документа СверкаВзаиморасчетов2_5_11
//
// Параметры:
//  СтрокаРасчета - СтрокаТаблицыЗначений из ТЧ ИтоговыеЗаписи
//  ДанныеДоговора - Структура - коллекция, содержащая сведения о договоре взаиморасчетов по данным контрагента
//
Процедура ЗаполнитьСтрокуТаблицыИтоговыеЗаписиАктаСверкиВзаиморасчетов(СтрокаРасчета, ДанныеДоговора)
	
	ЗаполнитьЗначенияСвойств(СтрокаРасчета, ДанныеДоговора);
	
	НомерДоговора = СокрЛП(ДанныеДоговора.Номер);
	
	СтрокаРасчета.ИдентификаторОбъекта = ДанныеДоговора.ИдДоговора;
	СтрокаРасчета.НомерДоговора = НомерДоговора;
	СтрокаРасчета.НомерДоговораКонтрагент = НомерДоговора;
	СтрокаРасчета.ДатаДоговора = ДанныеДоговора.Дата;
	СтрокаРасчета.ДатаДоговораКонтрагент = ДанныеДоговора.Дата;
	СтрокаРасчета.НаименованиеДоговора = ДанныеДоговора.Описание;
	СтрокаРасчета.НаименованиеДоговораКонтрагент = ДанныеДоговора.Описание;
	СтрокаРасчета.НачальноеСальдоДтКонтрагент = ДанныеДоговора.СальдоНачКредит;
	СтрокаРасчета.НачальноеСальдоКтКонтрагент = ДанныеДоговора.СальдоНачДебет;
	СтрокаРасчета.ОборотДтКонтрагент = ДанныеДоговора.ОборотКредит;
	СтрокаРасчета.ОборотКтКонтрагент = ДанныеДоговора.ОборотДебет;
	СтрокаРасчета.КонечноеСальдоДтКонтрагент = ДанныеДоговора.СальдоКонКредит;
	СтрокаРасчета.КонечноеСальдоКтКонтрагент = ДанныеДоговора.СальдоКонДебет;
	
КонецПроцедуры

// Заполняет строку таблицы Итогов документа СверкаВзаиморасчетов2_5_11
//
// Параметры:
//  СтрокаЗаписи - СтрокаТаблицыЗначений из см. ДетальныеЗаписи
//  ДанныеДокумента - Структура - коллекция, содержащая сведения о документе взаиморасчетов по данным контрагента
//  ДанныеОперации - Структура - коллекция, содержащая сведения об операции взаиморасчетов по данным контрагента
//
Процедура ЗаполнитьСтрокуТаблицыДетальныеЗаписиАктаСверкиВзаиморасчетов(СтрокаЗаписи, ДанныеДокумента, ДанныеОперации)
	
	ЗаполнитьЗначенияСвойств(СтрокаЗаписи, ДанныеДокумента);
	
	НомерДокумента = СокрЛП(ДанныеДокумента.Номер);
	
	СтрокаЗаписи.ИдентификаторОбъекта = ДанныеДокумента.ИдДокумента;
	СтрокаЗаписи.НомерДокумента = НомерДокумента;
	СтрокаЗаписи.НомерДокументаКонтрагент = НомерДокумента;
	СтрокаЗаписи.ДатаДокумента = ДанныеДокумента.Дата;
	СтрокаЗаписи.ДатаДокументаКонтрагент = ДанныеДокумента.Дата;
	СтрокаЗаписи.НаименованиеДокументаКонтрагент = ДанныеДокумента.Наименование;
	СтрокаЗаписи.СуммаДебет = ДанныеОперации.СуммаКредит;
	СтрокаЗаписи.СуммаДебетКонтрагент = ДанныеОперации.СуммаКредит;
	СтрокаЗаписи.СуммаКредит = ДанныеОперации.СуммаДебет;
	СтрокаЗаписи.СуммаКредитКонтрагент = ДанныеОперации.СуммаДебет;
	
КонецПроцедуры

Процедура ЗаполнитьСверкуВзаиморасчетов2_5_11(ДокументОбъект, ДанныеДляЗагрузки)
	
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	
	ДокументОбъект.УстановитьНовыйНомер();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеДляЗагрузки.ДанныеШапки);
	ДокументОбъект.ИнициализироватьДокумент();
	
	МодульЗначениеНастроек = ОбщегоНазначения.ОбщийМодуль("ЗначениеНастроекПовтИсп");
	ВалютаРегламентированногоУчета = МодульЗначениеНастроек.ВалютаРегламентированногоУчетаОрганизации(ДокументОбъект.Организация);
	
	ДокументОбъект.СверкаВВалюте = ЗначениеЗаполнено(ВалютаРегламентированногоУчета)
								И ДокументОбъект.Валюта <> ВалютаРегламентированногоУчета;
	ДокументОбъект.РежимСверкиИтоговВзаиморасчетов = Перечисления.РежимСверкиИтоговВзаиморасчетов.ПоДоговорам;
	
	// Инициализация табличных частей документа по данным шапки.
	МенеджерСверкаВзаиморасчетов2_5_11 = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Документ.СверкаВзаиморасчетов2_5_11");
	МенеджерСверкаВзаиморасчетов2_5_11.ЗаполнитьДанныеПоРасчетам(ДокументОбъект);
	
	// Заполнение табличных частей по данным отправителя.
	ИтоговыеЗаписи = ДокументОбъект.ИтоговыеЗаписи.Выгрузить();
	ДобавитьКолонкиСортировкиТаблицыИтоговАктаСверкиВзаиморасчетов(ИтоговыеЗаписи);
	
	ДанныеШапкиПоУмолчанию = Новый Структура("Партнер");
	ЗаполнитьЗначенияСвойств(ДанныеШапкиПоУмолчанию, ДокументОбъект);
	
	ЕстьРасхождения = ИтоговыеЗаписи.Количество() > ДанныеДляЗагрузки.ИтоговыеЗаписи.Количество();
	
	ИсключаемыеСвойства =
		"НомерДоговора,
		|ДатаДоговора,
		|НаименованиеДоговора,
		|Договор,
		|Партнер,
		|ТипРасчетов,
		|ОбъектРасчетов,
		|Валюта,
		|НачальноеСальдоДт,
		|НачальноеСальдоКт,
		|ОборотДт,
		|ОборотКт,
		|КонечноеСальдоДт,
		|КонечноеСальдоКт";
	
	СопоставлятьСтрокиПустыхИтогов = СопоставлятьСтрокиПустыхИтоговАктаСверкиВзаиморасчетов(
		ИтоговыеЗаписи,
		ДанныеДляЗагрузки.ИтоговыеЗаписи
	);
	
	Для Каждого СтрокаИтогов Из ДанныеДляЗагрузки.ИтоговыеЗаписи Цикл
		
		ОтборСтрокПоИтогу = ДанныеПоискаСведенийДоговораАктаСверкиВзаиморасчетов(СтрокаИтогов);
		ДанныеОтбораЗаполнены = ДанныеПоискаСведенийТаблицыАктаСверкиВзаиморасчетовЗаполнены(ОтборСтрокПоИтогу);
		СтрокиТаблицыПоОтбору = ИтоговыеЗаписи.НайтиСтроки(ОтборСтрокПоИтогу);
		
		Если ДанныеОтбораЗаполнены
			Или СопоставлятьСтрокиПустыхИтогов Тогда
			
			Если СтрокиТаблицыПоОтбору.Количество() = 1 Тогда
				
				СтрокаТаблицы = СтрокиТаблицыПоОтбору[0];
				
			Иначе
				
				СтрокаТаблицы = ИтоговыеЗаписи.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеШапкиПоУмолчанию);
				ЕстьРасхождения = Истина;
				
			КонецЕсли;
			
		Иначе
			
			СтрокаТаблицы = ИтоговыеЗаписи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеШапкиПоУмолчанию);
			ЕстьРасхождения = Истина;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаИтогов, Неопределено, ИсключаемыеСвойства);
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ИтоговыеЗаписи Цикл
		ЗаполнитьКолонкиСортировкиСтрокиТаблицыИтоговАктаСверкиВзаиморасчетов(СтрокаТаблицы);
	КонецЦикла;
	
	ИтоговыеЗаписи.Сортировать(
		"СтрокаСопоставлена Убыв,
		|ОбщаяДата,
		|ОбщийОборотДт,
		|ОбщийОборотКт,
		|ОборотДт,
		|ОборотДтКонтрагент,
		|ОборотКт,
		|ОборотКтКонтрагент"
	);
	
	ДетальныеЗаписи = ДокументОбъект.ДетальныеЗаписи.Выгрузить();
	ДобавитьКолонкиСортировкиТаблицыЗаписейАктаСверкиВзаиморасчетов(ДетальныеЗаписи);
	
	Если Не ЕстьРасхождения Тогда
		ЕстьРасхождения = ДетальныеЗаписи.Количество() > ДанныеДляЗагрузки.ДетальныеЗаписи.Количество();
	КонецЕсли;
	
	ЗаполняемыеСвойства =
		"НомерДокументаКонтрагент,
		|ДатаДокументаКонтрагент,
		|НаименованиеДокументаКонтрагент,
		|СуммаДебетКонтрагент,
		|СуммаКредитКонтрагент";
	
	Для Каждого СтрокаДетальнойЗаписи Из ДанныеДляЗагрузки.ДетальныеЗаписи Цикл
		
		ОтборСтрокПоЗаписи = ДанныеПоискаСведенийДокументаАктаСверкиВзаиморасчетов(СтрокаДетальнойЗаписи);
		СтрокиТаблицыПоОтбору = ДетальныеЗаписи.НайтиСтроки(ОтборСтрокПоЗаписи);
		
		Если СтрокиТаблицыПоОтбору.Количество() = 1 Тогда
			СтрокаЗаписи = СтрокиТаблицыПоОтбору[0];
		Иначе
			СтрокаЗаписи = ДетальныеЗаписи.Добавить();
			
			ЕстьРасхождения = Истина;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаЗаписи, СтрокаДетальнойЗаписи, ЗаполняемыеСвойства);
		
	КонецЦикла;
	
	Для Каждого СтрокаЗаписи Из ДетальныеЗаписи Цикл
		ЗаполнитьКолонкиСортировкиСтрокиТаблицыЗаписейАктаСверкиВзаиморасчетов(СтрокаЗаписи);
	КонецЦикла;
	
	ДетальныеЗаписи.Сортировать(
		"СтрокаСопоставлена Убыв,
		|ОбщаяДата,
		|ОбщаяСуммаДт,
		|ОбщаяСуммаКт,
		|СуммаДебет,
		|СуммаКредит"
	);
	
	ДокументОбъект.ИтоговыеЗаписи.Загрузить(ИтоговыеЗаписи);
	ДокументОбъект.ДетальныеЗаписи.Загрузить(ДетальныеЗаписи);
	
	ДокументОбъект.Статус = Перечисления.СтатусыСверокВзаиморасчетов2_5_11.НаСверке;
	ДокументОбъект.ЕстьРасхождения = ЕстьРасхождения;
	
КонецПроцедуры

Процедура ЗаполнитьЗаказПоставщику(ДокументОбъект, ДанныеЗаполнения)
	
	Шапка = ДанныеЗаполнения.Шапка;
	
	ДокументОбъект.Автор = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Заполнить(Шапка);
	
	ИспользоватьСтатусы = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыЗаказовПоставщикам");
	Если ИспользоватьСтатусы Тогда
		ДокументОбъект.Статус = Перечисления.СтатусыЗаказовПоставщикам.НеСогласован;
	КонецЕсли;
	
	// пересчет цен и сумм в зависимости от включения НДС в цену
	ПересчитатьЦенуСуммуПриУстановкеФлагаЦенаВключаетНДС(ДокументОбъект, "Товары");
	
	// сумма документа
	ДокументОбъект.СуммаДокумента = ЦенообразованиеКлиентСервер.ПолучитьСуммуДокумента(
		ДокументОбъект.Товары,
		ДокументОбъект.ЦенаВключаетНДС
	);
	
	ЗаполнитьДоговорСПоставщиком(ДокументОбъект);
	
	ДокументОбъект.ПорядокРасчетов = ДокументОбъект.Договор.ПорядокРасчетов;
	ДокументОбъект.ВариантПриемкиТоваров = ДокументОбъект.Договор.ВариантПриемкиТоваров;
	
	ДокументОбъект.ГруппаФинансовогоУчета = ДокументОбъект.Договор.ГруппаФинансовогоУчета;
	
	ДокументОбъект.Товары.Загрузить(ДанныеЗаполнения.Товары);
	
	// Тип налогообложения
	ЗаполнитьНалогообложениеНДСПлатежныхДокументов(ДокументОбъект, ДанныеЗаполнения.НДСИсчисляетсяНалоговымАгентом);
	
КонецПроцедуры

Процедура ЗаполнитьЗаявкуНаРасходованиеДС(ДокументОбъект, ДанныеЗаполнения)
	
	ИспользоватьСтатусы = ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыЗаказовПоставщикам");
	Если ИспользоватьСтатусы Тогда
		ДокументОбъект.Статус = Перечисления.СтатусыЗаказовПоставщикам.НеСогласован;
	КонецЕсли;
	
	ДокументОбъект.Автор = Пользователи.АвторизованныйПользователь();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	ДокументОбъект.Заполнить(ДанныеЗаполнения.Шапка);
	
	ЗаполнитьДоговорСПоставщиком(ДокументОбъект);
	
	ДокументОбъект.ДоговорСУчастникомГОЗ = Ложь;
	ДокументОбъект.ПлатежиПо275ФЗ = Ложь;
	
	ДокументОбъект.РасшифровкаПлатежа.Загрузить(ДанныеЗаполнения.РасшифровкаПлатежа);
	
	Договор = ДокументОбъект.Договор;
	Если ЗначениеЗаполнено(Договор) Тогда
		
		ДокументОбъект.СтатьяДвиженияДенежныхСредств = Договор.СтатьяДвиженияДенежныхСредств;
		ДокументОбъект.ГруппаФинансовогоУчета = Договор.ГруппаФинансовогоУчета;
		ДокументОбъект.НаправлениеДеятельности = Договор.НаправлениеДеятельности;
		
		Если Договор.ДоговорСУчастникомГОЗ Тогда
			ДокументОбъект.ДоговорСУчастникомГОЗ = Истина;
			ДокументОбъект.ПлатежиПо275ФЗ = Истина;
		КонецЕсли;
		
		Для Каждого Расшифровка Из ДокументОбъект.РасшифровкаПлатежа Цикл
			Расшифровка.СтатьяДвиженияДенежныхСредств = Договор.СтатьяДвиженияДенежныхСредств;
			Расшифровка.НаправлениеДеятельности = Договор.НаправлениеДеятельности;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьНалогообложениеНДСПлатежныхДокументов(ДокументОбъект, ДанныеЗаполнения.НДСИсчисляетсяНалоговымАгентом);
	
КонецПроцедуры

