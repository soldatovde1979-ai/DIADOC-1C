// Вызывается из Модуль_ИнтеграцияУниверсальный.РеквизитыЮрФизЛица.
//
// Параметры:
//  Реквизиты			 - Структура - возвращаемые сведения.
//  ЮрФизЛицо			 - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - компания, реквизиты которой нужно получить
//  Период				 - Дата - дата, на которую нужно получить значения периодических реквизитов
//  БанковскийСчет		 - СправочникСсылка.БанковскиеСчета - банковский счет, реквизиты которого нужно включить в реквизиты компании.
//                         Если не передан, будут включены реквизиты основного банковского счета.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события.
//
Процедура ПриПолученииРеквизитовЮрФизЛица(Реквизиты, ЮрФизЛицо, Период, БанковскийСчет, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.РегистрацииВНалоговомОргане") Тогда // Это ОП без выделения на отдельный баланс
		
		ВерсияУТ = ВерсияТорговойПодсистемы();
		
		Если СравнитьВерсии(ВерсияУТ, "11.4") >= 0 Тогда 
			Буфер = Справочники.РегистрацииВНалоговомОргане.СведенияОПодразделении(ЮрФизЛицо, Период);
		Иначе 
			Буфер = Справочники.РегистрацииВНалоговомОргане.СведенияОПодразделении(ЮрФизЛицо);
		КонецЕсли;
		
		Буфер.Вставить("ЮрФизЛицо", Перечисления.ЮрФизЛицо.ЮрЛицо);
		Буфер.Вставить("Телефоны", "");
		
	Иначе // Это Контрагент или Организация
		
		Буфер = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ЮрФизЛицо, Период, Ложь, БанковскийСчет);
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Реквизиты, Буфер);
	
	Если Буфер.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Реквизиты.ТипЮрФизЛица = "ЮридическоеЛицо";
	ИначеЕсли Буфер.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		Реквизиты.ТипЮрФизЛица = "ИностраннаяКомпания";
	Иначе
		Реквизиты.ТипЮрФизЛица = "ФизическоеЛицо";
	КонецЕсли;
	
КонецПроцедуры

