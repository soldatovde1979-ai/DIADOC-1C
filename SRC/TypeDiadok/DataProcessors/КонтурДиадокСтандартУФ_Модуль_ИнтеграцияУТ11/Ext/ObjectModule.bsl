//{ ПОЛУЧЕНИЕ ДАННЫХ

Функция ПолучитьВидКИ(ЮрФизЛицо, Юрадрес) Экспорт
	
	ВидАдреса = Неопределено;
	
	ТипЮрФизЛица = ТипЗнч(ЮрФизЛицо);
	
	Если ТипЮрФизЛица = Тип("СправочникСсылка.Организации") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресОрганизации", "ФактАдресОрганизации");
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.Контрагенты") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "ЮрАдресКонтрагента", "ФактАдресКонтрагента");
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
		
		ВидАдреса = ?(ЮрАдрес, "АдресПоПропискеФизическиеЛица", "АдресМестаПроживанияФизическиеЛица");
		
	ИначеЕсли ТипЮрФизЛица = Тип("СправочникСсылка.РегистрацииВНалоговомОргане") Тогда 
		
		ВидАдреса = "ФактАдресОбособленногоПодразделения";
		
	Иначе 
		ВызватьИсключение НСтр("ru = 'Некорректный параметр функции ""ПолучитьВидКИ""'");
	КонецЕсли;
	
	Результат = Справочники.ВидыКонтактнойИнформации[ВидАдреса];
	
	Возврат Результат;
	
КонецФункции

Функция ТабличнаяЧастьИсправительногоСчетаФактуры(СсылкаНаОбъект)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ИмяОбъекта = СсылкаНаОбъект.Метаданные().Имя;
	МенеджерОбъекта = МодульЛокализацииОбъекта(ИмяОбъекта);
	
	ОбъектыПечати = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект);
	ПараметрыПечати = Новый Структура;
	ДанныеДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, ОбъектыПечати);
	
	Товары = ИнициализацияТаблицыСтрокТовары(Ложь);
	
	РезультатЗапросаПоТЧ		 = ДанныеДляПечати.РезультатПоТабличнойЧасти;
	ЕстьКоличествоПоРНПТ		 = (РезультатЗапросаПоТЧ.Колонки.Найти("КоличествоПоРНПТ") <> Неопределено);
	ЗаполнитьПрослеживаемость	 = ИспользуетсяУчетПрослеживаемыхТоваров() И ЕстьКоличествоПоРНПТ;
	СуммаВключаетНДС = СсылкаНаОбъект.ДокументОснование.ЦенаВключаетНДС;
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") 
		или ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураКомиссионеру") Тогда
		ДокументОтгрузки = СсылкаНаОбъект.ДокументОснование;
	Иначе
		ДокументОтгрузки = СсылкаНаОбъект;
	КонецЕсли;
	
	ВыборкаДокументы = РезультатЗапросаПоТЧ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокументы.Следующий();
	
	Выборка = ВыборкаДокументы.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.КодНоменклатуры					= Выборка.НоменклатураКод;
		НоваяСтрока.ЕдиницаИзмеренияСсылка			= Выборка.ЕдиницаИзмерения;
		НоваяСтрока.КодЕдиницыИзмерения				= Выборка.ЕдиницаИзмеренияКод;
		НоваяСтрока.СуммаВключаетНДС 				= СуммаВключаетНДС;
		НоваяСтрока.ДокументОтгрузки 				= ДокументОтгрузки;
		
		Если СуммаВключаетНДС Тогда
			НоваяСтрока.Сумма = НоваяСтрока.СуммаСНДС;
		Иначе
			НоваяСтрока.Сумма = НоваяСтрока.СуммаСНДС - НоваяСтрока.СуммаНДС;
		КонецЕсли;
		
		ДополнительныеПараметры = ДополнительныеПараметрыПредставленияНоменклатуры();
		ДополнительныеПараметры.Содержание = НоваяСтрока.Содержание;
		
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатуры(Выборка.НоменклатураНаименование, Выборка.ХарактеристикаНаименование, ДополнительныеПараметры);
		
		Если ЗаполнитьПрослеживаемость Тогда
			ЗаполнитьСведенияПрослеживаемостиДляИсправительногоСчетФактура(НоваяСтрока, Выборка);
		КонецЕсли;
		
		НоваяСтрока.ЭтоУслуга = ЭтоУслуга(НоваяСтрока.Номенклатура);
		
	КонецЦикла;
	
	Возврат Товары;	
	
КонецФункции

Функция ТабличнаяЧастьКорректировочногоДокумента(СсылкаНаОбъект)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ИмяОбъекта = СсылкаНаОбъект.Метаданные().Имя;
	МенеджерОбъекта = МодульЛокализацииОбъекта(ИмяОбъекта);
	
	ОбъектыПечати = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект);
	ПараметрыПечати = Новый Структура;
	ДанныеДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыУКД(ПараметрыПечати, ОбъектыПечати);
	
	Товары = ИнициализацияТаблицыСтрокТовары(Истина);
	
	РезультатЗапросаПоТЧ		 = ДанныеДляПечати.РезультатПоТабличнойЧасти;
	ЕстьНомерСтрокиИсходногоСФ	 = (РезультатЗапросаПоТЧ.Колонки.Найти("НомерСтрокиИсходногоСФ") <> Неопределено);
	ЕстьКоличествоПоРНПТ		 = (РезультатЗапросаПоТЧ.Колонки.Найти("КоличествоПоРНПТ") <> Неопределено);
	ЗаполнитьПрослеживаемость	 = ИспользуетсяУчетПрослеживаемыхТоваров() И ЕстьКоличествоПоРНПТ;
	
	ВыборкаДокументы = РезультатЗапросаПоТЧ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокументы.Следующий();
	
	Выборка = ВыборкаДокументы.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаБезРасхождений = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка, "РазницаБезНДСУвеличение")
			И Выборка.РазницаБезНДСУвеличение = Выборка.РазницаБезНДСУменьшение
			И Выборка.РазницаНДСУвеличение = Выборка.РазницаНДСУменьшение
			И Выборка.РазницаСНДСУвеличение = Выборка.РазницаСНДСУменьшение
		;
		
		Если СтрокаБезРасхождений Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Товары.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если Не ЕстьНомерСтрокиИсходногоСФ Тогда
			НоваяСтрока.НомерСтрокиИсходногоСФ = Товары.Количество();
		КонецЕсли;
		
		НоваяСтрока.КодНоменклатуры					= Выборка.НоменклатураКод;
		НоваяСтрока.ЕдиницаИзмеренияСсылка			= Выборка.ЕдиницаИзмерения;
		НоваяСтрока.КодЕдиницыИзмерения				= Выборка.ЕдиницаИзмеренияКод;
		НоваяСтрока.ЕдиницаИзмеренияДоИзменения		= Выборка.ЕдиницаИзмерения;
		НоваяСтрока.КодЕдиницыИзмеренияДоИзменения	= Выборка.ЕдиницаИзмеренияКод;
		НоваяСтрока.СтавкаНДСДоИзменения			= Выборка.СтавкаНДС;
		НоваяСтрока.КоличествоДоИзменения			= Выборка.КоличествоДо;
		НоваяСтрока.ЦенаДоИзменения					= Выборка.ЦенаДо;
		НоваяСтрока.СуммаНДСДоИзменения				= Выборка.СуммаНДСДо;
		НоваяСтрока.СуммаСНДСДоИзменения			= Выборка.СуммаСНДСДо;
		
		ДополнительныеПараметры = ДополнительныеПараметрыПредставленияНоменклатуры();
		ДополнительныеПараметры.Содержание = НоваяСтрока.Содержание;
		
		НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатуры(Выборка.НоменклатураНаименование, Выборка.ХарактеристикаНаименование, ДополнительныеПараметры);
		
		НоваяСтрока.НомерГТД = НомерГТДСтрокой(Выборка.НомерГТД);
		
		Если ЗаполнитьПрослеживаемость Тогда
			ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(НоваяСтрока, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Товары;
	
КонецФункции

Функция НомерГТДСтрокой(НомерГТД)

	Результат = НомерГТД;
	
	Если ЗначениеЗаполнено(НомерГТД)
		И ТипЗнч(НомерГТД) = Тип("СправочникСсылка.НомераГТД") Тогда
		
		Результат = СокрЛП(НомерГТД.Код);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеТЧ(Документы, ВалютаРегламентированногоУчета = Неопределено, КолонкаКодаТовара = Неопределено, ФормированиеСФ = Неопределено, СчетФактура = неопределено, ФункцияУПД = "") Экспорт
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Если Не ЗначениеЗаполнено(КолонкаКодаТовара) Тогда 
		КолонкаКодаТовара = ИмяДополнительнойКолонки();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВалютаРегламентированногоУчета) Тогда 
		ВалютаРегламентированногоУчета = ВалютаРегламентированногоУчета();
	КонецЕсли;
	
	ЭтоКСФ = Ложь;
	//Документы - список документов либо одичночнй документ
	Если СчетФактуранаАванс(СчетФактура)
		Или ЭтоСчетФактураКомиссионеру(СчетФактура)
		Или ЭтоСчетФактураНаРеализациюЧерезКомиссионера(СчетФактура) 
		Тогда
		ДокументыИтератор = Новый СписокЗначений;
		ДокументыИтератор.Добавить(СчетФактура);
	ИначеЕсли ТипЗнч(Документы) = Тип("СписокЗначений") Тогда 
		ДокументыИтератор = Документы;
	Иначе 
		ДокументыИтератор = Новый СписокЗначений;
		ДокументыИтератор.Добавить(Документы);
	КонецЕсли;
	
	Товары = ИнициализацияТаблицыСтрокТовары(ЭтоКСФ);
	ДокументОтгрузки = Новый Структура("Ссылка");
	ЗапросТЧ = Новый Запрос;
	
	Для каждого Документ из ДокументыИтератор Цикл
		
		СсылкаНаДокумент = Документ.Значение;
		Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда // Счет не имеет своей табличной части
			СсылкаНаДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаДокумент, "ДокументОснование");
		КонецЕсли;
		
		ДокументОтгрузки.Ссылка = СсылкаНаДокумент;
		
		ТипСсылки = ТипЗнч(СсылкаНаДокумент);
		
		Если ТипСсылки = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СформироватьЗапрос_ДанныеТЧ_ПоРеализацияТоваровУслуг(ЗапросТЧ, КолонкаКодаТовара, СсылкаНаДокумент);
							
		ИначеЕсли ТипСсылки = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
			
			СформироватьЗапрос_ДанныеТЧ_ПоАктВыполненныхРабот(ЗапросТЧ, КолонкаКодаТовара, СсылкаНаДокумент, ВалютаРегламентированногоУчета);
			
		ИначеЕсли НЕ ЭтоКСФ
			И Метаданные.Документы.Найти("КорректировкаРеализации") <> Неопределено 
			И ТипСсылки = Тип("ДокументСсылка.КорректировкаРеализации") Тогда 
			
			СформироватьЗапрос_ДанныеТЧ_ПоКорректировкаРеализации(ЗапросТЧ, КолонкаКодаТовара);
			
		ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ОтчетКомитенту") Тогда 
			
			СформироватьЗапрос_ДанныеТЧ_ПоОтчетКомитенту(ЗапросТЧ, КолонкаКодаТовара);
							
		ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда 
			
			СформироватьЗапрос_ДанныеТЧ_ПоВозвратТоваровПоставщику(ЗапросТЧ, КолонкаКодаТовара, СсылкаНаДокумент);
							
		ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			
			СформироватьЗапрос_ДанныеТЧ_ПоЗаказКлиента(ЗапросТЧ, КолонкаКодаТовара);
			
		ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда 
			
			СформироватьЗапрос_ДанныеТЧ_ПоСчетФактураВыданныйАванс(ЗапросТЧ, КолонкаКодаТовара);
			
		ИначеЕсли ИспользуетсяОтчетДавальцу()
			И ТипСсылки = Тип("ДокументСсылка.ОтчетДавальцу") Тогда
			
			СформироватьЗапрос_ДанныеТЧ_ОтчетДавальцу(ЗапросТЧ, СсылкаНаДокумент);
			
		ИначеЕсли ТипСсылки = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
			
			СформироватьЗапрос_ДанныеТЧ_РеализацияУслугПрочихАктивов(ЗапросТЧ, СсылкаНаДокумент);
			
		ИначеЕсли ЭтоСчетФактураКомиссионеру(СсылкаНаДокумент) 
			ИЛИ ЭтоСчетФактураНаРеализациюЧерезКомиссионера(СсылкаНаДокумент) Тогда
			
			СформироватьЗапрос_ДанныеТЧ_СчетФактураКомиссионеру(ЗапросТЧ, СсылкаНаДокумент);
			
		ИначеЕсли ИспользуетсяПередачаТоваровХранителю()
			И ТипСсылки = Тип("ДокументСсылка.ПередачаТоваровХранителю") Тогда
			
			СформироватьЗапрос_ДанныеТЧ_ПоПередачаТоваровХранителю(ЗапросТЧ, КолонкаКодаТовара, СсылкаНаДокумент);	
			
		Иначе
			
			ЗапросТЧ.Текст = "";
			
		КонецЕсли;
		
		Если ПустаяСтрока(ЗапросТЧ.Текст) Тогда
			Возврат Товары;
		КонецЕсли;
		
		Если МетодСервера(, "СуществуетОбъектМетаданных", "Справочник.УпаковкиЕдиницыИзмерения") Тогда
			ЗапросТЧ.Текст = СтрЗаменить(ЗапросТЧ.Текст, "Справочник.УпаковкиНоменклатуры", "Справочник.УпаковкиЕдиницыИзмерения");
		КонецЕсли;
		
		ЗапросТЧ.Текст = СтрЗаменить(ЗапросТЧ.Текст, "Номенклатура.Код КАК КодНоменклатуры", "Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры");
		
		ПроверитьИсправитьИмяТаблицыСуммыРегл(ЗапросТЧ.Текст);
		
		ВыводитьБазовыеЕИ = ИспользоватьБазовыеЕдиницыИзмерения();
		
		ЗапросТЧ.УстановитьПараметр("ЗаполненаЕдиницаИзмеренияВеса", ЗначениеЗаполнено(Константы.ЕдиницаИзмеренияВеса.Получить()));
		ЗапросТЧ.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
		ЗапросТЧ.УстановитьПараметр("ИспользоватьБазовыеЕИ", ВыводитьБазовыеЕИ);
		
		РезультатЗапроса = ЗапросТЧ.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			РезультатЗапроса = Неопределено;
			
			Пока Выборка.Следующий() Цикл
				
				НоваяСтрока = Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, , "НомерГТД, СтранаПроисхождения");
				
				НоваяСтрока.КодЕдиницыИзмерения    = СокрЛП(Выборка.КодЕдиницыИзмерения);
				НоваяСтрока.ЕдиницаИзмеренияСсылка = Выборка.ЕдиницаИзмерения;
				
				Если ЗначениеЗаполнено(Выборка.СтранаПроисхождения) Тогда
					
					НоваяСтрока.НомерГТД = Выборка.НомерГТДПредставление;
					
					Если (ЗначениеЗаполнено(Выборка.НомерГТД) И ЗначениеЗаполнено(Выборка.НомерГТД.Код))
						ИЛИ НЕ МетодСервера(,"СтранаЧленТС", Выборка.СтранаПроисхождения.Код) Тогда
						НоваяСтрока.СтранаПроисхождения = Выборка.СтранаПроисхождения;
					КонецЕсли;
					
				КонецЕсли;
				
				ДополнительныеПараметры = ДополнительныеПараметрыПредставленияНоменклатуры();
				ДополнительныеПараметры.Содержание = НоваяСтрока.Содержание;
				
				НоваяСтрока.НоменклатураПредставление = ПредставлениеНоменклатуры(Выборка.НоменклатураПредставление, Выборка.Характеристика, ДополнительныеПараметры);
				
				НоваяСтрока.ДанныеПрослеживаемости = Новый Массив;
				Если НоваяСтрока.ПрослеживаемыйТовар = Истина Тогда
				
					ЭлементПрослеживаемости = НовыеСвойстваЭлементаПрослеживаемости();
					ЗаполнитьЗначенияСвойств(ЭлементПрослеживаемости, Выборка);
					НоваяСтрока.ДанныеПрослеживаемости.Добавить(ЭлементПрослеживаемости);
					
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ДокументОтгрузки, Выборка);
				
				НоваяСтрока.ДокументОтгрузки = ДокументОтгрузки.Ссылка;
				
			КонецЦикла; 
			
		КонецЕсли; 
	КонецЦикла;
	
	Если ДокументыИтератор.Количество() > 1 Тогда
		
		КолонкиСуммирования = "Количество, КоличествоМест, СуммаНДС, Сумма, Масса, МассаНетто";
		КолонкиСуммированияСтруктурой = Новый Структура(КолонкиСуммирования);
		
		КолонкиГруппировок 	= "";
		Разделитель 		= "";
		Для каждого Колонка Из Товары.Колонки Цикл
			Если НЕ КолонкиСуммированияСтруктурой.Свойство(Колонка.Имя) Тогда
				КолонкиГруппировок = КолонкиГруппировок + Разделитель + Колонка.Имя;
				Разделитель = ", ";
			КонецЕсли; 
		КонецЦикла;
		
		Товары.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
		
	КонецЕсли;

	Возврат Товары;
	
КонецФункции
	
Процедура СформироватьЗапрос_ДанныеТЧ_ПоРеализацияТоваровУслуг(Запрос, КолонкаКодаТовара, СсылкаНаДокумент)
	
	КонстантаВыводитьСерииВПечатныхФормах = Ложь;
	Если МетодСервера(, "ЕстьМетаданныеКонфигурации_ДД", "Константы.ВыводитьСерииВПечатныхФормах") Тогда
		КонстантаВыводитьСерииВПечатныхФормах = Константы.ВыводитьСерииВПечатныхФормах.Получить();
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Подзапрос.Номенклатура 								КАК Номенклатура,
		|	Подзапрос.НоменклатураПредставление 				КАК НоменклатураПредставление,
		|	Подзапрос.Характеристика 							КАК Характеристика,			
		|	Подзапрос.КодНоменклатуры 							КАК КодНоменклатуры,
		|	Подзапрос.Цена 										КАК Цена,
		|	Подзапрос.СтавкаНДС 								КАК СтавкаНДС,
		|	Подзапрос.НомерГТД 									КАК НомерГТД,
		|	Подзапрос.СтранаПроисхождения 						КАК СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление 					КАК НомерГТДПредставление,
		|	Подзапрос.НомерГТДРегистрационныйНомер 				КАК НомерГТДРегистрационныйНомер,
		|	Подзапрос.СуммаВключаетНДС 							КАК СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения 							КАК ЕдиницаИзмерения,
		|	Подзапрос.Упаковка		 							КАК Упаковка,
		|	Подзапрос.КодЕдиницыИзмерения 						КАК КодЕдиницыИзмерения,
		|	Подзапрос.ЕдиницаИзмеренияПрослеживаемости.Наименование 	КАК ЕдиницаИзмеренияПрослеживаемости,
		|	Подзапрос.ЕдиницаИзмеренияПрослеживаемости.Код 		КАК КодЕдиницыИзмеренияПрослеживаемости,
		|	Подзапрос.ВидУпаковки 								КАК ВидУпаковки,
		|	Подзапрос.КоличествоВОдномМесте 					КАК КоличествоВОдномМесте,
		|	Подзапрос.ЭтоУслуга 								КАК ЭтоУслуга,
		|	Подзапрос.Порядок 									КАК Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга 					КАК ПризнакТоварРаботаУслуга,
		|	Подзапрос.ПрослеживаемыйТовар 						КАК ПрослеживаемыйТовар,
		|";
	
	Если КонстантаВыводитьСерииВПечатныхФормах = Истина Тогда 
		
		Запрос.Текст = Запрос.Текст + "
		|	Подзапрос.НомерСтроки 								КАК НомерСтроки,
		|	Подзапрос.Серия 									КАК Серия,
		|	Подзапрос.Количество 								КАК Количество,
		|	Подзапрос.КоличествоПоРНПТ 							КАК КоличествоПоРНПТ,
		|	Подзапрос.Сумма 									КАК Сумма,
		|	Подзапрос.СуммаНДС 									КАК СуммаНДС,
		|	Подзапрос.КоличествоМест 							КАК КоличествоМест,
		|	Подзапрос.МассаНетто 								КАК МассаНетто,
		|	Подзапрос.Брутто 									КАК Масса,
		|	Подзапрос.СуммаСкидок 								КАК СуммаСкидок
		|";
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + "
		|	МИНИМУМ(Подзапрос.НомерСтроки) 						КАК НомерСтроки,
		|	NULL 												КАК Серия,
		|	СУММА(Подзапрос.Количество) 						КАК Количество,
		|	СУММА(Подзапрос.КоличествоПоРНПТ) 					КАК КоличествоПоРНПТ,
		|	СУММА(Подзапрос.Сумма) 								КАК Сумма,
		|	СУММА(Подзапрос.СуммаНДС) 							КАК СуммаНДС,
		|	СУММА(Подзапрос.КоличествоМест) 					КАК КоличествоМест,
		|	СУММА(Подзапрос.МассаНетто) 						КАК МассаНетто,
		|	СУММА(Подзапрос.Брутто) 							КАК Масса,
		|	СУММА(Подзапрос.СуммаСкидок) 						КАК СуммаСкидок
		|";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
		|ИЗ
		|	(ВЫБРАТЬ
		|		РеализацияТоваровУслугТовары.НомерСтроки 	КАК НомерСтроки,
		|		РеализацияТоваровУслугТовары.Номенклатура 	КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ПОДСТРОКА(РеализацияТоваровУслугТовары.Номенклатура.НаименованиеПолное, 1, 10) = """"
		|				ТОГДА РеализацияТоваровУслугТовары.Номенклатура.Наименование
		|			ИНАЧЕ РеализацияТоваровУслугТовары.Номенклатура.НаименованиеПолное
		|		КОНЕЦ КАК НоменклатураПредставление,
		|		РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
		|		РеализацияТоваровУслугТовары.Серия КАК Серия,
		|   	РеализацияТоваровУслугТовары.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|		ВЫБОР КОГДА &ВесВБазовыхЕИ 
		|            ТОГДА РеализацияТоваровУслугТовары.Количество
		|            ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
		|       КОНЕЦ КАК Количество,
		|		0 КАК КоличествоПоРНПТ,
		|		РеализацияТоваровУслугТовары.Цена КАК Цена,
		|		ВЫБОР
		|			КОГДА СуммыВВалютеУчета.СуммаБезНДСРегл ЕСТЬ NULL 
		|				ТОГДА РеализацияТоваровУслугТовары.Сумма
		|			КОГДА РеализацияТоваровУслугТовары.Ссылка.ЦенаВключаетНДС
		|				ТОГДА СуммыВВалютеУчета.СуммаБезНДСРегл + СуммыВВалютеУчета.СуммаНДСРегл
		|			ИНАЧЕ СуммыВВалютеУчета.СуммаБезНДСРегл
		|		КОНЕЦ КАК Сумма,
		|		РеализацияТоваровУслугТовары.СтавкаНДС КАК СтавкаНДС,
		|		ЕСТЬNULL(СуммыВВалютеУчета.СуммаНДСРегл, РеализацияТоваровУслугТовары.СуммаНДС) КАК СуммаНДС,
		|		"""" КАК НомерГТД,
		|		"""" КАК СтранаПроисхождения,
		|		"""" КАК НомерГТДПредставление,
		|		"""" КАК НомерГТДРегистрационныйНомер,
		|		РеализацияТоваровУслугТовары.Ссылка.ЦенаВключаетНДС КАК СуммаВключаетНДС,
		|		ВЫБОР КОГДА &ВесВБазовыхЕИ или (РеализацияТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка))
		|           ТОГДА РеализацияТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения 
		|           ИНАЧЕ РеализацияТоваровУслугТовары.Упаковка.ЕдиницаИзмерения
		|       КОНЕЦ КАК ЕдиницаИзмерения,
		|		&ПолеУпаковка КАК Упаковка,
		|		ВЫБОР КОГДА &ВесВБазовыхЕИ ИЛИ (РеализацияТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка))
		|           ТОГДА РеализацияТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения.код 
		|           ИНАЧЕ РеализацияТоваровУслугТовары.Упаковка.ЕдиницаИзмерения.код
		|       КОНЕЦ КАК КодЕдиницыИзмерения,
		|		ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка) КАК ЕдиницаИзмеренияПрослеживаемости,
		|		РеализацияТоваровУслугТовары.Упаковка.ЕдиницаИзмерения КАК ВидУпаковки,
		|		" + ПолучитьТекстЗапроса_КоэффициентУпаковки("РеализацияТоваровУслугТовары") + "
		|			РеализацияТоваровУслугТовары.КоличествоУпаковок КАК КоличествоМест,
		|		ИСТИНА КАК ЭтоУслуга,
		|       ВЫБОР КОГДА РеализацияТоваровУслугТовары.Упаковка.Вес ЕСТЬ NULL 
		|       	ТОГДА РеализацияТоваровУслугТовары.Количество * " + ПолучитьТекстЗапроса_НоменклатураВес("РеализацияТоваровУслугТовары") + "
		|           ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок * РеализацияТоваровУслугТовары.Упаковка.Вес 
		|       КОНЕЦ Как Масса,
		|       РеализацияТоваровУслугТовары.Количество * &ТекстЗапросаВесНоменклатуры как МассаНетто, 
		|		&ТекстЗапросаМассаБрутто КАК Брутто,
		|		Ложь КАК ПрослеживаемыйТовар,
		|		1 КАК Порядок,
		|		ВЫБОР 
		|			КОГДА РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) 
		|				ТОГДА ""Service"" 
		|			ИНАЧЕ ""Job"" 
		|		КОНЕЦ КАК ПризнакТоварРаботаУслуга,
		|		РеализацияТоваровУслугТовары.СуммаРучнойСкидки + РеализацияТоваровУслугТовары.СуммаАвтоматическойСкидки КАК СуммаСкидок
		|	ИЗ
		|		Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыВВалютеУчета
		|			ПО  СуммыВВалютеУчета.Регистратор  = &Ссылка 
		|				И РеализацияТоваровУслугТовары.ИдентификаторСтроки = СуммыВВалютеУчета.ИдентификаторСтроки
		|			И (СуммыВВалютеУчета.Активность)
		|				И (&ПересчитыватьВВалютуРегл)
		|	ГДЕ
		|		РеализацияТоваровУслугТовары.Ссылка = &Ссылка
		|		И " + ПолучитьТекстЗапроса_ОтборПоУслугамРаботам() + "
		|		И " + ТекстЗапроса_ОтборНаМногооборотнуюТару("РеализацияТоваровУслугТовары.Ссылка", "РеализацияТоваровУслугТовары.Номенклатура") + "
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	"+ ПолучитьТекстЗапросаДляСпискаТоваровСГТД(СсылкаНаДокумент, КолонкаКодаТовара)+") КАК Подзапрос
		|";
		
	Если КонстантаВыводитьСерииВПечатныхФормах = Истина Тогда 
		
		Запрос.Текст = Запрос.Текст + "";
		
	Иначе 
		
		Запрос.Текст = Запрос.Текст + "
		|	СГРУППИРОВАТЬ ПО
		|	Подзапрос.Номенклатура,
		|	Подзапрос.НоменклатураПредставление,
		|	Подзапрос.Характеристика,
		|	Подзапрос.КодНоменклатуры,
		|	Подзапрос.Цена,
		|	Подзапрос.СтавкаНДС,
		|	Подзапрос.НомерГТД,
		|	Подзапрос.СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление,
		|	Подзапрос.НомерГТДРегистрационныйНомер,
		|	Подзапрос.СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения,
		|	Подзапрос.Упаковка,
		|	Подзапрос.КодЕдиницыИзмерения,
		|	Подзапрос.ЕдиницаИзмеренияПрослеживаемости.Наименование,
		|	Подзапрос.ЕдиницаИзмеренияПрослеживаемости.Код,
		|	Подзапрос.ВидУпаковки,
		|	Подзапрос.КоличествоВОдномМесте,
		|	Подзапрос.ЭтоУслуга,
		|	Подзапрос.Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга,
		|	Подзапрос.ПрослеживаемыйТовар
		|";
		
	КонецЕсли;	
	
	Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	порядок,
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("ПустаяЕИ"										, Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВесВБазовыхЕИ"									, ИспользоватьБазовыеЕдиницыИзмерения());
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл"						, ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаДокумент));
	Запрос.УстановитьПараметр("ДатаДокумента"									, СсылкаНаДокумент.Дата);
	Запрос.УстановитьПараметр("ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров"	, ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров());
	
	Если 	(Метаданные.Имя = "УправлениеТорговлей" И МетодСервера(, "СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "11.2") < 0)
		Или (Метаданные.Имя = "УправлениеПредприятием" И МетодСервера(, "СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "2.1") < 0) Тогда
		
		ТекстЗапросаМассаБрутто = "
		|		ВЫБОР
		|			КОГДА &ЗаполненаЕдиницаИзмеренияВеса
		|				ТОГДА ВЫБОР
		|						КОГДА РеализацияТоваровУслугТовары.Упаковка.Вес ЕСТЬ NULL 
		|							ТОГДА РеализацияТоваровУслугТовары.Количество * РеализацияТоваровУслугТовары.Номенклатура.Вес
		|						ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок * РеализацияТоваровУслугТовары.Упаковка.Вес
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ";
		
		ТекстЗапросаВесНоменклатуры = "РеализацияТоваровУслугТовары.Номенклатура.Вес";
		
	Иначе
		
		ТекстЗапросаМассаБрутто = "
		|		ВЫБОР
		|			КОГДА &ЗаполненаЕдиницаИзмеренияВеса
		|				ТОГДА ВЫБОР
		|						КОГДА РеализацияТоваровУслугТовары.Упаковка.Вес ЕСТЬ NULL 
		|							ТОГДА РеализацияТоваровУслугТовары.Количество
		|						ИНАЧЕ ВЫБОР 
		|							КОГДА РеализацияТоваровУслугТовары.Упаковка.ТипИзмеряемойВеличины = Значение(Перечисление.ТипыИзмеряемыхВеличин.Вес)
		|								ТОГДА 0
		|							ИНАЧЕ РеализацияТоваровУслугТовары.КоличествоУпаковок
		|						КОНЕЦ
		|					КОНЕЦ * " + ТекстЗапросаВесУпаковки("РеализацияТоваровУслугТовары.Упаковка", "РеализацияТоваровУслугТовары.Номенклатура") + "
		|			ИНАЧЕ 0
		|		КОНЕЦ";
		
		ТекстЗапросаВесНоменклатуры = ТекстЗапросаВесУпаковки("РеализацияТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения", "РеализацияТоваровУслугТовары.Номенклатура");

	КонецЕсли;
	
	
	ПсевдонимТаблицы = "РеализацияТоваровУслугТовары";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦена", ВыражениеЦена(ПсевдонимТаблицы));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеУпаковка(ПсевдонимТаблицы));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаМассаБрутто", ТекстЗапросаМассаБрутто);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТекстЗапросаВесНоменклатуры", ТекстЗапросаВесНоменклатуры);
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоАктВыполненныхРабот(Запрос, КолонкаКодаТовара, СсылкаНаДокумент, ВалютаРегламентированногоУчета)
	
	Запрос.Текст = "ВЫБРАТЬ
		|	Подзапрос.НомерСтроки 				КАК НомерСтроки,
		|	Подзапрос.Номенклатура 				КАК Номенклатура,
		|	Подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
		|	Подзапрос.Содержание 				КАК Содержание,
		|	Подзапрос.Характеристика 			КАК Характеристика,
		|	НЕОПРЕДЕЛЕНО 						КАК Серия,
		|   Подзапрос.КодНоменклатуры 			КАК КодНоменклатуры, 
		|	Подзапрос.Количество 				КАК Количество,
		|	Подзапрос.Цена 						КАК Цена,
		|	Подзапрос.Сумма 					КАК Сумма,
		|	Подзапрос.СтавкаНДС 				КАК СтавкаНДС,
		|	Подзапрос.СуммаНДС 					КАК СуммаНДС,
		|	Подзапрос.НомерГТД 					КАК НомерГТД,
		|	Подзапрос.СтранаПроисхождения 		КАК СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление 	КАК НомерГТДПредставление,
		|	Подзапрос.СуммаВключаетНДС 			КАК СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения 			КАК ЕдиницаИзмерения,
		|	&ПолеУпаковка	 					КАК Упаковка,
		|	Подзапрос.КодЕдиницыИзмерения 		КАК КодЕдиницыИзмерения,
		|	"""" 								КАК ВидУпаковки,
		|	0 									КАК КоличествоВОдномМесте,
		|	0 									КАК КоличествоМест,
		|	Подзапрос.ЭтоУслуга 				КАК ЭтоУслуга,
		|	Подзапрос.Порядок 					КАК Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга 	КАК ПризнакТоварРаботаУслуга,
		|	Подзапрос.СуммаСкидок 				КАК СуммаСкидок
		|ИЗ
		|	(ВЫБРАТЬ
		|		АктВыполненныхРаботУслуги.НомерСтроки 	КАК НомерСтроки,
		|		АктВыполненныхРаботУслуги.Номенклатура 	КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ПОДСТРОКА(АктВыполненныхРаботУслуги.Номенклатура.НаименованиеПолное, 1, 10) = """"
		|				ТОГДА АктВыполненныхРаботУслуги.Номенклатура.Наименование
		|			ИНАЧЕ АктВыполненныхРаботУслуги.Номенклатура.НаименованиеПолное
		|		КОНЕЦ КАК НоменклатураПредставление,
		|		АктВыполненныхРаботУслуги.Содержание 	 КАК Содержание,
		|		АктВыполненныхРаботУслуги.Характеристика КАК Характеристика,
		|   	АктВыполненныхРаботУслуги.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|		АктВыполненныхРаботУслуги.Количество 	КАК Количество,
		|		АктВыполненныхРаботУслуги.Цена 			КАК Цена,
		|		ВЫБОР
		|			КОГДА СуммыВВалютеУчета.СуммаБезНДСРегл ЕСТЬ NULL 
		|				ТОГДА АктВыполненныхРаботУслуги.Сумма
		|			КОГДА АктВыполненныхРаботУслуги.Ссылка.ЦенаВключаетНДС
		|				ТОГДА СуммыВВалютеУчета.СуммаБезНДСРегл + СуммыВВалютеУчета.СуммаНДСРегл
		|			ИНАЧЕ СуммыВВалютеУчета.СуммаБезНДСРегл
		|		КОНЕЦ 									КАК Сумма,
		|		АктВыполненныхРаботУслуги.СтавкаНДС 	КАК СтавкаНДС,
		|		ЕСТЬNULL(СуммыВВалютеУчета.СуммаНДСРегл, АктВыполненныхРаботУслуги.СуммаНДС) КАК СуммаНДС,
		|		"""" КАК НомерГТД,
		|		"""" КАК СтранаПроисхождения,
		|		"""" КАК НомерГТДПредставление,
		|		АктВыполненныхРаботУслуги.Ссылка.ЦенаВключаетНДС 		КАК СуммаВключаетНДС,
		|		АктВыполненныхРаботУслуги.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|		АктВыполненныхРаботУслуги.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
		|		ИСТИНА КАК ЭтоУслуга,
		|		1 КАК Порядок,
		|		ВЫБОР 
		|			КОГДА АктВыполненныхРаботУслуги.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) 
		|				ТОГДА ""Service"" 
		|			ИНАЧЕ ""Job"" 
		|		КОНЕЦ КАК ПризнакТоварРаботаУслуга,
		|		АктВыполненныхРаботУслуги.СуммаРучнойСкидки + АктВыполненныхРаботУслуги.СуммаАвтоматическойСкидки КАК СуммаСкидок
		|	ИЗ
		|		Документ.АктВыполненныхРабот.Услуги КАК АктВыполненныхРаботУслуги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыВВалютеУчета
		|			ПО СуммыВВалютеУчета.Регистратор = &Ссылка 
		|				И АктВыполненныхРаботУслуги.ИдентификаторСтроки = СуммыВВалютеУчета.ИдентификаторСтроки
		|			И (СуммыВВалютеУчета.Активность)
		|				И (&ПересчитыватьВВалютуРегл)
		|	ГДЕ
		|		АктВыполненныхРаботУслуги.Ссылка = &Ссылка
		|	
		|	) КАК Подзапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	НомерСтроки";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеПустаяУпаковка());
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл", ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаДокумент));
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоКорректировкаРеализации(Запрос, КолонкаКодаТовара)
	
	Запрос.Текст = "ВЫБРАТЬ
		|	Подзапрос.НомерСтроки				КАК НомерСтроки,
		|	Подзапрос.Номенклатура				КАК Номенклатура,
		|	Подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
		|	Подзапрос.Содержание 				КАК Содержание,
		|	Подзапрос.Характеристика			КАК Характеристика,
		|	Подзапрос.Серия						КАК Серия,
		|	Подзапрос.КодНоменклатуры			КАК КодНоменклатуры,
		|	Подзапрос.Количество				КАК Количество,
		|	Подзапрос.Цена 						КАК Цена,
		|	Подзапрос.Сумма 					КАК Сумма,
		|	Подзапрос.СтавкаНДС 				КАК СтавкаНДС,
		|	Подзапрос.СуммаНДС 					КАК СуммаНДС,
		|	Подзапрос.НомерГТД 					КАК НомерГТД,
		|	Подзапрос.СтранаПроисхождения 		КАК СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление 	КАК НомерГТДПредставление,
		|	Подзапрос.СуммаВключаетНДС 			КАК СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения 			КАК ЕдиницаИзмерения,
		|	Подзапрос.Упаковка 					КАК Упаковка,
		|	Подзапрос.КодЕдиницыИзмерения 		КАК КодЕдиницыИзмерения,
		|	"""" 								КАК ВидУпаковки,
		|	0 									КАК КоличествоВОдномМесте,
		|	0 									КАК КоличествоМест,
		|	Подзапрос.ЭтоУслуга 				КАК ЭтоУслуга,
		|	Подзапрос.Порядок 					КАК Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга 	КАК ПризнакТоварРаботаУслуга
		|ИЗ
		|	(ВЫБРАТЬ
		|		КорректировкаРеализацииТовары.НомерСтроки	КАК НомерСтроки,
		|		КорректировкаРеализацииТовары.Номенклатура	КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ПОДСТРОКА(КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное, 1, 10) = """"
		|				ТОГДА КорректировкаРеализацииТовары.Номенклатура.Наименование
		|			ИНАЧЕ КорректировкаРеализацииТовары.Номенклатура.НаименованиеПолное
		|		КОНЕЦ 											КАК НоменклатураПредставление,
		|		КорректировкаРеализацииТовары.Содержание		КАК Содержание,
		|		КорректировкаРеализацииТовары.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|		КорректировкаРеализацииТовары.Характеристика	КАК Характеристика,
		|		КорректировкаРеализацииТовары.Серия				КАК Серия,
		|		ВЫБОР КОГДА &ВесВБазовыхЕИ 
		|            ТОГДА КорректировкаРеализацииТовары.Количество
		|            ИНАЧЕ КорректировкаРеализацииТовары.КоличествоУпаковок
		|       КОНЕЦ КАК Количество,
		|		КорректировкаРеализацииТовары.Цена				КАК Цена,
		|		КорректировкаРеализацииТовары.Сумма				КАК Сумма,
		|		КорректировкаРеализацииТовары.СтавкаНДС			КАК СтавкаНДС,
		|		КорректировкаРеализацииТовары.СуммаНДС			КАК СуммаНДС,
		|		"""" 											КАК НомерГТД,
		|		"""" 											КАК СтранаПроисхождения,
		|		"""" 											КАК НомерГТДПредставление,
		|		КорректировкаРеализацииТовары.Ссылка.ЦенаВключаетНДС 			КАК СуммаВключаетНДС,
		|		ВЫБОР КОГДА &ВесВБазовыхЕИ или (КорректировкаРеализацииТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка))
		|           ТОГДА КорректировкаРеализацииТовары.Номенклатура.ЕдиницаИзмерения 
		|           ИНАЧЕ КорректировкаРеализацииТовары.Упаковка.ЕдиницаИзмерения
		|       КОНЕЦ КАК ЕдиницаИзмерения,
		|		&ПолеУпаковка 							КАК Упаковка,
		|		ВЫБОР КОГДА &ВесВБазовыхЕИ ИЛИ (КорректировкаРеализацииТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка))
		|           ТОГДА КорректировкаРеализацииТовары.Номенклатура.ЕдиницаИзмерения.код 
		|           ИНАЧЕ КорректировкаРеализацииТовары.Упаковка.ЕдиницаИзмерения.код
		|       КОНЕЦ КАК КодЕдиницыИзмерения,
		|		ВЫБОР 
		|			КОГДА КорректировкаРеализацииТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар) 
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ КАК ЭтоУслуга,
		|		1 		КАК Порядок,
		|		ВЫБОР 
		|			КОГДА КорректировкаРеализацииТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар) 
		|				ТОГДА ""Property"" 
		|			КОГДА КорректировкаРеализацииТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга) 
		|				ТОГДА ""Service"" 
		|			ИНАЧЕ ""Job"" 
		|		КОНЕЦ КАК ПризнакТоварРаботаУслуга
		|	ИЗ
		|		Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
		|	ГДЕ
		|		КорректировкаРеализацииТовары.Ссылка = &Ссылка) КАК Подзапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	НомерСтроки";
	
	ПсевдонимТаблицы = "КорректировкаРеализацииТовары";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦена", ВыражениеЦена(ПсевдонимТаблицы));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеУпаковка(ПсевдонимТаблицы));
	Запрос.УстановитьПараметр("ВесВБазовыхЕИ", ИспользоватьБазовыеЕдиницыИзмерения());

КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоОтчетКомитенту(Запрос, КолонкаКодаТовара)
	
	Запрос.Текст = "ВЫБРАТЬ
		|	1 										КАК НомерСтроки,
		|	ОтчетКомитенту.СуммаВознаграждения		КАК Сумма,
		|	ОтчетКомитенту.СуммаНДСВознаграждения	КАК СуммаНДС,
		|	ОтчетКомитенту.СтавкаНДСВознаграждения	КАК СтавкаНДС,
		|	ОтчетКомитенту.Услуга					КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА ОтчетКомитенту.Услуга = ЗНАЧЕНИЕ(Справочник.номенклатура.ПустаяСсылка)
		|			ТОГДА ""Комиссионное вознаграждение""
		|		КОГДА ПОДСТРОКА(ОтчетКомитенту.Услуга.НаименованиеПолное, 1, 10) = """"
		|			ТОГДА ОтчетКомитенту.Услуга.Наименование
		|		ИНАЧЕ ОтчетКомитенту.Услуга.НаименованиеПолное
		|	КОНЕЦ 									КАК НоменклатураПредставление,
		|	ВЫБОР
		|		КОГДА ОтчетКомитенту.Услуга = ЗНАЧЕНИЕ(Справочник.номенклатура.ПустаяСсылка)
		|			ТОГДА """"
		|		ИНАЧЕ ОтчетКомитенту.Услуга." + КолонкаКодаТовара + "
		|	КОНЕЦ 							КАК КодНоменклатуры,
		|	НЕОПРЕДЕЛЕНО 					КАК Характеристика,
		|	НЕОПРЕДЕЛЕНО 					КАК Серия,
		|	0 								КАК Количество,
		|	"""" 							КАК Цена,
		|	"""" 							КАК НомерГТД,
		|	"""" 							КАК СтранаПроисхождения,
		|	"""" 							КАК НомерГТДПредставление,
		|	ОтчетКомитенту.ЦенаВключаетНДС 	КАК СуммаВключаетНДС,
		|	"""" 							КАК ЕдиницаИзмерения,
		|	&ПолеУпаковка					КАК Упаковка,
		|	"""" 							КАК КодЕдиницыИзмерения,
		|	"""" 							КАК ВидУпаковки,
		|	0 								КАК КоличествоВОдномМесте,
		|	0 								КАК КоличествоМест,
		|	ИСТИНА							КАК ЭтоУслуга,
		|	1 								КАК порядок,
		|	""Service"" 					КАК ПризнакТоварРаботаУслуга
		|ИЗ
		|	Документ.ОтчетКомитенту КАК ОтчетКомитенту
		|ГДЕ
		|	ОтчетКомитенту.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеПустаяУпаковка());
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоВозвратТоваровПоставщику(Запрос, КолонкаКодаТовара, СсылкаНаДокумент)
	
	Запрос.Текст = "ВЫБРАТЬ
		|	Подзапрос.НомерСтроки				КАК НомерСтроки,
		|	Подзапрос.Номенклатура				КАК Номенклатура,
		|	Подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
		|	Подзапрос.Характеристика 			КАК Характеристика,
		|	Подзапрос.Серия 					КАК Серия,
		|   Подзапрос.КодНоменклатуры 			КАК КодНоменклатуры, 
		|	Подзапрос.Количество 				КАК Количество,
		|	Подзапрос.Цена 						КАК Цена,
		|	Подзапрос.Сумма 					КАК Сумма,
		|	Подзапрос.СтавкаНДС 				КАК СтавкаНДС,
		|	Подзапрос.СуммаНДС 					КАК СуммаНДС,
		|	Подзапрос.НомерГТД 					КАК НомерГТД,
		|	Подзапрос.СтранаПроисхождения 		КАК СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление 	КАК НомерГТДПредставление,
		|	Подзапрос.СуммаВключаетНДС 			КАК СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения 			КАК ЕдиницаИзмерения,
		|	Подзапрос.Упаковка 					КАК Упаковка,
		|	Подзапрос.КодЕдиницыИзмерения 		КАК КодЕдиницыИзмерения,
		|	Подзапрос.ВидУпаковки 				КАК ВидУпаковки,
		|	Подзапрос.КоличествоВОдномМесте 	КАК КоличествоВОдномМесте,
		|	Подзапрос.КоличествоМест 			КАК КоличествоМест,
		|	Подзапрос.ЭтоУслуга 				КАК ЭтоУслуга,
		|	Подзапрос.порядок 					КАК Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга 	КАК ПризнакТоварРаботаУслуга
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВозвратТоваровПоставщикуТовары.НомерСтроки 	КАК НомерСтроки,
		|		ВозвратТоваровПоставщикуТовары.Номенклатура КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ПОДСТРОКА(ВозвратТоваровПоставщикуТовары.Номенклатура.НаименованиеПолное, 1, 10) = """"
		|				ТОГДА ВозвратТоваровПоставщикуТовары.Номенклатура.Наименование
		|			ИНАЧЕ ВозвратТоваровПоставщикуТовары.Номенклатура.НаименованиеПолное
		|		КОНЕЦ 											КАК НоменклатураПредставление,
		|		ВозвратТоваровПоставщикуТовары.Характеристика 	КАК Характеристика,
		|		ВозвратТоваровПоставщикуТовары.Серия 			КАК Серия,
		|   	ВозвратТоваровПоставщикуТовары.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|		ВозвратТоваровПоставщикуТовары.Количество 		КАК Количество,
		// ++ для совместимости с функцией ПолучитьТекстЗапросаДляСпискаТоваровСГТД()
		|		0 КАК КоличествоПоРНПТ,
		// -- для совместимости
		|		ВозвратТоваровПоставщикуТовары.Цена 			КАК Цена,
		|		ВозвратТоваровПоставщикуТовары.Сумма 			КАК Сумма,
		|		ВозвратТоваровПоставщикуТовары.СтавкаНДС 		КАК СтавкаНДС,
		|		ВозвратТоваровПоставщикуТовары.СуммаНДС 		КАК СуммаНДС,
		|		"""" КАК НомерГТД,
		|		"""" КАК СтранаПроисхождения,
		|		"""" КАК НомерГТДПредставление,
		// ++ для совместимости с функцией ПолучитьТекстЗапросаДляСпискаТоваровСГТД()
		|		"""" КАК НомерГТДРегистрационныйНомер,
		// -- для совместимости	
		|		ВозвратТоваровПоставщикуТовары.Ссылка.ЦенаВключаетНДС 				КАК СуммаВключаетНДС,
		|		ВозвратТоваровПоставщикуТовары.Номенклатура.ЕдиницаИзмерения 		КАК ЕдиницаИзмерения,
		|		&ПолеУпаковка							 							КАК Упаковка,
		|		ВозвратТоваровПоставщикуТовары.Номенклатура.ЕдиницаИзмерения.Код 	КАК КодЕдиницыИзмерения,
		// ++ для совместимости с функцией ПолучитьТекстЗапросаДляСпискаТоваровСГТД()
		|		"""" КАК ЕдиницаИзмеренияПрослеживаемости,
		// -- для совместимости				
		|		ВозвратТоваровПоставщикуТовары.Упаковка 							КАК ВидУпаковки,
		|		" + ПолучитьТекстЗапроса_КоэффициентУпаковки("ВозвратТоваровПоставщикуТовары") + "
		|		ВозвратТоваровПоставщикуТовары.КоличествоУпаковок КАК КоличествоМест,
		|		ЛОЖЬ КАК ЭтоУслуга,
		// ++ для совместимости с функцией ПолучитьТекстЗапросаДляСпискаТоваровСГТД()
		|		0 КАК Масса,
		|		0 КАК МассаНетто,
		|		0 КАК МассаБрутто,
		|		Ложь КАК ПрослеживаемыйТовар,
		// -- для совместимости
		|		1 КАК порядок,
		|		""Property"" КАК ПризнакТоварРаботаУслуга,
		// ++ для совместимости с функцией ПолучитьТекстЗапросаДляСпискаТоваровСГТД()
		|		0 КАК СуммаСкидок
		// -- для совместимости
		|	ИЗ
		|		Документ.ВозвратТоваровПоставщику.Товары КАК ВозвратТоваровПоставщикуТовары
		|	ГДЕ
		|		ВозвратТоваровПоставщикуТовары.Ссылка = &Ссылка
		|		И "+ПолучитьТекстЗапроса_ОтборПоУслугамРаботам() + "
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	" + ПолучитьТекстЗапросаДляСпискаТоваровСГТД(СсылкаНаДокумент, КолонкаКодаТовара) + ") КАК Подзапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	НомерСтроки";
	
	ПсевдонимТаблицы = "ВозвратТоваровПоставщикуТовары";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦена", ВыражениеЦена(ПсевдонимТаблицы));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеУпаковка(ПсевдонимТаблицы));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст
		, "Документ.РеализацияТоваровУслуг.ВидыЗапасов"
		, "Документ.ВозвратТоваровПоставщику.ВидыЗапасов");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст
		, "РеализацияТоваровУслугТовары"
		, "ВозвратТоваровПоставщикуТовары");
		
	Запрос.УстановитьПараметр("ПустаяЕИ"				, Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВесВБазовыхЕИ"			, ИспользоватьБазовыеЕдиницыИзмерения());
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл", ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаДокумент));
	Запрос.УстановитьПараметр("ДатаДокумента"			, СсылкаНаДокумент.Дата);
	Запрос.УстановитьПараметр("ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров", ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров());

КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоЗаказКлиента(Запрос, КолонкаКодаТовара)
	
	Запрос.Текст = "ВЫБРАТЬ
		|	Подзапрос.НомерСтроки 				КАК НомерСтроки,
		|	Подзапрос.Номенклатура				КАК Номенклатура,
		|	Подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
		|	Подзапрос.Содержание				КАК Содержание,
		|	Подзапрос.Характеристика 			КАК Характеристика,
		|	Подзапрос.Серия 					КАК Серия,
		|   Подзапрос.КодНоменклатуры 			КАК КодНоменклатуры, 
		|	Подзапрос.Количество 				КАК Количество,
		|	Подзапрос.Цена 						КАК Цена,
		|	Подзапрос.Сумма 					КАК Сумма,
		|	Подзапрос.СтавкаНДС 				КАК СтавкаНДС,
		|	Подзапрос.СуммаНДС 					КАК СуммаНДС,
		|	Подзапрос.НомерГТД 					КАК НомерГТД,
		|	Подзапрос.СтранаПроисхождения 		КАК СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление 	КАК НомерГТДПредставление,
		|	Подзапрос.СуммаВключаетНДС 			КАК СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения 			КАК ЕдиницаИзмерения,
		|	Подзапрос.Упаковка 					КАК Упаковка,
		|	Подзапрос.КодЕдиницыИзмерения 		КАК КодЕдиницыИзмерения,
		|	Подзапрос.ВидУпаковки 				КАК ВидУпаковки,
		|	Подзапрос.КоличествоВОдномМесте 	КАК КоличествоВОдномМесте,
		|	Подзапрос.КоличествоМест 			КАК КоличествоМест,
		|	Подзапрос.ЭтоУслуга 				КАК ЭтоУслуга,
		|	Подзапрос.порядок 					КАК Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга 	КАК ПризнакТоварРаботаУслуга,
		|	Подзапрос.СуммаСкидок 				КАК СуммаСкидок
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗаказКлиентаТовары.НомерСтроки	КАК НомерСтроки,
		|		ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ПОДСТРОКА(ЗаказКлиентаТовары.Номенклатура.НаименованиеПолное, 1, 10) = """"
		|				ТОГДА ЗаказКлиентаТовары.Номенклатура.Наименование
		|			ИНАЧЕ ЗаказКлиентаТовары.Номенклатура.НаименованиеПолное
		|		КОНЕЦ 								КАК НоменклатураПредставление,
		|		ЗаказКлиентаТовары.Содержание 		КАК Содержание,
		|		ЗаказКлиентаТовары.Характеристика 	КАК Характеристика,
		|		ЗаказКлиентаТовары.Серия 			КАК Серия,
		|   	ЗаказКлиентаТовары.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|		ЗаказКлиентаТовары.Количество 		КАК Количество,
		|		ЗаказКлиентаТовары.Цена 			КАК Цена,
		|		ЗаказКлиентаТовары.Сумма 			КАК Сумма,
		|		ЗаказКлиентаТовары.СтавкаНДС 		КАК СтавкаНДС,
		|		ЗаказКлиентаТовары.СуммаНДС 		КАК СуммаНДС,
		|		"""" КАК НомерГТД,
		|		"""" КАК СтранаПроисхождения,
		|		"""" КАК НомерГТДПредставление,
		|		ЗаказКлиентаТовары.Ссылка.ЦенаВключаетНДС 				КАК СуммаВключаетНДС,
		|		ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения 		КАК ЕдиницаИзмерения,
		|		&ПолеУпаковка 											КАК Упаковка,
		|		ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения.Код 	КАК КодЕдиницыИзмерения,
		|		ЗаказКлиентаТовары.Упаковка 							КАК ВидУпаковки,
		|		" + ПолучитьТекстЗапроса_КоэффициентУпаковки("ЗаказКлиентаТовары") + "
		|		ЗаказКлиентаТовары.КоличествоУпаковок 					КАК КоличествоМест,
		|		ЛОЖЬ 			КАК ЭтоУслуга,
		|		1 				КАК порядок,
		|		""Property"" 	КАК ПризнакТоварРаботаУслуга,
		|		ЗаказКлиентаТовары.СуммаРучнойСкидки + ЗаказКлиентаТовары.СуммаАвтоматическойСкидки КАК СуммаСкидок
		|	ИЗ
		|		Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|	ГДЕ
		|		ЗаказКлиентаТовары.Ссылка = &Ссылка И ЗаказКлиентаТовары.Отменено = ЛОЖЬ
		|	
		|	) КАК Подзапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	НомерСтроки";
	
	ПсевдонимТаблицы = "ЗаказКлиентаТовары";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеЦена", ВыражениеЦена(ПсевдонимТаблицы));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеУпаковка(ПсевдонимТаблицы));
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоСчетФактураВыданныйАванс(Запрос, КолонкаКодаТовара)
	
	Запрос.Текст =    
		"ВЫБРАТЬ
		|	СчетФактураВыданныйАвансы.НомерСтроки	КАК НомерСтроки,
		|	СчетФактураВыданныйАвансы.Номенклатура	КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА СчетФактураВыданныйАвансы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|            И ПОДСТРОКА(СчетФактураВыданныйАвансы.Номенклатура.НаименованиеПолное, 1, 10) <> """"
		|			ТОГДА СчетФактураВыданныйАвансы.Номенклатура.НаименованиеПолное
		|		КОГДА СчетФактураВыданныйАвансы.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)  
		|			ТОГДА СчетФактураВыданныйАвансы.Номенклатура.Наименование
		|		ИНАЧЕ ""Предварительная оплата""
		|	КОНЕЦ 			КАК НоменклатураПредставление,
		|	СчетФактураВыданныйАвансы.Содержание 	КАК Содержание,
		|	НЕОПРЕДЕЛЕНО 	КАК Характеристика,
		|	НЕОПРЕДЕЛЕНО 	КАК Серия,
		|  	СчетФактураВыданныйАвансы.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|	0 			КАК Количество,
		|	0 			КАК Цена,
		|	СчетФактураВыданныйАвансы.Сумма,
		|	СчетФактураВыданныйАвансы.СтавкаНДС,
		|	СчетФактураВыданныйАвансы.СуммаНДС,
		|	"""" 		КАК НомерГТД,
		|	"""" 		КАК СтранаПроисхождения,
		|	"""" 		КАК НомерГТДПредставление,
		|	ИСТИНА 		КАК СуммаВключаетНДС,
		|	"""" 		КАК ЕдиницаИзмерения,
		|	&ПолеУпаковка КАК Упаковка,
		|	"""" 		КАК КодЕдиницыИзмерения,
		|	"""" 		КАК ВидУпаковки,
		|	0 			КАК КоличествоВОдномМесте,
		|	0 			КАК КоличествоМест,
		|	ИСТИНА 		КАК ЭтоУслуга,
		|	""Service""	КАК ПризнакТоварРаботаУслуга
		|ИЗ
		|	Документ.СчетФактураВыданныйАванс.Авансы КАК СчетФактураВыданныйАвансы
		|ГДЕ
		|	СчетФактураВыданныйАвансы.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеПустаяУпаковка());
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ОтчетДавальцу(Запрос, СсылкаНаДокумент)
	
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл", ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаДокумент));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	1 КАК НомерСтроки,
	|	Подзапрос.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Подзапрос.НоменклатураПредставление) КАК НоменклатураПредставление,
	|	МАКСИМУМ(Подзапрос.Содержание) КАК Содержание,
	|	Подзапрос.Характеристика КАК Характеристика,
	|	НЕОПРЕДЕЛЕНО КАК Серия,
	|	МАКСИМУМ(Подзапрос.КодНоменклатуры) КАК КодНоменклатуры,
	|	1 КАК Количество,
	|	СУММА(Подзапрос.Сумма) КАК Цена,
	|	СУММА(Подзапрос.Сумма) КАК Сумма,
	|	Подзапрос.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(Подзапрос.СуммаНДС) КАК СуммаНДС,
	|	НЕОПРЕДЕЛЕНО КАК НомерГТД,
	|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
	|	НЕОПРЕДЕЛЕНО КАК НомерГТДПредставление,
	|	Подзапрос.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Подзапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Подзапрос.Упаковка КАК Упаковка,
	|	МАКСИМУМ(Подзапрос.КодЕдиницыИзмерения) КАК КодЕдиницыИзмерения,
	|	"""" КАК ВидУпаковки,
	|	0 КАК КоличествоВОдномМесте,
	|	0 КАК КоличествоМест,
	|	ИСТИНА КАК ЭтоУслуга,
	|	МАКСИМУМ(Подзапрос.ПризнакТоварРаботаУслуга) КАК ПризнакТоварРаботаУслуга,
	|	0 КАК СуммаСкидок
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеТЧ.Ссылка.Номенклатура КАК Номенклатура,
	|		ДанныеТЧ.Ссылка.Содержание КАК НоменклатураПредставление,
	|		ДанныеТЧ.Ссылка.Содержание КАК Содержание,
	|		ДанныеТЧ.Ссылка.Характеристика КАК Характеристика,
	|		ДанныеТЧ.Ссылка.Номенклатура.Код КАК КодНоменклатуры,
	|		ДанныеТЧ.Цена КАК Цена,
	|		ВЫБОР
	|			КОГДА СуммыВВалютеУчета.СуммаБезНДСРегл ЕСТЬ NULL
	|				ТОГДА ДанныеТЧ.Сумма
	|			КОГДА ДанныеТЧ.Ссылка.ЦенаВключаетНДС
	|				ТОГДА СуммыВВалютеУчета.СуммаБезНДСРегл + СуммыВВалютеУчета.СуммаНДСРегл
	|			ИНАЧЕ СуммыВВалютеУчета.СуммаБезНДСРегл
	|		КОНЕЦ КАК Сумма,
	|		ДанныеТЧ.Ссылка.СтавкаНДС КАК СтавкаНДС,
	|		ЕСТЬNULL(СуммыВВалютеУчета.СуммаНДСРегл, ДанныеТЧ.СуммаНДС) КАК СуммаНДС,
	|		ДанныеТЧ.Ссылка.ЦенаВключаетНДС КАК СуммаВключаетНДС,
	|		ДанныеТЧ.Ссылка.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		&ПолеУпаковка КАК Упаковка,
	|		ДанныеТЧ.Ссылка.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
	|		ВЫБОР
	|			КОГДА ДанныеТЧ.Ссылка.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|				ТОГДА ""Service""
	|			ИНАЧЕ ""Job""
	|		КОНЕЦ КАК ПризнакТоварРаботаУслуга
	|	ИЗ
	|		Документ.ОтчетДавальцу.Продукция КАК ДанныеТЧ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыВВалютеУчета
	|			ПО (СуммыВВалютеУчета.Регистратор = &Ссылка)
	|				И ДанныеТЧ.ИдентификаторСтроки = СуммыВВалютеУчета.ИдентификаторСтроки
	|				И (СуммыВВалютеУчета.Активность)
	|				И (&ПересчитыватьВВалютуРегл)
	|	ГДЕ
	|		ДанныеТЧ.Ссылка = &Ссылка) КАК Подзапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	Подзапрос.Номенклатура,
	|	Подзапрос.Характеристика,
	|	Подзапрос.СтавкаНДС,
	|	Подзапрос.ЕдиницаИзмерения,
	|	Подзапрос.Упаковка,
	|	Подзапрос.СуммаВключаетНДС";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеПустаяУпаковка());
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_РеализацияУслугПрочихАктивов(Запрос, СсылкаНаДокумент)
	
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл", ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаДокумент));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Подзапрос.НомерСтроки КАК НомерСтроки,
	|	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	|	Подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
	|	Подзапрос.Содержание КАК Содержание,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	НЕОПРЕДЕЛЕНО КАК Серия,
	|	НЕОПРЕДЕЛЕНО КАК КодНоменклатуры,
	|	Подзапрос.Количество КАК Количество,
	|	Подзапрос.Цена КАК Цена,
	|	Подзапрос.Сумма КАК Сумма,
	|	Подзапрос.СтавкаНДС КАК СтавкаНДС,
	|	Подзапрос.СуммаНДС КАК СуммаНДС,
	|	НЕОПРЕДЕЛЕНО КАК НомерГТД,
	|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
	|	НЕОПРЕДЕЛЕНО КАК НомерГТДПредставление,
	|	Подзапрос.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Подзапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Подзапрос.Упаковка КАК Упаковка,
	|	Подзапрос.КодЕдиницыИзмерения КАК КодЕдиницыИзмерения,
	|	"""" КАК ВидУпаковки,
	|	0 КАК КоличествоВОдномМесте,
	|	0 КАК КоличествоМест,
	|	ИСТИНА КАК ЭтоУслуга,
	|	""Service"" КАК ПризнакТоварРаботаУслуга,
	|	0 КАК СуммаСкидок
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДанныеТЧ.НомерСтроки КАК НомерСтроки,
	|		ДанныеТЧ.Содержание КАК НоменклатураПредставление,
	|		ДанныеТЧ.Содержание КАК Содержание,
	|		ДанныеТЧ.Количество КАК Количество,
	|		ДанныеТЧ.Цена КАК Цена,
	|		ВЫБОР
	|			КОГДА СуммыРегл.СуммаБезНДСРегл ЕСТЬ NULL
	|				ТОГДА ДанныеТЧ.Сумма
	|			КОГДА ДанныеТЧ.Ссылка.ЦенаВключаетНДС
	|				ТОГДА СуммыРегл.СуммаБезНДСРегл + СуммыРегл.СуммаНДСРегл
	|			ИНАЧЕ СуммыРегл.СуммаБезНДСРегл
	|		КОНЕЦ КАК Сумма,
	|		ДанныеТЧ.СтавкаНДС КАК СтавкаНДС,
	|		ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, ДанныеТЧ.СуммаНДС) КАК СуммаНДС,
	|		ДанныеТЧ.Ссылка.ЦенаВключаетНДС КАК СуммаВключаетНДС,
	|		ДанныеТЧ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		&ПолеУпаковка КАК Упаковка,
	|		ЕСТЬNULL(ДанныеТЧ.ЕдиницаИзмерения.Код, НЕОПРЕДЕЛЕНО) КАК КодЕдиницыИзмерения
	|	ИЗ
	|		Документ.РеализацияУслугПрочихАктивов.Доходы КАК ДанныеТЧ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыРегл
	|			ПО (СуммыРегл.Регистратор = &Ссылка)
	|				И ДанныеТЧ.ИдентификаторСтроки = СуммыРегл.ИдентификаторСтроки
	|				И (СуммыРегл.Активность)
	|				И (&ПересчитыватьВВалютуРегл)
	|	ГДЕ
	|		ДанныеТЧ.Ссылка = &Ссылка) КАК Подзапрос
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеУпаковка", ВыражениеПустаяУпаковка());
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_СчетФактураКомиссионеру(Запрос, СсылкаНаОбъект)
	
	ТекстЗапросаТаблицаПокупателей = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СФКомиссионеру.Ссылка КАК СчетФактура,
	|	СФКомиссионеру.ДокументОснование КАК ОтчетПоКомиссии,
	|	ТЧПокупатели.Покупатель КАК Покупатель,
	|	ТЧПокупатели.НомерСчетаФактуры КАК НомерСчетаФактуры
	|ПОМЕСТИТЬ ТаблицаПокупателей
	|ИЗ
	|	Документ.СчетФактураКомиссионеру.Покупатели КАК ТЧПокупатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураКомиссионеру КАК СФКомиссионеру
	|		ПО (СФКомиссионеру.Ссылка = ТЧПокупатели.Ссылка)
	|ГДЕ
	|	СФКомиссионеру.Ссылка = &СсылкаНаОбъект
	|;";
	
	Если ЭтоСчетФактураНаРеализациюЧерезКомиссионера(СсылкаНаОбъект) Тогда
		
		ТекстЗапросаТаблицаПокупателей = СтрЗаменить(ТекстЗапросаТаблицаПокупателей
			, "Документ.СчетФактураКомиссионеру"
			, "Документ.СчетФактураВыданный");
			
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапросаТаблицаПокупателей + "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокументов.Ссылка КАК Ссылка,
	|	ДанныеДокументов.Валюта КАК Валюта,
	|	ДанныеДокументов.Организация КАК Организация,
	|	ДанныеДокументов.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад
	|ПОМЕСТИТЬ ТаблицаДанныхДокументов
	|ИЗ
	|	Документ.ОтчетКомиссионера КАК ДанныеДокументов
	|ГДЕ
	|	ДанныеДокументов.Ссылка В(&ОснованияСФ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ТаблицаТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ТаблицаТоваров.Упаковка КАК Упаковка,
	|	МАКСИМУМ(ТаблицаТоваров.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ СтрокиТоваров
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ДанныеДокументов
	|		ПО ТаблицаТоваров.Ссылка = ДанныеДокументов.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.Ссылка,
	|	ТаблицаТоваров.АналитикаУчетаНоменклатуры,
	|	ТаблицаТоваров.Упаковка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаТоваров.Ссылка,
	|	ТаблицаТоваров.АналитикаУчетаНоменклатуры,
	|	ТаблицаТоваров.Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	СтрокиТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Серия КАК Серия,
	|	ТаблицаДокумента.НомерГТД КАК НомерГТД,
	|	СУММА(ТаблицаДокумента.Количество) КАК Количество,
	|	СУММА(ТаблицаДокумента.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	СУММА(ЕСТЬNULL(СуммыВВалютеУчета.СуммаБезНДСРегл, ТаблицаДокумента.СуммаСНДС - ТаблицаДокумента.СуммаНДС)) КАК СуммаБезНДС,
	|	ТаблицаДокумента.СтавкаНДС КАК СтавкаНДС,
	|	СУММА(ЕСТЬNULL(СуммыВВалютеУчета.СуммаНДСРегл, ТаблицаДокумента.СуммаНДС)) КАК СуммаНДС,
	|	ТаблицаДокумента.Упаковка КАК Упаковка,
	|	ТаблицаДокумента.ДатаСчетаФактурыКомиссионера КАК ДатаСчетаФактурыКомиссионера,
	|	ТаблицаДокумента.Покупатель КАК Покупатель,
	|	ТаблицаДокумента.НомерСчетаФактурыКомиссионера КАК НомерСчетаФактурыКомиссионера,
	|	ЛОЖЬ КАК ЭтоУслуга
	|ПОМЕСТИТЬ ОтчетКомиссионераТаблицаТоваров
	|ИЗ
	|	Документ.ОтчетКомиссионера.ВидыЗапасов КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ДанныеДокументов
	|		ПО ТаблицаДокумента.Ссылка = ДанныеДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыВВалютеУчета
	|		ПО ТаблицаДокумента.Ссылка = СуммыВВалютеУчета.Регистратор
	|			И ТаблицаДокумента.ИдентификаторСтроки = СуммыВВалютеУчета.ИдентификаторСтроки
	|			И (СуммыВВалютеУчета.Активность)
	|			И (&ПересчитыватьВВалютуРегл)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтрокиТоваров КАК СтрокиТоваров
	|		ПО ТаблицаДокумента.Ссылка = СтрокиТоваров.Ссылка
	|			И ТаблицаДокумента.АналитикаУчетаНоменклатуры = СтрокиТоваров.АналитикаУчетаНоменклатуры
	|			И ТаблицаДокумента.Упаковка = СтрокиТоваров.Упаковка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.Ссылка,
	|	СтрокиТоваров.НомерСтроки,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Номенклатура,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Характеристика,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Серия,
	|	ТаблицаДокумента.СтавкаНДС,
	|	ТаблицаДокумента.Упаковка,
	|	ТаблицаДокумента.НомерГТД,
	|	ТаблицаДокумента.ДатаСчетаФактурыКомиссионера,
	|	ТаблицаДокумента.Покупатель,
	|	ТаблицаДокумента.НомерСчетаФактурыКомиссионера
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка,
	|	ТаблицаДокумента.НомерСтроки,
	|	ТаблицаДокумента.Номенклатура,
	|	ТаблицаДокумента.Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	СУММА(ТаблицаДокумента.Количество),
	|	СУММА(ТаблицаДокумента.КоличествоУпаковок),
	|	СУММА(ЕСТЬNULL(СуммыВВалютеУчета.СуммаБезНДСРегл, ТаблицаДокумента.СуммаПродажи - ТаблицаДокумента.СуммаПродажиНДС)),
	|	ТаблицаДокумента.СтавкаНДС,
	|	СУММА(ЕСТЬNULL(СуммыВВалютеУчета.СуммаНДСРегл, ТаблицаДокумента.СуммаПродажиНДС)),
	|	ТаблицаДокумента.Упаковка,
	|	ТаблицаДокумента.ДатаСчетаФактурыКомиссионера,
	|	ТаблицаДокумента.Покупатель,
	|	ТаблицаДокумента.НомерСчетаФактурыКомиссионера,
	|	ИСТИНА
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ДанныеДокументов
	|		ПО ТаблицаДокумента.Ссылка = ДанныеДокументов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыВВалютеУчета
	|		ПО ТаблицаДокумента.Ссылка = СуммыВВалютеУчета.Регистратор
	|			И ТаблицаДокумента.ИдентификаторСтроки = СуммыВВалютеУчета.ИдентификаторСтроки
	|			И (СуммыВВалютеУчета.Активность)
	|			И (&ПересчитыватьВВалютуРегл)
	|ГДЕ
	|	ТаблицаДокумента.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.Ссылка,
	|	ТаблицаДокумента.НомерСтроки,
	|	ТаблицаДокумента.Номенклатура,
	|	ТаблицаДокумента.Характеристика,
	|	ТаблицаДокумента.СтавкаНДС,
	|	ТаблицаДокумента.Упаковка,
	|	ТаблицаДокумента.ДатаСчетаФактурыКомиссионера,
	|	ТаблицаДокумента.Покупатель,
	|	ТаблицаДокумента.НомерСчетаФактурыКомиссионера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка КАК Ссылка,
	|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДокумента.Номенклатура КАК Номенклатура,
	|	ТаблицаДокумента.Характеристика КАК Характеристика,
	|	ТаблицаДокумента.Серия КАК Серия,
	|	ТаблицаДокумента.Упаковка КАК Упаковка,
	|	ТаблицаДокумента.НомерГТД КАК НомерГТД,
	|	ТаблицаДокумента.Количество КАК Количество,
	|	ТаблицаДокумента.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ТаблицаДокумента.СуммаБезНДС КАК СуммаБезНДС,
	|	ТаблицаДокумента.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаДокумента.СуммаНДС КАК СуммаНДС,
	|	ТаблицаДокумента.ДатаСчетаФактурыКомиссионера КАК ДатаСчетаФактурыКомиссионера,
	|	ТаблицаДокумента.НомерСчетаФактурыКомиссионера КАК НомерСчетаФактурыКомиссионера,
	|	ТаблицаДокумента.Покупатель КАК Покупатель,
	|	ТаблицаДокумента.ЭтоУслуга КАК ЭтоУслуга
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	ОтчетКомиссионераТаблицаТоваров КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПокупателей КАК ТаблицаПокупателей
	|		ПО ТаблицаДокумента.Ссылка = ТаблицаПокупателей.ОтчетПоКомиссии
	|			И ТаблицаДокумента.Покупатель = ТаблицаПокупателей.Покупатель
	|			И ТаблицаДокумента.НомерСчетаФактурыКомиссионера = ТаблицаПокупателей.НомерСчетаФактуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ДанныеНоменклатуры.НаименованиеПолное КАК НоменклатураПредставление,
	|	ВЫБОР
	|		КОГДА &КолонкаКодов = ""Артикул""
	|			ТОГДА ДанныеНоменклатуры.Артикул
	|		ИНАЧЕ ДанныеНоменклатуры.Код
	|	КОНЕЦ КАК КодНоменклатуры,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеУпаковки.Ссылка ЕСТЬ NULL
	|			ТОГДА ДанныеУпаковки.ЕдиницаИзмерения
	|		КОГДА ДанныеНоменклатуры.Ссылка ЕСТЬ NULL
	|			ТОГДА ТаблицаТоваров.Упаковка
	|		ИНАЧЕ ДанныеНоменклатуры.ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА НЕ ДанныеУпаковки.Ссылка ЕСТЬ NULL
	|			ТОГДА ДанныеУпаковки.ЕдиницаИзмерения.Код
	|		КОГДА ДанныеНоменклатуры.Ссылка ЕСТЬ NULL
	|			ТОГДА ТаблицаТоваров.Упаковка.ЕдиницаИзмерения.Код
	|		ИНАЧЕ ДанныеНоменклатуры.ЕдиницаИзмерения.Код
	|	КОНЕЦ КАК КодЕдиницыИзмерения,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Серия КАК Серия,
	|	ТаблицаТоваров.НомерГТД КАК НомерГТД,
	|	НЕОПРЕДЕЛЕНО КАК СтранаПроисхождения,
	|	ТаблицаТоваров.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Количество
	|		ИНАЧЕ ТаблицаТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.Количество = 0
	|			ТОГДА 0
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.СуммаБезНДС / ТаблицаТоваров.Количество
	|		ИНАЧЕ ТаблицаТоваров.СуммаБезНДС / ТаблицаТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК Цена,
	|	ТаблицаТоваров.СуммаБезНДС КАК Сумма,
	|	ТаблицаТоваров.СуммаНДС КАК СуммаНДС,
	|	ЛОЖЬ КАК СуммаВключаетНДС,
	|	ТаблицаТоваров.ЭтоУслуга КАК ЭтоУслуга,
	|	ТаблицаТоваров.Покупатель КАК Покупатель,
	|	ТаблицаТоваров.ДатаСчетаФактурыКомиссионера КАК ДатаСчетаФактурыКомиссионера,
	|	ТаблицаТоваров.НомерСчетаФактурыКомиссионера КАК НомерСчетаФактурыКомиссионера
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ДанныеНоменклатуры
	|		ПО ТаблицаТоваров.Номенклатура = ДанныеНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК ДанныеУпаковки
	|		ПО (НЕ &ВыводитьБазовыеЕдиницыИзмерения)
	|			И ТаблицаТоваров.Упаковка = ДанныеУпаковки.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаТоваров.Ссылка,
	|	ТаблицаТоваров.НомерСтроки";
	
	ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
	ОснованияСФ = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументОснование);
	
	КолонкаКодов = ИмяДополнительнойКолонки();
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ОснованияСФ", ОснованияСФ);
	Запрос.УстановитьПараметр("КолонкаКодов", КолонкаКодов);
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", ИспользоватьБазовыеЕдиницыИзмерения());
	Запрос.УстановитьПараметр("ПересчитыватьВВалютуРегл", ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаОбъект));
	
КонецПроцедуры

Процедура СформироватьЗапрос_ДанныеТЧ_ПоПередачаТоваровХранителю(Запрос, КолонкаКодаТовара, СсылкаНаДокумент)
	
		Запрос.Текст = "ВЫБРАТЬ
		|	Подзапрос.НомерСтроки 				КАК НомерСтроки,
		|	Подзапрос.Номенклатура				КАК Номенклатура,
		|	Подзапрос.НоменклатураПредставление КАК НоменклатураПредставление,
		|	Подзапрос.Содержание				КАК Содержание,
		|	Подзапрос.Характеристика 			КАК Характеристика,
		|	Подзапрос.Серия 					КАК Серия,
		|   Подзапрос.КодНоменклатуры 			КАК КодНоменклатуры, 
		|	Подзапрос.Количество 				КАК Количество,
		|	Подзапрос.Цена 						КАК Цена,
		|	Подзапрос.Сумма 					КАК Сумма,
		|	Подзапрос.СтавкаНДС 				КАК СтавкаНДС,
		|	Подзапрос.СуммаНДС 					КАК СуммаНДС,
		|	Подзапрос.НомерГТД 					КАК НомерГТД,
		|	Подзапрос.СтранаПроисхождения 		КАК СтранаПроисхождения,
		|	Подзапрос.НомерГТДПредставление 	КАК НомерГТДПредставление,
		|	Подзапрос.СуммаВключаетНДС 			КАК СуммаВключаетНДС,
		|	Подзапрос.ЕдиницаИзмерения 			КАК ЕдиницаИзмерения,
		|	Подзапрос.КодЕдиницыИзмерения 		КАК КодЕдиницыИзмерения,
		|	Подзапрос.ВидУпаковки 				КАК ВидУпаковки,
		|	Подзапрос.КоличествоВОдномМесте 	КАК КоличествоВОдномМесте,
		|	Подзапрос.КоличествоУпаковок 		КАК КоличествоУпаковок,
		|	Подзапрос.ЭтоУслуга 				КАК ЭтоУслуга,
		|	Подзапрос.порядок 					КАК Порядок,
		|	Подзапрос.ПризнакТоварРаботаУслуга 	КАК ПризнакТоварРаботаУслуга,
		|	Подзапрос.СуммаСкидок 				КАК СуммаСкидок
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПередачаТоваровХранителюТовары.НомерСтроки	КАК НомерСтроки,
		|		ПередачаТоваровХранителюТовары.Номенклатура КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ПОДСТРОКА(ПередачаТоваровХранителюТовары.Номенклатура.НаименованиеПолное, 1, 10) = """"
		|				ТОГДА ПередачаТоваровХранителюТовары.Номенклатура.Наименование
		|			ИНАЧЕ ПередачаТоваровХранителюТовары.Номенклатура.НаименованиеПолное
		|		КОНЕЦ 								КАК НоменклатураПредставление,
		|		НЕОПРЕДЕЛЕНО									КАК Содержание,
		|		ПередачаТоваровХранителюТовары.Характеристика 	КАК Характеристика,
		|		ПередачаТоваровХранителюТовары.Серия 			КАК Серия,
		|   	ПередачаТоваровХранителюТовары.Номенклатура." + КолонкаКодаТовара + " КАК КодНоменклатуры,
		|		ПередачаТоваровХранителюТовары.Количество 		КАК Количество,
		|		ПередачаТоваровХранителюТовары.Цена 			КАК Цена,
		|		ПередачаТоваровХранителюТовары.Сумма 			КАК Сумма,
		|		ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС)           КАК СтавкаНДС,
		|		0 	 КАК СуммаНДС,
		|		"""" КАК НомерГТД,
		|		"""" КАК СтранаПроисхождения,
		|		"""" КАК НомерГТДПредставление,
		|		ЛОЖЬ КАК СуммаВключаетНДС,
		|		ПередачаТоваровХранителюТовары.Номенклатура.ЕдиницаИзмерения 		КАК ЕдиницаИзмерения,
		|		ПередачаТоваровХранителюТовары.Номенклатура.ЕдиницаИзмерения.Код 	КАК КодЕдиницыИзмерения,
		|		ПередачаТоваровХранителюТовары.Упаковка 							КАК ВидУпаковки,
		|		" + ПолучитьТекстЗапроса_КоэффициентУпаковки("ПередачаТоваровХранителюТовары") + "
		|		ПередачаТоваровХранителюТовары.КоличествоУпаковок 					КАК КоличествоУпаковок,
		|		ЛОЖЬ 			КАК ЭтоУслуга,
		|		1 				КАК порядок,
		|		""Property"" 	КАК ПризнакТоварРаботаУслуга,
		|		0 КАК СуммаСкидок
		|	ИЗ
		|		Документ.ПередачаТоваровХранителю.Товары КАК ПередачаТоваровХранителюТовары
		|	ГДЕ
		|		ПередачаТоваровХранителюТовары.Ссылка = &Ссылка
		|	
		|	) КАК Подзапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	НомерСтроки";
				
