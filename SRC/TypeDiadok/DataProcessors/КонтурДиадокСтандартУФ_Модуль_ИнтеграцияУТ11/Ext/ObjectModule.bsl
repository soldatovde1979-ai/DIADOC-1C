//  СправочникСсылка.СоглашенияСПоставщиками, Неопределено - соглашение по умолчанию.
//
Функция СоглашениеСПоставщикомПоУмолчанию(Партнер)
	
	Результат = Неопределено;
	
	ДопПараметры = ДополнительныеПараметрыОтбораСоглашений();
	ДопПараметры.УчитыватьГруппыСкладов = Истина;
	ДопПараметры.ИсключитьГруппыСкладовДоступныеВЗаказах = Истина;
	
	УсловияЗакупок = ЗакупкиСервер.ПолучитьУсловияЗакупокПоУмолчанию(Партнер, ДопПараметры);
	
	Если ЗначениеЗаполнено(УсловияЗакупок) Тогда
		Результат = УсловияЗакупок.Соглашение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

