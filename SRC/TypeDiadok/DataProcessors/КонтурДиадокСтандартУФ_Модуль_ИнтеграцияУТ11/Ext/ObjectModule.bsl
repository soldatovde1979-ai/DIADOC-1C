#Область СлужебныйПрограммныйИнтерфейс

// Вызывается из Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента
//
// Параметры:
//  ТребуемыеРеквизиты	 - Структура	 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение.
//  СсылкаНаОбъект		 - ЛюбаяСсылка	 - ссылка на объект, описание которого надо получить.
//
Процедура ПриПолученииОписанияПрикладногоДокумента(ТребуемыеРеквизиты, СсылкаНаОбъект) Экспорт
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ПсевдонимОсновнойТаблицы = "";
	
	Если МетаданныеОбъекта = Метаданные.Документы.КорректировкаРеализации Тогда
		
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_КРТУ_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_КРТУ_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		
	ИначеЕсли МетаданныеОбъекта = Метаданные.Документы.СчетФактураВыданный Тогда
		
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_СчетФактура_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_СчетФактура_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		
	ИначеЕсли МетаданныеОбъекта = Метаданные.Документы.СчетФактураВыданныйАванс Тогда
		
		ТребуемыеРеквизиты.ЭтоИсправление = ТекстЗапроса_СчетФактура_ЭтоИсправление(ПсевдонимОсновнойТаблицы);
		ТребуемыеРеквизиты.ЭтоКорректировка = ТекстЗапроса_СчетФактураАванс_ЭтоКорректировка(ПсевдонимОсновнойТаблицы);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидДокументаИнформационнойБазы
//
// Параметры:
//  ВидДокумента	 - Строка - (возвращаемый параметр) вид документа с точки зрения ЭДО (см. ВидыЭлектронныхДокументов);
//  СсылкаНаОбъект	 - ЛюбаяСсылка - объект информационной базы, вид которого необходимо определить;
//  ЭтоКорректировка - Булево - Истина, если объект отражает операцию корректировки;
//
Процедура ОпределитьВидДокумента(ВидДокумента, СсылкаНаОбъект, ЭтоКорректировка) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	МетаданныеДокументов = Метаданные.Документы;
	
	ЭтоСФ = ЭтоСчетФактура(МетаданныеОбъекта);
	
	Если ЭтоСФ И Не ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.СчетФактура;
		
	ИначеЕсли ЭтоСФ И ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.КорректировочныйСчетФактура;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.РеализацияТоваровУслуг 
		Или (МетаданныеОбъекта = МетаданныеДокументов.КорректировкаРеализации И Не ЭтоКорректировка) Тогда
		
		ТолькоУслуги = ДокументРеализацииСодержитТолькоУслуги(СсылкаНаОбъект);
		
		Если ТолькоУслуги Тогда
			ВидДокумента = ВидыЭД.АктОбОказанииУслуг;
		Иначе
			ВидДокумента = ВидыЭД.ТоварнаяНакладная;
		КонецЕсли;
		
	ИначеЕсли МетаданныеОбъекта = МетаданныеДокументов.КорректировкаРеализации И ЭтоКорректировка Тогда
		
		ВидДокумента = ВидыЭД.СоглашениеОбИзмененииСтоимости;
		
	Иначе
		
		СоответствиеМетаданных = Новый Соответствие;
		СоответствиеМетаданных.Вставить(МетаданныеДокументаСверкаВзаиморасчетов(), ВидыЭД.АктСверки);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.СчетНаОплатуКлиенту, ВидыЭД.СчетНаОплату);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.АктВыполненныхРабот, ВидыЭД.АктОбОказанииУслуг);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.РеализацияУслугПрочихАктивов, ВидыЭД.АктОбОказанииУслуг);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ВозвратТоваровПоставщику, ВидыЭД.ТоварнаяНакладная);
		СоответствиеМетаданных.Вставить(МетаданныеДокументов.ОтчетКомитенту, ВидыЭД.АктОбОказанииУслуг);
		
		Если ИспользуетсяОтчетДавальцу() Тогда
			СоответствиеМетаданных.Вставить(МетаданныеДокументов.ОтчетДавальцу, ВидыЭД.ТоварнаяНакладная);
		КонецЕсли;
		
		ВидДокумента = СоответствиеМетаданных.Получить(МетаданныеОбъекта);
		
	КонецЕсли;
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДатаНомерДокумента
//
// Параметры:
//  Результат		 	- Структура - (возвращаемый параметр) сведения о дате и номере документа;
//  ОписаниеДокумента	- Структура - параметры объекта ИБ (см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента);
//  ЦифровойИндексОП 	- Число 	- цифровой индекс обособленного подразделения;
//
Процедура ЗаполнитьСведенияОДатеИНомереДокумента(Результат, ОписаниеДокумента, ЦифровойИндексОП) Экспорт

	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;

	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Номер");
	ТребуемыеРеквизиты.Вставить("Дата");
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	
	УчитыватьИсправлениеДокумента = ЭтоИсправление;
	
	ЕстьПредставлениеНомера = ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеНомера", СсылкаНаОбъект.Метаданные());
	Если ЕстьПредставлениеНомера Тогда
		ТребуемыеРеквизиты.Вставить("ПредставлениеНомера");
	КонецЕсли;
	
	Если ТипСсылки = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		// Переопределить дату и номер документа
		ТребуемыеРеквизиты.Номер = "ДокументОснование.Номер";
		ТребуемыеРеквизиты.Дата	 = "ДокументОснование.Дата";
		
		УчитыватьИсправлениеДокумента = Ложь; // У КРТУ нет соответствующих реквизитов
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный")
		Или ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		
		Если ЭтоИсправление Тогда
			
			// Переопределить дату и номер
			ТребуемыеРеквизиты.Номер = "ЕСТЬNULL(СчетФактураОснование.Номер, ""--"")";
			ТребуемыеРеквизиты.Дата	 = "ЕСТЬNULL(СчетФактураОснование.Дата, ДАТАВРЕМЯ(1, 1, 1))";
			
			// Добавить реквизиты исправления
			ТребуемыеРеквизиты.Вставить("НомерИсправления");
			ТребуемыеРеквизиты.Вставить("ДатаИсправления", "Дата");
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, ТребуемыеРеквизиты);
	
	Результат.ДатаДокумента = ЗначенияРеквизитов.Дата;
	
	Если ЕстьПредставлениеНомера Тогда
		Результат.НомерДокумента = ЗначенияРеквизитов.ПредставлениеНомера;
	Иначе
		Результат.НомерДокумента = ПредставлениеНомера(ЗначенияРеквизитов.Номер);
	КонецЕсли;
	
	Если УчитыватьИсправлениеДокумента Тогда
		Результат.НомерИсправления	 = Формат(ЗначенияРеквизитов.НомерИсправления, "ЧГ=0");
		Результат.ДатаИсправления	 = ЗначенияРеквизитов.ДатаИсправления;
	КонецЕсли;

	ДополнитьНомерЦифровымИндексомОП(Результат, ЦифровойИндексОП, СсылкаНаОбъект);

КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку820
//
// Параметры:
//  ДокументыОбОтгрузке	- Массив - (возвращаемый параметр) Массив элементов "Новый_DocumentShipment";
//  СсылкаНаОбъект		- ДокументСсылка.СчетФактураВыданный - СФ для которой определяем реквизиты документов отгрузки.
//
Процедура ПриПолученииДанныхДокументовОбОтгрузке(Результат, СсылкаНаОбъект, СтандартнаяОбработка) Экспорт

КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДатаНомерДокумента
//
// Параметры:
//  Результат		 	- Структура - (возвращаемый параметр) сведения о дате и номере документа;
//  ОписаниеДокумента	- Структура - параметры объекта ИБ (см. Модуль_ИнтеграцияУниверсальный.ОписаниеПрикладногоДокумента);
//  ЦифровойИндексОП 	- Число 	- цифровой индекс обособленного подразделения;
//
Процедура ЗаполнитьСведенияОДатеИНомереКорректировочногоДокумента(Результат, ОписаниеДокумента, ЦифровойИндексОП) Экспорт

	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	ЭтоИсправление = ОписаниеДокумента.ЭтоИсправление;

	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	
	ЕстьПредставлениеНомера = ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеНомера", СсылкаНаОбъект.Метаданные());
	
	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("НомерДокумента", "Номер");
	РеквизитыДокумента.Вставить("ДатаДокумента"	, "Дата");
	
	Если ТипСсылки = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		РеквизитыДокумента.Вставить("НомерИсходногоДокумента", "ДокументОснование.Номер");
		РеквизитыДокумента.Вставить("ДатаИсходногоДокумента", "ДокументОснование.Дата");
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыДокумента);
		ЗаполнитьЗначенияСвойств(Результат, ЗначенияРеквизитов);
		
		ОписаниеРеквизитов = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ДатаНомерДокументаОснования");
		ОписаниеРеквизитов.НомерИсходногоДокумента	 = ПредставлениеНомера(ЗначенияРеквизитов.НомерИсходногоДокумента);
		ОписаниеРеквизитов.ДатаИсходногоДокумента	 = ЗначенияРеквизитов.ДатаИсходногоДокумента;
		Результат.ДатаНомерДокументовОснований.Добавить(ОписаниеРеквизитов);
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Если ЭтоИсправление Тогда
			РеквизитыДокумента.Вставить("НомерДокумента", "СчетФактураОснование.Номер");
			РеквизитыДокумента.Вставить("ДатаДокумента"	, "СчетФактураОснование.Дата");
			РеквизитыДокумента.Вставить("НомерИсправления", "НомерИсправления");
			РеквизитыДокумента.Вставить("ДатаИсправления", "Дата");
		КонецЕсли;
		
		Если ЕстьПредставлениеНомера Тогда
			РеквизитыДокумента.Вставить("ПредставлениеНомера", "ПредставлениеНомера");
		КонецЕсли;
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыДокумента);
		ЗаполнитьЗначенияСвойств(Результат, ЗначенияРеквизитов);
		
		ДатаНомерДокументовОснований = РеквизитыКорректировочногоСчетаФактуры(СсылкаНаОбъект);
		Результат.ДатаНомерДокументовОснований = ДатаНомерДокументовОснований;
		
	Иначе
		
		ШаблонОшибки = "Не удалось получить реквизиты корректировочного документа %1!
		|Тип документа не поддерживается (%2)";
		
		ТекстОшибки = СтрШаблон(ШаблонОшибки, Строка(СсылкаНаОбъект), ТипСсылки);
		
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаЗагрузка()
			, УровеньЖурналаРегистрации.Ошибка
			, СсылкаНаОбъект.Метаданные()
			, СсылкаНаОбъект
			, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Если ЕстьПредставлениеНомера Тогда
		Результат.НомерДокумента = ЗначенияРеквизитов.ПредставлениеНомера;
	Иначе
		Результат.НомерДокумента = ПредставлениеНомера(ЗначенияРеквизитов.НомерДокумента);
	КонецЕсли;
	
	Результат.НомерДокумента	 = ?(ЗначениеЗаполнено(Результат.НомерДокумента)	, Результат.НомерДокумента		, "--");
	Результат.ДатаДокумента		 = ?(ЗначениеЗаполнено(Результат.ДатаДокумента)		, Результат.ДатаДокумента		, "--");
	
	Если ЭтоИсправление Тогда
		Результат.НомерИсправления	 =  Формат(Результат.НомерИсправления, "ЧГ=0");
		Результат.НомерИсправления	 = ?(ЗначениеЗаполнено(Результат.НомерИсправления)	, Результат.НомерИсправления, "--");
		Результат.ДатаИсправления	 = ?(ЗначениеЗаполнено(Результат.ДатаИсправления)	, Результат.ДатаИсправления, "--");
	Иначе
		Результат.НомерИсправления	 = "";
		Результат.ДатаИсправления	 = "";
	КонецЕсли;
	
	ДополнитьНомерЦифровымИндексомОП(Результат, ЦифровойИндексОП, СсылкаНаОбъект);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеШапки
//
// Параметры:
//  Реквизиты			 - Структура		 - коллекция описаний полей запроса: ключ - имя поля, значение - выражение.
//  МетаданныеИсточника	 - ОбъектМетаданных	 - Метаданные документа-источника
//
Процедура ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеИсточника) Экспорт
	
	Реквизиты.Вставить("НалогообложениеНДС");
	
	Реквизиты.ВалютаДокумента			 = "Валюта";
	Реквизиты.ВалютаДокументаКод		 = "ВалютаКод";
	Реквизиты.КурсДокумента				 = "Курс";
	Реквизиты.КратностьДокумента		 = "Кратность";
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "Курс") Тогда 
		Реквизиты.КурсДокумента		 = "1";
		Реквизиты.КратностьДокумента = "1";
	КонецЕсли;
	
	Если Не ЕстьРеквизитМетаданных(МетаданныеИсточника, "БанковскийСчетОрганизации") И ЕстьРеквизитМетаданных(МетаданныеИсточника, "БанковскийСчет") Тогда 
		Реквизиты.БанковскийСчетОрганизации = "БанковскийСчет";
	КонецЕсли;
	
	Если ЕстьРеквизитМетаданных(МетаданныеИсточника, "ЦенаВключаетНДС") Тогда 
		Реквизиты.ЦенаВключаетНДС = "ЦенаВключаетНДС";
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеИсточника, "СуммаВключаетНДС") Тогда 
		Реквизиты.ЦенаВключаетНДС = "СуммаВключаетНДС";
	Иначе 
		Реквизиты.ЦенаВключаетНДС = "ЛОЖЬ";
	КонецЕсли;
	
	#Область ОбособленныеПодразделения
	
	Реквизиты.Вставить("Подразделение"); // Временное поле, требуется для определения ОП, невыделенного на отдельный баланс.
	
	Если НРег(МетаданныеИсточника.Имя) = НРег("СчетФактураВыданный") Тогда
		
		Реквизиты.Подразделение = "НЕОПРЕДЕЛЕНО";
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеИсточника, "Склад") Тогда
		
		Реквизиты.Подразделение =
		"ВЫБОР
		|	КОГДА Склад.Подразделение ЕСТЬ NULL ИЛИ Склад.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|		ТОГДА Подразделение
		|	ИНАЧЕ Склад.Подразделение
		|КОНЕЦ";
		
	КонецЕсли;
	
	#КонецОбласти
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ДанныеШапки
// после формирования структуры шапки документа.
//
// Параметры:
//  ЗначенияРеквизитов - Структура - Структура со значениями реквизита документа
//
Процедура ПослеПолученияДанныхШапкиДокумента(ДанныеШапки) Экспорт
	
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	
	Если ЭтоСчетФактура(СсылкаНаОбъект) Тогда
		ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеШапки);
	КонецЕсли;
	
	Если ЭтоСчетФактураКомиссионеру(СсылкаНаОбъект)
		ИЛИ ЭтоСчетФактураНаРеализациюЧерезКомиссионера(СсылкаНаОбъект)
		ИЛИ ЭтоСчетФактураНаРеализациюЧерезКомиссионера_25(СсылкаНаОбъект) Тогда
		ДополнитьШапкуСчетаФактурыКомиссионеру(ДанныеШапки);
	КонецЕсли;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		ДополнитьШапкуСчетаНаОплатуПоДокументуОснованию(ДанныеШапки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.НалогообложениеНДС)
		И ДанныеШапки.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя")
		Тогда
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом = Истина;
	Иначе
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетОрганизации) Тогда
		ДанныеШапки.БанковскийСчетОрганизации = ПолучитьБанковскийСчет(СсылкаНаОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетКонтрагента) Тогда
		ДанныеШапки.БанковскийСчетКонтрагента = ПолучитьБанковскийСчетПокупателя(СсылкаНаОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетГрузоотправителя) Тогда
		ДанныеШапки.БанковскийСчетГрузоотправителя = ПолучитьБанковскийСчетГрузоотправителя(СсылкаНаОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеШапки.БанковскийСчетГрузополучателя) Тогда
		ДанныеШапки.БанковскийСчетГрузополучателя = ПолучитьБанковскийСчетГрузополучателя(СсылкаНаОбъект);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеШапки.НазначениеПлатежа) Тогда
		НомерОбъекта = ПредставлениеНомера(ОписаниеДокумента.Номер);
		ДанныеШапки.НазначениеПлатежа = Документы.СчетНаОплатуКлиенту.СформироватьНазначениеПлатежа(НомерОбъекта, СсылкаНаОбъект);
	КонецЕсли;
	
	#Область ОбособленныеПодразделения
	
	РегистрацияПодразделения = РегистрацияПодразделенияВНалоговомОргане(ДанныеШапки.Подразделение, ДанныеШапки.Организация, ОписаниеДокумента.Дата);
	
	Если ЗначениеЗаполнено(РегистрацияПодразделения) Тогда
		ДанныеШапки.ОбособленноеПодразделение = РегистрацияПодразделения;
	ИначеЕсли ЭтоОбособленноеПодразделение(ДанныеШапки.Организация) Тогда
		ДанныеШапки.ОбособленноеПодразделение = ДанныеШапки.Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ОбособленноеПодразделение) Тогда
		
		ДанныеШапки.ЦифровойИндексОбособленногоПодразделения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.ОбособленноеПодразделение, "ЦифровойИндексОбособленногоПодразделения");
		
		Если НЕ ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
			// При отгрузке от ОП грузоотправитель должен быть указан всегда (нельзя писать "он же")
			ДанныеШапки.Грузоотправитель = ДанныеШапки.ОбособленноеПодразделение;
		КонецЕсли;
		
	КонецЕсли;
	
	#КонецОбласти
	
	АктуализироватьРасчетыСКонтрагентами(ДанныеШапки);
	
КонецПроцедуры

