Функция ПолучитьТекстЗапросаДляСпискаТоваровСГТД(ДокументСсылка, КолонкаКодаТовара)
	
	Если ИспользуетсяРегистрационныйНомерТД() Тогда
		НомерГТДПредставление = "РеализацияТоваровУслугВидыЗапасов.НомерГТД.РегистрационныйНомер";
	Иначе
		НомерГТДПредставление = "РеализацияТоваровУслугВидыЗапасов.НомерГТД.Код";
	КонецЕсли;
	
	ЭтоНакладная = ЭтоНакладная(ДокументСсылка);
	
	Если Не ИспользуетсяАналитикаУчетаНоменклатуры() Тогда
		
		Результат = 
			"ВЫБРАТЬ
			|	РеализацияТоваровУслугВидыЗапасов.НомерСтроки,
			|	РеализацияТоваровУслугВидыЗапасов.Номенклатура КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА ПОДСТРОКА(РеализацияТоваровУслугВидыЗапасов.Номенклатура.НаименованиеПолное, 1, 10) = """"
			|			ТОГДА РеализацияТоваровУслугВидыЗапасов.Номенклатура.Наименование
			|		ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.Номенклатура.НаименованиеПолное
			|	КОНЕЦ КАК НоменклатураПредставление,
			|	РеализацияТоваровУслугВидыЗапасов.Характеристика,
			|	РеализацияТоваровУслугВидыЗапасов.Серия КАК Серия,
			|  	РеализацияТоваровУслугВидыЗапасов.Номенклатура." + КолонкаКодаТовара + ",
			|	РеализацияТоваровУслугВидыЗапасов.Количество,
			|	%ТекстЗапросаКоличествоПоРНПТ% КАК КоличествоПоРНПТ,
			|   ВЫБОР
			|		КОГДА РеализацияТоваровУслугВидыЗапасов.Количество = 0
			|       	ТОГДА 0
			|		ИНАЧЕ
			|			ВЫБОР
			|				КОГДА РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС
			|					ТОГДА РеализацияТоваровУслугВидыЗапасов.СуммаСНДС
			|				ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.СуммаСНДС - РеализацияТоваровУслугВидыЗапасов.СуммаНДС
			|			КОНЕЦ / РеализацияТоваровУслугВидыЗапасов.Количество
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС
			|			ТОГДА РеализацияТоваровУслугВидыЗапасов.СуммаСНДС
			|		ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.СуммаСНДС - РеализацияТоваровУслугВидыЗапасов.СуммаНДС
			|	КОНЕЦ,
			|	РеализацияТоваровУслугВидыЗапасов.СтавкаНДС,
			|	РеализацияТоваровУслугВидыЗапасов.СуммаНДС,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД.СтранаПроисхождения,
			|	" + НомерГТДПредставление + " Как НомерГТДПредставление,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД.Код КАК НомерГТДРегистрационныйНомер,
			|	РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС КАК СуммаВключаетНДС,
			|	РеализацияТоваровУслугВидыЗапасов.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			|	&ПолеУпаковка КАК Упаковка,
			|	РеализацияТоваровУслугВидыЗапасов.Номенклатура.ЕдиницаИзмерения.Код КАК КодЕдиницыИзмерения,
			| " + ТекстЗапроса_ЕдиницаИзмеренияПрослеживаемости("РеализацияТоваровУслугВидыЗапасов", "ЕдиницаИзмеренияПрослеживаемости") + ",
			|	РеализацияТоваровУслугВидыЗапасов.Упаковка.ЕдиницаИзмерения КАК ВидУпаковки,
			|	" + ПолучитьТекстЗапроса_КоэффициентУпаковки("РеализацияТоваровУслугВидыЗапасов") + "
			|	РеализацияТоваровУслугВидыЗапасов.КоличествоУпаковок,
			|	ЛОЖЬ,
			|	0, 0,
			|	0, // Брутто
			| " + ТекстЗапроса_ПрослеживаемыйТовар("РеализацияТоваровУслугВидыЗапасов", "ПрослеживаемыйТовар") + ",
			|	1,
			|	""Property"",
			|	&ТекстЗапросаСуммаСкидок
			|ИЗ
			|	Документ.РеализацияТоваровУслуг.ВидыЗапасов КАК РеализацияТоваровУслугВидыЗапасов
			|ГДЕ
			|	РеализацияТоваровУслугВидыЗапасов.Ссылка = &Ссылка
			|	И &ТекстЗапросаОтборНаМногооборотнуюТару";
		
		Если ЭтоНакладная Тогда
			ТекстЗапросаОтборНаМногооборотнуюТару = ТекстЗапроса_ОтборНаМногооборотнуюТару("РеализацияТоваровУслугВидыЗапасов.Ссылка", "РеализацияТоваровУслугВидыЗапасов.Номенклатура");
		Иначе
			ТекстЗапросаОтборНаМногооборотнуюТару = "Истина";
		КонецЕсли;
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаОтборНаМногооборотнуюТару"	, ТекстЗапросаОтборНаМногооборотнуюТару);
		
	Иначе
		
		Результат = 
			"ВЫБРАТЬ
			|	МИНИМУМ(РеализацияТоваровУслугВидыЗапасов.НомерСтроки),
			|	Аналитика.Номенклатура КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА ПОДСТРОКА(Аналитика.Номенклатура.НаименованиеПолное, 1, 10) = """"
			|			ТОГДА Аналитика.Номенклатура.Наименование
			|		ИНАЧЕ Аналитика.Номенклатура.НаименованиеПолное
			|	КОНЕЦ КАК НоменклатураПредставление,
			|	Аналитика.Характеристика,
			|	Аналитика.Серия КАК Серия,
			|	Аналитика.Номенклатура." + КолонкаКодаТовара + ",
			|	СУММА(&ТекстЗапросаКоличество),
			|	СУММА(%ТекстЗапросаКоличествоПоРНПТ%),
			|	&ПолеЦена КАК Цена,
			| 	СУММА(&ТекстЗапросаСумма),
			|	РеализацияТоваровУслугВидыЗапасов.СтавкаНДС,
			|	СУММА(&ТекстЗапросаСуммаНДС),
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД.СтранаПроисхождения,
			|	" + НомерГТДПредставление + " Как НомерГТДПредставление,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД.Код КАК НомерГТДРегистрационныйНомер,
			|	РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС,
			| " + ТекстЗапроса_РеквизитыЕдиницыИзмерения("Ссылка") + " КАК ЕдиницаИзмерения,
			|	&ПолеУпаковка КАК Упаковка,
			| " + ТекстЗапроса_РеквизитыЕдиницыИзмерения("Код") + " КАК КодЕдиницыИзмерения,
			| " + ТекстЗапроса_ЕдиницаИзмеренияПрослеживаемости("Аналитика") + " КАК ЕдиницаИзмеренияПрослеживаемости,
			|	РеализацияТоваровУслугВидыЗапасов.Упаковка.ЕдиницаИзмерения КАК ВидУпаковки,
			|	" + ПолучитьТекстЗапроса_КоэффициентУпаковки("РеализацияТоваровУслугВидыЗапасов") + "
			|	СУММА(РеализацияТоваровУслугВидыЗапасов.КоличествоУпаковок),
			|	ЛОЖЬ,
			|   СУММА(ВЫБОР КОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка.Вес есть NULL 
			|                 ТОГДА  РеализацияТоваровУслугВидыЗапасов.Количество * " + ПолучитьТекстЗапроса_НоменклатураВес("Аналитика") + "
			|                 Иначе РеализацияТоваровУслугВидыЗапасов.КоличествоУпаковок *   РеализацияТоваровУслугВидыЗапасов.Упаковка.Вес 
			|         КОНЕЦ),
			//|   СУММА(РеализацияТоваровУслугВидыЗапасов.Количество *  " + ПолучитьТекстЗапроса_НоменклатураВес("Аналитика") + "), 
			|   СУММА(РеализацияТоваровУслугВидыЗапасов.Количество * &ТекстЗапросаВесНоменклатуры),
			|   &ТекстЗапросаМассаБруттоГТД, // Брутто
			| " + ТекстЗапроса_ПрослеживаемыйТовар("Аналитика", "ПрослеживаемыйТовар") + ",
			|	1,
			|	""Property"",
			|	СУММА(&ТекстЗапросаСуммаСкидок)
			|ИЗ
			|	Документ.РеализацияТоваровУслуг.ВидыЗапасов КАК РеализацияТоваровУслугВидыЗапасов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК Аналитика
			|		ПО РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры = Аналитика.Ссылка
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыВВалютеУчета
			|			ПО  СуммыВВалютеУчета.Регистратор  = &Ссылка 
			|				и РеализацияТоваровУслугВидыЗапасов.ИдентификаторСтроки = СуммыВВалютеУчета.ИдентификаторСтроки
			|			И (СуммыВВалютеУчета.Активность)
			|				И (&ПересчитыватьВВалютуРегл)
			|ГДЕ
			|	РеализацияТоваровУслугВидыЗапасов.Ссылка = &Ссылка
			|	И &ТекстЗапросаОтборНаМногооборотнуюТару
			|
			|СГРУППИРОВАТЬ ПО
			|	Аналитика.Номенклатура,
			|	Аналитика.Характеристика,
			|	Аналитика.Серия,
			|	Аналитика.Номенклатура." + КолонкаКодаТовара + ",
			|	РеализацияТоваровУслугВидыЗапасов.СтавкаНДС,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД.СтранаПроисхождения,
			|	РеализацияТоваровУслугВидыЗапасов.НомерГТД.Код,
			|	" + НомерГТДПредставление + ",
			|	РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС,
			|	РеализацияТоваровУслугВидыЗапасов.Упаковка.ЕдиницаИзмерения,
			|	РеализацияТоваровУслугВидыЗапасов.Упаковка,
			|	&ПолеЦена,
			|	" + СтрЗаменить(ПолучитьТекстЗапроса_КоэффициентУпаковки("РеализацияТоваровУслугВидыЗапасов"), "КАК КоличествоВОдномМесте", "") + "
			|	ВЫБОР
			|		КОГДА ПОДСТРОКА(Аналитика.Номенклатура.НаименованиеПолное, 1, 10) = """"
			|			ТОГДА Аналитика.Номенклатура.Наименование
			|		ИНАЧЕ Аналитика.Номенклатура.НаименованиеПолное
			|	КОНЕЦ,
			| " + ТекстЗапроса_РеквизитыЕдиницыИзмерения("Ссылка") + ",
			| " + ТекстЗапроса_ЕдиницаИзмеренияПрослеживаемости("Аналитика") + ",
			| " + ТекстЗапроса_ПрослеживаемыйТовар("Аналитика") + ",
			| " + ТекстЗапроса_РеквизитыЕдиницыИзмерения("Код");
		
		ТекстЗапросаСуммаНДС = 
		"ЕСТЬNULL(СуммыВВалютеУчета.СуммаНДСРегл, РеализацияТоваровУслугВидыЗапасов.СуммаНДС)";
		
		ТекстЗапросаСумма = 
		"ВЫБОР
		|	КОГДА СуммыВВалютеУчета.СуммаБезНДСРегл ЕСТЬ NULL
		|		ТОГДА ВЫБОР
		|				КОГДА РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС
		|					ТОГДА РеализацияТоваровУслугВидыЗапасов.СуммаСНДС
		|				ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.СуммаСНДС - РеализацияТоваровУслугВидыЗапасов.СуммаНДС
		|			КОНЕЦ
		|	ИНАЧЕ ВЫБОР
		|			КОГДА РеализацияТоваровУслугВидыЗапасов.Ссылка.ЦенаВключаетНДС
		|				ТОГДА СуммыВВалютеУчета.СуммаБезНДСРегл + СуммыВВалютеУчета.СуммаНДСРегл
		|			ИНАЧЕ СуммыВВалютеУчета.СуммаБезНДСРегл
		|		КОНЕЦ
		|КОНЕЦ";
		
		Если (Метаданные.Имя = "УправлениеТорговлей" И МетодСервера(, "СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "11.2") < 0)
				Или (Метаданные.Имя = "УправлениеПредприятием" И МетодСервера(, "СравнитьВерсии", ПараметрыКлиентСервер.ВерсияКонфигурации, "2.1") < 0) Тогда
			ТекстЗапросаМассаБруттоГТД = "
			|		СУММА(ВЫБОР
			|				КОГДА &ЗаполненаЕдиницаИзмеренияВеса
			|					ТОГДА ВЫБОР
			|							КОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка.Вес ЕСТЬ NULL 
			|								ТОГДА РеализацияТоваровУслугВидыЗапасов.Количество * Аналитика.Номенклатура.Вес
			|							ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.КоличествоУпаковок * РеализацияТоваровУслугВидыЗапасов.Упаковка.Вес
			|						КОНЕЦ
			|				ИНАЧЕ 0
			|			КОНЕЦ)";
			
			ТекстЗапросаВесНоменклатуры = "Аналитика.Номенклатура.Вес";
		Иначе
			
			ТекстЗапросаМассаБруттоГТД = "
			|   СУММА(ВЫБОР
			|			КОГДА &ЗаполненаЕдиницаИзмеренияВеса
			|				ТОГДА ВЫБОР
			|						КОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка.Вес ЕСТЬ NULL 
			|							ТОГДА РеализацияТоваровУслугВидыЗапасов.Количество
			|						ИНАЧЕ ВЫБОР 
			|							КОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка.ТипИзмеряемойВеличины = Значение(Перечисление.ТипыИзмеряемыхВеличин.Вес)
			|								ТОГДА 0
			|							ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.КоличествоУпаковок
			|						КОНЕЦ
			|					КОНЕЦ * " + ТекстЗапросаВесУпаковки("РеализацияТоваровУслугВидыЗапасов.Упаковка", "Аналитика.Номенклатура") + "
			|			ИНАЧЕ 0
			|		КОНЕЦ)";
			
			ТекстЗапросаВесНоменклатуры = ТекстЗапросаВесУпаковки("Аналитика.Номенклатура.ЕдиницаИзмерения", "Аналитика.Номенклатура");
			
		КонецЕсли;
		
		Если ДокументСсылка.Метаданные().ТабличныеЧасти.Найти("ВидыЗапасов").Реквизиты.Найти("СуммаРучнойСкидки") = Неопределено Тогда
			ТекстЗапросаСуммаСкидок = "0";
		Иначе
			ТекстЗапросаСуммаСкидок = "РеализацияТоваровУслугВидыЗапасов.СуммаРучнойСкидки + РеализацияТоваровУслугВидыЗапасов.СуммаАвтоматическойСкидки"
		КонецЕсли;
		
		Если ЭтоНакладная Тогда
			ТекстЗапросаОтборНаМногооборотнуюТару = ТекстЗапроса_ОтборНаМногооборотнуюТару("РеализацияТоваровУслугВидыЗапасов.Ссылка", "Аналитика.Номенклатура");
		Иначе
			ТекстЗапросаОтборНаМногооборотнуюТару = "Истина";
		КонецЕсли;
		
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаКоличество"		, ТекстЗапроса_Количество("РеализацияТоваровУслугВидыЗапасов"));
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаСуммаНДС"			, ТекстЗапросаСуммаНДС);
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаСуммаСкидок"		, ТекстЗапросаСуммаСкидок);
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаСумма"				, ТекстЗапросаСумма);
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаМассаБруттоГТД"	, ТекстЗапросаМассаБруттоГТД);
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаВесНоменклатуры"	, ТекстЗапросаВесНоменклатуры);
		Результат = СтрЗаменить(Результат, "&ТекстЗапросаОтборНаМногооборотнуюТару"	, ТекстЗапросаОтборНаМногооборотнуюТару);
		
	КонецЕсли;
	
	ЕстьРеквизитКоличествоПоРНПТ = МетодСервера( , "СуществуетОбъектМетаданных", "Документ.РеализацияТоваровУслуг.ТабличнаяЧасть.ВидыЗапасов.Реквизит.КоличествоПоРНПТ");
	Если ЕстьРеквизитКоличествоПоРНПТ Тогда
		Если МетодСервера( , "СуществуетОбъектМетаданных", "ФункциональнаяОпция.ИспользуетсяУчетВЕдиницеИзмеренияТНВЭД")
			И НЕ ПолучитьФункциональнуюОпцию("ИспользуетсяУчетВЕдиницеИзмеренияТНВЭД") Тогда
			ТекстЗапросаКоличествоПоРНПТ = "РеализацияТоваровУслугВидыЗапасов.Количество";
		Иначе
			ТекстЗапросаКоличествоПоРНПТ = "РеализацияТоваровУслугВидыЗапасов.КоличествоПоРНПТ";
		КонецЕсли; 
	Иначе
		ТекстЗапросаКоличествоПоРНПТ = "0";
	КонецЕсли;
	
	ПсевдонимТаблицы = "РеализацияТоваровУслугВидыЗапасов";
	Результат = СтрЗаменить(Результат, "&ПолеЦена", ВыражениеЦена(ПсевдонимТаблицы));
	Результат = СтрЗаменить(Результат, "&ПолеУпаковка", ВыражениеУпаковка(ПсевдонимТаблицы));
	Результат = СтрЗаменить(Результат, "%ТекстЗапросаКоличествоПоРНПТ%"	, ТекстЗапросаКоличествоПоРНПТ);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_РеквизитыЕдиницыИзмерения(ИмяРеквизита)
	
	Текст =
	"ВЫБОР
	|	КОГДА &ВесВБазовыхЕИ ИЛИ (РеализацияТоваровУслугВидыЗапасов.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиНоменклатуры.ПустаяСсылка))
	|		ТОГДА Аналитика.Номенклатура.ЕдиницаИзмерения#ИмяРеквизита 
	|	КОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|		ТОГДА РеализацияТоваровУслугВидыЗапасов.Упаковка.ЕдиницаИзмерения#ИмяРеквизита
	|	ИНАЧЕ РеализацияТоваровУслугВидыЗапасов.Упаковка#ИмяРеквизита
	|КОНЕЦ";
	
	Если ИмяРеквизита = "Ссылка" Тогда
		Текст = СтрЗаменить(Текст, "#ИмяРеквизита", "");
	Иначе
		Текст = СтрЗаменить(Текст, "#ИмяРеквизита", "." + ИмяРеквизита);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

//Возвращает текст отбора на переданную табличную часть.
//Отбор исключает товары с видом Тара и  если в документе стоит признак ВернутьМногооборотнуюТару
//
//Параметры
//  ИмяПоляСсылка		 - Строка - имя поля с сылкой на РТУ
//  ИмяПоляНоменклатура	 - Строка - имя поля с сылкой на Номенклатуру
//	
//Возвращаемое значение:
// Строка - отбор для табличной части
//
Функция ТекстЗапроса_ОтборНаМногооборотнуюТару(ИмяПоляСсылка, ИмяПоляНоменклатура)
	
	Результат = "Истина";
	
	ИспользоватьМногооборотнуюТару = 
		МетодСервера(, "СуществуетОбъектМетаданных", "ФункциональнаяОпция.ИспользоватьМногооборотнуюТару")
		И ПолучитьФункциональнуюОпцию("ИспользоватьМногооборотнуюТару");
	
	Если ИспользоватьМногооборотнуюТару Тогда
		
		ШаблонЗапроса = 
		"ВЫБОР 
		|	КОГДА ВЫРАЗИТЬ(%1 КАК Документ.РеализацияТоваровУслуг).ВернутьМногооборотнуюТару = Истина 
		|		И ВЫРАЗИТЬ(%2 КАК Справочник.Номенклатура).ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
		|		ТОГДА Ложь 
		|	ИНАЧЕ Истина
		|КОНЕЦ";	
		
		Результат = СтрШаблон(ШаблонЗапроса, ИмяПоляСсылка, ИмяПоляНоменклатура);
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОтборПоУслугамРаботам(ИмяТаблицы = "РеализацияТоваровУслугТовары")
	
	Если Метаданные.Перечисления.ТипыНоменклатуры.ЗначенияПеречисления.Найти("Работа") <> Неопределено Тогда 
		
		ТекстЗапроса = " ( 
		|(РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга))
		| или 
		|(РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
		|)";
		
	Иначе		
		ТекстЗапроса = "(РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга))";	
	КонецЕсли;
	
	Если ИмяТаблицы <> "РеализацияТоваровУслугТовары" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РеализацияТоваровУслугТовары", ИмяТаблицы);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапроса_КоэффициентУпаковки(НаименованиеТаблицы)

	Результат =
	"НаименованиеТаблицы.Упаковка.Числитель /
	|	ВЫБОР 
	|		КОГДА НаименованиеТаблицы.Упаковка.Знаменатель = 0
	|			ТОГДА 1
	|		ИНАЧЕ НаименованиеТаблицы.Упаковка.Знаменатель
	|	КОНЕЦ КАК КоличествоВОдномМесте";
	
	Результат = СтрЗаменить(Результат, "НаименованиеТаблицы", НаименованиеТаблицы);
	Результат = Результат + ",";
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТекстЗапроса_НоменклатураВес(НаименованиеТаблицы)
	
	Если МетодСервера(,"СуществуетОбъектМетаданных", "Справочник.Номенклатура.Реквизит.ВесЗнаменатель") Тогда
		Результат = "НаименованиеТаблицы.Номенклатура.ВесЗнаменатель * НаименованиеТаблицы.Номенклатура.ВесЧислитель";
	Иначе
		Результат = "НаименованиеТаблицы.Номенклатура.Вес";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "НаименованиеТаблицы", НаименованиеТаблицы);
	
	Возврат Результат;
	
КонецФункции

// Функция - Текст запроса коэффициента упаковки
//
// Параметры:
//  ИсточникУпаковки	 - Строка	 - Таблица с упаковкой. Например, "ВЫРАЗИТЬ(&Упаковка КАК Справочник.УпаковкаЕдиницаИзмерения)"
//  ИсточникНоменклатуры - Строка	 - Таблица с номенклатурой. Если этот параметр не заполнен, то ИсточникУпаковки
//  	должен гарантированно ссылаться на упаковку / единицу измерения типа "Упаковка".
//  	Например, "ТаблицаТовары.Номенклатура"
//  ВесУпаковкиВЕдиницеКонстанты	 - 	Булево	- если ЛОЖЬ, то текст запроса вернет вес в кг, иначе - в константе - единице измерения веса . 
// 
// Возвращаемое значение:
//  Строка - строка текста запроса, которая вернет вес либо в единице константы, либо в кг (см. параметр ВесУпаковкиВЕдиницеКонстанты)
//
Функция ТекстЗапросаВесУпаковки(ИсточникУпаковки, ИсточникНоменклатуры, ВесУпаковкиВЕдиницеКонстанты = Истина)
	
	Если ИсточникНоменклатуры = Неопределено Тогда 
		
		ТекстЗапроса = "ВЫРАЗИТЬ((ЕСТЬNULL(ТаблицаТовары.Упаковка.Вес, 0) * (ЕСТЬNULL(ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Числитель, 0) / ЕСТЬNULL(ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Знаменатель,1)) / &КоличествоКгВЕдиницеИзмеренияВеса) КАК Число(15,7))";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫРАЗИТЬ(ВЫБОР
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Вес)
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Числитель / ТаблицаТовары.Упаковка.Знаменатель КАК ЧИСЛО(15, 7))
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Объем)
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Числитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЧислитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ОбъемЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ((ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Числитель / ТаблицаТовары.Упаковка.Знаменатель КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ОбъемЧислитель / ТаблицаТовары.Номенклатура.ОбъемЗнаменатель КАК ЧИСЛО(15, 7))) * (ТаблицаТовары.Номенклатура.ВесЧислитель / ТаблицаТовары.Номенклатура.ВесЗнаменатель) * (ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Площадь)
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ПлощадьЕдиницаИзмерения.Числитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ПлощадьЧислитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ПлощадьЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ((ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Числитель / ТаблицаТовары.Упаковка.Знаменатель КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ПлощадьЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ПлощадьЧислитель / ТаблицаТовары.Номенклатура.ПлощадьЗнаменатель КАК ЧИСЛО(15, 7))) * (ТаблицаТовары.Номенклатура.ВесЧислитель / ТаблицаТовары.Номенклатура.ВесЗнаменатель) * (ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Длина)
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ДлинаЕдиницаИзмерения.Числитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ДлинаЕдиницаИзмерения.Знаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ДлинаЧислитель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ДлинаЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ((ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Числитель / ТаблицаТовары.Упаковка.Знаменатель КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ДлинаЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ДлинаЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ДлинаЧислитель / ТаблицаТовары.Номенклатура.ДлинаЗнаменатель КАК ЧИСЛО(15, 7))) * (ТаблицаТовары.Номенклатура.ВесЧислитель / ТаблицаТовары.Номенклатура.ВесЗнаменатель) * (ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
		|			КОГДА ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
		|					И ЕСТЬNULL(ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ(ТаблицаТовары.Упаковка.Вес * ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Числитель / ТаблицаТовары.Упаковка.ВесЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))
		|			КОГДА (ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
		|					ИЛИ ТаблицаТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.ПустаяСсылка)
		|					ИЛИ ЕСТЬNULL(ТаблицаТовары.Упаковка.Ссылка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
		|					И ТаблицаТовары.Номенклатура.ВесИспользовать
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЗнаменатель, 0) <> 0
		|					И ЕСТЬNULL(ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель, 0) <> 0
		|				ТОГДА ВЫРАЗИТЬ(ТаблицаТовары.Номенклатура.ВесЧислитель / ТаблицаТовары.Номенклатура.ВесЗнаменатель * (ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Числитель / ТаблицаТовары.Номенклатура.ВесЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
		|			ИНАЧЕ 0
		|		КОНЕЦ / (ВЫРАЗИТЬ(&КоличествоКгВЕдиницеИзмеренияВеса КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаТовары.Номенклатура", ИсточникНоменклатуры);
		
	КонецЕсли;
	
	Если ВесУпаковкиВЕдиницеКонстанты Тогда
		ЕдиницаИзмеренияВеса = Константы.ЕдиницаИзмеренияВеса.Получить();
		Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияВеса) Тогда
			ВызватьИсключение НСтр("ru = 'Не задано значение константы ""Единица измерения веса"". Обратитесь к администратору.'");
		КонецЕсли;
		СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмеренияВеса, "Числитель, Знаменатель");
		КоличествоКгВЕдиницеИзмеренияВеса = СтруктураРезультат.Числитель / СтруктураРезультат.Знаменатель;
	Иначе
		КоличествоКгВЕдиницеИзмеренияВеса = 1;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КоличествоКгВЕдиницеИзмеренияВеса", Формат(КоличествоКгВЕдиницеИзмеренияВеса, "ЧРД=.; ЧГ=0"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаТовары.Упаковка", ИсточникУпаковки);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ВыражениеПустаяУпаковка()
	Возврат "ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)";
КонецФункции

Функция ВыражениеУпаковка(ПсевдонимТаблицы = "")
	
	Результат =
	"ВЫБОР
	|	КОГДА &ИспользоватьБазовыеЕИ
	|		ТОГДА ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	ИНАЧЕ ПсевдонимТаблицы.Упаковка
	|КОНЕЦ";
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ВыражениеЦена(ПсевдонимТаблицы)
	
	ТекстЗапроса = "ПсевдонимТаблицы.Цена";
	
	ТекстЗапроса =
	"ВЫБОР
	|	КОГДА &ИспользоватьБазовыеЕИ
	|		ТОГДА ВЫБОР КОГДА ПсевдонимТаблицы.Количество <> 0 ТОГДА (ПсевдонимТаблицы.СуммаСНДС - ПсевдонимТаблицы.СуммаНДС) / ПсевдонимТаблицы.Количество ИНАЧЕ 0 КОНЕЦ
	|	ИНАЧЕ ПсевдонимТаблицы.Цена
	|КОНЕЦ";
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(ТекстЗапроса, ПсевдонимТаблицы);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_Количество(НаименованиеТаблицы)
	
	ТекстЗапроса =
	"ВЫБОР
	|	КОГДА &ВесВБазовыхЕИ
	|		ТОГДА &НаименованиеТаблицы.Количество
	|	ИНАЧЕ &НаименованиеТаблицы.КоличествоУпаковок
	|КОНЕЦ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеТаблицы", НаименованиеТаблицы); 
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ЕдиницаИзмерения(НаименованиеТаблицыС_Упаковкой, НаименованиеТаблицыС_ЕдИзм = Неопределено)
	
	ТекстЗапроса =
	"ВЫБОР
	|	КОГДА &ВесВБазовыхЕИ
	|			ИЛИ &НаименованиеТаблицыС_Упаковкой.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|		ТОГДА &НаименованиеТаблицыС_ЕдИзм.Номенклатура.ЕдиницаИзмерения
	|	КОГДА &НаименованиеТаблицыС_Упаковкой.Упаковка.ЕдиницаИзмерения <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|		ТОГДА &НаименованиеТаблицыС_Упаковкой.Упаковка.ЕдиницаИзмерения
	|	ИНАЧЕ &НаименованиеТаблицыС_Упаковкой.Упаковка
	|КОНЕЦ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеТаблицыС_Упаковкой", НаименованиеТаблицыС_Упаковкой); 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеТаблицыС_ЕдИзм", 
	?(НаименованиеТаблицыС_ЕдИзм = Неопределено, НаименованиеТаблицыС_Упаковкой, НаименованиеТаблицыС_ЕдИзм)); 
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ЕдиницаИзмеренияПрослеживаемости(НаименованиеТаблицыСНоменклатурой = "",  ИмяПоля = "")
	
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Если ИспользуетсяУчетПрослеживаемыхТоваров Тогда
		
		ТекстЗапроса =
			"ЕСТЬNULL(&НаименованиеТаблицыСНоменклатурой.Номенклатура.ЕдиницаИзмеренияТНВЭД, &ПустаяЕИ) &ИмяПоля";
		
	Иначе
		
		ТекстЗапроса =
			"&ПустаяЕИ &ИмяПоля";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеТаблицыСНоменклатурой", НаименованиеТаблицыСНоменклатурой);
	
	Если ЗначениеЗаполнено(ИмяПоля) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", " КАК " + ИмяПоля);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", "");
	КонецЕсли; 
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапроса_ПрослеживаемыйТовар(НаименованиеТаблицыСНоменклатурой, ИмяПоля = "")
	
	ИспользуетсяУчетПрослеживаемыхТоваров = ИспользуетсяУчетПрослеживаемыхТоваров();
	
	Если ИспользуетсяУчетПрослеживаемыхТоваров Тогда
		
		ТекстЗапроса =
			"ВЫБОР
			|		КОГДА &ДатаДокумента >= &ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров
			|			ТОГДА ЕСТЬNULL(&НаименованиеТаблицыСНоменклатурой.Номенклатура.КодТНВЭД.ПрослеживаемыйТовар, Ложь)
			|		ИНАЧЕ Ложь
			|	КОНЕЦ &ИмяПоля";
		
	Иначе
		
		ТекстЗапроса =
			"Ложь &ИмяПоля";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеТаблицыСНоменклатурой", НаименованиеТаблицыСНоменклатурой);
	
	Если ЗначениеЗаполнено(ИмяПоля) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", " КАК " + ИмяПоля);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяПоля", "");
	КонецЕсли; 
	
	Возврат ТекстЗапроса;
	
КонецФункции

