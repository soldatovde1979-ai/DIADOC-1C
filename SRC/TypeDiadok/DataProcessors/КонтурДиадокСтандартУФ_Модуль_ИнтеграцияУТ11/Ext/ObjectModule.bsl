// Вызывается из Модуль_ИнтеграцияУниверсальный.ЗаполнитьОбстФормСЧФ820.
//
// Параметры:
//  СчетФактура			 - ДокументСсылка.СчетФактураВыданный	 - счет фактура на основании которой вычисляется ОбстФормСЧФ;
//
// Возвращаемое значение:
//  Строка - вычисленное значение ОбстФормСЧФ
//
Функция ПолучитьОбстоятельствоФормированияСчетФактуры(СчетФактура) Экспорт
	
	Результат		 = Неопределено;
	
	КонстантаИспользоватьКомиссиюПриПродажах = Ложь;
	Если МетодСервера(, "ЕстьМетаданныеКонфигурации_ДД", "Константы.ИспользоватьКомиссиюПриПродажах") Тогда
		КонстантаИспользоватьКомиссиюПриПродажах = Константы.ИспользоватьКомиссиюПриПродажах.Получить();
	КонецЕсли;
	
	Если КонстантаИспользоватьКомиссиюПриПродажах Тогда
		
		Если ЭтоСчетФактура(СчетФактура) Тогда
			ДокументыОснования = ВсеДокументыОснования(СчетФактура);
		Иначе
			ДокументыОснования = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СчетФактура);
		КонецЕсли;
		
		ОперацияПередачаНаКомиссию = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию");
		
		Для каждого ДокументОснования Из ДокументыОснования Цикл
			ВидОперации = ХозяйственнаяОперацияДокумента(ДокументОснования);
			
			Если ВидОперации = ОперацияПередачаНаКомиссию Тогда
				Результат = "4";
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЕстьОтчетКомитенту = МетодСервера(, "ЕстьМетаданныеКонфигурации_ДД", "Документы.ОтчетКомитенту");
		
		Если НЕ ЗначениеЗаполнено(Результат) И ЕстьОтчетКомитенту Тогда
			
			Для каждого ДокументОснования Из ДокументыОснования Цикл
				
				Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
					Результат = "6";
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет реквизит ДанныеПрослеживаемости и ПрослеживаемыйТовар в ТаблицеТоваров
//
// Параметры
//  СтрокаТовары	- СтрокаТаблицыЗначений	 	- строка таблицы товаров, см. ИнициализацияТаблицыСтрокТовары()
//  Источник	- ВыборкаДетальныеЗаписи	- РезультатПоТабличнойЧасти документа методом ПолучитьДанныеДляПечатнойФормыУКД()
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляОтправкиПоКорректировке(СтрокаТовары, Источник)
	
	Если ЗначениеЗаполнено(Источник.КоличествоПоРНПТ) ИЛИ ЗначениеЗаполнено(Источник.КоличествоПоРНПТДо) Тогда
		
		ДанныеПрослеживаемости = Новый Массив;
		
		СтрокаПрослеживаемости = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НовыеСвойстваЭлементаПрослеживаемостиПоКорректировке");
		СтрокаПрослеживаемости.НомерГТДРегистрационныйНомер			 = НомерГТДСтрокой(Источник.НомерГТД);
		СтрокаПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости	 = СокрЛП(Источник.ЕдиницаИзмеренияТНВЭДКод);
		СтрокаПрослеживаемости.КоличествоПослеИзменения				 = Источник.КоличествоПоРНПТ;
		СтрокаПрослеживаемости.КоличествоДоИзменения				 = Источник.КоличествоПоРНПТДо; 
		
		ЭтоУменьшение = СтрокаПрослеживаемости.КоличествоДоИзменения > СтрокаПрослеживаемости.КоличествоПослеИзменения; 
		Если ЭтоУменьшение Тогда
			КоличествоУменьшение = СтрокаПрослеживаемости.КоличествоДоИзменения - СтрокаПрослеживаемости.КоличествоПослеИзменения;
			СтрокаПрослеживаемости.КоличествоУменьшение = КоличествоУменьшение;
		КонецЕсли; 
		
		ЭтоУвеличение = СтрокаПрослеживаемости.КоличествоПослеИзменения > СтрокаПрослеживаемости.КоличествоДоИзменения;
		Если ЭтоУвеличение Тогда
			КоличествоУвеличение = СтрокаПрослеживаемости.КоличествоПослеИзменения - СтрокаПрослеживаемости.КоличествоДоИзменения;
			СтрокаПрослеживаемости.КоличествоУвеличение = КоличествоУвеличение;
		КонецЕсли; 
		
		ДанныеПрослеживаемости.Добавить(СтрокаПрослеживаемости);
		СтрокаТовары.ДанныеПрослеживаемости	 = ДанныеПрослеживаемости;
		СтрокаТовары.ПрослеживаемыйТовар		 = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет реквизит ДанныеПрослеживаемости и ПрослеживаемыйТовар в ТаблицеТоваров
//
// Параметры
//  СтрокаТовары	- СтрокаТаблицыЗначений	 	- строка таблицы товаров, см. ИнициализацияТаблицыСтрокТовары()
//  Источник	- ВыборкаДетальныеЗаписи	- РезультатПоТабличнойЧасти документа методом ПолучитьДанныеДляПечатнойФормыУПД()
//
Процедура ЗаполнитьСведенияПрослеживаемостиДляИсправительногоСчетФактура(СтрокаТовары, Источник)
	
	Если ЗначениеЗаполнено(Источник.КоличествоПоРНПТ) ИЛИ ЗначениеЗаполнено(Источник.КоличествоПоРНПТДо) Тогда
		
		ДанныеПрослеживаемости = Новый Массив;
		
		СтрокаПрослеживаемости = НовыеСвойстваЭлементаПрослеживаемости();
		СтрокаПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости			 = Источник.ЕдиницаИзмерения;
		СтрокаПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости	 = СокрЛП(Источник.ЕдиницаИзмеренияКод);
		СтрокаПрослеживаемости.КоличествоПоРНПТ				 = Источник.КоличествоПоРНПТ;
		СтрокаПрослеживаемости.НомерГТДРегистрационныйНомер				 = СокрЛП(Строка(Источник.НомерГТД)); 
		
		ДанныеПрослеживаемости.Добавить(СтрокаПрослеживаемости);
		СтрокаТовары.ДанныеПрослеживаемости	 = ДанныеПрослеживаемости;
		СтрокаТовары.ПрослеживаемыйТовар		 = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоВыбытиеИзОборотаМаркируемойПродукции(ДокументСсылка) Экспорт
	
	Результат = Ложь;
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если ЭтоРедакция11_5() Тогда
		НачальнаяВерсияУТ = "11.5.7.288";
	Иначе
		НачальнаяВерсияУТ = "11.4.14.95";
	КонецЕсли;
		
	ОтсутствуетУчетВыбытия = СравнитьВерсии(ВерсияУТ, НачальнаяВерсияУТ) < 0;
	
	Если ОтсутствуетУчетВыбытия Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЭтоСчетФактура(ДокументСсылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ДокументыОснования.ДокументОснование ССЫЛКА Документ.КорректировкаРеализации
		|			ТОГДА ВЫРАЗИТЬ(ДокументыОснования.ДокументОснование КАК Документ.КорректировкаРеализации).ДокументОснование
		|		ИНАЧЕ ДокументыОснования.ДокументОснование
		|	КОНЕЦ КАК ПервичныйДокумент
		|ПОМЕСТИТЬ ВТ_ПервичныеДокументы
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК ДокументыОснования
		|ГДЕ
		|	ДокументыОснования.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПервичныеДокументы.ПервичныйДокумент КАК ПервичныйДокумент,
		|	ВЫБОР
		|		КОГДА ВТ_ПервичныеДокументы.ПервичныйДокумент ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА ВЫРАЗИТЬ(ВТ_ПервичныеДокументы.ПервичныйДокумент КАК Документ.РеализацияТоваровУслуг).ВариантВыбытияМаркируемойПродукции
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ВариантВыбытияМаркируемойПродукции
		|ПОМЕСТИТЬ ВТ_ВариантыВыбытияМаркируемойПродукции
		|ИЗ
		|	ВТ_ПервичныеДокументы КАК ВТ_ПервичныеДокументы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ВТ_ВариантыВыбытияМаркируемойПродукции.ВариантВыбытияМаркируемойПродукции = ЗНАЧЕНИЕ(Перечисление.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ВыбытиеМаркируемойПродукции
		|ИЗ
		|	ВТ_ВариантыВыбытияМаркируемойПродукции КАК ВТ_ВариантыВыбытияМаркируемойПродукции";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ВыбытиеМаркируемойПродукции;
		КонецЕсли;
		
	ИначеЕсли ЭтоНакладная(ДокументСсылка) Тогда
		
		ПризнакВыбытия = Перечисления.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд;
		Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ВариантВыбытияМаркируемойПродукции");
		Результат = (Значение = ПризнакВыбытия);
		
	ИначеЕсли ЭтоКорректировкаРеализации(ДокументСсылка) Тогда
		
		ПризнакВыбытия = Перечисления.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд;
		Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка.ДокументОснование, "ВариантВыбытияМаркируемойПродукции");
		Результат = (Значение = ПризнакВыбытия);
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

//} ПОЛУЧЕНИЕ ДАННЫХ
