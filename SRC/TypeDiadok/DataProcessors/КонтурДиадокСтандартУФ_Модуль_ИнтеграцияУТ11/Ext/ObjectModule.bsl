Функция ТекстЗапроса_СчетНаОплату_ПроцентОплаты(ПсевдонимТаблицы = "Документ")
	
	Результат =
	"ВЫБОР
	|	КОГДА ПсевдонимТаблицы.ДокументОснование ССЫЛКА Документ.ОтчетКомитенту
	|				И ПсевдонимТаблицы.ДокументОснование.СуммаВознаграждения = 0
	|		ТОГДА 0
	|	КОГДА ПсевдонимТаблицы.ДокументОснование ССЫЛКА Документ.ОтчетКомитенту
	|		ТОГДА ПсевдонимТаблицы.СуммаДокумента * 100 / ПсевдонимТаблицы.ДокументОснование.СуммаВознаграждения // СуммаВознаграждения <> 0
	|	КОГДА ПсевдонимТаблицы.ДокументОснование.СуммаДокумента = 0
	|		ТОГДА 0
	|	КОГДА (ПсевдонимТаблицы.ДокументОснование ССЫЛКА Документ.ЗаказКлиента
	|				ИЛИ ПсевдонимТаблицы.ДокументОснование ССЫЛКА Документ.ЗаявкаНаВозвратТоваровОтКлиента)
	|				И ПсевдонимТаблицы.ДокументОснование.ТребуетсяЗалогЗаТару
	|		ТОГДА ПсевдонимТаблицы.СуммаДокумента * 100 / (ПсевдонимТаблицы.ДокументОснование.СуммаДокумента + ПсевдонимТаблицы.ДокументОснование.СуммаВозвратнойТары)
	|	ИНАЧЕ ПсевдонимТаблицы.СуммаДокумента * 100 / ПсевдонимТаблицы.ДокументОснование.СуммаДокумента
	|КОНЕЦ";
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаВременнаяТаблица_ЕстьСЧФ()
	
	Результат =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Основная.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_ЕстьСЧФ
	|ИЗ
	|	ВТ_Основная КАК ВТ_Основная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СЧФ_ДокументыОснования
	|		ПО ВТ_Основная.Документ = СЧФ_ДокументыОснования.ДокументОснование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СЧФ
	|		ПО (СЧФ_ДокументыОснования.Ссылка = СЧФ.Ссылка)
	|ГДЕ
	|	СЧФ.Ссылка ЕСТЬ НЕ NULL 
	|	И НЕ СЧФ.ПометкаУдаления
	|	И (СЧФ.Проведен
	|			ИЛИ ВТ_Основная.ОтправлятьНепроведенные = ИСТИНА)";
	
	Возврат Результат;
	
КонецФункции

