Функция ЗаполнятьСведенияПрослеживаемости()
	
	ВестиУчет 		= ИспользуетсяУчетПрослеживаемыхТоваров();
	ДатаНачалаУчета = ДатаНачалаУчетаПрослеживаемыхИмпортныхТоваров();
		
	Результат = ВестиУчет
				И ЗначениеЗаполнено(ДатаНачалаУчета)
				И ДатаНачалаУчета <= ТекущаяДата();
			
	Возврат Результат;
	
