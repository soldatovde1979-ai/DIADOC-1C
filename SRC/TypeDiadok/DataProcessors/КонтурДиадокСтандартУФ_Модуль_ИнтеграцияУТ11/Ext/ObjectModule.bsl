	Для Каждого Колонка Из ТаблЗнач.Колонки Цикл
		СтрокаКлючей = СтрокаКлючей + ?(ПустаяСтрока(СтрокаКлючей), "", ",") + Колонка.Имя;
	КонецЦикла;
	
	Если ТипЗнч(ТаблЗнач) = Тип("ТаблицаЗначений") Тогда
		
