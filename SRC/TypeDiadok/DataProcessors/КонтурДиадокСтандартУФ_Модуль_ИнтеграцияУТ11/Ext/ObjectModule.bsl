Функция ПолучитьПлатежноРасчетныеДокументы(ДокументСсылка, МассивОснований)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = "ВЫБРАТЬ
	|	ПРС.ДатаПлатежноРасчетногоДокумента КАК ДатаПлатежноРасчетногоДокумента,
	|	ПРС.НомерПлатежноРасчетногоДокумента КАК НомерПлатежноРасчетногоДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК ПРС
	|ГДЕ
	|	ПРС.Ссылка = &Ссылка
	|	И ПРС.НомерПлатежноРасчетногоДокумента <> """"
	|	И ПРС.ДатаПлатежноРасчетногоДокумента <> ДАТАВРЕМЯ(1, 1, 1)";
	
	Если Метаданные.Документы.Найти("СчетФактураВыданныйАванс") <> Неопределено И ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы", "Документ.СчетФактураВыданныйАванс");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыСчетаФактуры(СчетФактура) Экспорт
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	Если СравнитьВерсии(ВерсияУТ, "11.4.10") < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ТекстЗапроса = ТекстЗапроса_СчетФактураВыданный();
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		ТекстЗапроса = ТекстЗапроса_СчетФактураВыданныйАванс();
	ИначеЕсли ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураНалоговыйАгент") Тогда
		ТекстЗапроса = ТекстЗапроса_СчетФактураНалоговыйАгент();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	Запрос.УстановитьПараметр("ВалютаРегл", ВалютаРегламентированногоУчета());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Результат = Новый Структура;
		Результат.Вставить("СуммаДокумента", Выборка.Сумма);
		Результат.Вставить("СуммаУвеличение", Выборка.СуммаУвеличение);
		Результат.Вставить("СуммаУменьшение", Выборка.СуммаУменьшение);
		Результат.Вставить("СуммаНДСДокумента", Выборка.СуммаНДС);
		Результат.Вставить("СуммаНДСУвеличение", Выборка.СуммаНДСУвеличение);
		Результат.Вставить("СуммаНДСУменьшение", Выборка.СуммаНДСУменьшение);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

