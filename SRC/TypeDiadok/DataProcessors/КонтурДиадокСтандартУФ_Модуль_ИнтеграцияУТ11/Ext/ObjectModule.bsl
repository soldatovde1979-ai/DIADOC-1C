КонецФункции

Функция ПолучитьЗаказПокупателяНаОснованииРТУ(ДокументСсылка) Экспорт
	
	Если НЕ Метаданные.Документы.РеализацияТоваровУслуг.Реквизиты.Найти("ЗаказКлиента") = Неопределено
		  И ТипЗнч(ДокументСсылка.ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		  
		Возврат ДокументСсылка.ЗаказКлиента;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСФОснованиеПоИСФ_КСФ(ИСФ_КСФ) Экспорт
	
	ДокОснование = ПервыйДокументОснование(ИСФ_КСФ);
	Если Не ЗначениеЗаполнено(ДокОснование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВидОперации = ХозяйственнаяОперацияДокумента(ДокОснование);
	
	Если ВидОперации = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон Тогда 
		ДокОснование = ПервыйДокументОснование(ДокОснование);
	Иначе
		Пока ТипЗнч(ДокОснование) = Тип("ДокументСсылка.КорректировкаРеализации")
			И ХозяйственнаяОперацияДокумента(ДокОснование) = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок Цикл 
			
			ДокОснование = ПервыйДокументОснование(ДокОснование);
			
		КонецЦикла;
	КонецЕсли;
	
	Результат = ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ДокОснование);
	
	Возврат Результат;

КонецФункции

Функция ПолучитьДанныеДляФормированияУПД(ДокСсылка, ФункцияУПД)
	
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "СЧФ" Тогда
		
		ДанныеДляФормированияСчетФактуры = СформироватьДанныеДляПечати(ДокСсылка, Ложь);
		
		ДанныеДляФормированияУПД = Новый Структура("ДанныеШапки", Новый Структура);
		
		Для Каждого КлючИЗначение Из ДанныеДляФормированияСчетФактуры Цикл
			
			Если КлючИЗначение.Ключ = "ТабличнаяЧасть" Тогда
				ДанныеДляФормированияУПД.Вставить("ТаблицаТоваров", КлючИЗначение.Значение);
			Иначе
				ДанныеДляФормированияУПД.ДанныеШапки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
			
		КонецЦикла;
		
		ТаблицаНакладных = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокСсылка);
		Если ЗначениеЗаполнено(ТаблицаНакладных) Тогда
			
			Накладная = ТаблицаНакладных[0].Ссылка;
			
			Если ФункцияУПД = "СЧФДОП" Тогда 
				
				ИсправляемыйДокументРеализации = ПолучитьИсправляемыйДокументРеализации(Накладная);
				
				ДанныеДляФормированияУПД.ДанныеШапки.Вставить("ДатаОтгрузки", ИсправляемыйДокументРеализации.Дата);
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ДанныеШапки	 = ДанныеШапки(ДокСсылка);
		
		ПроверитьЗаполнитьВалюту(ДанныеШапки);
		
		ДанныеТЧ	 = ПолучитьДанныеТЧ(ДокСсылка, Неопределено, Неопределено, Истина, , ФункцияУПД);
		ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ДанныеТЧ);
		
		ДанныеДляФормированияУПД = Новый Структура;
		ДанныеДляФормированияУПД.Вставить("ДанныеШапки"		, ДанныеШапки);
		ДанныеДляФормированияУПД.Вставить("ТаблицаТоваров"	, ДанныеТЧ);
		
	КонецЕсли;
	
	Если ФункцияУПД = "СЧФДОП" Тогда
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("Функция", "InvoiceAndBasic");
	ИначеЕсли ФункцияУПД = "ДОП" Тогда
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("Функция", "Basic");
	ИначеЕсли ФункцияУПД = "СЧФ" Тогда
		ДанныеДляФормированияУПД.ДанныеШапки.Вставить("Функция", "Invoice");
	КонецЕсли;
	ДанныеДляФормированияУПД.ДанныеШапки.Вставить("ДатаНомерСвидетельстваОРегистрации", ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(ДанныеДляФормированияУПД.ДанныеШапки.Организация));
	
	Если ДанныеДляФормированияУПД.ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ДанныеДляФормированияУПД.ТаблицаТоваров);
	КонецЕсли;
	
	Возврат ДанныеДляФормированияУПД;
	
КонецФункции

Функция ДанныеДляФормированияУКД(ДокСсылка, ДопПараметры)
	
	Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "КСЧФ" Тогда
		
		СчетФактура		 = ДокСсылка;
		ТаблицаНакладных = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ДокСсылка);
		Накладная		 = ТаблицаНакладных[0].Ссылка;
		
		ИсходныйСчетФактура = ИсходныйСчетФактура(ДокСсылка);
		ТаблицаИсправляемыхДокументов = ПолучитьТаблицуНакладныхПоСчетуФактуреВыданному(ИсходныйСчетФактура);
		ИсправляемыеДокументы = ТаблицаИсправляемыхДокументов.ВыгрузитьКолонку("Ссылка");
		
	Иначе
		
		СчетФактура = Неопределено;
		Накладная	= ДокСсылка;
		
		ТаблицаНакладных = Новый ТаблицаЗначений;
		ТаблицаНакладных.Колонки.Добавить("Ссылка");
		ТаблицаНакладных.Колонки.Добавить("Дата");
		
		НоваяСтрока = ТаблицаНакладных.Добавить();
		НоваяСтрока.Ссылка  = Накладная;
		НоваяСтрока.Дата  	= Накладная.Дата;
		
		СвязанныеДокументы = ТаблицаСвязанныхКорректировочныхДокументов(ДокСсылка);
		Если СвязанныеДокументы.Количество() > 1 Тогда
			ИсправляемыйДокумент = СвязанныеДокументы[1].Подчиненный;
		Иначе
			ИсправляемыйДокумент = ПолучитьИсправляемыйДокументРеализации(ДокСсылка);
		КонецЕсли;
		
		ИсправляемыеДокументы = Новый Массив;
		ИсправляемыеДокументы.Добавить(ИсправляемыйДокумент);
		
	КонецЕсли;
	
	Шапка = ДанныеШапки(ДокСсылка);
	
	ПроверитьЗаполнитьВалюту(Шапка);
	
	ТабличнаяЧасть = ТабличнаяЧастьКорректировочногоДокумента(ДокСсылка);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	Шапка.Вставить("Функция", ?(ДопПараметры.ФункцияУПД = "КСЧФДИС", "InvoiceAndBasic", ?(ДопПараметры.ФункцияУПД = "КСЧФ", "Invoice", "Basic")));
	
	Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "ДИС" Тогда
		ДатаУведомления = ТаблицаНакладных[0].Дата;
		Если ДатаУведомления <> Шапка.ДатаНомерДокумента.ДатаДокумента Тогда
			Шапка.Вставить("ДатаУведомления", ДатаУведомления);
		КонецЕсли;
	КонецЕсли;
	
	Если МетодСервера(, "ЕстьРеквизитТипаОбъекта", ТипЗнч(Накладная), "СопроводительныеДокументы") Тогда
		Шапка.Вставить("ИныеСведенияОбИзмененииСтоимости", Накладная.СопроводительныеДокументы);
	КонецЕсли;
					
	РеквизитыПередаточныхДокументов		= Новый Массив;
	ДобавленныеПередаточныеДокументы	= Новый Соответствие;
	
	ТипПередаточногоДокумента = "УПД "; 
	
	Шапка.Вставить("ОснованияПередачи", Новый Массив);
	Шапка.Вставить("ПередаточныеДокументы", Новый Массив);
	Шапка.Вставить("ИсправляемыеДокументы", ИсправляемыеДокументы);
	
	Для Каждого СтрокаТЗ Из ТаблицаНакладных Цикл
		
		СтруктураОснования = СтруктурированноеПредставлениеОснованияДляУКД(СтрокаТЗ.Ссылка);
		
		Если ЗначениеЗаполнено(СтруктураОснования)
			И ЗначениеЗаполнено(СтруктураОснования.GroundName)
			И ЗначениеЗаполнено(СтруктураОснования.GroundDate) Тогда
			
			ItemCorrectionBases = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_CorrectionBase");
			
			ЗаполнитьCorrectionBaseПоДаннымОснования(ItemCorrectionBases, СтруктураОснования);
			
			Шапка.ОснованияПередачи.Добавить(ItemCorrectionBases);	
			
		КонецЕсли;
	
		ИсправляемыйДокументРеализации = ПолучитьИсправляемыйДокументРеализации(СтрокаТЗ.Ссылка);
		Если ДопПараметры.ФункцияУПД = "КСЧФДИС" ИЛИ ДопПараметры.ФункцияУПД = "КСЧФ" Тогда 
			ПередаточныйДокумент = ПолучитьСсылкуСчетаФактурыВыданногоПоДокументуОснованию(ИсправляемыйДокументРеализации);
		Иначе
			ПередаточныйДокумент = ИсправляемыйДокументРеализации;
		КонецЕсли;
		
		Шапка.ПередаточныеДокументы.Добавить(ПередаточныйДокумент);
		
		Если ДобавленныеПередаточныеДокументы[ПередаточныйДокумент] <> Истина Тогда
			
			ДобавленныеПередаточныеДокументы.Вставить(ПередаточныйДокумент, Истина);
			
			Новый_BaseDocument = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_BaseDocumentName");
		
			Новый_BaseDocument.BaseDocumentName		= ТипПередаточногоДокумента;
			Новый_BaseDocument.BaseDocumentNumber 	= ПредставлениеНомераОбъекта(ПередаточныйДокумент);
			Новый_BaseDocument.BaseDocumentDate 	= Формат(ПередаточныйДокумент.Дата, "ДФ=dd.MM.yyyy");
			
			РеквизитыПередаточныхДокументов.Добавить(Новый_BaseDocument);
																				
		КонецЕсли;
		
	КонецЦикла;
	
	Шапка.Вставить("РеквизитыПередаточныхДокументов", РеквизитыПередаточныхДокументов); 
	
	Если Шапка.НДСИсчисляетсяНалоговымАгентом Тогда
		МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТабличнаяЧасть);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Шапка", 			Шапка);
	Результат.Вставить("ТабличнаяЧасть", 	ТабличнаяЧасть);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьСтруктуруОснования(ДоговорКонтрагента, ЭтоУПД)
	
	Ground = Новый Структура;
	Ground.Вставить("GroundName", 	"");
	Ground.Вставить("GroundNumber", "");
	Ground.Вставить("GroundDate", 	"");
	Ground.Вставить("Основание", 	"");
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
			
		Если ЭтоУПД Тогда
			ПредставлениеДоговора= "Договор";
		Иначе
			ПредставлениеДоговора= ДоговорКонтрагента.Наименование;
		КонецЕсли;
			
		Ground.Вставить("GroundName", 	ПредставлениеДоговора);
		Ground.Вставить("GroundNumber", ДоговорКонтрагента.Номер);
		Ground.Вставить("GroundDate", 	ДоговорКонтрагента.Дата);
		Ground.Вставить("Основание", 	ДоговорКонтрагента);
		
	КонецЕсли;
	
	Возврат Ground;
	
КонецФункции

Процедура ЗаполнитьCorrectionBaseПоДаннымОснования(CorrectionBase, СтруктураОснования)
	
	CorrectionBase.BaseDocumentName		= СтруктураОснования.GroundName;
	CorrectionBase.BaseDocumentNumber	= СтруктураОснования.GroundNumber;
	CorrectionBase.BaseDocumentDate		= СтруктураОснования.GroundDate;
	CorrectionBase.AdditionalInfo		= "";
	
КонецПроцедуры

Функция ПолучитьИсправляемыйДокументРеализации(ДокРеализации)
	
	Если ЗначениеЗаполнено(ДокРеализации) 
		И ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Результат = ПолучитьИсправляемыйДокументРеализации(ДокРеализации.ДокументОснование);
		
	ИначеЕсли ТипЗнч(ДокРеализации) = Тип("ДокументСсылка.ВозвратТоваровОтКлиента")
		И ЕстьРеквизитМетаданных(ДокРеализации.Метаданные(), "ДокументРеализации")
		И ТипЗнч(ДокРеализации.ДокументРеализации) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Результат = ДокРеализации.ДокументРеализации;
		
	Иначе
		
		Результат = ДокРеализации;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаСвязанныхКорректировочныхДокументов(ДокКорретировки)
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.ВидКорректировки КАК ХозяйственнаяОперация
	|
	|ПОМЕСТИТЬ ТаблицаДанныхДокумента
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка;
	|
	|//////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Основной,
	|	ДанныеДокумента.Ссылка КАК Подчиненный,
	|	ДанныеДокумента.Ссылка.МоментВремени КАК МоментВремени
	|ИЗ
	|	ТаблицаДанныхДокумента КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	|	И ДанныеДокумента.ХозяйственнаяОперация В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратНедопоставленногоТовара)
	|	)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТекущийДокумент.Ссылка,
	|	ТекущийДокумент.ДокументОснование,
	|	ТекущийДокумент.ДокументОснование.МоментВремени
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ТекущийДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокумента КАК ДанныеДокумента
	|		ПО ТекущийДокумент.Ссылка = ДанныеДокумента.Ссылка
	|ГДЕ
	|	ТекущийДокумент.Ссылка = &Ссылка
	|	И НЕ ДанныеДокумента.ХозяйственнаяОперация В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратНедопоставленногоТовара)
	|	)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТекущийДокумент.Ссылка,
	|	ПредыдущиеДокументы.Ссылка,
	|	ПредыдущиеДокументы.МоментВремени
	|ИЗ
	|	Документ.КорректировкаРеализации КАК ТекущийДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокумента КАК ДанныеДокумента
	|		ПО ТекущийДокумент.Ссылка = ДанныеДокумента.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРеализации КАК ПредыдущиеДокументы
	|		ПО ТекущийДокумент.ДокументОснование = ПредыдущиеДокументы.ДокументОснование
	|			И (ТекущийДокумент.Дата >= ПредыдущиеДокументы.Дата
	|				ИЛИ ТекущийДокумент.Дата = ПредыдущиеДокументы.Дата
	|					И ТекущийДокумент.Ссылка >= ПредыдущиеДокументы.Ссылка)
	|ГДЕ
	|	ТекущийДокумент.Ссылка = &Ссылка
	|	И ПредыдущиеДокументы.Проведен
	|	И НЕ ДанныеДокумента.ХозяйственнаяОперация В (
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияПерепоставленногоТовара),
	|		ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратНедопоставленногоТовара)
	|	)
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени УБЫВ;
	|
	|//////////////////////////////////////////////////////////////////
	|
	|УНИЧТОЖИТЬ ТаблицаДанныхДокумента";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокКорретировки);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

