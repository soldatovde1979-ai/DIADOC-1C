	Шапка.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ОплатаПоставщику);
	Шапка.Вставить("Контрагент", Контрагент);
	Шапка.Вставить("БанковскийСчет", БанковскийСчетОрганизации);
	Шапка.Вставить("Валюта", ШапкаЭД.Валюта.Ссылка);
	Шапка.Вставить("НеКонтролироватьЗаполнениеЗаявки", Ложь);
	
	Если ШапкаЭД.Свойство("КурсВалюты") Тогда
		Шапка.Вставить("КурсКонвертации", ШапкаЭД.КурсВалюты);
	КонецЕсли;
	
	Шапка.Вставить("ОплатаПоЗаявкам", Ложь);
	Шапка.Вставить("ПроводкиПоРаботникам", Ложь);
	Шапка.Вставить("Партнер", Партнер);
	Шапка.Вставить("Исправление", Ложь);
	
	РасшифровкаПлатежа = ПустаяСсылкаНаДокумент.РасшифровкаПлатежа.ВыгрузитьКолонки();
	
	НДСИсчисляетсяНалоговымАгентом = Ложь;
	
	Для Каждого СтрокаТовара Из ДанныеЭД.ТоварнаяЧасть Цикл
		СтрокаРасшифровки = РасшифровкаПлатежа.Добавить();
		СтрокаРасшифровки.Партнер = Партнер;
		СтрокаРасшифровки.Сумма = СтрокаТовара.СуммаСНДС;
		СтрокаРасшифровки.ВалютаВзаиморасчетов = ШапкаЭД.Валюта.Ссылка;
		СтрокаРасшифровки.СуммаВзаиморасчетов = СтрокаТовара.СуммаСНДС;
		СтрокаРасшифровки.СтавкаНДС = ЗначениеСтавкиНДС(СтрокаТовара.НоменклатураКонтрагента.СтавкаНДС);
		СтрокаРасшифровки.СуммаНДС = СтрокаТовара.СуммаНДС;
		СтрокаРасшифровки.Организация = Организация;
		
		Если СтрокаТовара.НоменклатураКонтрагента.СтавкаНДС = СтавкаНДСИсчисляетсяНалоговымАгентом() Тогда
			НДСИсчисляетсяНалоговымАгентом = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("РасшифровкаПлатежа", РасшифровкаПлатежа);
	ДанныеОбъекта.Вставить("НДСИсчисляетсяНалоговымАгентом", НДСИсчисляетсяНалоговымАгентом);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция БанковскийСчетКонтрагентаПоНомеру(Контрагент, НомерБанковскогоСчета)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчетаКонтрагентов.Ссылка КАК БанковскийСчет
	|ИЗ
	|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
	|ГДЕ
	|	БанковскиеСчетаКонтрагентов.НомерСчета = &НомерСчета
	|	И БанковскиеСчетаКонтрагентов.Владелец = &Контрагент
	|	И НЕ БанковскиеСчетаКонтрагентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НомерСчета", НомерБанковскогоСчета);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ЗначениеЗаполнено(РезультатЗапроса) Тогда
		Результат = РезультатЗапроса[0].БанковскийСчет;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция БанковскийСчетОрганизацииПоНомеру(Организация, НомерСчета)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеСчетаОрганизаций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	|ГДЕ
	|	БанковскиеСчетаОрганизаций.Владелец = &Организация
	|	И БанковскиеСчетаОрганизаций.НомерСчета = &НомерСчета
	|	И НЕ БанковскиеСчетаОрганизаций.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ЗначениеЗаполнено(РезультатЗапроса) Тогда
		Результат = РезультатЗапроса[0].БанковскийСчет;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НомерДокументаБезПрефикса(НомерДокумента)

	УдалитьПрефиксИнформационнойБазы	= Истина;
	УдалитьПользовательскийПрефикс		= Истина;
	
	НомерДокументаБезПрефикса = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерДокумента, УдалитьПрефиксИнформационнойБазы, УдалитьПользовательскийПрефикс);
	
	Возврат НомерДокументаБезПрефикса;

КонецФункции

Процедура ПроверитьВозможностьЗаполненияСчетаФактурыНаАванс(ДанныеЭД)
	
	Если ДанныеЭД.ЭтоАванс Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЭД = ДанныеЭД.ЭлектронныйДокумент.Идентификатор;
	СоставнойИдентификатор	 = ИдентификаторЭД.СоставнойИдентификатор;
	ИдентификаторОрганизации = ИдентификаторЭД.ИдентификаторОрганизации;
	
	Ошибка = НСтр("ru = 'Электронный документ не является счетом-фактурой на аванс!'");
	
	КомментарийЖР = НСтр("ru = 'Ошибка при отражении в учете документа %1 (boxId = %2):'")
		+ Символы.ПС
		+ Ошибка;
	
	КомментарийЖР = СтрШаблон(КомментарийЖР, СоставнойИдентификатор, ИдентификаторОрганизации);
	
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаЗагрузка()
		, УровеньЖурналаРегистрации.Ошибка
		, Метаданные.Документы.СчетФактураПолученныйАванс
		,
		, КомментарийЖР);
	
	ТекстСообщения = Ошибка
		+ Символы.ПС
		+ НСтр("ru = 'Попробуйте выбрать другой вид документа.'");
	
	ВызватьИсключение ТекстСообщения;
	
КонецПроцедуры

Процедура ПересчитатьЦенуСуммуПриУстановкеФлагаЦенаВключаетНДС(ДокументОбъект, ИмяТЧ)
	
	Если Не ДокументОбъект.ЦенаВключаетНДС Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	Если СравнитьВерсии(ВерсияУТ, "11.5.22") >= 0 Тогда
		
		ИмяМодуля = "УчетНДСУПКлиентСервер";
		ОбщийМодульУчетНДСУПКлиентСервер = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);

		Для Каждого Строка Из ДокументОбъект[ИмяТЧ] Цикл 
			
			СтавкаНДСЗначение = ОбщийМодульУчетНДСУПКлиентСервер.ЗначениеСтавкиНДС(Строка.СтавкаНДС);
			Строка.Цена = Строка.Цена * (СтавкаНДСЗначение + 100) / 100;
			Строка.Сумма = Строка.СуммаСНДС;
			
		КонецЦикла;
		
	Иначе
		СтруктураПересчетаСуммы = ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьЦенуСНДС", СтруктураПересчетаСуммы);
		
		МодульОбработкаТабличнойЧастиСервер = ОбщийМодульОбработкаТабличнойЧастиСервер();
		
		Для Каждого Строка Из ДокументОбъект[ИмяТЧ] Цикл 
			
			МодульОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Строка, СтруктураДействий, Неопределено);
			Строка.Сумма = Строка.СуммаСНДС;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Конструктор дополнительных параметров заполнения счетов-фактур.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ДокументОснование - Неопределено, ДокументСсылка, Массив - документ-основание (список оснований) счета-фактуры.
//
Функция ПараметрыЗаполненияСчетаФактуры()
	
	Результат = Новый Структура;
	Результат.Вставить("ДокументОснование", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Конструктор дополнительных параметров заполнения документа учета.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ЦенаВключаетНДС - Булево - Истина, если цена включает НДС.
//
Функция ОбщиеПараметрыЗаполненияДокументовУчета()
	
	Результат = Новый Структура;
	Результат.Вставить("ЦенаВключаетНДС", Ложь);
	
