Функция ПодготовитьДопДанныеДляСозданияНакладной(СтруктураВходящиеДанные) Экспорт
	
	ВозвращаемаяСтруктура = Новый Структура();
	
	Если МетодСервера(,"ЕстьРеквизитТипаОбъекта", ТипЗнч(СтруктураВходящиеДанные.Соглашение), "ВидЦеныПоставщика") Тогда 
		ВозвращаемаяСтруктура.Вставить("ВидЦеныПоставщика", СтруктураВходящиеДанные.Соглашение.ВидЦеныПоставщика);
	КонецЕсли;
	
	Если СтруктураВходящиеДанные.Свойство("ВидОперации")
		И СтруктураВходящиеДанные.ВидОперации = "ПоступлениеУслугИПрочихАктивов" Тогда
		
		СтруктураОбъекта = Новый Структура("Соглашение, Договор", СтруктураВходящиеДанные.Соглашение, СтруктураВходящиеДанные.ДоговорКонтрагента);
		ПорядокРасчетовПоУмолчанию = ВзаиморасчетыСервер.ПорядокРасчетовПоУмолчанию(СтруктураОбъекта);
		
		ВозвращаемаяСтруктура.Вставить("ПорядокРасчетовПоУмолчанию", ПорядокРасчетовПоУмолчанию);
		
		Если ЗначениеЗаполнено(СтруктураВходящиеДанные.ДоговорКонтрагента) Тогда
			
			// BSLLS:SetPrivilegedMode-off
			УстановитьПривилегированныйРежим(Истина);
			// BSLLS:SetPrivilegedMode-on
			
			ГрафикИсполненияВДоговоре = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураВходящиеДанные.ДоговорКонтрагента, "ЗаданГрафикИсполнения");
			
			Если ПривилегированныйРежим() Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			
			ВозвращаемаяСтруктура.Вставить("ГрафикИсполненияВДоговоре", ГрафикИсполненияВДоговоре);
			
		КонецЕсли;
		
		//в текущем случае значение первого параметра значения не играет
		ДоступныеПорядкиРасчетов = ВзаиморасчетыСервер.ДоступныеПорядкиРасчетовПоДокументу(ПорядокРасчетовПоУмолчанию, ПорядокРасчетовПоУмолчанию, Ложь);
		
		ВозвращаемаяСтруктура.Вставить("ДоступныеПорядкиРасчетов", ДоступныеПорядкиРасчетов);
						
	КонецЕсли;
			
	Возврат ВозвращаемаяСтруктура; 
	
КонецФункции

Функция ПараметрыМассыПрописью(Масса, КоэффициентПересчетаВТонны)

	МассаТонны = Масса * КоэффициентПересчетаВТонны;
	Если МассаТонны > 1 Тогда
		Коэффициент = 1;
		СтрокаФормат = "т, т, т, ж, кг, кг, кг, м, " + ?(Окр(МассаТонны) = МассаТонны, "0", "3");
	ИначеЕсли МассаТонны * 1000 > 1 Тогда
		Коэффициент = 1000;
		СтрокаФормат = "кг, кг, кг, м, г, г, г, м, " + ?(Окр(МассаТонны * Коэффициент) = МассаТонны * Коэффициент, "0", "3");
	Иначе
		Коэффициент = 1000000;
		СтрокаФормат = "г, г, г, м, г, г, г, м, 0";
	КонецЕсли;
	
	Возврат Новый Структура("Формат, Коэффициент", СтрокаФормат, Коэффициент*КоэффициентПересчетаВТонны);
	
КонецФункции

Функция СписокЗначений_В_Массив(Список)
	
	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитИлиСвойствоОбъектаЛок(Объект, ИмяРеквизита)
	
	Результат = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита);
	
	Возврат Результат;
	
КонецФункции

