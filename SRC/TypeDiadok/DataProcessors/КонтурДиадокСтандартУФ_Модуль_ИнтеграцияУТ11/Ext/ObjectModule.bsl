// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидыИсходящихДокументов.
//
// Параметры:
//  ВидыДокументов - ТаблицаЗначений - см. функцию Модуль_ИнтеграцияУниверсальный.ВидыИсходящихДокументов;
//
Процедура ПриПолученииВидовИсходящихДокументов(ВидыДокументов) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	
	ПсевдонимТаблицы = "ОсновнаяТаблица";
	
	КРТУ_ЭтоКорректировка = ТекстЗапроса_КРТУ_ЭтоКорректировка(ПсевдонимТаблицы);
	КРТУ_ЭтоНеКорректировка = "НЕ " + КРТУ_ЭтоКорректировка; 
	
	СФ_ЭтоКорректировка = ТекстЗапроса_СчетФактура_ЭтоКорректировка(ПсевдонимТаблицы);
	СФ_ЭтоНеКорректировка = "НЕ " + СФ_ЭтоКорректировка;
	
	СФАванс_ЭтоКорректировка = ТекстЗапроса_СчетФактураАванс_ЭтоКорректировка(ПсевдонимТаблицы);
	СФАванс_ЭтоНеКорректировка = "НЕ " + СФАванс_ЭтоКорректировка;
	
	СФКомиссионеру_ЭтоКорректировка = ТекстЗапроса_СчетФактураКомиссионеру_ЭтоКорректировка(ПсевдонимТаблицы);
	СФКомиссионеру_ЭтоНеКорректировка = "НЕ " + СФКомиссионеру_ЭтоКорректировка;
	
	СФНалоговыйАгент_ЭтоКорректировка = ТекстЗапроса_СчетФактураНалоговыйАгент_ЭтоКорректировка(ПсевдонимТаблицы);
	СФНалоговыйАгент_ЭтоНеКорректировка = "НЕ " + СФНалоговыйАгент_ЭтоКорректировка;
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураВыданный
		, ВидыЭД.СчетФактура
		, СФ_ЭтоНеКорректировка);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураВыданныйАванс
		, ВидыЭД.СчетФактура
		, СФАванс_ЭтоНеКорректировка);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураКомиссионеру
		, ВидыЭД.СчетФактура
		, СФКомиссионеру_ЭтоНеКорректировка);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураНалоговыйАгент
		, ВидыЭД.СчетФактура
		, СФНалоговыйАгент_ЭтоНеКорректировка);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураНаНеподтвержденнуюРеализацию0
		, ВидыЭД.СчетФактура
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураВыданный
		, ВидыЭД.КорректировочныйСчетФактура
		, СФ_ЭтоКорректировка);
		
	Если ИспользуетсяКорректировкаСчетаФактурыНаАванс() Тогда 
		
		ДобавитьВидДокументаДляОбмена(ВидыДокументов
			, Метаданные.Документы.СчетФактураВыданныйАванс
			, ВидыЭД.КорректировочныйСчетФактура
			, СФАванс_ЭтоКорректировка);
		
	КонецЕсли;
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетНаОплатуКлиенту
		, ВидыЭД.СчетНаОплату
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ЗаказКлиента
		, ВидыЭД.СчетНаОплату
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.РеализацияТоваровУслуг
		, ВидыЭД.СчетНаОплату
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.РеализацияТоваровУслуг
		, ВидыЭД.ТоварнаяНакладная
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.РеализацияТоваровУслуг
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.РеализацияУслугПрочихАктивов
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
	Если ИспользуетсяОтчетДавальцу() Тогда
		
		ДобавитьВидДокументаДляОбмена(ВидыДокументов
			, Метаданные.Документы.ОтчетДавальцу
			, ВидыЭД.АктОбОказанииУслуг
			, Неопределено);
		
	КонецЕсли;
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.КорректировкаРеализации
		, ВидыЭД.ТоварнаяНакладная
		, КРТУ_ЭтоНеКорректировка);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.КорректировкаРеализации
		, ВидыЭД.АктОбОказанииУслуг
		, КРТУ_ЭтоНеКорректировка);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.КорректировкаРеализации
		, ВидыЭД.СоглашениеОбИзмененииСтоимости
		, КРТУ_ЭтоКорректировка);
	
КонецПроцедуры

// Вызывается из Модуль_ИнтеграцияУниверсальный.ВидыВходящихДокументов.
//
// Параметры:
//  ВидыДокументов - ТаблицаЗначений - см. функцию Модуль_ИнтеграцияУниверсальный.ВидыВходящихДокументов;
//
Процедура ПриПолученииВидовВходящихДокументов(ВидыДокументов) Экспорт
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	
	СоответствиеРеквизитовСФ = НовоеПравилоКонвертацииСвойствЭД();
	СоответствиеРеквизитовСФ.Дата	 = "Дата";
	СоответствиеРеквизитовСФ.Номер	 = "Номер";
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураПолученный
		, ВидыЭД.СчетФактура
		, Неопределено
		, СоответствиеРеквизитовСФ);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураПолученныйАванс
		, ВидыЭД.СчетФактура
		, Неопределено
		, СоответствиеРеквизитовСФ);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПриобретениеТоваровУслуг
		, ВидыЭД.ТоварнаяНакладная
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПриобретениеУслугПрочихАктивов
		, ВидыЭД.ТоварнаяНакладная
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПриобретениеТоваровУслуг
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.ПриобретениеУслугПрочихАктивов
		, ВидыЭД.АктОбОказанииУслуг
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.СчетФактураПолученный
		, ВидыЭД.КорректировочныйСчетФактура
		, Неопределено);
	
	ДобавитьВидДокументаДляОбмена(ВидыДокументов
		, Метаданные.Документы.КорректировкаПриобретения
		, ВидыЭД.СоглашениеОбИзмененииСтоимости
		, Неопределено);
		
	Если МетодСервера(, "СуществуетОбъектМетаданных", "Документ.СчетФактураПолученныйНалоговыйАгент") Тогда
		
		ДобавитьВидДокументаДляОбмена(ВидыДокументов
			, Метаданные.Документы.СчетФактураПолученныйНалоговыйАгент
			, ВидыЭД.СчетФактура
			, Неопределено
			, СоответствиеРеквизитовСФ);
		
		ДобавитьВидДокументаДляОбмена(ВидыДокументов
			, Метаданные.Документы.СчетФактураПолученныйНалоговыйАгент
			, ВидыЭД.КорректировочныйСчетФактура
			, Неопределено
			, СоответствиеРеквизитовСФ);
		
	КонецЕсли;
	
КонецПроцедуры

