Процедура ЗаполнитьСтруктурированноеОписаниеАдреса(AddressContent, СведенияОбОрганизации, ЮрФизЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса = "")
	
	ВладелецКИ	 = ХранилищеКонтактнойИнформацииОбъекта(ЮрФизЛицо);
	ВидАдреса	 = ПолучитьВидКИ(ВладелецКИ, Юрадрес);
	Адрес		 = АдресЮрФизЛица(ВладелецКИ, ВидАдреса, ДатаДокумента);
	
	Если Не ЗначениеЗаполнено(Адрес.ЗначенияПолей) Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураАдреса = СведенияОбАдресе(Адрес.ЗначенияПолей);
	
	// Обертка для корректного заполнения адреса доставки (грузополучателя) по данным документа:
	// код страны определяем по фактическому адресу грузополучателя, а представление подставляем из документа
	Если ЗначениеЗаполнено(ПредставлениеАдреса) Тогда 
		СтруктураАдреса.СохраненноеПредставление = ПредставлениеАдреса;
	// используем пользовательское представление адреса	
	Иначе
		СтруктураАдреса.СохраненноеПредставление = ?(ЮрАдрес, СведенияОбОрганизации.ЮридическийАдрес, СведенияОбОрганизации.ФактическийАдрес);	
	КонецЕсли;
	
	Заполнить_AddressInfo(AddressContent, СтруктураАдреса);
	
КонецПроцедуры

Функция ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП(Организация)

	Возврат МетодСервера("Модуль_ИнтеграцияУниверсальный", "ПолучитьДатуНомерСвидетельстваОГосРегистрацииИП", Организация);
	
КонецФункции

Функция СформироватьПредставлениеКонтрагентаДляАкта(Организация, ДатаОперации)
	
	СведенияОбОрганизации = РеквизитыЮрФизЛица(Организация, ДатаОперации);
	Возврат ОтрезатьПравуюЗапятую(ДобавитьРазделитель(СведенияОбОрганизации.ПолноеНаименование) + ДобавитьРазделитель(СведенияОбОрганизации.ИНН, "ИНН: ") + ДобавитьРазделитель(СведенияОбОрганизации.КПП, "КПП: "));
	
КонецФункции

// Формирует структуру с данными, которые необходимы для визуализации ПФ счета на оплату. 
// Табличный документ формируется средствами Диадок
//
// Параметры:
//  СчетНаОплату - ДокументСсылка	- документ, на основании которого формируем печатную форму 
// 
// Возвращаемое значение:
//   Структура
//
Функция РезультатВизуализацииСчетаНаОплатуСредствамиДиадок(ДокСсылка, ПараметрыОтправкиНаСогласование =  Неопределено, ФИОПодписанта = "") Экспорт
	
	Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		ДокСсылкаДляПечати = ДокСсылка.ДокументОснование;
	Иначе
		ДокСсылкаДляПечати = ДокСсылка;	
	КонецЕсли;
	
	ДанныеШапки = ДанныеШапки(ДокСсылкаДляПечати);
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	
	Макет = ОбработкаОбъект.ПолучитьМакет("СчетНаОплату");
	Шапка1 = Макет.ПолучитьОбласть("ШапкаСчета1");
	Таб = Новый ТабличныйДокумент;
	
	МассивОбъектов= Новый Массив;
	МассивОбъектов.Добавить(ДокСсылка);
	
	Попытка
		ИмяТипаДокумента = ДокСсылка.Метаданные().Имя;
		СтруктураДанныхДляПечати = Документы[ИмяТипаДокумента].ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(, МассивОбъектов);
	Исключение
	КонецПопытки;
	
	Если СтруктураДанныхДляПечати <> Неопределено Тогда
		
		ВыборкаШапка = СтруктураДанныхДляПечати.РезультатПоШапке.Выбрать();
		ВыборкаШапка.Следующий();
		
		Шапка1.Параметры.БанкПолучателя 	 = ВыборкаШапка.НаименованиеБанка;
		Шапка1.Параметры.БИКБанкаПолучателя  = ВыборкаШапка.БИКБанк;
		Шапка1.Параметры.СчетБанкаПолучателя = ВыборкаШапка.КоррСчетБанка;
		Шапка1.Параметры.СчетПолучателя 	 = ВыборкаШапка.НомерБанковскогоСчета;
		
		СведенияОбОрганизации= РеквизитыЮрФизЛица(ВыборкаШапка.Организация, ВыборкаШапка.Дата);
		
		Шапка1.Параметры.ИННПолучателя 		 = СведенияОбОрганизации.ИНН;
		Шапка1.Параметры.КПППолучателя 		 = СведенияОбОрганизации.КПП;
		
		Если СведенияОбОрганизации.Свойство("НаименованиеДляПечатныхФорм") Тогда
			Шапка1.Параметры.Получатель		= СведенияОбОрганизации.НаименованиеДляПечатныхФорм;
		Иначе
			Шапка1.Параметры.Получатель 	= СведенияОбОрганизации.ПолноеНаименование;
		КонецЕсли;
		
	Иначе
		
		СведенияОбОрганизации = РеквизитыЮрФизЛица(ДанныеШапки.Организация, ДатаНомер.ДатаДокумента);
		Если ЗначениеЗаполнено(СведенияОбОрганизации.Банк) Тогда
			Шапка1.Параметры.БанкПолучателя 	 = СведенияОбОрганизации.Банк;
			Шапка1.Параметры.БИКБанкаПолучателя  = СведенияОбОрганизации.БИК;
			Шапка1.Параметры.СчетБанкаПолучателя = СведенияОбОрганизации.КоррСчет;
			Шапка1.Параметры.СчетПолучателя 	 = СведенияОбОрганизации.НомерСчета;
			Шапка1.Параметры.ИННПолучателя 		 = СведенияОбОрганизации.ИНН;
			Шапка1.Параметры.КПППолучателя 		 = СведенияОбОрганизации.КПП;
			Если СведенияОбОрганизации.Свойство("НаименованиеДляПечатныхФорм") Тогда
				Шапка1.Параметры.Получатель		= СведенияОбОрганизации.НаименованиеДляПечатныхФорм;
			Иначе
				Шапка1.Параметры.Получатель 	= СведенияОбОрганизации.ПолноеНаименование;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЕсли;
	
	Таб.Вывести(Шапка1);
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	НомерДокумента = ДатаНомер.НомерДокумента;
	ДатаДокумента  = ДатаНомер.ДатаДокумента;
	
	Шапка2 =  Макет.ПолучитьОбласть("ШапкаСчета2");
	Шапка2.Параметры.Заголовок = СтрШаблон("Счет на оплату № %1 от %2",
		НомерДокумента,
		Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
	Таб.Вывести(Шапка2);
	
	ОписаниеОрганизации = ПредставлениеЮрФизЛица(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм,ИНН,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет");
	Шапка3 =  Макет.ПолучитьОбласть("ШапкаСчета3");
	Шапка3.Параметры.Поставщик = ОписаниеОрганизации;
	Таб.Вывести(Шапка3);
	
	СведенияОбКонтрагенте = РеквизитыЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	
	ОписаниеКонтрагента = ПредставлениеЮрФизЛица(СведенияОбКонтрагенте, "НаименованиеДляПечатныхФорм,ИНН,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет");
	Шапка4 =  Макет.ПолучитьОбласть("ШапкаСчета4");
	Шапка4.Параметры.Покупатель = ОписаниеКонтрагента;
	Таб.Вывести(Шапка4);
	
	ВыводитьКолонкуСкидка = Ложь;

	Если ВыводитьКолонкуСкидка Тогда
		ШапкаТаблицы =  Макет.ПолучитьОбласть("ШапкаТаблицы");
		СтрокаТаблицы = Макет.ПолучитьОбласть("Строка");
	Иначе
		ШапкаТаблицы =  Макет.ПолучитьОбласть("ШапкаТаблицыБезСкидок");
		СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаБезСкидок");
	КонецЕсли;
	
	Таб.Вывести(ШапкаТаблицы);
	
	ЦенаВключаетНДС = ДанныеШапки.ЦенаВключаетНДС;
	
	СуммаВсего = 0;
	СуммаВсегоНДС = 0;
	ц = 0;
	
	ЕстьСтавкаБезНДС = Ложь;
	
	Если ЗначениеЗаполнено(СтруктураДанныхДляПечати) И СтруктураДанныхДляПечати.Свойство("РезультатПоТабличнойЧасти") Тогда
		
		Выборка = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать();
		
		ВсегоНаименований = Выборка.Количество();
		
		ЕстьСодержание = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Колонки.Найти("Содержание") <> Неопределено;
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТаблицы.Параметры.Заполнить(Выборка);
			
			Если ЕстьСодержание И ЗначениеЗаполнено(Выборка.Содержание) Тогда
				СтрокаТаблицы.Параметры.Товар = Выборка.Содержание;
			Иначе
				СтрокаТаблицы.Параметры.Товар = ?(ЗначениеЗаполнено(Выборка.НаименованиеПолное), Выборка.НаименованиеПолное, СокрЛП(Выборка.Номенклатура));
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Выборка.Артикул) Тогда
				СтрокаТаблицы.Параметры.Артикул = Выборка.Код;
			КонецЕсли; 
			
			Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Выборка.СтавкаНДС) Тогда
				ЕстьСтавкаБезНДС = Истина;
			КонецЕсли;
			
			Таб.Вывести(СтрокаТаблицы);
			
			СуммаВсего	  = СуммаВсего	  + Выборка.Сумма;
			СуммаВсегоНДС = СуммаВсегоНДС + Выборка.СуммаНДС;
			
		КонецЦикла; 
		
	Иначе
		
		ТаблицаТоваров = ПолучитьДанныеТЧ(ДокСсылкаДляПечати, Неопределено, Неопределено, Ложь);
		ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(ДанныеШапки, ТаблицаТоваров);
		
		Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
			МетодСервера(, "ЗаполнитьВТаблице_СтавкаНДС_ИсчНалАг", ТаблицаТоваров);
		КонецЕсли;
		
		ВсегоНаименований = ТаблицаТоваров.Количество();
		
		Для Каждого Стр Из ТаблицаТоваров Цикл
			
			Ц = Ц + 1;
			СтрокаТаблицы.Параметры.НомерСтроки = Ц;
			СтрокаТаблицы.Параметры.Артикул = Стр.КодНоменклатуры;
			СтрокаТаблицы.Параметры.Товар = Стр.НоменклатураПредставление;
			СтрокаТаблицы.Параметры.Количество = Стр.Количество;
			СтрокаТаблицы.Параметры.ЕдиницаИзмерения = Строка(Стр.ЕдиницаИзмерения);
			
			Если Стр.Цена = 0
				И Стр.Сумма <> 0
				И Стр.Количество <> 0 Тогда
				// Пропатчим цену. Запрос в функции "ПолучитьДанныеТЧ" вытаскивает документы не из Счета, а из РТУ, из ТЧ "Виды запасов", в которой нет цены.
				// Чтобы не ломать все остальное, посчитаем цену здесь
				Если ЦенаВключаетНДС Тогда
					Стр.Цена = Окр(Стр.Сумма / Стр.Количество, 2);
				Иначе
					Стр.Цена = Окр((Стр.Сумма - Стр.СуммаНДС) / Стр.Количество, 2);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТаблицы.Параметры.Цена = Стр.Цена;
			
			Если ЦенаВключаетНДС Тогда
				СтрокаТаблицы.Параметры.Сумма = Стр.сумма;
			Иначе	
				СтрокаТаблицы.Параметры.Сумма = Стр.сумма - Стр.СуммаНДС;
			КонецЕсли;
			
			Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
				ЕстьСтавкаБезНДС= Истина;
			КонецЕсли;
			
			СуммаВсего = СуммаВсего + Стр.Сумма;
			СуммаВсегоНДС = СуммаВсегоНДС + Стр.СуммаНДС;
			
			Таб.Вывести(СтрокаТаблицы);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Таб.Вывести(Подвал);
				
	Подвал = Макет.ПолучитьОбласть("ПодвалИтого");
	
	Подвал.Параметры.Всего = СуммаВсего;
	
	Таб.Вывести(Подвал);
	
	ПодвалНДС = Макет.ПолучитьОбласть("ПодвалНДС");
	Если ДанныеШапки.НДСИсчисляетсяНалоговымАгентом Тогда
		ПодвалНДС.Параметры.НДС = "НДС исчисляется налоговым агентом";
		ПодвалНДС.Параметры.ВсегоНДС = "-";	
	ИначеЕсли СуммаВсегоНДС <> 0 Тогда
		ПодвалНДС.Параметры.НДС = ?(ЦенаВключаетНДС, "В том числе НДС:", "Сумма НДС:");
		ПодвалНДС.Параметры.ВсегоНДС = Формат(СуммаВсегоНДС, "ЧЦ=15; ЧДЦ=2");
	Иначе
		ПодвалНДС.Параметры.НДС = "Без налога (НДС)";
		ПодвалНДС.Параметры.ВсегоНДС = "-";
	КонецЕсли;
	Таб.Вывести(ПодвалНДС);
	
	СуммаИтого = СуммаВсего + ?(ЦенаВключаетНДС, 0, СуммаВсегоНДС);
	
	ПодвалИтого = Макет.ПолучитьОбласть("ПодвалИтогоКОплате");
	ПодвалИтого.Параметры.ИтогоКОплате = СуммаИтого;
	Таб.Вывести(ПодвалИтого);
	
	ПодвалСуммаПрописью = Макет.ПолучитьОбласть("ПодвалСуммаПрописью");
	ПодвалСуммаПрописью.Параметры.ИтоговаяСтрока = "Всего наименований " + ВсегоНаименований
	+ ", на сумму "+ Формат(СуммаИтого, "ЧЦ=15; ЧДЦ=2") + " " + СокрП(ДанныеШапки.ВалютаДокумента);
	
	ПодвалСуммаПрописью.Параметры.СуммаПрописью = ЧислоПрописью(СуммаИтого, , МетодСервера("ПечатныеФормы", "ПараметрыИсчисленияВалюты", ДанныеШапки.ВалютаДокумента.Код));
	Таб.Вывести(ПодвалСуммаПрописью);
	
	ПодвалСчета = Макет.ПолучитьОбласть("ПодвалСчета");
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда 
		ПодвалСчета.Параметры.ФИОРуководителя = ?(ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта), ПараметрыОтправкиНаСогласование.ФИОПодписанта,
												?(ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПолучателя), ПараметрыОтправкиНаСогласование.ФИОПолучателя, "_"));
	Иначе 	
		ПодвалСчета.Параметры.ФИОРуководителя =  ФИОПодписанта;
	КонецЕсли;	
	Таб.Вывести(ПодвалСчета);
	
	Результат = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НовыйРезультатВизуализацииСчетаНаОплату");
	
	Результат.Таблица			= Таб;
	Результат.СписокОшибок		= "";
	Результат.ИмяФайла			= МетодСервера("Модуль_ИнтеграцияУниверсальный", "ИмяФайлаПечатнойФормы", "Счет", НомерДокумента, ДатаДокумента);
	Результат.Дата				= ДатаДокумента;
	Результат.Номер				= НомерДокумента;
	Результат.Сумма				= СуммаИтого;
	Результат.СуммаНДС			= СуммаВсегоНДС;
	Результат.ДокументБезНДС	= ?(ЕстьСтавкаБезНДС И СуммаВсегоНДС = 0, Истина, Ложь);
	
	Возврат Результат;	
	
КонецФункции //РезультатВизуализацииСчетаНаОплатуСредствамиДиадок()

Функция СформироватьМетуСчетаНаОплату(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		Документ = ДокументСсылка;
	Иначе
		Документ = ДокументСсылка.ДокументОснование;
	КонецЕсли;
	
	Шапка = ДанныеШапки(ДокументСсылка);
	ТабличнаяЧасть = ПолучитьДанныеТЧ(Документ, Неопределено, Неопределено, Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	МетаСчетаНаОплату = Новый Структура;
	МетаСчетаНаОплату.Вставить("Дата"		, ДатаНомер.ДатаДокумента);
	МетаСчетаНаОплату.Вставить("Номер"		, ДатаНомер.НомерДокумента);
	МетаСчетаНаОплату.Вставить("Сумма"		, Шапка.СуммаДокумента);
	МетаСчетаНаОплату.Вставить("СуммаНДС"	, ТабличнаяЧасть.Итог("СуммаНДС"));
	
	Возврат МетаСчетаНаОплату;
	
КонецФункции

Функция СформироватьМетуАктаВыполненныхРабот(ДокументСсылка) Экспорт
	
	Шапка			 = ДанныеШапки(ДокументСсылка);
	ТабличнаяЧасть	 = ПолучитьДанныеТЧ(ДокументСсылка, Неопределено, Неопределено, Ложь);
	ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть);
	
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	ТабличнаяЧасть.Колонки.Добавить("СуммаБезНДС");
	
	ИтогСумма=			0;
	ИтогСуммаБезНДС=	0;
	ЕстьСтавкаБезНДС= 	Ложь;
	
	Для каждого Стр Из ТабличнаяЧасть Цикл
		
		СуммаСНДС= 		(Стр.Сумма + ?(Шапка.ЦенаВключаетНДС, 0, Стр.СуммаНДС));
		СуммаБезНДС= 	СуммаСНДС - Стр.СуммаНДС;
		
		ИтогСумма=			ИтогСумма 		+ СуммаСНДС;
		ИтогСуммаБезНДС=	ИтогСуммаБезНДС + СуммаБезНДС;
		
		Если МенеджерИнтеграции_ЭтоСтавкаБезНДС(Стр.СтавкаНДС) Тогда
			ЕстьСтавкаБезНДС= Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	МетаАктаВыполненныхРабот = Новый Структура;
	МетаАктаВыполненныхРабот.Вставить("Дата"			, ДатаНомер.ДатаДокумента);
	МетаАктаВыполненныхРабот.Вставить("Номер"			, ДатаНомер.НомерДокумента);
	МетаАктаВыполненныхРабот.Вставить("Сумма"			, Шапка.СуммаДокумента);
	МетаАктаВыполненныхРабот.Вставить("СуммаНДС"		, ИтогСумма - ИтогСуммаБезНДС);
	МетаАктаВыполненныхРабот.Вставить("ДокументБезНДС"	, ?(ЕстьСтавкаБезНДС И (ИтогСумма - ИтогСуммаБезНДС) = 0, Истина, Ложь));
	
	Возврат МетаАктаВыполненныхРабот;
	
КонецФункции

Функция СформироватьМетуАктаСверки(ДокументСсылка) Экспорт
	
	МетаАктаСверки=	Новый Структура;
	МетаАктаСверки.Вставить("Дата", 	ДокументСсылка.Дата);
	МетаАктаСверки.Вставить("Номер", 	ПредставлениеНомераОбъекта(ДокументСсылка));
	
	Возврат МетаАктаСверки;
	
КонецФункции

// Возвращает значения реквизитов документа, которые используются
// для указания основания передачи.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на документ отгрузки.
// 
// Возвращаемое значение:
//  Структура - содержит реквизиты документа продажи:
//    * Договор
//    * Соглашение
//    * ЗаказКлиента
//    * Основание
//    * ОснованиеНомер
//    * ОснованиеДата
//
Функция РеквизитыДокументаДляПолученияСтруктурыОснованияПередачи(СсылкаНаДокумент)
	
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Договор");
	ИменаРеквизитов.Добавить("Соглашение");
	ИменаРеквизитов.Добавить("ЗаказКлиента");
	ИменаРеквизитов.Добавить("Основание");
	ИменаРеквизитов.Добавить("ОснованиеНомер");
	ИменаРеквизитов.Добавить("ОснованиеДата");
	
	МетаданныеДокумента = СсылкаНаДокумент.Метаданные();
	
	ТребуемыеРеквизиты = Новый Структура;
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеДокумента) Тогда
			ТребуемыеРеквизиты.Вставить(ИмяРеквизита);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, ТребуемыеРеквизиты);
	КонецЕсли;
	
	Результат.Вставить("Ссылка", СсылкаНаДокумент);
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение реквизита, который следует использовать в качестве 
// основания передачи. Это может быть заказ, договор или соглашение.
//
// Параметры:
//  РеквизитыДокумента - Структура - см. РеквизитыДокументаДляПолученияСтруктурыОснованияПередачи
// 
// Возвращаемое значение:
//  ЛюбаяСсылка	 - ссылка на заказ, договор или соглашение.
//  Неопределено - если у документа отсутствуют реквизиты, в которых указывается
//                 основание передачи, или ни один из этих реквизитов не заполнен.
//
Функция ОснованиеПередачиДокумента(РеквизитыДокумента)
	
	Если РеквизитыДокумента.Свойство("ЗаказКлиента")
		И ЗначениеЗаполнено(РеквизитыДокумента.ЗаказКлиента) Тогда
		
		Результат = РеквизитыДокумента.ЗаказКлиента;
		
	ИначеЕсли РеквизитыДокумента.Свойство("Договор")
		И ЗначениеЗаполнено(РеквизитыДокумента.Договор) Тогда
		
		Результат = РеквизитыДокумента.Договор;
		
	ИначеЕсли РеквизитыДокумента.Свойство("Соглашение")
		И ЗначениеЗаполнено(РеквизитыДокумента.Соглашение) Тогда
		
		Результат = РеквизитыДокумента.Соглашение;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует описание основания передачи с помощью программного
// интерфейса менеджера объекта. Так как программный интерфейс
// возвращает структуру, в которой отсутствует отдельное поле
// с названием вида основания передачи, в наименование основания
// дублируется его представление.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на документ отгрузки.
// 
// Возвращаемое значение:
//  Структура	 - см. НоваяСтруктураОснованияПередачи()
//  Неопределено - если в программном интерфейсе менеджера объекта
//                 отсутствует метод СтруктураОснованияДляПечати
//
Функция СтруктураОснованияДляПечати(СсылкаНаДокумент)
	
	МенеджерДокумента = Документы[СсылкаНаДокумент.Метаданные().Имя];
	
	Попытка
		СтруктураОснования = МенеджерДокумента.СтруктураОснованияДляПечати(СсылкаНаДокумент);
	Исключение
		СтруктураОснования = Неопределено;
	КонецПопытки;
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(СтруктураОснования) 
		И ЗначениеЗаполнено(СтруктураОснования.Основание) Тогда
		
		Результат = НоваяСтруктураОснованияПередачи(СсылкаНаДокумент);
		Результат.Presentation	 = СтруктураОснования.Основание;
		Результат.GroundName	 = СтруктураОснования.Основание;
		Результат.GroundNumber	 = СтруктураОснования.ОснованиеНомер;
		Результат.GroundDate	 = СтруктураОснования.ОснованиеДата;
		Результат.ПредставлениеВТекстеОшибки = "реквизитах печати";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует описание основания передачи по реквизитам объекта.
//
// Параметры:
//  ОснованиеПередачи - ЛюбаяСсылка - ссылка на объект, являющийся основанием-передачи.
// 
// Возвращаемое значение:
//  Структура	 - см. НоваяСтруктураОснованияПередачи()
//  Неопределено - если передан пустой параметр
//
Функция ОписаниеОснованияПередачи(ОснованиеПередачи)
	
	Если Не ЗначениеЗаполнено(ОснованиеПередачи) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеОснования = ОснованиеПередачи.Метаданные();
	ЭтоДокумент = ОбщегоНазначения.ЭтоДокумент(МетаданныеОснования);
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("GroundNumber"	, "Номер");
	ТребуемыеРеквизиты.Вставить("GroundDate"	, "Дата");
	
	Если Не ЭтоДокумент Тогда
		
		ВыражениеНаименование = "Наименование";
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("НаименованиеДляПечати", МетаданныеОснования) Тогда
			ВыражениеНаименование = "НаименованиеДляПечати";
		КонецЕсли;
		
		ТребуемыеРеквизиты.Вставить("GroundName"	, ВыражениеНаименование);
		ТребуемыеРеквизиты.Вставить("Presentation"	, ВыражениеНаименование);
		
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеПередачи, ТребуемыеРеквизиты);
	
	Результат = НоваяСтруктураОснованияПередачи(ОснованиеПередачи);
	ЗаполнитьЗначенияСвойств(Результат, ЗначенияРеквизитов);
	
	Если ЭтоДокумент Тогда
		Результат.GroundNumber = ПредставлениеНомера(Результат.GroundNumber);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.GroundName) Тогда
		Результат.GroundName = МетаданныеОснования.Синоним;
	КонецЕсли;
	
	Результат.GroundName	 = СокрЛП(Результат.GroundName);
	Результат.Presentation	 = СокрЛП(Результат.Presentation);
	
	Возврат Результат;
	
КонецФункции

// Инициализирует структуру, описывающую основание передачи товаров, работ, услуг.
//
// Параметры:
//  ОснованиеПередачи - ЛюбаяСсылка, Неопределено - источник сведений об основании передачи.
// 
// Возвращаемое значение:
//  Структура - содержит ключи:
//   * GroundName	 - Строка - Наименование документа-основания
//   * GroundNumber	 - Строка - Номер основания передачи
//   * GroundDate	 - Дата	  - Дата основания передачи
//   * Presentation	 - Строка - Представление документа-основания
//   * ОснованиеСсылка - ЛюбаяСсылка, Неопределено - источник сведений об основании передачи.
//   * ПредставлениеВТекстеОшибки - Строка - представление вида основания передачи в родительном падеже.
//                                  Используется при формировании сообщений в механизме валидации контента.
//
Функция НоваяСтруктураОснованияПередачи(ОснованиеПередачи = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("GroundName"		, "");
	Результат.Вставить("GroundNumber"	, "");
	Результат.Вставить("GroundDate"		, Дата(1, 1, 1));
	Результат.Вставить("Presentation"	, "");
	
	Результат.Вставить("ОснованиеСсылка"			, ОснованиеПередачи);
	Результат.Вставить("ПредставлениеВТекстеОшибки"	, "основании");
	
	Возврат Результат;
	
КонецФункции

// Удаляет из наименования основания сведения о дате и номере.
//
// Параметры:
//  ОписаниеОснованияПередачи - Структура - см. функцию НоваяСтруктураОснованияПередачи.
//
Процедура УдалитьДатуНомерИзНаименованияОснованияПередачи(ОписаниеОснованияПередачи)
	
	Если Не ЗначениеЗаполнено(ОписаниеОснованияПередачи) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОснованияПередачи.GroundDate)
		И ЗначениеЗаполнено(ОписаниеОснованияПередачи.GroundNumber) Тогда
		
		ПозНомера = Найти(ОписаниеОснованияПередачи.GroundName, "№");
		
		Если ПозНомера > 0 Тогда
			
			// Удаляем из наименования номер и дату, т.к. если они есть в реквизитах основания.
			ОписаниеОснованияПередачи.GroundName = СокрЛП(Лев(ОписаниеОснованияПередачи.GroundName, ПозНомера - 1));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, заполнено ли представление основания передачи.
// Если не заполнено, формирует представление наименованию, дате и номеру.
//
// Параметры:
//  ОписаниеОснованияПередачи - Структура - см. НоваяСтруктураОснованияПередачи.
//
Процедура ПроверитьЗаполнитьПредставлениеОснованияПередачи(ОписаниеОснованияПередачи)
	
	Если Не ЗначениеЗаполнено(ОписаниеОснованияПередачи) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОснованияПередачи.Presentation) Тогда
		Возврат;
	КонецЕсли;
	
	ЧастиПредставления = Новый Массив;
	ЧастиПредставления.Добавить(ОписаниеОснованияПередачи.GroundName);
	
	Если ЗначениеЗаполнено(ОписаниеОснованияПередачи.GroundNumber) Тогда
		ЧастиПредставления.Добавить("№");
		ЧастиПредставления.Добавить(ОписаниеОснованияПередачи.GroundNumber);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОснованияПередачи.GroundDate) Тогда
		ЧастиПредставления.Добавить("от");
		ЧастиПредставления.Добавить(Формат(ОписаниеОснованияПередачи.GroundDate, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	ОписаниеОснованияПередачи.Presentation = СтрСоединить(ЧастиПредставления, " ");
	
КонецПроцедуры

// Формирует структуру сведений об основании передачи товаров,
// услуг, работ по документу.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ передачи товаров, услуг, работ.
// 
// Возвращаемое значение:
//  Структура - см. НоваяСтруктураОснованияПередачи
//
Функция СтруктурированноеПредставлениеОснования(ДокументСсылка)
	
	РеквизитыДокумента = РеквизитыДокументаДляПолученияСтруктурыОснованияПередачи(ДокументСсылка);
	
	ЕстьРеквизитыДляПечати = РеквизитыДокумента.Свойство("Основание")
								И РеквизитыДокумента.Свойство("ОснованиеДата")
								И РеквизитыДокумента.Свойство("ОснованиеНомер");
	
	Если ЕстьРеквизитыДляПечати И ЗначениеЗаполнено(РеквизитыДокумента.Основание) Тогда
		
		// Использовать для заполенения реквизиты для печати
		Результат = НоваяСтруктураОснованияПередачи(ДокументСсылка);
		
		Результат.GroundName	 = РеквизитыДокумента.Основание;
		Результат.GroundNumber	 = РеквизитыДокумента.ОснованиеНомер;
		Результат.GroundDate	 = РеквизитыДокумента.ОснованиеДата;
		Результат.Presentation	 = РеквизитыДокумента.Основание;
		
		Результат.ПредставлениеВТекстеОшибки = "реквизитах печати";
		
	Иначе
		
		// Использовать программный интерфейс конфигурации
		Результат = СтруктураОснованияДляПечати(ДокументСсылка);
		
		Если Не ЗначениеЗаполнено(Результат) Тогда
			
			// Выбрать основание передачи из реквизитов документа (заказ, договор или соглашение)
			ОснованиеПередачи = ОснованиеПередачиДокумента(РеквизитыДокумента);
			
			// Сформировать описание основания передачи
			Результат = ОписаниеОснованияПередачи(ОснованиеПередачи);
			
		КонецЕсли;
		
	КонецЕсли;
	
	УдалитьДатуНомерИзНаименованияОснованияПередачи(Результат);
	ПроверитьЗаполнитьПредставлениеОснованияПередачи(Результат);
	
	Возврат Результат;
	
КонецФункции

// Формирует структуру сведений об основании передачи товаров, услуг, работ при заполнении УКД.
// Информация берется только из реквизитов печати или договора (в указанном порядке) 
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ передачи товаров, услуг, работ.
// 
// Возвращаемое значение:
//  Структура - см. НоваяСтруктураОснованияПередачи
//
Функция СтруктурированноеПредставлениеОснованияДляУКД(ДокументСсылка)
	
	РеквизитыДокумента = РеквизитыДокументаДляПолученияСтруктурыОснованияПередачи(ДокументСсылка);
	
	Результат = ОписаниеОснованияПоРеквизитамПечатиДокумента(РеквизитыДокумента);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Договор = СвойствоСтруктуры(РеквизитыДокумента, "Договор", Неопределено);
		
		Результат = ОписаниеОснованияПередачи(Договор);
		
	КонецЕсли;
	
	УдалитьДатуНомерИзНаименованияОснованияПередачи(Результат);
	ПроверитьЗаполнитьПредставлениеОснованияПередачи(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеОснованияПоРеквизитамПечатиДокумента(РеквизитыДокумента)
	
	Перем Результат;
	
	ЕстьРеквизитыДляПечати = РеквизитыДокумента.Свойство("Основание")
							И РеквизитыДокумента.Свойство("ОснованиеДата")
							И РеквизитыДокумента.Свойство("ОснованиеНомер");
	
	Если ЕстьРеквизитыДляПечати
		И ЗначениеЗаполнено(РеквизитыДокумента.Основание) Тогда
		
		// Использовать для заполенения реквизиты для печати
		Результат = НоваяСтруктураОснованияПередачи(РеквизитыДокумента.Ссылка);
		
		Результат.GroundName	 = РеквизитыДокумента.Основание;
		Результат.GroundNumber	 = РеквизитыДокумента.ОснованиеНомер;
		Результат.GroundDate	 = РеквизитыДокумента.ОснованиеДата;
		Результат.Presentation	 = РеквизитыДокумента.Основание;
		
		Результат.ПредставлениеВТекстеОшибки = "реквизитах печати";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСведенияОПередаче(Content, ДокументСсылка, ФункцияУПД, ДопПараметры)
	
	КоллекцияДокументНосительОснования = Новый Массив;
	
	Если ФункцияУПД = "СЧФДОП" ИЛИ ФункцияУПД = "СЧФ" Тогда
		
		МетаданныеДокумента = ДокументСсылка.Метаданные();
		
		// в этом случае параметр ДокументСсылка это Счет фактура выданный
		Если МетаданныеДокумента.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
			
			Для Каждого СтрокаТЧ Из ДокументСсылка.ДокументыОснования Цикл
				КоллекцияДокументНосительОснования.Добавить(СтрокаТЧ.ДокументОснование);	
			КонецЦикла;			
			
		ИначеЕсли МетаданныеДокумента.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
			КоллекцияДокументНосительОснования.Добавить(ДокументСсылка.ДокументОснование);
		КонецЕсли;
		
	Иначе
		// в этом случае параметр ДокументСсылка это документ реализации
		КоллекцияДокументНосительОснования.Добавить(ДокументСсылка);
	КонецЕсли;
	
	УказыватьОтсутствиеОснованияУПД = СвойствоСтруктуры(ДопПараметры, "УказыватьОтсутствиеОснованияУПД", Ложь);
	
	TransferBases = Content.TransferInfo.TransferBases;
	
	Для Каждого ДокументОснование Из КоллекцияДокументНосительОснования Цикл
		
		ДобавитьОснованиеПередачи = Истина;
		
		СтруктураОснования = СтруктурированноеПредставлениеОснования(ДокументОснование);
		
		TransferBase = СформироватьОписаниеОснованияПередачи(СтруктураОснования, УказыватьОтсутствиеОснованияУПД);
		
		TransferBaseЗаполнено = ОписаниеОснованияПередачиЗаполнено(TransferBase);
		Если TransferBaseЗаполнено Тогда
			ДобавитьОснованиеПередачи = КоллекцияСодержитОписаниеОснованияПередачи(TransferBases, TransferBase);
		КонецЕсли;
		
		Если TransferBaseЗаполнено 
			И ДобавитьОснованиеПередачи Тогда
			
			СлужебнаяИнформация = МетодСервера("Модуль_ИнтеграцияУниверсальный", "НоваяСлужебнаяИнформацияОснованияПередачи");
			
			Если ЗначениеЗаполнено(СтруктураОснования) Тогда
				СлужебнаяИнформация.ОснованиеСсылка	= СтруктураОснования.ОснованиеСсылка;
				СлужебнаяИнформация.ПредставлениеВТекстеОшибки	= СтруктураОснования.ПредставлениеВТекстеОшибки;
			КонецЕсли;
			
			ДополнитьКонтентСтрокиОснованийПередачиСлужебнойИнформацией(TransferBase, СлужебнаяИнформация);
			
			TransferBases.Добавить(TransferBase);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если TransferBases.Количество() = 0 Тогда
	
		TransferBase = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_TransferBase");
		Content.TransferInfo.TransferBases.Добавить(TransferBase);
			
		ЗаполнитьTransferBaseКакОтсутствует(TransferBase);
		
	КонецЕсли;
	
КонецПроцедуры

Функция КоллекцияСодержитОписаниеОснованияПередачи(TransferBases, TransferBase)
	
	Результат = Ложь;
	
	НайденноеОснование = МассивСтруктур_Найти(TransferBases, TransferBase);
	Если НайденноеОснование = Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеОснованияПередачиЗаполнено(TransferBase)
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(TransferBase)
		И ЗначениеЗаполнено(TransferBase.DocumentName) Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьОписаниеОснованияПередачи(ОписаниеОснования, УказыватьОтсутствиеОснованияУПД)
	
	Результат = Неопределено;
	
	Если ОписаниеОснования <> Неопределено Тогда
		
		Результат = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_TransferBase");
		
		Если Не ЗначениеЗаполнено(ОписаниеОснования.GroundDate) И УказыватьОтсутствиеОснованияУПД Тогда
			ЗаполнитьTransferBaseКакОтсутствует(Результат);
		Иначе
			ЗаполнитьTransferBaseПоДаннымОснования(Результат, ОписаниеОснования);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МассивСтруктур_Найти(Массив, ИскомаяСтруктура)
	
	Результат = Неопределено;
	
	Для Каждого СтруктураИзМассива Из Массив Цикл
		
		Результат = СтруктураИзМассива;

		Для Каждого ЭлементСтруктуры Из ИскомаяСтруктура Цикл

			ИмяСвойстваСтруктуры = ЭлементСтруктуры.Ключ;
			ИскомоеЗначение = ЭлементСтруктуры.Значение;

			Если СтруктураИзМассива[ИмяСвойстваСтруктуры] <> ИскомоеЗначение Тогда
				Результат = Неопределено;
				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьTransferBaseПоДаннымОснования(TransferBase, СтруктураОснования)
	
	TransferBase.DocumentName	= СтруктураОснования.GroundName;
	TransferBase.DocumentNumber	= СтруктураОснования.GroundNumber;
	TransferBase.DocumentDate	= СтруктураОснования.GroundDate;
	TransferBase.DocumentInfo	= "";
	
КонецПроцедуры

Процедура ЗаполнитьTransferBaseКакОтсутствует(TransferBase)
	
	TransferBase.DocumentName	= МетодСервера("Модуль_ИнтеграцияУниверсальный", "ДокументОснованиеОтгрузкиОтсутствует");
	TransferBase.DocumentNumber	= "";
	TransferBase.DocumentDate	= Дата(1, 1, 1);
	TransferBase.DocumentInfo	= "";

КонецПроцедуры

Процедура ЗаполнитьСтруктурированноеОписаниеГрузоотправителяГрузополучателя(OrganizationInfo, ЮрФизЛицо, ДатаДокумента, ПредставлениеАдреса = "")
	
	СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента);
	
	Если МетодСервера(, "ЕстьРеквизитИлиСвойствоОбъектаЛок", ЮрФизЛицо, "СтранаРегистрации") Тогда
		СведенияОбОрганизации.Вставить("СтранаРегистрации", ЮрФизЛицо.СтранаРегистрации);
	КонецЕсли;
	
	Если стрДлина(СведенияОбОрганизации.ИНН) <> 12 Тогда
		НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		ЭтоИП = Ложь;
	Иначе
		Если типЗнч(юрФизЛицо) = тип("СправочникСсылка.Организации") Тогда
			//для нашей организации - данные берем из нормализованного представления физлица
			НаименованиеОрганизации = юрФизЛицо.наименованиеПолное;
		Иначе
			НаименованиеОрганизации = СведенияОбОрганизации.ПолноеНаименование;
		КонецЕсли;
		
		ЭтоИП = Истина;
		
	КонецЕсли;
	
	OrganizationInfo.Name = НаименованиеОрганизации;
	OrganizationInfo.IsSoleProprietor = ЭтоИП;
	OrganizationInfo.SameAsSellerOrBuyer = Ложь;
	OrganizationInfo.Ссылка = ЮрФизЛицо;
	
	ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, Ложь, ДатаДокумента, ПредставлениеАдреса);
	
КонецПроцедуры

Функция ПолучитьГоловноеЮрлицо(ЮрФизЛицо)
	
	Результат = ЮрФизЛицо;
	
	Если ЭтоОбособленноеПодразделение(ЮрФизЛицо) Тогда 
		
		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.РегистрацииВНалоговомОргане") Тогда
			ИмяРеквизита = "Владелец";
		ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
			ИмяРеквизита = "ГоловнойКонтрагент";
		Иначе 
			ИмяРеквизита = "ГоловнаяОрганизация";
		КонецЕсли;
		
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, ИмяРеквизита);
		
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

Процедура ЗаполнитьСтруктурированоеОписаниеЮрФизЛица(OrganizationInfo, ЮрФизЛицо, ДатаДокумента, БанковскийСчетОрганизации = Неопределено,  ЮрАдрес, АдресДляСФ = Ложь, КППГрузоотправителя = "", ПредставлениеАдреса = "")

	СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента,  БанковскийСчетОрганизации);
	
	ЗаполнитьИнформациюОбОрганизации(OrganizationInfo, СведенияОбОрганизации);
	ЗаполнитьСтруктурированноеОписаниеАдреса(OrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, ЮрАдрес, ДатаДокумента, ПредставлениеАдреса);
	
	OrganizationInfo.вставить("Ссылка", ЮрФизЛицо);

КонецПроцедуры

Процедура Заполнить_ExtendedOrganizationInfo(ExtendedOrganizationInfo, ЮрФизЛицо, ДатаДокумента, ЭтоПродавец = Ложь, БанковскийСчет= Неопределено, КППГрузоотправителя = "", ОбособленноеПодразделение = Неопределено, ПредставлениеАдреса = "")
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда 
		
		Если ЭтоПродавец Тогда 
			СведенияОбОрганизации = РеквизитыПродавца(ЮрФизЛицо, ДатаДокумента, БанковскийСчет, ОбособленноеПодразделение);
		Иначе 
			СведенияОбОрганизации = РеквизитыГрузоотправителя(ЮрФизЛицо, ДатаДокумента, БанковскийСчет, ОбособленноеПодразделение);
		КонецЕсли;
		
		ИсточникСведений = ?(ЗначениеЗаполнено(ОбособленноеПодразделение), ОбособленноеПодразделение, ЮрФизЛицо); // Вероятно, используется в ПМ
		ExtendedOrganizationInfo.Вставить("Ссылка", ИсточникСведений);
		
	Иначе 
		
		СведенияОбОрганизации = РеквизитыЮрФизЛица(ЮрФизЛицо, ДатаДокумента, БанковскийСчет);
		ExtendedOrganizationInfo.Вставить("Ссылка", ЮрФизЛицо);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КППГрузоотправителя) Тогда
		СведенияОбОрганизации.КПП = КППГрузоотправителя;
	КонецЕсли;
	
	ЗаполнитьИнформациюОбОрганизации(ExtendedOrganizationInfo, СведенияОбОрганизации);
	ЗаполнитьСтруктурированноеОписаниеАдреса(ExtendedOrganizationInfo.Address, СведенияОбОрганизации, ЮрФизЛицо, ЭтоПродавец, ДатаДокумента, ПредставлениеАдреса);
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда 
		ExtendedOrganizationInfo.Okdp = ЮрФизЛицо.КодОКВЭД;
	КонецЕсли;
	
	Если ExtendedOrganizationInfo.Type = "IndividualEntity"
		И ДатаДокумента >= ДатаРедакции425() Тогда
		
		Если ЮрФизЛицо.Метаданные().Реквизиты.Найти("ДатаРегистрации") <> Неопределено Тогда
			ДатаРегистрацииОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "ДатаРегистрации");
		Иначе
			ДатаРегистрацииОрганизации = "";
		КонецЕсли;
		
		ExtendedOrganizationInfo.IndividualEntityRegistrationCertificate = СтрокаНомерСВ_2026(
			СведенияОбОрганизации.ОГРН,
			ДатаРегистрацииОрганизации
		);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаРедакции425()
	
	Возврат '20260101';
	
КонецФункции

Функция СтрокаНомерСВ_2026(ОГРН, ДатаРегистрации)
	
	ШаблонСтрокиНомерСВ = "%1;%2";
	
	Результат = СтрШаблон(
		ШаблонСтрокиНомерСВ,
		ОГРН,
		ДатаСтрокойЛок(ДатаРегистрации)
	);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаСтрокойЛок(ДатаСтрока)
	
	ПустоеЗначение = "";
	
	Если ПустаяСтрока(ДатаСтрока) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Попытка
		Значение = Дата(ДатаСтрока);
	Исключение
		Значение = ДатаСтрока;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	
КонецФункции

