Функция ПредставлениеНомера(НомерОбъекта)
	
	Результат = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерОбъекта, Ложь, Ложь);
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеНомераОбъекта(СсылкаНаОбъект)
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	РеквизитыОбъекта = Новый Структура;
	РеквизитыОбъекта.Вставить("Номер");
	
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ПредставлениеНомера") Тогда
		РеквизитыОбъекта.Вставить("ПредставлениеНомера");
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, РеквизитыОбъекта);
	
	Если ЗначенияРеквизитов.Свойство("ПредставлениеНомера") Тогда
		Результат = ЗначенияРеквизитов.ПредставлениеНомера;
	Иначе
		НомерОбъекта = ЗначенияРеквизитов.Номер;
		Результат = ПредставлениеНомера(НомерОбъекта);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВсеДокументыОснования(СсылкаНаОбъект)
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ИмяДокумента = МетаданныеОбъекта.Имя;
	
	ИмяМетаданныхТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Результат = Новый Массив;
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ИмяМетаданныхТаблицыОснований) Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ПолноеИмяТаблицы = СтрЗаменить("Документ.%ИмяДокумента%.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяТаблицы);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.ДокументОснование);
		КонецЦикла;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ДокументОснование") Тогда
		
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "ДокументОснование");
		Результат.Добавить(Основание);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает документ-основание произвольного документа.
// Если оснований несколько, берется только первое.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - произвольный документ, основание которого требуется получить.
// 
// Возвращаемое значение:
//  ДокументСсылка - документ-основание.
//
Функция ПервыйДокументОснование(СсылкаНаДокумент)
	
	Результат = Неопределено;
	
	МетаданныеДокумента	 = СсылкаНаДокумент.Метаданные();
	ИмяДокумента		 = МетаданныеДокумента.Имя;
	
	ПолноеИмяТаблицыОснований = СтрЗаменить("Документ.%ИмяДокумента%.ТабличнаяЧасть.ДокументыОснования", "%ИмяДокумента%", ИмяДокумента);
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ПолноеИмяТаблицыОснований) Тогда 
	
		ТекстЗапроса = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.%ИмяДокумента%.ДокументыОснования КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяДокумента%", ИмяДокумента);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			Результат = Выборка.ДокументОснование;
		КонецЕсли;
		
	ИначеЕсли ЕстьРеквизитМетаданных(МетаданныеДокумента, "ДокументОснование") Тогда 
		
		Результат = МетодСервера(, "ЗначениеРеквизитаОбъекта", СсылкаНаДокумент, "ДокументОснование");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет реквизиты шапки счета на оплату значениями реквизитов документа-основания.
// Для печати счета на оплату многие реквизиты берутся из его документа-основания.
//
// Параметры:
//  ДанныеСчетаНаОплату - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаНаОплатуПоДокументуОснованию(ДанныеСчетаНаОплату)
	
	СсылкаНаОбъект = ДанныеСчетаНаОплату.ОписаниеДокумента.Ссылка;
	ДокументОснование = ПервыйДокументОснование(СсылкаНаОбъект);
	ДанныеДокументаОснования = ДанныеШапки(ДокументОснование);
	
	КопируемыеРеквизиты = Новый Массив;
	КопируемыеРеквизиты.Добавить("ХозяйственнаяОперация");
	КопируемыеРеквизиты.Добавить("НалогообложениеНДС");
	КопируемыеРеквизиты.Добавить("БанковскийСчетКонтрагента");
	КопируемыеРеквизиты.Добавить("ЦенаВключаетНДС");
	КопируемыеРеквизиты.Добавить("АдресДоставки");
	
	Для Каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл 
		
		Если ЗначениеЗаполнено(ДанныеДокументаОснования[ИмяРеквизита]) Тогда 
			ДанныеСчетаНаОплату.Вставить(ИмяРеквизита, ДанныеДокументаОснования[ИмяРеквизита]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Дополняет реквизиты шапки счета-фактуры комиссионеру.
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаФактурыКомиссионеру(Шапка)
	
	ОписаниеДокумента = Шапка.ОписаниеДокумента;
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СФКомиссионеру.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ДанныеКонтрагента.ОбособленноеПодразделение, ЛОЖЬ)
	|			ТОГДА ДанныеКонтрагента.ГоловнойКонтрагент
	|		ИНАЧЕ ТЧПокупатели.Покупатель
	|	КОНЕЦ КАК Покупатель,
	|	ВЫБОР
	|		КОГДА ТЧПокупатели.ИННПокупателя ПОДОБНО """"
	|			ТОГДА ВЫБОР
	|					КОГДА ТЧПокупатели.Покупатель ССЫЛКА Справочник.Контрагенты
	|						ТОГДА ЕСТЬNULL(ДанныеКонтрагента.ИНН, """")
	|					КОГДА НЕ ДанныеОрганизацийПокупатель.Ссылка ЕСТЬ NULL
	|						ТОГДА ЕСТЬNULL(ДанныеОрганизацийПокупатель.ИНН, """")
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		ИНАЧЕ ТЧПокупатели.ИННПокупателя
	|	КОНЕЦ КАК ПокупательИНН,
	|	ВЫБОР
	|		КОГДА ТЧПокупатели.КПППокупателя ПОДОБНО """"
	|			ТОГДА ВЫБОР
	|					КОГДА ТЧПокупатели.Покупатель ССЫЛКА Справочник.Контрагенты
	|						ТОГДА """"
	|					КОГДА НЕ ДанныеОрганизацийПокупатель.Ссылка ЕСТЬ NULL
	|						ТОГДА ЕСТЬNULL(ДанныеОрганизацийПокупатель.КПП, """")
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		ИНАЧЕ ТЧПокупатели.КПППокупателя
	|	КОНЕЦ КАК ПокупательКПП,
	|	ТЧПокупатели.Покупатель КАК Грузополучатель
	|ИЗ
	|	Документ.СчетФактураКомиссионеру.Покупатели КАК ТЧПокупатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураКомиссионеру КАК СФКомиссионеру
	|		ПО (СФКомиссионеру.Ссылка = ТЧПокупатели.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК ДанныеКонтрагента
	|		ПО (ДанныеКонтрагента.Ссылка = ТЧПокупатели.Покупатель)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ДанныеОрганизацийПокупатель
	|		ПО (ДанныеОрганизацийПокупатель.Ссылка = ТЧПокупатели.Покупатель)
	|ГДЕ
	|	СФКомиссионеру.Ссылка = &СсылкаНаОбъект";
	
	Если 	ЭтоСчетФактураНаРеализациюЧерезКомиссионера(СсылкаНаОбъект)
		Или ЭтоСчетФактураНаРеализациюЧерезКомиссионера_25(СсылкаНаОбъект) Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса
			, "Документ.СчетФактураКомиссионеру"
			, "Документ.СчетФактураВыданный");
	
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Количество() > 1 Тогда
			
			ОписаниеОш = НСтр("ru = 'Отправка сводных счетов-фактур не поддерживается!';
			|en = 'Отправка сводных счетов-фактур не поддерживается!'");
			Шапка.ОшибкиВДанных.Добавить(ОписаниеОш);
			
		Иначе
			
			Выборка.Следующий();
			
			Шапка.Контрагент	  = Выборка.Покупатель;
			Шапка.КонтрагентИНН	  = Выборка.ПокупательИНН;
			Шапка.КонтрагентКПП	  = Выборка.ПокупательКПП;
			Шапка.Грузополучатель = Выборка.Грузополучатель;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет реквизиты шапки счета-фактуры значениями реквизитов документа-основания.
// Для печати счета-фактуры многие реквизиты берутся из его документа-основания.
//
// Параметры:
//  ДанныеСчетаФактуры - Структура - см. функцию ДанныеШапки.
//
Процедура ДополнитьШапкуСчетаФактурыПоДокументуОснованию(ДанныеСчетаФактуры)
	
	СсылкаНаОбъект = ДанныеСчетаФактуры.ОписаниеДокумента.Ссылка;
	
	ДокументОснование		 = ПервыйДокументОснование(СсылкаНаОбъект);
	ДанныеДокументаОснования = ДанныеШапки(ДокументОснование);
	
	КопируемыеРеквизиты = Новый Массив;
	КопируемыеРеквизиты.Добавить("ХозяйственнаяОперация");
	КопируемыеРеквизиты.Добавить("Грузополучатель");
	КопируемыеРеквизиты.Добавить("Грузоотправитель");
	КопируемыеРеквизиты.Добавить("ВалютаДокумента");
	КопируемыеРеквизиты.Добавить("ВалютаДокументаКод");
	КопируемыеРеквизиты.Добавить("НалогообложениеНДС");
	КопируемыеРеквизиты.Добавить("БанковскийСчетОрганизации");
	КопируемыеРеквизиты.Добавить("БанковскийСчетКонтрагента");
	КопируемыеРеквизиты.Добавить("БанковскийСчетГрузоотправителя");
	КопируемыеРеквизиты.Добавить("БанковскийСчетГрузополучателя");
	КопируемыеРеквизиты.Добавить("ЦенаВключаетНДС");
	КопируемыеРеквизиты.Добавить("АдресДоставки");
	КопируемыеРеквизиты.Добавить("ОбособленноеПодразделение");
	КопируемыеРеквизиты.Добавить("ЦифровойИндексОбособленногоПодразделения");
	
	Для Каждого ИмяРеквизита Из КопируемыеРеквизиты Цикл 
		
		Если ЗначениеЗаполнено(ДанныеДокументаОснования[ИмяРеквизита]) Тогда 
			ДанныеСчетаФактуры.Вставить(ИмяРеквизита, ДанныеДокументаОснования[ИмяРеквизита]);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоСчетФактураКомиссионеру(СсылкаНаДокумент)

	Результат = Ложь;
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СчетФактураКомиссионеру") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ЭтоСчетФактураНаРеализациюЧерезКомиссионера(СсылкаНаДокумент)

	Результат = Ложь;
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") 
		И ИспользуетсяРеализацияЧерезКомиссионера() Тогда
		
		Реквизиты = ЗначенияРеквизитовОбъектаЛокальная(СсылкаНаДокумент, "ДокументОснование,РеализацияЧерезКомиссионера");
		
		Если НЕ ЭтоНакладная(Реквизиты.ДокументОснование) Тогда
		
			Результат = Реквизиты.РеализацияЧерезКомиссионера;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактураНаРеализациюЧерезКомиссионера_25(СсылкаНаДокумент)
	
	Результат = Ложь;
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") 
		И ИспользуетсяРеализацияЧерезКомиссионера() Тогда
		
		ОснованиеСФ = ПервыйДокументОснование(СсылкаНаДокумент);
		
		Если ЭтоНакладная(ОснованиеСФ) Тогда
			
			Реквизиты = ЗначенияРеквизитовОбъектаЛокальная(ОснованиеСФ, "ХозяйственнаяОперация");
			
			ЭтоОперацияРеализацияЧерезКомиссионера = (Реквизиты.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияЧерезКомиссионера"));
			
			Если ЭтоОперацияРеализацияЧерезКомиссионера Тогда
				
				Результат = Истина;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактура(ОписаниеМетаданных)
	
	ТипПараметра = ТипЗнч(ОписаниеМетаданных);
	
	Если ТипПараметра = Тип("ОбъектМетаданных") Тогда
		ОбъектМетаданных = ОписаниеМетаданных;
	ИначеЕсли ТипПараметра = Тип("Тип") Тогда
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ОписаниеМетаданных);
	ИначеЕсли ТипПараметра = Тип("Строка") Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ОписаниеМетаданных);
	Иначе // Ссылка или объект
		ОбъектМетаданных = ОписаниеМетаданных.Метаданные();
	КонецЕсли;
	
	ИменаСчетовФактур = Новый Массив;
	ИменаСчетовФактур.Добавить("СчетФактураВыданный");
	ИменаСчетовФактур.Добавить("СчетФактураВыданныйАванс");
	ИменаСчетовФактур.Добавить("СчетФактураКомиссионеру");
	ИменаСчетовФактур.Добавить("СчетФактураКомитента");
	ИменаСчетовФактур.Добавить("СчетФактураНалоговыйАгент");
	ИменаСчетовФактур.Добавить("СчетФактураНаНеподтвержденнуюРеализацию0");
	
	Результат = (ИменаСчетовФактур.Найти(ОбъектМетаданных.Имя) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ДокументРеализацииСодержитТолькоУслуги(СсылкаНаОбъект)
	
	ШаблонЗапроса =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(ВЫБОР
		|			КОГДА ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ), Ложь) КАК ЕстьУслуги,
		|	ЕСТЬNULL(МАКСИМУМ(ВЫБОР
		|			КОГДА НЕ ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ), Ложь) КАК ЕстьТовары
		|ИЗ
		|	&ПолноеИмяТаблицы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ТипыНоменклатурыУслуги", ТипыНоменклатурыУслуги());
	
	ПолноеИмяТаблицы = СтрШаблон("%1.%2"
			, СсылкаНаОбъект.Метаданные().ПолноеИмя()
			, "Товары");
	
	Запрос.Текст = СтрЗаменить(ШаблонЗапроса
			, "&ПолноеИмяТаблицы"
			, ПолноеИмяТаблицы);
	
	Результат = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЕстьУслуги И НЕ Выборка.ЕстьТовары;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ДокументПродажи_ОплатаВВалюте(ПсевдонимТаблицы)
	
	Если ЭтоРедакция11_5() Тогда
		
		Результат = "ПсевдонимТаблицы.ОплатаВВалюте";
		
	Иначе
		
		Результат =
		"ВЫБОР
		|	КОГДА ПсевдонимТаблицы.ПорядокОплаты В (ЗНАЧЕНИЕ(Перечисление.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте), ЗНАЧЕНИЕ(Перечисление.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВВалюте))
		|		ТОГДА ИСТИНА
		|	ИНАЧЕ ЛОЖЬ
		|КОНЕЦ";
		
	КонецЕсли;
	
	ПодставитьПсевдонимТаблицыВВыражениеЗапроса(Результат, ПсевдонимТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаОбъект)
	
	ТипСсылки = ТипЗнч(СсылкаНаОбъект);
	Если ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИспользуетсяПередачаТоваровХранителю() 
		И ТипСсылки = Тип("ДокументСсылка.ПередачаТоваровХранителю") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДокументПродажи = СсылкаНаОбъект;
	Если ЭтоСчетФактура(СсылкаНаОбъект) Тогда
		ДокументПродажи = ПервыйДокументОснование(СсылкаНаОбъект);
	КонецЕсли;
	
	МетаданныеОбъекта = ДокументПродажи.Метаданные();
	
	ТипДокументаПродажи = ТипЗнч(ДокументПродажи);
	
	ПсевдонимТаблицы = "";
	Если ТипДокументаПродажи = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ПсевдонимТаблицы = "ДокументОснование";
	КонецЕсли;
	
	ПолеВалюта = "Валюта";
	ПолеВалютаВзаиморасчетов = "Валюта";
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ВалютаВзаиморасчетов") Тогда
		ПолеВалютаВзаиморасчетов = "ВалютаВзаиморасчетов";
	КонецЕсли;
	
	Если ТипДокументаПродажи = Тип("ДокументСсылка.ВозвратТоваровМеждуОрганизациями") Тогда
		ПолеОплатаВВалюте = "ЛОЖЬ";
	Иначе
		ПолеОплатаВВалюте = ТекстЗапроса_ДокументПродажи_ОплатаВВалюте(ПсевдонимТаблицы);
	КонецЕсли;
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Валюта", ПолеВалюта);
	ТребуемыеРеквизиты.Вставить("ВалютаВзаиморасчетов", ПолеВалютаВзаиморасчетов);
	ТребуемыеРеквизиты.Вставить("ОплатаВВалюте", ПолеОплатаВВалюте);
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПродажи, ТребуемыеРеквизиты);
	
	ВалютаРегл = ВалютаРегламентированногоУчета();
	
	Результат = (ЗначенияРеквизитов.Валюта <> ВалютаРегл
				 Или ЗначенияРеквизитов.ВалютаВзаиморасчетов <> ВалютаРегл)
				И Не ЗначенияРеквизитов.ОплатаВВалюте;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьЗаполнитьВалюту(Шапка)
	
	СсылкаНаОбъект = Шапка.ОписаниеДокумента.Ссылка;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданныйАванс")
		Или ПересчитыватьВВалютуРегламентированногоУчета(СсылкаНаОбъект) Тогда
		
		ВалютаРегл = ВалютаРегламентированногоУчета();
		Шапка.ВалютаДокумента	 = ВалютаРегл;
		Шапка.ВалютаДокументаКод = ВалютаРегл.Код;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоОбособленноеПодразделение(ЮрФизЛицо)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	МетаданныеОбъекта = ЮрФизЛицо.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, "ОбособленноеПодразделение", Ложь) Тогда 
		
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "ОбособленноеПодразделение");
		
	ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.РегистрацииВНалоговомОргане") Тогда 
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РегистрацияПодразделенияВНалоговомОргане(Подразделение, Организация, ДатаДокумента)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(Подразделение) 
		Или ТипЗнч(Подразделение) <> Тип("СправочникСсылка.СтруктураПредприятия") Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда 
		
		ТекстОшибки = НСтр("ru = 'Ошибка при получении сведений об обособленном подразделении ""%1"":
                            |Не указана организация!'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Строка(Подразделение));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если СравнитьВерсии(ВерсияУТ, "11.5.9.116") >= 0 Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
		|			&Дата,
		|			Подразделение = &Подразделение
		|				И Организация = &Организация) КАК Т";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане КАК Т
		|ГДЕ
		|	Т.Подразделение = &Подразделение
		|	И Т.Организация = &Организация";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Подразделение"	, Подразделение);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("Дата"			, ДатаДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Результат = Выборка.РегистрацияВНалоговомОргане;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыПродавца(Организация, Период, БанковскийСчет, ОбособленноеПодразделение)
	
	РеквизитыОрганизации = РеквизитыЮрФизЛица(Организация, Период, БанковскийСчет);
	
	Если ЗначениеЗаполнено(ОбособленноеПодразделение) Тогда 
		
		РеквизитыПодразделения = РеквизитыЮрФизЛица(ОбособленноеПодразделение, Период);
		
		РеквизитыОрганизации.КПП = РеквизитыПодразделения.КПП;
		
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

Функция РеквизитыГрузоотправителя(Организация, Период, БанковскийСчет, ОбособленноеПодразделение)
	
	РеквизитыОрганизации = РеквизитыЮрФизЛица(Организация, Период, БанковскийСчет);
	
	Если ЗначениеЗаполнено(ОбособленноеПодразделение) Тогда 
		
		РеквизитыПодразделения = РеквизитыЮрФизЛица(ОбособленноеПодразделение, Период);
		
		КопируемыеРеквизиты = Новый Массив;
		КопируемыеРеквизиты.Добавить("Представление");
		КопируемыеРеквизиты.Добавить("СокращенноеНаименование");
		КопируемыеРеквизиты.Добавить("ПолноеНаименование");
		КопируемыеРеквизиты.Добавить("НаименованиеДляПечатныхФорм");
		КопируемыеРеквизиты.Добавить("КПП");
		КопируемыеРеквизиты.Добавить("КодПоОКПО");
		КопируемыеРеквизиты.Добавить("ФактическийАдрес");
		КопируемыеРеквизиты.Добавить("ЗначенияПолейФактическийАдрес");
		
		Для Каждого ИмяСвойства Из КопируемыеРеквизиты Цикл 
			РеквизитыОрганизации[ИмяСвойства] = РеквизитыПодразделения[ИмяСвойства]
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РеквизитыОрганизации;
	
КонецФункции

Процедура ЗаполнитьИнформациюОбОрганизации(СведенияОбОрганизации, РеквизитыОрганизации)
	
	#Область ОбщиеСвойства
	СведенияОбОрганизации.Name	 = РеквизитыОрганизации.НаименованиеДляПечатныхФорм;
	СведенияОбОрганизации.Inn	 = РеквизитыОрганизации.ИНН;
	СведенияОбОрганизации.Kpp	 = РеквизитыОрганизации.КПП;
	СведенияОбОрганизации.Okpo	 = РеквизитыОрганизации.КодПоОкпо;
	СведенияОбОрганизации.Phone	 = РеквизитыОрганизации.Телефоны;
	
	СведенияОбОрганизации.BankAccountNumber		 = СокрЛП(РеквизитыОрганизации.НомерСчета);
	СведенияОбОрганизации.BankId				 = СокрЛП(РеквизитыОрганизации.БИК);
	СведенияОбОрганизации.BankName				 = ?(ЗначениеЗаполнено(РеквизитыОрганизации.Банк), Строка(РеквизитыОрганизации.Банк), ""); // в некоторых случаях Банк возвращается как ссылка на справочник и компонента игнорирует такое значение, теряя данные, поэтому значение Банк преобразовано к строке 
	#КонецОбласти
	
	ТипОрганизации = ЮрФизЛицо_ТипОрганизацииДляКонтента(РеквизитыОрганизации);
	
	#Область Свойства_ExtendedOrganizationInfo
	Если СведенияОбОрганизации.Свойство("CorrespondentAccount") Тогда 
		СведенияОбОрганизации.CorrespondentAccount = РеквизитыОрганизации.КоррСчет;
	КонецЕсли;
	
	Если СведенияОбОрганизации.Свойство("Email") Тогда
		СведенияОбОрганизации.Email = РеквизитыОрганизации.Email;
	КонецЕсли;
	
	Если СведенияОбОрганизации.Свойство("Type") Тогда 
		СведенияОбОрганизации.Type = ТипОрганизации;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыОрганизации.Свидетельство)
		И СведенияОбОрганизации.Свойство("IndividualEntityRegistrationCertificate") Тогда
		СведенияОбОрганизации.IndividualEntityRegistrationCertificate = РеквизитыОрганизации.Свидетельство;
	КонецЕсли;
	#КонецОбласти
	
	#Область Свойства_OrganizationInfo
	Если СведенияОбОрганизации.Свойство("IsSoleProprietor") Тогда 
		СведенияОбОрганизации.IsSoleProprietor = (ТипОрганизации = "IndividualEntity");
	КонецЕсли;
	#КонецОбласти
	
КонецПроцедуры

Функция ЮрФизЛицо_ТипОрганизацииДляКонтента(Реквизиты, УДАЛИТЬ_ЭтоИП = Неопределено, УДАЛИТЬ_СтранаРегистрацииКод = Неопределено)
	
	Если ЗначениеЗаполнено(Реквизиты.СтранаРегистрации)
		И Реквизиты.СтранаРегистрации <> Справочники.СтраныМира.Россия
		И Не ЗначениеЗаполнено(Реквизиты.ИНН) Тогда
		Результат = "ForeignEntity";
	ИначеЕсли Реквизиты.ТипЮрФизЛица = ТипыЮрФизЛиц().ФизическоеЛицо Тогда 
		Результат = "IndividualEntity";
	Иначе 
		Результат = "LegalEntity";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура АктуализироватьРасчетыСКонтрагентами(ДанныеШапки)
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если ДанныеШапки.ВалютаДокумента = ВалютаРегламентированногоУчета()
		Или СравнитьВерсии(ВерсияУТ, "11.4.1") < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	
	Если НоваяАрхитектураВзаиморасчетов() Тогда
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(СсылкаНаОбъект);
		
		Если ЭтоРедакция11_5() Тогда
			РегистрыСведений.СуммыДокументовВВалютахУчета.РассчитатьСуммыДокументовВВалютахУчета(МассивДокументов);
		Иначе
			РегистрыСведений.СуммыДокументовВВалютеРегл.РассчитатьСуммыДокументовВВалютеРегл(МассивДокументов);
		КонецЕсли;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РасчетыСКлиентами.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
		|
		|ГДЕ
		|	РасчетыСКлиентами.Регистратор = &Ссылка
		|	И РасчетыСКлиентами.Активность
		|";
		ТаблицаАналитик = Запрос.Выполнить().Выгрузить();
		МассивАналитикУчетаПоПартнерам = ТаблицаАналитик.ВыгрузитьКолонку("АналитикаУчетаПоПартнерам");
		
		МодульРаспределениеВзаиморасчетовВызовСервера = ОбщегоНазначения.ОбщийМодуль("РаспределениеВзаиморасчетовВызовСервера");
		
		Если МассивАналитикУчетаПоПартнерам.Количество() > 0 Тогда
			
			ОкончаниеПериодаРасчета = КонецМесяца(ОписаниеДокумента.Дата) + 1;
			АналитикиРасчета = МодульРаспределениеВзаиморасчетовВызовСервера.АналитикиРасчета();
			АналитикиРасчета.АналитикиУчетаПоПартнерам = МассивАналитикУчетаПоПартнерам;
			
			Попытка
				МодульРаспределениеВзаиморасчетовВызовСервера.РаспределитьВсеРасчетыСКлиентами(ОкончаниеПериодаРасчета, АналитикиРасчета);
			Исключение
				
				Ошибка = ИнформацияОбОшибке();
				
				ШаблонСообщения = НСтр("ru = 'Не удалось актуализировать состояние взаиморасчетов:
									   |%1
									   |Необходимо выполнить распределение взаиморасчетов вручную'");
				
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Диадок'"),
										 УровеньЖурналаРегистрации.Ошибка,
										 СсылкаНаОбъект.Метаданные(),
										 СсылкаНаОбъект,
										 СтрШаблон(ШаблонСообщения, ПодробноеПредставлениеОшибки(Ошибка)));
				
				ДанныеШапки.ОшибкиВДанных.Добавить(СтрШаблон(ШаблонСообщения, КраткоеПредставлениеОшибки(Ошибка)));
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОшибкиВалидацииИзДанныхШапки(ДанныеШапки, Content)
	
	Если Не ЗначениеЗаполнено(ДанныеШапки.ОшибкиВДанных) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекстОшибки Из ДанныеШапки.ОшибкиВДанных Цикл
		МетодСервера(, "ДобавитьОшибкуВалидации", Content.ОшибкиВДанных, ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры

// Удаляет позиции товаров с ндс, где нет изменения суммы НДС
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - исходная таблица товаров
Процедура УдалитьСтрокиНеСоответствующие736Формату(ТаблицаТоваров)
	
	Кэш = ТаблицаТоваров.СкопироватьКолонки();
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл 
		
		ТоварСНДС				= СтрокаТЧ.СуммаНДС > 0 Или СтрокаТЧ.СуммаНДСДоИзменения > 0;
		ПравильныйТоварСНДС		= ТоварСНДС И СтрокаТЧ.СуммаНДС <> СтрокаТЧ.СуммаНДСДоИзменения;		
		ПравильныйТоварБезНДС	= СтрокаТЧ.СуммаНДС = 0;
		
		Если ПравильныйТоварСНДС 
			Или ПравильныйТоварБезНДС Тогда
			
			НоваяСтрока = Кэш.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаТоваров = Кэш;
	
КонецПроцедуры

Функция ИсходныйСчетФактура(СчетФактура)
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если СравнитьВерсии(ВерсияУТ, "11.4.9") >= 0 Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ПредыдущийСчетФактура КАК ИсходныйДокумент
		|ИЗ
		|	Документ.СчетФактураВыданный.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.ИсходныйДокумент КАК ИсходныйДокумент
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СчетФактура);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Неопределено;
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ИсходныйДокумент;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьЗаголовокАкта172(Content, ДанныеШапки)
	
	ДатаНомер = ДанныеШапки.ДатаНомерДокумента;
	ОписаниеДокумента = ДанныеШапки.ОписаниеДокумента;
	СсылкаНаОбъект = ОписаниеДокумента.Ссылка;
	СтруктураОснования = СтруктурированноеПредставлениеОснования(СсылкаНаОбъект);
	
	ПредставлениеИсполнителя = сформироватьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Организация, ДатаНомер.ДатаДокумента);
	ПредставлениеЗаказчика	 = сформироватьПредставлениеКонтрагентаДляАкта(ДанныеШапки.Контрагент, ДатаНомер.ДатаДокумента);
	ПредставлениеОснования	 = "";
	Если ЗначениеЗаполнено(СтруктураОснования)
		И ЗначениеЗаполнено(СтруктураОснования.Presentation) Тогда
		ПредставлениеОснования = " на основании " + СтруктураОснования.Presentation;
	КонецЕсли;
	
	ЧастиЗаголовка = Новый Массив;
	ЧастиЗаголовка.Добавить("Мы, нижеподписавшиеся, представитель %1 (далее «Исполнитель»), с одной стороны,");
	ЧастиЗаголовка.Добавить("и представитель %2 (далее «Заказчик»), с другой стороны,");
	ЧастиЗаголовка.Добавить("составили настоящий акт о том, что «Исполнитель» выполнил,");
	ЧастиЗаголовка.Добавить("а  «Заказчик» принял следующие работы (услуги)%3:");
	
	ШаблонЗаголовка = СтрСоединить(ЧастиЗаголовка, " ");
	
	Content.Title = СтрШаблон(ШаблонЗаголовка
		, ПредставлениеИсполнителя
		, ПредставлениеЗаказчика
		, ПредставлениеОснования);
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеСведения(Content, ДанныеШапки, ПараметрыФормирования)
	
	ДопСведения = ПараметрыФормирования.ДополнительныеСведенияСтрокой;
	
	ИдКонтрагента = МетодСервера(, "Контрагент_2_CounteragentBoxID", ДанныеШапки.Контрагент);
	Если МетодСервера(, "НужноФормироватьДопИнфоПоШаблону", ИдКонтрагента) = Истина Тогда
		ДопСведения = МетодСервера(, "СформироватьСтрокуДопИнфоПоШаблону", ДопСведения);
	КонецЕсли;
	
	Content.AdditionalInfo = ДопСведения;
	
КонецПроцедуры

Процедура ЗаполнитьПодписантаАкта172(Content, Шапка, ПараметрыФормирования)
	
	ПараметрыПодписания = МетодСервера(, "ПолучитьПараметрыПодписанияТ12вДиадок", Шапка.Организация);
	
	ПараметрыОтправкиНаСогласование = ПараметрыФормирования.ПараметрыСогласования;
	
	Если НЕ ПараметрыОтправкиНаСогласование = Неопределено Тогда
		Если ЗначениеЗаполнено(ПараметрыОтправкиНаСогласование.ФИОПодписанта) Тогда
			ПараметрыПодписания.ФИОПодписанта 		= ПараметрыОтправкиНаСогласование.ФИОПодписанта;
			ПараметрыПодписания.ДолжностьПодписанта = ПараметрыОтправкиНаСогласование.ДолжностьПодписанта;
		Иначе
			ФИОПолучателя = ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			ПараметрыПодписания.ФИОПодписанта 		= ПараметрыОтправкиНаСогласование.ФИОПолучателя;
			ПараметрыПодписания.ДолжностьПодписанта = ПараметрыОтправкиНаСогласование.ДолжностьПолучателя;
		КонецЕсли;
	КонецЕсли;
	
	СведенияПодписанта = МетодСервера(, "ПредставлениеВизирующегоСтруктурой", ПараметрыПодписания);
	
	МетодСервера(, "ЗаполнитьПодписантаДляXmlTorg12", content.Official, СведенияПодписанта);
	
КонецПроцедуры

Функция РеквизитыКорректировочногоСчетаФактуры(СсылкаНаОбъект)
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	ЕстьПредставлениеНомера = ОбщегоНазначения.ЕстьРеквизитОбъекта("ПредставлениеНомера", СсылкаНаОбъект.Метаданные());
	
	Если СравнитьВерсии(ВерсияУТ, "11.4.9") > 0 Тогда // сведения об исходных документах в ТЧ Товары
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таблица.ПредыдущийСчетФактура КАК ИсходныйДокумент,
		|	ЕСТЬNULL(Таблица.ПредыдущийСчетФактура.Номер, """") КАК НомерИсходногоДокумента,
		|	ЕСТЬNULL(Таблица.ПредыдущийСчетФактура.ПредставлениеНомера, """") КАК ПредставлениеНомераИсходногоДокумента,
		|	ЕСТЬNULL(Таблица.ПредыдущийСчетФактура.СчетФактураОснование.Дата, Таблица.ПредыдущийСчетФактура.Дата) КАК ДатаИсходногоДокумента,
		|	ЕСТЬNULL(Таблица.ПредыдущийСчетФактура.НомерИсправления, """") КАК НомерИсправленияИсходногоДокумента,
		|	ЕСТЬNULL(Таблица.ПредыдущийСчетФактура.Исправление, ЛОЖЬ) КАК УчитыватьИсправлениеИсходногоДокумента,
		|	ВЫБОР
		|		КОГДА Таблица.ПредыдущийСчетФактура.Исправление
		|			ТОГДА ЕСТЬNULL(Таблица.ПредыдущийСчетФактура.Дата, ДАТАВРЕМЯ(1, 1, 1))
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаИсправленияИсходногоДокумента
		|ИЗ
		|	Документ.СчетФактураВыданный.Товары КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &СсылкаНаОбъект
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИсходныйДокумент";
		
	Иначе // Сведения об исходных документах в ТЧ ДокументыОснования
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таблица.ИсходныйДокумент КАК ИсходныйДокумент,
		|	Таблица.НомерИсходногоДокумента КАК НомерИсходногоДокумента,
		|	Таблица.ДатаИсходногоДокумента КАК ДатаИсходногоДокумента,
		|	Таблица.НомерИсправленияИсходногоДокумента КАК НомерИсправленияИсходногоДокумента,
		|	Таблица.ДатаИсправленияИсходногоДокумента КАК ДатаИсправленияИсходногоДокумента,
		|	ЕСТЬNULL(Таблица.ИсходныйДокумент.Исправление, ЛОЖЬ) КАК УчитыватьИсправлениеИсходногоДокумента,
		|	Выразить("""" КАК Строка(500)) КАК ПредставлениеНомераИсходногоДокумента
		|ИЗ
		|	Документ.СчетФактураВыданный.ДокументыОснования КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &СсылкаНаОбъект
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИсходныйДокумент";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ОписаниеРеквизитов = МетодСервера("Модуль_ИнтеграцияУниверсальный", "Новый_ДатаНомерДокументаОснования");
		ЗаполнитьЗначенияСвойств(ОписаниеРеквизитов, Выборка, , "НомерИсправленияИсходногоДокумента, ДатаИсправленияИсходногоДокумента");
		
		Если ОписаниеРеквизитов.УчитыватьИсправлениеИсходногоДокумента Тогда
			ОписаниеРеквизитов.НомерИсправленияИсходногоДокумента	 = Формат(Выборка.НомерИсправленияИсходногоДокумента, "ЧГ=0");
			ОписаниеРеквизитов.ДатаИсправленияИсходногоДокумента	 = Выборка.ДатаИсправленияИсходногоДокумента;
		Иначе
			ОписаниеРеквизитов.НомерИсправленияИсходногоДокумента	 = "";
			ОписаниеРеквизитов.ДатаИсправленияИсходногоДокумента	 = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ПредставлениеНомераИсходногоДокумента) Тогда
			ОписаниеРеквизитов.НомерИсходногоДокумента = Выборка.ПредставлениеНомераИсходногоДокумента;
		Иначе
			ОписаниеРеквизитов.НомерИсходногоДокумента = ПредставлениеНомера(ОписаниеРеквизитов.НомерДокумента);
		КонецЕсли;
		
		Результат.Добавить(ОписаниеРеквизитов);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

