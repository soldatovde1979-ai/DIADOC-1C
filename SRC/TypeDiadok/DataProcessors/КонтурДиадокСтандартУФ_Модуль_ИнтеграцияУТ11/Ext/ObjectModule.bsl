		Шапка.Вставить("АдресДоставки", ШапкаЭД.Покупатель.АдрТекст);
	КонецЕсли;
	
	ДатаНачТов = "";
	Если ШапкаЭД.Свойство("ДатаНачТов") Тогда
		ДатаНачТов = ШапкаЭД.ДатаНачТов;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаНачТов) Тогда
		Шапка.Вставить("ЖелаемаяДатаПоступления", ДатаНачТов);
		Шапка.Вставить("ДатаПервогоПоступления", ДатаНачТов);
		Шапка.Вставить("ДатаПоступления", ДатаНачТов);
		Шапка.Вставить("ДатаОтгрузки", ДатаНачТов);
	КонецЕсли;
	
	Если ШапкаЭД.Свойство("УсловияОказанияПоставки") Тогда
		Шапка.Вставить("ОсобыеУсловияПеревозки", Истина);
		ОсобыеУсловияПеревозкиОписание = "";
		Для Каждого УсловиеОказаниеПоставки Из ШапкаЭД.УсловияОказанияПоставки Цикл
			ОсобыеУсловияПеревозкиОписание = (ОсобыеУсловияПеревозкиОписание + УсловиеОказаниеПоставки + Символы.ПС);
		КонецЦикла;
		Шапка.Вставить("ОсобыеУсловияПеревозкиОписание", ОсобыеУсловияПеревозкиОписание);
	КонецЕсли;
	
	Товары = ПустаяСсылкаНаДокумент.Товары.ВыгрузитьКолонки();
	
	НДСИсчисляетсяНалоговымАгентом = Ложь;
	
	Для Каждого СтрокаТовара Из ДанныеЭД.ТоварнаяЧасть Цикл
		СтрокаПоДаннымКонтрагента = Товары.Добавить();
		СтрокаПоДаннымКонтрагента.Номенклатура = СтрокаТовара.Номенклатура.Номенклатура;
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура.Номенклатура) Тогда
			СтрокаПоДаннымКонтрагента.Упаковка = СтрокаТовара.Номенклатура.Упаковка;
		КонецЕсли;
		СтрокаПоДаннымКонтрагента.КоличествоУпаковок = СтрокаТовара.Количество;
		СтрокаПоДаннымКонтрагента.Количество = СтрокаТовара.Количество;
		СтрокаПоДаннымКонтрагента.Цена = СтрокаТовара.Цена;
		СтрокаПоДаннымКонтрагента.Сумма = СтрокаТовара.СуммаБезНДС;
		СтрокаПоДаннымКонтрагента.СтавкаНДС = ЗначениеСтавкиНДС(СтрокаТовара.НоменклатураКонтрагента.СтавкаНДС);
		СтрокаПоДаннымКонтрагента.СуммаНДС = СтрокаТовара.СуммаНДС;
		СтрокаПоДаннымКонтрагента.Отменено = Ложь;
		СтрокаПоДаннымКонтрагента.ПроцентРучнойСкидки = СтрокаТовара.ПроцентСкидки;
		СтрокаПоДаннымКонтрагента.СуммаРучнойСкидки = СтрокаТовара.СуммаСкидки;
		
		Если ЗначениеЗаполнено(ДатаНачТов) Тогда
			СтрокаПоДаннымКонтрагента.ДатаПоступления = ДатаНачТов;
			Если ЭтоРедакция11_5() Тогда
				СтрокаПоДаннымКонтрагента.ДатаОтгрузки = ДатаНачТов;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаТовара.НоменклатураКонтрагента.СтавкаНДС = СтавкаНДСИсчисляетсяНалоговымАгентом() Тогда
			НДСИсчисляетсяНалоговымАгентом = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОбъекта = Новый Структура;
	ДанныеОбъекта.Вставить("Шапка", Шапка);
	ДанныеОбъекта.Вставить("Товары", Товары);
	ДанныеОбъекта.Вставить("НДСИсчисляетсяНалоговымАгентом", НДСИсчисляетсяНалоговымАгентом);
	
