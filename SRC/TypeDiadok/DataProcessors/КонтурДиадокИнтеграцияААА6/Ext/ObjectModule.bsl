Функция УПД970_СведенияОбУчастникахЭДО(ДанныеШапки)
	
	Если ЭтоОбособленноеПодразделениеОрганизации(ДанныеШапки.ПодразделениеОрганизации) Тогда
		ОбособленноеПодразделение = ДанныеШапки.ПодразделениеОрганизации;
	ИначеЕсли ЭтоОбособленноеПодразделениеОрганизации(ДанныеШапки.Грузоотправитель) Тогда
		ОбособленноеПодразделение = ДанныеШапки.Грузоотправитель;
	Иначе
		ОбособленноеПодразделение = Неопределено;
	КонецЕсли;
	
	СведенияОбОбособленномПодразделении = Неопределено;
	Если ЗначениеЗаполнено(ОбособленноеПодразделение) Тогда
		
		СведенияОбОбособленномПодразделении = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ОбособленноеПодразделение,
			ДанныеШапки.Дата);
	
	КонецЕсли;
	
	// Продавец
	СведенияОбОрганизации = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
		ДанныеШапки.Организация,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации);
	
	Если СведенияОбОбособленномПодразделении <> Неопределено Тогда
		СведенияОбОрганизации.КПП = СведенияОбОбособленномПодразделении.КПП;
	КонецЕсли;
	
	Если ЭтоОбособленноеПодразделениеОрганизацииНаОтдельномБалансе(ОбособленноеПодразделение) Тогда
		СведенияОбОрганизации.НаименованиеБанка = СведенияОбОбособленномПодразделении.НаименованиеБанка;
		СведенияОбОрганизации.БИК = СведенияОбОбособленномПодразделении.БИК;
		СведенияОбОрганизации.КоррСчет = СведенияОбОбособленномПодразделении.КоррСчет;
		СведенияОбОрганизации.НомерСчета = СведенияОбОбособленномПодразделении.НомерСчета;
	КонецЕсли;
	
	// Покупатель
	ЭтоОбособленноеПодразделениеКонтрагента = ЭтоОбособленноеПодразделениеКонтрагента(ДанныеШапки.Контрагент);
	Если ЭтоОбособленноеПодразделениеКонтрагента Тогда
		
		СведенияОКонтрагенте = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
			ДанныеШапки.ГоловнойКонтрагент,
			ДанныеШапки.Дата);
			
		СведенияОКонтрагенте.КПП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеШапки.Контрагент, "КПП");
		
	Иначе
		
		СведенияОКонтрагенте = УПД970_ДанныеУчастникаЭДОсЮрАдресом(
			ДанныеШапки.Контрагент,
			ДанныеШапки.Дата);
			
	КонецЕсли;
	
	// Грузоотправитель
	Если ЗначениеЗаполнено(ДанныеШапки.Грузоотправитель) Тогда
		
		СведенияОГрузоотправителе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата);
			
	ИначеЕсли СведенияОбОбособленномПодразделении <> Неопределено Тогда
		
		СведенияОГрузоотправителе = СведенияОбОбособленномПодразделении;
		
	Иначе
		
		СведенияОГрузоотправителе = Ядро.КопияКоллекцииЗначений(СведенияОбОрганизации);
		
		СведенияОГрузоотправителе.Адрес = УПД970_СведенияОФактическомАдресе(
			СведенияОбОрганизации.Ссылка,
			ДанныеШапки.Дата);
		
	КонецЕсли;
	
	// Грузополучатель
	Если ЗначениеЗаполнено(ДанныеШапки.Грузополучатель) Тогда
		
		СведенияОГрузополучателе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата);
			
	ИначеЕсли ЭтоОбособленноеПодразделениеКонтрагента Тогда
		
		СведенияОГрузополучателе = УПД970_ДанныеУчастникаЭДОсФактАдресом(
			ДанныеШапки.Контрагент,
			ДанныеШапки.Дата);
			
		СведенияОГрузополучателе.ИНН = СведенияОКонтрагенте.ИНН;
		
	Иначе
		
		СведенияОГрузополучателе = Ядро.КопияКоллекцииЗначений(СведенияОКонтрагенте);
		
		СведенияОГрузополучателе.Адрес = УПД970_СведенияОФактическомАдресе(
			СведенияОКонтрагенте.Ссылка,
			ДанныеШапки.Дата);
		
	КонецЕсли;
	
	Результат = УПД970_Контракт_УчастникиЭДО();
	Результат.Организация = СведенияОбОрганизации;
	Результат.Контрагент = СведенияОКонтрагенте;
	Результат.Грузоотправитель = СведенияОГрузоотправителе;
	Результат.Грузополучатель = СведенияОГрузополучателе;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДОсЮрАдресом(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)
	
	Результат = УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет);
	
