// Используется для списка контрагентов в основном модуле для режима "Поиск и приглашение"
Функция ПолучитьКоличествоДокументовЗаПериод(Параметры)

	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Poluchit%27_Kolichestvo_Dokumentov_Za_Period.html
	
	МассивКонтрагентов	= Параметры.МассивКонтрагентов;
	ОрганизацияВ1С		= Параметры.Организация;
	
	СоответствиеДокументыЗаПериод = Новый Соответствие;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивКонтрагентов",	МассивКонтрагентов);
	Запрос.УстановитьПараметр("ДатаНачала",			ДобавитьМесяц(КонецДня(ТекущаяДата()), -3));
	Запрос.УстановитьПараметр("Организация",		ОрганизацияВ1С);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваров.Контрагент КАК Связь1,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваров.Ссылка) КАК ДокументовЗаПериод
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.РеализацияТоваров КАК РеализацияТоваров
	|ГДЕ
	|	РеализацияТоваров.Проведен = ИСТИНА
	|	И РеализацияТоваров.Организация = &Организация
	|	И РеализацияТоваров.Дата >= &ДатаНачала
	|	И РеализацияТоваров.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваров.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваров.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеТоваров.Ссылка)
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.Проведен = ИСТИНА
	|	И ПоступлениеТоваров.Организация = &Организация
	|	И ПоступлениеТоваров.Дата >= &ДатаНачала
	|	И ПоступлениеТоваров.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваров.Контрагент
	|	
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеализацияАвтомобилей.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияАвтомобилей.Ссылка)
	|ИЗ
	|	Документ.РеализацияАвтомобилей КАК РеализацияАвтомобилей
	|ГДЕ
	|	РеализацияАвтомобилей.Проведен = ИСТИНА
	|	И РеализацияАвтомобилей.Организация = &Организация
	|	И РеализацияАвтомобилей.Дата >= &ДатаНачала
	|	И РеализацияАвтомобилей.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияАвтомобилей.Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеАвтомобилей.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеАвтомобилей.Ссылка)
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей КАК ПоступлениеАвтомобилей
	|ГДЕ
	|	ПоступлениеАвтомобилей.Проведен = ИСТИНА
	|	И ПоступлениеАвтомобилей.Организация = &Организация
	|	И ПоступлениеАвтомобилей.Дата >= &ДатаНачала
	|	И ПоступлениеАвтомобилей.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеАвтомобилей.Контрагент
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратОтПокупателя.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВозвратОтПокупателя.Ссылка)
	|ИЗ
	|	Документ.ВозвратОтПокупателя КАК ВозвратОтПокупателя
	|ГДЕ
	|	ВозвратОтПокупателя.Проведен = ИСТИНА
	|	И ВозвратОтПокупателя.Организация = &Организация
	|	И ВозвратОтПокупателя.Дата >= &ДатаНачала
	|	И ВозвратОтПокупателя.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВозвратОтПокупателя.Контрагент
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратПоставщику.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВозвратПоставщику.Ссылка)
	|ИЗ
	|	Документ.ВозвратПоставщику КАК ВозвратПоставщику
	|ГДЕ
	|	ВозвратПоставщику.Проведен = ИСТИНА
	|	И ВозвратПоставщику.Организация = &Организация
	|	И ВозвратПоставщику.Дата >= &ДатаНачала
	|	И ВозвратПоставщику.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВозвратПоставщику.Контрагент
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаПоступления.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КорректировкаПоступления.Ссылка)
	|ИЗ
	|	Документ.КорректировкаПоступления КАК КорректировкаПоступления
	|ГДЕ
	|	КорректировкаПоступления.Проведен = ИСТИНА
	|	И КорректировкаПоступления.Организация = &Организация
	|	И КорректировкаПоступления.Дата >= &ДатаНачала
	|	И КорректировкаПоступления.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаПоступления.Контрагент
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаРеализации.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КорректировкаРеализации.Ссылка)
	|ИЗ
	|	Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|ГДЕ
	|	КорректировкаРеализации.Проведен = ИСТИНА
	|	И КорректировкаРеализации.Организация = &Организация
	|	И КорректировкаРеализации.Дата >= &ДатаНачала
	|	И КорректировкаРеализации.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаРеализации.Контрагент
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаПоступленияАвтомобилей.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КорректировкаПоступленияАвтомобилей.Ссылка)
	|ИЗ
	|	Документ.КорректировкаПоступленияАвтомобилей КАК КорректировкаПоступленияАвтомобилей
	|ГДЕ
	|	КорректировкаПоступленияАвтомобилей.Проведен = ИСТИНА
	|	И КорректировкаПоступленияАвтомобилей.Организация = &Организация
	|	И КорректировкаПоступленияАвтомобилей.Дата >= &ДатаНачала
	|	И КорректировкаПоступленияАвтомобилей.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаПоступленияАвтомобилей.Контрагент
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КорректировкаРеализацииАвтомобилей.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КорректировкаРеализацииАвтомобилей.Ссылка)
	|ИЗ
	|	Документ.КорректировкаРеализацииАвтомобилей КАК КорректировкаРеализацииАвтомобилей
	|ГДЕ
	|	КорректировкаРеализацииАвтомобилей.Проведен = ИСТИНА
	|	И КорректировкаРеализацииАвтомобилей.Организация = &Организация
	|	И КорректировкаРеализацииАвтомобилей.Дата >= &ДатаНачала
	|	И КорректировкаРеализацииАвтомобилей.Контрагент В(&МассивКонтрагентов)
	|
	|СГРУППИРОВАТЬ ПО
	|	КорректировкаРеализацииАвтомобилей.Контрагент
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Связь1 КАК Связь1,
	|	СУММА(ВТ_Документы.ДокументовЗаПериод) КАК ДокументовЗаПериод
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Документы.Связь1";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;

