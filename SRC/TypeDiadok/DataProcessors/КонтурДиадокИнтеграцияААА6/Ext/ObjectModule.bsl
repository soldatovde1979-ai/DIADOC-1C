КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОУлице(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Улица) Тогда
		AddressSAR.StreetElement = СведенияОбАдресе.Улица;
		AddressSAR.StreetElementType = СведенияОбАдресе.УлицаТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОЗданиях(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание.Номер)
		И ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания) Тогда
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = СведенияОбАдресе.Здание.Номер;
		AddressObject.Type = СведенияОбАдресе.Здание.ТипЗдания;
		
	КонецЕсли;

	Для Каждого Корпус Из СведенияОбАдресе.Корпуса Цикл
		
		Если Не ЗначениеЗаполнено(Корпус.Номер)
			И Не ЗначениеЗаполнено(Корпус.ТипКорпуса) Тогда
			Продолжить;
		КонецЕсли;
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = Корпус.Номер;
		AddressObject.Type = Корпус.ТипКорпуса;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииЗдания(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыПомещений = УПД970_ТипыПомещений();
	
	Для Каждого ТипПомещения Из ТипыПомещений Цикл
		
		ПомещениеЗдания = Ядро.МассивСтруктур_Найти(Помещения, ТипПомещения, "ТипПомещения");
		Если ПомещениеЗдания <> Неопределено Тогда
			
			AddressSAR.House = ПомещениеЗдания.Номер;
			AddressSAR.HouseType = ПомещениеЗдания.ТипПомещения;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииКвартиры(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыАпартаментов = УПД970_ТипыАпартаментов();
	
	Для Каждого ТипАппартаментов Из ТипыАпартаментов Цикл
		
		ПомещениеКвартиры = Ядро.МассивСтруктур_Найти(Помещения, ТипАппартаментов, "ТипПомещения");
		Если ПомещениеКвартиры <> Неопределено Тогда
			
			AddressSAR.Apartment = ПомещениеКвартиры.Номер;
			AddressSAR.ApartmentType = ПомещениеКвартиры.ТипПомещения;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокумента(Контент, ДанныеПоДокументу, ДополнительныеПараметры, ПересчитыватьНормыВремени = Ложь)
	
	Перем КодыМаркировки;
	
	ТабличныеДанные = ДанныеПоДокументу.ТабличныеДанные;
	
	Если ДанныеПоДокументу.Свойство("КодыМаркировки")
		И ЗначениеЗаполнено(ДанныеПоДокументу.КодыМаркировки) Тогда
		
		КодыМаркировки = ДанныеПоДокументу.КодыМаркировки.Скопировать();
		КодыМаркировки.Колонки.Добавить("Обработан", Новый ОписаниеТипов("Булево"));
		
	КонецЕсли;
	
	ТочностьЦены = ДополнительныеПараметры.ТочностьЦены;
	ТочностьКоличества = ДополнительныеПараметры.ТочностьКоличества;
	
	ВсеСтрокиБезНДС = Истина;
	
	Если Контент.Table = Неопределено Тогда
		Table = Контракт_InvoiceTable970();
		Контент.Table = Table;
	Иначе
		Table = Контент.Table;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		Item = Контракт_Item970();
		
		УПД970_ЗаполнитьОсновныеСведенияОНоменклатуре(Item, СтрокаТаблицы);
		
		Item.Quantity = 0;
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			
			Количество = Окр(СтрокаТаблицы.Количество, ТочностьКоличества);
			Если ПересчитыватьНормыВремени
				И ТипЗнч(СтрокаТаблицы.Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
				И ЕстьРеквизит(СтрокаТаблицы, "Коэффициент") Тогда
				Количество = Окр(СтрокаТаблицы.Количество * СтрокаТаблицы.Коэффициент, ТочностьКоличества);
			КонецЕсли;
			
			Item.Quantity = Количество;
			
		КонецЕсли;
		
		ПредставлениеСтавки = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
		
		Item.TaxRate = ПредставлениеСтавки;
		
		ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		
		Item.Price = 0;
		Если Количество <> 0 Тогда
			Item.Price = Окр(СтрокаТаблицы.СуммаБезНДС / Количество, ТочностьЦены);
		КонецЕсли;
		
		Item.Vat = СтрокаТаблицы.СуммаНДС;
		Item.Subtotal = СтрокаТаблицы.СуммаВсего;
		
		Item.SubtotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		
		УПД970_ЗаполнитьДополнительныеСведенияОНоменклатуре(
			Item,
			СтрокаТаблицы,
			КодыМаркировки,
			ДополнительныеПараметры.ИспользоватьСервисКонтурМаркировка);
			
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
		Если НЕ ЭтоСтавкаБезНДС Тогда
			ВсеСтрокиБезНДС = Ложь;
		КонецЕсли;
		
		УПД970_РассчитатьИтогиПоТаблице(Table, Item);

	КонецЦикла;
	
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьТаблицуКонтентаПоДаннымСчетФактураНаАванс(Контент, ТабличныеДанные, ДополнительныеПараметры)
	
	Table = Контракт_InvoiceTable970();
	Контент.Table = Table;

	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
			
		Item = Контракт_Item970();
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.НоменклатураПолноеНаименование) Тогда
			НаименованиеНоменклатуры = СтрокаТаблицы.НоменклатураПолноеНаименование;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.НоменклатураНаименование) Тогда
			НаименованиеНоменклатуры = СтрокаТаблицы.НоменклатураНаименование;
		Иначе
			НаименованиеНоменклатуры = "Предварительная оплата";
		КонецЕсли;
		
		Item.Product = НаименованиеНоменклатуры;
		Item.ItemMark = УПД970_ТипНоменклатурыВТерминахПрото(СтрокаТаблицы.ТипНоменклатуры);
		
		ПредставлениеСтавки = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС);
		Item.TaxRate = ПредставлениеСтавки;
		
		Item.Vat = СтрокаТаблицы.СуммаНДС;
		Item.Subtotal = СтрокаТаблицы.СуммаВсего;
		
		Item.СлужебнаяИнформация = Контракт_СлужебнаяИнформацияСтроки();
		Item.СлужебнаяИнформация.Номенклатура = СтрокаТаблицы.Номенклатура;
		Item.СлужебнаяИнформация.СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.Vat = ТабличныеДанные.Итог("СуммаНДС");
	Table.Total = ТабличныеДанные.Итог("СуммаВсего");
	
КонецПроцедуры

Процедура УПД970_РассчитатьИтогиПоТаблице(Table, Item)

	Если Table.TotalNet = Неопределено Тогда
		Table.TotalNet = 0;
	КонецЕсли;
	
	Если Table.TotalWithVatExcluded = Неопределено Тогда
		Table.TotalWithVatExcluded = 0;
	КонецЕсли;
	
	Если Table.Vat = Неопределено Тогда
		Table.Vat = 0;
	КонецЕсли;
	
	Если Table.Total = Неопределено Тогда
		Table.Total = 0;
	КонецЕсли;
	
	Если Item.Quantity <> Неопределено Тогда
		Table.TotalNet = Table.TotalNet + Item.Quantity;
	КонецЕсли;
	
	Table.Vat = Table.Vat + Item.Vat;
	Table.TotalWithVatExcluded = Table.TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
	Table.Total = Table.Total + Item.Subtotal;

КонецПроцедуры

Процедура УПД970_ЗаполнитьОсновныеСведенияОНоменклатуре(Item, СтрокаТаблицы)
	
	Item.Product = УПД970_ПредставлениеНоменклатуры(СтрокаТаблицы);
	Item.ItemMark = УПД970_ТипНоменклатурыВТерминахПрото(СтрокаТаблицы.ТипНоменклатуры);
	
	РежимВыводаКода = УправлениеПечатьюПлатформа.ПолучитьПараметрыРежимаВыводаКодаВДокументах().Имя;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Артикул)
		И (РежимВыводаКода = "Артикул" Или РежимВыводаКода = "АртикулИПроизводитель") Тогда
		Item.ItemVendorCode = СокрЛП(СтрокаТаблицы.Артикул);
	Иначе
		Item.ItemVendorCode = СокрЛП(СтрокаТаблицы.КодНоменклатуры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
		
		КодЕИ = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияКод);
		ИмяЕИ = СокрЛП(СтрокаТаблицы.ЕдиницаИзмерения);
		
		Item.Unit = ГенерацияXML.XML_КодЕдиницыИзмерения(КодЕИ);
		Item.UnitName = ИмяЕИ;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьДополнительныеСведенияОНоменклатуре(
	Item,
	СтрокаТаблицы,
	КодыМаркировки,
	ИспользуетсяСервисКонтурМаркировки)
	
	УПД970_ЗаполнитьСведенияОТаможеннойДекларации(Item, СтрокаТаблицы);
	
	Если СтрокаТаблицы.ПрослеживаемыйТовар Тогда
		УПД970_ЗаполнитьСведенияПрослеживаемости(Item, СтрокаТаблицы);
	КонецЕсли;
	
	Если Не ИспользуетсяСервисКонтурМаркировки Тогда
		УПД970_ЗаполнитьКодыМаркировкиВСтрокеКонтента(Item, КодыМаркировки, СтрокаТаблицы);
	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ЗаполнитьКодыМаркировкиВСтрокеКонтента(Item, КодыМаркировки, СтрокаТаблицы)
	
	Если Не ЗначениеЗаполнено(КодыМаркировки) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Номенклатура", СтрокаТаблицы.Номенклатура);
	Отбор.Вставить("ХарактеристикаНоменклатуры", СтрокаТаблицы.ХарактеристикаНоменклатуры);
	Отбор.Вставить("Обработан", Ложь);
	
	КодыМаркировкиПоТовару = КодыМаркировки.НайтиСтроки(Отбор);
	
	ИдентификационныйНомер = Контракт_ItemIdentificationNumber970();

	Для Каждого ДанныеМаркировки Из КодыМаркировкиПоТовару Цикл
		
		КодМаркировки = УПД970_КодМаркировкиБезСкобок(ДанныеМаркировки.КодМаркировки);
		ИдентификационныйНомер.Units.Добавить(КодМаркировки);
		
		ДанныеМаркировки.Обработан = Истина;
		
	КонецЦикла;
	
	Если ИдентификационныйНомер.Units.Количество() > 0 Тогда
		Item.ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОТаможеннойДекларации(Item, СтрокаТаблицы)
	
	СтранаПроисхожденияРоссия = (СтрокаТаблицы.СтранаПроисхожденияКод = ОсновнаяСтрана().Код);
	
	ЕстьСведенияГТД = (ЗначениеЗаполнено(СтрокаТаблицы.НомерГТД)
		Или ЗначениеЗаполнено(СтрокаТаблицы.СтранаПроисхожденияКод));
		
	Если СтранаПроисхожденияРоссия
		Или Не ЕстьСведенияГТД Тогда
		Возврат;
	КонецЕсли;
	
	СтранаПроисхожденияЧленЕАЭС = СтранаЧленЕАЭС(СтрокаТаблицы.СтранаПроисхожденияКод);
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерГТД) И СтранаПроисхожденияЧленЕАЭС Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрокаТаблицы.ПрослеживаемыйТовар Тогда
		НомерГТД = УПД970_РегистрационныйНомерПрослеживаемогоТовара();
	Иначе
		НомерГТД = СокрЛП(СтрокаТаблицы.НомерГТД);
	КонецЕсли;
	
	CustomDeclaration = Контракт_CustomDeclarations();
	CustomDeclaration.CountryCode = СтрокаТаблицы.СтранаПроисхожденияКод;
	CustomDeclaration.DeclarationNumber = НомерГТД;
	
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияПрослеживаемости(Item, СтрокаТаблицы)
	
	ItemTracingInfo = Контракт_ItemTracingInfo970();
	
	ItemTracingInfo.RegNumberUnit = СокрЛП(СтрокаТаблицы.НомерГТД);
	ItemTracingInfo.Quantity = Item.Quantity;
	ItemTracingInfo.SumWithoutVat = Окр(Item.SubtotalWithVatExcluded, 0);
	ItemTracingInfo.Unit = Item.Unit;
	ItemTracingInfo.UnitName = Item.UnitName;
	
	Item.ItemTracingInfos.Добавить(ItemTracingInfo);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОСотруднике(Контент, ДополнительныеПараметры)
	
	Перем ДанныеСотрудника;
	
	ДополнительныеПараметры.Свойство("ДанныеСотрудника", ДанныеСотрудника);
		
	ЕстьТовары = УПД970_ВДокументеЕстьТовары(Контент.Table.Items);
	
	НеобходимоЗаполнитьСведения = (ЗначениеЗаполнено(ДанныеСотрудника)
		И ЗначениеЗаполнено(ДанныеСотрудника.Должность)
		И Контент.Function <> ФункцияДокументаУПД_СЧФ()
		И ЕстьТовары);
	
	Если НеобходимоЗаполнитьСведения Тогда
		
		Employee = Контракт_Employee970();
		
		Employee.Surname = ДанныеСотрудника.Фамилия;
		Employee.FirstName = ДанныеСотрудника.Имя;
		Employee.Patronymic = ДанныеСотрудника.Отчество;
		Employee.EmployeePosition = ДанныеСотрудника.Должность;
		
		Контент.TransferInfo.Employee = Employee;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент)
	
	ЕстьПрослеживаемыеТовары = Ложь;
	
	Для Каждого Item Из Контент.Table.Items Цикл
		Если Item.ItemTracingInfos.Количество() > 0 Тогда
			ЕстьПрослеживаемыеТовары = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПризнакиТоваров = ГенерацияXML.Новый_ПризнакиПрослеживаемыхИМаркируемыхТоваровУПД970(ЕстьПрослеживаемыеТовары);
	
	ГенерацияXML.Заполнить_ПризнакиПрослеживаемыхИМаркируемыхТоваровДокументаУПД970(Контент, ПризнакиТоваров);

КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОМаркировкеЧерезСервисКонтурМаркировки(Контент, СсылкаНаОбъект)
	
	Попытка
		
		РаботаСМаркировкой.ЗаполнитьСведенияОМаркировке970(Контент);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		ПодробнаяОшибка = Ядро.Общее_ПодставитьПараметрыВСтроку(
			"Не удалось заполнить сведения о маркировке по причине:
			|%1",
			ПодробноеПредставлениеОшибки);
		
		ЗаписьЖурналаРегистрации(
			"Диадок.РаботаСМаркировкой",
			УровеньЖурналаРегистрации.Ошибка,
			СсылкаНаОбъект.Метаданные(),
			СсылкаНаОбъект,
			ПодробнаяОшибка);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Функция УПД970_ExtendedOrganizationInfoType(ДанныеУчастникаЭДО)
	
	ВидыЮрФизЛиц = ГенерацияXML_Перечисление_ВидыЮрФизЛиц();
	
	ЭтоФизЛицо = ДанныеУчастникаЭДО.ЭтоФизЛицо;
	ЭтоЮрЛицо = ДанныеУчастникаЭДО.ЭтоЮрЛицо;
	ЭтоРезидент = НЕ ДанныеУчастникаЭДО.Нерезидент;
	
	Если Не ЭтоЮрЛицо И Не ЭтоФизЛицо И ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ИндивидуальныйПредприниматель;
		
	ИначеЕсли ЭтоЮрЛицо И ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ЮридическоеЛицо;
		
	ИначеЕсли ЭтоФизЛицо И ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ФизическоеЛицо;
		
	ИначеЕсли Не ЭтоЮрЛицо И Не ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ИностранныйГражданин;
		
	ИначеЕсли ЭтоЮрЛицо И Не ЭтоРезидент Тогда
		
		Результат = ВидыЮрФизЛиц.ИностраннаяОрганизация;
		
	Иначе
		
		ТекстОшибки = НСтр("ru='Не удалось определить тип участника ЭДО.
				|Заполните корректные реквизиты участников ЭДО в базе 1С 
				|(организация, грузоотправитель, контрагент, грузополучатель)'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЭтоАдресВФорматеАдрГАР(СведенияОбАдресе)
	
	Результат = Ложь;
	
	Если СведенияОбАдресе.ТипАдреса <> МуниципальныйАдрес()
		Или НЕ ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторАдресногоОбъекта) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	ТипыПомещений = УПД970_ТипыПомещений();
	ТипыАпартаментов = УПД970_ТипыАпартаментов();
	
	Помещения = Новый Массив;
	Апартаменты = Новый Массив;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		Если ТипыПомещений.Найти(Элемент.ТипПомещения) <> Неопределено Тогда
			Помещения.Добавить(Элемент);
		КонецЕсли;
		
		Если ТипыАпартаментов.Найти(Элемент.ТипПомещения) <> Неопределено Тогда
			Апартаменты.Добавить(Элемент);
		КонецЕсли;
		
		Если Помещения.Количество() > 1
			ИЛИ Апартаменты.Количество() > 1 Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Помещения.Количество() <= 1
		И Апартаменты.Количество() <= 1 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЭтоАдресВФорматеАдрРФ(СведенияОбАдресе)
	
	МаксимальноеКоличествоКорпусовИПомещений = 1;
	
	Результат = (СведенияОбАдресе.ТипАдреса = АдминистративноТерриториальныйАдрес()
		И ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона)
		И СведенияОбАдресе.Корпуса.Количество() <= МаксимальноеКоличествоКорпусовИПомещений
		И СведенияОбАдресе.Помещения.Количество() <= МаксимальноеКоличествоКорпусовИПомещений
		И ТипКорпусаСоответствуетКлассификатору(СведенияОбАдресе.Корпуса)
		И ТипПомещенияСоответствуетКлассификатору(СведенияОбАдресе.Помещения));
	
	Возврат Результат;
	
КонецФункции

