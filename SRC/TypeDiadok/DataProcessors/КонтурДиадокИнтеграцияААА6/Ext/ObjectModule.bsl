	|	ТабРаботы.Количество КАК Количество,
	|	ТабРаботы.Цена КАК Цена,
	|	ТабРаботы.СтавкаНДС КАК СтавкаНДС,
	|	ТабРаботы.СуммаНДС КАК СуммаНДС,
	|	ТабРаботы.СуммаВсего - ТабРаботы.СуммаНДС КАК СуммаБезНДС,
	|	ТабРаботы.СуммаВсего КАК СуммаВсего,
	|	ЛОЖЬ КАК ПрослеживаемыйТовар
	|ИЗ
	|	Документ.КорректировкаРеализации.Автоработы КАК ТабРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Автоработы КАК СпрАвтоработы
	|		ПО ТабРаботы.Авторабота = СпрАвтоработы.Ссылка
	|ГДЕ
	|	ТабРаботы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	МетаданныеТЧ = Метаданные.Документы.КорректировкаРеализации.ТабличныеЧасти.Товары;
	ЕстьСодержание = (МетаданныеТЧ.Реквизиты.Найти("Содержание") <> Неопределено); // 6.1.8 и выше
	
	ВыражениеСодержание = "НЕОПРЕДЕЛЕНО";
	Если ЕстьСодержание Тогда
		ВыражениеСодержание = "ВЫРАЗИТЬ(ТабТовары.Содержание КАК СТРОКА(1000))";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&СодержаниеВыражение", ВыражениеСодержание);
	
	Возврат Результат;
	
