		Возврат;
	КонецЕсли;

	ТолькоУслуги = ДокументРеализацииСодержитТолькоУслуги(Документ1С);
	ВидДокумента = "ID_ТОРГ12";
	
	Если ТолькоУслуги Тогда
		ВидДокумента = "ID_АктФормализованный";
	КонецЕсли;
	
	ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Пакет, Документ1С, ВидДокумента);
	
КонецПроцедуры 

Функция ДокументРеализацииСодержитТолькоУслуги(Документ1С)
	
	Результат = Истина;
	
	ЕстьТЧТовары		= Документ1С.Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено;
	ЭтоОтчетКомитенту	= ТипЗнч(Документ1С) = Тип("ДокументСсылка.ОтчетКомитенту");
	ЭтоЗаказНаряд		= ТипЗнч(Документ1С) = Тип("ДокументСсылка.ЗаказНаряд");
	
	ЭтоРеализацияАктивов		= ТипЗнч(Документ1С) = Тип("ДокументСсылка.РеализацияАктивов");
	ЭтоРеализацияАвтомобилей	= ТипЗнч(Документ1С) = Тип("ДокументСсылка.РеализацияАвтомобилей");
	ОтчетКомиссионераЗаАвтомобили = ТипЗнч(Документ1С) = Тип("ДокументСсылка.ОтчетКомиссионераЗаАвтомобили");
	
	Если ЭтоЗаказНаряд Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ВложенныйЗапрос.ЕстьУслуги) КАК ЕстьУслуги,
		|	МАКСИМУМ(ВложенныйЗапрос.ЕстьТовары) КАК ЕстьТовары
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(ВЫБОР
		|				КОГДА ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ) КАК ЕстьУслуги,
		|		МАКСИМУМ(ВЫБОР
		|				КОГДА НЕ ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ) КАК ЕстьТовары
		|	ИЗ
		|		Документ.ЗаказНаряд.Товары КАК ТЧ
		|	ГДЕ
		|		ТЧ.Ссылка = &СсылкаНаОбъект
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		МАКСИМУМ(ВЫБОР
		|				КОГДА ЗаказНарядМатериалы.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ),
		|		МАКСИМУМ(ВЫБОР
		|				КОГДА НЕ ЗаказНарядМатериалы.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|	ИЗ
		|		Документ.ЗаказНаряд.Материалы КАК ЗаказНарядМатериалы
		|	ГДЕ
		|		ЗаказНарядМатериалы.Ссылка = &СсылкаНаОбъект
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		МАКСИМУМ(ИСТИНА),
		|		МАКСИМУМ(ЛОЖЬ)
		|	ИЗ
		|		Документ.ЗаказНаряд.Автоработы КАК ЗаказНарядАвтоработы
		|	ГДЕ
		|		ЗаказНарядАвтоработы.Ссылка = &СсылкаНаОбъект
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		МАКСИМУМ(ИСТИНА),
		|		МАКСИМУМ(ЛОЖЬ)
		|	ИЗ
		|		Документ.ЗаказНаряд.ВспомогательныеАвтоработы КАК ЗаказНарядВспомогательныеАвтоработы
		|	ГДЕ
		|		ЗаказНарядВспомогательныеАвтоработы.Ссылка = &СсылкаНаОбъект) КАК ВложенныйЗапрос";
	
		Запрос.УстановитьПараметр("СсылкаНаОбъект", Документ1С);
		Запрос.УстановитьПараметр("ТипыНоменклатурыУслуги", ТипыНоменклатурыУслуги());
	
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ЕстьУслуги И Не Выборка.ЕстьТовары;
		КонецЕсли;
		
	ИначеЕсли ЭтоРеализацияАктивов Тогда 
		
		Результат = Ложь;
		
	ИначеЕсли ЭтоРеализацияАвтомобилей Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ОтчетКомиссионераЗаАвтомобили Тогда 
		
		Результат = Ложь;
		
	ИначеЕсли ЕстьТЧТовары И Не ЭтоОтчетКомитенту Тогда
	
		ШаблонЗапроса =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьУслуги,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА НЕ ТЧ.Номенклатура.ТипНоменклатуры В (&ТипыНоменклатурыУслуги)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьТовары
		|ИЗ
		|	&ПолноеИмяТаблицы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &СсылкаНаОбъект";
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СсылкаНаОбъект", Документ1С);
		Запрос.УстановитьПараметр("ТипыНоменклатурыУслуги", ТипыНоменклатурыУслуги());
	
		ПолноеИмяТаблицы = СтрШаблон("%1.%2"
			, Документ1С.Метаданные().ПолноеИмя()
			, "Товары");
		
		Запрос.Текст = СтрЗаменить(ШаблонЗапроса
			, "&ПолноеИмяТаблицы"
			, ПолноеИмяТаблицы);
	
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ЕстьУслуги И Не Выборка.ЕстьТовары;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

