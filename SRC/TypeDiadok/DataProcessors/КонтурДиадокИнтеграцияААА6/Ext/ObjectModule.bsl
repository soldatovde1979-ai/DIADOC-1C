	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабТовары.Ссылка КАК ДокументОтгрузки,
	|	ТабТовары.НомерСтроки КАК НомерСтроки,
	|	&ТипНоменклатурыТовар КАК ТипНоменклатуры,
	|	ТабТовары.ИдентификаторТовара КАК ИдентификаторСтроки,
	|	НЕОПРЕДЕЛЕНО КАК Содержание,
	|	ТабТовары.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(СпрНоменклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК НоменклатураПолноеНаименование,
	|	ВЫРАЗИТЬ(СпрНоменклатура.Наименование КАК СТРОКА(1000)) КАК НоменклатураНаименование,
	|	СпрНоменклатура.Код КАК КодНоменклатуры,
	|	ТабТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ТабТовары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.НаименованиеПолное КАК ЕдиницаИзмеренияНаименование,
	|	ЕдиницыИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКод,
	|	ТабТовары.ГТД.Наименование КАК НомерГТД,
	|	ЕСТЬNULL(ТабТовары.ГТД.Страна, НЕОПРЕДЕЛЕНО) КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ТабТовары.ГТД.Страна.НаименованиеПолное, НЕОПРЕДЕЛЕНО) КАК ПредставлениеСтраны,
	|	ЕСТЬNULL(ТабТовары.ГТД.Страна.Код, НЕОПРЕДЕЛЕНО) КАК СтранаПроисхожденияКод,
	|	ТабТовары.Количество КАК Количество,
	|	ТабТовары.Цена КАК Цена,
	|	ТабТовары.СтавкаНДС КАК СтавкаНДС,
	|	ТабТовары.СуммаНДС КАК СуммаНДС,
	|	ТабТовары.СуммаВсего - ТабТовары.СуммаНДС КАК СуммаБезНДС,
	|	ТабТовары.СуммаВсего КАК СуммаВсего,
	|	СпрНоменклатура.Прослеживаемый КАК ПрослеживаемыйТовар
	|ИЗ
	|	Документ.ВозвратПоставщику.Товары КАК ТабТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ТабТовары.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО ТабТовары.ЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|ГДЕ
	|	ТабТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаКодовМаркировкиТоваровДокументаВозвратПоставщику()
	
	ИмяДокумента = "ВозвратПоставщику";
	Результат = УПД970_ТекстЗапросаКодовМаркировкиОбщее(ИмяДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиДокументаВозвратПоставщикуАвтомобилей()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеШапки.Ссылка КАК Ссылка,
	|	ДанныеШапки.Дата КАК Дата,
	|	ДанныеШапки.Номер КАК Номер,
	|	ДанныеШапки.ВалютаДокумента КАК ВалютаДокумента,
	|	ДанныеШапки.Организация КАК Организация,
	|	ДанныеШапки.Контрагент КАК Контрагент,
	|	ДанныеШапки.Контрагент.ГоловнойКонтрагент КАК ГоловнойКонтрагент,
	|	ДанныеШапки.ПодразделениеКомпании КАК ПодразделениеОрганизации,
	|	&ГрузоотправительВыражение КАК Грузоотправитель,
	|	&ГрузополучательВыражение КАК Грузополучатель,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетОрганизации,
	|	ДанныеШапки.ДоговорВзаиморасчетов КАК ДоговорКонтрагента,
	|	ДанныеШапки.КурсВалютыВзаиморасчетов КАК КурсВзаиморасчетов,
	|	ЕСТЬNULL(ДанныеШапки.ТипЦен.ЦенаВключаетНДС, ЛОЖЬ) КАК СуммаВключаетНДС,
	|	ДанныеШапки.ИдентификаторГосударственногоКонтракта КАК ИдентификаторГосКонтракта,
	|	ДоговорыКонтрагентов.ДатаНачала КАК ДоговорДата,
	|	ДоговорыКонтрагентов.НомерДоговора КАК ДоговорНомер,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.РасчетыВУсловныхЕдиницах, ЛОЖЬ) КАК РасчетыВУсловныхЕдиницах,
	|	ЕСТЬNULL(ДоговорыКонтрагентов.ВалютаВзаиморасчетов, """") КАК ВалютаВзаиморасчетов
	|ИЗ
	|	Документ.ВозвратПоставщикуАвтомобилей КАК ДанныеШапки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыВзаиморасчетов КАК ДоговорыКонтрагентов
	|		ПО ДанныеШапки.ДоговорВзаиморасчетов = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	ДанныеШапки.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

