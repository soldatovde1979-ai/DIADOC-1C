Процедура УПД970_ДополнитьДанныеСчетФактурыСведениямиОКодахМаркировки(ДанныеДокумента)
	
	ДокументОснование = ДанныеДокумента.ДанныеШапки.ДокументОснование;
	
	МетаданныеДокумента = ДокументОснование.Метаданные();
	ЕстьТабличнаяЧастьКодыМаркировки = (МетаданныеДокумента.ТабличныеЧасти.Найти("КодыМаркировки") <> Неопределено);
	
	Если ЕстьТабличнаяЧастьКодыМаркировки Тогда
		
		ТекстЗапроса = УПД970_ТекстЗапросаКодовМаркировкиОбщее(МетаданныеДокумента.Имя);
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
		
		КодыМаркировки = Запрос.Выполнить().Выгрузить();
		
		ДанныеДокумента.КодыМаркировки = КодыМаркировки;

	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ДополнитьДанныеШапкиЗначениямиДополнительныхСвойств(ДанныеШапки)
	
	ЭтоСчетФактура = ЭтоСчетФактураВыданный(ДанныеШапки.Ссылка);
	
	Если ЭтоСчетФактура Тогда
		ДокументОтгрузки = ДанныеШапки.ДокументОснование;
	Иначе
		ДокументОтгрузки = ДанныеШапки.Ссылка;
	КонецЕсли;
	
	ДатаОтгрузки = УПД970_ДатаОтгрузкиИзДополнительныхСвойствДокумента(ДокументОтгрузки);
	ДанныеШапки.Вставить("ДатаОтгрузки", ДатаОтгрузки);

	Если Не ЭтоРедакция6_1() Тогда
		
		ЗначенияСвойств = УПД970_ГрузоотправительИГрузополучательИзДополнительныхСвойствДокумента(ДанныеШапки.Ссылка);
		
		ДанныеШапки.Грузоотправитель = ЗначениеСвойстваЛок("Грузоотправитель", ЗначенияСвойств);
		
		Если Не ЭтоСчетФактура Тогда
			ДанныеШапки.Грузополучатель = ЗначениеСвойстваЛок("Грузополучатель", ЗначенияСвойств);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

