// Возвращает номер документа
//
// Параметры:
//  НомерДокумента - Строка - Номер документа учета информационной базы
//  УдалитьПрефиксИнформационнойБазы - Булево - признак удаления префикса информационной базы
//  УдалитьПользовательскийПрефикс - Булево - признак удаления пользовательского префикса
//  УдалитьНулиВНомере - Булево - признак удаления лидирующих нулей
//
// Возвращаемое значение:
//   Строка - Номер без префиксов и лидирующих нолей
//
Функция ПредставлениеНомера(Знач НомерДокумента,
	УдалитьПрефиксИнформационнойБазы = Истина,
	УдалитьПользовательскийПрефикс = Истина,
	УдалитьНулиВНомере = Истина)
	
	Если ЭтоРедакция6_1() Тогда
		
		МенеджерПрефиксации = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектов");
		
	Иначе
		
		МенеджерПрефиксации = ОбщегоНазначения.ОбщийМодуль("ПрефиксацияОбъектовПлатформа");
		
	КонецЕсли;
	
	Результат = МенеджерПрефиксации.ПолучитьНомерНаПечать(
			НомерДокумента,
			УдалитьПрефиксИнформационнойБазы,
			УдалитьПользовательскийПрефикс,
			УдалитьНулиВНомере);
	
	Возврат Результат;
	
КонецФункции

