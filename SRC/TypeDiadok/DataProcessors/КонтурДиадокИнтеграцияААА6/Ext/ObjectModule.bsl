// Вызывается из МодульМенеджер.ЗначенияПолейМаршрутизацииПоПодразделениям.
// Переопределяет получение значений полей маршрутизации по документу 1С
//
// Параметры:
//	ПоляОтправителя		- Массив 			- значения полей маршрутизации в подразделение отправителя
//	ПоляПолучателя		- Массив 			- значения полей маршрутизации в подразделение получателя
//	Документ1С			- ДокументСсылка 	- документ пакета, для которого определяются значения полей
Процедура ЗаполнитьЗначенияПолейМаршрутизацииПоПодразделениям(ПоляОтправителя, ПоляПолучателя, Документ1С) Экспорт
	
	МетаданныеДокумента1С = Документ1С.Метаданные();
	
	ЕстьРеквизитПодразделение	= Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "ПодразделениеКомпании");
	ЕстьРеквизитОрганизация		= Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "Организация");
	ЕстьРеквизитКонтрагент		= Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "Контрагент");
	
	ИменаРеквизитов = Новый Массив;
		
	Если ЕстьРеквизитПодразделение Тогда
		ИменаРеквизитов.Добавить("ПодразделениеКомпании");
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация Тогда
		ИменаРеквизитов.Добавить("Организация");
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент Тогда
		ИменаРеквизитов.Добавить("Контрагент");
	КонецЕсли;
		
	Разделитель 		= ",";
	ТребуемыеРеквизиты 	= Ядро.СоединитьСтроку(ИменаРеквизитов, Разделитель);
	
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		Реквизиты = Ядро.Общее_ЗначенияРеквизитовОбъекта(Документ1С, ТребуемыеРеквизиты);
	КонецЕсли;
	
	// В коллекции ПоляОтправителя и ПоляПолучателя индекс элементов соответствует приоритету этих элементов.
	// Чем меньше индекс, тем выше приоритет.
	
	Если ЕстьРеквизитПодразделение И ЗначениеЗаполнено(Реквизиты.ПодразделениеКомпании) Тогда
		ПоляОтправителя.Добавить(Реквизиты.ПодразделениеКомпании);
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация И ЗначениеЗаполнено(Реквизиты.Организация) Тогда
		ПоляОтправителя.Добавить(Реквизиты.Организация);
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент И ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Контрагент);
	КонецЕсли;
			
КонецПроцедуры

// См. метод "ПередФормированиемПечатнойФормыСчетаНаОплату" в модуле "МенеджерИнтеграции"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- см. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "МенеджерИнтеграции"
//
Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	СсылкаНаОбъект = ПараметрыМетодаПечати.МассивОбъектов[0];
	
	ИмяМакета = "ПФ_MXL_СчетНаОплату";
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетНаОплатуЗаАвтомобили") Тогда
		ИмяМакета = "СчетНаОплатуЗаАвтомобили";
	КонецЕсли;
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаНаОбъект);
	
	НовыйЭлементТаблицы = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета 	= ИмяМакета;
	НовыйЭлементТаблицы.ИмяВРЕГ 	= ВРег(НовыйЭлементТаблицы.ИмяМакета);
	
КонецПроцедуры

// См. метод "ПриЗаполненииМетыНеформализованногоСчетаНаОплату" в модуле "МенеджерИнтеграции"
//
// Параметры:
//  СчетНаОплату	- ДокументСсылка	- документ, на основании которого формируем печатную форму
//  Мета			- Структура			- см. метод "НовыйРезультатВизуализацииСчетаНаОплату" в модуле "МенеджерИнтеграции"
//
Процедура ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Мета) Экспорт
	
	ПараметрыСчета = МетаСчетаНаОплату(СчетНаОплату);
	
	Мета.Сумма = ПараметрыСчета.СуммаСНалогом;
	Мета.СуммаНДС = ПараметрыСчета.СуммаНалога;
	
КонецПроцедуры

Функция МетаСчетаНаОплату(СсылкаНаОбъект)
	
	Результат = Новый Структура;
	Результат.Вставить("СуммаСНалогом", 0);
	Результат.Вставить("СуммаНалога", 0);
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТЧ.СуммаВсего КАК СуммаСНалогом,
		|	ТЧ.СуммаНДС КАК СуммаНалога
		|ПОМЕСТИТЬ ПоказателиСчетаНаОплату
		|ИЗ
		|	Документ.СчетНаОплату.Товары КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТЧ.СуммаВсего,
		|	ТЧ.СуммаНДС
		|ИЗ
		|	Документ.СчетНаОплату.Автоработы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТЧ.СуммаВсего,
		|	ТЧ.СуммаНДС
		|ИЗ
		|	Документ.СчетНаОплатуЗаАвтомобили.Автомобили КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТЧ.СуммаВсего,
		|	ТЧ.СуммаНДС
		|ИЗ
		|	Документ.СчетНаОплатуЗаАвтомобили.Товары КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВТ.СуммаСНалогом) КАК СуммаСНалогом,
		|	СУММА(ВТ.СуммаНалога) КАК СуммаНалога
		|ИЗ
		|	ПоказателиСчетаНаОплату КАК ВТ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

