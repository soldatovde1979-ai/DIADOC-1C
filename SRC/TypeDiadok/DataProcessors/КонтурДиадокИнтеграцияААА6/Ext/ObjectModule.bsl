	РасчетноеПредставление = "";
		
	МодульУправлениеКИКлиентСервер = ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформациейКлиентСервер");
	МодульУправлениеКИКлиентСервер.СформироватьПредставлениеАдреса(СтруктураАдреса, РасчетноеПредставление);
	
	Если СтруктураАдреса.Свойство("Страна")
		И ЗначениеЗаполнено(СтруктураАдреса.Страна) Тогда
		
		СохраненноеПредставление = СтруктураАдреса.Страна + ", " + СохраненноеПредставление;
		
	КонецЕсли;

	Результат = (ВРег(РасчетноеПредставление) = ВРег(СохраненноеПредставление));
	
	Возврат Результат;

