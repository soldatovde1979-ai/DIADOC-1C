Функция УПД970_ИсходныеДанныеДокумента(ДокументСсылка)
	
	Перем Результат;
	
	Если ЭтоСчетФактураВыданный(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаСчетФактураВыданный(ДокументСсылка);
		
	ИначеЕсли ЭтоРеализацияТоваров(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаРеализацияТоваров(ДокументСсылка);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаКорректировкаРеализации(ДокументСсылка);
		
	ИначеЕсли ЭтоРеализацияАвтомобилей(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаРеализацияАвтомобилей(ДокументСсылка);
		
	ИначеЕсли ЭтоИсправлениеРеализацииАвтомобилей(ДокументСсылка) Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаКорректировкаРеализацииАвтомобилей(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетКомитенту(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомитентуЗаАвтомобили") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетКомитентуЗаАвтомобили(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетКомиссионера(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОтчетКомиссионераЗаАвтомобили") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаОтчетКомиссионераЗаАвтомобили(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратПоставщику") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаВозвратПоставщику(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратПоставщикуАвтомобилей") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаВозвратПоставщикуАвтомобилей(ДокументСсылка);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
		
		Результат = УПД970_ИсходныеДанныеДокументаЗаказНаряд(ДокументСсылка);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокументСсылка));
		
		ВызватьИсключение ТекстОшибки;
	
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция УПД970_НовыеДанныеПервичногоДокумента(
	РезультатЗапросаПоШапке,
	РезультатЗапросаПоТаблицам,
	РезультатЗапросаПоПрослеживаемости)
	
	Результат = УПД970_Контракт_ДанныеПервичногоДокумента();
	
	ТабДанныеШапки = РезультатЗапросаПоШапке.Выгрузить();
	Если ТабДанныеШапки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТабДанныеШапки[0]);
	УПД970_ДополнитьДанныеШапкиЗначениямиДополнительныхСвойств(ДанныеШапки);
	
	ТабличныеДанные = РезультатЗапросаПоТаблицам.Выгрузить();
	
	Если РезультатЗапросаПоПрослеживаемости = Неопределено Тогда
		КодыМаркировки = Неопределено;
	Иначе
		КодыМаркировки = РезультатЗапросаПоПрослеживаемости.Выгрузить();
	КонецЕсли;
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомитентом);
	ЭтоДоговорСКомиссионером = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером);

	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ТабличныеДанные = ТабличныеДанные;
	Результат.КодыМаркировки = КодыМаркировки;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.ЭтоДоговорСКомиссионером = ЭтоДоговорСКомиссионером;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_Контракт_РезультатыЗапросовДанныхПервичногоДокумента()

	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки");
	Результат.Вставить("ТабличныеДанные");
	Результат.Вставить("КодыМаркировки");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВыполнитьЗапросПоДокументу(ТекстыЗапросов, Документ)

	РазделительЗапросов = ТекстЗапроса_РазделительЗапросов();
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, РазделительЗапросов);
	
	УПД970_ЗаменитьИменаПараметровВТекстеЗапросаНаВыражения(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	Запрос.УстановитьПараметр("ТипНоменклатурыТовар", УПД970_ТипНоменклатурыТовар());
	Запрос.УстановитьПараметр("ТипНоменклатурыУслуга", УПД970_ТипНоменклатурыУслуга());
	Запрос.УстановитьПараметр("ТипНоменклатурыРабота", УПД970_ТипНоменклатурыРабота());
	
	Запрос.УстановитьПараметр("КраткоеНаименованиеЕдиницыИзмеренияЧас", УПД970_КраткоеНаименованиеЕдиницыИзмеренияЧас());
	Запрос.УстановитьПараметр("КодЕдиницыИзмеренияЧас", УПД970_КодЕдиницыИзмеренияЧас());
	
	Запрос.УстановитьПараметр("НаименованиеЕдИзмШтука", "шт");
	Запрос.УстановитьПараметр("КодЕдИзмШтука", "796");
	Запрос.УстановитьПараметр("ЕдИзмШтука", Справочники.КлассификаторЕдиницИзмерения.шт);

	Результат = Запрос.ВыполнитьПакет();
	
	Возврат Результат;
	
