Процедура ДобавитьЗапросПоВидуПакетуПакета(Запросы, ОписаниеВидаПакета)
	
	ВидПакетаID = ОписаниеВидаПакета.ID;
	ЭтоИсправление = ЭтоИсправительныйВидПакета(ВидПакетаID);
	
	Если ЭтоВидПакетаОсновной(ВидПакетаID) Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_НаРеализацию(
			Запросы, 
			ОписаниеВидаПакета, 
			ЭтоИсправление
		);
		
	ИначеЕсли ЭтоВидПакетаКорректировочный(ВидПакетаID) Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_Корректировочный(
			Запросы, 
			ОписаниеВидаПакета, 
			ЭтоИсправление
		);
		
	ИначеЕсли ЭтоВидПакетаСчетФактураНаАванс(ВидПакетаID) Тогда
		
		ДобавитьТекстЗапроса_СчетаФактуры_НаАванс(
			Запросы, 
			ОписаниеВидаПакета, 
			ЭтоИсправление
		); 
		
	ИначеЕсли ЭтоВидПакетаБезСчетаФактуры(ВидПакетаID) Тогда
		
		ДобавитьТекстЗапроса_ПервичныеДокументыБезНДС(Запросы, ОписаниеВидаПакета);
		
	ИначеЕсли	ЭтоВидПакетаСчетНаОплату(ВидПакетаID) Тогда
		
		ДобавитьТекстЗапроса_СчетНаОплату(Запросы, ОписаниеВидаПакета);
		
		ДобавитьТекстЗапроса_СчетНаОплатуЗаАвтомобили(Запросы, ОписаниеВидаПакета);
		
	ИначеЕсли	ЭтоВидПакетаАктСверки(ВидПакетаID) Тогда
		
		ДобавитьТекстЗапроса_АктыСверок(Запросы, ОписаниеВидаПакета);
		
	КонецЕсли;
	
КонецПроцедуры


