//{ ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ РАБОТЫ С ТЕКУЩЕЙ КОНФИГУРАЦИЕЙ БАЗЫ

Функция СведенияОбАдресе_(Адрес, ДополнительныеПараметры = Неопределено)

	ВерсияБСП = ВерсияБиблиотекиСтандартныхПодсистем();
	
	Если Ядро.СравнитьВерсии(ВерсияБСП, "2.4") >= 0 Тогда
		ИмяОбщегоМодуля = "РаботаСАдресами";
	Иначе
		ИмяОбщегоМодуля = "УправлениеКонтактнойИнформацией";
	КонецЕсли;
	
	ОбщийМодульРаботыСАдресами = ОбщегоНазначения.ОбщийМодуль(ИмяОбщегоМодуля);
	Результат = ОбщийМодульРаботыСАдресами.СведенияОбАдресе(Адрес, ДополнительныеПараметры);

	Возврат Результат;
	
КонецФункции

Функция ПолучитьКППНаДату_(СсылкаНаОбъект, ДатаСведений)

	Если ЭтоРедакция6_1() Тогда
		МенеджерРеквизитовИстории = ОбщегоНазначения.ОбщийМодуль("РеквизитыСИсторией");
	Иначе
		МенеджерРеквизитовИстории = ОбщегоНазначения;
	КонецЕсли;
	
	Результат = МенеджерРеквизитовИстории.ПолучитьКППНаДату(СсылкаНаОбъект, ДатаСведений);
	
	Возврат Результат;

КонецФункции

Функция СведенияОЮрФизЛице(Ссылка, ДатаСведений)
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
		Результат = Справочники.Организации.ДанныеЮрФизЛицаДляЭДО(Ссылка);
		ДополнитьСведенияОЮрФизЛицеДаннымиОрганизации(Результат, Ссылка);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
		
		Результат = Справочники.ПодразделенияКомпании.ДанныеЮрФизЛицаДляЭДО(Ссылка);
		ДополнитьСведенияОЮрФизЛицеДаннымиПодразделения(Результат, Ссылка);

	Иначе
		
		Результат = Справочники.Контрагенты.ДанныеЮрФизЛицаДляЭДО(Ссылка);
		ДополнитьСведенияОЮрФизЛицеДаннымиКонтрагента(Результат, Ссылка);
		
	КонецЕсли;
	
	Результат.КПП = ПолучитьКППНаДату_(Ссылка, ДатаСведений);
	
	ДополнитьСведенияОЮрФизЛицеТелефономИEmail(Результат, Ссылка, ДатаСведений);
	
	ОсновнойБанковскийСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ОсновнойБанковскийСчет");
	Если ЗначениеЗаполнено(ОсновнойБанковскийСчет) Тогда
		
		РеквизитыСчета = СведенияОБанковскомСчете(ОсновнойБанковскийСчет);
		
		Результат.Банк = РеквизитыСчета.Банк;
		Результат.БИК = РеквизитыСчета.БИК;
		Результат.КоррСчет = РеквизитыСчета.КоррСчет;
		Результат.НомерСчета = РеквизитыСчета.НомерСчета;
		
	Иначе
		
		Результат.Банк = Неопределено;
		Результат.БИК = Неопределено;
		Результат.КоррСчет = Неопределено;
		Результат.НомерСчета = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СведенияОБанковскомСчете(БанковскийСчет)
	
	РеквизитыСчета = Новый Структура;
