Функция ЕстьПересчетНормыВремени()
	
	// С версии 6.1.16 пересчет норм времени авторабот в Заказ-наряде
	// при заполнении товарной части СФ выполняется в запросе (при заполнении СФ на основании),
	// если установлено значение "По норме времени" в строке ТЧ.
	// В более старых версиях пересчет выполняется на лету при формировании типовой ПФ УПД
	
	ВерсияАА = ВерсияПодсистемыАА();
	Результат = (Ядро.СравнитьВерсии(ВерсияАА, "6.1.16") >= 0);
	
	Возврат Результат;
	
КонецФункции

