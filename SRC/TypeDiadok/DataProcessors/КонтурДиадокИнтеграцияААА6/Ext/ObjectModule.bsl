Функция УПД970_КодМаркировкиБезСкобок(Штрихкод)
	
	Если Не СтрНачинаетсяС(Штрихкод, "(") Тогда
		Возврат Штрихкод;
	КонецЕсли;
	
	Результат = СтрЗаменить(Штрихкод, "(01)", "01");
	Результат = СтрЗаменить(Результат, "(21)", "21");
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ГрузоотправительИГрузополучательИзДополнительныхСвойствДокумента(Документ)

	Грузоотправитель = ПредопределенноеЗначение(
		"ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.Грузоотправитель");
	
	Грузополучатель = ПредопределенноеЗначение(
		"ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.Грузополучатель");
	
	ДопРеквизитыИСвойства = Новый Массив;
	ДопРеквизитыИСвойства.Добавить(Грузоотправитель);
	ДопРеквизитыИСвойства.Добавить(Грузополучатель);
	
	Результат = ЗначенияСвойствЛок(Документ, ДопРеквизитыИСвойства);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДатаОтгрузкиИзДополнительныхСвойствДокумента(Документ)
	
	ДопРеквизитыИСвойства = Новый Массив;
	ДопРеквизитыИСвойства.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДатаОтгрузки);
	
	ЗначенияСвойств = ЗначенияСвойствЛок(Документ, ДопРеквизитыИСвойства);
	
	Результат = ЗначениеСвойстваЛок("ДатаОтгрузки", ЗначенияСвойств);
	
	Возврат Результат;
	
