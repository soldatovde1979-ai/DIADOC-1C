	УдалитьПрефиксИнформационнойБазы = УдалятьПрефиксы;
	УдалитьПользовательскийПрефикс = УдалятьПрефиксы;
	УдалитьНулиВНомере = УдалятьПрефиксы;
	
	Результат = ПредставлениеНомера(
			НомерДокумента,
			УдалитьПрефиксИнформационнойБазы,
			УдалитьПользовательскийПрефикс,
			УдалитьНулиВНомере);
	
	Возврат Результат;
	
