Процедура ДополнитьСведенияОЮрФизЛицеТелефономИEmail(СведенияОЮрФизЛице, Ссылка, ДатаСведений)

	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
		ВидКонтактнойИнформацииТелефон = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации;
		ВидКонтактнойИнформацииEmail = Справочники.ВидыКонтактнойИнформации.EmailОрганизации;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
		
		ВидКонтактнойИнформацииТелефон = Справочники.ВидыКонтактнойИнформации.ТелефонПодразделенияКомпании;
		ВидКонтактнойИнформацииEmail = Справочники.ВидыКонтактнойИнформации.EmailПодразделенияКомпании;
		
	Иначе
		
		ВидКонтактнойИнформацииТелефон = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		ВидКонтактнойИнформацииEmail = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
		
	КонецЕсли;
	
	Телефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Ссылка,
		ВидКонтактнойИнформацииТелефон,
		ДатаСведений);
		
	ЭлектроннаяПочта = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		Ссылка,
		ВидКонтактнойИнформацииEmail,
		ДатаСведений);
		
	СведенияОЮрФизЛице.Вставить("Телефоны", Телефон);
	СведенияОЮрФизЛице.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочта);

КонецПроцедуры

Процедура ДополнитьСведенияОЮрФизЛицеДаннымиПодразделения(СведенияОЮрФизЛице, Ссылка)

	ОГРН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Организация.ОГРН");
		
	СведенияОЮрФизЛице.Вставить("ОГРН", ОГРН);
	СведенияОЮрФизЛице.Вставить("СтранаРегистрации", Справочники.СтраныМира.Россия);
	СведенияОЮрФизЛице.Вставить("Нерезидент", Ложь);

КонецПроцедуры

Процедура ДополнитьСведенияОЮрФизЛицеДаннымиОрганизации(СведенияОЮрФизЛице, Ссылка)
	
	ВыбираемыеРеквизиты = Новый Структура;
	ВыбираемыеРеквизиты.Вставить("ДатаРегистрации");

	Если Не ЭтоРедакция6_1() Тогда
		ВыбираемыеРеквизиты.Вставить("ОГРН");
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ВыбираемыеРеквизиты);
		
	СведенияОЮрФизЛице.Вставить("ДатаРегистрации", РеквизитыОрганизации.ДатаРегистрации);
	
	Если Не ЭтоРедакция6_1() Тогда
		СведенияОЮрФизЛице.Вставить("ОГРН", РеквизитыОрганизации.ОГРН);
		СведенияОЮрФизЛице.Вставить("СтранаРегистрации", Справочники.СтраныМира.Россия);
	КонецЕсли;
	
	СведенияОЮрФизЛице.Вставить("Нерезидент", Ложь);
	
КонецПроцедуры

Процедура ДополнитьСведенияОЮрФизЛицеДаннымиКонтрагента(СведенияОЮрФизЛице, Ссылка)
	
	ОписаниеРеквизитов = Новый Структура;
	ОписаниеРеквизитов.Вставить("СтранаРегистрации", "СтранаРегистрации");
	ОписаниеРеквизитов.Вставить("Иностранный", "Иностранный");
	ОписаниеРеквизитов.Вставить("НалоговыйНомер", "НалоговыйНомер");
	ОписаниеРеквизитов.Вставить("ИНН", "ГоловнойКонтрагент.ИНН");
	
	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ОписаниеРеквизитов);
		
	Нерезидент = (РеквизитыКонтрагента.Иностранный
		И РеквизитыКонтрагента.СтранаРегистрации <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия"));
		
	СведенияОЮрФизЛице.Вставить("Нерезидент", Нерезидент);

	Если Не ЭтоРедакция6_1() Тогда
		
		СведенияОЮрФизЛице.Вставить("СтранаРегистрации", РеквизитыКонтрагента.СтранаРегистрации);
		СведенияОЮрФизЛице.Вставить("НалоговыйНомерВСтранеРегистрации", РеквизитыКонтрагента.НалоговыйНомер);
		СведенияОЮрФизЛице.Вставить("ОГРН", "");
		
	КонецЕсли;
	
	ОбособленноеПодразделение = ПредопределенноеЗначение("Перечисление.ФормыСобственности.ОбособленноеПодразделение");
	Если СведенияОЮрФизЛице.ЮрФизЛицо = ОбособленноеПодразделение Тогда
		СведенияОЮрФизЛице.ИНН = РеквизитыКонтрагента.ИНН;
	КонецЕсли;

КонецПроцедуры

