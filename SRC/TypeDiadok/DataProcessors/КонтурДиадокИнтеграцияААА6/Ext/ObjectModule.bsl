	Результат = Ложь;
	
	Если НЕ ЕстьПересчетНормыВремени() Тогда
		Результат = (ТипЗнч(ДокументОснованиеПересчета) = Тип("ДокументСсылка.ЗаказНаряд"));
	КонецЕсли;
	
	Возврат Результат;
	
