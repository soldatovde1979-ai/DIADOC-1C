Функция УПД970_ДанныеУчастникаЭДО(Ссылка, ДатаСведений, БанковскийСчет = Неопределено)

	СведенияОЮрФизЛице = СведенияОЮрФизЛице(Ссылка, ДатаСведений);
		
	НаименованиеУчастникаЭДО = УПД970_НаименованиеУчастникаЭДО(СведенияОЮрФизЛице);
	ЭтоИП = (СведенияОЮрФизЛице.ЮрФизЛицо = Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель);
	ЭтоФизЛицо = (СведенияОЮрФизЛице.ЮрФизЛицо = Перечисления.ФормыСобственности.ЧастноеЛицо);

	Результат = УПД970_Контракт_ДанныеУчастникаЭДО();

	Результат.Ссылка = Ссылка;
	Результат.Наименование = НаименованиеУчастникаЭДО;
	Результат.ИНН = СведенияОЮрФизЛице.ИНН;
	Результат.КПП = СведенияОЮрФизЛице.КПП;
	Результат.КодПоОКПО = СведенияОЮрФизЛице.КодПоОКПО;
	
	Результат.ЭтоЮрЛицо = (Не ЭтоИП И Не ЭтоФизЛицо);
	Результат.ЭтоФизЛицо = ЭтоФизЛицо;
	Результат.Нерезидент = СведенияОЮрФизЛице.Нерезидент;
	
	Если СведенияОЮрФизЛице.Нерезидент Тогда
		Результат.НалоговыйНомерВСтранеРегистрации = СведенияОЮрФизЛице.НалоговыйНомерВСтранеРегистрации;
	КонецЕсли;
	
	Если ЭтоИП Тогда
		Результат.ОГРНИП = СведенияОЮрФизЛице.ОГРН;
		СведенияОЮрФизЛице.Свойство("ДатаРегистрации", Результат.ДатаОГРНИП);
	КонецЕсли;
	
	Если СведенияОЮрФизЛице.Свойство("СтранаРегистрации") Тогда
		Результат.СтранаКод = СведенияОЮрФизЛице.СтранаРегистрации.Код;
		Результат.СтранаНаименование = СведенияОЮрФизЛице.СтранаРегистрации.Наименование;
	КонецЕсли;
	
	Результат.Телефоны = СведенияОЮрФизЛице.Телефоны;
	Результат.ЭлектроннаяПочта = СведенияОЮрФизЛице.ЭлектроннаяПочта;
	
	Если ЗначениеЗаполнено(БанковскийСчет) Тогда
		СведенияОБанковскомСчете = СведенияОБанковскомСчете(БанковскийСчет);
	Иначе
		СведенияОБанковскомСчете = СведенияОЮрФизЛице;
	КонецЕсли;
	
	Результат.НаименованиеБанка = СведенияОБанковскомСчете.Банк;
	Результат.НомерСчета = СведенияОБанковскомСчете.НомерСчета;
	Результат.КоррСчет = СведенияОБанковскомСчете.КоррСчет;
	Результат.БИК = СведенияОБанковскомСчете.БИК;
		
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыПодразделенияОрганизации(Подразделение)
	
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("НаименованиеПолное", "НаименованиеПолное");
	Реквизиты.Вставить("КПП", "КПП");
	Реквизиты.Вставить("Ссылка", "Ссылка");
	
	Если ЭтоРедакция6_1() Тогда
		Реквизиты.Вставить("ОбособленноеПодразделение", "ОбособленноеПодразделение");
	Иначе
		Реквизиты.Вставить("ОбособленноеПодразделение", "Ложь");
	КонецЕсли;
		
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подразделение, Реквизиты);
	
	Если Не ЭтоРедакция6_1() Тогда
		Результат.ОбособленноеПодразделение = ЗначениеЗаполнено(Реквизиты.КПП);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НаименованиеУчастникаЭДО(СведенияОЮрФизЛице)

	Результат = СведенияОЮрФизЛице.ПолноеНаименование;
	
	Если СведенияОЮрФизЛице.ЮрФизЛицо = Перечисления.ФормыСобственности.ИндивидуальныйПредприниматель Тогда
		
		ФИОУчастникаЭДО = Новый Массив;
		ФИОУчастникаЭДО.Добавить(СведенияОЮрФизЛице.Фамилия);
		ФИОУчастникаЭДО.Добавить(СведенияОЮрФизЛице.Имя);
		ФИОУчастникаЭДО.Добавить(СведенияОЮрФизЛице.Отчество);
		
		РазделительФИО = " ";
		Результат = СтрСоединить(ФИОУчастникаЭДО, РазделительФИО);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция УПД970_СведенияОбЮридическомАдресе(Ссылка, ДатаСведений)
	
	Перем Результат;
	
	ВидАдреса = ВидКонтактнойИнформацииЮридическийАдрес(Ссылка);
	Если ВидАдреса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектыКИ = Новый Массив;
	ОбъектыКИ.Добавить(Ссылка);
	
	ТипАдреса = Неопределено;
	
	СведенияОбАдресах = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		ОбъектыКИ,
		ТипАдреса,
		ВидАдреса,
		ДатаСведений);
		
	Результат = УПД970_СтруктураАдресаОбъекта(СведенияОбАдресах);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СведенияОФактическомАдресе(Ссылка, ДатаСведений)
	
	Перем Результат;
	
	ВидАдреса = ВидКонтактнойИнформацииФактическийАдрес(Ссылка);
	Если ВидАдреса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбъектыКИ = Новый Массив;
	ОбъектыКИ.Добавить(Ссылка);
	
	ТипАдреса = Неопределено;
	
	СведенияОбАдресах = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		ОбъектыКИ,
		ТипАдреса,
		ВидАдреса,
		ДатаСведений);
		
	Результат = УПД970_СтруктураАдресаОбъекта(СведенияОбАдресах);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_СтруктураАдресаОбъекта(СведенияОбАдресах)
	
	Перем Результат;
	
	Если ЗначениеЗаполнено(СведенияОбАдресах) Тогда
		
		СведенияОбАдресе = СведенияОбАдресах[0];
		
		ДопПараметры = УПД970_ДополнительныеПараметрыДляПолученияАдреса();
		
		Если ЭтоРедакция6_1() Тогда
			СтрокаАдреса = СведенияОбАдресе.Значение;
		Иначе
			СтрокаАдреса = СведенияОбАдресе.ЗначенияПолей;
		КонецЕсли;
		
		Результат = СведенияОбАдресе_(СтрокаАдреса, ДопПараметры);
		
		Если Не ЭтоРедакция6_1() Тогда
			
			ЭтоАдресВСвободнойФорме = ЭтоАдресВСвободнойФорме(Результат, СведенияОбАдресе.Представление);
			
			Если ЭтоАдресВСвободнойФорме Тогда
				
				ТипАдреса = "";
				Представление = СведенияОбАдресе.Представление;
				
			Иначе
				
				ТипАдреса = АдминистративноТерриториальныйАдрес();
				Представление = СведенияОбАдресе.Представление;
				
			КонецЕсли;
			
			Результат.Вставить("ТипАдреса", ТипАдреса);
			Результат.Вставить("Представление", Представление);
			
		Иначе
			
			Если Результат.ТипАдреса = "ВСвободнойФорме" Тогда
				Результат.Вставить("Представление", СведенияОбАдресе.Представление);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДополнительныеПараметрыДляПолученияАдреса()

	Результат = Новый Структура;
