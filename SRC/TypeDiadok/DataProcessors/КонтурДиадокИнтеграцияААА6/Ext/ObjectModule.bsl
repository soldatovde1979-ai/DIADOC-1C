Функция УПД970_ИсправляемыйДокументОтгрузки(ИсходныйДокумент)
	
	ТипДокумента = ТипЗнч(ИсходныйДокумент);
	
	ЭтоИсправительныйДокумент = (ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации")
		Или ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализацииАвтомобилей"));
	
	Если ЭтоИсправительныйДокумент Тогда
		
		ДокументРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсходныйДокумент, "ДокументОснование");
		Результат = УПД970_ИсправляемыйДокументОтгрузки(ДокументРеализации);
		
	Иначе
		
		Результат = ИсходныйДокумент;
		
	КонецЕсли;
	
	Возврат Результат;

