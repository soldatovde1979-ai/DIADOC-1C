// Возвращает виды документов из текущей конфигурации для поиска в модуле
// 
// Возвращаемое значение:
//  Массив - Предопределенные виды документов конфигурации для поиска в модуле
//
Функция ВидыПредопределенныхДокументовДляПоискаВМодуле() Экспорт
	
	ДокументыКонфигурации = Метаданные.Документы;
	
	Результат = Новый Массив;
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомиссионера);
	Результат.Добавить(ДокументыКонфигурации.РеализацияАвтомобилей);
	Результат.Добавить(ДокументыКонфигурации.КорректировкаРеализации);
	Результат.Добавить(ДокументыКонфигурации.ЗаказНаряд);
	Результат.Добавить(ДокументыКонфигурации.РеализацияТоваров);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомиссионераЗаАвтомобили);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомитенту);
	Результат.Добавить(ДокументыКонфигурации.КорректировкаРеализацииАвтомобилей);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомитентуЗаАвтомобили);
	Результат.Добавить(ДокументыКонфигурации.СчетНаОплату);
	Результат.Добавить(ДокументыКонфигурации.СчетНаОплатуЗаАвтомобили);
	Результат.Добавить(ДокументыКонфигурации.СчетФактураВыданный);
	
	Возврат Результат;
	
КонецФункции

