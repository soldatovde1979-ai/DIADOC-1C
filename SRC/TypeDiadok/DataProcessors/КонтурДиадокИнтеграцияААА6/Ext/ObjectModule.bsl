Функция ТекстЗапроса_ВыбытиеМаркируемойПродукцииДляСобственныхНуждПоСчетФактуре()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА СчетаФактуры.ДокументОснование ССЫЛКА Документ.РеализацияТоваров
	|			ТОГДА ВЫРАЗИТЬ(СчетаФактуры.ДокументОснование КАК Документ.РеализацияТоваров).ПричинаВыводаИзОборота
	|		КОГДА СчетаФактуры.ДокументОснование ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА ВЫРАЗИТЬ(СчетаФактуры.ДокументОснование КАК Документ.КорректировкаРеализации).ПричинаВыводаИзОборота
	|		КОГДА СчетаФактуры.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	|			ТОГДА ВЫРАЗИТЬ(СчетаФактуры.ДокументОснование КАК Документ.ЗаказНаряд).ПричинаВыводаИзОборота
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПричинаВыводаИзОборота
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетаФактуры
	|ГДЕ
	|	СчетаФактуры.Ссылка = &Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция ВариантВыбытияМаркируемойПродукции(ДокументСсылка)
	
	Результат = "";
	
	ВариантыВыбытия = Новый Соответствие;
	ВариантыВыбытия.Вставить(Перечисления.ПричиныВыбытияМаркируемойПродукции.ПустаяСсылка(),						"");
	ВариантыВыбытия.Вставить(Перечисления.ПричиныВыбытияМаркируемойПродукции.ИспользованиеДляСобственныхНужд,		"1");
	ВариантыВыбытия.Вставить(Перечисления.ПричиныВыбытияМаркируемойПродукции.БезвозмезднаяПередача,					"2");
	ВариантыВыбытия.Вставить(Перечисления.ПричиныВыбытияМаркируемойПродукции.ПриобретениеВРамкахГосКонтракта,		"3");
	ВариантыВыбытия.Вставить(Перечисления.ПричиныВыбытияМаркируемойПродукции.ИспользованиеДляПроизводственныхЦелей,	"4");
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса_ВыбытиеМаркируемойПродукцииДляСобственныхНуждПоСчетФактуре();
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Причина = Выборка.ПричинаВыводаИзОборота;
			Результат = ВариантыВыбытия.Получить(Причина);
		КонецЕсли;
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваров")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ЗаказНаряд")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
	
		Причина = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПричинаВыводаИзОборота");
		Результат = ВариантыВыбытия.Получить(Причина);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокументСсылка) Тогда
		
		Причина = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка.ДокументОснование, "ПричинаВыводаИзОборота");
		Результат = ВариантыВыбытия.Получить(Причина);
		
	Иначе
		
			Результат = "";
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьПризнакВыбытияИзОборотаМаркируемойПродукции(Контент, ДокСсылка)
	
	ВариантВыбытияМаркируемойПродукции = ВариантВыбытияМаркируемойПродукции(ДокСсылка);
	
	ЕстьКодыМаркировки = УПД970_ВКонтентеЕстьКодыМаркировки(Контент.Table.Items);
	
	Если ЕстьКодыМаркировки
		И Контент.Function <> ФункцияДокумента_СЧФ()
		И ВариантВыбытияМаркируемойПродукции <> "" Тогда
		
		Если Контент.AdditionalInfoId = Неопределено Тогда
			Контент.AdditionalInfoId = Контракт_AdditionalInfoId();
		КонецЕсли;
	
		ПризнакВыбытия = Новый Структура;
		ПризнакВыбытия.Вставить("Key", "СвВыбытияМАРК");
		ПризнакВыбытия.Вставить("Value", Число(ВариантВыбытияМаркируемойПродукции));
	
		Контент.AdditionalInfoId.StructedAdditionalInfos.Добавить(ПризнакВыбытия);
	
	КонецЕсли;
	
КонецПроцедуры

