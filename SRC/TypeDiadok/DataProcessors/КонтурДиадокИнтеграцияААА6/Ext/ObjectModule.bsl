Функция УПД970_ЭтоПоддерживаемыйТипПервичногоДокумента(ДокументСсылка)
	
	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить(Тип("ДокументСсылка.РеализацияТоваров"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.РеализацияАвтомобилей"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.КорректировкаРеализацииАвтомобилей"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ОтчетКомитенту"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ОтчетКомитентуЗаАвтомобили"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ОтчетКомиссионера"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ОтчетКомиссионераЗаАвтомобили"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ВозвратПоставщику"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ВозвратПоставщикуАвтомобилей"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ЗаказНаряд"));
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Результат = (ТипыДокументов.Найти(ТипДокумента) <> Неопределено);
	
	Возврат Результат;
	
