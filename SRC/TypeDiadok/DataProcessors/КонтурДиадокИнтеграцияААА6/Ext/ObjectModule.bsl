// Возвращает заполненную протоструктуру титула продавца в формате 970 по данным документа 1С
//
// Параметры:
//  ДокСсылка		 - ДокументСсылка - ссылка на учетный документ 1С,
//										по которому заполняется протоконтент титула продавца 970@
//  ФункцияДокумента - Строка - функция УПД (возможные значения: СЧФ, СЧФДОП, ДОП)
//  ДополнительныеПараметры	 - Структура - Модуль_Ядро.ДополнительныеПараметрыПолученияКонтента
// 
// Возвращаемое значение:
//  Структура - заполненный протоконтент УПД (см. Контракт_ПротоСтруктураУПД970)
//
Функция УПД970_КонтентТитулаПродавца(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры) Экспорт
	
	Перем Результат;
	
	Если ЭтоСчетФактураВыданный(ДокСсылка) Тогда
		
		Если ЭтоСчетФактураНаАванс(ДокСсылка) Тогда
			Результат = УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураВыданныйНаАванс(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
		Иначе
			Результат = УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураВыданный(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
		КонецЕсли;
			
	ИначеЕсли УПД970_ЭтоПоддерживаемыйТипПервичногоДокумента(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоПервичномуДокументуОбщее(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

//} УПД970. Программный интерфейс

//{ УПД970. Заполнение протоструктуры по документам

Функция УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураВыданный(
	СчетФактура,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	Перем Контент;
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокумента(СчетФактура);
	
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	СведенияОДокументахОплаты = ДанныеПоДокументу.СведенияОДокументахОплаты;
	
	Контент = Контракт_ПротоструктураУПД970();
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента);
	Контент.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;

	Если ДанныеШапки.Исправление Тогда
		УПД970_ЗаполнитьДатуНомерДляИсправительногоДокумента(Контент, ДанныеШапки);
	Иначе
		УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки);
	КонецЕсли;
		
	УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(
		Контент,
		СведенияОДокументахОплаты);
	
	ОснованиеПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваровПоОснованиюСчетФактураВыданный(
		Контент,
		ДанныеШапки);
		
	УПД970_ЗаполнитьРеквизитыОснованияПередачиТоваров(Контент, ОснованиеПередачиТоваров, ДополнительныеПараметры);
	УПД970_ЗаполнитьДатуОтгрузки(Контент, ДанныеШапки);

	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки);
	
	ПересчитыватьНормыВремени = ТребуетсяПересчетНормыВремени(ДанныеШапки.ДокументОснование);
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокумента(
		Контент,
		ДанныеПоДокументу,
		ДополнительныеПараметры,
		ПересчитыватьНормыВремени);
		
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, ДанныеШапки);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДанныеШапки.ДокументОснование, ФункцияДокумента);

	УПД970_ЗаполнитьНаименованиеДокумента(Контент, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОСотруднике(Контент, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	Если ДополнительныеПараметры.ИспользоватьСервисКонтурМаркировка Тогда
		УПД970_ЗаполнитьСведенияОМаркировкеЧерезСервисКонтурМаркировки(Контент, СчетФактура);
	КонецЕсли;
	
	УПД970_ЗаполнитьПризнакВыбытияИзОборотаМаркируемойПродукции(
		Контент,
		СчетФактура);
	
		Возврат Контент;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоДокументуСчетФактураВыданныйНаАванс(
	ДокСсылка,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокументаСчетФактураВыданныйНаАванс(ДокСсылка);
	
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	
	Контент = Контракт_ПротоструктураУПД970();
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента);
	Контент.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	
	УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки);
	
	УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(
		Контент,
		ДанныеПоДокументу.СведенияОДокументахОплаты);
		
	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки);
	
	УПД970_ЗаполнитьТаблицуКонтентаПоДаннымСчетФактураНаАванс(
		Контент,
		ДанныеПоДокументу.ТабличныеДанные,
		ДополнительныеПараметры);
		
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, ДанныеШапки);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	Контент.Shippers.Очистить();
	Контент.Consignees.Очистить();

	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	Возврат Контент;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоПервичномуДокументуОбщее(
	ДокСсылка,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	ДанныеПоДокументу = УПД970_ИсходныеДанныеДокумента(ДокСсылка);
	
	ДанныеШапки = ДанныеПоДокументу.ДанныеШапки;
	
	Контент = Контракт_ПротоструктураУПД970();
	
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияДокумента(ДанныеПоДокументу, ФункцияДокумента);
	Контент.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	
	УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки);
		
	УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки);
	
	ДокументыПередачиТоваров = Новый Массив;
	ДокументыПередачиТоваров.Добавить(ДокСсылка);
	
	ОснованияПередачиТоваров = УПД970_РеквизитыОснованияПередачиТоваровПоОснованиюСчетФактураВыданный(
		Контент,
		ДанныеШапки);
		
	УПД970_ЗаполнитьРеквизитыОснованияПередачиТоваров(Контент,
		ОснованияПередачиТоваров,
		ДополнительныеПараметры);
		
	УПД970_ЗаполнитьТаблицуТоваровКонтентаПоДаннымДокумента(
		Контент,
		ДанныеПоДокументу,
		ДополнительныеПараметры);
		
	УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, ДанныеШапки);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);

	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДокСсылка, ФункцияДокумента);
	УПД970_ЗаполнитьДатуОтгрузки(Контент, ДанныеШапки);

	УПД970_ЗаполнитьНаименованиеДокумента(Контент, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОСотруднике(Контент, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	
	Если ДополнительныеПараметры.ИспользоватьСервисКонтурМаркировка Тогда
		УПД970_ЗаполнитьСведенияОМаркировкеЧерезСервисКонтурМаркировки(Контент, ДокСсылка);
	КонецЕсли;
	
	УПД970_ЗаполнитьПризнакВыбытияИзОборотаМаркируемойПродукции(
		Контент,
		ДокСсылка);
		
	Возврат Контент;
	
КонецФункции

//{ УПД970. Заполнение протоструктуры по документам. Общее

Процедура УПД970_ЗаполнитьДатуНомер(Контент, ДанныеШапки)
	
	НомерДокумента = УПД970_ПредставлениеНомераДокумента(ДанныеШапки.Номер);
	
	ДобавитьИндексОП = (ЗначениеЗаполнено(ДанныеШапки.ПодразделениеОрганизации)
		И ЭтоРедакция6_1()
		И ЭтоСчетФактураВыданный(ДанныеШапки.Ссылка));
	
	ЧастиНомераДокумента = Новый Массив;
	ЧастиНомераДокумента.Добавить(НомерДокумента);
	
	Если ДобавитьИндексОП Тогда
		
		ИндексПодразделения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДанныеШапки.ПодразделениеОрганизации,
			"ЦифровойИндексОбособленногоПодразделения");
			
		Если ЗначениеЗаполнено(ИндексПодразделения) Тогда
			ЧастиНомераДокумента.Добавить(Формат(ИндексПодразделения, "ЧГ=0"));
		КонецЕсли;
			
	КонецЕсли;
	
	Контент.DocumentNumber = СтрСоединить(ЧастиНомераДокумента, "/");
	Контент.DocumentDate = ДанныеШапки.Дата;

КонецПроцедуры

Процедура УПД970_ЗаполнитьДатуНомерДляИсправительногоДокумента(Контент, ДанныеШапки)

	Контент.RevisionNumber = ДанныеШапки.НомерИсправления;
	Контент.RevisionDate = ДанныеШапки.Дата;
	
	Контент.DocumentNumber = УПД970_НомерИсходногоДокументаИсправительногоСчетФактураВыданный(ДанныеШапки);
	Контент.DocumentDate = УПД970_ДатаИсходногоДокументаИсправительногоСчетФактураВыданный(ДанныеШапки);

КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОДокументахОплатыСчетаФактуры(Контент, СведенияОДокументахОплаты)
	
	Для Каждого СтрокаТаблицы Из СведенияОДокументахОплаты Цикл
		
		PaymentDocument = Контракт_PaymentDocumentInfo();
		
		PaymentDocument.Number = СтрокаТаблицы.НомерДокумента;
		PaymentDocument.Date = СтрокаТаблицы.ДатаДокумента;
		
		Контент.PaymentDocuments.Добавить(PaymentDocument);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьРеквизитыОснованияПередачиТоваров(
	Контент,
	РеквизитыОснования,
	ДополнительныеПараметры)
	
	Перем УказыватьОтсутствиеОснованияУПД;
	
	TransferInfo = Контракт_TransferInfo970();
	Контент.TransferInfo = TransferInfo;
	
	TransferInfo.OperationInfo = "Товары переданы, работы сданы, услуги оказаны";
	
	ДополнительныеПараметры.Свойство("УказыватьОтсутствиеОснованияУПД", УказыватьОтсутствиеОснованияУПД);
	
	РеквизитыЗаполнены = УПД970_РеквизитыОснованияЗаполнены(РеквизитыОснования);
		
	Если Не РеквизитыЗаполнены
		И УказыватьОтсутствиеОснованияУПД = Истина Тогда
		
		TransferInfo.TransferBases.Очистить();
		
	Иначе
		
		TransferBase = УПД970_НовыйTransferBase(РеквизитыОснования);
		TransferInfo.TransferBases.Добавить(TransferBase);
		
	КонецЕсли;
	
	Если TransferInfo.TransferBases.Количество() = 0 Тогда
		TransferInfo.WithoutTransferBase = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ИсходныйДокумент, ФункцияДокумента)
	
	ДокументОтгрузки = УПД970_ИсправляемыйДокументОтгрузки(ИсходныйДокумент);
	
	СтрокиТаблицы = Контент.Table.Items;
	
	НаименованиеДокумента = УПД970_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ФункцияДокумента);
	
	Если ФункцияДокумента = ФункцияДокументаУПД_СЧФ() Тогда
		
		РеквизитыДокументаОтгрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДокументОтгрузки,
			"Дата, Номер");
			
		НомерДокумента = УПД970_ПредставлениеНомераДокумента(РеквизитыДокументаОтгрузки.Номер);
		ДатаДокумента = РеквизитыДокументаОтгрузки.Дата;
		
		DocumentShipment = УПД970_НовыйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента);
		Контент.DocumentShipments.Добавить(DocumentShipment);
			
	Иначе
		
		НомерДокумента = Контент.DocumentNumber;
		ДатаДокумента = Контент.DocumentDate;
		
		DocumentShipment = УПД970_НовыйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента);
		Контент.DocumentShipments.Добавить(DocumentShipment);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьНаименованиеДокумента(Контент, ФункцияДокумента)
	
	Если ФункцияДокумента <> ФункцияДокументаУПД_СЧФ()
		И Контент.DocumentShipments.Количество() > 0 Тогда
		Контент.DocumentName = Контент.DocumentShipments[0].Name;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьДатуОтгрузки(Контент, ДанныеШапки)
	
	Если Контент.Function <> ФункцияДокументаУПД_СЧФ() Тогда
		
		ДатаОтгрузки = ДанныеШапки.ДатаОтгрузки;
		Если Не ЗначениеЗаполнено(ДатаОтгрузки) Тогда
			ДатаОтгрузки = ДанныеШапки.Дата;
		КонецЕсли;

		Контент.TransferInfo.TransferDate = ДатаОтгрузки;

	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ЗаполнитьВалюту(Контент, ДанныеШапки)
	
	Валюта = ДанныеШапки.ВалютаДокумента;
	
	Контент.Currency = Валюта.Код;

КонецПроцедуры

Процедура УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент)
	
	Контент.DocumentCreator = "";
	Контент.DocumentCreatorBase = "";
	
	Если Контент.Sellers.Количество() > 0 Тогда
		
		ПродавецИнфо = Контент.Sellers[0];
		Контент.DocumentCreator = ПредставлениеЮрФизЛица(ПродавецИнфо.Name, ПродавецИнфо.Inn, ПродавецИнфо.Kpp);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОбУчастникахЭДО(Контент, ДанныеШапки)
	
	СведенияОбУчастникахЭДО = УПД970_СведенияОбУчастникахЭДО(ДанныеШапки);
	
	Seller = Контракт_ExtendedOrganizationInfo970();
	Контент.Sellers.Добавить(Seller);
	УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, СведенияОбУчастникахЭДО.Организация);
	Seller.СлужебнаяИнформация.Ссылка = СведенияОбУчастникахЭДО.Организация.Ссылка;
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	Контент.Buyers.Добавить(Buyer);
	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, СведенияОбУчастникахЭДО.Контрагент);
	Buyer.СлужебнаяИнформация.Ссылка = СведенияОбУчастникахЭДО.Контрагент.Ссылка;
	
	ВДокументеЕстьТовары = УПД970_ВДокументеЕстьТовары(Контент.Table.Items);

	Грузоотправитель = СведенияОбУчастникахЭДО.Грузоотправитель;
	Если Грузоотправитель <> Неопределено
		И ВДокументеЕстьТовары Тогда
		
		Shipper = Контракт_Shipper970();
		Shipper.SameAsSeller = Ложь;
		
		Контент.Shippers.Добавить(Shipper);
		
		Если Грузоотправитель.Ссылка = СведенияОбУчастникахЭДО.Организация.Ссылка
			И Контент.Function <> ФункцияДокументаУПД_ДОП() Тогда
			
			Shipper.SameAsSeller = Истина;
			
		Иначе
			
			ShipperInfo = Контракт_ExtendedOrganizationInfo970();
			Shipper.OrganizationInfo = ShipperInfo;
			
			УПД970_ЗаполнитьExtendedOrganizationInfo(ShipperInfo, Грузоотправитель);
			
			ShipperInfo.СлужебнаяИнформация.Ссылка = Грузоотправитель.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СведенияОбУчастникахЭДО.Грузополучатель <> Неопределено
		И ВДокументеЕстьТовары Тогда
		
		Consignee = Контракт_ExtendedOrganizationInfo970();
		Контент.Consignees.Добавить(Consignee);

		УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, СведенияОбУчастникахЭДО.Грузополучатель);
		
		Consignee.СлужебнаяИнформация.Ссылка = СведенияОбУчастникахЭДО.Грузополучатель.Ссылка;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьExtendedOrganizationInfo(Content, ДанныеУчастникаЭДО)
	
	Content.Type = УПД970_ExtendedOrganizationInfoType(ДанныеУчастникаЭДО);
	
	Content.Name = ДанныеУчастникаЭДО.Наименование;
	
	Content.Inn = ДанныеУчастникаЭДО.ИНН;
	Content.Kpp = ДанныеУчастникаЭДО.КПП;
	Content.Okpo = ДанныеУчастникаЭДО.КодПоОКПО;
	
	Content.IndividualEntityRegistrationCertificate = ДанныеУчастникаЭДО.Свидетельство;
	
	Content.IndividualEntityRegistrationNumber = ДанныеУчастникаЭДО.ОГРНИП;
	Content.IndividualEntityRegistrationDate = ДанныеУчастникаЭДО.ДатаОГРНИП;
	
	Content.LegalEntityId = ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации;
	
	Content.Country = ДанныеУчастникаЭДО.СтранаНаименование;
	Content.CountryCode = ДанныеУчастникаЭДО.СтранаКод;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Телефоны) Тогда
		Content.Phone.Добавить(ДанныеУчастникаЭДО.Телефоны);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.ЭлектроннаяПочта) Тогда
		Content.Email.Добавить(ДанныеУчастникаЭДО.ЭлектроннаяПочта);
	КонецЕсли;
	
	Content.BankName = ДанныеУчастникаЭДО.НаименованиеБанка;
	Content.BankAccountNumber = ДанныеУчастникаЭДО.НомерСчета;
	Content.CorrespondentAccount = ДанныеУчастникаЭДО.КоррСчет;
	Content.BankId = ДанныеУчастникаЭДО.БИК;
	
	УПД970_ЗаполнитьAddressInfo(Content, ДанныеУчастникаЭДО.Адрес);
	
	Content.СлужебнаяИнформация.Ссылка = ДанныеУчастникаЭДО.Ссылка;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьAddressInfo(OrganizationInfo, СведенияОбАдресе)
	
	Если Не ЗначениеЗаполнено(СведенияОбАдресе) Тогда
		Возврат;
	КонецЕсли;
	
	AddressInfo = Контракт_AddressInfo970();
	OrganizationInfo.Address = AddressInfo;
	
	ВидыАдресов = ГенерацияXML.Перечисление_ВидыАдресов();
	
	ЭтоАдресВФорматеГАР = УПД970_ЭтоАдресВФорматеАдрГАР(СведенияОбАдресе);
	ЭтоАдресВФорматеРФ = УПД970_ЭтоАдресВФорматеАдрРФ(СведенияОбАдресе);
	
	Если ЭтоАдресВФорматеГАР Тогда
		
		AddressSAR = УПД970_НовыйAddressSAR(СведенияОбАдресе);
		
		AddressInfo.AddressSAR = AddressSAR;
		AddressInfo.Type = ВидыАдресов.АдресГАР;
		
	ИначеЕсли ЭтоАдресВФорматеРФ Тогда
		
		AddressRF = УПД970_НовыйAddressRF(СведенияОбАдресе);
		
		AddressInfo.AddressRF = AddressRF;
		AddressInfo.Type = ВидыАдресов.АдресРФ;
		
	Иначе
		
		AddressText = УПД970_НовыйAddressText(СведенияОбАдресе);
		
		AddressInfo.AddressText = AddressText;
		AddressInfo.Type = ВидыАдресов.АдресСтрокой;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Поселение) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.Поселение;
		AddressSAR.SettlementCode = СведенияОбАдресе.КодПоселения;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.ВнутригородскойРайон) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.ВнутригородскойРайон;
		AddressSAR.SettlementCode = "4";
		
	Иначе
		
		AddressSAR.Settlement = "";
		AddressSAR.SettlementCode = "";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОНаселенномПункте(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.НаселенныйПункт) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.НаселенныйПункт;
		AddressSAR.LocalityType = СведенияОбАдресе.НаселенныйПунктТипКраткий;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.Город) Тогда
		
