Функция УПД970_ИсходныеДанныеДокументаСчетФактураВыданный(ДокСсылка)
	
	ТекстЗапросаРеквизиты = УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданный();
	ТекстЗапросаТабличныеДанные = УПД970_ТекстЗапросаТабличныхДанныхДокументаСчетФактураВыданный();
	ТекстЗапросаДанныхОДокументахОплаты = УПД970_ТекстЗапросаДанныхОДокументахОплатыСчетФактурыВыданный();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаРеквизиты);
	ТекстыЗапросов.Добавить(ТекстЗапросаТабличныеДанные);
	ТекстыЗапросов.Добавить(ТекстЗапросаДанныхОДокументахОплаты);
	
	РезультатыЗапроса = УПД970_ВыполнитьЗапросПоДокументу(ТекстыЗапросов, ДокСсылка);
	
	Результат = УПД970_Контракт_ДанныеСчетФактураВыданный();
	
	ТабДанныеШапки = РезультатыЗапроса[0].Выгрузить();
	ДанныеШапки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТабДанныеШапки[0]);
	
	УПД970_ДополнитьДанныеШапкиЗначениямиДополнительныхСвойств(ДанныеШапки);

	ТабличныеДанные = РезультатыЗапроса[1].Выгрузить();
	
	СведенияОДокументахОплаты = РезультатыЗапроса[2].Выгрузить();
	
	ЭтоДоговорСКомитентом = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомитентом);
	ЭтоДоговорСКомиссионером = (ДанныеШапки.ВидДоговора = Перечисления.ВидыДоговоров.СКомиссионером);
	
	Результат.ДанныеШапки = ДанныеШапки;
	Результат.ТабличныеДанные = ТабличныеДанные;
	Результат.СведенияОДокументахОплаты = СведенияОДокументахОплаты;
	Результат.ЭтоДоговорСКомитентом = ЭтоДоговорСКомитентом;
	Результат.ЭтоДоговорСКомиссионером = ЭтоДоговорСКомиссионером;
	Результат.ЭтоСчетФактураНаАванс = Ложь;
	
	УПД970_ДополнитьДанныеСчетФактурыСведениямиОКодахМаркировки(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеДокументаСчетФактураВыданныйНаАванс(ДокСсылка)
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданныйНаАванс());
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаТабличныхДанныхДокументаСчетФактураВыданныйНаАванс());
	ТекстыЗапросов.Добавить(УПД970_ТекстЗапросаДанныхОДокументахОплатыСчетФактурыВыданный());
	
	ТекстЗапроса = Ядро.СоединитьСтроку(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	УПД970_ЗаменитьИменаПараметровВТекстеЗапросаНаВыражения(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = УПД970_Контракт_ДанныеСчетФактураВыданный();
	
	ТабДанныеШапки = РезультатыЗапроса[0].Выгрузить();
