	Если Подключено Тогда
		РасширениеПодключено = Истина;
		КонтурДиадокСтдОбщегоНазначенияКлиент.ВыполнитьОбработкуОповещенияЛок(ДопПараметры.ИсходноеОповещение, РасширениеПодключено);
	ИначеЕсли ДопПараметры.УстановитьЕслиНеПодключено Тогда
		
		Оповещение = КонтурДиадокСтдОбщегоНазначенияКлиент.ОписаниеОповещения(
				"ПослеУстановкиРасширенияРаботыСФайлами",
				КонтурДиадокСтдФССлужебныйКлиент,
				ДопПараметры.ИсходноеОповещение);
		
		КонтурДиадокСтдФССлужебный83Клиент.НачатьУстановкуРасширенияРаботыСФайламиЛок(Оповещение);
		
	Иначе
		// не удалось подключить или установить расширение
		ВызватьИсключение("Не удалось подключить или установить расширение");
	КонецЕсли;
	
КонецПроцедуры // ПослеПодключенияРасширенияРаботыСФайлами

Процедура ПослеУстановкиРасширенияРаботыСФайлами(ИсходноеОповещение) Экспорт
	
	ПодключитьУстановитьРасширениеРаботыСФайлами(ИсходноеОповещение, Ложь);
	
КонецПроцедуры // ПослеУстановкиРасширенияРаботыСФайлами

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура НачатьПомещениеФайлаНаСерверОбработкаИсточникаФайла(ВыбранноеИмяФайла, ПутьКФайлуПараметрыДиалога)
	
	ТипЗнчИсточника = ТипЗнч(ПутьКФайлуПараметрыДиалога);
	
	Если ТипЗнчИсточника = Тип("ФиксированнаяСтруктура")
		И ПутьКФайлуПараметрыДиалога.Свойство("Заголовок") Тогда
		
		ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогОткрытияФайла.Заголовок = ПутьКФайлуПараметрыДиалога.Заголовок;
		ДиалогОткрытияФайла.МножественныйВыбор = ПутьКФайлуПараметрыДиалога.МножественныйВыбор;
		ДиалогОткрытияФайла.Фильтр = ПутьКФайлуПараметрыДиалога.Фильтр;
		
		Если ДиалогОткрытияФайла.Выбрать() Тогда
			ВыбранноеИмяФайла = ДиалогОткрытияФайла.ПолноеИмяФайла;
		КонецЕсли;
		
	ИначеЕсли ТипЗнчИсточника = Тип("Строка") Тогда
		ВыбранноеИмяФайла = ПутьКФайлуПараметрыДиалога;
	Иначе
		ВызватьИсключение "Ошибка типа: " + ТипЗнчИсточника;
	КонецЕсли;
	
КонецПроцедуры // НачатьПомещениеФайлаНаСерверОбработкаИсточникаФайла

Процедура ПодключитьУстановитьРасширениеРаботыСФайлами(ИсходноеОповещение, УстановитьЕслиНеПодключено = Истина)
	
	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("УстановитьЕслиНеПодключено", УстановитьЕслиНеПодключено);
	ДопПараметры.Вставить("ИсходноеОповещение", ИсходноеОповещение);
	
	Оповещение = КонтурДиадокСтдОбщегоНазначенияКлиент.ОписаниеОповещения(
			"ПослеПодключенияРасширенияРаботыСФайлами",
			КонтурДиадокСтдФССлужебныйКлиент,
			ДопПараметры);
	
	КонтурДиадокСтдФССлужебный83Клиент.НачатьПодключениеРасширенияРаботыСФайламиЛок(Оповещение);
	
КонецПроцедуры // ПодключитьУстановитьРасширениеРаботыСФайлами

Процедура ОбработатьОтсутствиеРасширенияРаботыСФайлами()
	
	ВызватьИсключение "Не подключено расширение работы с файлами";
	
КонецПроцедуры // ОбработатьОтсутствиеРасширенияРаботыСФайлами