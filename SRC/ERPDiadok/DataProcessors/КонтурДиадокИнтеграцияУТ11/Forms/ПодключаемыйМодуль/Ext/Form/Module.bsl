
//#Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Функция ОбработатьСобытие(ИмяСобытия, Параметры) Экспорт
	
	///////////// КРИПТОГРАФИЯ /////////////
	
	Если ИмяСобытия = "ПолучитьСписокЛокальныхСертификатов" Тогда
		
		Возврат ПолучитьСписокЛокальныхСертификатов(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПолучитьСертификатВBase64" Тогда
		
		Возврат ПолучитьСертификатВBase64(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПолучитьОтпечатокСертификатаДляBoxId" Тогда
		
		Возврат ПолучитьОтпечатокСертификатаДляBoxId(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПодписатьДанные" Тогда
		
		Возврат ПодписатьДанные(Параметры);
		
	ИначеЕсли ИмяСобытия = "ЗашифроватьДанные" Тогда
		
		Возврат ЗашифроватьДанные(Параметры);
		
	ИначеЕсли ИмяСобытия = "РасшифроватьДанные" Тогда
		
		Возврат РасшифроватьДанные(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПроверитьПодпись" Тогда
		
		Возврат ПроверитьПодпись(Параметры);
		
	ИначеЕсли ИмяСобытия = "ПолучитьСертификатыДляШифрования" Тогда
		
		Возврат ПолучитьСертификатыДляШифрования(Параметры);
		
	///////////// ПРОЧИЕ СОБЫТИЯ /////////////
	
	ИначеЕсли ИмяСобытия = "НажатиеДополнительнойКнопки" Тогда
		
		Возврат НажатиеДополнительнойКнопки(Параметры);
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПереопределениеФорм_ЭлементФормыНачалоВыбора(Контекст, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПереопределениеФорм_ЭлементФормыОбработкаВыбора(Контекст, Элемент, ВыбранноеЗначение, СтандартнаяОбработка) Экспорт
	
	Если Контекст.Назначение = "СопоставлениеНоменклатуры" Тогда
		
		СопоставлениеНоменклатуры_УпаковкаОбработкаВыбора(
			Контекст,
			Элемент,
			ВыбранноеЗначение,
			СтандартнаяОбработка
		);
		
	КонецЕсли;
	
КонецПроцедуры

//#КонецОбласти СлужебныйПрограммныйИнтерфейс


//#Область СлужебныеПроцедурыИФункции_ПереопределениеФорм

&НаКлиенте
Процедура СопоставлениеНоменклатуры_УпаковкаОбработкаВыбора(Контекст, Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Контекст.СтандартныйЭлемент <> "Упаковка" Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	ТекущиеДанные = Контекст.Форма.Элементы.ДеревоНоменклатуры.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ТекстСообщения = НСтр("ru = 'Для выбора упаковок или единиц измерения номенклатура должна быть заполнена.';
								|en = 'Fill in the products to select packages or units of measure.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = ЭлектронноеВзаимодействиеУТВызовСервера.ЕдиницаХраненияНоменклатуры(ТекущиеДанные.Номенклатура);
	
КонецПроцедуры

//#КонецОбласти СлужебныеПроцедурыИФункции_ПереопределениеФорм


