#КонецОбласти

#Область УПД970_ЗаполнениеЭлементовПротоструктуры

Функция УПД970_НовыйПротоСтруктураУПД970()

	Результат = Контракт_ПротоСтруктураУПД970();
	
	Результат.Table = УПД970_НовыйInvoiceTable970();
	Результат.TransferInfo = Контракт_TransferInfo970();
	Результат.СлужебнаяИнформация = Контракт_СлужебнаяИнформация();
	Результат.AdditionalInfoId = Контракт_AdditionalInfoId();
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НовыйInvoiceTable970()
	
	Результат = Контракт_InvoiceTable970();
	
	Результат.TotalNet = 0;
	Результат.TotalWithVatExcluded = 0;
	Результат.Vat = 0;
	Результат.Total = 0;

	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьТабличныеДанныеКонтента(
	Table,
	ТаблицаДокумента,
	ФункцияДокумента,
	ПараметрыЗаполнения,
	СведенияПрослеживаемости = Неопределено,
	ВыводитьКодыТНВЭД = Ложь)
	
	Table.WithoutVat = XMLСтрока(Истина);
	
	ЕстьКолонкаСодержание = ТаблицаДокумента.Колонки.Найти("Содержание") <> Неопределено;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		
		ДобавитьСтрокуВКонтент = УПД970_ДобавитьСтрокуВТаблицуКонтента(
			СтрокаТаблицы.ЭтоНабор,
			СтрокаТаблицы.ЭтоКомплектующие,
			СтрокаТаблицы.ВариантПредставленияНабора);
			
		Если Не ДобавитьСтрокуВКонтент Тогда
			Продолжить;
		КонецЕсли;
		
		Item = Контракт_Item970();
		
		Если ЕстьКолонкаСодержание Тогда
			Содержание = СтрокаТаблицы.Содержание;
		Иначе
			Содержание = "";
		КонецЕсли;
		
		ПредставлениеНоменклатуры = ПредставлениеНоменклатуры(
			СтрокаТаблицы.НоменклатураНаименование,
			СтрокаТаблицы.ХарактеристикаНаименование,
			Содержание
		);
		
		Item.Product = ПредставлениеНоменклатуры;
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатурыВТерминахПрото(СтрокаТаблицы.НоменклатураТип);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			
			УПД970_ЗаполнитьЕдиницуИзмерения(
				Item,
				СтрокаТаблицы.ЕдиницаИзмеренияНаименование,
				СтрокаТаблицы.ЕдиницаИзмеренияКод);
			
		КонецЕсли;
		
		УПД970_ЗаполнитьКоличествоПоСтрокеТаблицы(
			Item,
			СтрокаТаблицы.Количество,
			ФункцияДокумента,
			ПараметрыЗаполнения.ТочностьКоличества);
		
		УПД970_ЗаполнитьЦенуПоСтрокеТаблицы(
			Item,
			СтрокаТаблицы,
			ФункцияДокумента,
			ПараметрыЗаполнения);
		
		УПД970_ЗаполнитьСуммыПоСтрокеТаблицы(
			Item,
			СтрокаТаблицы,
			ПараметрыЗаполнения.ПересчитыватьВВалютуРеглУчета,
			ПараметрыЗаполнения.НДСИсчисляетсяНалоговымАгентом);
	
		УПД970_ЗаполнитьCustomDeclaration(Item, СтрокаТаблицы.НомерГТД, СтрокаТаблицы.СтранаПроисхожденияКод);
		
		СтрокаСодержитРНПТ = УПД970_СтрокаТоваровСодержитНомерРНПТ(
			СтрокаТаблицы.КоличествоПоРНПТ,
			СтрокаТаблицы.ТипНомераГТД);
		
		Если СтрокаСодержитРНПТ Тогда
			
			УПД970_ЗаполнитьСведенияОПрослеживаемыхТоварахПоСтрокеТаблицы(
				Item,
				СтрокаТаблицы,
				ПараметрыЗаполнения.ПересчитыватьВВалютуРеглУчета);
				
		ИначеЕсли ЭтоРеализацияУслугИПрочихАктивов(СтрокаТаблицы.Ссылка) Тогда
				
			УПД970_ЗаполнитьСведенияОПрослеживаемыхТоварах(
				Item,
				СведенияПрослеживаемости,
				СтрокаТаблицы.НомерСтроки);
		
		Иначе
			
			УПД970_ЗаполнитьСведенияОПрослеживаемыхКомплектующих(
				Item,
				СведенияПрослеживаемости,
				СтрокаТаблицы.НомерГТД,
				СтрокаТаблицы.СуммаБезНДС,
				СтрокаТаблицы.КоличествоПоРНПТ);
			
		КонецЕсли;
		
		Если ВыводитьКодыТНВЭД Тогда
			Item.ItemTypeCode = ЗначениеРеквизитаОбъектаЛок(СтрокаТаблицы.КодТНВЭД, "Код");
		КонецЕсли;
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
		УПД970_ПересчитатьИтогиПоТаблицеКонтента(Table, Item);

	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьЕдиницуИзмерения(Item, Наименование, Код)

	КодЕИ = СокрЛП(Код);
	ИмяЕИ = СокрЛП(Наименование);
	
	Item.Unit = ГенерацияXML.XML_КодЕдиницыИзмерения(КодЕИ);
	Item.UnitName = ИмяЕИ;

КонецПроцедуры

Процедура УПД970_ЗаполнитьКоличествоПоСтрокеТаблицы(
	Item,
	КоличествоПоДокументу,
	ФункцияДокумента,
	ТочностьКоличества)
	
	КоличествоОбязательно = (ФункцияДокумента <> ФункцияДокумента_ДОП() И ЗначениеЗаполнено(Item.Unit));
	
	ЭтоРаботаИлиУслуга = (УПД970_ЭтоТипНоменклатурыКонтентаУслуга(Item.ItemMark)
		Или УПД970_ЭтоТипНоменклатурыКонтентаРабота(Item.ItemMark));
	
	Если ЗначениеЗаполнено(КоличествоПоДокументу) Тогда
		Количество = Окр(КоличествоПоДокументу, ТочностьКоличества);
	ИначеЕсли КоличествоОбязательно И ЭтоРаботаИлиУслуга Тогда
		Количество = 1;
	Иначе
		Количество = 0;
	КонецЕсли;
	
	Item.Quantity = Количество;

КонецПроцедуры

Процедура УПД970_ЗаполнитьЦенуПоСтрокеТаблицы(
	Item,
	СтрокаТаблицы,
	ФункцияДокумента,
	ПараметрыЗаполнения)
	
	Цена = 0;

	СуммаСкидок = 0;
	ПараметрыСуммаСкидок = Новый Структура;
	ПараметрыСуммаСкидок.Вставить("СуммаСкидок");
	ЗаполнитьЗначенияСвойств(ПараметрыСуммаСкидок, СтрокаТаблицы);
	Если ЗначениеЗаполнено(ПараметрыСуммаСкидок.СуммаСкидок) Тогда
		СуммаСкидок = ПараметрыСуммаСкидок.СуммаСкидок;
	КонецЕсли;
	
	ЦенаОбязательнаПоФормату = (ФункцияДокумента <> ФункцияДокумента_ДОП()
		И (ЗначениеЗаполнено(Item.Unit) Или ЗначениеЗаполнено(Item.Quantity)));
		
	МожемЗаполнитьЦену = (ЗначениеЗаполнено(СтрокаТаблицы.Цена) 
			ИЛИ СтрокаТаблицы.ЭтоНабор
			ИЛИ СуммаСкидок <> 0);
		
	Если ЦенаОбязательнаПоФормату Или МожемЗаполнитьЦену Тогда
		
		ВыводитьБазовыеЕдиницыИзмерения = НЕ ПараметрыЗаполнения.ВыводитьБазовыеЕдиницыИзмерения;
		ПересчитыватьВВалютуРеглУчета = ПараметрыЗаполнения.ПересчитыватьВВалютуРеглУчета;
		ЦенаВключаетНДС = ПараметрыЗаполнения.ЦенаВключаетНДС;
		
		ЗаполнитьКакВДокументе = ЗначениеЗаполнено(СтрокаТаблицы.Цена)
			И ВыводитьБазовыеЕдиницыИзмерения
			И НЕ ПересчитыватьВВалютуРеглУчета
			И Не ЦенаВключаетНДС
			И НЕ СуммаСкидок <> 0;
			
		ЗаполнитьКакСуммаБезНДС = ЗначениеЗаполнено(СтрокаТаблицы.Цена)
			И НЕ ВыводитьБазовыеЕдиницыИзмерения
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Количество)
			И НЕ ПересчитыватьВВалютуРеглУчета;
		
		Если ЗаполнитьКакВДокументе Тогда
			Цена = СтрокаТаблицы.Цена;
		ИначеЕсли ЗаполнитьКакСуммаБезНДС Тогда
			Цена = СтрокаТаблицы.СуммаБезНДСРуб;
		ИначеЕсли Не ЗначениеЗаполнено(Item.Quantity) Тогда
			Цена = 0;
		ИначеЕсли ПересчитыватьВВалютуРеглУчета Тогда
			Цена = СтрокаТаблицы.СуммаБезНДСРуб / Item.Quantity;
		Иначе
			Цена = СтрокаТаблицы.СуммаБезНДС / Item.Quantity;
		КонецЕсли;
		
	КонецЕсли;
	
	Item.Price = Окр(Цена, ПараметрыЗаполнения.ТочностьЦены);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСуммыПоСтрокеТаблицы(
	Item,
	ИсходнаяСтрока,
	ПересчитыватьВВалютуРеглУчета,
	НДСИсчисляетсяНалоговымАгентом)
	
	Если ПересчитыватьВВалютуРеглУчета Тогда
		СуммаБезНДС = ИсходнаяСтрока.СуммаБезНДСРуб;
		СуммаНДС = ИсходнаяСтрока.СуммаНДСРуб;
		СуммаВсего = ИсходнаяСтрока.СуммаСНДСРуб;
	Иначе
		СуммаБезНДС = ИсходнаяСтрока.СуммаБезНДС;
		СуммаНДС = ИсходнаяСтрока.СуммаНДС;
		СуммаВсего = ИсходнаяСтрока.СуммаСНДС;
	КонецЕсли;
	
	Если НДСИсчисляетсяНалоговымАгентом Тогда
		
		СуммаНДС = 0;
		СуммаВсего = 0;
		
		ЗначениеПризнакаБезНДС = XMLСтрока(Ложь);
		
	Иначе
		
		ЭтоСтавкаБезНДС = (ИсходнаяСтрока.СтавкаНДС = ПрикладнаяСтавкаБезНДС());
		ЗначениеПризнакаБезНДС = XMLСтрока(ЭтоСтавкаБезНДС);
		
	КонецЕсли;

	Item.SubtotalWithVatExcluded = СуммаБезНДС;
	Item.Vat = СуммаНДС;
	Item.Subtotal = СуммаВсего;
	Item.TaxRate = ПредставлениеСтавкиНДС(ИсходнаяСтрока.СтавкаНДС, НДСИсчисляетсяНалоговымАгентом);
	Item.WithoutVat = ЗначениеПризнакаБезНДС;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьCustomDeclaration(Item, НомерГТД, КодСтраныПроисхождения)
	
	Если Не ЗначениеЗаполнено(НомерГТД)
		Или Не ЗначениеЗаполнено(КодСтраныПроисхождения) Тогда
		Возврат;
	КонецЕсли;
	
	CustomDeclaration = Контракт_CustomDeclarations();
	CustomDeclaration.CountryCode = КодСтраныПроисхождения;
	CustomDeclaration.DeclarationNumber = СокрЛП(НомерГТД);
	
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьItemTracingInfos(
	Item,
	СтрокаТаблицы,
	СведенияПрослеживаемости,
	ПересчитыватьВВалютуРеглУчета)
	
	КоличествоПоРНПТ = СтрокаТаблицы.КоличествоПоРНПТ;
	ТипНомераГТД = СтрокаТаблицы.ТипНомераГТД;
	
	СтрокаСодержитРНПТ = УПД970_СтрокаТоваровСодержитНомерРНПТ(КоличествоПоРНПТ, ТипНомераГТД);
	
	Если СтрокаСодержитРНПТ Тогда
		
		Если ПересчитыватьВВалютуРеглУчета Тогда
			СуммаБезНДС = СтрокаТаблицы.СуммаБезНДСРуб;
		Иначе
			СуммаБезНДС = СтрокаТаблицы.СуммаБезНДС;
		КонецЕсли;
		
		ItemTracingInfo = УПД970_НовыйItemTracingInfo(
			СтрокаТаблицы.НомерГТД,
			СтрокаТаблицы.ЕдиницаИзмеренияТНВЭДКод,
			СтрокаТаблицы.ЕдиницаИзмеренияТНВЭДНаименование,
			КоличествоПоРНПТ,
			СуммаБезНДС);
		
		Item.ItemTracingInfos.Добавить(ItemTracingInfo);
		
	Иначе
		
		Если Не ЗначениеЗаполнено(СведенияПрослеживаемости) Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоПрослеживаемыеКомплектующие = (СведенияПрослеживаемости.Колонки.Найти("ОбщаяСуммаПоКомплекту") <> Неопределено);
		
		Если ЭтоПрослеживаемыеКомплектующие Тогда
			УПД970_ЗаполнитьСведенияОПрослеживаемыхКомплектующих(
				Item,
				СведенияПрослеживаемости,
				СтрокаТаблицы.НомерГТД,
				СтрокаТаблицы.СуммаБезНДС,
				КоличествоПоРНПТ);
		Иначе
			УПД970_ЗаполнитьСведенияОПрослеживаемыхТоварах(
				Item,
				СведенияПрослеживаемости,
				СтрокаТаблицы.НомерСтроки);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Item.CustomDeclarations)
		И ЗначениеЗаполнено(Item.ItemTracingInfos) Тогда
		
		Для Каждого CustomDeclaration Из Item.CustomDeclarations Цикл
			CustomDeclaration.DeclarationNumber = "Прослеж";
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры


Процедура УПД970_ЗаполнитьСведенияОПрослеживаемыхТоварахПоСтрокеТаблицы(
	Item,
	СтрокаТаблицы,
	ПересчитыватьВВалютуРеглУчета)
	
	Если ПересчитыватьВВалютуРеглУчета Тогда
		СуммаБезНДС = СтрокаТаблицы.СуммаБезНДСРуб;
	Иначе
		СуммаБезНДС = СтрокаТаблицы.СуммаБезНДС;
	КонецЕсли;
	
	ItemTracingInfo = УПД970_НовыйItemTracingInfo(
		СтрокаТаблицы.НомерГТД,
		СтрокаТаблицы.ЕдиницаИзмеренияТНВЭДКод,
		СтрокаТаблицы.ЕдиницаИзмеренияТНВЭДНаименование,
		СтрокаТаблицы.КоличествоПоРНПТ,
		СуммаБезНДС);
	
	Item.ItemTracingInfos.Добавить(ItemTracingInfo);
	
	УПД970_ЗаменитьНомераГТДПризнакомПрослеживаемогоТовара(Item);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПрослеживаемыхКомплектующих(
	Item,
	ПрослеживаемыеКомплектующие,
	НомерГТД,
	СуммаБезНДС,
	КоличествоПоРНПТ)

	Если Не ЗначениеЗаполнено(КоличествоПоРНПТ)
		Или Не ЗначениеЗаполнено(ПрослеживаемыеКомплектующие) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура("НомерГТД", НомерГТД);
	КомплектующиеПоНомеруГТД = ПрослеживаемыеКомплектующие.НайтиСтроки(ОтборСтрок);
	
	Для Каждого СтрокаКомплекта Из КомплектующиеПоНомеруГТД Цикл
		
		СтоимостьБезНДС = СтоимостьПоРНПТСтрокиКомплекта(
			СуммаБезНДС,
			СтрокаКомплекта.ОбщаяСуммаПоКомплекту,
			СтрокаКомплекта.СуммаПоРНПТ);
		
		ItemTracingInfo = УПД970_НовыйItemTracingInfo(
			СтрокаКомплекта.НомерТовара,
			СтрокаКомплекта.ЕдиницаИзмеренияКод,
			СтрокаКомплекта.ЕдиницаИзмеренияНаименование,
			СтрокаКомплекта.Количество * КоличествоПоРНПТ,
			СтоимостьБезНДС);
		
		Item.ItemTracingInfos.Добавить(ItemTracingInfo);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Item.CustomDeclarations)
		И ЗначениеЗаполнено(Item.ItemTracingInfos) Тогда
		УПД970_ЗаменитьНомераГТДПризнакомПрослеживаемогоТовара(Item);
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПрослеживаемыхТоварах(Item, ПрослеживаемыеТовары, НомерСтрокиТоваров)
	
	Если Не ЗначениеЗаполнено(ПрослеживаемыеТовары) Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрок = Новый Структура("НомерСтроки", НомерСтрокиТоваров);
	ПрослеживаемыеТоварыПоНомеруСтроки = ПрослеживаемыеТовары.НайтиСтроки(ОтборСтрок);
	
	Item.CustomDeclarations.Очистить();
	
	Для Каждого СтрокаТовары Из ПрослеживаемыеТоварыПоНомеруСтроки Цикл
		
		ItemTracingInfo = УПД970_НовыйItemTracingInfo(
			СтрокаТовары.НомерТовара,
			СтрокаТовары.ЕдиницаИзмеренияКод,
			СтрокаТовары.ЕдиницаИзмеренияНаименование,
			СтрокаТовары.Количество,
			СтрокаТовары.СуммаПоРНПТ);
		
		Item.ItemTracingInfos.Добавить(ItemTracingInfo);
		
		Если ЗначениеЗаполнено(СтрокаТовары.НомерГТД)
			И ЗначениеЗаполнено(СтрокаТовары.СтранаПроисхожденияКод) Тогда
			
			CustomDeclaration = Контракт_CustomDeclarations();
			CustomDeclaration.CountryCode = СтрокаТовары.СтранаПроисхожденияКод;
			CustomDeclaration.DeclarationNumber = "Прослеж";
			
			Item.CustomDeclarations.Добавить(CustomDeclaration);
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаменитьНомераГТДПризнакомПрослеживаемогоТовара(Item)
	
	Для Каждого CustomDeclaration Из Item.CustomDeclarations Цикл
		CustomDeclaration.DeclarationNumber = "Прослеж";
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПродавце(
	Контент,
	Контрагент,
	ДатаСведений,
	БанковскийСчет,
	КПППоставщика = "")

	Поставщики = ЗначениеВМассивЛок(Контрагент);
	
	Для Каждого Поставщик Из Поставщики Цикл
		
		РеквизитыПродавца = УПД970_ДанныеУчастникаЭДО(Поставщик, ДатаСведений, БанковскийСчет);
		ЮрАдресПродавца = СведенияОбЮридическомАдресеОбъекта(Поставщик, ДатаСведений);
		
		Если ЗначениеЗаполнено(КПППоставщика) Тогда
			РеквизитыПродавца.КПП = КПППоставщика;
		КонецЕсли;
		
		Seller = Контракт_ExtendedOrganizationInfo970();
		Контент.Sellers.Добавить(Seller);
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, РеквизитыПродавца, ЮрАдресПродавца);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПокупателе(
	Контент,
	Покупатель,
	ДатаСведений,
	БанковскийСчет = Неопределено,
	КПППокупателя = "")
	
	РеквизитыПокупателя = УПД970_ДанныеУчастникаЭДО(Покупатель, ДатаСведений, БанковскийСчет);
	ЮрАдресПокупателя = СведенияОбЮридическомАдресеОбъекта(Покупатель, ДатаСведений);
	
	Если ЗначениеЗаполнено(КПППокупателя) Тогда
		РеквизитыПокупателя.КПП = КПППокупателя;
	КонецЕсли;
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	Контент.Buyers.Добавить(Buyer);
	
	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, РеквизитыПокупателя, ЮрАдресПокупателя);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПокупателях(Контент, Покупатели, ДатаСведений)
	
	Для Каждого СтрокаПокупатели Из Покупатели Цикл
		
		РеквизитыПокупателя = УПД970_ДанныеУчастникаЭДО(СтрокаПокупатели.Покупатель, ДатаСведений);
		ЮрАдресПокупателя = СведенияОбЮридическомАдресеОбъекта(СтрокаПокупатели.Покупатель, ДатаСведений);
		
		Если ЗначениеЗаполнено(СтрокаПокупатели.ИННПокупателя) Тогда
			РеквизитыПокупателя.ИНН = СтрокаПокупатели.ИННПокупателя;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПокупатели.КПППокупателя) Тогда
			РеквизитыПокупателя.КПП = СтрокаПокупатели.КПППокупателя;
		КонецЕсли;
		
		Buyer = Контракт_ExtendedOrganizationInfo970();
		Контент.Buyers.Добавить(Buyer);
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, РеквизитыПокупателя, ЮрАдресПокупателя);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет контент сведениями о грузополучателе(ях)
//
// Параметры:
//  Контент			 - Структура                    - см. Контракт_ПротоСтруктураУПД970
//  Грузоотправитель - СправочникСсылка.Контрагенты - для документов Отчет комитенту о закупках тип значения - Массив
//					   Массив 
//  ДатаСведений	 - Дата                         - дата документа, на которую получаем сведения о грузоотправителе
//  БанковскийСчет	 - СправочникСсылка.БанковскиеСчетаКонтрагентов - либо из документа, либо из справочника
//
Процедура УПД970_ЗаполнитьСведенияОГрузоотправителе(
	Контент,
	Грузоотправитель,
	ДатаСведений,
	БанковскийСчет = Неопределено)
	
	Если Не ЗначениеЗаполнено(Грузоотправитель) Тогда
		Возврат;
	КонецЕсли;
	
	Если УПД970_ЭтоГрузоотправительОнЖе(Грузоотправитель, Контент.Sellers) Тогда
		
		УПД970_ДобавитьГрузоотправителяОнЖе(Контент.Shippers);
		
	Иначе
		
		Грузоотправители = ЗначениеВМассивЛок(Грузоотправитель);
		
		Для Каждого _Грузоотправитель Из Грузоотправители Цикл
			
			Если УПД970_ЭтоГрузоотправительОнЖе(_Грузоотправитель, Контент.Sellers) Тогда
				
				УПД970_ДобавитьГрузоотправителяОнЖе(Контент.Shippers);
				
				Продолжить;
				
			КонецЕсли;
			
			Shipper = Контракт_Shipper970();
			Shipper.SameAsSeller = Ложь;
			
			Контент.Shippers.Добавить(Shipper);
			
			РеквизитыГрузоотправителя = УПД970_ДанныеУчастникаЭДО(
				_Грузоотправитель,
				ДатаСведений,
				БанковскийСчет);
			
			СведенияОбАдресе = СведенияОФактическомАдресеОбъекта(_Грузоотправитель, ДатаСведений);
			
			ShipperInfo = Контракт_ExtendedOrganizationInfo970();
			Shipper.OrganizationInfo = ShipperInfo;
			
			УПД970_ЗаполнитьExtendedOrganizationInfo(ShipperInfo, РеквизитыГрузоотправителя, СведенияОбАдресе);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ЭтоГрузоотправительОнЖе(Shipper, Sellers)
	
	Результат = ТипЗнч(Shipper) <> Тип("Массив")
		И Sellers.Количество() > 0
		И Shipper = Sellers[0].СлужебнаяИнформация.Ссылка;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДобавитьГрузоотправителяОнЖе(Shippers)
	
	Shipper = Контракт_Shipper970();
	Shipper.SameAsSeller = Истина;
	
	Shippers.Добавить(Shipper);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГрузополучателе(
	Контент,
	Грузополучатель,
	ДатаСведений,
	БанковскийСчет = Неопределено,
	СведенияОбАдресеДоставки = Неопределено)
	
	Если Не ЗначениеЗаполнено(Грузополучатель) Тогда
		Возврат;
	КонецЕсли;
	
	Грузополучатели = ЗначениеВМассивЛок(Грузополучатель);
	
	Для Каждого _Грузополучатель Из Грузополучатели Цикл
		
		РеквизитыГрузополучателя = УПД970_ДанныеУчастникаЭДО(
			_Грузополучатель,
			ДатаСведений,
			БанковскийСчет);
		
		Если Не ЗначениеЗаполнено(СведенияОбАдресеДоставки) Тогда
			СведенияОбАдресеДоставки = СведенияОФактическомАдресеОбъекта(_Грузополучатель, ДатаСведений);
		КонецЕсли;
		
		Consignee = Контракт_ExtendedOrganizationInfo970();
		Контент.Consignees.Добавить(Consignee);
		
		УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, РеквизитыГрузополучателя, СведенияОбАдресеДоставки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОГрузополучателяхПоПокупателям(Грузополучатели, Покупатели, ДатаСведений)
	
	Для Каждого ДанныеПокупателя Из Покупатели Цикл
		
		Грузополучатель = СкопироватьКоллекциюЛок(ДанныеПокупателя);
		Грузополучатели.Добавить(Грузополучатель);
		
		СведенияОбАдресе = СведенияОФактическомАдресеОбъекта(
			ДанныеПокупателя.СлужебнаяИнформация.Ссылка,
			ДатаСведений);
			
		Грузополучатель.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры)
	
	ДанныеСотрудника = СвойствоСтруктурыЛок(ДополнительныеПараметры, "ДанныеСотрудника");
	Если ЗначениеЗаполнено(ДанныеСотрудника)
		И ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
		
		TransferInfo.Employee = УПД970_НовыйEmployee(
			ДанныеСотрудника.Фамилия,
			ДанныеСотрудника.Имя,
			ДанныеСотрудника.Отчество,
			ДанныеСотрудника.Должность);
	
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ПересчитатьИтогиПоТаблицеКонтента(Table, Item)
	
	Table.TotalNet = Table.TotalNet + Item.Quantity;
	Table.TotalWithVatExcluded = Table.TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
	Table.Vat = Table.Vat + Item.Vat;
	Table.Total = Table.Total + Item.Subtotal;
	
	XmlЗначениеЛожь = XMLСтрока(Ложь);
	
	Если Item.WithoutVat = XmlЗначениеЛожь Тогда
		Table.WithoutVat = XmlЗначениеЛожь;
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_НовыйEmployee(Фамилия, Имя, Отчество, Должность)

	Результат = Контракт_Employee970();
	
