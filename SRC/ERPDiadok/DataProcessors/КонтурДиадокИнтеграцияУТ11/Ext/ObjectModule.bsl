Функция УПД970_ТекстЗапросаТабличныхДанныхРеализацииУслугПрочихАктивов()

	Результат =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ТаблицаТоваров.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	НЕОПРЕДЕЛЕНО КАК ВариантПредставленияНабора,
	|	ЛОЖЬ КАК ЭтоНабор,
	|	ЛОЖЬ КАК ЭтоКомплектующие,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Содержание КАК НоменклатураНаименование,
	|	"""" КАК НоменклатураКод,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияВнеоборотныхАктивов)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|	КОНЕЦ КАК НоменклатураТип,
	|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
	|	"""" КАК ХарактеристикаНаименование,
	|	ТаблицаТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Представление, """") КАК ЕдиницаИзмеренияНаименование,
	|	ЕСТЬNULL(ТаблицаТоваров.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмеренияКод,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК ЕдиницаИзмеренияТНВЭД,
	|	"""" КАК ЕдиницаИзмеренияТНВЭДНаименование,
	|	"""" КАК ЕдиницаИзмеренияТНВЭДКод,
	|	ТаблицаТоваров.КодТНВЭД КАК КодТНВЭД,
	|	ТаблицаТоваров.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаТоваров.НомерГТД КАК НомерГТДСсылка,
	|	НЕОПРЕДЕЛЕНО КАК ТипНомераГТД,
	|	"""" КАК НомерГТД,
	|	ЕСТЬNULL(ТаблицаТоваров.НомерГТД.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ТаблицаТоваров.НомерГТД.СтранаПроисхождения.Код, """") КАК СтранаПроисхожденияКод,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.СуммаБезНДС КАК СуммаБезНДС,
	|	ТаблицаТоваров.СуммаНДС КАК СуммаНДС,
	|	ТаблицаТоваров.СуммаБезНДС + ТаблицаТоваров.СуммаНДС КАК СуммаСНДС,
	|	ТаблицаТоваров.СуммаБезНДСРуб КАК СуммаБезНДСРуб,
	|	ТаблицаТоваров.СуммаНДСРуб КАК СуммаНДСРуб,
	|	ТаблицаТоваров.СуммаБезНДСРуб + ТаблицаТоваров.СуммаНДСРуб КАК СуммаСНДСРуб,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	РеализацияУслугПрочихАктивовТаблицаТоваров КАК ТаблицаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Возврат Результат;
	
