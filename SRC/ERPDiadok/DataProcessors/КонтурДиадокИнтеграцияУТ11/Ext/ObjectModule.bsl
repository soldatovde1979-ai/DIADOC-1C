Функция Счет29_ИсходныеДанныеЗаказаКлиента(СсылкаНаОбъект)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса = Счет29_ТекстЗапросаРеквизитовШапкиЗаказаКлиентов();
	ДанныеШапки = Данные_ШапкаДокумента(СсылкаНаОбъект, ТекстЗапроса, МенеджерВременныхТаблиц);
	
	Счет29_ПоместитьВременнуюТаблицуТоваровЗаказаКлиента(СсылкаНаОбъект, МенеджерВременныхТаблиц);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(Счет29_ТекстЗапросаТабличныхДанныхЗаказаКлиента());
	ТекстыЗапросов.Добавить(Счет29_ТекстЗапросаЭтаповГрафикаОплаты("ЗаказКлиента"));
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДопКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов());
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", ВыводитьБазовыеЕдиницыИзмерения());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТабличныеДанные = РезультатЗапроса[0].Выгрузить();
	ЭтапыГрафикаОплаты = РезультатЗапроса[1].Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("ГрафикОплаты", ЭтапыГрафикаОплаты);
	
	Возврат Результат;
	
КонецФункции

