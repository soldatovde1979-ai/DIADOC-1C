Процедура УПД970_ЗаполнитьВТекстеЗапросаПараметрСТипомНомераГТД(ТекстЗапроса)

	ВерсияБиблиотекиИСМП = ВерсияБиблиотекиИнтеграцииИСМП();
	
	Если СравнитьВерсии_(ВерсияБиблиотекиИСМП, "10.1.28") >= 0 Тогда
		ТипНомераГТД = "ЕСТЬNULL(ТаблицаТоваров.НомерГТД.ТипНомераГТД, НЕОПРЕДЕЛЕНО)";
	Иначе
		ТипНомераГТД = "НЕОПРЕДЕЛЕНО";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТипНомераГТД", ТипНомераГТД);

КонецПроцедуры

Процедура УПД970_ЗаполнитьВТекстеЗапросаПараметрСуммаСкидок(ТекстЗапроса, ИмяОбъектаМетаданных)
	
	ЕстьРеквизитСуммаРучнойСкидки = Ложь;
	
	Если Метаданные.Документы[ИмяОбъектаМетаданных].ТабличныеЧасти.Найти("ВидыЗапасов") <> Неопределено Тогда
		
		ЕстьРеквизитСуммаРучнойСкидки = ЕстьРеквизитОбъектаЛок("СуммаРучнойСкидки",
			Метаданные.Документы[ИмяОбъектаМетаданных].ТабличныеЧасти.ВидыЗапасов);
		
	КонецЕсли;
	
	Если ЕстьРеквизитСуммаРучнойСкидки Тогда
		СуммаСкидок = "ТаблицаДокумента.СуммаРучнойСкидки + ТаблицаДокумента.СуммаАвтоматическойСкидки";
	Иначе
		СуммаСкидок = "0";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СуммаСкидок", СуммаСкидок);

КонецПроцедуры

Процедура ТекстЗапроса_ЗаполнитьВыражениеСНаименованиемНоменклатуры(ТекстЗапроса)

	ВыражениеТекстаЗапроса =
	"	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура.НаименованиеПолное КАК СТРОКА(1000)) = """"
	|			ТОГДА ТаблицаТоваров.Номенклатура.Наименование
	|		ИНАЧЕ ТаблицаТоваров.Номенклатура.НаименованиеПолное
	|	КОНЕЦ";

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&НаименованиеНоменклатуры",
		ВыражениеТекстаЗапроса);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьВТекстеЗапросаПараметрКоличествоПоРНПТ(ТекстЗапроса, ИмяОбъектаМетаданных)
	
	ЕстьРеквизитКоличествоРНПТ = Ложь;
	
	Если Метаданные.Документы.Найти(ИмяОбъектаМетаданных) <> Неопределено
		И Метаданные.Документы[ИмяОбъектаМетаданных].ТабличныеЧасти.Найти("ВидыЗапасов") <> Неопределено Тогда
		
		ЕстьРеквизитКоличествоРНПТ = ЕстьРеквизитОбъектаЛок("КоличествоПоРНПТ",
			Метаданные.Документы[ИмяОбъектаМетаданных].ТабличныеЧасти.ВидыЗапасов);
		
	КонецЕсли;
	
	Если ЕстьРеквизитКоличествоРНПТ Тогда
		КоличествоПоРНПТ = "ТаблицаДокумента.КоличествоПоРНПТ";
	Иначе
		КоличествоПоРНПТ = "0";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КоличествоПоРНПТ", КоличествоПоРНПТ);
	
КонецПроцедуры

