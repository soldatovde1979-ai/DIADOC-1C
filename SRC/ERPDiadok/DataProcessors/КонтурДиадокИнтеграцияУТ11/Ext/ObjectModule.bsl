Процедура УПД970_ПоместитьВременнуюТаблицуТоваровКорректировкиРеализации(МенеджерВременныхТаблиц, ДатаДокумента)
	
	ТекстЗапросаВТВидыЗапасов = УПД970_ТекстЗапросаВремТаблицыВидыЗапасовКорректировкиРеализации();
	ТекстЗапросаВТТоваровДляПреобразования = УПД970_ТекстЗапросаВТТоваровКорректировкиРеализацииДляПреобразования();
	ТекстЗапросаВТНаборов = УПД970_ТекстЗапросаВременнойТаблицыСНаборамиКорректировкиРеализации();
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаВТВидыЗапасов);
	ТекстыЗапросов.Добавить(ТекстЗапросаВТТоваровДляПреобразования);
	ТекстыЗапросов.Добавить(ТекстЗапросаВТНаборов);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	ИспользоватьУчетПрослежИмпТоваров = Ложь;
	Если ЕстьФункциональностьУчетаПрослеживаемыхТоваров() Тогда
		МодульУчетПрослеживаемыхТоваровЛокализация = ОбщийМодульПоИмениЛок("УчетПрослеживаемыхТоваровЛокализация");
		ИспользоватьУчетПрослежИмпТоваров = МодульУчетПрослеживаемыхТоваровЛокализация.ИспользоватьУчетПрослеживаемыхИмпортныхТоваров(
			ДатаДокумента
		);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ИспользоватьУчетПрослеживаемыхИмпортныхТоваров", ИспользоватьУчетПрослежИмпТоваров);
	
	Запрос.Выполнить();
	
КонецПроцедуры


