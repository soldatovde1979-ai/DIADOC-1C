Процедура УПД970_ЗаполнитьВТекстеЗапросаВТТоваровКорректировкиРеализацииДляПреобразованияОтчетДавальцу(ТекстЗапроса)
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		
		ОтчетДавальцуДоКорректировки =
			"ВЫБРАТЬ
			|	СвязанныеДокументы.Основной КАК Ссылка,
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК НоменклатураНабора,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНабора,
			|	ЛОЖЬ КАК ВернутьМногооборотнуюТару,
			|	"""" КАК Содержание,
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.Характеристика КАК Характеристика,
			|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
			|	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
			|	Товары.Количество КАК Количество,
			|	Товары.Количество КАК КоличествоУпаковок,
			|	0 КАК КоличествоПоРНПТ,
			|	Товары.СуммаСНДС - Товары.СуммаНДС КАК СуммаБезНДС,
			|	Товары.СуммаНДС КАК СуммаНДС,
			|	ЕСТЬNULL(СуммыРегл.СуммаБезНДСРегл, 0) КАК СуммаБезНДСРуб,
			|	ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, 0) КАК СуммаНДСРуб,
			|	Товары.Ссылка.СтавкаНДС КАК СтавкаНДС,
			|	ЛОЖЬ КАК ЭтоТовар,
			|	ЛОЖЬ КАК ЭтоНеВозвратнаяТара,
			|	ЛОЖЬ КАК ДоКорректировки
			|ИЗ
			|	Документ.ОтчетДавальцу2_5.Продукция КАК Товары
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСвязанныеДокументы КАК СвязанныеДокументы
			|		ПО Товары.Ссылка = СвязанныеДокументы.Подчиненный
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютахУчета КАК СуммыРегл
			|		ПО Товары.Ссылка = СуммыРегл.Регистратор
			|			И Товары.ИдентификаторСтроки = СуммыРегл.ИдентификаторСтроки
			|			И СуммыРегл.Активность
			|ГДЕ
			|	Товары.Номенклатура.ТипНоменклатуры НЕ В (
			|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар),
			|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
			|	ИЛИ Товары.Номенклатура.ТипНоменклатуры ЕСТЬ NULL";
		
		ОтчетДавальцуДоКорректировки = ОтчетДавальцуДоКорректировки + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";
		
		ОтчетДавальцуПослеКорректировки = "
			|ВЫБРАТЬ
			|	СвязанныеДокументы.Основной КАК Ссылка,
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК НоменклатураНабора,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаНабора,
			|	ЛОЖЬ КАК ВернутьМногооборотнуюТару,
			|	"""" КАК Содержание,
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.Характеристика КАК Характеристика,
			|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
			|	ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка) КАК НомерГТД,
			|	Товары.Количество КАК Количество,
			|	Товары.Количество КАК КоличествоУпаковок,
			|	0 КАК КоличествоПоРНПТ,
			|	Товары.СуммаСНДС - Товары.СуммаНДС КАК СуммаБезНДС,
			|	Товары.СуммаНДС КАК СуммаНДС,
			|	ЕСТЬNULL(СуммыРегл.СуммаБезНДСРегл, 0) КАК СуммаБезНДСРуб,
			|	ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, 0) КАК СуммаНДСРуб,
			|	Товары.Ссылка.СтавкаНДС КАК СтавкаНДС,
			|	ЛОЖЬ КАК ЭтоТовар,
			|	ЛОЖЬ КАК ЭтоНеВозвратнаяТара,
			|	ИСТИНА КАК ДоКорректировки
			|ИЗ
			|	Документ.ОтчетДавальцу2_5.Продукция КАК Товары
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСвязанныеДокументы КАК СвязанныеДокументы
			|		ПО Товары.Ссылка = СвязанныеДокументы.Подчиненный
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютахУчета КАК СуммыРегл
			|		ПО Товары.Ссылка = СуммыРегл.Регистратор
			|			И Товары.ИдентификаторСтроки = СуммыРегл.ИдентификаторСтроки
			|			И СуммыРегл.Активность
			|ГДЕ
			|	(Товары.Номенклатура.ТипНоменклатуры НЕ В (
			|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар),
			|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
			|	) ИЛИ Товары.Номенклатура.ТипНоменклатуры ЕСТЬ NULL)";
		
		ОтчетДавальцуПослеКорректировки = "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|" +
			ОтчетДавальцуПослеКорректировки;
		
	Иначе
		
		ОтчетДавальцуДоКорректировки = "";
		ОтчетДавальцуПослеКорректировки = "";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//&ОтчетДавальцуДоКорректировки", ОтчетДавальцуДоКорректировки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//&ОтчетДавальцуПослеКорректировки", ОтчетДавальцуПослеКорректировки);
	
КонецПроцедуры

Процедура ТекстЗапроса_ЗаполнитьЗапросаВыраженияТипаКорректировки(ТекстЗапроса)
	
	ИмяРеквизитаТипКорректировки = "ТипКорректировки";
	МетаданныеДокумента = Метаданные.Документы.КорректировкаРеализации;
	
	Если ЕстьРеквизитОбъектаЛок(ИмяРеквизитаТипКорректировки, МетаданныеДокумента) Тогда
		
		ВыражениеЭтоОбычнаяКорректировкаТоваров = "Товары.Ссылка.ТипКорректировки = ЗНАЧЕНИЕ(Перечисление.ТипыКорректировки.ОбычнаяКорректировка)";
		ВыражениеВыборкаДанныхКорректировкиПоПервичномуДокументу = УПД970_ТекстЗапросаВыборкиДанныхКорректировкиПоПервичномуДокументу();
		ВыражениеГруппировкаПоТипуКорректировки = ",ДанныеКорректировки.ТипКорректировки";
		ВыражениеУсловиеГруппировкиПоТипуКорректировки = "ИЛИ ДанныеКорректировки.ТипКорректировки В(
			|				ЗНАЧЕНИЕ(Перечисление.ТипыКорректировки.КорректировкаДоВводаОстатковТоваровИУслуг),
			|				ЗНАЧЕНИЕ(Перечисление.ТипыКорректировки.КорректировкаДоВводаОстатковУслугИПрочихАктивов))";
		ВыражениеСозданиеВТДанныеКорректировкиПосле = УПД970_ТекстЗапросаВТДанныеКорректировкиПосле();
		ВыражениеЭтоОбычнаяКорректировкаТоваров2 = "ВидыЗапасов.Ссылка.ТипКорректировки = ЗНАЧЕНИЕ(Перечисление.ТипыКорректировки.ОбычнаяКорректировка)";
		ВыражениеВыборкаВТЗапасыПоПервичномуДокументу = УПД970_ТекстЗапросаВыборкаВТЗапасыПоПервичномуДокументу();
		ВыражениеУничтожитьВТДанныхДоВводаОстатков = "
		|;
		|УНИЧТОЖИТЬ ВтДанныеПоКорректировкеДоВводаОстатков";
		
		ТекстЗапроса =
			УПД970_ТекстЗапросаДанныхКорректировокРеализацииДоВводаОстатков()
			+ ТекстЗапроса_РазделительЗапросов()
			+ ТекстЗапроса;
		
	Иначе
		
		ВыражениеЭтоОбычнаяКорректировкаТоваров = "Истина";
		ВыражениеВыборкаДанныхКорректировкиПоПервичномуДокументу = "";
		ВыражениеГруппировкаПоТипуКорректировки = "";
		ВыражениеУсловиеГруппировкиПоТипуКорректировки = "";
		ВыражениеСозданиеВТДанныеКорректировкиПосле = "";
		ВыражениеЭтоОбычнаяКорректировкаТоваров2 = "Истина";
		ВыражениеВыборкаВТЗапасыПоПервичномуДокументу = "";
		ВыражениеУничтожитьВТДанныхДоВводаОстатков = "";
		
	КонецЕсли;
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&ЭтоОбычнаяКорректировкаТоваров1", ВыражениеЭтоОбычнаяКорректировкаТоваров);
	Замены.Добавить(
		"//&ВыборкаДанныхКорректировкиПоПервичномуДокументу",
		ВыражениеВыборкаДанныхКорректировкиПоПервичномуДокументу
	);
	Замены.Добавить("&ГруппировкаПоТипуКорректировки", ВыражениеГруппировкаПоТипуКорректировки);
	Замены.Добавить("&УсловиеГруппировкиПоТипуКорректировки", ВыражениеУсловиеГруппировкиПоТипуКорректировки);
	Замены.Добавить("//&СозданиеВТДанныеКорректировкиПосле", ВыражениеСозданиеВТДанныеКорректировкиПосле);
	Замены.Добавить("&ЭтоОбычнаяКорректировкаТоваров2", ВыражениеЭтоОбычнаяКорректировкаТоваров2);
	Замены.Добавить("//&ВыборкаВТЗапасыПоПервичномуДокументу", ВыражениеВыборкаВТЗапасыПоПервичномуДокументу);
	Замены.Добавить("//&УничтожитьВТДанныхДоВводаОстатков", ВыражениеУничтожитьВТДанныхДоВводаОстатков);
	
	Для Каждого Элемент Из Замены Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Элемент.Значение, Элемент.Представление );
	КонецЦикла;
	
КонецПроцедуры

Процедура ТекстЗапроса_ЗаполнитьВыражениеАналитикаУчетаПрослеживаемыйТовар(ТекстЗапроса)
	
	ЕслиПрослеживаемыйТовар = Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ПрослеживаемыйТовар") <> Неопределено;
	
