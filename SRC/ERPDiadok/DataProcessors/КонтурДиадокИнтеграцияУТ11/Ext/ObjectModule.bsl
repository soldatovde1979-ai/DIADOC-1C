Процедура АктСверки405_ПроверитьВозможностьОтправки(Результат, ДокСсылка)
	
	Если НЕ ЭтоСверкаВзаиморасчетов2_5_11(ДокСсылка) Тогда
		
		ТекстОшибки = НСтр("ru='Не удалось создать Акт сверки в формализованном виде. Проверьте, что тип <сопоставленного документа> ""Сверка взаиморасчетов (2.5.11)""'");
		
		ГенерацияXML.ДобавитьОшибкуВалидации(
			Результат.ОшибкиВДанных,
			ТекстОшибки,
			ДокСсылка
		);
		
	КонецЕсли;
	
КонецПроцедуры

Функция АктСверки405_ПроверитьВозможностьФормированияОтветногоТитула(Результат, ДокСсылка)
	
	ЭтоДокументАктСверки = ЭтоСверкаВзаиморасчетов2_5_11(ДокСсылка);
	
	Если НЕ ЭтоДокументАктСверки Тогда
		
		ТекстОшибки = НСтр(
			"ru='Не удалось обновить результат сверки. Итоги сверки заполняются только если в документе 1С заполнен признак ""Есть расхождения"".
			|Этот признак можно установить в типе ""Сверка взаиморасчетов 2.5.11""'"
		);
		
		ГенерацияXML.ДобавитьОшибкуВалидации(
			Результат.ОшибкиВДанных,
			ТекстОшибки
		);
		
	КонецЕсли;
	
	Возврат ЭтоДокументАктСверки;
	
КонецФункции

Процедура АктСверки405_ПроверитьОборотыЗаПериодСверки(Результат, ВыборкаПоДоговорам, ДокСсылка)
	
	Если ВыборкаПоДоговорам.Количество() = 0 Тогда
		
		ТекстОшибки = НСтр("ru='В <связанном документе 1С> нет оборотов за период сверки. Заполните обороты или сформируйте акт за другой период, где есть обороты'");
		
		ГенерацияXML.ДобавитьОшибкуВалидации(
			Результат.ОшибкиВДанных,
			ТекстОшибки,
			ДокСсылка
		);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеЮрФизЛицаСлужебный(Реквизиты, ШаблонПредставления = "")
	
	Перем Префикс, СтрокаДополнения;
	
	СоответствиеПараметров = Новый Структура;
	СоответствиеПараметров.Вставить("ПолноеНаименование", " ");
	СоответствиеПараметров.Вставить("СокращенноеНаименование", " ");
	СоответствиеПараметров.Вставить("НаименованиеДляПечатныхФорм", " ");
	СоответствиеПараметров.Вставить("ИНН", " ИНН ");
	СоответствиеПараметров.Вставить("КПП", " КПП ");
	СоответствиеПараметров.Вставить("Свидетельство", " ");
	СоответствиеПараметров.Вставить("СвидетельствоДатаВыдачи", " от ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес", " ");
	СоответствиеПараметров.Вставить("ФактическийАдрес", " ");
	СоответствиеПараметров.Вставить("Телефоны", " тел.: ");
	СоответствиеПараметров.Вставить("Факс", " факс: ");
	СоответствиеПараметров.Вставить("НомерСчета", " р/с ");
	СоответствиеПараметров.Вставить("Банк", " в банке ");
	СоответствиеПараметров.Вставить("БИК", " БИК ");
	СоответствиеПараметров.Вставить("КоррСчет", " к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО", " Код по ОКПО ");
	
	Если ПустаяСтрока(ШаблонПредставления) Тогда
		
		Если НЕ Реквизиты.Свойство("НаименованиеДляПечатныхФорм")
			ИЛИ Не ЗначениеЗаполнено(Реквизиты.НаименованиеДляПечатныхФорм) Тогда
			
			ШаблонПредставления = "НаименованиеПолное," + ШаблонПредставления;
			
		Иначе
			
			ШаблонПредставления = "НаименованиеДляПечатныхФорм," + ШаблонПредставления;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПропускатьПустыеСтроки = Истина;
	Разделитель = ",";
	СписокПараметров = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		ШаблонПредставления,
		Разделитель,
		ПропускатьПустыеСтроки
	);
	
	Результат = Новый Массив;
	
	Для каждого ИмяПараметра Из СписокПараметров Цикл
		
		Если Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения) Тогда
			
			Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения);
			Если ПустаяСтрока(СтрокаДополнения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СоответствиеПараметров.Свойство(ИмяПараметра, Префикс) Тогда
				Результат.Добавить(Префикс + СтрокаДополнения);
			Иначе
				Результат.Добавить(СтрокаДополнения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаРезультата = СтрСоединить(Результат, ",");
	СтрокаРезультата = СтрЗаменить(СтрокаРезультата, "  ", " ");
	
	Возврат СокрЛП(СтрокаРезультата);
	
КонецФункции

Функция ПредставлениеНоменклатуры(Номенклатура, Характеристика, Содержание = "")
	
	Серия = Неопределено;
	Упаковка = Неопределено;
	НоменклатураНаименование = СокрЛП(Номенклатура);
	ХарактеристикаНаименование = СокрЛП(Характеристика);
	
	ИнтерфейсУТ = ОбщийМодульПоИмениЛок("НоменклатураКлиентСервер");
	
	ДополнительныеПараметры = ИнтерфейсУТ.ДополнительныеПараметрыПредставлениеНоменклатурыДляПечати();
	ДополнительныеПараметры.Содержание = Содержание;
	
	Результат = ИнтерфейсУТ.ПредставлениеНоменклатурыДляПечати(
			НоменклатураНаименование,
			ХарактеристикаНаименование,
			Упаковка,
			Серия,
			ДополнительныеПараметры);
	
	Возврат Результат;
	
КонецФункции

Функция АртикулНоменклатуры(Номенклатура)
	
	ДополнительнаяКолонкаНоменклатуры = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	
	Если ДополнительнаяКолонкаНоменклатуры = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
		
		Результат = Номенклатура.Артикул;
		
	ИначеЕсли ДополнительнаяКолонкаНоменклатуры = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Код Тогда
		
		Результат = Номенклатура.Код;
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

