Функция УПД970_ТекстЗапросаАвансовыхДокументовСчетФактурыВыданный()
	
	Результат =
	"ВЫБРАТЬ
	|	&НомерСчетаФактурыНаАванс КАК НомерСчетаФактурыНаАванс,
	|	&ДатаСчетаФактурыНаАванс КАК ДатаСчетаФактурыНаАванс,
	|	&НомерИсправленияСчетаФактурыНаАванс КАК НомерИсправленияСчетаФактурыНаАванс,
	|	&ДатаИсправленияСчетаФактурыНаАванс КАК ДатаИсправленияСчетаФактурыНаАванс
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка
	|	И &ДанныеАСЧФ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ЕстьФункционалСведенийОбАвансах = ЕстьФункционалСведенийОбАвансах();
	
	Если ЕстьФункционалСведенийОбАвансах Тогда
		
		ВыражениеНомерСчетаФактурыНаАванс = "Таблица.НомерСчетаФактурыНаАванс";
		ВыражениеДатаСчетаФактурыНаАванс = "Таблица.ДатаСчетаФактурыНаАванс";
		ВыражениеНомерИсправленияСчетаФактурыНаАванс = "Таблица.НомерИсправленияСчетаФактурыНаАванс";
		ВыражениеДатаИсправленияСчетаФактурыНаАванс = "Таблица.ДатаИсправленияСчетаФактурыНаАванс";
		
		ВыражениеДанныеАСЧФ = "(Таблица.НомерСчетаФактурыНаАванс <> """"
			|	ИЛИ Таблица.ДатаСчетаФактурыНаАванс <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|	ИЛИ Таблица.НомерИсправленияСчетаФактурыНаАванс <> """"
			|	ИЛИ Таблица.ДатаИсправленияСчетаФактурыНаАванс <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
		
	Иначе
		
		НеопределеноДляЗапроса = "НЕОПРЕДЕЛЕНО";
		
		ВыражениеНомерСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		ВыражениеДатаСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		ВыражениеНомерИсправленияСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		ВыражениеДатаИсправленияСчетаФактурыНаАванс = НеопределеноДляЗапроса;
		
		ВыражениеДанныеАСЧФ = "ЛОЖЬ";
		
	КонецЕсли;
	
	Замены = Новый СписокЗначений;
	Замены.Добавить("&НомерСчетаФактурыНаАванс", ВыражениеНомерСчетаФактурыНаАванс);
	Замены.Добавить("&ДатаСчетаФактурыНаАванс", ВыражениеДатаСчетаФактурыНаАванс);
	Замены.Добавить("&НомерИсправленияСчетаФактурыНаАванс", ВыражениеНомерИсправленияСчетаФактурыНаАванс);
	Замены.Добавить("&ДатаИсправленияСчетаФактурыНаАванс", ВыражениеДатаИсправленияСчетаФактурыНаАванс);
	Замены.Добавить("&ДанныеАСЧФ", ВыражениеДанныеАСЧФ);
	
	Для Каждого Элемент Из Замены Цикл
		Результат = СтрЗаменить(Результат, Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданныйНаАванс()
	
	Результат =
	"ВЫБРАТЬ
	|	СчетФактура.Ссылка КАК Ссылка,
	|	СчетФактура.НалогообложениеНДС КАК НалогообложениеНДС,
	|	СчетФактура.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	СчетФактура.Номер КАК Номер,
	|	ВЫБОР КОГДА СчетФактура.Исправление ТОГДА
	|		ЕСТЬNULL(СчетФактура.СчетФактураОснование.Дата, ДАТАВРЕМЯ(1,1,1))
	|	ИНАЧЕ 
	|		СчетФактура.Дата
	|	КОНЕЦ КАК Дата,
	|	ВЫБОР КОГДА СчетФактура.Исправление ТОГДА
	|		СчетФактура.НомерИсправления 
	|	ИНАЧЕ
	|		НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК НомерИсправления,
	|	ВЫБОР КОГДА СчетФактура.Исправление ТОГДА
	|		СчетФактура.Дата
	|	ИНАЧЕ
	|		НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДатаИсправления,
	|	СчетФактура.Исправление КАК ЭтоИсправление,
	|	ВЫРАЗИТЬ(&ВалютаРеглУчета КАК Справочник.Валюты).Код КАК ВалютаДокументаКод,
	|	ВЫБОР
	|		КОГДА СчетФактура.Контрагент.ОбособленноеПодразделение
	|			ТОГДА СчетФактура.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ СчетФактура.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА СчетФактура.Организация.ОбособленноеПодразделение
	|			ТОГДА СчетФактура.Организация.ГоловнаяОрганизация
	|		ИНАЧЕ СчетФактура.Организация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР 
	|		КОГДА ЕСТЬNULL(СчетФактура.НалогообложениеНДС, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НДСИсчисляетсяНалоговымАгентом,
	|
	|	ЕСТЬNULL(ДанныеПоставщика.ИндексПодразделения, 0) КАК ИндексПодразделения,
	|	&ВалютаРеглУчета КАК ВалютаДокумента,
	|
	|	СчетФактура.ДокументОснование КАК ДокументОснование,
	|	СчетФактура.НомерПлатежноРасчетногоДокумента КАК НомерПлатежноРасчетногоДокумента,
	|	СчетФактура.ДатаПлатежноРасчетногоДокумента КАК ДатаПлатежноРасчетногоДокумента,
	|
	|	ДанныеПоставщика.КПППоставщика КАК КПППоставщика,
	|	&КПППокупателя КАК КПППокупателя
	|ИЗ
	|	Документ.СчетФактураВыданныйАванс КАК СчетФактура
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ДанныеОрганизацийПокупатель
	|		ПО ДанныеОрганизацийПокупатель.Ссылка = СчетФактура.Контрагент
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК ДанныеКонтрагента
	|		ПО ДанныеКонтрагента.Ссылка = СчетФактура.Контрагент
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоставщика КАК ДанныеПоставщика
	|		ПО СчетФактура.Ссылка = ДанныеПоставщика.Ссылка
	|ГДЕ
	|	СчетФактура.Ссылка = &Ссылка";
	
	Если СравнитьВерсии_(ВерсияТорговойПодсистемы(), "11.5.19") >= 0 Тогда
		
		ТекстЗамены = "
		|	ВЫБОР
		|		КОГДА СчетФактура.КППКонтрагента ПОДОБНО """" ТОГДА
		|			ВЫБОР 
		|				КОГДА СчетФактура.Контрагент ССЫЛКА Справочник.Контрагенты ТОГДА 
		|					""""
		|				КОГДА СчетФактура.Контрагент ССЫЛКА Справочник.Организации 
		|						И НЕ ДанныеОрганизацийПокупатель.Ссылка ЕСТЬ NULL ТОГДА 
		|							ВЫБОР
		|								КОГДА ДанныеОрганизацийПокупатель.КрупнейшийНалогоплательщик ТОГДА
		|									ДанныеОрганизацийПокупатель.КрупнейшийНалогоплательщикКПП
		|								ИНАЧЕ
		|									ДанныеОрганизацийПокупатель.КПП
		|								КОНЕЦ
		|				ИНАЧЕ 
		|					""""
		|				КОНЕЦ
		|		ИНАЧЕ
		|			СчетФактура.КППКонтрагента
		|	КОНЕЦ";
		
	Иначе
		
		ТекстЗамены = "
		|	ВЫБОР
		|		КОГДА СчетФактура.КППКонтрагента ПОДОБНО """" ТОГДА
		|			ДанныеОрганизацийПокупатель.КПП
		|		ИНАЧЕ
		|			СчетФактура.КППКонтрагента
		|	КОНЕЦ";
	
	КонецЕсли;

	Результат = СтрЗаменить(Результат, "&КПППокупателя", ТекстЗамены);
	
