	|	ТаблицаДокумента.НомерГТД                               КАК НомерГТД,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Номенклатура.КодТНВЭД    КАК КодТНВЭД,
	|	СУММА(ТаблицаДокумента.Количество)                      КАК Количество,
	|	СУММА(ТаблицаДокумента.КоличествоПоРНПТ)                КАК КоличествоПоРНПТ,
	|	
	|	ТаблицаДокумента.Цена                                   КАК Цена,
	|	СУММА(ТаблицаДокумента.СуммаСНДС) - СУММА(ТаблицаДокумента.СуммаНДС) КАК СуммаБезНДС,
	|	СУММА(ЕСТЬNULL(СуммыДокументовВВалютахУчета.СуммаБезНДСРегл, 0)) КАК СуммаБезНДСРуб,
	|	
	|	ТаблицаДокумента.СтавкаНДС                              КАК СтавкаНДС,
	|	
	|	СУММА(ТаблицаДокумента.СуммаНДС)                        КАК СуммаНДС,
	|	СУММА(ЕСТЬNULL(СуммыДокументовВВалютахУчета.СуммаНДСРегл, 0)) КАК СуммаНДСРуб,
	|	
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Номенклатура.ТипНоменклатуры В
	|		(ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ                                                   КАК ЭтоТовар,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаДокумента.Упаковка
	|	КОНЕЦ                                               КАК Упаковка,
	|	СУММА(ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ЕСТЬNULL(ТаблицаДокумента.Количество, 0)
	|		ИНАЧЕ ЕСТЬNULL(ТаблицаДокумента.КоличествоУпаковок, 0)
	|	КОНЕЦ)                                                  КАК КоличествоУпаковок,
	|	РеквизитыДокумента.ЦенаВключаетНДС                      КАК ЦенаВключаетНДС,
	|
	|	ТаблицаДокумента.Поставщик                              КАК Поставщик
	|
	|ПОМЕСТИТЬ ОтчетКомитентуОЗакупкахТаблицаТоваров
	|ИЗ
	|	Документ.ОтчетКомитентуОЗакупках.Товары КАК ТаблицаДокумента
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|	ПО
	|		ТаблицаДокумента.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Документ.ОтчетКомитентуОЗакупках КАК РеквизитыДокумента
	|	ПО
	|		ТаблицаДокумента.Ссылка = РеквизитыДокумента.Ссылка
	|	
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.СуммыДокументовВВалютахУчета КАК СуммыДокументовВВалютахУчета
	|	ПО
	|		ТаблицаДокумента.Ссылка = СуммыДокументовВВалютахУчета.Регистратор
	|		И ТаблицаДокумента.ИдентификаторСтроки = СуммыДокументовВВалютахУчета.ИдентификаторСтроки
	|		И СуммыДокументовВВалютахУчета.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумента.Ссылка,
	|	ТаблицаДокумента.ИдентификаторСтроки,
	|	ТаблицаДокумента.Номенклатура,
	|	ТаблицаДокумента.Характеристика,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Серия,
	|	ТаблицаДокумента.НомерГТД,
	|	ТаблицаДокумента.АналитикаУчетаНоменклатуры.Номенклатура.КодТНВЭД,
	|	ТаблицаДокумента.Цена,
	|	ТаблицаДокумента.СтавкаНДС,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаДокумента.Упаковка
	|	КОНЕЦ,
	|	РеквизитыДокумента.ЦенаВключаетНДС,
	|	ТаблицаДокумента.Поставщик
	|";
	
	УПД970_ЗаполнитьВТекстеЗапросаИмяРегистраСуммаДокументовВВалютахУчета(ТекстЗапроса);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", ВыводитьБазовыеЕдиницыИзмерения());
	Запрос.Выполнить();
	
