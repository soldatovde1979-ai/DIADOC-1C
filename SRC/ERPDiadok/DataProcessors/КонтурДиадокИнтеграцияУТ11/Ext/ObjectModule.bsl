Функция УПД970_НовыйСтруктураДанных(ИсходныеДанные)

	Результат = Новый Структура;
	Результат.Вставить("ПлатежноРасчетныеДокументы", Неопределено);
	Результат.Вставить("Прослеживаемость", Неопределено);
	Результат.Вставить("ПрослеживаемыеКомплектующие", Неопределено);
	Результат.Вставить("РезультатПоКонтрагентам", Неопределено);
	Результат.Вставить("РезультатПоПоставщикам", Неопределено);
	Результат.Вставить("РезультатПоТабличнойЧасти", Неопределено);
	Результат.Вставить("СчетФактураНаАванс", Ложь);
	
	ЗаполнитьЗначенияСвойств(Результат, ИсходныеДанные);
	
	ВыборкаДанныхШапки = ИсходныеДанные.РезультатПоШапке.Выбрать();
	
	Если Не ВыборкаДанныхШапки.Следующий() Тогда
		ТекстОшибки = НСтр("ru='Не удалось сформировать пакет документов. Проверьте корректность заполнения документа 1С'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Результат.Вставить("ДанныеШапки", ВыборкаДанныхШапки);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеСчетФактураВыданныйНаАвансДляТитулаПродавца(ДокСсылка)
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ДокСсылка);
	
	ПараметрыПечати = Новый Структура();
	ПараметрыПечати.Вставить("ЗаполнениеЭлектронногоДокумента");
	
	Если ЭтоВерсияТорговойПодсистемы_11_5() Тогда
		МенеджерОбъекта = ОбщийМодульПоИмениЛок("СчетФактураВыданныйАвансЛокализация");
	Иначе
		МенеджерОбъекта = Документы.СчетФактураВыданныйАванс;
	КонецЕсли;
		
	СтруктураДанных = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыСчетФактура(
		ПараметрыПечати,
		МассивОбъектов);
		
	Результат = УПД970_НовыйСтруктураДанных(СтруктураДанных);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТаблицаДанныхПрослеживаемости(СтруктураДанных)

	ДанныеПрослеживаемости = Неопределено;
	СтруктураДанных.Свойство("Прослеживаемость", ДанныеПрослеживаемости);
	
