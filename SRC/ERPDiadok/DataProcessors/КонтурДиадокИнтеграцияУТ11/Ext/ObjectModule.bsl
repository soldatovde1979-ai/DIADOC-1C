// Типовой обработчик события "ПодготовитьДанныеДляОтправкиВнутреннихДокументов"
//
// Параметры:
//  ВидПакетаID - Строка - идентификатор вида пакета
//  Запрос - Запрос - инициализированный запрос (с параметрами и менеджером временных таблиц)
// 
// Возвращаемое значение:
//  Массив из Строка - имена добавленных временных таблиц
//
Функция ВнутренниеДокументыСлужебный_ПодготовитьДанныеДляОтправки(ВидПакетаID, Запрос) Экспорт
	
	Результат = Новый Массив;
	
	IDВидовПакетовВнутренних = ИдентификаторыПакетовВнутреннихДокументов();
	ЭтоВидПакетаВнутренний = (IDВидовПакетовВнутренних.Найти(ВидПакетаID) <> Неопределено);
	
	Если НЕ ЭтоВидПакетаВнутренний Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если РазрешеноЧтениеТаблицы(Метаданные.Документы.ПеремещениеТоваров) Тогда
		
		Если ЭтоИсправительныйВидПакета(ВидПакетаID)
			И НЕ ЕстьИсправлениеПеремещенияТоваров() Тогда
			Возврат Результат;
		КонецЕсли;
		
		Если ЭтоИсправительныйВидПакета(ВидПакетаID) Тогда
			ИмяВТ = ДобавитьТаблицу_ИсправлениеПеремещенияТоваров(Запрос);
		Иначе
			ИмяВТ = ДобавитьТаблицу_ПеремещениеТоваров(Запрос);
		КонецЕсли;
		
		Результат.Добавить(ИмяВТ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИдентификаторыПакетовВнутреннихДокументов()
	
	Результат = Новый Массив;
	Результат.Добавить("ID_УПД_ВНУТР");
	Результат.Добавить("ID_ИУПД_ВНУТР");
	
	Возврат Результат;
	
КонецФункции

// Вызывается из МодульМенеджер.ЗначенияПолейМаршрутизацииПоПодразделениям.
// Переопределяет получение значений полей маршрутизации по документу 1С
//
// Параметры:
//	ПоляОтправителя		- Массив 			- значения полей маршрутизации в подразделение отправителя
//	ПоляПолучателя		- Массив 			- значения полей маршрутизации в подразделение получателя
//	Документ1С			- ДокументСсылка 	- документ пакета, для которого определяются значения полей
Процедура ЗаполнитьЗначенияПолейМаршрутизацииПоПодразделениям(ПоляОтправителя, ПоляПолучателя, Документ1С) Экспорт
	
	МетаданныеДокумента1С = Документ1С.Метаданные();
	
	ЕстьРеквизитПодразделение = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "Подразделение");
	ЕстьРеквизитОрганизация = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "Организация");
	ЕстьРеквизитКонтрагент = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "Контрагент");
	ЕстьРеквизитПартнер = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "Партнер");
	ЕстьРеквизитСкладОтправитель = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "СкладОтправитель");
	ЕстьРеквизитСкладПолучатель = Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеДокумента1С, "СкладПолучатель");
	
	ИменаРеквизитов = Новый Массив;
	
	Если ЕстьРеквизитСкладОтправитель Тогда
		ИменаРеквизитов.Добавить("СкладОтправитель");
	КонецЕсли;
	
	Если ЕстьРеквизитСкладПолучатель Тогда
		ИменаРеквизитов.Добавить("СкладПолучатель");
	КонецЕсли;
	
	Если ЕстьРеквизитПодразделение Тогда
		ИменаРеквизитов.Добавить("Подразделение");
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация Тогда
		ИменаРеквизитов.Добавить("Организация");
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент Тогда
		ИменаРеквизитов.Добавить("Контрагент");
	КонецЕсли;
	
	Если ЕстьРеквизитПартнер Тогда
		ИменаРеквизитов.Добавить("Партнер");
	КонецЕсли;
	
	Разделитель = ",";
	ТребуемыеРеквизиты = Ядро.СоединитьСтроку(ИменаРеквизитов, Разделитель);
	
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		Реквизиты = Ядро.Общее_ЗначенияРеквизитовОбъекта(Документ1С, ТребуемыеРеквизиты);
	КонецЕсли;
	
	// В коллекции ПоляОтправителя и ПоляПолучателя индекс элементов соответствует приоритету этих элементов.
	// Чем меньше индекс, тем выше приоритет.
	
	Если ЕстьРеквизитСкладОтправитель И ЗначениеЗаполнено(Реквизиты.СкладОтправитель) Тогда
		ПоляОтправителя.Добавить(Реквизиты.СкладОтправитель);
	КонецЕсли;
	
	Если ЕстьРеквизитПодразделение И ЗначениеЗаполнено(Реквизиты.Подразделение) Тогда
		ПоляОтправителя.Добавить(Реквизиты.Подразделение);
	КонецЕсли;
	
	Если ЕстьРеквизитОрганизация И ЗначениеЗаполнено(Реквизиты.Организация) Тогда
		ПоляОтправителя.Добавить(Реквизиты.Организация);
	КонецЕсли;
	
	Если ЕстьРеквизитСкладПолучатель И ЗначениеЗаполнено(Реквизиты.СкладПолучатель) Тогда
		ПоляПолучателя.Добавить(Реквизиты.СкладПолучатель);
	КонецЕсли;
	
	Если ЕстьРеквизитКонтрагент И ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Контрагент);
	КонецЕсли;
	
	Если ЕстьРеквизитПартнер И ЗначениеЗаполнено(Реквизиты.Партнер) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Партнер);
	КонецЕсли;
	
	ДополнитьПоляМаршрутизацииЗначениямиДоговоров(ПоляПолучателя, Документ1С);
	
КонецПроцедуры

Процедура ДополнитьПоляМаршрутизацииЗначениямиДоговоров(ПоляПолучателя, Документ1С)
	
	// не все документы основания для СФ и СФ на аванс содержат данные о подразделении
	// и наоборот СФ на аванс не содержит данных о договоре и соглашении 
	
	ТипСсылки = ТипЗнч(Документ1С);
	
	ЭтоСчетФактураВыданныйАванс = (ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданныйАванс"));
	ЭтоСчетФактураВыданный		= (ТипСсылки = Тип("ДокументСсылка.СчетФактураВыданный"));
			
	Если ЭтоСчетФактураВыданныйАванс Тогда
		
		ЗначениеРеквизита = Ядро.Общее_ЗначенияРеквизитовОбъекта(Документ1С, "ДокументОснование");
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита.ДокументОснование) Тогда
			Возврат;		
		КонецЕсли;
		
		ИсточникДанных = ЗначениеРеквизита.ДокументОснование;
		
	ИначеЕсли ЭтоСчетФактураВыданный Тогда
		
		ДокОснованиеСФ = ДокументыОснованияСчетаФактуры(Документ1С);
		
		Если Не ЗначениеЗаполнено(ДокОснованиеСФ) Тогда
			Возврат;
		КонецЕсли;
		
		ИсточникДанных = ДокОснованиеСФ[0];
		
	Иначе
		
		ИсточникДанных = Документ1С;
		
	КонецЕсли;
	
	МетаданныеИсточникаДанных = ИсточникДанных.Метаданные();
	
	ЕстьРеквизитДоговор		= Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "Договор");
	ЕстьРеквизитСоглашение	= Ядро.Общее_ЕстьРеквизитМетаданных(МетаданныеИсточникаДанных, "Соглашение");
	
	ИменаРеквизитов = Новый Массив;
	
	Если ЕстьРеквизитДоговор Тогда
		ИменаРеквизитов.Добавить("Договор");
	КонецЕсли;
	
	Если ЕстьРеквизитСоглашение Тогда
		ИменаРеквизитов.Добавить("Соглашение");
	КонецЕсли;
		
	Разделитель 		= ",";
	ТребуемыеРеквизиты 	= Ядро.СоединитьСтроку(ИменаРеквизитов, Разделитель);
	
	Если ЗначениеЗаполнено(ТребуемыеРеквизиты) Тогда
		Реквизиты = Ядро.Общее_ЗначенияРеквизитовОбъекта(ИсточникДанных, ТребуемыеРеквизиты);
	КонецЕсли;
	
	Если ЕстьРеквизитДоговор И ЗначениеЗаполнено(Реквизиты.Договор) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Договор);
	КонецЕсли;
	
	Если ЕстьРеквизитСоглашение И ЗначениеЗаполнено(Реквизиты.Соглашение) Тогда
		ПоляПолучателя.Добавить(Реквизиты.Соглашение);
	КонецЕсли;
	
КонецПроцедуры

// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка.СчетФактураВыданный - Счет-фактура, основание которого требуется получить.
// 
// Возвращаемое значение:
//  Массив - документы, на основании которых выписан счет-фактура.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура)
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Выборка = Ядро.Общее_ВыборкаДанныхОбъекта(СчетФактура, "ДокументыОснования", "ДокументОснование");
			
	Пока Выборка.Следующий() Цикл 
		
		ДокументОснование = Выборка.ДокументОснование;
		
		Если Результат.Найти(ДокументОснование) = Неопределено Тогда
			Результат.Добавить(ДокументОснование);
		КонецЕсли;
		
	КонецЦикла;
			
	Возврат Результат;
	
КонецФункции

// См. метод "ПередФормированиемПечатнойФормыСчетаНаОплату" в модуле "МенеджерИнтеграции"
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- см. метод "НовыйПараметрыТиповогоМетодаПечати" в модуле "МенеджерИнтеграции"
//
Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати) Экспорт
	
	МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Обработка.ПечатьСчетовНаОплату");
	
	НовыйЭлементТаблицы = ПараметрыМетодаПечати.КоллекцияПечатныхФорм.Добавить();
	НовыйЭлементТаблицы.ИмяМакета 	= "СчетНаОплату";
	НовыйЭлементТаблицы.ИмяВРЕГ 	= ВРег(НовыйЭлементТаблицы.ИмяМакета);
	
КонецПроцедуры

// Возвращает номер документа учета без префикса информационной базы,
// префикса конфигурации и лидирующих нолей
//
// Параметры:
//  Документ - ДокументСсылка - документ учета информационной базы
//
// Возвращаемое значение:
//   Строка - Номер без префиксов и лидирующих нолей
//
Функция ПриПолученииПредставленияНомераДокументаУчета(Документ) Экспорт
	
	Результат = ПредставлениеНомера(Документ.Номер);
	
	Возврат Результат;
	
КонецФункции

// См. метод "СписокОснованийДляЭлектронногоСчетаНаОплату" в модуле "МенеджерИнтеграции"
// Переопределяет заполнение списка доступных оснований для формирования электронного счета на оплату.
//
// Параметры:
//	СписокОснований - СписокЗначений - переопределяемый список значений
//
Процедура ЗаполнитьСписокОснованийДляЭлектронногоСчетаНаОплату(СписокОснований) Экспорт
	
	СписокОснований.Добавить("СчетНаОплату"		, "Счет на оплату");
	СписокОснований.Добавить("ЗаказКлиента"		, "Заказ клиента");
	СписокОснований.Добавить("ДокументПродажи"	, "Документ продажи");
	
КонецПроцедуры

// См. метод "ЭтоДокументКонфигурацииСчетНаОплату" в модуле "МенеджерИнтеграции"
// Определяет является ли переданный документ ИБ счетом на оплату
//
// Параметры:
//	Документ1С - ДокументСсылка - учетный документ информационной базы
//
// Возвращаемое значение:
//	Булево - Истина, если это счет на оплату
Функция ЭтоДокументКонфигурацииСчетНаОплату(Документ1С) Экспорт
	
	Результат = (ТипЗнч(Документ1С) = Тип("ДокументСсылка.СчетНаОплатуКлиенту"));
	
	Возврат Результат;
	
КонецФункции

// При получении реквизитов документов можно изменить реквизиты документа проверяемые по умолчанию или добавить новые
//
// Параметры:
//  СоответствияРеквизитов	 - Структура - Соответствие реквизитов ЭД и Документа учета
//  СсылкаНаОбъект		 - ДокументСсылка - ссылка на проверяемый документ
Процедура ПриПолученииИменРеквизитовДокументаУчета_НомерДата(СоответствияРеквизитов, СсылкаНаОбъект) Экспорт
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	ИмяМетаданных = МетаданныеОбъекта.Имя;
	
	ВидыДокументов = Новый Структура;
	ВидыДокументов.Вставить("СчетФактураПолученный");
	ВидыДокументов.Вставить("СчетФактураПолученныйАванс");
	ВидыДокументов.Вставить("СчетФактураПолученныйНалоговыйАгент");
	
	Если ВидыДокументов.Свойство(ИмяМетаданных) Тогда
		
		СоответствияРеквизитов.Номер = "Номер";
		СоответствияРеквизитов.Дата	 = "ДатаСоставления";
		
	КонецЕсли;
	
КонецПроцедуры

// Значения реквизитов документов учета организация контрагент
//
// Параметры:
//  КоллекцияДокументов - Массив - коллекция документов учета
// 
// Возвращаемое значение:
//  Соотвествие - Соответствие в котором ключом является сам документ а в значении структура ревизитов (Организация, Контрагент) 
//
Функция ЗначенияРеквизитовДокументовУчета_ОрганизацияКонтрагент(КоллекцияДокументов) Экспорт
	
	ПервыйЭлемент = КоллекцияДокументов[0];
	МетаданныеЭлемента = ПервыйЭлемент.Метаданные();
	
	Реквизиты = Новый Массив;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеЭлемента) Тогда
		Реквизиты.Добавить("Организация");
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеЭлемента) Тогда
		Реквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	ИменаРеквизитов = СтрСоединить(Реквизиты, ",");
	ВыбратьРазрешенные = Истина;
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		КоллекцияДокументов,
		ИменаРеквизитов,
		ВыбратьРазрешенные
	);
	
	Возврат Результат;
	
КонецФункции

Функция РеквизитыДокументаУчетаДляПакетаНаОтправку(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Документ", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("НомерДокумента", "");
	Результат.Вставить("ДатаДокумента", '00010101');
	Результат.Вставить("СуммаДокумента", "");
	Результат.Вставить("ДокументБезНДС", Ложь);
	Результат.Вставить("ТипДокументаПоддерживается", Истина);
	Результат.Вставить("КатегорияПакета", "ОсновнойПакет");
	
	Если ЭтоПодходящийСчетФактураДляПакетаНаОтправку(СсылкаНаОбъект) Тогда
		
		ВыборкаРеквизитов = ВыборкаРеквизитовСчетФактурыДляПакетаНаОтправку(СсылкаНаОбъект);
		
		Если ЭтоСчетФактураВыданныйНаАванс(СсылкаНаОбъект) Тогда
			Результат.КатегорияПакета = "СчетФактураНаАванс";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Если ЭтоРеализацияПередачаНаКомиссию(СсылкаНаОбъект) Тогда
			Результат.ДокументБезНДС = Истина;
		Иначе
			Результат.ДокументБезНДС = ДокументБезНДС(СсылкаНаОбъект);
		КонецЕсли;
		
		Если Результат.ДокументБезНДС Тогда
			ВыборкаРеквизитов = ВыборкаРеквизитовРеализацииДляПакетаНаОтправку(СсылкаНаОбъект);
		ИначеЕсли РазрешеноЧтениеТаблицы(Метаданные.Документы.СчетФактураВыданный) Тогда
			ВыборкаРеквизитов = ВыборкаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку(СсылкаНаОбъект);
		Иначе
			Результат.ТипДокументаПоддерживается = Ложь;
		КонецЕсли;
		
	Иначе
		
		Результат.ТипДокументаПоддерживается = Ложь;
		
	КонецЕсли;
	
	Если Результат.ТипДокументаПоддерживается
		И ВыборкаРеквизитов.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, ВыборкаРеквизитов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДокументБезНДС(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТабличнаяЧасть.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК ТабличнаяЧасть
	|ГДЕ
	|	ТабличнаяЧасть.СтавкаНДС <> ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И ТабличнаяЧасть.Ссылка = &СсылкаНаОбъект";
	
	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Перечисление.СтавкиНДС", "Справочник.СтавкиНДС");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаРеквизитовСчетФактурыДляПакетаНаОтправку(СсылкаНаОбъект)
	
	Если ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		ТекстЗапроса = ТекстЗапросаРеквизитовСчетФактурыДляПакетаНаОтправку_ПоРегистру();
	Иначе
		ТекстЗапроса = ТекстЗапросаРеквизитовСчетФактурыДляПакетаНаОтправку_ПоДокументу();
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	
	// BSLLS:IfElseIfEndsWithElse-off
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.СчетФактураВыданный", "Документ.СчетФактураВыданныйАванс");
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураКомиссионеру") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.СчетФактураВыданный", "Документ.СчетФактураКомиссионеру");
	КонецЕсли;
	// BSLLS:IfElseIfEndsWithElse-on
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаРеквизитовСчетФактурыДляПакетаНаОтправку_ПоРегистру()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДокСчетФактура.Ссылка КАК Документ,
	|	ДокСчетФактура.Контрагент КАК Контрагент,
	|	ДокСчетФактура.Организация КАК Организация,
	|	ДокСчетФактура.Номер КАК НомерДокумента,
	|	ДокСчетФактура.Дата КАК ДатаДокумента,
	|	ЛОЖЬ КАК ДокументБезНДС,
	|	СУММА(
	|		ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре, 0)
	|		+ ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение, 0)
	|		+ ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение, 0)) КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный КАК ДокСчетФактура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
	|		ПО ДокСчетФактура.Ссылка = ЖурналУчетаСчетовФактур.СчетФактура
	|			И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры)
	|ГДЕ
	|	ДокСчетФактура.Ссылка = &СсылкаНаОбъект
	|	И НЕ ДокСчетФактура.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокСчетФактура.Ссылка,
	|	ДокСчетФактура.Номер,
	|	ДокСчетФактура.Дата,
	|	ДокСчетФактура.Контрагент,
	|	ДокСчетФактура.Организация";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаРеквизитовСчетФактурыДляПакетаНаОтправку_ПоДокументу()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокСчетФактура.Ссылка КАК Документ,
	|	ДокСчетФактура.Контрагент КАК Контрагент,
	|	ДокСчетФактура.Организация КАК Организация,
	|	ДокСчетФактура.Номер КАК НомерДокумента,
	|	ДокСчетФактура.Дата КАК ДатаДокумента,
	|	ЛОЖЬ КАК ДокументБезНДС,
	|	0 КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный КАК ДокСчетФактура
	|ГДЕ
	|	ДокСчетФактура.Ссылка = &СсылкаНаОбъект
	|	И НЕ ДокСчетФактура.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции


Функция ВыборкаРеквизитовРеализацииДляПакетаНаОтправку(СсылкаНаОбъект)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслуг.Ссылка КАК Документ,
	|	РеализацияТоваровУслуг.Контрагент КАК Контрагент,
	|	РеализацияТоваровУслуг.Организация КАК Организация,
	|	РеализацияТоваровУслуг.Номер КАК НомерДокумента,
	|	РеализацияТоваровУслуг.Дата КАК ДатаДокумента,
	|	РеализацияТоваровУслуг.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &СсылкаНаОбъект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ВыборкаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку(СсылкаНаОбъект)
	
	Если ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		ТекстЗапроса = ТекстЗапросаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку_ПоРегистру();
	Иначе
		ТекстЗапроса = ТекстЗапросаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку_ПоДокументу();
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку_ПоРегистру()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Контрагент КАК Контрагент,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Организация КАК Организация,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер КАК НомерДокумента,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Дата КАК ДатаДокумента,
	|	СУММА(
	|		ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре, 0)
	|		+ ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение, 0)
	|		+ ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение, 0)) КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
	|		ПО СчетФактураВыданныйДокументыОснования.Ссылка = ЖурналУчетаСчетовФактур.СчетФактура
	|			И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры)
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетФактураВыданныйДокументыОснования.Ссылка,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Дата,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Контрагент,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Организация";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаРеквизитовСчетФактурыПоДокументуОснованияДляПакетаНаОтправку_ПоДокументу()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Контрагент КАК Контрагент,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Организация КАК Организация,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Номер КАК НомерДокумента,
	|	СчетФактураВыданныйДокументыОснования.Ссылка.Дата КАК ДатаДокумента,
	|	0 КАК СуммаДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления";
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПодходящийСчетФактураДляПакетаНаОтправку(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	Если ЭтоСчетФактураКомиссионеру(СсылкаНаОбъект) Тогда
		Результат = Истина;
	ИначеЕсли ЭтоСчетФактураВыданныйНаАванс(СсылкаНаОбъект) Тогда
		Результат = НЕ ЭтоИсправительныйИлиКорректировочныйСчетФактура(СсылкаНаОбъект);
	ИначеЕсли ЭтоСчетФактураВыданный(СсылкаНаОбъект) Тогда
		Результат = НЕ ЭтоИсправительныйИлиКорректировочныйСчетФактура(СсылкаНаОбъект)
			И МодульПоддерживаетОбработкуДокументаОснованияСчетФактуры(СсылкаНаОбъект);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактураВыданный(СсылкаНаОбъект)
	
	Результат = ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный");
	Возврат Результат;
	
КонецФункции

Функция ЭтоИсправительныйИлиКорректировочныйСчетФактура(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	РеквизитыСФ = ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, "Корректировочный, Исправление");
	
	Если РеквизитыСФ.Корректировочный = Истина
		Или РеквизитыСФ.Исправление = Истина Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МодульПоддерживаетОбработкуДокументаОснованияСчетФактуры(СсылкаНаОбъект)
	
	Результат = Истина;
	
	ВидыПредопределенныхДокументов = ВидыПредопределенныхДокументовДляПоискаВМодуле();
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК Т
	|ГДЕ
	|	Т.Ссылка = &СсылкаНаОбъект";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументОснование = Выборка.ДокументОснование;
		
		Если ВидыПредопределенныхДокументов.Найти(ДокументОснование.Метаданные()) = Неопределено Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


// Определяет необходимость наличия счета-фактуры выданного у документа реализации товаров и услуг
//
// Параметры:
//  Документ1С	 - ДокументСсылка	 - реализация товаров и услуг, у которой необходимо проверить необходимость наличия СФ  
// 
// Возвращаемое значение:
//  Результат	- Булево - Истина, если требуется наличие счета-фактуры 
//
Функция ТребуетсяСчетФактура(Документ1С) Экспорт

	Результат = Ложь;
	
	Если ТипЗнч(Документ1С) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ЭтоРеализацияПередачаНаКомиссию = ЭтоРеализацияПередачаНаКомиссию(Документ1С);
		ДокументБезНДС = ДокументБезНДС(Документ1С);
		УДокументаЕстьСчетФактураВыданный = УДокументаЕстьСчетФактураВыданный(Документ1С);
		
		Если Не ЭтоРеализацияПередачаНаКомиссию 
			И (Не ДокументБезНДС И Не УДокументаЕстьСчетФактураВыданный) Тогда
			
			Результат = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УДокументаЕстьСчетФактураВыданный(Документ1С)

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Документ
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументОснование
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументОснование", Документ1С);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = Не РезультатЗапроса.Пустой();
	
	Возврат Результат;		
	
КонецФункции

// Возвращает массив ссылок на связанные документы учета 1С.
// Для получения подчиненных документов используется критерии отбора СвязанныеДокументы.
// Если передан в параметрх СчетНаОплатуКлиента, то сначала берем ссылку на документ из его реквизита ДокументоОснование
// и только потом для этого документа по критериям ищем связанные документы.
//
// Параметры:
//  ДокументУчета	 - Любая ссылка	 - ссылка на документ учета 1С, для которого необходимо получить коллекую связанных с ним
// 
// Возвращаемое значение:
//  Массив - массив ссылок на документы 1С
//
Функция СчетаНаОплату_СвязанныеДокументыПоКритериюОтбора(Документ) Экспорт
	
	Результат = Новый Массив;
	
	Если ЭтоЗаказКлиента(Документ) Тогда
		
		СчетаНаОплату_ЗаполнитьКоллекциюПоЗаказуКлиента(Результат, Документ);
		
	Иначе
		
		Если ЭтоСчетНаОплатуПокупателю(Документ) Тогда
			ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ДокументОснование");
		Иначе
			ДокументОснование = Документ;
		КонецЕсли;
		
		Если ЭтоЗаказКлиента(ДокументОснование) Тогда
			СчетаНаОплату_ЗаполнитьКоллекциюПоЗаказуКлиента(Результат, ДокументОснование);
		Иначе
			
			ИсключаемыеТипы = СчетаНаОплату_ИсключаемыеТипыСвязей();
			ВторичныеСвязи = СвязиДокументов_НайтиПоКритериюОтбора(ДокументОснование, ИсключаемыеТипы);
			Общее_ДополнитьМассив(Результат, ВторичныеСвязи);
			
		КонецЕсли;
		
		Результат.Добавить(ДокументОснование);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СчетаНаОплату_ЗаполнитьКоллекциюПоЗаказуКлиента(КоллекцияПриемник, ЗаказКлиента)
	
	ИсключаемыеТипы = СчетаНаОплату_ИсключаемыеТипыСвязей();
	
	ПервичныеСвязи = СвязиДокументов_НайтиПоКритериюОтбора(ЗаказКлиента, ИсключаемыеТипы);
	Общее_ДополнитьМассив(КоллекцияПриемник, ПервичныеСвязи);
	
	Для Каждого СсылкаНаОбъект Из ПервичныеСвязи Цикл
		
		ВторичныеСвязи = СвязиДокументов_НайтиПоКритериюОтбора(СсылкаНаОбъект, ИсключаемыеТипы);
		Общее_ДополнитьМассив(КоллекцияПриемник, ВторичныеСвязи);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Общее_ДополнитьМассив(МассивПриемник, МассивИсточник)
	
	ТолькоУникальныеЗначения = Истина;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		МассивПриемник,
		МассивИсточник,
		ТолькоУникальныеЗначения
	);
	
КонецПроцедуры

Процедура СвязанныеДокументы_ЗаполнитьКоллекциюПоДокументу(КоллекцияПриемник, Документ)
	
	СвязанныеДокументы = СвязиДокументов_НайтиПоКритериюОтбора(Документ);

	Для Каждого СсылкаНаОбъект Из СвязанныеДокументы Цикл

		Если КоллекцияПриемник.Найти(СсылкаНаОбъект) = Неопределено Тогда
			КоллекцияПриемник.Добавить(СсылкаНаОбъект); 
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает массив ссылок на связанные документы учета 1С
//
// Параметры:
//  Документ - Любая ссылка	 - ссылка на документ учета 1С, для которого необходимо получить коллекую связанных с ним
// 
// Возвращаемое значение:
//  Массив - массив ссылок на документы 1С
//
Функция СвязиДокументов_НайтиПоКритериюОтбора(Документ, Знач ИсключаемыеТипы = Неопределено)
	
	УсловиеИсключитьТипы = "ИСТИНА";
	
	Если ЗначениеЗаполнено(ИсключаемыеТипы) Тогда
		УсловиеИсключитьТипы = "НЕ ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) В(&ИсключаемыеТипы)";
	КонецЕсли;
	
	ТекстЗапроса = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СвязанныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	КритерийОтбора.СвязанныеДокументы(&Ссылка) КАК СвязанныеДокументы
	|ГДЕ
	|	&УсловиеИсключитьТипы";
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"&УсловиеИсключитьТипы",
		УсловиеИсключитьТипы
	);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.УстановитьПараметр("ИсключаемыеТипы", ИсключаемыеТипы);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат Результат;	
	
КонецФункции

Функция СчетаНаОплату_ИсключаемыеТипыСвязей()
	
	Результат = Новый Массив;
	Результат.Добавить(Тип("СправочникСсылка.ОбъектыРасчетов"));
	
