Функция УПД970_ТекстЗапросаТабличныхДанныхВыкупТоваровХранителем()
	
	Результат =
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ТаблицаТоваров.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ТаблицаТоваров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаТоваров.ВариантПредставленияНабора КАК ВариантПредставленияНабора,
	|	ТаблицаТоваров.ЭтоКомплектующие КАК ЭтоКомплектующие,
	|	ТаблицаТоваров.ЭтоНабор КАК ЭтоНабор,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Номенклатура.ТипНоменклатуры КАК НоменклатураТип,
	|	&НаименованиеНоменклатуры КАК НоменклатураНаименование,
	|	&КодТовараУслуги КАК НоменклатураКод,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ &ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ &НаименованиеЕдиницыИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Код
	|		ИНАЧЕ &КодЕдиницыИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	&НаименованиеЕдИзмТНВЭД КАК ЕдиницаИзмеренияТНВЭДНаименование,
	|	&КодЕдИзмТНВЭД          КАК ЕдиницаИзмеренияТНВЭДКод,
	|	НЕОПРЕДЕЛЕНО КАК КодТНВЭД,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Характеристика.НаименованиеПолное КАК ХарактеристикаНаименование,
	|	ТаблицаТоваров.Серия.Наименование КАК СерияНаименование,
	|	ТаблицаТоваров.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаТоваров.НомерГТД КАК НомерГТДСсылка,
	|	&ТипНомераГТД КАК ТипНомераГТД,
	|	ТаблицаТоваров.НомерГТД КАК НомерГТД,
	|	ТаблицаТоваров.НомерГТД.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаТоваров.НомерГТД.СтранаПроисхождения.Код КАК СтранаПроисхожденияКод,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Количество
	|		ИНАЧЕ ТаблицаТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК Количество,
	|	ТаблицаТоваров.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
	|	ВЫБОР
	|		КОГДА НЕ &ВыводитьБазовыеЕдиницыИзмерения ТОГДА
	|			ВЫБОР
	|				КОГДА ТаблицаТоваров.КоличествоУпаковок = 0
	|					ТОГДА 0
	|				ИНАЧЕ (ТаблицаТоваров.СуммаБезНДС + ТаблицаТоваров.СуммаНДС) / ТаблицаТоваров.КоличествоУпаковок
	|			КОНЕЦ
	|		ИНАЧЕ ТаблицаТоваров.Цена
	|	КОНЕЦ КАК Цена,
	|	ТаблицаТоваров.СуммаБезНДС КАК СуммаБезНДС,
	|	ТаблицаТоваров.СуммаНДС КАК СуммаНДС,
	|	ТаблицаТоваров.СуммаБезНДС + ТаблицаТоваров.СуммаНДС КАК СуммаСНДС,
	|	ТаблицаТоваров.СуммаБезНДСРуб КАК СуммаБезНДСРуб,
	|	ТаблицаТоваров.СуммаНДСРуб КАК СуммаНДСРуб,
	|	ТаблицаТоваров.СуммаБезНДСРуб + ТаблицаТоваров.СуммаНДСРуб КАК СуммаСНДСРуб,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВыкупТоваровХранителемТаблицаТоваров КАК ТаблицаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТабличнойЧасти,
	|	НомерСтроки";
	
	ТекстЗапроса_ЗаполнитьВыражениеСКодомТовараУслуги(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСЕдиницейИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСКодомЕдиницыИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСНаименованиемЕдиницыИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСНаименованиемНоменклатуры(Результат);
	
	УПД970_ЗаполнитьВТекстеЗапросаПараметрыЕдиницыИзмеренияТНВЭД(Результат);
	УПД970_ЗаполнитьВТекстеЗапросаПараметрСТипомНомераГТД(Результат);

	Возврат Результат;
	
