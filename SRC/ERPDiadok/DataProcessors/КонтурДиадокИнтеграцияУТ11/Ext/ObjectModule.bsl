// Поиск документа из 1С, соответствующего электронному документу в ДД
Функция НайтиСопоставлениеДокумента(Параметры)
	
	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Nayti_Sopostavleniye_Dokumenta.html
	
	Документ = Параметры.Документ;
	
	ТипДокумента = Документ.Тип;
	ФункцияДокумента = Документ.Тип.ФункцияДокумента;
	
	Если ОсновнойМодуль.ЭтоАгентскиеФункцииУПДУКД(ФункцияДокумента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Идентификаторы = ОсновнойМодуль.ЭДО_Новый_ИдентификаторыСправочника(
			Документ.Получатель.ОрганизацияЭДО, 
			Документ.Получатель.BoxId);
	СопоставленныеОрганизации1С = ОсновнойМодуль.ЭДО_Организации_СопоставленныеВ1С(Идентификаторы);
	
	Идентификаторы = ОсновнойМодуль.ЭДО_Новый_ИдентификаторыСправочника(
			Документ.Отправитель.ОрганизацияЭДО, 
			Документ.Отправитель.BoxId);
	СопоставленныеКонтрагенты1С = ОсновнойМодуль.ЭДО_Контрагенты_СопоставленныеВ1С(Идентификаторы);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Организация", СопоставленныеОрганизации1С);
	ПараметрыОтбора.Вставить("Контрагент",	СопоставленныеКонтрагенты1С);
	ПараметрыОтбора.Вставить("ДатаДокумента",	Документ.Реквизиты.Дата);
	ПараметрыОтбора.Вставить("НомерДокумента",	Документ.Реквизиты.Номер);
	
	Если ОсновнойМодуль.ЭтоУниверсальныйПередаточныйДокумент(ТипДокумента)
		ИЛИ ОсновнойМодуль.ЭтоПередаточныйДокумент(ТипДокумента) Тогда
		
		Результат = ПолучитьДокументы1С(ПараметрыОтбора, "ПриобретениеТоваровУслуг");
		
		Если Результат = Неопределено Тогда
			Результат = ПолучитьДокументы1С(ПараметрыОтбора, "ПриобретениеУслугПрочихАктивов");
		КонецЕсли;
		
	ИначеЕсли ОсновнойМодуль.ЭтоСчетФактура(ТипДокумента) Тогда
		
		Результат = ПолучитьДокументы1С(ПараметрыОтбора, "СчетФактураПолученный");
		
	ИначеЕсли ОсновнойМодуль.ЭтоУниверсальныйКорректировочныйДокумент(ТипДокумента)
		ИЛИ ОсновнойМодуль.ЭтоКорректировочныйДокумент(ТипДокумента) Тогда
		
		Результат = ПолучитьДокументы1С(ПараметрыОтбора, "КорректировкаПриобретения");
		
	ИначеЕсли ОсновнойМодуль.ЭтоКорректировочныйСчетФактура(ТипДокумента) Тогда
		
		Результат = ПолучитьДокументы1С(ПараметрыОтбора, "СчетФактураПолученный");
		
	ИначеЕсли ОсновнойМодуль.ЭтоАктОРасхождениях(ТипДокумента) Тогда
		
		Результат = ПолучитьДокументы1С(ПараметрыОтбора, "АктОРасхожденияхПослеОтгрузки");
		
	ИначеЕсли ЭтоФормализованныйАктСверки405(ТипДокумента) Тогда
		
		Организация = Документ.Получатель.Организация;
		Контрагент = Документ.Отправитель.Организация;
		НачалоПериодаСверки = Общее_СтрокаВДату(Документ.Метаданные.BeginDate);
		ОкончаниеПериодаСверки = Общее_СтрокаВДату(Документ.Метаданные.EndDate);
		
		Результат = НайтиСверкуВзаиморасчетов(
			Организация,
			Контрагент,
			НачалоПериодаСверки,
			ОкончаниеПериодаСверки
		);
		
	ИначеЕсли ТипДокумента = "ProformaInvoice"
		Или НРег(ТипДокумента) = НРег("XmlInvoiceOffer")
		Или НРег(ТипДокумента) = НРег("XmlProformaInvoice") Тогда
		
		Результат = ПолучитьДокументы1С(ПараметрыОтбора, "ЗаказПоставщику");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоФормализованныйАктСверки405(ТипЭД)
	
	Результат = НРег(ТипЭД.ТипДокумента) = НРег("ReconciliationAct")
				И НРег(ТипЭД.ТипКонтента) = НРег("reconciliationact405");
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСверкуВзаиморасчетов(Организация, Контрагент, НачалоПериодаСверки, ОкончаниеПериодаСверки)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_НайтиСверкуВзаиморасчетов();
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаСверки);
	Запрос.УстановитьПараметр("КонецПериода", ОкончаниеПериодаСверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_НайтиСверкуВзаиморасчетов()
	
	ИмяТаблицыМетаданных = "СверкаВзаиморасчетов";
	
	Если ИспользуетсяСверкаВзаиморасчетов2_5_11() Тогда
		ИмяТаблицыМетаданных = "СверкаВзаиморасчетов2_5_11";
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДокумент.Ссылка КАК Ссылка
	|ИЗ
	|	&ИмяТаблицыМетаданных КАК ТаблицаДокумент
	|ГДЕ
	|	НЕ ТаблицаДокумент.ПометкаУдаления
	|	И ТаблицаДокумент.Организация = &Организация
	|	И ТаблицаДокумент.Контрагент = &Контрагент
	|	И ТаблицаДокумент.НачалоПериода = &НачалоПериода
	|	И ТаблицаДокумент.КонецПериода = &КонецПериода";
	
	Результат = СтрЗаменить(Результат, "&ИмяТаблицыМетаданных", "Документ." + ИмяТаблицыМетаданных);
	
	Возврат Результат;
	
КонецФункции

