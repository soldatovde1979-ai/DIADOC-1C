Процедура Счет29_ЗаполнитьСведенияОГрузоотправителе(
	Shipper,
	Грузоотправитель,
	ДатаСведений,
	БанковскийСчет,
	КПППоставщика = "")

	Если Не ЗначениеЗаполнено(Грузоотправитель) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыГрузоотправителя = УПД970_ДанныеУчастникаЭДО(Грузоотправитель, ДатаСведений, БанковскийСчет);
	
	Если ЗначениеЗаполнено(КПППоставщика) Тогда
		РеквизитыГрузоотправителя.Вставить("КПП", КПППоставщика);
	КонецЕсли;
	
	ФактАдрес = СведенияОФактическомАдресеОбъекта(Грузоотправитель, ДатаСведений);
	
	Shipper = Счет29_НовыйOrganizationInfo(РеквизитыГрузоотправителя, ФактАдрес);
	
КонецПроцедуры

Процедура Счет29_ЗаполнитьСведенияОГрузополучателе(
	Consignee,
	Грузополучатель,
	ДатаСведений,
	БанковскийСчет,
	АдресДоставки,
	АдресДоставкиЗначение)
	
	Перем ФактАдрес;
	
	Если Не ЗначениеЗаполнено(Грузополучатель) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыГрузополучателя = УПД970_ДанныеУчастникаЭДО(Грузополучатель, ДатаСведений, БанковскийСчет);
	
	ИспользоватьАдресДоставкиИзДокумента = АдресГрузополучателяБратьИзАдресаДоставки();
	Если ИспользоватьАдресДоставкиИзДокумента Тогда
		ФактАдрес = УПД970_СведенияОбАдресеДоставки(АдресДоставки, АдресДоставкиЗначение);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФактАдрес) Тогда
		ФактАдрес = СведенияОФактическомАдресеОбъекта(Грузополучатель, ДатаСведений);
	КонецЕсли;
	
	Consignee = Счет29_НовыйOrganizationInfo(РеквизитыГрузополучателя, ФактАдрес);
	
КонецПроцедуры

