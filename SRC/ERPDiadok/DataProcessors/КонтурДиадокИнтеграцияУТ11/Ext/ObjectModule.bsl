#КонецОбласти

Функция Счет29_ТекстНазначенияПлатежа(НомерДокумента, ДатаДокумента)
	
	Результат = СтрШаблон("Оплата по счету %1 от %2", НомерДокумента, Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"));
	Возврат Результат;
	
КонецФункции

Функция Счет29_ОграничениеПоСрокуОплаты(ГрафикПлатежей)

	Результат = Дата(1, 1, 1);
	
	Если ЗначениеЗаполнено(ГрафикПлатежей) Тогда
		
		ГрафикПлатежей.Сортировать("ДатаПлатежа УБЫВ");
		Результат = ГрафикПлатежей[0].ДатаПлатежа;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Счет29_ВычислитьКоличествоПоСтроке(СтрокаТаблицы, Разрядность)
	
	ЭтоУслугиИлиРабота = (СтрокаТаблицы.НоменклатураТип = Перечисления.ТипыНоменклатуры.Услуга
		Или СтрокаТаблицы.НоменклатураТип = Перечисления.ТипыНоменклатуры.Работа);
	
	ЗаполнитьКоличествомПоУмолчанию = ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения)
		И ЭтоУслугиИлиРабота;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
		Результат = Окр(СтрокаТаблицы.Количество, Разрядность);
	ИначеЕсли ЗаполнитьКоличествомПоУмолчанию Тогда
		Результат = 1;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбщиеТекстыЗапросов

Функция ТекстЗапроса_ОбщиеДанныеДокумента(ИмяДокумента)

	Результат =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	&ВалютаРеглУчета КАК Валюта,
	|	ДанныеДокумента.Организация КАК Организация,
	|	&Подразделение КАК Подразделение,
	|	&Склад КАК Склад,
	|	ДанныеДокумента.Дата КАК Период
	|
	|ПОМЕСТИТЬ ТаблицаДанныхДокументов
	|ИЗ
	|	//ПОЛНОЕ_ИМЯ_ДОКУМЕНТА КАК ДанныеДокумента
	|
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка";
	
	МетаданныеДокумента = Метаданные.Документы[ИмяДокумента];
	
	Если ЕстьРеквизитОбъектаЛок("Валюта", МетаданныеДокумента) Тогда
		ТекстЗамены = "ДанныеДокумента.Валюта";
		Результат = СтрЗаменить(Результат, "&ВалютаРеглУчета", ТекстЗамены);
	КонецЕсли;
	
	Если ЕстьРеквизитОбъектаЛок("Склад", МетаданныеДокумента) Тогда
		ТекстЗамены = "ДанныеДокумента.Склад";
	Иначе
		ТекстЗамены = "ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&Склад", ТекстЗамены);
	
	Если ЕстьРеквизитОбъектаЛок("Подразделение", МетаданныеДокумента) Тогда
		ТекстЗамены = "ДанныеДокумента.Подразделение";
	Иначе
		ТекстЗамены = "ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";
	КонецЕсли;
	Результат = СтрЗаменить(Результат, "&Подразделение", ТекстЗамены);
	
	ПолноеИмяДокумента = "Документ." + ИмяДокумента;
	Результат = СтрЗаменить(Результат, "//ПОЛНОЕ_ИМЯ_ДОКУМЕНТА", ПолноеИмяДокумента);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ВременнаяТаблицаДанныхПодразделенийНаДатуДокумента()

	Результат =
	"ВЫБРАТЬ
	|	ТаблицаДанныхДокумента.Ссылка                 КАК Ссылка,
	|	ДанныеРегистрацийОрганизаций.Подразделение    КАК Подразделение,
	|	ДанныеРегистрацийОрганизаций.Организация      КАК Организация,
	|	МАКСИМУМ(ДанныеРегистрацийОрганизаций.Период) КАК Период
	|ПОМЕСТИТЬ МаксимумыДанныхПодразделений
	|ИЗ
	|	РегистрСведений.РегистрацииВНалоговомОргане КАК ДанныеРегистрацийОрганизаций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|		ПО ДанныеРегистрацийОрганизаций.Подразделение = ТаблицаДанныхДокумента.Склад.Подразделение
	|			И ДанныеРегистрацийОрганизаций.Организация = ТаблицаДанныхДокумента.Организация
	|			И ДанныеРегистрацийОрганизаций.Период <= ТаблицаДанныхДокумента.Период
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ПО ДанныеРегистрацийОрганизаций.РегистрацияВНалоговомОргане = РегистрацииВНалоговомОргане.Ссылка
	|			И (РегистрацииВНалоговомОргане.ДатаСнятияСУчета > ДанныеРегистрацийОрганизаций.Период
	|			ИЛИ РегистрацииВНалоговомОргане.ДатаСнятияСУчета = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ГДЕ
	|	ДанныеРегистрацийОрганизаций.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДанныхДокумента.Ссылка,
	|	ДанныеРегистрацийОрганизаций.Подразделение,
	|	ДанныеРегистрацийОрганизаций.Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаДанныхДокумента.Ссылка                 КАК Ссылка,
	|	ДанныеРегистрацийОрганизаций.Подразделение    КАК Подразделение,
	|	ДанныеРегистрацийОрганизаций.Организация      КАК Организация,
	|	МАКСИМУМ(ДанныеРегистрацийОрганизаций.Период) КАК Период
	|ИЗ
	|	РегистрСведений.РегистрацииВНалоговомОргане КАК ДанныеРегистрацийОрганизаций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|		ПО ДанныеРегистрацийОрганизаций.Подразделение = ТаблицаДанныхДокумента.Подразделение
	|		И ДанныеРегистрацийОрганизаций.Организация = ТаблицаДанныхДокумента.Организация
	|		И ДанныеРегистрацийОрганизаций.Период <= ТаблицаДанныхДокумента.Период
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ПО ДанныеРегистрацийОрганизаций.РегистрацияВНалоговомОргане = РегистрацииВНалоговомОргане.Ссылка
	|		И (РегистрацииВНалоговомОргане.ДатаСнятияСУчета > ДанныеРегистрацийОрганизаций.Период
	|		ИЛИ РегистрацииВНалоговомОргане.ДатаСнятияСУчета = ДАТАВРЕМЯ(1, 1, 1))
	|
	|ГДЕ
	|	ДанныеРегистрацийОрганизаций.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДанныхДокумента.Ссылка,
	|	ДанныеРегистрацийОрганизаций.Подразделение,
	|	ДанныеРегистрацийОрганизаций.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение,
	|	Организация,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	МаксимумыДанныхПодразделений.Ссылка                     КАК Ссылка,
	|	РегистрацииВНалоговомОргане.Подразделение               КАК Подразделение,
	|	РегистрацииВНалоговомОргане.Организация                 КАК Организация,
	|	РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
	|ПОМЕСТИТЬ ДанныеПодразделенийПредварительная
	|ИЗ
	|	РегистрСведений.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксимумыДанныхПодразделений КАК МаксимумыДанныхПодразделений
	|		ПО (РегистрацииВНалоговомОргане.Подразделение = МаксимумыДанныхПодразделений.Подразделение
	|		И РегистрацииВНалоговомОргане.Организация = МаксимумыДанныхПодразделений.Организация
	|		И РегистрацииВНалоговомОргане.Период = МаксимумыДанныхПодразделений.Период)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Подразделение,
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПодразделений.Ссылка                                         КАК Ссылка,
	|	ДанныеПодразделений.Подразделение                                  КАК Подразделение,
	|	ДанныеПодразделений.Организация                                    КАК Организация,
	|	ДанныеПодразделений.РегистрацияВНалоговомОргане                    КАК РегистрацияВНалоговомОргане,
	|	ЕСТЬNULL(РегистрацииВНалоговомОргане.НаименованиеОбособленногоПодразделения, """") КАК НаименованиеОбособленногоПодразделения,
