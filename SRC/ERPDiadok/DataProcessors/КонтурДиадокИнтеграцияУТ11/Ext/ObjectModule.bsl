Функция СчетаНаОплату_СвязанныеДокументы(ОснованиеЭлектронногоСчета) Экспорт
	
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета) Тогда
		
		Результат = СчетаНаОплату_СвязиПоСчетуНаОплату(ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоЗаказКлиента(ОснованиеЭлектронногоСчета) Тогда
		
		Результат = СчетаНаОплату_СвязиПоЗаказуКлиента(ОснованиеЭлектронногоСчета);
		Результат.Добавить(ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеЭлектронногоСчета) Тогда
		
		Результат = СчетаНаОплату_СвязиПоДокументуПродажи(ОснованиеЭлектронногоСчета);
		Результат.Добавить(ОснованиеЭлектронногоСчета);
		
	Иначе
		
		Результат = Новый Массив;
		
	КонецЕсли;
		
	Возврат Результат;
		
КонецФункции 

Функция СчетаНаОплату_СвязиПоСчетуНаОплату(СчетНаОплату)
	
	ОснованиеСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетНаОплату, "ДокументОснование");
	
	Результат = Новый Массив;
	Результат.Добавить(ОснованиеСчета);
	
	Если ЭтоЗаказКлиента(ОснованиеСчета) Тогда
		
		ВторичныеСвязи = СчетаНаОплату_СвязиПоЗаказуКлиента(ОснованиеСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеСчета) Тогда
		
		ВторичныеСвязи = СчетаНаОплату_СвязиПоДокументуПродажи(ОснованиеСчета);
		
	Иначе
		
		ВторичныеСвязи = Новый Массив;
		
	КонецЕсли;
	
	Общее_ДополнитьМассив(Результат, ВторичныеСвязи);
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_СвязиПоДокументуПродажи(ДокументПродажи)
	
	Результат = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|ГДЕ
	|	СчетФактураВыданныйДокументыОснования.ДокументОснование = &ДокументПродажи
	|	И НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СчетФактураКомиссионеру.Ссылка
	|ИЗ
	|	Документ.СчетФактураКомиссионеру КАК СчетФактураКомиссионеру
	|ГДЕ
	|	СчетФактураКомиссионеру.ДокументОснование = &ДокументПродажи
	|	И НЕ СчетФактураКомиссионеру.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДокументПродажи", ДокументПродажи);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	Результат = ТаблицаРезультата.ВыгрузитьКолонку(0);
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_СвязиПоЗаказуКлиента(ЗаказКлиента)
	
	Результат = Новый Массив;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслугШапка.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_СвязанныеПервичныеДокументы
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслугШапка
	|ГДЕ
	|	РеализацияТоваровУслугШапка.ЗаказКлиента = &ЗаказКлиента
	|	И НЕ РеализацияТоваровУслугШапка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.ЗаказКлиента = &ЗаказКлиента
	|	И НЕ РеализацияТоваровУслугТовары.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АктВыполненныхРабот.Ссылка
	|ИЗ
	|	Документ.АктВыполненныхРабот КАК АктВыполненныхРабот
	|ГДЕ
	|	АктВыполненныхРабот.ЗаказКлиента = &ЗаказКлиента
	|	И НЕ АктВыполненныхРабот.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	АктВыполненныхРаботУслуги.Ссылка
	|ИЗ
	|	Документ.АктВыполненныхРабот.Услуги КАК АктВыполненныхРаботУслуги
	|ГДЕ
	|	НЕ АктВыполненныхРаботУслуги.Ссылка.ПометкаУдаления
	|	И АктВыполненныхРаботУслуги.ЗаказКлиента = &ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетФактураВыданныйДокументыОснования.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_СвязанныеПервичныеДокументы КАК СвязанныеПервичныеДокументы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.ДокументыОснования КАК СчетФактураВыданныйДокументыОснования
	|		ПО СвязанныеПервичныеДокументы.Ссылка = СчетФактураВыданныйДокументыОснования.ДокументОснование
	|ГДЕ
	|	НЕ СчетФактураВыданныйДокументыОснования.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СвязанныеДокументы.Ссылка
	|ИЗ
	|	ВТ_СвязанныеПервичныеДокументы КАК СвязанныеДокументы";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	Результат = ТаблицаРезультата.ВыгрузитьКолонку(0);
	
	Возврат Результат;
	
КонецФункции

// Процедура - При получении оснований документа учета
//
// Параметры:
//  КоллекцияОснований	 - Массив - Коллекция для заполнения документами основания
//  ДокументУчета		 - ДокументСсылка - Ссылка на документ учета по которому выбираются документы основания
//
Процедура ПриПолученииОснованийДокументаУчета(КоллекцияОснований, ДокументУчета) Экспорт
	
	Если НЕ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	КоллекцияОснований = ДокументыОснованияСчетаФактуры(ДокументУчета);
	
КонецПроцедуры

Функция АктСверки405_ИнформацияПолучателя(ДокСсылка, ПараметрыФормирования) Экспорт
	
	Результат = Новый_ReconciliationActRecipientTitle();
	
	Если НЕ АктСверки405_ПроверитьВозможностьФормированияОтветногоТитула(Результат, ДокСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Запрос.Текст = ТекстЗапроса_ДанныеШапкиАктаСверкиВзаиморасчетов();
	
	ДанныеШапки = Запрос.Выполнить().Выгрузить();
	ДанныеШапки = ДанныеШапки[0];
	
	ЕстьРасхождения = ДанныеШапки.Статус = Перечисления.СтатусыСверокВзаиморасчетов2_5_11.СверенаСРазногласиями;
	
	Если ЕстьРасхождения Тогда
		Результат.SignDisagreement = "WithDisagreements";
	Иначе
		Результат.SignDisagreement = "WithoutDisagreements";
	КонецЕсли;
	
	ЗаполнитьТаблицуОтветногоТитулаАктаСверки = ПараметрыФормирования.ЗаполнитьТаблицуОтветногоТитулаАктаСверки;
	
	Если ЗаполнитьТаблицуОтветногоТитулаАктаСверки Тогда
		
		Запрос.Текст = ТекстЗапроса_ДанныеТабличныхЧастейАктаСверкиВзаиморасчетов();
		ВыборкаДанныхТЧ = Запрос.Выполнить().Выбрать();
		
		Результат.ReconciliationAct = Новый_RecipientData_ReconciliationAct();
		
		АктСверки405_ЗаполнитьТабличнуюЧастьОтветногоТитула(
			Результат,
			ВыборкаДанныхТЧ
		);
		
		АктСверки405_ЗаполнитьИтогиТабличнойЧастиОтветногоТитула(
			Результат,
			ДанныеШапки
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки405_ИнформацияОтправителя(ДокСсылка) Экспорт
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ДокСсылка);
	ПараметрыПечати = Новый Структура();
	
	Если НЕ ИспользуетсяСверкаВзаиморасчетов2_5_11() Тогда
		
		ТекстОшибки = НСтр("ru='Текущая версия конфигурации не поддерживает работу с актом сверки в формате 405@'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ДанныеПечати = Документы.СверкаВзаиморасчетов2_5_11.ПолучитьДанныеДляПечатнойФормыУПД(ПараметрыПечати, МассивОбъектов);
	ВыборкаШапка = ДанныеПечати.РезультатПоШапке.Выбрать();
	ВыборкаШапка.Следующий();
	
	Результат = Новый_ReconciliationActSenderTitle();
	
	АктСверки405_ПроверитьВозможностьОтправки(Результат, ДокСсылка);
	
	АктСверки405_ЗаполнитьШапкуТитулаОтправителя(
		Результат,
		ВыборкаШапка
	);
	
	АктСверки405_ЗаполнитьРеквизитыОтправителя(
		Результат,
		ВыборкаШапка.Отправитель,
		ВыборкаШапка.ДатаДокумента
	);
	
	АктСверки405_ЗаполнитьРеквизитыПолучателя(
		Результат,
		ВыборкаШапка.Получатель,
		ВыборкаШапка.ДатаДокумента
	);
	
	ВыборкаПоДоговорам = ДанныеПечати.РезультатПоТабличнойЧасти.Выбрать();
	
	АктСверки405_ПроверитьОборотыЗаПериодСверки(Результат, ВыборкаПоДоговорам, ДокСсылка);
	
	АктСверки405_ЗаполнитьТабличнуюЧастьТитулаОтправителя(
		Результат,
		ВыборкаПоДоговорам
	);
	
	АктСверки405_ЗаполнитьИтогиПоТабличнойЧастиТитулаОтправителя(
		Результат,
		ВыборкаШапка
	);
	
	АктСверки405_ЗаполнитьПодписанта(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция СчетаНаОплату_ПечатнаяФорма1С(ДокСсылка) Экспорт
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(ДокСсылка);
	
	СтруктураТипов = Новый Соответствие;
	СтруктураТипов.Вставить(ДокСсылка.Метаданные().ПолноеИмя(), ДокументПечати);
	
	ОбъектыПечати = Новый СписокЗначений;
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	Результат = Обработки.ПечатьСчетовНаОплату.СформироватьПечатнуюФормуСчетНаОплату(
		СтруктураТипов,
		ОбъектыПечати,
		ПараметрыПечати
	);
	
	Возврат Результат;
	
КонецФункции

// Заполняет модель данных электронного счета на оплату.
//
// Параметры:
//	Шапка - Контракт шапки неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ШапкаСчетаНаОплату())
//  ТабличнаяЧасть - Контракт табличной части неформализованного счета на оплату по форме ДД (см. МенеджерИнтеграции.Новый_ТабличнаяЧастьСчетаНаОплату() 
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - Основание электронного счета
//
Процедура СчетаНаОплату_ЗаполнитьДанные(МодельШапка, МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета) Экспорт
	
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьШапкуПоУмолчанию(МодельШапка, ОснованиеЭлектронногоСчета);
		СчетаНаОплату_ЗаполнитьТабличнуюЧасть_СчетНаОплатуПокупателю(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоЗаказКлиента(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьШапкуПоУмолчанию(МодельШапка, ОснованиеЭлектронногоСчета);
		СчетаНаОплату_ЗаполнитьТабличнуюЧастьПоУмолчанию(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	ИначеЕсли ЭтоДокументПродажи(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьДанные_ШапкаДокументПродажи(МодельШапка, ОснованиеЭлектронногоСчета);
		СчетаНаОплату_ЗаполнитьТабличнуюЧасть_ДокументПродажи(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ОснованиеЭлектронногоСчета));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьТабличнуюЧасть_СчетНаОплатуПокупателю(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	Если ЭтоЧастичнаяОплатаСчета(ОснованиеЭлектронногоСчета) Тогда
		
		СчетаНаОплату_ЗаполнитьТабличнуюЧасть_ЧастичнаяОплатаСчета(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		СчетаНаОплату_ЗаполнитьТабличнуюЧастьПоУмолчанию(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьТабличнуюЧасть_ЧастичнаяОплатаСчета(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	ПараметрыПечати = Неопределено;
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ОснованиеЭлектронногоСчета);
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОснованиеЭлектронногоСчета);
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(
		ПараметрыПечати,
		МассивОбъектов
	);
	
	ДанныеШапки = СтруктураДанныхДляПечати.РезультатПоШапке.Выбрать();
	ТаблицаТовары = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выгрузить();
	ЭтапыОплаты = СтруктураДанныхДляПечати.РезультатПоЭтапамОплаты.Выгрузить();
	ДанныеШапки.Следующий();
	
	НоваяСтрока = МодельТабличнаяЧасть.Добавить();
	НоваяСтрока.Номенклатура = ДанныеШапки.ДокументОснование;
	НоваяСтрока.НоменклатураПредставление = ДанныеШапки.НазначениеПлатежа;
	НоваяСтрока.Сумма = ЭтапыОплаты.Итог("СуммаПлатежа");
	
	ЭтапыЗалоговойТары = ЭтапыОплаты.НайтиСтроки(Новый Структура("ЭтоЗалогЗаТару", Истина));
	ТолькоЗалогЗаТару = ЭтапыЗалоговойТары.Количество() = ЭтапыОплаты.Количество() И ЭтапыЗалоговойТары.Количество() > 0;
	
	Если ДанныеШапки.УчитыватьНДС И
		НЕ ТолькоЗалогЗаТару
		И НЕ ДанныеШапки.ОперацияОблагаетсяНДСУПокупателя Тогда
		
		НоваяСтрока.СуммаНДС = СчетНаОплату_СуммаНДСЧастичнаяОплатаСчета(ДанныеШапки, ТаблицаТовары);
		
	КонецЕсли;
	
КонецПроцедуры

Функция СчетНаОплату_СуммаНДСЧастичнаяОплатаСчета(ДанныеШапки, ТаблицаТовары)
	
	Результат = 0;
	
	ИспользоватьНаборы = Ложь;
	Если ТаблицаТовары.Колонки.Найти("ЭтоНабор") <> Неопределено Тогда
		ИспользоватьНаборы = Истина;
	КонецЕсли;
	
	СоответствиеСтавокНДС = Новый Соответствие;
	
	Если ТаблицаТовары.Количество() = 0 Тогда
		
		Если ЗначениеЗаполнено(ДанныеШапки.СтавкаНДС) Тогда
			
			СуммаНДС = ДанныеШапки.СуммаНДС;
			СоответствиеСтавокНДС.Вставить(ДанныеШапки.СтавкаНДС, СуммаНДС);
			
		КонецЕсли;
		
	Иначе
		
		Для Каждого СтрокаТовара Из ТаблицаТовары Цикл
			
			Если ИспользоватьНаборы И СтрокаТовара.ЭтоНабор
				И Не (СтрокаТовара.ВариантПредставленияНабораВПечатныхФормах = 
					Перечисления.ВариантыПредставленияНаборовВПечатныхФормах.ТолькоНабор) Тогда
				// Исключаем суммы НДС по набору в целом, когда комплектующие выводятся в печатных формах.
				Продолжить;
			КонецЕсли;
			
			СуммаНДС = СоответствиеСтавокНДС[СтрокаТовара.СтавкаНДС];
			
			Если СуммаНДС = Неопределено Тогда
				СуммаНДС = СтрокаТовара.СуммаНДС;
			Иначе
				СуммаНДС = СуммаНДС + СтрокаТовара.СуммаНДС;
			КонецЕсли;
			
			СоответствиеСтавокНДС.Вставить(СтрокаТовара.СтавкаНДС, СуммаНДС);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если СоответствиеСтавокНДС.Количество() > 0 Тогда
		
		Для Каждого ТекСтавкаНДС Из СоответствиеСтавокНДС Цикл
			
			Если ЗначениеЗаполнено(ТекСтавкаНДС.Значение) Тогда
				Результат = Результат + ТекСтавкаНДС.Значение / 100 * ДанныеШапки.ПроцентОплаты;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СчетаНаОплату_ЗаполнитьДанные_ШапкаДокументПродажи(МодельШапка, ОснованиеЭлектронногоСчета)
	
	Если ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		СчетаНаОплату_ЗаполнитьШапку_ОтчетКомитенту(МодельШапка, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		СчетаНаОплату_ЗаполнитьШапкуПоУмолчанию(МодельШапка, ОснованиеЭлектронногоСчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьТабличнуюЧасть_ДокументПродажи(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	Если ТипЗнч(ОснованиеЭлектронногоСчета) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		СчетаНаОплату_ЗаполнитьТабличнуюЧасть_ОтчетКомитенту(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	Иначе
		
		СчетаНаОплату_ЗаполнитьТабличнуюЧастьПоУмолчанию(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьШапку_ОтчетКомитенту(МодельШапка, ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокСсылка", ОснованиеЭлектронногоСчета);
	Запрос.Текст = ТекстЗапроса_ДанныеДокументаОтчетКомитенту();
	
	ДанныеДокумента = Запрос.Выполнить().Выбрать();
	ДанныеДокумента.Следующий();
	
	НомерДокумента = ПредставлениеНомера(ДанныеДокумента.Номер);
	ДатаДокумента = ДанныеДокумента.Дата;
	БанковскийСчет = ДанныеДокумента.БанковскийСчет;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеДокумента.Организация, ДатаДокумента, БанковскийСчет);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеДокумента.Контрагент, ДатаДокумента);
	
	ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	
	ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	
	ЗаголовокСчета = СтрШаблон(
		"Счет на оплату № %1 от %2",
		НомерДокумента,
		Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")
	);
	
	ОблагаетсяНДСУПокупателя = (ДанныеДокумента.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя);
	УчитыватьНДС = (ДанныеДокумента.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	
	МодельШапка.Заголовок = ЗаголовокСчета;
	МодельШапка.Продавец = ДанныеДокумента.Организация;
	МодельШапка.ПродавецПредставление = ПродавецПредставление;
	МодельШапка.ПродавецОписание = ПродавецОписание;
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	МодельШапка.Покупатель = ДанныеДокумента.Контрагент;
	МодельШапка.ПокупательПредставление = ПокупательПредставление;
	МодельШапка.ПокупательОписание = ПокупательОписание;
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.ЦенаВключаетНДС = Истина;
	МодельШапка.ОблагаетсяНДСУПокупателя = ОблагаетсяНДСУПокупателя;
	МодельШапка.Валюта = ДанныеДокумента.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеДокумента.Валюта);
	МодельШапка.УчитыватьНДС = УчитыватьНДС;
	
	ЕстьБанковскийСчет = ЗначениеЗаполнено(ДанныеДокумента.БанковскийСчет);
	
	Если ЕстьБанковскийСчет Тогда
		
		ВыбратьРазрешенные = Истина;
		
		НаименованиеБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			БанковскийСчет.Банк,
			"Наименование",
			ВыбратьРазрешенные
		);
		
		МодельШапка.ПродавецБанк = СведенияОбОрганизации.Банк;
		МодельШапка.ПродавецБанкБИК = СведенияОбОрганизации.БИК;
		МодельШапка.ПродавецБанкПредставление = НаименованиеБанка;
		МодельШапка.ПродавецБанковскийСчет = БанковскийСчет;
		МодельШапка.ПродавецБанковскийСчетНомер = СведенияОбОрганизации.НомерСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = СведенияОбОрганизации.КоррСчет;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьТабличнуюЧасть_ОтчетКомитенту(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокСсылка", ОснованиеЭлектронногоСчета);
	Запрос.Текст = ТекстЗапроса_ДанныеДокументаОтчетКомитенту();
	
	ДанныеДокумента = Запрос.Выполнить().Выбрать();
	ДанныеДокумента.Следующий();
	
	НоваяСтрока = МодельТабличнаяЧасть.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеДокумента);
	
	НоваяСтрока.НоменклатураПредставление = ДанныеДокумента.НаименованиеПолное;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.Номенклатура) Тогда
		НоваяСтрока.НоменклатураАртикул = АртикулНоменклатуры(ДанныеДокумента.Номенклатура);
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьШапкуПоУмолчанию(МодельШапка, ОснованиеЭлектронногоСчета)
	
	ПараметрыПечати = Неопределено;
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ОснованиеЭлектронногоСчета);
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОснованиеЭлектронногоСчета);
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(
		ПараметрыПечати,
		МассивОбъектов
	);
	
	ДанныеШапки = СтруктураДанныхДляПечати.РезультатПоШапке.Выбрать();
	ДанныеШапки.Следующий();
	
	НомерДокумента = ПредставлениеНомера(ОснованиеЭлектронногоСчета.Номер);
	ДатаДокумента = ОснованиеЭлектронногоСчета.Дата;
	
	СведенияОбОрганизации = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Организация, ДатаДокумента);
	СведенияОКонтрагенте = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Контрагент, ДатаДокумента);
	СведенияОГрузоотправителе = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Грузоотправитель, ДатаДокумента);
	СведенияОГрузополучателе = СчетаНаОплату_ДанныеЮрФизЛица(ДанныеШапки.Грузополучатель, ДатаДокумента);
	
	ПродавецПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОбОрганизации);
	ПокупательПредставление = СчетаНаОплату_ПредставлениеЮрФизЛица(СведенияОКонтрагенте);
	
	ПродавецОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОбОрганизации);
	ПокупательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОКонтрагенте);
	ГрузоотправительОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОГрузоотправителе);
	ГрузополучательОписание = СчетаНаОплату_СтрокаРеквизитыЮрФизЛица(СведенияОГрузополучателе);
	
	ЗаголовокСчета = СтрШаблон(
		"Счет на оплату № %1 от %2",
		НомерДокумента,
		Формат(ДатаДокумента, "ДФ=dd.MM.yyyy")
	);
	
	ЦенаВключаетНДС = ДанныеШапки.ЦенаВключаетНДС;
	Если ЭтоСчетНаОплатуПокупателю(ОснованиеЭлектронногоСчета)
		И ЭтоЧастичнаяОплатаСчета(ОснованиеЭлектронногоСчета) Тогда
		
		ЦенаВключаетНДС = Истина;
		
	КонецЕсли;
	
	МодельШапка.Заголовок = ЗаголовокСчета;
	МодельШапка.Продавец = ДанныеШапки.Организация;
	МодельШапка.ПродавецПредставление = ПродавецПредставление;
	МодельШапка.ПродавецОписание = ПродавецОписание;
	МодельШапка.ПродавецИНН = СведенияОбОрганизации.ИНН;
	МодельШапка.ПродавецКПП = СведенияОбОрганизации.КПП;
	МодельШапка.Покупатель = ДанныеШапки.Контрагент;
	МодельШапка.ПокупательПредставление = ПокупательПредставление;
	МодельШапка.ПокупательОписание = ПокупательОписание;
	МодельШапка.Грузоотправитель = ДанныеШапки.Грузоотправитель;
	МодельШапка.ГрузоотправительПредставление = ГрузоотправительОписание;
	МодельШапка.Грузополучатель = ДанныеШапки.Грузополучатель;
	МодельШапка.ГрузополучательПредставление = ГрузополучательОписание;
	МодельШапка.Номер = НомерДокумента;
	МодельШапка.Дата = ДатаДокумента;
	МодельШапка.РуководительФИО = ДанныеШапки.Руководитель;
	МодельШапка.ЦенаВключаетНДС = ЦенаВключаетНДС;
	МодельШапка.ОблагаетсяНДСУПокупателя = ДанныеШапки.ОперацияОблагаетсяНДСУПокупателя;
	МодельШапка.Валюта = ДанныеШапки.Валюта;
	МодельШапка.ВалютаКод = КодВалютыПоКлассификатору(ДанныеШапки.Валюта);
	МодельШапка.УчитыватьНДС = ДанныеШапки.УчитыватьНДС;
	
	ЕстьБанковскийСчет = ЗначениеЗаполнено(ДанныеШапки.БанковскийСчет);
	
	Если ЕстьБанковскийСчет Тогда
		
		ВыбратьРазрешенные = Истина;
		
		ПродавецБанк = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДанныеШапки.БанковскийСчет,
			"Банк",
			ВыбратьРазрешенные
		);
		
		МодельШапка.ПродавецБанк = ПродавецБанк;
		МодельШапка.ПродавецБанкБИК = ДанныеШапки.БИКБанк;
		МодельШапка.ПродавецБанкПредставление = ДанныеШапки.НаименованиеБанка;
		МодельШапка.ПродавецБанковскийСчет = ДанныеШапки.БанковскийСчет;
		МодельШапка.ПродавецБанковскийСчетНомер = ДанныеШапки.НомерБанковскогоСчета;
		МодельШапка.ПродавецБанковскийСчетКорСчет = ДанныеШапки.КоррСчетБанка;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СчетаНаОплату_ЗаполнитьТабличнуюЧастьПоУмолчанию(МодельТабличнаяЧасть, ОснованиеЭлектронногоСчета)
	
	ПараметрыПечати = Неопределено;
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ОснованиеЭлектронногоСчета);
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОснованиеЭлектронногоСчета);
	СтруктураДанныхДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(
		ПараметрыПечати,
		МассивОбъектов
	);
	
	ДанныеТабличнойЧасти = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Выбрать();
	
	ЕстьСодержание = СтруктураДанныхДляПечати.РезультатПоТабличнойЧасти.Колонки.Найти("Содержание") <> Неопределено;
	
	Пока ДанныеТабличнойЧасти.Следующий() Цикл
		
		НоваяСтрока = МодельТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеТабличнойЧасти);
		
		Содержание = "";
		
		Если ЕстьСодержание Тогда
			Содержание = ДанныеТабличнойЧасти.Содержание;
		КонецЕсли;
		
		НоменклатураПредставление = ПредставлениеНоменклатуры(
			ДанныеТабличнойЧасти.Номенклатура,
			ДанныеТабличнойЧасти.Характеристика,
			Содержание
		);
		
		НоваяСтрока.НоменклатураПредставление = НоменклатураПредставление;
		
		Если ЗначениеЗаполнено(ДанныеТабличнойЧасти.Номенклатура) Тогда
			НоваяСтрока.НоменклатураАртикул = АртикулНоменклатуры(ДанныеТабличнойЧасти.Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Получает код валюты в соответствии с ОКВ
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты - валюта, код которой требуется определить
// 
// Возвращаемое значение:
//  Строка - код валюты по ОКВ
//
Функция КодВалютыПоКлассификатору(Валюта)
	
	РеквизитыВалюты = Новый Структура;
	РеквизитыВалюты.Вставить("Код");
	РеквизитыВалюты.Вставить("ЗагружаетсяИзИнтернета");
	РеквизитыВалюты.Вставить("ОсновнаяВалютаКод", "ОсновнаяВалюта.Код");
	
	ЗначенияРеквизитов = ЗначенияРеквизитовОбъектаЛок(Валюта, РеквизитыВалюты);
	
	Результат = СокрЛП(ЗначенияРеквизитов.Код);
	Если Не ЗначенияРеквизитов.ЗагружаетсяИзИнтернета
		И ЗначениеЗаполнено(ЗначенияРеквизитов.ОсновнаяВалютаКод) Тогда
		Результат = СокрЛП(ЗначенияРеквизитов.ОсновнаяВалютаКод);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначенияРеквизитовОбъектаЛок(СсылкаНаОбъект, Реквизиты)
	
	ВыбиратьРазрешенные = Истина;
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СсылкаНаОбъект,
		Реквизиты,
		ВыбиратьРазрешенные
	);
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеРеквизитаОбъектаЛок(СсылкаНаОбъект, ИмяРеквизита)
	
	ВыбиратьРазрешенные = Истина;
	Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		СсылкаНаОбъект,
		ИмяРеквизита,
		ВыбиратьРазрешенные
	);
	
	Возврат Результат;
	
КонецФункции

Функция ЗначенияРеквизитовОбъектовЛок(СсылкаНаОбъект, Реквизиты)

	ВыбиратьРазрешенные = Истина;
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		СсылкаНаОбъект,
		Реквизиты,
		ВыбиратьРазрешенные
	);
	
	Возврат Результат;
	
КонецФункции

Функция ОбщийМодульПоИмениЛок(ИмяМодуля)
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		Ошибка = СтрШаблон("Общий модуль ""%1"" не найден", ИмяМодуля);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат Вычислить(ИмяМодуля);
	
КонецФункции

Функция МенеджерОбъектаПоПолномуИмениЛок(ПолноеИмяОбъекта)

	Результат = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъекта);
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитОбъектаЛок(ИмяРеквизита, ОбъектМетаданных)
	
	Результат = (ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено);
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитИлиСвойствоОбъектаЛок(ПроверяемыйОбъект, ИмяРеквизита)
	
	КлючУникальности = Новый УникальныйИдентификатор;
	СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
	
	ЗаполнитьЗначенияСвойств(СтруктураРеквизита, ПроверяемыйОбъект);
	
	Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
	
КонецФункции

Функция ЕстьРеквизитТабличнойЧастиОбъектаЛок(ПроверяемыйОбъект, ИмяТабличнойЧасти, ИмяРеквизита)
	
	Результат = Ложь;
	
	ТабличнаяЧасть = ПроверяемыйОбъект.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ЕстьРеквизитИлиСвойствоОбъектаЛок(ТабличнаяЧасть, ИмяРеквизита);
	Возврат Результат;
	
КонецФункции

// Возвращает виды документов из текущей конфигурации для поиска в модуле
// 
// Возвращаемое значение:
//  Массив - Предопределенные виды документов конфигурации для поиска в модуле
//
Функция ВидыПредопределенныхДокументовДляПоискаВМодуле() Экспорт
	
	ДокументыКонфигурации = Метаданные.Документы;
	
	Результат = Новый Массив;
	Результат.Добавить(ДокументыКонфигурации.АктВыполненныхРабот);
	Результат.Добавить(ДокументыКонфигурации.ВозвратТоваровОтКлиента);
	Результат.Добавить(ДокументыКонфигурации.ВозвратТоваровПоставщику);
	Результат.Добавить(ДокументыКонфигурации.КорректировкаРеализации);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомиссионера);
	Результат.Добавить(ДокументыКонфигурации.ОтчетКомитенту);
	Результат.Добавить(ДокументыКонфигурации.РеализацияТоваровУслуг);
	Результат.Добавить(ДокументыКонфигурации.РеализацияУслугПрочихАктивов);
	Результат.Добавить(ДокументыКонфигурации.СчетНаОплатуКлиенту);
	Результат.Добавить(ДокументыКонфигурации.СчетФактураВыданный);
	Результат.Добавить(ДокументыКонфигурации.СчетФактураВыданныйАванс);
	Результат.Добавить(ДокументыКонфигурации.СчетФактураКомиссионеру);
	
	Если ИспользуетсяСверкаВзаиморасчетов2_4() Тогда
		Результат.Добавить(ДокументыКонфигурации.СверкаВзаиморасчетов2_4);
	Иначе
		Результат.Добавить(ДокументыКонфигурации.СверкаВзаиморасчетов);
	КонецЕсли;
	
	Если ИспользуетсяСверкаВзаиморасчетов2_5_11() Тогда
		Результат.Добавить(ДокументыКонфигурации.СверкаВзаиморасчетов2_5_11);
	КонецЕсли;
	
	Если ЕстьДокументОтчетДавальцу() Тогда
		Результат.Добавить(ДокументыКонфигурации.ОтчетДавальцу);
	КонецЕсли;
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		Результат.Добавить(ДокументыКонфигурации.ОтчетДавальцу2_5);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает прикладное значение ставки НДС по его строковому представлению
//
// Параметры:
//  ПредставлениеСтавки - Строка - Строковое представление ставки НДС
// 
// Возвращаемое значение:
//  СправочникСсылка, ПеречислениеСсылка - Прикладное значение ставки НДС
//
Функция ЗначениеСтавкиНДС(ПредставлениеСтавки) Экспорт
	
	ЗначениеНДС = Неопределено;
	
	Если ПредставлениеСтавки = Неопределено
		ИЛИ СтрНайти("БЕЗ НДС", ВРег(ПредставлениеСтавки)) > 0 Тогда
		
		ЗначениеНДС = "без НДС";
		
	Иначе
		
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, "%", "");
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, " ", "");
		СтрСтавкаНДС = СтрЗаменить(ПредставлениеСтавки, "\", "/");
		
		Если СтрНайти("0", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "0";
		ИначеЕсли СтрНайти("5", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "5";
		ИначеЕсли СтрНайти("7", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "7";
		ИначеЕсли СтрНайти("10", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "10";
		ИначеЕсли СтрНайти("18", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "18";
		ИначеЕсли СтрНайти("20", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "20";
		ИначеЕсли СтрНайти("22", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "22";
		ИначеЕсли СтрНайти("10/110", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "10/110";
		ИначеЕсли СтрНайти("18/118", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "18/118";
		ИначеЕсли СтрНайти("20/120", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "20/120";
		ИначеЕсли СтрНайти("22/122", СтрСтавкаНДС) > 0 Тогда
			ЗначениеНДС = "22/122";
		Иначе
			ЗначениеНДС = ПредставлениеСтавки;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = СтавкаНДСИзСоответствия(ЗначениеНДС);
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое представление ставки НДС по прикладному значению
//
// Параметры:
//  ЗначениеСтавки - СправочникСсылка, ПеречислениеСсылка - Прикладное значение ставки НДС
//  НДСИсчисляетсяНалоговымАгентом - Булево - Истина, если НДС исчисляется налоговым агентом
// 
// Возвращаемое значение:
//  Строка - Строковое представление ставки НДС для электронного документа
//
Функция ПредставлениеСтавкиНДС(ЗначениеСтавки, НДСИсчисляетсяНалоговымАгентом = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗначениеСтавки) Тогда
		
		Результат = "##";
		
	ИначеЕсли НДСИсчисляетсяНалоговымАгентом Тогда
		
		Результат = СтавкаНДСИсчисляетсяНалоговымАгентом();
		
	Иначе
		
		Результат = СтавкаНДСИзСоответствия(, ЗначениеСтавки);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = СокрЛП(ЗначениеСтавки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтавкаНДСИзСоответствия(ПредставлениеБЭД = "", ПрикладноеЗначение = Неопределено)
	
	Результат = Неопределено;
	
	ПеречислениеСтавокНДС = ЗаполнитьСоответствиеСтавокНДС();
	
	Если ЗначениеЗаполнено(ПредставлениеБЭД) Тогда
		
		Результат = ПеречислениеСтавокНДС.Получить(ПредставлениеБЭД);
		
	Иначе
		
		Для Каждого КлючИЗначение Из ПеречислениеСтавокНДС Цикл
			
			Если КлючИЗначение.Значение = ПрикладноеЗначение Тогда
				
				Результат = КлючИЗначение.Ключ;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьСоответствиеСтавокНДС()
	
	Если ИспользуетсяБЭД19() Тогда
		Результат = СоответствиеСтавокНДСИзСправочника();
	Иначе
		Результат = СоответствиеСтавокНДСИзПеречисления();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеСтавокНДСИзПеречисления()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	Результат.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	Результат.Вставить("18", Перечисления.СтавкиНДС.НДС18);
	Результат.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	Результат.Вставить("10/110", Перечисления.СтавкиНДС.НДС10_110);
	Результат.Вставить("18/118", Перечисления.СтавкиНДС.НДС18_118);
	Результат.Вставить("20/120", Перечисления.СтавкиНДС.НДС20_120);
	Результат.Вставить(ПредставлениеСтавкиБезНДС(), Перечисления.СтавкиНДС.БезНДС);
	Результат.Вставить(СтавкаНДСИсчисляетсяНалоговымАгентом(), СтавкаНДСИсчисляетсяНалоговымАгентомПредставление());
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		Результат.Вставить("5", Перечисления.СтавкиНДС.НДС5);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		Результат.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		Результат.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		Результат.Вставить("5/105", Перечисления.СтавкиНДС.НДС5_105);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		Результат.Вставить("7/107", Перечисления.СтавкиНДС.НДС7_107);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		Результат.Вставить("22/122", Перечисления.СтавкиНДС.НДС22_122);
	КонецЕсли;
	
	Результат.Вставить(Перечисления.СтавкиНДС.НДС0, "0");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10, "10");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18, "18");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20, "20");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС10_110, "10/110");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС18_118, "18/118");
	Результат.Вставить(Перечисления.СтавкиНДС.НДС20_120, "20/120");
	Результат.Вставить(Перечисления.СтавкиНДС.БезНДС, ПредставлениеСтавкиБезНДС());
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС5, "5");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС7, "7");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС22, "22");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС5_105, "5/105");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС7_107, "7/107");
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		Результат.Вставить(Перечисления.СтавкиНДС.НДС22_122, "22/122");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоответствиеСтавокНДСИзСправочника()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтавкиНДС.Ставка КАК Ставка,
	|	СтавкиНДС.Ссылка КАК Ссылка,
	|	СтавкиНДС.РасчетнаяСтавка КАК РасчетнаяСтавка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	НЕ СтавкиНДС.Ссылка = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.РасчетнаяСтавка Тогда
			КлючСоответствия = Строка(ВыборкаДетальныеЗаписи.Ставка) + "/" + Строка(ВыборкаДетальныеЗаписи.Ставка + 100);
		Иначе
			КлючСоответствия = Строка(ВыборкаДетальныеЗаписи.Ставка);
		КонецЕсли;
		
		Результат.Вставить(КлючСоответствия, ВыборкаДетальныеЗаписи.Ссылка);
		
	КонецЦикла;
	
	Результат.Вставить(ПредставлениеСтавкиБезНДС(), Справочники.СтавкиНДС.БезНДС);
	Результат.Вставить(СтавкаНДСИсчисляетсяНалоговымАгентом(), СтавкаНДСИсчисляетсяНалоговымАгентомПредставление());
	
	Возврат Результат;
	
КонецФункции

Функция СуществуетЗначениеПеречисленияСтавкиНДС(ИмяЗначенияСтавкаНДС)
	
	ЗначенияПеречисления = Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления;
	Результат = (ЗначенияПеречисления.Найти(ИмяЗначенияСтавкаНДС) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция СтавкаНДСЧислом(СтавкаНДС)
	
	Перем Результат;
	
	СоответствиеСтавокНДС = СоответствиеСтавокНДСИзПеречисления();
	ПредставлениеСтавки = СоответствиеСтавокНДС.Получить(СтавкаНДС);
	
	Если ПредставлениеСтавки = "22" ИЛИ ПредставлениеСтавки = "22/122" Тогда
		Результат = 22;
	ИначеЕсли ПредставлениеСтавки = "20" ИЛИ ПредставлениеСтавки = "20/120" Тогда
		Результат = 20;
	ИначеЕсли ПредставлениеСтавки = "10" ИЛИ ПредставлениеСтавки = "10/110" Тогда
		Результат = 10;
	ИначеЕсли ПредставлениеСтавки = "7" ИЛИ ПредставлениеСтавки = "7/107" Тогда
		Результат = 7;
	ИначеЕсли ПредставлениеСтавки = "5" ИЛИ ПредставлениеСтавки = "5/105" Тогда
		Результат = 5;
	Иначе
		Результат = 0;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

