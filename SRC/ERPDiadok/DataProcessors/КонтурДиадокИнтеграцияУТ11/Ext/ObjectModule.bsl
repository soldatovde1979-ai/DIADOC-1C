Функция РегистрацияПодразделенияВНалоговомОргане(Подразделение, Организация, ДатаДокумента)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(Подразделение) 
		Или ТипЗнч(Подразделение) <> Тип("СправочникСсылка.СтруктураПредприятия") Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда 
		
		ТекстОшибки = НСтр("ru = 'Ошибка при получении сведений об обособленном подразделении ""%1"":
								|Не указана организация!'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, Строка(Подразделение));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если Ядро.СравнитьВерсии(ВерсияУТ, "11.5.9.116") >= 0 Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
		|			&Дата,
		|			Подразделение = &Подразделение
		|				И Организация = &Организация) КАК Т";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
		|ИЗ
		|	РегистрСведений.РегистрацииВНалоговомОргане КАК Т
		|ГДЕ
		|	Т.Подразделение = &Подразделение
		|	И Т.Организация = &Организация";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Подразделение"	, Подразделение);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("Дата"			, ДатаДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Результат = Выборка.РегистрацияВНалоговомОргане;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодразделениеСклада(ДокументСсылка)
	
	Результат = Справочники.СтруктураПредприятия.ПустаяСсылка();
	
	МетаданныеСправочника = Метаданные.Справочники.Склады;
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	Если ЕстьРеквизитОбъектаЛок("Подразделение", МетаданныеСправочника)
		И ЕстьРеквизитОбъектаЛок("Склад", МетаданныеДокумента) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Склад.Подразделение");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

