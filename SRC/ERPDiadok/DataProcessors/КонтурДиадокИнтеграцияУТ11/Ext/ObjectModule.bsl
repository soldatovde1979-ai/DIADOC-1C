Функция УПД970_КонтентТитулаПродавцаПоКорректировкеРеализации(Документ, ФункцияДокумента, ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеКорректировкиРеализации(Документ);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	
	ПересчитыватьВВалютуРеглУчета = УПД970_ПересчитыватьСуммыВВалютуРегламентированногоУчета(
		ДанныеШапки.ВалютаДокумента,
		ДанныеШапки.ОплатаВВалюте
	);
	
	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента_ДОП();
	Результат.CircumFormatInvoice = УПД970_ОбстоятельстваФормированияУПД(ДанныеШапки.Ссылка);
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	Результат.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
	Результат.RevisionNumber = ПредставлениеНомера(ДанныеШапки.НомерИсправления);
	Результат.RevisionDate = ДанныеШапки.ДатаИсправления;
	
	Если ПересчитыватьВВалютуРеглУчета Тогда
		Результат.Currency = КодВалютыРегламентированногоУчета();
	Иначе
		Результат.Currency = ДанныеШапки.ВалютаДокументаКод;
	КонецЕсли;
	
	Table = Результат.Table;
	
	ПараметрыЗаполненияТаблицы = УПД970_НовыйПараметрыЗаполненияТабличныхДанныхКонтента(
		ПересчитыватьВВалютуРеглУчета,
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
		ДанныеШапки.ЦенаВключаетНДС,
		ДополнительныеПараметры.ТочностьКоличества,
		ДополнительныеПараметры.ТочностьЦены
	);
	УПД970_ЗаполнитьТабличныеДанныеКонтента(
		Table,
		ДанныеДокумента.ТабличныеДанные,
		Результат.Function,
		ПараметрыЗаполненияТаблицы,
		ДанныеДокумента.СведенияПрослеживаемости
	);
	УПД970_ЗаполнитьСведенияОПродавце(
		Результат,
		ДанныеШапки.Поставщик,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации,
		ДанныеШапки.КПППоставщика
	);
	УПД970_ЗаполнитьСведенияОПокупателе(
		Результат,
		ДанныеШапки.Контрагент,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетКонтрагента
	);
	
	ЕстьТовары = УПД970_СодержитТовары(ДанныеДокумента.ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		УПД970_ЗаполнитьСведенияОГрузоотправителе(
			Результат,
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетГрузоотправителя
		);
		ИспользоватьАдресДоставкиИзДокумента = АдресГрузополучателяБратьИзАдресаДоставки();
		
		Если ИспользоватьАдресДоставкиИзДокумента Тогда
			СведенияОАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
				ДанныеШапки.АдресДоставки,
				ДанныеШапки.АдресДоставкиЗначенияПолей
			);
		Иначе
			СведенияОАдресеДоставки = Неопределено;
		КонецЕсли;
		
		УПД970_ЗаполнитьСведенияОГрузополучателе(
			Результат,
			ДанныеШапки.Грузополучатель,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетГрузополучателя,
			СведенияОАдресеДоставки
		);
	КонецЕсли;
	
	ДокументыОтгрузки = ЗначениеВМассивЛок(Документ);
	Результат.DocumentName = УПД790_НаименованиеДокументаОтгрузки(Table.Items, ДокументыОтгрузки, Результат.Function);
	
	DocumentShipment = УПД970_НовыйDocumentShipments970(
		Результат.DocumentName,
		Результат.DocumentNumber,
		Результат.DocumentDate
	);
	Результат.DocumentShipments.Добавить(DocumentShipment);
	
	TransferInfo = Результат.TransferInfo;
	
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	TransferInfo.TransferTextInfo = ДанныеШапки.СведенияОТранспортировкеИГрузе;
	
	Если ЕстьТовары Тогда
		УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры);
	КонецЕсли;
	
	TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	
	ОснованияОтгрузки = УПД970_РеквизитыОснованийОтгрузки(
		ДанныеШапки.Основание,
		ДанныеШапки.ОснованиеНомер,
		ДанныеШапки.ОснованиеДата,
		ДокументыОтгрузки
	);
	
	УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Результат);
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Результат);
	УПД970_ЗаполнитьСведенияОМаркировке(Результат, Документ);
	УПД970_ЗаполнитьПризнакВыбытияИзОборотаМаркируемойПродукции(Результат, Документ);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область УПД970_ДанныхДокументовИнформационнойБазы

Функция УПД970_ИсходныеДанныеСчетФактураВыданный(Документ)
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки");
	Результат.Вставить("ТабличныеДанные");
	Результат.Вставить("ДокументыОснования");
	Результат.Вставить("СведенияПрослеживаемости");
	Результат.Вставить("ПлатежноРасчетныеДокументы");
	Результат.Вставить("Покупатели");
	Результат.Вставить("АвансовыеДокументы");
	
	ИмяДокумента = "СчетФактураВыданный";
	
	ТекстЗапросаДанныхШапки = УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданный();
	ТекстЗапросаПРД = УПД970_ТекстЗапросаПлатежноРасчетныхДокументов(ИмяДокумента);
	ТекстЗапросаАвансовыхДокументов = УПД970_ТекстЗапросаАвансовыхДокументовСчетФактурыВыданный();
	
	ТекстыЗапросов = ЗначениеВМассивЛок(ТекстЗапросаДанныхШапки);
	ТекстыЗапросов.Добавить(ТекстЗапросаПРД);
	
	ИспользуетсяТаблицаПокупатели = (СравнитьВерсии_(ВерсияТорговойПодсистемы(), "11.5.8") >= 0);
	Если ИспользуетсяТаблицаПокупатели Тогда
		ТекстЗапросаПокупатели = УПД970_ТекстЗапросаДанныеПокупателейСчетФактуры(ИмяДокумента);
		ТекстыЗапросов.Добавить(ТекстЗапросаПокупатели);
	КонецЕсли;
	
	ТекстыЗапросов.Добавить(ТекстЗапросаАвансовыхДокументов);

	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапкиСФ = СтрокаТаблицыЗначенийВСтруктуруЛок(РезультатыЗапроса[0].Выгрузить()[0]);
	ПлатежноРасчетныеДокументы = РезультатыЗапроса[1].Выгрузить();
	
	Покупатели = Неопределено;
	Если ИспользуетсяТаблицаПокупатели Тогда
		Покупатели = РезультатыЗапроса[2].Выгрузить();
	КонецЕсли;
	
	Если ИспользуетсяТаблицаПокупатели Тогда
		АвансовыеДокументы = РезультатыЗапроса[3].Выгрузить();
	Иначе
		АвансовыеДокументы = РезультатыЗапроса[2].Выгрузить();
	КонецЕсли;
	
	ЭтоПервыйДокументОснования = Истина;
	
	ТаблицаДокументовОснований = ДокументыОснованияСчетФактураВыданный(Документ);
	
	Для Каждого ДокументОснования Из ТаблицаДокументовОснований Цикл
		
		ДанныеОснования = УПД970_ИсходныеДанныеДокументаОснованияСчетФактураВыданный(
			ДокументОснования.ТекущийДокумент,
			Документ,
			Покупатели);
			
		Грузоотправитель = СвойствоСтруктурыЛок(ДанныеОснования.ДанныеШапки, "Грузоотправитель");
		Грузополучатель = СвойствоСтруктурыЛок(ДанныеОснования.ДанныеШапки, "Грузополучатель");
		
		Если ЭтоПервыйДокументОснования Тогда
			
			Результат.ДанныеШапки = СкопироватьКоллекциюЛок(ДанныеОснования.ДанныеШапки);
			
			ЗаменятьЗначения = Истина;
			ДополнитьСтруктуруЛок(Результат.ДанныеШапки, ДанныеШапкиСФ, ЗаменятьЗначения);
			
			Результат.ТабличныеДанные = ДанныеОснования.ТабличныеДанные;
			
			Результат.СведенияПрослеживаемости = СвойствоСтруктурыЛок(ДанныеОснования, "СведенияПрослеживаемости");
			
			Результат.ДанныеШапки.Вставить("Грузоотправитель", Новый Массив);
			Результат.ДанныеШапки.Вставить("Грузополучатель", Новый Массив);
			
		Иначе
			
			СведенияПрослеживаемости = СвойствоСтруктурыЛок(ДанныеОснования, "СведенияПрослеживаемости");
			
			ДополнитьТаблицуЗначенийЛок(Результат.ТабличныеДанные, ДанныеОснования.ТабличныеДанные);
			ДополнитьТаблицуЗначенийЛок(Результат.СведенияПрослеживаемости, СведенияПрослеживаемости);
			
			Результат.ДанныеШапки.Вставить("БанковскийСчетГрузоотправителя", Неопределено);
			Результат.ДанныеШапки.Вставить("БанковскийСчетГрузополучателя", Неопределено);
			Результат.ДанныеШапки.Вставить("АдресДоставки", Неопределено);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Грузоотправитель) Тогда
			_Грузоотправитель = ЗначениеВМассивЛок(Грузоотправитель);
			ДополнитьМассивЛок(Результат.ДанныеШапки.Грузоотправитель, _Грузоотправитель, Истина);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(Грузополучатель) Тогда
			_Грузополучатель = ЗначениеВМассивЛок(Грузополучатель);
			ДополнитьМассивЛок(Результат.ДанныеШапки.Грузополучатель, _Грузополучатель, Истина);
		КонецЕсли;
		
		ЭтоПервыйДокументОснования = Ложь;
		
	КонецЦикла;
	
	ДокументыОснования = ТаблицаДокументовОснований.ВыгрузитьКолонку("ПервичныйДокумент");
	
	Результат.ПлатежноРасчетныеДокументы = ПлатежноРасчетныеДокументы;
	Результат.ДокументыОснования = ДокументыОснования;
	Результат.Покупатели = Покупатели;
	Результат.АвансовыеДокументы = АвансовыеДокументы;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеСчетФактураКомиссионеру(Документ)
	
	ДанныеШапкиСФ = ЗначенияРеквизитовОбъектаЛок(Документ, "Номер, Дата, КодВидаОперации");
	
	ИмяДокумента = "СчетФактураКомиссионеру";
	
	ТекстЗапросаПРД = УПД970_ТекстЗапросаПлатежноРасчетныхДокументов(ИмяДокумента);
	ТекстЗапросаПокупатели = УПД970_ТекстЗапросаДанныеПокупателейСчетФактуры(ИмяДокумента);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаПРД);
	ТекстыЗапросов.Добавить(ТекстЗапросаПокупатели);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ПлатежноРасчетныеДокументы = РезультатЗапроса[0].Выгрузить();
	Покупатели = РезультатЗапроса[1].Выгрузить();
	
	ДокументОснования = ЗначениеРеквизитаОбъектаЛок(Документ, "ДокументОснование");
	Результат = УПД970_ИсходныеДанныеОтчетаКомиссионера(ДокументОснования, Покупатели);
	
	ДанныеШапки = Результат.ДанныеШапки;
	ДанныеШапки.Номер = ДанныеШапкиСФ.Номер;
	ДанныеШапки.Дата = ДанныеШапкиСФ.Дата;
	ДанныеШапки.Ссылка = Документ;
	ДанныеШапки.Вставить("КодВидаОперации", ДанныеШапкиСФ.КодВидаОперации);
	
	Результат.Вставить("ПлатежноРасчетныеДокументы", ПлатежноРасчетныеДокументы);
	Результат.Вставить("Покупатели", Покупатели);
	Результат.Вставить("ДокументыОснования", ЗначениеВМассивЛок(ДокументОснования));

	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеСчетФактураВыданныйНаАванс(Документ)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса = УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданныйНаАванс();
	ДанныеШапки = Данные_ШапкаДокумента(Документ, ТекстЗапроса, МенеджерВременныхТаблиц);
	
	Данные_АктуализироватьРасчетыСКонтрагентами(Документ, ДанныеШапки.ВалютаДокумента);

	УПД970_ПоместитьВременнуюТаблицуТоваровСчетФактурыВыданныйАванс(МенеджерВременныхТаблиц);

	ТекстЗапроса = УПД970_ТекстЗапросаТабличныхДанныхСчетФактураВыданныйАванс();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДопКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов());

	ТабличныеДанные = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("ДокументыОснования", ЗначениеВМассивЛок(ДанныеШапки.ДокументОснование));

	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеРеализацииТоваровУслуг(Документ)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса = УПД970_ТекстЗапросаРеквизитовШапкиРеализацииТоваровУслуг();
	ДанныеШапки = Данные_ШапкаДокумента(Документ, ТекстЗапроса, МенеджерВременныхТаблиц);
	
	Данные_АктуализироватьРасчетыСКонтрагентами(Документ, ДанныеШапки.ВалютаДокумента);
	
	УПД970_ПоместитьВременнуюТаблицуТоваровРеализацииТоваровУслуг(МенеджерВременныхТаблиц);
	
	ТекстЗапросаТоваров = УПД970_ТекстЗапросаТабличныхДанныхРеализацииТоваровУслуг();
	ТекстыЗапросов = ЗначениеВМассивЛок(ТекстЗапросаТоваров);
	
	ЕстьУчетПрослеживаемыхКомплектующих = ЕстьФункциональностьУчетаПрослеживаемыхКомплектующих();
	Если ЕстьУчетПрослеживаемыхКомплектующих Тогда
		ТекстЗапросаПрослеживаемыхКомплектующих = УПД970_ТекстЗапросаПрослеживаемыхКомплектующихОбщее(
			"РеализацияТоваровУслугТаблицаТоваров");
		ТекстыЗапросов.Добавить(ТекстЗапросаПрослеживаемыхКомплектующих);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", ВыводитьБазовыеЕдиницыИзмерения());
	Запрос.УстановитьПараметр("ДопКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов());

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТабличныеДанные = РезультатЗапроса[0].Выгрузить();
	УПД970_ДополнитьСтрокиТоваровВариантамиПредставленияНаборов(ТабличныеДанные);
	
	СведенияПрослеживаемости = Неопределено;
	Если ЕстьУчетПрослеживаемыхКомплектующих Тогда
		СведенияПрослеживаемости = РезультатЗапроса[1].Выгрузить();
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсходныеДанныеАктаВыполненныхРабот(Документ)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса = УПД970_ТекстЗапросаРеквизитовШапкиАктаВыполненныхРабот();
	ДанныеШапки = Данные_ШапкаДокумента(Документ, ТекстЗапроса, МенеджерВременныхТаблиц);
	
	Данные_АктуализироватьРасчетыСКонтрагентами(Документ, ДанныеШапки.ВалютаДокумента);
	
	УПД970_ПоместитьВременнуюТаблицуТоваровАктаВыполненныхРабот(МенеджерВременныхТаблиц);
	
	ТекстЗапросаТоваров = УПД970_ТекстЗапросаТабличныхДанныхАктаВыполненныхРабот();
	ТекстыЗапросов = ЗначениеВМассивЛок(ТекстЗапросаТоваров);
	
	ЕстьУчетПрослеживаемыхКомплектующих = ЕстьФункциональностьУчетаПрослеживаемыхКомплектующих();
	Если ЕстьУчетПрослеживаемыхКомплектующих Тогда
		ТекстЗапросаПрослеживаемыхКомплектующих = УПД970_ТекстЗапросаПрослеживаемыхКомплектующихОбщее(
			"АктВыполненныхРаботТаблицаТоваров");
		ТекстыЗапросов.Добавить(ТекстЗапросаПрослеживаемыхКомплектующих);
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДопКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов());
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", ВыводитьБазовыеЕдиницыИзмерения());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТабличныеДанные = РезультатЗапроса[0].Выгрузить();
	УПД970_ДополнитьСтрокиТоваровВариантамиПредставленияНаборов(ТабличныеДанные);
	
	СведенияПрослеживаемости = Неопределено;
	Если ЕстьУчетПрослеживаемыхКомплектующих Тогда
		СведенияПрослеживаемости = РезультатЗапроса[1].Выгрузить();
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("СведенияПрослеживаемости", СведенияПрослеживаемости);
	
	Возврат Результат;
	
КонецФункции

