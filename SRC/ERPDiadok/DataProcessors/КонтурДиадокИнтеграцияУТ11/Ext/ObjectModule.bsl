Функция УПД970_ИсходныеДанныеДокументаОснованияСчетФактураВыданный(
	ДокументОснование,
	СчетФактура,
	Покупатели)

	ТипДокумента = ТипЗнч(ДокументОснование);
	
	Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Результат = УПД970_ИсходныеДанныеРеализацииТоваровУслуг(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		Результат = УПД970_ИсходныеДанныеАктаВыполненныхРабот(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
		
		Результат = УПД970_ИсходныеДанныеРеализацииУслугПрочихАктивов(ДокументОснование);
		
	ИначеЕсли ЭтоОтчетКомитентуОЗакупках(ДокументОснование) Тогда
		
		ЭтоСчетФактураПеревыставленный = ЭтоСчетФактураПеревыставленный(СчетФактура);
		Если ЭтоСчетФактураПеревыставленный Тогда
			Результат = УПД970_ИсходныеДанныеОтчетаКомитентуОЗакупках_Товары(ДокументОснование, СчетФактура);
		Иначе
			Результат = УПД970_ИсходныеДанныеОтчетаКомитентуОЗакупках_Вознаграждение(ДокументОснование);
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		Результат = УПД970_ИсходныеДанныеОтчетаКомитенту(ДокументОснование);
			
	ИначеЕсли ЭтоОтчетДавальцу(ДокументОснование) Тогда
			
		Результат = УПД970_ИсходныеДанныеОтчетаДавальцу(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом") Тогда
			
		Результат = УПД970_ИсходныеДанныеВыкупаВозвратнойТарыКлиентом(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		
		Результат = УПД970_ИсходныеДанныеОтчетаКомиссионера(ДокументОснование, Покупатели);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		
		Результат = УПД970_ИсходныеДанныеКорректировкиРеализации(ДокументОснование);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыкупТоваровХранителем") Тогда
		
		Результат = УПД970_ИсходныеДанныеВыкупаТоваровХранителем(ДокументОснование);
		
	Иначе
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не поддерживаются счета-фактуры с документами-основаниями %1'"),
			ДокументОснование.Метаданные().Синоним);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

