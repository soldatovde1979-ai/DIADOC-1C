Функция УПД970_ТекстЗапросаДанныхШапкиСчетФактураВыданный()

	Результат =
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК Ссылка,
	|	ВЫБОР КОГДА СчетФактураВыданный.Исправление ТОГДА
	|		ЕСТЬNULL(СчетФактураВыданный.СчетФактураОснование.Дата, ДАТАВРЕМЯ(1,1,1))
	|	ИНАЧЕ 
	|		СчетФактураВыданный.Дата
	|	КОНЕЦ КАК Дата,
	|	СчетФактураВыданный.ПредставлениеНомера КАК Номер,
	|	СчетФактураВыданный.КодВидаОперации КАК КодВидаОперации,
	|	СчетФактураВыданный.КППКонтрагента КАК КПППокупателя,
	|	СчетФактураВыданный.Исправление КАК Исправление,
	|	СчетФактураВыданный.НомерИсправления КАК НомерИсправления,
	|	СчетФактураВыданный.Дата КАК ДатаИсправления,
	|	СчетФактураВыданный.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
	|	&РеализацияЧерезКомиссионера КАК РеализацияЧерезКомиссионера
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Ссылка = &Ссылка";
	
	Если ИспользуетсяРеализацияЧерезКомиссионера() Тогда
		ТекстЗамены = "СчетФактураВыданный.РеализацияЧерезКомиссионера";
	Иначе
		ТекстЗамены = "ЛОЖЬ";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&РеализацияЧерезКомиссионера", ТекстЗамены);
	
	Возврат Результат;
	
