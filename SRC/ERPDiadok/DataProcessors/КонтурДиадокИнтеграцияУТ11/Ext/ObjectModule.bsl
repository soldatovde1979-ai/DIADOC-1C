КонецФункции

Функция ЭтоДокументПродажи(Документ)
	
	МассивТипов = Новый Массив;
	
	МассивТипов.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	МассивТипов.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
	МассивТипов.Добавить(Тип("ДокументСсылка.РеализацияУслугПрочихАктивов"));
	МассивТипов.Добавить(Тип("ДокументСсылка.ОтчетКомитенту"));
	МассивТипов.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));
	МассивТипов.Добавить(Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом"));
	МассивТипов.Добавить(Тип("ДокументСсылка.ОтчетКомиссионера"));
	
	Если ЕстьДокументОтчетДавальцу() Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ОтчетДавальцу"));
	КонецЕсли;
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.ОтчетДавальцу2_5"));
	КонецЕсли;
	
	Результат = МассивТипов.Найти(ТипЗнч(Документ)) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСверкаВзаиморасчетов2_5_11(Документ)
	
