Функция УПД970_КонтентТитулаПродавцаПоСчетФактураКомиссионеру(Документ, ФункцияДокумента, ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеСчетФактураКомиссионеру(Документ);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	
	ПересчитыватьВВалютуРеглУчета = УПД970_ПересчитыватьСуммыВВалютуРегламентированногоУчета(
		ДанныеШапки.ВалютаДокумента,
		ДанныеШапки.ОплатаВВалюте);

	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента;
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФ() Тогда
		ОбстФормированияДокумента = УПД970_ОбстоятельстваФормированияСчетаФактуры(
			ДанныеШапки.КодВидаОперации,
			ДанныеШапки.ТипДоговора);
	Иначе
		ОбстФормированияДокумента = УПД970_ОбстоятельстваФормированияУПД(Документ);
	КонецЕсли;
	
	Результат.CircumFormatInvoice = ОбстФормированияДокумента;
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	Результат.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
	
	Если ПересчитыватьВВалютуРеглУчета Тогда
		Результат.Currency = КодВалютыРегламентированногоУчета();
	Иначе
		Результат.Currency = ДанныеШапки.ВалютаДокументаКод;
	КонецЕсли;
	
	Table = Результат.Table;
	
	ПараметрыЗаполненияТаблицы = УПД970_НовыйПараметрыЗаполненияТабличныхДанныхКонтента(
		ПересчитыватьВВалютуРеглУчета,
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
		ДанныеШапки.ЦенаВключаетНДС,
		ДополнительныеПараметры.ТочностьКоличества,
		ДополнительныеПараметры.ТочностьЦены);
		
	УПД970_ЗаполнитьТабличныеДанныеКонтента(
		Table,
		ДанныеДокумента.ТабличныеДанные,
		Результат.Function,
		ПараметрыЗаполненияТаблицы);
	
	УПД970_ЗаполнитьСведенияОПродавце(
		Результат,
		ДанныеШапки.Поставщик,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации,
		ДанныеШапки.КПППоставщика);
		
	Если ДанныеДокумента.Покупатели.Количество() = 0 Тогда
		БанковскийСчетКонтрагента = Неопределено;
		УПД970_ЗаполнитьСведенияОПокупателе(
			Результат,
			ДанныеШапки.Контрагент,
			ДанныеШапки.Дата,
			БанковскийСчетКонтрагента,
			ДанныеШапки.КПППокупателя);
	Иначе
		УПД970_ЗаполнитьСведенияОПокупателях(Результат, ДанныеДокумента.Покупатели, ДанныеШапки.Дата);
	КонецЕсли;
	
	ЕстьТовары = УПД970_СодержитТовары(ДанныеДокумента.ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		УПД970_ЗаполнитьСведенияОГрузоотправителе(
			Результат,
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата
		);
		УПД970_ЗаполнитьСведенияОГрузополучателяхПоПокупателям(
			Результат.Consignees,
			Результат.Buyers,
			ДанныеШапки.Дата
		);
		
	КонецЕсли;
	
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Результат, ДанныеДокумента.ДокументыОснования, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОПлатежноРасчетныхДокументах(
		Результат.PaymentDocuments,
		ДанныеДокумента.ПлатежноРасчетныеДокументы);

	TransferInfo = Результат.TransferInfo;
	
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	TransferInfo.TransferTextInfo = ДанныеШапки.СведенияОТранспортировкеИГрузе;
	
	ЕстьТовары = УПД970_СодержитТовары(ДанныеДокумента.ТабличныеДанные);
	Если ЕстьТовары Тогда
		УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры);
	КонецЕсли;
	
	TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	
	ОснованияОтгрузки = УПД970_РеквизитыОснованийОтгрузки(
		ДанныеШапки.Основание,
		ДанныеШапки.ОснованиеНомер,
		ДанныеШапки.ОснованиеДата,
		ДанныеДокумента.ДокументыОснования);
		
	УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры);
	
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Результат);

	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Результат);
	
	Возврат Результат;
	
КонецФункции

