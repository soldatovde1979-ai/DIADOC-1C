Процедура АктСверки405_ЗаполнитьИтогиТабличнойЧастиОтветногоТитула(Content, ДанныеШапки)
	
	ReconciliationActTable = Content.ReconciliationAct.ReconciliationActTable;
	
	ReconciliationActTable.BalanceDebitFrom = ДанныеШапки.СальдоНаНачалоПериодаДебет;
	ReconciliationActTable.BalanceAmountFrom = ДанныеШапки.СальдоНаНачалоПериодаКредит;
	ReconciliationActTable.TurnoverDebit = ДанныеШапки.ОборотПоДебету;
	ReconciliationActTable.TurnoverAmount = ДанныеШапки.ОборотПоКредиту;
	ReconciliationActTable.BalanceDebitEnd = ДанныеШапки.СальдоНаКонецПериодаДебет;
	ReconciliationActTable.BalanceAmountEnd = ДанныеШапки.СальдоНаКонецПериодаКредит;
	ReconciliationActTable.TotalConsumptionDebit = ДанныеШапки.СальдоНаКонецПериодаДебет - ДанныеШапки.СальдоНаКонецПериодаДебетКонтрагент;
	ReconciliationActTable.TotalConsumptionAmount = ДанныеШапки.СальдоНаКонецПериодаКредит - ДанныеШапки.СальдоНаКонецПериодаКредитКонтрагент;
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьТабличнуюЧастьОтветногоТитула(Content, Выборка)
	
	ТекущиеПоля = Новый Структура("Договор, ИдентификаторДокумента, ПорядковыйНомер");
	ContractInfo = Неопределено;
	НоваяСтрокаВторогоУровня = Неопределено;
	
	ReconciliationActTable = Новый_RecipientReconciliationActTable();
	
	Пока Выборка.Следующий() Цикл
		
		ЕстьИзмененияГруппировки = Ложь;
		
		Если ТекущиеПоля.Договор <> Выборка.Договор Тогда
			
			ContractInfo = Новый_RecipientContractInfo_ReconciliationAct();
			
			ReconciliationActTable.ContractInfo.Добавить(ContractInfo);
			
			АктСверки405_ЗаполнитьContractInfoОтветногоТитула(ContractInfo, Выборка);
			
			ЕстьИзмененияГруппировки = Истина;
			
		КонецЕсли;
		
		Если ContractInfo <> Неопределено
			И (ТекущиеПоля.ИдентификаторДокумента <> Выборка.ИдентификаторДокумента
			Или ЕстьИзмененияГруппировки) Тогда
			
			DocumentInfo = Новый_RecipientDocumentInfo_ReconciliationAct();
			
			Если ПустаяСтрока(Выборка.НаименованиеДокумента) Тогда
				ДанныеДокумента = АктСверки405_ДанныеПустогоДокумента();
			Иначе
				ДанныеДокумента = Выборка;
			КонецЕсли;
			
			АктСверки405_ЗаполнитьDocumentInfoОтветногоТитула(DocumentInfo, ДанныеДокумента);
			
			ContractInfo.DocumentInfo.Добавить(DocumentInfo);
			
			ЕстьИзмененияГруппировки = Истина;
			
		КонецЕсли;
		
		Если DocumentInfo <> Неопределено
			И (ТекущиеПоля.ПорядковыйНомер <> Выборка.ПорядковыйНомер
			Или ЕстьИзмененияГруппировки) Тогда
			
			OperationInfo = Новый_RecipientOperationInfo_ReconciliationAct();
			
			Если Выборка.ПорядковыйНомер > 0 Тогда
				ДанныеОперации = Выборка;
			Иначе
				ДанныеОперации = АктСверки405_ДанныеПустойОперации();
			КонецЕсли;
			
			АктСверки405_ЗаполнитьOperationInfoОтветногоТитула(OperationInfo, ДанныеОперации);
			
			DocumentInfo.OperationInfo.Добавить(OperationInfo);
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекущиеПоля, Выборка);
		
	КонецЦикла;
	
	Если ReconciliationActTable.ContractInfo.Количество() = 0 Тогда
		АктСверки405_НетОборотовЗаПериод(ReconciliationActTable);
	КонецЕсли;
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьContractInfoОтветногоТитула(Content, ДанныеДоговора)
	
	Content.ContractAdditionalInfo = Строка(ДанныеДоговора.Договор.ТипДоговора);
	Content.ContractNumber = ДанныеДоговора.НомерДоговора;
	Content.ContractDate = ДанныеДоговора.ДатаДоговора;
	Content.BalanceDebitFrom = ДанныеДоговора.СальдоНаНачалоПериодаДебет;
	Content.BalanceAmountFrom = ДанныеДоговора.СальдоНаНачалоПериодаКредит;
	Content.TurnoverDebit = ДанныеДоговора.ОборотПоДебету;
	Content.TurnoverAmount = ДанныеДоговора.ОборотПоКредиту;
	Content.BalanceDebitEnd = ДанныеДоговора.СальдоНаКонецПериодаДебет;
	Content.BalanceAmountEnd = ДанныеДоговора.СальдоНаКонецПериодаКредит;
	Content.TotalConsumptionDebit = ДанныеДоговора.СальдоНаКонецПериодаДебет - ДанныеДоговора.СальдоНаКонецПериодаДебетКонтрагент;
	Content.TotalConsumptionAmount = ДанныеДоговора.СальдоНаКонецПериодаКредит - ДанныеДоговора.СальдоНаКонецПериодаКредитКонтрагент;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьDocumentInfoОтветногоТитула(Content, ДанныеДокумента)
	
	НаименованиеДокумента = ДанныеДокумента.НаименованиеДокумента;
	
	Если НЕ ЗначениеЗаполнено(НаименованиеДокумента) Тогда
		НаименованиеДокумента = ДанныеДокумента.НомерДокумента + " от " + Формат(ДанныеДокумента.ДатаДокумента, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	
	СуммаРасхожденийДебет = ДанныеДокумента.СуммаДебет - ДанныеДокумента.СуммаДебетКонтрагент;
	СуммаРасхожденийКредит = ДанныеДокумента.СуммаКредит - ДанныеДокумента.СуммаКредитКонтрагент;
	СуммаРасхождений = СуммаРасхожденийДебет - СуммаРасхожденийКредит;
	
	Content.DocumentName = НаименованиеДокумента;
	Content.DocumentNumber = ДанныеДокумента.НомерДокумента;
	Content.DocumentDate = ДанныеДокумента.ДатаДокумента;
	Content.TotalConsumption = СуммаРасхождений;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьOperationInfoОтветногоТитула(Content, ДанныеОперации)
	
	Content.StringNumber = ДанныеОперации.ПорядковыйНомер;
	Content.OperationDate = ДанныеОперации.ДатаОперации;
