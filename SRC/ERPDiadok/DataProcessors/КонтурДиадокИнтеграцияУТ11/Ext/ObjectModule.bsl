Процедура ДокументыБезСФ_ДобавитьТекстЗапросаПоОтчетуКомитентуОПродажах(Запросы)
	
	ОбъектМетаданных = Метаданные.Документы.ОтчетКомитенту;
	ЗапрещеноЧтениеТаблицыДанныхДокумента = ЗапрещеноЧтениеТаблицыДанныхДокумента(ОбъектМетаданных);
	
	Если ЗапрещеноЧтениеТаблицыДанныхДокумента Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Документ,
	|	0 КАК ВсегоПозиций,
	|	0 КАК ПозицийБезНДС,
	|	ЛОЖЬ КАК ЭтоИсправление,
	|	ЛОЖЬ КАК ЭтоКорректировка
	|ИЗ
	|	Документ.ОтчетКомитенту КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.СпособРасчетаВознаграждения <> ЗНАЧЕНИЕ(Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается)
	|	И Док.СтавкаНДСВознаграждения = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Если Метаданные.Справочники.Найти("СтавкиНДС") <> Неопределено Тогда
		Результат = СтрЗаменить(Результат, "Перечисление.СтавкиНДС", "Справочник.СтавкиНДС");
	КонецЕсли;
	
	ДобавитьТекстЗапросаВПакет(Запросы, Результат);
	
КонецПроцедуры

