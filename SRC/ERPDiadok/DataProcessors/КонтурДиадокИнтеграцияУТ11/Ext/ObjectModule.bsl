Функция УПД970_КонтентТитулаПродавцаПоСчетФактураВыданныйАвансКорректировочный(
	ДокСсылка,
	ФункцияДокумента,
	ДополнительныеПараметры)
	
	Контент = УПД970_НовыйПротоСтруктураУПД970();
	
	СтруктураДанных = УПД970_ИсходныеДанныеСчетФактураВыданныйНаАвансДляТитулаПродавца(ДокСсылка);
	
	ДанныеШапки = СтруктураДанных.ДанныеШапки;
	
	НДСИсчисляетсяНалоговымАгентом = УПД970_НДСИсчисляетсяНалоговымАгентом(ДанныеШапки);
	
	Контент.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;

	УПД970_ЗаполнитьСведенияОПродавцеУстаревший(Контент, ДанныеШапки);
	УПД970_ЗаполнитьСведенияОПокупателеУстаревший(Контент, СтруктураДанных);
	
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	УПД970_ЗаполнитьОбщиеРеквизитыКонтента(Контент, ДанныеШапки, ФункцияДокумента);
	
	РеквизитыПлатежноРасчетногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокСсылка,
		"НомерПлатежноРасчетногоДокумента, ДатаПлатежноРасчетногоДокумента");
		
	PaymentDocument = Контракт_PaymentDocumentInfo();
	PaymentDocument.Number = РеквизитыПлатежноРасчетногоДокумента.НомерПлатежноРасчетногоДокумента;
	PaymentDocument.Date = РеквизитыПлатежноРасчетногоДокумента.ДатаПлатежноРасчетногоДокумента;
	
	Контент.PaymentDocuments.Добавить(PaymentDocument);
		
	УПД970_ЗаполнитьТаблицуКонтентаПоСчетФактураНаАванс(
		Контент,
		СтруктураДанных.РезультатПоТабличнойЧасти,
		НДСИсчисляетсяНалоговымАгентом);
	
	ДокументыОснования = ДокументыОснованияСчетФактураВыданныйНаАванс(ДокСсылка);
	ОснованияОтгрузки = УПЛ970_РеквизитыОснованияОтгрузкиПоДокументам(ДокументыОснования);
	
	УПД970_ЗаполнитьСведенияОПередачеТоваров(Контент, ОснованияОтгрузки, ДополнительныеПараметры);
	
	Возврат Контент;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаНаПеремещениеТоваров(СсылкаНаОбъект, ДополнительныеПараметры)
	
	Валюта = ВалютаРегламентированногоУчета();
	ФункцияДокумента = ФункцияДокумента_ДОП();
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Перемещение.Ссылка КАК Ссылка,
	|	&ВыражениеНомерПеремещения КАК НомерДокумента,
	|	&ВыражениеДатаПеремещения КАК ДатаДокумента,
	|	перемещение.Дата КАК ДатаИсправления,
	|	Перемещение.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА Перемещение.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеремещениеТоваровМеждуФилиалами)
	|			ТОГДА Перемещение.ОрганизацияПолучатель
	|		ИНАЧЕ Перемещение.Организация
	|	КОНЕЦ КАК Контрагент,
	|	Перемещение.СкладОтправитель КАК СкладОтправитель,
	|	Перемещение.СкладПолучатель КАК СкладПолучатель,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Перемещение.СкладОтправитель) КАК СкладОтправительПредставление,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Перемещение.СкладПолучатель) КАК СкладПолучательПредставление,
	|	Перемещение.СкладОтправитель.ТекущийОтветственный КАК КладовщикОтправитель,
	|	Перемещение.СкладОтправитель.ТекущаяДолжностьОтветственного КАК ДолжностьКладовщикаОтправителя,
	|	Перемещение.СкладПолучатель.ТекущийОтветственный КАК КладовщикПолучатель,
	|	Перемещение.СкладПолучатель.ТекущаяДолжностьОтветственного КАК ДолжностьКладовщикаПолучателя,
	|	Перемещение.ВидЦены КАК УчетныйВидЦены,
	|	Перемещение.ВидЦены.ВалютаЦены КАК УчетныйВидЦеныВалютаЦены,
	|	&ВыражениеИсправление КАК Исправление
	|ПОМЕСТИТЬ ТаблицаДанныхДокументов
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК Перемещение
	|ГДЕ
	|	Перемещение.Ссылка = &СсылкаНаОбъект;
	|ВЫБРАТЬ
	|	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	|	ПеремещениеТоваровТовары.НомерСтроки КАК НомерСтроки,
	|	ПеремещениеТоваровТовары.Ссылка КАК Ссылка,
	|	ПеремещениеТоваровТовары.Упаковка КАК Упаковка,
	|	ПеремещениеТоваровТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ПеремещениеТоваровТовары.Количество КАК Количество
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|ГДЕ
	|	ПеремещениеТоваровТовары.Ссылка = &СсылкаНаОбъект
	|";
	
	ВыражениеНомерПеремещения = "Перемещение.Номер";
	ВыражениеДатаПеремещения = "Перемещение.Дата";
	ВыражениеИсправление = "ЛОЖЬ";
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СсылкаНаОбъект, "ИсправляемыйДокумент") Тогда
		
		ВыражениеНомерПеремещения = "ЕСТЬNULL(Перемещение.ИсправляемыйДокумент.Номер, Перемещение.Номер)";
		ВыражениеДатаПеремещения = "ЕСТЬNULL(Перемещение.ИсправляемыйДокумент.Дата, Перемещение.Дата)";
		ВыражениеИсправление = "Перемещение.Исправление";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеНомерПеремещения", ВыражениеНомерПеремещения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеДатаПеремещения", ВыражениеДатаПеремещения);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВыражениеИсправление", ВыражениеИсправление);
	
	Запрос.Текст = ТекстЗапроса;
	
	Данные = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Шапка = Данные[0].Выбрать();
	Шапка.Следующий();
	
	Если ИспользуетсяУказаниеНаборовВПеремещенияхТоваров() Тогда
		УПД970Служебный_ПоместитьВременнуюТаблицуНаборов_Перемещение(МенеджерВременныхТаблиц);
	КонецЕсли;
	
	МодульПродажиСервер = ОбщийМодульПоИмениЛок("ПродажиСервер");
	МодульПродажиСервер.ПоместитьВременнуюТаблицуКоэффициентыУпаковок(МенеджерВременныхТаблиц);
	
	ИспользуетсяЦенообразование25 = ИспользуетсяЦенообразование25(Шапка.ДатаДокумента);
	
	Если ИспользуетсяЦенообразование25 Тогда
		Запрос = УПД970Служебный_ЗапросВыборкиСтрокТоваров25_Перемещение();
	Иначе
		Запрос = УПД970Служебный_ЗапросВыборкиСтрокТоваров20_Перемещение();
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПеремещениеТоваров", Шапка.Ссылка);
	Запрос.УстановитьПараметр("ДатаДокумента", Шапка.ДатаДокумента);
	Запрос.УстановитьПараметр("УчетныйВидЦены", Шапка.УчетныйВидЦены);
	
	Если ИспользуетсяЦенообразование25 Тогда
		РезультатТовары = Запрос.ВыполнитьПакет()[1].Выгрузить();
	Иначе
		РезультатТовары = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Контент = УПД970_НовыйПротоСтруктураУПД970();
	Контент.Function = ФункцияДокумента;
	Контент.CircumFormatInvoice = "00051";
	Контент.DocumentName = НаименованияДокументов.УПД;
	Контент.Currency = Валюта.Код;
	Контент.DocumentNumber = ПредставлениеНомера(Шапка.НомерДокумента);
	Контент.DocumentDate = Шапка.ДатаДокумента;
	
	Если Шапка.Исправление Тогда
		
		ДатаИсправления = Шапка.ДатаИсправления;
		
		Контент.RevisionNumber = УПД970_ПорядковыйНомерИсправленияПеремещенияТоваров(СсылкаНаОбъект, ДатаИсправления);
		Контент.RevisionDate = ДатаИсправления;
		
	КонецЕсли;
	
	DocumentShipment = УПД970_НовыйDocumentShipments970(
		Контент.DocumentName,
		Контент.DocumentNumber,
		Контент.DocumentDate
	);
	
	Контент.DocumentShipments.Добавить(DocumentShipment);
	
	ПродавецИнфо = УПД970_ДанныеУчастникаЭДО(Шапка.Организация, Шапка.ДатаДокумента);
	ОрганизацияАдрес = СведенияОбЮридическомАдресеОбъекта(Шапка.Организация, Шапка.ДатаДокумента);
	
	ПокупательИнфо = УПД970_ДанныеУчастникаЭДО(Шапка.Контрагент, Шапка.ДатаДокумента);
	КонтрагентАдрес = СведенияОбЮридическомАдресеОбъекта(Шапка.Контрагент, Шапка.ДатаДокумента);
	
	Seller = Контракт_ExtendedOrganizationInfo970();
	УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, ПродавецИнфо, ОрганизацияАдрес);
	Контент.Sellers.Добавить(Seller);
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	УПД970_ЗаполнитьExtendedOrganizationInfo(Buyer, ПокупательИнфо, КонтрагентАдрес);
	Контент.Buyers.Добавить(Buyer);
	
	СкладОтправительАдрес = СведенияОбАдресеСклада(Шапка.СкладОтправитель, Шапка.ДатаДокумента);
	Shipper = Контракт_Shipper970();
	Shipper.SameAsSeller = Ложь;
	Shipper.OrganizationInfo = Контракт_ExtendedOrganizationInfo970();
	УПД970_ЗаполнитьExtendedOrganizationInfo(Shipper.OrganizationInfo, ПродавецИнфо, СкладОтправительАдрес);
	Shipper.OrganizationInfo.СлужебнаяИнформация.Ссылка = Шапка.СкладОтправитель;
	Shipper.OrganizationInfo.Department = Шапка.СкладОтправительПредставление;
	Контент.Shippers.Добавить(Shipper);
	
	СкладПолучательАдрес = СведенияОбАдресеСклада(Шапка.СкладПолучатель, Шапка.ДатаДокумента);
	Consignee = Контракт_ExtendedOrganizationInfo970();
	УПД970_ЗаполнитьExtendedOrganizationInfo(Consignee, ПокупательИнфо, СкладПолучательАдрес);
	Consignee.СлужебнаяИнформация.Ссылка = Шапка.СкладПолучатель;
	Consignee.Department = Шапка.СкладПолучательПредставление;
	Контент.Consignees.Добавить(Consignee);
	
	Table = Контракт_InvoiceTable970();
	Контент.Table = Table;
	
	ТочностьЦены = 2;
	ТочностьКоличества = 3;
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	ВсеСтрокиБезНДС = Истина;
	СтавкаБезНДС = ЗначениеСтавкиБезНДС();
	
	Для Каждого ДанныеТЧ Из РезультатТовары Цикл
		
		Item = Контракт_Item970();
		
		Item.Product = ПредставлениеНоменклатуры(СокрЛП(ДанныеТЧ.ТоварНаименование), СокрЛП(ДанныеТЧ.ХарактеристикаНаименование), "");
		Item.ItemMark = ТипыНоменклатуры.Имущество;
		
		Item.ItemVendorCode = ДанныеТЧ.ТоварКод;
		
		Если ЗначениеЗаполнено(ДанныеТЧ.ЕдиницаИзмеренияНаименование) Тогда
			Item.UnitName = СокрЛП(ДанныеТЧ.ЕдиницаИзмеренияНаименование);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеТЧ.ЕдиницаИзмеренияКодПоОКЕИ) Тогда
			Item.Unit = СокрЛП(ДанныеТЧ.ЕдиницаИзмеренияКодПоОКЕИ);
		КонецЕсли;
		
		Item.Quantity = Окр(ДанныеТЧ.Количество, ТочностьКоличества);
		
		Item.TaxRate = ПредставлениеСтавкиБезНДС();
		
		ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		Если НЕ ЭтоСтавкаБезНДС Тогда
			ВсеСтрокиБезНДС = Ложь;
		КонецЕсли;
		
		Item.Price = Окр(ДанныеТЧ.Цена, ТочностьЦены);
		Item.Vat = 0;
		Item.Subtotal = ДанныеТЧ.Сумма;
		Item.SubtotalWithVatExcluded = Item.Subtotal - Item.Vat;
		
		СлужебнаяИнфо = Контракт_СлужебнаяИнформацияСтроки();
		СлужебнаяИнфо.Упаковка = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "Упаковка");
		СлужебнаяИнфо.ЕдиницаИзмерения = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "ЕдиницаИзмерения");
		СлужебнаяИнфо.Номенклатура = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "Товар");
		СлужебнаяИнфо.СтранаПроисхождения = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "СтранаПроисхождения");
		СлужебнаяИнфо.СтавкаНДС = СтавкаБезНДС;
		СлужебнаяИнфо.НомерГТД = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "НомерГТД");
		СлужебнаяИнфо.ПрослеживаемыйТовар = Ложь;
		СлужебнаяИнфо.Серия = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "Серия");
		СлужебнаяИнфо.Характеристика = СсылочноеЗначениеСвойстваИсточникаДанных(ДанныеТЧ, "Характеристика");
		СлужебнаяИнфо.ДокументОтгрузки = СсылкаНаОбъект;
		
		Item.СлужебнаяИнформация = СлужебнаяИнфо;
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.TotalNet = РезультатТовары.Итог("Количество");
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	Table.Vat = 0;
	Table.Total = РезультатТовары.Итог("Сумма");
	Table.TotalWithVatExcluded = Table.Total - Table.Vat;
	
	TransferInfo = Контракт_TransferInfo970();
	TransferInfo.WithoutTransferBase = Истина;
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferDate = Контент.DocumentDate;
	Контент.TransferInfo = TransferInfo;
	
	УПД970_ЗаполнитьСведенияОСотрудникеУстаревший(Контент, ДополнительныеПараметры);
	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент);
	УПД970_ЗаполнитьСведенияОМаркировке(Контент, СсылкаНаОбъект);
	УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент);
	
	Возврат Контент;
	
КонецФункции

Процедура УПД970Служебный_ПоместитьВременнуюТаблицуНаборов_Перемещение(МенеджерВременныхТаблиц)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтрокиТоваров.Ссылка                                        КАК Ссылка,
		|
		|	ЕСТЬNULL(ВариантыКомплектацииНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.ВариантыКомплектацииНоменклатуры.ПустаяСсылка)) КАК ВариантКомплектацииНоменклатуры,
		|	ЕСТЬNULL(ВариантыКомплектацииНоменклатуры.ВариантПредставленияНабораВПечатныхФормах, ЗНАЧЕНИЕ(Перечисление.ВариантыПредставленияНаборовВПечатныхФормах.ПустаяСсылка)) КАК ВариантПредставленияНабораВПечатныхФормах,
		|	ЕСТЬNULL(ВариантыКомплектацииНоменклатуры.ВариантРасчетаЦеныНабора, ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаЦенНаборов.ПустаяСсылка)) КАК ВариантРасчетаЦеныНабора,
		|
		|	СтрокиТоваров.НоменклатураНабора   КАК НоменклатураНабора,
		|	СтрокиТоваров.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|
		|	СтрокиТоваров.НомерСтроки        КАК НомерСтроки,
		|	СтрокиТоваров.Номенклатура       КАК Номенклатура,
		|	СтрокиТоваров.Характеристика     КАК Характеристика,
		|	СтрокиТоваров.Серия              КАК Серия,
		|	
		|	СтрокиТоваров.Количество         КАК Количество,
		|	СтрокиТоваров.КоличествоУпаковок КАК КоличествоУпаковок,
		|	
		|	СтрокиТоваров.Упаковка КАК Упаковка,
		|	ВЫРАЗИТЬ(&ТекстЗапросаВесНоменклатуры КАК ЧИСЛО(12,3))         КАК МассаНетто
		|
		|ПОМЕСТИТЬ ПеремещениеТоваровТаблицаТоваровДляПреобразования
		|ИЗ
		|	Документ.ПеремещениеТоваров.Товары КАК СтрокиТоваров
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
		|	ПО
		|		СтрокиТоваров.Ссылка = ТаблицаДанныхДокумента.Ссылка
		|	
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
		|		ПО ВариантыКомплектацииНоменклатуры.Владелец = СтрокиТоваров.АналитикаУчетаНаборов.НоменклатураНабора
		|		И ВариантыКомплектацииНоменклатуры.Характеристика = СтрокиТоваров.АналитикаУчетаНаборов.ХарактеристикаНабора
		|		И ВариантыКомплектацииНоменклатуры.Основной
		|
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	НомерСтроки
		//Наборы
		|;
		|/////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаТоваров.Ссылка КАК Ссылка,
		|	ТаблицаТоваров.НоменклатураНабора КАК НоменклатураНабора,
		|	ТаблицаТоваров.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|	МИНИМУМ(ТаблицаТоваров.НомерСтроки) КАК НомерСтроки,
		|	СУММА(ТаблицаТоваров.Количество * ТаблицаТоваров.МассаНетто) КАК МассаНетто
		|ПОМЕСТИТЬ ВременнаяТаблицаНаборыПодготовка
		|ИЗ
		|	ПеремещениеТоваровТаблицаТоваровДляПреобразования КАК ТаблицаТоваров
		|ГДЕ
		|	ТаблицаТоваров.НоменклатураНабора <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаТоваров.Ссылка,
		|	ТаблицаТоваров.НоменклатураНабора,
		|	ТаблицаТоваров.ХарактеристикаНабора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Результат.Ссылка КАК Ссылка,
		|	Результат.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
		|	Результат.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора,
		|	Результат.ВариантПредставленияНабораВПечатныхФормах КАК ВариантПредставленияНабораВПечатныхФормах,
		|	Результат.НоменклатураНабора КАК НоменклатураНабора,
		|	Результат.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|	(ВЫРАЗИТЬ(МИНИМУМ(ВЫБОР
		|				КОГДА Результат.КоличествоПоУмолчанию <> 0
		|						И Результат.ОсновнаяКомплектующая
		|					ТОГДА Результат.Количество / Результат.КоличествоПоУмолчанию
		|				ИНАЧЕ NULL
		|			КОНЕЦ) + 0.5 КАК ЧИСЛО(10, 0))) - 1 КАК Количество,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Результат.КоличествоПоУмолчанию <> 0
		|				ТОГДА Результат.Количество / Результат.КоличествоПоУмолчанию
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК КоэффициентМаксимум,
		|	(ВЫРАЗИТЬ(МИНИМУМ(ВЫБОР
		|				КОГДА Результат.КоличествоПоУмолчанию <> 0
		|					ТОГДА Результат.Количество / Результат.КоличествоПоУмолчанию
		|				ИНАЧЕ NULL
		|			КОНЕЦ) + 0.5 КАК ЧИСЛО(10, 0))) - 1 КАК КоэффициентМинимум
		|ПОМЕСТИТЬ ВременнаяТаблицаНаборыДополнительно
		|ИЗ
		|	(ВЫБРАТЬ
		|		Таблица.Ссылка КАК Ссылка,
		|		Таблица.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
		|		Таблица.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора,
		|		Таблица.ВариантПредставленияНабораВПечатныхФормах КАК ВариантПредставленияНабораВПечатныхФормах,
		|		Таблица.НоменклатураНабора КАК НоменклатураНабора,
		|		Таблица.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|		Таблица.Номенклатура КАК Номенклатура,
		|		Таблица.Характеристика КАК Характеристика,
		|		МАКСИМУМ(Таблица.ОсновнаяКомплектующая) КАК ОсновнаяКомплектующая,
		|		СУММА(Таблица.КоличествоПоУмолчанию) КАК КоличествоПоУмолчанию,
		|		СУММА(Таблица.Количество) КАК Количество
		|	ИЗ
		|		(ВЫБРАТЬ
		|			Товары.Ссылка КАК Ссылка,
		|			Товары.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
		|			Товары.ВариантПредставленияНабораВПечатныхФормах КАК ВариантПредставленияНабораВПечатныхФормах,
		|			Товары.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора,
		|			Товары.НоменклатураНабора КАК НоменклатураНабора,
		|			Товары.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|			Товары.Номенклатура КАК Номенклатура,
		|			Товары.Характеристика КАК Характеристика,
		|			ВЫБОР
		|				КОГДА Товары.ВариантКомплектацииНоменклатуры.НоменклатураОсновногоКомпонента = Товары.Номенклатура
		|						И Товары.ВариантКомплектацииНоменклатуры.ХарактеристикаОсновногоКомпонента = Товары.Характеристика
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ КАК ОсновнаяКомплектующая,
		|			0 КАК КоличествоПоУмолчанию,
		|			Товары.Количество КАК Количество
		|		ИЗ
		|			ПеремещениеТоваровТаблицаТоваровДляПреобразования КАК Товары
		|		ГДЕ
		|			Товары.НоменклатураНабора <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ТаблицаДанныхДокументов.Ссылка,
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка,
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка.ВариантПредставленияНабораВПечатныхФормах,
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка.ВариантРасчетаЦеныНабора,
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец,
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка.Характеристика,
		|			ВариантыКомплектацииНоменклатурыТовары.Номенклатура,
		|			ВариантыКомплектацииНоменклатурыТовары.Характеристика,
		|			ЛОЖЬ,
		|			ВариантыКомплектацииНоменклатурыТовары.Количество,
		|			0
		|		ИЗ
		|			Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|				ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокументов
		|				ПО (ИСТИНА)
		|		ГДЕ
		|			ВариантыКомплектацииНоменклатурыТовары.Ссылка В
		|					(ВЫБРАТЬ
		|						ПеремещениеТоваровТаблицаТоваровДляПреобразования.ВариантКомплектацииНоменклатуры
		|					ИЗ
		|						ПеремещениеТоваровТаблицаТоваровДляПреобразования КАК ПеремещениеТоваровТаблицаТоваровДляПреобразования)) КАК Таблица
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Таблица.Ссылка,
		|		Таблица.ВариантКомплектацииНоменклатуры,
		|		Таблица.ВариантРасчетаЦеныНабора,
		|		Таблица.ВариантПредставленияНабораВПечатныхФормах,
		|		Таблица.НоменклатураНабора,
		|		Таблица.ХарактеристикаНабора,
		|		Таблица.Номенклатура,
		|		Таблица.Характеристика) КАК Результат
		|
		|СГРУППИРОВАТЬ ПО
		|	Результат.Ссылка,
		|	Результат.ВариантКомплектацииНоменклатуры,
		|	Результат.ВариантРасчетаЦеныНабора,
		|	Результат.ВариантПредставленияНабораВПечатныхФормах,
		|	Результат.НоменклатураНабора,
		|	Результат.ХарактеристикаНабора
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	НоменклатураНабора,
		|	ХарактеристикаНабора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблицаНаборыДополнительно.ВариантКомплектацииНоменклатуры КАК ВариантКомплектацииНоменклатуры,
		|	ВЫБОР
		|		КОГДА ВЫРАЗИТЬ(Таблица.Ссылка КАК Документ.ПеремещениеТоваров).ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию)
		|			ТОГДА ВЫБОР
		|					КОГДА ВременнаяТаблицаНаборыДополнительно.ВариантПредставленияНабораВПечатныхФормах = ЗНАЧЕНИЕ(Перечисление.ВариантыПредставленияНаборовВПечатныхФормах.ТолькоНабор)
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВариантыПредставленияНаборовВПечатныхФормах.НаборИКомплектующие)
		|					ИНАЧЕ ВременнаяТаблицаНаборыДополнительно.ВариантПредставленияНабораВПечатныхФормах
		|				КОНЕЦ
		|		ИНАЧЕ ВременнаяТаблицаНаборыДополнительно.ВариантПредставленияНабораВПечатныхФормах
		|	КОНЕЦ КАК ВариантПредставленияНабораВПечатныхФормах,
		|	ВременнаяТаблицаНаборыДополнительно.ВариантРасчетаЦеныНабора КАК ВариантРасчетаЦеныНабора,
		|	Таблица.Ссылка КАК Ссылка,
		|	Таблица.НоменклатураНабора КАК НоменклатураНабора,
		|	Таблица.ХарактеристикаНабора КАК ХарактеристикаНабора,
		|	Таблица.НомерСтроки КАК НомерСтроки,
		|	ЕСТЬNULL(ВременнаяТаблицаНаборыДополнительно.Количество, 1) КАК КоличествоУпаковок,
		|	ЕСТЬNULL(ВременнаяТаблицаНаборыДополнительно.Количество, 1) КАК Количество,
		|	ВЫБОР
		|		КОГДА ВременнаяТаблицаНаборыДополнительно.КоэффициентМинимум = ВременнаяТаблицаНаборыДополнительно.КоэффициентМаксимум
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПолныйНабор,
		|	Таблица.МассаНетто КАК МассаНетто
		|ПОМЕСТИТЬ ВременнаяТаблицаНаборы
		|ИЗ
		|	ВременнаяТаблицаНаборыПодготовка КАК Таблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблицаНаборыДополнительно КАК ВременнаяТаблицаНаборыДополнительно
		|		ПО Таблица.НоменклатураНабора = ВременнаяТаблицаНаборыДополнительно.НоменклатураНабора
		|			И Таблица.ХарактеристикаНабора = ВременнаяТаблицаНаборыДополнительно.ХарактеристикаНабора
		|			И Таблица.Ссылка = ВременнаяТаблицаНаборыДополнительно.Ссылка
		|
