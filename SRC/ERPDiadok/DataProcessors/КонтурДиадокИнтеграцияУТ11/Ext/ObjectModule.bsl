		|	ИНАЧЕ ДанныеДокумента.Договор.ИдентификаторГосКонтракта
		|КОНЕЦ";
		
	Иначе
		
		ИдентификаторГосКонтракта =
		"ВЫБОР
		|	КОГДА ДанныеДокумента.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) ТОГДА
		|		ЕСТЬNULL(ДанныеДокумента.Соглашение.НаправлениеДеятельности.ГосударственныйКонтракт, """")
		|	ИНАЧЕ ДанныеДокумента.Договор.ИдентификаторГосКонтракта
		|КОНЕЦ";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторГосКонтракта", ИдентификаторГосКонтракта);
	
