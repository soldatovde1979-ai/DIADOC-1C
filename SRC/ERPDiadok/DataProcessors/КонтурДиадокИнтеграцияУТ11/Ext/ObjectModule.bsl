КонецФункции

// Создание документа по данным из Диадока
Функция ПолучитьЗаполненныйОбъектДокумента1С(Параметры)
	
	//https://developer.kontur.ru/Docs/Diadoc_UM/func/Poluchit%27_Zapolnennyy_Obyekt_Dokumenta_1S.html
	
	ПроверитьЗаполнитьИдентификаторОперации(Параметры);
	
	Результат = ОсновнойМодуль.НовыйРезультатФункции();
	
	Документ = Параметры.Документ;
	
	ИспользоватьДатуЭД = Параметры.ИспользоватьДатуЭлектронногоДокумента;
	ОтключитьПроверкуСопоставленияНоменклатуры = Параметры.ОтключитьПроверкуСопоставленияНоменклатуры;
	
	Если ОсновнойМодуль.ЭтоАгентскиеФункцииУПДУКД(Документ.Тип.ФункцияДокумента) Тогда
		Результат.ОписаниеОшибки = "Не задана операция для создания учетного документа!";
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторОперации = Параметры.ИдентификаторОперации;
	
	РезультатПроверки = ПроверкаДокументаОснования(Документ, ИдентификаторОперации);
	
	Если НЕ РезультатПроверки.ОписаниеОшибки = "" Тогда
		
		Результат.ОписаниеОшибки = РезультатПроверки.ОписаниеОшибки;
		Возврат Результат;
		
	КонецЕсли;
	
	Параметры.ДополнительныеПараметры.Вставить("ДокументОснование", РезультатПроверки.ОсновнойОбъект);
	
	Результат = ОсновнойМодуль.ТиповойМодуль_СоздатьДокумент(НеИспользуется_ТиповойМодуль, Параметры);
	
	НовыйОбъект = Результат.ОсновнойОбъект;
	
	Ошибки = ЗначениеВМассивЛок(Результат.ОписаниеОшибки);
	
	ПроверитьЗаполнениеДокумента(НовыйОбъект, Ошибки, ОтключитьПроверкуСопоставленияНоменклатуры);
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		
		Результат = РезультатФункцииОшибка(Ошибки);
		// + ШХ 
		// т1к О.Н.Кошелев, 2023-12-11{Автоматизация ЭДО: e1cib/data/Справочник.Карточка?ref=b90f005056bc8d5011ee78923fc51ecb 
		т1кПараметры = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры.ДополнительныеПараметры, "т1кПараметры");
		т1кЭтоРегламентноеСоздание = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(т1кПараметры, "т1кЭтоРегламентноеСоздание", Ложь);
		Если т1кЭтоРегламентноеСоздание Тогда
			Результат.ОсновнойОбъект.ДополнительныеСвойства.Вставить("т1кЕстьОшибкиЗаполнения", Истина);
		Иначе
			Результат.ОсновнойОбъект = Неопределено;	
		КонецЕсли;
		// - ШХ
		Возврат Результат;
		
	КонецЕсли;
	
	Если ИспользоватьДатуЭД
		И НЕ ЭтоФормализованныйАктСверки405(Документ.Тип) Тогда
		
		ДатаДокумента = Документ.Реквизиты.Дата;
		ТекущаяДатаДокумента = НовыйОбъект.Дата;
		НовыйОбъект.Дата = ДатаДокумента;
		Если Год(ДатаДокумента) <> Год(ТекущаяДатаДокумента) Тогда
			НовыйОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.СоздаватьСчетаФактуры Тогда
		
		СоздатьСчетФактуру(НовыйОбъект, Документ, ИспользоватьДатуЭД);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

