Функция АктыСверок_ПечатнаяФорма1С(СсылкаНаОбъект) Экспорт
	
	Если НЕ ЭтоСверкаВзаиморасчетов(СсылкаНаОбъект) Тогда
		
		ТипОбъекта = ТипЗнч(СсылкаНаОбъект);
		
		Ошибка = СтрШаблон(
			"Неожиданный тип параметра 'СсылкаНаОбъект' (%1)",
			Строка(ТипОбъекта)
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	ДокументПечати = Новый Массив;
	ДокументПечати.Добавить(СсылкаНаОбъект);
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
	
	КоллекцияПечатныхФорм = НовыйКоллекцияПечатныхФормДляПечатиДокумента();
	
	АктыСверок_ЗаполнитьКоллекциюПечатныхФорм(КоллекцияПечатныхФорм);
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(СсылкаНаОбъект);
	
	ПараметрыВывода = Контракт_ПараметрыВывода_Печать();
	
	Если ИспользуетсяСверкаВзаиморасчетов2_5_11()
		И ЭтоСверкаВзаиморасчетов2_5_11(СсылкаНаОбъект) Тогда
		
		МенеджерПечати = Документы.СверкаВзаиморасчетов2_5_11;
		
	Иначе
		
		Если ИспользуетсяСверкаВзаиморасчетов2_4() Тогда
			МенеджерПечати = Документы.СверкаВзаиморасчетов2_4;
		Иначе
			МенеджерПечати = Документы.СверкаВзаиморасчетов;
		КонецЕсли;
		
	КонецЕсли;
	
	МенеджерПечати.Печать(
		ДокументПечати,
		ПараметрыПечати,
		КоллекцияПечатныхФорм,
		ОбъектыПечати,
		ПараметрыВывода
	);
	
	Для Каждого Стр Из КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			
			ТабличныйДокумент = Стр.ТабличныйДокумент;
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;

	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ЭтоСверкаВзаиморасчетов(ДокументСсылка)
	
	ТипыДокументовСверкаВзаиморасчетов = Новый Массив;
	
	Если ИспользуетсяСверкаВзаиморасчетов2_4() Тогда
		ТипыДокументовСверкаВзаиморасчетов.Добавить(Тип("ДокументСсылка.СверкаВзаиморасчетов2_4"));
	Иначе
		ТипыДокументовСверкаВзаиморасчетов.Добавить(Тип("ДокументСсылка.СверкаВзаиморасчетов"));
	КонецЕсли;
	
	Если ИспользуетсяСверкаВзаиморасчетов2_5_11() Тогда
		ТипыДокументовСверкаВзаиморасчетов.Добавить(Тип("ДокументСсылка.СверкаВзаиморасчетов2_5_11"));
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Результат = (ТипыДокументовСверкаВзаиморасчетов.Найти(ТипДокумента) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Заполняет мету электронных актов и накладных
//
// Параметры:
//  Мета - Структура - модель меты передаточного документа
//  УчетныйДокумент - ЛюбаяСсылка - основание электронного акта или накладной
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартный обработчик заполнения меты
//
Процедура ПередаточныеДокументы_ЗаполнитьМету(Мета, УчетныйДокумент, СтандартнаяОбработка) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТипОснования = ТипЗнч(УчетныйДокумент);
	
	Если ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоРТУ(Мета, УчетныйДокумент);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоРУиПА(Мета, УчетныйДокумент);
		
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		ПередаточныеДокументы_ЗаполнитьМетуПоАВР(Мета, УчетныйДокумент);
		
	Иначе
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередаточныеДокументы_ЗаполнитьМетуПоРТУ(Мета, УчетныйДокумент)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Шапка.Ссылка КАК Ссылка,
	|	Шапка.Номер КАК Номер,
	|	Шапка.Дата КАК Дата,
	|	Шапка.Валюта КАК Валюта,
	|	Шапка.НалогообложениеНДС КАК НалогообложениеНДС,
	|	МАКСИМУМ(Шапка.СуммаДокумента) КАК СуммаДокумента,
	|	СУММА(ЕСТЬNULL(ТЧ.СуммаНДС, 0)) КАК СуммаНДС
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК ТЧ
	|		ПО Шапка.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Шапка.Ссылка = &СсылкаНаОбъект
	|
	|СГРУППИРОВАТЬ ПО
	|	Шапка.Ссылка,
	|	Шапка.Номер,
	|	Шапка.Дата,
	|	Шапка.Валюта";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", УчетныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Мета.Дата = Выборка.Дата;
	Мета.Номер = ПредставлениеНомера(Выборка.Номер);
	Мета.Сумма = Выборка.СуммаДокумента;
	Мета.СуммаНДС = Выборка.СуммаНДС;
	Мета.ДокументБезНДС = ЭтоПродажаБезНДС(Выборка.НалогообложениеНДС);
	Мета.КодВалюты = КодВалютыПоКлассификатору(Выборка.Валюта);
	
КонецПроцедуры

