Функция РассчитатьСуммуНДС(Сумма, СтавкаНДС, СуммаВключаетНДС = Ложь)
	
	СтавкаНДСЧислом = ЗначениеСтавкиНДСЛок(СтавкаНДС);
	
	Процент100 = 100;
	
	Если СуммаВключаетНДС Тогда
		Результат = Сумма - Сумма / (1 + СтавкаНДСЧислом / Процент100);
	Иначе
		Результат = Сумма * СтавкаНДСЧислом / Процент100;
	КонецЕсли;
	
	Разрядность2 = 2;
	
	Возврат Окр(Результат, Разрядность2);
	
КонецФункции

Функция РассчитатьЦену(Сумма, Количество, РазрядностьЦены)

	Если ЗначениеЗаполнено(Количество) Тогда
		Результат = Окр(Сумма / Количество, РазрядностьЦены);
	Иначе
		Результат = Окр(Сумма, РазрядностьЦены);
	КонецЕсли;
	
	Возврат Результат;
	
