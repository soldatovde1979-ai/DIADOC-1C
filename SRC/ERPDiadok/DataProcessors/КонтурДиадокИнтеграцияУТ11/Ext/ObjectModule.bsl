	ЕстьПолеСодержание = Истина;
	
	ТекстЗапросаВремТаблицыТоваров = Счет29_ТекстЗапросаВременнойТаблицыТоваровЗаказаКлиента();
	ТекстЗапросаВремТаблицыНаборов = Счет29_ТекстЗапросаВременнойТаблицыСНаборами();
	ТекстЗапросаВременнаяТаблицаТоваров = Счет29_ТекстЗапросаВременнойТаблицыТоваровСНаборами(ЕстьПолеСодержание);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаВремТаблицыТоваров);
