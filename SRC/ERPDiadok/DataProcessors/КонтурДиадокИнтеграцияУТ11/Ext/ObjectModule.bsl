Функция АктСверки_ДанныеЮрФизЛица(Участник, ДатаСведений = Неопределено, БанковскийСчет = Неопределено)
	
	Если НЕ ИспользуетсяМодульЭлектронноеВзаимодействиеУТ() Тогда
		
		ТекстОшибки = НСтр("ru='В текущей версии конфигурации нет общего модуля ЭлектронноеВзаимодействиеУТ.'");
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ИнтерфейсУТ = ОбщийМодульПоИмениЛок("ЭлектронноеВзаимодействиеУТ");
	ДанныеУчастникаЭДО = ИнтерфейсУТ.ПолучитьДанныеЮрФизЛица(
		Участник,
		БанковскийСчет,
		ДатаСведений
	);
	
	Результат = АктСверки_Контракт_ДанныеЮрФизЛица();
	
	ЗаполнитьЗначенияСвойств(Результат, ДанныеУчастникаЭДО);

	ЮрФизЛицо = ДанныеУчастникаЭДО.ЮрФизЛицо;
	
	Если ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		Результат.НалоговыйНомерВСтранеРегистрации = АктСверки_НалоговыйНомерВСтранеРегистрации(Участник);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АктСверки_НалоговыйНомерВСтранеРегистрации(Участник)
	
	НалоговыйНомерВСтранеРегистрации = "";
	
	Если ТипЗнч(Участник) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Участник, "НалоговыйНомерВСтранеРегистрации") Тогда
			
			РеквизитыНерезидент = ЗначенияРеквизитовОбъектаЛок(Участник, "НалоговыйНомерВСтранеРегистрации");
			НалоговыйНомерВСтранеРегистрации = РеквизитыНерезидент.НалоговыйНомерВСтранеРегистрации;
			
		ИначеЕсли ЕстьРеквизитИлиСвойствоОбъектаЛок(Участник, "НалоговыйНомер") Тогда
			
			РеквизитыНерезидент = ЗначенияРеквизитовОбъектаЛок(Участник, "НалоговыйНомер");
			НалоговыйНомерВСтранеРегистрации = РеквизитыНерезидент.НалоговыйНомер;
			
		Иначе
			
			НалоговыйНомерВСтранеРегистрации = "";
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Участник) = Тип("СправочникСсылка.Организации") Тогда
		
		Если ЕстьРеквизитИлиСвойствоОбъектаЛок(Участник, "КодВСтранеРегистрации") Тогда
			
			РеквизитыНерезидент = ЗначенияРеквизитовОбъектаЛок(Участник, "КодВСтранеРегистрации");
			НалоговыйНомерВСтранеРегистрации = РеквизитыНерезидент.КодВСтранеРегистрации;
			
		КонецЕсли;
		
	Иначе
		
		НалоговыйНомерВСтранеРегистрации = "";
		
	КонецЕсли;
	
	Возврат НалоговыйНомерВСтранеРегистрации;

КонецФункции

Функция СчетаНаОплату_ДанныеЮрФизЛица(Участник, ДатаСведений = Неопределено, БанковскийСчет = Неопределено)
	
	Если НЕ ИспользуетсяМодульЭлектронноеВзаимодействиеУТ() Тогда
		
		ТекстОшибки = НСтр("ru='В текущей версии конфигурации нет общего модуля ЭлектронноеВзаимодействиеУТ.'");
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ИнтерфейсУТ = ОбщийМодульПоИмениЛок("ЭлектронноеВзаимодействиеУТ");
	
	ДанныеУчастникаЭДО = ИнтерфейсУТ.ПолучитьДанныеЮрФизЛица(
		Участник,
		БанковскийСчет,
		ДатаСведений
	);
	
	Результат = СчетаНаОплату_Контракт_ДанныеЮрФизЛица();
	
