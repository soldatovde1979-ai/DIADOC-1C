Процедура УПД970_ДополнитьСтрокиТоваровВариантамиПредставленияНаборов(ТаблицаТоваров)
	
	ВариантПредставленияНабора = Перечисления.ВариантыПредставленияНаборовВПечатныхФормах.ПустаяСсылка();
	
	Для Каждого СтрокаТоваров Из ТаблицаТоваров Цикл
		
		Если СтрокаТоваров.ЭтоНабор Тогда
			ВариантПредставленияНабора = СтрокаТоваров.ВариантПредставленияНабора;
		КонецЕсли;
		
		Если СтрокаТоваров.ЭтоКомплектующие Тогда
			СтрокаТоваров.ВариантПредставленияНабора = ВариантПредставленияНабора;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция Данные_ШапкаДокумента(Документ, ТекстЗапросаРеквизитовШапки, МенеджерВременныхТаблиц)
	
	Данные_ПоместитьВременнуюТаблицуОбщихДанныхДокументов(Документ, МенеджерВременныхТаблиц);
	Данные_ПоместитьВременнуюТаблицуДанныхПоставщика(МенеджерВременныхТаблиц);
	
	Запрос = Новый Запрос(ТекстЗапросаРеквизитовШапки);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета());
	
	ТаблицаДанныеШапки = Запрос.Выполнить().Выгрузить();
	Результат = СтрокаТаблицыЗначенийВСтруктуруЛок(ТаблицаДанныеШапки[0]);
	
	Возврат Результат;
	
КонецФункции

Функция Данные_ШапкаКорректировкиРеализации(Документ, ТекстЗапросаРеквизитовШапки, МенеджерВременныхТаблиц)
	
	ТекстЗапросаДанныеДокумента = УПД970_ТекстЗапросаДанныхДокументаКорректировкиРеализации();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаДанныеДокумента;
	Запрос.УстановитьПараметр("Ссылка", Документ);
	Запрос.Выполнить();
	
	Данные_ПоместитьВременнуюТаблицуДанныхПоставщика(МенеджерВременныхТаблиц);
	
	Запрос.Текст = ТекстЗапросаРеквизитовШапки;
	
	ТаблицаДанныеШапки = Запрос.Выполнить().Выгрузить();
	Результат = СтрокаТаблицыЗначенийВСтруктуруЛок(ТаблицаДанныеШапки[0]);

	Возврат Результат;
	
КонецФункции

Процедура Данные_ПоместитьВременнуюТаблицуОбщихДанныхДокументов(Документ, МенеджерВременныхТаблиц)
	
	ВалютаРеглУчета = ВалютаРегламентированногоУчета();
	
	ТекстЗапроса = ТекстЗапроса_ОбщиеДанныеДокумента(Документ.Метаданные().Имя);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Ссылка", Документ); 
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРеглУчета);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура Данные_АктуализироватьРасчетыСКонтрагентами(Документ, ВалютаДокумента)
	
	ЕстьНоваяАрхитектураВзаиморасчетов = ЕстьНоваяАрхитектураВзаиморасчетов();
	Если ВалютаДокумента <> ВалютаРегламентированногоУчета()
		И ЕстьНоваяАрхитектураВзаиморасчетов Тогда
		
		// BSLLS:SetPrivilegedMode-off
		УстановитьПривилегированныйРежим(Истина);
		// BSLLS:SetPrivilegedMode-on
		
		МассивДокументов = ЗначениеВМассивЛок(Документ);
		
		Если ЭтоВерсияТорговойПодсистемы_11_5() Тогда
			РегистрыСведений["СуммыДокументовВВалютахУчета"].РассчитатьСуммыДокументовВВалютахУчета(МассивДокументов);
		Иначе
			РегистрыСведений["СуммыДокументовВВалютеРегл"].РассчитатьСуммыДокументовВВалютеРегл(МассивДокументов);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

