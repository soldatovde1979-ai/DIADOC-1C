Функция ВыбытиеМаркируемойПродукцииДляСобственныхНужд(ДокументСсылка)
	
	Результат = Ложь;
	
	Если ОтсутствуетУчетВыбытияМаркируемойПродукции() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса_ВыбытиеМаркируемойПродукцииДляСобственныхНуждПоСчетФактуре();
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ВыбытиеМаркируемойПродукции;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ПризнакВыбытия = Перечисления.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд;
		Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ВариантВыбытияМаркируемойПродукции");
		
		Результат = (Значение = ПризнакВыбытия);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокументСсылка) Тогда
		
		ПризнакВыбытия = Перечисления.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд;
		Значение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка.ДокументОснование, "ВариантВыбытияМаркируемойПродукции");
		
		Результат = (Значение = ПризнакВыбытия);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтсутствуетУчетВыбытияМаркируемойПродукции()
	
	ВерсияУТ = ВерсияТорговойПодсистемы();
	
	Если ЭтоВерсияТорговойПодсистемы_11_5() Тогда
		НачальнаяВерсияУТ = "11.5.7.288";
	Иначе
		НачальнаяВерсияУТ = "11.4.14.95";
	КонецЕсли;
	
	Результат = Ядро.СравнитьВерсии(ВерсияУТ, НачальнаяВерсияУТ) < 0;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ВыбытиеМаркируемойПродукцииДляСобственныхНуждПоСчетФактуре()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ДокументыОснования.ДокументОснование ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА ВЫРАЗИТЬ(ДокументыОснования.ДокументОснование КАК Документ.КорректировкаРеализации).ДокументОснование
	|		ИНАЧЕ ДокументыОснования.ДокументОснование
	|	КОНЕЦ КАК ПервичныйДокумент
	|ПОМЕСТИТЬ ВТ_ПервичныеДокументы
	|ИЗ
	|	Документ.СчетФактураВыданный.ДокументыОснования КАК ДокументыОснования
	|ГДЕ
	|	ДокументыОснования.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПервичныеДокументы.ПервичныйДокумент КАК ПервичныйДокумент,
	|	ВЫБОР
	|		КОГДА ВТ_ПервичныеДокументы.ПервичныйДокумент ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(ВТ_ПервичныеДокументы.ПервичныйДокумент КАК Документ.РеализацияТоваровУслуг).ВариантВыбытияМаркируемойПродукции
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ВариантВыбытияМаркируемойПродукции
	|ПОМЕСТИТЬ ВТ_ВариантыВыбытияМаркируемойПродукции
	|ИЗ
	|	ВТ_ПервичныеДокументы КАК ВТ_ПервичныеДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ВТ_ВариантыВыбытияМаркируемойПродукции.ВариантВыбытияМаркируемойПродукции = ЗНАЧЕНИЕ(Перечисление.ВариантыВыбытияМаркируемойПродукции.ИспользованиеПокупателемДляСобственныхНужд)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ВыбытиеМаркируемойПродукции
	|ИЗ
	|	ВТ_ВариантыВыбытияМаркируемойПродукции КАК ВТ_ВариантыВыбытияМаркируемойПродукции";
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СчетНаОплату29

Функция СчетФНС29(Знач СсылкаНаОбъект) Экспорт
	
	ТипПараметра = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипПараметра = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		Контент = Счет29_СчетНаОплату(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Контент = Счет29_ЗаказКлиента(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Контент = Счет29_РеализацияТоваровУслуг(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
		Контент = Счет29_РеализацияУслугПрочихАктивов(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Контент = Счет29_КорректировкаРеализации(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		Контент = Счет29_АктВыполненныхРабот(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом") Тогда
		Контент = Счет29_ВыкупВозвратнойТарыКлиентом(СсылкаНаОбъект);
	Иначе
		Ошибка = СтрШаблон("Неожиданный тип документа (%1)", ТипЗнч(СсылкаНаОбъект));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Возврат Контент;
	
КонецФункции

Функция Счет29_СчетНаОплату(СсылкаНаОбъект)
	
	ДанныеСчета = Счет29_ИсходныеДанныеСчетаНаОплату(СсылкаНаОбъект);
	
	ДанныеШапки = ДанныеСчета.ДанныеШапки;
	ТабличныеДанные = ДанныеСчета.ТабличныеДанные;
	ГрафикПлатежей = ДанныеСчета.ГрафикПлатежей;

	Content = Счет29_НовыйКонтент(ДанныеШапки);
	Content.Table = Счет29_НовыйTable(
		ТабличныеДанные,
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
		ДанныеШапки.ЦенаВключаетНДС);
	
	ProformaInvoiceAdditionalInfo = Content.ProformaInvoiceAdditionalInfo;
	ProformaInvoiceAdditionalInfo.DateRestriction = Счет29_ОграничениеПоСрокуОплаты(ГрафикПлатежей);
	
	Для Каждого ЭтапГрафикаОплаты Из ГрафикПлатежей Цикл
		ПредставлениеЭтапа = Счет29_НовыйPaymentTermПоСчету(ЭтапГрафикаОплаты);
		Content.ProformaInvoiceAdditionalInfo.PaymentTerms.Добавить(ПредставлениеЭтапа);
	КонецЦикла;
		
	BaseInfo = Счет29_НовыйBaseInfo(ДанныеШапки.ДокументОснование);
	Если ЗначениеЗаполнено(BaseInfo) Тогда
		Content.ProformaInvoiceBases.Добавить(BaseInfo);
	КонецЕсли;
	
	Возврат Content;
	
КонецФункции

Функция Счет29_ЗаказКлиента(СсылкаНаОбъект)
	
	ДанныеДокумента = Счет29_ИсходныеДанныеЗаказаКлиента(СсылкаНаОбъект);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТабличныеДанные = ДанныеДокумента.ТабличныеДанные;
	ГрафикОплаты = ДанныеДокумента.ГрафикОплаты;
	
	Content = Счет29_НовыйКонтент(ДанныеШапки);
	Content.Table = Счет29_НовыйTable(
		ТабличныеДанные,
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
		ДанныеШапки.ЦенаВключаетНДС);
	
	ЕстьТовары = УПД970_СодержитТовары(ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		Счет29_ЗаполнитьСведенияОГрузоотправителе(
			Content.Shipper,
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетГрузоотправителя,
			ДанныеШапки.КПППоставщика);
			
		Счет29_ЗаполнитьСведенияОГрузополучателе(
			Content.Consignee,
			ДанныеШапки.Грузополучатель,
