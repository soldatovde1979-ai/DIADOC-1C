Функция Счет29_НовыйPaymentTermПоДокументуПродажи(ЭтапГрафикаОплаты)
	
	ЭлементыСтроки = Новый Массив;
	ЭлементыСтроки.Добавить(Строка(ЭтапГрафикаОплаты.ВариантОплаты));
	ЭлементыСтроки.Добавить(Формат(ЭтапГрафикаОплаты.ДатаПлатежа, "ДФ=dd.MM.yy"));
	ЭлементыСтроки.Добавить(Формат(ЭтапГрафикаОплаты.ПроцентПлатежа, "ЧФ=Ч%"));
	ЭлементыСтроки.Добавить(Формат(ЭтапГрафикаОплаты.СуммаПлатежа, "ЧЦ=15; ЧДЦ=2; ЧРД=,"));
	ЭлементыСтроки.Добавить(СокрЛП(ЭтапГрафикаОплаты.ВалютаНаименование));
	
	Результат = СокрЛП(СтрСоединить(ЭлементыСтроки, " "));
	
	Возврат Результат;
	
КонецФункции

Процедура Счет29_ЗаполнитьСуммыБезУчетаСкидки(Item, СтавкаНДС, ЭтоНДСИНА, ЦенаВключаетНДС, РазрядностьЦены)
	
	Если ЗначениеЗаполнено(Item.DiscountSum) Тогда
		
		Item.SubtotalWithoutVatAndDiscount = Item.SubtotalWithVatExcluded + Item.DiscountSum;
		
		СуммаНДССкидки = 0;
		Item.VatWithoutDiscount = 0;
		
		Если Не ЭтоНДСИНА Тогда
			Item.VatWithoutDiscount = РассчитатьСуммуНДС(Item.SubtotalWithoutVatAndDiscount, СтавкаНДС);
			СуммаНДССкидки = РассчитатьСуммуНДС(Item.DiscountSum, СтавкаНДС);
		КонецЕсли;
		
		СуммаСНДСБезСкидки = Item.Subtotal + Item.DiscountSum;
		Если Не ЦенаВключаетНДС Тогда
			СуммаСНДСБезСкидки = СуммаСНДСБезСкидки + СуммаНДССкидки;
		КонецЕсли;
		
		Item.SubtotalWithoutDiscount = СуммаСНДСБезСкидки;
		Item.PriceWithoutDiscount = РассчитатьЦену(Item.SubtotalWithoutVatAndDiscount, Item.Quantity, РазрядностьЦены);
		
	Иначе
		
		Item.PriceWithoutDiscount = Item.Price;
		Item.VatWithoutDiscount = Item.Vat;
		
	КонецЕсли;
	
КонецПроцедуры

Функция Счет29_ПредставлениеНоменклатуры(
	НоменклатураНаименованиеПолное,
	НоменклатураНаименование,
	ХарактеристикаНаименование,
	Содержание)
	
	Если ЗначениеЗаполнено(Содержание) Тогда
		
		Результат = Содержание;
		
	Иначе
		
		Если ЗначениеЗаполнено(ХарактеристикаНаименование) Тогда
			ПредставлениеНоменклатуры = "%НаименованиеНоменклатуры% (%ТекстВСкобках%)";
			ПредставлениеНоменклатуры = СтрЗаменить(ПредставлениеНоменклатуры, "%ТекстВСкобках%", ХарактеристикаНаименование);
		Иначе
			ПредставлениеНоменклатуры = "%НаименованиеНоменклатуры%";
		КонецЕсли;
		
		НаименованиеНоменклатуры = НоменклатураНаименованиеПолное;
		Если Не ЗначениеЗаполнено(НаименованиеНоменклатуры) Тогда
			НаименованиеНоменклатуры = НоменклатураНаименование;
		КонецЕсли;
		
		Результат = СтрЗаменить(ПредставлениеНоменклатуры, "%НаименованиеНоменклатуры%", НаименованиеНоменклатуры);
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

