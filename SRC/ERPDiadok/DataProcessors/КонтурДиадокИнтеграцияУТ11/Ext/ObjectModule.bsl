	|			ТОГДА ДанныеДокумента.Дата
	|		ИНАЧЕ СчетФактура.Дата
	|	КОНЕЦ КАК Дата,
	|
	|	ВЫБОР 
	|		КОГДА ЕСТЬNULL(ДанныеДокумента.НалогообложениеНДС, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НДСИсчисляетсяНалоговымАгентом,
	|	ДанныеДокумента.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеДокумента.Организация КАК Поставщик,
	|	ДанныеДокумента.БанковскийСчет КАК БанковскийСчетОрганизации,

	|	ЕСТЬNULL(ДокументПриобретениеТоваровУслуг.Контрагент.КПП, """") КАК КПППоставщика,
	|
	|	ЕСТЬNULL(ДокументПриобретениеТоваровУслуг.Контрагент, ДанныеДокумента.Организация) КАК Контрагент,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетКонтрагента,

	|	ДокументПриобретениеТоваровУслуг.Контрагент КАК Грузоотправитель,
	|	ДанныеДокумента.Организация КАК Грузополучатель,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетГрузополучателя,
	|	НЕОПРЕДЕЛЕНО КАК БанковскийСчетГрузоотправителя,
	
	|	ДанныеДокумента.Договор КАК Договор,
	|	ЕСТЬNULL(ДанныеДокумента.Договор.ТипДоговора, ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.ПустаяСсылка)) КАК ТипДоговора,
	|	ДанныеДокумента.Соглашение КАК Соглашение,
	|	&ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,

	|	ДанныеДокумента.Организация.КПП КАК КПППокупателя,
	|
	|	"""" КАК АдресДоставки,
	|	"""" КАК АдресДоставкиЗначенияПолей,
	|
	|	&ОплатаВВалюте КАК ОплатаВВалюте,
	|
	|	ДанныеДокумента.Валюта КАК ВалютаДокумента,
	|	ДанныеДокумента.Валюта.Код КАК ВалютаДокументаКод,
	|
	|	"""" КАК Основание,
	|	"""" КАК ОснованиеНомер,
	|	НЕОПРЕДЕЛЕНО КАК ОснованиеДата,
	|
	|	ЕСТЬNULL(ДанныеПоставщика.ИндексПодразделения, 0) КАК ИндексПодразделения,
	|	ДанныеПоставщика.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|
	|	"""" КАК СведенияОТранспортировкеИГрузе
	|ИЗ
	|	Документ.ОтчетКомитентуОЗакупках КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|		ПО ДанныеДокумента.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоставщика КАК ДанныеПоставщика
	|		ПО ДанныеДокумента.Ссылка = ДанныеПоставщика.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг КАК ДокументПриобретениеТоваровУслуг
	|		ПО ДокументПриобретениеТоваровУслуг.Ссылка = ДанныеДокумента.ДокументПриобретения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК Договоры
	|		ПО Договоры.Ссылка = ДанныеДокумента.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактура
	|		ПО СчетФактура.ДокументОснование = ДанныеДокумента.Ссылка
	|			И СчетФактура.Перевыставленный";

	УПД970_ЗаполнитьВТекстеЗапросаВыражениеОплатаВВалюте(Результат);
	УПД970_ЗаполнитьВТекстеЗапросаПараметрИдентификаторГосКонтракта(Результат);
	
	Возврат Результат;
	
