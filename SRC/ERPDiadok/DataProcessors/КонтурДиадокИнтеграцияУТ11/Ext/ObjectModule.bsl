Функция СведенияОбАдресеЛок(АдресСтрокойJSON)

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("БезПредставлений", Ложь);
	ДопПараметры.Вставить("КодыАдреса", Истина);
	ДопПараметры.Вставить("КодыКЛАДР", Ложь);
	ДопПараметры.Вставить("ПолныеНаименованияСокращений", Ложь);
	ДопПараметры.Вставить("НаименованиеВключаетСокращение", Ложь);
	ДопПараметры.Вставить("ПроверитьАдрес", Ложь);
	
	ВерсияБСП = ВерсияБиблиотекиСтандартныхПодсистем();
	Если СравнитьВерсии_(ВерсияБСП, "2.4") >= 0 Тогда
		ИмяМодуля = "РаботаСАдресами";
	Иначе 
		ИмяМодуля = "УправлениеКонтактнойИнформацией";
	КонецЕсли;
	
	МодульРаботыСАдресами = ОбщийМодульПоИмениЛок(ИмяМодуля);
	
	Результат = МодульРаботыСАдресами.СведенияОбАдресе(АдресСтрокойJSON, ДопПараметры);
	
	Возврат Результат;
	
КонецФункции

Функция СсылочноеЗначениеСвойстваИсточникаДанных(ИсточникДанных, КаноничноеИмяСвойства)
	
	Результат = Неопределено;
	
	ПроверяемыеСвойства = Новый Массив;
	ПроверяемыеСвойства.Добавить(КаноничноеИмяСвойства);
	ПроверяемыеСвойства.Добавить(КаноничноеИмяСвойства + "Ссылка");
	
	Для Каждого ИмяСвойства Из ПроверяемыеСвойства Цикл 
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ИсточникДанных, ИмяСвойства)
		И ОбщегоНазначения.ЗначениеСсылочногоТипа(ИсточникДанных[ИмяСвойства]) Тогда 
			
			Результат = ИсточникДанных[ИмяСвойства];
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
