Функция ТекстЗапроса_ВременнаяТаблицаДанныхПоставщика()

	Результат = 
	"ВЫБРАТЬ
	|	ТаблицаДанныхДокумента.Ссылка КАК Ссылка,
	|	
	|	ВЫБОР КОГДА СправочникОрганизации.ОбособленноеПодразделение ТОГДА
	|		СправочникОрганизации.ГоловнаяОрганизация
	|	ИНАЧЕ
	|		СправочникОрганизации.Ссылка
	|	КОНЕЦ КАК ГоловнаяОрганизация,
	|
	|	&КПППоставщика КАК КПППоставщика,
	|
	|	ВЫБОР КОГДА НЕ ДанныеПодразделений.РегистрацияВНалоговомОргане.Ссылка ЕСТЬ NULL ТОГДА
	|		ДанныеПодразделений.РегистрацияВНалоговомОргане.ЦифровойИндексОбособленногоПодразделения
	|	КОГДА ЕСТЬNULL(СправочникОрганизации.ОбособленноеПодразделение, ЛОЖЬ) ТОГДА
	|		СправочникОрганизации.ЦифровойИндексОбособленногоПодразделения
	|	ИНАЧЕ
	|		0
	|	КОНЕЦ КАК ИндексПодразделения,
	|	
	|	ЕСТЬNULL(ДанныеПодразделений.РегистрацияВНалоговомОргане, ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)) КАК РегистрацияВНалоговомОргане,
	|	ЕСТЬNULL(ДанныеПодразделений.НаименованиеОбособленногоПодразделения, """") КАК НаименованиеОбособленногоПодразделения,
	|	ЕСТЬNULL(ДанныеПодразделений.АдресОбособленногоПодразделения, """") КАК АдресОбособленногоПодразделения
	|
	|ПОМЕСТИТЬ ДанныеПоставщика
	|ИЗ
	|	ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Справочник.Организации КАК СправочникОрганизации
	|	ПО
	|		ТаблицаДанныхДокумента.Организация = СправочникОрганизации.Ссылка
	|	
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ДанныеПодразделений КАК ДанныеПодразделений
	|	ПО
	|		ДанныеПодразделений.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|		И ДанныеПодразделений.Организация = ТаблицаДанныхДокумента.Организация
	|		И (ДанныеПодразделений.Подразделение = ТаблицаДанныхДокумента.Склад.Подразделение
	|			ИЛИ ДанныеПодразделений.Подразделение = ТаблицаДанныхДокумента.Подразделение)
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ДанныеОрганизаций КАК ДанныеОрганизаций
	|	ПО
	|		ДанныеОрганизаций.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|		И ДанныеОрганизаций.Организация = ТаблицаДанныхДокумента.Организация
	|	
	|	&ТаблицаДанныхКрупнейшегоНалогоплательщика
	|";

	Если СравнитьВерсии_(ВерсияТорговойПодсистемы(), "11.5.19") >= 0 Тогда
		
		ТекстЗаменыПоляЗапроса = 
		"	ВЫБОР
		|		КОГДА СправочникОрганизации.КрупнейшийНалогоплательщик
		|				И НЕ СправочникОрганизации.ОбособленноеПодразделение
		|				И НЕ КрупнейшийНалогоплательщикДанныеОрганизаций.РегистрацияВНалоговомОргане.КПП ЕСТЬ NULL
		|				И (ДанныеПодразделений.РегистрацияВНалоговомОргане.Ссылка ЕСТЬ NULL
		|					ИЛИ ДанныеПодразделений.РегистрацияВНалоговомОргане = ДанныеОрганизаций.РегистрацияВНалоговомОргане) ТОГДА
		|				КрупнейшийНалогоплательщикДанныеОрганизаций.РегистрацияВНалоговомОргане.КПП
		|		КОГДА НЕ ДанныеПодразделений.РегистрацияВНалоговомОргане.Ссылка ЕСТЬ NULL ТОГДА
		|			ДанныеПодразделений.РегистрацияВНалоговомОргане.КПП
		|		КОГДА НЕ ДанныеОрганизаций.РегистрацияВНалоговомОргане.Ссылка ЕСТЬ NULL ТОГДА
		|			ДанныеОрганизаций.РегистрацияВНалоговомОргане.КПП
		|		ИНАЧЕ
		|			СправочникОрганизации.КПП
		|	КОНЕЦ";
		
		ТекстЗаменыСоединения = "
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|		КрупнейшийНалогоплательщикДанныеОрганизаций КАК КрупнейшийНалогоплательщикДанныеОрганизаций
		|	ПО
		|		КрупнейшийНалогоплательщикДанныеОрганизаций.Ссылка = ТаблицаДанныхДокумента.Ссылка
		|		И КрупнейшийНалогоплательщикДанныеОрганизаций.Организация = ТаблицаДанныхДокумента.Организация";
		
		Результат = СтрЗаменить(Результат, "&КПППоставщика", ТекстЗаменыПоляЗапроса);
		Результат = СтрЗаменить(Результат, "&ТаблицаДанныхКрупнейшегоНалогоплательщика", ТекстЗаменыСоединения);
		
	Иначе
		
		ТекстЗаменыПоляЗапроса = 
		"	ВЫБОР
		|		КОГДА НЕ ДанныеПодразделений.РегистрацияВНалоговомОргане.Ссылка ЕСТЬ NULL ТОГДА
		|			ДанныеПодразделений.РегистрацияВНалоговомОргане.КПП
		|		КОГДА НЕ ДанныеОрганизаций.РегистрацияВНалоговомОргане.Ссылка ЕСТЬ NULL ТОГДА
		|			ДанныеОрганизаций.РегистрацияВНалоговомОргане.КПП
		|		ИНАЧЕ
		|			СправочникОрганизации.КПП
		|	КОНЕЦ";
		
		ТекстЗаменыСоединения = "";
		
		Результат = СтрЗаменить(Результат, "&КПППоставщика", ТекстЗаменыПоляЗапроса);
		Результат = СтрЗаменить(Результат, "&ТаблицаДанныхКрупнейшегоНалогоплательщика", ТекстЗаменыСоединения);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

