Процедура УПД970_ЗаполнитьВТекстеЗапросаПараметрРеализацииЧерезКомиссионера(ТекстЗапроса)
	
	Если ИспользуетсяРеализацияЧерезКомиссионера() Тогда
		
		ТекстЗамены = 
		"ДанныеДокумента.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияЧерезКомиссионера)
		|	ИЛИ ДанныеДокумента.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияЧерезКомиссионераБезПереходаПраваСобственности)";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеализацияЧерезКомиссионера", ТекстЗамены);
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеализацияЧерезКомиссионера", "ЛОЖЬ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеДокумента.КлиентКонтрагент", "ДанныеДокумента.Контрагент");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьВТекстеЗапросаПараметрыЕдиницыИзмеренияТНВЭД(ТекстЗапроса)
	
	Если СравнитьВерсии_(ВерсияТорговойПодсистемы(), "11.5.19") >= 0 Тогда
		НаименованиеЕдИзмТНВЭД = "ТаблицаТоваров.НомерГТД.ЕдиницаИзмерения.Представление";
		КодЕдИзмТНВЭД = "ТаблицаТоваров.НомерГТД.ЕдиницаИзмерения.Код";
	ИначеЕсли СравнитьВерсии_(ВерсияТорговойПодсистемы(), "11.4.13") < 0 Тогда
		НаименованиеЕдИзмТНВЭД = "ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Представление";
		КодЕдИзмТНВЭД = "ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Код";
	Иначе
		НаименованиеЕдИзмТНВЭД = "ТаблицаТоваров.Номенклатура.ЕдиницаИзмеренияТНВЭД.Представление";
		КодЕдИзмТНВЭД = "ТаблицаТоваров.Номенклатура.ЕдиницаИзмеренияТНВЭД.Код";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаименованиеЕдИзмТНВЭД", НаименованиеЕдИзмТНВЭД);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КодЕдИзмТНВЭД", КодЕдИзмТНВЭД);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьВТекстеЗапросаПараметрИдентификаторГосКонтракта(ТекстЗапроса)
	
	Если СравнитьВерсии_(ВерсияТорговойПодсистемы(), "11.5.10") >= 0 Тогда
		
