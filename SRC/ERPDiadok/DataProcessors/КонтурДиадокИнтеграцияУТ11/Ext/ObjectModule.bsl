	|	ДанныеСтраныПросхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	ТаблицаТоваров.НомерГТД.РегистрационныйНомер КАК РНПТ,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.НомерГТД.РегистрационныйНомер = """"
	|			ТОГДА ТаблицаТоваров.НомерГТД
	|		ИНАЧЕ ТаблицаТоваров.НомерГТД.РегистрационныйНомер
	|	КОНЕЦ												КАК НомерТовара,	
	|	ТаблицаТоваров.КодТНВЭД.Код КАК КодТНВЭД,
	|	ТаблицаТоваров.СуммаПоРНПТ КАК СуммаПоРНПТ,
	|	&КодЕдИзмТНВЭД КАК ЕдиницаИзмеренияКод,
	|	&НаименованиеЕдИзмТНВЭД КАК ЕдиницаИзмеренияНаименование,
	|	ТаблицаТоваров.ОсновноеСредство КАК ОсновноеСредство, 
	|	ТаблицаТоваров.КоличествоПоРНПТ КАК Количество,
	|	РеализацияУслугПрочихАктивовДоходы.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_РУиПА_Предварительная
	|ИЗ
	|	Документ.РеализацияУслугПрочихАктивов.ПрослеживаемыеТовары КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РеализацияУслугПрочихАктивовТаблицаТоваров КАК РеализацияУслугПрочихАктивовТаблицаТоваров
	|			ПО ТаблицаТоваров.Ссылка = РеализацияУслугПрочихАктивовТаблицаТоваров.Ссылка
	|			И ТаблицаТоваров.ОсновноеСредство = РеализацияУслугПрочихАктивовТаблицаТоваров.АналитикаДоходов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК ДанныеСтраныПросхождения
	|		ПО ТаблицаТоваров.НомерГТД.СтранаПроисхождения = ДанныеСтраныПросхождения.Ссылка 	
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияУслугПрочихАктивов.Доходы КАК РеализацияУслугПрочихАктивовДоходы
	|		ПО (ТаблицаТоваров.Ссылка = РеализацияУслугПрочихАктивовДоходы.Ссылка)
	|			И (ТаблицаТоваров.ОсновноеСредство = РеализацияУслугПрочихАктивовДоходы.АналитикаДоходов)
	|ГДЕ
	|	ЕСТЬNULL(ТаблицаТоваров.НомерГТД.ТипНомераГТД, ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.ПустаяСсылка)) В
	|			(ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТ),
	|			ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РУиПА_Предварительная.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ_РУиПА_Предварительная.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_РУиПА_БазаРаспределения
	|ИЗ
	|	ВТ_РУиПА_Предварительная КАК ВТ_РУиПА_Предварительная
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РУиПА_Предварительная.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РУиПА_Предварительная.НомерСтроки КАК НомерСтроки,
	|	ВТ_РУиПА_Предварительная.НомерГТД КАК НомерГТД,
	|	ВТ_РУиПА_Предварительная.СтранаПроисхожденияКод КАК СтранаПроисхожденияКод,
	|	ВТ_РУиПА_Предварительная.СтранаПроисхожденияНаименование КАК СтранаПроисхожденияНаименование,
	|	ВТ_РУиПА_Предварительная.РНПТ КАК РНПТ,
	|	ВТ_РУиПА_Предварительная.НомерТовара КАК НомерТовара,
	|	ВТ_РУиПА_Предварительная.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_РУиПА_Предварительная.ЕдиницаИзмеренияКод КАК ЕдиницаИзмеренияКод,
	|	ВТ_РУиПА_Предварительная.ЕдиницаИзмеренияНаименование КАК ЕдиницаИзмеренияНаименование,
    |	ВЫРАЗИТЬ(СУММА(ВЫБОР
	|		КОГДА ВТ_РУиПА_Предварительная.СуммаПоРНПТ <> 0
	|			ТОГДА ВТ_РУиПА_Предварительная.СуммаПоРНПТ
	|		КОГДА ВТ_РУиПА_БазаРаспределения.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_РУиПА_Предварительная.Сумма / ВТ_РУиПА_БазаРаспределения.Количество * ВТ_РУиПА_Предварительная.Количество
	|	КОНЕЦ) КАК ЧИСЛО (19, 2)) КАК СуммаПоРНПТ,
	|	СУММА(ВТ_РУиПА_Предварительная.Количество) КАК Количество
	|ИЗ
	|	ВТ_РУиПА_Предварительная КАК ВТ_РУиПА_Предварительная
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РУиПА_БазаРаспределения КАК ВТ_РУиПА_БазаРаспределения
	|		ПО ВТ_РУиПА_Предварительная.ОсновноеСредство = ВТ_РУиПА_БазаРаспределения.ОсновноеСредство
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_РУиПА_Предварительная.НомерСтроки,
	|	ВТ_РУиПА_Предварительная.НомерГТД,
	|	ВТ_РУиПА_Предварительная.СтранаПроисхожденияКод,
	|	ВТ_РУиПА_Предварительная.СтранаПроисхожденияНаименование,
	|	ВТ_РУиПА_Предварительная.РНПТ,
	|	ВТ_РУиПА_Предварительная.НомерТовара,
	|	ВТ_РУиПА_Предварительная.КодТНВЭД,
	|	ВТ_РУиПА_Предварительная.ЕдиницаИзмеренияКод,
	|	ВТ_РУиПА_Предварительная.ЕдиницаИзмеренияНаименование";
	
	УПД970_ЗаполнитьВТекстеЗапросаПараметрыЕдиницыИзмеренияТНВЭД(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ТекстЗапросаРеквизитовШапкиОтчетаКомитентуОЗакупках_Вознаграждение()

	Результат =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Ссылка КАК Ссылка,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.Контрагент.ОбособленноеПодразделение
	|			ТОГДА ДанныеДокумента.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ ДанныеДокумента.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|
	|	ВЫБОР 
	|		КОГДА ЕСТЬNULL(ДанныеДокумента.НалогообложениеНДС, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НДСИсчисляетсяНалоговымАгентом,
	|	ЛОЖЬ КАК ЦенаВключаетНДС,
	|	ДанныеДокумента.Организация КАК Организация,
	|	ДанныеПоставщика.ГоловнаяОрганизация КАК Поставщик,
	|	ДанныеПоставщика.КПППоставщика КАК КПППоставщика,
	|	""""                           КАК КПППокупателя,
	|	ДанныеПоставщика.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	
