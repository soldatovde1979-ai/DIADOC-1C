Процедура АктСверки405_ЗаполнитьТабличнуюЧастьТитулаОтправителя(Content, ВыборкаПоДоговорам)
	
	ТекущиеПоля = Новый Структура("ИдентификаторДоговора, ИдентификаторДокумента, ПорядковыйНомер");
	ТекущиеПоля.ИдентификаторДоговора = "";
	ContractInfo = Неопределено;
	НоваяСтрокаВторогоУровня = Неопределено;
	
	ReconciliationActTable = Новый_SenderReconciliationActTable();
	
	Пока ВыборкаПоДоговорам.Следующий() Цикл
		
		ЕстьИзмененияГруппировки = Ложь;
		
		Если ТекущиеПоля.ИдентификаторДоговора <> ВыборкаПоДоговорам.ИдентификаторДоговора Тогда
			
			ContractInfo = Новый_SenderContractInfo_ReconciliationAct();
			
			АктСверки405_ЗаполнитьContractInfoТитулаОтправителя(ContractInfo, ВыборкаПоДоговорам);
			
			ReconciliationActTable.ContractInfo.Добавить(ContractInfo);
			
			ЕстьИзмененияГруппировки = Истина;
			
		КонецЕсли;
		
		Если ContractInfo <> Неопределено
			И (ТекущиеПоля.ИдентификаторДокумента <> ВыборкаПоДоговорам.ИдентификаторДокумента
				Или ЕстьИзмененияГруппировки) Тогда
			
			DocumentInfo = Новый_SenderDocumentInfo_ReconciliationAct();
			
			Если ПустаяСтрока(ВыборкаПоДоговорам.НаименованиеДокумента) Тогда
				ДанныеДокумента = АктСверки405_ДанныеПустогоДокумента();
			Иначе
				
				ДанныеДокумента = ВыборкаПоДоговорам;
				
				ЕстьИзмененияГруппировки = Истина;
				
			КонецЕсли;
			
			АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(DocumentInfo, ДанныеДокумента);
			
			ContractInfo.DocumentInfo.Добавить(DocumentInfo);
			
		КонецЕсли;
		
		Если DocumentInfo <> Неопределено
			И (ТекущиеПоля.ПорядковыйНомер <> ВыборкаПоДоговорам.ПорядковыйНомер
			Или ЕстьИзмененияГруппировки) Тогда
			
			OperationInfo = Новый_SenderOperationInfo_ReconciliationAct();
			
			Если ВыборкаПоДоговорам.ПорядковыйНомер > 0 Тогда
				ДанныеОперации = ВыборкаПоДоговорам;
			Иначе
				ДанныеОперации = АктСверки405_ДанныеПустойОперации();
			КонецЕсли;
			
			АктСверки405_ЗаполнитьOperationInfoТитулаОтправителя(OperationInfo, ДанныеОперации);
			
			DocumentInfo.OperationInfo.Добавить(OperationInfo);
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекущиеПоля, ВыборкаПоДоговорам);
		
	КонецЦикла;
	
	Если ReconciliationActTable.ContractInfo.Количество() = 0 Тогда
		АктСверки405_НетОборотовЗаПериодТитулОтправителя(ReconciliationActTable);
	КонецЕсли;
	
	Content.ReconciliationAct.ReconciliationActTable = ReconciliationActTable;
	
КонецПроцедуры

Процедура АктСверки405_НетОборотовЗаПериодТитулОтправителя(Content)
	
	ContractInfo = Новый_RecipientContractInfo_ReconciliationAct();
	ДанныеДоговора = АктСверки405_ДанныеПустогоДоговора();
	
	АктСверки405_ЗаполнитьContractInfoТитулаОтправителя(ContractInfo, ДанныеДоговора);
	
	Content.ContractInfo.Добавить(ContractInfo);
	
	DocumentInfo = Новый_RecipientDocumentInfo_ReconciliationAct();
	ДанныеДокумента = АктСверки405_ДанныеПустогоДокумента();
	
	АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(DocumentInfo, ДанныеДокумента);
	
	ContractInfo.DocumentInfo.Добавить(DocumentInfo);
	
	OperationInfo = Новый_RecipientOperationInfo_ReconciliationAct();
	ДанныеОперации = АктСверки405_ДанныеПустойОперации();
	
	АктСверки405_ЗаполнитьOperationInfoТитулаОтправителя(OperationInfo, ДанныеОперации);
	
	DocumentInfo.OperationInfo.Добавить(OperationInfo);
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьContractInfoТитулаОтправителя(Content, ДанныеДоговора)
	
	Content.ContractAdditionalInfo = ДанныеДоговора.ОписаниеДоговора;
	Content.ContractNumber = ДанныеДоговора.НомерДоговора;
	Content.ContractDate = ДанныеДоговора.ДатаДоговора;
	Content.BalanceDebitFrom = ДанныеДоговора.СальдоНаНачалоПериодаДебет;
	Content.BalanceAmountFrom = ДанныеДоговора.СальдоНаНачалоПериодаКредит;
	Content.TurnoverDebit = ДанныеДоговора.ОборотПоДебету;
	Content.TurnoverAmount = ДанныеДоговора.ОборотПоКредиту;
	Content.BalanceDebitEnd = ДанныеДоговора.СальдоНаКонецПериодаДебет;
	Content.BalanceAmountEnd = ДанныеДоговора.СальдоНаКонецПериодаКредит;
	
	Если ДанныеДоговора.ИдентификаторДоговора <> Неопределено Тогда
		Content.ContractId = Строка(ДанныеДоговора.ИдентификаторДоговора.УникальныйИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьDocumentInfoТитулаОтправителя(Content, ДанныеДокумента)
	
	НаименованиеДокумента = ДанныеДокумента.НаименованиеДокумента;
	
	Если НЕ ЗначениеЗаполнено(НаименованиеДокумента) Тогда
		НаименованиеДокумента = ДанныеДокумента.НомерДокумента + " от " + Формат(ДанныеДокумента.ДатаДокумента, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	
	Content.DocumentName = НаименованиеДокумента;
	Content.DocumentNumber = ДанныеДокумента.НомерДокумента;
	Content.DocumentDate = ДанныеДокумента.ДатаДокумента;
	
	Если ДанныеДокумента.ИдентификаторДокумента <> Неопределено Тогда
		Content.DocumentId = Строка(ДанныеДокумента.ИдентификаторДокумента.УникальныйИдентификатор());
	Иначе
		Content.DocumentId = "0";
	КонецЕсли;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьOperationInfoТитулаОтправителя(Content, ДанныеОперации)
	
	Content.StringNumber = ДанныеОперации.ПорядковыйНомер;
	Content.OperationDate = ДанныеОперации.ДатаОперации;
	Content.OperationName = ДанныеОперации.НаименованиеОперации;
	Content.SumDebit = ДанныеОперации.СуммаДебет;
	Content.SumAmount = ДанныеОперации.СуммаКредит;
	
КонецПроцедуры

Процедура АктСверки405_ЗаполнитьИтогиПоТабличнойЧастиТитулаОтправителя(Content, ВыборкаИтогов)
	
	ReconciliationActTable = Content.ReconciliationAct.ReconciliationActTable;
	
