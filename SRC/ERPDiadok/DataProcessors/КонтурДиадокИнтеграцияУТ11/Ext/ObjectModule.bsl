Функция Счет29_ИсходныеДанныеСчетаНаОплату(СсылкаНаОбъект)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстЗапроса = Счет29_ТекстЗапросаРеквизитовШапкиСчетНаОплатуКлиенту();
	ДанныеШапки = Данные_ШапкаДокумента(СсылкаНаОбъект, ТекстЗапроса, МенеджерВременныхТаблиц);
	
	ДокументОснование = ДанныеШапки.ДокументОснование;
	
	Если ЭтоДоговорКонтрагента(ДокументОснование) Тогда
		
		Запрос.Текст = Счет29_ТекстЗапросаТабличныхДанныхСчетаНаОплатуКлиенту();
		ТабличныеДанные = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаТовары Из ТабличныеДанные Цикл
			
			СтрокаТовары.СуммаНДС = РассчитатьСуммуНДС(
				СтрокаТовары.СуммаСНДС,
				СтрокаТовары.СтавкаНДС,
				ДанныеШапки.ЦенаВключаетНДС);
				
			СтрокаТовары.СуммаБезНДС = СтрокаТовары.СуммаСНДС - СтрокаТовары.СуммаНДС;
				
		КонецЦикла;
		
	Иначе
		
		ДанныеОснования = Счет29_ИсходныеДанныеДокументаОснованияСчетНаОплатуКлиенту(ДанныеШапки.ДокументОснование);
		ТабличныеДанные = ДанныеОснования.ТабличныеДанные;
		
		ДанныеШапки.Вставить("ЦенаВключаетНДС", ДанныеОснования.ДанныеШапки.ЦенаВключаетНДС);
		ДанныеШапки.Вставить("НДСИсчисляетсяНалоговымАгентом", ДанныеОснования.ДанныеШапки.НДСИсчисляетсяНалоговымАгентом);

	КонецЕсли;
	
	ТекстЗапроса = Счет29_ТекстЗапросаЭтаповГрафикаОплатыСчетаНаОплату();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);
	
	ГрафикПлатежей = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	Результат.Вставить("ГрафикПлатежей", ГрафикПлатежей);
	
	Возврат Результат;
	
КонецФункции

Функция Счет29_ИсходныеДанныеДокументаОснованияСчетНаОплатуКлиенту(СсылкаНаОбъект)
	
	ТипПараметра = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипПараметра = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Результат = Счет29_ИсходныеДанныеЗаказаКлиента(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Результат = Счет29_ИсходныеДанныеРеализацииТоваровУслуг(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
		Результат = Счет29_ИсходныеДанныеРеализацииУслугПрочихАктивов(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Результат = Счет29_ИсходныеДанныеКорректировкиРеализации(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		Результат = Счет29_ИсходныеДанныеАктаВыполненныхРабот(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом") Тогда
		Результат = Счет29_ИсходныеДанныеВыкупаВозвратнойТарыКлиентом(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		Результат = Счет29_ИсходныеДанныеОтчетаКомитенту(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ОтчетКомиссионера") Тогда
		Результат = Счет29_ИсходныеДанныеОтчетаКомиссионера(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ОтчетДавальцу2_5") Тогда
		Результат = Счет29_ИсходныеДанныеОтчетаДавальцу2_5(СсылкаНаОбъект);
	ИначеЕсли ТипПараметра = Тип("ДокументСсылка.ОтчетДавальцу") Тогда
		Результат = Счет29_ИсходныеДанныеОтчетаДавальцу(СсылкаНаОбъект);
	Иначе
		ШаблонТекстаОшибки = НСтр("ru='Неожиданный тип документа основания по счету: %1'");
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипПараметра);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

