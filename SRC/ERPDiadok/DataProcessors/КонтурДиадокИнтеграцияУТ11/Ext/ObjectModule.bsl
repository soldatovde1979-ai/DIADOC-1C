Функция Счет29_НовыйКонтент(ДанныеШапки)

	Content = Новый_ЭлементПротоКонтента("ProformaInvoice29SellerContent");
	
	Content.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Content.DocumentDate = ДанныеШапки.Дата;
	
	Если ДанныеШапки.ЭтоВалютаПоОКВ Или ДанныеШапки.Валюта = ВалютаРегламентированногоУчета() Тогда
		Content.Currency = ДанныеШапки.ВалютаКод;
		Content.IsConventionalUnit = Ложь;
		Content.ConventionalUnitDefinition = "";
	Иначе
		Content.Currency = "";
		Content.IsConventionalUnit = Истина;
		Content.ConventionalUnitDefinition = ДанныеШапки.ВалютаНаименование;
	КонецЕсли;
	
	РеквизитыПродавца = УПД970_ДанныеУчастникаЭДО(
		ДанныеШапки.Организация,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации);
		
	Если ЗначениеЗаполнено(ДанныеШапки.КПППоставщика) Тогда
		РеквизитыПродавца.КПП = ДанныеШапки.КПППоставщика;
	КонецЕсли;
	
	ЮрАдресПродавца = СведенияОбЮридическомАдресеОбъекта(ДанныеШапки.Организация, ДанныеШапки.Дата);
	
	Content.Seller = Счет29_НовыйOrganizationInfo(РеквизитыПродавца, ЮрАдресПродавца);
	
	БанковскийСчетКонтрагента = СвойствоСтруктурыЛок(ДанныеШапки, "БанковскийСчетКонтрагента");
	
	РеквизитыПокупателя = УПД970_ДанныеУчастникаЭДО(
		ДанныеШапки.Контрагент,
		ДанныеШапки.Дата,
		БанковскийСчетКонтрагента);
		
	Если ЗначениеЗаполнено(ДанныеШапки.КПППокупателя) Тогда
		РеквизитыПокупателя.КПП = ДанныеШапки.КПППокупателя;
	КонецЕсли;
	
	ЮрАдресПокупателя = СведенияОбЮридическомАдресеОбъекта(ДанныеШапки.Контрагент, ДанныеШапки.Дата);
	
	Content.Buyer = Счет29_НовыйOrganizationInfo(РеквизитыПокупателя, ЮрАдресПокупателя);

	Content.Payer = Content.Buyer;
	Content.MoneyRecipient = Content.Seller;

	Content.ProformaInvoiceAdditionalInfo = Новый_ЭлементПротоКонтента("ProformaInvoiceAdditionalInfo");
	
	Если ЗначениеЗаполнено(ДанныеШапки.НазначениеПлатежа) Тогда
		НазначениеПлатежа = ДанныеШапки.НазначениеПлатежа;
	Иначе
		НазначениеПлатежа = Счет29_ТекстНазначенияПлатежа(Content.DocumentNumber, Content.DocumentDate);
	КонецЕсли;
	
	Content.ProformaInvoiceAdditionalInfo.PaymentPurpose = НазначениеПлатежа;
	Content.ProformaInvoiceAdditionalInfo.UniquePaymentInfo = ДанныеШапки.ИдентификаторПлатежа;
	
	Возврат Content;
	
КонецФункции

Функция Счет29_НовыйTable(ТаблицаДокумента, ЭтоНДСИНА, ЦенаВключаетНДС)
	
	РазрядностьЦены = 2;
	РазрядностьКоличества = 3;
	
	Table = Новый_ЭлементПротоКонтента("ProformaInvoiceTable29");
	
	ВсеСтрокиБезНДС = Истина;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокумента Цикл
		
		Item = Новый_ЭлементПротоКонтента("Item29");
		
		Item.Product = Счет29_ПредставлениеНоменклатуры(
			СтрокаТаблицы.НоменклатураНаименованиеПолное,
			СтрокаТаблицы.НоменклатураНаименование,
			СтрокаТаблицы.ХарактеристикаНаименование,
			СтрокаТаблицы.Содержание);
			
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатурыВТерминахПрото(СтрокаТаблицы.НоменклатураТип);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
			
			КодЕИ = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияКод);
			
			Item.Unit = ГенерацияXML.XML_КодЕдиницыИзмерения(КодЕИ);
			Item.UnitName = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияНаименование);
			
		КонецЕсли;
		
		Item.Quantity = Счет29_ВычислитьКоличествоПоСтроке(СтрокаТаблицы, РазрядностьКоличества);
		
		СтавкаНДС = СтрокаТаблицы.СтавкаНДС;
		
		ПредставлениеСтавки = Счет29_ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС, ЭтоНДСИНА);
		
		Если Счет29_ЭтоСтавкаНДСизПеречняПоКодексу(ПредставлениеСтавки) Тогда
			Item.TaxRate = ПредставлениеСтавки;
		Иначе
			Item.OtherTaxRate = ПредставлениеСтавки;
		КонецЕсли;
			
		ЭтоСтавкаБезНДС = (Item.TaxRate = ПредставлениеСтавкиБезНДС());
		ВсеСтрокиБезНДС = ВсеСтрокиБезНДС И ЭтоСтавкаБезНДС;
		
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		
		СуммаСНДС = СтрокаТаблицы.СуммаСНДС;
		
		Item.Vat = 0;
		Если Не ЭтоНДСИНА Тогда
			Item.Vat = СтрокаТаблицы.СуммаНДС;
		КонецЕсли;
			
		Item.Subtotal = СуммаСНДС;
		Item.SubtotalWithVatExcluded = СтрокаТаблицы.СуммаБезНДС;
		Item.DiscountSum = СтрокаТаблицы.СуммаСкидки;
		
		Item.Price = 0;
		Если ЗначениеЗаполнено(СтрокаТаблицы.Цена)
			Или ЗначениеЗаполнено(Item.Quantity) Тогда
			Item.Price = РассчитатьЦену(Item.SubtotalWithVatExcluded, Item.Quantity, РазрядностьЦены);
		КонецЕсли;
		
		Счет29_ЗаполнитьСуммыБезУчетаСкидки(Item, СтавкаНДС, ЭтоНДСИНА, ЦенаВключаетНДС, РазрядностьЦены);
		
		Table.Items.Добавить(Item);
		
	КонецЦикла;
	
	Table.Vat = 0;
	Если Не ЭтоНДСИНА Тогда
		Table.Vat = ТаблицаДокумента.Итог("СуммаНДС");
	КонецЕсли;
	
	Table.Total = ТаблицаДокумента.Итог("СуммаСНДС");
	Table.TotalDiscountSum = ТаблицаДокумента.Итог("СуммаСкидки");
	Table.TotalWithVatExcluded = Table.Total - Table.Vat;

	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);

	Возврат Table;
	
КонецФункции

