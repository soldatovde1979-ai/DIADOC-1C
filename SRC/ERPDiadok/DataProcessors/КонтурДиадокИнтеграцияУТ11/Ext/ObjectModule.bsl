Функция Счет29_НовыйProformaInvoice29Base(РеквизитыОснования)
	
	DocumentRequisitesType = Новый_ЭлементПротоКонтента("DocumentRequisitesType");
	
	DocumentRequisitesType.DocumentName = РеквизитыОснования.Наименование;
	
	Если ЗначениеЗаполнено(РеквизитыОснования.Дата) Тогда
		DocumentRequisitesType.DocumentDate = РеквизитыОснования.Дата;
	КонецЕсли;
	
	Если ПустаяСтрока(РеквизитыОснования.Номер) Тогда
		DocumentRequisitesType.DocumentNumber = "Без номера";
	Иначе
		DocumentRequisitesType.DocumentNumber = РеквизитыОснования.Номер;
	КонецЕсли;
	
	ProformaInvoice29Base = Новый_ЭлементПротоКонтента("ProformaInvoice29Base");
	ProformaInvoice29Base.ProformaInvoiceBaseDocument = DocumentRequisitesType;
	
	Возврат ProformaInvoice29Base;
	
