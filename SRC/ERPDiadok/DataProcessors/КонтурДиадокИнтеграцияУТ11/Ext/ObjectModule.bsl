Процедура УПД970_ЗаполнитьОбщиеРеквизитыКонтента(Контент, ДанныеШапки, ФункцияДокумента)
	
	Контент.Function = ФункцияДокумента;
	
	Контент.CircumFormatInvoice = УПД970_ПолучитьОбстоятельстваФормированияДокумента(ДанныеШапки.Ссылка, ФункцияДокумента);
	
	Контент.DocumentDate = ДанныеШапки.Дата;
	Контент.DocumentNumber = ПредставлениеНомера(ДанныеШапки.Номер);
	Если ЗначениеЗаполнено(ДанныеШапки.ИндексПодразделения) Тогда
		Контент.DocumentNumber = Контент.DocumentNumber + "/" + XMLСтрока(ДанныеШапки.ИндексПодразделения);
	КонецЕсли;
	
	Если ДанныеШапки.Исправление
		И ФункцияДокумента <> ФункцияДокумента_ДОП() Тогда
		Контент.RevisionNumber = ПредставлениеНомера(ДанныеШапки.НомерИсправления);
		Контент.RevisionDate = ДанныеШапки.ДатаИсправления;
	КонецЕсли;
	
	Контент.Currency = КодВалютыРегламентированногоУчета();
	
КонецПроцедуры

Функция УПД970_ПолучитьОбстоятельстваФормированияДокумента(ДокументСсылка, ФункцияДокумента)
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФ() Тогда
		Результат = УПД970_ПолучитьОбстоятельстваФормированияСчетФактурыУстаревший(ДокументСсылка);
	Иначе
		Результат = УПД970_ОбстоятельстваФормированияУПД(ДокументСсылка);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ПолучитьОбстоятельстваФормированияСчетФактурыУстаревший(ДокументСсылка)
	
	ЭтоКомиссионнаяТорговля = Ложь;
	Если ЭтоСчетФактураКомиссионеру(ДокументСсылка)
		ИЛИ ЭтоСчетФактураНаРеализациюЧерезКомиссионера(ДокументСсылка) Тогда
		ЭтоКомиссионнаяТорговля = Истина; 
	КонецЕсли;
	
	ЭтоСчетФактураВыданныйНаАванс = ЭтоСчетФактураВыданныйНаАванс(ДокументСсылка);
	КодВидаОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "КодВидаОперации");
	
	Если КодВидаОперации = "01" И ЭтоКомиссионнаяТорговля Тогда
		Результат = "1";	
	ИначеЕсли ЭтоСчетФактураВыданныйНаАванс Тогда
		Результат = "2";
	ИначеЕсли КодВидаОперации = "27" Тогда // Сводный комиссионный
		Результат = "3";
	ИначеЕсли КодВидаОперации = "06" Тогда // Налоговый агент
		Результат = "4";
	ИначеЕсли КодВидаОперации = "34" Тогда // НДСИНА
		Результат = "5";
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияСчетаФактуры(КодВидаОперации, ВидДоговора)
	
	ЭтоКомиссионнаяТорговля = ЭтоВидДоговораНаКомиссионнуюТорговлю(ВидДоговора);
	
	Если КодВидаОперации = "01" И ЭтоКомиссионнаяТорговля Тогда
		Результат = "1";
	ИначеЕсли КодВидаОперации = "27" Тогда // Сводный комиссионный
		Результат = "3";
	ИначеЕсли КодВидаОперации = "06" Тогда // Налоговый агент
		Результат = "4";
	ИначеЕсли КодВидаОперации = "34" Тогда // НДСИНА
		Результат = "5";
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ОбстоятельстваФормированияУПД(ДокументСсылка)
	
	Результат = Неопределено;
	
	Если ЭтоСчетФактураКомиссионеру(ДокументСсылка)
		ИЛИ ЭтоСчетФактураНаРеализациюЧерезКомиссионера(ДокументСсылка)
		ИЛИ ЭтоРеализацияПередачаНаКомиссию(ДокументСсылка) 
		ИЛИ ЭтоПередачаНаКомиссию(ДокументСсылка) Тогда
		
		Результат = "00005";
		
	ИначеЕсли Ложь Тогда
		
		// TODO: Нужно добавить условия, когда основание ОтчетКомитенту, то "00007"
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Контент)
	
	Контент.DocumentCreator = "";
	
	Если Контент.Sellers.Количество() > 0 Тогда
		
		ПродавецИнфо = Контент.Sellers[0];
		Контент.DocumentCreator = НаименованиеИННКПП(ПродавецИнфо.Name, ПродавецИнфо.Inn, ПродавецИнфо.Kpp);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСоставителяДокументаПоДаннымОрганизации(Контент, Организация, ОснованияОтгрузки, ДатаСведений)
	
	РеквизитыОрганизации = УПД970_ДанныеУчастникаЭДО(Организация, ДатаСведений);
	
	ПредставлениеСоставителяДокумента = НаименованиеИННКПП(
		РеквизитыОрганизации.Наименование,
		РеквизитыОрганизации.ИНН,
		РеквизитыОрганизации.КПП);
		
	Контент.DocumentCreator = ПредставлениеСоставителяДокумента;
	
	Если ОснованияОтгрузки.Количество() > 0 Тогда
		
		РеквизитыОснования = ОснованияОтгрузки[0];
		
		Если ЗначениеЗаполнено(РеквизитыОснования.Наименование)
			И ЗначениеЗаполнено(РеквизитыОснования.Номер)
			И ЗначениеЗаполнено(РеквизитыОснования.Дата) Тогда
				
				DocumentCreatorBase = Контракт_DocumentCreatorBase();
				Контент.DocumentCreatorBase = DocumentCreatorBase;
				
				DocumentCreatorBase.Name = РеквизитыОснования.Наименование;
				DocumentCreatorBase.Number = РеквизитыОснования.Номер;
				DocumentCreatorBase.Date = РеквизитыОснования.Дата;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПродавцеУстаревший(Контент, ДанныеШапки)
	
	РеквизитыОрганизации = УПД970_РеквизитыОрганизации(ДанныеШапки);
	ЮрАдресПродавца = СведенияОбЮридическомАдресеОбъекта(РеквизитыОрганизации.Ссылка, ДанныеШапки.Дата);
	
	ОбособленноеПодразделение = ОбособленноеПодразделениеОрганизации(ДанныеШапки);
		
	Если ЗначениеЗаполнено(ОбособленноеПодразделение) Тогда
		КПП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбособленноеПодразделение, "КПП");
		РеквизитыОрганизации.КПП = КПП;
	КонецЕсли;
	
	Seller = Контракт_ExtendedOrganizationInfo970();
	Контент.Sellers.Добавить(Seller);
	
	УПД970_ЗаполнитьExtendedOrganizationInfo(Seller, РеквизитыОрганизации, ЮрАдресПродавца);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПокупателеУстаревший(Контент, СтруктураДанных)
	
	ДанныеШапки = СтруктураДанных.ДанныеШапки;
	
	РеквизитыКонтрагента = УПД970_РеквизитыКонтрагента(СтруктураДанных);
	ЮрАдресКонтрагента = СведенияОбЮридическомАдресеОбъекта(РеквизитыКонтрагента.Ссылка, ДанныеШапки.Дата);
	
	Buyer = Контракт_ExtendedOrganizationInfo970();
	Контент.Buyers.Добавить(Buyer);
	
