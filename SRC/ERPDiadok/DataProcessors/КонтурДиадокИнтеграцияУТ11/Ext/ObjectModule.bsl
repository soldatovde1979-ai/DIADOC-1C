Функция ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера(ОписаниеВидаПакета, ЭтоКорректировка)
	
	КатегорияПакета	= ОписаниеВидаПакета.КатегорияПакета;
	ВидПакетаID		= ОписаниеВидаПакета.ID;
	
	Если ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		Результат = ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера_ПоРегистру(ЭтоКорректировка);
	Иначе
		Результат = ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера_ПоДокументу(ЭтоКорректировка);
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&ВидПакетаID",	"""" + ВидПакетаID + """");
	
	Результат = ТекстЗапроса_СкорректированныеСвязиДляОтправленныхДокументов(Результат, ОписаниеВидаПакета);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера_ПоРегистру(ЭтоКорректировка)
	
	Результат =
		"ВЫБРАТЬ
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Документ КАК Документ,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.НомерДокумента КАК НомерДокумента,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.ДатаДокумента КАК ДатаДокумента,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Контрагент КАК Контрагент,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Организация КАК Организация,
		|	СУММА(ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре, 0) - ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение, 0) + ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение, 0)) КАК СуммаДокумента,
		|	&ВидПакетаID КАК ВидПакетаID
		|ИЗ
		|	ВТ_СчетФактурыПоОтчетуКомиссионера КАК ВТ_СчетФактурыПоОтчетуКомиссионера
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КэшКонтрагентовПоВидамПакетов КАК ВТ_КэшКонтрагентовПоВидамПакетов
		|		ПО ВТ_СчетФактурыПоОтчетуКомиссионера.Организация = ВТ_КэшКонтрагентовПоВидамПакетов.Организация1С
		|			И ВТ_СчетФактурыПоОтчетуКомиссионера.Контрагент = ВТ_КэшКонтрагентовПоВидамПакетов.Контрагент1С
		|			И (ВТ_КэшКонтрагентовПоВидамПакетов.ВидПакетаID = &ВидПакетаID)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтправленныеДокументы КАК ОтправленныеДокументы
		|		ПО ВТ_СчетФактурыПоОтчетуКомиссионера.Документ = ОтправленныеДокументы.Документ
		|			И (&УсловиеСвязиПоКатегорииПакета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
		|		ПО ВТ_СчетФактурыПоОтчетуКомиссионера.Документ = ЖурналУчетаСчетовФактур.СчетФактура
		|			И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры) 
		|ГДЕ
		|	ОтправленныеДокументы.Документ ЕСТЬ NULL
		|	И НЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Сводный
		|	И ВЫБОР
		|			КОГДА ВТ_КэшКонтрагентовПоВидамПакетов.ОтправлятьНепроведенные
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Проведен
		|		КОНЕЦ
		|	И НЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Корректировочный
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Документ,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.НомерДокумента,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.ДатаДокумента,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Контрагент,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Организация";
	
	Если ЭтоКорректировка Тогда
		
		Результат = СтрЗаменить(Результат, "НЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Корректировочный", "ВТ_СчетФактурыПоОтчетуКомиссионера.Корректировочный");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_СчетФактурыПоОтчетуКомиссионера_ПоДокументу(ЭтоКорректировка)
	
	Результат =
		"ВЫБРАТЬ
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Документ КАК Документ,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.НомерДокумента КАК НомерДокумента,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.ДатаДокумента КАК ДатаДокумента,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Контрагент КАК Контрагент,
		|	ВТ_СчетФактурыПоОтчетуКомиссионера.Организация КАК Организация,
		|	0 КАК СуммаДокумента,
		|	&ВидПакетаID КАК ВидПакетаID
		|ИЗ
		|	ВТ_СчетФактурыПоОтчетуКомиссионера КАК ВТ_СчетФактурыПоОтчетуКомиссионера
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КэшКонтрагентовПоВидамПакетов КАК ВТ_КэшКонтрагентовПоВидамПакетов
		|		ПО ВТ_СчетФактурыПоОтчетуКомиссионера.Организация = ВТ_КэшКонтрагентовПоВидамПакетов.Организация1С
		|			И ВТ_СчетФактурыПоОтчетуКомиссионера.Контрагент = ВТ_КэшКонтрагентовПоВидамПакетов.Контрагент1С
		|			И (ВТ_КэшКонтрагентовПоВидамПакетов.ВидПакетаID = &ВидПакетаID)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтправленныеДокументы КАК ОтправленныеДокументы
		|		ПО ВТ_СчетФактурыПоОтчетуКомиссионера.Документ = ОтправленныеДокументы.Документ
		|			И (&УсловиеСвязиПоКатегорииПакета)
		|ГДЕ
		|	ОтправленныеДокументы.Документ ЕСТЬ NULL
		|	И НЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Сводный
		|	И ВЫБОР
		|			КОГДА ВТ_КэшКонтрагентовПоВидамПакетов.ОтправлятьНепроведенные
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Проведен
		|		КОНЕЦ
		|	И НЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Корректировочный";
	
	Если ЭтоКорректировка Тогда
		
		Результат = СтрЗаменить(Результат, "НЕ ВТ_СчетФактурыПоОтчетуКомиссионера.Корректировочный", "ВТ_СчетФактурыПоОтчетуКомиссионера.Корректировочный");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_ВТ_СчетФактурыПоОтчетуКомиссионера()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураКомиссионеру.Ссылка КАК Документ,
	|	СчетФактураКомиссионеру.Проведен КАК Проведен,
	|	СчетФактураКомиссионеру.Номер КАК НомерДокумента,
	|	СчетФактураКомиссионеру.Дата КАК ДатаДокумента,
	|	СчетФактураКомиссионеру.Контрагент КАК Контрагент,
	|	СчетФактураКомиссионеру.Организация КАК Организация,
	|	0 КАК СуммаДокумента,
	|	СчетФактураКомиссионеру.Сводный КАК Сводный,
	|	ЛОЖЬ КАК Корректировочный
	|ПОМЕСТИТЬ ВТ_СчетФактурыПоОтчетуКомиссионера
	|ИЗ
	|	Документ.СчетФактураКомиссионеру КАК СчетФактураКомиссионеру
	|ГДЕ
	|	СчетФактураКомиссионеру.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ СчетФактураКомиссионеру.ПометкаУдаления
	|	И НЕ СчетФактураКомиссионеру.Сводный";
	
	Если Не ИспользуетсяСчетФактураКомиссионеру() ИЛИ 
			ЗапрещеноЧтениеТаблицыДанныхДокумента(Метаданные.Документы.СчетФактураКомиссионеру) Тогда
		
		Результат =
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|	НЕОПРЕДЕЛЕНО КАК Документ,
		|	ИСТИНА КАК Проведен,
		|	НЕОПРЕДЕЛЕНО КАК НомерДокумента,
		|	НЕОПРЕДЕЛЕНО КАК ДатаДокумента,
		|	НЕОПРЕДЕЛЕНО КАК Контрагент,
		|	НЕОПРЕДЕЛЕНО КАК Организация,
		|	0 КАК СуммаДокумента,
		|	ЛОЖЬ КАК Сводный,
		|	ЛОЖЬ КАК Корректировочный
		|ПОМЕСТИТЬ ВТ_СчетФактурыПоОтчетуКомиссионера";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ТекстЗапроса_ДополнитьВременнойТаблицей_СчетФактурыПоОтчетуКомиссионера(ТекстЗапроса)
	
	Результат = ТекстЗапроса_ВТ_СчетФактурыПоОтчетуКомиссионера();
	
	Если ИспользуетсяРеализацияЧерезКомиссионера() Тогда
		
		ТекстЗапросаВТОбычныеСФВыданныйЧерезКомиссионера = ТекстЗапроса_ВТОбычныеСФВыданныйЧерезКомиссионера();
		
		ТекстЗапросаОбычныеСФВыданныйЧерезКомиссионера = 
			"ВЫБРАТЬ
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.Документ КАК Документ,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.Проведен КАК Проведен,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.НомерДокумента КАК НомерДокумента,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.ДатаДокумента КАК ДатаДокумента,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.Контрагент КАК Контрагент,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.Организация КАК Организация,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.СуммаДокумента КАК СуммаДокумента,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.Сводный КАК Сводный,
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера.Корректировочный КАК Корректировочный
			|ИЗ
			|	ВТ_ОбычныеСФВыданныйЧерезКомиссионера КАК ВТ_ОбычныеСФВыданныйЧерезКомиссионера";
			
		Результат = 
			ТекстЗапросаВТОбычныеСФВыданныйЧерезКомиссионера 
			+ ТекстЗапроса_РазделительЗапросов() 
			+ Результат 
			+ ТекстЗапроса_ОбъединитьВсе()
			+ ТекстЗапросаОбычныеСФВыданныйЧерезКомиссионера;
		
	КонецЕсли;
	
	Результат = Результат + "
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ";
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапроса_РазделительЗапросов() + Результат;
	
КонецПроцедуры

Функция ТекстЗапроса_ВТОбычныеСФВыданныйЧерезКомиссионера()

	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактураВыданный.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ВсеСФВыданныйЧерезКомиссионера
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ СчетФактураВыданный.ПометкаУдаления
	|	И СчетФактураВыданный.РеализацияЧерезКомиссионера
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетФактураВыданныйПокупатели.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СчетФактураВыданныйПокупатели.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_СФВыданныйЧерезКомиссионераКоличествоСтрок
	|ИЗ
	|	ВТ_ВсеСФВыданныйЧерезКомиссионера КАК ВТ_ВсеСФВыданныйЧерезКомиссионера
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный.Покупатели КАК СчетФактураВыданныйПокупатели
	|		ПО ВТ_ВсеСФВыданныйЧерезКомиссионера.Ссылка = СчетФактураВыданныйПокупатели.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетФактураВыданныйПокупатели.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ВсеСФВыданныйЧерезКомиссионера.Ссылка КАК Документ,
	|	СчетФактураВыданный.Проведен КАК Проведен,
	|	СчетФактураВыданный.Номер КАК НомерДокумента,
	|	СчетФактураВыданный.Дата КАК ДатаДокумента,
	|	СчетФактураВыданный.Контрагент КАК Контрагент,
	|	СчетФактураВыданный.Организация КАК Организация,
	|	0 КАК СуммаДокумента,
	|	ВТ_СФВыданныйЧерезКомиссионераКоличествоСтрок.НомерСтроки > 1 КАК Сводный,
	|	СчетФактураВыданный.Корректировочный КАК Корректировочный
	|ПОМЕСТИТЬ ВТ_ОбычныеСФВыданныйЧерезКомиссионера
	|ИЗ
	|	ВТ_ВсеСФВыданныйЧерезКомиссионера КАК ВТ_ВсеСФВыданныйЧерезКомиссионера
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СФВыданныйЧерезКомиссионераКоличествоСтрок КАК ВТ_СФВыданныйЧерезКомиссионераКоличествоСтрок
	|		ПО ВТ_ВсеСФВыданныйЧерезКомиссионера.Ссылка = ВТ_СФВыданныйЧерезКомиссионераКоличествоСтрок.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ПО ВТ_ВсеСФВыданныйЧерезКомиссионера.Ссылка = СчетФактураВыданный.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ВсеСФВыданныйЧерезКомиссионера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_СФВыданныйЧерезКомиссионераКоличествоСтрок";
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСуммуДокументаПоСчетФактуре(СчетФактура)
	
	Результат = 0;
	
	Если Не ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре 
	|		+ ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение 
	|		- ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение) КАК СуммаДокумента
	|ИЗ
	|	РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
	|ГДЕ
	|	ЖурналУчетаСчетовФактур.СчетФактура = &СчетФактура
	|	И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры)";
	
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СуммаДокумента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

