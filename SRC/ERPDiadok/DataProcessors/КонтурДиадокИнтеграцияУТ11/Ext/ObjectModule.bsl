КонецПроцедуры

Функция УПД970_РеквизитыОрганизации(ДанныеШапки)
	
	БанковскийСчетОрганизации = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШапки, "БанковскийСчетОрганизации") Тогда
		БанковскийСчетОрганизации = ДанныеШапки.БанковскийСчетОрганизации;
	КонецЕсли;
	
	Результат = УПД970_ДанныеУчастникаЭДО(
		ДанныеШапки.Организация,
		ДанныеШапки.Дата,
		БанковскийСчетОрганизации);
		
	Если ЗначениеЗаполнено(ДанныеШапки.КПППоставщика) Тогда
		Результат.КПП = ДанныеШапки.КПППоставщика;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыКонтрагента(СтруктураДанных)
	
	ДанныеШапки = СтруктураДанных.ДанныеШапки;
	
	Контрагент = Неопределено;
	КППКонтрагента = "";
	
	Если СтруктураДанных.Свойство("РезультатПоКонтрагентам")
		И СтруктураДанных.РезультатПоКонтрагентам <> Неопределено Тогда
		
		ВыборкаДанныхКонтрагента = СтруктураДанных.РезультатПоКонтрагентам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаДанныхКонтрагента.НайтиСледующий(Новый Структура("Ссылка", ДанныеШапки.Ссылка));
		ДанныеКонтрагента = ВыборкаДанныхКонтрагента.Выбрать();
		ДанныеКонтрагента.Следующий();
		Если ЗначениеЗаполнено(ДанныеКонтрагента.Контрагент) Тогда
			Контрагент = ДанныеКонтрагента.Контрагент;
			КППКонтрагента = ДанныеКонтрагента.КПППокупателя;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = ДанныеШапки.Контрагент;
		КППКонтрагента = ДанныеШапки.КПППокупателя;
	КонецЕсли;
	
	БанковскийСчетКонтрагента = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШапки, "БанковскийСчетКонтрагента") Тогда
		БанковскийСчетКонтрагента = ДанныеШапки.БанковскийСчетКонтрагента;
	КонецЕсли;
	
	Результат = УПД970_ДанныеУчастникаЭДО(
		Контрагент,
		ДанныеШапки.Дата,
		БанковскийСчетКонтрагента);
		
	Если ЗначениеЗаполнено(КППКонтрагента) Тогда
		Результат.КПП = КППКонтрагента;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыГрузополучателя(СтруктураДанных)
	
	Перем Результат;
	
	ДанныеШапки = СтруктураДанных.ДанныеШапки;
	
	Грузополучатель = Неопределено;
	
	Если СтруктураДанных.Свойство("РезультатПоКонтрагентам")
		И СтруктураДанных.РезультатПоКонтрагентам <> Неопределено Тогда
		
		ВыборкаДанныхКонтрагента = СтруктураДанных.РезультатПоКонтрагентам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаДанныхКонтрагента.НайтиСледующий(Новый Структура("Ссылка", ДанныеШапки.Ссылка));
		ДанныеКонтрагента = ВыборкаДанныхКонтрагента.Выбрать();
		ДанныеКонтрагента.Следующий();
		Если ЗначениеЗаполнено(ДанныеКонтрагента.Грузополучатель) Тогда
			Грузополучатель = ДанныеКонтрагента.Грузополучатель;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Грузополучатель) Тогда
		Грузополучатель = ДанныеШапки.Грузополучатель;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		
		БанковскийСчетГрузополучателя = Неопределено;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШапки, "БанковскийСчетГрузополучателя") Тогда
			БанковскийСчетГрузополучателя = ДанныеШапки.БанковскийСчетГрузополучателя;
		КонецЕсли;
		
		Результат = УПД970_ДанныеУчастникаЭДО(
			Грузополучатель,
			ДанныеШапки.Дата,
			БанковскийСчетГрузополучателя);
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьExtendedOrganizationInfo(Content, ДанныеУчастникаЭДО, СведенияОбАдресе)
	
	Content.Type = УПД970_ExtendedOrganizationInfoType(
		ДанныеУчастникаЭДО.ЮрФизЛицо,
		ДанныеУчастникаЭДО.Страна);
	
	Content.Name = ДанныеУчастникаЭДО.Наименование;
	
	Content.Inn = ДанныеУчастникаЭДО.ИНН;
	Content.Kpp = ДанныеУчастникаЭДО.КПП;
	Content.Okpo = ДанныеУчастникаЭДО.КодПоОКПО;
	
	Content.IndividualEntityRegistrationCertificate = ДанныеУчастникаЭДО.Свидетельство;
	Content.IndividualEntityRegistrationNumber = ДанныеУчастникаЭДО.ОГРНИП;
	Content.IndividualEntityRegistrationDate = ДанныеУчастникаЭДО.ДатаОГРНИП;
	
	Content.LegalEntityId = ДанныеУчастникаЭДО.НалоговыйНомерВСтранеРегистрации;
	Content.OrganizationOrPersonInfo = ДанныеУчастникаЭДО.РегистрационныйНомер;
	
	Content.Country = ДанныеУчастникаЭДО.СтранаНаименование;
	Content.CountryCode = ДанныеУчастникаЭДО.СтранаКод;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.Телефоны) Тогда
		Content.Phone.Добавить(ДанныеУчастникаЭДО.Телефоны);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеУчастникаЭДО.ЭлектроннаяПочта) Тогда
		Content.Email.Добавить(ДанныеУчастникаЭДО.ЭлектроннаяПочта);
	КонецЕсли;
	
	Content.BankName = ДанныеУчастникаЭДО.НаименованиеБанка;
	Content.BankAccountNumber = ДанныеУчастникаЭДО.НомерСчета;
	Content.CorrespondentAccount = ДанныеУчастникаЭДО.КоррСчет;
	Content.BankId = ДанныеУчастникаЭДО.БИК;
	
	Content.Address = УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе);
	
	Content.СлужебнаяИнформация.Ссылка = ДанныеУчастникаЭДО.Ссылка;
	
КонецПроцедуры

Функция УПД970_ExtendedOrganizationInfoType(ТипЮрФизЛица, СтранаРегистрации)
	
	ВидыЮрФизЛицПрото = ГенерацияXML_Перечисление_ВидыЮрФизЛиц();
	
	Если ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		Результат = ВидыЮрФизЛицПрото.ИндивидуальныйПредприниматель;
		
	ИначеЕсли СтранаРегистрации = Справочники.СтраныМира.Россия
		И ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		Результат = ВидыЮрФизЛицПрото.ФизическоеЛицо;
		
	ИначеЕсли ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		
		Результат = ВидыЮрФизЛицПрото.ЮридическоеЛицо;
		
	ИначеЕсли СтранаРегистрации <> Справочники.СтраныМира.Россия
		И ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		Результат = ВидыЮрФизЛицПрото.ИностранныйГражданин;
		
	ИначеЕсли ТипЮрФизЛица = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		Результат = ВидыЮрФизЛицПрото.ИностраннаяОрганизация;
		
	Иначе
		
		ТекстОшибки = НСтр("ru='Не удалось определить тип участника ЭДО.
				|Заполните корректные реквизиты участников ЭДО в базе 1С 
				|(организация, грузоотправитель, контрагент, грузополучатель)'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ДанныеУчастникаЭДО(УчастникЭДО, ДатаСведений, БанковскийСчет = Неопределено)
	
	Если НЕ ИспользуетсяМодульЭлектронноеВзаимодействиеУТ() Тогда
		
		ТекстОшибки = НСтр("ru='В текущей версии конфигурации нет общего модуля ЭлектронноеВзаимодействиеУТ.'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	МодульЭлектронноеВзаимодействиеУТ = ОбщийМодульПоИмениЛок("ЭлектронноеВзаимодействиеУТ");
	
	ДанныеЮрФизЛица = МодульЭлектронноеВзаимодействиеУТ.ПолучитьДанныеЮрФизЛица(
		УчастникЭДО,
		БанковскийСчет,
		ДатаСведений);
		
	Если ТипЗнч(УчастникЭДО) = Тип("СправочникСсылка.РегистрацииВНалоговомОргане") Тогда
		ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
		СтранаРегистрации = Справочники.СтраныМира.Россия;
	Иначе
		ЮрФизЛицо = ДанныеЮрФизЛица.ЮрФизЛицо;
		
		СтранаРегистрации = Неопределено;
		Если НЕ ДанныеЮрФизЛица.Свойство("СтранаРегистрации", СтранаРегистрации) Тогда
			СтранаРегистрации = Справочники.СтраныМира.Россия;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = УПД970_Контракт_ДанныеУчастникаЭДО();
	
	Результат.Ссылка = ДанныеЮрФизЛица.Ссылка;
	
	Если ДанныеЮрФизЛица.Свойство("НаименованиеДляПечатныхФорм") Тогда
		Результат.Наименование = ДанныеЮрФизЛица.НаименованиеДляПечатныхФорм;
	Иначе
		Результат.Наименование = ДанныеЮрФизЛица.ПолноеНаименование;
	КонецЕсли;
	
	Результат.ИНН = ДанныеЮрФизЛица.ИНН;
	Результат.КПП = ДанныеЮрФизЛица.КПП;
	
	Если ТипЗнч(УчастникЭДО) = Тип("СправочникСсылка.Организации")
		И ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		РеквизитыИП = ЗначенияРеквизитовОбъектаЛок(УчастникЭДО, "ДатаРегистрации, ОГРН");
		
		Результат.ОГРНИП = РеквизитыИП.ОГРН;
		Результат.ДатаОГРНИП = РеквизитыИП.ДатаРегистрации;
		
	КонецЕсли;
	
	Если ТипЗнч(УчастникЭДО) = Тип("СправочникСсылка.Контрагенты")
		И ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		РеквизитыИП = ЗначенияРеквизитовОбъектаЛок(УчастникЭДО, "РегистрационныйНомер");
		
		Результат.ОГРНИП = РеквизитыИП.РегистрационныйНомер;
		
	КонецЕсли;
	
	Если ТипЗнч(УчастникЭДО) = Тип("СправочникСсылка.Контрагенты")
		И ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		
		ЮрЛицоНеРезидент = ЗначенияРеквизитовОбъектаЛок(УчастникЭДО, "РегистрационныйНомер,НалоговыйНомер");
		
		Результат.РегистрационныйНомер = ЮрЛицоНеРезидент.РегистрационныйНомер;
		Результат.НалоговыйНомерВСтранеРегистрации = ЮрЛицоНеРезидент.НалоговыйНомер;
		
	КонецЕсли;
	
	Результат.ЮрФизЛицо = ЮрФизЛицо;
	Результат.КодПоОКПО = ДанныеЮрФизЛица.КодПоОКПО;
	Результат.Телефоны = ДанныеЮрФизЛица.Телефоны;
	
	Если ДанныеЮрФизЛица.Свойство("ЭлектроннаяПочта") Тогда
		Результат.ЭлектроннаяПочта = ДанныеЮрФизЛица.ЭлектроннаяПочта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтранаРегистрации) Тогда
		Результат.Страна = СтранаРегистрации;
		Результат.СтранаНаименование = СтранаРегистрации.Наименование;
		Результат.СтранаКод = СтранаРегистрации.Код;
	КонецЕсли;
	
	Если ДанныеЮрФизЛица.Свойство("Свидетельство") Тогда
		Результат.Свидетельство = ДанныеЮрФизЛица.Свидетельство;
	КонецЕсли;
	Если ДанныеЮрФизЛица.Свойство("СвидетельствоСерияНомер") Тогда
		Результат.СвидетельствоСерияНомер = ДанныеЮрФизЛица.СвидетельствоСерияНомер;
	КонецЕсли;
	Если ДанныеЮрФизЛица.Свойство("СвидетельствоДатаВыдачи") Тогда
		Результат.СвидетельствоДатаВыдачи = ДанныеЮрФизЛица.СвидетельствоДатаВыдачи;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЮрФизЛица.Банк)
		И ТипЗнч(ДанныеЮрФизЛица.Банк) = Тип("СправочникСсылка.КлассификаторБанков") Тогда
		НаименованиеБанка = ЗначениеРеквизитаОбъектаЛок(ДанныеЮрФизЛица.Банк, "Наименование");
	ИначеЕсли ЗначениеЗаполнено(ДанныеЮрФизЛица.Банк)
		И ТипЗнч(ДанныеЮрФизЛица.Банк) = Тип("Строка") Тогда
		НаименованиеБанка = ДанныеЮрФизЛица.Банк;
	Иначе
		НаименованиеБанка = "";
	КонецЕсли;
	
	Результат.НаименованиеБанка = НаименованиеБанка;
	Результат.НомерСчета = ДанныеЮрФизЛица.НомерСчета;
	Результат.КоррСчет = ДанныеЮрФизЛица.КоррСчет;
	Результат.БИК = ДанныеЮрФизЛица.БИК;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressInfo(СведенияОбАдресе)
	
	Перем Результат;
	
	Если СведенияОбАдресе = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыАдресов = ГенерацияXML.Перечисление_ВидыАдресов();
	
	Результат = Контракт_AddressInfo970();
	
	Если ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		
		AddressSAR = УПД970_ЗаполненныйAddressSAR(СведенияОбАдресе);
		
		Результат.AddressSAR = AddressSAR;
		Результат.Type = ВидыАдресов.АдресГАР;
		
	ИначеЕсли ЭтоАдминистративноТерриториальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		
		AddressRF = УПД970_ЗаполненныйAddressRF(СведенияОбАдресе);
		
		Результат.AddressRF = AddressRF;
		Результат.Type = ВидыАдресов.АдресРФ;
		
	Иначе
		
		AddressText = УПД970_ЗаполненныйAddressText(СведенияОбАдресе);
		
		Результат.AddressText = AddressText;
		Результат.Type = ВидыАдресов.АдресСтрокой;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСоответствуетСтруктуреAddressSAR(СведенияОбАдресе)

	Результат = Ложь;
	
	Если Не ЭтоМуниципальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		Возврат Результат;
	КонецЕсли;

	ЕстьКодРегиона = ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона);
	ЕстьНаименованиеМуниципальногоРайона = ЗначениеЗаполнено(СведенияОбАдресе.МуниципальныйРайон);
	
	ЕстьКодМуниципальногоРайона = ЗначениеЗаполнено(СведенияОбАдресе.КодМуниципальногоРайона);
	Если Не ЕстьКодМуниципальногоРайона Тогда
		КодМуниципальногоРайона = УПД970_КодМуниципальногоРайона(СведенияОбАдресе.МуниципальныйРайонСокращение);
		ЕстьКодМуниципальногоРайона = ЗначениеЗаполнено(КодМуниципальногоРайона);
	КонецЕсли;
	
	ЕстьИдентификаторАдресногоОбъекта = ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторАдресногоОбъекта);
	
	ЕстьНесколькоТиповПомещений = УПД970_АдресСодержитНесколькоТиповПомещений(СведенияОбАдресе);
	ЕстьНесколькоТиповАпартаментов = УПД970_АдресСодержитНесколькоТиповАпартаментов(СведенияОбАдресе);
	
	МуниципальноеПредставление = СвойствоСтруктурыЛок(СведенияОбАдресе, "МуниципальноеПредставление");
	ПредставленияАдресаСовпадают = (МуниципальноеПредставление = СведенияОбАдресе.СохраненноеПредставление);
	
	Результат = ЕстьКодРегиона
		И ЕстьНаименованиеМуниципальногоРайона
		И ЕстьКодМуниципальногоРайона
		И ЕстьИдентификаторАдресногоОбъекта
		И ПредставленияАдресаСовпадают
		И Не ЕстьНесколькоТиповПомещений
		И Не ЕстьНесколькоТиповАпартаментов;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСоответствуетСтруктуреAddressRF(СведенияОбАдресе)
	
	Результат = Ложь;
	
	Если Не ЭтоАдминистративноТерриториальныйАдресЛок(СведенияОбАдресе.ТипАдреса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЕстьКодРегиона = ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона);
	ЭтоКодГородаФедеральногоЗначения = УПД970_ЭтоКодГородаФедеральногоЗначения(СведенияОбАдресе.КодРегиона);
	
	ПомещенияНеЗаполнены = (СведенияОбАдресе.Помещения.Количество() = 0);
	ТипПомещенияСоответствуетАдрРФ = (СведенияОбАдресе.Помещения.Количество() = 1
		И ВРЕГ(СведенияОбАдресе.Помещения[0].ТипПомещения) = ВРЕГ(ТипПомещенияАдрРФ()));
		
	ПомещенияСоответствуютАдрРФ = (ПомещенияНеЗаполнены Или ТипПомещенияСоответствуетАдрРФ);
	
	КорпусаНеЗаполнены = (СведенияОбАдресе.Корпуса.Количество() = 0);
	ТипКорпусаСоответствуетАдрРФ = (СведенияОбАдресе.Корпуса.Количество() = 1
		И ВРЕГ(СведенияОбАдресе.Корпуса[0].ТипКорпуса) = ВРЕГ(ТипКорпусаАдрРФ()));
		
	КорпусаСоответствуютАдрРФ = (КорпусаНеЗаполнены Или ТипКорпусаСоответствуетАдрРФ);
		
	ТипЗданияСоответствуетАдрРФ = Не ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания)
		Или ВРЕГ(СведенияОбАдресе.Здание.ТипЗдания) = ВРЕГ(ТипЗданияАдрРФ());
		
	АдресНеСоответствуетСтруктуреАдрРФ = ЗаполненыПоляНесоответствующиеСтруктуреАдрРФ(СведенияОбАдресе);
		
	ПредставлениеАдреса = СведенияОбАдресе.Представление;
	ПредставленияАдресаСовпадают = (ПредставлениеАдреса = СведенияОбАдресе.СохраненноеПредставление);

	Результат = ЕстьКодРегиона
		И ПомещенияСоответствуютАдрРФ
		И КорпусаСоответствуютАдрРФ
		И ТипЗданияСоответствуетАдрРФ
		И ПредставленияАдресаСовпадают
		И Не АдресНеСоответствуетСтруктуреАдрРФ
		И Не ЭтоКодГородаФедеральногоЗначения;

	Возврат Результат;
	
КонецФункции

Функция УПД970_ЭтоКодГородаФедеральногоЗначения(КодРегиона)

	КодыРегионов = Новый Массив;
	КодыРегионов.Добавить("77"); // г. Москва
	КодыРегионов.Добавить("78"); // г. Санкт-Петербург
	КодыРегионов.Добавить("92"); // г. Севастополь
	КодыРегионов.Добавить("99"); // иные территории, включая город и космодром Байконур

	Результат = (КодыРегионов.Найти(КодРегиона) <> Неопределено);
	Возврат Результат;
	
КонецФункции

Функция УПД970_АдресСодержитНесколькоТиповПомещений(СведенияОбАдресе)
	
	Результат = Ложь;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();

	КоличествоТиповПомещений = 0;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		Если ТипыПомещенийЗдания.Найти(Элемент.ТипПомещения) <> Неопределено Тогда
			КоличествоТиповПомещений = КоличествоТиповПомещений + 1;
		КонецЕсли;
		
		Если КоличествоТиповПомещений > 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция УПД970_АдресСодержитНесколькоТиповАпартаментов(СведенияОбАдресе)
	
	Результат = Ложь;

	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();

	КоличествоТиповПомещений = 0;
	
	Для Каждого Элемент Из СведенияОбАдресе.Помещения Цикл
		
		ТипПомещения = Элемент.ТипПомещения;
		
		ЭтоПомещениеЗдания = (ТипыПомещенийЗдания.Найти(ТипПомещения) <> Неопределено);
		ЭтоПомещениеКвартиры = (ТипыПомещенийКвартиры.Найти(ТипПомещения) <> Неопределено);
		
		ЭтоНеклассифицированноеПомещениеКвартиры = (Не ЭтоПомещениеЗдания И Не ЭтоПомещениеКвартиры);
		
		Если ЭтоПомещениеКвартиры Или ЭтоНеклассифицированноеПомещениеКвартиры Тогда
			КоличествоТиповПомещений = КоличествоТиповПомещений + 1;
		КонецЕсли;
		
		Если КоличествоТиповПомещений > 1 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

