Функция УПД970_ЗаполненныйAddressSAR(СведенияОбАдресе)
	
	КодыРегионов = ГенерацияXML.КодыРегионов();
	
	Результат = Контракт_AddressSARInfo();
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторДома) Тогда
		Результат.ID = СведенияОбАдресе.ИдентификаторДома;
	Иначе
		Результат.ID = СведенияОбАдресе.ИдентификаторАдресногоОбъекта;
	КонецЕсли;
	
	Результат.ZipCode = СведенияОбАдресе.Индекс;
	Результат.RegionCode = СведенияОбАдресе.КодРегиона;
	
	ПредставлениеРегиона = "";
	Если ЗначениеЗаполнено(СведенияОбАдресе.КодРегиона) Тогда
		ПредставлениеРегиона = КодыРегионов.Получить(XMLЗначение(Тип("Число"), СведенияОбАдресе.КодРегиона));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПредставлениеРегиона) Тогда
		
		ЧастиРегиона = Новый Массив;
		ЧастиРегиона.Добавить(СокрЛП(СведенияОбАдресе.Регион));
		ЧастиРегиона.Добавить(НРег(СведенияОбАдресе.РегионТипПолный));
		
		ПредставлениеРегиона = СтрСоединить(ЧастиРегиона, " ");
		
	КонецЕсли;
	Результат.Region = ПредставлениеРегиона;
	
	MunicipalDistrictCode = СведенияОбАдресе.КодМуниципальногоРайона;
	Если НЕ ЗначениеЗаполнено(MunicipalDistrictCode) Тогда
		MunicipalDistrictCode = УПД970_КодМуниципальногоРайона(СведенияОбАдресе.МуниципальныйРайонСокращение);
	КонецЕсли;
	
	Результат.MunicipalDistrict = СведенияОбАдресе.МуниципальныйРайон;
	Результат.MunicipalDistrictCode = MunicipalDistrictCode;
	
	УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОНаселенномПункте(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОТерритории(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОУлице(Результат, СведенияОбАдресе);
	
	Результат.LandPlot = СведенияОбАдресе.НомерЗемельногоУчастка;
	
	УПД970_ЗаполнитьСведенияОЗданиях(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОПомещенииЗдания(Результат, СведенияОбАдресе);
	УПД970_ЗаполнитьСведенияОПомещенииКвартиры(Результат, СведенияОбАдресе);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОГородеПоселенииРайоне(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Поселение) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.Поселение;
		AddressSAR.SettlementCode = СведенияОбАдресе.КодПоселения;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.ВнутригородскойРайон) Тогда
		
		AddressSAR.Settlement = СведенияОбАдресе.ВнутригородскойРайон;
		AddressSAR.SettlementCode = "4";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОНаселенномПункте(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.НаселенныйПункт) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.НаселенныйПункт;
		AddressSAR.LocalityType = СведенияОбАдресе.НаселенныйПунктТипКраткий;
		
	ИначеЕсли ЗначениеЗаполнено(СведенияОбАдресе.Город) Тогда
		
		AddressSAR.Locality = СведенияОбАдресе.Город;
		AddressSAR.LocalityType = СведенияОбАдресе.ГородТипКраткий;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОТерритории(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Территория) Тогда
		AddressSAR.PlanningElement = СведенияОбАдресе.Территория;
		AddressSAR.PlanningElementType = СведенияОбАдресе.ТерриторияТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОУлице(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Улица) Тогда
		AddressSAR.StreetElement = СведенияОбАдресе.Улица;
		AddressSAR.StreetElementType = СведенияОбАдресе.УлицаТипКраткий;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОЗданиях(AddressSAR, СведенияОбАдресе)
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание.Номер)
		И ЗначениеЗаполнено(СведенияОбАдресе.Здание.ТипЗдания) Тогда
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = СведенияОбАдресе.Здание.Номер;
		AddressObject.Type = СведенияОбАдресе.Здание.ТипЗдания;
		
	КонецЕсли;
	
	Для Каждого Корпус Из СведенияОбАдресе.Корпуса Цикл
		
		Если НЕ ЗначениеЗаполнено(Корпус.Номер)
			И НЕ ЗначениеЗаполнено(Корпус.ТипКорпуса) Тогда
			Продолжить;
		КонецЕсли;
		
		AddressObject = Контракт_AddressObjectNumberInfo();
		AddressSAR.Buildings.Добавить(AddressObject);
		
		AddressObject.Number = Корпус.Номер;
		AddressObject.Type = Корпус.ТипКорпуса;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииЗдания(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	
	Для Каждого ТипПомещения Из ТипыПомещенийЗдания Цикл
		
		ПомещениеЗдания = Ядро.МассивСтруктур_Найти(Помещения, ТипПомещения, "ТипПомещения");
		Если ПомещениеЗдания <> Неопределено Тогда
			
			AddressSAR.House = ПомещениеЗдания.Номер;
			AddressSAR.HouseType = ПомещениеЗдания.ТипПомещения;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПомещенииКвартиры(AddressSAR, СведенияОбАдресе)
	
	Помещения = СведенияОбАдресе.Помещения;
	Если НЕ ЗначениеЗаполнено(Помещения) Тогда
		Возврат;
	КонецЕсли;
	
	ПомещениеКвартиры = УПД970_ПолучитьПомещениеКвартиры(Помещения);
	
	Если ПомещениеКвартиры = Неопределено Тогда
		ПомещениеКвартиры = УПД970_ПолучитьНеклассифицированноеПомещение(Помещения);
	КонецЕсли;
	
	Если ПомещениеКвартиры <> Неопределено Тогда
		AddressSAR.Apartment = ПомещениеКвартиры.Номер;
		AddressSAR.ApartmentType = ПомещениеКвартиры.ТипПомещения;
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ПолучитьПомещениеКвартиры(СписокПомещений)

	ПомещениеКвартиры = Неопределено;
	
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();
	Для Каждого ИмяТипаПомещения Из ТипыПомещенийКвартиры Цикл
		
		ПомещениеКвартиры = Ядро.МассивСтруктур_Найти(СписокПомещений, ИмяТипаПомещения, "ТипПомещения");
		
		Если ПомещениеКвартиры <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПомещениеКвартиры;

КонецФункции

Функция УПД970_ПолучитьНеклассифицированноеПомещение(СписокПомещений)
	
	Результат = Неопределено;
	
	ТипыПомещенийЗдания = УПД970_ТипыПомещенийЗдания();
	ТипыПомещенийКвартиры = УПД970_ТипыПомещенийКвартиры();

	Для Каждого Помещение Из СписокПомещений Цикл
		
		ТипПомещения = Помещение.ТипПомещения;
		
		ЭтоПомещениеЗдания = (ТипыПомещенийЗдания.Найти(ТипПомещения) <> Неопределено);
		ЭтоПомещениеКвартиры = (ТипыПомещенийКвартиры.Найти(ТипПомещения) <> Неопределено);
		
		Если Не ЭтоПомещениеЗдания
			И Не ЭтоПомещениеКвартиры Тогда
			Результат = Помещение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressRF(СведенияОбАдресе)
	
	Результат = Контракт_AddressRFInfo();
	
	Результат.ZipCode = СведенияОбАдресе.Индекс;
	Результат.RegionCode = СведенияОбАдресе.КодРегиона;
	Результат.Region = СведенияОбАдресе.Регион;
	Результат.Territory = СведенияОбАдресе.Район;
	
	Если ВРег(СведенияОбАдресе.Город) <> ВРег(СведенияОбАдресе.Регион) Тогда
		Результат.City = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.ГородСокращение, СведенияОбАдресе.Город);
	КонецЕсли;
	
	Если ВРег(СведенияОбАдресе.Город) <> ВРег(СведенияОбАдресе.НаселенныйПункт) Тогда
		Результат.Locality = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.НаселенныйПунктСокращение, СведенияОбАдресе.НаселенныйПункт);
	КонецЕсли;
	
	Результат.Street = СоединитьЭлементыАдресногоОбъекта(СведенияОбАдресе.УлицаСокращение, СведенияОбАдресе.Улица);
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Здание) Тогда 
		СведенияОбАдресе.Здание.Свойство("Номер", Результат.Building);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Корпуса) Тогда 
		СведенияОбАдресе.Корпуса[0].Свойство("Номер", Результат.Block);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбАдресе.Помещения) Тогда 
		СведенияОбАдресе.Помещения[0].Свойство("Номер", Результат.Apartment);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйAddressText(СведенияОбАдресе)
	
	Результат = Контракт_AddressTextInfo();
	
	Результат.AddressText = СведенияОбАдресе.Представление;
	Результат.CountryCode = СведенияОбАдресе.КодСтраны;
	Результат.Country = СведенияОбАдресе.Страна;

	Возврат Результат;
	
КонецФункции

Функция УПД970_КодМуниципальногоРайона(ТипМуниципальногоРайона)
	
	Результат = "";
	
	Если ВРег(ТипМуниципальногоРайона) = ВРег("м.р-н") Тогда
		
		Результат = "1";
		
	ИначеЕсли ВРег(ТипМуниципальногоРайона) = ВРег("г.о.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("ф.т.") Тогда
		
		Результат = "2";
		
	ИначеЕсли ВРег(ТипМуниципальногоРайона) = ВРег("вн.тер.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("вн.тер. г.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("вн.тер.г.") Тогда
		
		Результат = "3";
		
	ИначеЕсли ВРег(ТипМуниципальногоРайона) = ВРег("мун. окр.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("м.о.")
		Или ВРег(ТипМуниципальногоРайона) = ВРег("мун.окр.") Тогда
		
		Результат = "4";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Контент)
	
	ЕстьПрослеживаемыеТовары = Ложь;
	
	Для Каждого Item Из Контент.Table.Items Цикл
		Если Item.ItemTracingInfos.Количество() > 0 Тогда
			ЕстьПрослеживаемыеТовары = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПризнакиПрослежкиИМаркировки = ГенерацияXML.Новый_ПризнакиПрослеживаемыхИМаркируемыхТоваровУПД970(ЕстьПрослеживаемыеТовары);
	
	ГенерацияXML.Заполнить_ПризнакиПрослеживаемыхИМаркируемыхТоваровДокументаУПД970(Контент, ПризнакиПрослежкиИМаркировки);

КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Контент, ДокументыОтгрузки, ФункцияДокумента)
	
	СтрокиТаблицы = Контент.Table.Items;
	
	НаименованиеДокумента = УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента);
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФ() Тогда
		
		РеквизитыДокументовОтгрузки = ЗначенияРеквизитовОбъектовЛок(ДокументыОтгрузки, "Номер, Дата");
		
		Для Каждого КлючЗначение Из РеквизитыДокументовОтгрузки Цикл
			
			РеквизитыДокумента = КлючЗначение.Значение;
			
			НомерДокумента = ПредставлениеНомера(РеквизитыДокумента.Номер);
			ДатаДокумента = НачалоДня(РеквизитыДокумента.Дата);
			
			DocumentShipment = УПД970_НовыйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента);
			Контент.DocumentShipments.Добавить(DocumentShipment);
		
		КонецЦикла;
		
	Иначе
		
		НомерДокумента = Контент.DocumentNumber;
		ДатаДокумента = Контент.DocumentDate;
		
		DocumentShipment = УПД970_НовыйDocumentShipments970(НаименованиеДокумента, НомерДокумента, ДатаДокумента);
		Контент.DocumentShipments.Добавить(DocumentShipment);
		
		Контент.DocumentName = НаименованиеДокумента;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД790_НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента)
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФДОП() Тогда
		
		Результат = НаименованияДокументов.УПД;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументыОтгрузки) И ДокументыОтгрузки.Количество() > 1 Тогда
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		ЕстьУслуги = УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы);
		
		Если ЕстьТовары И НЕ ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Накладная;
			
		ИначеЕсли НЕ ЕстьТовары И ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Акт;
			
		Иначе
			Результат = НаименованияДокументов.Документ;
		КонецЕсли;
		
	Иначе
		
		ЕстьТовары = УПД970_ВДокументеЕстьТовары(СтрокиТаблицы);
		
		Если ЕстьТовары Тогда
			Результат = НаименованияДокументов.Накладная;
		Иначе
			Результат = НаименованияДокументов.Акт;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованияДокументовОтгрузки()
	
	Результат = Новый Структура;
	
	Результат.Вставить("УПД", "Универсальный передаточный документ");
	Результат.Вставить("Накладная", "Товарная накладная");
	Результат.Вставить("Акт", "Акт");
	Результат.Вставить("Документ", "Документ");
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьПризнакВыбытияИзОборотаМаркируемойПродукции(Контент, ДокСсылка)
	
	ЕстьКодыМаркировки = УПД970_ВКонтентеЕстьКодыМаркировки(Контент.Table.Items);
	
	Если ЕстьКодыМаркировки
		И Контент.Function <> ФункцияДокумента_СЧФ() Тогда
		
		ВыбытиеДляСобственныхНужд = ВыбытиеМаркируемойПродукцииДляСобственныхНужд(ДокСсылка);
		
		Если ВыбытиеДляСобственныхНужд Тогда
			
			Если Контент.AdditionalInfoId = Неопределено Тогда
				Контент.AdditionalInfoId = Контракт_AdditionalInfoId();
			КонецЕсли;
			
			ПризнакВыбытия = Новый Структура;
			ПризнакВыбытия.Вставить("Key", "СвВыбытияМАРК");
			ПризнакВыбытия.Вставить("Value", 1);
			
			Контент.AdditionalInfoId.StructedAdditionalInfos.Добавить(ПризнакВыбытия);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ВКонтентеЕстьКодыМаркировки(Items)
	
	Результат = Ложь;
	
	Для Каждого Item Из Items Цикл
		Если Item.ItemIdentificationNumbers.Количество() > 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ПорядковыйНомерИсправленияПеремещенияТоваров(СсылкаНаОбъект, ДатаСреза)
	
	МодульИсправлениеДокументов = ОбщийМодульПоИмениЛок("ИсправлениеДокументов");
	ИсправляемыйДокумент = МодульИсправлениеДокументов.ИсправляемыйДокумент(СсылкаНаОбъект);
	ИсправленияДокумента = УПД970_ИсправленияНаДатуПеремещенияТоваров(ИсправляемыйДокумент, ДатаСреза);
	
	Результат = XMLСтрока(ИсправленияДокумента.Количество());
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ИсправленияНаДатуПеремещенияТоваров(ИсправляемыйДокумент, ДатаСреза)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсправленияДокументов.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ИсправленияДокументов КАК ИсправленияДокументов
	|ГДЕ
	|	ИсправленияДокументов.ИсправляемыйДокумент = &ИсправляемыйДокумент
	|	И ИсправленияДокументов.Период <= &Период";
	
	Запрос.УстановитьПараметр("Период", ДатаСреза);
	Запрос.УстановитьПараметр("ИсправляемыйДокумент", ИсправляемыйДокумент);
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область УПД970_ЗаполнениеКонтента_ТабличнаяЧасть

Процедура УПД970_ЗаполнитьТовары(Контент, СтруктураДанных, ДополнительныеПараметры, ДокументОтгрузки = Неопределено)
	
	Перем ТаблицаДанныхПрослеживаемости, ПрослеживаемыеКомплектующие;
	
	ВыводитьБазовыеЕдИзмерения = Константы.ВыводитьБазовыеЕдиницыИзмерения.Получить();
	
	ДанныеШапки = СтруктураДанных.ДанныеШапки;
	
	НДСИсчисляетсяНалоговымАгентом = УПД970_НДСИсчисляетсяНалоговымАгентом(ДанныеШапки);
	
	ТочностьЦены = ДополнительныеПараметры.ТочностьЦены;
	ТочностьКоличества = ДополнительныеПараметры.ТочностьКоличества;

	ЕстьУчетПрослеживаемыхТоваров = ДокументомВедетсяУчетПрослеживаемыхТоваров(ДанныеШапки.Ссылка);
	Если ЕстьУчетПрослеживаемыхТоваров Тогда
		ТаблицаДанныхПрослеживаемости = УПД970_ТаблицаДанныхПрослеживаемости(СтруктураДанных);
		ПрослеживаемыеКомплектующие = УПД970_ПрослеживаемыеКомплектующие(СтруктураДанных);
	КонецЕсли;
	
	ЦенаВключаетНДС = Ложь;
	Если ЭтоОтчетДавальцу2_5(ДанныеШапки.Ссылка) Тогда
		ЦенаВключаетНДС = ЗначениеРеквизитаОбъектаЛок(ДанныеШапки.Ссылка, "ЦенаВключаетНДС");
	КонецЕсли;
	
	XMLЗначениеИстина = XMLСтрока(Истина);
	
	Если Контент.Table = Неопределено Тогда
		
		Контент.Table = Контракт_InvoiceTable970();
		
		Контент.Table.WithoutVat = XMLЗначениеИстина;
		
	КонецЕсли;
	
	Table = Контент.Table;
	
	ИтогиПоДокументу = СтруктураДанных.РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ИспользоватьНаборы = Ложь;
	Если СтруктураДанных.РезультатПоТабличнойЧасти.Колонки.Найти("ЭтоНабор") <> Неопределено Тогда
		ИспользоватьНаборы = Истина;
	КонецЕсли;
	
	Пока ИтогиПоДокументу.Следующий() Цикл
		
		ДанныеСтрокиТЧ = ИтогиПоДокументу.Выбрать();
		Пока ДанныеСтрокиТЧ.Следующий() Цикл
			
			Если ИспользоватьНаборы И ДанныеСтрокиТЧ.ЭтоНабор
				И ЭтоПредставлениеНабораИКомплектующих(ДанныеСтрокиТЧ.ВариантПредставленияНабораВПечатныхФормах) Тогда
				Продолжить;
			КонецЕсли;
			
			Item = Контракт_Item970();
			
			ПараметрыЗаполненияСтроки = НовыйПараметрыЗаполненияСтрокиКонтента(
				Контент.Function,
				НДСИсчисляетсяНалоговымАгентом,
				ТочностьКоличества,
				ТочностьЦены,
				ЦенаВключаетНДС);
			
			УПД970_ЗаполнитьСтрокуТоваров(Item, ДанныеСтрокиТЧ, ПараметрыЗаполненияСтроки);
			
			Если ЕстьУчетПрослеживаемыхТоваров Тогда
				
				УПД970_ЗаполнитьСведенияОТаможеннойДекларации(Item, ДанныеСтрокиТЧ);
			
				УПД970_ЗаполнитьСведенияОПрослеживаемости(
					Item,
					ДанныеСтрокиТЧ,
					ТаблицаДанныхПрослеживаемости,
					ПрослеживаемыеКомплектующие);
					
			КонецЕсли;

			Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(
				ДанныеСтрокиТЧ,
				ДокументОтгрузки,
				ВыводитьБазовыеЕдИзмерения);
			
			Если Table.WithoutVat = XMLЗначениеИстина
				И Item.WithoutVat <> XMLЗначениеИстина Тогда
				Table.WithoutVat = Item.WithoutVat;
			КонецЕсли;
			
			УПД970_ДополнитьИтоговыеЗначенияПоТаблицу(Table, Item, НДСИсчисляетсяНалоговымАгентом);
			
			Table.Items.Добавить(Item);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДокументомВедетсяУчетПрослеживаемыхТоваров(ДокументСсылка)
	
	Результат = ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом")
		И Не ЭтоОтчетДавальцу(ДокументСсылка)
		И Не ЭтоПередачаНаКомиссию(ДокументСсылка);
	
	Возврат Результат;
	
КонецФункции

Функция НовыйПараметрыЗаполненияСтрокиКонтента(
	ФункцияДокумента,
	НДСИсчисляетсяНалоговымАгентом,
	ТочностьКоличества,
	ТочностьЦены,
	ЦенаВключаетНДС)

	Результат = Новый Структура;
	Результат.Вставить("НДСИсчисляетсяНалоговымАгентом", НДСИсчисляетсяНалоговымАгентом);
	Результат.Вставить("ТочностьКоличества", ТочностьКоличества);
	Результат.Вставить("ТочностьЦены", ТочностьЦены);
	Результат.Вставить("ФункцияДокумента", ФункцияДокумента);
	Результат.Вставить("ЦенаВключаетНДС", ЦенаВключаетНДС);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ДополнитьИтоговыеЗначенияПоТаблицу(Table, Item, НДСИсчисляетсяНалоговымАгентом)
	
	Table.TotalNet = Table.TotalNet + Item.Quantity;
	Table.TotalWithVatExcluded = Table.TotalWithVatExcluded + Item.SubtotalWithVatExcluded;
	
	Если Не НДСИсчисляетсяНалоговымАгентом Тогда
		Table.Vat = Table.Vat + Item.Vat;
		Table.Total = Table.Total + Item.Subtotal;
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСтрокуТоваров(Item, ДанныеСтрокиТЧ, ДопПараметры)
	
	Содержание = "";
	Item.Product = ПредставлениеНоменклатуры(
		ДанныеСтрокиТЧ.НоменклатураНаименование,
		ДанныеСтрокиТЧ.ХарактеристикаНаименование,
		Содержание
	);
	
	Item.ItemMark = УПД970_ПризнакТовараИлиУслугиПоСтрокеДокумента(ДанныеСтрокиТЧ);
	
	Если ЗначениеЗаполнено(ДанныеСтрокиТЧ.НоменклатураКод) Тогда
		Item.ItemVendorCode = ДанныеСтрокиТЧ.НоменклатураКод;
	КонецЕсли;
	
	УПД970_ЗаполнитьЕдиницуИзмеренияПоСтрокеТаблицы(Item, ДанныеСтрокиТЧ);
	
	УПД970_ЗаполнитьКоличествоПоСтроке(
			Item,
			ДанныеСтрокиТЧ,
			ДопПараметры.ФункцияДокумента,
			ДопПараметры.ТочностьКоличества);
			
	УПД970_ЗаполнитьЦенуПоСтроке(
			Item,
			ДанныеСтрокиТЧ,
			ДопПараметры.ФункцияДокумента,
			ДопПараметры.ТочностьЦены,
			ДопПараметры.ЦенаВключаетНДС);
	
	Item.TaxRate = ПредставлениеСтавкиНДС(ДанныеСтрокиТЧ.СтавкаНДС, ДопПараметры.НДСИсчисляетсяНалоговымАгентом);
	
	Item.SubtotalWithVatExcluded = ДанныеСтрокиТЧ.СуммаБезНДС;
	
	Если ДопПараметры.НДСИсчисляетсяНалоговымАгентом Тогда
		Item.Vat = 0;
		Item.Subtotal = 0;
		Item.WithoutVat = XMLСтрока(Ложь);
	Иначе
		Item.Vat = ДанныеСтрокиТЧ.СуммаНДС;
		Item.Subtotal = ДанныеСтрокиТЧ.СуммаСНДС;
		Item.WithoutVat = XMLСтрока(ДанныеСтрокиТЧ.СтавкаНДС = ЗначениеСтавкиБезНДС());
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьЕдиницуИзмеренияПоСтрокеТаблицы(СтрокаКонтента, СтрокаТаблицы)
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ЕдиницаИзмерения) Тогда
		
		КодЕИ = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияКод);
		ИмяЕИ = СокрЛП(СтрокаТаблицы.ЕдиницаИзмерения);
		
		СтрокаКонтента.Unit = ГенерацияXML.XML_КодЕдиницыИзмерения(КодЕИ);
		СтрокаКонтента.UnitName = ИмяЕИ;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьКоличествоПоСтроке(Item, СтрокаТаблицы, ФункцияДокумента, ТочностьКоличества)
	
	Item.Quantity = 0;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
		
		Item.Quantity = Окр(СтрокаТаблицы.Количество, ТочностьКоличества);
		
	Иначе
		
		ТипыНоменклатурыКонтента = ГенерацияXML.Перечисление_ItemMarks();
		
		ЭтоТипНоменклатурыУслугаИлиРабота = (Item.ItemMark = ТипыНоменклатурыКонтента.Услуга
			Или Item.ItemMark = ТипыНоменклатурыКонтента.Работа);
		
		КоличествоИЦенаОбязательны = УПД970_КоличествоИЦенаОбязательныПоФормату(ФункцияДокумента, Item.Unit);

		Если КоличествоИЦенаОбязательны И ЭтоТипНоменклатурыУслугаИлиРабота Тогда
			Item.Quantity = 1;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ЗаполнитьЦенуПоСтроке(Item, СтрокаТаблицы, ФункцияДокумента, ТочностьЦены, ЦенаВключаетНДС)
	
	Item.Price = 0;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.Цена) Тогда
		
		Если ЦенаВключаетНДС И ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			Цена = СтрокаТаблицы.СуммаБезНДС / СтрокаТаблицы.Количество;
		Иначе
			Цена = СтрокаТаблицы.Цена;
		КонецЕсли;
		
		Item.Price = Окр(Цена, ТочностьЦены);
		
	Иначе
		
		ТипыНоменклатурыКонтента = ГенерацияXML.Перечисление_ItemMarks();
		
		ЭтоТипНоменклатурыУслугаИлиРабота = (Item.ItemMark = ТипыНоменклатурыКонтента.Услуга
			Или Item.ItemMark = ТипыНоменклатурыКонтента.Работа);
		
		КоличествоИЦенаОбязательны = УПД970_КоличествоИЦенаОбязательныПоФормату(ФункцияДокумента, Item.Unit);

		Если КоличествоИЦенаОбязательны
			И ЭтоТипНоменклатурыУслугаИлиРабота
			И ЗначениеЗаполнено(Item.Quantity) Тогда
			
			Item.Price = Окр(СтрокаТаблицы.СуммаБезНДС / Item.Quantity, ТочностьЦены);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура УПД970_ЗаполнитьТаблицуКонтентаПоСчетФактураНаАванс(
	Контент,
	РезультатПоТабличнойЧасти,
	НДСИсчисляетсяНалоговымАгентом)
	
	ВсеСтрокиБезНДС = Истина;
	СтавкаБезНДС = ЗначениеСтавкиБезНДС();

	Table = Контракт_InvoiceTable970();
	
	ВыборкаИтоговТЧ = РезультатПоТабличнойЧасти.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаИтоговТЧ.Следующий() Цикл
		
		ДанныеСтрокиТЧ = ВыборкаИтоговТЧ.Выбрать();
		Пока ДанныеСтрокиТЧ.Следующий() Цикл
			
			Item = Контракт_Item970();
			
			Item.Product = ДанныеСтрокиТЧ.НоменклатураНаименование;
			Item.ItemMark = УПД970_ПризнакТовараИлиУслугиПоСтрокеДокумента(ДанныеСтрокиТЧ);
			
			Item.TaxRate = ПредставлениеСтавкиНДС(ДанныеСтрокиТЧ.СтавкаНДС, НДСИсчисляетсяНалоговымАгентом);
			
			ЭтоСтавкаБезНДС = (ДанныеСтрокиТЧ.СтавкаНДС = СтавкаБезНДС);
			Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
			
			Если НДСИсчисляетсяНалоговымАгентом Тогда
				Item.Vat = 0;
				Item.Subtotal = 0;
				Item.SubtotalWithVatExcluded = ДанныеСтрокиТЧ.СуммаСНДС;
			Иначе
				Item.Vat = ДанныеСтрокиТЧ.СуммаНДС;
				Item.Subtotal = ДанныеСтрокиТЧ.СуммаСНДС;
				Item.SubtotalWithVatExcluded = ДанныеСтрокиТЧ.СуммаБезНДС;
			КонецЕсли;
			
			Item.СлужебнаяИнформация = Контракт_СлужебнаяИнформацияСтроки();
			
			Table.Items.Добавить(Item);
			
			Если ДанныеСтрокиТЧ.СтавкаНДС <> СтавкаБезНДС Тогда
				ВсеСтрокиБезНДС = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		Table.TotalNet = ВыборкаИтоговТЧ.Количество;
		Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
		
		Если НДСИсчисляетсяНалоговымАгентом Тогда
			Table.Vat = 0;
			Table.Total = 0;
			Table.TotalWithVatExcluded = ВыборкаИтоговТЧ.СуммаСНДС;
		Иначе
			Table.Vat = ВыборкаИтоговТЧ.СуммаНДС;
			Table.Total = ВыборкаИтоговТЧ.СуммаСНДС;
			Table.TotalWithVatExcluded = ВыборкаИтоговТЧ.СуммаБезНДС;
		КонецЕсли;
		
	КонецЦикла;

	Контент.Table = Table;
	
КонецПроцедуры

