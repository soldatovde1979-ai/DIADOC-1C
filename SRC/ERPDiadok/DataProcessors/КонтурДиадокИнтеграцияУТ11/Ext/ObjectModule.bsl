	Результат = ФункцияДокумента <> ФункцияДокумента_ДОП()
				И ЗначениеЗаполнено(КодЕдиницыИзмерения);
			
	Возврат Результат;
	
КонецФункции

Функция УПД970_ПризнакТовараИлиУслугиПоСтрокеДокумента(ДанныеСтрокиТЧ)
	
	ТипыНоменклатурыКонтента = ГенерацияXML.Перечисление_ItemMarks();
	
	ТипНоменклатуры = Неопределено;
	Если ЗначениеЗаполнено(ДанныеСтрокиТЧ.Номенклатура) Тогда
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеСтрокиТЧ.Номенклатура, "ТипНоменклатуры");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДанныеСтрокиТЧ.Номенклатура)
		И ЗначениеЗаполнено(ДанныеСтрокиТЧ.НоменклатураНаименование) Тогда
		
		Результат = ТипыНоменклатурыКонтента.Услуга;	
		
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
		
		Результат = ТипыНоменклатурыКонтента.Услуга;
		
	ИначеЕсли ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
		
		Результат = ТипыНоменклатурыКонтента.Работа;
		
	Иначе
		
		Результат = ТипыНоменклатурыКонтента.Имущество;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЗаполненныйСлужебнаяИнформацияItem(
	СтрокаТаблицы,
	ДокументОтгрузки = Неопределено,
	ВыводитьБазовыеЕдиницыИзмерения = Ложь)
	
	Результат = Контракт_СлужебнаяИнформацияСтроки();
	
	Если Не ВыводитьБазовыеЕдиницыИзмерения Тогда
		Результат.Упаковка = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Упаковка");
		Результат.УпаковкаДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "УпаковкаДоИзменения");
	КонецЕсли;
	
	Результат.ЕдиницаИзмерения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "ЕдиницаИзмерения");
	Результат.ЕдиницаИзмеренияДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "ЕдиницаИзмеренияДоИзменения");
	
	Результат.Номенклатура = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Номенклатура");
	Результат.Характеристика = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Характеристика");
	Результат.Серия = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "Серия");
	Результат.СтранаПроисхождения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтранаПроисхождения");
	Результат.СтавкаНДС = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтавкаНДС");
	Результат.СтавкаНДСДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "СтавкаНДСДоИзменения");
	Результат.НомерГТД = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТаблицы, "НомерГТД");
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "ПрослеживаемыйТовар") Тогда
		Результат.ПрослеживаемыйТовар = СтрокаТаблицы.ПрослеживаемыйТовар;
	Иначе
		Результат.ПрослеживаемыйТовар = Ложь;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "Ссылка") Тогда
		Результат.ДокументОтгрузки = СтрокаТаблицы.Ссылка;
	Иначе
		Результат.ДокументОтгрузки = ДокументОтгрузки;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "ИдентификаторСтроки") Тогда
		Результат.ИдентификаторСтроки = СтрокаТаблицы.ИдентификаторСтроки;
	КонецЕсли;
	
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "ИмяТабличнойЧасти") Тогда
		Результат.ПутьКИдентификаторуСтроки = СтрокаТаблицы.ИмяТабличнойЧасти;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОТаможеннойДекларации(Item, СтрокаТаблицы)
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерГТД)
		Или Не ЗначениеЗаполнено(СтрокаТаблицы.СтранаПроисхожденияКод) Тогда
		Возврат;
	КонецЕсли;
	
	CustomDeclaration = Контракт_CustomDeclarations();
	CustomDeclaration.CountryCode = СтрокаТаблицы.СтранаПроисхожденияКод;
	CustomDeclaration.DeclarationNumber = СокрЛП(СтрокаТаблицы.НомерГТД);
		
	Item.CustomDeclarations.Добавить(CustomDeclaration);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПрослеживаемости(
		Item,
		СтрокаТаблицы,
		ТаблицаДанныхПрослеживаемости,
		ПрослеживаемыеКомплектующие)
	
	КоличествоПоРНПТ = 0;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "КоличествоПоРНПТ") Тогда
		КоличествоПоРНПТ = СтрокаТаблицы.КоличествоПоРНПТ;
	КонецЕсли;
	
	ТипНомераГТД = Неопределено;
	Если ЕстьРеквизитИлиСвойствоОбъектаЛок(СтрокаТаблицы, "ТипНомераГТД") Тогда
		ТипНомераГТД = СтрокаТаблицы.ТипНомераГТД;
	КонецЕсли;
	
	Если УПД970_СтрокаТоваровСодержитНомерРНПТ(КоличествоПоРНПТ, ТипНомераГТД) Тогда
		
		ItemTracingInfo = Контракт_ItemTracingInfo970();
		
		ItemTracingInfo.RegNumberUnit = СокрЛП(Строка(СтрокаТаблицы.НомерГТД));
		ItemTracingInfo.Unit = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияТНВЭДКод);
		ItemTracingInfo.UnitName = СокрЛП(СтрокаТаблицы.ЕдиницаИзмеренияТНВЭДНаименование);
		ItemTracingInfo.Quantity = КоличествоПоРНПТ;
		ItemTracingInfo.SumWithoutVat = СтрокаТаблицы.СуммаБезНДС;
		
		Item.ItemTracingInfos.Добавить(ItemTracingInfo);
		
	ИначеЕсли ЗначениеЗаполнено(КоличествоПоРНПТ)
		И ЗначениеЗаполнено(ПрослеживаемыеКомплектующие) Тогда
		
		ОтборСтрок = Новый Структура("НомерГТД", СтрокаТаблицы.НомерГТДСсылка);
		Комплектующие = ПрослеживаемыеКомплектующие.НайтиСтроки(ОтборСтрок);
		
		Для Каждого СтрокаКомплекта Из Комплектующие Цикл
			
			СтоимостьБезНДС = СтоимостьПоРНПТСтрокиКомплекта(
					СтрокаТаблицы.СуммаБезНДС,
					СтрокаКомплекта.ОбщаяСуммаПоКомплекту,
					СтрокаКомплекта.СуммаПоРНПТ);
			
			ItemTracingInfo = Контракт_ItemTracingInfo970();
			
			ItemTracingInfo.RegNumberUnit = СокрЛП(СтрокаКомплекта.НомерТовара);
			ItemTracingInfo.Unit = СокрЛП(СтрокаКомплекта.ЕдиницаИзмеренияКод);
			ItemTracingInfo.UnitName = СокрЛП(СтрокаКомплекта.ЕдиницаИзмеренияНаименование);
			ItemTracingInfo.Quantity = СтрокаКомплекта.Количество * КоличествоПоРНПТ;
			ItemTracingInfo.SumWithoutVat = СтоимостьБезНДС;
			
			Item.ItemTracingInfos.Добавить(ItemTracingInfo);
			
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(ТаблицаДанныхПрослеживаемости) Тогда
		
		НомерСтрокиСФ = СтрокаТаблицы.НомерСтроки;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТаблицы, "НомерСтрокиИсходногоСФ")
			И ЗначениеЗаполнено(СтрокаТаблицы.НомерСтрокиИсходногоСФ) Тогда
			НомерСтрокиСФ = СтрокаТаблицы.НомерСтрокиИсходногоСФ;
		КонецЕсли;
		
		ПараметрыПоиска = Новый Структура();
		ПараметрыПоиска.Вставить("СчетФактура", СтрокаТаблицы.Ссылка);
		ПараметрыПоиска.Вставить("НомерСтрокиСФ", НомерСтрокиСФ);
		
		СтрокиДанных = ТаблицаДанныхПрослеживаемости.НайтиСтроки(ПараметрыПоиска);
		
		Item.CustomDeclarations.Очистить();
		
		КодВидаТовара = "";
		
		Для Каждого СтрокаДанных Из СтрокиДанных Цикл
			
			Если ЗначениеЗаполнено(СтрокаДанных.КодТНВЭД) Тогда
				КодВидаТовара = СтрокаДанных.КодТНВЭД;
			КонецЕсли;
			
			ItemTracingInfo = Контракт_ItemTracingInfo970();
			
			ItemTracingInfo.RegNumberUnit = СокрЛП(Строка(СтрокаДанных.НомерТовара));
			ItemTracingInfo.Unit = СокрЛП(СтрокаДанных.ЕдиницаИзмеренияКод);
			ItemTracingInfo.UnitName = СокрЛП(СтрокаДанных.ЕдиницаИзмеренияНаименование);
			ItemTracingInfo.Quantity = СтрокаДанных.Количество;
			ItemTracingInfo.SumWithoutVat = СтрокаДанных.СуммаПоРНПТ;
			
			Item.ItemTracingInfos.Добавить(ItemTracingInfo);
			
			УПД970_ЗаполнитьСведенияОТаможеннойДекларации(Item, СтрокаДанных);
			
		КонецЦикла;
		
		ВыводитьКодыТНВЭД = СтранаЧленТС(СтрокаТаблицы.СтранаПроисхожденияКод);
		
		Если ЗначениеЗаполнено(КодВидаТовара) И ВыводитьКодыТНВЭД Тогда
			Item.ItemTypeCode = КодВидаТовара;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Item.CustomDeclarations)
		И ЗначениеЗаполнено(Item.ItemTracingInfos) Тогда
		
		Для Каждого CustomDeclaration Из Item.CustomDeclarations Цикл
			CustomDeclaration.DeclarationNumber = "Прослеж";
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_СтрокаТоваровСодержитНомерРНПТ(КоличествоПоРНПТ, ТипНомераГТД)
	
	Результат = Ложь;
	
	ЕстьПоддержкаКомплектовСПрослежкой = ЕстьФункциональностьУчетаПрослеживаемыхКомплектующих();
	
	Если ЗначениеЗаполнено(КоличествоПоРНПТ)
		И Не ЕстьПоддержкаКомплектовСПрослежкой Тогда
		
		Результат = Истина;
		
	ИначеЕсли ЗначениеЗаполнено(КоличествоПоРНПТ)
		И ЕстьПоддержкаКомплектовСПрослежкой Тогда
		
		Результат = (ТипНомераГТД = Перечисления["ТипыНомеровГТД"].НомерРНПТ);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

