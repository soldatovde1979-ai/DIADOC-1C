#КонецОбласти

#Область УПД970_ЗаполнениеКонтента_СведенияОПередачеТоваров

Процедура УПД970_ЗаполнитьСведенияОПередачеТоваров(Контент, ОснованияОтгрузки, ДополнительныеПараметры)

	TransferInfo = Контракт_TransferInfo970();
	Контент.TransferInfo = TransferInfo;
	
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	
	Если Контент.Function <> ФункцияДокумента_СЧФ() Тогда
		TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Контент.DocumentDate, Контент.DocumentShipments);
	КонецЕсли;
	
	УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры)
	
	Перем УказыватьОтсутствиеОснованияУПД;
	
	ДополнительныеПараметры.Свойство("УказыватьОтсутствиеОснованияУПД", УказыватьОтсутствиеОснованияУПД);
		
	Для Каждого РеквизитыОснования Из ОснованияОтгрузки Цикл
		
		РеквизитыЗаполнены = Ложь;
		
		Если ЗначениеЗаполнено(РеквизитыОснования.Наименование)
			И ЗначениеЗаполнено(РеквизитыОснования.Номер)
			И ЗначениеЗаполнено(РеквизитыОснования.Дата) Тогда
			
			РеквизитыЗаполнены = Истина;
			
		КонецЕсли;
		
		Если Не РеквизитыЗаполнены
			И УказыватьОтсутствиеОснованияУПД = Истина Тогда
			
			TransferInfo.TransferBases.Очистить();
			
			Прервать;
			
		Иначе
			
			TransferBase = УПД970_НовыйTransferBases(
				РеквизитыОснования.Наименование,
				РеквизитыОснования.Номер,
				РеквизитыОснования.Дата);
			
			TransferInfo.TransferBases.Добавить(TransferBase);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если TransferInfo.TransferBases.Количество() = 0 Тогда
		УПД970_УстановитьЗначениеБезОснованияОтгрузки(TransferInfo);
	КонецЕсли;
	
КонецПроцедуры

Процедура УПД970_УстановитьЗначениеБезОснованияОтгрузки(Контент)
	Контент.WithoutTransferBase = Истина;
КонецПроцедуры

Функция УПД970_РеквизитыОснованийОтгрузкиУстаревший(ДокументыОтгрузки, ДанныеШапки = Неопределено)
	
	Результат = УПЛ970_РеквизитыОснованияОтгрузкиПоДаннымШапки(ДанныеШапки);
	Если Результат.Количество() = 0 Тогда
		Результат = УПЛ970_РеквизитыОснованияОтгрузкиПоДокументам(ДокументыОтгрузки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованийОтгрузки(
	НаименованиеОснования,
	НомерОснования,
	ДатаОснования,
	ДокументыОтгрузки)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(НаименованиеОснования)
		ИЛИ ЗначениеЗаполнено(НомерОснования)
		ИЛИ ЗначениеЗаполнено(ДатаОснования) Тогда
		
		РеквизитыОснования = УПД970_НовыйРеквизитыОснованияОтгрузки(
			НаименованиеОснования,
			НомерОснования,
			ДатаОснования);
		
		УПД970_УдалитьДатуНомерИзНаименованияОснованияОтгрузки(РеквизитыОснования);
		
		Если ЗначениеЗаполнено(РеквизитыОснования.Наименование)
			И ЗначениеЗаполнено(РеквизитыОснования.Дата) Тогда
			Результат.Добавить(РеквизитыОснования);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		Результат = УПЛ970_РеквизитыОснованияОтгрузкиПоДокументам(ДокументыОтгрузки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПЛ970_РеквизитыОснованияОтгрузкиПоДаннымШапки(ДанныеШапки)
	
	Результат = Новый Массив;
	
	ЕстьРеквизитыОснования = УПД970_ЕстьРеквизитыОснованияПередачи(ДанныеШапки);
	
	Если ЕстьРеквизитыОснования
		И (ЗначениеЗаполнено(ДанныеШапки.Основание)
			ИЛИ ЗначениеЗаполнено(ДанныеШапки.ОснованиеНомер)
			ИЛИ ЗначениеЗаполнено(ДанныеШапки.ОснованиеДата)) Тогда
		
		Если ТипЗнч(ДанныеШапки.Основание) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			
			РеквизитыОснования = ОписаниеОснованияПередачиДокумента(ДанныеШапки.Основание);
			
		Иначе
			
			РеквизитыОснования = УПД970_НовыйРеквизитыОснованияОтгрузки(
					ДанныеШапки.Основание,
					ДанныеШапки.ОснованиеНомер,
					ДанныеШапки.ОснованиеДата);
			
		КонецЕсли;
		
		УПД970_УдалитьДатуНомерИзНаименованияОснованияОтгрузки(РеквизитыОснования);
		
		Если ЗначениеЗаполнено(РеквизитыОснования.Наименование)
			И ЗначениеЗаполнено(РеквизитыОснования.Дата) Тогда
			Результат.Добавить(РеквизитыОснования);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ЕстьРеквизитыОснованияПередачи(ДанныеШапки)
	
	Результат = Ложь;
	
	Если ДанныеШапки <> Неопределено Тогда
		Результат = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШапки, "ОснованиеНомер");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияДокументаСредствамиКонфигурации(ДокументСсылка)

	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	ТипыДокСПрограммнымИнтерфейсом = Новый Массив;
	ТипыДокСПрограммнымИнтерфейсом.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));
	ТипыДокСПрограммнымИнтерфейсом.Добавить(Тип("ДокументСсылка.ВозвратТоваровПоставщику"));
	ТипыДокСПрограммнымИнтерфейсом.Добавить(Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом"));
	ТипыДокСПрограммнымИнтерфейсом.Добавить(Тип("ДокументСсылка.КорректировкаРеализации"));
	ТипыДокСПрограммнымИнтерфейсом.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		ТипыДокСПрограммнымИнтерфейсом.Добавить(Тип("ДокументСсылка.ОтчетДавальцу2_5"));
	КонецЕсли;
	
	Если ТипыДокСПрограммнымИнтерфейсом.Найти(ТипДокумента) <> Неопределено Тогда
		
		МетаданныеДокумента = ДокументСсылка.Метаданные();
		
		СтруктураОснования = Документы[МетаданныеДокумента.Имя].СтруктураОснованияДляПечати(ДокументСсылка);
		
		Если ЗначениеЗаполнено(СтруктураОснования.Основание) Тогда
			
			Результат = УПД970_НовыйРеквизитыОснованияОтгрузки(
				СтруктураОснования.Основание,
				СтруктураОснования.ОснованиеНомер,
				СтруктураОснования.ОснованиеДата);
			
			УПД970_УдалитьДатуНомерИзНаименованияОснованияОтгрузки(Результат);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_РеквизитыОснованияПоРеквизитамДокумента(ДокументСсылка)
	
	Перем Результат;
	
	ИменаРеквизитовДокумента = Новый Массив;
	
	Если ЕстьРеквизитЗаказКлиента(ДокументСсылка) Тогда
		ИменаРеквизитовДокумента.Добавить("ЗаказКлиента");
	КонецЕсли;
	
	Если ЕстьРеквизитДоговораКлиента(ДокументСсылка) Тогда
		ИменаРеквизитовДокумента.Добавить("Договор");
	КонецЕсли;
	
	Если ЕстьРеквизитСоглашениеСКлиентом(ДокументСсылка) Тогда
		ИменаРеквизитовДокумента.Добавить("Соглашение");
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ИменаРеквизитовДокумента);
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитовДокумента Цикл
		
		ЗначениеРеквизита = ЗначенияРеквизитов[ИмяРеквизита];
		Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Результат = ОписаниеОснованияПередачиДокумента(ЗначениеРеквизита);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Функция УПЛ970_РеквизитыОснованияОтгрузкиПоДокументам(ДокументыОтгрузки)
	
	Результат = Новый Массив;
	
	Для Каждого ДокументСсылка Из ДокументыОтгрузки Цикл
		
		РеквизитыОснования = УПД970_РеквизитыОснованияДокументаСредствамиКонфигурации(ДокументСсылка);
		
		Если РеквизитыОснования = Неопределено
			Или НЕ ЗначениеЗаполнено(РеквизитыОснования.Наименование) Тогда
			РеквизитыОснования = УПД970_РеквизитыОснованияПоРеквизитамДокумента(ДокументСсылка);
		КонецЕсли;
		
		Если РеквизитыОснования <> Неопределено
			И ЗначениеЗаполнено(РеквизитыОснования.Наименование) Тогда
			Результат.Добавить(РеквизитыОснования);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НовыйРеквизитыОснованияОтгрузки(Наименование = "", Номер = "", Дата = '00010101')

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Наименование);
	Результат.Вставить("Номер", Номер);
	Результат.Вставить("Дата", Дата);
	
	Возврат Результат;
	
КонецФункции

Процедура УПД970_УдалитьДатуНомерИзНаименованияОснованияОтгрузки(РеквизитыОснования)
	
	Если ЗначениеЗаполнено(РеквизитыОснования.Дата)
			И ЗначениеЗаполнено(РеквизитыОснования.Номер) Тогда
			
			ПозНомера = Найти(РеквизитыОснования.Наименование, "№");
			
			Если ПозНомера > 0 Тогда
				РеквизитыОснования.Наименование = СокрЛП(Лев(РеквизитыОснования.Наименование, ПозНомера - 1));
			КонецЕсли;
			
		КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ПолучитьДатуОтгрузки(DocumentDate, DocumentShipments)
	
	Результат = DocumentDate;
	
	Для Каждого DocumentShipment Из DocumentShipments Цикл
		Результат = DocumentShipment.Date;
		Прервать;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область УПД970_ЗаполнениеКонтента_ПлатежноРасчетныеДокументы

Процедура УПД970_ЗаполнитьСведенияОПлатежноРасчетныхДокументах(Контент, ПлатежноРасчетныеДокументы)
	
	Если Не ЗначениеЗаполнено(ПлатежноРасчетныеДокументы) Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого СтрокаПРД Из ПлатежноРасчетныеДокументы Цикл
		PaymentDocument = УПД970_НовыйPaymentDocument(СтрокаПРД.НомерДокумента, СтрокаПРД.ДатаДокумента);
		Контент.Добавить(PaymentDocument);
	КонецЦикла;
	
КонецПроцедуры

Процедура УПД970_ЗаполнитьСведенияОПлатежноРасчетныхДокументахПоСчетФактуре(Контент, СчетФактура)
	
	ПлатежноРасчетныеДокументы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФактура, "ПлатежноРасчетныеДокументы");
	Если Не ПлатежноРасчетныеДокументы.Пустой() Тогда
		
		ВыборкаДокументов = ПлатежноРасчетныеДокументы.Выбрать();
		Пока ВыборкаДокументов.Следующий() Цикл
			
			PaymentDocument = УПД970_НовыйPaymentDocument(
				ВыборкаДокументов.НомерПлатежноРасчетногоДокумента,
				ВыборкаДокументов.ДатаПлатежноРасчетногоДокумента);
				
			Контент.Добавить(PaymentDocument);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

