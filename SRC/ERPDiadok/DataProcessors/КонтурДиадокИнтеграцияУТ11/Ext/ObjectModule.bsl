Функция ТекстЗапроса_СчетаФактуры(ОписаниеВидаПакета, ВидСчетаФактуры, Исправление)
	
	КатегорияПакета	= ОписаниеВидаПакета.КатегорияПакета;
	ВидПакетаID		= ОписаниеВидаПакета.ID;
	
	Если ЕстьПравоЧтенияЖурналаУчетаСчетовФактур() Тогда
		Результат = ТекстЗапроса_СчетаФактуры_ПоРегистру();
	Иначе
		Результат = ТекстЗапроса_СчетаФактуры_ПоДокументу();
	КонецЕсли;
	
	Если Исправление Тогда
		
		Если ВидПакетаID = "ID_ИСФ" Тогда
			ВидИсправляемогоПакета = "ID_ОсновнойПакет";
		Иначе
			ВидИсправляемогоПакета = СтрЗаменить(ВидПакетаID, "ID_И", "ID_");
		КонецЕсли;
		
		Результат = СтрЗаменить(Результат, "ВТ_КэшКонтрагентовПоВидамПакетов.ВидПакетаID = &ВидПакетаID",
										   "ВТ_КэшКонтрагентовПоВидамПакетов.ВидПакетаID = """ + ВидИсправляемогоПакета + """");
		
		Результат = СтрЗаменить(Результат, "НЕ ДокСчетФактура.Исправление", "ДокСчетФактура.Исправление");
		
	КонецЕсли;
	
	Если ВидСчетаФактуры = "Корректировочный" Тогда
		
		Результат = СтрЗаменить(Результат, "НЕ ДокСчетФактура.Корректировочный", "ДокСчетФактура.Корректировочный");
		
	ИначеЕсли ВидСчетаФактуры = "НаАванс" Тогда	
		
		Результат = СтрЗаменить(Результат, "Документ.СчетФактураВыданный", "Документ.СчетФактураВыданныйАванс");
		Результат = СтрЗаменить(Результат, "И НЕ ДокСчетФактура.Корректировочный", "");
		
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "&ВидПакетаID",	"""" + ВидПакетаID + """");
	Результат = СтрЗаменить(Результат, "НаРеализацию",	ВидСчетаФактуры);
	
	Результат = ТекстЗапроса_СкорректированныеСвязиДляОтправленныхДокументов(Результат, ОписаниеВидаПакета);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_СчетаФактуры_ПоРегистру()
	
	Результат =
		"ВЫБРАТЬ
		|	ДокСчетФактура.Ссылка КАК Документ,
		|	ДокСчетФактура.Номер КАК НомерДокумента,
		|	ДокСчетФактура.Дата КАК ДатаДокумента,
		|	ДокСчетФактура.Контрагент КАК Контрагент,
		|	ДокСчетФактура.Организация КАК Организация,
		|	СУММА(ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре, 0) + ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение, 0) - ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение, 0)) КАК СуммаДокумента,
		|	&ВидПакетаID КАК ВидПакетаID
		|ИЗ
		|	Документ.СчетФактураВыданный КАК ДокСчетФактура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КэшКонтрагентовПоВидамПакетов КАК ВТ_КэшКонтрагентовПоВидамПакетов
		|		ПО ДокСчетФактура.Организация = ВТ_КэшКонтрагентовПоВидамПакетов.Организация1С
		|			И ДокСчетФактура.Контрагент = ВТ_КэшКонтрагентовПоВидамПакетов.Контрагент1С
		|			И (ВТ_КэшКонтрагентовПоВидамПакетов.ВидПакетаID = &ВидПакетаID)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтправленныеДокументы КАК ОтправленныеДокументы
		|		ПО ДокСчетФактура.Ссылка = ОтправленныеДокументы.Документ
		|			И (&УсловиеСвязиПоКатегорииПакета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СчетФактурыПоОтчетуКомиссионера КАК СчетФактурыПоОтчетуКомиссионера
		|		ПО ДокСчетФактура.Ссылка = СчетФактурыПоОтчетуКомиссионера.Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
		|		ПО ДокСчетФактура.Ссылка = ЖурналУчетаСчетовФактур.СчетФактура
		|			И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры)
		|ГДЕ
		|	ОтправленныеДокументы.Документ ЕСТЬ NULL
		|	И НЕ ВТ_КэшКонтрагентовПоВидамПакетов.ОтправлятьНепроведенные
		|	И ДокСчетФактура.Проведен
		|	И ДокСчетФактура.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ДокСчетФактура.Корректировочный
		|	И НЕ ДокСчетФактура.Исправление
		|	И СчетФактурыПоОтчетуКомиссионера.Документ ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокСчетФактура.Ссылка,
		|	ДокСчетФактура.Номер,
		|	ДокСчетФактура.Дата,
		|	ДокСчетФактура.Контрагент,
		|	ДокСчетФактура.Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДокСчетФактура.Ссылка,
		|	ДокСчетФактура.Номер,
		|	ДокСчетФактура.Дата,
		|	ДокСчетФактура.Контрагент,
		|	ДокСчетФактура.Организация,
		|	СУММА(ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуре, 0) + ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУвеличение, 0) - ЕСТЬNULL(ЖурналУчетаСчетовФактур.СуммаПоСчетуФактуреРазницаУменьшение, 0)),
		|	&ВидПакетаID
		|ИЗ
		|	Документ.СчетФактураВыданный КАК ДокСчетФактура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КэшКонтрагентовПоВидамПакетов КАК ВТ_КэшКонтрагентовПоВидамПакетов
		|		ПО ДокСчетФактура.Организация = ВТ_КэшКонтрагентовПоВидамПакетов.Организация1С
		|			И ДокСчетФактура.Контрагент = ВТ_КэшКонтрагентовПоВидамПакетов.Контрагент1С
		|			И (ВТ_КэшКонтрагентовПоВидамПакетов.ВидПакетаID = &ВидПакетаID)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтправленныеДокументы КАК ОтправленныеДокументы
		|		ПО ДокСчетФактура.Ссылка = ОтправленныеДокументы.Документ
		|			И (&УсловиеСвязиПоКатегорииПакета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СчетФактурыПоОтчетуКомиссионера КАК СчетФактурыПоОтчетуКомиссионера
		|		ПО ДокСчетФактура.Ссылка = СчетФактурыПоОтчетуКомиссионера.Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналУчетаСчетовФактур КАК ЖурналУчетаСчетовФактур
		|		ПО ДокСчетФактура.Ссылка = ЖурналУчетаСчетовФактур.СчетФактура
		|			И ЖурналУчетаСчетовФактур.ЧастьЖурнала = Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры)
		|ГДЕ
		|	ОтправленныеДокументы.Документ ЕСТЬ NULL
		|	И ВТ_КэшКонтрагентовПоВидамПакетов.ОтправлятьНепроведенные
		|	И НЕ ДокСчетФактура.ПометкаУдаления
		|	И ДокСчетФактура.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ДокСчетФактура.Корректировочный
		|	И НЕ ДокСчетФактура.Исправление
		|	И СчетФактурыПоОтчетуКомиссионера.Документ ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокСчетФактура.Ссылка,
		|	ДокСчетФактура.Номер,
		|	ДокСчетФактура.Дата,
		|	ДокСчетФактура.Контрагент,
		|	ДокСчетФактура.Организация";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_СчетаФактуры_ПоДокументу()
	
	Результат =
		"ВЫБРАТЬ
		|	ДокСчетФактура.Ссылка КАК Документ,
		|	ДокСчетФактура.Номер КАК НомерДокумента,
		|	ДокСчетФактура.Дата КАК ДатаДокумента,
