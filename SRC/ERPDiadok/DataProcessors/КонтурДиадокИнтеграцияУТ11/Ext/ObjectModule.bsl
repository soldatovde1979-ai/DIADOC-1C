// Возвращает заполненную протоструктуру титула продавца в формате 970 по данным документа 1С
//
// Параметры:
//  Документ - ДокументСсылка - ссылка на учетный документ 1С,
//				по которому заполняется протоконтент титула продавца 970@
//  ФункцияДокумента - Строка - функция УПД (возможные значения: СЧФ, СЧФДОП, ДОП)
//  ДополнительныеПараметры	 - Структура - Модуль_Ядро.ДополнительныеПараметрыПолученияКонтента
//
// Возвращаемое значение:
//  Структура - заполненный протоконтент УПД (см. Контракт_ПротоСтруктураУПД970)
//
Функция УПД970_КонтентТитулаПродавца(ДокСсылка, ФункцияДокумента, ДополнительныеПараметры) Экспорт
	
	Перем Результат;
	
	ТипДокумента = ТипЗнч(ДокСсылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный")
		И НЕ ЭтоКорректировочныйСчетФактура(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоСчетФактураВыданный(
			ДокСсылка,
			ФункцияДокумента,
			ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
		
		Если ЭтоКорректировочныйСчетФактураНаАванс(ДокСсылка) Тогда
			Результат = УПД970_КонтентТитулаПродавцаПоСчетФактураВыданныйАвансКорректировочный(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
		Иначе
			Результат = УПД970_КонтентТитулаПродавцаПоСчетФактураВыданныйНаАванс(
				ДокСсылка,
				ДополнительныеПараметры);
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоРеализацииТоваровУслуг(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктВыполненныхРабот") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоАктуВыполненныхРабот(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ЭтоИсправлениеРеализации(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоКорректировкеРеализации(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РеализацияУслугПрочихАктивов") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоРеализацииУслугИПрочихАктивов(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоОтчетуКомитенту(
				ДокСсылка,
				ДополнительныеПараметры);
				
	ИначеЕсли ЭтоОтчетКомитентуОЗакупках(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоОтчетуКомитентуОЗакупках(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураКомиссионеру") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоСчетФактураКомиссионеру(
				ДокСсылка,
				ФункцияДокумента,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыкупВозвратнойТарыКлиентом") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоВыкупуВозвратнойТарыКлиентом(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ЭтоОтчетДавальцу(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоОтчетуДавальцу(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоВозвратуТоваровПоставщику(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ЭтоПередачаНаКомиссию(ДокСсылка) Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаПоПередачаНаКомиссию2_5(
				ДокСсылка,
				ДополнительныеПараметры);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаНаПеремещениеТоваров(
			ДокСсылка,
			ДополнительныеПараметры);
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыкупТоваровХранителем") Тогда
		
		Результат = УПД970_КонтентТитулаПродавцаНаВыкупТоваровХранителем(
			ДокСсылка,
			ДополнительныеПараметры);
		
	Иначе
		
		ШаблонТекстаОшибки = НСтр("ru='Неподдерживаемый тип документа: %1'");
		
		ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ТипЗнч(ДокСсылка));
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область УПД970_КонтентПоДокументам

Функция УПД970_КонтентТитулаПродавцаПоСчетФактураВыданный(Документ, ФункцияДокумента, ДополнительныеПараметры)
	
	ДанныеДокумента = УПД970_ИсходныеДанныеСчетФактураВыданный(Документ);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	
	ПересчитыватьВВалютуРеглУчета = УПД970_ПересчитыватьСуммыВВалютуРегламентированногоУчета(
		ДанныеШапки.ВалютаДокумента,
		ДанныеШапки.ОплатаВВалюте);
	
	ВыводитьКодыТНВЭД = УПД970_ВыводитьКодыТНВЭД(ДанныеШапки.Контрагент, ДанныеШапки.Грузополучатель);
	
	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента;
	
	Если ФункцияДокумента = ФункцияДокумента_СЧФ() Тогда
		ОбстФормированияДокумента = УПД970_ОбстоятельстваФормированияСчетаФактуры(
			ДанныеШапки.КодВидаОперации,
			ДанныеШапки.ТипДоговора);
	Иначе
		ОбстФормированияДокумента = УПД970_ОбстоятельстваФормированияУПД(ДанныеШапки.Ссылка);
	КонецЕсли;
	
	Результат.CircumFormatInvoice = ОбстФормированияДокумента;
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	Результат.DocumentNumber = ДанныеШапки.Номер;
	Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
	
	Если ДанныеШапки.Исправление
		И ФункцияДокумента <> ФункцияДокумента_ДОП() Тогда
		Результат.RevisionNumber = ПредставлениеНомера(ДанныеШапки.НомерИсправления);
		Результат.RevisionDate = ДанныеШапки.ДатаИсправления;
	КонецЕсли;
	
	Если ПересчитыватьВВалютуРеглУчета Тогда
		Результат.Currency = КодВалютыРегламентированногоУчета();
	Иначе
		Результат.Currency = ДанныеШапки.ВалютаДокументаКод;
	КонецЕсли;
	
	Table = Результат.Table;
	
	ПараметрыЗаполненияТаблицы = УПД970_НовыйПараметрыЗаполненияТабличныхДанныхКонтента(
		ПересчитыватьВВалютуРеглУчета,
		ДанныеШапки.НДСИсчисляетсяНалоговымАгентом,
		ДанныеШапки.ЦенаВключаетНДС,
		ДополнительныеПараметры.ТочностьКоличества,
		ДополнительныеПараметры.ТочностьЦены);
		
	УПД970_ЗаполнитьТабличныеДанныеКонтента(
		Table,
		ДанныеДокумента.ТабличныеДанные,
		Результат.Function,
		ПараметрыЗаполненияТаблицы,
		ДанныеДокумента.СведенияПрослеживаемости,
		ВыводитьКодыТНВЭД);
	
	УПД970_ЗаполнитьСведенияОПродавце(
		Результат,
		ДанныеШапки.Поставщик,
		ДанныеШапки.Дата,
		ДанныеШапки.БанковскийСчетОрганизации,
		ДанныеШапки.КПППоставщика);
		
	Если ДанныеШапки.РеализацияЧерезКомиссионера Тогда
		УПД970_ЗаполнитьСведенияОПокупателях(Результат, ДанныеДокумента.Покупатели, ДанныеШапки.Дата);
	Иначе
		УПД970_ЗаполнитьСведенияОПокупателе(
			Результат,
			ДанныеШапки.Контрагент,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетКонтрагента,
			ДанныеШапки.КПППокупателя);
	КонецЕсли;
	
	ЕстьТовары = УПД970_СодержитТовары(ДанныеДокумента.ТабличныеДанные);
	Если ЕстьТовары Тогда
		
		УПД970_ЗаполнитьСведенияОГрузоотправителе(
			Результат,
			ДанныеШапки.Грузоотправитель,
			ДанныеШапки.Дата,
			ДанныеШапки.БанковскийСчетГрузоотправителя);
			
		Если ДанныеШапки.РеализацияЧерезКомиссионера Тогда
			
			УПД970_ЗаполнитьСведенияОГрузополучателяхПоПокупателям(
				Результат.Consignees,
				Результат.Buyers,
				ДанныеШапки.Дата);
				
		Иначе
				
			ИспользоватьАдресДоставкиИзДокумента = АдресГрузополучателяБратьИзАдресаДоставки();
			Если ИспользоватьАдресДоставкиИзДокумента Тогда
				СведенияОАдресеДоставки = УПД970_СведенияОбАдресеДоставки(
					ДанныеШапки.АдресДоставки,
					ДанныеШапки.АдресДоставкиЗначенияПолей);
			Иначе
				СведенияОАдресеДоставки = Неопределено;
			КонецЕсли;
		
			УПД970_ЗаполнитьСведенияОГрузополучателе(
				Результат,
				ДанныеШапки.Грузополучатель,
				ДанныеШапки.Дата,
				ДанныеШапки.БанковскийСчетГрузополучателя,
				СведенияОАдресеДоставки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументыОснования = ДанныеДокумента.ДокументыОснования;
	УПД970_ЗаполнитьСведенияДокументовОбОтгрузке(Результат, ДокументыОснования, ФункцияДокумента);
	
	УПД970_ЗаполнитьСведенияОПлатежноРасчетныхДокументах(
		Результат.PaymentDocuments,
		ДанныеДокумента.ПлатежноРасчетныеДокументы);

	УПД970_ЗаполнитьСведенияОбАвансовыхСФ(
		Результат.AccompanyingDocuments,
		ДанныеДокумента.АвансовыеДокументы
	);
	TransferInfo = Результат.TransferInfo;
	
	TransferInfo.OperationInfo = УПД970_СодержаниеОперацииОтгрузкиТоваровУслуг();
	TransferInfo.TransferTextInfo = ДанныеШапки.СведенияОТранспортировкеИГрузе;
	
	Если Результат.Function <> ФункцияДокумента_СЧФ() Тогда
		TransferInfo.TransferDate = УПД970_ПолучитьДатуОтгрузки(Результат.DocumentDate, Результат.DocumentShipments);
	КонецЕсли;
	
	Если ЕстьТовары Тогда
		УПД970_ЗаполнитьСведенияОСотрудникеОтгрузившемТовар(TransferInfo, ДополнительныеПараметры);
	КонецЕсли;
	
	ОснованияОтгрузки = УПД970_РеквизитыОснованийОтгрузки(
		ДанныеШапки.Основание,
		ДанныеШапки.ОснованиеНомер,
		ДанныеШапки.ОснованиеДата,
		ДокументыОснования);
		
	УПД970_ЗаполнитьTransferBases(TransferInfo, ОснованияОтгрузки, ДополнительныеПараметры);
	
	Если ЭтоСчетФактураПеревыставленный(Документ) Тогда
		
		УПД970_ЗаполнитьСоставителяДокументаПоДаннымОрганизации(
			Результат,
			ДанныеШапки.Организация,
			ОснованияОтгрузки,
			ДанныеШапки.Дата);
			
	Иначе
		
		УПД970_ЗаполнитьСоставителяДокументаПоДаннымПродавца(Результат);
		
	КонецЕсли;

	УПД970_ЗаполнитьПризнакНаличияПрослеживаемыхТоваров(Результат);
	
	УПД970_ЗаполнитьСведенияОМаркировке(Результат, Документ);
	
	УПД970_ЗаполнитьПризнакВыбытияИзОборотаМаркируемойПродукции(
		Результат,
		Документ);
		
	Возврат Результат;
	
КонецФункции

Процедура УПД970_ЗаполнитьСведенияОбАвансовыхСФ(AccompanyingDocuments, АвансовыеДокументы)
	
	Для Каждого АвансовыйДокумент Из АвансовыеДокументы Цикл
		
		AccompanyingDocument = Контракт_AccompanyingDocument970();
		AccompanyingDocument.Name = Конст_ИмяДокументаАСЧФ();
		AccompanyingDocument.Date = АвансовыйДокумент.ДатаСчетаФактурыНаАванс;
		AccompanyingDocument.Number = XMLСтрока(АвансовыйДокумент.НомерСчетаФактурыНаАванс);
		
		ЭтоИсправление = ЗначениеЗаполнено(АвансовыйДокумент.НомерИсправленияСчетаФактурыНаАванс)
			Или ЗначениеЗаполнено(АвансовыйДокумент.ДатаИсправленияСчетаФактурыНаАванс);
		
		Если ЭтоИсправление Тогда
			AccompanyingDocument.AdditionalInfo = СтрШаблон(
				"ИспАСЧФ № %1 от %2",
				XMLСтрока(АвансовыйДокумент.НомерИсправленияСчетаФактурыНаАванс),
				Формат(АвансовыйДокумент.ДатаИсправленияСчетаФактурыНаАванс, "ДФ=dd.MM.yyyy")
			);
		КонецЕсли;
		
		AccompanyingDocuments.Добавить(AccompanyingDocument);
		
	КонецЦикла;
	
КонецПроцедуры

Функция Конст_ИмяДокументаАСЧФ()
	Возврат "АСЧФ";
КонецФункции

Функция УПД970_ВыводитьКодыТНВЭД(Покупатель, Грузополучатель)
	
	КодСтраныПокупателя = "0";
	Если ЗначениеЗаполнено(Покупатель) Тогда
		КодСтраныПокупателя = ЗначениеРеквизитаОбъектаЛок(Покупатель.СтранаРегистрации, "Код");
	КонецЕсли;
	
	КодСтраныГрузополучателя = "0";
	ГрузополучательСтранаЕАЭС = Ложь;
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		Для Каждого Элемент Из Грузополучатель Цикл
			КодСтраныГрузополучателя = ЗначениеРеквизитаОбъектаЛок(Элемент.СтранаРегистрации, "Код");
			ГрузополучательСтранаЕАЭС = СтранаЧленТС(КодСтраныГрузополучателя);
			Если ГрузополучательСтранаЕАЭС Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПокупательСтранаЕАЭС = СтранаЧленТС(КодСтраныПокупателя);
	
	// Обязательно указание значения в случае отражения в счете-фактуре товаров,
	// вывезенных за пределы территории Российской Федерации на территорию государства - члена ЕАЭС
	Результат = ((КодСтраныПокупателя <> "643")
		И (КодСтраныГрузополучателя <> "643")
		И ПокупательСтранаЕАЭС
		И ГрузополучательСтранаЕАЭС);
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_КонтентТитулаПродавцаПоСчетФактураВыданныйНаАванс(Документ, ДополнительныеПараметры)

	ДанныеДокумента = УПД970_ИсходныеДанныеСчетФактураВыданныйНаАванс(Документ);
	
	ДанныеШапки = ДанныеДокумента.ДанныеШапки;
	ТабличныеДанные = ДанныеДокумента.ТабличныеДанные;
	
	Результат = УПД970_НовыйПротоСтруктураУПД970();
	
	Результат.Function = ФункцияДокумента_СЧФ();
	Результат.CircumFormatInvoice = "2";
	Результат.GovernmentContractInfo = ДанныеШапки.ИдентификаторГосКонтракта;
	Результат.Currency = ДанныеШапки.ВалютаДокументаКод;
	
	ПредставлениеНомера = ПредставлениеНомера(ДанныеШапки.Номер);
	Если ЗначениеЗаполнено(ДанныеШапки.ИндексПодразделения) Тогда
		ПредставлениеНомера = ПредставлениеНомера + "/" + ДанныеШапки.ИндексПодразделения;
	КонецЕсли;
	
	Результат.DocumentNumber = ПредставлениеНомера;
	Результат.DocumentDate = НачалоДня(ДанныеШапки.Дата);
		
	Если ДанныеШапки.ЭтоИсправление Тогда
		Результат.RevisionNumber = ДанныеШапки.НомерИсправления;
		Результат.RevisionDate = НачалоДня(ДанныеШапки.ДатаИсправления);
	КонецЕсли;

	НДСИсчисляетсяНалоговымАгентом = ДанныеШапки.НДСИсчисляетсяНалоговымАгентом;
	
	Table = Результат.Table;
	Table.TotalNet = 0;
	Table.TotalWithVatExcluded = 0;
	Table.Vat = 0;
	Table.Total = 0;
	
	ВсеСтрокиБезНДС = Истина;
	
	Для Каждого СтрокаТаблицы Из ТабличныеДанные Цикл
		
		ДобавитьСтрокуВКонтент = УПД970_ДобавитьСтрокуВТаблицуКонтента(
			СтрокаТаблицы.ЭтоНабор,
			СтрокаТаблицы.ЭтоКомплектующие,
			СтрокаТаблицы.ВариантПредставленияНабора);
			
		Если Не ДобавитьСтрокуВКонтент Тогда
			Продолжить;
		КонецЕсли;

		Item = Контракт_Item970();
		
		Item.Product = ПредставлениеНоменклатуры(
			СтрокаТаблицы.НоменклатураНаименование,
			СтрокаТаблицы.ХарактеристикаНаименование,
		);
		
		Item.ItemVendorCode = СтрокаТаблицы.НоменклатураКод;
		Item.ItemMark = УПД970_ЗначениеТипаНоменклатурыВТерминахПрото(СтрокаТаблицы.НоменклатураТип);
		
		Если НДСИсчисляетсяНалоговымАгентом Тогда
			СуммаСНДС = 0;
			СуммаБезНДС = СтрокаТаблицы.СуммаБезНДС;
		Иначе
			СуммаСНДС = СтрокаТаблицы.СуммаСНДС;
			СуммаБезНДС = 0;
		КонецЕсли;
		
		Item.Quantity = 0;
		Item.Price = 0;
		Item.SubtotalWithVatExcluded = СуммаБезНДС;
		Item.Vat = СтрокаТаблицы.СуммаНДС;
		Item.Subtotal = СуммаСНДС;
		Item.TaxRate = ПредставлениеСтавкиНДС(СтрокаТаблицы.СтавкаНДС, ДанныеШапки.НДСИсчисляетсяНалоговымАгентом);
		
		ЭтоСтавкаБезНДС = (СтрокаТаблицы.СтавкаНДС = ПрикладнаяСтавкаБезНДС());
		Если Не ЭтоСтавкаБезНДС Тогда
			ВсеСтрокиБезНДС = Ложь;
		КонецЕсли;
		
		Item.WithoutVat = XMLСтрока(ЭтоСтавкаБезНДС);
		
		Item.СлужебнаяИнформация = УПД970_ЗаполненныйСлужебнаяИнформацияItem(СтрокаТаблицы);
		
		Table.Items.Добавить(Item);
		
		Table.Vat = Table.Vat + Item.Vat;
		Table.Total = Table.Total +  Item.Subtotal;
		Table.TotalWithVatExcluded = Table.TotalWithVatExcluded + СуммаБезНДС;
		
	КонецЦикла;
	
	Table.WithoutVat = XMLСтрока(ВсеСтрокиБезНДС);
	
