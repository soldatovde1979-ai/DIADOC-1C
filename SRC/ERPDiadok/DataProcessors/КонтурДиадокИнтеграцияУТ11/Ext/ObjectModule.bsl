Функция УПД970_ИсходныеДанныеОтчетаКомитентуОЗакупках_Товары(Документ, СчетФактура)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТекстЗапроса = УПД970_ТекстЗапросаРеквизитовШапкиОтчетаКомитенту_Товары();
	ДанныеШапки = Данные_ШапкаДокумента(Документ, ТекстЗапроса, МенеджерВременныхТаблиц);
	
	Данные_АктуализироватьРасчетыСКонтрагентами(Документ, ДанныеШапки.ВалютаДокумента);
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		ТекстЗапросаПоставщиков = УПД970_ТекстЗапросаПоставщиковПоСчетФактураВыданныйПеревыставленный();

		ТекстЗапросаКонтрагента = УПД970_ТекстЗапросаКонтрагентаПоСчетФактураВыданныйПеревыставленный();
		ЗапросКонтрагент = Новый Запрос(ТекстЗапросаКонтрагента);
		ЗапросКонтрагент.УстановитьПараметр("СчетФактура", СчетФактура);
		ТаблицаКонтрагентов = ЗапросКонтрагент.Выполнить().Выгрузить();
		Если ТаблицаКонтрагентов.Количество() > 0 Тогда
			ДанныеШапки.Контрагент = ТаблицаКонтрагентов[0].Контрагент;
		КонецЕсли;
	Иначе
		ТекстЗапросаПоставщиков = УПД970_ТекстЗапросаПоставщиковПоОтчетуКомитентуОЗакупках();
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаПоставщиков);
	Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТаблицаПоставщиков = Запрос.Выполнить().Выгрузить();
	Если ТаблицаПоставщиков.Количество() > 0 Тогда
		ДанныеШапки.Поставщик = ТаблицаПоставщиков.ВыгрузитьКолонку("Поставщик");
		ДанныеШапки.Грузоотправитель = ДанныеШапки.Поставщик;
	КонецЕсли;
	
	УПД970_ПоместитьВременнуюТаблицуТоваровОтчетаКомитентуОЗакупках_Товары(МенеджерВременныхТаблиц);
	
	Запрос.Текст = УПД970_ТекстЗапросаТабличныхДанныхОтчетаКомитентуОЗакупках_Товары();
	Запрос.УстановитьПараметр("ВыводитьБазовыеЕдиницыИзмерения", ВыводитьБазовыеЕдиницыИзмерения());
	Запрос.УстановитьПараметр("ДопКолонкаПечатныхФормДокументов", ДополнительнаяКолонкаПечатныхФормДокументов());
	Запрос.УстановитьПараметр("Поставщики", ДанныеШапки.Поставщик);
	
	ТабличныеДанные = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("ДанныеШапки", ДанныеШапки);
	Результат.Вставить("ТабличныеДанные", ТабличныеДанные);
	
	Возврат Результат;
	
КонецФункции

