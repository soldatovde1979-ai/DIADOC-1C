Функция Счет29_ТекстЗапросаВременнойТаблицыТоваровАктаВыполненныхРабот()
	
	ЕстьНаборы = ЕстьРеквизитТабличнойЧастиОбъектаЛок(
		Метаданные.Документы.АктВыполненныхРабот, "Услуги", "НоменклатураНабора");
	
	Если ЕстьНаборы Тогда
		Результат = Счет29_ТекстЗапросаВременнойТаблицыТоваровАктаВыполненныхРаботСНаборами();
	Иначе
		Результат = Счет29_ТекстЗапросаВременнойТаблицыТоваровАктаВыполненныхРаботТолькоСУслугами();
	КонецЕсли;
	
