Процедура УПД970_ТекстЗапросаВремТаблицыВидыЗапасовКорректировкиРеализацииОтчетДавальцу(ТекстЗапроса)
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		
		ОбъединениеОтчетаДавальца =
			"ВЫБРАТЬ
			|	СвязанныеДокументы.Основной КАК Ссылка,
			|	ЛОЖЬ КАК ДоКорректировки,
			|	ВидыЗапасов.НомерСтроки КАК НомерСтроки,
			|	ВидыЗапасов.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
			|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНаборов.ПустаяСсылка) КАК АналитикаУчетаНаборов,
			|	ВидыЗапасов.Упаковка КАК Упаковка,
			|	ВидыЗапасов.ВидЗапасов КАК ВидЗапасов,
			|	ВидыЗапасов.НомерГТД КАК НомерГТД,
			|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.КодТНВЭД КАК КодТНВЭД,
			|	ВидыЗапасов.Количество КАК КоличествоУпаковок,
			|	ВидыЗапасов.Количество КАК Количество,
			|	ВидыЗапасов.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
			|	
			|	ВидыЗапасов.СуммаСНДС - ВидыЗапасов.СуммаНДС КАК СуммаБезНДС,
			|	ВидыЗапасов.СуммаНДС КАК СуммаНДС,
			|	ЕСТЬNULL(СуммыРегл.СуммаБезНДСРегл, 0) КАК СуммаБезНДСРуб,
			|	ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, 0) КАК СуммаНДСРуб,
			|	ВидыЗапасов.Ссылка.СтавкаНДС КАК СтавкаНДС,
			|	
			|	ВидыЗапасов.ЗаказДавальца КАК ЗаказКлиента
			|
			|ИЗ
			|	Документ.ОтчетДавальцу2_5.ВидыЗапасов КАК ВидыЗапасов
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСвязанныеДокументы КАК СвязанныеДокументы
			|		ПО ВидыЗапасов.Ссылка = СвязанныеДокументы.Подчиненный
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютахУчета КАК СуммыРегл
			|		ПО ВидыЗапасов.Ссылка = СуммыРегл.Регистратор
			|			И ВидыЗапасов.ИдентификаторСтроки = СуммыРегл.ИдентификаторСтроки
			|			И СуммыРегл.Активность
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СвязанныеДокументы.Основной КАК Ссылка,
			|	ИСТИНА КАК ДоКорректировки,
			|	ВидыЗапасов.НомерСтроки КАК НомерСтроки,
			|	ВидыЗапасов.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
			|	ЗНАЧЕНИЕ(Справочник.КлючиАналитикиУчетаНаборов.ПустаяСсылка) КАК АналитикаУчетаНаборов,
			|	ВидыЗапасов.Упаковка КАК Упаковка,
			|	ВидыЗапасов.ВидЗапасов КАК ВидЗапасов,
			|	ВидыЗапасов.НомерГТД КАК НомерГТД,
			|	ВидыЗапасов.АналитикаУчетаНоменклатуры.Номенклатура.КодТНВЭД КАК КодТНВЭД,
			|	ВидыЗапасов.Количество КАК КоличествоУпаковок,
			|	ВидыЗапасов.Количество КАК Количество,
			|	ВидыЗапасов.КоличествоПоРНПТ КАК КоличествоПоРНПТ,
			|	
			|	ВидыЗапасов.СуммаСНДС - ВидыЗапасов.СуммаНДС КАК СуммаБезНДС,
			|	ВидыЗапасов.СуммаНДС КАК СуммаНДС,
			|	ЕСТЬNULL(СуммыРегл.СуммаБезНДСРегл, 0) КАК СуммаБезНДСРуб,
			|	ЕСТЬNULL(СуммыРегл.СуммаНДСРегл, 0) КАК СуммаНДСРуб,
			|	ВидыЗапасов.Ссылка.СтавкаНДС КАК СтавкаНДС,
			|	
			|	ВидыЗапасов.ЗаказДавальца КАК ЗаказКлиента
			|
			|ИЗ
			|	Документ.ОтчетДавальцу2_5.ВидыЗапасов КАК ВидыЗапасов
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСвязанныеДокументы КАК СвязанныеДокументы
			|		ПО ВидыЗапасов.Ссылка = СвязанныеДокументы.Подчиненный
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммыДокументовВВалютахУчета КАК СуммыРегл
			|		ПО ВидыЗапасов.Ссылка = СуммыРегл.Регистратор
			|			И ВидыЗапасов.ИдентификаторСтроки = СуммыРегл.ИдентификаторСтроки
			|			И СуммыРегл.Активность";
		
		ОбъединениеОтчетаДавальца = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|" + ОбъединениеОтчетаДавальца;
		
	Иначе
		ОбъединениеОтчетаДавальца = "";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//&ОбъединениеОтчетаДавальца", ОбъединениеОтчетаДавальца);
	
КонецПроцедуры

Процедура УПД970_ТекстЗапросаВремТаблицыВидыЗапасовКорректировкиРеализацииАктВыполненныхРабот(ТекстЗапроса)
	
	ЕстьТЧВидыЗапасов = Метаданные.Документы.АктВыполненныхРабот.ТабличныеЧасти.Найти("ВидыЗапасов") <> Неопределено;
	
	Если ЕстьТЧВидыЗапасов Тогда
	
		ОбъединениеАктВыполненныхРабот = "
