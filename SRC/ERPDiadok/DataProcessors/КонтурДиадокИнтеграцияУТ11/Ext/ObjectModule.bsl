Процедура УПД970_ЗаполнитьСведенияОСотрудникеУстаревший(Контент, ДополнительныеПараметры)
	
	Перем ДанныеСотрудника;
	
	ДополнительныеПараметры.Свойство("ДанныеСотрудника", ДанныеСотрудника);
		
	ЕстьТовары = УПД970_ВДокументеЕстьТовары(Контент.Table.Items);
	
	Если ЗначениеЗаполнено(ДанныеСотрудника)
		И ЗначениеЗаполнено(ДанныеСотрудника.Должность)
		И Контент.Function <> ФункцияДокумента_СЧФ() 
		И ЕстьТовары Тогда
		
		Employee = Контракт_Employee970();
		
		Employee.Surname = ДанныеСотрудника.Фамилия;
		Employee.FirstName = ДанныеСотрудника.Имя;
		Employee.Patronymic = ДанныеСотрудника.Отчество;
		Employee.EmployeePosition = ДанныеСотрудника.Должность;
		
		Контент.TransferInfo.Employee = Employee;
		
	КонецЕсли;
	
КонецПроцедуры

Функция УПД970_ВДокументеЕстьТовары(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Имущество Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_ВДокументеЕстьУслуги(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = ГенерацияXML.Перечисление_ItemMarks();
	
	МаксИндекс = СтрокиТаблицы.Количество() - 1;
	
	Для ТекИндекс = - МаксИндекс По 0 Цикл
		
		ItemMark = СтрокиТаблицы[ - ТекИндекс].ItemMark;
		
		Если ItemMark = ТипыНоменклатуры.Услуга
			ИЛИ ItemMark = ТипыНоменклатуры.Работа
			ИЛИ ItemMark = ТипыНоменклатуры.ИмущественныеПрава Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УПД970_НДСИсчисляетсяНалоговымАгентом(ДанныеШапки)
	
	Результат = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеШапки, "НалогообложениеНДС") Тогда
		Результат = (ДанныеШапки.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЭтоОтчетДавальцу(ДокументСсылка)
	
	ТипыДокументовБезБанковскихРеквизитов = Новый Массив;
	
	Если ЕстьДокументОтчетДавальцу() Тогда
		ТипыДокументовБезБанковскихРеквизитов.Добавить(Тип("ДокументСсылка.ОтчетДавальцу"));
	КонецЕсли;
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		ТипыДокументовБезБанковскихРеквизитов.Добавить(Тип("ДокументСсылка.ОтчетДавальцу2_5"));
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Результат = (ТипыДокументовБезБанковскихРеквизитов.Найти(ТипДокумента) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоОтчетДавальцу2_5(Документ)
	
	Результат = Ложь;
	
	Если ЕстьДокументОтчетДавальцу25() Тогда
		Результат = (ТипЗнч(Документ) = Тип("ДокументСсылка.ОтчетДавальцу2_5"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПередачаНаКомиссию(ДокументСсылка)

	Результат = Ложь;
	
	Если ЕстьДокументПередачаТоваровХранителю() Тогда
		Результат = (ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаТоваровХранителю"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеОснованияПередачиДокумента(ОбъектОснования)

	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ОбъектОснования) Тогда
		
		МетаданныеОбъекта = ОбъектОснования.Метаданные();
		ЭтоДокумент = ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта);
		
		РеквизитыОснования = Новый Массив;
		РеквизитыОснования.Добавить("Номер");
		РеквизитыОснования.Добавить("Дата");
				
		Если Не ЭтоДокумент Тогда
			РеквизитыОснования.Добавить("Наименование");
		КонецЕсли;
		
		Если ТипЗнч(ОбъектОснования) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			РеквизитыОснования.Добавить("НаименованиеДляПечати");
		КонецЕсли;
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектОснования, РеквизитыОснования);
		
		НомерОснования = ЗначенияРеквизитов.Номер;
		ДатаОснования = ЗначенияРеквизитов.Дата;
		
		Если ЗначенияРеквизитов.Свойство("НаименованиеДляПечати")
			И ЗначениеЗаполнено(ЗначенияРеквизитов.НаименованиеДляПечати) Тогда
			
			НаименованиеОснования = ЗначенияРеквизитов.НаименованиеДляПечати;
			
		ИначеЕсли ЗначенияРеквизитов.Свойство("Наименование")
			И ЗначениеЗаполнено(ЗначенияРеквизитов.Наименование) Тогда
			
			НаименованиеОснования = ЗначенияРеквизитов.Наименование;
			
		Иначе
			
			НаименованиеОснования = МетаданныеОбъекта.Синоним;
			
		КонецЕсли;
		
		Результат = УПД970_НовыйРеквизитыОснованияОтгрузки(
			НаименованиеОснования,
			НомерОснования,
			ДатаОснования);
		
		УПД970_УдалитьДатуНомерИзНаименованияОснованияОтгрузки(Результат);
		
		Если НЕ ЗначениеЗаполнено(Результат.Наименование) Тогда
			
			Если ТипЗнч(ОбъектОснования) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
				НаименованиеПоТипу = "Договор";
			ИначеЕсли ТипЗнч(ОбъектОснования) = Тип("СправочникСсылка.СоглашенияСКлиентами") Тогда
				НаименованиеПоТипу = "Соглашение";
			ИначеЕсли ЭтоДокумент Тогда
				НаименованиеПоТипу = "Заказ";
			КонецЕсли;
			
			Результат.Наименование = НаименованиеПоТипу;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

