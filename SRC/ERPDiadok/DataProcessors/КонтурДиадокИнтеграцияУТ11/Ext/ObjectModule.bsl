	|	ТаблицаТоваров.НоменклатураНабора.НаименованиеПолное КАК НоменклатураНабораНаименованиеПолное,
	|	ТаблицаТоваров.ХарактеристикаНабора КАК ХарактеристикаНабора,
	|	ЕСТЬNULL(ТаблицаТоваров.ХарактеристикаНабора.НаименованиеПолное, """") КАК ХарактеристикаНабораНаименованиеПолное,
	|	ТаблицаТоваров.ЭтоНабор КАК ЭтоНабор,
	|	ТаблицаТоваров.ЭтоКомплектующие КАК ЭтоКомплектующие,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ТаблицаТоваров.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ТаблицаТоваров.Содержание КАК Содержание,
	|	ТаблицаТоваров.Номенклатура.ТипНоменклатуры КАК НоменклатураТип,
	|	&КодТовараУслуги КАК НоменклатураКод,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ &ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ &НаименованиеЕдиницыИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Код
	|		ИНАЧЕ &КодЕдиницыИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	ТаблицаТоваров.КоличествоУпаковок КАК Количество,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.СуммаСНДС - ТаблицаТоваров.СуммаНДС КАК СуммаБезНДС,
	|	ТаблицаТоваров.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаТоваров.СуммаНДС КАК СуммаНДС,
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаТоваров.Характеристика) КАК ХарактеристикаНаименование,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаТоваров.Упаковка
	|	КОНЕЦ КАК Упаковка,
	|	ТаблицаТоваров.СуммаСкидки КАК СуммаСкидки,
	|	ТаблицаТоваров.СуммаСНДС КАК СуммаСНДС
	|ИЗ
	|	ТаблицаТоваровСНаборами КАК ТаблицаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаТоваров.НомерСтроки,
	|	ЭтоНабор УБЫВ";

	ТекстЗапроса_ЗаполнитьВыражениеСНаименованиемЕдиницыИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСЕдиницейИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСКодомЕдиницыИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСКодомТовараУслуги(Результат);

	Возврат Результат;
	
КонецФункции

Функция Счет29_ТекстЗапросаРеквизитовШапкиВыкупаВозвратнойТарыКлиентом()
	
	Результат =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокумента.Ссылка КАК Документ,
	|	ДанныеДокумента.Номер КАК Номер,
	|	ДанныеДокумента.Дата КАК Дата,
	|	ДанныеДокумента.Валюта КАК Валюта,
	|	ЕСТЬNULL(ДанныеДокумента.Валюта.Код, """") КАК ВалютаКод,
	|	ЕСТЬNULL(ДанныеДокумента.Валюта.Наименование, """") КАК ВалютаНаименование,
	|	ЕСТЬNULL(ДанныеДокумента.Валюта.ЗагружаетсяИзИнтернета, ЛОЖЬ) КАК ЭтоВалютаПоОКВ,
	|	ДанныеПоставщика.ГоловнаяОрганизация КАК Организация,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.Контрагент.ОбособленноеПодразделение
	|			ТОГДА ДанныеДокумента.Контрагент.ГоловнойКонтрагент
	|		ИНАЧЕ ДанныеДокумента.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ДанныеДокумента.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации,
	|	ДанныеДокумента.Организация КАК ОрганизацияПолучатель,
	|	ДанныеДокумента.БанковскийСчетОрганизации КАК БанковскийСчетПолучателя,
	|	ДанныеДокумента.БанковскийСчетКонтрагента КАК БанковскийСчетКонтрагента,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеДокумента.Грузоотправитель
	|		КОГДА ДанныеПоставщика.РегистрацияВНалоговомОргане <> ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|			ТОГДА ДанныеПоставщика.РегистрацияВНалоговомОргане
	|		ИНАЧЕ ДанныеДокумента.Организация
	|	КОНЕЦ КАК Грузоотправитель,
	|	ВЫБОР
	|		КОГДА ДанныеДокумента.Грузополучатель = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ДанныеДокумента.Контрагент
	|		ИНАЧЕ ДанныеДокумента.Грузополучатель
	|	КОНЕЦ КАК Грузополучатель,
	|	ДанныеДокумента.БанковскийСчетГрузоотправителя КАК БанковскийСчетГрузоотправителя,
	|	ДанныеДокумента.БанковскийСчетГрузополучателя КАК БанковскийСчетГрузополучателя,
	|	"""" КАК АдресДоставки,
	|	"""" КАК АдресДоставкиЗначенияПолей,
	|	ДанныеДокумента.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ВЫБОР 
	|		КОГДА ЕСТЬNULL(ДанныеДокумента.НалогообложениеНДС, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НДСИсчисляетсяНалоговымАгентом,
	|	ДанныеДокумента.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	|	"""" КАК НазначениеПлатежа,
	|	ЕСТЬNULL(ДанныеПоставщика.ИндексПодразделения, 0) КАК ИндексПодразделения,
	|	ЕСТЬNULL(ДанныеПоставщика.НаименованиеОбособленногоПодразделения, """") КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА
	|			ДанныеДокумента.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И ДанныеДокумента.Грузополучатель.ГоловнойКонтрагент = ДанныеДокумента.Контрагент
	|		ТОГДА
	|			ДанныеДокумента.Грузополучатель.КПП
	|		ИНАЧЕ
	|			ДанныеДокумента.Контрагент.КПП
	|	КОНЕЦ КАК КПППокупателя,
	|	ДанныеПоставщика.КПППоставщика КАК КПППоставщика,
	|	ДанныеПоставщика.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане
	|ИЗ
	|	Документ.ВыкупВозвратнойТарыКлиентом КАК ДанныеДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|		ПО ДанныеДокумента.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоставщика КАК ДанныеПоставщика
	|		ПО ДанныеДокумента.Ссылка = ДанныеПоставщика.Ссылка";
	
	Возврат Результат;
	
КонецФункции

Функция Счет29_ТекстЗапросаТабличныхДанныхВыкупаВозвратнойТарыКлиентом()

	Результат = 
	"ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	0 КАК НомерТабличнойЧасти,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	ТаблицаТоваров.КоличествоУпаковок КАК Количество,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.СуммаСНДС - ТаблицаТоваров.СуммаНДС КАК СуммаБезНДС,
	|	ТаблицаТоваров.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаТоваров.СуммаНДС КАК СуммаНДС,
	|	ТаблицаТоваров.СуммаСНДС КАК СуммаСНДС
	|ПОМЕСТИТЬ ВыкупВозвратнойТарыКлиентомТаблицаТоваров
	|ИЗ
	|	Документ.ВыкупВозвратнойТарыКлиентом.Товары КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|		ПО ТаблицаТоваров.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|ГДЕ
	|	ТаблицаТоваров.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка,
	|	1,
	|	ТаблицаТоваров.НомерСтроки,
	|	ТаблицаТоваров.АналитикаУчетаНоменклатуры.Номенклатура,
	|	ТаблицаТоваров.АналитикаУчетаНоменклатуры.Характеристика,
	|	ТаблицаТоваров.Упаковка,
	|	ТаблицаТоваров.КоличествоУпаковок,
	|	ВЫБОР
	|		КОГДА ТаблицаТоваров.КоличествоУпаковок = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(ТаблицаТоваров.СуммаСНДС / ТаблицаТоваров.КоличествоУпаковок КАК ЧИСЛО(15, 2))
	|	КОНЕЦ,
	|	ТаблицаТоваров.СуммаСНДС - ТаблицаТоваров.СуммаНДС,
	|	ТаблицаТоваров.СтавкаНДС,
	|	ТаблицаТоваров.СуммаНДС,
	|	ТаблицаТоваров.СуммаСНДС
	|ИЗ
	|	Документ.ВыкупВозвратнойТарыКлиентом.ВидыЗапасов КАК ТаблицаТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДанныхДокументов КАК ТаблицаДанныхДокумента
	|		ПО ТаблицаТоваров.Ссылка = ТаблицаДанныхДокумента.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Ссылка КАК Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.ВариантыПредставленияНаборовВПечатныхФормах.ПустаяСсылка) КАК ВариантПредставленияНабора,
	|	ЛОЖЬ КАК ЭтоНабор,
	|	ЛОЖЬ КАК ЭтоКомплектующие,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Номенклатура.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ТаблицаТоваров.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	"""" КАК Содержание,
	|	ТаблицаТоваров.Номенклатура.ТипНоменклатуры КАК НоменклатураТип,
	|	&КодТовараУслуги КАК НоменклатураКод,
	|	ПРЕДСТАВЛЕНИЕ(ТаблицаТоваров.Характеристика) КАК ХарактеристикаНаименование,
	|	"""" КАК СерияНаименование,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения
	|		ИНАЧЕ &ЕдиницаИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ &НаименованиеЕдиницыИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмеренияНаименование,
	|	ВЫБОР
	|		КОГДА &ВыводитьБазовыеЕдиницыИзмерения
	|			ТОГДА ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения.Код
	|		ИНАЧЕ &КодЕдиницыИзмерения
	|	КОНЕЦ КАК ЕдиницаИзмеренияКод,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	ТаблицаТоваров.Цена КАК Цена,
	|	ТаблицаТоваров.СуммаСНДС - ТаблицаТоваров.СуммаНДС КАК СуммаБезНДС,
	|	ТаблицаТоваров.СтавкаНДС КАК СтавкаНДС,
	|	ТаблицаТоваров.СуммаНДС КАК СуммаНДС,
	|	ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) КАК Упаковка,
	|	0 КАК СуммаСкидки,
	|	ТаблицаТоваров.СуммаСНДС КАК СуммаСНДС
	|ИЗ
	|	ВыкупВозвратнойТарыКлиентомТаблицаТоваров КАК ТаблицаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаТоваров.НомерТабличнойЧасти,
	|	ТаблицаТоваров.НомерСтроки";
	
	ТекстЗапроса_ЗаполнитьВыражениеСНаименованиемЕдиницыИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСЕдиницейИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСКодомЕдиницыИзмерения(Результат);
	ТекстЗапроса_ЗаполнитьВыражениеСКодомТовараУслуги(Результат);
	
	Возврат Результат;
	
КонецФункции

