	ТекстыЗапросов.Добавить(ТекстЗапросаВременнаяТаблицаТоваров);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ТекстЗапроса_РазделительЗапросов());
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
