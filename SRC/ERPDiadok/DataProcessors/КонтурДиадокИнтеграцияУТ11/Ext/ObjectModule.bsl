Функция УПД970_СодержитТовары(Таблица)
	
	Результат = Ложь;
	
	ИмяКолонки = "НоменклатураТип";
	
	Если Таблица.Найти(Перечисления.ТипыНоменклатуры.Товар, ИмяКолонки) <> Неопределено
		Или Таблица.Найти(Перечисления.ТипыНоменклатуры.Набор, ИмяКолонки) <> Неопределено
		Или Таблица.Найти(Перечисления.ТипыНоменклатуры.МногооборотнаяТара, ИмяКолонки) <> Неопределено Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция УПД970_СведенияОбАдресеДоставки(АдресДоставки, АдресДоставкиЗначенияПолей)

	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(АдресДоставки) Тогда
		
		Если ЗначениеЗаполнено(АдресДоставкиЗначенияПолей) Тогда
			Результат = УПД970_СведенияОбАдресе(АдресДоставкиЗначенияПолей);
		КонецЕсли;
		
		ПредставлениеАдресаПоJSON = УПД970_ПредставлениеАдресаИзСтруктуры(Результат);
		
		ПредставленияАдресаРазличаются = (НРег(АдресДоставки) <> НРег(ПредставлениеАдресаПоJSON));
		
		СведенияОбАдресеПоПредставлениюИзДокумента = (Не ЗначениеЗаполнено(Результат)
			Или ПредставленияАдресаРазличаются);
			
		Если СведенияОбАдресеПоПредставлениюИзДокумента Тогда
		
			ИнтерфейсБСП = ОбщийМодульПоИмениЛок("УправлениеКонтактнойИнформацией");
			Адрес = ИнтерфейсБСП.КонтактнаяИнформацияПоПредставлению(
				АдресДоставки,
				ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес")
			);
			
			Результат = УПД970_СведенияОбАдресе(Адрес);
			
			Результат.Представление = АдресДоставки;
			Результат.ТипАдреса = АдресВСвободнойФорме();
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция УПД970_ДобавитьСтрокуВТаблицуКонтента(ЭтоНабор, ЭтоКомплектующие, ВариантПредставленияНабора)
	
	Результат = Истина;
	
	Если Не ЭтоНабор И Не ЭтоКомплектующие Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВариантПредставленияТолькоНабор = Перечисления.ВариантыПредставленияНаборовВПечатныхФормах.ТолькоНабор;
	ВыводитьТолькоНабор = (ВариантПредставленияНабора = ВариантПредставленияТолькоНабор);
	
	Результат = (ЭтоНабор И ВыводитьТолькоНабор) Или (ЭтоКомплектующие И Не ВыводитьТолькоНабор);
	
	Возврат Результат;
	
КонецФункции

