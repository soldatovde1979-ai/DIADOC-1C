// Дополняет таблицу видов документов для обмена.
//
// Параметры:
//  ВидыДокументов	 - ТаблицаЗначений	 - см. функцию ВидыИсходящихДокументов;
//  ОбъектМетаданных - ОбъектМетаданных	 - метаданные объекта учета;
//  ВидЭД			 - Строка			 - вид электронного документа (см. ВидыЭлектронныхДокументов);
//  Ограничения		 - Неопределено		 - // TODO: Дописать позже. Пока видится, что это будет структура отборов;
//  ПравилоКонвертацииСвойств - Структура - см. функцию НовоеПравилоКонвертацииСвойствЭД;
//
// Пример:
//  Модуль_ИнтеграцияУниверсальный.ДобавитьВидДокументаДляОбмена(ВидыДокументов
//  	, Метаданные.Документы.СчетФактураВыданный
//  	, ВидыЭлектронныхДокументов().СчетФактура);
//
Процедура ДобавитьВидДокументаДляОбмена(ВидыДокументов, ОбъектМетаданных, ВидЭД, Ограничения = Неопределено, ПравилоКонвертацииСвойств = Неопределено) Экспорт
	
	ПКС = НовоеПравилоКонвертацииСвойствЭД();
	Если ЗначениеЗаполнено(ПравилоКонвертацииСвойств) Тогда 
		ЗаполнитьЗначенияСвойств(ПКС, ПравилоКонвертацииСвойств);
	КонецЕсли;
	
	НоваяСтрока = ВидыДокументов.Добавить();
	НоваяСтрока.ОбъектМетаданных = ОбъектМетаданных;
	НоваяСтрока.ВидЭД = ВидЭД;
	НоваяСтрока.Ограничения = Ограничения;
	НоваяСтрока.ПравилоКонвертацииСвойств = ПКС;
	
КонецПроцедуры

// Инициализирует правило конвертации свойств электронного документа в реквизиты учетного документа.
// Ключ структуры - имя поля электронного документа, значение - имя реквизита прикладного документа.
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//     * Организация - Строка - имя реквизита, содержащего ссылку на организацию (по умолчанию - "Организация");
//     * Контрагент	 - Строка - имя реквизита, содержащего ссылку на контрагента (по умолчанию - "Контрагент");
//     * Номер		 - Строка - имя реквизита, содержащего номер входящего документа (по умолчанию - "НомерВходящегоДокумента");
//     * Дата		 - Дата	  - имя реквизита, содержащего дату входящего документа (по умолчанию - "ДатаВходящегоДокумента");
//
Функция НовоеПравилоКонвертацииСвойствЭД() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация", "Организация");
	Результат.Вставить("Контрагент"	, "Контрагент");
	Результат.Вставить("Номер"		, "НомерВходящегоДокумента");
	Результат.Вставить("Дата"		, "ДатаВходящегоДокумента");
	
	Возврат Результат;
	
КонецФункции

// Добавляет новую запись в таблицу правил обработки электронных документов.
//
// Параметры:
//  ПравилаОбработки - ТаблицаЗначений - см. ПравилаОбработкиВходящихДокументов;
//  ИдентификаторПравила - Строка - идентификатор правила обработки документов;
//  ВидДокумента		 - Строка - вид документа, к которому относится правило (см. ВидыЭлектронныхДокументов);
//  ДляИсправлений		 - Булево, Неопределено - Ложь, если правило действует только для первичной версии документа;
//                                            Истина, если правило действует для только для исправленной версии документа;
//                                            Неопределено, если правило действует только для первичной и исправительной версий документа;
//
Процедура ДобавитьПравилоОбработкиДокументов(ПравилаОбработки, ИдентификаторПравила, ВидДокумента, ДляИсправлений) Экспорт
	
	ЗначенияФлага = Новый Массив;
	
	Если ДляИсправлений = Неопределено Тогда
		ЗначенияФлага.Добавить(Ложь);
		ЗначенияФлага.Добавить(Истина);
	Иначе
		ЗначенияФлага.Добавить(ДляИсправлений);
	КонецЕсли;
	
	Для Каждого ЭтоИсправление Из ЗначенияФлага Цикл
		
		НовоеПравило = ПравилаОбработки.Добавить();
		НовоеПравило.ВидДокумента = ВидДокумента;
		НовоеПравило.ЭтоИсправление = ЭтоИсправление;
		НовоеПравило.ИдентификаторПравила = ИдентификаторПравила;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоответствиеРеквизитовПолямВходящегоДокумента(ОбъектМетаданных) Экспорт
	
	ИменаПолей = Новый Структура;
	ИменаПолей.Вставить("Номер", "НомерВходящегоДокумента");
	ИменаПолей.Вставить("Дата", "ДатаВходящегоДокумента");
	ИменаПолей.Вставить("НомерИсправления", "НомерИсправления");
	ИменаПолей.Вставить("ДатаИсправления", "ДатаИсправления");
	
	ПроверятьСтандартныеРеквизиты = Истина;
	МетаданныеОбъекта = ОбъектМетаданныхПоОписанию(ОбъектМетаданных);
	ЗаполнитьСоответствиеПолейВходящегоДокумента(МетаданныеОбъекта, ИменаПолей);
	
	Результат = Новый Структура;
	
	Для Каждого Элемент Из ИменаПолей Цикл
		
		ИмяПоляЭлектронногоДокумента = Элемент.Ключ;
		ИмяПоляДокументаИБ = Элемент.Значение;
		
		Если ЗначениеЗаполнено(ИмяПоляДокументаИБ)
			И ЕстьРеквизитМетаданных(МетаданныеОбъекта, ИмяПоляДокументаИБ, ПроверятьСтандартныеРеквизиты) Тогда
			Результат.Вставить(ИмяПоляЭлектронногоДокумента, ИмяПоляДокументаИБ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Определяет ссылку на объекта, который будет выступать в качестве константы для дополнительных сведений
//
// Возвращаемое значение:
//	ЛюбаяСсылка, Неопределено
Функция ВладелецОбщихНастроекМодуля() Экспорт
	
	Результат 				= Неопределено;
	СтандартнаяОбработка 	= Истина;
	
	Если Не МаркерКонфигурацииОпределен() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПриПолученииВладельцаОбщихНастроекМодуля(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		Результат = ВалютаРегламентированногоУчета();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает описания всех библиотек конфигурации, включая
// описание самой конфигурации.
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - Строка - имя подсистемы, например, "СтандартныеПодсистемы".
//   * Значение - Структура - описание подсистемы:
//     ** Имя - Строка - имя подсистемы.
//     ** Версия - Строка - версия подсистемы.
//     ** ЭтоКонфигурация - Булево - Истина, если данная подсистема является основной конфигурацией.
//     ** ИдентификаторИнтернетПоддержки - Строка - уникальное имя программы в сервисах интернет-поддержки.
//
Функция ОписанияПодсистемКонфигурации() Экспорт
	
	// Используем служебный интерфейс БСП, т.к. метод ОписанияПодсистем добавлен в
	// программный интерфейс модуля ОбщегоНазначения только в версии БСП 3.0.2 и выше
	Результат = СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам;
	Возврат Результат;
	
КонецФункции

#Область СопоставлениеНоменклатуры

Функция МетаданныеСопоставленияНоменклатуры() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВладелецНоменклатурыТип");
	Результат.Вставить("ВладелецНоменклатурыПредставлениеОбъекта");
	
	Результат.Вставить("НоменклатураТип");
	Результат.Вставить("НоменклатураПредставлениеОбъекта");
	
	Результат.Вставить("ХарактеристикаТип");
	Результат.Вставить("ХарактеристикаПредставлениеОбъекта");
	
	Результат.Вставить("УпаковкаТип");
	Результат.Вставить("УпаковкаПредставлениеОбъекта");
	
	Результат.Вставить("ИмяПараметраСвязиХарактеристики", "Отбор.Владелец");
	Результат.Вставить("ИмяПараметраСвязиУпаковки", "Отбор.Владелец");
	
	СтандартнаяОбработка = Истина;
	ЗаполнитьМетаданныеСопоставленияНоменклатурыКонфигурация(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ЗаполнитьМетаданныеСопоставленияНоменклатурыБЭД(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает номенклатуру информационной базы, соответствующую идентификаторам номенклатуры контрагента.
//
// Параметры:
//  ВладелецНоменклатуры - ОпределяемыйТип.ВладелецНоменклатурыБЭД - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Строка, Массив из Строка - идентификаторы номенклатуры контрагента.
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//    * Ключ - Строка - идентификатор номенклатуры контрагента.
//    * Значение - Структура - номенклатура информационной базы (см. НоваяНоменклатураИнформационнойБазы).
//
Функция ПрочитатьСопоставлениеНоменклатуры(ВладелецНоменклатуры, ИдентификаторыНоменклатуры) Экспорт
	
	Результат = Новый Соответствие;
	
	Если Не ЗначениеЗаполнено(ИдентификаторыНоменклатуры) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ИдентификаторыНоменклатуры) = Тип("Массив") Тогда
		КоллекцияИдентификаторов = ИдентификаторыНоменклатуры;
	Иначе
		КоллекцияИдентификаторов = Новый Массив;
		КоллекцияИдентификаторов.Добавить(ИдентификаторыНоменклатуры);
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ПрочитатьСоответствиеНоменклатурыПереопределяемый(Результат, ВладелецНоменклатуры, КоллекцияИдентификаторов, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ПрочитатьСоответствиеНоменклатурыБЭД(Результат, ВладелецНоменклатуры, КоллекцияИдентификаторов);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записывает соответствие номенклатуры информационной базы с номенклатурой поставщика.
//
// Параметры:
//  НоменклатураКонтрагента	 - Структура - сведения о номенклатуре контрагента (см. НоваяНоменклатураКонтрагента)
//  НоменклатураИБ			 - Структура - сведения о номенклатуре информационной базы (см. НоваяНоменклатураИнформационнойБазы)
//
Процедура ЗаписатьСопоставлениеНоменклатуры(НоменклатураКонтрагента, НоменклатураИБ) Экспорт
	
	ЗаполнитьИдентификаторНоменклатурыКонтрагента(НоменклатураКонтрагента); // Для вызова из ФормаВводаНакладной
	
	СтандартнаяОбработка = Истина;
	ЗаписатьСоответствиеНоменклатурыПереопределяемый(НоменклатураКонтрагента, НоменклатураИБ, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		ЗаписатьСоответствиеНоменклатурыБЭД(НоменклатураКонтрагента, НоменклатураИБ);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает свойства набора номенклатур информационной базы.
// Определяет обязательность использования характеристики и упаковки.
//
// Параметры:
//  СсылкаИлиМассив - Массив из ОпределяемыйТип.НоменклатураБЭД, ОпределяемыйТип.НоменклатураБЭД
//    - ссылки на номенклатуру ИБ, для которой требуется определить свойства. Если передается ссылка, преобразуется в массив.
//
// Возвращаемое значение:
// Соответствие, Неопределено - в случае незаполненного набора номенклатуры возвращается Неопределено. Соответствие содержит:
//  * Ключ     - ОпределяемыйТип.НоменклатураБЭД - ссылка на номенклатуру ИБ.
//  * Значение - Структура                       - содержит свойства номенклатуры ИБ. См. НовыеСвойстваНоменклатурыИБ.
//
Функция СвойстваНоменклатурыИнформационнойБазы(Знач СсылкаИлиМассив) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СсылкаИлиМассив) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СвойстваНоменклатурИБ = Новый Соответствие;
	
	Если ТипЗнч(СсылкаИлиМассив) <> Тип("Массив") Тогда
		НаборНоменклатуры = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаИлиМассив);
	Иначе
		НаборНоменклатуры = СсылкаИлиМассив;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаборНоменклатуры) Тогда
		ПриОпределенииСвойствНоменклатурыИнформационнойБазы(НаборНоменклатуры, СвойстваНоменклатурИБ);
	КонецЕсли;
	
	Возврат СвойстваНоменклатурИБ;
	
КонецФункции

// Возвращает структуру свойств номенклатуры ИБ.
//
// Возвращаемое значение:
//  Структура - свойства номенклатуры информационной базы:
//   * ИспользоватьХарактеристики           - Булево - признак использования характеристик. По умолчанию Ложь.
//   * ИспользоватьУпаковки                 - Булево - признак использования упаковок. По умолчанию Ложь.
//   * ОбязательноеЗаполнениеХарактеристики - Булево - признак обязательного заполнения характеристик при их использовании. По умолчанию Истина.
//
Функция НовыеСвойстваНоменклатурыИБ() Экспорт
	
	СвойствоНоменклатуры = Новый Структура;
	СвойствоНоменклатуры.Вставить("ИспользоватьХарактеристики"          , Ложь);
	СвойствоНоменклатуры.Вставить("ИспользоватьУпаковки"                , Ложь);
	СвойствоНоменклатуры.Вставить("ОбязательноеЗаполнениеХарактеристики", Истина);
	
	Возврат СвойствоНоменклатуры;
	
КонецФункции

// Возвращает набор данных, представляющий номенклатуру контрагента.
//
// Параметры:
//  Владелец      - ОпределяемыйТип.ВладелецНоменклатурыБЭД - значение для инициализации выходного свойства Владелец.
//  Идентификатор - Строка                                  - значение для инициализации выходного свойства Идентификатор.
//
// Возвращаемое значение:
//  Структура - данные, представляющие номенклатуру контрагента:
//   * Владелец				 - ОпределяемыйТип.ВладелецНоменклатурыБЭД, Неопределено - владелец номенклатуры. Неопределено, если не инициализировано.
//   * Идентификатор		 - Строка - идентификатор записи по комбинации: номенклатура#характеристика#упаковка.
//   * Наименование			 - Строка - наименование номенклатуры.
//   * Характеристика		 - Строка - наименование характеристики номенклатуры.
//   * ЕдиницаИзмерения		 - Строка - единица измерения номенклатуры.
//   * ЕдиницаИзмеренияКод	 - Строка - код единицы измерения номенклатуры.
//   * Код					 - Строка - код номенклатуры.
//   * Артикул				 - Строка - артикул номенклатуры.
//   * Сорт					 - Строка - сорт номенклатуры.
//   * Описание				 - Строка - описание работы, услуги.
//   * СтавкаНДС			 - Строка - ставка НДС номенклатуры.
//   * Штрихкод				 - Строка - штрихкоды номенклатуры через запятую.
//
Функция НоваяНоменклатураКонтрагента(Знач Владелец = Неопределено, Знач Идентификатор = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Владелец", Владелец);
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Код");
	Результат.Вставить("Артикул");
	Результат.Вставить("Сорт");
	Результат.Вставить("Наименование");
	Результат.Вставить("Характеристика");
	Результат.Вставить("Описание");
	Результат.Вставить("СтавкаНДС");
	Результат.Вставить("ЕдиницаИзмерения");
	Результат.Вставить("ЕдиницаИзмеренияКод");
	Результат.Вставить("Штрихкод", "");
	Результат.Вставить("ШтрихкодыНоменклатуры", "");
	Результат.Вставить("GTIN", "");
	Результат.Вставить("Тип", "");
	
	Возврат Результат;
	
КонецФункции

// Возвращает набор данных, представляющий номенклатуру информационной базы.
//
// Параметры:
//  Номенклатура   - ОпределяемыйТип.НоменклатураБЭД               - значение для инициализации выходного свойства Номенклатура.
//  Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатурыБЭД - значение для инициализации выходного свойства Характеристика.
//  Упаковка       - ОпределяемыйТип.УпаковкаНоменклатурыБЭД       - значение для инициализации выходного свойства Упаковка.
//
// Возвращаемое значение:
//  Структура - данные, представляющие номенклатуру информационной базы:
//   * Номенклатура   - ОпределяемыйТип.НоменклатураБЭД, Неопределено               - номенклатура ИБ. Неопределено, если не инициализировано.
//   * Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатурыБЭД, Неопределено - характеристика номенклатуры ИБ. Неопределено, если не инициализировано.
//   * Упаковка       - ОпределяемыйТип.УпаковкаНоменклатурыБЭД, Неопределено       - упаковка номенклатуры информационной базы. Неопределено, если не инициализировано.
//
Функция НоваяНоменклатураИнформационнойБазы(Номенклатура = Неопределено, Характеристика = Неопределено, Упаковка = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Номенклатура"	, Номенклатура);
	Результат.Вставить("Характеристика"	, Характеристика);
	Результат.Вставить("Упаковка"		, Упаковка);
	
	Возврат Результат;
	
КонецФункции

// Возвращает сведения для передачи в помощник сопоставления номенклатуры
// (форма "ФормаГрупповоеСопоставлениеНоменклатуры")
//
// Параметры:
//  ДанныеЭД - Структура - см. НовыйДанныеЭлектронногоДокумента.
// 
// Возвращаемое значение:
//  Массив из Структура - сведения номенклатуры контрагента (см. НоваяНоменклатураКонтрагента)
//
Функция НоменклатураЭлектронногоДокумента(ДанныеЭД, ТолькоНесопоставленная = Ложь) Экспорт
	
	Контрагент = ДанныеЭД.Шапка.Продавец.Ссылка;
	ВладелецНоменклатуры = ПартнерПоКонтрагенту(Контрагент);
	
	Результат = Новый Массив;
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		НоменклатураИБ = Стр.Номенклатура;
		
		Если ЗначениеЗаполнено(НоменклатураИБ.Номенклатура)
			И ТолькоНесопоставленная Тогда
			Продолжить;
		КонецЕсли;
		
		НоменклатураКонтрагента = Стр.НоменклатураКонтрагента;
		
		ЗаполнитьИдентификаторНоменклатурыКонтрагента(НоменклатураКонтрагента);
		Если Не ЗначениеЗаполнено(НоменклатураКонтрагента.Владелец) Тогда
			НоменклатураКонтрагента.Владелец = ВладелецНоменклатуры;
		КонецЕсли;
		
		Результат.Добавить(НоменклатураКонтрагента);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает сведения о номенклатуре информационной базы, сопоставленной
// с идентификатором номенклатуры контрагента.
//
// Параметры:
//  Владелец      - ОпределяемыйТип.ВладелецНоменклатурыБЭД - владелец номенклатуры контрагента.
//  Идентификатор - Строка                                  - идентификатор номенклатуры контрагента.
// 
// Возвращаемое значение:
//  Структура - номенклатура информационной базы (см. НоваяНоменклатураИнформационнойБазы)
//  Неопределено - если номенклатура не сопоставлена
//
Функция НоменклатураИнформационнойБазыПоИдентификатору(Владелец, Идентификатор) Экспорт
	
	СопоставленнаяНоменклатура = ПрочитатьСопоставлениеНоменклатуры(Владелец, Идентификатор);
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(СопоставленнаяНоменклатура) Тогда
		Результат = СопоставленнаяНоменклатура.Получить(Идентификатор);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура НайтиНоменклатуруИнформационнойБазы(НоменклатураИБ, НоменклатураКонтрагента) Экспорт
	
	ЗаполнитьИдентификаторНоменклатурыКонтрагента(НоменклатураКонтрагента);
	
	ВладелецНоменклатуры = НоменклатураКонтрагента.Владелец;
	ИдентификаторНоменклатуры = НоменклатураКонтрагента.Идентификатор;
	
	НоменклатураИБ = НоменклатураИнформационнойБазыПоИдентификатору(ВладелецНоменклатуры, ИдентификаторНоменклатуры);
	
	Если Не ЗначениеЗаполнено(НоменклатураИБ) Тогда
		НоменклатураИБ = НоваяНоменклатураИнформационнойБазы();
	КонецЕсли;
	
КонецПроцедуры

// Подбирает недостающие данные о номенклатуре информационной базы по уже имеющимся,
// а также номенклатуре контрагента.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - данные номенклатуры контрагента (см. НоваяНоменклатураКонтрагента)
//  НоменклатураИБ - Структура - данные о номенклатуре информационной базы (имеющиеся или требующие подбора).
//                               См. НоваяНоменклатураИнформационнойБазы.
//
Процедура ПодобратьНоменклатуруИнформационнойБазы(Знач НоменклатураКонтрагента, НоменклатураИБ) Экспорт
	
	Если Не ЗначениеЗаполнено(НоменклатураИБ.Номенклатура) Тогда
		НоменклатураИБ.Характеристика = Неопределено;
		НоменклатураИБ.Упаковка = Неопределено;
		Возврат;
	КонецЕсли;
	
	МодульИнтеграции_ПриПодбореНоменклатурыИнформационнойБазы(НоменклатураКонтрагента, НоменклатураИБ);
	
КонецПроцедуры

// Ищет варианты сопоставления номенклатуры по номенклатуре контрагента.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - см. Контракт_НоменклатураКонтрагента
// 
// Возвращаемое значение:
//  Массив из Контракт_НоменклатураКонтрагента
//
Функция ВариантыСопоставленияНоменклатуры(НоменклатураКонтрагента) Экспорт
	
	Результат = Новый Массив;
	
	СтандартнаяОбработка = Истина;
	
	Результат = Новый Массив;
	
	МетодСервера(ИмяМодуляИнтеграции(), 
		"ПриЗаполненииВариантовСопоставленияНоменклатуры",
		Результат, 
		НоменклатураКонтрагента,
		СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		ЗаполнитьВариантыСопоставленияНоменклатурыПоУмолчанию(
			Результат,
			НоменклатураКонтрагента
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Запоняет варианты сопоставления номенклатурыИБ по полям НоменклатураКонтрагента
//
// Параметры:
//  Результат				 - Массив - Используется для заполнения контрактами НоваяНоменклатураИнформационнойБазы
//  НоменклатураКонтрагента	 - Структура - Структура полей см. Контракт_НоменклатураКонтрагента 
//
Процедура ЗаполнитьВариантыСопоставленияНоменклатурыПоУмолчанию(Результат, НоменклатураКонтрагента) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ИменаВТ = Новый Массив;
	
	ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Артикул);
	ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Код);
	ДобавитьЗапросПоНаименованию(МенеджерВТ, ИменаВТ, НоменклатураКонтрагента.Наименование);
	
	Если НЕ ЗначениеЗаполнено(ИменаВТ) Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗапросов = Новый Массив;
	Для Каждого ИмяВТ Из ИменаВТ Цикл
		МассивЗапросов.Добавить("ВЫБРАТЬ * ИЗ " + ИмяВТ);
	КонецЦикла;
	Разделитель = " ОБЪЕДИНИТЬ ";
	
	ИтоговыйТекст = СтрСоединить(МассивЗапросов, Разделитель);
	
	Запрос = Новый Запрос(ИтоговыйТекст);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоменклатураИБ = НоваяНоменклатураИнформационнойБазы(ВыборкаДетальныеЗаписи.НоменклатураСсылка);
		
		Результат.Добавить(НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

// Добавить запрос по артикулу
//
// Параметры:
//  МенеджерВТ	 - МенеджерВременныхТаблиц - менеджер временных таблиц запроса на варианты сопоставления номенклатуры 
//  ИменаВТ		 - Массив - Массив имен временных таблиц
//  Артикул		 - Строка - Искомый артикул
//
Процедура ДобавитьЗапросПоАртикулу(МенеджерВТ, ИменаВТ, Артикул)
	
	Если Не ЗначениеЗаполнено(Артикул) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = "ВТ_ПоАртикулу" + XMLСтрока(ИменаВТ.Количество());
	
	Текст = 
	"ВЫБРАТЬ
	|  Т.Ссылка КАК НоменклатураСсылка
	|ПОМЕСТИТЬ ИмяВТ
	|ИЗ
	|  Справочник.Номенклатура КАК Т
	|ГДЕ
	|  Т.Артикул = &Артикул
	|  И НЕ Т.ЭтоГруппа
	|  И НЕ Т.ПометкаУдаления";
	
	Запрос = Новый Запрос(Текст);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТ", ИмяВТ);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Параметры.Вставить("Артикул", Артикул); 
	
	Запрос.Выполнить();
	
	ИменаВТ.Добавить(ИмяВТ);
	
КонецПроцедуры

// Добавить запрос по наименованию
//
// Параметры:
//  МенеджерВТ	 - МенеджерВременныхТаблиц - менеджер временных таблиц запроса на варианты сопоставления номенклатуры 
//  ИменаВТ		 - Массив - Массив имен временных таблиц
//  Наименование - Строка - Искомое наименование
//
Процедура ДобавитьЗапросПоНаименованию(МенеджерВТ, ИменаВТ, Наименование)
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВТ = "ВТ_ПоНаименованию" + XMLСтрока(ИменаВТ.Количество());
	
	Текст =
		"ВЫБРАТЬ
		|  Т.Ссылка КАК НоменклатураСсылка
		|ПОМЕСТИТЬ ИмяВТ
		|ИЗ
		|  Справочник.Номенклатура КАК Т
		|ГДЕ
		|  Т.Наименование = ВЫРАЗИТЬ(&Наименование КАК Строка(1024))
		|  И НЕ Т.ЭтоГруппа
		|  И НЕ Т.ПометкаУдаления";
	
	Запрос = Новый Запрос(Текст);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВТ", ИмяВТ);
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Параметры.Вставить("Наименование", Наименование);
	
	Запрос.Выполнить();
	
	ИменаВТ.Добавить(ИмяВТ);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКонтента

// Заполняет коллекцию DocumentShipments в протоструктуре формата 820@.
// В случае, если электронный документ содержит функцию документа о передаче, в коллекцию
// добавляется один элемент с реквизитами самого УПД. В остальных случаях коллекция
// заполняется реквизитами каждого документа-основания.
//
// Параметры:
//  Контент820 - Структура - см. Новый_Utd820SellerContent.
//  ДокументыОснования - Массив, Неопределено - документы информационной базы, которыми отражена фактическая отгрузка.
//
Процедура ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку820(Контент820, ДокументыОснования) Экспорт
	
	ДокПодтвОтгр = Контент820.DocumentShipments;
	ФункцияДокумента = Контент820.Function;
	СтрокиТаблицы = Контент820.Table.Items;
	
	НаименованиеДокумента = НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОснования, ФункцияДокумента);
	
	Если ФункцияДокумента = ФункцияПрото_Invoice() Тогда
		
		СтандартнаяОбработка = Истина;
		
		ПриПолученииДанныхДокументовОбОтгрузке(ДокПодтвОтгр, Контент820.СлужебнаяИнформация.Ссылка, СтандартнаяОбработка);
					
		Если СтандартнаяОбработка Тогда
			
			Если Не ЗначениеЗаполнено(ДокументыОснования) Тогда
				Возврат;
			КонецЕсли;
			
			Для Каждого Основание Из ДокументыОснования Цикл
				
				ОписаниеДокумента = ОписаниеПрикладногоДокумента(Основание);
				ДатаНомер = ДатаНомерДокумента(ОписаниеДокумента, "");
				
				ОбъектМетаданных = Основание.Метаданные();
				
				РеквизитыДокумента = Новый_DocumentShipment();
				РеквизитыДокумента.Name = НаименованиеДокумента;
				РеквизитыДокумента.Number = ДатаНомер.НомерДокумента;
				РеквизитыДокумента.Date = ДатаНомер.ДатаДокумента;
				
				ДокПодтвОтгр.Добавить(РеквизитыДокумента);
											 
			КонецЦикла;
			
		КонецЕсли;
	
	Иначе
		
		ДокументыОснования = Новый Массив;
		
		РеквизитыДокумента = Новый_DocumentShipment();
		РеквизитыДокумента.Name = НаименованиеДокумента;
		РеквизитыДокумента.Number = Контент820.DocumentNumber;
		РеквизитыДокумента.Date = Контент820.DocumentDate;
		
		ДокПодтвОтгр.Добавить(РеквизитыДокумента);

	КонецЕсли;
	
КонецПроцедуры

Функция НаименованиеДокументаОтгрузки(СтрокиТаблицы, ДокументыОтгрузки, ФункцияДокумента)
	
	НаименованияДокументов = НаименованияДокументовОтгрузки();
	
	Если ФункцияДокумента = ФункцияПрото_InvoiceAndBasic() Тогда
		
		Результат = НаименованияДокументов.УПД;
		
	ИначеЕсли ЗначениеЗаполнено(ДокументыОтгрузки) И ДокументыОтгрузки.Количество() > 1 Тогда
		
		ЕстьТовары = ВДокументеЕстьТовары(СтрокиТаблицы);
		ЕстьУслуги = ВДокументеЕстьУслуги(СтрокиТаблицы);
		
		Если ЕстьТовары И НЕ ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Накладная;
			
		ИначеЕсли НЕ ЕстьТовары И ЕстьУслуги Тогда
			
			Результат = НаименованияДокументов.Акт;
			
		Иначе
			Результат = НаименованияДокументов.Документ;
		КонецЕсли;
		
	Иначе
		
		ЕстьТовары = ВДокументеЕстьТовары(СтрокиТаблицы);
		
		Если ЕстьТовары Тогда
			Результат = НаименованияДокументов.Накладная;
		Иначе
			Результат = НаименованияДокументов.Акт;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НаименованияДокументовОтгрузки()
	
	Результат = Новый Структура;
	
	Результат.Вставить("УПД", "Универсальный передаточный документ");
	Результат.Вставить("Накладная", "Товарная накладная");
	Результат.Вставить("Акт", "Акт");
	Результат.Вставить("Документ", "Документ");
	
	Возврат Результат;
	
КонецФункции

Функция ВДокументеЕстьТовары(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = Перечисление_ItemMarks();
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		Если СтрокаТаблицы.ItemMark = ТипыНоменклатуры.Имущество Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ВДокументеЕстьУслуги(СтрокиТаблицы)

	Результат = Ложь;
	
	ТипыНоменклатуры = Перечисление_ItemMarks();
	
	МаксИндекс = СтрокиТаблицы.Количество() - 1;
	
	Для ТекИндекс = - МаксИндекс По 0 Цикл
		
		ItemMark = СтрокиТаблицы[ - ТекИндекс].ItemMark;
		
		Если ItemMark = ТипыНоменклатуры.Услуга
			ИЛИ ItemMark = ТипыНоменклатуры.Работа
			ИЛИ ItemMark = ТипыНоменклатуры.ИмущественныеПрава Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Перечисление_ItemMarks()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Имущество", "Property");
	Результат.Вставить("Работа", "Job");
	Результат.Вставить("Услуга", "Service");
	Результат.Вставить("ИмущественныеПрава", "PropertyRights");
	Результат.Вставить("Иное", "Other");
	
	Возврат Результат;
	
КонецФункции

// Заполняет в табличной части протоконтента сведения о маркировке.
// @СлужебныйПрограммныйИнтерфейс
//
// Параметры:
//  Контент - Структура - Протоконтент в формате приказа 820@.
//  СсылкаНаДокумент - ЛюбаяСсылка - Ссылка основание электронного документа.
//  ИспользоватьКонтурМаркировку - Булево - Истина, если получать сведения о маркировке
//                                          нужно с помощью подсистемы "Контур.Маркировка"
//
Процедура ЗаполнитьСведенияОМаркировке820(Контент, СсылкаНаОбъект, ИспользоватьКонтурМаркировку = Ложь) Экспорт
	
	Если ИспользоватьКонтурМаркировку Тогда
		
		ЗаполнитьСведенияОМаркировке820_КонтурМаркировка(Контент, СсылкаНаОбъект);
		
	ИначеЕсли ИспользоватьИнтеграционныйМодульДляЗаполненияСведенийОМаркировке() Тогда
		
		ЗаполнитьСведенияОМаркировке820_ИнтеграционныйМодуль(Контент, СсылкаНаОбъект);
		
	Иначе
		
		ЗаполнитьСведенияОМаркировке820_ИСМП(Контент, СсылкаНаОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировке736(Контент, СсылкаНаОбъект, ИспользоватьКонтурМаркировку = Ложь) Экспорт
	
	ИсходныйДокумент = Неопределено;
	ПередаточныеДокументы = Неопределено;
	ИсправляемыеДокументы = Неопределено;
	
	Если Контент.СлужебнаяИнформация.Свойство("ИсправляемыеДокументы", ИсправляемыеДокументы)
		И ЗначениеЗаполнено(ИсправляемыеДокументы) Тогда
		ИсходныйДокумент = ИсправляемыеДокументы[0];
	ИначеЕсли Контент.СлужебнаяИнформация.Свойство("ПередаточныеДокументы", ПередаточныеДокументы)
		И ЗначениеЗаполнено(ПередаточныеДокументы) Тогда 
		ИсходныйДокумент = ПередаточныеДокументы[0];
	КонецЕсли;
	
	Если ИспользоватьКонтурМаркировку Тогда
		
		ЗаполнитьСведенияОМаркировке736_КонтурМаркировка(Контент, СсылкаНаОбъект, ИсходныйДокумент);
		
	ИначеЕсли ИспользоватьИнтеграционныйМодульДляЗаполненияСведенийОМаркировке() Тогда
		
		ЗаполнитьСведенияОМаркировке736_ИнтеграционныйМодуль(Контент, СсылкаНаОбъект, ИсходныйДокумент);
		
	Иначе
		
		ЗаполнитьСведенияОМаркировке736_ИСМП(Контент, СсылкаНаОбъект, ИсходныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры


Функция ОписаниеТиповЗначения(Значение)
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипЗнч(Значение));
	
	Результат = Новый ОписаниеТипов(МассивТипов);
	
	Возврат Результат;
	
КонецФункции

// Поддержано только часть сценария оформления УКД на основании возврата: документ реализации -> возврат товара.
// Не поддержан сценарий, при котором в цепочке документа присутсвуют корректрировки реализациим или несколько возвратов.
// требуется инверсия заполнения, т.к. в ТЧ Возврата тот товар, которого в коллекции "После" не должно быть
Процедура ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента(СтрокаТЧ, ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокДоИзменения)
	
	ДанныеШтрихкодовУпаковокИнверсия = ДанныеШтрихкодовУпаковокДоИзменения.Скопировать();
	// колонка "ссылка" теперь указывает не на возврат, а на корректируемый документ!
	ДанныеШтрихкодовУпаковокИнверсия.ЗаполнитьЗначения(Ложь, "Обработан");
	
	ЗаполнитьДанныеШтрихкодовУпаковокИнверсией(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия);
	
	ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity - СтрокаТЧ.CorrectedValues.Quantity;
	
	Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
		
		// Инициализировать промежуточную структуру с коллекциями кодов маркировки
		КодыМаркировки = НовыйСведенияОМаркировке();
		
		// Найти подходящие кодами маркировки
		ПодобратьКодыМаркировки(КодыМаркировки, ДанныеШтрихкодовУпаковокИнверсия, СтрокаТЧ.СлужебнаяИнформация, ТребуемоеКоличество);
		
		// Перенести найденные коды маркировки в строку протоконтента
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента_ИСМП10127(
	СтрокаТЧ,
	ДанныеШтрихкодовУпаковок,
	ДанныеШтрихкодовУпаковокДоИзменения)
	
	Если ВозвращаетсяКодОСУ(ДанныеШтрихкодовУпаковок) Тогда
		
		ДанныеШтрихкодовУпаковокИнверсия = ДанныеШтрихкодовУпаковокДоИзменения.Скопировать();
		// колонка "ссылка" теперь указывает не на возврат, а на корректируемый документ!
		ДанныеШтрихкодовУпаковокИнверсия.ЗаполнитьЗначения(Ложь, "Обработан");
		
		ЗаполнитьДанныеШтрихкодовУпаковокИнверсией_ИСМП10127(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия);
		
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity - СтрокаТЧ.CorrectedValues.Quantity;
		
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			// Инициализировать промежуточную структуру с коллекциями кодов маркировки
			КодыМаркировки = НовыйСведенияОМаркировке();
			
			// Найти подходящие кодами маркировки
			ПодобратьКодыМаркировки_ИСМП10127(
				КодыМаркировки,
				ДанныеШтрихкодовУпаковокИнверсия,
				СтрокаТЧ.СлужебнаяИнформация,
				ТребуемоеКоличество
			);
			
			// Перенести найденные коды маркировки в строку протоконтента
			ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
	Иначе
		
		СтрокаТЧ.OriginalItemIdentificationNumbers = Новый Массив;
		
		КодыМаркировки = НовыйСведенияОМаркировке();
		
		ПодобратьКодыМаркировки_ИСМП10127(
			КодыМаркировки,
			ДанныеШтрихкодовУпаковок,
			СтрокаТЧ.СлужебнаяИнформация,
			СтрокаТЧ.OriginalValues.Quantity
		);
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВозвращаетсяКодОСУ(ДанныеШтрихкодовУпаковок)
	
	Результат = Ложь;
	
	Для Каждого СтрокаУпаковкиВозврата Из ДанныеШтрихкодовУпаковок Цикл
		Если СтрокаУпаковкиВозврата.ВидУпаковки = УпаковкаОбъемноСортовойУчет() Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоПолныйВозвратТовара(СтрокаТЧ)

	Результат = ЗначениеЗаполнено(СтрокаТЧ.OriginalValues.Quantity)
		И Не ЗначениеЗаполнено(СтрокаТЧ.CorrectedValues.Quantity); 
		
	Возврат Результат;

КонецФункции // ()

Процедура ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект)
	
	ЭтоПервичныйДокумент = ЕстьФункцияПервичногоДокумента(Контент.Function);
	
	Если ЭтоПервичныйДокумент Тогда
		
		ВыбытиеИзОборота = ЭтоВыбытиеИзОборотаМаркируемойПродукции(СсылкаНаОбъект);
		
		Если ВыбытиеИзОборота Тогда	
			
			ИдентификаторПризнакаВыбытия = "СвВыбытияМАРК";
			ДополнитьМассивKeyValue(Контент.AdditionalInfoId.StructedAdditionalInfos, ИдентификаторПризнакаВыбытия, 1);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоВыбытиеИзОборотаМаркируемойПродукции(СсылкаНаОбъект)

	Результат = МетодСервера(ИмяМодуляИнтеграции(), "ЭтоВыбытиеИзОборотаМаркируемойПродукции", СсылкаНаОбъект);
	
	Если Результат = Неопределено Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьДанныеШтрихкодовУпаковокИнверсией(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия)
	
	Для Каждого СтрокаУпаковкиВозврата Из ДанныеШтрихкодовУпаковок Цикл
		
		КлючиПараметровОтбора = "Номенклатура, Характеристика, Серия, ЗначениеШтрихкода, ВидУпаковки, ИспользоватьХарактеристики, ИспользоватьСерии";
	
		ПараметрыОтбора = Новый Структура(КлючиПараметровОтбора);
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаУпаковкиВозврата);
	
		УдаляемыеСтроки = ДанныеШтрихкодовУпаковокИнверсия.НайтиСтроки(ПараметрыОтбора);
		
		Пока УдаляемыеСтроки.Количество() > 0 Цикл
			
			УдаляемаяСтрока = УдаляемыеСтроки.Получить(0);
							
			ДанныеШтрихкодовУпаковокИнверсия.Удалить(УдаляемаяСтрока);
			
			УдаляемыеСтроки.Удалить(0);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеШтрихкодовУпаковокИнверсией_ИСМП10127(ДанныеШтрихкодовУпаковок, ДанныеШтрихкодовУпаковокИнверсия)
	
	Для Каждого СтрокаУпаковкиВозврата Из ДанныеШтрихкодовУпаковок Цикл
		
		Если СтрокаУпаковкиВозврата.ВидУпаковки = УпаковкаОбъемноСортовойУчет() Тогда
			Продолжить;
		КонецЕсли;
		
		КлючиПараметровОтбора = "Номенклатура, Характеристика, Серия, ЗначениеШтрихкода, ВидУпаковки, ИспользоватьХарактеристики, ИспользоватьСерии";
	
		ПараметрыОтбора = Новый Структура(КлючиПараметровОтбора);
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаУпаковкиВозврата);
	
		УдаляемыеСтроки = ДанныеШтрихкодовУпаковокИнверсия.НайтиСтроки(ПараметрыОтбора);
		
		Пока УдаляемыеСтроки.Количество() > 0 Цикл
			
			УдаляемаяСтрока = УдаляемыеСтроки.Получить(0);
							
			ДанныеШтрихкодовУпаковокИнверсия.Удалить(УдаляемаяСтрока);
			
			УдаляемыеСтроки.Удалить(0);
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияПрослеживаемости820(Контент)
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		Если СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ПрослеживаемыйТовар", Ложь) = Истина Тогда
			
			ДанныеПрослеживаемости = СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ДанныеПрослеживаемости", Новый Массив);
			
			Если ДанныеПрослеживаемости <> Неопределено Тогда
				
				Для каждого СтрокаДанныхПрослеживаемости Из ДанныеПрослеживаемости Цикл
					
					ItemTracingInfo					 = Новый_ItemTracingInfo();
					
					ItemTracingInfo.Unit			 = СтрокаДанныхПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости;
					ItemTracingInfo.UnitName		 = СокрЛП(СтрокаДанныхПрослеживаемости.ЕдиницаИзмеренияПрослеживаемости);
					ItemTracingInfo.Quantity		 = СтрокаДанныхПрослеживаемости.КоличествоПоРНПТ;
					ItemTracingInfo.RegNumberUnit	 = СокрЛП(СтрокаДанныхПрослеживаемости.НомерГТДРегистрационныйНомер);
					
					Если ЗначениеЗаполнено(ItemTracingInfo.RegNumberUnit) Тогда
						СтрокаТЧ.ItemTracingInfos.Добавить(ItemTracingInfo);
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЗначениеЗаполнено(СтрокаТЧ.CustomDeclarations) Тогда
					
					Для каждого CustomDeclaration Из СтрокаТЧ.CustomDeclarations Цикл
						CustomDeclaration.DeclarationNumber = "Прослеж";
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет ItemTracingInfos в строках Items по данным реквизита СлужебнаяИнформация.ДанныеПрослеживаемости
//
// Параметры
//  Контент - Структура - Протоконтент в формате приказа 736@.
//
Процедура ЗаполнитьСведенияПрослеживаемости736(Контент)
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		Если СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ПрослеживаемыйТовар", Ложь) = Истина Тогда
			
			ДанныеПрослеживаемости = СвойствоСтруктуры(СтрокаТЧ.СлужебнаяИнформация, "ДанныеПрослеживаемости", Новый Массив);
			
			Если ДанныеПрослеживаемости <> Неопределено Тогда
				
				ЕстьУвеличение = ЕстьДельта(СтрокаТЧ.AmountsInc);
				ЕстьУменьшение = ЕстьДельта(СтрокаТЧ.AmountsDec);
				
				Для каждого СтрокаДанныхПрослеживаемости Из ДанныеПрослеживаемости Цикл
					
					QuantityDiff = Новый_QuantityDiff();
					QuantityDiff.CorrectedQuantity	 = СтрокаДанныхПрослеживаемости.КоличествоПослеИзменения;
					QuantityDiff.OriginalQuantity	 = СтрокаДанныхПрослеживаемости.КоличествоДоИзменения;
					QuantityDiff.QuantityInc		 = СтрокаДанныхПрослеживаемости.КоличествоУвеличение;
					QuantityDiff.QuantityDec		 = СтрокаДанныхПрослеживаемости.КоличествоУменьшение;
				
					Если НЕ ЗначениеЗаполнено(QuantityDiff.QuantityDec) 
						И НЕ ЗначениеЗаполнено(QuantityDiff.QuantityInc) Тогда
						
						Если ЕстьУвеличение Тогда
							QuantityDiff.QuantityInc = 0;
							QuantityDiff.QuantityDec = Неопределено;
						ИначеЕсли ЕстьУменьшение Тогда
							QuantityDiff.QuantityInc = Неопределено;
							QuantityDiff.QuantityDec = 0;
						КонецЕсли;
						
					КонецЕсли;
					
					ItemTracingInfo					 = Новый_ItemTracingInfo736();
					ItemTracingInfo.Unit			 = СтрокаДанныхПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости;
					ItemTracingInfo.QuantityDiff	 = QuantityDiff;
					ItemTracingInfo.RegNumberUnit	 = СокрЛП(СтрокаДанныхПрослеживаемости.НомерГТДРегистрационныйНомер);
					
					СтрокаТЧ.ItemTracingInfos.Добавить(ItemTracingInfo);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает структуру свойств строки прослеживаемости
