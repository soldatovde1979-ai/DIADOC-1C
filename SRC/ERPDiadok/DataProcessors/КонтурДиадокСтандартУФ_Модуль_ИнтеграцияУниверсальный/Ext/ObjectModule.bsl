		МетаданныеРеквизита = Метаданные.НайтиПоПолномуИмени(ИмяРеквизита);
		
		МассивТипов = МетаданныеРеквизита.Тип.Типы();
		
		Для каждого Тип Из МассивТипов Цикл
			ПустоеЗначение = ПустоеЗначениеТипа(Тип);
			Результат.Добавить(ПустоеЗначение);
		КонецЦикла;
		
		Если Результат.Количество() > 1 Тогда
			Результат.Добавить(Неопределено);
		КонецЕсли;
		
		Результат = Новый ФиксированныйМассив(Результат);
		
		Возврат Результат;
		
	КонецФункции
	
	// Предназначена для получения пустого значения заданного типа:
	//	примитивного, или ссылочного. Используется
	//
	// Параметры:
	//	ЗаданныйТип - Тип, Строка - Тип пустого значения или строка с его идентификатором.
	//
	Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт
		
		Если ЗаданныйТип = Тип("Число") Тогда
			
			Результат = 0;
			
		ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
			
			Результат = "";
			
		ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
			
			Результат = '00010101';
			
		ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
			
			Результат = Ложь;
			
		Иначе
			
			Результат = Новый (ЗаданныйТип);
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции
	
	Функция ИмяФайлаПечатнойФормы(ИмяДокумента, НомерДокумента, ДатаДокумента) Экспорт 
		
		НормализованныйНомер = ЗаменитьНедопустимыеСимволы(НомерДокумента);
		
		Возврат ИмяДокумента + " №" + НормализованныйНомер + " от " + Формат(ДатаДокумента, "ДЛФ=Д") + ".pdf"; 
					
	КонецФункции
	
	Функция ЗаменитьНедопустимыеСимволы(НомерДокумента) Экспорт 
		
		Результат = НомерДокумента;
		
		НедопустимыеЗнаки = "\/:*?""<>|";
		
		Пока СтрДлина(НедопустимыеЗнаки) > 0 Цикл
			
			ТекСимвол = Лев(НедопустимыеЗнаки, 1);
			Если Найти(Результат, ТекСимвол) <> 0 Тогда
				Результат = СтрЗаменить(Результат, ТекСимвол, "_");
			КонецЕсли;
			НедопустимыеЗнаки = Сред(НедопустимыеЗнаки, 2);
			
		КонецЦикла;
		
		Возврат Результат;
		
	КонецФункции
	
