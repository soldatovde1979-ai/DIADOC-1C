// Добавляет в коллекцию данных грузовой таможенной декларации новый элемент.
//
// Параметры:
//  ДанныеГТД - Массив - содержит структуры с ключами:
//    * СтранаПроисхождения - Структура - см. НовыйКлючевыеСвойстваСтранаМира;
//    * НомерГТД - Структура - см. НовыйКлючевыеСвойстваНомерГТД;
//  КодСтраны - Строка - код страны мира по общероссийскому классификатору;
//  НомерГТД  - Строка - регистрационный номер таможенной декларации;
//
Процедура ДополнитьДанныеГТД(ДанныеГТД, КодСтраны, НомерГТД)
	
	Если Не ЗначениеЗаполнено(КодСтраны) И Не ЗначениеЗаполнено(НомерГТД) Тогда 
		Возврат;
	КонецЕсли;
	
	Элемент = Новый Структура;
	Элемент.Вставить("СтранаПроисхождения", НовыйКлючевыеСвойстваСтранаМира());
	Элемент.Вставить("НомерГТД"			, НовыйКлючевыеСвойстваГТД());
	
	Элемент.СтранаПроисхождения.Код = КодСтраны;
	Элемент.НомерГТД.РегистрационныйНомер = НомерГТД;
	
	ДанныеГТД.Добавить(Элемент);
	
КонецПроцедуры

// Считывает идентификатор номенклатуры контрагента из инфополей
// строки электронного документа.
//
// Параметры:
//  СтрокаЭД - Структура - протоструктура строки ЭД (см. Новый_ExtendedInvoiceItem, Новый_TovTorgItem и т.д.).
// 
// Возвращаемое значение:
//  Строка - идентификатор номенклатуры поставщика.
//
Функция ИдентификаторНоменклатурыИзСтрокиЭД(СтрокаЭД)
	
	Результат = "";
	
	ИнфоПоля = СвойствоСтруктуры(СтрокаЭД, "StructedAdditionalInfos");
	
	Если Не ЗначениеЗаполнено(ИнфоПоля) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Имена дополнительных полей, которые могут содержать идентификатор номенклатуры для сопоставления.
	// Порядок определяет приоритет выбора поля!
	ВозможныеИмена = Новый Массив;
	ВозможныеИмена.Добавить(ЗарезервированныеИменаИнфоПолей().ИдентификаторНоменклатуры);
	ВозможныеИмена.Добавить("Для1С_Идентификатор"); // Используется в 1С-ЭДО
	
	// Найдем все возможные идентификаторы.
	НайденныеЗначения = Новый Соответствие;
	
	Для Каждого ДополнительноеПоле Из ИнфоПоля Цикл
		
		ИмяПоля	 = ДополнительноеПоле.Key;
		Значение = ДополнительноеПоле.Value;
		
		Если ВозможныеИмена.Найти(ИмяПоля) <> Неопределено Тогда
			НайденныеЗначения.Вставить(ИмяПоля, Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(НайденныеЗначения) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Выберем из найденных значений то, чье имя имеет наболее высокий приоритет.
	Для Каждого ИмяПоля Из ВозможныеИмена Цикл
		
		Если ЗначениеЗаполнено(НайденныеЗначения[ИмяПоля]) Тогда
			Результат = НайденныеЗначения[ИмяПоля];
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли электронный документ счетом-фактурой на аванс.
// Счет-фактура авансовый, если это явно указано в предопределенном инфополе
// или если ни в одной строке не заполнено поле СуммаБезНДС (атрибут СтТовБезНДС)
//
// Параметры:
//  ДанныеЭД - Структура - см. функцию НовыйДанныеЭлектронногоДокумента;
// 
// Возвращаемое значение:
//  Булево - Истина, если это счет-фактура (УПД СЧФ или СФ) на аванс.
//
Функция ЭтоЭлектронныйСчетФактураНаАванс(Контент, ДанныеЭД)
	
	Результат = Истина;
	
	ИмяПоляВидСФ	 = ЗарезервированныеИменаИнфоПолей().ВидСчетаФактуры;
	ВидСчетаФактуры	 = ЗначениеИнформационногоПоля(ДанныеЭД.Шапка, ИмяПоляВидСФ);
	
	ФункцияДокумента = СвойствоСтруктуры(Контент, "Function");
	ОбстФормСЧФ = СвойствоСтруктуры(Контент, "CircumFormatInvoice");
	
	Если ФункцияДокумента = ФункцииЭлектронныхДокументов().СЧФ
		И ОбстФормСЧФ = "2" Тогда
		
		Результат = Истина;
		
	ИначеЕсли ЗначениеЗаполнено(ВидСчетаФактуры)
		И ВидСчетаФактуры <> ВидыЭлектронныхСчетовФактур().Авансовый Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ВидСчетаФактуры = Неопределено Тогда
		
		Для Каждого СтрокаТЧ Из ДанныеЭД.ТоварнаяЧасть Цикл
			
			НДСИНА = ЭтоСтавкаНДСИНА(СтрокаТЧ.НоменклатураКонтрагента.СтавкаНДС);
			
			Если Не НДСИНА И ЗначениеЗаполнено(СтрокаТЧ.СуммаБезНДС)
				Или НДСИНА И ЗначениеЗаполнено(СтрокаТЧ.Цена) Тогда
				Результат = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает значение информационного поля по его имени.
//
// Параметры:
//  Владелец - Структура - электронный документ или строка электронного документа;
//  ИмяИнформационногоПоля - Строка - имя информационного поля;
//  ЗначениеПоУмолчанию - Произвольный - Необязательный. Возвращается когда нет инфополя с указанным именем;
// 
// Возвращаемое значение:
//  Произвольный - Значение информационного поля. ЗначениеПоУмолчанию если нет указанного поля.
//
Функция ЗначениеИнформационногоПоля(Владелец, ИмяИнформационногоПоля, ЗначениеПоУмолчанию = Неопределено)
	
	Результат = ЗначениеПоУмолчанию;
	
	ИмяПоляВРЕГ = ВРег(ИмяИнформационногоПоля);
	
	КоллекцияИнфоПолей = Владелец.ДопИнфо;
	
	Для Каждого Элемент Из КоллекцияИнфоПолей Цикл
		
		Если ВРег(Элемент.Ключ) = ИмяПоляВРЕГ Тогда
			Результат = Элемент.Значение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает страну по данным информационного поля "цифровой код страны происхождения" из ДопИнфо. 
//
// Параметры:
//  ДопИнфо - Массив;
// 
// Возвращаемое значение:
//  СправочникСсылка.СтраныМира, Неопределено
//
Функция НайтиСтрануПроисхожденияПоДаннымДопИнфо(ДопИнфо) Экспорт
	
	Результат = Неопределено;
	
	КлючКодСтраны = Перечисление_ИдентификаторыСведенийОСтранеПроисхождения().КодСтраны;

	КодСтраны = "";
	
	Для каждого Элемент Из ДопИнфо Цикл
	
		Если ВРег(Элемент.Ключ) = ВРег(КлючКодСтраны) Тогда
			
			Если ЗначениеЗаполнено(КодСтраны) Тогда
				КодСтраны = Неопределено;
				Прервать;
			КонецЕсли;
			
			КодСтраны = Элемент.Значение; 
			
		КонецЕсли;
	
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(КодСтраны) Тогда
		
		СвойстваОбъекта		 = НовыйКлючевыеСвойстваСтранаМира(); 
		СвойстваОбъекта.Код	 = КодСтраны;
		НайтиСтрану(СвойстваОбъекта);
		
		Результат = СвойстваОбъекта.Ссылка;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Генерирует уникальный строковый идентификатор с ограниченной длиной.
// Входная строка приводится к верхнему регистру, из нее удаляются все пробелы.
// Если длина нормализованной строки превышает заданное ограничение,
// её "хвост" заменяется на хеш-строку, вычисленную по алгоритму MD5.
//
// Параметры:
//  ВходнаяСтрока		 - Строка	 - произвольная строка;
//  МаксимальнаяДлина	 - Число	 - максимальная длина формируемого идентификатора;
// 
// Возвращаемое значение:
//  Строка - идентификатор входной строки.
//
Функция ИдентификаторПоСтроке(Знач ВходнаяСтрока, Знач МаксимальнаяДлина = Неопределено)
	
	Если Не ЗначениеЗаполнено(МаксимальнаяДлина) Тогда 
		МаксимальнаяДлина = 110;
	КонецЕсли;
	
	Идентификатор = СокрЛП(ВходнаяСтрока);
	Идентификатор = ВРег(Идентификатор);
	Идентификатор = СтрЗаменить(Идентификатор, " ", "");
	
	Длина = СтрДлина(Идентификатор);
	
	Если Длина > МаксимальнаяДлина Тогда
		
		Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеширование.Добавить(Идентификатор);
		
		ХешСтрока = Строка(Хеширование.ХешСумма);
		ХешСтрока = СтрЗаменить(ХешСтрока, " ", "");
		
		ДлинаХешСтроки = СтрДлина(ХешСтрока);
		
		Идентификатор = Лев(Идентификатор, МаксимальнаяДлина - ДлинаХешСтроки) + ХешСтрока;
		
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Заполняет идентификатор номенклатуры контрагента, который будет использован
// для сопоставления с номенклатурой информационной базы.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - см. функцию НовыйКлючевыеСвойстваНоменклатураПоставщика.
//
Процедура ЗаполнитьИдентификаторНоменклатурыКонтрагента(НоменклатураКонтрагента)
	
	Если ЗначениеЗаполнено(НоменклатураКонтрагента.Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	
	ФрагментыПредставления = Новый Массив;
	ФрагментыПредставления.Добавить(НоменклатураКонтрагента.Наименование);
