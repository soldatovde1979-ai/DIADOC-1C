// Возвращает таблицу, содержащую контактную информацию объекта.
//
// Параметры:
//  СсылкаИлиОбъект - ЛюбаяСсылка, Объект - Ссылка или объект-владелец контактной информации (организация,
//                                          контрагент, партнер и т.д.).
//  ВидКИ           - СправочникСсылка.ВидыКонтактнойИнформации - Необязательный, отбор по виду контактной информации.
//  Дата            - Дата - необязательный, дата с которой действует запись контактной информации,
//                           используется при хранении истории изменения контактной информации.
//                           Если владелец хранит историю изменений, то при несоответствии параметра
//                           дате будет вызвано исключение.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с контактной информацией объекта, содержащая колонки:
//    * Объект			 - Ссылка - Владелец контактной информации;
//    * Вид				 - СправочникСсылка.ВидыКонтактнойИнформации   - Вид контактной информации;
//    * Тип				 - ПеречислениеСсылка.ТипыКонтактнойИнформации - Тип контактной информации;
//    * ЗначенияПолей	 - Строка - XML, соответствующий XDTO пакетам КонтактнаяИнформация или Адрес;
//    * Значение		 - Строка - (необязательный) контактная информация во внутреннем формате JSON (только для БСП 3.0 и выше).
//    * Представление	 - Строка - Представление контактной информации.
//    * Дата			 - Дата   - (необязательный) Дата с которой действует запись контактной информации (для БСП 2.4 и выше).
//
Функция КонтактнаяИнформацияОбъекта(ЮрФизЛицо, ВидКИ = Неопределено, Знач Дата = Неопределено)
	
	ИнформацияОКонфигурации = МетодСервера(, "СведенияОКонфигурации");
	
	ВерсияБСП = ИнформацияОКонфигурации.ВерсииБиблиотек.СтандартныеПодсистемы;
	
	Если МетодСервера(, "СравнитьВерсии", ВерсияБСП, "2.4") >= 0 Тогда
		Результат = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, ВидКИ, Дата, Ложь);
	Иначе 
		МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЮрФизЛицо);
		Результат	 = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(МассивСсылок, , ВидКИ, Дата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Исправление ошибки БСП 00-00174180:
// Значения полей адреса в формате JSON содержат неверный код страны или код страны вообще не указан.
// Такое поведение зафиксировано на ERP 2.4.6.85 и БП 3.0.65.72 (версии БСП 3.0.1.252 и 3.0.1.268 соответственно).
//
// Параметры:
//  СтруктураАдреса - Структура - см. функцию СведенияОбАдресе;
//
Процедура ПроверитьИсправитьКодСтраныВСведенияхОбАдресе(СтруктураАдреса)
	
	Если ЗначениеЗаполнено(СтруктураАдреса.КодСтраны) Тогда
		Возврат;
	КонецЕсли;
	
	// Находим страну по ее наименованию
	ДанныеСтраны = УправлениеКонтактнойИнформацией.ДанныеКлассификатораСтранМираПоНаименованию(СтруктураАдреса.Страна);
	
	// Исправляем код страны
	Если ЗначениеЗаполнено(ДанныеСтраны) Тогда 
		СтруктураАдреса.КодСтраны = ДанныеСтраны.Код;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, является ли адрес российским.
// Проверка производится по коду страны.
//
// Параметры:
//  СтруктураАдреса - Структура - см. функцию СведенияОбАдресе или урезанный вариант (КодСтраны и Представление);
// 
// Возвращаемое значение:
//  Булево - Истина, если указан код России по ОКСМ (643).
//
Функция ЭтоРоссийскийАдрес(СтруктураАдреса)
	
	Результат = (СтруктураАдреса.КодСтраны = "643");
	
	Возврат Результат;
	
КонецФункции

// Проверяет адрес на соответствие формату КЛАДР. Если в сведении об адресе
// заполнены специфичные для ФИАС поля, то он не поместится в формат КЛАДР.
//
// Параметры:
//  СтруктураАдреса - Структура - см. функцию СведенияОбАдресе.
//
// Возвращаемое значение - Булево - Истина, если адрес соответствует формату КЛАДР.
//
Функция АдресСоответствуетФорматуКЛАДР(СтруктураАдреса)
	
	Соответствует = Ложь;
	
	Если ЗначениеЗаполнено(СвойствоСтруктуры(СтруктураАдреса, "КодРегиона"))
		И Не ЕстьПоляНеПоКЛАДР(СтруктураАдреса)
		И ЗданиеСоответствуетКЛАДР(СтруктураАдреса)
		И КорпусСоответствуетКЛАДР(СтруктураАдреса)
		И ПомещениеСоответствуетКЛАДР(СтруктураАдреса) Тогда
		
		Соответствует = Истина;
		
	КонецЕсли;
	
	Возврат Соответствует;
	
КонецФункции

Функция ЭтоМуниципальныйАдрес(СтруктураАдреса)
	
	ТипАдреса = СвойствоСтруктуры(СтруктураАдреса, "ТипАдреса");
	
	Результат = ТипАдреса = МуниципальныйАдрес();
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что в структуре адреса присутствуют поля, которых нет в формате КЛАДР.
//
// Параметры:
//  СтруктураАдреса - Структура - см. функцию СведенияОбАдресе;
// 
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы одно заполненное поле, не соответстующее формату КЛАДР.
//
Функция ЕстьПоляНеПоКЛАДР(СтруктураАдреса)
	
	Результат = Ложь;
	
	ПоляНеПоКЛАДР = Новый Массив;
	ПоляНеПоКЛАДР.Добавить("Округ");
	ПоляНеПоКЛАДР.Добавить("МуниципальныйРайон");
	ПоляНеПоКЛАДР.Добавить("Поселение");
	ПоляНеПоКЛАДР.Добавить("ВнутригородскойРайон");
	ПоляНеПоКЛАДР.Добавить("Территория");
	ПоляНеПоКЛАДР.Добавить("ДополнительнаяТерритория");
	ПоляНеПоКЛАДР.Добавить("ЭлементДополнительнойТерритории");
	
	Для Каждого ИмяПоля Из ПоляНеПоКЛАДР Цикл 
		
		ЗначениеПоля = СвойствоСтруктуры(СтруктураАдреса, ИмяПоля);
		Если ЗначениеЗаполнено(ЗначениеПоля) Тогда 
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗданиеСоответствуетКЛАДР(СтруктураАдреса)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(СтруктураАдреса.Здание.ТипЗдания)
		Или ВРег(СтруктураАдреса.Здание.ТипЗдания) = ВРег("Дом") Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КорпусСоответствуетКЛАДР(СтруктураАдреса)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(СтруктураАдреса.Корпуса)
		Или СтруктураАдреса.Корпуса.Количество() = 1 //Тогда 
		И ВРег(СтруктураАдреса.Корпуса[0].ТипКорпуса) = ВРег("Корпус") Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПомещениеСоответствуетКЛАДР(СтруктураАдреса)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(СтруктураАдреса.Помещения)
		Или СтруктураАдреса.Помещения.Количество() = 1 //Тогда 
		И ВРег(СтруктураАдреса.Помещения[0].ТипПомещения) = ВРег("Квартира") Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СкопироватьЗначенияJSONВЗначенияПолей(РеквизитыЮрФизЛица)
	
	СоответствиеПолей = Новый Структура;
	СоответствиеПолей.Вставить("ЗначениеJSONЮридическийАдрес"	, "ЗначенияПолейЮридическийАдрес");
	СоответствиеПолей.Вставить("ЗначениеJSONФактическийАдрес"	, "ЗначенияПолейФактическийАдрес");
	СоответствиеПолей.Вставить("ЗначениеJSONПочтовыйАдрес"		, "ЗначенияПолейПочтовыйАдрес");
	СоответствиеПолей.Вставить("ЗначениеJSONТелефоны"			, "ЗначенияПолейТелефоны");
	
	Для каждого Элемент Из СоответствиеПолей Цикл
		
		ПолеИсточник = Элемент.Ключ;
		ПолеПриемник = Элемент.Значение;
		
		НовоеЗначение = РеквизитыЮрФизЛица[ПолеИсточник];
		
		Если ЗначениеЗаполнено(НовоеЗначение) Тогда
			РеквизитыЮрФизЛица[ПолеПриемник] = НовоеЗначение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет в коллекции реквизитов компании свойства, содержащие
// значения полей юридического и фактического адресов.
//
// Параметры:
//  РеквизитыЮрФизЛица	 - Структура - см. функцию РеквизитыЮрФизЛица()
//  ЮрФизЛицо			 - СправочникСсылка - компания, для которой нужно заполнить адресную информацию
//  Период				 - Дата - дата, на которую нужно получить значения периодических реквизитов
//
Процедура ДополнитьРеквизитыЮрФизЛицаАдреснойИнформацией(РеквизитыЮрФизЛица, ЮрФизЛицо, Период = Неопределено)
	
	ПроверяемыеВидыКИ = Новый Массив;
	ПроверяемыеВидыКИ.Добавить(Перечисление_ВидыКИ().ЮридическийАдрес);
	ПроверяемыеВидыКИ.Добавить(Перечисление_ВидыКИ().ФактическийАдрес);
	
	Для Каждого ВидКИСтрокой Из ПроверяемыеВидыКИ Цикл 
		
		ИмяСвойства = "ЗначенияПолей" + ВидКИСтрокой;
		Если ЗначениеЗаполнено(РеквизитыЮрФизЛица[ИмяСвойства]) Тогда 
			Продолжить;
		КонецЕсли;
		
		ЭтоЮрАдрес = (ВидКИСтрокой = Перечисление_ВидыКИ().ЮридическийАдрес);
		
		ВидКИ = МетодСервера(ИмяМодуляИнтеграции(), "ПолучитьВидКИ", ЮрФизЛицо, ЭтоЮрАдрес);
		
		Адрес = АдресЮрФизЛица(ЮрФизЛицо, ВидКИ, Период);
		
		РеквизитыЮрФизЛица[ИмяСвойства] = Адрес.ЗначенияПолей;
		РеквизитыЮрФизЛица[ВидКИСтрокой] = Адрес.Представление;
		
	КонецЦикла;
	
КонецПроцедуры

