// Инициализирует структуру дополнительных параметров для методов сбора контента.
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//    * ИспользоватьСервисКонтурМаркировка - Булево - Истина, если для получения сведений о маркировке следует
//                                                    использовать данные подсистемы Контур.Маркировка.
//    * УказыватьОтсутствиеОснованияУПД - Булево - Истина, если при незаполненном основании передачи
//                                                 товаров (услуг, работ) в поле GroundName следует
//                                                 в указывать строку, определенную форматом для пустого
//                                                 основания передачи (например, "Отсутствует" для 155@
//                                                 или "Без документа-основания" для 820@).
//    * ФункцияДокумента - Строка - функция документа для формирования XML. Используется для UtdSellerContent и UcdSellerContent.
//    * ДополнительныеСведенияСтрокой - Строка - (Устарел) Список доп. полей в формате "ИмяПоля = Значение".
//                                               Доп. поля указываются через точку с запятой.
//    * ФИОПодписанта - Строка - (Устарел) Фамилия, имя и отчество  подписанта.
//    * ПараметрыСогласования - Структура - Заполняется при передаче документа на согласование/подпись:
//       ** ФИОПодписанта - Строка - Фамилия, имя и отчетство подписанта;
//       ** ДолжностьПодписанта - Строка - должность подписанта;
//       ** ФИОПолучателя - Строка - Фамилия, имя и отчество получателя;
//       ** ДолжностьПолучателя - Строка - должность получателя;
//    * Отправитель_FnsParticipantId - Строка - идентификатор участника ЭДО отправителя документа;
//    * Получатель_FnsParticipantId - Строка - идентификатор участника ЭДО получателя документа;
//    * НомерЗаказа - Строка - номер заказа (используется только для формата 172@);
//    * ДанныеСотрудника - Структура - (Необязательный) Сведения о работнике организации продавца (РабОргПрод):
//       ** Фамилия - Строка - фамилия сотрудника.
//       ** Имя - Строка - имя сотрудника.
//       ** Отчество - Строка - отчество сотрудника.
//       ** Должность - Строка - должность сотрудника.
//
Функция ДополнительныеПараметрыПолученияКонтента() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("УказыватьОтсутствиеОснованияУПД", Ложь);
	Результат.Вставить("ДополнительныеСведенияСтрокой", "");
	Результат.Вставить("ФункцияДокумента", Неопределено);
	Результат.Вставить("ПараметрыСогласования", Неопределено);
	Результат.Вставить("ФИОПодписанта", Неопределено);
	Результат.Вставить("НомерЗаказа", Неопределено);
	Результат.Вставить("Отправитель_FnsParticipantId", Неопределено);
	Результат.Вставить("Получатель_FnsParticipantId", Неопределено);
	Результат.Вставить("ПараметрыФормированияФайла", Неопределено);
	Результат.Вставить("ДанныеСотрудника", Неопределено);
	Результат.Вставить("ИспользоватьСервисКонтурМаркировка", Ложь);
	Результат.Вставить("ФорматОтправки", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Формирует протоструктуру для отправки электронного документа в заданном формате.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ФорматОтправки	 - Структура - содержит свойства:
//    * ИмяТипа			 - Строка - имя типа документа (typeNameId);
//    * ФункцияДокумента - Строка - функция документа (Function);
//    * ВерсияФормата	 - Строка - версия формата контента (Version);
//  ДополнительныеПараметры - Структура - см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентФормализованногоДокумента(СсылкаНаДокумент, ФорматОтправки, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтента();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	ОписаниеФормата = ПолноеОписаниеФорматаЭлектронногоДокумента(ФорматОтправки);
	
	БазовыеФорматы = БазовыеФорматы();
	БазовыйФормат = ОписаниеФормата.БазовыйФормат;
	
	ПараметрыФормирования.ФорматОтправки = ОписаниеФормата;
	ПараметрыФормирования.ФункцияДокумента = ФункцияУниверсальногоДокумента(ОписаниеФормата);
	
	Если БазовыйФормат = БазовыеФорматы.utd820 Тогда
		
		Результат = КонтентУПД820(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.utd Тогда
		
		Результат = КонтентУПД155(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.ucd736 Тогда 	
		
		Результат = КонтентУКД736(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.ucd Тогда
		
		Результат = КонтентУКД189(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.torg12 Тогда
		
		Результат = КонтентНакладной172(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.act Тогда
		
		Результат = КонтентАкта172(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.invoice Тогда
		
		Результат = КонтентСчетаФактуры93(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.invoicecor Тогда
		
		Результат = КонтентКорректировочногоСчетаФактуры93(СсылкаНаДокумент, ПараметрыФормирования);
		
	ИначеЕсли БазовыйФормат = БазовыеФорматы.proformainvoice Тогда
		
		Результат = КонтентФормализованногоСчета(СсылкаНаДокумент, ПараметрыФормирования);
		
	Иначе
		
		ТекстОшибки = СтрШаблон("Формат отправки не поддерживается!
			|Тип документа: %1
			|Функция документа: %2
			|Версия документа: %3"
			, ОписаниеФормата.ИмяТипа
			, ОписаниеФормата.ФункцияДокумента
			, ОписаниеФормата.ВерсияФормата);
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации()
			, УровеньЖурналаРегистрации.Ошибка
			, СсылкаНаДокумент.Метаданные()
			, СсылкаНаДокумент
			, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

