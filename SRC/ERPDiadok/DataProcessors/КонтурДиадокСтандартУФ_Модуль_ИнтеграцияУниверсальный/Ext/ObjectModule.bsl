//
// Параметры:
//  ИсходнаяСтруктура	 - Структура - исходная структура;
//  КопируемыеПоля		 - Строка - имена копируемый полей исходной структуры;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КопияСтруктуры(ИсходнаяСтруктура, КопируемыеПоля)
	
	Результат = Новый Структура(КопируемыеПоля);
	ЗаполнитьЗначенияСвойств(Результат, ИсходнаяСтруктура);
	
	Возврат Результат;
	
КонецФункции

// Заполняет свойство "Ссылка" структуры "ЮрФизЛицо".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. НовыйКлючевыеСвойстваЮрФизЛицо();
//
Процедура НайтиКонтрагента(СвойстваОбъекта)
	
	Если Не ЗначениеЗаполнено(СвойстваОбъекта) Тогда 
		Возврат;
	КонецЕсли;
	
	КоллекцияУчастниковЭДО = ЗначениеВМассиве(СвойстваОбъекта);
	
	ОписаниеОбъектаМетаданных = МетаданныеПрикладногоСправочника("Контрагенты");
	
	Если ОписаниеОбъектаМетаданных = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент из КоллекцияУчастниковЭДО Цикл
		
		Если ЗначениеЗаполнено(Элемент.Ссылка) Тогда 
			Возврат;
		КонецЕсли;
		
		ПоляПоиска = Новый Массив;
		ПоляПоиска.Добавить(КопияСтруктуры(Элемент, "ИдентификаторОрганизации"));
		
		Элемент.Ссылка = СсылкаОбъектаПоНаборуПолейПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет свойство "Ссылка" структуры "ЮрФизЛицо".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. НовыйКлючевыеСвойстваЮрФизЛицо();
//
Процедура НайтиОрганизацию(СвойстваОбъекта)
	
	Если Не ЗначениеЗаполнено(СвойстваОбъекта) Тогда 
		Возврат;
	КонецЕсли;
	
	КоллекцияУчастниковЭДО = ЗначениеВМассиве(СвойстваОбъекта);
	
	ОписаниеОбъектаМетаданных = МетаданныеПрикладногоСправочника("Организации");
	
	Если ОписаниеОбъектаМетаданных = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент из КоллекцияУчастниковЭДО Цикл
		
		Если ЗначениеЗаполнено(Элемент.Ссылка) Тогда 
			Возврат;
		КонецЕсли;
		
		ПоляПоиска = Новый Массив;
		ПоляПоиска.Добавить(КопияСтруктуры(Элемент, "ИдентификаторОрганизации"));
		ПоляПоиска.Добавить(КопияСтруктуры(Элемент, "ИдентификаторУчастникаЭДО"));
		ПоляПоиска.Добавить(КопияСтруктуры(Элемент, "ИНН, КПП"));
		ПоляПоиска.Добавить(КопияСтруктуры(Элемент, "НаименованиеПолное, ИНН"));
		ПоляПоиска.Добавить(КопияСтруктуры(Элемент, "Наименование, ИНН"));
		
		Элемент.Ссылка = СсылкаОбъектаПоНаборуПолейПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет свойство "Ссылка" структуры "ЮрФизЛицо".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. НовыйКлючевыеСвойстваПартнер();
//
Процедура НайтиПартнера(СвойстваОбъекта)
	
	Если Не ЗначениеЗаполнено(СвойстваОбъекта) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваОбъекта.Ссылка) Тогда 
		Возврат;
	КонецЕсли;
	
	ОписаниеОбъектаМетаданных = МетаданныеПрикладногоСправочника("Партнеры");
	
	Если ОписаниеОбъектаМетаданных = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Контрагент = СвойствоСтруктуры(СвойстваОбъекта, "Контрагент");
	
	СвойстваОбъекта.Ссылка = ПартнерПоКонтрагенту(Контрагент);
	
КонецПроцедуры

// Заполняет свойство "Ссылка" структуры "Валюта".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. НовыйКлючевыеСвойстваВалюта();
//
Процедура НайтиВалюту(СвойстваОбъекта)
	
