КонецПроцедуры

// Заполняет сведения о работнике организации продавца, передавшем товар (груз).
//
// Параметры:
//  Контент - Структура - протоконтент в формате приказа 155@.
//  Шапка - Структура - данные шапки документа-источника (см. ДанныеШапки).
//  ПараметрыФормирования - Структура - параметры получения контента (см. ДополнительныеПараметрыПолученияКонтента)
//
Процедура ЗаполнитьСведенияОЛицеПередавшемТовар(Контент, Шапка, ПараметрыФормирования) Экспорт
	
	Сотрудник = ПараметрыФормирования.ДанныеСотрудника;
	
	Если Не ЗначениеЗаполнено(Сотрудник)
		Или Не ЗначениеЗаполнено(Сотрудник.Должность) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьФункцияПД = (Шапка.Функция = "InvoiceAndBasic" ИЛИ Шапка.Функция = "Basic");
	
	Если Не Шапка.ЕстьТовары
		Или Не ЕстьФункцияПД Тогда
		Возврат;
	КонецЕсли;
	
	Контент.TransferInfo.Employee.Surname		   = Сотрудник.Фамилия;
	Контент.TransferInfo.Employee.FirstName		   = Сотрудник.Имя;
	Контент.TransferInfo.Employee.Patronymic	   = Сотрудник.Отчество;
	Контент.TransferInfo.Employee.EmployeePosition = Сотрудник.Должность;
	
КонецПроцедуры

// Заполняет поля "Name" и "Function" протоструктуры в формате приказа 155@
//
// Параметры:
//  Прото - Структура - протоконтент.
//  ФорматОтправки - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
Процедура ЗаполнитьНаименованиеФункцию155(Прото, ФорматОтправки) Экспорт
	
	ТипыЭД = ИдентификаторыТиповДокументов();
	ФункцииЭД = ФункцииЭлектронныхДокументов();
	
	ИмяТипа = ФорматОтправки.ИмяТипа;
	ФункцияДокумента = ФорматОтправки.ФункцияДокумента;
	
	Если ФункцияДокумента = ФункцииЭД.ПоУмолчанию Тогда
		
		ТипыСЧФ = Новый Массив;
		ТипыСЧФ.Добавить(ТипыЭД.Invoice);
		ТипыСЧФ.Добавить(ТипыЭД.InvoiceRevision);
		
		ЭтоСчетФактура = (ТипыСЧФ.Найти(ИмяТипа) <> Неопределено);
		Если ЭтоСчетФактура Тогда
			ФункцияПрото = ФункцияПрото_Invoice();
		Иначе
			ФункцияПрото = ФункцияПрото_Basic();
		КонецЕсли;
		
	Иначе
		
		ЗначенияФункций = Новый Соответствие;
		ЗначенияФункций.Вставить(ФункцииЭД.СЧФДОП, ФункцияПрото_InvoiceAndBasic());
		ЗначенияФункций.Вставить(ФункцииЭД.СЧФ, ФункцияПрото_Invoice());
		ЗначенияФункций.Вставить(ФункцииЭД.ДОП, ФункцияПрото_Basic());
		
		ФункцияПрото = ЗначенияФункций.Получить(ФункцияДокумента);
		
	КонецЕсли;
	
	Если ФункцияПрото = ФункцияПрото_InvoiceAndBasic() Тогда
		НаименованиеЭД = "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	ИначеЕсли ФункцияПрото = ФункцияПрото_Basic() Тогда
		НаименованиеЭД = "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)";
	ИначеЕсли ФункцияПрото = ФункцияПрото_Invoice() Тогда
		НаименованиеЭД = Неопределено;
	Иначе
		
		Ошибка = СтрШаблон("Недопустимое значение функции протоструктуры (%1) (ИмяТипа = %2, ФункцияДокумента = %3)",
			ФункцияПрото,
			ФорматОтправки.ИмяТипа,
			ФорматОтправки.ФункцияДокумента);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Прото.Function = ФункцияПрото;
	Прото.Name = НаименованиеЭД;
	
КонецПроцедуры

// Возвращает информацию о стране происхождения товара в формате строки.
//
// Параметры:
//  КоллекцияСведений - Структура - Коллекция сведений о стране происхождения:
//      * СтранаПроисхождения - СправочникСсылка.СтраныМира - Страна происхождения товара.
//      * НомерГТД            - СправочникСсылка.НомераГТД - Номер грузовой таможенной декларации.
//
// Возвращаемое значение:
//   Строка - Сведения о стране происхождения товара для поля StructedAdditionalInfo в формате Ключ=Значение.
//
Функция СведенияОСтранеПроисхожденияСтрокой(КоллекцияСведений) Экспорт
	
	ПараметрыСтроки = Новый Массив;
	
	Если ЗначениеЗаполнено(КоллекцияСведений.СтранаПроисхождения) Тогда
		
		КодСтраныПроисхождения = ПривестиКЧислу(СокрЛП(КоллекцияСведений.СтранаПроисхождения.Код));
		
		ШаблонКодСтраныПроисхождения	= НСтр("ru = 'цифровой код страны происхождения=%1'");
		ПараметрКодСтраныПроисхождения	= ПодставитьПараметрыВСтроку(ШаблонКодСтраныПроисхождения, КодСтраныПроисхождения);
		
		ШаблонСтранаПроисхождения	= НСтр("ru = 'краткое наименование страны происхождения=%1'");
		ПараметрСтранаПроисхождения	= ПодставитьПараметрыВСтроку(ШаблонСтранаПроисхождения, КоллекцияСведений.СтранаПроисхождения);
		
		ПараметрыСтроки.Добавить(ПараметрКодСтраныПроисхождения);
		ПараметрыСтроки.Добавить(ПараметрСтранаПроисхождения);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоллекцияСведений.НомерГТД) Тогда
		
		ШаблонНомерГТД = НСтр("ru = 'регистрационный номер декларации на товары=%1'");
		ПараметрНомерГТД = ПодставитьПараметрыВСтроку(ШаблонНомерГТД, СокрЛП(КоллекцияСведений.НомерГТД));
		
		ПараметрыСтроки.Добавить(ПараметрНомерГТД);
		
	КонецЕсли;
	
	СведенияОстранеПроисхождения = СтрокаИзМассиваПодстрок(ПараметрыСтроки, ";");
	
	Возврат СведенияОстранеПроисхождения;

КонецФункции

Процедура ЗаполнитьОбстФормСЧФ820(Контент, СчетФактура, ФункцияУПД)
	
	ФункцииЭлектронныхДокументов	 = ФункцииЭлектронныхДокументов();
	ЭтоФункцияДОП					 = ФункцияУПД = ФункцииЭлектронныхДокументов.ДОП;
	ЭтоФункцияСЧФДОП				 = ФункцияУПД = ФункцииЭлектронныхДокументов.СЧФДОП;
	
	Если ЭтоФункцияДОП ИЛИ ЭтоФункцияСЧФДОП Тогда
		
		Результат = МетодСервера(ИмяМодуляИнтеграции(), "ПолучитьОбстоятельствоФормированияСчетФактуры"
			, СчетФактура);
		
		Контент.CircumFormatInvoice = Результат;
		
	КонецЕсли;
	
