#Область ПравилаОтправки

// Находит правило отправки документа по его виду, функции и флагу исправления.
//
//
// Параметры:
//  КлючНастройкиОтправки	 - Строка - см. КлючиНастроекОтправки;
//  ВидДокумента			 - Строка - см. ИдентификаторыТиповДокументов;
//  ФункцияДокумента		 - Строка - см. ФункцииЭлектронныхДокументов;
//  ЭтоИсправление			 - Булево - Истина, если нужно отправить исправленную версию документа
//  КэшПравил				 - Соответствие, Неопределено - содержит ключи настроек отправки и соответствующие им правила отправки;
// 
// Возвращаемое значение:
//  Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента;
//
Функция ФорматОтправкиДокумента(КлючНастройкиОтправки, ВидДокумента, ФункцияДокумента, ЭтоИсправление, КэшПравил = Неопределено)
	
	Результат = Неопределено;
	
	Если КэшПравил = Неопределено Тогда
		КэшПравил = Новый Соответствие;
	КонецЕсли;
	
	ПравилаОтправки = КэшПравил[КлючНастройкиОтправки];
	Если Не ЗначениеЗаполнено(ПравилаОтправки) Тогда
		ПравилаОтправки = ПравилаОтправкиДокументов(КлючНастройкиОтправки);
		КэшПравил.Вставить(КлючНастройкиОтправки, ПравилаОтправки);
	КонецЕсли;
	
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("ВидЭД"				, ВидДокумента);
	ПараметрыДокумента.Вставить("ФункцияДокумента"	, ФункцияДокумента);
	ПараметрыДокумента.Вставить("ЭтоИсправление"	, ЭтоИсправление);
	
	НайденныеПравила = ПравилаОтправки.НайтиСтроки(ПараметрыДокумента);
	
	Если ЗначениеЗаполнено(НайденныеПравила) Тогда
		Результат = НайденныеПравила[0].ФорматОтправки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Для указанного ключа настроек формирует таблиц правил, по которым
// определяется формат отправки документа. Чтобы корректно определить
// формат отправки документа, нужно знать, что это за документ (его вид),
// его функцию, а также понимать, является ли этот документ исправлением.
//
// Параметры:
//  КлючНастройкиФорматаОтправки - Строка - см. КлючиНастроекОтправки;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//    * ВидЭД			 - Строка - см. ВидыЭлектронныхДокументов;
//    * ФункцияДокумента - Строка - см. ФункцииЭлектронныхДокументов;
//    * ЭтоИсправление	 - Булево - Истина, если исправленная версия документа;
//    * ФорматОтправки	 - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента;
//
Функция ПравилаОтправкиДокументов(КлючНастройкиФорматаОтправки)
	
	КлючиНастроек = КлючиНастроекОтправки();
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидЭД");
	Результат.Колонки.Добавить("ФункцияДокумента");
	Результат.Колонки.Добавить("ЭтоИсправление");
	Результат.Колонки.Добавить("ФорматОтправки");
	
	ДобавитьОбщиеПравилаОтправки(Результат);
	
	Если 	КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФДОП_820_736
		Или КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФ_ДОП_820_736 Тогда 
		
		ДобавитьПравилаОтправкиУПДСЧФДОП820(Результат);
		ДобавитьПравилаОтправкиУПДСЧФ820(Результат);
		ДобавитьПравилаОтправкиУПДДОП820(Результат);
		ДобавитьПравилаОтправкиУКДКСЧФДИС736(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФДОП_820
		Или КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФ_ДОП_820 Тогда
		
		ДобавитьПравилаОтправкиУПДСЧФДОП820(Результат);
		ДобавитьПравилаОтправкиУПДСЧФ820(Результат);
		ДобавитьПравилаОтправкиУПДДОП820(Результат);
		ДобавитьПравилаОтправкиУКДКСЧФДИС189(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФДОП
		Или КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФ_ДОП Тогда
		
		ДобавитьПравилаОтправкиУПДСЧФДОП155(Результат);
		ДобавитьПравилаОтправкиУПДСЧФ155(Результат);
		ДобавитьПравилаОтправкиУПДДОП155(Результат);
		ДобавитьПравилаОтправкиУКДКСЧФДИС189(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СФТОРГ12АКТ_820_736 Тогда
		
		ДобавитьПравилаОтправкиСФ820(Результат);
		ДобавитьПравилаОтправкиКСФ736(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов820(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СФТОРГ12АКТ_820 Тогда
		
		ДобавитьПравилаОтправкиСФ820(Результат);
		ДобавитьПравилаОтправкиКСФ189(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов820(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СФТОРГ12АКТ Тогда
		
		ДобавитьПравилаОтправкиСФ155(Результат);
		ДобавитьПравилаОтправкиКСФ189(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов155(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СЧФ Тогда
		
		ДобавитьПравилаОтправкиУПДСЧФ155(Результат);
		ДобавитьПравилаОтправкиУКДКСЧФДИС189(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов172(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.ДОП Тогда
		
		ДобавитьПравилаОтправкиСФ93(Результат);
		ДобавитьПравилаОтправкиКСФ93(Результат);
		ДобавитьПравилаОтправкиУКДКСЧФДИС189(Результат);
		ДобавитьПравилаОтправкиУПДДОП155(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.СФ Тогда
		
		ДобавитьПравилаОтправкиСФ155(Результат);
		ДобавитьПравилаОтправкиКСФ189(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов172(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.ТОРГ12АКТ Тогда
		
		ДобавитьПравилаОтправкиСФ93(Результат);
		ДобавитьПравилаОтправкиКСФ93(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов155(Результат);
		
	ИначеЕсли КлючНастройкиФорматаОтправки = КлючиНастроек.НЕТ Тогда
		
		ДобавитьПравилаОтправкиСФ93(Результат);
		ДобавитьПравилаОтправкиКСФ93(Результат);
		ДобавитьПравилаОтправкиНакладныхАктов172(Результат);
		
	Иначе
		
		Ошибка = СтрШаблон("Неизвестный ключ настройки отправки (%1)", КлючНастройкиФорматаОтправки);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет новую строку в таблицу правил определения формата отправки.
//
// Параметры:
//  Правила			 - ТаблицаЗначений - см. ПравилаОтправкиДокументов;
//  ВидЭД			 - Строка - см. ВидыЭлектронныхДокументов;
//  ФункцияДокумента - Строка - см. ФункцииЭлектронныхДокументов;
//  ЭтоИсправление	 - Булево - Истина, если исправленная версия документа;
//  ФорматОтправки	 - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента;
//
Процедура ДобавитьПравилоОтправки(Правила, ВидЭД, ФункцияДокумента, ФорматОтправки, ЭтоИсправление = Ложь)
	
	НовоеПравило = Правила.Добавить();
	НовоеПравило.ВидЭД = ВидЭД;
	НовоеПравило.ФункцияДокумента = ФункцияДокумента;
	НовоеПравило.ФорматОтправки = ФорматОтправки;
	НовоеПравило.ЭтоИсправление = ЭтоИсправление;
	
КонецПроцедуры

// Добавляет правила отправки, общие для всех настроек отправки.
//
// Параметры:
//  Правила - ТаблицаЗначений - см. ПравилаОтправкиДокументов;
//
Процедура ДобавитьОбщиеПравилаОтправки(Правила)
	
	ВидыЭД	  = ВидыЭлектронныхДокументов();
	ФункцииЭД = ФункцииЭлектронныхДокументов();
	
	// Счета на оплату
	ФорматОтправки = ФорматОтправкиСчетНаОплату();
	
	Для Индекс = 0 По 1 Цикл
		
		Исправление = (Индекс = 1);
		
		ДобавитьПравилоОтправки(Правила
			, ВидыЭД.СчетНаОплату
			, ФункцииЭД.ПоУмолчанию
			, ФорматОтправки
			, Исправление);
		
	КонецЦикла;
	
	// Акты сверок
	ДобавитьПравилоОтправки(Правила
		, ВидыЭД.АктСверки
		, ФункцииЭД.ПоУмолчанию
		, ФорматОтправкиАктСверки());
	
	// Прочие неформализованные
	ДобавитьПравилоОтправки(Правила
		, ВидыЭД.Произвольный
		, ФункцииЭД.ПоУмолчанию
		, ФорматОтправкиПроизвольный());
	
КонецПроцедуры

