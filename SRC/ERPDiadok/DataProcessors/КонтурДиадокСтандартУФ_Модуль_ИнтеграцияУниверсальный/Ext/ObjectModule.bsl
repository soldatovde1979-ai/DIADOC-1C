// Инициализирует структуру, описывающую формат электронного документа.
//
// Возвращаемое значение:
//  Структура - содержит свойства:
//  * ИмяТипа			 - Строка - Именованный идентификатор типа документа;
//  * ФункцияДокумента	 - Строка - Функция документа;
//  * ВерсияФормата		 - Строка - Версия формата;
//  * Представление		 - Строка - Представление формата;
//  * БазовыйФормат		 - Строка - Идентификатор базового формата (см. БазовыеФорматы);
//  * ПриказОбУтверждении - ФиксированнаяСтруктура - приказ об утверждении формата (см. НовыйПриказОбУтвержденииФормата)
//  * ТипКонтента		 - Строка - (Для совместимости) Тип протоконтента (см. ТипыКонтента);
//  * DocumentType		 - Строка - (Для совместимости) Тип документа в терминах компоненты;
//  * ЭтоИсправление	 - Булево - Истина, если это исправительный документ;
//  * ЭтоКорректировка	 - Булево - Истина, если это корректировочный документ;
//  * ЕстьФункцияПД		 - Булево - Истина, если формат включает функцию первичного документа;
//  * ЕстьФункцияСФ		 - Булево - Истина, если формат включает функцию счета-фактуры;
//  * ВидПервичногоДокумента - см. функцию ВидПервичногоДокумента;
//  * ВидСчетаФактуры		 - см. функцию ВидСчетаФактуры;
//  * ТипДокумента		 - Строка - Идентификатор вида электонного документа.
//
Функция НовоеОписаниеФорматаЭлектронногоДокумента()
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяТипа");
	Результат.Вставить("ВерсияФормата");
	Результат.Вставить("ФункцияДокумента");
	Результат.Вставить("Представление");
	Результат.Вставить("БазовыйФормат");
	Результат.Вставить("ПриказОбУтверждении");
	Результат.Вставить("ЭтоИсправление", Ложь);
	Результат.Вставить("ЭтоКорректировка", Ложь);
	Результат.Вставить("ВидПервичногоДокумента");
	Результат.Вставить("ВидСчетаФактуры");
	Результат.Вставить("ЕстьФункцияПД", Ложь);
	Результат.Вставить("ЕстьФункцияСФ", Ложь);
	Результат.Вставить("ТипКонтента"); // Для совместимости
	Результат.Вставить("DocumentType"); // Для совместимости
	Результат.Вставить("ТипДокумента");
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что переданная структура содержит полное описание формата электронных документов.
//
// Параметры:
//  ФорматЭД - Структура - описание формата.
// 
// Возвращаемое значение:
//  Булево - Истина, если параметр содержит полное описание формата.
//
Функция ЭтоПолноеОписаниеФорматаЭД(ФорматЭД)
	
	Результат = Истина;
	
	ШаблонФормата = НовоеОписаниеФорматаЭлектронногоДокумента();
	
	Для Каждого Элемент Из ШаблонФормата Цикл
		
		Если Не ФорматЭД.Свойство(Элемент.Ключ) Тогда
			Результат = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает полное описание формата электронного документа по структуре, содержащей
// имя типа, функцию документа и версию формата вложения.
//
// Параметры:
//  ФорматЭД - Структура - содержит ключи:
//   * ИмяТипа - Строка - идентификатор типа документа (TypeNamedId)
//   * ФункцияДокумента - Строка - идентификатор функции документа (Function)
//   * ВерсияФормата - Строка - идентификатор версии вложения (Version).
// 
// Возвращаемое значение:
//  Структура - полное описание формата (см. ОписаниеФорматаЭлектронногоДокумента)
//
Функция ПолноеОписаниеФорматаЭлектронногоДокумента(ФорматЭД) Экспорт
	
	ЭтоПолноеОписаниеФормата = ЭтоПолноеОписаниеФорматаЭД(ФорматЭД);
	
	Если ЭтоПолноеОписаниеФормата Тогда
		Результат = ФорматЭД;
	Иначе
		Результат = ОписаниеФорматаЭлектронногоДокумента(ФорматЭД.ИмяТипа
			, ФорматЭД.ФункцияДокумента
			, ФорматЭД.ВерсияФормата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует описание формата электронного документа.
//
// Параметры:
//  ИмяТипа			 - Строка - typeNameId (см. ИдентификаторыТиповДокументов())
//  ФункцияДокумента - Строка - Function (см. ФункцииЭлектронныхДокументов())
//  ВерсияФормата	 - Строка - Version (см. значения перечисления ВерсииФорматовЭлектронныхДокументов())
// 
// Возвращаемое значение:
//  Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента.
//
Функция ОписаниеФорматаЭлектронногоДокумента(ИмяТипа, ФункцияДокумента, ВерсияФормата) Экспорт
	
	БазовыйФормат	 = БазовыйФорматВерсииКонтента(ВерсияФормата);
	ТипКонтента		 = ТипКонтентаПоБазовомуФормату(БазовыйФормат);
	ТипДокументаCOM	 = ТипДокументаКомпоненты(ИмяТипа);
	Представление	 = ПредставлениеФорматаЭД(ИмяТипа, ФункцияДокумента);
	ПриказОбУтверждении = ПриказОбУтвержденииФормата(БазовыйФормат);
	
	Результат = НовоеОписаниеФорматаЭлектронногоДокумента();
	Результат.ИмяТипа			 = ИмяТипа;
	Результат.ВерсияФормата		 = ВерсияФормата;
	Результат.ФункцияДокумента	 = ФункцияДокумента;
	
	// Расчетные параметры
	Результат.Представление	 = Представление;
	Результат.БазовыйФормат	 = БазовыйФормат;
	Результат.ТипКонтента	 = ТипКонтента;
	Результат.DocumentType	 = ТипДокументаCOM;
	Результат.ЭтоКорректировка	 = ЭтоКорректировочныйДокумент(ИмяТипа);
	Результат.ЭтоИсправление	 = ЭтоИсправительныйДокумент(ИмяТипа);
	Результат.ТипДокумента	= ОпределитьТипДокумента(ИмяТипа);
	
	Результат.ПриказОбУтверждении = ПриказОбУтверждении;
	
	Результат.ВидПервичногоДокумента = ВидПервичногоДокумента(Результат);
	Результат.ВидСчетаФактуры		 = ВидСчетаФактуры(Результат);
	Результат.ЕстьФункцияПД	 = ЗначениеЗаполнено(Результат.ВидПервичногоДокумента);
	Результат.ЕстьФункцияСФ	 = ЗначениеЗаполнено(Результат.ВидСчетаФактуры);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Формирует представление для формата электронных документов
// для отображения в пользовательском интерфейсе
//
// Параметры:
//  ИмяТипа			 - Строка - см. ИдентификаторыТиповДокументов;
//  ФункцияДокумента - Строка - см. ФункцииЭлектронныхДокументов;
// 
// Возвращаемое значение:
//  Строка - представление формата ЭД.
//
Функция ПредставлениеФорматаЭД(ИмяТипа, ФункцияДокумента)
	
	ПредставлениеТипа	 = ПредставлениеТипаЭлектронногоДокумента(ИмяТипа);
	ПредставлениеФункции = ПредставлениеФункцииЭлектронногоДокумента(ФункцияДокумента);
	
	Подстроки = Новый Массив;
	Подстроки.Добавить(ПредставлениеТипа);
	
	Если ЗначениеЗаполнено(ПредставлениеФункции) Тогда
		Подстроки.Добавить(ПредставлениеФункции);
	КонецЕсли;
	
	Результат = СтрСоединить(Подстроки, " ");
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление типа электронного документа для отображения
// в пользовательском интерфейсе.
//
// Параметры:
//  ИмяТипа - Строка - см. ИдентификаторыТиповДокументов;
// 
// Возвращаемое значение:
//  Строка.
//
Функция ПредставлениеТипаЭлектронногоДокумента(ИмяТипа)
	
	ТипыДокументов = ИдентификаторыТиповДокументов();
	
	ПредставленияТипов = Новый Соответствие;
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalTransferDocument
		, НСтр("ru = 'УПД'; en = 'UTD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalTransferDocumentRevision
		, НСтр("ru = 'Исправление УПД'; en = 'Revision of UTD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalCorrectionDocument
		, НСтр("ru = 'УКД'; en = 'UAD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.UniversalCorrectionDocumentRevision
		, НСтр("ru = 'Исправление УКД'; en = 'Revision of UAD'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.XmlTorg12
		, НСтр("ru = 'Торг-12'; en='TORG-12'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.Torg12
		, НСтр("ru = 'Торг-12'; en='TORG-12'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.XmlAcceptanceCertificate
		, НСтр("ru = 'Акт'; en='Act'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.AcceptanceCertificate
		, НСтр("ru = 'Акт'; en='Act'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.Invoice
		, НСтр("ru = 'Счет-фактура'; en='Tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.InvoiceRevision
		, НСтр("ru = 'Исправление СФ'; en='Revision of tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.InvoiceCorrection
		, НСтр("ru = 'Корректировочный СФ'; en = 'Corrective tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.InvoiceCorrectionRevision
		, НСтр("ru = 'Исправление КСФ'; en = 'Revision of corrective tax invoice'"));
	
	ПредставленияТипов.Вставить(ТипыДокументов.ProformaInvoice
		, НСтр("ru = 'Счет на оплату'; en='Proforma invoice'"));
	
