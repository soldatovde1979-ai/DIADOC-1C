// Получает основные сведения о признаках и свойствах, характеризующих объект информационной базы.
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на потенциальный источник сведений для формирования электронного документа;
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//    * Ссылка - ЛюбаяСсылка - ссылка на исходный документ
//    * Проведен - Булево - Истина, если объект является документом и проведен
//    * ПометкаУдаления - Булево - Истина, если объект помечен на удаление
//    * Дата - Дата - Системная дата документа
//    * Номер - Строка - Системный номер объекта
//    * ЭтоИсравление - Булево - Истина, если это исправительный документ
//    * ЭтоКорректировка - Булево - Истина, если это корректировочный документ
//    * ВидДокумента - Строка - вид документа с точки зрения ЭДО (см. ВидыЭлектронныхДокументов)
//
Функция ОписаниеПрикладногоДокумента(СсылкаНаОбъект) Экспорт
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("Ссылка");
	ТребуемыеРеквизиты.Вставить("Проведен");
	ТребуемыеРеквизиты.Вставить("ПометкаУдаления");
	ТребуемыеРеквизиты.Вставить("Дата");
	ТребуемыеРеквизиты.Вставить("Номер");
	ТребуемыеРеквизиты.Вставить("ЭтоКорректировка", "ЛОЖЬ");
	ТребуемыеРеквизиты.Вставить("ЭтоИсправление", "ЛОЖЬ");
	
	ЭтоДокумент = Метаданные.Документы.Содержит(СсылкаНаОбъект.Метаданные());
	Если Не ЭтоДокумент Тогда
		ТребуемыеРеквизиты.Проведен = "ЛОЖЬ";
	КонецЕсли;
	
	ПриПолученииОписанияПрикладногоДокумента(ТребуемыеРеквизиты, СсылкаНаОбъект);
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, ТребуемыеРеквизиты);
	
	РеквизитыТипаБулево = Новый Массив;
	РеквизитыТипаБулево.Добавить("Проведен");
	РеквизитыТипаБулево.Добавить("ПометкаУдаления");
	РеквизитыТипаБулево.Добавить("ЭтоКорректировка");
	РеквизитыТипаБулево.Добавить("ЭтоИсправление");
	
	Для Каждого ИмяРеквизита Из РеквизитыТипаБулево Цикл
		
		Если Результат[ИмяРеквизита] = Неопределено Тогда
			Результат[ИмяРеквизита] = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ВидДокумента = ВидДокументаИнформационнойБазы(СсылкаНаОбъект, Результат.ЭтоКорректировка);
	
	Результат.Вставить("ВидДокумента", ВидДокумента);
	
	Возврат Результат;
	
КонецФункции

// Возвращает сведения о дате и номере документа, необходимые для формирования электронных документов и печатных форм.
//
// Параметры:
//  ОписаниеДокумента - Структура - параметры объекта ИБ (см. ОписаниеПрикладногоДокумента)
//  ЦифровойИндексОП - Строка, Число - цифровой индекс обособленного подразделения
// 
// Возвращаемое значение:
//  Структура - содержит свойства:
//    * НомерДокумента - Строка - представление номера документа;
//    * ДатаДокумента - Дата - дата документа;
//    * НомерИсправления - Строка - (необязательный) номер исправления документа;
//    * ДатаИсправления - Дата - (необязательный) дата исправления документа;
//    * НомерИсходногоДокумента - Строка - (необязательный) представление номера корректируемого документа;
//    * ДатаИсходногоДокумента - Дата - (необязательный) дата корректируемого документа;
//    * УчитыватьИсправлениеИсходногоДокумента - Булево - Истина, если требуется учитывать дату и номер исправления корректируемого документа;
//    * НомерИсправленияИсходногоДокумента - Строка - (необязательный) номер исправления корректируемого документа;
//    * ДатаИсправленияИсходногоДокумента - Дата - (необязательный) дата исправления корректируемого документа;
//
Функция ДатаНомерДокумента(ОписаниеДокумента, ЦифровойИндексОП) Экспорт
	
	СсылкаНаОбъект 		= ОписаниеДокумента.Ссылка;
	ЭтоКорректировка 	= ОписаниеДокумента.ЭтоКорректировка;
	
	Результат = Новый Структура;
	Результат.Вставить("НомерДокумента");
	Результат.Вставить("ДатаДокумента");
	Результат.Вставить("НомерИсправления");
	Результат.Вставить("ДатаИсправления");
	
	ИмяПроцедурыЗаполнения = "ЗаполнитьСведенияОДатеИНомереДокумента";
	
	Если ЭтоКорректировка Тогда
		
		Результат.Вставить("ДатаНомерДокументовОснований", Новый Массив);
		
		//Результат.Вставить("НомерИсходногоДокумента");
		//Результат.Вставить("ДатаИсходногоДокумента");
		//Результат.Вставить("НомерИсправленияИсходногоДокумента");
		//Результат.Вставить("ДатаИсправленияИсходногоДокумента");
		//Результат.Вставить("УчитыватьИсправлениеИсходногоДокумента", Ложь);
		
		ИмяПроцедурыЗаполнения = "ЗаполнитьСведенияОДатеИНомереКорректировочногоДокумента";
		
	КонецЕсли;
	
	МетодСервера(ИмяМодуляИнтеграции(), ИмяПроцедурыЗаполнения
		, Результат
		, ОписаниеДокумента
		, ЦифровойИндексОП);
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ДатаНомерДокументаОснования() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("НомерДокумента");
	Результат.Вставить("ДатаДокумента");
	Результат.Вставить("НомерИсправления");
	Результат.Вставить("ДатаИсправления");
	
	Результат.Вставить("НомерИсходногоДокумента");
	Результат.Вставить("ДатаИсходногоДокумента");
	Результат.Вставить("НомерИсправленияИсходногоДокумента");
	Результат.Вставить("ДатаИсправленияИсходногоДокумента");
	Результат.Вставить("УчитыватьИсправлениеИсходногоДокумента", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Дополняет номер документа и номер исходного документа (для корректировки) цифровым индексом обособленного подразделения
//
// Параметры:
//  ДатаНомер		 - Структура - см. метод ДатаНомерДокумента()
//  ЦифровойИндексОП - Число	 - цифровой индекс обособленного подразделения (может быть пустым)
//
Процедура ДополнитьНомерЦифровымИндексомОП(ДатаНомер, ЦифровойИндексОП) Экспорт
	
	Если Не ЗначениеЗаполнено(ЦифровойИндексОП) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонНомера = "%1/%2";
		
	ДатаНомер.НомерДокумента = СтрШаблон(ШаблонНомера, ДатаНомер.НомерДокумента, ЦифровойИндексОП);
	
	ДанныеОснований = СвойствоСтруктуры(ДатаНомер, "ДатаНомерДокументовОснований", Новый Массив);
	Для каждого НомераОснования Из ДанныеОснований Цикл
		Если ЗначениеЗаполнено(НомераОснования.НомерИсходногоДокумента) Тогда
			НомераОснования.НомерИсходногоДокумента = СтрШаблон(ШаблонНомера, НомераОснования.НомерИсходногоДокумента, ЦифровойИндексОП);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяМодуляИнтеграции()
	
	Результат = "Модуль_Интеграция" + ПараметрыКлиентСервер.МаркерКонфигурации;
	Возврат Результат;
	
КонецФункции

// Проверяет, что в интеграционном модуле используется "старый" алгоритм 
// получения данных табличной части.
// 
// Возвращаемое значение:
//  Булево - Истина, если для получения данных табличной части используется устаревший метод "ПолучитьДанныеТЧ".
//
Функция ИспользуетсяМетодПолучитьДанныеТЧ()
	
	Результат = Истина;
	
	ИдентификаторКонфигурации = ВРег(ПараметрыКлиентСервер.МаркерКонфигурации);
	
	Если ИдентификаторКонфигурации = "УНФ16" Тогда 
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает данные товарной части документа по "старому" алгоритму
// и преобразует их в соответствии с контрактом функции ДанныеТабличныхЧастей.
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки()
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. функцию ДанныеТабличныхЧастей()
//
Функция ПолучитьДанныеТЧ(Шапка)
	
	ПромежуточныйРезультат = МетодСервера(ИмяМодуляИнтеграции(), "ПолучитьДанныеТЧ", Шапка.ОписаниеДокумента.Ссылка);
	
	ОписаниеСтрокиТЧ = НоваяСтрокаТоварнойЧасти();
	Результат = Новый ТаблицаЗначений;
	
	Для Каждого Элемент Из ОписаниеСтрокиТЧ Цикл 
		Результат.Колонки.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Счетчик = 0;
	
	Для Каждого СтрокаИсточник Из ПромежуточныйРезультат Цикл 
		
		Счетчик = Счетчик + 1;
		
		СтрокаПриемник = Результат.Добавить();
		СтрокаПриемник.НомерСтроки = Счетчик;
		СтрокаПриемник.ИмяТабличнойЧасти = "Неопределено";
		
		СтрокаПриемник.Номенклатура = СтрокаИсточник.Номенклатура;
		СтрокаПриемник.Характеристика = СтрокаИсточник.Характеристика;
		СтрокаПриемник.Серия = СтрокаИсточник.Серия;
		СтрокаПриемник.ЕдиницаИзмерения = СтрокаИсточник.ЕдиницаИзмерения;
		
		СтрокаПриемник.НоменклатураКод = СтрокаИсточник.КодНоменклатуры;
		СтрокаПриемник.НоменклатураПредставление = СтрокаИсточник.НоменклатураПредставление;
		
		СтрокаПриемник.ВидУпаковки = СтрокаИсточник.ВидУпаковки;
		СтрокаПриемник.ЕдиницаИзмеренияКод = СтрокаИсточник.КодЕдиницыИзмерения;
		
		СтрокаПриемник.ПризнакТоварРаботаУслуга = СтрокаИсточник.ПризнакТоварРаботаУслуга;
		СтрокаПриемник.ЭтоУслуга = СтрокаИсточник.ЭтоУслуга;
		
		СтрокаПриемник.СтавкаНДС = СтрокаИсточник.СтавкаНДС;
		СтрокаПриемник.СтавкаНДСПредставление = ПредставлениеПрикладнойСтавкиНДС(СтрокаПриемник.СтавкаНДС);
		
		СтрокаПриемник.НомерГТД = СтрокаИсточник.НомерГТД;
		СтрокаПриемник.СтранаПроисхождения = СтрокаИсточник.СтранаПроисхождения;
		Если ЗначениеЗаполнено(СтрокаПриемник.СтранаПроисхождения) Тогда 
			СтрокаПриемник.СтранаПроисхожденияКод = СтрокаПриемник.СтранаПроисхождения.Код;
		КонецЕсли;
		
		СтрокаПриемник.Количество = СтрокаИсточник.Количество;
		СтрокаПриемник.КоличествоВОдномМесте = СтрокаИсточник.КоличествоВОдномМесте;
		СтрокаПриемник.КоличествоМест = СтрокаИсточник.КоличествоМест;
		СтрокаПриемник.Масса = СтрокаИсточник.Масса;
		
		СтрокаПриемник.СуммаНДС = СтрокаИсточник.СуммаНДС;
		Если Шапка.ЦенаВключаетНДС Тогда 
			СтрокаПриемник.СуммаСНДС = СтрокаИсточник.Сумма;
			СтрокаПриемник.Цена		 = СтрокаПриемник.СуммаСНДС / ?(ЗначениеЗаполнено(СтрокаПриемник.Количество), СтрокаПриемник.Количество, 1);
		Иначе
			СтрокаПриемник.СуммаСНДС = СтрокаИсточник.Сумма + СтрокаИсточник.СуммаНДС;
			СтрокаПриемник.Цена		 = СтрокаИсточник.Цена;
		КонецЕсли;
		СтрокаПриемник.Сумма = СтрокаПриемник.СуммаСНДС - СтрокаПриемник.СуммаНДС;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив имен табличных частей документа, содержащих его товарную часть.
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки
// 
// Возвращаемое значение:
//  Массив - содержит имена табличных частей с товарами, услугами, работами.
//
Функция ИменаТабличныхЧастейДокумента(Шапка)
	
	Результат			 = Новый Массив;
	СтандартнаяОбработка = Истина;
	
	СсылкаНаОбъект = Шапка.ОписаниеДокумента.Ссылка;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	ПриПолученииИменТабличныхЧастей(МетаданныеОбъекта, Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		ПолноеИмяДокумента = МетаданныеОбъекта.ПолноеИмя();
		
		ПроверяемыеИменаТЧ = Новый Массив;
		ПроверяемыеИменаТЧ.Добавить("Товары");
		ПроверяемыеИменаТЧ.Добавить("Услуги");
		ПроверяемыеИменаТЧ.Добавить("РаботыИУслуги");
		
		Для Каждого ИмяТЧ Из ПроверяемыеИменаТЧ Цикл 
			
			Если СуществуетОбъектМетаданных(ПолноеИмяДокумента + ".ТабличнаяЧасть." + ИмяТЧ) Тогда
				Результат.Добавить(ИмяТЧ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет существование объекта метаданных по его полному имени.
//
// Параметры:
//  ПолноеИмяОбъекта - Строка - полное имя объекта метаданных.
// 
// Возвращаемое значение:
//  Булево - Истина, если объект с заданным именем существует.
//
// Пример:
//   ЕстьКорректировкиРТУ	 = СуществуетОбъектМетаданных("Документ.КорректировкаРеализации");
//   ЕстьГрузооотправитель	 = СуществуетОбъектМетаданных("Документ.РеализацияТоваровУслуг.Реквизит.Грузоотправитель");
//   ЕстьРеквизитКодТНВЭД	 = СуществуетОбъектМетаданных("Документ.РасходнаяНакладная.ТабличнаяЧасть.Запасы.Реквизит.КодТНВЭД");
//
Функция СуществуетОбъектМетаданных(ПолноеИмяОбъекта)
	
	Возврат МетодСервера(, "СуществуетОбъектМетаданных", ПолноеИмяОбъекта);
	
КонецФункции

// Универсальный метод для получения данных табличной части документа.
//
// Параметры:
//  Шапка				 - Структура - см. функцию ДанныеШапки
//  ИмяТабличнойЧасти	 - Строка	 - имя табличной части.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит данные табличной части документа.
//
Функция ТабличнаяЧастьДокумента(Шапка, ИмяТабличнойЧасти)
	
	Реквизиты = НоваяСтрокаТоварнойЧасти();
	Реквизиты.ИмяТабличнойЧасти = СтрШаблон("""%1""", ИмяТабличнойЧасти);
	
	Реквизиты.НоменклатураПредставление = "Содержание";
	Реквизиты.ЭтоУслуга = "ЛОЖЬ";
	Реквизиты.ПризнакТоварРаботаУслуга = """Property""";
	
	ИмяКолонкиКодНоменклатуры = ИмяКолонкиКодТовара();
	Если ЗначениеЗаполнено(ИмяКолонкиКодНоменклатуры) Тогда 
		Реквизиты.НоменклатураКод = "Номенклатура." + ИмяКолонкиКодНоменклатуры;
	Иначе 
		Реквизиты.НоменклатураКод = """""";
	КонецЕсли;
	
	СсылкаНаОбъект = Шапка.ОписаниеДокумента.Ссылка;
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	
	ПараметрыЗапроса = Новый Структура;
	ПриПодготовкеЗапросаПоТоварнойЧастиДокумента(Шапка, ИмяТабличнойЧасти, Реквизиты, ПараметрыЗапроса);
	
	ЗаполнитьВыраженияПолейЗапроса(Реквизиты, МетаданныеТЧ);
	
	ТабличнаяЧасть = ЗначенияРеквизитовТабличнойЧасти(СсылкаНаОбъект, ИмяТабличнойЧасти, Реквизиты, ПараметрыЗапроса);
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

// Возвращает параметры учета номенклатуры в текущей информационной базе.
// 
// Возвращаемое значение:
//  ФикисированнаяСтруктура - содержит ключи:
//    * ИспользоватьХарактеристики - Булево - Истина, если используются характеристики номенклатуры
//    * ИспользоватьУпаковки - Булево - Истина, если используются упаковки номенклатуры
//    * ИспользоватьСерии - Булево - Истина, если используются серии номенклатуры
//
Функция ПараметрыУчетаНоменклатуры()
	
	СтандартнаяОбработка = Истина;
	
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("ИспользоватьХарактеристики", Ложь);
	ПараметрыНоменклатуры.Вставить("ИспользоватьСерии", Ложь);
	
	ПриЗаполненииПараметровУчетаНоменклатуры(ПараметрыНоменклатуры, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		Если Метаданные.Справочники.Найти("ХарактеристикиНоменклатуры") <> Неопределено Тогда
			ПараметрыНоменклатуры.ИспользоватьХарактеристики = Истина;
		КонецЕсли;
		
		Если Метаданные.Справочники.Найти("СерииНоменклатуры") <> Неопределено Тогда
			ПараметрыНоменклатуры.ИспользоватьСерии = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый ФиксированнаяСтруктура(ПараметрыНоменклатуры);
	
	Возврат Результат;
	
КонецФункции

