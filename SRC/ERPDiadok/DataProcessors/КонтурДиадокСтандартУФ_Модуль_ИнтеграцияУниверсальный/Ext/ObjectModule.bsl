#Область БиблиотекаИнтеграцииИСМП

// Заполняет в табличной части протоконтента сведения о маркировке с помощью библиотеки интеграции с ИС МП
//
// Параметры:
//  Контент - Структура - Протоконтент в формате приказа 820@.
//  СсылкаНаДокумент - ЛюбаяСсылка - Ссылка основание электронного документа.
//
Процедура ЗаполнитьСведенияОМаркировке820_ИСМП(Контент, СсылкаНаОбъект)
	
	Если НЕ ЕстьИнтеграцияИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
	ТаблицаУпаковок = ТаблицаУпаковокИСМП(ДокументыПередачи);
	
	Если Не ЗначениеЗаполнено(ТаблицаУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяИнтеграцияИСМП10127() Тогда
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок_ИСМП10127();
		ТаблицаТоваров = ТаблицаТоваровИСМП820(Контент.Table.Items);
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИКодыОСУИСМП(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте820_ИСМП10127(Контент, РазвернутаяТаблицаУпаковок);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИСМП(ТаблицаУпаковок);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		ЗаполнитьСведенияОМаркировкеВКонтенте820(Контент, РазвернутаяТаблицаУпаковок);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РазвернутаяТаблицаУпаковок) Тогда
		ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировке736_ИСМП(Контент, СсылкаНаОбъект, ИсходныйДокумент)
	
	Если НЕ ЕстьИнтеграцияИСМП() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
	ТаблицаУпаковок = ТаблицаУпаковокИСМП(ДокументыПередачи);
	
	Если ИспользуетсяИнтеграцияИСМП10127() Тогда
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок_ИСМП10127();
		РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок_ИСМП10127();
		ТаблицаТоваров = ТаблицаТоваровИСМП736(Контент.InvoiceCorrectionTable.Items, Ложь);
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИКодыОСУИСМП(ТаблицаУпаковок, ТаблицаТоваров, ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
			
			ИсходныеДокументыПередачи = ВладельцыКодовМаркировки(ИсходныйДокумент);
			ТаблицаУпаковокДоИзменения = ТаблицаУпаковокИСМП(ИсходныеДокументыПередачи);
			ИсходныйДокументПередачи = ?(ИсходныеДокументыПередачи.Количество(), ИсходныеДокументыПередачи[0], Неопределено);
			ТаблицаТоваровДоИзменения = ТаблицаТоваровИСМП736(
				Контент.InvoiceCorrectionTable.Items,
				Истина,
				ИсходныйДокументПередачи
			);
			ДанныеШтрихкодовУпаковокДоИзменения = ЧастичноеСодержимоеИКодыОСУИСМП(
				ТаблицаУпаковокДоИзменения,
				ТаблицаТоваровДоИзменения,
				ИсходныеДокументыПередачи
			);
			
			ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковокДоИзменения, ДанныеШтрихкодовУпаковокДоИзменения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736_ИСМП10127(
			Контент,
			ДокументыПередачи,
			РазвернутаяТаблицаУпаковок,
			РазвернутаяТаблицаУпаковокДоИзменения
		);
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
		РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок();
		ДанныеШтрихкодовУпаковок = ЧастичноеСодержимоеИСМП(ТаблицаУпаковок);
		
		ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковок, ДанныеШтрихкодовУпаковок);
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
			
			ИсходныеДокументыПередачи = ВладельцыКодовМаркировки(ИсходныйДокумент);
			ТаблицаУпаковокДоИзменения = ТаблицаУпаковокИСМП(ИсходныеДокументыПередачи);
			ДанныеШтрихкодовУпаковокДоИзменения = ЧастичноеСодержимоеИСМП(ТаблицаУпаковокДоИзменения);
			
			ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(РазвернутаяТаблицаУпаковокДоИзменения, ДанныеШтрихкодовУпаковокДоИзменения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736(Контент, СсылкаНаОбъект, РазвернутаяТаблицаУпаковок, РазвернутаяТаблицаУпаковокДоИзменения);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШтрихкодовУпаковок) Тогда
		ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
	КонецЕсли;
	
КонецПроцедуры

Функция ТаблицаТоваровИСМП820(СтрокиКонтента)
	
	Результат = НоваяТаблицаТоваровИСМП(СтрокиКонтента);
	
	Для Каждого СтрокаКонтента Из СтрокиКонтента Цикл
		
		СлужебнаяИнформацияСтрокиКонтента = СтрокаКонтента.СлужебнаяИнформация;
		
		СтрокаТаблицыТоваров = Результат.Добавить();
		СтрокаТаблицыТоваров.Номенклатура = СлужебнаяИнформацияСтрокиКонтента.Номенклатура;
		СтрокаТаблицыТоваров.Характеристика = СлужебнаяИнформацияСтрокиКонтента.Характеристика;
		СтрокаТаблицыТоваров.Ссылка = СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки;
		СтрокаТаблицыТоваров.Количество = СтрокаКонтента.Quantity;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаТоваровИСМП736(СтрокиКонтента, ИспользоватьКоличествоДоИзменения, ДокументОтгрузкиДоИзменения = Неопределено)
	
	Результат = НоваяТаблицаТоваровИСМП(СтрокиКонтента, ДокументОтгрузкиДоИзменения);
	
	Для Каждого СтрокаКонтента Из СтрокиКонтента Цикл
		
		СлужебнаяИнформацияСтрокиКонтента = СтрокаКонтента.СлужебнаяИнформация;
		
		СтрокаТаблицыТоваров = Результат.Добавить();
		СтрокаТаблицыТоваров.Номенклатура = СлужебнаяИнформацияСтрокиКонтента.Номенклатура;
		СтрокаТаблицыТоваров.Характеристика = СлужебнаяИнформацияСтрокиКонтента.Характеристика;
		
		Если ЗначениеЗаполнено(ДокументОтгрузкиДоИзменения) Тогда
			СтрокаТаблицыТоваров.Ссылка = ДокументОтгрузкиДоИзменения;
		Иначе
			СтрокаТаблицыТоваров.Ссылка = СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки;
		КонецЕсли;
		
		Если ИспользоватьКоличествоДоИзменения Тогда
			СтрокаТаблицыТоваров.Количество = СтрокаКонтента["OriginalValues"].Quantity;
		Иначе
			СтрокаТаблицыТоваров.Количество = СтрокаКонтента["CorrectedValues"].Quantity;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НоваяТаблицаТоваровИСМП(СтрокиКонтента, ДокументОтгрузкиДоИзменения = Неопределено)
	
	ОписаниеТипаНоменклатура = Новый ОписаниеТипов(Справочники.ТипВсеСсылки());
	ОписаниеТипаХарактеристика = Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатуры.Тип;
	ОписаниеТипаСсылка = Новый ОписаниеТипов(Документы.ТипВсеСсылки());
	
	Если СтрокиКонтента.Количество() Тогда
		
		СлужебнаяИнформацияСтрокиКонтента = СтрокиКонтента[0].СлужебнаяИнформация;
		
		Если ЗначениеЗаполнено(СлужебнаяИнформацияСтрокиКонтента.Номенклатура) Тогда
			ОписаниеТипаНоменклатура = ОписаниеТиповЗначения(СлужебнаяИнформацияСтрокиКонтента.Номенклатура);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СлужебнаяИнформацияСтрокиКонтента.Характеристика) Тогда
			ОписаниеТипаХарактеристика = ОписаниеТиповЗначения(СлужебнаяИнформацияСтрокиКонтента.Характеристика);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОтгрузкиДоИзменения) Тогда
			ОписаниеТипаСсылка = ОписаниеТиповЗначения(ДокументОтгрузкиДоИзменения);
		ИначеЕсли ЗначениеЗаполнено(СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки) Тогда
			ОписаниеТипаСсылка = ОписаниеТиповЗначения(СлужебнаяИнформацияСтрокиКонтента.ДокументОтгрузки);
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", ОписаниеТипаНоменклатура);
	Результат.Колонки.Добавить("Характеристика", ОписаниеТипаХарактеристика);
	Результат.Колонки.Добавить("Ссылка", ОписаниеТипаСсылка);
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Возврат Результат;
	
КонецФункции

// Проверяет, встроена ли в конфигурацию библиотека интеграции с ИС МП.
// 
// Возвращаемое значение:
//  Булево - Истина, если подсистема есть.
//
Функция ЕстьИнтеграцияИСМП()
	
	Результат = Ложь;
	
	ОписанияПодсистем = ОписанияПодсистемКонфигурации();
	Если ОписанияПодсистем.Получить("БиблиотекаИнтеграцииИСМП") <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, поддерживает-ли встроенная версия библиотеки интеграции с ИС МП распределение одного кода ОСУ по нескольким строкам
// 
// Возвращаемое значение:
//  Булево - Истина, если библиотека поддерживает функционал.
//
Функция ИспользуетсяИнтеграцияИСМП10127()
	
	Результат = Ложь;
	
	ОписанияПодсистем = ОписанияПодсистемКонфигурации();
	ОписаниеПодсистемыБиблиотекиИнтеграцииИСМП = ОписанияПодсистем.Получить("БиблиотекаИнтеграцииИСМП");
	
	Если СравнитьВерсии(ОписаниеПодсистемыБиблиотекиИнтеграцииИСМП.Версия, "10.1.27") >= 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяРасширеннаяВерсияГосИС()
	
	Результат = Ложь;
	
	Подсистема = "ГосИС.БазоваяФункциональность.Расширенная";
	
	Результат = ОбщегоНазначения.ПодсистемаСуществует(Подсистема);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, есть ли у объекта метаданных табличная часть с штрихкодами упаковок товаров.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - проверяемый объект метаданных.
// 
// Возвращаемое значение:
//  Булево - Истина, если у объекта есть табличная часть "ШтрихкодыУпаковок".
//
Функция ЕстьШтрихкодыУпаковокИСМП(ОбъектМетаданных)
	
	Результат = (ОбъектМетаданных.ТабличныеЧасти.Найти("ШтрихкодыУпаковок") <> Неопределено);
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу упаковок, сформированную по данным библиотеки интеграции с ИС МП.
//
// Параметры:
//  СсылкаИлиМассив - ЛюбаяСсылка, Массив - ссылки на документы, по которым необходимо получить таблицу упаковок
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица упаковок:
//   * Ссылка   - Произвольный - объект-владелец штрихкода
//   * Штрихкод - СправочникСсылка.ШтрихкодыУпаковокТоваров
//
Функция ТаблицаУпаковокИСМП(СсылкаИлиМассив)
	
	КоллекцияСсылок = ЗначениеВМассиве(СсылкаИлиМассив);
	
	ВладельцыШтрихкодов = Новый Массив;
	
	ТипыСсылок = Новый Соответствие;
	
	ТекстыЗапросов = Новый Массив;
	
	Для Каждого СсылкаНаОбъект Из КоллекцияСсылок Цикл
		
		Тип = ТипЗнч(СсылкаНаОбъект);
		
		Если ТипыСсылок[Тип] = Неопределено Тогда
			
			МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
			ЕстьШК = ЕстьШтрихкодыУпаковокИСМП(МетаданныеОбъекта);
			
			ТипыСсылок.Вставить(Тип, ЕстьШК);
			
			Если ЕстьШК Тогда
				ТекстЗапросаШК = ТекстЗапросаТаблицыУпаковокИСМП(МетаданныеОбъекта.ПолноеИмя());
				ТекстыЗапросов.Добавить(ТекстЗапросаШК);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипыСсылок[Тип] Тогда
			ВладельцыШтрихкодов.Добавить(СсылкаНаОбъект);
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ТекстыЗапросов) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = СтрСоединить(ТекстыЗапросов, РазделительОбъединенияЗапросов());
		Запрос.УстановитьПараметр("ВладельцыШтрихкодов", ВладельцыШтрихкодов);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
	Иначе
		
		КоллекцияТипов = Новый Массив;
		
		Для Каждого Элемент Из ТипыСсылок Цикл
			КоллекцияТипов.Добавить(Элемент.Ключ);
		КонецЦикла;
		
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить(
			"Ссылка",
			Новый ОписаниеТипов(КоллекцияТипов)
		);
		Результат.Колонки.Добавить(
			"Штрихкод",
			Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров")
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаТаблицыУпаковокИСМП(ПолноеИмяОбъекта)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Ссылка,
	|	ТЧ.ШтрихкодУпаковки КАК Штрихкод
	|ИЗ
	|	&ТЧШтрихкоды КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&ВладельцыШтрихкодов)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТЧШтрихкоды", ПолноеИмяОбъекта + ".ШтрихкодыУпаковок");
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Разворачивает таблицу транспортных и индивидуальных штрихкодов до номенклатуры, характеристики, серии
//   для дальнейшего сопоставления информации об упаковках с товарной частью.
//   Для транспортных упаковок номенклатура (характеристика, серия)- это номенклатура (характеристика, серия)
//   первого вложенного (на любом уровне) индивидуального штрихкода.
// 
// Параметры:
// 	ТаблицаУпаковок - ТаблицаЗначений - исходная таблица упаковок:
// 	 * Ссылка   - Произвольный - объект-владелец штрихкода
// 	 * Штрихкод - СправочникСсылка.ШтрихкодыУпаковокТоваров
// Возвращаемое значение - ТаблицаЗначений - таблица упаковок с товарными данными:
// 	 * Ссылка             - Произвольный - объект-владелец штрихкода - исходная колонка
// 	 * Штрихкод           - СправочникСсылка.ШтрихкодыУпаковокТоваров - ссылка на индивидуальный штрихкод содержимого
// 	 * Номенклатура       - ОпределяемыйТип.Номенклатура - содержимое
// 	 * Характеристика     - ОпределяемыйТип.ХарактеристикаНоменклатуры - содержимое
// 	 * Серия              - ОпределяемыйТип.СерияНоменклатуры - содержимое
// 	 * ЗначениеШтрихкода  - Строка - текстовое представление исходного штрихкода для передачи в ЭДО
// 	 * Обработан          - Булево - признак сопоставления строки товарной части документа
//
Функция ЧастичноеСодержимоеИСМП(ТаблицаУпаковок)
	
	МодульЭлектронноеВзаимодействиеИСМП = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеВзаимодействиеИСМП");
	Результат = МодульЭлектронноеВзаимодействиеИСМП.ЧастичноеСодержимое(ТаблицаУпаковок);
	
	Возврат Результат;
	
КонецФункции

// Разворачивает таблицу транспортных и индивидуальных штрихкодов до номенклатуры, характеристики, серии
//   для дальнейшего сопоставления информации об упаковках с товарной частью.
// Добавляет в таблицу коды ОСУ для строк, по которым коды маркировки не указывались. Считаем что таблица товаров
//   уже соответствует таблице штрихкодов упаковок (с учетом невнесенных ОСУ).
//
// Параметры:
// 	ТаблицаУпаковок - ТаблицаЗначений - исходная таблица упаковок:
// 	 * Ссылка   - Произвольный - объект-владелец штрихкода
// 	 * Штрихкод - СправочникСсылка.ШтрихкодыУпаковокТоваров - Штрихкод
//  ТаблицаТоваров	 - ТаблицаЗначений - исходная таблица товаров: 
// 	 * Ссылка         - Произвольный - объект-владелец штрихкода
// 	 * Номенклатура   - ОпределяемыйТип.Номенклатура - номенклатура
// 	 * Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатуры - характеристика
// 	 * Количество     - Число - количество
//  ПараметрыСканирования - См. ШтрихкодированиеИС.ПараметрыСканирования
// Возвращаемое значение:
//  ТаблицаЗначений - См. ЧастичноеСодержимое
//
Функция ЧастичноеСодержимоеИКодыОСУИСМП(ТаблицаУпаковок, ТаблицаТоваров, ДокументыОснования)
	
	Если ДокументыОснования.Количество() Тогда
		ДокументОснование = ДокументыОснования[0];
	ИначеЕсли ТаблицаТоваров.Количество() Тогда
		ДокументОснование = ТаблицаТоваров[0].Ссылка;
	КонецЕсли;
	
	Если ИспользуетсяРасширеннаяВерсияГосИС() Тогда
		МодульШтрихкодированиеИС = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеОбщегоНазначенияИС");
	Иначе
		МодульШтрихкодированиеИС = ОбщегоНазначения.ОбщийМодуль("ШтрихкодированиеИС");
	КонецЕсли;
	
	ПараметрыСканирования = МодульШтрихкодированиеИС.ПараметрыСканирования(ДокументОснование);
	МодульЭлектронноеВзаимодействиеИСМП = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеВзаимодействиеИСМП");
	
	Результат = МодульЭлектронноеВзаимодействиеИСМП.ЧастичноеСодержимоеИКодыОСУ(ТаблицаУпаковок
				,ТаблицаТоваров
				,ПараметрыСканирования);
	
	Возврат Результат;
	
КонецФункции

Функция НоваяРазвернутаяТаблицаУпаковок_ИСМП10127()
	
	Результат = НоваяРазвернутаяТаблицаУпаковок();
	
	Результат.Колонки.Добавить("КоличествоВПотребительскойУпаковке", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ШтрихКод");
	
	Возврат Результат;
	
КонецФункции

// Заполняет таблицу кодов средствами типовой библиотеки интеграции с ИС МП.
//
// Параметры:
//  Результат - ТаблицаЗначений - Заполняемая таблица (см. НоваяРазвернутаяТаблицаУпаковок)
//  СсылкаНаДокумент - ЛюбаяСсылка - объект-владелец штрихкода
//
Процедура ЗаполнитьРазвернутуюТаблицуКодов_ИСМП(Результат, ДанныеШтрихкодовУпаковок)
	
	ЕстьВидУпаковки = (ДанныеШтрихкодовУпаковок.Колонки.Найти("ВидУпаковки") <> Неопределено);
	ИсключаемыеСвойства = "";
	
	Если ЕстьВидУпаковки Тогда 
		ИсключаемыеСвойства = "ВидУпаковки";
	КонецЕсли;
	
	ПараметрыНоменклатуры = ПараметрыУчетаНоменклатуры();
	ПравилаКонвертацииУпаковок = ПравилаКонвертацииУпаковокИСМП();
	
	Для Каждого УпаковкаИСМП Из ДанныеШтрихкодовУпаковок Цикл
		
		ВидУпаковкиИСМП = Неопределено;
		Если ЕстьВидУпаковки Тогда
			ВидУпаковкиИСМП = УпаковкаИСМП.ВидУпаковки;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, УпаковкаИСМП, , ИсключаемыеСвойства);
		НоваяСтрока.ВидУпаковки = ВидУпаковкиПоДаннымИСМП(ВидУпаковкиИСМП, ПравилаКонвертацииУпаковок);
		НоваяСтрока.ИспользоватьХарактеристики = ПараметрыНоменклатуры.ИспользоватьХарактеристики;
		НоваяСтрока.ИспользоватьСерии = ПараметрыНоменклатуры.ИспользоватьСерии;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте820_ИСМП10127(Контент, РазвернутаяТаблицаУпаковок)
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		ТребуемоеКоличество = СтрокаТЧ.Quantity;
		
		Если Не ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			Продолжить;
		КонецЕсли;
		
		// Инициализировать промежуточную структуру с коллекциями кодов маркировки
		КодыМаркировки = НовыйСведенияОМаркировке();
		
		// Найти подходящие кодами маркировки
		ПодобратьКодыМаркировки_ИСМП10127(КодыМаркировки, РазвернутаяТаблицаУпаковок, СтрокаТЧ.СлужебнаяИнформация, ТребуемоеКоличество);
		
		// Перенести найденные коды маркировки в строку протоконтента
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.ItemIdentificationNumbers, КодыМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодобратьКодыМаркировки_ИСМП10127(КодыМаркировки, РазвернутаяТаблицаУпаковок, СлужебнаяИнформация, ТребуемоеКоличество)
	
	Для Каждого СтрокаУпаковки Из РазвернутаяТаблицаУпаковок Цикл
		
		Если СтрокаУпаковки.Обработан Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.Номенклатура <> СлужебнаяИнформация.Номенклатура Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.ИспользоватьХарактеристики
			И СтрокаУпаковки.Характеристика <> СлужебнаяИнформация.Характеристика Тогда
			Продолжить;
		КонецЕсли;
		
		ВидУпаковки = СтрокаУпаковки.ВидУпаковки;
		
		Если (ВидУпаковки <> УпаковкаОбъемноСортовойУчет() ИЛИ ЗначениеЗаполнено(СтрокаУпаковки.Штрихкод))
			И СтрокаУпаковки.ИспользоватьСерии
			И ЗначениеЗаполнено(СлужебнаяИнформация.Серия)
			И СтрокаУпаковки.Серия <> СлужебнаяИнформация.Серия Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеШК = СтрокаУпаковки.ЗначениеШтрихкода;
		
		Если ЗначениеЗаполнено(ЗначениеШК) Тогда
			
			Если ВидУпаковки = УпаковкаЛогистическая() Тогда
				КодыМаркировки.ТранспортныеУпаковки.Добавить(ЗначениеШК);
			ИначеЕсли ВидУпаковки = УпаковкаГрупповая() Тогда
				КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет() Тогда
				
				Если ЗначениеЗаполнено(СтрокаУпаковки.Штрихкод) Тогда
					КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
				Иначе
					Если ТребуемоеКоличество > 0 Тогда
						ЗначениеШК = СформироватьКодОСУИзGTIN(ТребуемоеКоличество, СтрокаУпаковки);
						КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
					КонецЕсли;
					
					Прервать;
				КонецЕсли;
				
			Иначе
				КодыМаркировки.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаУпаковки.Обработан = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте736_ИСМП10127(
	Контент,
	ДокументыПередачи,
	РазвернутаяТаблицаУпаковок,
	РазвернутаяТаблицаУпаковокДоИзменения
	)
	
	ЭтоУКД_НаОснованииВозвратаОтКлиента = СредиВладельцевКодовМаркировкиТолькоВозвратыОтКлиента(ДокументыПередачи);
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
						
		//OriginalValues
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity;
		ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
		
		// Инициализировать промежуточную структуру с коллекциями кодов маркировки
		КодыМаркировки = НовыйСведенияОМаркировке();
		
		// Найти подходящие кодами маркировки
		ПодобратьКодыМаркировки_ИСМП10127(КодыМаркировки
			, РазвернутаяТаблицаУпаковокДоИзменения
			, СтрокаТЧ.СлужебнаяИнформация
			, ТребуемоеКоличество
		);
		
		// Перенести найденные коды маркировки в строку протоконтента
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
		
		ЭтоПолныйВозвратТовара = ЭтоПолныйВозвратТовара(СтрокаТЧ);
		Если ЭтоПолныйВозвратТовара Тогда
			Продолжить;
		КонецЕсли;
			
		//CorrectedValues
		Если ЭтоУКД_НаОснованииВозвратаОтКлиента Тогда
			
			ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента_ИСМП10127(
				СтрокаТЧ, 
				РазвернутаяТаблицаУпаковок,
				РазвернутаяТаблицаУпаковокДоИзменения
			);
			
		Иначе
			
			ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
			ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
			
			// Инициализировать промежуточную структуру с коллекциями кодов маркировки
			КодыМаркировки = НовыйСведенияОМаркировке();
			
			// Найти подходящие кодами маркировки
			ПодобратьКодыМаркировки_ИСМП10127(КодыМаркировки
				, РазвернутаяТаблицаУпаковок
				, СтрокаТЧ.СлужебнаяИнформация
				, ТребуемоеКоличество
			);
			
			// Перенести найденные коды маркировки в строку протоконтента
			ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует правила преобразования видов упаковок подсистемы ИСМП во внутреннее представление,
// которое используется для заполнения развернутой таблицы упаковок.
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - ПеречислениеСсылка.ВидыУпаковокИС - вид упаковки в формате ИСМП.
//   * Значение - Строка - Внутреннее представление вида упаковки.
//
Функция ПравилаКонвертацииУпаковокИСМП()
	
	Результат = Новый Соответствие;

	МетаданныеВидыУпаковокИС = Метаданные.Перечисления.Найти("ВидыУпаковокИС");
	Если МетаданныеВидыУпаковокИС <> Неопределено Тогда
		
		ВидыУпаковокИСМП = Перечисления.ВидыУпаковокИС;
		
		Результат.Вставить(ВидыУпаковокИСМП.Групповая, УпаковкаГрупповая());
		Результат.Вставить(ВидыУпаковокИСМП.Логистическая, УпаковкаЛогистическая());
		Результат.Вставить(ВидыУпаковокИСМП.Потребительская, УпаковкаПотребительская()); 
		
		ЕстьОбъемноСортовойУчет = МетаданныеВидыУпаковокИС.ЗначенияПеречисления.Найти("ОбъемноСортовойУчет") <> Неопределено;
		Если ЕстьОбъемноСортовойУчет Тогда
			Результат.Вставить(ВидыУпаковокИСМП.ОбъемноСортовойУчет, УпаковкаОбъемноСортовойУчет());
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразовывает вид упаковки подсистемы ИСМП во внутренее представление.
//
// Параметры:
//  ВидУпаковкиИСМП - ПеречислениеСсылка.ВидыУпаковокИС - вид упаковки в формате ИСМП.
//  ПравилаКонвертацииУпаковок - Соответствие - (Необязательный) правила преобразования (см. ПравилаКонвертацииУпаковокИСМП)
// 
// Возвращаемое значение:
//  Строка - Возможные значения описаны функциями УпаковкаПотребительская(), УпаковкаЛогистическая() и УпаковкаГрупповая()
//
Функция ВидУпаковкиПоДаннымИСМП(ВидУпаковкиИСМП, ПравилаКонвертацииУпаковок = Неопределено)
	
	Если ПравилаКонвертацииУпаковок = Неопределено Тогда
		ПравилаКонвертацииУпаковок = ПравилаКонвертацииУпаковокИСМП();
	КонецЕсли;
	
	ЗначениеПоУмолчанию = УпаковкаПотребительская();
	
	Результат = ПравилаКонвертацииУпаковок.Получить(ВидУпаковкиИСМП);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область КонтурМаркировка

// Заполняет в табличной части протоконтента сведения о маркировке с помощью подсистемы "Контур.Маркировка"
//
// Параметры:
//  Контент - Структура - Протоконтент в формате приказа 820@.
//  СсылкаНаДокумент - ЛюбаяСсылка - Ссылка основание электронного документа.
//
Процедура ЗаполнитьСведенияОМаркировке820_КонтурМаркировка(Контент, СсылкаНаОбъект)
	
	ПроверитьПодсистемуКонтурМаркировка();
	
	Если ИспользуетсяКонтурМаркировка33() Тогда
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок_КонтурМаркировка33();
		ОшибкиЗаполнения = Новый Массив;
		
		ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтента(РазвернутаяТаблицаУпаковок, Контент);
		ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка33(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		ЗаполнитьСведенияОМаркировкеВКонтенте820_КонтурМаркировка33(Контент, РазвернутаяТаблицаУпаковок);
		
		Если ЕстьМаркируемаяПродукция_КонтурМаркировка33(РазвернутаяТаблицаУпаковок) Тогда
			ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
		КонецЕсли;
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
		ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
		ОшибкиЗаполнения = Новый Массив;
		
		ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка(РазвернутаяТаблицаУпаковок, ДокументыПередачи, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		ЗаполнитьСведенияОМаркировкеВКонтенте820(Контент, РазвернутаяТаблицаУпаковок);
		
		Если ЗначениеЗаполнено(РазвернутаяТаблицаУпаковок) Тогда
			ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировке736_КонтурМаркировка(Контент, СсылкаНаОбъект, ИсходныйДокумент)
	
	ПроверитьПодсистемуКонтурМаркировка();
	
	// Получим товарные документы отгрузки до корректировки, если таких документов больше 1,
	// то не будем использовать новый метод маркировки, так как не сможем корректно получить коды по нескольким документам
	Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
		ИсходныеДокументыПередачи = ВладельцыКодовМаркировки(ИсходныйДокумент);
	Иначе
		ИсходныеДокументыПередачи = Новый Массив;
	КонецЕсли;
	
	ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
	
	НесколькоДокументовПередачи = 2;
	
	Если ИспользуетсяКонтурМаркировка310()
		И ИсходныеДокументыПередачи.Количество() < НесколькоДокументовПередачи Тогда
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок_КонтурМаркировка33();
		РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок_КонтурМаркировка33();
		ОшибкиЗаполнения = Новый Массив;
		
		ЭтоУКДНаОснованииВозвратаОтКлиента = СредиВладельцевКодовМаркировкиТолькоВозвратыОтКлиента(ДокументыПередачи);
		
		ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтентаУКД736(
			РазвернутаяТаблицаУпаковок,
			Контент,
			Неопределено,
			ЭтоУКДНаОснованииВозвратаОтКлиента
		);
		ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка33(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		Если ИсходныеДокументыПередачи.Количество() > 0 Тогда
			
			ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтентаУКД736(
				РазвернутаяТаблицаУпаковокДоИзменения,
				Контент,
				ИсходныеДокументыПередачи[0],
				Ложь
			);
			ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка33(РазвернутаяТаблицаУпаковокДоИзменения, ОшибкиЗаполнения);
			ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736_КонтурМаркировка33(
			Контент,
			РазвернутаяТаблицаУпаковок,
			РазвернутаяТаблицаУпаковокДоИзменения,
			ЭтоУКДНаОснованииВозвратаОтКлиента
		);
		
		Если ЕстьМаркируемаяПродукция_КонтурМаркировка33(РазвернутаяТаблицаУпаковок) Тогда
			ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
		КонецЕсли;
		
	Иначе
		
		РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
		РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок();
		ОшибкиЗаполнения = Новый Массив;
		
		ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка(РазвернутаяТаблицаУпаковок, ДокументыПередачи, ОшибкиЗаполнения);
		ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
		
		Если ИсходныеДокументыПередачи.Количество() > 0 Тогда
			
			ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка(
				РазвернутаяТаблицаУпаковокДоИзменения,
				ИсходныеДокументыПередачи,
				ОшибкиЗаполнения
			);
			ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, ОшибкиЗаполнения);
			
		КонецЕсли;
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736_КонтурМаркировка(
			Контент,
			ДокументыПередачи,
			РазвернутаяТаблицаУпаковок,
			РазвернутаяТаблицаУпаковокДоИзменения
		);
		
		Если ЗначениеЗаполнено(РазвернутаяТаблицаУпаковок) Тогда
			ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте736_КонтурМаркировка(
	Контент,
	ДокументыПередачи,
	РазвернутаяТаблицаУпаковок,
	РазвернутаяТаблицаУпаковокДоИзменения
	)
	
	ЭтоУКД_НаОснованииВозвратаОтКлиента = СредиВладельцевКодовМаркировкиТолькоВозвратыОтКлиента(ДокументыПередачи);
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
						
		//OriginalValues
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity;
		
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			// Инициализировать промежуточную структуру с коллекциями кодов маркировки
			КодыМаркировки = НовыйСведенияОМаркировке();
			
			// Найти подходящие кодами маркировки
			ПодобратьКодыМаркировки(КодыМаркировки
				, РазвернутаяТаблицаУпаковокДоИзменения
				, СтрокаТЧ.СлужебнаяИнформация
				, ТребуемоеКоличество
			);
			
			// Перенести найденные коды маркировки в строку протоконтента
			ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
		ЭтоПолныйВозвратТовара = ЭтоПолныйВозвратТовара(СтрокаТЧ);
		
		//CorrectedValues
		Если ЭтоУКД_НаОснованииВозвратаОтКлиента Тогда
			
			Если ЭтоПолныйВозвратТовара Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента(
				СтрокаТЧ, 
				РазвернутаяТаблицаУпаковок, 
				РазвернутаяТаблицаУпаковокДоИзменения
			);
			
		Иначе
			
			ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
			ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
			
			Если ЗначениеЗаполнено(ТребуемоеКоличество) ИЛИ ЭтоПолныйВозвратТовара Тогда
			
				// Инициализировать промежуточную структуру с коллекциями кодов маркировки
				КодыМаркировки = НовыйСведенияОМаркировке();
				
				// Найти подходящие кодами маркировки
				ПодобратьКодыМаркировки(КодыМаркировки
					, РазвернутаяТаблицаУпаковок
					, СтрокаТЧ.СлужебнаяИнформация
					, ТребуемоеКоличество
					, ЭтоПолныйВозвратТовара
				);
				
				// Перенести найденные коды маркировки в строку протоконтента
				ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте736_КонтурМаркировка33(
		Контент,
		РазвернутаяТаблицаУпаковок,
		РазвернутаяТаблицаУпаковокДоИзменения,
		ЭтоУКДНаОснованииВозвратаОтКлиента
	)
	
	НомерСтроки = 1;
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Найти(НомерСтроки, "ИндексСтроки");
		
		Если СтрокаТаблицыУпаковок <> Неопределено Тогда
			СведенияОМаркировке = СтрокаТаблицыУпаковок.СведенияОМаркировке;
		Иначе
			СведенияОМаркировке = Неопределено;
		КонецЕсли;
		
		СтрокаТаблицыУпаковокДоИзменения = РазвернутаяТаблицаУпаковокДоИзменения.Найти(НомерСтроки, "ИндексСтроки");
		
		Если СтрокаТаблицыУпаковокДоИзменения <> Неопределено Тогда
			СведенияОМаркировкеДоИзменения = СтрокаТаблицыУпаковокДоИзменения.СведенияОМаркировке;
		Иначе
			СведенияОМаркировкеДоИзменения = Неопределено;
		КонецЕсли;
		
		Если ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			СведенияОМаркировкеПослеИзменения = СведенияОМаркировкеПередаваемыеПослеВозврата(
				СведенияОМаркировке,
				СведенияОМаркировкеДоИзменения
			);
		Иначе
			СведенияОМаркировкеПослеИзменения = СведенияОМаркировке;
		КонецЕсли;
		
		КодыМаркировки = КодыМаркировкиДляКонтентаПоДаннымКонтурМаркировки33(СведенияОМаркировкеПослеИзменения);
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
		
		Если ЗначениеЗаполнено(КодыМаркировки.НомерПартии) Тогда
			ДополнитьМассивKeyValue(СтрокаТЧ.StructedAdditionalInfos, "ПрПартМаркПосле", КодыМаркировки.НомерПартии);
		КонецЕсли;
		
		КодыМаркировкиДоИзменения = КодыМаркировкиДляКонтентаПоДаннымКонтурМаркировки33(СведенияОМаркировкеДоИзменения);
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировкиДоИзменения);
		
		Если ЗначениеЗаполнено(КодыМаркировкиДоИзменения.НомерПартии) Тогда
			ДополнитьМассивKeyValue(СтрокаТЧ.StructedAdditionalInfos, "ПрПартМаркДо", КодыМаркировкиДоИзменения.НомерПартии);
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что подсистема Контур.Маркировка подключена.
// 
// Возвращаемое значение:
//  Булево - Истина, если подсистема подключена.
//
Функция ЕстьИнтеграцияКонтурМаркировка()
	
	Результат = Метаданные.Подсистемы.Найти("КонтурМаркировка") <> Неопределено
		И Метаданные.ОбщиеМодули.Найти("ВзаимодействиеКонтурМаркировка") <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что подсистема "Контур.Маркировка" установлена.
// Если подсистема не установлена, записывает ошибку в журнал
// и генерирует исключение.
//
Процедура ПроверитьПодсистемуКонтурМаркировка()
	
	Если ЕстьИнтеграцияКонтурМаркировка() Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "Подсистема ""Контур.Маркировка"" не подключена!";
	
	ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации()
		, УровеньЖурналаРегистрации.Ошибка
		,
		,
		, ТекстОшибки);
	
	ВызватьИсключение ТекстОшибки;
	
КонецПроцедуры

Функция ИспользуетсяКонтурМаркировка33()
	
	Результат = Истина;
	НеобходимаяВерсияМодуляМаркировки = "3.3.0";
	
	Попытка
		ВерсияМодуляМаркировки = Вычислить("ВзаимодействиеКонтурМаркировка.ВерсияМодуля()");
	Исключение
		ВерсияМодуляМаркировки = "0.0.0";
	КонецПопытки;
	
	Результат = СравнитьВерсии(ВерсияМодуляМаркировки, НеобходимаяВерсияМодуляМаркировки) >= 0;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяКонтурМаркировка310()
	
	// В версии 3.10 в маркировке исправлена ошибка деления на 0 при полном возврате кодов ОСУ
	
	Результат = Истина;
	НеобходимаяВерсияМодуляМаркировки = "3.10.0";
	
	Попытка
		ВерсияМодуляМаркировки = Вычислить("ВзаимодействиеКонтурМаркировка.ВерсияМодуля()");
	Исключение
		ВерсияМодуляМаркировки = "0.0.0";
	КонецПопытки;
	
	Результат = СравнитьВерсии(ВерсияМодуляМаркировки, НеобходимаяВерсияМодуляМаркировки) >= 0;
	
	Возврат Результат;
	
КонецФункции

// Получает таблицу упаковок, развернутую по номенклатуре, из подсистемы Контур.Маркировка.
// Аналог функции ЧастичноеСодержимоеИСМП.
//
// Параметры:
//  ДокументыПередачи - Массив - коллекция объектов-владельцев кодов.
//  ОшибкиЗаполнения - Массив - (Необязательный) Коллекция ошибок получения кодов (возвращаемый параметр).
// 
// Возвращаемое значение:
//  ТаблицаЗначений.
//
Функция РазвернутаяТаблицаУпаковокКонтурМаркировка(ДокументыПередачи, ОшибкиЗаполнения)
	
	МодульВзаимодействиеКонтурМаркировка = ОбщегоНазначения.ОбщийМодуль("ВзаимодействиеКонтурМаркировка");
	
	Результат = МодульВзаимодействиеКонтурМаркировка.РазвернутаяТаблицаУпаковок(ДокументыПередачи, ОшибкиЗаполнения);
	
	Возврат Результат;
	
КонецФункции

// Заполняет таблицу кодов по данным подсистемы Контур.Маркировка
//
// Параметры:
//  Результат - ТаблицаЗначений - Заполняемая таблица (см. НоваяРазвернутаяТаблицаУпаковок)
//  ДокументыПередачи - Массив - коллекция объектов-владельцев штрихкодов
//  ОшибкиЗаполнения - Массив - (Необязательный) Коллекция ошибок получения кодов (возвращаемый параметр).
//
Процедура ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка(Результат, ДокументыПередачи, ОшибкиЗаполнения)
	
	ДанныеШтрихкодовУпаковок = РазвернутаяТаблицаУпаковокКонтурМаркировка(ДокументыПередачи, ОшибкиЗаполнения);
	
	Если Не ЗначениеЗаполнено(ДанныеШтрихкодовУпаковок) Тогда
		Возврат;
	КонецЕсли;
	
	КолонкиШтрихкодов = ДанныеШтрихкодовУпаковок.Колонки;
	ЕстьПараметрыНоменклатуры = (КолонкиШтрихкодов.Найти("ИспользоватьХарактеристики") <> Неопределено);
	ПараметрыНоменклатурыПоУмолчанию = ПараметрыУчетаНоменклатуры();
	ПравилаКонвертацииУпаковок = ПравилаКонвертацииУпаковокКонтурМаркировка();
	
	Для Каждого УпаковкаКМ Из ДанныеШтрихкодовУпаковок Цикл
		
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, УпаковкаКМ);
		
		НоваяСтрока.ВидУпаковки = ВидУпаковкиПоДаннымКонтурМаркировка(УпаковкаКМ.ВидУпаковки, ПравилаКонвертацииУпаковок);
		
		Если Не ЕстьПараметрыНоменклатуры Тогда
			НоваяСтрока.ИспользоватьХарактеристики = ПараметрыНоменклатурыПоУмолчанию.ИспользоватьХарактеристики;
			НоваяСтрока.ИспользоватьСерии = ПараметрыНоменклатурыПоУмолчанию.ИспользоватьСерии;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяРазвернутаяТаблицаУпаковок_КонтурМаркировка33()
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипЧисло5 = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0));
	ТипЧисло15_3 = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 3));
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИндексСтроки", ТипЧисло5);
	Результат.Колонки.Добавить("Количество", ТипЧисло15_3);
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Серия");
	Результат.Колонки.Добавить("Упаковка");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("ПервичныйДокумент");
	Результат.Колонки.Добавить("СведенияОМаркировке");
	Результат.Колонки.Добавить("КодТоварнойГруппы", ТипЧисло);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтента(РазвернутаяТаблицаУпаковок, Контент)
	
	НомерСтроки = 1;
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		СлужебнаяИнформацияСтрокиТЧ = СтрокаТЧ.СлужебнаяИнформация;
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыУпаковок, СлужебнаяИнформацияСтрокиТЧ);
		
		СтрокаТаблицыУпаковок.ИндексСтроки = НомерСтроки;
		СтрокаТаблицыУпаковок.Количество = СтрокаТЧ.Quantity;
		СтрокаТаблицыУпаковок.ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРазвернутуюТаблицуУпаковокИзКонтентаУКД736(
	РазвернутаяТаблицаУпаковок,
	Контент,
	ИсходныйДокумент,
	ЭтоУКДНаОснованииВозвратаОтКлиента)
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		СлужебнаяИнформацияСтрокиТЧ = СтрокаТЧ.СлужебнаяИнформация;
		
		Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда
			КоличествоПоСтроке = ПривестиКЧислу(СтрокаТЧ["OriginalValues"].Quantity);
			ПервичныйДокумент = ИсходныйДокумент;
		ИначеЕсли ЭтоУКДНаОснованииВозвратаОтКлиента Тогда
			КоличествоПоСтроке = ПривестиКЧислу(СтрокаТЧ["OriginalValues"].Quantity)
				- ПривестиКЧислу(СтрокаТЧ["CorrectedValues"].Quantity);
			ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		Иначе
			КоличествоПоСтроке = ПривестиКЧислу(СтрокаТЧ["CorrectedValues"].Quantity);
			ПервичныйДокумент = СлужебнаяИнформацияСтрокиТЧ.ДокументОтгрузки;
		КонецЕсли;
		
		Если КоличествоПоСтроке = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыУпаковок = РазвернутаяТаблицаУпаковок.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыУпаковок, СлужебнаяИнформацияСтрокиТЧ);
		
		СтрокаТаблицыУпаковок.ИндексСтроки = НомерСтроки;
		СтрокаТаблицыУпаковок.Количество = КоличествоПоСтроке;
		СтрокаТаблицыУпаковок.ПервичныйДокумент = ПервичныйДокумент;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРазвернутуюТаблицуКодов_КонтурМаркировка33(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения)
	
	МодульВзаимодействиеКонтурМаркировка = ОбщегоНазначения.ОбщийМодуль("ВзаимодействиеКонтурМаркировка");
	
	МодульВзаимодействиеКонтурМаркировка.ЗаполнитьСведенияОМаркировке(РазвернутаяТаблицаУпаковок, ОшибкиЗаполнения);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте820_КонтурМаркировка33(Контент, РазвернутаяТаблицаУпаковок)
	
	ВидыУпаковокКМ = Перечисления.КонтурМаркировка_ВидыУпаковок;
	УпаковкаГрупповая = ВидыУпаковокКМ.Групповая;
	УпаковкаЛогистическая = ВидыУпаковокКМ.Логистическая;
	УпаковкаОбъемноСортовойУчет = ВидыУпаковокКМ.ОбъемноСортовойУчет;
	
	НомерСтроки = 1;
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		СтрокаТаблицы = РазвернутаяТаблицаУпаковок.Найти(НомерСтроки, "ИндексСтроки");
		СведенияОМаркировке = СтрокаТаблицы.СведенияОМаркировке; // ЗначениеШтрихкода - Строка, ВидУпаковки - Перечисления.КонтурМаркировка_ВидыУпаковок, GTIN - Строка, Количество - Число
		
		КодыМаркировки = НовыйСведенияОМаркировке();
		
		Для Каждого СведенияОКоде Из СведенияОМаркировке Цикл
			
			ВидУпаковки = СведенияОКоде.ВидУпаковки;
			ЗначениеШК = СведенияОКоде.ЗначениеШтрихкода;
			
			Если ВидУпаковки = УпаковкаЛогистическая Тогда
				
				КодыМаркировки.ТранспортныеУпаковки.Добавить(ЗначениеШК);
				
			ИначеЕсли ВидУпаковки = УпаковкаГрупповая Тогда
				
				КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
				
			ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет Тогда
				
				ЗначениеШК = СформироватьКодОСУ_КонтурМаркировка33(СведенияОКоде);
				КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
				
			Иначе
				КодыМаркировки.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.ItemIdentificationNumbers, КодыМаркировки);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СведенияОМаркировкеПередаваемыеПослеВозврата(СведенияОМаркировке, СведенияОМаркировкеДоИзменения)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(СведенияОМаркировкеДоИзменения) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат СведенияОМаркировкеДоИзменения;
	КонецЕсли;
	
	// Коды ОСУ не совпадают из-за количества в самом коде ОСУ
	// так же СведенияОМаркировке содержит только одну строку
	СтрокаМаркировки = СведенияОМаркировке[0];
	
	ЭтоКодОСУ = СтрокаМаркировки.ВидУпаковки = Перечисления.КонтурМаркировка_ВидыУпаковок.ОбъемноСортовойУчет;
	
	Если ЭтоКодОСУ Тогда
		
		СтрокаМаркировкиДоИзменения = СведенияОМаркировкеДоИзменения[0];
		
		СтрокаМаркировки.Количество = СтрокаМаркировкиДоИзменения.Количество - СтрокаМаркировки.Количество;
		
		Результат = СведенияОМаркировке;
		
	Иначе
		
		ВозвращенныеКоды = Новый СписокЗначений;
		ВозвращенныеКоды.ЗагрузитьЗначения(СведенияОМаркировке.ВыгрузитьКолонку("ЗначениеШтрихкода"));
		
		ПостроительЗапроса = Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(СведенияОМаркировкеДоИзменения);
		
		НовыйОтбор = ПостроительЗапроса.Отбор.Добавить("ЗначениеШтрихкода");
		НовыйОтбор.Использование = Истина;
		НовыйОтбор.ВидСравнения = ВидСравнения.НеВСписке;
		НовыйОтбор.Значение = ВозвращенныеКоды;
		
		Результат = ПостроительЗапроса.Результат.Выгрузить();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодыМаркировкиДляКонтентаПоДаннымКонтурМаркировки33(СведенияОМаркировке)
	
	Результат = НовыйСведенияОМаркировке();
	
	Если НЕ ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВидыУпаковокКМ = Перечисления.КонтурМаркировка_ВидыУпаковок;
	УпаковкаГрупповая = ВидыУпаковокКМ.Групповая;
	УпаковкаЛогистическая = ВидыУпаковокКМ.Логистическая;
	УпаковкаОбъемноСортовойУчет = ВидыУпаковокКМ.ОбъемноСортовойУчет;
	
	ЕстьИнформацияПоПартиям = Неопределено;
	
	Для Каждого СведенияОКоде Из СведенияОМаркировке Цикл
		
		ВидУпаковки = СведенияОКоде.ВидУпаковки;
		ЗначениеШК = СведенияОКоде.ЗначениеШтрихкода;
		
		Если ВидУпаковки = УпаковкаЛогистическая Тогда
			
			Результат.ТранспортныеУпаковки.Добавить(ЗначениеШК);
			
		ИначеЕсли ВидУпаковки = УпаковкаГрупповая Тогда
			
			Результат.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			
		ИначеЕсли ВидУпаковки = УпаковкаОбъемноСортовойУчет Тогда
			
			ЗначениеШК = СформироватьКодОСУ_КонтурМаркировка33(СведенияОКоде);
			Результат.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			
			Если ЕстьИнформацияПоПартиям = Неопределено Тогда
				ЕстьИнформацияПоПартиям = НЕ СведенияОМаркировке.Колонки.Найти("НомерПартии") = Неопределено;
			КонецЕсли;
			
			Если ЕстьИнформацияПоПартиям Тогда
				Результат.НомерПартии = СведенияОКоде.НомерПартии;
			КонецЕсли;
			
		Иначе
			Результат.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьКодОСУ_КонтурМаркировка33(СведенияОКоде)
	
	Результат = СтрШаблон("%1%2%3%4",
		"02",
		СведенияОКоде.GTIN,
		"37",
		Формат(СведенияОКоде.Количество, "ЧДЦ=0; ЧН=0; ЧГ=;"));
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьМаркируемаяПродукция_КонтурМаркировка33(РазвернутаяТаблицаУпаковок)
	
	Результат = Ложь;
	
	ТипТаблицаЗначений = Тип("ТаблицаЗначений");
	
	Для Каждого СтрокаТаблицыУпаковок Из РазвернутаяТаблицаУпаковок Цикл
		
		СведенияОМаркировке = СтрокаТаблицыУпаковок.СведенияОМаркировке;
		
		Если ТипЗнч(СведенияОМаркировке) = ТипТаблицаЗначений
			И СведенияОМаркировке.Количество() > 0 Тогда
			
			Результат = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьОшибкиПолученияКодовКонтурМаркировка(Контент, КоллекцияОшибок)
	
	Если Не ЗначениеЗаполнено(КоллекцияОшибок) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Ошибка Из КоллекцияОшибок Цикл
		
		ТекстОшибки = "<Контур.Маркировка> " + Ошибка.ТекстОшибки;
		СсылкаНаОбъект = Ошибка.ДокументМаркировки;
		
		МетодСервера(, "ДобавитьОшибкуВалидации"
			, Контент.ОшибкиВДанных
			, ТекстОшибки
			, СсылкаНаОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует правила преобразования видов упаковок подсистемы КонтурМаркировка во внутреннее представление,
// которое используется для заполнения развернутой таблицы упаковок.
// 
// Возвращаемое значение:
//  Соответствие:
//   * Ключ - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки в формате КонтурМаркировка.
//   * Значение - Строка - Внутреннее представление вида упаковки.
//
Функция ПравилаКонвертацииУпаковокКонтурМаркировка()
	
	Результат = Новый Соответствие;

	МетаданныеВидыУпаковокКонтурМаркировка = Метаданные.Перечисления.Найти("КонтурМаркировка_ВидыУпаковок");
	Если МетаданныеВидыУпаковокКонтурМаркировка <> Неопределено Тогда
		
		ВидыУпаковокКМ = Перечисления.КонтурМаркировка_ВидыУпаковок;
		
		Результат.Вставить(ВидыУпаковокКМ.Групповая, УпаковкаГрупповая());
		Результат.Вставить(ВидыУпаковокКМ.Логистическая, УпаковкаЛогистическая());
		Результат.Вставить(ВидыУпаковокКМ.Потребительская, УпаковкаПотребительская()); 
		
		ЕстьОбъемноСортовойУчет = МетаданныеВидыУпаковокКонтурМаркировка.ЗначенияПеречисления.Найти("ОбъемноСортовойУчет") <> Неопределено;
		Если ЕстьОбъемноСортовойУчет Тогда
			Результат.Вставить(ВидыУпаковокКМ.ОбъемноСортовойУчет, УпаковкаОбъемноСортовойУчет());
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразовывает вид упаковки подсистемы КонтурМаркировка во внутренее представление.
//
// Параметры:
//  ВидУпаковкиКМ - ПеречислениеСсылка.КонтурМаркировка_ВидыУпаковок - вид упаковки в формате КМ.
//  ПравилаКонвертацииУпаковок - Соответствие - (Необязательный) правила преобразования (см. ПравилаКонвертацииУпаковокКонтурМаркировка)
// 
// Возвращаемое значение:
//  Строка - Возможные значения описаны функциями УпаковкаПотребительская(), УпаковкаЛогистическая() и УпаковкаГрупповая()
//
Функция ВидУпаковкиПоДаннымКонтурМаркировка(ВидУпаковкиКМ, ПравилаКонвертацииУпаковок = Неопределено)
	
	Если ПравилаКонвертацииУпаковок = Неопределено Тогда
		ПравилаКонвертацииУпаковок = ПравилаКонвертацииУпаковокКонтурМаркировка();
	КонецЕсли;
	
	ЗначениеПоУмолчанию = УпаковкаПотребительская();
	
	Результат = ПравилаКонвертацииУпаковок.Получить(ВидУпаковкиКМ);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

