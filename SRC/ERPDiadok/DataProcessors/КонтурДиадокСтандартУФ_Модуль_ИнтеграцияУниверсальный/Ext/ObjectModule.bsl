Процедура ЗаполнитьОрганизациюКонтрагентаИнформационнойБазы(Шапка, ЭлектронныйДокумент)
	
	ОрганизацияИБ = ЭлектронныйДокумент.ОрганизацияСервиса.Ссылка;
	
	Если ЗначениеЗаполнено(ОрганизацияИБ)
		И ТипЗнч(Шапка.Покупатель) = Тип("Структура") // Документ содержит сведения об одном покупателе
		И Не ЗначениеЗаполнено(Шапка.Покупатель.Ссылка) Тогда
		Шапка.Покупатель.Ссылка = ОрганизацияИБ;
	КонецЕсли;
	
	КонтрагентИБ = ЭлектронныйДокумент.КонтрагентСервиса.Ссылка;
	
	Если ЗначениеЗаполнено(КонтрагентИБ)
		И ТипЗнч(Шапка.Продавец) = Тип("Структура") // Документ содержит сведения об одном продавце
		И Не ЗначениеЗаполнено(Шапка.Продавец.Ссылка) Тогда
		Шапка.Продавец.Ссылка = КонтрагентИБ;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОрганизациюКонтрагентаИнформационнойБазы405(Шапка, ЭлектронныйДокумент)
	
	ОрганизацияИБ = ЭлектронныйДокумент.ОрганизацияСервиса.Ссылка;
	
	Если ЗначениеЗаполнено(ОрганизацияИБ)
		И ТипЗнч(Шапка.Получатель) = Тип("Структура") // Документ содержит сведения об одном получателе
		И Не ЗначениеЗаполнено(Шапка.Получатель.Ссылка) Тогда
		Шапка.Получатель.Ссылка = ОрганизацияИБ;
	КонецЕсли;
	
	КонтрагентИБ = ЭлектронныйДокумент.КонтрагентСервиса.Ссылка;
	
	Если ЗначениеЗаполнено(КонтрагентИБ)
		И ТипЗнч(Шапка.Отправитель) = Тип("Структура") // Документ содержит сведения об одном отправителе
		И Не ЗначениеЗаполнено(Шапка.Отправитель.Ссылка) Тогда
		Шапка.Отправитель.Ссылка = КонтрагентИБ;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКлючевыеСвойстваКорректируемогоДокумента(Шапка, Контент)
	
	Если Контент.Invoices.Количество() > 1 Тогда 
		ТекстОшибки = НСтр("ru = 'Создание корректировки по нескольким документам-основаниям не поддерживается.'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	КорректируемыйДокумент = Контент.Invoices[0];
	Шапка.Вставить("КорректируемыйДокумент", КлючевыеСвойстваДокументОснованиеУКД(КорректируемыйДокумент));
	
КонецПроцедуры

Процедура ЗаполнитьКлючевыеСвойстваДокумента423(Шапка, Контент)

	ОснованиеАктаОРасхождениях = СвойствоСтруктуры(Контент, "CircumstancesAcceptanceInfo.CargoInspectionInformation.AccompanyingDocumentInfo");
	Шапка.Основание = КлючевыеСвойстваДокументОснованиеДокументаОРасхождениях(ОснованиеАктаОРасхождениях);

КонецПроцедуры

// Формирует описание товарной части электронного документа.
//
// Параметры:
//  Контент - Структура - Протоструктура с содержимым документа;
//  ЭтоКорректировка - Булево - Истина, если это контент корректировочного документа;
// 
// Возвращаемое значение:
//  Структура.
//
Функция ДанныеТоварнойЧастиЭлектронногоДокумента(Контент, ЭтоКорректировка)
	
	ТоварнаяЧасть 	= Новый Массив;
	Итоги 			= Новый Структура;
	
	Если ЭтоКорректировка Тогда 
		
		Таблица = Контент.InvoiceCorrectionTable;
		
		СтрокиКонтента = Таблица.Items;
		ЗаполнитьТоварнуюЧастьПоДаннымЭлектронногоКорректировочногоДокумента(ТоварнаяЧасть, СтрокиКонтента);
		
		// Итоги (уменьшение)
		СуммаСНДСУменьшение		 = СвойствоСтруктуры(Таблица, "TotalsDec.Total");
		СуммаБезНДСУменьшение	 = СвойствоСтруктуры(Таблица, "TotalsDec.TotalWithVatExcluded");
		СуммаНДСУменьшение		 = СвойствоСтруктуры(Таблица, "TotalsDec.Vat");
		
		Итоги.Вставить("СуммаСНДСУменьшение"	, ПривестиКЧислу(СуммаСНДСУменьшение));
		Итоги.Вставить("СуммаБезНДСУменьшение"	, ПривестиКЧислу(СуммаБезНДСУменьшение));
		Итоги.Вставить("СуммаНДСУменьшение"		, ПривестиКЧислу(СуммаНДСУменьшение));
		
		// Итоги (увеличение)
		СуммаСНДСУвеличение		 = СвойствоСтруктуры(Таблица, "TotalsInc.Total");
		СуммаБезНДСУвеличение	 = СвойствоСтруктуры(Таблица, "TotalsInc.TotalWithVatExcluded");
		СуммаНДСУвеличение		 = СвойствоСтруктуры(Таблица, "TotalsInc.Vat");
		
		Итоги.Вставить("СуммаСНДСУвеличение"	, ПривестиКЧислу(СуммаСНДСУвеличение));
		Итоги.Вставить("СуммаБезНДСУвеличение"	, ПривестиКЧислу(СуммаБезНДСУвеличение));
		Итоги.Вставить("СуммаНДСУвеличение"		, ПривестиКЧислу(СуммаНДСУвеличение));
		
	Иначе 
		
		Если Контент.Свойство("Items") Тогда
			// это старый формат
			СтрокиКонтента = Контент.Items;
		ИначеЕсли Контент.Свойство("Table") Тогда
			Таблица = Контент.Table;
			СтрокиКонтента = Таблица.Items;
		ИначеЕсли Контент.Свойство("Works") Тогда
			// это акт 552 формата
			ТаблицыРабот = Контент.Works;
			СтрокиКонтента = Новый Массив;
			Для Каждого Таблица Из ТаблицыРабот Цикл
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СтрокиКонтента, Таблица.Items);
			КонецЦикла;
		Иначе
			Таблица = Контент.InvoiceTable;
			СтрокиКонтента = Таблица.Items;
		КонецЕсли;
		
		ЗаполнитьТоварнуюЧастьПоДаннымЭлектронногоДокумента(ТоварнаяЧасть, СтрокиКонтента);
		
		// Итоги
		СуммаСНДС	 = СвойствоСтруктуры(Таблица, "Total");
		СуммаБезНДС	 = СвойствоСтруктуры(Таблица, "TotalWithVatExcluded");
		СуммаНДС	 = СвойствоСтруктуры(Таблица, "Vat");
		
		Итоги.Вставить("СуммаСНДС"	, ПривестиКЧислу(СуммаСНДС));
		Итоги.Вставить("СуммаБезНДС", ПривестиКЧислу(СуммаБезНДС));
		Итоги.Вставить("СуммаНДС"	, ПривестиКЧислу(СуммаНДС));
		
	КонецЕсли;
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТоварнаяЧасть", ТоварнаяЧасть);
	Результат.Вставить("ИтоговыеСуммы", Итоги);
	
	Возврат Результат;
	
КонецФункции

