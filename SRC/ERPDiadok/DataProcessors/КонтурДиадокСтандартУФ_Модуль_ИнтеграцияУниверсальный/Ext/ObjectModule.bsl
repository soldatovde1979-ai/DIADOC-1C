// Заполняет СведенияОПрослеживаемости по данным ItemTracingInfos строки контента
//
// Параметры
//  Приемник 		- Массив 		- см. НоваяСтрокаТоварнойЧастиКорректировочногоДокумента().СведенияОПрослеживаемости
//  ИсточникДанных 	- Структура		- СтрокаКонтента в которой есть ItemTracingInfos.
//
Процедура ПрочитатьСвойства_СведенияОПрослеживаемостиКорректировочногоДокумента(Приемник, ИсточникДанных)
	
	СведПрослеж = СвойствоСтруктуры(ИсточникДанных, "ItemTracingInfos");
	
	Если Не ЗначениеЗаполнено(СведПрослеж) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из СведПрослеж Цикл
		
		ДанныеПрослеживаемости = НовыеСвойстваЭлементаПрослеживаемостиПоКорректировке(); 
		
		ДанныеПрослеживаемости.НомерГТДРегистрационныйНомер 		= Элемент.RegNumberUnit;
		ДанныеПрослеживаемости.КодЕдиницыИзмеренияПрослеживаемости 	= Элемент.Unit;
		
		QuantityDiff												= Элемент.QuantityDiff;
		ДанныеПрослеживаемости.КоличествоУменьшение 				= QuantityDiff.QuantityDec;
		ДанныеПрослеживаемости.КоличествоУвеличение 				= QuantityDiff.QuantityInc;
		ДанныеПрослеживаемости.КоличествоПослеИзменения 			= QuantityDiff.CorrectedQuantity;
		ДанныеПрослеживаемости.КоличествоДоИзменения 				= QuantityDiff.OriginalQuantity;
		
		Приемник.Добавить(ДанныеПрослеживаемости);
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует структуру свойств контрагента или организации
// по данным объекта ExtendedOrganizationInfo.
//
// Параметры:
//  ИнформацияОбОрганизации - Структура - соответствует объекту ExtendedOrganizationInfo;
// 
// Возвращаемое значение:
//  Структура - см. функцию НовыйКлючевыеСвойстваЮрФизЛицо
//
Функция КлючевыеСвойстваЮрФизЛицо(ИнформацияОбОрганизации)
	
	// Результат метода используется для подготовки данных шапки УПД СЧФ ДОП и Счета ФНС 29@.
	// Реализовано для поддержки плагина распознавания неформализованных документов (Plaugin_OCR).
	// При получении документа с типом nonformalized пользователь выбирает вид документа для создания
	// из перечня первичных документов и счета на оплату (поддержаны в плагине).
	// В этом случае нужно создать первичный документ и счет от поставщика из контента УПД.
	
	Если Не ЗначениеЗаполнено(ИнформацияОбОрганизации) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = НовыйКлючевыеСвойстваЮрФизЛицо();
	
	Результат.ИдентификаторУчастникаЭДО	 = СвойствоСтруктуры(ИнформацияОбОрганизации, "FnsParticipantId");
	Результат.ИдентификаторОрганизации	 = СвойствоСтруктуры(ИнформацияОбОрганизации, "BoxId");
	Результат.НаименованиеПолное = ИнформацияОбОрганизации.Name;
	Результат.Наименование		 = ИнформацияОбОрганизации.Name;
	Результат.ИНН = СвойствоСтруктуры(ИнформацияОбОрганизации, "Inn");
	Результат.КПП = СвойствоСтруктуры(ИнформацияОбОрганизации, "Kpp");
	Результат.НомерСчета = СвойствоСтруктуры(ИнформацияОбОрганизации, "BankAccountNumber");
	
	Возврат Результат;
	
КонецФункции

