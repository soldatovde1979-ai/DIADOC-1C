// Заполняет поля AmountsInc, AmountsDec, TotalsInc, TotalsDec в контенте КСФ
//
Процедура РассчитатьСуммыУвеличенияУменьшенияВКонтентеКСФ(Content)
	
	Content.TotalsDec.Total = 0;
	Content.TotalsDec.TotalWithVatExcluded = 0;
	Content.TotalsDec.Vat = 0;
	
	Content.TotalsInc.Total= 0;
	Content.TotalsInc.TotalWithVatExcluded= 0;
	Content.TotalsInc.Vat= 0;
	
	Для каждого Item из Content.items Цикл 
						
		Если Item.OriginalValues.TotalWithVatExcluded < Item.CorrectedValues.TotalWithVatExcluded Тогда 
			Item.AmountsInc.TotalWithVatExcluded= 	Item.CorrectedValues.TotalWithVatExcluded - Item.OriginalValues.TotalWithVatExcluded;
			Item.AmountsDec.TotalWithVatExcluded= 	0;
		Иначе 
			Item.AmountsInc.TotalWithVatExcluded= 	0; 
			Item.AmountsDec.TotalWithVatExcluded= 	- Item.CorrectedValues.TotalWithVatExcluded + Item.OriginalValues.TotalWithVatExcluded;
		КонецЕсли;
		
		Если Item.OriginalValues.Vat < Item.CorrectedValues.Vat Тогда 
			Item.AmountsInc.Vat= Item.CorrectedValues.Vat - Item.OriginalValues.Vat;
			Item.AmountsDec.Vat= 0; 
		Иначе 
			Item.AmountsInc.Vat= 0 ;
			Item.AmountsDec.Vat= - Item.CorrectedValues.Vat + Item.OriginalValues.Vat;
		КонецЕсли;
		
		Если Item.OriginalValues.Total < Item.CorrectedValues.Total Тогда 
			Item.AmountsInc.Total= Item.CorrectedValues.Total - Item.OriginalValues.Total;
			Item.AmountsDec.Total= 0;
		Иначе 
			Item.AmountsInc.Total= 0;
			Item.AmountsDec.Total= - Item.CorrectedValues.Total + Item.OriginalValues.Total;
		КонецЕсли;
		
		Content.TotalsDec.TotalWithVatExcluded= Content.TotalsDec.TotalWithVatExcluded 	+ Item.AmountsDec.TotalWithVatExcluded; 
		Content.TotalsDec.Vat= 					Content.TotalsDec.Vat					+ Item.AmountsDec.Vat; 
		Content.TotalsDec.Total= 				Content.TotalsDec.Total 				+ Item.AmountsDec.Total; 
		
		Content.TotalsInc.TotalWithVatExcluded= Content.TotalsInc.TotalWithVatExcluded 	+ Item.AmountsInc.TotalWithVatExcluded; 
		Content.TotalsInc.Vat= 					Content.TotalsInc.Vat					+ Item.AmountsInc.Vat; 
		Content.TotalsInc.Total= 				Content.TotalsInc.Total 				+ Item.AmountsInc.Total; 
		
	КонецЦикла;
	
КонецПроцедуры

