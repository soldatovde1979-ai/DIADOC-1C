	ОписаниеОбъектаМетаданных = МетаданныеПрикладногоСправочника("Валюты");
	
	Если ОписаниеОбъектаМетаданных = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ПоляПоиска = КопияСтруктуры(СвойстваОбъекта, "Код");
	СвойстваОбъекта.Ссылка = СсылкаОбъектаПоПолямПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных);
	
КонецПроцедуры

// Заполняет свойство "Ссылка" структуры "НомерГТД".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. НовыйКлючевыеСвойстваНомерГТД();
