// Возвращает список метаданных с правилами сопоставления реквизитов, 
// в которые можно загрузить электронный документ.
//
// Параметры:
//  ВидЭД - Строка - см. функцию ВидыЭлектронныхДокументов;
// 
// Возвращаемое значение:
//  Соответствие - в качестве ключа используется объект метаданных, в который можно конвертировать ЭД,
//                 в качестве значения передается структура с правилами конвертации свойств (см. НовоеПравилоКонвертацииСвойствЭД).
//
Функция ПравилаЗагрузкиПоВидуЭД(ВидЭД) Экспорт
	
	Результат = Новый Соответствие;
	
	ВсеПравила = ВидыВходящихДокументов();
	
	ПараметрыОтбора	 = Новый Структура("ВидЭД", ВидЭД);
	НайденныеПравила = ВсеПравила.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого Правило Из НайденныеПравила Цикл 
		Результат.Вставить(Правило.ОбъектМетаданных, Правило.ПравилоКонвертацииСвойств);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

