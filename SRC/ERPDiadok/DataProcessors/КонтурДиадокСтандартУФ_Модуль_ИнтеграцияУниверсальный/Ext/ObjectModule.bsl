// Возвращает описание способа отражения электронного документа в учете:
// как создать и заполнить новый объект информационной базы или
// сопоставить с существующим объектом.
//
// Параметры:
//  ИдентификаторПравила - Строка - Идентификатор правила обработки электронных документов. Варианты использования:
//                                  1. Имя метаданных документа:
//                                     правило обработки формируется автоматически по имени и представлению метаданного
//                                  2. Произвольная строка:
//                                     правило обработки требуется описать в событии ПриПолученииПравилаОбработкиЭлектронногоДокумента
// 
// Возвращаемое значение:
//  Структура - содержит поля;
//   * Идентификатор - Строка - Идентификатор правила (способа) обработки;
//   * Представление - Строка - Представление правила для пользовательского интерфейса;
//   * ОбъектМетаданных - Строка - Полное имя объекта метаданных;
//   * ДополнительныеПараметры - Структура, Неопределено - Дополнительные параметры для передачи в обработку заполнения документа;
//
Функция ПравилоОбработкиЭлектронныхДокументов(ИдентификаторПравила)
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", ИдентификаторПравила);
	Результат.Вставить("Представление");
	Результат.Вставить("ОбъектМетаданных");
	Результат.Вставить("ДополнительныеПараметры");
	
	СтандартнаяОбработка = Истина;
	
	ПриПолученииПравилаОбработкиЭлектронногоДокумента(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		ОбъектМетаданных = Метаданные.Документы.Найти(ИдентификаторПравила);
		
		Если ОбъектМетаданных = Неопределено Тогда
			
			ПолноеИмяОбъектаМетаданных = "Документ." + ИдентификаторПравила;
			ШаблонОшибки = НСтр("ru = 'Не найден объект метаданных (%1)'");
			Ошибка = СтрШаблон(ШаблонОшибки, ПолноеИмяОбъектаМетаданных);
			ВызватьИсключение Ошибка;
			
		КонецЕсли;
		
		ПредставлениеОперации = ОбъектМетаданных.ПредставлениеОбъекта;
		Если Не ЗначениеЗаполнено(ПредставлениеОперации) Тогда
			ПредставлениеОперации = ОбъектМетаданных.Представление();
		КонецЕсли;
		
		Результат.Идентификатор		 = ИдентификаторПравила;
		Результат.Представление		 = ПредставлениеОперации;
		Результат.ОбъектМетаданных	 = ОбъектМетаданных.ПолноеИмя();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает правила обработки входящих электронных документов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//    * ВидДокумента - Строка - вид электронного документа (см. ВидыЭлектронныхДокументов);
//    * ЭтоИсправление - Булево - Истина, если правило действует для исправлений;
//    * ИдентификаторПравила - Строка - идентификатор правила обработки (см. ПравилоОбработкиЭлектронныхДокументов)
//
