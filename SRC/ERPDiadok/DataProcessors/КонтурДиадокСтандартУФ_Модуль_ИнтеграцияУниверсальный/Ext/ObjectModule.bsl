//
// Параметры:
//  ИнформацияОбОрганизации - Структура - соответствует объекту ExtendedOrganizationInfo_ReconciliationAct;
// 
// Возвращаемое значение:
//  Структура - см. функцию НовыйКлючевыеСвойстваЮрФизЛицо
//
Функция КлючевыеСвойстваЮрФизЛицо405(ИнформацияОбОрганизации)
	
	Если Не ЗначениеЗаполнено(ИнформацияОбОрганизации) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = НовыйКлючевыеСвойстваЮрФизЛицо();
	
	Результат.НаименованиеПолное = ИнформацияОбОрганизации.Name;
	Результат.Наименование = ИнформацияОбОрганизации.Name;
	Результат.ИНН = ИнформацияОбОрганизации.Inn;
	Результат.КПП = ИнформацияОбОрганизации.Kpp;
	
	Возврат Результат;
	
КонецФункции

// Формирует структру свойств валюты
//
// Параметры:
//  ДанныеВалюты - Строка, Число - код валюты по ОКВ;
// 
// Возвращаемое значение:
//  Структура - см. функцию НовыйКлючевыеСвойстваВалюта.
//
Функция КлючевыеСвойстваВалюта(ДанныеВалюты)
	
	Результат = НовыйКлючевыеСвойстваВалюта();
	Результат.Код = Формат(ДанныеВалюты, "ЧГ=0"); // на случай, если из компоненты прилетит число
	
	Возврат Результат;
	
КонецФункции

Функция КлючевыеСвойстваНоменклатурыПоставщика(ИсточникДанных)
	
	Результат = НовыйКлючевыеСвойстваНоменклатураПоставщика();
	
	Результат.Код = КодНоменклатурыИзСтрокиЭД(ИсточникДанных);
	Результат.Сорт = СортНоменклатурыИзСтрокиЭД(ИсточникДанных);
	Результат.Артикул = АртикулНоменклатурыИзСтрокиЭД(ИсточникДанных);
	Результат.Описание = СвойствоСтруктуры(ИсточникДанных, "Description");
	Результат.Наименование = НаименованиеНоменклатурыИзСтрокиЭД(ИсточникДанных);
	Результат.Идентификатор = ИдентификаторНоменклатурыИзСтрокиЭД(ИсточникДанных);
	Результат.Характеристика = ХарактеристикаНоменклатурыИзСтрокиЭД(ИсточникДанных);
	// + шх Красавин А.А. 13.03.2025 (00-00012906) Изменение формата счета-фактуры, УПД в соответствии с приказом № ЕД-7-26/970@: e1cib/data/Справочник.Карточка?ref=b933005056bcf87311eeecfe9d671e15 
	// т1к О.Н.Кошелев, 2023-11-30{Автоматизация ЭДО: e1cib/data/Справочник.Карточка?ref=b90f005056bc8d5011ee78923fc51ecb 
	Результат.ЕдиницаИзмерения = КлючевыеСвойстваЕдиницыИзмерения(ИсточникДанных).Наименование; 
	// }т1к О.Н.Кошелев, 2023-11-30
	// - шх Красавин А.А. 13.03.2025 (00-00012906) Изменение формата счета-фактуры, УПД в соответствии с приказом № ЕД-7-26/970@: e1cib/data/Справочник.Карточка?ref=b933005056bcf87311eeecfe9d671e15 
	
	Если Не ЗначениеЗаполнено(Результат.Наименование)
		И ЗначениеЗаполнено(Результат.Описание) Тогда
		
		Результат.Наименование = Результат.Описание;
		Результат.Описание = "";
		
	КонецЕсли;
	
	ЗаполнитьИдентификаторНоменклатурыКонтрагента(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция КлючевыеСвойстваЕдиницыИзмерения(ИсточникДанных)
	
	Результат = НовыйКлючевыеСвойстваЕдиницаИзмерения();
	
	Результат.Наименование = СвойствоСтруктуры(ИсточникДанных, "UnitName");
	
	Результат.Код = СвойствоСтруктуры(ИсточникДанных, "UnitCode");
	Если Не ЗначениеЗаполнено(Результат.Код) Тогда 
		Результат.Код = СвойствоСтруктуры(ИсточникДанных, "Unit"); // 551@, 820@
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КлючевыеСвойстваСтавкиНДС(ИсточникДанных)
	
	ПредставлениеСтавки = СвойствоСтруктуры(ИсточникДанных, "TaxRate");
	
	Если Не ЗначениеЗаполнено(ПредставлениеСтавки) Тогда // для 172@
		
		СуммаНалога = СвойствоСтруктуры(ИсточникДанных, "Vat", 0);
		СуммаБезНалога = СвойствоСтруктуры(ИсточникДанных, "TotalWithVatExcluded", 0);
		ПредставлениеСтавки = РасчетноеПредставлениеСтавкиНДС(СуммаБезНалога, СуммаНалога);
		
	КонецЕсли;
	
	Результат = НовыйКлючевыеСвойстваСтавкаНДС();
	Результат.Представление = ПредставлениеСтавки;
	Результат.Ссылка = ПрикладнаяСтавкаНДС(ПредставлениеСтавки);
	
	Возврат Результат;
	
КонецФункции

Функция КлючевыеСвойстваСтавкиНДСИноеЗначение(ИсточникДанных)
	
	ПредставлениеСтавки = СвойствоСтруктуры(ИсточникДанных, "OtherTaxRate");
	
