	Результат = СокрЛП(ПодставитьПараметрыВСтроку("%1 %2", Поле, ПолеСокращение));
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеАдреса(СтруктураАдреса)
	
	Если ЭтоМуниципальныйАдрес(СтруктураАдреса) Тогда
		Результат = СвойствоСтруктуры(СтруктураАдреса, "МуниципальноеПредставление");
	Иначе
		Результат = СвойствоСтруктуры(СтруктураАдреса, "Представление");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СохраненноеПредставлениеАдресаСовпадаетСРассчитанным(СтруктураАдреса)
	
	РассчитанноеПредставление	 = ВРег(ПредставлениеАдреса(СтруктураАдреса));
	СохраненноеПредставление	 = ВРег(СтруктураАдреса.СохраненноеПредставление);
	Страна = ВРег(СтруктураАдреса.Страна);
	
	Результат = Ложь;
	
	Если РассчитанноеПредставление = СохраненноеПредставление
		Или РассчитанноеПредставление = Страна + ", " + СохраненноеПредставление Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

