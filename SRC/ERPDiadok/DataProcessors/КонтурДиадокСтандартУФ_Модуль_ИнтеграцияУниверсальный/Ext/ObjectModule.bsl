// Создает новую таблицу значений для штрихкодов упаковок.
// В прикладных документах должна существовать табличная часть с аналогичным набором колонок.
// См. ЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок()
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица значений штрихкодов упаковок:
//    * ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров - Штрихкод упаковки
//    * ЗначениеШтрихкода - Строка - Значение штрихкода
//
Функция НоваяТаблицаШтрихкодыУпаковок() Экспорт
	
	//МодульЭлектронноеВзаимодействиеИСМП = ОбщегоНазначения.ОбщийМодуль("ЭлектронноеВзаимодействиеИСМП");
	//Результат = МодульЭлектронноеВзаимодействиеИСМП.НоваяТаблицаШтрихкодыУпаковок();
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ШтрихкодУпаковки");
	Результат.Колонки.Добавить("ЗначениеШтрихкода");
	
	Возврат Результат;
	
КонецФункции

// Считывает коды маркировки из строки электронного документа и
// добавляет их в общую таблицу штрихкодов.
//
// Параметры:
//  ШтрихкодыУпаковок	 - ТаблицаЗначений - таблица с кодами маркировки (см НоваяТаблицаШтрихкодыУпаковок)
//  СведенияОМаркировке	 - Структура - сведения о маркировке (см. НовыйСведенияОМаркировке)
//  GTIN				 - Строка - Глобальный идентификационный номер товарной продукции
//
Процедура ДополнитьТаблицуШтрихкодов(ШтрихкодыУпаковок, СведенияОМаркировке, GTIN = "") Экспорт
	
	//Если ИспользоватьКонтурМаркировку() Тогда
	//	Возврат;
	//КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СведенияОМаркировке) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(GTIN)
		И ЗначениеЗаполнено(СведенияОМаркировке.КоличествоТовараВУпаковке) Тогда
		
		КоличествоТовараВУпаковке = СведенияОМаркировке.КоличествоТовараВУпаковке;

		ЗначениеШтрихкода = НовыйКодОСУ(GTIN, КоличествоТовараВУпаковке);
		
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;

	КонецЕсли;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.КонтрольныеИдентификационныеЗнаки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ИндивидуальныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
	Для Каждого ЗначениеШтрихкода Из СведенияОМаркировке.ТранспортныеУпаковки Цикл
		НоваяСтрока = ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ЗначениеШтрихкода = ЗначениеШтрихкода;
	КонецЦикла;
	
КонецПроцедуры

Функция НовыйКодОСУ(GTIN, Количество)
	
	КоличествоСтрокой = XMLСтрока(Цел(Количество));
	
	ЧастиКодаОСУ = Новый Массив;
	ЧастиКодаОСУ.Добавить("02");
	ЧастиКодаОСУ.Добавить(GTIN);
	ЧастиКодаОСУ.Добавить("37");
	ЧастиКодаОСУ.Добавить(КоличествоСтрокой);
	
	Результат = СтрСоединить(ЧастиКодаОСУ);
	
	Возврат Результат;
	
КонецФункции

// Возвращает зарезервированное имя свойства для передачи произвольных данных в структуру контента.
// Например, ссылки на источники, по которым сформирована структура контента,
// или любые иные сведения, определенные в событии ПМ "ПослеЗаполненияКонтента".
// 
// Возвращаемое значение:
//  Строка.
//
Функция ИмяСвойстваСлужебнаяИнформация() Экспорт
	
	Возврат "СлужебнаяИнформация";
	
КонецФункции

// Дополняет структуру контента документа служебной информацией об источнике заполнения контента:
// ссылками на сам документ, контрагента, организацию и т.д.
//
// Параметры:
//  Протоструктура	 - Структура - формируемый контент документа;
//  ДанныеШапки		 - Структура - см. функцию ДанныеШапки;
//
Процедура ДополнитьКонтентДокументаСлужебнойИнформацией(Контент, ДанныеШапки) Экспорт 
	
	СлужебнаяИнформация = НоваяСлужебнаяИнформацияШапки();
	ЗаполнитьЗначенияСвойств(СлужебнаяИнформация, ДанныеШапки);
	СлужебнаяИнформация.Ссылка = ДанныеШапки.ОписаниеДокумента.Ссылка;
	
	Контент.Вставить(ИмяСвойстваСлужебнаяИнформация(), СлужебнаяИнформация);
	
КонецПроцедуры

// Дополняет структуру контента строки табличной части служебной информацией об источнике заполнения контента:
// ссылками на номенклатуру, характеристику, упаковку (единицу измерения) и т.д.
//
// Параметры:
//  Протоструктура	 - Структура - структура, содержащая контент по строке табличной части;
//  СтрокаТЧ		 - СтрокаТаблицыЗначений - см. функцию ДанныеТабличныхЧастей;
//
Процедура ДополнитьКонтентСтрокиДокументаСлужебнойИнформацией(Контент, СтрокаТЧ) Экспорт 
	
	СлужебнаяИнформация = НоваяСлужебнаяИнформацияСтроки();
	ЗаполнитьЗначенияСвойств(СлужебнаяИнформация, СтрокаТЧ);
	
	// Упаковки (единицы) номенклатуры из учетного документа
	СлужебнаяИнформация.Упаковка = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "Упаковка");
	СлужебнаяИнформация.УпаковкаДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "УпаковкаДоИзменения");
	
	// Единицы измерения по классификатору
	СлужебнаяИнформация.ЕдиницаИзмерения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "ЕдиницаИзмерения");
	СлужебнаяИнформация.ЕдиницаИзмеренияДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "ЕдиницаИзмеренияДоИзменения");
	
	СлужебнаяИнформация.Номенклатура		 = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "Номенклатура");
	СлужебнаяИнформация.Характеристика		 = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "Характеристика");
	СлужебнаяИнформация.Серия				 = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "Серия");
	СлужебнаяИнформация.СтранаПроисхождения	 = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "СтранаПроисхождения");
	СлужебнаяИнформация.СтавкаНДС			 = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "СтавкаНДС");
	СлужебнаяИнформация.СтавкаНДСДоИзменения = СсылочноеЗначениеСвойстваИсточникаДанных(СтрокаТЧ, "СтавкаНДСДоИзменения");
	СлужебнаяИнформация.ДокументОтгрузки	 = СтрокаТЧ.ДокументОтгрузки;
	
	Если Не ЗначениеЗаполнено(СлужебнаяИнформация.ПрослеживаемыйТовар) Тогда
		СлужебнаяИнформация.ПрослеживаемыйТовар = Ложь;
	КонецЕсли;
	Если ТипЗнч(СлужебнаяИнформация.ДанныеПрослеживаемости) <> Тип("Массив") Тогда
		СлужебнаяИнформация.ДанныеПрослеживаемости = Новый Массив;
	КонецЕсли;
	
	Контент.Вставить(ИмяСвойстваСлужебнаяИнформация(), СлужебнаяИнформация);
	
КонецПроцедуры

// Создает структуру параметров для заполнения служебной информации об основании передачи,
// которая будет передана в протоструктуру контента документа.
// 
// Возвращаемое значение:
//  Структура.
//
Функция НоваяСлужебнаяИнформацияОснованияПередачи() Экспорт
	
