// Проверяет, что указанный ИНН принадлежит физическому лицу.
//
// Параметры:
//  ИНН - Строка - проверяемый ИНН;
// 
// Возвращаемое значение:
//  Булево - Истина, если ИНН состоит из 12 значащих символов.
//
Функция ЭтоИННФизическогоЛица(Знач ИНН)
	
	Результат = Ложь;
	
	ИНН = СокрЛП(ИНН);
	Если Лев(ИНН, 2) = "00" Тогда 
		ИНН = Сред(ИНН, 3);
	КонецЕсли;
	
	Если СтрДлина(ИНН) = 12 Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

