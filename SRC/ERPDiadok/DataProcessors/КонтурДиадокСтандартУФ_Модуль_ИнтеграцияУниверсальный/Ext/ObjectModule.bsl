Функция ВыгрузитьКолонкуМассиваСтруктур(МассивСтруктур, ИмяКолонки, ТолькоРазличные = Истина)
	
	Результат = Новый Массив;
	
	Для Каждого Стр Из МассивСтруктур Цикл
		
		Значение = Неопределено;
		Если Не Стр.Свойство(ИмяКолонки, Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ТолькоРазличные
			Или Результат.Найти(Значение) = Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
