//
Функция КонтентСчетаФактуры93(СсылкаНаДокумент, ПараметрыФормирования)
	
	Результат = Новый_InvoiceContent();
	
	МетодСервера(ПараметрыКлиентСервер.ИмяФормыИнтеграции, "ЗаполнитьКонтентInvoice"
				, Результат
				, СсылкаНаДокумент
				, ПараметрыФормирования);
	
	Возврат Результат;
	
КонецФункции

// Формирует и заполняет структуру InvoiceCorrectionContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ПараметрыФормирования - Структура - см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентКорректировочногоСчетаФактуры93(СсылкаНаДокумент, ПараметрыФормирования)
	
	Результат = Новый_InvoiceCorrectionContent();
	
	МетодСервера(ПараметрыКлиентСервер.ИмяФормыИнтеграции, "ЗаполнитьКонтентInvoiceCorrection"
				, Результат
				, СсылкаНаДокумент
				, ПараметрыФормирования);
	
	РассчитатьСуммыУвеличенияУменьшенияВКонтентеКСФ(Результат);
	
	Возврат Результат;
	
КонецФункции

// Определяет значение параметра ФункцияУПД, используемого в
// методах заполнения контента. Алгоритм следующий:
//  - Пробуем определить результат по имени типа электронного документа (typeNamedId);
//  - В случае неудачи берем значение функции из формата отправки;
//  - Если результат не определен, возвращаем функцию по умолчанию;
//
// Параметры:
//  ФорматОтправки - Структура - см. НовоеОписаниеФорматаЭлектронногоДокумента;
// 
// Возвращаемое значение:
//  Строка - возможные значения указаны в перечислении ФункцииЭлектронныхДокументов;
//
Функция ФункцияУниверсальногоДокумента(ФорматОтправки)
	
	ТипыДокументов = ИдентификаторыТиповДокументов();
	ФункцииЭД = ФункцииЭлектронныхДокументов();
	
	ИмяТипа = ФорматОтправки.ИмяТипа;
	
	Если ИмяТипа = ТипыДокументов.Invoice
		Или ИмяТипа = ТипыДокументов.InvoiceRevision Тогда
		
		Результат = ФункцииЭД.СЧФ;
		
	ИначеЕсли ИмяТипа = ТипыДокументов.InvoiceCorrection
		Или ИмяТипа = ТипыДокументов.InvoiceCorrectionRevision Тогда
		
		Результат = ФункцииЭД.КСЧФ;
		
	ИначеЕсли ИмяТипа = ТипыДокументов.XmlTorg12
		Или ИмяТипа = ТипыДокументов.XmlAcceptanceCertificate Тогда
		
		Результат = ФункцииЭД.ДОП;
		
	Иначе
		
		Результат = ФорматОтправки.ФункцияДокумента;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ФункцииЭД.ПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли строка корректировочного документа (ucd) новой.
//
// Параметры:
//  Item - СтрокаТаблицыЗначений - элемент коллекции UcdSellerContent.InvoiceCorrectionTable.Items.
// 
// Возвращаемое значение:
//  Булево - Истина, если это новая строка (её не было в исходном документе).
// 
Функция ЭтоНоваяСтрокаКорректировки(Item)
	
	ЗначенияДоИзменения = Item.OriginalValues;
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(ЗначенияДоИзменения.Quantity)
		Или ЗначениеЗаполнено(ЗначенияДоИзменения.TotalWithVatExcluded)
		Или ЗначениеЗаполнено(ЗначенияДоИзменения.Total)
		Или ЗначениеЗаполнено(ЗначенияДоИзменения.Vat) Тогда
		
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

