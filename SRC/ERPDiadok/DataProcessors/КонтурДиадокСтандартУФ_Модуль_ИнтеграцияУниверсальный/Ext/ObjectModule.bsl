	Функция ПолучитьОписаниеТиповСтрокой(ЗначениеЭл)
		
		СтрЗаменТипов = Новый Структура("Справочник,Документ,Перечисление", "СправочникСсылка", "ДокументСсылка", "ПеречислениеСсылка");
		
