Функция МЧД_ИмяСправочникаВИнформационнойБазе() Экспорт
	
	Перем Результат;
	
	СтандартнаяОбработка = Истина;
	
	Результат = МЧД_ИмяСправочникаВИнформационнойБазеПереопределяемый(СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		//TODO git-1486: возможно стоит перенести все в переопределяемый метод и сделать проверку на версию конфигурации
		ИмяСправочника = "МашиночитаемыеДоверенностиФНС";
		
		Если Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено Тогда
			Результат = ИмяСправочника;	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МЧД_ДанныеДоверенностиИнформационнойБазы(Ссылка) Экспорт
	
	Перем Результат;
	
	Если Не МЧД_ЕстьСправочникМашиночитаемыхДоверенностей() Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	
	Результат = МЧД_ДанныеДоверенностиИнформационнойБазыПереопределеяемый(Ссылка, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Результат = МЧД_ДанныеДоверенности(Ссылка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция МЧД_ИмяСправочникаВИнформационнойБазеПереопределяемый(СтандартнаяОбработка)
	
	Перем Результат;
	
	МетодСервера(ИмяМодуляИнтеграции(), "МЧД_ИмяСправочникаВИнформационнойБазе", СтандартнаяОбработка);
		
	Возврат Результат;
	
