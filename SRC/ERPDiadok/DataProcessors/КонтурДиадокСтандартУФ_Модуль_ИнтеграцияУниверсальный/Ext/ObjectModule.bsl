// Формирует и заполняет структуру Utd820SellerContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ПараметрыФормирования - Структура - см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентУПД820(СсылкаНаДокумент, ПараметрыФормирования)
	
	Контент155 = КонтентУПД155(СсылкаНаДокумент, ПараметрыФормирования);
	
	Результат = Конвертировать155в820(Контент155);
	
	ДокументыОснования = СвойствоСтруктуры(Контент155.СлужебнаяИнформация, "ДокументыОснования");
	ЗаполнитьСведенияОДокументахПодтверждающихОтгрузку820(Результат, ДокументыОснования);
	
	ИспользоватьКМ = ПараметрыФормирования.ИспользоватьСервисКонтурМаркировка;
	ЗаполнитьСведенияОМаркировке820(Результат, СсылкаНаДокумент, ИспользоватьКМ);
	
	ЗаполнитьСведенияПрослеживаемости820(Результат);
	
	Если ЭтоЭлектронныйУПД(ПараметрыФормирования.ФорматОтправки.ИмяТипа) Тогда
		ЗаполнитьОбстФормСЧФ820(Результат, СсылкаНаДокумент, ПараметрыФормирования.ФункцияДокумента);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конвертирует протоконтент из формата 155@ в формат 820@.
//
// @СлужебныйПрограммныйИнтерфейс
//
// Параметры:
//  Контент155 - Структура - см. Новый_UtdSellerContent.
// 
// Возвращаемое значение:
//  Структура - см. Новый_Utd820SellerContent.
//
Функция Конвертировать155в820(Контент155) Экспорт
	
	Результат = Новый_Utd820SellerContent();
	ЗаполнитьКонтент820ПоДаннымКонтент155(Результат, Контент155);
	
	Возврат Результат;
	
КонецФункции

// Мапит структуру UtdSellerContent в структуру Utd820SellerContent
//
// Параметры:
//	Контент820	- Структура - см. метода Новый_Utd820SellerContent()
//	Контент155	- Структура	- заполненная структура Новый_Utd820SellerContent() 
//
// ВозвращаемоеЗначение:
//	Структура - См. тело метода
Процедура ЗаполнитьКонтент820ПоДаннымКонтент155(Контент820, Контент155)
	
	// Наименование, дата и номер документа
	Контент820.DocumentName	 = Контент155.Name;
	Контент820.DocumentDate	 = Контент155.Date;
	Контент820.DocumentNumber = Контент155.Number;
	
	// Дата и номер исправления
	Контент820.RevisionDate		= Контент155.RevisionDate;
	Контент820.RevisionNumber	= Контент155.RevisionNumber;
	
	Контент820.Function = Контент155.Function;
	
	// Валюта
	Контент820.Currency 		= Контент155.Currency;
	Контент820.CurrencyRate 	= Контент155.CurrencyRate;
	
	// Составитель документа и его полномочия
	Контент820.DocumentCreator		 = Контент155.Creator;
	Контент820.DocumentCreatorBase	 = Контент155.CreatorBase;
	
	// Идентификатор государственного контракта
	Контент820.GovernmentContractInfo = Контент155.GovernmentContractInfo;
	
	// Участники сделки
	Buyer		 = Новый_ExtendedOrganizationInfo820();
	Seller		 = Новый_ExtendedOrganizationInfo820();
	Consignee	 = Новый_ExtendedOrganizationInfo820();
	
	ЗаполнитьЗначенияСвойств(Buyer		, Контент155.Buyer);
	ЗаполнитьЗначенияСвойств(Seller		, Контент155.Seller);
	ЗаполнитьЗначенияСвойств(Consignee	, Контент155.Consignee);
	
	Если СтруктураЗаполнена(Consignee) Тогда
		Consignee.HyphenInn = НЕ ЗначениеЗаполнено(Consignee.Inn);
	КонецЕсли;
	
	Shipper = Новый_Shipper820();
	Shipper.SameAsSeller = Контент155.Shipper.SameAsSeller;
	ЗаполнитьЗначенияСвойств(Shipper.OrganizationInfo, Контент155.Shipper.OrganizationInfo);
	
	Если СтруктураЗаполнена(Shipper.OrganizationInfo) Тогда
		Shipper.OrganizationInfo.HyphenInn = НЕ ЗначениеЗаполнено(Shipper.OrganizationInfo.Inn);
	КонецЕсли;
	
	Контент820.Buyers.Добавить(Buyer);
	Контент820.Sellers.Добавить(Seller);
	Контент820.Shippers.Добавить(Shipper);
	Контент820.Consignees.Добавить(Consignee);
	
	Контент820.AdditionalInfoId = Контент155.AdditionalInfoId;
	
	// Сведения о платежно-расчетном документе
	Для Каждого PaymentDocument155 Из Контент155.PaymentDocuments Цикл
	
		PaymentDocument820 = Новый_PaymentDocumentInfo();
		
		ЗаполнитьЗначенияСвойств(PaymentDocument820, PaymentDocument155);
		
		Контент820.PaymentDocuments.Добавить(PaymentDocument820);
		
	КонецЦикла;
	
	// Основания передачи
	ЗаполнитьTransferBase820ПоДаннымКонтент155(Контент820.TransferInfo, Контент155.TransferInfo);
			
	// Табличная часть
	ЗаполнитьUtd820TableПоДаннымКонтент155(Контент820, Контент155);
	
	// Подписанты
	ЗаполнитьSigners820ПоДаннымКонтент155(Контент820.Signers, Контент155.Signers);
						
	Контент820.ОшибкиВДанных = Контент155.ОшибкиВДанных;
	
	КлючСлужебнаяИнформация = ИмяСвойстваСлужебнаяИнформация();
	Если Контент155.Свойство(КлючСлужебнаяИнформация) Тогда
		
		СлужебнаяИнформация820 = Контент820[КлючСлужебнаяИнформация];
		СлужебнаяИнформация155 = Контент155[КлючСлужебнаяИнформация];
		ЗаполнитьЗначенияСвойств(СлужебнаяИнформация820, СлужебнаяИнформация155);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьTransferBase820ПоДаннымКонтент155(TransferInfo820, TransferInfo155)
	
	TransferInfo820.OperationInfo 		= TransferInfo155.OperationInfo;
	TransferInfo820.OperationType 		= TransferInfo155.OperationType;
	
	TransferInfo820.TransferTextInfo	= TransferInfo155.TransferTextInfo;
	TransferInfo820.TransferDate		= TransferInfo155.TransferDate;
	
	TransferInfo820.CreatedThingInfo	= TransferInfo155.CreatedThingInfo;
	TransferInfo820.CreatedThingTransferDate 	= TransferInfo155.CreatedThingTransferDate;
	
	Для Каждого Waybills155 Из TransferInfo155.Waybills Цикл
		
		Waybills820 = Новый_Waybill();
		
		ЗаполнитьЗначенияСвойств(Waybills820, Waybills155);
		
		TransferInfo820.Waybills.Добавить(Waybills820);
		
	КонецЦикла;
	
	КлючСлужебнаяИнформация = ИмяСвойстваСлужебнаяИнформация();
	Для каждого TransferBase155 Из TransferInfo155.TransferBases Цикл
		
		TransferBase820 = Новый_TransferBase820();
		
		ЗаполнитьЗначенияСвойств(TransferBase820, TransferBase155);
		
		Если TransferBase820.DocumentName = "Отсутствует" Тогда
			TransferBase820.DocumentName = "Без документа-основания";
		КонецЕсли;
		
		Если TransferBase155.Свойство(КлючСлужебнаяИнформация) Тогда
			
			СлужебнаяИнформацияОснования155 = TransferBase155[КлючСлужебнаяИнформация];
			ДополнитьКонтентСтрокиОснованийПередачиСлужебнойИнформацией(TransferBase820, СлужебнаяИнформацияОснования155);
			
		КонецЕсли;
		
		TransferInfo820.TransferBases.Добавить(TransferBase820);
				
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(TransferInfo820.Carrier	, TransferInfo155.Carrier);
	
	ЗаполнитьЗначенияСвойств(TransferInfo820.Employee	, TransferInfo155.Employee);
	ЗаполнитьЗначенияСвойств(TransferInfo820.OtherIssuer, TransferInfo155.OtherIssuer);
	
	ЗаполнитьЗначенияСвойств(TransferInfo820.AdditionalInfoId, TransferInfo155.AdditionalInfoId);
				
КонецПроцедуры

Процедура ЗаполнитьUtd820TableПоДаннымКонтент155(Контент820, Контент155)
	
	ТабличнаяЧасть = Контент820.Table;
	ЗаполнитьЗначенияСвойств(ТабличнаяЧасть, Контент155.InvoiceTable, , "Items");
	
