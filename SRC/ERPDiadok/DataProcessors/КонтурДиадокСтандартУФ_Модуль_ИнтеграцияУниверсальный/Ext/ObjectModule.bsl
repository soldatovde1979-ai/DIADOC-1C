#Область Маркировка

// Заполняет в табличной части протоконтента сведения о маркировке полученными из ПМ
//
// Параметры:
//  Контент - Структура - Протоконтент в формате приказа 820@.
//  СсылкаНаДокумент - ЛюбаяСсылка - Ссылка основание электронного документа.
//
Процедура ЗаполнитьСведенияОМаркировке820_ИнтеграционныйМодуль(Контент, СсылкаНаОбъект)
	
	СтандартнаяОбработка = Истина;
	РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
	
	ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковок, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка = Ложь Тогда
		
		ЗаполнитьСведенияОМаркировкеВКонтенте820(Контент, РазвернутаяТаблицаУпаковок);
		
		Если ЗначениеЗаполнено(РазвернутаяТаблицаУпаковок) Тогда
			ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировке736_ИнтеграционныйМодуль(Контент, СсылкаНаОбъект, ИсходныйДокумент)
	
	СтандартнаяОбработка = Истина;
	РазвернутаяТаблицаУпаковок = НоваяРазвернутаяТаблицаУпаковок();
	РазвернутаяТаблицаУпаковокДоИзменения = НоваяРазвернутаяТаблицаУпаковок();
	
	ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковок, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если ЗначениеЗаполнено(ИсходныйДокумент) Тогда 
		ЗаполнитьРазвернутуюТаблицуКодов(РазвернутаяТаблицаУпаковокДоИзменения, ИсходныйДокумент, СтандартнаяОбработка);
	КонецЕсли;
	
	Если СтандартнаяОбработка = Ложь Тогда
		
		ЗаполнитьСведенияОМаркировкеВКонтенте736(Контент, СсылкаНаОбъект, РазвернутаяТаблицаУпаковок, РазвернутаяТаблицаУпаковокДоИзменения);
		
		Если ЗначениеЗаполнено(РазвернутаяТаблицаУпаковок) Тогда
			ЗаполнитьВыбытиеИзОборотаМаркируемойПродукции(Контент, СсылкаНаОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте820(Контент, РазвернутаяТаблицаУпаковок)
	
	Для Каждого СтрокаТЧ Из Контент.Table.Items Цикл
		
		ТребуемоеКоличество = СтрокаТЧ.Quantity;
		
		Если Не ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			Продолжить;
		КонецЕсли;
		
		// Инициализировать промежуточную структуру с коллекциями кодов маркировки
		КодыМаркировки = НовыйСведенияОМаркировке();
		
		// Найти подходящие кодами маркировки
		ПодобратьКодыМаркировки(КодыМаркировки, РазвернутаяТаблицаУпаковок, СтрокаТЧ.СлужебнаяИнформация, ТребуемоеКоличество);
		
		// Перенести найденные коды маркировки в строку протоконтента
		ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.ItemIdentificationNumbers, КодыМаркировки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеВКонтенте736(Контент, СсылкаНаОбъект, РазвернутаяТаблицаУпаковок, РазвернутаяТаблицаУпаковокДоИзменения)
	
	ДокументыПередачи = ВладельцыКодовМаркировки(СсылкаНаОбъект);
	ЭтоУКД_НаОснованииВозвратаОтКлиента = СредиВладельцевКодовМаркировкиТолькоВозвратыОтКлиента(ДокументыПередачи);
	
	Для Каждого СтрокаТЧ Из Контент.InvoiceCorrectionTable.Items Цикл
						
		//OriginalValues
		ТребуемоеКоличество = СтрокаТЧ.OriginalValues.Quantity;
		
		Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
			// Инициализировать промежуточную структуру с коллекциями кодов маркировки
			КодыМаркировки = НовыйСведенияОМаркировке();
			
			// Найти подходящие кодами маркировки
			ПодобратьКодыМаркировки(КодыМаркировки
				, РазвернутаяТаблицаУпаковокДоИзменения
				, СтрокаТЧ.СлужебнаяИнформация
				, ТребуемоеКоличество
			);
			
			// Перенести найденные коды маркировки в строку протоконтента
			ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.OriginalItemIdentificationNumbers, КодыМаркировки);
			
		КонецЕсли;
		
		ЭтоПолныйВозвратТовара = ЭтоПолныйВозвратТовара(СтрокаТЧ);
		
		//CorrectedValues
		Если ЭтоУКД_НаОснованииВозвратаОтКлиента Тогда
			
			Если ЭтоПолныйВозвратТовара Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьКодыМаркировкиДляВозвратаОтКлиента(
				СтрокаТЧ, 
				РазвернутаяТаблицаУпаковок,
				РазвернутаяТаблицаУпаковокДоИзменения
			);
			
		Иначе
			
			ТребуемоеКоличество = СтрокаТЧ.CorrectedValues.Quantity;
			ТребуемоеКоличество = ?(ТребуемоеКоличество = Неопределено, 0, ТребуемоеКоличество);
			
			Если ЗначениеЗаполнено(ТребуемоеКоличество) Тогда
			
				// Инициализировать промежуточную структуру с коллекциями кодов маркировки
				КодыМаркировки = НовыйСведенияОМаркировке();
				
				// Найти подходящие кодами маркировки
				ПодобратьКодыМаркировки(КодыМаркировки
					, РазвернутаяТаблицаУпаковок
					, СтрокаТЧ.СлужебнаяИнформация
					, ТребуемоеКоличество
				);
				
				// Перенести найденные коды маркировки в строку протоконтента
				ЗаполнитьКодыМаркировкиВСтрокеКонтента(СтрокаТЧ.CorrectedItemIdentificationNumbers, КодыМаркировки);
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет таблицу кодов штатными средствами конфигурации (с помощью интеграционного модуля).
//
// Параметры:
//  Результат - ТаблицаЗначений - Заполняемая таблица (см. НоваяРазвернутаяТаблицаУпаковок).
//  СсылкаНаДокумент - ЛюбаяСсылка - объект-владелец штрихкода.
//  СтандартнаяОбработка - Булево - если установить Ложь, то заполнение таблицы кодов средствами
//                                  типовой библиотеки интеграции с ИС МП будет отключено.
//
Процедура ЗаполнитьРазвернутуюТаблицуКодов(Результат, СсылкаНаОбъект, СтандартнаяОбработка)
	
	МетодСервера(ИмяМодуляИнтеграции(), "ЗаполнитьРазвернутуюТаблицуКодов", Результат, СсылкаНаОбъект, СтандартнаяОбработка);
	
КонецПроцедуры

// Инициализирует структуру с коллекциями кодов маркировки.
// 
// Возвращаемое значение:
//  Структура - содержит ключи:
//   * ТранспортныеУпаковки - Массив - Идентификаторы транспортных упаковок (TransPackageId, ИдентТрансУпак)
//   * ИндивидуальныеУпаковки - Массив - Идентификаторы потребительских упаковок (PackageIds, НомУпак)
//   * КонтрольныеИдентификационныеЗнаки - Массив - Контрольные идентификационные знаки (Units, КИЗ)
//
Функция НовыйСведенияОМаркировке()
	
	Результат = Новый Структура;
	Результат.Вставить("КонтрольныеИдентификационныеЗнаки", Новый Массив);
	Результат.Вставить("ИндивидуальныеУпаковки", Новый Массив);
	Результат.Вставить("ТранспортныеУпаковки", Новый Массив);
	Результат.Вставить("КоличествоТовараВУпаковке", 0);
	Результат.Вставить("НомерПартии", "");
	
	Возврат Результат;
	
КонецФункции

// Подбирает требуемое количество кодов маркировки, удовлетворяющих параметрам номенклатуры.
// В исходной таблице кодов строки с подобранными кодами отмечаются как обработанные.
//
// Параметры:
//  КодыМаркировки		 - Структура - результат подбора (см. НовыйСведенияОМаркировке)
//  ТаблицаКодов		 - ТаблицаЗначений - таблица штрихкодов упаковок (см. РазвернутаяТаблицаУпаковок)
//  СлужебнаяИнформация	 - Структура - содержит параметры номенклатуры (см. НоваяСлужебнаяИнформацияСтроки)
//  ТребуемоеКоличество	 - Число - Количество кодов, которые нужно подобрать
//
Процедура ПодобратьКодыМаркировки(КодыМаркировки
	, РазвернутаяТаблицаУпаковок
	, СлужебнаяИнформация
	, Знач ТребуемоеКоличество
	, ПодобратьКодДляПолногоВозрата = Ложь)
	
	Для Каждого СтрокаУпаковки Из РазвернутаяТаблицаУпаковок Цикл
		
		МожноПодобратьКодПоУпаковке = МожноПодобратьКодМаркировкиПоУпаковке(СтрокаУпаковки, ТребуемоеКоличество, ПодобратьКодДляПолногоВозрата);
		
		Если НЕ МожноПодобратьКодПоУпаковке Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.Номенклатура <> СлужебнаяИнформация.Номенклатура Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.ИспользоватьХарактеристики
			И СтрокаУпаковки.Характеристика <> СлужебнаяИнформация.Характеристика Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаУпаковки.ИспользоватьСерии
			И ЗначениеЗаполнено(СлужебнаяИнформация.Серия)
			И СтрокаУпаковки.Серия <> СлужебнаяИнформация.Серия Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеШК = СтрокаУпаковки.ЗначениеШтрихкода; 
		
		Если ЗначениеЗаполнено(ЗначениеШК) Тогда
			
			ВидУпаковки = СтрокаУпаковки.ВидУпаковки;
			
			Если ВидУпаковки = УпаковкаЛогистическая() Тогда
				КодыМаркировки.ТранспортныеУпаковки.Добавить(ЗначениеШК);
			ИначеЕсли ВидУпаковки = УпаковкаГрупповая()
				ИЛИ ВидУпаковки = УпаковкаОбъемноСортовойУчет() Тогда
				КодыМаркировки.ИндивидуальныеУпаковки.Добавить(ЗначениеШК);
			Иначе
				КодыМаркировки.КонтрольныеИдентификационныеЗнаки.Добавить(ЗначениеШК);
			КонецЕсли;
			
			ТребуемоеКоличество = ТребуемоеКоличество - 1;
			
		КонецЕсли;
		
		СтрокаУпаковки.Обработан = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Функция МожноПодобратьКодМаркировкиПоУпаковке(СтрокаУпаковки, ТребуемоеКоличество, ПодобратьКодДляПолногоВозрата)
	
	Результат = Истина;
	
	Если СтрокаУпаковки.Обработан Тогда
		
		Результат = Ложь;
		
	ИначеЕсли ПодобратьКодДляПолногоВозрата 
		И ТребуемоеКоличество = 0 Тогда
		
		ЭтоОСУ = СтрокаУпаковки.ВидУпаковки = УпаковкаОбъемноСортовойУчет();
		
		Если НЕ ЭтоОСУ Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли ТребуемоеКоличество <= 0 Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьКодОСУИзGTIN(КоличествоТовара, СтрокаУпаковки)
	
	Если СтрокаУпаковки.КоличествоВПотребительскойУпаковке = 0 Тогда
		КоличествоПоТегу37 = 0;
	Иначе
		КоличествоПоТегу37 = Окр(КоличествоТовара / СтрокаУпаковки.КоличествоВПотребительскойУпаковке);
	КонецЕсли;
	
	Результат = НовыйКодОСУ(СтрокаУпаковки.ЗначениеШтрихкода, КоличествоПоТегу37);
	
	Возврат Результат;
	
КонецФункции

// Переносит коды маркировки в коллекцию ItemIdentificationNumbers.
//
// Параметры:
//  ItemIdentificationNumbers - Массив - содержит структуры, соответствующие объекту ItemIdentificationNumber (см. Новый_ItemIdentificationNumber)
//  КодыМаркировки - Структура - содержит коллекции кодов маркировки (см. НовыйСведенияОМаркировке)
//
Процедура ЗаполнитьКодыМаркировкиВСтрокеКонтента(ItemIdentificationNumbers, КодыМаркировки)
	
	Для Каждого Элемент Из КодыМаркировки.ТранспортныеУпаковки Цикл
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		ИдентификационныйНомер.TransPackageId = Элемент;
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КодыМаркировки.ИндивидуальныеУпаковки) Тогда
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		
		Для Каждого Элемент Из КодыМаркировки.ИндивидуальныеУпаковки Цикл
			ИдентификационныйНомер.PackageIds.Добавить(Элемент);
		КонецЦикла;
		
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодыМаркировки.КонтрольныеИдентификационныеЗнаки) Тогда
		
		ИдентификационныйНомер = Новый_ItemIdentificationNumber();
		
		Для Каждого Элемент Из КодыМаркировки.КонтрольныеИдентификационныеЗнаки Цикл
			ИдентификационныйНомер.Units.Добавить(Элемент);
		КонецЦикла;
		
		ItemIdentificationNumbers.Добавить(ИдентификационныйНомер);
		
	КонецЕсли;
	
КонецПроцедуры

// Конструктор таблицы кодов маркировки, развернутой по номенклатуре.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица упаковок с товарными данными:
//   * Ссылка             - Произвольный - объект-владелец штрихкода - исходная колонка
//   * Номенклатура       - ОпределяемыйТип.Номенклатура - содержимое
//   * Характеристика     - ОпределяемыйТип.ХарактеристикаНоменклатуры - содержимое
//   * Серия              - ОпределяемыйТип.СерияНоменклатуры - содержимое
//   * ЗначениеШтрихкода  - Строка - текстовое представление исходного штрихкода для передачи в ЭДО
//   * ВидУпаковки        - Строка - вид упаковки номенклатуры для кодировки значения штрихкода. Допустимые значения:
//                                   УпаковкаПотребительская(), УпаковкаЛогистическая(), УпаковкаГрупповая(), Неопределено.
//   * Обработан          - Булево - признак сопоставления строки товарной части документа
//
//
Функция НоваяРазвернутаяТаблицаУпаковок()
	
	ТипСтрока200 = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200));
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("Серия");
	Результат.Колонки.Добавить("ЗначениеШтрихкода", ТипСтрока200);
	Результат.Колонки.Добавить("ВидУпаковки", ТипСтрока200);
	Результат.Колонки.Добавить("Обработан", ТипБулево);
	Результат.Колонки.Добавить("ИспользоватьХарактеристики", ТипБулево);
	Результат.Колонки.Добавить("ИспользоватьСерии", ТипБулево);
	
	Возврат Результат;
	
КонецФункции

Функция ИспользоватьИнтеграционныйМодульДляЗаполненияСведенийОМаркировке()
	
