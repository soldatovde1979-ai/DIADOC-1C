#Область ПодготовкаСпискаИсходящихДокументов

// Возвращает список параметров запроса для построения списка исходящих документов.
//
// Параметры:
//  ДатаНачала		 - Дата - нижняя граница выборки документов;
//  ДатаОкончания	 - Дата - верхняя граница выборки документов;
// 
// Возвращаемое значение:
//  Структура - см. тело метода.
//
Функция ПараметрыЗапросаСпискаИсходящих(ДатаНачала, ДатаОкончания)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ДатаНачала"		, ДатаНачала);
	Результат.Вставить("ДатаОкончания"	, КонецДня(ДатаОкончания));
	Результат.Вставить("СвойствоДокументаИдентификатор"			, СвойствоДокументаИдентификатор());
	Результат.Вставить("СвойствоДокументаИдентификаторСчета"	, СвойствоДокументаИдентификаторСчета());
	Результат.Вставить("СвойствоДокументаСтатусОтправляемыхВПФ"	, СвойствоДокументаСтатусОтправляемыхВПФ());
	
	КлючиНастроек = КлючиНастроекОтправки();
	Для Каждого Элемент Из КлючиНастроек Цикл
		Результат.Вставить("КлючНастройки_" + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ФункцииЭД = ФункцииЭлектронныхДокументов();
	Для Каждого Элемент Из ФункцииЭД Цикл
		Результат.Вставить("ФункцияЭД_" + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	Для Каждого Элемент Из ВидыЭД Цикл
		Результат.Вставить("ВидыЭД_" + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ВидыОснованийСчета = ВидыОснованийСчета();
	Для Каждого Элемент Из ВидыОснованийСчета Цикл
		Результат.Вставить("ОснованиеСчета_" + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	ВидыПФ = ВидыПечатныхФорм();
	Для Каждого Элемент Из ВидыПФ Цикл
		Результат.Вставить("ВидыПФ_" + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет параметры запроса по переданной структуре.
//
// Параметры:
//  Запрос			 - Запрос - Запрос, параметры которого нужно установить;
//  ПараметрыЗапроса - Структура - содержит имена и значения устанавливаемых параметров;
//
Процедура УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса)
	
	Для Каждого Элемент Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Формирует временную таблицу НастройкиОрганизаций, которая содержит колонки:
//  * Организация - СправочникСсылка.Организации;
//  * КлючНастройкиОтправки - Строка - см. КлючиНастроекОтправки;
//  * ОснованиеФормированияСчета - Строка - см. ВидыОснованийСчета;
//  * ОтправлятьНепроведенные - Булево - Истина, если нужно отправлять непроведенные документы;
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц, содержит таблицу ТаблицаОтношений (см. ПодготовитьТаблицуПартнерскихОтношений);
//
Процедура ПодготовитьНастройкиОрганизаций(МенеджерВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Параметры.Вставить("НастройкаОтправкиПоУмолчанию", КлючНастройкиОтправкиПоУмолчанию());
	Запрос.Параметры.Вставить("ВидОснованияСчетаПоУмолчанию", ВидОснованияСчетаПоУмолчанию());
	Запрос.Параметры.Вставить("ПечатнаяФормаДляТоваровПоУмолчанию", ПечатнаяФормаДляТоваровПоУмолчанию());
	Запрос.Параметры.Вставить("ПечатнаяФормаДляУслугПоУмолчанию", ПечатнаяФормаДляУслугПоУмолчанию());
	
	Запрос.Параметры.Вставить("СвойствоОрганизацииФормироватьУПД"
		, СвойствоОрганизацииФормироватьУПД());
	
	Запрос.Параметры.Вставить("СвойствоОрганизацииОтправлятьНепроведенные"
		, СвойствоОрганизацииОтправлятьНепроведенные());
	
	Запрос.Параметры.Вставить("СвойствоОрганизацииОснованиеДляФормированияСчета"
		, СвойствоОрганизацииФормироватьСчетНаОсновании());
	
	Запрос.Параметры.Вставить("СвойствоОрганизацииПечатнаяФормаДляТоваров"
		, СвойствоОрганизацииПечатнаяФормаДляТоваров());
	
	Запрос.Параметры.Вставить("СвойствоОрганизацииПечатнаяФормаДляУслуг"
		, СвойствоОрганизацииПечатнаяФормаДляУслуг());
	
	ВидыОснованийСчета = ВидыОснованийСчета();
	Запрос.УстановитьПараметр("ДопустимыеВидыОснованийСчета", ЗначенияКоллекцииВМассив(ВидыОснованийСчета));
	
	КлючиНастроекОтправки = КлючиНастроекОтправки();
	Запрос.УстановитьПараметр("ДопустимыеНастройкиОтправки", ЗначенияКоллекцииВМассив(КлючиНастроекОтправки));
	
	ВидыПечатныхФорм = ВидыПечатныхФорм();
	Запрос.УстановитьПараметр("ДопустимыеВидыПечатныхФорм", ЗначенияКоллекцииВМассив(ВидыПечатныхФорм));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	Таблица.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ЗначенияСвойстваНастройкаФорматовОтправки.Значение В (&ДопустимыеНастройкиОтправки)
	|			ТОГДА ЗначенияСвойстваНастройкаФорматовОтправки.Значение
	|		ИНАЧЕ &НастройкаОтправкиПоУмолчанию
	|	КОНЕЦ КАК КлючНастройкиОтправки,
	|	ВЫБОР
	|		КОГДА ЗначенияСвойстваНастройкаОснованияДляФормированияСчета.Значение В (&ДопустимыеВидыОснованийСчета)
	|			ТОГДА ЗначенияСвойстваНастройкаОснованияДляФормированияСчета.Значение
	|		ИНАЧЕ &ВидОснованияСчетаПоУмолчанию
	|	КОНЕЦ КАК ОснованиеФормированияСчета,
	|	ВЫБОР
	|		КОГДА ЗначенияСвойстваПечатнаяФормаДляТоваров.Значение В (&ДопустимыеВидыПечатныхФорм)
	|			ТОГДА ЗначенияСвойстваПечатнаяФормаДляТоваров.Значение
	|		ИНАЧЕ &ПечатнаяФормаДляТоваровПоУмолчанию
	|	КОНЕЦ КАК ПечатнаяФормаДляТоваров,
	|	ВЫБОР
	|		КОГДА ЗначенияСвойстваПечатнаяФормаДляУслуг.Значение В (&ДопустимыеВидыПечатныхФорм)
	|			ТОГДА ЗначенияСвойстваПечатнаяФормаДляУслуг.Значение
	|		ИНАЧЕ &ПечатнаяФормаДляУслугПоУмолчанию
	|	КОНЕЦ КАК ПечатнаяФормаДляУслуг,
	|	ЕСТЬNULL(ЗначенияСвойстваОтправлятьНепроведенные.Значение, ЛОЖЬ) КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ НастройкиОрганизаций
	|ИЗ
	|	ТаблицаОтношений КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойстваНастройкаФорматовОтправки
	|		ПО Таблица.Организация = ЗначенияСвойстваНастройкаФорматовОтправки.Объект
	|			И (ЗначенияСвойстваНастройкаФорматовОтправки.Свойство = &СвойствоОрганизацииФормироватьУПД)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойстваОтправлятьНепроведенные
	|		ПО Таблица.Организация = ЗначенияСвойстваОтправлятьНепроведенные.Объект
	|			И (ЗначенияСвойстваОтправлятьНепроведенные.Свойство = &СвойствоОрганизацииОтправлятьНепроведенные)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойстваНастройкаОснованияДляФормированияСчета
	|		ПО Таблица.Организация = ЗначенияСвойстваНастройкаОснованияДляФормированияСчета.Объект
	|			И (ЗначенияСвойстваНастройкаОснованияДляФормированияСчета.Свойство = &СвойствоОрганизацииОснованиеДляФормированияСчета)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойстваПечатнаяФормаДляТоваров
	|		ПО Таблица.Организация = ЗначенияСвойстваПечатнаяФормаДляТоваров.Объект
	|			И (ЗначенияСвойстваПечатнаяФормаДляТоваров.Свойство = &СвойствоОрганизацииПечатнаяФормаДляТоваров)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойстваПечатнаяФормаДляУслуг
	|		ПО Таблица.Организация = ЗначенияСвойстваПечатнаяФормаДляУслуг.Объект
	|			И (ЗначенияСвойстваПечатнаяФормаДляУслуг.Свойство = &СвойствоОрганизацииПечатнаяФормаДляУслуг)";
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Уничтожает временную таблицу НастройкиОрганизаций.
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
//
Процедура УничтожитьНастройкиОрганизаций(МенеджерВТ)
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ НастройкиОрганизаций");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Формирует временную таблицу НастройкиКонтрагентов, которая содержит колонки:
//  * Контрагент - СправочникСсылка.Контрагенты;
//  * КлючНастройкиОтправки - Строка - см. КлючиНастроекОтправки;
//                          - Null	 - если для контрагента используется настройка по умолчанию;
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц, содержит таблицу ТаблицаОтношений (см. ПодготовитьТаблицуПартнерскихОтношений);
//
Процедура ПодготовитьНастройкиКонтрагентов(МенеджерВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ПустыеЗначенияНастроек = ПустыеЗначенияРеквизита("РегистрСведений.ДополнительныеСведения.Ресурс.Значение");
	
	Запрос.Параметры.Вставить("ПустыеЗначенияНастроек", ПустыеЗначенияНастроек);
	Запрос.Параметры.Вставить("СвойствоКонтрагентаФормироватьУПД"
		, СвойствоКонтрагентаФормироватьУПД());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	Таблица.Контрагент КАК Контрагент,
	|	ЗначенияСвойстваНастройкаФорматовОтправки.Значение КАК КлючНастройкиОтправки
	|ПОМЕСТИТЬ НастройкиКонтрагентов
	|ИЗ
	|	ТаблицаОтношений КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойстваНастройкаФорматовОтправки
	|		ПО Таблица.Контрагент = ЗначенияСвойстваНастройкаФорматовОтправки.Объект
	|			И (ЗначенияСвойстваНастройкаФорматовОтправки.Свойство = &СвойствоКонтрагентаФормироватьУПД)
	|			И (НЕ ЗначенияСвойстваНастройкаФорматовОтправки.Значение В (&ПустыеЗначенияНастроек))";
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Уничтожает временную таблицу НастройкиКонтрагентов.
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
//
Процедура УничтожитьНастройкиКонтрагентов(МенеджерВТ)
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ НастройкиКонтрагентов");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Формирует временную таблицу ТаблицаОтношений, которая содержит колонки:
//  * Контрагент - СправочникСсылка.Контрагенты;
//  * Организация - СправочникСсылка.Организации;
//  * ЭтоТестовыйКонтрагент - Булево - Истина, если это тестовый контрагент;
//  * ЭтоТестоваяОрганизация - Булево - Истина, если это тестовая организация;
//  * Статус - Строка - статус партнерских отношений (см. СтатусыПартнерскихОтношений);
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
//  СведенияОбОтношениях - Массив - содержит структуры с описаниями партнерских отношений;
//  Организация - ЛюбаяСсылка - значение отбора по организации
//  Контрагент - ЛюбаяСсылка - значение отбора по контрагенту
//
Процедура ПодготовитьТаблицуПартнерскихОтношений(МенеджерВТ, СведенияОбОтношениях, Организация = Неопределено, Контрагент = Неопределено)
	
	ТипВсеСсылки = ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(100);
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТаблицаОтношений = Новый ТаблицаЗначений;
	ТаблицаОтношений.Колонки.Добавить("Контрагент", ТипВсеСсылки);
	ТаблицаОтношений.Колонки.Добавить("Организация", ТипВсеСсылки);
	ТаблицаОтношений.Колонки.Добавить("ЭтоТестовыйКонтрагент", ТипБулево);
	ТаблицаОтношений.Колонки.Добавить("ЭтоТестоваяОрганизация", ТипБулево);
	ТаблицаОтношений.Колонки.Добавить("Статус", ТипСтрока);
	
	Для Каждого Элемент Из СведенияОбОтношениях Цикл
		
		НоваяСтрока = ТаблицаОтношений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
		
	КонецЦикла;
	
	УсловиеПоОрганизации = "ИСТИНА";
	Если ЗначениеЗаполнено(Организация) Тогда
		УсловиеПоОрганизации = "Т.Организация В (&Организация)";
	КонецЕсли;
	
	УсловиеПоКонтрагенту = "ИСТИНА";
	Если ЗначениеЗаполнено(Контрагент) Тогда
		УсловиеПоКонтрагенту = "Т.Контрагент В (&Контрагент)";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	*
	|ПОМЕСТИТЬ ТаблицаОтношений
	|ИЗ
	|	&ТаблицаОтношений КАК Т
	|ГДЕ
	|	&ОтборПоОрганизации
	|	И &ОтборПоКонтрагенту";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоОрганизации", УсловиеПоОрганизации);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоКонтрагенту", УсловиеПоКонтрагенту);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("ТаблицаОтношений", ТаблицаОтношений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Уничтожает временную таблицу НастройкиОрганизаций.
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
//
Процедура УничтожитьТаблицуПартнерскихОтношений(МенеджерВТ)
	
	Запрос = Новый Запрос("УНИЧТОЖИТЬ ТаблицаОтношений");
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Формирует временную таблицу НастройкиЭДО.
// Менеджер временных таблиц должен содержать следующие ВТ:
//  * НастройкиОрганизаций - см. ПодготовитьНастройкиОрганизаций;
//  * НастройкиКонтрагентов - см. ПодготовитьНастройкиКонтрагентов;
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
//
Процедура ПодготовитьНастройкиЭДО(МенеджерВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	КлючиНастроек = КлючиНастроекОтправки();
	Для Каждого Элемент Из КлючиНастроек Цикл
		Запрос.Параметры.Вставить("КлючНастройки_" + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОтношений.Организация КАК Организация,
	|	ТаблицаОтношений.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТаблицаОтношений.ЭтоТестоваяОрганизация
	|				ИЛИ ТаблицаОтношений.ЭтоТестовыйКонтрагент
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоТестоваяНастройка,
	|	НастройкиОрганизаций.ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	НастройкиОрганизаций.ПечатнаяФормаДляТоваров КАК ПечатнаяФормаДляТоваров,
	|	НастройкиОрганизаций.ПечатнаяФормаДляУслуг КАК ПечатнаяФормаДляУслуг,
	|	НастройкиОрганизаций.ОтправлятьНепроведенные КАК ОтправлятьНепроведенные,
	|	ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) КАК КлючНастройкиОтправки,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) = &КлючНастройки_СЧФДОП_820_736
	|			ИЛИ ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) = &КлючНастройки_СЧФДОП_820 
	|			ТОГДА &КлючНастройки_СЧФДОП
	|		КОГДА ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) = &КлючНастройки_СЧФ_ДОП_820_736
	|			ИЛИ ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) = &КлючНастройки_СЧФ_ДОП_820
	|			ТОГДА &КлючНастройки_СЧФ_ДОП
	|		КОГДА ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) = &КлючНастройки_СФТОРГ12АКТ_820_736
	|			ИЛИ ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки) = &КлючНастройки_СФТОРГ12АКТ_820
	|			ТОГДА &КлючНастройки_СФТОРГ12АКТ
	|		ИНАЧЕ ЕСТЬNULL(НастройкиКонтрагентов.КлючНастройкиОтправки, НастройкиОрганизаций.КлючНастройкиОтправки)
	|	КОНЕЦ КАК ФормироватьУПД
	|ПОМЕСТИТЬ НастройкиЭДО
	|ИЗ
	|	ТаблицаОтношений КАК ТаблицаОтношений
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиОрганизаций КАК НастройкиОрганизаций
	|		ПО ТаблицаОтношений.Организация = НастройкиОрганизаций.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиКонтрагентов КАК НастройкиКонтрагентов
	|		ПО ТаблицаОтношений.Контрагент = НастройкиКонтрагентов.Контрагент
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Контрагент";
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьГрузополучателя(Документ) Экспорт
	
	Если (Метаданные.Документы.Найти("РеализацияТоваровУслуг") <> Неопределено И ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг"))
		ИЛИ (Метаданные.Документы.Найти("НакладнаяНаРеализациюТорг12") <> Неопределено И ТипЗнч(Документ) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")) Тогда
		
		Если Документ.Метаданные().Реквизиты.Найти("Грузополучатель") <> Неопределено Тогда
			Грузополучатель = Документ.Грузополучатель;
		Иначе
			Грузополучатель = Документ.Контрагент;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ПредставлениеОтчетаКомиссионера = "ОтчетКомиссионераОПродажах";
		Если Метаданные.Документы.Найти(ПредставлениеОтчетаКомиссионера) = Неопределено Тогда
			ПредставлениеОтчетаКомиссионера = "ОтчетКомиссионера";
		КонецЕсли;
		
		Если (Документ.Метаданные().ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено 
			И Документ.ДокументыОснования.Количество() > 0
			И (ТипЗнч(Документ.ДокументыОснования[0].ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") 
			ИЛИ ТипЗнч(Документ.ДокументыОснования[0].ДокументОснование) = Тип("ДокументСсылка." + ПредставлениеОтчетаКомиссионера))) Тогда
			
			Если Документ.ДокументыОснования[0].ДокументОснование.Метаданные().Реквизиты.Найти("Грузополучатель") <> Неопределено Тогда
				Грузополучатель = Документ.ДокументыОснования[0].ДокументОснование.Грузополучатель;
			Иначе
				Грузополучатель = Документ.ДокументыОснования[0].ДокументОснование.Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли (ТипЗнч(Документ) = Тип("ДокументСсылка.СчетФактураВыданный")) И 
		Метаданные.Документы.Найти("НакладнаяНаРеализациюТорг12") <> Неопределено И (ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")) Тогда
		
		Если Документ.ДокументОснование.Метаданные().Реквизиты.Найти("Грузополучатель") <> Неопределено Тогда
			Грузополучатель = Документ.ДокументОснование.Грузополучатель;
		Иначе
			Грузополучатель = Документ.ДокументОснование.Контрагент;
		КонецЕсли;
		
	Иначе 
		
		Грузополучатель = Неопределено;
		
	КонецЕсли;	
	
	Возврат Грузополучатель;
	
КонецФункции

Функция ПолучитьПодразделениеПолучателя(Документ, Контрагент) Экспорт
	
	СтруктураДанных=	Новый Структура("ToDepartmentID, НаименованиеПодразделения");
	
	НаименованиеРеквизитаДоговор=	?(ПараметрыКлиентСервер.МаркерКонфигурации = "БГУ20" Или ПараметрыКлиентСервер.МаркерКонфигурации = "УТ11", "Договор", "ДоговорКонтрагента");
	Если НЕ Документ.Метаданные().Реквизиты.Найти(НаименованиеРеквизитаДоговор) = Неопределено Тогда
		
		МаршрутПоДоговору=	МетодСервера(,"ПолучитьМаршрутизациюПоДоговору", Документ[НаименованиеРеквизитаДоговор]);
		Если ЗначениеЗаполнено(МаршрутПоДоговору.ToDepartmentID) Тогда
			
			СтруктураДанных.Вставить("ToDepartmentID", 				МаршрутПоДоговору.ToDepartmentID);
			СтруктураДанных.Вставить("НаименованиеПодразделения", 	МаршрутПоДоговору.НаименованиеПодразделения);
			
			Возврат СтруктураДанных;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыКлиентСервер.МаркерКонфигурации = "УНФ16" Тогда
		Грузополучатель= МетодСервера("Модуль_ИнтеграцияУНФ16", "ПолучитьГрузополучателя", Документ);
	Иначе
		Грузополучатель= ПолучитьГрузополучателя(Документ);
	КонецЕсли;
	
	ТекущийКонтрагент=	Контрагент;
	Если (ЗначениеЗаполнено(Грузополучатель)) И (ТекущийКонтрагент.ИНН = Грузополучатель.ИНН) Тогда
		
		МаршрутПоГрузополучателю=	МетодСервера(,"ПолучитьМаршрутизациюПоКонтрагенту", Грузополучатель);
		Если ЗначениеЗаполнено(МаршрутПоГрузополучателю.ToDepartmentID) Тогда
			
			СтруктураДанных.Вставить("ToDepartmentID", 				МаршрутПоГрузополучателю.ToDepartmentID);
			СтруктураДанных.Вставить("НаименованиеПодразделения", 	МаршрутПоГрузополучателю.НаименованиеПодразделения);
			
			Возврат СтруктураДанных;
			
		КонецЕсли;
		
	КонецЕсли;
	
	МаршрутПоКонтрагенту=	МетодСервера(,"ПолучитьМаршрутизациюПоКонтрагенту", ТекущийКонтрагент);
	СтруктураДанных.Вставить("ToDepartmentID", 				МаршрутПоКонтрагенту.ToDepartmentID);
	СтруктураДанных.Вставить("НаименованиеПодразделения", 	МаршрутПоКонтрагенту.НаименованиеПодразделения);
	
	Возврат СтруктураДанных;
	
КонецФункции

// Возвращает строку представления суммы документа или её корректировки
//
// Параметры:
//  СуммаДокумента  - Число - сумма документа
//  СуммаУвеличение - Число - сумма корректировки в большую сторону
//  СуммаУменьшение - Число - сумма корректировки в меньшую сторону
// 
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеСуммы(Знач СуммаДокумента
	, Знач СуммаУвеличение = Неопределено
	, Знач СуммаУменьшение = Неопределено)
	
	ФорматнаяСтрока = "ЧДЦ=2; ЧРГ=' '"; // Явно указанный разделитель групп отключает неразрывный пробел
	
	СуммаДокумента = Формат(СуммаДокумента, ФорматнаяСтрока);
	СуммаУвеличение = Формат(СуммаУвеличение, ФорматнаяСтрока);
	СуммаУменьшение = Формат(СуммаУменьшение, ФорматнаяСтрока);
	
	Если ЗначениеЗаполнено(СуммаУвеличение) И ЗначениеЗаполнено(СуммаУменьшение) Тогда
		
		Результат = "+" + СуммаУвеличение + " -" + СуммаУменьшение;
		
	ИначеЕсли ЗначениеЗаполнено(СуммаУвеличение) Тогда
		
		Результат = "+" + СуммаУвеличение;
		
	ИначеЕсли ЗначениеЗаполнено(СуммаУменьшение) Тогда
		
		Результат = "-" + СуммаУменьшение;
		
	Иначе
		
		Результат = СуммаДокумента;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТаблицыДляВыгрузкиВДиадок(ДатаНачала, ДатаОкончания
			, ТипыДокументов
			, Организации
			, Контрагенты
			, СведенияОПартнерскихОтношениях
			, ДопПараметрыЗапросаРасширение = Неопределено
			, ВызовИзРасширения = Ложь
			, НеИспользуется_ПользовательАвторизованПоСертификату = Ложь) Экспорт
	
	Если ВызовИзРасширения Тогда
		
		// Дополним параметры, которые нужны функции СформироватьТЗВыгрузкиВДиадок_ПакетныйРежим, но не переданы сюда на входе 
		// Предполагаем, что ПараметрыРасширения - Структура, где Значения являются ссылками на документы или Неопределено
		
		Для Каждого КлючИЗначение Из ДопПараметрыЗапросаРасширение Цикл
			
			Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				
				ДатаНачала		= НачалоДня(КлючИЗначение.Значение.Дата);
				ДатаОкончания	= КонецДня(КлючИЗначение.Значение.Дата);
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ТипыДокументов = "";
		
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	ПодготовитьТаблицуПартнерскихОтношений(МенеджерВТ, СведенияОПартнерскихОтношениях, Организации, Контрагенты);
	
	// Настройки ЭДО
	ПодготовитьНастройкиОрганизаций(МенеджерВТ);
	ПодготовитьНастройкиКонтрагентов(МенеджерВТ);
	ПодготовитьНастройкиЭДО(МенеджерВТ);
	
	// Уничтожить ненужные таблицы
	УничтожитьНастройкиОрганизаций(МенеджерВТ);
	УничтожитьНастройкиКонтрагентов(МенеджерВТ);
	УничтожитьТаблицуПартнерскихОтношений(МенеджерВТ);
	
	ПараметрыЗапросаСписка = ПараметрыЗапросаСпискаИсходящих(ДатаНачала, ДатаОкончания);
	
	СтруктТаблицыДляВыгрузки = СформироватьТаблицыДляВыгрузкиВДиадок_ПакетныйРежим(МенеджерВТ
		, ПараметрыЗапросаСписка
		, ТипыДокументов);
	
	ТЗ = СтруктТаблицыДляВыгрузки.ТаблицаВыгрузки;
	
	Если ВызовИзРасширения Тогда
		
		// Теперь надо отфильтровать ТЗ по документам, переданным в ДопПараметрыЗапросаРасширение.
		// Получаем избыточность в запросах внутри СформироватьТЗВыгрузкиВДиадок_ПакетныйРежим,
		//   но выигрываем в поддержке данного кода.
		// В будущем можно оптимизировать, передавая ссылки на конкретные документы в явном виде в конечные запросы.
		
		НайденныеСтроки = Новый Массив;
		Для Каждого КлючИЗначение Из ДопПараметрыЗапросаРасширение Цикл
			
			Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				
				СтрокиТаблицыВыгрузки = ТЗ.НайтиСтроки(Новый Структура("Документ", КлючИЗначение.Значение));
				Для Каждого СтрокаТаблицыВыгрузки Из СтрокиТаблицыВыгрузки Цикл
					НайденныеСтроки.Добавить(СтрокаТаблицыВыгрузки);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктТаблицыДляВыгрузки.ТаблицаВыгрузки = ТЗ.Скопировать(НайденныеСтроки);
		
	КонецЕсли;
	
	ПараметрыСобытияПМ = Новый Структура;
	ПараметрыСобытияПМ.Вставить("МассивОрганизаций"	, Организации);
	ПараметрыСобытияПМ.Вставить("МассивКонтрагентов", Контрагенты);
	ПараметрыСобытияПМ.Вставить("ДатаНачала"		, ДатаНачала);
	ПараметрыСобытияПМ.Вставить("ДатаОкончания"		, ДатаОкончания);
	ПараметрыСобытияПМ.Вставить("ТипыДокументов"	, ТипыДокументов);
	ПараметрыСобытияПМ.Вставить("ТаблицаДокументов"	, СтруктТаблицыДляВыгрузки.ТаблицаВыгрузки);
	ПараметрыСобытияПМ.Вставить("ТаблицаСвязей"		, СтруктТаблицыДляВыгрузки.ТаблицаСвязей);
	
	МетодСервера(, "ОбработкаСобытияПодключаемогоМодуля", "ПослеПолученияТаблицыДокументовДляОтправки", ПараметрыСобытияПМ);
	
	Возврат СтруктТаблицыДляВыгрузки;
	
КонецФункции

Процедура ДобавитьСтрокуТаблицыИсходящихДокументов(ИсходящиеДокументы, Выборка, КэшПравил)
	
	Попытка
		
		ФорматЭД = ФорматОтправкиДокумента(Выборка.КлючНастройкиОтправки
			, Выборка.ВидЭД
			, Выборка.ФункцияУПД
			, Выборка.ЭтоИсправление
			, КэшПравил);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		
		СсылкаНаОбъект = Выборка.Документ;
		ШаблонКомментария = "Не удалось определить формат отправки по причине: %1";
		КомментарийЖР = СтрШаблон(ШаблонКомментария, ПодробноеПредставлениеОшибки(Ошибка));
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации()
			, УровеньЖурналаРегистрации.Ошибка
			, СсылкаНаОбъект.Метаданные()
			, СсылкаНаОбъект
			, КомментарийЖР);
		
		ШаблонСообщения = "Не удалось определить формат отправки документа %1
		|Подробности в журнале регистрации.";
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(ШаблонСообщения, Строка(СсылкаНаОбъект));
		Сообщение.Сообщить(); 
		
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ФорматЭД) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = ИсходящиеДокументы.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
	
	ЗаполнитьПредставлениеСуммыВСтрокеСпискаДокументовНаОтправку(СтрокаТаблицы);
	
	СтрокаТаблицы.ФорматОтправки = ФорматЭД;
	СтрокаТаблицы.DocumentType = ФорматЭД.DocumentType;
	СтрокаТаблицы.ТипДокумента = ФорматЭД.Представление;
	
	Если ТекущаяДатаСеанса() > ФорматЭД.ПриказОбУтверждении.ДатаОкончанияДействия Тогда
		СтрокаТаблицы.УстаревшийФормат = Истина;
	КонецЕсли;
	
	СтрокаТаблицы.CounteragentID = МетодСервера(, "Контрагент_2_CounteragentBoxID", СтрокаТаблицы.Контрагент);
	Если СтрокаТаблицы.ЭтоТестовыйДок Тогда
		СтрокаТаблицы.ТипДокумента  = СтрокаТаблицы.ТипДокумента + " (тестовый)";
	КонецЕсли;
	
	СтрокаТаблицы.ДокВыгружен = ЗначениеЗаполнено(СтрокаТаблицы.ID);
	
	ДанныеДляМаршрутизации = ПолучитьПодразделениеПолучателя(СтрокаТаблицы.Документ, СтрокаТаблицы.Контрагент);
	СтрокаТаблицы.НаименованиеПодразделения	 = ДанныеДляМаршрутизации.НаименованиеПодразделения;
	СтрокаТаблицы.ToDepartmentID			 = ДанныеДляМаршрутизации.ToDepartmentID;
	
	СтрокаТаблицы.ВидДокумента = СтрокаТаблицы.Документ.Метаданные().Представление();
	
	ШаблонКлючей = МетодСервера(, "ПолучитьШаблонКлючейДопСведений", СтрокаТаблицы.CounteragentID, СтрокаТаблицы.DocumentType); 
	Если ЗначениеЗаполнено(ШаблонКлючей) = Истина Тогда
		СтрокаТаблицы.ДопПоле = ПолучитьСтрокуКлючЗначение(СтрокаТаблицы.Организация, СтрокаТаблицы.DocumentType, ШаблонКлючей);
	КонецЕсли;
	СтрокаТаблицы.ТребуетсяКлючЗначение = Истина;
	
	СтрокаТаблицы.ПропускатьПриВыгрузке = Ложь;
	СтрокаТаблицы.СвязующийИдентификаторСтроки = Новый УникальныйИдентификатор;
	
	Если СтрокаТаблицы.Проведен Тогда
		СтрокаТаблицы.СостояниеДокумента = 2;
	Иначе
		СтрокаТаблицы.СостояниеДокумента = 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПредставлениеСуммыВСтрокеСпискаДокументовНаОтправку(СтрокаСписка)
	
	СуммаДокумента = СтрокаСписка.СуммаДокументаЗначение;
	СуммаНДСДокумента = СтрокаСписка.СуммаНДСЗначение;
	
	СуммаУвеличение = 0;
	СуммаУменьшение = 0;
	СуммаНДСУвеличение = 0;
	СуммаНДСУменьшение = 0;
	
	Если СтрокаСписка.Тип = "СчетФактураВыданный" Тогда
		
		ПараметрыСФ = МетодСервера(ИмяМодуляИнтеграции(), "ПараметрыСчетаФактуры", СтрокаСписка.Документ);
		
		Если ПараметрыСФ <> Неопределено Тогда
			
			СуммаДокумента = ПараметрыСФ.СуммаДокумента;
			СуммаУвеличение = ПараметрыСФ.СуммаУвеличение;
			СуммаУменьшение = ПараметрыСФ.СуммаУменьшение;
			
			СуммаНДСДокумента = ПараметрыСФ.СуммаНДСДокумента;
			СуммаНДСУвеличение = ПараметрыСФ.СуммаНДСУвеличение;
			СуммаНДСУменьшение = ПараметрыСФ.СуммаНДСУменьшение;
			
		КонецЕсли;
		
	ИначеЕсли СтрокаСписка.Тип = "СчетНаОплату" Тогда
		
		ПараметрыСчета = МетодСервера(ИмяМодуляИнтеграции(), "ПараметрыСчетаНаОплату", СтрокаСписка.Документ);
		
		Если ПараметрыСчета <> Неопределено Тогда
			
			СуммаДокумента = ПараметрыСчета.СуммаДокумента;
			СуммаНДСДокумента = ПараметрыСчета.СуммаНДСДокумента;
			
		КонецЕсли;
		
	Иначе
		
		СуммаДокумента = СтрокаСписка.СуммаДокументаЗначение;
		СуммаНДСДокумента = СтрокаСписка.СуммаНДСЗначение;
		
	КонецЕсли;
	
	СтрокаСписка.СуммаДокумента = ПредставлениеСуммы(СуммаДокумента, СуммаУвеличение, СуммаУменьшение);
	СтрокаСписка.СуммаНДС = ПредставлениеСуммы(СуммаНДСДокумента, СуммаНДСУвеличение, СуммаНДСУменьшение);
	
КонецПроцедуры

Функция СформироватьТаблицыДляВыгрузкиВДиадок_ПакетныйРежим(МенеджерВТ, ПараметрыЗапроса, ТипыДокументов)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	УстановитьПараметрыЗапроса(Запрос, ПараметрыЗапроса);
	
	МассивВременныхТаблиц = МетодСервера(ПараметрыКлиентСервер.ИмяФормыИнтеграции
		, "ПодготовитьВТДляСпискаОтправкиДокументов"
		, ТипыДокументов
		, Запрос);
	
	Запрос.Текст = ТаблицаВыгрузки_ПодготовитьИтоговыйТекстЗапроса(МассивВременныхТаблиц);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Запрос.Текст = ТаблицаСвязей_ПодготовитьТекстЗапроса(МассивВременныхТаблиц);
	ТаблицаСвязей = Запрос.Выполнить().Выгрузить();
	
	Запрос.МенеджерВременныхТаблиц.Закрыть();
	Запрос = Неопределено;
	
	ИсходящиеДокументы = ВернутьЗаготовкуРезультирующейТаблицы(РезультатЗапроса);
	
	Выборка = РезультатЗапроса.Выбрать();
	РезультатЗапроса = Неопределено;
	
	КэшПравил = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		ДобавитьСтрокуТаблицыИсходящихДокументов(ИсходящиеДокументы
			, Выборка
			, КэшПравил);
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаВыгрузки", ИсходящиеДокументы);
	Результат.Вставить("ТаблицаСвязей"	, ТаблицаСвязей);
	
	Возврат Результат;
	
КонецФункции

Функция ТаблицаВыгрузки_ПодготовитьИтоговыйТекстЗапроса(МассивВременныхТаблиц)
	
	ТекстЗапроса=	"";
	Разделитель=	"";
	
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ
	|	Т.Документ КАК Документ,
	|	ВЫБОР
	|		КОГДА Т.ВидЭД = &ВидыЭД_ТоварнаяНакладная И НастройкиОбмена.ПечатнаяФормаДляТоваров = &ВидыПФ_Акт
	|			ТОГДА &ВидыЭД_АктОбОказанииУслуг
	|		КОГДА Т.ВидЭД = &ВидыЭД_АктОбОказанииУслуг И НастройкиОбмена.ПечатнаяФормаДляУслуг = &ВидыПФ_Торг12
	|			ТОГДА &ВидыЭД_ТоварнаяНакладная
	|		ИНАЧЕ Т.ВидЭД
	|	КОНЕЦ КАК ВидЭД,
	|	Т.ЭтоИсправление КАК ЭтоИсправление,
	|	Т.ЭтоКорректировка КАК ЭтоКорректировка,
	|	Т.Организация КАК Организация,
	|	Т.Контрагент КАК Контрагент,
	|	Т.СуммаДокументаЗначение КАК СуммаДокументаЗначение,
	|	Т.Валюта КАК Валюта,
	|	Т.ID_ КАК ID,
	|	Т.СостояниеОтправкиДополнительныхВПФ КАК СостояниеОтправкиДополнительныхВПФ,
	|	Т.Проведен КАК Проведен,
	|	Т.Дата КАК Дата,
	|	Т.Номер КАК Номер,
	|	Т.СуммаНДСТовары КАК СуммаНДСТовары,
	|	Т.СуммаНДСУслуги КАК СуммаНДСУслуги,
	|	Т.СуммаНДСТовары + Т.СуммаНДСУслуги КАК СуммаНДСЗначение,
	|	Т.Тип КАК Тип,
	|	Т.ФункцияУПД КАК ФункцияУПД,
	|	НастройкиОбмена.ЭтоТестоваяНастройка КАК ЭтоТестовыйДок,
	|	НастройкиОбмена.КлючНастройкиОтправки КАК КлючНастройкиОтправки
	|ИЗ
	|	&ИмяВременнойТаблицы КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиЭДО КАК НастройкиОбмена
	|		ПО Т.Организация = НастройкиОбмена.Организация
	|			И Т.Контрагент = НастройкиОбмена.Контрагент";
	
	Для Каждого ИмяВременнойТаблицы Из МассивВременныхТаблиц Цикл
		
		Если Лев(ИмяВременнойТаблицы, 6) = "Связь_" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + Разделитель
		+ СтрЗаменить(ШаблонТекстаЗапроса, "&ИмяВременнойТаблицы", ИмяВременнойТаблицы);
		
		Разделитель = РазделительОбъединенияЗапросов();
		
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НастройкиЭДО";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТаблицаСвязей_ПодготовитьТекстЗапроса(МассивВременныхТаблиц)
	
	ТекстЗапроса	= "";
	Разделитель		= "";
	ТекстПоместить	= "ПОМЕСТИТЬ ВТ_Объединение";
	
	Для Каждого ИмяВременнойТаблицы Из МассивВременныхТаблиц Цикл
		
		Если НЕ Лев(ИмяВременнойТаблицы, 6) = "Связь_" Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + Разделитель + 
		"ВЫБРАТЬ
		|	Документ,
		|	ДокументСвязь
		|"+ТекстПоместить+"
		|ИЗ
		|	" + ИмяВременнойТаблицы + " КАК Т";
		
		Разделитель		= РазделительОбъединенияЗапросов();
		ТекстПоместить	= "";
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Документ КАК Документ,
		|	ВТ1.Документ КАК ДокументСвязь
		|ИЗ
		|	ВТ_Объединение КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Объединение КАК ВТ1
		|		ПО ВТ.Документ = ВТ1.ДокументСвязь
		|
		|	ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВТ.Документ,
		|	ВТ1.Документ
		|ИЗ
		|	ВТ_Объединение КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Объединение КАК ВТ1
		|		ПО ВТ.ДокументСвязь = ВТ1.ДокументСвязь
		|			И ВТ.Документ <> ВТ1.Документ
		|			И ВТ.ДокументСвязь <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_Объединение";
		
	Иначе
		
		ТекстЗапроса = 		
		"ВЫБРАТЬ
		| NULL КАК Документ,
		| NULL КАК ДокументСвязь
		|ГДЕ
		| ЛОЖЬ";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

