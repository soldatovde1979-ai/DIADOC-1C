// 
// Возвращаемое значение:
//  Строка.
//
Функция ТипДокументаКомпоненты(ИмяТипа)
	
	ТипыДокументов = ИдентификаторыТиповДокументов();
	
	Результат = ИмяТипа;
	
	Если ИмяТипа = ТипыДокументов.ProformaInvoice Тогда
		Результат = "NonformalizedProforma";
	КонецЕсли;
	
	Возврат Результат;
	
