// Описывает значения псевдоперечисления ТипыНалогообложенияНДС.
// 
// Возвращаемое значение:
//  Структура - значения и представления значений перечисления.
//
Функция Перечисление_ТипыНалогообложенияНДС()
	
	ЗначенияПеречисления = Новый Структура;
	ЗначенияПеречисления.Вставить("ПродажаОблагаетсяНДС"	, "Продажа облагается НДС");		 // Есть строки с суммой НДС, отличной от нуля.
	ЗначенияПеречисления.Вставить("ПродажаНеОблагаетсяНДС"	, "Продажа не облагается НДС");		 // Все строки по ставке "Без НДС"
	ЗначенияПеречисления.Вставить("ПродажаНаЭкспорт"		, "Продажа на экспорт (ставка 0%)"); // Все строки по ставке "0%"
