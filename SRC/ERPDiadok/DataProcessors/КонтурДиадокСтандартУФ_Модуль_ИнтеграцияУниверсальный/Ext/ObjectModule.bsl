#Область ТаблицаДокументовНаОтправку

// Возвращает таблицу исходящих документов.
// Для построения таблицы формируется тестовая таблица НастройкиЭДО,
// в которую входят все организации и контрагенты информационной базы.
//
// Параметры:
//  НачалоПериода			 - Дата - нижняя граница выборки документов;
//  КонецПериода			 - Дата - верхняя граница выборки документов;
//  КлючНастройкиОтправки	 - Строка - см. КлючиНастроекОтправки;
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица, которая используется для отображения в форме ФормаВыгрузка.
//
Функция Тест_ТаблицаИсходящихДокументов(НачалоПериода, КонецПериода, КлючНастройкиОтправки) Экспорт
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	// Сформировать ВТ НастройкиОрганизаций с заданным ключом настройки отправки
	Тест_ПодготовитьНастройкиОрганизаций(МенеджерВТ, КлючНастройкиОтправки);
	
	// Сформировать ВТ НастройкиКонтрагентов
	Тест_ПодготовитьНастройкиКонтрагентов(МенеджерВТ);
	
	// Сформировать ВТ ТаблицаОтношений
	Тест_ПодготовитьТаблицуПартнерскихОтношений(МенеджерВТ);
	
	// Сформировать ВТ НастройкиЭДО
	ПодготовитьНастройкиЭДО(МенеджерВТ);
	
	// Уничтожить ненужные таблицы
	УничтожитьНастройкиОрганизаций(МенеджерВТ);
	УничтожитьНастройкиКонтрагентов(МенеджерВТ);
	УничтожитьТаблицуПартнерскихОтношений(МенеджерВТ);
	
	КлючНастройкиОтбораПоТипам = "";
	
	ПараметрыЗапросаСписка = ПараметрыЗапросаСпискаИсходящих(НачалоПериода, КонецПериода);
	
	ДанныеДляВыгрузки = СформироватьТаблицыДляВыгрузкиВДиадок_ПакетныйРежим(МенеджерВТ
							, ПараметрыЗапросаСписка
							, КлючНастройкиОтбораПоТипам);
	
	Результат = ДанныеДляВыгрузки.ТаблицаВыгрузки;
	
	Возврат Результат;
	
КонецФункции

// Формирует временную таблицу НастройкиОрганизаций для автотестов.
// Описание таблицы см. в процедуре ПодготовитьНастройкиОрганизаций.
//
// Параметры:
//  МенеджерВТ				 - МенеджерВременныхТаблиц	 - менеджер временных таблиц;
//  КлючНастройкиОтправки	 - Строка - см. КлючиНастроекОтправки;
//
Процедура Тест_ПодготовитьНастройкиОрганизаций(МенеджерВТ, КлючНастройкиОтправки)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.Ссылка КАК Организация,
	|	&КлючНастройкиОтправки КАК КлючНастройкиОтправки,
	|	&ОснованиеФормированияСчета КАК ОснованиеФормированияСчета,
	|	&ПечатнаяФормаДляТоваров КАК ПечатнаяФормаДляТоваров,
	|	&ПечатнаяФормаДляУслуг КАК ПечатнаяФормаДляУслуг,
	|	&ОтправлятьНепроведенные КАК ОтправлятьНепроведенные
	|ПОМЕСТИТЬ НастройкиОрганизаций
	|ИЗ
	|	Справочник.Организации КАК Таблица
	|ГДЕ
	|	НЕ Таблица.ПометкаУдаления";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Запрос.Параметры.Вставить("КлючНастройкиОтправки"		, КлючНастройкиОтправки);
	Запрос.Параметры.Вставить("ОснованиеФормированияСчета"	, ВидОснованияСчетаПоУмолчанию());
	Запрос.Параметры.Вставить("ПечатнаяФормаДляТоваров"		, ПечатнаяФормаДляТоваровПоУмолчанию());
	Запрос.Параметры.Вставить("ПечатнаяФормаДляУслуг"		, ПечатнаяФормаДляУслугПоУмолчанию());
	Запрос.Параметры.Вставить("ОтправлятьНепроведенные"		, Ложь);
	
	Запрос.Выполнить();
	
КонецПроцедуры

// Формирует временную таблицу НастройкиКонтрагентов для автотестов.
// Описание таблицы см. в процедуре ПодготовитьНастройкиКонтрагентов.
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
//
Процедура Тест_ПодготовитьНастройкиКонтрагентов(МенеджерВТ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.Ссылка КАК Контрагент,
	|	NULL КАК КлючНастройкиОтправки
	|ПОМЕСТИТЬ НастройкиКонтрагентов
	|ИЗ
	|	Справочник.Контрагенты КАК Таблица
	|ГДЕ
	|	НЕ Таблица.ПометкаУдаления
	|	И &УсловиеЭтоГруппа";
	
	УсловиеЭтоГруппа = "ИСТИНА";
	Если Метаданные.Справочники.Контрагенты.Иерархический Тогда
		УсловиеЭтоГруппа = "НЕ Таблица.ЭтоГруппа";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеЭтоГруппа", УсловиеЭтоГруппа);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Выполнить();
	
КонецПроцедуры

// Формирует временную таблицу ТаблицаОтношений для автотестов.
// Описание таблицы см. в процедуре ПодготовитьТаблицуПартнерскихОтношений.
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - менеджер временных таблиц;
// 
Процедура Тест_ПодготовитьТаблицуПартнерскихОтношений(МенеджерВТ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВсеОрганизации.Организация КАК Организация,
	|	ВсеКонтрагенты.Контрагент КАК Контрагент,
	|	ИСТИНА КАК ЭтоТестоваяОрганизация,
	|	ИСТИНА КАК ЭтоТестовыйКонтрагент,
	|	&СтатусОтношений КАК Статус
	|ПОМЕСТИТЬ ТаблицаОтношений
	|ИЗ
	|	НастройкиОрганизаций КАК ВсеОрганизации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиКонтрагентов КАК ВсеКонтрагенты
	|		ПО (ИСТИНА)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СтатусОтношений", СтатусДействующихПартнерскихОтношений());
	Запрос.Выполнить();
	
КонецПроцедуры

#КонецОбласти

