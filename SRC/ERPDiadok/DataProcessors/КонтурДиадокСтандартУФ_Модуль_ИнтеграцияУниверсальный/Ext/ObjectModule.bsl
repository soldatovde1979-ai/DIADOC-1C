Функция ВыборкаОбъектовПоПараметрамПоиска(ОписаниеОбъектаМетаданных, ПоляПоиска, ИгнорироватьПустыеЗначения = Истина)
	
	Результат = Новый Массив;
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ
	|	Таблица.Ссылка КАК Ссылка
	|ИЗ
	|	&ПолноеИмяТаблицы КАК Таблица
	|ГДЕ
	|	НЕ Таблица.ПометкаУдаления";
	
	ТекстЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, "&ПолноеИмяТаблицы", ОбъектМетаданных.ПолноеИмя());
	
	Запрос = Новый Запрос;
	
	Для Каждого Элемент Из ПоляПоиска Цикл 
		
		КлючПоиска	 = Элемент.Ключ;
		Значение	 = Элемент.Значение;
		ИмяРеквизита = КлючПоиска;
		
		// Нормализуем значение
		Если ТипЗнч(Значение) = Тип("Строка") Тогда 
			Значение = СокрЛП(Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда 
			Значение = НачалоДня(Значение);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Значение) И ИгнорироватьПустыеЗначения Тогда 
			Продолжить;
		КонецЕсли;
		
		ВыражениеСправа = ПодставитьПараметрыВСтроку("&%1", ИмяРеквизита);
		
		Если ЭтоСтроковыйРеквизитНеограниченнойДлины(ОбъектМетаданных, ИмяРеквизита) Тогда 
			
			ВыражениеСлева = ПодставитьПараметрыВСтроку("ВЫРАЗИТЬ(Таблица.%1 КАК СТРОКА(%2))"
								, ИмяРеквизита
								, Формат(СтрДлина(Значение), "ЧГ=0"));
			
		ИначеЕсли ЭтоРеквизитТипаДатаВремя(ОбъектМетаданных, ИмяРеквизита) Тогда
			
			ВыражениеСлева = ПодставитьПараметрыВСтроку("НАЧАЛОПЕРИОДА(Таблица.%1, ДЕНЬ)", ИмяРеквизита);
			
		Иначе 
			
			ВыражениеСлева = ПодставитьПараметрыВСтроку("Таблица.%1", ИмяРеквизита);
			
		КонецЕсли;
		
		ТекстЗапроса = ПодставитьПараметрыВСтроку("%1 И %2 = %3", ТекстЗапроса, ВыражениеСлева, ВыражениеСправа);
		
		Запрос.УстановитьПараметр(ИмяРеквизита, Значение);
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСчетФактура(СсылкаНаОбъект)
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	ВидыЭД = ВидыЭлектронныхДокументов();
	
	ВидыСФ = Новый Массив;
	ВидыСФ.Добавить(ВидыЭД.СчетФактура);
	ВидыСФ.Добавить(ВидыЭД.КорректировочныйСчетФактура);
	
	МетаданныеСчетовФактур = МетаданныеПоВидуЭД(ВидыСФ, Истина, Истина);
	
	Результат = МетаданныеСчетовФактур.Найти(МетаданныеОбъекта) <> Неопределено;
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных)
	
	ОбъектМетаданных = Неопределено;
	
	ТипОписанияОбъектаМетаданных = ТипЗнч(ОписаниеОбъектаМетаданных);
	
	Если ТипОписанияОбъектаМетаданных = Тип("Тип") Тогда 
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ОписаниеОбъектаМетаданных);
	ИначеЕсли ТипОписанияОбъектаМетаданных = Тип("Строка") Тогда 
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ОписаниеОбъектаМетаданных);
	ИначеЕсли ТипОписанияОбъектаМетаданных = Тип("ОбъектМетаданных") Тогда 
		ОбъектМетаданных = ОписаниеОбъектаМетаданных;
	КонецЕсли;
	
	Если ОбъектМетаданных = Неопределено Тогда 
		
		ОписаниеОш = ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка при выполнении функции Модуль_ИнтеграцииУниверсальный.ОбъектМетаданныхПоОписанию().
                                     |
                                     |Объект метаданных не найден:
                                     |ОписаниеОбъектаМетаданных = ""%1"" (тип ""%2"")'")
								, ОписаниеОбъектаМетаданных
								, Строка(ТипОписанияОбъектаМетаданных));
		
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	Возврат ОбъектМетаданных;
	
КонецФункции

// Создает объект ОписаниеТипов на основании описания объекта метаданных.
//
// Параметры:
//  ОписаниеОбъектаМетаданных - ОбъектМетаданных, Тип, Строка - см. функцию ОбъектМетаданныхПоОписанию;
// 
// Возвращаемое значение:
//  ОписаниеТипов.
//
Функция ОписаниеТиповПоОбъектуМетаданных(ОписаниеОбъектаМетаданных)
	
	Если ОписаниеОбъектаМетаданных = Неопределено Тогда 
		Возврат ОбщегоНазначения.ОписаниеТипаВсеСсылки();
	КонецЕсли;
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	МенеджерОбъекта	 = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбъектМетаданных.ПолноеИмя());
	ПустаяСсылка	 = МенеджерОбъекта.ПустаяСсылка();
	
	МассивТипов	 = Новый Массив;
	МассивТипов.Добавить(ТипЗнч(ПустаяСсылка));
	
	Результат = Новый ОписаниеТипов(МассивТипов);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что в описание типов реквизита входит тип Строка с неограниченной длиной.
//
// Параметры:
//  ОписаниеОбъектаМетаданных - ОбъектМетаданных, Тип, Строка - см. функцию ОбъектМетаданныхПоОписанию;
//  ИмяРеквизита - Строка - имя проверяемого реквизита;
// 
// Возвращаемое значение:
//  Булево - Истина, если в описание типов реквизита входит тип Строка с неограниченной длиной.
//
Функция ЭтоСтроковыйРеквизитНеограниченнойДлины(ОписаниеОбъектаМетаданных, ИмяРеквизита)
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
	
	Результат = Ложь;
	
	Если Реквизит <> Неопределено
		И Реквизит.Тип.СодержитТип(Тип("Строка"))
		И (Реквизит.Тип.КвалификаторыСтроки.Длина = 0) Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что в описание типов реквизита входит тип Дата, включающий дату и время.
//
// Параметры:
//  ОписаниеОбъектаМетаданных - ОбъектМетаданных, Тип, Строка - см. функцию ОбъектМетаданныхПоОписанию;
//  ИмяРеквизита - Строка - имя проверяемого реквизита;
// 
// Возвращаемое значение:
//  Булево - Истина, если в описание типов реквизита входит тип Дата, включающий дату и время.
//
Функция ЭтоРеквизитТипаДатаВремя(ОписаниеОбъектаМетаданных, ИмяРеквизита)
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
	
	Если Реквизит = Неопределено
		И ЕстьРеквизитМетаданных(ОбъектМетаданных, ИмяРеквизита, Истина) Тогда 
		Реквизит = ОбъектМетаданных.СтандартныеРеквизиты[ИмяРеквизита];
	КонецЕсли;
	
	Результат = Ложь;
	
	Если Реквизит <> Неопределено
		И Реквизит.Тип.СодержитТип(Тип("Дата"))
		И (Реквизит.Тип.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.ДатаВремя) Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что у всех элементов коллекции заполнены значения.
//
// Параметры:
//  Коллекция - Струтура, ФиксированнаяСтруктура, 
//				Соответствие, ФиксированноеСоответствие, 
//				Массив, ФиксированныйМассив,
//				СписокЗначений - проверяемая коллекция;
// 
// Возвращаемое значение:
//  Булево - Истина, если отсутствуют незаполненные значения
//
Функция ВсеПоляКоллекцииЗаполнены(Коллекция)
	
	Если Не ЗначениеЗаполнено(Коллекция) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ТипКоллекции = ТипЗнч(Коллекция);
	ПроверятьЭлемент = (ТипКоллекции = Тип("Массив") Или ТипКоллекции = Тип("ФиксированныйМассив"));
	
	Результат = Истина;
	
	Для Каждого Элемент Из Коллекция Цикл 
		
		ПроверяемоеЗначение = ?(ПроверятьЭлемент, Элемент, Элемент.Значение);
		
		Если Не ЗначениеЗаполнено(ПроверяемоеЗначение) Тогда 
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает массив и копирует в него значения элементов коллекции.
//
// Параметры:
//  Коллекция - Структура, Соответствие, СписокЗначений - коллекция элементов КлючИЗначение.
// 
// Возвращаемое значение:
//  Массив.
//
Функция ЗначенияКоллекцииВМассив(Коллекция)
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из Коллекция Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьФункцияСчетаФактуры(Знач ФункцияЭД)
	
	Результат = Ложь;
	
	ФункцияЭД = ВРег(ФункцияЭД);
	
	ПодстрокиПоиска = Новый Массив;
	ПодстрокиПоиска.Добавить("Invoice");
	ПодстрокиПоиска.Добавить("СЧФ");
	ПодстрокиПоиска.Добавить("КСЧФ");
	
	Для Каждого Подстрока Из ПодстрокиПоиска Цикл 
		
		Если Найти(ФункцияЭД, ВРег(Подстрока)) > 0 Тогда 
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьФункцияПервичногоДокумента(Знач ФункцияЭД)
	
	Результат = Ложь;
	
	ФункцияЭД = ВРег(ФункцияЭД);
	
	ПодстрокиПоиска = Новый Массив;
	ПодстрокиПоиска.Добавить("Basic");
	ПодстрокиПоиска.Добавить("ДОП");
	ПодстрокиПоиска.Добавить("ДИС");
	ПодстрокиПоиска.Добавить("СВРК");
	ПодстрокиПоиска.Добавить("СВЗК");
	ПодстрокиПоиска.Добавить("СВИСЗК");
	ПодстрокиПоиска.Добавить("СВИСРК");
	
	Для Каждого Подстрока Из ПодстрокиПоиска Цикл 
		
		Если Найти(ФункцияЭД, ВРег(Подстрока)) > 0 Тогда 
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

