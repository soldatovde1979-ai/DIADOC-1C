// Формирует и заполняет шапку с данными электронного документа.
//
// Параметры:
//  Контент - Структура - Протоструктура с содержимым документа;
// 
// Возвращаемое значение:
//  Структура - см. тело функции.
//
Функция ШапкаСчетаНаОплату(Контент)
	
	Результат = НовыйШапкаЭлектронногоДокумента();
	
	ЗаполнитьШапкуПоДаннымЭлектронногоДокумента29(Результат, Контент);
	
	Если ЗначениеЗаполнено(Контент.ProformaInvoiceAdditionalInfo.StartShipmentDate) Тогда
		Результат.Вставить("ДатаНачТов", Контент.ProformaInvoiceAdditionalInfo.StartShipmentDate);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контент.ProformaInvoiceAdditionalInfo.ShipmentTerms) Тогда
		Результат.Вставить("УсловияОказанияПоставки", Контент.ProformaInvoiceAdditionalInfo.ShipmentTerms);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контент.Buyer.Address.AddressText.AddressText) Тогда
		Результат.Покупатель.Вставить("АдрТекст", Контент.Buyer.Address.AddressText.AddressText);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контент.ProformaInvoiceAdditionalInfo.PaymentPurpose) Тогда
		Результат.Вставить("НазначениеПлатежа", Контент.ProformaInvoiceAdditionalInfo.PaymentPurpose);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контент.ProformaInvoiceAdditionalInfo.DateRestriction) Тогда
		Результат.Вставить("ЖелательнаяДатаПлатежа", Контент.ProformaInvoiceAdditionalInfo.DateRestriction);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контент.CurrencyRate) Тогда
		Результат.Вставить("КурсВалюты", Контент.CurrencyRate);
	КонецЕсли;
	
	Если Контент.ProformaInvoiceAdditionalInfo.Свойство("UniquePaymentInfo") Тогда
		Результат.Вставить("ИдентификаторПлатежа", Контент.ProformaInvoiceAdditionalInfo.UniquePaymentInfo);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет описание шапки электронного документа по контенту документа 29@.
//
// Параметры:
//  Шапка	 - Структура - см. ШапкаЭлектронногоДокумента;
//  Контент	 - Структура - Протоструктура с содержимым документа;
//
Процедура ЗаполнитьШапкуПоДаннымЭлектронногоДокумента29(Шапка, Контент)
	
	Шапка.Продавец			= КлючевыеСвойстваПродавцов29(Контент);
	Шапка.Покупатель		= КлючевыеСвойстваПокупателей29(Контент);
	Шапка.Партнер			= НовыйКлючевыеСвойстваПартнер();
	Шапка.Грузоотправитель	= КлючевыеСвойстваГрузоотправителей(Контент);
	Шапка.Грузополучатель	= КлючевыеСвойстваГрузополучателей(Контент);
	
	Получатель = КлючевыеСвойстваПолучателей29(Контент);
	Шапка.Вставить("Получатель", Получатель);
	
	Если СвойствоСтруктуры(Контент, "Currency") = Неопределено Тогда
		Валюта = НовыйКлючевыеСвойстваВалюта();
	Иначе
		Валюта = КлючевыеСвойстваВалюта(Контент.Currency);
	КонецЕсли;
	
	CurrencyRate = СвойствоСтруктуры(Контент, "CurrencyRate");
	Если ЗначениеЗаполнено(CurrencyRate) Тогда
		КурсВалюты = ПривестиКЧислу(CurrencyRate);
	Иначе
		КурсВалюты = 1;
	КонецЕсли;
	
	Шапка.Валюта			= Валюта;
	Шапка.Курс				= КурсВалюты;
	Шапка.Кратность			= 1;
	
	Если Контент.Свойство("DocumentDate") Тогда
		ДатаДокумента = Контент.DocumentDate;
	Иначе
		ДатаДокумента = Контент.Date;
	КонецЕсли;
	
	Шапка.Дата				= ДатаДокумента;
	
	Если Контент.Свойство("DocumentNumber") Тогда
		НомерДокумента = Контент.DocumentNumber;
	Иначе
		НомерДокумента = Контент.Number;
	КонецЕсли;
	
	Шапка.Номер				= НомерДокумента;
	
КонецПроцедуры

// Заполняет описание шапки электронного документа по контенту.
//
// Параметры:
//  Шапка	 - Структура - см. ШапкаЭлектронногоДокумента;
//  Контент	 - Структура - Протоструктура с содержимым документа;
//
Процедура ЗаполнитьШапкуПоДаннымЭлектронногоДокумента(Шапка, Контент)
	
	Шапка.Продавец			= КлючевыеСвойстваПродавцов(Контент);
	Шапка.Покупатель		= КлючевыеСвойстваПокупателей(Контент);
	Шапка.Партнер			= НовыйКлючевыеСвойстваПартнер();
	Шапка.Грузоотправитель	= КлючевыеСвойстваГрузоотправителей(Контент);
	Шапка.Грузополучатель	= КлючевыеСвойстваГрузополучателей(Контент);
	
	Если СвойствоСтруктуры(Контент, "Currency") = Неопределено Тогда
		Валюта = НовыйКлючевыеСвойстваВалюта();
	Иначе
		Валюта = КлючевыеСвойстваВалюта(Контент.Currency);
	КонецЕсли;
	
	CurrencyRate = СвойствоСтруктуры(Контент, "CurrencyRate");
	Если ЗначениеЗаполнено(CurrencyRate) Тогда
		КурсВалюты = ПривестиКЧислу(CurrencyRate);
	Иначе
		КурсВалюты = 1;
	КонецЕсли;
	
	Шапка.Валюта			= Валюта;
	Шапка.Курс				= КурсВалюты;
	Шапка.Кратность			= 1;
	
	Если Контент.Свойство("DocumentDate") Тогда
		ДатаДокумента = Контент.DocumentDate;
	Иначе
		ДатаДокумента = Контент.Date;
	КонецЕсли;
	
	Шапка.Дата				= ДатаДокумента;
	
	Если Контент.Свойство("DocumentNumber") Тогда
		НомерДокумента = Контент.DocumentNumber;
	Иначе
		НомерДокумента = Контент.Number;
	КонецЕсли;
	
	Шапка.Номер				= НомерДокумента;
	
	Шапка.НомерИсправления	= СвойствоСтруктуры(Контент, "RevisionNumber");
	Шапка.ДатаИсправления	= СвойствоСтруктуры(Контент, "RevisionDate");
	
	// Информационные поля шапки
	Если Контент.Свойство("AdditionalInfoId") Тогда
		ПрочитатьСвойства_ИнформационныеПоля(Шапка.ДопИнфо, Контент.AdditionalInfoId);
	КонецЕсли;
	
КонецПроцедуры

