// Преобразует протоструктуры со сведениями об участниках ЭДО
// в структуры с ключевыми свойствами организаций.
//
// Параметры:
//  КоллекцияУчастниковЭДО - Массив - содержит структуры, соответствующие объекту ExtendedOrganizationInfo.
// 
// Возвращаемое значение:
//  Структура - если в коллекции один элемент (см. КлючевыеСвойстваЮрФизЛицо);
//  Массив - если в коллекции несколько элементов.
//  Неопределено - если коллекция пустая
//
Функция КлючевыеСвойстваУчастниковЭДО(КоллекцияУчастниковЭДО)
	
	Если Не ЗначениеЗаполнено(КоллекцияУчастниковЭДО) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КоллекцияЮрФизЛиц = Новый Массив;
	
	Для Каждого ДанныеУчастника Из КоллекцияУчастниковЭДО Цикл
		
		ЮрФизЛицо = КлючевыеСвойстваЮрФизЛицо(ДанныеУчастника);
		КоллекцияЮрФизЛиц.Добавить(ЮрФизЛицо);
		
	КонецЦикла;
	
	Если КоллекцияЮрФизЛиц.Количество() = 1 Тогда
		Результат = КоллекцияЮрФизЛиц[0];
	Иначе
		Результат = КоллекцияЮрФизЛиц;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

