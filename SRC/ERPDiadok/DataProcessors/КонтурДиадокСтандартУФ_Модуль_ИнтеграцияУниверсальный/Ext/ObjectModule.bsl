	КонецЕсли;
	
	ПоляПоиска = КопияСтруктуры(СвойстваОбъекта, "Код");
	СвойстваОбъекта.Ссылка = СсылкаОбъектаПоПолямПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных);
	
КонецПроцедуры

// Заполняет свойство "СчетФактура" структуры "КорректируемыйДокумент".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. КлючевыеСвойстваДокументОснованиеУКД();
//
Процедура НайтиКорректируемыйСчетФактуру(СвойстваОбъекта)
	
	Если Не ЗначениеЗаполнено(СвойстваОбъекта) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваОбъекта.СчетФактура) Тогда 
		Возврат;
	КонецЕсли;
	
	СвойстваОбъекта.СчетФактура = ДокументУчетаПоРеквизитамВходящегоЭД(ВидыЭлектронныхДокументов().СчетФактура, СвойстваОбъекта);
	
КонецПроцедуры

// Заполняет свойство "ПервичныйДокумент" структуры "КорректируемыйДокумент".
//
// Параметры:
//  СвойстваОбъекта - Структура - см. КлючевыеСвойстваДокументОснованиеУКД();
//
Процедура НайтиКорректируемуюНакладную(СвойстваОбъекта)
	
	Если Не ЗначениеЗаполнено(СвойстваОбъекта) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваОбъекта.ПервичныйДокумент) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СвойстваОбъекта.СчетФактура) = Тип("Массив") И СвойстваОбъекта.СчетФактура.Количество() > 0 Тогда 
		СчетФактура = СвойстваОбъекта.СчетФактура[0];
	Иначе 
		СчетФактура = СвойстваОбъекта.СчетФактура;
	КонецЕсли;
	
	НайденныеДокументы = ДокументыОснованияСчетаФактуры(СчетФактура);
	
	Если Не ЗначениеЗаполнено(НайденныеДокументы) Тогда 
		
		НайденныеДокументы = ДокументУчетаПоРеквизитамВходящегоЭД(ВидыЭлектронныхДокументов().АктОбОказанииУслуг, СвойстваОбъекта);
		Если Не ЗначениеЗаполнено(НайденныеДокументы) Тогда 
			НайденныеДокументы = ДокументУчетаПоРеквизитамВходящегоЭД(ВидыЭлектронныхДокументов().ТоварнаяНакладная, СвойстваОбъекта);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныеДокументы) Тогда
		Результат = Неопределено;
	ИначеЕсли ТипЗнч(НайденныеДокументы) = Тип("Массив") 
		И НайденныеДокументы.Количество() = 1 Тогда 
		Результат = НайденныеДокументы[0];
	Иначе 
		Результат = НайденныеДокументы;
	КонецЕсли;
	
	СвойстваОбъекта.ПервичныйДокумент = Результат;
	
КонецПроцедуры

// Получает ссылку на объект информационной базы, связанный с участником сделки
//
// Параметры:
//  СвойстваИлиМассив - Структура, Массив из Структура - см. КлючевыеСвойстваЮрФизЛицо.
// 
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено.
//
Функция СсылкаНаУчастникаЭДО(СвойстваИлиМассив) Экспорт
	
	КоллекцияУчастниковЭДО = ЗначениеВМассиве(СвойстваИлиМассив);
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(КоллекцияУчастниковЭДО) Тогда
		ПервыйЭлемент = КоллекцияУчастниковЭДО[0];
		Результат = СвойствоСтруктуры(ПервыйЭлемент, "Ссылка");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СопоставлениеНоменклатуры

Процедура ПрочитатьСоответствиеНоменклатурыБЭД(СоответствиеНоменклатуры, ВладелецНоменклатуры, ИдентификаторыНоменклатуры)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СопоставленнаяНоменклатура.Идентификатор КАК Идентификатор,
	|	СопоставленнаяНоменклатура.Номенклатура КАК Номенклатура,
	|	СопоставленнаяНоменклатура.Характеристика КАК Характеристика,
	|	СопоставленнаяНоменклатура.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.НоменклатураКонтрагентовБЭД КАК СопоставленнаяНоменклатура
	|ГДЕ
	|	СопоставленнаяНоменклатура.Владелец = &Владелец
	|	И СопоставленнаяНоменклатура.Идентификатор В(&ИдентификаторыНоменклатуры)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Владелец", ВладелецНоменклатуры);
	Запрос.УстановитьПараметр("ИдентификаторыНоменклатуры", ИдентификаторыНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоменклатураИБ = НоваяНоменклатураИнформационнойБазы();
		ЗаполнитьЗначенияСвойств(НоменклатураИБ, Выборка);
		СоответствиеНоменклатуры.Вставить(Выборка.Идентификатор, НоменклатураИБ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьСоответствиеНоменклатурыПереопределяемый(СоответствиеНоменклатуры, ВладелецНоменклатуры, ИдентификаторыНоменклатуры, СтандартнаяОбработка)
	
	МетодСервера(ИмяМодуляИнтеграции(), "ПриЧтенииСоответствияНоменклатуры"
		, СоответствиеНоменклатуры
		, ВладелецНоменклатуры
		, ИдентификаторыНоменклатуры
		, СтандартнаяОбработка);
	
КонецПроцедуры

// Создает или обновляет запись в регистре сведений НоменклатураКонтрагентовБЭД.
//
// Параметры:
//  НоменклатураИБ					 - Структура - см. функцию НоваяНоменклатураИнформационнойБазы;
//  ВладелецНоменклатуры			 - СправочникСсылка	 - владелец номенклатуры (контрагент/партнер);
//  РеквизитыНоменклатурыКонтрагента - Структура - см. функцию НовыйКлючевыеСвойстваНоменклатураПоставщика;
//
Процедура ЗаписатьСоответствиеНоменклатурыБЭД(НоменклатураКонтрагента, НоменклатураИБ)
	
	Набор = РегистрыСведений.НоменклатураКонтрагентовБЭД.СоздатьНаборЗаписей();
	Набор.Отбор.Владелец.Установить(НоменклатураКонтрагента.Владелец);
	Набор.Отбор.Идентификатор.Установить(НоменклатураКонтрагента.Идентификатор);
	
	Запись = Набор.Добавить();
	
	ЗаполнитьЗначенияСвойств(Запись, НоменклатураКонтрагента);
	ЗаполнитьЗначенияСвойств(Запись, НоменклатураИБ);
	
	Набор.Записать();
	
КонецПроцедуры

Процедура ЗаписатьСоответствиеНоменклатурыПереопределяемый(НоменклатураКонтрагента, НоменклатураИБ, СтандартнаяОбработка)
	
	МетодСервера(ИмяМодуляИнтеграции(), "ПриЗаписиСоответствияНоменклатуры"
		, НоменклатураКонтрагента
		, НоменклатураИБ
		, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ЗаполнитьМетаданныеСопоставленияНоменклатурыКонфигурация(МетаданныеСопоставления, СтандартнаяОбработка)
	
	МетодСервера(ИмяМодуляИнтеграции(), "ПриЗаполненииМетаданныхСопоставленияНоменклатуры"
		, МетаданныеСопоставления
		, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура ЗаполнитьМетаданныеСопоставленияНоменклатурыБЭД(МетаданныеСопоставления)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.СопоставлениеНоменклатурыКонтрагентов") Тогда
		МодульСопоставленияНоменклатуры = ОбщегоНазначения.ОбщийМодуль("СопоставлениеНоменклатурыКонтрагентовСлужебный");
	Иначе
		МодульСопоставленияНоменклатуры = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиСлужебный");
	КонецЕсли;
	
	МетаданныеСопоставленияБЭД = МодульСопоставленияНоменклатуры.МетаданныеСопоставленияНоменклатуры();
	
	ЗаполнитьЗначенияСвойств(МетаданныеСопоставления, МетаданныеСопоставленияБЭД);
	
	МетаданныеСопоставления.ВладелецНоменклатурыТип = Метаданные.ОпределяемыеТипы.ВладелецНоменклатурыБЭД.Тип;
	МетаданныеСопоставления.НоменклатураТип = Новый_ТипНоменклатурыБЭДДляСопоставления(Метаданные.ОпределяемыеТипы.НоменклатураБЭД.Тип);
	МетаданныеСопоставления.ХарактеристикаТип = Метаданные.ОпределяемыеТипы.ХарактеристикаНоменклатурыБЭД.Тип;
	МетаданныеСопоставления.УпаковкаТип = Метаданные.ОпределяемыеТипы.УпаковкаНоменклатурыБЭД.Тип;
	
КонецПроцедуры

Функция Новый_ТипНоменклатурыБЭДДляСопоставления(ОписаниеТипаНоменклатураБЭД)
	
	Результат = ОписаниеТипаНоменклатураБЭД;
	
	ИмяОбъектаМетаданных = "Справочник.Номенклатура";
	Если Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМетаданных) <> Неопределено Тогда
		
		ИмяТипа			 = "СправочникСсылка.Номенклатура";
		ТипНоменклатура	 = Тип(ИмяТипа);
		
		Если ОписаниеТипаНоменклатураБЭД.СодержитТип(ТипНоменклатура) Тогда
			Результат = Новый ОписаниеТипов(ИмяТипа);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

