Функция ПредставлениеПрикладнойСтавкиНДС(СтавкаНДС) Экспорт
	
	Если ТипЗнч(СтавкаНДС) = Тип("Строка") Тогда
		
		Результат = СтавкаНДС;
		
	ИначеЕсли Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		
		Результат = "##";
		
	Иначе
		
		Если ИспользуетсяБЭД19() Тогда
			МодульБЭД = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияЭДО");
		Иначе
			МодульБЭД = ОбщегоНазначения.ОбщийМодуль("ОбменСКонтрагентамиПовтИсп");
		КонецЕсли;
		
		Результат = МодульБЭД.СтавкаНДСИзСоответствия(, СтавкаНДС);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = СокрЛП(СтавкаНДС);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РасчетноеПредставлениеСтавкиНДС(СуммаБезНалога, СуммаНалога)
	
	Если СуммаНалога = Неопределено Тогда // без НДС
		Возврат ПредставлениеСтавкиБезНДС();
	КонецЕсли;
	
	РасчетнаяСтавка = 0;
	Если ЗначениеЗаполнено(СуммаБезНалога) Тогда
		РасчетнаяСтавка = 100 * СуммаНалога / СуммаБезНалога;
	КонецЕсли;
	
	Если РасчетнаяСтавка < 5 Тогда
		Результат = "0";
	ИначеЕсли РасчетнаяСтавка < 14 Тогда
		Результат = "10";
	ИначеЕсли РасчетнаяСтавка < 19 Тогда
		Результат = "18";
	Иначе
		Результат = "20";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСтавкаБезНДС(Ставка) Экспорт
	
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(Ставка)
		Или Ставка = СтавкаБезНДС()
		Или НРег(Ставка) = НРег(ПредставлениеСтавкиБезНДС()) Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что указанное представление ставки НДС соответствует ставке "НДС исчисляется налоговым агентом".
//
// Параметры:
//  ПредставлениеСтавки - Строка - Представление ставки НДС.
// 
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоСтавкаНДСИНА(Знач ПредставлениеСтавки) Экспорт
	
	Результат = Ложь;
	
	ПредставлениеСтавки = ВРег(ПредставлениеСтавки);
	
	Если ПредставлениеСтавки = ВРег("ИсчНалАг") 
		Или ПредставлениеСтавки = ВРег("НДС исчисляется налоговым агентом") Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение ставки НДС по умолчанию.
//
// Параметры:
//  Период - Дата - дата на которую необходимо получить ставку НДС по умолчанию,
//               если дата пустая, то будет получена ставка НДС на текущую дату
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтавкиНДС, СправочникСсылка.СтавкиНДС - значение ставки НДС.
//
Функция ОбщаяСтавкаНДС(Период = Неопределено) Экспорт
	
	ДатаПолучения = ?(ЗначениеЗаполнено(Период), Период, ТекущаяДатаСеанса());
	
	Если ДатаПолучения < ДатаПримененияНДС20() Тогда
		Результат = СтавкаНДС18();
	Иначе
		Результат = СтавкаНДС20();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение расчетной ставки НДС по умолчанию.
//
// Параметры:
//  Период - Дата - дата на которую необходимо получить ставку НДС по умолчанию,
//               если дата пустая, то будет получена ставка НДС на текущую дату
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтавкиНДС, СправочникСсылка.СтавкиНДС - значение ставки НДС.
//
Функция ОбщаяРасчетнаяСтавкаНДС(Период = Неопределено) Экспорт
	
	ДатаПолучения = ?(ЗначениеЗаполнено(Период), Период, ТекущаяДатаСеанса());
	
	Если ДатаПолучения >= ДатаПримененияНДС20() Тогда
		Результат = СтавкаНДС20_120();
	Иначе
		Результат = СтавкаНДС18_118();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДатаПримененияНДС20()
	Возврат '20190101';
КонецФункции

