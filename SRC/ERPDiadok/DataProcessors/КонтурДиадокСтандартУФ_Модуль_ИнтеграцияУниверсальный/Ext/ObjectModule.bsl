// Для указанного формата электронного документа формирует
// список соответствующих ему видов первичных документов.
//
// Параметры:
//  ФорматЭД - Структура - описание формата (см. НовоеОписаниеФорматаЭлектронногоДокумента).
// 
// Возвращаемое значение:
//  Строка - вид электронного документа (см. ВидыЭлектронныхДокументов);
//  Массив - если формат можно преобразовать в несколько видов документов (см. ВидыЭлектронныхДокументов);
//  Неопределено - если формат не предполагает создание первичного документа.
//
Функция ВидПервичногоДокумента(ФорматЭД)
	
	ВидыДокументов = ВидыЭлектронныхДокументов();
	ТипыДокументов = ИдентификаторыТиповДокументов();
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	ФункцияДокумента = ФорматЭД.ФункцияДокумента;
	ВерсияФормата = ФорматЭД.ВерсияФормата;
	
	ЭтоУПД = ЭтоЭлектронныйУПД(ТипДокумента);
	ЭтоУКД = ЭтоЭлектронныйУКД(ТипДокумента);
	
	ЕстьФункцияПД = ЕстьФункцияПервичногоДокумента(ФункцияДокумента);
	
	Если ТипДокумента = ТипыДокументов.XmlTorg12 Тогда
		
		Результат = ВидыДокументов.ТоварнаяНакладная;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.XmlAcceptanceCertificate Тогда
		
		Результат = ВидыДокументов.АктОбОказанииУслуг;
		
	ИначеЕсли ЭтоУПД И ЕстьФункцияПД Тогда
		
		Результат = Новый Массив;
		Результат.Добавить(ВидыДокументов.ТоварнаяНакладная);
		Результат.Добавить(ВидыДокументов.АктОбОказанииУслуг);
		
	ИначеЕсли ЭтоУКД И ЕстьФункцияПД Тогда
		
		Результат = ВидыДокументов.СоглашениеОбИзмененииСтоимости;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.Torg2 Тогда
		
		Результат = ВидыДокументов.ДокументОРасхождениях;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.reconciliationact
		И НРег(ВерсияФормата) = "reconciliationact405_05_01_01" Тогда
		
		Результат = ВидыДокументов.АктСверки;
		
	ИначеЕсли ТипДокумента = ТипыДокументов.XmlInvoiceOffer
		Или ТипДокумента = ТипыДокументов.XmlProformaInvoice Тогда
		
		Результат = ВидыДокументов.СчетНаОплату;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Для указанного формата электронного документа получает соответствующий
// ему вид счета-фактуры.
//
// Параметры:
//  ФорматЭД - Структура - описание формата (см. НовоеОписаниеФорматаЭлектронногоДокумента).
// 
// Возвращаемое значение:
//  Строка - вид счета-фактуры (см. ВидыЭлектронныхДокументов);
//  Неопределено - если формат не предполагает создание счета-фактуры.
//
Функция ВидСчетаФактуры(ФорматЭД)
	
	ВидыДокументов = ВидыЭлектронныхДокументов();
	
	ТипДокумента = ФорматЭД.ИмяТипа;
	ФункцияДокумента = ФорматЭД.ФункцияДокумента;
	
	ЭтоУПД	 = ЭтоЭлектронныйУПД(ТипДокумента);
	ЭтоУКД	 = ЭтоЭлектронныйУКД(ТипДокумента);
	ЭтоСФ	 = ЭтоЭлектронныйСчетФактура(ТипДокумента);
	ЭтоКСФ	 = ЭтоЭлектронныйКорректировочныйСчетФактура(ТипДокумента);
	
	ЕстьФункцияСФ = ЕстьФункцияСчетаФактуры(ФункцияДокумента);
	
	Если ЭтоУПД И ЕстьФункцияСФ
		Или ЭтоСФ Тогда
		
		Результат = ВидыДокументов.СчетФактура;
		
	ИначеЕсли ЭтоУКД И ЕстьФункцияСФ
		Или ЭтоКСФ Тогда
		
		Результат = ВидыДокументов.КорректировочныйСчетФактура;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет таблицу правил обработки электронных документов.
//
// Параметры:
//  ПравилаОбработки - ТаблицаЗначений - правила обработки документов (см. ПравилаОбработкиВходящихДокументов);
//
// Пример:
//	Если ПолучитьФункциональнуюОпцию("ВедетсяПроизводственнаяДеятельность") Тогда
//		
//		ДобавитьПравилоОбработкиДокументов(ПравилоОбработки
//			, "ПоступлениеВПереработку" // Описание правила задается в процедуре ПриПолученииПравилаОбработкиЭлектронногоДокумента
//			, "ТоварнаяНакладная" 		// Используется для накладных
//			, Ложь); 					// Для исправлений не используется, только для первичных документов
//		
//	КонецЕсли;
//
Процедура ЗаполнитьПравилаОбработкиВходящихДокументов(ПравилаОбработки)
	
	МетодСервера(ИмяМодуляИнтеграции()
		, "ЗаполнитьПравилаОбработкиВходящихДокументов"
		, ПравилаОбработки);
	
КонецПроцедуры

// Обработчик получения правила отражения электронного документа в учетной системе.
//
// Параметры:
//  ПравилоОбработки	 - Структура - описание правила обработки электронного документа (см. ПравилоОбработкиЭлектронныхДокументов);
//  СтандартнаяОбработка - Булево - Истина, если специальная обработка не требуется,
//                                  а идентификатор совпадает с именем метаданных документа;
//
// Пример:
//
//	Если ПравилоОбработки.Идентификатор = "ПоступлениеВПереработку" Тогда
//		
//		СтандартнаяОбработка = Ложь;
//		
//		ДополнительныеПараметры = Новый Структура;
//		ДополнительныеПараметры.Вставить("ВидОперации", Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ВПереработку);
//		
//		ПравилоОбработки.Представление = "Поступление материалов в переработку";
//		ПравилоОбработки.ОбъектМетаданных = Метаданные.Документы.ПоступлениеТоваровУслуг.ПолноеИмя();
//		ПравилоОбработки.ДополнительныеПараметры = ДополнительныеПараметры;
//		
//	КонецЕсли;
//
Процедура ПриПолученииПравилаОбработкиЭлектронногоДокумента(ПравилоОбработки, СтандартнаяОбработка)
	
	МетодСервера(ИмяМодуляИнтеграции()
		, "ПриПолученииПравилаОбработкиЭлектронногоДокумента"
		, ПравилоОбработки
		, СтандартнаяОбработка);
	
КонецПроцедуры

// Формирует из структуры с данными электронного документа новую структуру,
// в свойствах которой вместо вложенных структур находятся значения для
// заполнения документа информационной базы.
//
// Параметры:
//  ДанныеЭД - Структура - содержит данные электронного документа;
// 
// Возвращаемое значение:
//  Структура.
//
Функция ЗначенияЗаполненияДокументаИБ(ДанныеЭД)
	
	Шапка = ДанныеЭД.Шапка;
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация", СвойствоСтруктуры(Шапка, "Покупатель.Ссылка"));
	Результат.Вставить("Контрагент"	, СвойствоСтруктуры(Шапка, "Продавец.Ссылка"));
	Результат.Вставить("Валюта"		, СвойствоСтруктуры(Шапка, "Валюта.Ссылка"));
	Результат.Вставить("ДатаВходящегоДокумента"	, Шапка.Дата);
	Результат.Вставить("НомерВходящегоДокумента", Шапка.Номер);
	
	Результат.Вставить("Грузоотправитель"	, СвойствоСтруктуры(Шапка, "Грузоотправитель.Ссылка"));
	Результат.Вставить("Грузополучатель"	, СвойствоСтруктуры(Шапка, "Грузополучатель.Ссылка"));
	Результат.Вставить("НомерИсправления"	, Шапка.НомерИсправления);
	Результат.Вставить("ДатаИсправления"	, Шапка.ДатаИсправления);
	
	Возврат Результат;
	
КонецФункции

// Формирует массив с метаданными документов, которые можно создавать по входящему ЭД.
//
// Параметры:
//  ВидЭД - Строка - см. функцию ВидыЭлектронныхДокументов;
// 
// Возвращаемое значение:
//  Массив - содержит метаданные прикладных документов.
//
Функция МетаданныеПоВидуЭД(ВидЭД, ВключаяВходящие = Истина, ВключаяИсходящие = Ложь)
	
	Если ТипЗнч(ВидЭД) = Тип("Массив") Тогда 
		КоллекцияВидовЭД = ВидЭД;
	Иначе 
		КоллекцияВидовЭД = Новый Массив;
		КоллекцияВидовЭД.Добавить(ВидЭД);
	КонецЕсли;
	
	Результат = Новый Массив;
	
	// Получим таблицу видов документов для обмена
	Если ВключаяВходящие И ВключаяИсходящие Тогда 
		ТаблицаВидов = ВсеВидыДокументовДляОбмена();
	ИначеЕсли ВключаяВходящие Тогда 
		ТаблицаВидов = ВидыВходящихДокументов();
	ИначеЕсли ВключаяИсходящие Тогда 
		ТаблицаВидов = ВидыИсходящихДокументов();
	Иначе 
		ТаблицаВидов = Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаВидов) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	КэшМетаданных = Новый Соответствие;
	
	Для Каждого Стр Из ТаблицаВидов Цикл 
		
		Если КоллекцияВидовЭД.Найти(Стр.ВидЭД) = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Если КэшМетаданных[Стр.ОбъектМетаданных] = Неопределено Тогда 
			КэшМетаданных.Вставить(Стр.ОбъектМетаданных, Истина);
			Результат.Добавить(Стр.ОбъектМетаданных);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на документ учета, подходящую по значениям реквизитов электронного документа:
// Организация, Контрагент, Дата и Номер.
//
// Параметры:
//  ВидЭД - Строка - см. функцию ВидыЭлектронныхДокументов;
//  ПараметрыПоиска - Структура - содержит значения реквизитов для поиска (ключи структуры совпадают с ключами структуры НовоеПравилоКонвертацииСвойствЭД);
// 
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка на найденный документ или Неопределено, если документ не найден.
//
Функция ДокументУчетаПоРеквизитамВходящегоЭД(ВидЭД, ПараметрыПоиска)
	
	Результат = Неопределено;
	
	ПравилаЗагрузки = ПравилаОбработкиВидаДокументов(ВидЭД);
	
	Для Каждого ЭлементСписка Из ПравилаЗагрузки Цикл 
		
		Правило = ЭлементСписка.Значение;
		
		ОбъектМетаданных = Правило.ОбъектМетаданных;
		СоответствиеРеквизитов = СоответствиеРеквизитовПолямВходящегоДокумента(ОбъектМетаданных);
		
		ЗначенияРеквизитов = Новый Структура;
		
		Для Каждого Элемент Из СоответствиеРеквизитов Цикл 
			
			ИмяРеквизитаЭД = Элемент.Ключ;
			ИмяРеквизитаИБ = Элемент.Значение;
			
			Если ПараметрыПоиска.Свойство(ИмяРеквизитаЭД) Тогда
				ЗначениеРеквизита = ПараметрыПоиска[ИмяРеквизитаЭД];
				ЗначенияРеквизитов.Вставить(ИмяРеквизитаИБ, ЗначениеРеквизита);
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(ЗначенияРеквизитов) Тогда
			Продолжить;
		КонецЕсли;
		
		НайденноеЗначение = СсылкаОбъектаПоПолямПоиска(ЗначенияРеквизитов, ОбъектМетаданных, Истина);
		
		Если ЗначениеЗаполнено(НайденноеЗначение) Тогда 
			Результат = НайденноеЗначение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Контструктор структуры параметров регистрации счетов-фактур на основании документов закупки или возврата товаров от клиента.
// 
// Возвращаемое значение:
// 	Структура - Структура параметров с ключами
// 	     * Ссылка - ДокументСсылка - Ссылка на документ закупки.
// 	     * Организация - СправочникСсылка.Организации - Организация, в которой отражается закупка или возврат товаров.
// 	     * Контрагент - СправочникСсылка.Контрагенты,
// 	                    СправочникСсылка.Организации - Контрагент или организация поставщик.
// 	                                                   Покупатель товаров при возврате.
// 	     * НалогообложениеНДС - ПеречислениеСсылка.ТипыНалогообложенияНДС - Налогообложение НДС документа закупки или возврата.
//
Функция ПараметрыРегистрацииСчетаФактуры()
	
	ПараметрыРегистрации = Новый Структура();
	ПараметрыРегистрации.Вставить("Ссылка");
	ПараметрыРегистрации.Вставить("Организация");
	ПараметрыРегистрации.Вставить("Контрагент");
	ПараметрыРегистрации.Вставить("НалогообложениеНДС");
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Инициализирует параметры регистрации счета-фактуры по документу-основанию.
//
// Параметры:
//  ДокументОснование - ДокументСсылка - документ, на основании которого необходимо получить параметры;
// 
// Возвращаемое значение:
//  Структура - см. ПараметрыРегистрацииСчетаФактуры().
//
Функция ПараметрыРегистрацииСчетаФактурыПоОснованию(ДокументОснование)
	
	ПараметрыРегистрации = ПараметрыРегистрацииСчетаФактуры();
	СтандартнаяОбработка = Истина;
	
	ПриПодготовкеПараметровРегистрацииСчетаФактуры(ПараметрыРегистрации, ДокументОснование, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Ссылка, Организация, Контрагент");
		ЗаполнитьЗначенияСвойств(ПараметрыРегистрации, РеквизитыОснования);
		
	КонецЕсли;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Определяет партнера, соответствующего выбранному контрагенту.
//
// Параметры:
//  Контрагент - СправочникСсылка - элемент справочника "Контрагенты";
//               Структура - ключевые свойства контрагента (см. функцию НовыйКлючевыеСвойстваЮрФизЛицо);
// 
// Возвращаемое значение:
//  СправочникСсылка - ссылка на партнера;
//  Неопределено - если не удалось определить партнера;
//
Функция ПартнерПоКонтрагенту(Контрагент, Кэш = Неопределено)
	
	Результат = Неопределено;
	
	Если Кэш <> Неопределено Тогда
		
		Результат = Кэш[Контрагент];
		
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("Структура") Тогда 
		КонтрагентСсылка = СвойствоСтруктуры(Контрагент, "Ссылка");
	Иначе 
		КонтрагентСсылка = Контрагент;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КонтрагентСсылка) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	МетаданныеКонтрагентов = КонтрагентСсылка.Метаданные();
	
	Если ЕстьРеквизитМетаданных(МетаданныеКонтрагентов, "Партнер") Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	Иначе
		Результат = КонтрагентСсылка;
	КонецЕсли;
	
	Если Кэш <> Неопределено Тогда
		Кэш.Вставить(Контрагент, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на элемент справочника-владельца номенклатуры поставщиков.
//
// Параметры:
//  ДанныеЭД - Структура - см. функцию НовыйДанныеЭлектронногоДокумента;
// 
// Возвращаемое значение:
//  СправочникСсылка - ссылка на поставщика номенклатуры (контрагента или партнера).
//
Функция ВладелецНоменклатураПоставщиков(ДанныеЭД)
	
	Результат	 = Неопределено;
	ИмяСвойства	 = ИмяРеквизитаВладельцаНоменклатуры();
	
	Если Не ЗначениеЗаполнено(ИмяСвойства) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Результат = СвойствоСтруктуры(ДанныеЭД, ИмяСвойства);
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя свойства структуры ДанныеЭД, содержащее ссылку
// на владельца номенклатуры (контрагента или партнера).
// 
// Возвращаемое значение:
//  Строка - имя свойства структуры.
//
Функция ИмяРеквизитаВладельцаНоменклатуры()
	
	Результат = Неопределено;
	
	ИмяСправочника = ИмяСправочникаВладельцаНоменклатуры();
	
	Если ВРег(ИмяСправочника) = ВРег("Партнеры") Тогда 
		Результат = "Партнер.Ссылка";
	Иначе 
		Результат = "Продавец.Ссылка";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя справочника-владельца номенклатуры поставщиков.
// 
// Возвращаемое значение:
//  Строка - имя прикладного справочника.
//
Функция ИмяСправочникаВладельцаНоменклатуры()
	
	Результат = Неопределено;
	
	СтандартнаяОбработка = Истина;
	
	ПриОпределенииИмениСправочникаВладельцаНоменклатуры(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		Результат = "Контрагенты";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает метаданные прикладного справочника по имени справочника в терминах сервиса.
//
// Параметры:
//  ИмяСправочника - строка - название справочника в терминах сервиса.
//
// Возвращаемое значение:
//  ОбъектМетаданных - метаданные прикладного справочника.
//
Функция МетаданныеПрикладногоСправочника(ИмяСправочника)
	
	СоответствиеСправочников = Новый Соответствие;
	
	СтандартнаяОбработка = Истина;
	ПриПолученииСоответствияСправочников(СоответствиеСправочников, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		СоответствиеСправочников.Вставить("Валюты"			, Метаданные.Справочники.Валюты);
		СоответствиеСправочников.Вставить("СтраныМира"		, Метаданные.Справочники.СтраныМира);
		СоответствиеСправочников.Вставить("Организации"				, Метаданные.Справочники.Организации);
		СоответствиеСправочников.Вставить("Контрагенты"				, Метаданные.Справочники.Контрагенты);
		СоответствиеСправочников.Вставить("Партнеры"				, Неопределено);
		
	КонецЕсли;
	
	ИмяПрикладногоСправочника = СоответствиеСправочников.Получить(ИмяСправочника);
	
	Возврат ИмяПрикладногоСправочника;
	
КонецФункции

// Возвращает ссылку на организацию или контрагента по идентификатору организации в сервисе Диадок.
//
// Параметры:
//  Идентификатор	 - Строка - идентификатор организации в сервисе Диадок (boxId);
//  ОбъектМетаданных - ОбъектМетаданных - метаданные справочника, в котором осуществляется поиск;
// 
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка на найденный элемент.
//
Функция СсылкаПоИдентификаторуОрганизации(Идентификатор, ОбъектМетаданных)
	
	Результат = Неопределено;
	
	Если ОбъектМетаданных = МетаданныеПрикладногоСправочника("Организации") Тогда 
		
		Результат = МетодСервера(, "BoxID_2_Организация", Идентификатор);
		
	ИначеЕсли ОбъектМетаданных = МетаданныеПрикладногоСправочника("Контрагенты") Тогда 
		
		Результат = МетодСервера(, "CounteragentBoxID_2_Контрагент", Идентификатор);
		
	Иначе 
		
		ТекстОшибки = НСтр("ru = 'Поиск ссылки с идентификатором ""%1"" не выполнен по причине:
                           |Для объектов ""%2"" поиск по идентификатору организации не определен!'");
		
		ТекстОшибки = ПодставитьПараметрыВСтроку(ТекстОшибки, Идентификатор, ОбъектМетаданных.ПолноеИмя());
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

