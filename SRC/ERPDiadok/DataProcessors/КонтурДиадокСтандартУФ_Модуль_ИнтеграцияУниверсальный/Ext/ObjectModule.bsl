Функция ОпределитьТипДокумента(ТипДокумента)

	Если ЭтоПервичныйДокумент(ТипДокумента) Тогда
		Результат = ТипДокумента_Первичный();
	ИначеЕсли ЭтоКорректировочныйДокумент(ТипДокумента) Тогда
		Результат = ТипДокумента_Корректировочный();
	ИначеЕсли ЭтоДокументОРасхождениях(ТипДокумента) Тогда
		Результат = ТипДокумента_ДокументОРасхождениях();
	ИначеЕсли ЭтоАктСверки(ТипДокумента) Тогда
		Результат = ТипДокумента_АктСверки();
	ИначеЕсли ЭтоТипДокументаСчетНаОплату(ТипДокумента) Тогда
		Результат = ТипДокумента_СчетНаОплату();
	Иначе
		Результат = ТипДокумента_НеизвестныйТип();
	КонецЕсли;
	
	Возврат Результат;

