//  ПараметрыФормирования 	- Структура 		- см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентУКД736(СсылкаНаДокумент, ПараметрыФормирования)
	
	Результат = Новый_UcdSellerContent();
	
	Результат.FormatVersion = БазовыеФорматы().ucd736;
	
