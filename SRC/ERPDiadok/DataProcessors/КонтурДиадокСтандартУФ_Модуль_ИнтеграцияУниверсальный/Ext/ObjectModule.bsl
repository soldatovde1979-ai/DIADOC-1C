КонецФункции

Функция МЧД_ДанныеДоверенности(СсылкаНаДоверенность)
	
	// TODO git-1486: дополнить данными
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МЧД.Наименование КАК Наименование,
	|	МЧД.НомерДоверенности КАК НомерДоверенности,
	|	МЧД.ДатаВыдачи КАК ДатаВыдачи,
	|	МЧД.ДатаОкончания КАК ДатаОкончания,
	|	МЧД.СрокДействия КАК СрокДействия,
	|	МЧД.Организация КАК Организация,
	|	МЧД.ДоверительЮЛ_НаимОрг КАК ДоверительНаименование,
	|	МЧД.ДоверительЮЛ_ИНН КАК ДоверительИНН,
	|	МЧД.ДоверительЮЛ_КПП КАК ДоверительКПП,
	|	МЧД.ДоверительЮЛ_ОГРН КАК ДоверительОГРН,
	|	МЧД.Представитель КАК Представитель,
	|	ВЫБОР
	|		КОГДА МЧД.Представитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА ВЫРАЗИТЬ(МЧД.Представитель КАК Справочник.ФизическиеЛица).ФИО
	|		ИНАЧЕ МЧД.ПредставительЮЛ_НаимОрг
	|	КОНЕЦ КАК ПредставительНаименование,
	|	ВЫБОР
	|		КОГДА МЧД.Представитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА МЧД.ПредставительФЛ_ИНН
	|		ИНАЧЕ МЧД.ПредставительЮЛ_ИНН
	|	КОНЕЦ КАК ПредставительИНН,
	|	ВЫБОР
	|		КОГДА МЧД.Представитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА """"
	|		ИНАЧЕ МЧД.ПредставительЮЛ_КПП
	|	КОНЕЦ КАК ПредставительКПП,
	|	ВЫБОР
	|		КОГДА МЧД.Представитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА """"
	|		ИНАЧЕ МЧД.ПредставительЮЛ_ОГРН
	|	КОНЕЦ КАК ПредставительОГРН,
	|	ВЫБОР
	|		КОГДА МЧД.Представитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА МЧД.ПредставительФЛ_СНИЛС
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПредставительСНИЛС,
	|	МЧД.Статус КАК Статус
	|ИЗ
	|	Справочник.МашиночитаемыеДоверенностиФНС КАК МЧД
	|ГДЕ
	|	МЧД.Ссылка = &Ссылка"
	);
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДоверенность);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		// TODO git-1486: возможно, стоит перенести в отдельный метод создания контракта
		Результат = Новый Структура;
		Результат.Вставить("Идентификатор", Выборка.НомерДоверенности);
		Результат.Вставить("СрокДействия", Выборка.СрокДействия);
		
		Результат.Вставить("Доверитель", Новый Структура);
		Результат.Доверитель.Вставить("Наименование", Выборка.ДоверительНаименование);
		Результат.Доверитель.Вставить("ИНН"			, Выборка.ДоверительИНН);
		Результат.Доверитель.Вставить("КПП"			, Выборка.ДоверительКПП);
		Результат.Доверитель.Вставить("ОГРН"		, Выборка.ДоверительОГРН);
		
		Результат.Вставить("Представитель", Новый Структура);
		Результат.Представитель.Вставить("Наименование"	, Выборка.ПредставительНаименование);		
		Результат.Представитель.Вставить("ИНН"			, Выборка.ПредставительИНН);
		Результат.Представитель.Вставить("КПП"			, Выборка.ПредставительКПП);
		Результат.Представитель.Вставить("СНИЛС"		, Выборка.ПредставительСНИЛС);
		Результат.Представитель.Вставить("ОГРН"			, Выборка.ПредставительОГРН);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

