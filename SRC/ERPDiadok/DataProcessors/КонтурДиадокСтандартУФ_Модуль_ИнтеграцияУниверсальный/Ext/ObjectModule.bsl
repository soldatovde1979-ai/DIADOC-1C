// Возвращает график оплаты счета на оплату.
//
// Параметры:
//  Шапка - Структура - реквизиты шапки документа (см. ДанныеШапки)
// 
// Возвращаемое значение:
//  ТаблицаЗначений - график платежей, содержит колонки:
//     * НомерСтроки	 - Число	 - номер строки графика;
//     * ДатаПлатежа	 - Дата		 - дата платежа;
//     * ПроцентПлатежа	 - Число	 - процент платежа;
//     * СуммаПлатежа	 - Число	 - сумма платежа;
//     * ЭтоЗалогЗаТару	 - Булево	 - Истина, если это оплата залога за тару;
//
Функция ЭтапыГрафикаОплатПоДокументу(Шапка)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтроки");
	Результат.Колонки.Добавить("ДатаПлатежа");
	Результат.Колонки.Добавить("ПроцентПлатежа");
	Результат.Колонки.Добавить("СуммаПлатежа");
	Результат.Колонки.Добавить("ЭтоЗалогЗаТару");
	
	СтандартнаяОбработка = Истина;
	ПриПолученииЭтаповГрафикаОплат(Результат, Шапка, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		ДатаПлатежа = Шапка.СрокОплаты;
		
		Если ЗначениеЗаполнено(ДатаПлатежа) Тогда 
			Этап = Результат.Добавить();
			Этап.НомерСтроки	 = 1;
			Этап.ДатаПлатежа	 = ДатаПлатежа;
			Этап.ПроцентПлатежа	 = 100;
			Этап.СуммаПлатежа	 = Шапка.СуммаДокумента;
			Этап.ЭтоЗалогЗаТару	 = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

