// Заполняет сведения о грузовой таможенной декларации и стран епроисхождения товара.
// 
// Параметры:
//  Приемник - Массив - Массив структур, сведения о ГТД и стране происхождения товара из StructedAdditionalInfos.
//  ИсточникДанных - Массив - Массив структур, дополнительные сведения поля StructedAdditionalInfos.
// 
Процедура ПрочитатьСвойства_ДанныеГТД_Корректировка(Приемник, ИсточникДанных)
	
	ДополнительныеПоля = СвойствоСтруктуры(ИсточникДанных, "StructedAdditionalInfos");
	
	Если Не ЗначениеЗаполнено(ДополнительныеПоля) Тогда 
		Возврат;
	КонецЕсли;
	
	КлючИнфПолФХЖ2 = Перечисление_ИдентификаторыСведенийОСтранеПроисхождения();
	
	КодыСтран			= Новый Массив;
	НомераДекаларций	= Новый Массив;
		
	Для Каждого Элемент Из ДополнительныеПоля Цикл 
		
		Если НРег(Элемент.Key) = НРег(КлючИнфПолФХЖ2.КодСтраны) Тогда
			КодыСтран.Добавить(Элемент.Value);
		ИначеЕсли НРег(Элемент.Key) = НРег(КлючИнфПолФХЖ2.НомерТД) Тогда
			НомераДекаларций.Добавить(Элемент.Value);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(КодыСтран)
		И ЗначениеЗаполнено(НомераДекаларций) Тогда
		
		ДополнитьДанныеГТД(Приемник, КодыСтран[0], НомераДекаларций[0]);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьСвойства_ДанныеГТД(Приемник, ИсточникДанных)
	
	СведенияТД = СвойствоСтруктуры(ИсточникДанных, "CustomDeclarations");
	
	Если ЗначениеЗаполнено(СведенияТД) Тогда 
		
		Для Каждого Элемент Из СведенияТД Цикл 
			
			КодСтраны	 = СвойствоСтруктуры(Элемент, "CountryCode");
			НомерГТД	 = СвойствоСтруктуры(Элемент, "DeclarationNumber");
			
			ДополнитьДанныеГТД(Приемник, КодСтраны, НомерГТД);
			
		КонецЦикла;
		
	Иначе 
		
		КодСтраны	 = СвойствоСтруктуры(ИсточникДанных, "CountriesOfOrigin");
		НомерГТД	 = СвойствоСтруктуры(ИсточникДанных, "CustomsDeclarationNumbers");
		
		ДополнитьДанныеГТД(Приемник, КодСтраны, НомерГТД);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьСвойства_СведенияОМаркировке(Приемник, ИсточникДанных)
	
	НомСредИдентТов = СвойствоСтруктуры(ИсточникДанных, "ItemIdentificationNumbers");
	
	Если Не ЗначениеЗаполнено(НомСредИдентТов) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из НомСредИдентТов Цикл
		
		Если ЗначениеЗаполнено(Элемент.TransPackageId) Тогда
			Приемник.ТранспортныеУпаковки.Добавить(Элемент.TransPackageId);
		КонецЕсли;
		
		Для Каждого ВложенныйЭлемент Из Элемент.PackageIds Цикл
			Приемник.ИндивидуальныеУпаковки.Добавить(ВложенныйЭлемент);
		КонецЦикла;
		
		Для Каждого ВложенныйЭлемент Из Элемент.Units Цикл
			Приемник.КонтрольныеИдентификационныеЗнаки.Добавить(ВложенныйЭлемент);
		КонецЦикла;
		
		КолВедМарк = СвойствоСтруктуры(Элемент, "MarkedItemsQuantity", 0);
		
		Если ЗначениеЗаполнено(КолВедМарк) Тогда
			Приемник.КоличествоТовараВУпаковке = Приемник.КоличествоТовараВУпаковке + КолВедМарк;
		КонецЕсли;
		
	КонецЦикла;
	
