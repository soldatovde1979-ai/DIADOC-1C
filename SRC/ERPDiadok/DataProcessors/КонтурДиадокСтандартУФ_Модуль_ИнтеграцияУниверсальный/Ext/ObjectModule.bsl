Функция ЕстьДельта(Amounts)
	
	Результат = Ложь;
	
	Если Amounts.TotalWithVatExcluded <> Неопределено
		Или Amounts.Vat <> Неопределено Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьЗаполнитьАтрибутWithoutVat736(Контент736)
	
	ТабличнаяЧасть = Контент736.InvoiceCorrectionTable;
	
	ЕстьУвеличение = Ложь;
	ЕстьУменьшение = Ложь;
	
	ВсегоУвелБезНДС = Истина;
	ВсегоУмБезНДС = Истина;
	
	Для Каждого Элемент Из ТабличнаяЧасть.Items Цикл
		
		СтавкаДоИзменения = Элемент.OriginalValues.TaxRate;
		ДоИзмененияБезНДС = ЭтоСтавкаБезНДС(СтавкаДоИзменения);
		Элемент.OriginalValues.WithoutVat = XMLСтрока(ДоИзмененияБезНДС);
		
		СтавкаПослеИзменения = Элемент.CorrectedValues.TaxRate;
		ПослеИзмененияБезНДС = ЭтоСтавкаБезНДС(СтавкаПослеИзменения);
		Элемент.CorrectedValues.WithoutVat = XMLСтрока(ПослеИзмененияБезНДС);
		
		Если ЕстьДельта(Элемент.AmountsInc) Тогда
			ЕстьУвеличение = Истина;
			ВсегоУвелБезНДС = ВсегоУвелБезНДС И ДоИзмененияБезНДС И ПослеИзмененияБезНДС;
		КонецЕсли;
		
		Если ЕстьДельта(Элемент.AmountsDec) Тогда
			ЕстьУменьшение = Истина;
			ВсегоУмБезНДС = ВсегоУмБезНДС И ДоИзмененияБезНДС И ПослеИзмененияБезНДС;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьУвеличение Тогда
		ТабличнаяЧасть.TotalsInc.WithoutVat = XMLСтрока(ВсегоУвелБезНДС);
	КонецЕсли;
	
	Если ЕстьУменьшение Тогда
		ТабличнаяЧасть.TotalsDec.WithoutVat = XMLСтрока(ВсегоУмБезНДС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнитьItemOriginalNumber736(Контент736)
	
	СтрокиТабличнойЧасти = Контент736.InvoiceCorrectionTable.Items;
	
	НомерПоПорядку = 0;
	
	Для Каждого Item Из СтрокиТабличнойЧасти Цикл
		
		НомерПоПорядку = НомерПоПорядку + 1;
		
		ЭтоНоваяСтрока = ЭтоНоваяСтрокаКорректировки(Item);
		
		НомерСтрокиИсходногоСФ = НомерПоПорядку;
		
		Если ЭтоНоваяСтрока Тогда
			НомерСтрокиИсходногоСФ = Неопределено;
		ИначеЕсли ЗначениеЗаполнено(Item.OriginalNumber) Тогда 
			Продолжить;
		КонецЕсли;
		
		Item.OriginalNumber = НомерСтрокиИсходногоСФ;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЗаполнитьКонтент189ПоДаннымКонтент736(ПротоКонтентУКД)
	
	ПротоКонтентУКД.EventContent.TransferDocDetails = ПредставлениеTransferDocDetails(ПротоКонтентУКД.EventContent.TransferDocDetails736);
	
	Для Каждого CorrectionBase Из ПротоКонтентУКД.EventContent.CorrectionBases Цикл
			
		Если CorrectionBase.BaseDocumentName = ОснованиеПередачи_БезДокументаОснования() Тогда
			CorrectionBase.BaseDocumentName = ОснованиеПередачи_Отсутствует();
		КонецЕсли;
		
	КонецЦикла;
	
	СтавкаНДС_ИсчНалАг = МетодСервера(, "СтавкаНДС_ИсчНалАг");
	
	Для Каждого Item Из ПротоКонтентУКД.InvoiceCorrectionTable.Items Цикл
		
		Если Item.CorrectedValues.TaxRate = СтавкаНДС_ИсчНалАг Тогда
			
			Если Item.CorrectedValues.TotalWithVatExcluded >= Item.OriginalValues.TotalWithVatExcluded Тогда // увеличение
				Item.AmountsInc.Vat		= 0;
				Item.AmountsInc.Total 	= 0;			
			Иначе // уменьшение
				Item.AmountsDec.Vat 	= 0;
				Item.AmountsDec.Total 	= 0;			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеTransferDocDetails(TransferDocDetails736)

	Результат = "";
	
	Для Каждого BaseDocument Из TransferDocDetails736 Цикл
		
		Результат = Результат 	+ ?(ПустаяСтрока(Результат), "", ", ")
								+ BaseDocument.BaseDocumentName + "№" + BaseDocument.BaseDocumentNumber 
								+ " от " + BaseDocument.BaseDocumentDate;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

// Формирует и заполняет структуру ProformaInvoiceContent по данным учетного документа.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ПараметрыФормирования - Структура - см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентФормализованногоСчета(СсылкаНаДокумент, ПараметрыФормирования)
	
	Результат = Новый_ProformaInvoiceSellerContent();
	
	Шапка = ДанныеШапки(СсылкаНаДокумент);
	ДатаНомер = Шапка.ДатаНомерДокумента;
	
	Результат.DocumentDate	 = ДатаНомер.ДатаДокумента;
	Результат.DocumentNumber = ДатаНомер.НомерДокумента;
	
	Результат.Currency	 = Шапка.ВалютаДокументаКод;
	Результат.CurrencyRate = Шапка.КурсДокумента;
	
	// Заполнение сведений о продавце и получателе платежа
	Продавец	 = Шапка.Организация;
	Получатель	 = Шапка.ОрганизацияПолучатель;
	Если Получатель = Продавец Тогда 
		Получатель = Неопределено;
	КонецЕсли;
	
	СчетПродавца	 = ?(ЗначениеЗаполнено(Получатель), Неопределено, Шапка.БанковскийСчетОрганизации);
	СчетПолучателя	 = Шапка.БанковскийСчетОрганизации;
	
	РеквизитыПродавца = РеквизитыЮрФизЛица(Продавец, ДатаНомер.ДатаДокумента, СчетПродавца);
	ЗаполнитьИнформациюОбОрганизации(Результат.Seller, РеквизитыПродавца);
	
	Если ЗначениеЗаполнено(Получатель) Тогда 
		РеквизитыПолучателя = РеквизитыЮрФизЛица(Получатель, ДатаНомер.ДатаДокумента, СчетПолучателя);
		ЗаполнитьИнформациюОбОрганизации(Результат.Recipient, РеквизитыПолучателя);
	Иначе 
		Результат.Recipient = Неопределено;
	КонецЕсли;
	
	// Заполнение сведений о покупателе и плательщике
	Покупатель = Шапка.Контрагент;
	Плательщик = Шапка.Плательщик;
	Если Плательщик = Покупатель Тогда 
		Плательщик = Неопределено;
	КонецЕсли;
	
	СчетПокупателя = ?(ЗначениеЗаполнено(Плательщик), Неопределено, Шапка.БанковскийСчетКонтрагента);
	СчетПлательщика = Шапка.БанковскийСчетКонтрагента;
	
	РеквизитыПокупателя = РеквизитыЮрФизЛица(Покупатель, ДатаНомер.ДатаДокумента, СчетПокупателя);
	ЗаполнитьИнформациюОбОрганизации(Результат.Buyer, РеквизитыПокупателя);
	
	Если ЗначениеЗаполнено(Плательщик) Тогда 
		РеквизитыПлательщика = РеквизитыЮрФизЛица(Плательщик, ДатаНомер.ДатаДокумента, СчетПлательщика);
		ЗаполнитьИнформациюОбОрганизации(Результат.Payer, РеквизитыПлательщика);
	Иначе 
		Результат.Payer = Неопределено;
	КонецЕсли;
	
	Договор = РеквизитыДоговора(Шапка);
	Если ЗначениеЗаполнено(Договор) Тогда 
		Результат.Contract.Name	 = Договор.Представление;
		Результат.Contract.Number	 = Договор.Номер;
		Результат.Contract.Date	 = Договор.Дата;
	Иначе 
		Результат.Contract = Неопределено;
	КонецЕсли;
	
	Результат.GovernmentContractInfo = Шапка.ИдентификаторГосКонтракта;
	Результат.PaymentPurpose = Шапка.НазначениеПлатежа;
	
	ГрафикПлатежей = ЭтапыГрафикаОплатПоДокументу(Шапка);
	Если ГрафикПлатежей.Количество() = 0 Тогда
		ДатаПлатежа = '00010101';
	ИначеЕсли ГрафикПлатежей.Количество() = 1 Тогда
		ДатаПлатежа = ГрафикПлатежей[0].ДатаПлатежа;
	Иначе
		ДатаПлатежа = ГрафикПлатежей[ГрафикПлатежей.Количество()-1].ДатаПлатежа;
	КонецЕсли;
	
	ИнфоПоля = Новый Структура;
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().ДополнительныеУсловия	, Шапка.ДополнительныеУсловия);
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().ДополнительнаяИнформация, Шапка.ДополнительнаяИнформация);
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().ИдентификаторПлатежа	, Шапка.ИдентификаторПлатежа);
	ИнфоПоля.Вставить(ЗарезервированныеИменаИнфоПолей().СрокОплаты				, ДатаПлатежа);
	
	Для Каждого Поле Из ИнфоПоля Цикл 
		Если ЗначениеЗаполнено(Поле.Значение) Тогда 
			ДополнитьМассивKeyValue(Результат.StructedAdditionalInfos, Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеТЧ = ДанныеТабличныхЧастей(Шапка);
	ЗаполнитьТаблицуСчетаНаОплату(Результат.ProformaInvoiceTable, ДанныеТЧ);
	
	СведенияОбПодписанте = Результат.Signer;
	
	Если ЗначениеЗаполнено(РеквизитыПродавца.Свидетельство)
		И СведенияОбПодписанте.Свойство("SoleProprietorRegistrationCertificate") Тогда
		Результат.Signer.SoleProprietorRegistrationCertificate = РеквизитыПродавца.Свидетельство;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

