// Дополняет структуру шапки документа данными, которые
// рассчитываются по табличной части документа.
//
// TODO: Убрать ключевое слово "Экспорт" и перенести в раздел "СлужебныеПроцедурыИФункции".
//       Это можно сделать только после полного перевода всех модулей интеграции на новые алгоритмы получения данных ТЧ.
//
// Параметры:
//  Шапка			 - Структура		 - см. функцию ДанныеШапки.
//  ТабличнаяЧасть	 - ТаблицаЗначений	 - см. функцию ДанныеТабличныхЧастей
//
Процедура ДополнитьДанныеШапкиХарактеристикамиТабличнойЧасти(Шапка, ТабличнаяЧасть) Экспорт
	
	Шапка.Вставить("ЕстьТовары"	, ТабличнаяЧасть.НайтиСтроки(Новый Структура("ЭтоУслуга", Ложь	)).Количество() > 0);
	Шапка.Вставить("ЕстьУслуги"	, ТабличнаяЧасть.НайтиСтроки(Новый Структура("ЭтоУслуга", Истина)).Количество() > 0);
	
	// TODO: Добавить расчет следующих показателей
	//   * ВсегоНДС, ВсегоСНДС - вычислять нужно в цикле по ТЧ, использовать метод Итог(<Колонка>)
	//                           нельзя, т.к. в строках могут быть не только числа (например, Неопределено)
	//   * ТипНалогообложения - в качестве возможных значений предлагается использовать имена значений
	//                          перечисления ТипыНалогообложенияНДС из УТ/КА/ERP. 
	//                          На текущий момент важны 3 значения:
	//                            ** ОблагаетсяНДС - ВсегоНДС > 0
	//                            ** НеОблагаетсяНДС - все строки по ставке "Без НДС"
	//                            ** ОблагаетсяНДСУПокупателя - все строки по ставке "НДС исчисляется налоговым агентом"
	
КонецПроцедуры

// Универсальный метод для получения сведений по шапке документов.
// Состав полей и их значений может быть переопределен в интеграционном модуле 
// конфигурации или в подключаемом модуле с помощью событий:
//  - ПриПодготовкеЗапросаПоШапкеДокумента
//  - ПослеПолученияДанныхШапкиДокумента
//
// Параметры:
//  Ссылка - ДокументСсылка - документ, данные шапки которого нужно получить.
// 
// Возвращаемое значение:
//  Структура - реквизиты шапки документа:
//    * ОписаниеДокумента - Структура - Основные параметры документа информационной базы (см. ОписаниеПрикладногоДокумента)
//    * ДатаНомерДокумента - Структура - сведения о дате и номере документа (см. ДатаНомерДокумента)
//    * Представление					 - Строка			 - Представление документа для отображения в пользовательском интерфейсе.
//    * ХозяйственнаяОперация			 - Ссылка			 - элемент перечисления или справочника "ХозяйственныеОперации"
//    * ВидОперации						 - Ссылка			 - вид операции документа.
//    * СуммаДокумента					 - Число			 - сумма документа с НДС.
//    * ЦенаВключаетНДС					 - Булево			 - Истина, если цены указаны с учетом НДС.
//    * ВалютаДокумента					 - СправочникСсылка	 - валюта документа.
//    * ВалютаДокументаКод				 - Строка			 - код валюты документа.
//    * КурсДокумента					 - Число			 - курс валюты документа.
//    * КратностьДокумента				 - Число			 - кратность валюты документа.
//    * РасчетыВУсловныхЕдиницах		 - Булево			 - Истина, если расчеты ведутся в условных единицах.
//    * ИдентификаторГосКонтракта		 - Строка			 - Идентификатор государственного контракта, договора (соглашения)
//    * Организация						 - СправочникСсылка	 - организация документа.
//    * ОрганизацияРеквизиты			 - Структура		 - см. функцию РеквизитыЮрФизЛица.
//    * БанковскийСчетОрганизации		 - СправочникСсылка	 - банковский счет организации документа.
//    * ЦифровойИндексОбособленногоПодразделения - Строка, Число - цифровой индекс обособленного подразделения.
//    * Грузоотправитель				 - СправочникСсылка	 - грузоотправитель.
//    * ГрузоотправительРеквизиты		 - Структура		 - см. функцию РеквизитыЮрФизЛица.
//    * БанковскийСчетГрузоотправителя	 - СправочникСсылка	 - банковский счет грузоотправителя.
//    * Контрагент						 - СправочникСсылка	 - контрагент документа.
//    * КонтрагентРеквизиты				 - Структура		 - см. функцию РеквизитыЮрФизЛица.
//    * КонтрагентИНН					 - Строка			 - ИНН контрагента.
//    * КонтрагентКПП					 - Строка			 - КПП контрагента.
//    * БанковскийСчетКонтрагента		 - СправочникСсылка	 - банковский счет контрагента.
//    * Грузополучатель					 - СправочникСсылка	 - грузополучатель.
//    * ГрузополучательРеквизиты		 - Структура		 - см. функцию РеквизитыЮрФизЛица.
//    * БанковскийСчетГрузополучателя	 - СправочникСсылка	 - банковский счет грузополучателя.
//    * АдресДоставки					 - Строка			 - адрес доставки груза.
//
Функция ДанныеШапки(Ссылка) Экспорт 
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда 
		
		ОписаниеОш = НСтр("ru = 'Не заполнено значение первого параметра <Ссылка>!'");
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	ОписаниеДокумента = ОписаниеПрикладногоДокумента(Ссылка);
	
	МетаданныеДокумента = Ссылка.Метаданные();
	
	// Готовим описание итоговой структуры
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ХозяйственнаяОперация");
	Реквизиты.Вставить("ВидОперации");
	Реквизиты.Вставить("Организация");
	Реквизиты.Вставить("БанковскийСчетОрганизации");
	Реквизиты.Вставить("Контрагент");
	Реквизиты.Вставить("БанковскийСчетКонтрагента");
	Реквизиты.Вставить("Грузоотправитель");
	Реквизиты.Вставить("БанковскийСчетГрузоотправителя");
	Реквизиты.Вставить("Грузополучатель");
	Реквизиты.Вставить("БанковскийСчетГрузополучателя");
	Реквизиты.Вставить("ИдентификаторГосКонтракта");
	Реквизиты.Вставить("РасчетыВУсловныхЕдиницах");
	Реквизиты.Вставить("ВалютаДокумента");
	Реквизиты.Вставить("ВалютаДокументаКод");
	Реквизиты.Вставить("КурсДокумента");
	Реквизиты.Вставить("КратностьДокумента");
	Реквизиты.Вставить("ЦенаВключаетНДС");
	Реквизиты.Вставить("СуммаДокумента");
	Реквизиты.Вставить("СуммаНДСДокумента");
	Реквизиты.Вставить("НДСИсчисляетсяНалоговымАгентом");
	
	Реквизиты.Вставить("Объем");
	Реквизиты.Вставить("Вес");
	
	Реквизиты.Вставить("АдресДоставки");
	Реквизиты.Вставить("СведенияОТранспортировкеИГрузе");
	
	Реквизиты.Вставить("ОбособленноеПодразделение");
	Реквизиты.Вставить("ЦифровойИндексОбособленногоПодразделения", "НЕОПРЕДЕЛЕНО");
	
	#Область СчетНаОплату
	Реквизиты.Вставить("ОрганизацияПолучатель");
	Реквизиты.Вставить("Плательщик");
	Реквизиты.Вставить("СуммаСкидки");
	Реквизиты.Вставить("НазначениеПлатежа");
	Реквизиты.Вставить("ДополнительныеУсловия");
	Реквизиты.Вставить("ДополнительнаяИнформация");
	Реквизиты.Вставить("ИдентификаторПлатежа");
	Реквизиты.Вставить("СрокОплаты");
	#КонецОбласти
	
	// В более-менее свежих версиях конфигураций УТ, КА, ERP и БП
	// ИНН и КПП контрагента сохраняются прямо в документе (например, СФ).
	Реквизиты.Вставить("КонтрагентИНН", "ИННКонтрагента");
	Реквизиты.Вставить("КонтрагентКПП", "КППКонтрагента");
	
	// Вызовем обработчик события, переопределенный в модуле интеграции
	ПриПодготовкеЗапросаПоШапкеДокумента(Реквизиты, МетаданныеДокумента);
	
	// Проверим существование всех необходимых реквизитов и заполним
	// выражения для полей с зарезервированными именами (ИмяПоляСсылка, ИмяПоляПредставление и т.д.)
	ЗаполнитьВыраженияПолейЗапроса(Реквизиты, МетаданныеДокумента);
	
	// Сформируем и выполним запрос по реквизитам
	Шапка = МетодСервера(, "ЗначенияРеквизитовОбъекта", Ссылка, Реквизиты);
	
	// Дополним итоговую структуру вспомогательными данными
	Шапка.Вставить("ОписаниеДокумента", ОписаниеДокумента);
	Шапка.Вставить("ИмяМетаданных"	, МетаданныеДокумента.Имя); // TODO: Удалить
	Шапка.Вставить("ОшибкиВДанных"	, Новый Массив);
	
	// Вызовем обработчик события, переопределенный в модуле интеграции
	ПослеПолученияДанныхШапкиДокумента(Шапка);
	
	ДатаНомерДокумента = ДатаНомерДокумента(ОписаниеДокумента, Шапка.ЦифровойИндексОбособленногоПодразделения);
	Шапка.Вставить("ДатаНомерДокумента", ДатаНомерДокумента);
	
	// Добавим в шапку сведения о юридических и физических лицах
	ДополнитьШапкуРеквизитамиЮрФизЛиц(Шапка);
	
	// Если ИНН и КПП контрагента не хранятся в самом документе,
	// то возьмем их из карточки контрагента
	ПроверитьЗаполнитьИННКППКонтрагента(Шапка);
	
	ЗаполнитьПредставлениеДокумента(Шапка);
	
	Возврат Шапка;
	
КонецФункции

// Универсальный метод для получения товарной части документа.
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит информацию о товарной части документа:
//     * ИмяТабличнойЧасти - Строка, Неопределено - имя табличной части документа;
//     * НомерСтроки - Число - номер строки документа;
//     * Номенклатура - СправочникСсылка - номенклатура документа;
//     * НоменклатураПредставление - Строка - представление номенклатуры;
//     * НоменклатураКод - Строка - код или артикул номенклатуры;
//     * ЭтоУслуга - Булево - Истина, если номенклатура является услугой;
//     * ПризнакТоварРаботаУслуга - Строка - тип номенклатуры в терминах сервиса {NotSpecified, Property, Job, Service, PropertyRights, Other};
//     * Характеристика - СправочникСсылка, Неопределено - характеристика номенклатуры;
//     * Серия - СправочникСсылка, Неопределено - серия номенклатуры;
//     * Упаковка - СправочникСсылка - упаковка (единица измерения) номенклатуры;
//     * ЕдиницаИзмерения - СправочникСсылка - единица измерения номенклатуры;
//     * ЕдиницаИзмеренияКод - Строка - код единицы измерения по ОКЕИ;
//     * ВидУпаковки - СправочникСсылка, Неопределено - (устарел, удалить);
//     * СтранаПроисхождения - СправочникСсылка, Неопределено - страна происхождения;
//     * СтранаПроисхожденияКод - Строка - код страны происхождения по ОКСМ;
//     * НомерГТД - СправочникСсылка, Неопределено - номер ГТД;
//     * КодТНВЭД - СправочникСсылка, Неопределено - код ТН ВЭД;
//     * СтавкаНДС - ПеречислениеСсылка, СправочникСсылка - ставка НДС;
//     * СтавкаНДСПредставление - Строка - представление ставки НДС (см. ПредставлениеСтавкиНДС);
//     * Количество - Число - количество упаковок;
//     * КоличествоВОдномМесте - Число - коэффициент упаковки;
//     * Цена - Число - цена за упаковку (без НДС и скидок/наценок);
//     * Сумма - Число - сумма без НДС;
//     * СуммаНДС - Число - сумма налога;
//     * СуммаСНДС - Число - сумма с учетом НДС;
//     * Масса - Число, Неопределено - масса;
//     * МассаНетто - Число, Неопределено - масса (нетто);
//
Функция ДанныеТабличныхЧастей(Шапка) Экспорт 
	
	Если Не ЗначениеЗаполнено(Шапка) Тогда 
		
		ОписаниеОш = НСтр("ru = 'Не заполнено значение первого параметра <Данные шапки документа>!'");
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	Если ИспользуетсяМетодПолучитьДанныеТЧ() Тогда // данные ТЧ собираем "по-старому"
		Возврат ПолучитьДанныеТЧ(Шапка);
	КонецЕсли;
	
	ТабличныеЧасти = ИменаТабличныхЧастейДокумента(Шапка);
	
	ДанныеТЧ = Неопределено;
	
	Для Каждого ИмяТабличнойЧасти Из ТабличныеЧасти Цикл 
		
		Буфер = ТабличнаяЧастьДокумента(Шапка, ИмяТабличнойЧасти);
		
		Если ДанныеТЧ = Неопределено Тогда 
			ДанныеТЧ = Буфер.Скопировать();
		Иначе 
			ДополнитьТаблицу(ДанныеТЧ, Буфер);
		КонецЕсли;
		
	КонецЦикла;
	
	ПослеПолученияТоварнойЧастиДокумента(Шапка, ДанныеТЧ);
	
	Возврат ДанныеТЧ;
	
КонецФункции

// Устарела.
// Получает номер документа для вывода на печать; из номера удаляются префиксы и лидирующие нули.
//
// Параметры:
//  СсылкаИлиСтруктура - ДокументСсылка	 - документ, номер которого нужно получить.
//                     - Структура		 - структура с ключом "Номер".
// 
// Возвращаемое значение:
//  Строка - Номер на печать.
//
Функция НомерНаПечать(СсылкаИлиСтруктура) Экспорт
	
	НомерОбъекта = Неопределено;
	Если ТипЗнч(СсылкаИлиСтруктура) = Тип("Структура") Тогда 
		НомерОбъекта = СсылкаИлиСтруктура.Номер;
	Иначе
		НомерОбъекта = МетодСервера(, "ЗначениеРеквизитаОбъекта", СсылкаИлиСтруктура, "Номер");
	КонецЕсли;
	
	Результат = РасчетноеПредставлениеНомера(НомерОбъекта);
	
	Возврат Результат;
	
КонецФункции

// Возвращает имя реквизита номенклатуры, который нужно использовать в качестве кода товара в печатных формах.
// 
// Возвращаемое значение:
//  Строка - имя реквизита с представлением кода номенклатуры. Например, "Код" или "Артикул".
//
Функция ИмяКолонкиКодТовара() Экспорт
	
	СтандартнаяОбработка = Истина;
	ИмяКолонки			 = Неопределено;
	
	ПриОпределенииДополнительнойКолонкиПечатныхФормДокументов(ИмяКолонки, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		ИмяКолонки = "Код";
	КонецЕсли;
	
	Возврат ИмяКолонки;
	
КонецФункции

// Возвращает валюту регламентированного учета.
// 
// Возвращаемое значение:
//  СправочникСсылка.Валюты - валюта регл. учета.
//
Функция ВалютаРегламентированногоУчета() Экспорт
	
	СтандартнаяОбработка = Истина;
	Результат = Неопределено;
	
	ПриОпределенииВалютыРегламентированногоУчета(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		Если Метаданные.Константы.Найти("ВалютаРегламентированногоУчета") <> Неопределено Тогда
			Результат = Константы.ВалютаРегламентированногоУчета.Получить();
		ИначеЕсли Метаданные.Константы.Найти("ВалютаУчета") <> Неопределено Тогда
			Результат = Константы.ВалютаУчета.Получить();
		ИначеЕсли Метаданные.Константы.Найти("ВалютаРегламентированногоУчетаОрганизаций") <> Неопределено Тогда
			Результат = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

// Формирует пользовательское представление документа для отображения в интерфейсе и сообщениях
// в формате "<Представление вида документа> <Номер> от <Дата> (<Операция>)"
//
// Параметры:
//  Шапка - Структура - см. функцию ДанныеШапки
//
Процедура ЗаполнитьПредставлениеДокумента(Шапка)
	
	Результат = "";
	
	ОписаниеДокумента = Шапка.ОписаниеДокумента;
	ОбъектМетаданных = ОписаниеДокумента.Ссылка.Метаданные();
	
	ПредставлениеОбъектаМетаданных = ОбъектМетаданных.ПредставлениеОбъекта;
	Если Не ЗначениеЗаполнено(ПредставлениеОбъектаМетаданных) Тогда
		ПредставлениеОбъектаМетаданных = ОбъектМетаданных.Представление();
	КонецЕсли;
	
	ПредставлениеДаты = Формат(ОписаниеДокумента.Дата, "ДЛФ=D");
	ПредставлениеНомера = ОписаниеДокумента.Номер;
	
	Результат = ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2 от %3'")
		, ПредставлениеОбъектаМетаданных
		, ПредставлениеНомера
		, ПредставлениеДаты
		);
	
	Операция = ?(ЗначениеЗаполнено(Шапка.ХозяйственнаяОперация), Шапка.ХозяйственнаяОперация, Шапка.ВидОперации);
	
	Если ЗначениеЗаполнено(Операция) Тогда 
		Результат = ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"), Результат, Операция);
	КонецЕсли;
	
	Шапка.Вставить("Представление", Результат);
	
КонецПроцедуры

// Предоставляет реквизиты компании (юридического лица или предпринимателя), например, для вывода в печатной форме.
//
// Параметры:
//  ЮрФизЛицо		 - СправочникСсылка.Организации, СправочникСсылка.Контрагенты - компания, реквизиты которой нужно получить
//  Период			 - Дата - дата, на которую нужно получить значения периодических реквизитов
//  БанковскийСчет	 - СправочникСсылка.БанковскиеСчета - банковский счет, реквизиты которого нужно включить в реквизиты компании.
//                     Если не передан, будут включены реквизиты основного банковского счета.
// 
// Возвращаемое значение:
// см. НовыйРеквизитыКомпании() - коллекция общепринятых реквизитов компании.
//
Функция РеквизитыЮрФизЛица(ЮрФизЛицо, Период = '00010101', Знач БанковскийСчет = Неопределено) Экспорт
	
	Результат = НовыйРеквизитыЮрФизЛица();
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Если Период = "--" Тогда
		Период = '00010101';
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	ПриПолученииРеквизитовЮрФизЛица(Результат, ЮрФизЛицо, Период, БанковскийСчет, СтандартнаяОбработка);
	
	ДополнитьРеквизитыЮрФизЛицаАдреснойИнформацией(Результат, ЮрФизЛицо, Период);
	
	СкопироватьЗначенияJSONВЗначенияПолей(Результат);
	
	Если Результат.Свойство("НаименованиеДляПечатныхФорм") 
		И НЕ ЗначениеЗаполнено(Результат.НаименованиеДляПечатныхФорм) Тогда
		
		Результат.НаименованиеДляПечатныхФорм = Результат.ПолноеНаименование;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое описание юридического или физического лица.
//
// Параметры:
//  Реквизиты		 - Структура - см. функцию РеквизитыЮрФизЛица.
//  ШаблонОписания	 - Строка	 - задает формат результирующей строки с описанием организации.
//  СПрефиксом		 - Булево	 - Истина, если требуется выводить заголовки реквизитов.
//
// Возвращаемое значение:
//  Строка - описатель организации / контрагента / физ.лица.
//
Функция ПредставлениеЮрФизЛица(Реквизиты, ШаблонПредставления = "", СПрефиксом = Истина) Экспорт
	
	Перем Префикс, СтрокаДополнения;

	Результат = Новый Массив;

	СоответствиеПараметров = Новый Структура;
	СоответствиеПараметров.Вставить("ПолноеНаименование",			" ");
	СоответствиеПараметров.Вставить("СокращенноеНаименование",		" ");
	СоответствиеПараметров.Вставить("НаименованиеДляПечатныхФорм",	" ");
	СоответствиеПараметров.Вставить("ИНН",							" ИНН ");
	СоответствиеПараметров.Вставить("КПП",							" КПП ");
	СоответствиеПараметров.Вставить("Свидетельство",				" ");
	СоответствиеПараметров.Вставить("СвидетельствоДатаВыдачи",		" от ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес",				" ");
	СоответствиеПараметров.Вставить("ФактическийАдрес",				" ");
	СоответствиеПараметров.Вставить("Телефоны",						" тел.: ");
	СоответствиеПараметров.Вставить("Факс",							" факс: ");
	СоответствиеПараметров.Вставить("НомерСчета",					" р/с ");
	СоответствиеПараметров.Вставить("Банк",               			" в банке ");
	СоответствиеПараметров.Вставить("БИК",                			" БИК ");
	СоответствиеПараметров.Вставить("КоррСчет",           			" к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО",          			" Код по ОКПО ");
	
	Если ПустаяСтрока(ШаблонПредставления) Тогда

		ШаблонПредставления = "ИНН,Свидетельство,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет";
		Если Не Реквизиты.Свойство("НаименованиеДляПечатныхФорм") Или Не ЗначениеЗаполнено(Реквизиты.НаименованиеДляПечатныхФорм) Тогда
			ШаблонПредставления = "НаименованиеПолное," + ШаблонПредставления;
		Иначе
			ШаблонПредставления = "НаименованиеДляПечатныхФорм," + ШаблонПредставления;
		КонецЕсли;

	КонецЕсли;
	
	СписокПараметров = РазложитьСтрокуВМассивПодстрок(ШаблонПредставления, ",", Истина);
	
	Для каждого ИмяПараметра Из СписокПараметров Цикл
		
		Если Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения) Тогда
			
			Реквизиты.Свойство(ИмяПараметра, СтрокаДополнения);
			Если ПустаяСтрока(СтрокаДополнения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СПрефиксом = Истина И СоответствиеПараметров.Свойство(ИмяПараметра, Префикс) Тогда
				Результат.Добавить(Префикс + СтрокаДополнения);
			Иначе
				Результат.Добавить(СтрокаДополнения);
			КонецЕсли; 
			
		Иначе
			
			//ТекстСообщения = НСТр("ru = 'Не удалось определить значение параметра организации:'") + " " + ИмяПараметра;
			//
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);

			//ЗаписьЖурналаРегистрации(
			//	НСтр("ru = 'Формирование сведений об организации'", КодОсновногоЯзыка()), 
			//	УровеньЖурналаРегистрации.Ошибка,
			//	Метаданные.Справочники.Организации, , 
			//	ТекстСообщения + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		КонецЕсли;
		
	КонецЦикла; 

	СтрокаРезультата = СтрокаИзМассиваПодстрок(Результат, ",");
	СтрокаРезультата = СтрЗаменить(СтрокаРезультата, "  ", " ");
	
	Возврат СокрЛП(СтрокаРезультата);
	
КонецФункции

// Возвращает представление номенклатуры для печати.
//
// Параметры:
//  Номенклатура - Строка, СправочникСсылка.Номенклатура - номенклатура;
//  Характеристика - Строка, СправочникСсылка.ХарактеристикиНоменклатуры - (необязательный) характеристика номенклатуры;
//  ДополнительныеПараметры - Структура - (необязательный) см. функцию ДополнительныеПараметрыПредставленияНоменклатуры.
// 
// Возвращаемое значение:
//  Строка - представление номенклатуры.
//
Функция ПредставлениеНоменклатуры(Номенклатура, Характеристика = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт 
	
	Результат			 = "";
	СтандартнаяОбработка = Истина;
	
	Если ДополнительныеПараметры = Неопределено Тогда 
		ДополнительныеПараметры = ДополнительныеПараметрыПредставленияНоменклатуры();
	КонецЕсли;
	
	ПриПолученииПредставленияНоменклатуры(Результат, Номенклатура, Характеристика, ДополнительныеПараметры, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		
		Результат = СокрЛП(Номенклатура);
		Если ЗначениеЗаполнено(Характеристика) Тогда 
			Результат = ПодставитьПараметрыВСтроку("%1 (%2)", Результат, СокрЛП(Характеристика));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Дополнительные параметры функции ПредставлениеНоменклатуры.
// 
// Возвращаемое значение:
//  Структура - со свойствами:
//  * Упаковка	 - Строка, СправочникСсылка - упаковка / единица измерения номенклатуры;
//  * Серия		 - Строка, СправочникСсылка - серия номенклатуры;
//  * КодТНВЭД	 - Строка, СправочникСсылка - Код ТН ВЭД;
//  * Префикс - Строка - если указан, то к представлению будет добавлен префикс перед наименованием номенклатуры.
//  * КодОсновногоЯзыка - Строка - указывается для уточнения кода основного языка при выводе локализуемых строк.
//
Функция ДополнительныеПараметрыПредставленияНоменклатуры() Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("Содержание", "");
	Результат.Вставить("ВозвратнаяТара", Ложь);
	Результат.Вставить("Серия");
	Результат.Вставить("Упаковка");
	Результат.Вставить("КодТНВЭД");
	Результат.Вставить("КодОсновногоЯзыка", КодОсновногоЯзыка());
	Результат.Вставить("Префикс", "");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаДанных

// Возвращает список различных правил обработки, которые подходят для указанного вида документов.
// Виды документов можно передавать массивом. Например, для УПД можно передать массив из двух элементов:
//  * ТоварнаяНакладная
//  * АктОбОказанииУслуг
//
// Параметры:
//  * ВидЭД - Строка - вид документа (см. ВидыЭлектронныхДокументов);
//          - Массив - список видов документов.
//  * ЭтоИсправление - Булево - Истина, если требуется получить правила обработки исправления документа;
// 
// Возвращаемое значение:
//  СписокЗначений - где Значение - это идентификатор правила обработки (см. ПравилоОбработкиЭлектронныхДокументов),
//                   Представление - представление правила для пользовательского интерфейса.
//
Функция ПравилаОбработкиВидаДокументов(ВидЭД, ЭтоИсправление = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидЭД) Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	Если ТипЗнч(ВидЭД) = Тип("Массив") Тогда
		КоллекцияВидовЭД = ВидЭД;
	Иначе
		КоллекцияВидовЭД = Новый Массив;
		КоллекцияВидовЭД.Добавить(ВидЭД);
	КонецЕсли;
	
	Результат = Новый СписокЗначений;
	ДобавленныеИдентификаторы = Новый Соответствие;
	
	ТаблицаПравил = ПравилаОбработкиВходящихДокументов();
	
	Для Каждого ВидДокумента Из КоллекцияВидовЭД Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ВидДокумента", ВидДокумента);
		ПараметрыОтбора.Вставить("ЭтоИсправление", ЭтоИсправление);
		
		НайденныеСтроки = ТаблицаПравил.НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого Запись Из НайденныеСтроки Цикл
			
			ИдентификаторПравила = Запись.ИдентификаторПравила;
			
			Если ДобавленныеИдентификаторы[ИдентификаторПравила] = Истина Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавленныеИдентификаторы.Вставить(ИдентификаторПравила, Истина);
			
			Попытка
				
				ПравилоОбработки = ПравилоОбработкиЭлектронныхДокументов(ИдентификаторПравила);
				Результат.Добавить(ПравилоОбработки, ПравилоОбработки.Представление);
				
			Исключение
				
				Ошибка = ИнформацияОбОшибке();
				ПодробнаяИнформация = КраткоеПредставлениеОшибки(Ошибка);
				ШаблонКомментария = НСтр("ru = 'Не удалось инициализировать правило обработки электронных документов %1 при причине: %2'");
				КомментарийЖР = СтрШаблон(ШаблонКомментария, ИдентификаторПравила, ПодробнаяИнформация);
				СобытиеЖР = СобытиеЖурналаРегистрации();
				
				ЗаписьЖурналаРегистрации(
					СобытиеЖР,
					УровеньЖурналаРегистрации.Ошибка,
					Неопределено,
					ИдентификаторПравила,
					КомментарийЖР
				);
				
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает правила обработки обработки электронного документа, который
// выступает в роли первичного документа.
//
// Параметры:
//  ФорматЭД - Структура - описание формата (см. НовоеОписаниеФорматаЭлектронногоДокумента).
// 
// Возвращаемое значение:
//  СписокЗначений - см. ПравилаОбработкиВидаДокументов.
//
Функция ПравилаОбработкиПервичныхДокументов(ФорматЭД) Экспорт
	
	ВидДокумента = ФорматЭД.ВидПервичногоДокумента;
	ЭтоИсправление = ФорматЭД.ЭтоИсправление;
	Результат = ПравилаОбработкиВидаДокументов(ВидДокумента, ЭтоИсправление);
	
	Возврат Результат;
	
КонецФункции

// Получает правила обработки обработки электронного документа, который
// выступает в роли счета-фактуры.
//
// Параметры:
//  ФорматЭД - Структура - описание формата (см. НовоеОписаниеФорматаЭлектронногоДокумента).
// 
// Возвращаемое значение:
//  СписокЗначений - см. ПравилаОбработкиВидаДокументов.
//
Функция ПравилаОбработкиСчетовФактур(ФорматЭД) Экспорт
	
	ВидДокумента = ФорматЭД.ВидСчетаФактуры;
	ЭтоИсправление = ФорматЭД.ЭтоИсправление;
	Результат = ПравилаОбработкиВидаДокументов(ВидДокумента, ЭтоИсправление);
	
	Возврат Результат;
	
КонецФункции

// Формирует и заполняет структуру с данными электронного документа.
//
// Параметры:
//  ЭлектронныйДокумент	 - Структура - описание документа (см. НовыйЭлектронныйДокумент);
//  Контент				 - Структура - протоструктура;
// 
// Возвращаемое значение:
//  Структура - см. НовыйДанныеЭлектронногоДокумента;
//
Функция ДанныеЭлектронногоДокумента(ЭлектронныйДокумент, Контент) Экспорт
	
	ЭтоКорректировка	= ЭлектронныйДокумент.Формат.ЭтоКорректировка;
	ТипДокумента		= ЭлектронныйДокумент.Формат.ТипДокумента;
	Результат			= НовыйДанныеЭлектронногоДокумента();
	
	Если ТипДокумента = ТипДокумента_ДокументОРасхождениях() Тогда
		
		Шапка = ШапкаЭлектронногоДокумента423(Контент);
		
		ЗаполнитьКлючевыеСвойстваДокумента423(Шапка, Контент);
		
		СведенияТЧ = ДанныеТоварнойЧастиЭлектронногоДокумента423(Контент);
		
		Результат.Шапка = Шапка;
		Результат.ТоварнаяЧасть = СведенияТЧ;
		
		ЗаполнитьОрганизациюКонтрагентаИнформационнойБазы(Шапка, ЭлектронныйДокумент);
		
	ИначеЕсли ТипДокумента = ТипДокумента_АктСверки() Тогда
		
		Шапка = ШапкаАктаСверки405(Контент);
		
		СведенияТЧ = ДанныеТабличнойЧастиЭлектронногоДокумента405(Контент);
		
		Результат.Шапка = Шапка;
		Результат.ТоварнаяЧасть = СведенияТЧ.СверкаПоДаннымКонтрагента;
		Результат.Итоги = СведенияТЧ.ИтоговыеСуммы;
		
		ЗаполнитьОрганизациюКонтрагентаИнформационнойБазы405(Шапка, ЭлектронныйДокумент);
		
	ИначеЕсли ТипДокумента = ТипДокумента_СчетНаОплату() Тогда
		
		Шапка = ШапкаСчетаНаОплату(Контент);
		
		СведенияТЧ = ДанныеТоварнойЧастиЭлектронногоДокумента29(Контент, ЭтоКорректировка);
		
		Результат.Шапка = Шапка;
		Результат.Итоги = СведенияТЧ.ИтоговыеСуммы;
		Результат.ТоварнаяЧасть = СведенияТЧ.ТоварнаяЧасть;
		
		ЗаполнитьОрганизациюКонтрагентаИнформационнойБазы(Шапка, ЭлектронныйДокумент);
		
	Иначе
		
		Шапка = ШапкаЭлектронногоДокумента(Контент);
		
		Если ЭтоКорректировка Тогда
			ЗаполнитьКлючевыеСвойстваКорректируемогоДокумента(Шапка, Контент);
		КонецЕсли;
		
		СведенияТЧ = ДанныеТоварнойЧастиЭлектронногоДокумента(Контент, ЭтоКорректировка);
		
		Результат.Шапка = Шапка;
		Результат.Итоги = СведенияТЧ.ИтоговыеСуммы;
		Результат.ТоварнаяЧасть = СведенияТЧ.ТоварнаяЧасть;
		Результат.ЭтоАванс = ЭтоЭлектронныйСчетФактураНаАванс(Контент, Результат);
		
		ЗаполнитьОрганизациюКонтрагентаИнформационнойБазы(Шапка, ЭлектронныйДокумент);
		
	КонецЕсли;
	
	Результат.ЭлектронныйДокумент = ЭлектронныйДокумент;
	
	Возврат Результат;
	
КонецФункции

// Обогощает универсальную структуру электронного документа
// ссылками на объекты информационной базы.
//
// Параметры:
//  ДанныеЭД - Структура - см. функцию НовыйДанныеЭлектронногоДокумента;
//
Процедура ДополнитьОписаниеЭлектронногоДокументаДаннымиИБ(ДанныеЭД) Экспорт
	
	ШапкаЭД = ДанныеЭД.Шапка;

	НайтиОрганизацию(ШапкаЭД.Покупатель);
	НайтиКонтрагента(ШапкаЭД.Продавец);
	НайтиКонтрагента(ШапкаЭД.Грузоотправитель);
	НайтиКонтрагента(ШапкаЭД.Грузополучатель);
	
	НайтиВалюту(ШапкаЭД.Валюта);
	
	Организация	 = СсылкаНаУчастникаЭДО(ШапкаЭД.Покупатель);
	Контрагент	 = СсылкаНаУчастникаЭДО(ШапкаЭД.Продавец);
	
	УстановитьСвойствоСтруктуры(ДанныеЭД, "Шапка.Партнер.Контрагент", Контрагент);
	НайтиПартнера(ШапкаЭД.Партнер);
	
	ВладелецНоменклатуры = ВладелецНоменклатураПоставщиков(ШапкаЭД);
	
	ФорматЭД		= ДанныеЭД.ЭлектронныйДокумент.Формат;
	ТипДокумента	= ДанныеЭД.ЭлектронныйДокумент.Формат.ТипДокумента;
	
	Если ТипДокумента = ТипДокумента_Корректировочный() Тогда
		
		УстановитьСвойствоСтруктуры(ДанныеЭД, "Шапка.КорректируемыйДокумент.Организация", Организация);
		УстановитьСвойствоСтруктуры(ДанныеЭД, "Шапка.КорректируемыйДокумент.Контрагент", Контрагент);
		
		Если ФорматЭД.ЕстьФункцияСФ Тогда
			НайтиКорректируемыйСчетФактуру(ДанныеЭД.Шапка.КорректируемыйДокумент);
		КонецЕсли;
		
		НайтиКорректируемуюНакладную(ДанныеЭД.Шапка.КорректируемыйДокумент);
		
	КонецЕсли;
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		Стр.НоменклатураКонтрагента.Владелец = ВладелецНоменклатуры;
		
		НайтиНоменклатуруИнформационнойБазы(Стр.Номенклатура, Стр.НоменклатураКонтрагента);
		
		Если Стр.Свойство("ДанныеГТД") Тогда 
			
			Для Каждого Элемент Из Стр.ДанныеГТД Цикл 
				
				НайтиСтрану(Элемент.СтранаПроисхождения);
				НайтиНомерГТД(Элемент.НомерГТД);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Обогощает структуру электронного документа в фромате 405@
// ссылками на объекты информационной базы.
//
// Параметры:
//  ДанныеЭД - Структура - см. функцию НовыйДанныеЭлектронногоДокумента;
//
Процедура ДополнитьОписаниеЭлектронногоДокументаДаннымиИБ405(ДанныеЭД)
	
	ШапкаЭД = ДанныеЭД.Шапка;

	НайтиОрганизацию(ШапкаЭД.Получатель);
	НайтиКонтрагента(ШапкаЭД.Отправитель);
	
	НайтиВалюту(ШапкаЭД.Валюта);
	
	Контрагент = СсылкаНаУчастникаЭДО(ШапкаЭД.Отправитель);
	
	УстановитьСвойствоСтруктуры(ДанныеЭД, "Шапка.Партнер.Контрагент", Контрагент);
	
	НайтиПартнера(ШапкаЭД.Партнер);
	
КонецПроцедуры

// Создает новый экземпляр документа информационной базы и заполняет его
// по данным электронного документа. Созданный объект при этом не записывается.
//
// Параметры:
//  ДанныеЭД - Структура - Данные электронного документа (см. ДанныеЭлектронногоДокумента);
//  ИдентификаторПравилаОбработки - Строка - Идентификатор правила создания и заполнения документа информационной базы:
//                                  1. Имя метаданных документа:
//                                     правило обработки формируется автоматически по имени и представлению метаданного
//                                  2. Произвольная строка:
//                                     правило обработки требуется описать в событии ПриПолученииПравилаОбработкиЭлектронногоДокумента
// 
// Возвращаемое значение:
//  ДокументОбъект - заполненный, но еще не записанный, документ-объект.
//
// Пример:
// ПараметрыСозданияСФ = Новый Структура;
// ПараметрыСозданияСФ.Вставить("ДокументОснование", ДокументОснование);
// СчетФактураОбъект = МенеджерИнтеграции.НовыйДокументИнформационнойБазы(ДанныеЭД, "СчетФактураПолученный", ПараметрыСозданияСФ);
//
Функция НовыйДокументИнформационнойБазы(ДанныеЭД, ИдентификаторПравилаОбработки, ДополнительныеПараметры = Неопределено) Экспорт
	
	ТипДокумента = ДанныеЭД.ЭлектронныйДокумент.Формат.ТипДокумента;
	
	Если ТипДокумента = ТипДокумента_АктСверки() Тогда
		ДополнитьОписаниеЭлектронногоДокументаДаннымиИБ405(ДанныеЭД);
	Иначе
		ДополнитьОписаниеЭлектронногоДокументаДаннымиИБ(ДанныеЭД);
	КонецЕсли;
	
	ПравилоОбработки = ПравилоОбработкиЭлектронныхДокументов(ИдентификаторПравилаОбработки);
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ПравилоОбработки.ОбъектМетаданных);
	МенеджерОбъекта	 = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбъектМетаданных.ПолноеИмя());
	
	ПараметрыЗаполнения = Новый Структура;
	
	Если ЗначениеЗаполнено(ПравилоОбработки.ДополнительныеПараметры) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗаполнения, ПравилоОбработки.ДополнительныеПараметры, Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ПараметрыЗаполнения, ДополнительныеПараметры, Истина);
	КонецЕсли;
	
	НовыйОбъект = МенеджерОбъекта.СоздатьДокумент();
	
	СтандартнаяОбработка = Истина;
	ПриСозданииДокументаИнформационнойБазы(НовыйОбъект, ДанныеЭД, ПараметрыЗаполнения, СтандартнаяОбработка);
	
	// Стандартный механизм, как правило, заполняет документ так:
	// - реквизиты, в метаданных которых установлен флаг "ЗаполнятьИзДанныхЗаполнения"
	// - некоторые реквизиты заполняются значениями по умолчанию
	Если СтандартнаяОбработка Тогда 
		
		ЗначенияЗаполнения = ЗначенияЗаполненияДокументаИБ(ДанныеЭД); // Структура с найденными ссылками
		НовыйОбъект.Заполнить(ЗначенияЗаполнения);
		
		Если ЕстьРеквизитМетаданных(ОбъектМетаданных, "Комментарий")
			И Не ЗначениеЗаполнено(НовыйОбъект.Комментарий) Тогда
			НовыйОбъект.Комментарий = "Загружен из системы Диадок";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйОбъект.Дата) Тогда
			НовыйОбъект.Дата = ТекущаяДата();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НовыйОбъект.Номер) Тогда
			НовыйОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НовыйОбъект;
	
КонецФункции

// Выполняет поиск ссылок на объекты информационной базы по значениям реквизитов
//
// Параметры:
//  ОбластьПоиска	 - ОбъектМетаданных, Массив - метаданные объектов, по которым осуществляется поиск;
//  ПоляПоиска		 - Структура - содержит имена и значения реквизитов поиска;
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на найденные объекты.
//
Функция НайтиСсылкиПоЗначениямРеквизитов(ОбластьПоиска, ПоляПоиска) Экспорт
	
	Если ТипЗнч(ОбластьПоиска) = Тип("Массив") Тогда 
		КоллекцияМетаданных = ОбластьПоиска;
	Иначе 
		КоллекцияМетаданных = Новый Массив;
		КоллекцияМетаданных.Добавить(ОбластьПоиска);
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для Каждого ОписаниеОбъектаМетаданных Из КоллекцияМетаданных Цикл 
		
		ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
		
		ЕстьРеквизитыПоиска = Истина;
		Для Каждого Поле Из ПоляПоиска Цикл 
			
			Если Не ЕстьРеквизитМетаданных(ОбъектМетаданных, Поле.Ключ) Тогда 
				ЕстьРеквизитыПоиска = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЕстьРеквизитыПоиска Тогда 
			Продолжить;
		КонецЕсли;
		
		Буфер = ВыборкаОбъектовПоПараметрамПоиска(ОбъектМетаданных, ПоляПоиска);
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, Буфер, Истина);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Позволяет определить заполнен ли реквизит в документе.
//
// Параметры:
//  ИмяРеквизита - Строка - Строковое имя искомого реквизита.
//  Объект - ДокументОбъект - Объект, в котором проверяется заполненность реквизита.
//  МетаданныеОбъекта - Метаданные - Объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьНезаполненныйРеквизитОбъекта(ИмяРеквизита, Объект, МетаданныеОбъекта) Экспорт

	Результат = Ложь;
	
	Если ЕстьРеквизитМетаданных(МетаданныеОбъекта, ИмяРеквизита)
		И Не ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Возвращает массив учетных документов, сопоставленных с электронным документом.
//
// Параметры:
//  ИдентификаторЭД - Структура - полный идентификатор документа (см. Модуль_Клиент.ИдентификаторЭлектронногоДокумента)
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на документы учета (первичные документы и СФ).
//
Функция СопоставленныеУчетныеДокументы(ИдентификаторЭД) Экспорт
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ИдентификаторЭД) Тогда
		
		Результат = МетодСервера(, "DocumentID_2_МассивДокументов"
			, ИдентификаторЭД.СоставнойИдентификатор
			, ИдентификаторЭД.ИдентификаторОрганизации);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает номенклатуру электронного документа, которая 
// требует сопоставления с данными информационной базы.
//
// Параметры:
//  ДанныеЭД - Структура - Данные электронного документа;
// 
// Возвращаемое значение:
//  Соответствие - ключ - ключ строки документа, значение - номенклатура контрагента (см. НовыйКлючевыеСвойстваНоменклатураПоставщика).
//
Функция НоменклатураНаКонтроле(ДанныеЭД) Экспорт
	
	Результат = Новый Соответствие;
	
	Для Каждого Стр Из ДанныеЭД.ТоварнаяЧасть Цикл 
		
		ДанныеНоменклатуры = Стр.Номенклатура;
		
		Если Не ЗначениеЗаполнено(ДанныеНоменклатуры.Номенклатура) Тогда 
			
			Результат.Вставить(Стр.КлючСтроки, Стр.НоменклатураКонтрагента);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Функция находит счета-фактуры заданного документа.
//
// Параметры:
//  ДокументОснование	 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция СчетаФактурыПоОснованию(ДокументОснование) Экспорт 
	
	НайденныеДокументы	 = Новый Массив;
	СтандартнаяОбработка = Истина;
	ПараметрыРегистрации = ПараметрыРегистрацииСчетаФактурыПоОснованию(ДокументОснование);
	
	ПриПолученииСчетовФактурПоОснованию(НайденныеДокументы, ПараметрыРегистрации, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
	КонецЕсли;
	
	Возврат НайденныеДокументы;
	
КонецФункции

// Функция находит документы-основания заданного счета-фактуры.
//
// Параметры:
//  СчетФактура - ДокументСсылка - счет-фактура, основание которой нужно найти;
// 
// Возвращаемое значение:
//  Массив - содержит ссылки на основания счета-фактуры.
//
Функция ДокументыОснованияСчетаФактуры(СчетФактура) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЭтоСчетФактура(СчетФактура) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = СчетФактура.Метаданные();
	ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
	
	Если МетодСервера(, "СуществуетОбъектМетаданных", ПолноеИмяОбъекта+".ТабличнаяЧасть.ДокументыОснования") Тогда 
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ПолноеИмяТаблицы КАК Т
		|ГДЕ
		|	Т.Ссылка = &СчетФактура";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяТаблицы", ПолноеИмяОбъекта + ".ДокументыОснования");
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("СчетФактура", СчетФактура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			Результат.Добавить(Выборка.ДокументОснование);
		КонецЦикла;
		
	ИначеЕсли ЕстьРеквизитМетаданных(ОбъектМетаданных, "ДокументОснование") Тогда 
		
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетФактура, "ДокументОснование");
		Результат.Добавить(ДокументОснование);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеКонтента

// Заполняет объект AddressInfo по структуре сведений об адресе.
//
// Параметры:
//  AddressInfo		 - Структура - соответствует объекту https://diadocsdk-1c.readthedocs.io/ru/latest/AddressInfo.html;
//  СтруктураАдреса	 - Структура - см. функцию СведенияОбАдресе или урезанный вариант (КодСтраны и Представление);
//
Процедура Заполнить_AddressInfo(AddressInfo, СтруктураАдреса) Экспорт
	
	ЗаполнятьАдрРФ = Ложь;
	Если СохраненноеПредставлениеАдресаСовпадаетСРассчитанным(СтруктураАдреса) // проверка на консистентность адреса
		И ЭтоРоссийскийАдрес(СтруктураАдреса)
		И АдресСоответствуетФорматуКЛАДР(СтруктураАдреса) Тогда
		ЗаполнятьАдрРФ = Истина;
	КонецЕсли;
	
	Если ЗаполнятьАдрРФ Тогда 
		
		AddressInfo.IsForeign	 = Ложь;
		AddressInfo.ZipCode		 = СтруктураАдреса.Индекс;
		AddressInfo.RegionCode	 = СтруктураАдреса.КодРегиона;
		AddressInfo.Territory	 = ПолеАдресаССокращением(СтруктураАдреса.Район, СтруктураАдреса.РайонСокращение);
		AddressInfo.City		 = ПолеАдресаССокращением(СтруктураАдреса.Город, СтруктураАдреса.ГородСокращение);
		AddressInfo.Locality	 = ПолеАдресаССокращением(СтруктураАдреса.НаселенныйПункт, СтруктураАдреса.НаселенныйПунктСокращение);
		AddressInfo.Street		 = ПолеАдресаССокращением(СтруктураАдреса.Улица, СтруктураАдреса.УлицаСокращение);
		
		Если ЗначениеЗаполнено(СтруктураАдреса.Здание) Тогда 
			СтруктураАдреса.Здание.Свойство("Номер", AddressInfo.Building);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураАдреса.Корпуса) Тогда 
			СтруктураАдреса.Корпуса[0].Свойство("Номер", AddressInfo.Block);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураАдреса.Помещения) Тогда 
			СтруктураАдреса.Помещения[0].Свойство("Номер", AddressInfo.Apartment);
		КонецЕсли;
		
	Иначе 
		
		// Для российских адресов не по КЛАДР тоже установим флаг в значение Истина,
		// чтобы обойти некорректную проверку адреса в компоненте
		AddressInfo.IsForeign	 = Истина;
		AddressInfo.CountryCode	 = СтруктураАдреса.КодСтраны;
		AddressInfo.AddressText	 = СтруктураАдреса.СохраненноеПредставление;
		
	КонецЕсли;
	
КонецПроцедуры

// Заполняет массив структур поля StructedAdditionalInfos
//
// Параметры:
//  StructedAdditionalInfos - Массив - Коллекция дополнительных сведений
//  ДопСведения             - Строка - Дополнительные сведения в формате "ключ1=значение1;ключ2=значение2"
//
Процедура ЗаполнитьStructedAdditionalInfos(StructedAdditionalInfos, ДопСведения) Экспорт

	МетодСервера(, "ЗаполнитьStructedAdditionalInfos", StructedAdditionalInfos, ДопСведения);

КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

// Добавляет в указанный массив новую структуру с ключами "Ключ" и "Значение".
//
// Параметры:
//  Коллекция	 - Массив - коллекция структур;
//  Ключ		 - Строка - произвольная строка;
//  Значение	 - Произвольный - произвольное значение.
//
Процедура ДобавитьКлючЗначение(Коллекция, Ключ, Значение) Экспорт
	
	ЭлементКоллекции = Новый Структура;
	ЭлементКоллекции.Вставить("Ключ", Ключ);
	ЭлементКоллекции.Вставить("Значение", Значение);
	
	Коллекция.Добавить(ЭлементКоллекции);
	
КонецПроцедуры

// Дополняет таблицу значений-приемник данными из таблицы значений-источник.
//
// Параметры:
//  ТаблицаПриемник - ТаблицаЗначений - таблица, в которую будут добавлены строки из таблицы-источника.
//  ТаблицаИсточник - ТаблицаЗначений - таблица, из которой будут браться строки для заполнения;
//  
Процедура ДополнитьТаблицу(ТаблицаПриемник, ТаблицаИсточник) Экспорт
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет существование реквизита метаданных.
//
// Параметры:
//  ОбъектМетаданных				 - ОбъектМетаданных	 - метаданные произвольного объекта.
//  ИмяРеквизита					 - Строка			 - имя проверяемого реквизита.
//  ПроверятьСтандартныеРеквизиты	 - Булево			 - Истина, если при проверке следует учитывать стандартные реквизиты (Код, Наименование и т.д.)
// 
// Возвращаемое значение:
//  Булево - Истина, если реквизит с заданным именем существует.
//
Функция ЕстьРеквизитМетаданных(ОбъектМетаданных, ИмяРеквизита, ПроверятьСтандартныеРеквизиты = Ложь) Экспорт
	
	Если ОбъектМетаданных = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьРеквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
	Если Не ЕстьРеквизит И ПроверятьСтандартныеРеквизиты Тогда 
		
		КоллекцияРеквизитов = ОбъектМетаданных.СтандартныеРеквизиты;
		
		Для Каждого СтандартныйРеквизит Из КоллекцияРеквизитов Цикл 
			
			Если ВРег(СтандартныйРеквизит.Имя) = ВРег(ИмяРеквизита) Тогда 
				ЕстьРеквизит = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЕстьРеквизит;
	
КонецФункции

Функция ЗначенияРеквизитовОбъектаЛокальная(Ссылка, Реквизиты) Экспорт
	
	Результат = МетодСервера(, "ЗначенияРеквизитовОбъекта", Ссылка, Реквизиты);
	
	Возврат Результат;
	
КонецФункции

// Проверяет существование и использование общего реквизита для объекта метаданных.
//
// Параметры:
//  ОбъектМетаданных				 - ОбъектМетаданных	 - метаданные произвольного объекта.
//  ИмяРеквизита					 - Строка			 - имя проверяемого реквизита.
// 
// Возвращаемое значение:
//  Булево - Истина, если реквизит с заданным именем существует.
//
Функция ЕстьОбщийРеквизит(ОбъектМетаданных, ИмяРеквизита) Экспорт
	
	Если ОбъектМетаданных = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьРеквизит = Ложь;
		
	КоллекцияРеквизитов = Метаданные.ОбщиеРеквизиты;
	
	Для Каждого ОбщийРеквизит Из КоллекцияРеквизитов Цикл
		
		Если ВРег(ОбщийРеквизит.Имя) = ВРег(ИмяРеквизита) Тогда
			
			ИспользованиеОбщегоРеквизита = ОбщийРеквизит.Состав.Найти(ОбъектМетаданных);
			
			Если ИспользованиеОбщегоРеквизита.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать Тогда
				ЕстьРеквизит = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьРеквизит;
	
КонецФункции

// Возвращает таблицу значений с данными табличной части объекта.
// 
//  Если доступа к одному из реквизитов нет, возникнет исключение прав доступа.
//  Если необходимо зачитать реквизит независимо от прав текущего пользователя,
//  то следует использовать предварительный переход в привилегированный режим.
// 
// Параметры:
//  Ссылка    - ЛюбаяСсылка - элемент справочника, документ, ...
//  ИмяТЧ     - Строка - имя табличной части.
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую, в формате
//              требований к свойствам структуры.
//              Например, "Код, Наименование, Родитель".
//            - Структура, ФиксированнаяСтруктура - в качестве ключа передается
//              псевдоним поля для возвращаемой структуры с результатом, а в качестве
//              значения (опционально) фактическое имя поля в таблице.
//              Если значение не определено, то имя поля берется из ключа.
//            - Массив, ФиксированныйМассив - имена реквизитов в формате требований
//              к свойствам структуры.
//  ДополнительныеПараметры - Структура, Неопределено - параметры, которые нужно передать в запрос.
//
// Возвращаемое значение:
//  ТаблицаЗначений - содержит затребованные данные табличной части.
//
Функция ЗначенияРеквизитовТабличнойЧасти(Ссылка, ИмяТЧ, Реквизиты, ДополнительныеПараметры = Неопределено)
	
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		Если ПустаяСтрока(Реквизиты) Тогда
			Возврат Новый Структура;
		КонецЕсли;
		
		СтруктураРеквизитов = Новый Структура(Реквизиты);
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Структура")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированнаяСтруктура") Тогда
		
		СтруктураРеквизитов = Реквизиты;
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		
		СтруктураРеквизитов = Новый Структура;
		Для каждого Реквизит Из Реквизиты Цикл
			СтруктураРеквизитов.Вставить(Реквизит);
		КонецЦикла;
	Иначе
		
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Неверный тип второго параметра Реквизиты: %1'"),
		Строка(ТипЗнч(Реквизиты)));
		
	КонецЕсли;
	
	Результат	 = Новый ТаблицаЗначений;
	ТекстПолей	 = "";
	
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		
		ИмяПоля   = ?(ЗначениеЗаполнено(КлючИЗначение.Значение),
		СокрЛП(КлючИЗначение.Значение),
		СокрЛП(КлючИЗначение.Ключ));
		
		Псевдоним = СокрЛП(КлючИЗначение.Ключ);
		
		ТекстПолей  = ТекстПолей 
		+ 	?(ЗначениеЗаполнено(ТекстПолей), ",", "")
		+ 	"
			|	" + ИмяПоля + " КАК " + Псевдоним;
		
		Результат.Колонки.Добавить(Псевдоним);
		
	КонецЦикла;
	
	ПолноеИмяТаблицы = Ссылка.Метаданные().ПолноеИмя() + "." + ИмяТЧ;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда 
		
		Для Каждого Параметр Из ДополнительныеПараметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + ТекстПолей + "
	|ИЗ
	|	" + ПолноеИмяТаблицы + " КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки
	|";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение свойства структуры или значение по умолчанию,
// если указанное свойство не существует. 
// 
// Параметры:
//   СложнаяСтруктура    - Структура   - Структура, которая может содержать вложенные структуры.
//   ИерархияСвойств     - Строка     - Полное имя ключа с учетом вложенности структур
//                         (имена свойств вложенных структур отделяются точкой);
//   ЗначениеПоУмолчанию - Произвольный   - Необязательный. Возвращается когда в структуре нет значения по указанному
//                         ключу. Для скорости рекомендуется передавать только быстро вычисляемые 
//                         значения (например примитивные типы),а инициализацию более тяжелых значений
//                         выполнять после проверки полученного значения (только если это требуется);
// 
// Возвращаемое значение:
//   Произвольный - Значение свойства структуры. ЗначениеПоУмолчанию если в структуре нет указанного свойства.
//
Функция СвойствоСтруктуры(СложнаяСтруктура, ИерархияСвойств, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	
	Если Не ЗначениеЗаполнено(ИерархияСвойств) Или СложнаяСтруктура = Неопределено Тогда // ЗначениеЗаполнено не применять, т.к. это может быть объект ДанныеФормыСтруктура
		Возврат Результат;
	КонецЕсли;
	
	ПростыеКлючи = РазложитьСтрокуВМассивПодстрок(ИерархияСвойств, ".", Ложь);
	
	ЗначениеПолучено = Ложь;
	ТекущееЗначение   = Неопределено;
	ТекущаяСтруктура = СложнаяСтруктура;
	
	ВГраница = ПростыеКлючи.ВГраница();
	
	Для Сч = 0 По ВГраница Цикл
		
		ТекущийКлюч = ПростыеКлючи[Сч];
		
		Если ТекущаяСтруктура.Свойство(ТекущийКлюч, ТекущееЗначение) Тогда
			
			Если Сч = ВГраница Тогда
				
				// Это последний ПолныйКлюч в массиве
				ЗначениеПолучено = Истина;
				
			ИначеЕсли ТипЗнч(ТекущееЗначение) = Тип("Структура") Тогда
				
				// Есть подчиненная СложнаяСтруктура для получения следующего значения
				ТекущаяСтруктура = ТекущееЗначение;
				
			Иначе
				Прервать;
			КонецЕсли;
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеПолучено Тогда
		Результат = ТекущееЗначение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Установить свойство структуры
//
// Параметры:
//  Структура		 - Структура - Структура, которая может содержать вложенные структуры;
//  ИерархияСвойств	 - Строка - Полное имя ключа с учетом вложенности структур
//                     (имена свойств вложенных структур отделяются точкой);
//  Значение		 - Произвольный - значение устанавливаемого свойства;
//
Процедура УстановитьСвойствоСтруктуры(Структура, Знач ИерархияСвойств, Знач Значение) Экспорт
	
	Если ТипЗнч(ИерархияСвойств) = Тип("Строка") Тогда
		ИерархияСвойств = РазложитьСтрокуВМассивСлов(ИерархияСвойств, ".");
	КонецЕсли;
	
	ТекущееСвойство = ИерархияСвойств[0];
	
	Если ИерархияСвойств.Количество() = 1 Тогда
		
		Структура.Вставить(ТекущееСвойство, Значение);
		
	Иначе
		
		ТекущееЗначение = Неопределено;
		Если Не Структура.Свойство(ТекущееСвойство, ТекущееЗначение) Тогда
			ТекущееЗначение = Новый Структура;
		КонецЕсли;
		ИерархияСвойств.Удалить(0);
		УстановитьСвойствоСтруктуры(ТекущееЗначение, ИерархияСвойств, Значение);
		Структура.Вставить(ТекущееСвойство, ТекущееЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

Функция СкопироватьСтруктуру(Знач СтруктураИсходник) Экспорт
	
	СтруктураПриемник=	Новый Структура;
	Для каждого ЭлементИсходник Из СтруктураИсходник Цикл
		Если ТипЗнч(ЭлементИсходник.Значение) = Тип("Массив") Тогда
			СтруктураПриемник.Вставить(ЭлементИсходник.Ключ, Новый Массив);	
		Иначе
			СтруктураПриемник.Вставить(ЭлементИсходник.Ключ, Неопределено);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтруктураПриемник;
	
КонецФункции

// Находит ссылку на объект ИБ по различным комбинациям свойств объекта.
//
// Параметры:
//  СвойстваОбъекта	 - Структура - содержит имена и значения реквизитов искомого объекта;
//  ВариантыПоиска	 - Массив	 - содержит строки с именами реквизитов, по которым выполняется поиск;
//  ОписаниеОбъектаМетаданных - ОбъектМетаданных, Тип, Строка
// 
// Возвращаемое значение:
//  ЛюбаяСсылка - ссылка на найденный объект ИБ;
//  Неопределено - если объект не найден;
//
Функция СсылкаОбъектаПоСвойствам(СвойстваОбъекта, ВариантыПоиска, ОписаниеОбъектаМетаданных) Экспорт
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ВариантыПоиска) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	
	Для Каждого КомбинацияПолей Из ВариантыПоиска Цикл 
		
		ПоляПоиска = Новый Структура(КомбинацияПолей);
		ЗаполнитьЗначенияСвойств(ПоляПоиска, СвойстваОбъекта);
		
		// Вариант поиска является полноценным, если заполнены все поля.
		// В противном случае должен сработать другой вариант поиска.
		Если Не ВсеПоляКоллекцииЗаполнены(ПоляПоиска) Тогда 
			Продолжить;
		КонецЕсли;
		
		Результат = СсылкаОбъектаПоПолямПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных);
		
		Если ЗначениеЗаполнено(Результат) Тогда 
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Находит ссылку на объект ИБ по различным комбинациям полей поиска.
//
// Параметры:
//  НаборПолейПоиска			 - Массив - содержит структуры с полями поиска;
//  ОписаниеОбъектаМетаданных	 - ОбъектМетаданных, Тип, Строка - объект метаданных, тип или полное имя объекта метаданных;
//  ОднозначноеСоответствие		 - Булево - Истина, если требуется найти единственную подходящую ссылку;
// 
// Возвращаемое значение:
//  ЛюбаяСсылка	 - ссылка на найденный объект ИБ;
//  Неопределено - если объект не найден;
//
Функция СсылкаОбъектаПоНаборуПолейПоиска(НаборПолейПоиска, ОписаниеОбъектаМетаданных, ОднозначноеСоответствие = Истина)
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(НаборПолейПоиска) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	
	Для Каждого ПоляПоиска Из НаборПолейПоиска Цикл 
		
		// Вариант поиска является полноценным, если заполнены все поля.
		// В противном случае должен сработать другой вариант поиска.
		Если Не ВсеПоляКоллекцииЗаполнены(ПоляПоиска) Тогда 
			Продолжить;
		КонецЕсли;
		
		Результат = СсылкаОбъектаПоПолямПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных, ОднозначноеСоответствие);
		
		Если ЗначениеЗаполнено(Результат) Тогда 
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Находит ссылку на объект информационной базы по значениям полей
//
// Параметры:
//  ПоляПоиска					 - Структура - содержит имена и значения полей;
//  ОписаниеОбъектаМетаданных	 - ОбъектМетаданных, Тип, Строка - объект метаданных, тип или полное имя объекта метаданных;
//  ОднозначноеСоответствие		 - Булево - Истина, если требуется найти единственную подходящую ссылку;
// 
// Возвращаемое значение:
//  ЛюбаяСсылка	 - ссылка на найденный объект ИБ;
//  Неопределено - если объект не найден;
//
Функция СсылкаОбъектаПоПолямПоиска(ПоляПоиска, ОписаниеОбъектаМетаданных, ОднозначноеСоответствие = Истина) Экспорт
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(ПоляПоиска) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ОбъектМетаданных = ОбъектМетаданныхПоОписанию(ОписаниеОбъектаМетаданных);
	ЭтоДокумент		 = Метаданные.Документы.Содержит(ОбъектМетаданных);
	ЭтоСправочник	 = Метаданные.Справочники.Содержит(ОбъектМетаданных);
	
	СтандартнаяОбработка = Истина;
	ПриПолученииСсылкиПоПолямПоиска(Результат, ПоляПоиска, ОбъектМетаданных, СтандартнаяОбработка);
	
	Если Не СтандартнаяОбработка Тогда 
		Возврат Результат;
	КонецЕсли;
	
	// Если есть возможность, используем платформенные методы поиска
	Если ЭтоДокумент
		И ПоляПоиска.Количество() = 2
		И ПоляПоиска.Свойство("Дата")
		И ПоляПоиска.Свойство("Номер") Тогда
		
		МенеджерОбъекта = Документы[ОбъектМетаданных.Имя];
		Результат = МенеджерОбъекта.НайтиПоНомеру(ПоляПоиска.Номер, ПоляПоиска.Дата);
		
	ИначеЕсли ЭтоСправочник 
		И ПоляПоиска.Количество() = 1
		И ПоляПоиска.Свойство("Наименование") Тогда 
		
		МенеджерОбъекта = Справочники[ОбъектМетаданных.Имя];
		Результат = МенеджерОбъекта.НайтиПоНаименованию(ПоляПоиска.Наименование, Истина);
		
	ИначеЕсли ЭтоСправочник 
		И ПоляПоиска.Количество() = 1
		И ПоляПоиска.Свойство("Код") Тогда 
		
		МенеджерОбъекта = Справочники[ОбъектМетаданных.Имя];
		Результат = МенеджерОбъекта.НайтиПоКоду(ПоляПоиска.Код);
		
	ИначеЕсли ПоляПоиска.Количество() = 1
		И ПоляПоиска.Свойство("ИдентификаторОрганизации") Тогда
		
		Результат = СсылкаПоИдентификаторуОрганизации(ПоляПоиска.ИдентификаторОрганизации, ОбъектМетаданных);
		
	ИначеЕсли ПоляПоиска.Количество() = 1
		И ПоляПоиска.Свойство("ИдентификаторУчастникаЭДО") Тогда // TODO: поиск по fnsParticipantId
		
	Иначе // Поиск запросом
		
		НайденныеСсылки = ВыборкаОбъектовПоПараметрамПоиска(ОбъектМетаданных, ПоляПоиска, Ложь);
		
		Если НайденныеСсылки.Количество() = 1 Тогда 
			Результат = НайденныеСсылки[0];
		ИначеЕсли НайденныеСсылки.Количество() > 1 И Не ОднозначноеСоответствие Тогда 
			Результат = НайденныеСсылки[0];
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда 
		Результат = Неопределено; // поиск платформенными методами может возвращать пустые ссылки
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Преобразовывает произвольное значение в число.
//
// Параметры:
//  Значение - Произвольный - произвольное значение.
// 
// Возвращаемое значение:
//  Число - результат преобразования.
//
// Пример:
//   Цена = ПривестиКЧислу("1 000,50"); // результат 1000.5
//
Функция ПривестиКЧислу(Знач Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда // нечего преобразовывать
		Возврат Значение;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда // удалим пробелы
		Значение = СтрЗаменить(Значение, " ", "");
	КонецЕсли;
	
	ОписаниеТипов = Новый ОписаниеТипов("Число");
	Результат = ОписаниеТипов.ПривестиЗначение(Значение);
	
	Возврат Результат;
	
КонецФункции

// Значение возвращаемое в "DocumentName" объекта "TransferBase" в случае отсутствия 
// документа основания отгрузки
Функция ДокументОснованиеОтгрузкиОтсутствует() Экспорт
	
	Возврат "Отсутствует";
	
КонецФункции

Функция СтруктураЗаполнена(Структура)
	
	Результат = Ложь;
	
	Для Каждого КлючИЗначение Из Структура Цикл
		
		ТипЗначения = ТипЗнч(КлючИЗначение.Значение);
		
		Если ТипЗначения = Тип("Структура") Тогда
			Результат = СтруктураЗаполнена(КлючИЗначение.Значение);
		ИначеЕсли ТипЗначения = Тип("Булево") Тогда
			Результат = КлючИЗначение.Значение = Истина;
		Иначе
			Результат = ЗначениеЗаполнено(КлючИЗначение.Значение);
		КонецЕсли;
		
		Если Результат = Истина Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СтроковыеФункции

// Разбивает строку на несколько строк по разделителю. Разделитель может иметь любую длину.
//
// Параметры:
//  Строка                 - Строка - текст с разделителями;
//  Разделитель            - Строка - разделитель строк текста, минимум 1 символ;
//  ПропускатьПустыеСтроки - Булево - признак необходимости включения в результат пустых строк.
//    Если параметр не задан, то функция работает в режиме совместимости со своей предыдущей версией:
//     - для разделителя-пробела пустые строки не включаются в результат, для остальных разделителей пустые строки
//       включаются в результат.
//     - если параметр Строка не содержит значащих символов или не содержит ни одного символа (пустая строка), то в
//       случае разделителя-пробела результатом функции будет массив, содержащий одно значение "" (пустая строка), а
//       при других разделителях результатом функции будет пустой массив.
//  СокращатьНепечатаемыеСимволы - Булево - сокращать непечатаемые символы по краям каждой из найденных подстрок.
//
// Возвращаемое значение:
//  Массив - массив строк.
//
// Примеры:
//  РазложитьСтрокуВМассивПодстрок(",один,,два,", ",") - возвратит массив из 5 элементов, три из которых  - пустые строки;
//  РазложитьСтрокуВМассивПодстрок(",один,,два,", ",", Истина) - возвратит массив из двух элементов;
//  РазложитьСтрокуВМассивПодстрок(" один   два  ", " ") - возвратит массив из двух элементов;
//  РазложитьСтрокуВМассивПодстрок("") - возвратит пустой массив;
//  РазложитьСтрокуВМассивПодстрок("",,Ложь) - возвратит массив с одним элементом "" (пустой строкой);
//  РазложитьСтрокуВМассивПодстрок("", " ") - возвратит массив с одним элементом "" (пустой строкой);
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено, СокращатьНепечатаемыеСимволы = Ложь)
	
	Результат = Новый Массив;
	
	// для обеспечения обратной совместимости
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда 
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	//
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Если СокращатьНепечатаемыеСимволы Тогда
				Результат.Добавить(СокрЛП(Подстрока));
			Иначе
				Результат.Добавить(Подстрока);
			КонецЕсли;
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Если СокращатьНепечатаемыеСимволы Тогда
			Результат.Добавить(СокрЛП(Строка));
		Иначе
			Результат.Добавить(Строка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// Объединяет строки из массива в строку с разделителями.
//
// Параметры:
//  Массив      - Массив - массив строк которые необходимо объединить в одну строку;
//  Разделитель - Строка - любой набор символов, который будет использован в качестве разделителя.
//
// Возвращаемое значение:
//  Строка - строка с разделителями.
// 
Функция СтрокаИзМассиваПодстрок(Массив, Разделитель = ",", СокращатьНепечатаемыеСимволы = Ложь)
	
	Результат = "";
	
	Для Индекс = 0 По Массив.ВГраница() Цикл
		Подстрока = Массив[Индекс];
		
		Если СокращатьНепечатаемыеСимволы Тогда
			Подстрока = СокрЛП(Подстрока);
		КонецЕсли;
		
		Если ТипЗнч(Подстрока) <> Тип("Строка") Тогда
			Подстрока = Строка(Подстрока);
		КонецЕсли;
		
		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		
		Результат = Результат + Подстрока;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли символ разделителем.
//
// Параметры:
//  КодСимвола      - Число  - код проверяемого символа;
//  РазделителиСлов - Строка - символы разделителей.
//
// Возвращаемое значение:
//  Булево - истина, если символ является разделителем.
//
Функция ЭтоРазделительСлов(КодСимвола, РазделителиСлов = Неопределено)
	
	Если РазделителиСлов <> Неопределено Тогда
		Возврат Найти(РазделителиСлов, Символ(КодСимвола)) > 0;
	КонецЕсли;
		
	Диапазоны = Новый Массив;
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 48, 57)); 		// цифры
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 65, 90)); 		// латиница большие
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 97, 122)); 		// латиница маленькие
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 1040, 1103)); 	// кириллица
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 1025, 1025)); 	// символ "Ё"
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 1105, 1105)); 	// символ "ё"
	Диапазоны.Добавить(Новый Структура("Мин,Макс", 95, 95)); 		// символ "_"
	
	Для Каждого Диапазон Из Диапазоны Цикл
		Если КодСимвола >= Диапазон.Мин И КодСимвола <= Диапазон.Макс Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Разбивает строку на несколько строк, используя заданный набор разделителей.
// Если параметр РазделителиСлов не задан, то разделителем слов считается любой из символов, 
// не относящихся к символам латиницы, кириллицы, цифры, подчеркивания.
//
// Параметры:
//  Строка          - Строка - строка, которую необходимо разложить на слова.
//  РазделителиСлов - Строка - строка, содержащая символы-разделители.
//
//  Возвращаемое значение:
//      массив значений, элементы которого - отдельные слова
//
// Пример:
//  РазложитьСтрокуВМассивСлов("один-@#два2_!три") возвратит массив значений: "один", "два2_", "три";
//  РазложитьСтрокуВМассивСлов("один-@#два2_!три", "#@!_") возвратит массив значений: "один-", "два2", "три".
//
Функция РазложитьСтрокуВМассивСлов(Знач Строка, РазделителиСлов = Неопределено)
	
	Слова = Новый Массив;
	
	РазмерТекста = СтрДлина(Строка);
	НачалоСлова = 1;
	Для Позиция = 1 По РазмерТекста Цикл
		КодСимвола = КодСимвола(Строка, Позиция);
		Если ЭтоРазделительСлов(КодСимвола, РазделителиСлов) Тогда
			Если Позиция <> НачалоСлова Тогда
				Слова.Добавить(Сред(Строка, НачалоСлова, Позиция - НачалоСлова));
			КонецЕсли;
			НачалоСлова = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Позиция <> НачалоСлова Тогда
		Слова.Добавить(Сред(Строка, НачалоСлова, Позиция - НачалоСлова));
	КонецЕсли;
	
	Возврат Слова;
	
КонецФункции

// Подставляет параметры в строку. Максимально возможное число параметров - 9.
// Параметры в строке задаются как %<номер параметра>. Нумерация параметров начинается с единицы.
//
// Параметры:
//  СтрокаПодстановки  - Строка - шаблон строки с параметрами (вхождениями вида "%ИмяПараметра");
//  Параметр<n>        - Строка - подставляемый параметр.
//
// Возвращаемое значение:
//  Строка   - текстовая строка с подставленными параметрами.
//
// Пример:
//  ПодставитьПараметрыВСтроку(НСтр("ru='%1 пошел в %2'"), "Вася", "Зоопарк") = "Вася пошел в Зоопарк".
//
Функция ПодставитьПараметрыВСтроку(Знач СтрокаПодстановки,
	Знач Параметр1, Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
	Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено)
	
	ИспользоватьАльтернативныйАлгоритм = 
		Найти(Параметр1, "%")
		Или Найти(Параметр2, "%")
		Или Найти(Параметр3, "%")
		Или Найти(Параметр4, "%")
		Или Найти(Параметр5, "%")
		Или Найти(Параметр6, "%")
		Или Найти(Параметр7, "%")
		Или Найти(Параметр8, "%")
		Или Найти(Параметр9, "%");
		
	Если ИспользоватьАльтернативныйАлгоритм Тогда
		СтрокаПодстановки = ПодставитьПараметрыВСтрокуАльтернативныйАлгоритм(СтрокаПодстановки, Параметр1,
			Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7, Параметр8, Параметр9);
	Иначе
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%1", Параметр1);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%2", Параметр2);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%3", Параметр3);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%4", Параметр4);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%5", Параметр5);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%6", Параметр6);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%7", Параметр7);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%8", Параметр8);
		СтрокаПодстановки = СтрЗаменить(СтрокаПодстановки, "%9", Параметр9);
	КонецЕсли;
	
	Возврат СтрокаПодстановки;
КонецФункции

// Формирует строку повторяющихся символов заданной длины.
//
// Параметры:
//  Символ      - Строка - символ, из которого будет формироваться строка.
//  ДлинаСтроки - Число  - требуемая длина результирующей строки.
//
// Возвращаемое значение:
//  Строка - строка, состоящая из повторяющихся символов.
//
Функция СформироватьСтрокуСимволов(Знач Символ, Знач ДлинаСтроки)
	
	Результат = "";
	Для Счетчик = 1 По ДлинаСтроки Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Дополняет строку символами слева или справа до заданной длины и возвращает ее.
// Незначащие символы слева и справа удаляются. По умолчанию функция дополняет строку символами "0" (ноль) слева.
//
// Параметры:
//  Строка      - Строка - исходная строка, которую необходимо дополнить символами;
//  ДлинаСтроки - Число  - требуемая результирующая длина строки;
//  Символ      - Строка - символ, которым необходимо дополнить строку;
//  Режим       - Строка - "Слева" или "Справа" - режим добавления символов к исходной строке.
// 
// Возвращаемое значение:
//  Строка - строка, дополненная символами.
//
// Пример 1:
// Строка = "1234"; ДлинаСтроки = 10; Символ = "0"; Режим = "Слева"
// Возврат: "0000001234"
//
// Пример 2:
// Строка = " 1234  "; ДлинаСтроки = 10; Символ = "#"; Режим = "Справа"
// Возврат: "1234######"
//
Функция ДополнитьСтроку(Знач Строка, Знач ДлинаСтроки, Знач Символ = "0", Знач Режим = "Слева")
	
	// длина символа не должна превышать единицы
	Символ = Лев(Символ, 1);
	
	// удаляем крайние пробелы слева и справа строки
	Строка = СокрЛП(Строка);
	
	КоличествоСимволовНадоДобавить = ДлинаСтроки - СтрДлина(Строка);
	
	Если КоличествоСимволовНадоДобавить > 0 Тогда
		
		СтрокаДляДобавления = СформироватьСтрокуСимволов(Символ, КоличествоСимволовНадоДобавить);
		
		Если ВРег(Режим) = "СЛЕВА" Тогда
			
			Строка = СтрокаДляДобавления + Строка;
			
		ИначеЕсли ВРег(Режим) = "СПРАВА" Тогда
			
			Строка = Строка + СтрокаДляДобавления;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Строка;
	
КонецФункции

// Определяет, заканчивается ли строка указанной подстрокой.
//
// Параметры:
//  Строка			 - Строка - Строка, окончание которой проверяется на совпадение с подстрокой поиска.
//  СтрокаПоиска	 - Строка - Строка, содержащая предполагаемое окончание строки. 
//                              В случае если переданное значение является пустой строкой генерируется исключение.
//  УчитыватьРегистр - Булево - Истина, если проверять совпадение следует с учетом регистра.
// 
// Возвращаемое значение:
//  Булево - Истина, если строка заканчивается указанной подстрокой.
//
Функция СтрокаЗаканчиваетсяНа(Знач Строка, Знач СтрокаПоиска, УчитыватьРегистр = Истина)
	
	Если Не ЗначениеЗаполнено(СтрокаПоиска) Или Не ТипЗнч(СтрокаПоиска) = Тип("Строка") Тогда 
		ТекстИсключения = НСтр("ru = 'Ошибка при вызове метода контекста (СтрокаЗаканчиваетсяНа): 
                                |Недопустимое значение параметра (параметр номер ''2'')'");
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если Не УчитыватьРегистр Тогда 
		Строка		 = ВРег(Строка);
		СтрокаПоиска = ВРег(СтрокаПоиска);
	КонецЕсли;
	
	Результат = Ложь;
	Если Прав(Строка, СтрДлина(СтрокаПоиска)) = СтрокаПоиска Тогда 
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Удаляет с конца строки заданное количество символов.
//
// Параметры:
//  Строка				 - Строка	 - исходная строка.
//  КоличествоСимволов	 - Число	 - количество удаляемых символов.
// 
// Возвращаемое значение:
//  Строка - обрезанная строка.
//
Функция ОбрезатьСтрокуСправа(Строка, КоличествоСимволов = 1)
	
	Результат = Лев(Строка, СтрДлина(Строка) - КоличествоСимволов);
	
	Возврат Результат;
	
КонецФункции

// Сравнить две строки версий.
//
// Параметры
//  СтрокаВерсии1  - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС
//  СтрокаВерсии2  - Строка - второй сравниваемый номер версии
//
// Возвращаемое значение:
//   Число - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
//
Функция СравнитьВерсии(Знач СтрокаВерсии1, Знач СтрокаВерсии2) Экспорт
	
	Результат = МетодСервера(, "СравнитьВерсии", СтрокаВерсии1, СтрокаВерсии2);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РаботаСКонтактнойИнформацией

// Возвращает сведения об адресе в виде отдельных частей адреса и различных кодов (код региона, ОКТМО и др.).
//
// Параметры:
//   Адрес                  - Строка	 - адрес во внутреннем формате JSON;
//                          - Строка	 - адрес в формате XML, соответствующем XDTO пакету Адрес;
//                          - Строка	 - адрес в формате "9 запятых" (КЛАДР);
//                          - ОбъектXDTO - XDTO объект, соответствующий XDTO пакету Адрес;
//   ДополнительныеПараметры - Структура - для уточнения возвращаемого значения:
//       * БезПредставлений - Булево - Если Истина, то поле Представление будет отсутствовать. По умолчанию, Ложь.
//       * КодыАдреса       - Булево - Если Истина, то результат содержит поля ИдентификаторАдресногоОбъекта, ИдентификаторДома
//                                     и структура с кодами адреса(Идентификаторы, ДополнительныеКоды, КодыКЛАДР).
//                                     Подробнее см. в возвращаемом значении структуры Идентификаторы и ДополнительныеКоды. По умолчанию, Ложь.
//                                     Если в адресе отсутствуют идентификаторы и в программу не загружены идентификаторы адресных объектов адреса,
//                                     то получение идентификаторов может инициировать http запрос к веб-сервису 1С orgaddress.
//       * КодыКЛАДР        - Булево - Если Истина, то возвращается структура КодыКЛАДР. По умолчанию, Ложь.
//                                     Если в адресе отсутствуют коды и в программу не загружены адресные объекты адреса,
//                                     Получение кодов может инициировать http запрос к веб-сервису 1С orgaddress.
//       * ПолныеНаименованияСокращений - Булево - Если Истина, то возвращается полное наименование адресных объектов.
//       * НаименованиеВключаетСокращение - Булево - Если Истина, то поля содержат сокращениям в наименованиях адресных объектов.
//       * ПроверитьАдрес   - Булево - Если Истина, то адрес будет проверен на соответствие ФИАС. По умолчанию, Ложь.
//                                     Если в программу не загружены проверяемые адресные объекты,
//                                     то проверка адреса может инициировать http запрос к веб-сервису 1С orgaddress.
//
// Возвращаемое значение:
//   Структура - сведения об адресе:
//        * СохраненноеПредставление  - Строка - Представление адреса, отображаемое в формах:
//                                      тег "value" в JSON или атрибут "Представление" для XML.
//        * Представление    - Строка - текстовое представление адреса по административно-территориальному делению.
//                                      Это представление формируется динамически по значениям адресообразующих полей.
//        * МуниципальноеПредставление - Строка - текстовое представление адреса по муниципальному делению.
//        * ТипАдреса        - Строка - основной тип адреса (только для адресов РФ).
//                                      Варианты: "Муниципальный", "Административно-территориальный".
//        * Страна           - Строка - текстовое представление страны.
//        * КодСтраны        - Строка - код страны по ОКСМ.
//        * Индекс           - Строка - почтовый индекс.
//        * КодРегиона       - Строка - код региона РФ.
//        * Регион           - Строка - текстовое представление региона РФ.
//        * РегионСокращение - Строка - сокращение региона.
//        * Округ            - Строка - (устарело) текстовое представление округа;
//        * ОкругСокращение  - Строка - (устарело) сокращение округа;
//        * Район            - Строка - текстовое представление района у адресов по административно-территориальному делению.
//        * РайонСокращение  - Строка - сокращение района у адресов по административно-территориальному делению.
//        * МуниципальныйРайон - Строка - текстовое представление муниципального района у адресов по муниципальному делению.
//        * МуниципальныйРайонСокращение - Строка - сокращение муниципального района у адресов по муниципальному делению.
//        * Город            - Строка - текстовое представление города у адресов по административно-территориальному делению.
//        * ГородСокращение  - Строка - сокращение города  у адресов по административно-территориальному делению.
//        * Поселение            - Строка - текстовое представление поселения у адресов по муниципальному делению.
//        * ПоселениеСокращение  - Строка - сокращение поселения у адресов по муниципальному делению.
//        * ВнутригородскойРайон - Строка - текстовое представление внутригородского района.
//        * ВнутригородскойРайонСокращение  - Строка - сокращение внутригородского района.
//        * НаселенныйПункт  - Строка - текстовое представление населенного пункта.
//        * НаселенныйПунктСокращение - Строка - сокращение населенного пункта.
//        * Территория            - Строка - текстовое представление территории.
//        * ТерриторияСокращение  - Строка - сокращение территории.
//        * Улица            - Строка - текстовое представление улицы.
//        * УлицаСокращение  - Строка - сокращение улицы.
//        * ДополнительнаяТерритория - Строка - (устарело) текстовое представление дополнительной территории;
//        * ДополнительнаяТерриторияСокращение - Строка - (устарело)сокращение дополнительной территории;
//        * ЭлементДополнительнойТерритории - Строка - (устарело) текстовое представление элемента дополнительной территории;
//        * ЭлементДополнительнойТерриторииСокращение - Строка - (устарело)сокращение элемента дополнительной территории;
//        * Здание - Структура - структура с информацией о здании адреса.
//            ** ТипЗдания - Строка  - тип объекта адресации адреса РФ согласно приказу Минфина России от 5.11.2015 г. N
//                                     171н.
//            ** Номер - Строка  - текстовое представление номера дома (только для адресов РФ).
//        * Корпуса   - Массив - содержит структуры(поля структуры: ТипКорпуса, Номер) с перечнем корпусов адреса.
//        * Помещения - Массив - содержит структуры(поля структуры: ТипПомещения, Номер) с перечнем помещений адреса.
//        * Комментарий - Строка - комментарий об адресе.
//        * ИдентификаторАдресногоОбъекта - УникальныйИдентификатор - Идентификационный код последнего адресного объекта
//                                        в иерархи адреса. Например, для адреса: Москва г., Дмитровское ш., д.9 это
//                                        будет идентификатор улицы.
//                                        Поле отсутствует, если дополнительный параметр КодыАдреса равен Ложь.
//        * ИдентификаторДома             - УникальныйИдентификатор - Идентификационный код дома(строения) адресного объекта.
//                                        Поле отсутствует, если дополнительный параметр КодыАдреса равен Ложь.
//        * Идентификаторы - Структура - Идентификаторы адресных объектов адреса, если установлен параметр КодыАдреса или КодыКЛАДР.
//                                       Поле отсутствует, если дополнительный параметр КодыАдреса или КодыКЛАДР равен Ложь.
//            ** Регион               - УникальныйИдентификатор - идентификатор региона.
//            ** Район                - УникальныйИдентификатор - идентификатор района.
//            ** МуниципальныйРайон   - УникальныйИдентификатор - идентификатор муниципального района.
//            ** Город                - УникальныйИдентификатор - идентификатор города.
//            ** Поселение            - УникальныйИдентификатор - идентификатор поселения.
//            ** ВнутригородскойРайон - УникальныйИдентификатор - идентификатор внутригородского района.
//            ** Территория           - УникальныйИдентификатор - идентификатор территории.
//            ** Улица                - УникальныйИдентификатор - идентификатор улица.
//        * КодыКЛАДР           - Структура - Коды КЛАДР, если установлен параметр КодыКЛАДР в Истина.
//           ** Регион          - Строка    - Код КЛАДР региона.
//           ** Район           - Строка    - Код КЛАДР район.
//           ** Город           - Строка    - Код КЛАДР города.
//           ** НаселенныйПункт - Строка    - Код КЛАДР населенного пункта.
//           ** Улица           - Строка    - Код КЛАДР улица.
//        * ДополнительныеКоды  - Структура - Коды ОКТМО, ОКТМО, ОКАТО, КодИФНСФЛ, КодИФНСЮЛ, КодУчасткаИФНСФЛ, КодУчасткаИФНСЮЛ.
//                                            Поле отсутствует, если дополнительный параметр КодыАдреса равен Ложь.
//        * РезультатПроверкиАдреса - Строка - "Успех", если адрес корректный, "Ошибка" - при наличии ошибок проверки,
//                                             "Отказ", если не удалось проверить адрес, т.к. не доступен классификатор.
//                                             Пустая строка, если в параметре ДополнительныеПараметры.ПроверитьАдрес не
//                                             установлен флаг ПроверитьАдрес.
//        * ОшибкиПроверкиАдреса - Строка  - описание ошибок в адресе, выявленных в ходе проверки.
//
Функция СведенияОбАдресе(Адрес, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыЗапросаСведений = Новый Структура;
	ПараметрыЗапросаСведений.Вставить("БезПредставлений", Ложь);
	ПараметрыЗапросаСведений.Вставить("КодыАдреса", Ложь);
	ПараметрыЗапросаСведений.Вставить("КодыКЛАДР", Ложь);
	ПараметрыЗапросаСведений.Вставить("ПолныеНаименованияСокращений", Ложь);
	ПараметрыЗапросаСведений.Вставить("НаименованиеВключаетСокращение", Ложь);
	ПараметрыЗапросаСведений.Вставить("ПроверитьАдрес", Ложь);
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда 
		ЗаполнитьЗначенияСвойств(ПараметрыЗапросаСведений, ДополнительныеПараметры);
	КонецЕсли;
	
	ВерсияБСП = СтандартныеПодсистемыСервер.ВерсияБиблиотеки();
	
	Если МетодСервера(, "СравнитьВерсии", ВерсияБСП, "2.4") >= 0 Тогда
		ИмяМодуля = "РаботаСАдресами";
	Иначе 
		ИмяМодуля = "УправлениеКонтактнойИнформацией";
	КонецЕсли;
	
	МодульРаботаСАдресами = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	
	Результат = МодульРаботаСАдресами.СведенияОбАдресе(Адрес, ДополнительныеПараметры);
	
	ПроверитьИсправитьКодСтраныВСведенияхОбАдресе(Результат); // Исправление ошибки БСП 00-00174180
	
	// Свойство "ТипАдреса" появилось только в БСП 2.4
	Если Не Результат.Свойство("ТипАдреса") Тогда
		
		// до БСП 3.0 российские адреса могли быть введены только по административно-территориальному делению
		ТипАдреса = ?(ЭтоРоссийскийАдрес(Результат)
						, АдминистративноТерриториальныйАдрес()
						, ИностранныйАдрес());
		
		Результат.Вставить("ТипАдреса", ТипАдреса);
		
	КонецЕсли;
	
	Если Не Результат.Свойство("Представление") Тогда 
		Результат.Вставить("Представление");
		УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеАдреса(Результат, Результат.Представление);
	КонецЕсли;
	
	СохраненноеПредставление = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформации(Адрес);
	Результат.Вставить("СохраненноеПредставление", СохраненноеПредставление);
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление адреса и значения полей во внутреннем формате JSON (для БСП 3.0 и выше) или XML (для БСП 2.4 и ниже).
//
// Параметры:
//  ЮрФизЛицо	 - ЛюбаяСсылка - владелец контактной информации (организация, контрагент, партнер и т.д.);
//  ВидАдреса	 - СправочникСсылка.ВидыКонтактнойИнформации - вид запрашиваемого адреса;
//  Дата		 - Дата - (необязательный) дата с которой действует запись контактной информации,
//  					  используется при хранении истории изменения контактной информации;
// 
// Возвращаемое значение:
//  Структура - содержит ключи:
//     * Представление - Строка - строковое представление адреса;
//     * ЗначенияПолей - Строка - значения полей адреса во внутреннем формате JSON или XML;
//
Функция АдресЮрФизЛица(ЮрФизЛицо, ВидАдреса, Дата = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Представление");
	Результат.Вставить("ЗначенияПолей");
	
	ТаблицаКИ = КонтактнаяИнформацияОбъекта(ЮрФизЛицо, ВидАдреса, Дата);
	
	Если ЗначениеЗаполнено(ТаблицаКИ) Тогда 
		
		СтрокаКИ = ТаблицаКИ[0];
		
		Если ТаблицаКИ.Колонки.Найти("Значение") <> Неопределено Тогда // JSON, для БСП 3.0.x
			Результат.ЗначенияПолей = СтрокаКИ.Значение;
		ИначеЕсли ТаблицаКИ.Колонки.Найти("ЗначенияПолей") <> Неопределено Тогда // XML
			Результат.ЗначенияПолей = СтрокаКИ.ЗначенияПолей;
		КонецЕсли;
		
		Результат.Представление = СтрокаКИ.Представление;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на фактического владельца контактной информации объекта.
// Например, контактная информация контрагента - физ.лица хранится в карточке
// связанного с контрагентом физического лица, а не в карточке самого контрагента.
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на объект (контрагента/организацию/подразделение);
// 
// Возвращаемое значение:
//  ЛюбаяСсылка - ссылка на объект, который является фактическим владельцем контактной информации.
//
Функция ХранилищеКонтактнойИнформацииОбъекта(СсылкаНаОбъект) Экспорт 
	
	ХранилищеКИ = Неопределено;
	
	СтандартнаяОбработка = Истина;
	ПриОпределенииМестаХраненияКонтактнойИнформацииОбъекта(ХранилищеКИ, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда 
		ХранилищеКИ = СсылкаНаОбъект;
	КонецЕсли;
	
	Возврат ХранилищеКИ;
	
КонецФункции

// Возвращает представление контактной информации объекта.
//
// Параметры:
//  СсылкаИлиОбъект         - Произвольный - Владелец контактной информации.
//  ВидКонтактнойИнформации - СправочникСсылка.ВидыКонтактнойИнформации - Вид контактной информации.
//  Разделитель             - Строка - Разделитель, который добавляется в представление между записями контактной информации.
//                                     По умолчанию это запятая с последующем пробелом, для исключения
//                                     пробела необходимо использовать признак БезПробелов у параметра ДополнительныеПараметры.
//  Дата                    - Дата - Дата с которой действует запись контактной информации. Если контактная информация
//                                   хранит историю изменения, то передача даты обязательна.
//  ДополнительныеПараметры - Структура - Необязательные параметры для формирования представления контактной информации.
//   * ТолькоПервая         - Булево - Если Истина, то будет возвращено представление только основной(первой) записи
//                                     контактной информации. По умолчанию - Ложь;
//   * БезПробелов          - Булево - Если Истина, то после разделителя не будет автоматически добавляется пробел.
//                                     По умолчанию - Ложь;
// 
// Возвращаемое значение:
//  Строка - Сформированное представление контактной информации.
//
Функция ПредставлениеКонтактнойИнформацииОбъекта(СсылкаИлиОбъект, ВидКонтактнойИнформации, Разделитель = ",", Дата = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ТолькоПервая = Ложь;
	БезПробелов = Ложь;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("ТолькоПервая") Тогда
			ТолькоПервая = ДополнительныеПараметры.ТолькоПервая;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("БезПробелов") Тогда
			БезПробелов = ДополнительныеПараметры.БезПробелов;
		КонецЕсли;
	КонецЕсли;
	РазделительВПредставлении = ?(БезПробелов, Разделитель, Разделитель + " ");
	
	ПервыйПроход = Истина;
	КонтактнаяИнформация = КонтактнаяИнформацияОбъекта(СсылкаИлиОбъект, ВидКонтактнойИнформации, Дата);
	Для каждого ЗаписьКонтактнойИнформации Из КонтактнаяИнформация Цикл
		Если ПервыйПроход Тогда
			Представление = ЗаписьКонтактнойИнформации.Представление;
			Если ТолькоПервая Тогда
				Возврат Представление;
			КонецЕсли;
			ПервыйПроход = Ложь;
		Иначе
			Представление = Представление + РазделительВПредставлении + ЗаписьКонтактнойИнформации.Представление;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Представление;
	
КонецФункции

Процедура ЗаполнитьАдресУчастникаЭДО(AddressInfo, ПредставлениеАдреса, ЗначенияПолейАдреса) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗначенияПолейАдреса) Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураАдреса = СведенияОбАдресе(ЗначенияПолейАдреса);
	СтруктураАдреса.СохраненноеПредставление = ПредставлениеАдреса;
	
	Заполнить_AddressInfo(AddressInfo, СтруктураАдреса);
	
КонецПроцедуры

