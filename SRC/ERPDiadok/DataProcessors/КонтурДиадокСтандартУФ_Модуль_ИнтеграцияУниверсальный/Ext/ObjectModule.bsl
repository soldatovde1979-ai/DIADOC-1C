	КоллекцияУчастниковЭДО = Новый Массив;
	
	Если Контент.Свойство("Shippers") Тогда
		
		Для Каждого Shipper Из Контент.Shippers Цикл
			
			ЭлементКоллекции = Shipper.OrganizationInfo;
			КоллекцияУчастниковЭДО.Добавить(ЭлементКоллекции);
			
		КонецЦикла;
		
	ИначеЕсли Контент.Свойство("Shipper") Тогда
		
		Если Контент.Shipper.Свойство("OrganizationInfo") Тогда
			ЭлементКоллекции = Контент.Shipper.OrganizationInfo; // для 155@
		Иначе
			ЭлементКоллекции = Контент.Shipper; // для 172@
		КонецЕсли;
		
		КоллекцияУчастниковЭДО.Добавить(ЭлементКоллекции);
		
	КонецЕсли;
	
	Результат = КлючевыеСвойстваУчастниковЭДО(КоллекцияУчастниковЭДО);
	
	Возврат Результат;
	
