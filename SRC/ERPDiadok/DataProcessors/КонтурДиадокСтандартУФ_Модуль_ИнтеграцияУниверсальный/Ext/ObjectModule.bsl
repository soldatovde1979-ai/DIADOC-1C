	Результат.Ссылка = ПрикладнаяСтавкаНДС(ПредставлениеСтавки);
	
	Возврат Результат;
	
КонецФункции

// Формирует структру свойств документа-основания УКД.
//
// Параметры:
//  СведенияОКорректируемомДокументе - Структура - соответствует объекту InvoiceForCorrectionInfo;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КлючевыеСвойстваДокументОснованиеУКД(СведенияОКорректируемомДокументе)
	
	Результат = Новый Структура;
	Результат.Вставить("ПервичныйДокумент");
	Результат.Вставить("СчетФактура");
	Результат.Вставить("Организация");
	Результат.Вставить("Контрагент");
	Результат.Вставить("Дата", СведенияОКорректируемомДокументе.InvoiceDate);
	Результат.Вставить("Номер", СведенияОКорректируемомДокументе.InvoiceNumber);
	
