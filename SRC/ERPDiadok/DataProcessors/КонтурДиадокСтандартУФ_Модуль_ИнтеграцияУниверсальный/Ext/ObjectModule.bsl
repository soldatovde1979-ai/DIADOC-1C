		//   	Структура
		//
		Функция РезультатВизуализацииСчетаНаОплату(ДокССылка, ПараметрыОтправкиНаСогласование =  Неопределено, ФИОПодписанта = "") Экспорт
			
			ИДСвойства = МетодСервера(, "ИдентификаторСвойстваСтандартнаяФормаСчетаНаОплату");
			СтандартнаяФормаСчетаНаОплату = МетодСервера(, "ПолучитьЗначениеСвойства", ДокСсылка.Организация, ИДСвойства);
	
			Если СтандартнаяФормаСчетаНаОплату = Истина
				И ЭтоСчетНаОплату(ДокССылка) Тогда
				
				Результат = РезультатВизуализацииСчетаНаОплатуСредствамиКонфигурации(ДокСсылка);
			Иначе 
				
				Результат = МетодСервера(ИмяМодуляИнтеграции(), "РезультатВизуализацииСчетаНаОплатуСредствамиДиадок", ДокССылка, ПараметрыОтправкиНаСогласование, ФИОПодписанта);
			КонецЕсли;
			
			Если ТипЗнч(Результат.Таблица) = Тип("ТабличныйДокумент") Тогда
				Результат.Таблица.Автомасштаб = Истина;
			КонецЕсли;
			
			Возврат Результат;
			
		КонецФункции //РезультатВизуализацииСчетаНаОплату()
		
		// Формирует структуру с данными, которые необходимы для визуализации ПФ счета на оплату. 
		// Табличный документ формируется типовым механизмом конфигурации.
		//
		// Параметры:
		//  СчетНаОплату - ДокументСсылка	- документ, на основании которого формируем печатную форму 
		// 
		// Возвращаемое значение:
		//   Структура
		//
		Функция РезультатВизуализацииСчетаНаОплатуСредствамиКонфигурации(СчетНаОплату) Экспорт 
			
			Перем МенеджерПечати;
			
			ПараметрыМетодаПечати = НовыйПараметрыТиповогоМетодаПечати();
			ПараметрыМетодаПечати.МассивОбъектов.Добавить(СчетНаОплату);
			
			ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати);
			
			Если МенеджерПечати = Неопределено Тогда
				ВызватьИсключение "Не удалось определить менеджер печати для сформирования печатной формы счета на оплату по документу " + СчетНаОплату;
			КонецЕсли;
			
			МенеджерПечати.Печать(	ПараметрыМетодаПечати.МассивОбъектов, 
									ПараметрыМетодаПечати.ПараметрыПечати, 
									ПараметрыМетодаПечати.КоллекцияПечатныхФорм, 
									ПараметрыМетодаПечати.ОбъектыПечати, 
									ПараметрыМетодаПечати.ПараметрыВывода	);
			
			Для Каждого Стр Из ПараметрыМетодаПечати.КоллекцияПечатныхФорм Цикл
				Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
					ТабличныйДокумент = Стр.ТабличныйДокумент;
				КонецЕсли;
			КонецЦикла;
			
			Если ТабличныйДокумент = Неопределено Тогда
				ВызватьИсключение "Не удалось сформировать печатную форму счета на оплату по документу " + СчетНаОплату;
			КонецЕсли;
			
			УстановитьПоляТабличногоДокумента(ТабличныйДокумент);
			
			ОписаниеДокумента = ОписаниеПрикладногоДокумента(СчетНаОплату);
			ИндексОП = "";
			
			ДатаНомер = ДатаНомерДокумента(ОписаниеДокумента, ИндексОП);
			
			Результат = НовыйРезультатВизуализацииСчетаНаОплату();
			
			Результат.Таблица 		= ТабличныйДокумент;
			Результат.СписокОшибок 	= ""; 
			Результат.ИмяФайла 		= ИмяФайлаПечатнойФормы("Счет", ДатаНомер.НомерДокумента, ДатаНомер.ДатаДокумента);
			Результат.Дата 			= ДатаНомер.ДатаДокумента;
			Результат.Номер 		= ДатаНомер.НомерДокумента;
			
			ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Результат);
			
			Возврат Результат;
			
		КонецФункции //РезультатВизуализацииСчетаНаОплатуСредствамиКонфигурации()
		
		// Дозаполняет мету неформализованного счета на оплату по данным интеграционного модуля
		//
		// Параметры:
		//  СчетНаОплату - ДокументСсылка	- документ, на основании которого формируем печатную форму 
		//  Мета		 - Структура		- см. метод "НовыйРезультатВизуализацииСчетаНаОплату"
		//
		Процедура ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Мета)
			
			МетодСервера(ИмяМодуляИнтеграции(), "ПриЗаполненииМетыНеформализованногоСчетаНаОплату", СчетНаОплату, Мета);
			
		КонецПроцедуры //ПриЗаполненииМетыНеформализованногоСчетаНаОплату()
		
		// Определяет менеждер печати и значения параметров метода печати, характерные для конкретной конфигурации 1С
		//
		// Параметры:
		//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
		//  ПараметрыМетодаПечати	 - Структура 		- См. метод "НовыйПараметрыТиповогоМетодаПечати"
		//
		Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати)
			
			МетодСервера(ИмяМодуляИнтеграции(), "ПередФормированиемПечатнойФормыСчетаНаОплату", МенеджерПечати, ПараметрыМетодаПечати);
			
		КонецПроцедуры
		
				// Формирует структуру с данными, которые необходимы для визуализации ПФ сверки взаиморасчетов, используя типовые механизмы конфигурации 1С.
		//	Параметры:
		//  	ДокументСверкиСсылка	- ДокументСсылка	- Ссылка на документ, по которому формируется печатная форма
		//
		//	Возвращаемое значение:
		//   	Структура
		//
		Функция РезультатВизуализацииАктаСверки(ДокументСверкиСсылка, ПараметрыОтправкиНаСогласование = Неопределено, ФИОПодписанта = "") Экспорт

			Перем МенеджерПечати;

			ПараметрыМетодаПечати = НовыйПараметрыТиповогоМетодаПечати();
			ПараметрыМетодаПечати.МассивОбъектов.Добавить(ДокументСверкиСсылка);

			ПередФормированиемПечатнойФормыСверкиВзаиморасчетов(МенеджерПечати, ПараметрыМетодаПечати);

			Если МенеджерПечати = Неопределено Тогда
				ВызватьИсключение "Не удалось определить менеджер печати для формирования печатной формы сверки взаиморасчетов по документу " + ДокументСверкиСсылка;
			КонецЕсли;

			МенеджерПечати.Печать(
				ПараметрыМетодаПечати.МассивОбъектов,
				ПараметрыМетодаПечати.ПараметрыПечати,
				ПараметрыМетодаПечати.КоллекцияПечатныхФорм,
				ПараметрыМетодаПечати.ОбъектыПечати,
				ПараметрыМетодаПечати.ПараметрыВывода);

			Для Каждого ЭлементТЗ Из ПараметрыМетодаПечати.КоллекцияПечатныхФорм Цикл
				Если ТипЗнч(ЭлементТЗ.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
					ТабличныйДокумент = ЭлементТЗ.ТабличныйДокумент;
				КонецЕсли;
			КонецЦикла;

			Если ТабличныйДокумент = Неопределено Тогда
				ВызватьИсключение "Не удалось сформировать печатную форму сверки взаиморасчетов по документу " + ДокументСверкиСсылка;
			КонецЕсли;

			УстановитьПоляТабличногоДокумента(ТабличныйДокумент);

			Результат = НовыйРезультатВизуализацииАктаСверки();

			Результат.Вставить("Таблица", ТабличныйДокумент);
			Результат.Вставить("СписокОшибок", "");
			Результат.Вставить("ИмяФайла", ИмяФайлаПечатнойФормы("Акт сверки", ДокументСверкиСсылка.Номер, ДокументСверкиСсылка.Дата));
			Результат.Вставить("Дата", ДокументСверкиСсылка.Дата);
			Результат.Вставить("Номер", ДокументСверкиСсылка.Номер);
			Результат.Вставить("Сумма", "");
			Результат.Вставить("СуммаНДС", "");

			УбратьПодписьИПечать(Результат.Таблица);

			Возврат Результат;

		КонецФункции // РезультатВизуализацииАктаСверки()
		
		Процедура УбратьПодписьИПечать(ТабличныйДокумент)
	
			Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
				Если Рисунок.ТипРисунка = ТипРисункаТабличногоДокумента.Картинка
					И Найти(Рисунок.Имя, "_Документ_") > 0 Тогда
					Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
				КонецЕсли;
			КонецЦикла;
	
		КонецПроцедуры

		
		Процедура УстановитьПоляТабличногоДокумента(ТабДокумент)
			
			Если ТипЗнч(ТабДокумент) <> Тип("ТабличныйДокумент") Тогда
				Возврат;
			КонецЕсли;
			
			ТабДокумент.ПолеСверху = 5;
			ТабДокумент.ПолеСлева = 5;
			ТабДокумент.ПолеСнизу = 5;
			ТабДокумент.ПолеСправа = 5;
			
			ТабДокумент.АвтоМасштаб = Истина;
			
		КонецПроцедуры
		
		// Определяет менеждер печати и значения параметров метода печати, характерные для конкретной конфигурации 1С
		//
		// Параметры:
		//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
		//  ПараметрыМетодаПечати	 - Структура 		- См. метод "НовыйПараметрыТиповогоМетодаПечати"
		//
		Процедура ПередФормированиемПечатнойФормыСверкиВзаиморасчетов(МенеджерПечати, ПараметрыМетодаПечати)
			
			МетодСервера(ИмяМодуляИнтеграции(), "ПередФормированиемПечатнойФормыСверкиВзаиморасчетов", МенеджерПечати, ПараметрыМетодаПечати);
			
		КонецПроцедуры //ПередФормированиемПечатнойФормыСверкиВзаиморасчетов()


		Функция СформироватьМетуВнешнейПечатнойФормы(DocumentType, ДокументСсылка) Экспорт
			
			Результат = Неопределено;
			
			Если DocumentType = "XmlAcceptanceCertificate" Тогда
				
				Результат = СформироватьМетуАктаВыполненныхРабот(ДокументСсылка);
				
			ИначеЕсли DocumentType = "ProformaInvoice" Тогда
				
				Результат = СформироватьМетуСчетаНаОплату(ДокументСсылка);
				
			ИначеЕсли DocumentType = "ReconciliationAct" Тогда
				
				Результат = СформироватьМетуАктаСверки(ДокументСсылка);
				
			КонецЕсли;
			
			Возврат Результат;
			
		КонецФункции
		
		Функция СформироватьМетуСчетаНаОплату(ДокументСсылка) Экспорт
			
			Возврат МетодСервера(ПараметрыКлиентСервер.ИмяФормыИнтеграции, "СформироватьМетуСчетаНаОплату", ДокументСсылка);
			
		КонецФункции
		
		Функция СформироватьМетуАктаСверки(ДокументСсылка) Экспорт
			
			Возврат МетодСервера(ПараметрыКлиентСервер.ИмяФормыИнтеграции, "СформироватьМетуАктаСверки", ДокументСсылка);
			
		КонецФункции
		
		Функция СформироватьМетуАктаВыполненныхРабот(ДокументСсылка) Экспорт
			
			Возврат МетодСервера(ПараметрыКлиентСервер.ИмяФормыИнтеграции, "СформироватьМетуАктаВыполненныхРабот", ДокументСсылка);
			
		КонецФункции
		
		// Возвращает шаблон текста для объединения запросов.
		//
		// Параметры:
		//  ТолькоНовые - Булево - Истина, если из результата присоединяемого запроса нужно получить
		//                         только те строки, которых еще нет в общем результате.
		// 
		// Возвращаемое значение:
		//   Строка
		//
		Функция РазделительОбъединенияЗапросов(ТолькоНовые = Ложь)
			
			Если ТолькоНовые Тогда
				
				Результат = "
				|
				|ОБЪЕДИНИТЬ
				|
				|";
				
			Иначе
				
				Результат = "
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|";
				
			КонецЕсли;
			
			Возврат Результат;
			
		КонецФункции
		
	//} ОБЩИЕ ПРОЦЕДУРЫ И ФУНКЦИИ
