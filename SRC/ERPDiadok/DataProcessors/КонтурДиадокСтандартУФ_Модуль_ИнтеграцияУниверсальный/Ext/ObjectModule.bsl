	Возврат Результат;
	
КонецФункции

Функция НоменклатураКонтрагентаПоСтрокеКонтента(СтрокаКонтента)

	Результат = НоваяНоменклатураКонтрагента();

	НоменклатураЭД = КлючевыеСвойстваНоменклатурыПоставщика(СтрокаКонтента);
	
	ЕдиницаЭД = КлючевыеСвойстваЕдиницыИзмерения(СтрокаКонтента);
	
	ПредставлениеСтавкиИноеЗначение = СвойствоСтруктуры(СтрокаКонтента, "OtherTaxRate"); // 29@
	Если ПредставлениеСтавкиИноеЗначение = Неопределено Тогда
		СтавкаЭД = КлючевыеСвойстваСтавкиНДС(СтрокаКонтента);
	Иначе
		СтавкаЭД = КлючевыеСвойстваСтавкиНДСИноеЗначение(СтрокаКонтента);
	КонецЕсли;
	
	GTIN = СвойствоСтруктуры(СтрокаКонтента, "GTIN", "");
	Тип = СвойствоСтруктуры(СтрокаКонтента, "ItemMark", "");
	
	ЗаполнитьЗначенияСвойств(Результат, НоменклатураЭД);
	
	Результат.Тип = Тип;
	Результат.ЕдиницаИзмеренияКод = ЕдиницаЭД.Код;
	Результат.ЕдиницаИзмерения = ЕдиницаЭД.Наименование;
	Результат.СтавкаНДС = СтавкаЭД.Представление;
		
	Результат.GTIN = GTIN;
	
	Возврат Результат;
	
КонецФункции

Процедура ПрочитатьСвойства_КоличественноСуммовыеПоказатели(Стр, ИсточникДанных, ЗначенияДоИзменения = Ложь)
	
	Если ИсточникДанных.Свойство("Net") Тогда // НеттоПередано в 551@
		Количество = ИсточникДанных.Net;
	Иначе
		Количество = ИсточникДанных.Quantity;
	КонецЕсли;
	
	Цена		 = СвойствоСтруктуры(ИсточникДанных, "Price");
	СуммаАкциза	 = СвойствоСтруктуры(ИсточникДанных, "Excise");
	СуммаБезНДС	 = СвойствоСтруктуры(ИсточникДанных, "TotalWithVatExcluded");
	СуммаНДС	 = СвойствоСтруктуры(ИсточникДанных, "Vat");
	СуммаСНДС	 = СвойствоСтруктуры(ИсточникДанных, "Total");
	
	Если СуммаБезНДС = Неопределено Тогда 
		СуммаБезНДС = СвойствоСтруктуры(ИсточникДанных, "SubtotalWithVatExcluded");
	КонецЕсли;
	
	Если СуммаСНДС = Неопределено Тогда 
		СуммаСНДС = СвойствоСтруктуры(ИсточникДанных, "Subtotal");
	КонецЕсли;
	
	Количество	 = ПривестиКЧислу(Количество);
	Цена		 = ПривестиКЧислу(Цена);
	СуммаАкциза	 = ПривестиКЧислу(СуммаАкциза);
	СуммаБезНДС	 = ПривестиКЧислу(СуммаБезНДС);
	СуммаНДС	 = ПривестиКЧислу(СуммаНДС);
	СуммаСНДС	 = ПривестиКЧислу(СуммаСНДС);
	
	Постфикс = ?(ЗначенияДоИзменения, "_До", "");
	
	УстановитьСвойствоСтруктуры(Стр, "Количество" + Постфикс	, Количество);
	УстановитьСвойствоСтруктуры(Стр, "Цена" + Постфикс		, Цена);
	УстановитьСвойствоСтруктуры(Стр, "СуммаАкциза" + Постфикс	, СуммаАкциза);
	УстановитьСвойствоСтруктуры(Стр, "СуммаБезНДС" + Постфикс	, СуммаБезНДС);
	УстановитьСвойствоСтруктуры(Стр, "СуммаНДС" + Постфикс	, СуммаНДС);
	УстановитьСвойствоСтруктуры(Стр, "СуммаСНДС" + Постфикс	, СуммаСНДС);
	
КонецПроцедуры

Процедура ПрочитатьСвойства_КорСчета(Стр, ИсточникДанных)
	
	КорСчетДт = СвойствоСтруктуры(ИсточникДанных, "AccountDebit");
