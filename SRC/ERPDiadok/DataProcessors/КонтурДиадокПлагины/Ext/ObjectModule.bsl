//
//		HTTP
//

// Выполняет http запрос через основной модуль и заполняет описание ответа
//
// Параметры:
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеHTTPЗапроса();
// 
// Возвращаемое значение:
//  Структура - см. Новый_ОписаниеHTTPОтвета()
//
Функция ВыполнитьHTTPЗапрос(ОписаниеЗапроса)
	
	ПутьНаСервере = ЗаполнитьПутьНаСервереПараметрамиАдреса(ОписаниеЗапроса.ПутьНаСервере, ОписаниеЗапроса.Параметры);
	
	Если Лев(ПутьНаСервере, 1) <> "/" Тогда
		ПутьНаСервере = "/" + ПутьНаСервере;  // для работы транспорта xmlhttp на платформе 8.2
	КонецЕсли;
	
	ОписаниеЗапроса.ПутьНаСервере = ПутьНаСервере;
	
	Результат = Новый_ОписаниеHTTPОтвета();
	СтандартнаяОбработка = Истина;
	ОсновнойМодуль_ПриВыполненииHTTPЗапроса(Результат, ОписаниеЗапроса, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		СтандартнаяОбработка_ПриВыполненииHTTPЗапроса(Результат, ОписаниеЗапроса);
		
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

// Проверяет на ошибки HTTP ответ
//
// Параметры:
//  ОписаниеОтвета - Структура - см. Новый_ОписаниеHTTPОтвета();
//  ОписаниеЗапроса - Структура - см. Новый_ОписаниеHTTPЗапроса();
//
Процедура ОбработатьОшибкуHTTP(ОписаниеОтвета, ОписаниеЗапроса)
	
	Если ОписаниеОтвета.КодОтвета = 200 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеОтвета.ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
		ТекстОтвета = СтрокаИзДвоичныхДанных(ОписаниеОтвета.ТелоОтвета);
	Иначе
		ТекстОтвета = ОписаниеОтвета.ТелоОтвета;
	КонецЕсли;
	
	СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("HTTP");
	
	ТекстОшибки = НСтр(
	"ru = 'Метод: %1
	|Имя сервера: %2
	|Путь на сервере: %3
	|Код ответа: %4
	|%5'");
	
	ТекстОшибки = ПараметрыВСтроку(
		ТекстОшибки,
		ОписаниеЗапроса.Метод,
		ОписаниеЗапроса.ИмяСервера,
		ОписаниеЗапроса.ПутьНаСервере,
		ОписаниеОтвета.КодОтвета,
		ТекстОтвета
	);
	
	ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
	
	ТекстСообщения = "Недопустимый код ответа HTTP-запрос!";
	ТекстСообщения = ТекстСообщения + Символы.ПС + ТекстОшибки;
	
	ВызватьИсключение ТекстСообщения;
	
КонецПроцедуры

// Заполняет путь на сервере параметрами запроса в строке адреса
//
// Параметры:
//  ПутьНаСервере - Строка - путь метода на сервере;
//  ПараметрыЗапроса - 	 - 
// 
// Возвращаемое значение:
//   - 
//
Функция ЗаполнитьПутьНаСервереПараметрамиАдреса(ПутьНаСервере, ПараметрыЗапроса = Неопределено)
	
	Если Не ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		Возврат ПутьНаСервере;
	КонецЕсли;
	
	Результат = ПутьНаСервере;
	Результат = СтрЗаменить(Результат, "{{", "{");
	Результат = СтрЗаменить(Результат, "}}", "}");
	ПараметрыАдреса = Новый Массив;
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Ключ = Параметр.Ключ;
		Значение = Параметр.Значение;
		ПараметрАдреса = ПараметрыВСтроку("{%1}", Ключ);
		Если Найти(Результат, ПараметрАдреса) > 0 Тогда
			Результат = СтрЗаменить(Результат, ПараметрАдреса, Значение);
			ПараметрыАдреса.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ИмяПараметра Из ПараметрыАдреса Цикл
		ПараметрыЗапроса.Удалить(ИмяПараметра);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Содержит необходимые параметры для http запроса
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * Метод - Строка - метод запроса (по умолчанию 'GET')
//   * ПутьНаСервере - Строка - конечный адрес запроса (без указания сервера)
//   * Заголовки - Соответствие - заголовки запроса
//   * Параметры - Соответствие - параметры запроса
//   * ТелоОтветаКакДвоичныеДанные - Булево - Истина, если необходимо получить тело ответа в виде двоичных данных
//   * ТелоЗапроса - Строка, ДвоичныеДанные - тело запроса
//   * Таймаут - Число - таймаут ожидания (по умолчанию 20 секунд)
//
Функция Новый_ОписаниеHTTPЗапроса()
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", "https");
	Результат.Вставить("ИмяСервера", "");
	Результат.Вставить("Метод", "GET");
	Результат.Вставить("ПутьНаСервере", "");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("Параметры", Новый Структура);
	Результат.Вставить("ТелоОтветаКакДвоичныеДанные", Ложь);
	Результат.Вставить("ТелоЗапроса", Неопределено);
	Результат.Вставить("Таймаут", 20);
	
	Возврат Результат;
	
КонецФункции

// Содержит описание http ответа
// 
// Возвращаемое значение:
//  Структура:
//   * КодОтвета - Число - код http ответа;
//   * Заголовки - Соответствие - заголовки http ответа;
//   * ТелоОтвета - Строка, ДвоичныеДанные - зависит от ТелоОтветаКакДвоичныеДанные (см. Новый_ОписаниеHTTPЗапроса)
//
Функция Новый_ОписаниеHTTPОтвета()
	
	Результат = Новый Структура;
	Результат.Вставить("КодОтвета");
	Результат.Вставить("ТелоОтвета");
	Результат.Вставить("Заголовки", Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

