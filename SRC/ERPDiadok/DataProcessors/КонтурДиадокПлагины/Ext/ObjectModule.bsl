КонецФункции

Функция СписокТиповыхПлагинов()
	
	ИмяПроекта = ИдентификаторПроекта();
	
	СтрокаXML = Сервис_СписокПлагинов(ИмяПроекта);
	СтрокаXSL = Сервис_СписокПлагиновXSLT(ИмяПроекта);
	СтрокаXML = ПреобразоватьXMLпоXSL(СтрокаXML, СтрокаXSL);
	
	ТаблицаПлагинов = СериализоватьXML(СтрокаXML);
	
	Результат = Новый Массив;
	
	Для каждого Стр Из ТаблицаПлагинов Цикл
		
		НовыйПлагин = Новый_ТиповойПлагин();
		ЗаполнитьЗначенияСвойств(НовыйПлагин, Стр);
		
		Результат.Добавить(НовыйПлагин);
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

