// Добавляет ошибку плагина в массив ошибок и запись в журнал регистрации
//
// Параметры:
//  ОписаниеПлагина - Структура - см. Новый_ОписаниеПлагина();
//  ИмяСобытия - Строка - имя события;
//  ТекстОшибки - Строка - текст ошибки;
//
Процедура ЗафиксироватьОшибкуПлагина(Плагин, ИмяСобытия, ТекстОшибки) 
	
	Идентификатор = Плагин.Идентификатор;
	
	СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияПлагина(Идентификатор, ИмяСобытия);
	ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
	
КонецПроцедуры

// внутренние методы плагинов

Процедура Плагин_ОбработатьСобытие(Плагин, ИмяСобытия, ПараметрыСобытия)
	
	НастройкиПлагина = Неопределено;
	
	РезультатНастроек = ПолучитьРезультатСлужебногоСобытия("Плагин_ПолучитьНастройки", 
															Новый Структура("Идентификатор", Плагин.Идентификатор));
	
	Если РезультатНастроек.Успешно Тогда
		НастройкиПлагина = РезультатНастроек.Данные;	
	КонецЕсли;
	
	Попытка
		
		МодульПлагина = Плагин_СоздатьОбъект(Плагин.Идентификатор);
		МодульПлагина.ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, НастройкиПлагина);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		ЗафиксироватьОшибкуПлагина(Плагин, ИмяСобытия, ТекстОшибки);
		
		ВызватьИсключение;
		
	КонецПопытки;

КонецПроцедуры

Функция Плагин_СоздатьОбъект(Идентификатор)
	
	Результат = Кэш_ПолучитьПлагин(Идентификатор);
	
	Если Не Результат = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФайлПлагина = ПрочитатьФайлПлагина(Идентификатор);
	
	ИмяВнешнейОбработки = Идентификатор;
	
	ЭтоИмяФайла = ТипЗнч(ФайлПлагина) = Тип("Строка");
	
	Если ЭтоИмяФайла Или ЭтоОбычноеПриложение() Тогда
		
		Если ЭтоИмяФайла Тогда
			
			Результат = ВнешниеОбработки_Создать(ФайлПлагина);
			
		Иначе
			
			ИмяВремФайла = ПолучитьИмяВременногоФайла("epf");
			
			ФайлПлагина.Записать(ИмяВремФайла);
			
			Результат = ВнешниеОбработки_Создать(ИмяВремФайла);
			
			УдалитьФайлы(ИмяВремФайла);
			
		КонецЕсли;
		
	Иначе
		
		АдресОбработки	 = ПоместитьВоВременноеХранилище(ФайлПлагина);
		ИмяОбработки	 = ВнешниеОбработки_Подключить(АдресОбработки, ИмяВнешнейОбработки);
		Результат		 = ВнешниеОбработки.Создать(ИмяОбработки, Ложь);
		УдалитьИзВременногоХранилища(АдресОбработки);
		
	КонецЕсли;
	
	Плагин_ИнициализироватьПеременные(Результат);
	Кэш_ПоместитьПлагин(Идентификатор, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура Плагин_ИнициализироватьПеременные(ОбъектПлагина)
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ОсновнойМодуль", ОсновнойМодуль);
	ЗначенияЗаполнения.Вставить("ВерсияМенеджера", ВерсияОбработки());
	ЗначенияЗаполнения.Вставить("ИспользоватьМетрики", Истина);
	ЗаполнитьЗначенияСвойств(ОбъектПлагина, ЗначенияЗаполнения);

КонецПроцедуры 

