//
//		СЕРВИС
//

Функция Сервис_СписокПлагинов(ИмяПроекта)
	
	ИмяМетода = "PluginsList";
	
	ОписаниеМетода	= ОписаниеМетодаАПИ(ИмяПроекта, ИмяМетода);
	
	ОписаниеЗапроса = ОписаниеЗапросаПоОписаниюМетода(ОписаниеМетода);
	ОписаниеЗапроса.Параметры.Вставить("projectName", ИмяПроекта);
	ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	ОписаниеОтвета = ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
	
	ОбработатьОшибкуHTTP(ОписаниеОтвета, ОписаниеЗапроса);
	
	Результат = СтрокаИзДвоичныхДанных(ОписаниеОтвета.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

Функция Сервис_СписокПлагиновXSLT(ИмяПроекта)
	
	ИмяМетода = "PluginsListXSLT";
	
	ОписаниеМетода	= ОписаниеМетодаАПИ(ИмяПроекта, ИмяМетода);
	
	ОписаниеЗапроса = ОписаниеЗапросаПоОписаниюМетода(ОписаниеМетода);
	ОписаниеЗапроса.Параметры.Вставить("projectName", ИмяПроекта);
    ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	ОписаниеОтвета = ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
	
	ОбработатьОшибкуHTTP(ОписаниеОтвета, ОписаниеЗапроса);
	
    Результат = СтрокаИзДвоичныхДанных(ОписаниеОтвета.ТелоОтвета);	
	
	Возврат Результат;
	
КонецФункции

Функция Сервис_ФайлПлагина(ИмяПроекта, ИмяПлагина)
	
	ИмяМетода = "Plugin";
	
	ОписаниеМетода	= ОписаниеМетодаАПИ(ИмяПроекта, ИмяМетода);
	
	ОписаниеЗапроса = ОписаниеЗапросаПоОписаниюМетода(ОписаниеМетода);
	ОписаниеЗапроса.Параметры.Вставить("projectName", ИмяПроекта);
	ОписаниеЗапроса.Параметры.Вставить("pluginName", ИмяПлагина + ".epf");
	ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	ОписаниеОтвета = ВыполнитьHTTPЗапрос(ОписаниеЗапроса);
	
	ОбработатьОшибкуHTTP(ОписаниеОтвета, ОписаниеЗапроса);
	
	Возврат ОписаниеОтвета.ТелоОтвета;
	
КонецФункции

// Описание методов АПИ

// Получает описание всех доступных методов АПИ в проекте
// 
// Возвращаемое значение:
//  Структура:
//   * Ключ - Строка - имя проекта
//   * Значение - Массив из Структура - см. item в https://edi.kontur.ru/1c/Plugins/Demo/Settings/API/methods.json
//
Функция ДоступныеМетодыАПИ(ИмяПроекта)
	
	КлючКэш = "ДоступныеМетоды_" + ИмяПроекта;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОписаниеМетодов = ОписаниеМетодовИзСервиса(ИмяПроекта);
	
	Результат = ОписаниеМетодов.item;
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание метода апи в проекте
//
// Параметры:
//  ИмяПроекта - Строка - имя проекта;
//  ИмяМетода - Строка - имя метода апи;
// 
// Возвращаемое значение:
//  Структура - см. Значение из ДоступныеМетодыАПИ();
//
Функция ОписаниеМетодаАПИ(ИмяПроекта, ИмяМетода)
	
	Результат = Неопределено;
	
	ДоступныеМетоды = ДоступныеМетодыАПИ(ИмяПроекта);
	Для каждого ОписаниеМетода Из ДоступныеМетоды Цикл
		Если НРег(ОписаниеМетода.name) = НРег(ИмяМетода) Тогда
			Результат = ОписаниеМетода;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат = Неопределено Тогда
		
		ТекстОшибки = НСтр("ru = 'Не найдено описание метода апи: %1'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ИмяМетода);
		
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("API");
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает из сервиса описание доступных методов из methods.json
//
// Параметры:
//  ИмяПроекта - Строка - имя проекта
// 
// Возвращаемое значение:
//  Строка - 
//
Функция ОписаниеМетодовИзСервиса(ИмяПроекта)
	
	ИмяСервера = "edi.kontur.ru";
	ПутьНаСервере = "/1c/Plugins/{{projectName}}/Settings/API/methods.json";
	
	ОписаниеЗапроса = Новый_ОписаниеHTTPЗапроса();
	ОписаниеЗапроса.ИмяСервера = ИмяСервера;
