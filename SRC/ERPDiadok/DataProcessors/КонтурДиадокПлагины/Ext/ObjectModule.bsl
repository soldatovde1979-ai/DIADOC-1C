// Описание ошибки которая возникла в плагине
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * ТекстОшибки - Строка - текст ошибки;
//   * ИмяСобытия - Строка - событие связанное с ошибкой;
//   * Дата - Дата - дата возникновения ошибки;
//
Функция Новый_ОшибкаПлагина(ИмяПлагина, ИмяСобытия, ТекстОшибки)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИмяПлагина",	ИмяПлагина);
	Результат.Вставить("ИмяСобытия",	ИмяСобытия);
	Результат.Вставить("ТекстОшибки",	ТекстОшибки);
	Результат.Вставить("Дата",			ТекущаяДатаСеанса());
	
	Возврат Результат;
	
КонецФункции

//********************************************************
//
//		СТАНДАРТНАЯ ОБРАБОТКА СЛУЖЕБНЫХ СОБЫТИЙ
//

// Стандартная обработка получения списка установленных плагинов.
//
// Параметры:
//  Результат - Массив из Новый_КонтрактХранения() - список установленных плагинов
//
Процедура СтандартнаяОбработка_ПриПолученииСпискаЗагруженныхПлагинов(Результат)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонтурПлагин_ID",		ХранениеДанных_СвойствоОбъекта("КонтурПлагин_ID"));
	Запрос.УстановитьПараметр("КонтурПлагин_Версия",	ХранениеДанных_СвойствоОбъекта("КонтурПлагин_Версия"));
	Запрос.УстановитьПараметр("КонтурПлагин_Проект",	ХранениеДанных_СвойствоОбъекта("КонтурПлагин_Проект"));
	Запрос.УстановитьПараметр("КонтурПлагин_Состояние",	ХранениеДанных_СвойствоОбъекта("КонтурПлагин_Состояние"));
	
	Запрос.УстановитьПараметр("СостояниеПоУмолчанию", СостояниеПлагинаВключен());
	Запрос.УстановитьПараметр("ПустаяВерсия", "");
	Запрос.УстановитьПараметр("Проект", ИдентификаторПроекта());
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		Запрос.Текст = ТекстЗапроса_СписокДополнительныеОтчетыИОбработки();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		
		Запрос.Текст = ТекстЗапроса_СписокВнешниеПечатныеФормы();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		Запрос.Текст = ТекстЗапроса_СписокВнешниеОбработки();
		
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		
		НовыйПлагин = Новый_КонтрактХранения();
		ЗаполнитьЗначенияСвойств(НовыйПлагин, Выборка);
		
		Результат.Добавить(НовыйПлагин);
		
	КонецЦикла;
	
КонецПроцедуры 

Функция ТекстЗапроса_СписокДополнительныеОтчетыИОбработки()
	
	Результат = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Объект КАК Объект,
	|	Т.Свойство КАК Свойство,
	|	Т.Значение КАК Значение
	|ПОМЕСТИТЬ ТабСвойств
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Т
	|ГДЕ
	|	Т.Объект ССЫЛКА Справочник.ДополнительныеОтчетыИОбработки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникОбработок.Наименование КАК Представление,
	|	ЕСТЬNULL(ТабСвойствИдентификатор.Значение, СправочникОбработок.ИмяОбъекта) КАК Идентификатор,
	|	ЕСТЬNULL(ТабСвойствСостояние.Значение, &СостояниеПоУмолчанию) КАК Состояние,
	|	ЕСТЬNULL(ТабСвойствВерсия.Значение, &ПустаяВерсия) КАК Версия
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК СправочникОбработок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствПроект
	|		ПО (ТабСвойствПроект.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствПроект.Свойство = &КонтурПлагин_Проект)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствИдентификатор
	|		ПО (ТабСвойствИдентификатор.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствИдентификатор.Свойство = &КонтурПлагин_ID)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствВерсия
	|		ПО (ТабСвойствВерсия.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствВерсия.Свойство = &КонтурПлагин_Версия)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствСостояние
	|		ПО (ТабСвойствСостояние.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствСостояние.Свойство = &КонтурПлагин_Состояние)
	|ГДЕ
	|	ТабСвойствПроект.Значение = &Проект
	|	И НЕ СправочникОбработок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Представление";
	
	Возврат Результат;
	
КонецФункции 

Функция ТекстЗапроса_СписокВнешниеОбработки()
	
	Результат = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Т.Объект КАК Справочник.ВнешниеОбработки) КАК Объект,
	|	Т.Свойство,
	|	Т.Значение
	|ПОМЕСТИТЬ ТабСвойств
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Т
	|ГДЕ
	|	Т.Объект ССЫЛКА Справочник.ВнешниеОбработки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникОбработок.Наименование КАК Представление,
	|	ТабСвойствИдентификатор.Значение КАК Идентификатор,
	|	ЕСТЬNULL(ТабСвойствСостояние.Значение, &СостояниеПоУмолчанию) КАК Состояние,
	|	ТабСвойствВерсия.Значение КАК Версия
	|ИЗ
	|	Справочник.ВнешниеОбработки КАК СправочникОбработок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствИдентификатор
	|		ПО (ТабСвойствИдентификатор.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствИдентификатор.Свойство = &КонтурПлагин_ID)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствВерсия
	|		ПО (ТабСвойствВерсия.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствВерсия.Свойство = &КонтурПлагин_Версия)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствПроект
	|		ПО (ТабСвойствПроект.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствПроект.Свойство = &КонтурПлагин_Проект)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствСостояние
	|		ПО (ТабСвойствСостояние.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствСостояние.Свойство = &КонтурПлагин_Состояние)
	|ГДЕ
	|	ТабСвойствПроект.Значение = &Проект
	|	И НЕ СправочникОбработок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Представление";
	
	Возврат Результат;
	
КонецФункции 

Функция ТекстЗапроса_СписокВнешниеПечатныеФормы()
	
	Результат = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Ссылка КАК Объект,
	|	Т.ПредставлениеОбъекта КАК Свойство,
	|	Т.ИмяОбъекта КАК Значение
	|ПОМЕСТИТЬ ТабСвойств
	|ИЗ
	|	Справочник.ВнешниеПечатныеФормы.Принадлежность КАК Т
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникОбработок.Наименование КАК Представление,
	|	ТабСвойствИдентификатор.Значение КАК Идентификатор,
	|	ЕСТЬNULL(ТабСвойствСостояние.Значение, &СостояниеПоУмолчанию) КАК Состояние,
	|	ТабСвойствВерсия.Значение КАК Версия
	|ИЗ
	|	Справочник.ВнешниеПечатныеФормы КАК СправочникОбработок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствИдентификатор
	|		ПО (ТабСвойствИдентификатор.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствИдентификатор.Свойство = &КонтурПлагин_ID)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствВерсия
	|		ПО (ТабСвойствВерсия.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствВерсия.Свойство = &КонтурПлагин_Версия)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствПроект
	|		ПО (ТабСвойствПроект.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствПроект.Свойство = &КонтурПлагин_Проект)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойствСостояние
	|		ПО (ТабСвойствСостояние.Объект = СправочникОбработок.Ссылка)
	|			И (ТабСвойствСостояние.Свойство = &КонтурПлагин_Состояние)
	|ГДЕ
	|	ТабСвойствПроект.Значение = &Проект
	|	И НЕ СправочникОбработок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Представление";
	
	Возврат Результат;
	
КонецФункции

// Стандартная обработка выполнения HTTPЗапроса
//
// Параметры:
//  ОписаниеОтвета - Структура - (возвращаемый параметр) описание ответа (см. Новый_ОписаниеHTTPОтвета())
//  ОписаниеЗапроса - Структура - Описание запроса (см. Новый_ОписаниеHTTPЗапроса)
//
Процедура СтандартнаяОбработка_ПриВыполненииHTTPЗапроса(ОписаниеОтвета, ОписаниеЗапроса)
	
	Ошибка = "Отсутствует обработчик события (ПриВыполненииHTTPЗапроса)";
	
	СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("HTTP");
	ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, Ошибка);
	
	ВызватьИсключение Ошибка;
	
КонецПроцедуры

// Стандартная обработка загрузки файла плагина в хранилище.
//
// Параметры:
//  Файл - ДвоичныеДанные - двоичные данные плагина.
//  Описание - Структура - описание плагина (см. Новый_КонтрактХранения())
// 
Процедура СтандартнаяОбработка_ПриЗагрузкеПлагина(Файл, Описание) 
	
	НачатьТранзакцию();
	
	Попытка
		
		СохраненныйПлагин = ХранениеДанных_ЗагрузитьФайлПлагина(Файл, Описание);
		
		
		ХранениеДанных_УстановитьЗначениеСвойства(СохраненныйПлагин.Ссылка, "КонтурПлагин_ID", 		Описание.Идентификатор);
		ХранениеДанных_УстановитьЗначениеСвойства(СохраненныйПлагин.Ссылка, "КонтурПлагин_Версия",	Описание.Версия);
		ХранениеДанных_УстановитьЗначениеСвойства(СохраненныйПлагин.Ссылка, "КонтурПлагин_Проект",	ИдентификаторПроекта());
		
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		Ошибка = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ПриЗагрузкеПлагина");
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СтандартнаяОбработка_ПриПроверкеВозможностиНастройки(Результат)

	Если ХранениеДанных_ВариантХраненияПлагинов() = Неопределено Тогда
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Отсутствует возможность использовать механизм плагинов в вашей базе 1С";
		
	ИначеЕсли ХранениеДанных_ЕстьПраваНаИзменениеОбъектов() = Ложь Тогда
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Недостаточно прав для настройки плагинов. 
								|Запустите модуль с правами на изменение справочника дополнительных обработок.";
		
	КонецЕсли;
		
КонецПроцедуры

Процедура СтандартнаяОбработка_ПриВключенииПлагина(Результат, Идентификатор)

	СсылкаНаПлагин = ХранениеДанных_ПлагинПоИдентификатору(Идентификатор);
	НовоеСостояние = СостояниеПлагинаВключен();
	
	Если СсылкаНаПлагин = Неопределено Тогда
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не найден плагин с идентификатором """+Идентификатор+"""";
	Иначе
		ХранениеДанных_УстановитьЗначениеСвойства(СсылкаНаПлагин, "КонтурПлагин_Состояние", НовоеСостояние);
		Результат.Успешно = Истина;
	КонецЕсли;
		
КонецПроцедуры

Процедура СтандартнаяОбработка_ПриУдаленииПлагина(Результат, Идентификатор)

	НайденныйПлагин = ХранениеДанных_ПлагинПоИдентификатору(Идентификатор);
	
	Если НЕ НайденныйПлагин = Неопределено Тогда
		
		ОбъектПлагина = НайденныйПлагин.ПолучитьОбъект();
		ОбъектПлагина.УстановитьПометкуУдаления(Истина);
		
		Если ХранениеДанных_ВариантХраненияПлагинов() = ВариантХранения_ВнешниеПечатныеФормы() Тогда
			
			ОбъектПлагина.Принадлежность.Очистить();
			ОбъектПлагина.Записать();
			
		Иначе 
			
			ХранениеДанных_УдалитьЗначениеСвойства(НайденныйПлагин, "КонтурПлагин_ID");
			ХранениеДанных_УдалитьЗначениеСвойства(НайденныйПлагин, "КонтурПлагин_Версия");
			ХранениеДанных_УдалитьЗначениеСвойства(НайденныйПлагин, "КонтурПлагин_Проект");
			ХранениеДанных_УдалитьЗначениеСвойства(НайденныйПлагин, "КонтурПлагин_Состояние");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Успешно = Истина;
	
КонецПроцедуры

Процедура СтандартнаяОбработка_ПриОтключенииПлагина(Результат, Идентификатор)

	СсылкаНаПлагин = ХранениеДанных_ПлагинПоИдентификатору(Идентификатор);
	НовоеСостояние = СостояниеПлагинаОтключен();
	
	Если СсылкаНаПлагин = Неопределено Тогда
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = "Не найдет плагин с идентификатором """+Идентификатор+"""";
	Иначе
		ХранениеДанных_УстановитьЗначениеСвойства(СсылкаНаПлагин, "КонтурПлагин_Состояние", НовоеСостояние);
		Результат.Успешно = Истина;
	КонецЕсли;
		
КонецПроцедуры

Процедура СтандартнаяОбработка_ПриСохраненииНастроекПлагина(Результат, Идентификатор, Настройки)

	СсылкаНаПлагин = ХранениеДанных_ПлагинПоИдентификатору(Идентификатор);
	
	Если СсылкаНаПлагин = Неопределено Тогда
		// TODO: вызывать исключение
	Иначе
		
		Плагин = СсылкаНаПлагин.ПолучитьОбъект();
		
		ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
		
		Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
			
			Если Плагин.Принадлежность.Количество() = 0 Тогда
				СтрокаНастроек = Плагин.Принадлежность.Добавить();
			Иначе
				СтрокаНастроек = Плагин.Принадлежность[0];
			КонецЕсли;
			
			СтрокаНастроек.ДополнительныеПараметрыОбработки = Новый ХранилищеЗначения(Настройки);
			
		ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
			
			СтрокаНастроек = Плагин.Принадлежность.Найти("Настройки", "ПредставлениеОбъекта");
			
			Если СтрокаНастроек = Неопределено Тогда 
				
				СтрокаНастроек = Плагин.Принадлежность.Добавить();
				СтрокаНастроек.ПредставлениеОбъекта = "Настройки";
				
			КонецЕсли;
			
			СтрокаНастроек.НастройкиПостроителяОтбор = Новый ХранилищеЗначения(Настройки);
			
		ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
			
			Плагин.ХранилищеНастроек = Новый ХранилищеЗначения(Настройки);
			
		КонецЕсли;
		
		//Плагин.ОбменДанными.Загрузка = Истина;
		Плагин.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

// Стандартная обработка чтения настроек плагина.
//
// Параметры:
//  Настройки - Произвольный - (возвращаемый параметр) настройки плагина
//  Идентификатор - Строка - идентификатор плагина
//
Процедура СтандартнаяОбработка_ПриПолученииНастроекПлагина(Результат, Идентификатор)
	
	СсылкаНаПлагин = ХранениеДанных_ПлагинПоИдентификатору(Идентификатор);
	
	Если Не ЗначениеЗаполнено(СсылкаНаПлагин) Тогда
		Возврат;
	КонецЕсли;
	
	Плагин = СсылкаНаПлагин.ПолучитьОбъект();
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		Если Плагин.Принадлежность.Количество() > 0 Тогда
			СтрокаНастроек = Плагин.Принадлежность[0];
			Результат.Данные = СтрокаНастроек.ДополнительныеПараметрыОбработки.Получить();
		КонецЕсли;
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		
		СтрокаНастроек = Плагин.Принадлежность.Найти("Настройки", "ПредставлениеОбъекта");
		
		Если Не СтрокаНастроек = Неопределено Тогда 
			
			Результат.Данные = СтрокаНастроек.НастройкиПостроителяОтбор.Получить();
			
		КонецЕсли;
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		Результат.Данные = Плагин.ХранилищеНастроек.Получить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СтандартнаяОбработка_ПрочитатьФайлПлагина(Идентификатор, ДвоичныеДанные)
	
	ДвоичныеДанные = ХранениеДанных_ПрочитатьФайлПлагина(Идентификатор);
	
КонецПроцедуры

