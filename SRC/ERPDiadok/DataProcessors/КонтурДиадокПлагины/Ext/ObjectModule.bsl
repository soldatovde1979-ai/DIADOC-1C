Функция МанифестПлагина(Идентификатор)
	
	Результат = Новый Структура("Успешно, Данные, ОписаниеОшибки");
	
	Попытка
		
		ОбъектПлагина 		= Плагин_СоздатьОбъект(Идентификатор);
		Результат.Данные	= ОбъектПлагина.МанифестПлагина();
		Результат.Успешно	= Истина;
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияПлагина(Идентификатор, "ПолучитьМанифест");
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		
		Результат.Успешно			= Ложь;
		Результат.ОписаниеОшибки	= ТекстОшибки;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПротестироватьПлагин(Идентификатор)
	
	Результат = Новый Структура("Успешно, ТребуетсяНастройка, ОписаниеОшибки", Истина, Ложь, "");
	
	Попытка
		
		ОбъектПлагина	= Плагин_СоздатьОбъект(Идентификатор);
		
		РезультатТеста	= ОбъектПлагина.ПротестироватьПлагин();
		
		Результат.Успешно				= РезультатТеста.Успешно;
		Результат.ТребуетсяНастройка	= РезультатТеста.ТребуетсяНастройка;
		Результат.ОписаниеОшибки		= РезультатТеста.ОписаниеОшибки;

	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияПлагина(Идентификатор, "Протестировать");
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		
		Результат.Успешно			= Ложь;
		Результат.ОписаниеОшибки	= ПодробноеПредставлениеОшибки(Ошибка);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

