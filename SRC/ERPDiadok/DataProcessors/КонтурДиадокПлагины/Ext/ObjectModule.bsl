	Результат.Вставить("КаталогОтладки", "");
	
	Возврат Результат;
	
КонецФункции

// Обертка для более удобного получения результата служебных событий
Функция ПолучитьРезультатСлужебногоСобытия(ИмяКоманды, ПараметрыКоманды = Неопределено)
	
	Если ПараметрыКоманды = Неопределено Тогда
		ПараметрыКоманды = Новый Структура;
	КонецЕсли;
	
	ПараметрыКоманды.Вставить("Результат");
	
	ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды, Контекст);
	
	Возврат ПараметрыКоманды.Результат;
	
КонецФункции

Процедура ЗавершитьРаботуМодуля()
	
	КешПлагинов = КэшПлагинов();
	КэшПлагинов = Неопределено;
	
	ОсновнойМодуль = Неопределено;
	СчетчикВызовов = Неопределено;
	КэшНаСервере = Неопределено;
	Контекст = Неопределено;
	
КонецПроцедуры

