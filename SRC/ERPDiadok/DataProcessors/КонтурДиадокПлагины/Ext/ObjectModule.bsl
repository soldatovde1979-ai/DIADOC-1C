Функция ИдентификаторПроекта()
	
	Результат = "";
	СтандартнаяОбработка = Истина;
	
	ОсновнойМодуль_ПриПолученииИдентификатораПроекта(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		Ошибка = "Отсутствует обработчик события (ПриПолученииИдентификатораПроекта)";
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ОпределитьИдентификаторПроекта");
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, Ошибка);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

