КонецФункции

// Заполняет описание запроса по описанию метода из сервиса
//
// Параметры:
//  ОписаниеМетода - Структура - см. ОписаниеМетодаАПИ()
// 
// Возвращаемое значение:
//  Структура - см. Новый_ОписаниеHTTPЗапроса()
//
Функция ОписаниеЗапросаПоОписаниюМетода(ОписаниеМетода)
	
	Результат = Новый_ОписаниеHTTPЗапроса();
	Результат.Метод = ОписаниеМетода.request.method;
	
	Для каждого Элемент Из ОписаниеМетода.request.header Цикл
		Результат.Заголовки.Вставить(Элемент.key, Элемент.value);
	КонецЦикла;
	
	СтруктураURI = СтруктураURI(ОписаниеМетода.request.url.raw);
	
	ЗаполнитьЗначенияСвойств(Результат, СтруктураURI);
	
	Возврат Результат;
	
КонецФункции

