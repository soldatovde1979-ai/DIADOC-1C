Функция Метрика_ИдентификаторТрассировки()
	
	Результат = TraceId;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		TraceId = "БиблиотекаПлагинов_" + Новый УникальныйИдентификатор;
		
		Результат = TraceId;
		
	КонецЕсли;
	
	Возврат Результат;
	
