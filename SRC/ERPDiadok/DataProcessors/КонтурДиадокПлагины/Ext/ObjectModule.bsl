//#Область ПрограммныйИнтерфейс

// Открывает основную форму библиотеки плагинов.
//
// Параметры:
//  КонтекстИлиВызвающийМодуль - Структура, ФормаКлиентскогоПриложения - см. НовыйКонтекстВызывающегоМодуля
//  ПараметрВладелец - ФормаКлиентскогоПриложения - форма или элемент управления другой формы.
//
Процедура ОткрытьОсновнуюФорму(КонтекстИлиВызвающийМодуль, ПараметрВладелец) Экспорт
	
	Если ТипЗнч(КонтекстИлиВызвающийМодуль) = Тип("Структура") Тогда
		Контекст = КонтекстИлиВызвающийМодуль;
	Иначе
		Контекст = НовыйКонтекстВызывающегоМодуля(КонтекстИлиВызвающийМодуль);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ИмяОсновнойФормы = "Форма_Обычная";
	
	ПараметрКлючУникальности = Неопределено;
	ПараметрЗакрыватьПриЗакрытииВладельца = Истина;
	
	ФормаОбработки = ПолучитьФормуОбработки(
		ИмяОсновнойФормы,
		ПараметрВладелец,
		ПараметрыФормы,
		ПараметрКлючУникальности,
		ПараметрЗакрыватьПриЗакрытииВладельца
	);
	
	ФормаОбработки.Инициализировать(Контекст);
	ФормаОбработки.Открыть();
	
КонецПроцедуры

Процедура ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, КонтекстИлиВызвающийМодуль) Экспорт
	
	ПриНачалеВызоваБиблиотеки(КонтекстИлиВызвающийМодуль);
	
	СоответствиеСобытийПлагинам = СоответствиеСобытийПлагинам_Получить();
	
	МассивПлагинов = СоответствиеСобытийПлагинам.Получить(ИмяСобытия);
	
	Если НЕ МассивПлагинов = Неопределено Тогда
		Для Каждого Плагин ИЗ МассивПлагинов Цикл
			
			Плагин_ОбработатьСобытие(
				Плагин,
				ИмяСобытия,
				ПараметрыСобытия
			);
			
		КонецЦикла;
	КонецЕсли;

	ПриОкончанииВызоваБиблиотеки();
	
КонецПроцедуры

Функция СведенияОВнешнейОбработке() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("БезопасныйРежим", Ложь);
	Результат.Вставить("Наименование"	, Метаданные().Синоним);
	Результат.Вставить("Информация"		, Метаданные().Комментарий);
	Результат.Вставить("Версия"			, ВерсияОбработки());
	Результат.Вставить("Команды"		, Новый ТаблицаЗначений);
	Результат.Вставить("Вид"			, "ДополнительнаяОбработка");
	
	Возврат Результат;
	
КонецФункции

// Конструктор сведений о плагине.
//
// Параметры:
//  Идентификатор - Строка - идентификатор (имя) плагина;
//  Версия - Строка - версия плагина;
//  Включен - Булево - (необязательный) Истина, если плагин включен;
//  Представление - Строка - (Необязательный) Пользовательское представление плагина. Если не заполнено, используется Идентификатор.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. Контракт_СведенияОПлагине.
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция Новый_СведенияОПлагине(Знач Идентификатор, Знач Версия, Знач Включен = Истина, Знач Представление = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = Идентификатор;
	КонецЕсли;
	
	Результат = Контракт_СведенияОПлагине();
	Результат.Идентификатор = Идентификатор;
	Результат.Представление = Представление;
	Результат.Включен = Включен;
	Результат.Версия = Версия;
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает список установленных плагинов (загруженных в информационную базу)
// 
// Возвращаемое значение:
//  Массив из Структура:
//   * Идентификатор - Строка - идентификатор (имя) плагина;
//   * Версия - Строка - версия плагина;
//   * Состояние - Строка - представление состояния плагина;
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция УстановленныеПлагины(КонтекстИлиВызвающийМодуль) Экспорт
	
	ПриНачалеВызоваБиблиотеки(КонтекстИлиВызвающийМодуль);
	
	Результат = Новый Массив;
	
	ЗагруженныеПлагины = СписокЗагруженныхПлагинов();
	
	Для Каждого ВнутреннийКонтракт Из ЗагруженныеПлагины Цикл
		
		ПубличныйКонтракт = Новый Структура;
		ПубличныйКонтракт.Вставить("Идентификатор", ВнутреннийКонтракт.Идентификатор);
		ПубличныйКонтракт.Вставить("Состояние", ВнутреннийКонтракт.Состояние);
		ПубличныйКонтракт.Вставить("Версия", ВнутреннийКонтракт.Версия);
		
		Результат.Добавить(ПубличныйКонтракт);
		
	КонецЦикла;
	
	ПриОкончанииВызоваБиблиотеки();
	
	Возврат Результат;
	
КонецФункции


// Возвращает признак возможности хранения плагинов в стандартном хранилище.
// 
// Возвращаемое значение:
//  Булево - Истина, если определено стандартное хранилище плагинов.
//
Функция ДоступноСтандартноеХранилищеПлагинов() Экспорт
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Результат = ЗначениеЗаполнено(ВариантХранения);
	
	Возврат Результат;
	
КонецФункции

