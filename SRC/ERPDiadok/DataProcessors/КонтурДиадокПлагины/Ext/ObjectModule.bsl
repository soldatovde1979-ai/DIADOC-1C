Процедура ОбработатьКоманду_ПроверитьНаличиеОбновлений(ПараметрыСобытия)
	
	Результат = Новый Структура("Успешно, Данные, ОписаниеОшибки", Ложь, ,"");
	
	СписокЗагруженных = СписокЗагруженныхПлагинов();
	СписокТиповых = СписокТиповыхПлагинов();
	
	СоответствиеПлагинов = Новый Соответствие;
	
	Для Каждого СтрТиповой ИЗ СписокТиповых Цикл
		
		СтруктураПлагина = Новый Структура();
		СтруктураПлагина.Вставить("Идентификатор",		СтрТиповой.Идентификатор);
		СтруктураПлагина.Вставить("Версия",				СтрТиповой.Версия);
		СтруктураПлагина.Вставить("Автообновление", 	СтрТиповой.Автообновление);
		СтруктураПлагина.Вставить("Описание",			СтрТиповой.Описание);
		СтруктураПлагина.Вставить("СсылкаНаСправку",	СтрТиповой.СсылкаНаСправку);
		
		СоответствиеПлагинов.Вставить(СтрТиповой.Идентификатор,СтруктураПлагина);
			
	КонецЦикла;
	
	МассивОбновлений = Новый Массив; 
	
	Для Каждого Плагин Из СписокЗагруженных Цикл
		
		АктуальнаяВерсия = СоответствиеПлагинов.Получить(Плагин.Идентификатор);
		Если НЕ АктуальнаяВерсия = Неопределено Тогда
			Если СравнитьВерсии(АктуальнаяВерсия.Версия, Плагин.Версия)>0 Тогда
				
				МассивОбновлений.Добавить(АктуальнаяВерсия);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Успешно	= Истина;
	Результат.Данные	= МассивОбновлений;
	
	ПараметрыСобытия.Вставить("Результат",Результат);
	
КонецПроцедуры

Процедура ОбработатьКоманду_ВыполнитьАвтоматическоеОбновление(ПараметрыСобытия)
	
	СписокАктуальныхВерсий = ПолучитьРезультатСлужебногоСобытия(КомандаПроверитьНаличиеОбновлений());
	
	Для Каждого АктуальнаяВерсия Из СписокАктуальныхВерсий Цикл
		Если АктуальнаяВерсия.Автообновление Тогда
			
			ПараметрыОбновления = Новый Структура();
			ПараметрыОбновления.Вставить("Идентификатор",	АктуальнаяВерсия.Идентификатор);
			ПараметрыОбновления.Вставить("ВариантЗагрузки",	"Обновление");
			
			Результат = ПолучитьРезультатСлужебногоСобытия(КомандаЗагрузитьПлагин(), ПараметрыОбновления);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьКоманду_ПолучитьСписокПлагинов(ПараметрыСобытия)
	
	// Список неиспользуемых
	НеиспользуемыеПлагины = Новый Соответствие;
	МассивНеиспользуемых = СписокНеиспользуемыхПлагинов();
	Для Каждого Эл ИЗ МассивНеиспользуемых Цикл
		НеиспользуемыеПлагины.Вставить(Эл,Истина);
	КонецЦикла;
	
	СписокЗагруженных = СписокЗагруженныхПлагинов();
	
	МассивСписка = Новый Массив;
	
	Для Каждого Плагин Из СписокЗагруженных Цикл
		
		НовыйЭлемент = Новый_МанифестПлагина();
		НовыйЭлемент.Вставить("ЕстьОбновление");
		НовыйЭлемент.Вставить("Состояние");
		НовыйЭлемент.Вставить("ОписаниеОшибки");
		НовыйЭлемент.Вставить("ПутьКФайлу");
		
		// заполним основные поля
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, Плагин);
		
		// заполним поля из манифеста
		
		РезультатМанифеста = МанифестПлагина(Плагин.Идентификатор);
		
		Если РезультатМанифеста.Успешно Тогда
			
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, РезультатМанифеста.Данные);
			
		Иначе
			
			Если НовыйЭлемент.Состояние = СостояниеПлагинаВключен() Тогда
				НовыйЭлемент.Состояние = СостояниеПлагинаЕстьОшибки();
			КонецЕсли;
			
			НовыйЭлемент.ОписаниеОшибки = РезультатМанифеста.ОписаниеОшибки;
			
		КонецЕсли;
		
		// протестируем плагин, если он включен
		
		Если НовыйЭлемент.Состояние = СостояниеПлагинаВключен() Тогда
			
			РезультатТестирования = ПротестироватьПлагин(Плагин.Идентификатор);
			
			Если НЕ РезультатТестирования.Успешно Тогда
				
				НовыйЭлемент.Состояние		= СостояниеПлагинаЕстьОшибки();
				НовыйЭлемент.ОписаниеОшибки	= РезультатТестирования.ОписаниеОшибки;
				
			ИначеЕсли РезультатТестирования.ТребуетсяНастройка Тогда
				
				НовыйЭлемент.Состояние		= СостояниеПлагинаТребуетсяНастройка();
				
			КонецЕсли;
				
		КонецЕсли;
		
		// сбросим состояние в "Не используется", если он есть в перечне неиспользуемых плагинов основного модуля
		
		Если НеиспользуемыеПлагины.Получить(Плагин.Идентификатор) = Истина Тогда
			
			НовыйЭлемент.Состояние = СостояниеПлагинаНеИспользуется();
			
		КонецЕсли;
		
		МассивСписка.Добавить(НовыйЭлемент);
		
	КонецЦикла;
	
	ПараметрыСобытия.Результат = МассивСписка;
	
КонецПроцедуры

Процедура ОбработатьКоманду_ЗагрузитьПлагин(ПараметрыСобытия)
	
	Действие = "Загрузить";
	
	Результат = Новый Структура("Успешно, ОписаниеОшибки", Истина, "");
	
	ИмяПроекта = ИдентификаторПроекта();
	ИмяПлагина = ПараметрыСобытия.Идентификатор;
	
	Плагин = Новый_КонтрактХранения();
	Плагин.Идентификатор = ИмяПлагина;
	Плагин.Представление = ПараметрыСобытия.Представление;
	Плагин.Версия = ПараметрыСобытия.Версия;
	
	Файл = ПараметрыСобытия.ДвоичныеДанные;
	
	Если Файл = Неопределено Тогда
		Файл = Сервис_ФайлПлагина(ИмяПроекта, ИмяПлагина);
	КонецЕсли;
	
	СтандартнаяОбработка = Истина;
	
	Попытка
		
		ОсновнойМодуль_ПриЗагрузкеПлагина(Файл, Плагин, СтандартнаяОбработка);
		
		Если СтандартнаяОбработка Тогда
			СтандартнаяОбработка_ПриЗагрузкеПлагина(Файл, Плагин);
		КонецЕсли;
		
		Метрики_ЗаписатьДействиеПлагинов(
			Плагин.Идентификатор,
			Плагин.Версия,
			Действие
		);

		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ПодробноеПредставлениеОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		ЖурналРегистрации_ЗаписатьОшибку(
			КомандаЗагрузитьПлагин(),
			ПодробноеПредставлениеОшибки
		);
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = КраткоеПредставлениеОшибки(Ошибка);
		
		Метрики_ЗаписатьОшибкуПлагинов(
			Плагин.Идентификатор,
			Плагин.Версия,
			Действие,
			ПодробноеПредставлениеОшибки
		);
		
	КонецПопытки;
	
	СброситьКэш();
	
	ПараметрыСобытия.Вставить("Результат", Результат);
	
КонецПроцедуры

