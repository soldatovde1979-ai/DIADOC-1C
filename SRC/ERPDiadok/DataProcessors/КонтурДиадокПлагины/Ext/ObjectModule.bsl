	КонецЕсли;
	
	СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ПриНачалеВызоваБиблиотеки");
	Ошибка = "Отсутвует указатель на вызывающий модуль!";
	ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, Ошибка);
	
	ВызватьИсключение Ошибка;
	
