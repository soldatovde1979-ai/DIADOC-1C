// Проверяет наличие прав на изменение объектов хранения данных
Функция ХранениеДанных_ЕстьПраваНаИзменениеОбъектов()
	
	ЕстьПраваНаИзменениеОбъектов = Кэш_Прочитать("ЕстьПраваНаИзменениеОбъектов");	
	Если НЕ ЕстьПраваНаИзменениеОбъектов = Неопределено Тогда
		Возврат ЕстьПраваНаИзменениеОбъектов;
	КонецЕсли;
	
	ЕстьПраваНаИзменениеОбъектов = Ложь;
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		Если ПравоДоступа("Изменение", Метаданные.Справочники.ВнешниеОбработки) И
			 ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ЗначенияСвойствОбъектов) И
			 ПравоДоступа("Изменение", Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов) Тогда
			 
			 ЕстьПраваНаИзменениеОбъектов = Истина;
			 
		 КонецЕсли;
		 
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		
		Если ПравоДоступа("Изменение", Метаданные.Справочники.ВнешниеПечатныеФормы) И
			 ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ЗначенияСвойствОбъектов) Тогда
			 
			 ЕстьПраваНаИзменениеОбъектов = Истина;
			 
		КонецЕсли;
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		Если ПравоДоступа("Изменение", Метаданные.Справочники.ДополнительныеОтчетыИОбработки) И
			 ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ДополнительныеСведения) И
			 ПравоДоступа("Изменение", Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения) Тогда
			 
			 ЕстьПраваНаИзменениеОбъектов = Истина;
			 
		КонецЕсли;
		
	КонецЕсли;
	
	Кэш_Поместить("ЕстьПраваНаИзменениеОбъектов", ЕстьПраваНаИзменениеОбъектов);
	
	Возврат ЕстьПраваНаИзменениеОбъектов;
	
КонецФункции

// Определяет вариант хранения плагинов: ВнешниеОбработки ИЛИ ДополнительныеОтчетыИОбработки
Функция ХранениеДанных_ВариантХраненияПлагинов()
	
	ВариантХранения = Кэш_Прочитать("ВариантХраненияДанных");	
	Если НЕ ВариантХранения = Неопределено Тогда
		Возврат ВариантХранения;
	КонецЕсли;
			 
	Если Служебные_ЕстьНеобходимыеМетаданные("Справочники.ДополнительныеОтчетыИОбработки.Реквизиты.ХранилищеОбработки") И
		 Служебные_ЕстьНеобходимыеМетаданные("Справочники.ДополнительныеОтчетыИОбработки.Реквизиты.ХранилищеНастроек") И 
		 Служебные_ЕстьНеобходимыеМетаданные("РегистрыСведений.ДополнительныеСведения") И 
		 Служебные_ЕстьНеобходимыеМетаданные("ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения") Тогда
		
		 ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки();
		 
	ИначеЕсли Служебные_ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки.Реквизиты.ХранилищеВнешнейОбработки") И
		 Служебные_ЕстьНеобходимыеМетаданные("Справочники.ВнешниеОбработки.ТабличныеЧасти.Принадлежность.Реквизиты.ДополнительныеПараметрыОбработки") И 
		 Служебные_ЕстьНеобходимыеМетаданные("РегистрыСведений.ЗначенияСвойствОбъектов") И 
		 Служебные_ЕстьНеобходимыеМетаданные("ПланыВидовХарактеристик.СвойстваОбъектов") Тогда
		 
		 ВариантХранения = ВариантХранения_ВнешниеОбработки();
		 
    ИначеЕсли Служебные_ЕстьНеобходимыеМетаданные("Справочники.ВнешниеПечатныеФормы.Реквизиты.Хранилище") И
		 Служебные_ЕстьНеобходимыеМетаданные("Справочники.ВнешниеПечатныеФормы.ТабличныеЧасти.Принадлежность.Реквизиты.НастройкиПостроителяОтбор") Тогда
		 
		 ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы();
		 
	Иначе
		
		ВариантХранения = Неопределено;
		
	КонецЕсли;
		
	Кэш_Поместить("ВариантХраненияДанных", ВариантХранения);
	
	Возврат ВариантХранения;
	
КонецФункции

Функция ВариантХранения_ВнешниеОбработки()
	Возврат "ВнешниеОбработки";
КонецФункции

Функция ВариантХранения_ДополнительныеОтчетыИОбработки()
	Возврат "ДополнительныеОтчетыИОбработки";
КонецФункции

Функция ВариантХранения_ВнешниеПечатныеФормы()
	Возврат "ВнешниеПечатныеФормы";
КонецФункции

// Возвращает имя каталога справочника доп. обработок, в который будут сохраняться все плагины
Функция ХранениеДанных_ИмяКаталогаПлагинов()
	
	Возврат "Контур.Плагины";
	
КонецФункции

// Находит и создает в случае необходимости каталог в справочнике доп. обработок
Функция ХранениеДанных_КаталогПлагинов()
	
	КаталогПлагинов = Кэш_Прочитать("КаталогПлагинов");
	Если НЕ КаталогПлагинов = Неопределено Тогда
		Возврат КаталогПлагинов;
	КонецЕсли;
	
	ВариантХранения		= ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		ИмяСправочникаПлагинов = "ВнешниеОбработки";
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		ИмяСправочникаПлагинов = "ДополнительныеОтчетыИОбработки";
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		ИмяСправочникаПлагинов = "ВнешниеПечатныеФормы";
	Иначе
		// TODO: вызвать исключение
	КонецЕсли;
	
	ИмяКаталогаПлагина	= ХранениеДанных_ИмяКаталогаПлагинов();
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.Ссылка
	|ИЗ
	|	Справочник."+ИмяСправочникаПлагинов+" КАК Т
	|ГДЕ
	|	Т.ЭтоГруппа
	|	И НЕ Т.ПометкаУдаления
	|	И Т.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", ИмяКаталогаПлагина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		КаталогПлагинов = Выборка.Ссылка;
		
	Иначе
		
		НовыйКаталог = Справочники[ИмяСправочникаПлагинов].СоздатьГруппу();
		НовыйКаталог.Наименование = ИмяКаталогаПлагина;
		НовыйКаталог.ОбменДанными.Загрузка = Истина;
		НовыйКаталог.Записать();
		
		КаталогПлагинов = НовыйКаталог.Ссылка;
		
	КонецЕсли;
	
	Кэш_Поместить("КаталогПлагинов", КаталогПлагинов);
	
	Возврат КаталогПлагинов;
	
КонецФункции

// Сохраняет двоичные данные плагина в справочник доп. обработок
//
// Параметры:
//  Файл - ДвоичныеДанные - двоичные данные плагина.
//  Описание - Структура - описание плагина (см. Новый_КонтрактХранения())
// 
Функция ХранениеДанных_ЗагрузитьФайлПлагина(Файл, Описание)
	
	ВариантХранения	= ХранениеДанных_ВариантХраненияПлагинов();
	КаталогПлагинов = ХранениеДанных_КаталогПлагинов();
	
	НайденныйПлагин = ХранениеДанных_ПлагинПоИдентификатору(Описание.Идентификатор);
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		Если НайденныйПлагин = Неопределено Тогда	
			СохраненныйПлагин = Справочники.ВнешниеОбработки.СоздатьЭлемент();
		Иначе
			СохраненныйПлагин = НайденныйПлагин.ПолучитьОбъект();
		КонецЕсли;	
		
		СохраненныйПлагин.Родитель = КаталогПлагинов;
		СохраненныйПлагин.Наименование = Описание.Представление;
		СохраненныйПлагин.ВидОбработки = Перечисления.ВидыДополнительныхВнешнихОбработок.ПечатнаяФорма;
		СохраненныйПлагин.ХранилищеВнешнейОбработки = Новый ХранилищеЗначения(Файл);
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
			
		Если НайденныйПлагин = Неопределено Тогда	
			СохраненныйПлагин = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
		Иначе
			СохраненныйПлагин = НайденныйПлагин.ПолучитьОбъект();
		КонецЕсли;	
		
		// TODO: публикация - понять насколько стоит смешивать состояние и публикацию
		
		СохраненныйПлагин.Родитель				= КаталогПлагинов;
		СохраненныйПлагин.Вид                   = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка;
		СохраненныйПлагин.Наименование			= Описание.Представление;
		СохраненныйПлагин.Публикация			= Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется;
		СохраненныйПлагин.ИмяОбъекта			= Описание.Идентификатор;
		СохраненныйПлагин.ХранилищеОбработки	= Новый ХранилищеЗначения(Файл);
		СохраненныйПлагин.Версия				= Описание.Версия;
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		
		Если НайденныйПлагин = Неопределено Тогда	
			СохраненныйПлагин = Справочники.ВнешниеПечатныеФормы.СоздатьЭлемент();
		Иначе
			СохраненныйПлагин = НайденныйПлагин.ПолучитьОбъект();
		КонецЕсли;	
		
		СохраненныйПлагин.Родитель					= КаталогПлагинов;
		СохраненныйПлагин.Наименование				= Описание.Представление;
		СохраненныйПлагин.ВидОбработки				= Перечисления.ВидыВнешнихОбработок.Обработка;
		СохраненныйПлагин.Хранилище					= Новый ХранилищеЗначения(Файл);
			
	Иначе
			
		// TODO: вызвать исключение
			
	КонецЕсли;
	
	//СохраненныйПлагин.ОбменДанными.Загрузка = Истина;
	
	СохраненныйПлагин.Записать();
	
	Возврат СохраненныйПлагин.Ссылка;
	
КонецФункции

// Подставляет параметры в строку, максимальное число параметров - 5.
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон содержащий маркеры подстановки вида: "%1..%N"
//                        . Нумерация маркеров начинается с 1.
//                          N не может быть более 6.
//  Параметр<n>  - Строка - подставляемые параметры.
//
// Возвращаемое значение:
//   Строка - строка шаблона с подставленными параметрами.
//
Функция СтроковыеУтилиты_ПодставитьПараметрыВСтроку(ШаблонСтроки, Параметр1
	, Параметр2 = Неопределено
	, Параметр3 = Неопределено
	, Параметр4 = Неопределено
	, Параметр5 = Неопределено
	, Параметр6 = Неопределено) Экспорт
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	Результат = СтрЗаменить(Результат	, "%6", Параметр6);
	
	Возврат Результат;
	
КонецФункции

// Объединяет части пути через разделитель
//
Функция ФайловаяСистема_ОбъединитьПути(П1, П2, П3 = Неопределено, П4 = Неопределено)
	
	Результат = П1;
	
	РазделительПути = ФайловаяСистема_РазделительПути();
	
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(П2);
	ЧастиПути.Добавить(П3);
	ЧастиПути.Добавить(П4);
	
	Для Каждого Элемент Из ЧастиПути Цикл
		
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			Прервать;
		КонецЕсли;
		
		Если Прав(Результат, 1) <> РазделительПути Тогда
			Результат = Результат + РазделительПути;
		КонецЕсли;
		
		Результат = Результат + Элемент;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает разделитель пути, используемого в операционной системе
// 
// Возвращаемое значение:
//  Строка
//
Функция ФайловаяСистема_РазделительПути()
	
	Если ВерсияПлатформыНиже("8.3.3") Тогда
		
		Результат = "/";
		
		Если ЭтоПлатформаWindows() Тогда
			Результат = "\";
		КонецЕсли;
		
	Иначе
		Результат = Вычислить("ПолучитьРазделительПути()");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ФайловаяСистема_ПроверитьСоздатьКаталог(Знач Каталог)
	
	Если ТипЗнч(Каталог) = Тип("Строка") Тогда
		Каталог = Новый Файл(Каталог);
	КонецЕсли;
	
	Если Не Каталог.Существует() Тогда 
		
		СоздатьКаталог(Каталог.ПолноеИмя);
		
	ИначеЕсли Не Каталог.ЭтоКаталог() Тогда 
		
		ОписаниеОш = СтроковыеУтилиты_ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Невозможно создать каталог ""%1"" по причине: 
				|%2'"),
			Каталог.ПолноеИмя,
			НСтр("ru = 'Имя каталога занято файлом'")
		);
		
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьФайлПлагина(Идентификатор)
	
	ДвоичныеДанные = Неопределено;
	СтандартнаяОбработка = Истина;
	
	ОсновнойМодуль_ПрочитатьФайлПлагина(Идентификатор, ДвоичныеДанные, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		СтандартнаяОбработка_ПрочитатьФайлПлагина(Идентификатор, ДвоичныеДанные);
	КонецЕсли;
	
	Если Отладка_РежимОтладки() Тогда
		
		ФайловаяСистема_ПроверитьСоздатьКаталог(Отладка_КаталогОтладки());
		
		ФайлПуть = Отладка_ПутьКФайлуПлагина(Идентификатор);
		
		Файл = Новый Файл(ФайлПуть);
		
		Если Не Файл.Существует() Тогда
			ДвоичныеДанные.Записать(Файл.ПолноеИмя);
		КонецЕсли;
		
		Результат = Файл.ПолноеИмя;
		
	Иначе
		
		Результат = ДвоичныеДанные;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ХранениеДанных_ПрочитатьФайлПлагина(Идентификатор)
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	НайденныйПлагин = ХранениеДанных_ПлагинПоИдентификатору(Идентификатор);
	
	Если Не ЗначениеЗаполнено(НайденныйПлагин) Тогда
		
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ХранениеДанных.ПрочитатьФайлПлагина");
		ТекстОшибки = ПараметрыВСтроку("Плагин не найден (идентификатор = %1)", Идентификатор);
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		Возврат НайденныйПлагин.ХранилищеВнешнейОбработки.Получить();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
			
		Возврат НайденныйПлагин.ХранилищеОбработки.Получить();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
			
		Возврат НайденныйПлагин.Хранилище.Получить();
			
	Иначе
			
		// TODO: вызвать исключение
				
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

// Находит объект по значению свойства
//
// Параметры:
//  ИмяСвойства - Строка - наименование свойства.
//  Значение - Строка - значение свойства
// 
Функция ХранениеДанных_НайтиОбъектПоЗначениюСвойства(ИмяСвойства, Значение)
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Запрос = Новый Запрос;
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		Запрос.Текст = ТекстЗапроса_КаталогВнешниеОбработки();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		Запрос.Текст = ТекстЗапроса_КаталогДополнительныеОтчетыиОбработки();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		
		Запрос.Текст = ТекстЗапроса_КаталогВнешниеПечатныеформы();
		
	Иначе
		// TODO: вызвать исключение
	КонецЕсли;
	
	Свойство = ХранениеДанных_СвойствоОбъекта(ИмяСвойства);
	
	Запрос.УстановитьПараметр("Свойство",		Свойство);
	Запрос.УстановитьПараметр("Значение",		Значение);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Объект;
		
	КонецЕсли;
	
КонецФункции 

Функция ТекстЗапроса_КаталогДополнительныеОтчетыиОбработки()
	
	Результат = "ВЫБРАТЬ
	|	Т.Объект
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Т
	|ГДЕ
	|	Т.Свойство = &Свойство
	|	И Т.Значение = &Значение";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_КаталогВнешниеОбработки()
	
	Результат = "ВЫБРАТЬ
	|	Т.Объект
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК Т
	|ГДЕ
	|	Т.Свойство = &Свойство
	|	И Т.Значение = &Значение";
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапроса_КаталогВнешниеПечатныеформы()
	
	Результат = "ВЫБРАТЬ
	|	Т.Ссылка Как Объект
	|ИЗ
	|	Справочник.ВнешниеПечатныеФормы.Принадлежность КАК Т
	|ГДЕ
	|	Т.ПредставлениеОбъекта = &Свойство
	|	И Т.ИмяОбъекта = &Значение";
	
	Возврат Результат;
	
КонецФункции

// Находит или создает свойство объекта в плане видов характеристик типовых объектов
//
// Параметры:
//  ИмяСвойства - Строка - наименование свойства.
//
// ВозвращаемоеЗначение: ссылка на элемент плана видов характеристик нужного свойства
// 
Функция ХранениеДанных_СвойствоОбъекта(ИмяСвойства) 
	
	Свойство = Кэш_Прочитать("Свойство_"+ИмяСвойства);	
	Если НЕ Свойство = Неопределено Тогда
		Возврат Свойство;
	КонецЕсли;
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		ИмяПВХ = "СвойстваОбъектов";
		Свойство = ХранениеДанных_НайтиСоздатьСвойство(ИмяПВХ, ИмяСвойства, ВариантХранения);
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		ИмяПВХ = "ДополнительныеРеквизитыИСведения"; 
		Свойство = ХранениеДанных_НайтиСоздатьСвойство(ИмяПВХ, ИмяСвойства, ВариантХранения);
		
	ИначеЕсли ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда 
		
		Свойство = ИмяСвойства;
		
	Иначе
		
		// TODO: вызвать исключение
		
	КонецЕсли;
	
	Кэш_Поместить("Свойство_"+ИмяСвойства, Свойство);
	
	Возврат Свойство;
	
КонецФункции 

Функция ХранениеДанных_НайтиСоздатьСвойство(ИмяПВХ, ИмяСвойства, ВариантХранения)
	
	Свойство = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Т.Ссылка
					|ИЗ
					|	ПланВидовХарактеристик."+ИмяПВХ+" КАК Т
					|ГДЕ
					|	Т.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование",ИмяСвойства);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Свойство = Выборка.Ссылка;
		
	Иначе
		
		Свойство = ХранениеДанных_СоздатьСвойство(ИмяСвойства, ВариантХранения);
		
	КонецЕсли; 
	
	Возврат Свойство;
	
КонецФункции   

Функция ХранениеДанных_СоздатьСвойство(ИмяСвойства, ВариантХранения)
	
	Результат = Неопределено;
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		НовоеСвойство 						= ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		НовоеСвойство.НазначениеСвойства	= ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочники;
	Иначе
		НовоеСвойство 						= ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Имя"						, ИмяСвойства);
	СтруктураРеквизитов.Вставить("Заголовок"				, ИмяСвойства);
	СтруктураРеквизитов.Вставить("Наименование"				, ИмяСвойства);
	СтруктураРеквизитов.Вставить("ИдентификаторДляФормул"	, ИмяСвойства);
	СтруктураРеквизитов.Вставить("ТипЗначения"				, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	ЗаполнитьЗначенияСвойств(НовоеСвойство, СтруктураРеквизитов); 
	
	НовоеСвойство.ОбменДанными.Загрузка = Истина;
	НовоеСвойство.Записать();
	
	Результат = НовоеСвойство.Ссылка;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает значение свойства объекта
//
// Параметры:
//  Объект - Ссылка - ссылка на объект
//  ИмяСвойства - Строка - наименование свойства
//  Значение - Строка - значение свойства
// 
Процедура ХранениеДанных_УстановитьЗначениеСвойства(Объект, ИмяСвойства, Значение) 
	
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Свойство = ХранениеДанных_СвойствоОбъекта(ИмяСвойства);
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		НоваяЗапись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		НоваяЗапись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		
	Иначе
		// TODO: вызвать исключение
	КонецЕсли; 
	
	Если ВариантХранения = ВариантХранения_ВнешниеПечатныеФормы() Тогда
		
		ОбъектПлагина = Объект.ПолучитьОбъект();
		
		МенеджерНастроек = ОбъектПлагина.Принадлежность;
		
		СтрокаПринадлежности = МенеджерНастроек.Найти(ИмяСвойства, "ПредставлениеОбъекта");
		
		Если СтрокаПринадлежности = Неопределено Тогда 
			
			СтрокаПринадлежности = МенеджерНастроек.Добавить();

		КонецЕсли;
		
		СтрокаПринадлежности.ПредставлениеОбъекта = ИмяСвойства;
		СтрокаПринадлежности.ИмяОбъекта = Значение;
		
		ОбъектПлагина.Записать();
		
	Иначе
		
		НоваяЗапись.Объект		= Объект.Ссылка;
		НоваяЗапись.Свойство	= Свойство;
		НоваяЗапись.Значение	= Значение;
		
		НоваяЗапись.Записать();  
		
	КонецЕсли;
	
КонецПроцедуры

// Удаляет значение свойства объекта
//
// Параметры:
//  Объект - Ссылка - ссылка на объект
//  ИмяСвойства - Строка - наименование свойства
// 
Процедура ХранениеДанных_УдалитьЗначениеСвойства(Объект, ИмяСвойства)
	
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Свойство = ХранениеДанных_СвойствоОбъекта(ИмяСвойства);
	
	ВариантХранения = ХранениеДанных_ВариантХраненияПлагинов();
	
	Если ВариантХранения = ВариантХранения_ВнешниеОбработки() Тогда
		
		НоваяЗапись = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		
	ИначеЕсли ВариантХранения = ВариантХранения_ДополнительныеОтчетыИОбработки() Тогда
		
		НоваяЗапись = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
		
	Иначе
		// TODO: вызвать исключение
	КонецЕсли;
	
	НоваяЗапись.Объект		= Объект.Ссылка;
	НоваяЗапись.Свойство	= Свойство;
	
	НоваяЗапись.Прочитать();
	НоваяЗапись.Удалить();
	
КонецПроцедуры

Функция ХранениеДанных_ПлагинПоИдентификатору(Идентификатор)
	
	ИмяСвойства = "КонтурПлагин_ID";
	Результат = ХранениеДанных_НайтиОбъектПоЗначениюСвойства(ИмяСвойства, Идентификатор);
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ХранениеДанных.ПлагинПоИдентификатору");
		ТекстОшибки = ПараметрыВСтроку("Плагин не найден (идентификатор = %1)", Идентификатор);
		ЖурналРегистрации_ЗаписатьПредупреждение(СобытиеЖР, ТекстОшибки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

