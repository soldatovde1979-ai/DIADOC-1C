Функция ВерсияЗагруженногоПлагина(Идентификатор)
	
	Результат = "";
	
	СписокЗагруженныхПлагинов = СписокЗагруженныхПлагинов();
	Для Каждого ЗагруженныйПлагин Из СписокЗагруженныхПлагинов Цикл
		
		Если загруженныйПлагин.Идентификатор = Идентификатор Тогда
			Результат = ЗагруженныйПлагин.Версия;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НовоеСобытиеМетрики(ТипСобытия, Действие, ИдентификаторПлагина, ВерсияПлагина, Переменные = Неопределено, ТекстОшибки = Неопределено, ИдентификаторТрассировки = Неопределено)
	
	Результат = Новый Структура;
	Результат.Вставить("ТипСобытия", ТипСобытия);
	Результат.Вставить("Действие", Действие);
	Результат.Вставить("ИдентификаторПлагина", ИдентификаторПлагина);
	Результат.Вставить("ВерсияПлагина", ВерсияПлагина);
	Результат.Вставить("ИдентификаторТрассировки", ИдентификаторТрассировки);
	Результат.Вставить("Переменные", Переменные);
	Результат.Вставить("ТекстОшибки", ТекстОшибки);

	Возврат Результат;
	
КонецФункции

Процедура Метрики_ЗарегистрироватьСобытие(ОписаниеСобытия)
	
	СтандартнаяОбработка = Ложь;
	
	ОсновнойМодуль_ПриПолученииМетрики(ОписаниеСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура Метрики_ЗаписатьДействиеПлагинов(ИдентификаторПлагина, ВерсияПлагина, Действие)
	
	ТипСобытия = Метрики_ТипСобытияСтатистика();
	
	ИдентификаторТрассировки = Метрика_ИдентификаторТрассировки();
	НовоеСобытиеМетрики = НовоеСобытиеМетрики(ТипСобытия, Действие, ИдентификаторПлагина, ВерсияПлагина, , , ИдентификаторТрассировки);
	
	Метрики_ЗарегистрироватьСобытие(НовоеСобытиеМетрики);
	
КонецПроцедуры

Процедура Метрики_ЗаписатьОшибкуПлагинов(ИдентификаторПлагина, ВерсияПлагина, Действие, ТекстОшибки)
	
	ТипСобытия = Метрики_ТипСобытияОшибка();
	
	Переменные = Новый Структура;
	Переменные.Вставить("Ошибка", ТекстОшибки); 
	
	НовоеСобытиеМетрики = НовоеСобытиеМетрики(ТипСобытия, Действие, ИдентификаторПлагина, ВерсияПлагина, Переменные);
	
	Метрики_ЗарегистрироватьСобытие(НовоеСобытиеМетрики);
	
КонецПроцедуры

