//
//		ОБРАБОТЧИКИ СЛУЖЕБНЫХ КОМАНД
//

Процедура ОбработатьКоманду_ПроверитьВозможностьНастройки(ПараметрыСобытия)
	
	Результат = Новый Структура("Успешно, ОписаниеОшибки", Истина, "");
	
	СтандартнаяОбработка = Истина;
	
	ОсновнойМодуль_ПриПроверкеВозможностиНастройки(Результат, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		СтандартнаяОбработка_ПриПроверкеВозможностиНастройки(Результат);
	КонецЕсли;
	
	ПараметрыСобытия.Вставить("Результат", Результат);
	
КонецПроцедуры

// Получает из сервиса список доступных плагинов
Процедура ОбработатьКоманду_ПолучитьСписокТиповых(ПараметрыСобытия)
	
	Если ПараметрыСобытия = Неопределено Тогда 
		ПараметрыСобытия = Новый Структура;
	КонецЕсли; 
	
	Результат = СписокТиповыхПлагинов();
	
