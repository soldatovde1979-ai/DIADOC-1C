//#Область ПубличныеКонтракты

// Публичный контракт описания плагина.
// 
// Возвращаемое значение:
//  Стурктура:
//    * Идентификатор - Строка - идентификатор (имя) плагина;
//    * Представление - Строка - пользовательское представление плагина;
//    * Версия - Строка - Версия плагина (по умолчанию "0.0.0");
//    * Включен - Булево - Истина, если плагин включен;
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция Контракт_СведенияОПлагине()
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Представление");
	Результат.Вставить("Включен");
	Результат.Вставить("Версия");
	
	Возврат Результат;
	
КонецФункции

//#КонецОбласти // ПубличныеКонтракты


//#Область СлужебныйПрограммныйИнтерфейс

// Открывает список опубликованных плагинов.
//
// Параметры:
//  ПараметрВладелец - ФормаКлиентскогоПриложения - форма или элемент управления другой формы.
//
Процедура ОткрытьБиблиотекуПлагинов(ПараметрВладелец) Экспорт
	
	ИмяФормыБиблиотеки = "Форма_БиблиотекаПлагинов_Обычная";
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрКлючУникальности = Неопределено;
	ПараметрЗакрыватьПриЗакрытииВладельца = Истина;
	
	ФормаОбработки = ПолучитьФормуОбработки(
		ИмяФормыБиблиотеки,
		ПараметрВладелец,
		ПараметрыФормы,
		ПараметрКлючУникальности,
		ПараметрЗакрыватьПриЗакрытииВладельца
	);
	
	ФормаОбработки.Открыть();
	
КонецПроцедуры

Процедура ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды, КонтекстИлиВызвающийМодуль) Экспорт
	
	ПриНачалеВызоваБиблиотеки(КонтекстИлиВызвающийМодуль);
	
	Если ИмяКоманды = КомандаПолучитьСписокТиповых() Тогда 
		
		ОбработатьКоманду_ПолучитьСписокТиповых(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаПолучитьСписокЗагруженных() Тогда
		
		ОбработатьКоманду_ПолучитьСписокЗагруженных(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаПолучитьСписокПлагинов() Тогда
		
		ОбработатьКоманду_ПолучитьСписокПлагинов(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаПроверитьНаличиеОбновлений() Тогда
		
		ОбработатьКоманду_ПроверитьНаличиеОбновлений(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаПроверитьВозможностьНастройки() Тогда
		
		ОбработатьКоманду_ПроверитьВозможностьНастройки(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаЗагрузитьПлагин() Тогда
		
		ОбработатьКоманду_ЗагрузитьПлагин(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаПолучитьФайл() Тогда
		
		ОбработатьКоманду_ПолучитьФайл(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаВключитьПлагин() Тогда
		
		ОбработатьКоманду_ВключитьПлагин(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаОтключитьПлагин() Тогда
		
		ОбработатьКоманду_ОтключитьПлагин(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаУдалитьПлагин() Тогда
		
		ОбработатьКоманду_УдалитьПлагин(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаОткрытьНастройкиПлагина() Тогда
		
		ОбработатьКоманду_ОткрытьНастройкиПлагина(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаПолучитьНастройки() Тогда
		
		ОбработатьКоманду_ПолучитьНастройки(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаСохранитьНастройки() Тогда
		
		ОбработатьКоманду_СохранитьНастройкиПлагина(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаЗафиксироватьОшибкуПлагина() Тогда
		
		ОбработатьКоманду_ПлагинЗафиксироватьОшибку(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаМетрики_ЗаписатьОшибку() Тогда
		
		ОбработатьКоманду_Метрики_ЗаписатьОшибку(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаМетрики_ЗаписатьСтатистику() Тогда
		
		ОбработатьКоманду_Метрики_ЗаписатьСтатистику(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаМетрики_ЗаписатьПоведение() Тогда
		
		ОбработатьКоманду_Метрики_ЗаписатьПоведение(ПараметрыКоманды);
		
	ИначеЕсли ИмяКоманды = КомандаМетрики_ЗаписатьЗамер() Тогда
		
		ОбработатьКоманду_Метрики_ЗаписатьЗамер(ПараметрыКоманды);
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Неизвестная команда (%1)'");
		ТекстОшибки = ПараметрыВСтроку(ТекстОшибки, ИмяКоманды);
		
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ОбработатьСлужебнуюКоманду");
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ПриОкончанииВызоваБиблиотеки();
	
КонецПроцедуры

//#КонецОбласти // СлужебныйПрограммныйИнтерфейс


//#Область СлужебныеКонтракты

// Конструктор сведений о плагине.
// 
// Возвращаемое значение:
//  Структура - содержит ключи:
//    * Идентификатор - Строка - идентификатор плагина
//    * Представление - Строка - представление плагина для пользователя
//    * Состояние - Строка - текущее состояние плагина (см. Перечисление_СостоянияПлагинов)
//    * Версия - Строка - номер версии МАЖОРНАЯ.МИНОРНАЯ.ПАТЧ (см. https://semver.org/lang/ru/)
//
Функция Новый_КонтрактХранения()
	
	СостояниеПоУмолчанию = СостояниеПлагинаВключен();
	
	Результат = Новый Структура;
	
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Представление");
	Результат.Вставить("Состояние", СостояниеПоУмолчанию);
	Результат.Вставить("Версия");
	Результат.Вставить("ПутьКФайлу");
	
	Возврат Результат;
	
КонецФункции

Функция Новый_ТиповойПлагин()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Идентификатор");
	Результат.Вставить("Представление");
	Результат.Вставить("ДатаОбновления");
	Результат.Вставить("Версия");
	Результат.Вставить("Описание");
	Результат.Вставить("СсылкаНаСправку");
	Результат.Вставить("Автообновление", Ложь);
	
	Возврат Результат;
	
КонецФункции

//#КонецОбласти // СлужебныеКонтракты


//#Область СлужебныеПроцедурыИФункции

Функция СоответствиеСобытийПлагинам_Получить()
	
	// TODO: помещать в кэш основного модуля через Плагины_ПоместитьКэш?
	
	КлючКэш = "СоответствиеСобытийПлагинам";
	
	Результат = Кэш_Прочитать(КлючКэш);
	Если НЕ Результат = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	СоответствиеСобытийПлагинам = Новый Соответствие;
	
	ВсеПлагины = СписокПлагинов();
	
	Для Каждого Плагин ИЗ ВсеПлагины Цикл
		
		Если Плагин.Состояние <> СостояниеПлагинаВключен() Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатМанифеста = МанифестПлагина(Плагин.Идентификатор);
		
		Если РезультатМанифеста.Успешно Тогда
			
			Для Каждого ИмяСобытия ИЗ РезультатМанифеста.Данные.События Цикл
				
				МассивПлагинов = СоответствиеСобытийПлагинам.Получить(ИмяСобытия);
				Если МассивПлагинов = Неопределено Тогда
					МассивПлагинов = Новый Массив;
				КонецЕсли;
				
				КонтрактХранения = Новый_КонтрактХранения();
				ЗаполнитьЗначенияСвойств(КонтрактХранения, Плагин);
				МассивПлагинов.Добавить(КонтрактХранения);
				
				СоответствиеСобытийПлагинам.Вставить(ИмяСобытия,МассивПлагинов);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Кэш_Поместить(КлючКэш, СоответствиеСобытийПлагинам);
	
	Возврат СоответствиеСобытийПлагинам;
	
КонецФункции

Процедура СброситьКэш()

	// TODO: помещать в кэш основного модуля через Плагины_ПоместитьКэш? 
	КэшПлагинов_Очистить();
	
	Кэш_Поместить("СоответствиеСобытийПлагинам", Неопределено);
	
