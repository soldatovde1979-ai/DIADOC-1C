// Сравнивает указанную версию с версией платформы
//
// Параметры:
//  Версия - Строка - версия, с которой нужно сравнить версию платформы;
// 
// Возвращаемое значение:
//  Булево - Истина, если версия платформы ниже указанной
//
Функция ВерсияПлатформыНиже(Версия)
	
	КлючКэш = "ВерсияПлатформыНиже " + Версия;
	Результат = Кэш_Прочитать(КлючКэш);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	СисИнфо = Новый СистемнаяИнформация;
	Результат = (СравнитьВерсии(ВерсияПлатформы(), Версия) < 0);
	
	Кэш_Поместить(КлючКэш, Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание защиты от опасных действий
// с отключенным предупреждением об опасных действиях
// 
// Возвращаемое значение:
//  ОписаниеЗащитыОтОпасныхДействий
//
Функция ОписаниеЗащитыБезПредупреждений()
	
	Результат = Неопределено;
	
	Попытка
		Результат = Новый("ОписаниеЗащитыОтОпасныхДействий");
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияБиблиотеки("ПодключениеОбработок");
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		ЖурналРегистрации_ЗаписатьПредупреждение(СобытиеЖР, ТекстОшибки);
		
	КонецПопытки;
	
	Если Результат <> Неопределено Тогда
		Результат.ПредупреждатьОбОпасныхДействиях = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие механизма платформы, предупреждающего об опасных действиях.
//
// Возвращаемое значение:
//  Булево - Истина, если механизм предупреждений безопасности есть
//
Функция ЕстьЗащитаОтОпасныхДействий()
	
	Свойства = Новый Структура("ЗащитаОтОпасныхДействий, UnsafeOperationProtection");
	ЗаполнитьЗначенияСвойств(Свойства, ПользователиИнформационнойБазы.ТекущийПользователь());
	
	Если Свойства.ЗащитаОтОпасныхДействий <> Неопределено
		Или Свойства.UnsafeOperationProtection <> Неопределено Тогда
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Соединяет массив переданных строк в одну строку с указанным разделителем.
// По аналогии с глобальным методом СтрСоединить, добавленным в платформу версии 8.3.6.
// ВАЖНО: В результирующую строку добавляются только непустые значения!
// Платформенный метод СтрСоединить объединяет строки безусловно.
// Нужно это учитывать, если в качестве разделителя задана непустая строка.
// 
// Параметры:
//  Строки - Массив, ФиксированныйМассив - коллекция объединяемых строк.
//  Разделитель - Строка - Строка, которая будет вставлена между объединяемыми строками.
//                         Если параметр не задан, строки будут объединены слитно друг с другом.
//
// Возвращаемое значение:
//   Строка - строка, содержащая соединенные исходные строки с разделителем между ними.
//
// Пример:
//   
//   Строки = Новый Массив;
//   Строки.Добавить("Элемент0");
//   Строки.Добавить("");
//   Строки.Добавить("Элемент2");
//   
//   СоединитьСтроку(Строки, "#") = "Элемент0#Элемент2"
//   СтрСоединить(Строки, "#") = "Элемент0##Элемент2"
//   СоединитьСтроку(Строки, "") = СтрСоединить(Строки, "") = "Элемент0Элемент2"
//
Функция Служебные_СоединитьСтроку(Строки, Разделитель = "")
	
	Результат = "";
	ТекРазделитель = "";
	
	Для Каждого Строка Из Строки Цикл
		
		Результат = Результат + ТекРазделитель + Строка;
		ТекРазделитель = Разделитель;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разделяет строку на части по указанным разделителям
// В отличие от СтрРазделить, в качестве разделителя используется вся строка
//
// Параметры:
//  Строка               - Строка - разделяемая строка;
//  МассивИлиРазделитель - Массив, Строка - строка разделителя или массив строк разделителей;
//  ВключатьПустые       - Булево - Ложь, если пустые части строки включать в результат не нужно;
// 
// Возвращаемое значение:
//  Массив - массив со строками, которые получились в результате разделения исходной строки
//
Функция Служебные_РазделитьСтроку(Строка, МассивИлиРазделитель = ",", ВключатьПустые = Истина)
	
	Если ТипЗнч(МассивИлиРазделитель) = Тип("Массив") Тогда
		МассивРазделителей = МассивИлиРазделитель;
	Иначе
		МассивРазделителей = Новый Массив;
		МассивРазделителей.Добавить(МассивИлиРазделитель);
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для каждого Разделитель Из МассивРазделителей Цикл
		
		Результат.Очистить();
		
		СтрокаРазделена = Ложь;
		
		ТекСтрока = Строка;
		
		ДлинаРазделителя = СтрДлина(Разделитель);
		
		Пока Истина Цикл
			
			Поз = Найти(ТекСтрока, Разделитель);
			
			Если Поз > 0 Тогда
				СтрокаРазделена = Истина;
			КонецЕсли;
			
			Если Поз = 0 Тогда
				Подстрока = СокрЛП(ТекСтрока);
				ТекСтрока = "";
			Иначе
				Подстрока = СокрЛП(Лев(ТекСтрока, Поз - 1));
				ТекСтрока = Сред(ТекСтрока, Поз + ДлинаРазделителя);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Подстрока) Или ВключатьПустые Тогда
				Результат.Добавить(Подстрока);
			КонецЕсли;
			
			Если Поз = 0 Тогда
				Прервать; // Нет разделителя, за которым могла бы быть следующая часть строки
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрокаРазделена Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие метаданных (в т.ч. реквизитов) по строке
Функция Служебные_ЕстьНеобходимыеМетаданные(СтрокаМетаданных) 
	
	КлючКэш = "ЕстьМетаданные";
	
	РезультатыКэш = Кэш_Прочитать(КлючКэш);
	
	Если Не ЗначениеЗаполнено(РезультатыКэш) Тогда
		РезультатыКэш = Новый Соответствие;
		Кэш_Поместить(КлючКэш, РезультатыКэш);
	КонецЕсли;
	
	Результат = РезультатыКэш.Получить(СтрокаМетаданных);
	
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = Истина;
	
	МассивИмен = Служебные_РазделитьСтроку(СтрокаМетаданных, ".");
	
	КоличествоИмен = МассивИмен.Количество();
	
	// КоличествоИмен = 2 для проверки наличия объекта, например 					Справочники.КонтурEDI_Сообщения
	// КоличествоИмен = 4 для проверки наличия реквизита\ресурса и т.д., например	Справочники.КонтурEDI_Сообщения.Реквизиты.Организация
	// КоличествоИмен = 6 для проверки наличия реквизита таб. части, например		Справочники.КонтурEDI_Сообщения.ТабличныеЧасти.ДополнительныеРеквизиты.Реквизиты.ЗначениеСтрока
	
	Если КоличествоИмен <> 2 И КоличествоИмен <> 4 И КоличествоИмен <> 6 Тогда
		
		Результат = Ложь;
		
	Иначе
		
		ТекущиеМетаданные = Метаданные;
		
		КоличествоПоисков = КоличествоИмен / 2;
		
		Для Сч = 1 По КоличествоПоисков Цикл
			
			Владелец = МассивИмен[Сч * 2 - 2];
			Реквизит = МассивИмен[Сч * 2 - 1];
			
			ТекущиеМетаданные = ТекущиеМетаданные[Владелец].Найти(Реквизит);
			
			Если ТекущиеМетаданные = Неопределено Тогда
				Результат = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	РезультатыКэш.Вставить(Результат);
	
	Возврат Результат;
	
КонецФункции

