//		ПЕРЕОПРЕДЕЛЕНИЕ СЛУЖЕБНЫХ СОБЫТИЙ В ОСНОВНОМ МОДУЛЕ
//

Процедура ОсновнойМодуль_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка)
	
	Попытка
		
		ОсновнойМодуль.КонтурПлагины_ОбработатьСлужебноеСобытие(
			ИмяСобытия,
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		СобытиеЖР = ЖурналРегистрации_ИдентификаторСобытияПродукта(ИмяСобытия);
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		
		ЖурналРегистрации_ЗаписатьОшибку(СобытиеЖР, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

// Обработка записи плагина в хранилище текущей информационной базы.
// В свойство "ПараметрыСобытия.Описание" будем помещать Контракт_СведенияОПлагине.
//
// Параметры:
//  Файл - ДвоичныеДанные - двоичные данные плагина.
//  Описание - Структура - описание плагина (см. Новый_КонтрактХранения())
//  СтандартнаяОбработка - Булево - Ложь, если требуется отключить стандартную обработку события.
//
Процедура ОсновнойМодуль_ПриЗагрузкеПлагина(Файл, Описание, СтандартнаяОбработка)
	
	ИмяСобытия = "ПриЗагрузкеПлагина";
	
	Включен = Описание.Состояние = СостояниеПлагинаВключен();
	
	СведенияОПлагине = Новый_СведенияОПлагине(
		Описание.Идентификатор,
		Описание.Версия,
		Включен,
		Описание.Представление
	);
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Файл", Файл);
	ПараметрыСобытия.Вставить("Описание", СведенияОПлагине);
	
	ОсновнойМодуль_ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

