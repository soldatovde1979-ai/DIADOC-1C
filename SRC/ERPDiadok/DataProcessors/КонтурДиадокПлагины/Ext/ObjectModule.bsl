// Формирует полный идентификатор события журнала регистрации, относящегося к работе библиотеки.
//
// Параметры:
//  Действие - Строка - Действие, с которым связано событие.
// 
// Возвращаемое значение:
//  Строка - полный идентификатор события.
//
Функция ЖурналРегистрации_ИдентификаторСобытияБиблиотеки(Действие)
	
	Подстроки = Новый Массив;
	Подстроки.Добавить(ИдентификаторБиблиотеки());
	Подстроки.Добавить(Действие);
	
	Разделитель = РазделительУровнейЛога();
	
	Результат = Служебные_СоединитьСтроку(Подстроки, Разделитель);
	
	Возврат Результат;
	
КонецФункции

// Формирует полный идентификатор события журнала регистрации, относящегося к работе плагина.
//
// Параметры:
//  ИдентификаторПлагина - Строка - Идентификатор плагина.
//  Действие - Строка - Действие, с которым связано событие.
// 
// Возвращаемое значение:
//  Строка - полный идентификатор события.
//
Функция ЖурналРегистрации_ИдентификаторСобытияПлагина(ИдентификаторПлагина, Действие)
	
	Подстроки = Новый Массив;
	Подстроки.Добавить(ИдентификаторБиблиотеки());
	Подстроки.Добавить(ИдентификаторПлагина);
	Подстроки.Добавить(Действие);
	
	Разделитель = РазделительУровнейЛога();
	
	Результат = Служебные_СоединитьСтроку(Подстроки, Разделитель);
	
	Возврат Результат;
	
КонецФункции

