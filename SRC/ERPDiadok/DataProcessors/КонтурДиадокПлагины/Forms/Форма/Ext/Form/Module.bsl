#Область ОписаниеПеременных

&НаСервере
Перем КэшМодуляОбъекта;

&НаКлиенте
Перем КэшМодуляКлиента;

&НаКлиенте
Перем ВызывающийМодуль;

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Процедура Инициализировать(Контекст, БиблиотекаПлагиновКлиент) Экспорт
	
	ВызывающийМодуль = Контекст.ВызывающийМодуль;
	КэшМодуляКлиента = БиблиотекаПлагиновКлиент;
	
	Если Контекст.РежимОтладки Тогда
		
		Заголовок = СтрШаблон(
			"%1 (каталог отладки: %2)",
			Заголовок,
			Контекст.КаталогОтладки
		);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОсновнойМодуль() Экспорт
	
	Возврат ВызывающийМодуль;
	
КонецФункции

&НаКлиенте
Функция МодульКлиента() Экспорт
	
	Возврат КэшМодуляКлиента;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Результат");
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаПроверитьВозможностьНастройки(),
		ПараметрыСобытия
	);
	
	Результат = ПараметрыСобытия.Результат;
	
	Если Не Результат.Успешно Тогда
		
		Элементы.Предупреждение_ОписаниеОшибки.Заголовок = Результат.ОписаниеОшибки;
		Элементы.ГруппаПредупреждениеНастройки.Видимость = Истина;
		
		Элементы.ГруппаКоманднаяПанельСпискаПлагиновОсновная.Доступность = Ложь;
		Элементы.ГруппаПлагин_КоманднаяПанель.Доступность = Ложь;
		
	КонецЕсли;
	
	ОбновитьСписок();
	ПроверитьНаличиеОбновлений();
	ПриАктивизацииСтрокиСпискаПлагинов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонтурПлагины_ЗагруженНовыйПлагин" Тогда
		ОбновитьСписок();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьКПлагинамНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	МодульПлагиныКлиент = МодульКлиента();
	МодульПлагиныКлиент.ПоказатьДиалогВыбораКаталога(
		"Выберите сетевую папку для хранения плагинов",
		Неопределено,
		"ПутьКПлагинам_ПослеВыбораКаталога",
		ЭтаФорма
	);
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПлагины_Список

&НаКлиенте
Процедура Плагины_СписокПриАктивизацииСтроки(Элемент)
	
	ПриАктивизацииСтрокиСпискаПлагинов()
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Плагины_ОткрытьБиблиотеку(Команда)
	
	МодульПлагиныКлиент = МодульКлиента();
	МодульПлагиныКлиент.ОткрытьБиблиотекуПлагинов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Плагины_ОбновитьСписок(Команда)
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_Удалить(Команда)
	
	ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Плагин и его настройки будут удалены, продолжить?";
	ОписаниеОповещения = Новый ОписаниеОповещения("Плагин_УдалитьЗавершение", ЭтаФорма);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_Включить(Команда)
	
	ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Идентификатор", ТекСтрока.Идентификатор);
	ПараметрыСобытия.Вставить("Результат");
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаВключитьПлагин(),
		ПараметрыСобытия
	);
	
	Результат = ПараметрыСобытия.Результат;
	Если НЕ Результат.Успешно Тогда
		ВызватьИсключение("При выполнении действия возникла ошибка:" + Символы.ПС + Символы.ПС + Результат.ОписаниеОшибки);
	КонецЕсли;
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_Отключить(Команда)
	
	ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Идентификатор", ТекСтрока.Идентификатор);
	ПараметрыСобытия.Вставить("Результат");
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаОтключитьПлагин(),
		ПараметрыСобытия
	);
	
	Результат = ПараметрыСобытия.Результат;
	Если НЕ Результат.Успешно Тогда
		ВызватьИсключение("При выполнении действия возникла ошибка:" + Символы.ПС + Символы.ПС + Результат.ОписаниеОшибки);
	КонецЕсли;
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКПлагинамСохранить(Команда)
	
	СохранитьНастройки();
	УправлениеДоступностью();
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_Открыть(Команда)
	
	ТекДанные = Элементы.Плагины_Список.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено Тогда
		
		ОткрытьФормуНастроекПлагина(ТекДанные.Идентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Плагины_ЗагрузитьИзФайла(Команда)
	
	МодульПлагиныКлиент = МодульКлиента();
	МодульПлагиныКлиент.ПоказатьДиалогВыбораФайла(
		"Выберите плагин для загрузки",
		,
		,
		, 
		"ОбработатьЗагрузкуФайла",
		ЭтаФорма
	);
	
КонецПроцедуры

&НаКлиенте
Процедура Плагины_ВыгрузитьФайл(Команда)
	
	ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("Идентификатор", ТекСтрока.Идентификатор);
	
	МодульПлагиныКлиент = МодульКлиента();
	МодульПлагиныКлиент.ПоказатьДиалогСохраненияФайла(
		"Укажите путь для сохранения файла плагина",
		Неопределено,
		ТекСтрока.Идентификатор,
		"epf",
		Неопределено, 
		"ОбработатьСохранениеФайлаПлагина",
		ЭтаФорма,
		ПараметрыОбработчика
	);
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_Обновить(Команда)
	
	ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ЗагрузитьПлагинИзСервиса(
		ТекСтрока.Идентификатор,
		ТекСтрока.Представление,
		ТекСтрока.Версия
	);
	
	Если Не Результат.Успешно Тогда
		ВызватьИсключение("Не удалось загрузить плагин: "+Результат.ОписаниеОшибки);
	КонецЕсли;
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_ОткрытьПодробноеОписание(Команда)
	
	ТекущиеДанные = Элементы.Плагины_Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СсылкаНаСправку) Тогда
		ЗапуститьПриложение(ТекущиеДанные.СсылкаНаСправку);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВключитьСистемныеКнопки(Команда)
	
	Элементы.ГруппаСистемные.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Плагины_ПроверитьНаличиеОбновлений(Команда)
	
	ПроверитьНаличиеОбновлений();
	ПриАктивизацииСтрокиСпискаПлагинов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция МодульОбъекта()
	
	Если КэшМодуляОбъекта = Неопределено Тогда
		КэшМодуляОбъекта = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Возврат КэшМодуляОбъекта;
	
КонецФункции

&НаКлиенте
Процедура СохранитьНастройки()
	
	Настройки = НастройкиПоКонтексту();
	
	ОсновнойМодуль().Плагины_СохранитьНастройкиБиблиотеки(Настройки);
	
КонецПроцедуры

&НаКлиенте
Функция НастройкиПоКонтексту()
	
	МодульПлагиныКлиент = МодульКлиента();
	Результат = МодульПлагиныКлиент.Новый_НастройкиБиблиотеки();
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтаФорма);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПутьКПлагинамСохранитьНаСервере()
	
	МодульОбъекта().Интеграция_СохранитьНастройку("ПутьКПлагинамНаДиске",ПутьКПлагинам);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиСпискаПлагинов()
	
	ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
	
	ЕстьДанные = (ТекСтрока <> Неопределено);
	Элементы.ГруппаПлагины_Право.Видимость = ЕстьДанные;
	
	Если Не ЕстьДанные Тогда
		Возврат;
	КонецЕсли;
	
	ПлагинАктивен = (ТекСтрока.Состояние = СостояниеПлагинаВключен() Или ТекСтрока.Состояние = СостояниеПлагинаОтладка());
	
	Элементы.Плагин_Отключить.Видимость = ПлагинАктивен;
	Элементы.Плагин_Включить.Видимость = Не ПлагинАктивен;
	Элементы.Плагин_Обновить.Видимость = ТекСтрока.ЕстьОбновление И ПлагинАктивен;
	Элементы.Плагин_Открыть.Видимость = ТекСтрока.ЕстьНастройки И ПлагинАктивен;
	Элементы.Плагин_ОткрытьСправку.Видимость = ЗначениеЗаполнено(ТекСтрока.СсылкаНаСправку);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДоступностью()
	
	МодульПлагиныКлиент = МодульКлиента();
	ВариантыХраненияПлагинов = МодульПлагиныКлиент.Перечисление_ВариантыХраненияПлагинов();
	
	Элементы.НастройкаПервогоЗапуска.Видимость = Ложь;
	Элементы.ГруппаПредупреждениеДопОбработки.Видимость = Ложь;
	
	Если ВариантХранения = ВариантыХраненияПлагинов.НаДиске Тогда
		
		ПервыйЗапуск = НЕ ЗначениеЗаполнено(ПутьКПлагинам);
			
		Элементы.НастройкаПервогоЗапуска.Видимость	= ПервыйЗапуск;
		Элементы.ГруппаПлагины_Основная.Видимость	= НЕ ПервыйЗапуск;
		
	ИначеЕсли ВариантХранения = ВариантыХраненияПлагинов.ДопОбработки Тогда
		
		ЕстьПраваНаДопОбработки = МодульПлагиныКлиент.Интеграция_ЕстьПраваНаСправочникДопОбработок();
		
		Элементы.ГруппаПредупреждениеДопОбработки.Видимость = НЕ ЕстьПраваНаДопОбработки;
		Элементы.Плагины_ОткрытьБиблиотеку.Доступность = ЕстьПраваНаДопОбработки;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок()
	
	Плагины_Список.Очистить();
	
	ПараметрыСобытия = Новый Структура;
	ПараметрыСобытия.Вставить("Результат");
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаПолучитьСписокПлагинов(),
		ПараметрыСобытия
	);
	
	СписокПлагинов = ПараметрыСобытия.Результат;
	
	Для Каждого Плагин Из СписокПлагинов Цикл 
		
		СтрокаСписка = Плагины_Список.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Плагин);
		
		Если СтрокаСписка.Состояние = "Включен" Тогда
			СтрокаСписка.КартинкаСтатус = 1;
		КонецЕсли;
		
		Если НЕ СтрокаСписка.ЕстьОбновление Тогда
			СтрокаСписка.КартинкаОбновление = 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастроекПлагина(Идентификатор)
	
	МодульПлагиныКлиент = МодульКлиента();
	МодульПлагиныКлиент.ОткрытьНастройкиПлагина(Идентификатор, ОсновнойМодуль());
	
КонецПроцедуры 

&НаКлиенте
Функция ЗагрузитьПлагинИзФайла(Идентификатор, Файл)
	
	МодульКлиента = МодульКлиента();
	Результат = МодульКлиента.ЗагрузитьПлагин(
		Идентификатор,
		Идентификатор,
		"",
		Файл
	);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьПлагинИзСервиса(Идентификатор, Представление, Версия)
	
	МодульКлиента = МодульКлиента();
	Результат = МодульКлиента.ЗагрузитьПлагин(
		Идентификатор,
		Представление,
		Версия,
	);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьНаличиеОбновлений()
	
	ПараметрыСобытия = Новый Структура("Результат");

	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаПроверитьНаличиеОбновлений(),
		ПараметрыСобытия
	);
	
	РезультатПроверки = ПараметрыСобытия.Результат;
	
	Если Не РезультатПроверки.Успешно Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Обновление Из РезультатПроверки.Данные Цикл 
		
		Отбор = Новый Структура("Идентификатор", Обновление.Идентификатор);
		НайденныеСтроки = Плагины_Список.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			НайденнаяСтрока = НайденныеСтроки[0];
			НайденнаяСтрока.ЕстьОбновление = Истина;
			НайденнаяСтрока.Описание = Обновление.Описание;
			
			НайденнаяСтрока.КартинкаОбновление = 0;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновнойМодуль_ОбработатьСлужебнуюКоманду(ИмяКоманды, ПараметрыКоманды)
	
	ОсновнойМодуль = ОсновнойМодуль();
	ОсновнойМодуль.КонтурПлагины_ОбработатьСлужебнуюКоманду(
		ИмяКоманды,
		ПараметрыКоманды
	);
	
КонецПроцедуры

#Область ОбработчикиОписанийОповещений

&НаКлиенте
Процедура ПутьКПлагинам_ПослеВыбораКаталога(ВыбранныйКаталог, ДопПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныйКаталог) Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКПлагинам = ВыбранныйКаталог[0];
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКаталогаОтладки(ВыбранныеКаталоги, ПараметрыОбработчика = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеКаталоги) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыСобытия = Новый Структура();
	ПараметрыСобытия.Вставить("КаталогОтладки", ВыбранныеКаталоги[0]);
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		"Плагины_ВключитьОтладку",
		ПараметрыСобытия
	);
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьЗагрузкуФайла(ВыбранныеФайлы, ПараметрыОбработчика = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ВыбранныеФайлы[0];
	Файл = Новый Файл(ПутьКФайлу);
	
	ДвоичныеДанные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
	
	ЗагрузитьПлагинИзФайла(Файл.ИмяБезРасширения, ДвоичныеДанные);
	
	ОбновитьСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСохранениеФайлаПлагина(ВыбранныеФайлы, ПараметрыОбработчика = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПлагина = ПараметрыОбработчика.Идентификатор;
	ПутьКФайлу = ВыбранныеФайлы[0];
	
	ФайлПлагина = Новый Файл(ПутьКФайлу);
	
	Если ФайлПлагина.ИмяБезРасширения <> ИдентификаторПлагина Тогда
		ВызватьИсключение("При сохранении файла плагина не стоит менять предложенное имя файла!");
	КонецЕсли;
	
	ПараметрыСобытия = Новый Структура();
	ПараметрыСобытия.Вставить("Идентификатор", ИдентификаторПлагина);
	
	ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
		КомандаПолучитьФайл(),
		ПараметрыСобытия
	);
	
	ДвоичныеДанныеФайла = ПараметрыСобытия.Результат;
	ДвоичныеДанныеФайла.Записать(ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура Плагин_УдалитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда

		ТекСтрока = Элементы.Плагины_Список.ТекущиеДанные;
		
		ПараметрыСобытия = Новый Структура;
		ПараметрыСобытия.Вставить("Идентификатор", ТекСтрока.Идентификатор);
		ПараметрыСобытия.Вставить("Результат");
		
		ОсновнойМодуль_ОбработатьСлужебнуюКоманду(
			КомандаУдалитьПлагин(),
			ПараметрыСобытия
		);
		
		Результат = ПараметрыСобытия.Результат;
		Если Не Результат.Успешно Тогда
			ВызватьИсключение("При выполнении действия возникла ошибка:" + Символы.ПС + Символы.ПС + Результат.ОписаниеОшибки);
		КонецЕсли;
		
		ОбновитьСписок();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

