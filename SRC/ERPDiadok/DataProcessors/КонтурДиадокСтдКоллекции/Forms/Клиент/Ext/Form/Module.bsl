&НаКлиенте
Функция ФиксированныеДанныеМассив(Данные, ВызыватьИсключение)
	
	Массив = Новый Массив;
	
	Для Каждого Значение Из Данные Цикл
		
		ТипЗначения = ТипЗнч(Значение);
		
		Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("Массив") Тогда
			Массив.Добавить(ФиксированныеДанныеЛок(Значение));
		ИначеЕсли ВызыватьИсключение Тогда
			ПроверкаФиксированностиДанных(Значение);
			Массив.Добавить(Значение);
		Иначе
			Массив.Добавить(Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(Массив);
	
КонецФункции // ФиксированныеДанныеМассив

&НаКлиенте
Функция ФиксированныеДанныеКлючиИЗначения(Данные, ВызыватьИсключение)
	
	ТипДанных = ТипЗнч(Данные);
	
	Если ТипДанных = Тип("Структура") Тогда
		Коллекция = Новый Структура;
	Иначе
		Коллекция = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Данные Цикл
		
		Значение = КлючИЗначение.Значение;
		ТипЗначения = ТипЗнч(Значение);
		
		Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") ИЛИ ТипЗначения = Тип("Массив") Тогда
			Коллекция.Вставить(КлючИЗначение.Ключ, ФиксированныеДанныеЛок(Значение));
		ИначеЕсли ВызыватьИсключение Тогда
			ПроверкаФиксированностиДанных(Значение);
			Коллекция.Вставить(КлючИЗначение.Ключ, Значение);
		Иначе
			Коллекция.Вставить(КлючИЗначение.Ключ, Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТипДанных = Тип("Соответствие") Тогда
		Результат = Новый ФиксированноеСоответствие(Коллекция);
	Иначе
		Результат = Новый ФиксированнаяСтруктура(Коллекция);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ФиксированныеДанныеКлючиИЗначения