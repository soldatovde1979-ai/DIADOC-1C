// БСП

&НаКлиенте
Процедура ПроверкаФиксированностиДанных(Данные, ДанныеВЗначенииФиксированныхТипов = Ложь)
	
	Возврат;
	
КонецПроцедуры // ПроверкаФиксированностиДанных

&НаКлиенте
Функция СкопироватьСтруктуруЛок(СтруктураИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый Структура;
	
	Для Каждого КлючИЗначение Из СтруктураИсточник Цикл
		Результат.Вставить(КлючИЗначение.Ключ, СкопироватьРекурсивноЛок(КлючИЗначение.Значение, ФиксироватьДанные));
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина
		ИЛИ ФиксироватьДанные = Неопределено
		И ТипЗнч(СтруктураИсточник) = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Новый ФиксированнаяСтруктура(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СкопироватьСтруктуруЛок

&НаКлиенте
Функция СкопироватьСоответствиеЛок(СоответствиеИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеИсточник Цикл
		
		Ключ = КлючИЗначение.Ключ;
		Значение = СкопироватьРекурсивноЛок(КлючИЗначение.Значение, ФиксироватьДанные);
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина
		ИЛИ ФиксироватьДанные = Неопределено
		И ТипЗнч(СоответствиеИсточник) = Тип("ФиксированноеСоответствие") Тогда
		
		Результат = Новый ФиксированноеСоответствие(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СкопироватьСоответствиеЛок

&НаКлиенте
Функция СкопироватьМассивЛок(МассивИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из МассивИсточник Цикл
		
		НовыйЭлемент = СкопироватьРекурсивноЛок(Элемент, ФиксироватьДанные);
		Результат.Добавить(НовыйЭлемент);
		
	КонецЦикла;
	
	Если ФиксироватьДанные = Истина
		ИЛИ ФиксироватьДанные = Неопределено
		И ТипЗнч(МассивИсточник) = Тип("ФиксированныйМассив") Тогда
		
		Результат = Новый ФиксированныйМассив(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СкопироватьМассивЛок

&НаКлиенте
Функция СкопироватьСписокЗначенийЛок(СписокИсточник, ФиксироватьДанные = Неопределено)
	
	Результат = Новый СписокЗначений;
	
	Для Каждого ЭлементСписка Из СписокИсточник Цикл
		
		НовыйЭлемент = СкопироватьРекурсивноЛок(ЭлементСписка.Значение, ФиксироватьДанные);
		
		Результат.Добавить(НовыйЭлемент, ЭлементСписка.Представление, ЭлементСписка.Пометка, ЭлементСписка.Картинка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // СкопироватьСписокЗначенийЛок

// СОРТИРОВКИ

&НаКлиенте
Процедура СортироватьМассив(Коллекция, Сравнение)
	
	ТипЗначенияСравнение = ТипЗнч(Сравнение);
	Если ТипЗначенияСравнение = Тип("Строка") Тогда
		СортироватьМассив(Коллекция, РазобратьСтрокуСравнение(Сравнение));
	ИначеЕсли ТипЗначенияСравнение = Тип("НаправлениеСортировки") Тогда
		СортироватьПоЗначениюМассив(Коллекция, Сравнение);
	ИначеЕсли ТипЗначенияСравнение = Тип("Массив") Тогда
		СортироватьПоСвойствамМассив(Коллекция, Сравнение);
	Иначе
		ВызватьИсключение "Ошибка типа: " + Строка(ТипЗначенияСравнение);
	КонецЕсли;
	
КонецПроцедуры // СортироватьМассив

&НаКлиенте
Процедура СортироватьПоСвойствамМассив(Массив, Сравнение)
	
	Размер = Массив.Количество();
	Для Сч = 0 По Сравнение.ВГраница() Цикл
		Элемент = Сравнение[Сравнение.ВГраница() - Сч];
		Для I = 0 По Размер - 1 Цикл
			Для J = 0 По Размер - 1 - I - 1 Цикл
				Если СравнитьКоллекции(Массив[J][Элемент.Поле], Массив[J + 1][Элемент.Поле], Элемент.Направление) > 0 Тогда
					ВременнаяПеременная = Массив[J];
					Массив[J] = Массив[J + 1];
					Массив[J + 1] = ВременнаяПеременная;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры // СортироватьПоСвойствамМассив

&НаКлиенте
Процедура СортироватьПоЗначениюМассив(Массив, Сравнение)
	
	Размер = Массив.Количество();
	Для I = 0 По Размер - 1 Цикл
		Для J = 0 По Размер - 1 - I - 1 Цикл
			Если СравнитьКоллекции(Массив[J], Массив[J + 1], Сравнение) > 0 Тогда
				ВременноеЗначение = Массив[J];
				Массив[J] = Массив[J + 1];
				Массив[J + 1] = ВременноеЗначение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры // СортироватьПоЗначениюМассив

&НаКлиенте
Процедура СортироватьСписокЗначений(СписокЗначений, Сравнение)
	
	ТипЗначенияСравнение = ТипЗнч(Сравнение);
	Если ТипЗначенияСравнение = Тип("НаправлениеСортировки") Тогда
		СписокЗначений.СортироватьПоЗначению(Сравнение);
	Иначе
		ВызватьИсключение "Ошибка типа: " + Строка(ТипЗначенияСравнение);
	КонецЕсли;
	
КонецПроцедуры // СортироватьСписокЗначений

&НаКлиенте
Процедура СортироватьПоСвойствамСписокЗначений(СписокЗначений, Сравнение)
	
	Размер = СписокЗначений.Количество();
	Для Сч = 0 По Сравнение.ВГраница() Цикл
		Элемент = Сравнение[Сравнение.ВГраница() - Сч];
		Для I = 0 По Размер - 1 Цикл
			Для J = 0 По Размер - 1 - I - 1 Цикл
				Если СравнитьКоллекции(СписокЗначений[J].Значение[Элемент.Поле],
						СписокЗначений[J + 1].Значение[Элемент.Поле], Элемент.Направление) > 0 Тогда
					ВременнаяПеременная = СписокЗначений[J];
					СписокЗначений[J] = СписокЗначений[J + 1];
					СписокЗначений[J + 1] = ВременнаяПеременная;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры // СортироватьПоСвойствамСписокЗначений

// СРАВНЕНИЯ

&НаКлиенте
Процедура ЗаполнитьМассивКлючейСравнение(МассивКлючей1, МассивКлючей2, ОтборКлючей, КартаКлючей,
		Коллекция1, Коллекция2, Ключи)
	
	Значение1ТипЗнч = ТипЗнч(Коллекция1);
	Значение2ТипЗнч = ТипЗнч(Коллекция1);
	
	ЗависимыеКлючи = Ложь;
	
	ЗаполнитьОтборКлючей(Значение1ТипЗнч, Значение2ТипЗнч, ЗависимыеКлючи,
		ОтборКлючей, КартаКлючей, Ключи);
	
	Для Каждого КлючИЗначение Из Коллекция1 Цикл
		Если НЕ ЗависимыеКлючи Тогда
			Ключ = ВРег(КлючИЗначение.Ключ);
		Иначе
			Ключ = КлючИЗначение.Ключ;
		КонецЕсли;
		Если ОтборКлючей.Количество() = 0 ИЛИ ОтборКлючей.Найти(Ключ) <> Неопределено Тогда
			МассивКлючей1.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	
	МассивКлючей2 = Новый Массив;
	Для Каждого КлючИЗначение Из Коллекция2 Цикл
		Если НЕ ЗависимыеКлючи Тогда
			Ключ = ВРег(КлючИЗначение.Ключ);
		Иначе
			Ключ = КлючИЗначение.Ключ;
		КонецЕсли;
		Если ОтборКлючей.Количество() = 0 ИЛИ ОтборКлючей.Найти(Ключ) <> Неопределено Тогда
			МассивКлючей2.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьМассивКлючейСравнение

&НаКлиенте
Процедура ЗаполнитьМассивКолонокСравнение(МассивКолонок1, МассивКолонок2, ОтборКолонок, КартаКолонок,
		ТаблицаЗначений1, ТаблицаЗначений2, Колонки)
	
	Если ТипЗнч(Колонки) = Тип("Массив") Тогда
		Для Каждого Элемент Из Колонки Цикл
			ОтборКолонок.Добавить(ВРег(Элемент.Поле));
			КартаКолонок.Вставить(ВРег(Элемент.Поле), Элемент.Направление);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Колонка Из ТаблицаЗначений1.Колонки Цикл
		Если ОтборКолонок.Количество() = 0 ИЛИ ОтборКолонок.Найти(ВРег(Колонка.Имя)) <> Неопределено Тогда
			МассивКолонок1.Добавить(ВРег(Колонка.Имя));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
		Если ОтборКолонок.Количество() = 0 ИЛИ ОтборКолонок.Найти(ВРег(Колонка.Имя)) <> Неопределено Тогда
			МассивКолонок2.Добавить(ВРег(Колонка.Имя));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьМассивКолонокСравнение

&НаКлиенте
Процедура ЗаполнитьОтборКлючей(Значение1ТипЗнч, Значение2ТипЗнч, ЗависимыеКлючи, ОтборКлючей, КартаКлючей, Ключи)
	
	ЗависимыеКлючи = (Значение1ТипЗнч = Тип("Соответствие") ИЛИ Значение1ТипЗнч = Тип("ФиксированноеСоответствие"))
		И (Значение2ТипЗнч = Тип("Соответствие") ИЛИ Значение2ТипЗнч = Тип("ФиксированноеСоответствие"));
	
	Если ТипЗнч(Ключи) = Тип("Массив") Тогда
		Для Каждого Элемент Из Ключи Цикл
			Если НЕ ЗависимыеКлючи Тогда
				Ключ = ВРег(Элемент.Поле);
			Иначе
				Ключ = Элемент.Поле;
			КонецЕсли;
			ОтборКлючей.Добавить(Ключ);
			КартаКлючей.Вставить(Ключ, Элемент.Направление);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьОтборКлючей

&НаКлиенте
Функция СравнитьЗначения(Значение1, Значение2, ОписаниеСравнения = Неопределено)
	
	Если Значение1 = Значение2 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ОписаниеСравнения = НаправлениеСортировки.Убыв Тогда
		Множитель = -1;
	Иначе
		Множитель = 1;
	КонецЕсли;
	
	#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	ОбъектСравнения = Новый СравнениеЗначений;
	Результат = ОбъектСравнения.Сравнить(Значение1, Значение2) * Множитель;
	#Иначе
	Если Значение1 > Значение2 Тогда
		Результат = 1 * Множитель;
	ИначеЕсли Значение1 < Значение2 Тогда
		Результат = -1 * Множитель;
	Иначе
		Результат = 0;
	КонецЕсли;
	#КонецЕсли
	
	Возврат Результат;
	
КонецФункции // СравнитьЗначения

&НаКлиенте
Функция СравнитьМассивы(Массив1, Массив2, Сравнение = Неопределено)
	
	МинимальнаяДлина = Мин(Массив1.Количество(), Массив2.Количество());
	
	Для Индекс = 0 По МинимальнаяДлина - 1 Цикл
		Результат = СравнитьКоллекции(Массив1[Индекс], Массив2[Индекс], Сравнение);
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СравнитьКоллекции(Массив1.Количество(), Массив2.Количество());
	
КонецФункции // СравнитьМассивы

&НаКлиенте
Функция СравнитьКлючиИЗначения(Коллекция1, Коллекция2, Ключи = Неопределено)
	
	МассивКлючей1 = Новый Массив;
	МассивКлючей2 = Новый Массив;
	ОтборКлючей = Новый Массив;
	КартаКлючей = Новый Соответствие;
	
	ЗаполнитьМассивКлючейСравнение(МассивКлючей1, МассивКлючей2, ОтборКлючей, КартаКлючей, Коллекция1, Коллекция2, Ключи);
	
	// т.к. ключи коллекции не упорядочены
	
	СортироватьМассив(МассивКлючей1, НаправлениеСортировки.Возр);
	СортироватьМассив(МассивКлючей2, НаправлениеСортировки.Возр);
	
	Результат = СравнитьКоллекции(МассивКлючей1, МассивКлючей2);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	//
	
	НаправлениеПоУмолчанию = НаправлениеСортировки.Возр;
	Если ТипЗнч(Ключи) = Тип("НаправлениеСортировки") Тогда
		НаправлениеПоУмолчанию = Ключи;
	КонецЕсли;
	
	Для Каждого Ключ Из МассивКлючей1 Цикл
		
		Направление = КартаКлючей.Получить(Ключ);
		Если Направление = Неопределено Тогда
			Направление = НаправлениеПоУмолчанию;
		КонецЕсли;
		
		Результат = СравнитьКоллекции(Коллекция1[Ключ], Коллекция2[Ключ], Направление);
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции // СравнитьКлючиИЗначения

