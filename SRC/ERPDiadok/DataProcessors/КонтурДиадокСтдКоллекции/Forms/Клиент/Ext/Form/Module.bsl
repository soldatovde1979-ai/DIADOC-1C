// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// БСП

// Удаляет значение из массива, если оно в нем есть
//
// Параметры:
//  Массив - Массив - массив, из которого нужно удалить значение;
//  Значение - Значение - значение, которое нужно удалить;
//
&НаКлиенте
Процедура УдалитьЗначениеИзМассиваЛок(Массив, Значение) Экспорт
	
	ИндексЗначения = Массив.Найти(Значение);
	
	Если ИндексЗначения <> Неопределено Тогда
		Массив.Удалить(ИндексЗначения);
	КонецЕсли;
	
КонецПроцедуры // УдалитьЗначениеИзМассиваЛок

// Удаляет все вхождения переданного значения из массива.
//
// Параметры:
//  Массив - Массив - массив, из которого необходимо удалить значение;
//  Значение - Произвольный - удаляемое значение из массива.
//
&НаКлиенте
Процедура УдалитьВсеВхожденияЗначенияИзМассиваЛок(Массив, Значение) Экспорт
	
	КоличествоЭлементовВМассиве = Массив.Количество();
	
	Для НомерЭлемента = 1 По КоличествоЭлементовВМассиве Цикл
		
		ИндексЭлемента = КоличествоЭлементовВМассиве - НомерЭлемента;
		
		Если Массив[ИндексЭлемента] = Значение Тогда
			
			Массив.Удалить(ИндексЭлемента);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // УдалитьВсеВхожденияЗначенияИзМассиваЛок

// Дополняет таблицу значений - приемник данными из таблицы значений - источника.
// Типы ТаблицаЗначений, ДеревоЗначений, ТабличнаяЧасть не доступны на клиенте.
//
// Параметры:
//  ТаблицаИсточник - ТаблицаЗначений
//                  - ДеревоЗначений
//                  - ТабличнаяЧасть
//                  - ДанныеФормыКоллекция - таблица, из которой будут
//                    браться строки для заполнения;
//  ТаблицаПриемник - ТаблицаЗначений
//                  - ДеревоЗначений
//                  - ТабличнаяЧасть
//                  - ДанныеФормыКоллекция - таблица, в которую будут
//                    добавлены строки из таблицы-источника.
//
&НаКлиенте
Процедура ДополнитьТаблицуЛок(ТаблицаИсточник, ТаблицаПриемник) Экспорт
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаТаблицыИсточник);
		
	КонецЦикла;
	
КонецПроцедуры // ДополнитьТаблицуЛок

// Дополняет массив значениями из другого массива
//
// Параметры:
//  МассивПриемник - Массив - массив, в который необходимо добавить значения;
//  МассивИсточник - Массив - массив, из которого нужно взять значения;
//  ТолькоНовые - Булево - (необязательный) Истина, если в приемник
//					нужно добавить только те значения, которых там еще нет;
//
&НаКлиенте
Процедура ДополнитьМассивЛок(МассивПриемник, МассивИсточник, ТолькоНовые = Ложь) Экспорт
	
	Если ТолькоНовые Тогда
		
		ЗначенияПриемника = Новый Соответствие;
		
		Для Каждого Значение Из МассивПриемник Цикл
			ЗначенияПриемника.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			
			Если ЗначенияПриемника[Значение] = Неопределено Тогда
				
				МассивПриемник.Добавить(Значение);
				
				ЗначенияПриемника.Вставить(Значение, Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Значение Из МассивИсточник Цикл
			МассивПриемник.Добавить(Значение);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ДополнитьМассивЛок

// Дополняет структуру значениями из другой структуры.
//
// Параметры:
//   СтруктураПриемник - Структура - коллекция, в которую будут добавляться новые значения.
//   СтруктураИсточник - Структура - коллекция, из которой будут считываться пары Ключ и Значение для заполнения.
//   Заменять - Булево, Неопределено - что делать в местах пересечения ключей источника и приемника:
//                                     Истина - заменять значения приемника (самый быстрый способ),
//                                     Ложь   - не заменять значения приемника (пропускать),
//                                     Неопределено - значение по умолчанию. Бросать исключение
//
&НаКлиенте
Процедура ДополнитьСтруктуруЛок(СтруктураПриемник, СтруктураИсточник, Заменять = Неопределено) Экспорт
	
	Для Каждого Элемент Из СтруктураИсточник Цикл
		
		Если Заменять <> Истина И СтруктураПриемник.Свойство(Элемент.Ключ) Тогда
			
			Если Заменять = Ложь Тогда
				Продолжить;
			Иначе
				ОписаниеИсключения = НСтр("ru = 'Пересечение ключей источника и приемника: ""%1"".'");
				
				ВызватьИсключение СтдКлиентЛок.Стр().ПодставитьПараметрыВСтрокуЛок(ОписаниеИсключения, Элемент.Ключ);
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураПриемник.Вставить(Элемент.Ключ, Элемент.Значение);
		
	КонецЦикла;
	
КонецПроцедуры // ДополнитьСтруктуруЛок

// Дополняет соответствие значениями из другой соответствия.
//
// Параметры:
//   СоответствиеПриемник - Соответствие - коллекция, в которую будут добавляться новые значения.
//   СоответствиеИсточник - Соответствие - коллекция, из которой будут считываться пары Ключ и Значение для заполнения.
//   Заменять - Булево, Неопределено - что делать в местах пересечения ключей источника и приемника:
//                                     Истина - заменять значения приемника (самый быстрый способ),
//                                     Ложь - не заменять значения приемника (пропускать),
//                                     Неопределено - значение по умолчанию. Бросать исключение
//
&НаКлиенте
Процедура ДополнитьСоответствиеЛок(СоответствиеПриемник, СоответствиеИсточник, Заменять = Неопределено) Экспорт
	
	Для Каждого Элемент Из СоответствиеИсточник Цикл
		
		Если Заменять <> Истина И СоответствиеПриемник[Элемент.Ключ] <> Неопределено Тогда
			
			Если Заменять = Ложь Тогда
				Продолжить;
			Иначе
				ОписаниеИсключения = НСтр("ru = 'Пересечение ключей источника и приемника: ""%1"".'");
				
				ВызватьИсключение СтдКлиентЛок.Стр().ПодставитьПараметрыВСтрокуЛок(ОписаниеИсключения, Элемент.Ключ);
			КонецЕсли;
			
		КонецЕсли;
		
		СоответствиеПриемник.Вставить(Элемент.Ключ, Элемент.Значение);
		
	КонецЦикла;
	
КонецПроцедуры // ДополнитьСоответствиеЛок

// Создает полную копию структуры, соответствия, массива, таблицы значений или списка, рекурсивно,
// с учетом типов дочерних элементов. При этом содержимое значений объектных типов
// (СправочникОбъект, ДокументОбъект и т.п.) не копируются, а возвращаются ссылки на исходный объект.
//
// Параметры:
//  Источник - Структура, ФиксированнаяСтруктура - объект, который необходимо скопировать
//           - Соответствие, ФиксированноеСоответствие - объект, который необходимо скопировать
//           - Массив, ФиксированныйМассив - объект, который необходимо скопировать
//           - СписокЗначений - объект, который необходимо скопировать.
//  ФиксироватьДанные - Булево - Истина/Ложь Зафиксировать/снять фиксацию
//                    - Неопределено - Не изменять (По умолчанию)
//
// Возвращаемое значение:
//  - Структура, ФиксированнаяСтруктура - Копия объекта, переданного в параметре Источник
//  - Соответствие, ФиксированноеСоответствие - Копия объекта, переданного в параметре Источник
//  - Массив, ФиксированныйМассив - Копия объекта, переданного в параметре Источник
//  - СписокЗначений - Копия объекта, переданного в параметре Источник
//
&НаКлиенте
Функция СкопироватьРекурсивноЛок(Источник, ФиксироватьДанные = Неопределено) Экспорт
	
	Перем Приемник;
	
	ТипИсточника = ТипЗнч(Источник);
	
	Если ТипИсточника = Тип("Структура")
		ИЛИ ТипИсточника = Тип("ФиксированнаяСтруктура") Тогда
		Приемник = СкопироватьСтруктуруЛок(Источник, ФиксироватьДанные);
	ИначеЕсли ТипИсточника = Тип("Соответствие")
		ИЛИ ТипИсточника = Тип("ФиксированноеСоответствие") Тогда
		Приемник = СкопироватьСоответствиеЛок(Источник, ФиксироватьДанные);
	ИначеЕсли ТипИсточника = Тип("Массив")
		ИЛИ ТипИсточника = Тип("ФиксированныйМассив") Тогда
		Приемник = СкопироватьМассивЛок(Источник, ФиксироватьДанные);
	ИначеЕсли ТипИсточника = Тип("СписокЗначений") Тогда
		Приемник = СкопироватьСписокЗначенийЛок(Источник, ФиксироватьДанные);
	Иначе
		Приемник = Источник;
	КонецЕсли;
	
	Возврат Приемник;
	
КонецФункции // СкопироватьРекурсивноЛок

// Возвращает массив уникальных значений (аналогия множества)
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - массив, который необходимо свернуть;
//
// Возвращаемое значение:
//  Массив, ФиксированныйМассив - свернутый массив
//
&НаКлиенте
Функция СвернутьМассивЛок(Знач Массив) Экспорт
	
	Результат = Новый Массив;
	
	ДополнитьМассивЛок(Результат, Массив, Истина);
	
	Возврат Результат;
	
КонецФункции // СвернутьМассивЛок

// Создает массив и помещает в него переданное значение.
//
// Параметры:
//  Значение - Произвольный - любое значение.
//
// Возвращаемое значение:
//  Массив - массив из одного элемента.
//
&НаКлиенте
Функция ЗначениеВМассивеЛок(Знач Значение) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;
	
КонецФункции // ЗначениеВМассивеЛок

// Возвращает значение свойства структуры или значение по умолчанию,
// если в структуре нет такого свойства.
//
// Параметры:
//  Структура           - Структура    - Структура, которая может содержать вложенные структуры
//  Ключ                - Строка       - Имя ключа структуры
//  ЗначениеПоУмолчанию - Произвольный - возвращается в случае если в структуре
//                                       нет указанного свойства (необязательный)
//
// Возвращаемое значение:
//   Произвольный - Значение свойства структуры или ЗначениеПоУмолчанию,
//                  если в структуре нет такого свойства.
//
&НаКлиенте
Функция СвойствоСтруктурыЛок(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Если Структура = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Результат = ЗначениеПоУмолчанию;
	Если Структура.Свойство(Ключ, Результат) Тогда
		Возврат Результат;
	Иначе
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецФункции // СвойствоСтруктурыЛок

// Фиксирует данные типов Структура, Соответствие, Массив с учетом вложенности.
//
// Параметры:
//  Данные - Структура
//         - Соответствие
//         - Массив - Коллекции, значения которых являются примитивными типами,
//                    хранилищем значения или не могут быть изменены. Поддерживаются типы значений
//                    Булево, Строка, Число, Дата, Неопределено, УникальныйИдентификатор, Null, Тип,
//                    ХранилищеЗначения, ОбщийМодуль, ОбъектМетаданных, ТипЗначенияXDTO, ТипОбъектаXDTO,
//                    ЛюбаяСсылка
//  ВызыватьИсключение - Булево
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, ФиксированноеСоответствие, ФиксированныйМассив - фиксированные данные, аналогичные
//    переданным в параметре Данные.
//
&НаКлиенте
Функция ФиксированныеДанныеЛок(Данные, ВызыватьИсключение = Истина) Экспорт
	
	ТипДанных = ТипЗнч(Данные);
	Если ТипДанных = Тип("Массив") Тогда
		Результат = ФиксированныеДанныеМассив(Данные, ВызыватьИсключение);
	ИначеЕсли ТипДанных = Тип("Структура") ИЛИ ТипДанных = Тип("Соответствие") Тогда
		Результат = ФиксированныеДанныеКлючиИЗначения(Данные, ВызыватьИсключение);
	ИначеЕсли ВызыватьИсключение Тогда
		ПроверкаФиксированностиДанных(Данные);
		Результат = Данные;
	Иначе
		Результат = Данные;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ФиксированныеДанныеЛок

// КОНСТРУКТОРЫ

// Создает структуру на основании переданного источника
//
// Параметры:
//  Источник - Структура, ФиксированнаяСтруктура - структура, копию которой необходимо создать
//
// Возвращаемое значение:
//  Структура - структура, созданная из переданной в параметре Источник
//
&НаКлиенте
Функция Структура(Источник) Экспорт
	
	ТипЗначения = ТипЗнч(Источник);
	Если ТипЗначения = Тип("Структура")
		ИЛИ ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = СтруктураИзСтруктура(Источник);
	Иначе
		ВызватьИсключение "Ошибка типа: " + ТипЗначения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // Структура

// Создает соответствие на основании переданного соответствия
//
// Параметры:
//  СоответствиеИсточник - Соответствие, ФиксированноеСоответствие - соответствие, копию которого необходимо создать;
//
// Возвращаемое значение:
//  Соответствие - соответствие, созданное из переданного в параметре СоответствиеИсточник
//
&НаКлиенте
Функция Соответствие(СоответствиеИсточник) Экспорт
	
	Результат = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СоответствиеИсточник Цикл
		
		Ключ = КлючИЗначение.Ключ;
		Значение = КлючИЗначение.Значение;
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // Соответствие

// МАССИВ

// Удаляет все пустые значения из массива. ЗначениеЗаполнено() = Ложь
//
// Параметры:
//  Массив - Массив - массив, из которого необходимо удалить значение.
//
&НаКлиенте
Процедура УдалитьПустыеЗначенияМассива(Массив) Экспорт
	
	КоличествоЭлементовВМассиве = Массив.Количество();
	
	Для НомерЭлемента = 1 По КоличествоЭлементовВМассиве Цикл
		
		ИндексЭлемента = КоличествоЭлементовВМассиве - НомерЭлемента;
		ПроверяемыйЭлемент = Массив[ИндексЭлемента];
		
		Если НЕ ЗначениеЗаполнено(ПроверяемыйЭлемент) И ПроверяемыйЭлемент <> 0 Тогда
			
			Массив.Удалить(ИндексЭлемента);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // УдалитьПустыеЗначенияМассива

// Ищет в массиве структур по паре ключ-значение,
// возвращает результат поиска в виде массива структур
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ПараметрыОтбора - Структура - ключ - поле структуры, значение - значение, которое надо найти;
//
// Возвращаемое значение:
//  Массив - массив структур удовлетворяющих отбору
//
&НаКлиенте
Функция НайтиСтрокиМассиваСтруктур(МассивСтруктур, ПараметрыОтбора) Экспорт
	
	Свойства = Новый Массив;
	Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
		Свойства.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	ОтборСвойств = СтдКлиентЛок.Стр().СтрСоединитьЛок(Свойства, ",");
	
	Результат = Новый Массив;
	Для Каждого Элемент Из МассивСтруктур Цикл
		Если СравнитьКоллекции(Элемент, ПараметрыОтбора, ОтборСвойств) = 0 Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // НайтиСтрокиМассиваСтруктур

// Выгружает значения поля из массива структур в новый массив
//
// Параметры:
//  МассивСтруктур - Массив - массив содержит структуры;
//  ИмяПоля - Строка - поле, значения которого нужно выгрузить;
//
// Возвращаемое значение:
//  Массив - массив значений из структур
//
&НаКлиенте
Функция ВыгрузитьЗначенияМассиваСтруктур(МассивСтруктур, ИмяПоля) Экспорт
	
	Результат = Новый Массив;
	Для Каждого Элемент Из МассивСтруктур Цикл
		Результат.Добавить(Элемент[ИмяПоля]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ВыгрузитьЗначенияМассиваСтруктур

// ПРОЧЕЕ

// Удаляет строки из таблицы
//
// Параметры:
//  Таблица - ДанныеФормыКоллекция, ДанныеФормыСтруктураСКоллекцией - Таблица
//  ПараметрыОтбора - Структура - Задает условия поиска ключ структуры определяет имя колонки, по которой
//                                будет осуществляться поиск, а значение структуры - искомое значение.
//
&НаКлиенте
Процедура УдалитьСтрокиТаблицы(Таблица, ПараметрыОтбора) Экспорт
	
	Строки = Таблица.НайтиСтроки(ПараметрыОтбора);
	Для Каждого Строка Из Строки Цикл
		Таблица.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры // УдалитьСтрокиТаблицы

// Сортирует переданную коллекцию значений
//
// Параметры:
//  Значение  - Массив, ТаблицаЗначений, СписокЗначений - Коллекция для сортировки
//  Сравнение - Строка - Задается аналогично перечислению колонок метода сортировать ТаблицыЗначений
//            - НаправлениеСортировки - (значение по умолчанию = Возр) при использовании Убыв,
//                                      результат будет инвертирован
//
&НаКлиенте
Процедура СортироватьКоллекцию(Значение, Сравнение = Неопределено) Экспорт
	
	СравнениеТипЗнч = ТипЗнч(Сравнение);
	
	Если СравнениеТипЗнч = Тип("Строка") Тогда
		ОписаниеСравнения = РазобратьСтрокуСравнение(Сравнение);
	ИначеЕсли Сравнение = Неопределено Тогда
		ОписаниеСравнения = НаправлениеСортировки.Возр;
	ИначеЕсли СравнениеТипЗнч = Тип("НаправлениеСортировки") Тогда
		ОписаниеСравнения = Сравнение;
	Иначе
		ВызватьИсключение "Ошибка типа: " + СравнениеТипЗнч;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Массив") Тогда
		СортироватьМассив(Значение, ОписаниеСравнения);
	ИначеЕсли ТипЗначения = Тип("СписокЗначений") Тогда
		СортироватьСписокЗначений(Значение, ОписаниеСравнения);
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // СортироватьКоллекцию

// Возвращает отсортированную копию переданной коллекции
//
// Параметры:
//  Значение  - Массив, ТаблицаЗначений, СписокЗначений - Коллекция для копирования и сортировки
//  Сравнение - Строка - Задается аналогично перечислению колонок метода сортировать ТаблицыЗначений
//            - НаправлениеСортировки - (значение по умолчанию = Возр) при использовании Убыв,
//                                      результат будет инвертирован
//
// Возвращаемое значение:
//  Массив, ТаблицаЗначений, СписокЗначений - Отсортированная копия исходной коллекции
//
&НаКлиенте
Функция СортированнаяКоллекция(Значение, Сравнение = Неопределено) Экспорт
	
	Результат = СкопироватьРекурсивноЛок(Значение, Ложь);
	
	СортироватьКоллекцию(Результат, Сравнение);
	
	Возврат Результат;
	
КонецФункции // СортированнаяКоллекция

// Сравнивает два значения
//
// Параметры:
//  Значение1 - Произвольный - Коллекция или иное значение
//  Значение2 - Произвольный - Коллекция или иное значение
//  Сравнение - Строка - Задается аналогично перечислению колонок метода сортировать ТаблицыЗначений
//            - НаправлениеСортировки - (значение по умолчанию = Возр) при использовании Убыв,
//                                      результат будет инвертирован
//
// Возвращаемое значение:
//  Число - Результат < 0 - первое значение меньше второго.
//          Результат > 0 - первое значение больше второго.
//          Результат = 0 - первое значение равно второму
//
&НаКлиенте
Функция СравнитьКоллекции(Значение1, Значение2, Сравнение = Неопределено) Экспорт
	
	СравнениеТипЗнч = ТипЗнч(Сравнение);
	
	Если СравнениеТипЗнч = Тип("Строка") Тогда
		ОписаниеСравнения = РазобратьСтрокуСравнение(Сравнение);
	ИначеЕсли Сравнение = Неопределено Тогда
		ОписаниеСравнения = НаправлениеСортировки.Возр;
	ИначеЕсли СравнениеТипЗнч = Тип("НаправлениеСортировки") Тогда
		ОписаниеСравнения = Сравнение;
	Иначе
		ВызватьИсключение "Ошибка типа: " + СравнениеТипЗнч;
	КонецЕсли;
	
	Значение1ТипЗнч = ТипЗнч(Значение1);
	Значение2ТипЗнч = ТипЗнч(Значение2);
	
	Если СравнениеМассивовЛок(Значение1ТипЗнч, Значение2ТипЗнч) Тогда
		Результат = СравнитьМассивы(Значение1, Значение2, ОписаниеСравнения);
	ИначеЕсли СравнениеКлючейИЗначений(Значение1ТипЗнч, Значение2ТипЗнч) Тогда
		Результат = СравнитьКлючиИЗначения(Значение1, Значение2, ОписаниеСравнения);
	ИначеЕсли Значение1ТипЗнч = Тип("СписокЗначений") И Значение2ТипЗнч = Тип("СписокЗначений") Тогда
		Результат = СравнитьМассивы(Значение1.ВыгрузитьЗначения(), Значение2.ВыгрузитьЗначения(), ОписаниеСравнения);
	Иначе
		Результат = СравнитьЗначения(Значение1, Значение2, ОписаниеСравнения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // СравнитьКоллекции

