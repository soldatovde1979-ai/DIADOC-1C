			ИЛИ Значение2ТипЗнч = Тип("ФиксированнаяСтруктура")
			ИЛИ Значение2ТипЗнч = Тип("Соответствие")
			ИЛИ Значение2ТипЗнч = Тип("ФиксированноеСоответствие"));
	
