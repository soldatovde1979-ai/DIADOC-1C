&НаКлиенте
Функция РазобратьСтрокуСравнение(Строка)
	
	КартаНаправлений = Новый Соответствие;
	КартаНаправлений.Вставить("ВОЗР", НаправлениеСортировки.Возр);
	КартаНаправлений.Вставить("УБЫВ", НаправлениеСортировки.Убыв);
	КартаНаправлений.Вставить("ASK", НаправлениеСортировки.Возр);
	КартаНаправлений.Вставить("DESC", НаправлениеСортировки.Убыв);
	КартаНаправлений.Вставить("", НаправлениеСортировки.Возр);
	
	ПростоНаправление = КартаНаправлений.Получить(ВРЕГ(Строка));
	Если ПростоНаправление <> Неопределено Тогда
		Возврат ПростоНаправление;
	КонецЕсли;
	
	ПеречислениеПолей = СтдКлиентЛок.Стр().СтрРазделитьЛок(Строка, ",");
	Если НЕ ПеречислениеПолей.Количество() Тогда
		ВызватьИсключение "Ошибка значения: " + Строка;
	КонецЕсли;
	
	Сравнение = Новый Массив;
	Для Каждого Поле Из ПеречислениеПолей Цикл
		ПолеСортировки = Новый Структура("Поле,Направление", Неопределено, НаправлениеСортировки.Возр);
		ИмяПоляНаправление = СтдКлиентЛок.Стр().СтрРазделитьЛок(Поле, " ", Ложь);
		Если ИмяПоляНаправление.Количество() > 0 Тогда
			ПолеСортировки.Поле = СокрЛП(ИмяПоляНаправление[0]);
		КонецЕсли;
		Если ИмяПоляНаправление.Количество() > 1 Тогда
			Направление = КартаНаправлений.Получить(ВРЕГ(СокрЛП(ИмяПоляНаправление[1])));
			Если Направление <> Неопределено Тогда
				ПолеСортировки.Направление = Направление;
			КонецЕсли;
		КонецЕсли;
		Сравнение.Добавить(ПолеСортировки);
	КонецЦикла;
	
	Возврат Сравнение;
	
КонецФункции // РазобратьСтрокуСравнение

&НаКлиенте
Функция СобратьСтрокуСравнение(Сравнение)
	
	МассивСтрок = Новый Массив;
	
	Для Каждого Элемент Из Сравнение Цикл
		ПолеСравнения = СокрЛП(Элемент.Поле + " " + Строка(Элемент.Направление));
		МассивСтрок.Добавить(ПолеСравнения);
	КонецЦикла;
	
	Возврат СтдКлиентЛок.Стр().СтрСоединитьЛок(МассивСтрок, ",");
	
