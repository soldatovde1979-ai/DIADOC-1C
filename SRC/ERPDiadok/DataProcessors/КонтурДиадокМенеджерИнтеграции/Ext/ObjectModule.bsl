// Добавляет значения ИнфПолФХЖ1 в соответствии с требованиями
// системы маркировки "Честный знак" для алкогольной продукции
// 
// Параметры:
//  Контент970 - Структура - Utd970SellerContent.
//
Процедура УПД970_ДобавитьИнфПолФХЖ1(Контент970)
	
	ВидыТоваровДокумента = Контент970.СлужебнаяИнформация.ContentsDocumentProductsType;
	
	Если ВидыТоваровДокумента.ContainsAlcoholeProducts Тогда
		
		ДанныеГрузоотправителя = Контент970.Sellers[0];
		Если НЕ Контент970.Shippers[0].SameAsSeller Тогда
			ДанныеГрузоотправителя = Контент970.Shippers[0].OrganizationInfo;
		КонецЕсли;
		ДанныеГрузополучателя = Контент970.Consignees[0];
		
		ЗначениеПоУмолчаниюДефис = "-";
		
		Если ДанныеГрузоотправителя.Type = "IndividualEntity" Тогда
			
			Продавец_ФиасИД = ФиасИДУчастникаДокументооборота(ДанныеГрузоотправителя);
			ДобавитьAdditionalInfoItem(Контент970, "Продавец_ФиасИД", Продавец_ФиасИД);
			
		КонецЕсли;
		
		Если ДанныеГрузополучателя.Type = "IndividualEntity" Тогда
			
			Покупатель_ФиасИД = ФиасИДУчастникаДокументооборота(ДанныеГрузополучателя);
			ДобавитьAdditionalInfoItem(Контент970, "Покупатель_ФиасИД", Покупатель_ФиасИД);
			
		КонецЕсли;
		
		ДобавитьAdditionalInfoItem(Контент970, "НомерПеревозДок", ЗначениеПоУмолчаниюДефис);
		ДобавитьAdditionalInfoItem(Контент970, "ДатаПеревозДок", ЗначениеПоУмолчаниюДефис);
		ДобавитьAdditionalInfoItem(Контент970, "РегНомер", ЗначениеПоУмолчаниюДефис);
		ДобавитьAdditionalInfoItem(Контент970, "НомерПеревозЭлДок", ЗначениеПоУмолчаниюДефис);
		
	КонецЕсли;
	
КонецПроцедуры

// Формирует титул продавца для счета на оплату в формате ФНС 29@
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - основание электронного счета
// 
// Возвращаемое значение:
//  Структура - см. тип ProformaInvoice29SellerContent
//
Функция Счет29_КонтентТитулаПродавца(Знач СсылкаНаОбъект)
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Ошибка = "ФНС29_СчетНаОплату: Не заполнено значение параметра 'СсылкаНаОбъект' (Тип = '%1')";
		Ошибка = СтрЗаменить(Ошибка, "%1", Строка(ТипЗнч(СсылкаНаОбъект)));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	// BSLLS:SetPrivilegedMode-off
	УстановитьПривилегированныйРежим(Истина);
	// BSLLS:SetPrivilegedMode-on
	
	Контент = ИнтеграционныйМодуль.СчетФНС29(СсылкаНаОбъект);
	
	Возврат Контент;
	
КонецФункции

Функция ФиасИДУчастникаДокументооборота(ExtendedOrganizationInfo)
	
	Результат = "-";
	
	Если ЕстьАдресГАРУчастникаДокументооборота(ExtendedOrganizationInfo) Тогда
		Результат = ExtendedOrganizationInfo.Address.AddressSAR.ID;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьАдресГАРУчастникаДокументооборота(ExtendedOrganizationInfo)
	
	Результат = Ложь;
	
	ЕстьAddressInfo = ЗначениеЗаполнено(ExtendedOrganizationInfo)
		И ЗначениеЗаполнено(ExtendedOrganizationInfo.Address);
	
	Если ЕстьAddressInfo Тогда
		Результат = (ExtendedOrganizationInfo.Address.Type = "AddressSAR");
	КонецЕсли;
	
	Возврат Результат;
	
