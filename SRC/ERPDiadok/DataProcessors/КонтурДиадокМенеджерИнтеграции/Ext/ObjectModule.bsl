Функция ЖурналРегистрации_ИдентификаторСобытия(ИмяСобытия)
	
	Подстроки = Новый Массив;
	Подстроки.Добавить(ЖурналРегистрации_ИдентификаторПродукта());
	Подстроки.Добавить(ЖурналРегистрации_ИмяМодуля());
	Подстроки.Добавить(ИмяСобытия);
	
	Разделитель = ".";
	
	Результат = Общее_СоединитьСтроку(Подстроки, Разделитель);
	
	Возврат Результат;
	
