// Типовой обработчик события "ПолучитьЗаполненныйОбъектДокумента1С"
//
// Параметры:
//  Документ - Структура - электронный документ (см. Контракт_Документ)
//  ИдентификаторОперации - Строка, Неопределено - идентификатор операции по созданию учетного
//                          документа (см. Ядро.Документы_СписокТиповДокументовДляСоздания)
//  ДополнительныеПараметрыОбработчика - Структура, Неопределено - дополнительные параметры обработчика события
//  ПараметрыСоздания - Структура - (Необязательный) параметры создания
//									(см. ДополнительныеПараметрыСозданияУчетногоДокумента)
//
// Возвращаемое значение:
//  Структура:
//    * ОсновнойОбъект - ДокументОбъект, СправочникОбъект, Неопределено - заполненный объект ИБ
//						(Неопределено, если есть ошибки)
//    * ОписаниеОшибки - Строка - текст ошибки создания объекта
//
Функция ПолучитьЗаполненныйОбъектДокумента1С(
		Документ,
		ИдентификаторОперации,
		ДополнительныеПараметрыОбработчика,
		ПараметрыСоздания = Неопределено
	) Экспорт
	
	ИмяСобытия = "ПолучитьЗаполненныйОбъектДокумента1С";
	
	ИсполняемыеПараметры = ДополнительныеПараметрыСозданияУчетногоДокумента();
	Если ЗначениеЗаполнено(ПараметрыСоздания) Тогда
		ЗаполнитьЗначенияСвойств(ИсполняемыеПараметры, ПараметрыСоздания);
	КонецЕсли;
	
	ПараметрыИМ = Новый Структура;
	ПараметрыИМ.Вставить("Документ", Документ);
	ПараметрыИМ.Вставить("ИдентификаторОперации", ИдентификаторОперации);
	ПараметрыИМ.Вставить("ДополнительныеПараметры", ДополнительныеПараметрыОбработчика);
	ПараметрыИМ.Вставить("СоздаватьСчетаФактуры", ИсполняемыеПараметры.СоздаватьСчетаФактуры);
	ПараметрыИМ.Вставить("ИспользоватьДатуЭлектронногоДокумента", ИсполняемыеПараметры.ИспользоватьДатуЭлектронногоДокумента);
	ПараметрыИМ.Вставить("ОтключитьПроверкуСопоставленияНоменклатуры", ИсполняемыеПараметры.ОтключитьПроверкуСопоставленияНоменклатуры);
	
	Результат = ИнтеграционныйМодуль.ОбработатьСобытие(
			ИмяСобытия,
			ПараметрыИМ
		);
	
	Возврат Результат;
	
КонецФункции

// Типовой обработчик события "ПолучитьТаблицуИспользуемыхПакетов"
//
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//  * ID - Строка - идентификатор вида пакета
//  * Наименование - Строка - пользовательское представление вида пакета
//  * СоставПакета - Строка - идентификаторы видов документов (через запятую)
//  * КатегорияПакета - Строка - идентификатор категории пакетов
//  * НаименованиеКатегории - Строка - пользовательское представление категории пакетов
//  * Шаблон - Булево - Истина, если пакет является шаблоном
//  * ВнутреннийДО - Булево - Истина, если пакет используется для внутреннего документооборота
//  * БазовыйВидПакета - Строка - Идентификатор вида пакета, который является основным для текущего вида.
//                                Заполняется для пакетов без категории.
//
Функция ПоставляемыеВидыПакетов() Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ID", ТипСтрока, "Идентификатор");
	Результат.Колонки.Добавить("Наименование", ТипСтрока, "Представление");
	Результат.Колонки.Добавить("СоставПакета", ТипСтрока, "Состав пакета");
	Результат.Колонки.Добавить("КатегорияПакета", ТипСтрока, "Идентификатор категории");
	Результат.Колонки.Добавить("НаименованиеКатегории", ТипСтрока, "Представление категории");
	Результат.Колонки.Добавить("Шаблон", ТипБулево, "Это шаблон");
	Результат.Колонки.Добавить("ВнутреннийДО", ТипБулево, "Это внутренний ДО");
	Результат.Колонки.Добавить("БазовыйВидПакета", ТипСтрока, "Базовый вид пакета");
	
	ИнтеграционныйМодуль.ЗаполнитьСписокПоставляемыхПакетов(Результат);
	
	Возврат Результат;
	
КонецФункции

// Типовой обработчик события "ПолучитьТаблицуИспользуемыхВидовДокументов"
// 
// Возвращаемое значение:
//  ТаблицаЗначений - содержит колонки:
//    * ID - Строка - идентификатор вида документа
//    * Наименование - Строка - пользовательское представление вида документа
//    * ТипДокументаAPI - Строка - идентификатор типа документа (TypeNamedId)
//    * ТипКонтентаAPI - Строка - идентификатор формата вложения (FormatVersion)
//    * ФункцияДокументаAPI - Строка - идентификатор функции документа (пустая строка для значения "default")
//    * БазовыйВидДокумента - Строка - идентификатор базового вида документа
//
Функция ПоставляемыеВидыДокументов() Экспорт
	
	ИмяСобытия = "ПолучитьТаблицуИспользуемыхВидовДокументов";
	ПараметрыСобытия = Новый Структура;
	
	Результат = ИнтеграционныйМодуль.ОбработатьСобытие(ИмяСобытия, ПараметрыСобытия);
	
	Возврат Результат;
	
КонецФункции

