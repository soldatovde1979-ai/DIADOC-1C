// Получает сведения для заполнения меты неформализованного счета на оплату
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - учетный документ (основание электронного счета на оплату)
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - мета счета на оплату:
//    * Дата - Дата - дата электронного документа
//    * Номер - Строка - номер электронного документа
//    * Сумма - Число - Сумма электронного документа (только для счетов на оплату)
//    * СуммаНДС - Число - Сумма НДС электронного документа (только для счетов на оплату)
//    * ДокументБезНДС - Булево - Истина, если документ без НДС (только для счетов на оплату)
//    * ИмяФайлаВложения - Строка - Имя файла документа-вложения
//
Функция СчетаНаОплату_Метаданные(СсылкаНаОбъект) Экспорт
	
	Данные = Новый Структура;
	Данные.Вставить("Дата", Дата(1, 1, 1));
	Данные.Вставить("Номер", "");
	Данные.Вставить("Сумма", 0);
	Данные.Вставить("СуммаНДС", 0);
	Данные.Вставить("ДокументБезНДС", Ложь);
	Данные.Вставить("ИмяФайлаВложения", "");
	Данные.Вставить("КодВалюты", "");
	
	Данные.Дата = СсылкаНаОбъект.Дата;
	Данные.Номер = ПредставлениеНомераДокументаУчета(СсылкаНаОбъект);
	
	ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СсылкаНаОбъект, Данные);
	
	Данные.ИмяФайлаВложения = ИмяФайлаВложенияPDF(
		"Счет",
		Данные.Номер,
		Данные.Дата
	);
	
	Результат = ФиксированныеДанные(Данные);
	
	Возврат Результат;
	
КонецФункции

// Формирует внутреннее представление счета на оплату
//
// Параметры:
//  ОснованиеЭлектронногоСчета - ЛюбаяСсылка - основание электронного счета
// 
// Возвращаемое значение:
//  Структура - представление счета на оплату:
//    * Шапка - Структура - поля шапки (см. Новый_ШапкаСчетаНаОплату)
//    * ТабличнаяЧасть - ТаблицаЗначений - товарная часть (см. Новый_ТабличнаяЧастьСчетаНаОплату)
//
Функция СчетаНаОплату_Данные(ОснованиеЭлектронногоСчета) Экспорт
	
	Шапка = Новый_ШапкаСчетаНаОплату();
	ТабличнаяЧасть = Новый_ТабличнаяЧастьСчетаНаОплату();
	
	ИнтеграционныйМодуль.СчетаНаОплату_ЗаполнитьДанные(Шапка, ТабличнаяЧасть, ОснованиеЭлектронногоСчета);
	
	Модель = Новый Структура;
	Модель.Вставить("Шапка", Шапка);
	Модель.Вставить("ТабличнаяЧасть", ТабличнаяЧасть);
	
	Результат = ФиксированныеДанные(Модель);
	
	Возврат Результат;
	
КонецФункции

