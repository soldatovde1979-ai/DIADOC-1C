// Формирует протоструктуру для отправки ответного титула электронного документа в заданном формате.
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ТипКонтента	 - Структура - содержит свойства:
//    * ИмяТипа			 - Строка - имя типа документа (typeNameId);
//    * ФункцияДокумента - Строка - функция документа (Function);
//    * ВерсияФормата	 - Строка - версия формата контента (Version);
//  ДополнительныеПараметры - Структура - см. ДополнительныеПараметрыПолученияКонтента;
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентОтветногоТитула(СсылкаНаДокумент, ТипКонтента, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтентаОтветногоТитула();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	Если НРег(ТипКонтента) = НРег("reconciliationact405") Тогда
		
		Результат = КонтентФормализованногоАктаСверкиТитулПолучателя(СсылкаНаДокумент, ПараметрыФормирования);
		
	Иначе
		
		ТекстОшибки = ПараметрыВСтроку(НСтр("ru = 'Тип контента не поддерживается!
			|Тип контента: %1'")
			, ТипКонтента);
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации()
			, УровеньЖурналаРегистрации.Ошибка
			, СсылкаНаДокумент.Метаданные()
			, СсылкаНаДокумент
			, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует протоструктуру для отправки титула отправителя электронного документа в заданном формате.
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ФорматЭД - Структура - описание типа электронного документа (см. Контракт_ФорматЭлектронногоДокумента);
//  ДополнительныеПараметры - Структура - см. ДополнительныеПараметрыПолученияКонтента.
// 
// Возвращаемое значение:
//  Структура.
//
Функция КонтентТитулаОтправителя(СсылкаНаОбъект, ФорматЭД, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Ошибка = "КонтентТитулаОтправителя: Не заполнено значение параметра ""СсылкаНаОбъект"" (Тип = %1)";
		Ошибка = СтрЗаменить(Ошибка, "%1", Строка(ТипЗнч(СсылкаНаОбъект)));
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	ПараметрыФормирования = ДополнительныеПараметрыПолученияКонтентаОтветногоТитула();
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыФормирования, ДополнительныеПараметры);
	КонецЕсли;
	
	ИмяТипа = ФорматЭД.ИмяТипа;
	ВерсияФорматаНРег = НРег(ФорматЭД.ВерсияФормата);
	
	Если НРег(ИмяТипа) = НРег("ReconciliationAct") Тогда
		
		Результат = КонтентФормализованногоАктаСверкиТитулОтправителя(СсылкаНаОбъект, ПараметрыФормирования);
		
	ИначеЕсли ВерсияФорматаНРег = "utd970" Тогда
		
		Результат = УПД970_КонтентТитулаПродавца(СсылкаНаОбъект, ФорматЭД.ФункцияДокумента, ДополнительныеПараметры);
		
	ИначеЕсли ВерсияФорматаНРег = "proformainvoice29" Тогда
		
		Результат = Счет29_КонтентТитулаПродавца(СсылкаНаОбъект);
		
	Иначе
		
		Если Не ТиповойМодульПодключен() Тогда
			ЛогироватьТиповойМодульНеПодключен("КонтентФормализованногоДокумента");
			Возврат Новый Структура;
		КонецЕсли;
		
		Результат = ТиповойМодуль.КонтентФормализованногоДокумента(
			СсылкаНаОбъект,
			ФорматЭД,
			ДополнительныеПараметры
		);
		
		Если СтрНачинаетсяСЛок(ВерсияФорматаНРег, "utd820") Тогда
			УПД820_ПроверитьИсправитьСтавкиНДС(Результат);
		ИначеЕсли СтрНачинаетсяСЛок(ВерсияФорматаНРег, "ucd") Тогда
			УКД736_ПроверитьИсправитьСтавкиНДС(Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Формирует стандартную печатную форму счета на оплату.
// Если для указанного документа в конфигурации не реализована печатная форма, будет вызвано исключение
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - учетный документ (основание электронного счета на оплату)
