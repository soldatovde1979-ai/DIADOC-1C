//
Процедура УПД970_ОкруглитьСтТовБезНДСПрослеж(Контент970)
	
	ДатаФормата5_03 = Дата("20250122");
	
	Точность = 0;
	Если ТекущаяУниверсальнаяДата() + 3 * 60 * 60 >= ДатаФормата5_03 Тогда
		Точность = 2;
	КонецЕсли;
	
	Для Каждого Item Из Контент970.Table.Items Цикл
		
		Для Каждого ItemTracingInfo Из Item.ItemTracingInfos Цикл
		
			ItemTracingInfo.SumWithoutVat = Окр(ItemTracingInfo.SumWithoutVat, Точность);
		
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

