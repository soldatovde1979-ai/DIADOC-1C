// Возвращает значение реквизитов номер и дата документа учета
//
// Параметры:
//  Документ		 - Структура - см. Контракт_Документ
//  СсылкаНаОбъект	 - ДокументСсылка - Ссылка на документ учета
// 
// Возвращаемое значение:
// РеквизитыДокументаУчета - Структура - Коллекция в которой находятся реквизиты и их соответствия в случае отсутствия ИМ возвращает Неопределено
// 	- Номер - Строка - номер учетного документа
// 	- Дата - Дата - дата учетного документа
//
Функция ПолучитьРеквизитыДокументаУчета_НомерДата(СсылкаНаОбъект) Экспорт
	
	СоответствиеРеквизитов = СоответствиеРеквизитовПоУмолчанию();
	
	ИнтеграционныйМодуль.ПриПолученииИменРеквизитовДокументаУчета_НомерДата(СоответствиеРеквизитов, СсылкаНаОбъект);
	
	Результат = ЗаполненныеРеквизитыДокументаУчета(
			СоответствиеРеквизитов,
			СсылкаНаОбъект
		);
	
	Возврат Результат;
	
КонецФункции

// Заполняет значение реквизитов номер и дата документа учета
//
// Параметры:
//  СсылкаНаОбъект	 	- ДокументОбъект - Объект документа учета
//  Номер	 			- Строка - Номер документа учета для заполнения
//  Дата	 			- Дата - Дата документа учета для заполнения
//
Процедура ЗаполнитьРеквизитыДокументаУчета_НомерДата(СсылкаНаОбъект, Номер, Дата) Экспорт
	
	СоответствиеРеквизитов = СоответствиеРеквизитовПоУмолчанию();
	
	ИнтеграционныйМодуль.ПриПолученииИменРеквизитовДокументаУчета_НомерДата(СоответствиеРеквизитов, СсылкаНаОбъект);
	
	ИмяРеквизитаНомер = СоответствиеРеквизитов.Номер;
	ИмяРеквизитаДата = СоответствиеРеквизитов.Дата;

	Если Не ЕстьРеквизитыНомерИДатаВУчетномДокументе(СоответствиеРеквизитов, СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить(ИмяРеквизитаНомер, Номер);
	СтруктураЗаполнения.Вставить(ИмяРеквизитаДата, Дата);
	
	ЗаполнитьЗначенияСвойств(СсылкаНаОбъект, СтруктураЗаполнения);
	
КонецПроцедуры

// Значения реквизитов документов учета организация контрагент
//
// Параметры:
//  КоллекцияДокументов - Массив - Коллекция документов по которым нужно получить реквизиты Организации и Контрагента
// 
// Возвращаемое значение:
//  Соотвествие - Соответствие в котором ключом является сам документ а в значении структура ревизитов (Организация, Контрагент)
//
Функция ЗначенияРеквизитовДокументовУчета(КоллекцияДокументов) Экспорт
	
	Результат = Новый Соответствие;
	
	ДокументыПоТипам = Новый Соответствие;
	Для Каждого ДокументУчета Из КоллекцияДокументов Цикл
		
		Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипДокумента = ТипЗнч(ДокументУчета);
		Если ДокументыПоТипам.Получить(ТипДокумента) = Неопределено Тогда
			ДокументыПоТипам.Вставить(ТипДокумента, Новый Массив);
		КонецЕсли;
		
		ДокументыПоТипам[ТипДокумента].Добавить(ДокументУчета);
		
	КонецЦикла;
	
	Для Каждого Элемент Из ДокументыПоТипам Цикл
		
		ОбъектМД = Метаданные.НайтиПоТипу(Элемент.Ключ);
		Если Не ПравоДоступа("Чтение", ОбъектМД) Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатФункции = ИнтеграционныйМодуль.ЗначенияРеквизитовДокументовУчета_ОрганизацияКонтрагент(Элемент.Значение);
		Общее_ДополнитьСоответствие(Результат, РезультатФункции);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// см. ИнтеграционныйМодуль.СчетаНаОплату_СвязанныеДокументыПоКритериюОтбора()
