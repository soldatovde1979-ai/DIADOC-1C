//{		СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Дополняет соответствие значениями из другого соответствия.
//
// Параметры:
//   Приемник - Соответствие - коллекция, в которую будут добавляться новые значения.
//   Источник - Соответствие - коллекция, из которой будут считываться пары Ключ и Значение для заполнения.
//   Заменять - Булево, Неопределено - Что делать в местах пересечения ключей источника и приемника:
//                                       Истина - Заменять значения приемника (самый быстрый способ),
//                                       Ложь   - Не заменять значения приемника (пропускать),
//                                       Неопределено - Значение по умолчанию. Бросать исключение.
//
Процедура Общее_ДополнитьСоответствие(Приемник, Источник, Заменять = Неопределено)
	
	Для Каждого Элемент Из Источник Цикл
		Если Заменять <> Истина И Приемник[Элемент.Ключ] <> Неопределено Тогда
			Если Заменять = Ложь Тогда
				Продолжить;
			Иначе
				ВызватьИсключение ПараметрыВСтроку(НСтр("ru = 'Пересечение ключей источника и приемника: ""%1"".'"), "%1", Элемент.Ключ);
			КонецЕсли
		КонецЕсли;
		Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Соединяет массив переданных строк в одну строку с указанным разделителем.
// По аналогии с глобальным методом СтрСоединить, добавленным в платформу версии 8.3.6.
// ВАЖНО: В результирующую строку добавляются только непустые значения!
// Платформенный метод СтрСоединить объединяет строки безусловно.
// Нужно это учитывать, если в качестве разделителя задана непустая строка.
// 
// Параметры:
//  Строки - Массив, ФиксированныйМассив - коллекция объединяемых строк.
//  Разделитель - Строка - Строка, которая будет вставлена между объединяемыми строками.
//                         Если параметр не задан, строки будут объединены слитно друг с другом.
//
// Возвращаемое значение:
//   Строка - строка, содержащая соединенные исходные строки с разделителем между ними.
//
// Пример:
//   
//   Строки = Новый Массив;
//   Строки.Добавить("Элемент0");
//   Строки.Добавить("");
//   Строки.Добавить("Элемент2");
//   
//   СоединитьСтроку(Строки, "#") = "Элемент0#Элемент2"
//   СтрСоединить(Строки, "#") = "Элемент0##Элемент2"
//   СоединитьСтроку(Строки, "") = СтрСоединить(Строки, "") = "Элемент0Элемент2"
//
Функция Общее_СоединитьСтроку(Строки, Знач Разделитель = "")
	
	Результат = "";
	ТекРазделитель = "";
	
	Для Каждого Строка Из Строки Цикл
		
		Если Не ЗначениеЗаполнено(Строка) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + ТекРазделитель + Строка;
		ТекРазделитель = Разделитель;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, заканчивается ли строка указанной подстрокой.
//
// Параметры:
//  Строка - Строка - Проверяемая строка
//  СтрокаПоиска - Строка - Искомое окончание строки
// 
// Возвращаемое значение:
//  Булево - Истина, если строка зкаканчивается указанной подстрокой
//
Функция СтрЗаканчиваетсяНаЛок(Знач Строка, Знач СтрокаПоиска)
	
	Результат = (Прав(Строка, СтрДлина(СтрокаПоиска)) = СтрокаПоиска);
	Возврат Результат;
	
КонецФункции

// Определяет, что строка начинается с указанной подстроки. Определение выполняется с учетом регистра, аналогично функции Найти
//
// Параметры:
//  Строка - Строка - Строка, начало которой проверяется на совпадение с подстрокой поиска
//  СтрокаПоиска - Строка - Строка, содержащая предполагаемое начало строки
//
// Возвращаемое значение:
//  Булево - Истина, начинается с указанной подстроки.
//
Функция СтрНачинаетсяСЛок(Знач Строка, Знач СтрокаПоиска)
	
	Результат = (Лев(Строка, СтрДлина(СтрокаПоиска)) = СтрокаПоиска);
	Возврат Результат;
	
КонецФункции

// Фиксирует Данные типов Структура, Соответствие, Массив с учетом вложенности.
//
// BSLLS:TooManyReturns-off
// BSLLS:CognitiveComplexity-off
// BSLLS:CyclomaticComplexity-off
// BSLLS:IfElseIfEndsWithElse-off
// BSLLS:IfConditionComplexity-off
// BSLLS:DuplicateStringLiteral-off
//
// Параметры:
//  Данные - Структура
//         - Соответствие
//         - Массив - коллекции, значения которых являются примитивными типами,
//           хранилищем значения или не могут быть изменены. Поддерживаются типы значений:
//           Булево, Строка, Число, Дата, Неопределено, УникальныйИдентификатор, Null, Тип,
//           ХранилищеЗначения, ОбщийМодуль, ОбъектМетаданных, ТипЗначенияXDTO, ТипОбъектаXDTO,
//           ЛюбаяСсылка.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, ФиксированноеСоответствие, ФиксированныйМассив - фиксированные данные, аналогичные
//    переданным в параметре Данные.
// 
Функция ФиксированныеДанные(Данные)
	
	Если ТипЗнч(Данные) = Тип("Массив")
		Или ТипЗнч(Данные) = Тип("ФиксированныйМассив") Тогда
		Массив = Новый Массив;
		
		Для Каждого Значение Из Данные Цикл
			
			Если ТипЗнч(Значение) = Тип("Структура")
				Или ТипЗнч(Значение) = Тип("Соответствие")
				Или ТипЗнч(Значение) = Тип("Массив")
				Или ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
				
				Массив.Добавить(ФиксированныеДанные(Значение));
				
			Иначе
				Массив.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Новый ФиксированныйМассив(Массив);
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Структура")
		Или ТипЗнч(Данные) = Тип("Соответствие") Тогда
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Коллекция = Новый Структура;
		Иначе
			Коллекция = Новый Соответствие;
		КонецЕсли;
		
		Для Каждого КлючИЗначение Из Данные Цикл
			Значение = КлючИЗначение.Значение;
			
			Если ТипЗнч(Значение) = Тип("Структура")
			 ИЛИ ТипЗнч(Значение) = Тип("Соответствие")
			 ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
				
				Коллекция.Вставить(
					КлючИЗначение.Ключ, ФиксированныеДанные(Значение));
			Иначе
				Коллекция.Вставить(КлючИЗначение.Ключ, Значение);
			КонецЕсли;
		КонецЦикла;
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Возврат Новый ФиксированнаяСтруктура(Коллекция);
		Иначе
			Возврат Новый ФиксированноеСоответствие(Коллекция);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Данные;
	
	// BSLLS:TooManyReturns-on
	// BSLLS:CognitiveComplexity-on
	// BSLLS:CyclomaticComplexity-on
	// BSLLS:IfElseIfEndsWithElse-on
	// BSLLS:IfConditionComplexity-on
	// BSLLS:DuplicateStringLiteral-on
	
КонецФункции // ФиксированныеДанные

// Формирует структуру с данными, которые необходимы для визуализации ПФ счета на оплату.
// Табличный документ формируется типовым механизмом конфигурации.
//
// Параметры:
//  СчетНаОплату - ДокументСсылка	- документ, на основании которого формируем печатную форму
//
// Возвращаемое значение:
//   Структура - см. НовыйРезультатВизуализацииСчетаНаОплату
//
Функция РезультатВизуализацииСчетаНаОплатуСредствамиКонфигурации(СчетНаОплату)
	
	Перем МенеджерПечати;
	
	Результат = НовыйРезультатВизуализацииСчетаНаОплату();
	
	ПараметрыМетодаПечати = НовыйПараметрыТиповогоМетодаПечати();
	ПараметрыМетодаПечати.МассивОбъектов.Добавить(СчетНаОплату);
	
	ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати);
	ПриФормированииПечатнойФормыСчетаНаОплату(Результат, МенеджерПечати, ПараметрыМетодаПечати, СчетНаОплату);
	ИнтеграционныйМодуль.ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ПриФормированииПечатнойФормыСчетаНаОплату(Результат, МенеджерПечати, ПараметрыМетодаПечати, СчетНаОплату)
	
	Если МенеджерПечати = Неопределено Тогда
		ВызватьИсключение "Не удалось определить менеджер печати для формирования печатной формы счета на оплату по документу " + СчетНаОплату;
	КонецЕсли;
	
	МенеджерПечати.Печать(
		ПараметрыМетодаПечати.МассивОбъектов,
		ПараметрыМетодаПечати.ПараметрыПечати,
		ПараметрыМетодаПечати.КоллекцияПечатныхФорм,
		ПараметрыМетодаПечати.ОбъектыПечати,
		ПараметрыМетодаПечати.ПараметрыВывода);
	
	Для Каждого Стр Из ПараметрыМетодаПечати.КоллекцияПечатныхФорм Цикл
		Если ТипЗнч(Стр.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
			ТабличныйДокумент = Стр.ТабличныйДокумент;
		КонецЕсли;
	КонецЦикла;
	
	Если ТабличныйДокумент = Неопределено Тогда
		ВызватьИсключение "Не удалось сформировать печатную форму счета на оплату по документу " + СчетНаОплату;
	КонецЕсли;
	
	ТабличныйДокумент.Автомасштаб = Истина;
	
	НомерДокумента = ПредставлениеНомераДокументаУчета(СчетНаОплату);
	
	Результат.Таблица = ТабличныйДокумент;
	Результат.Дата = СчетНаОплату.Дата;
	Результат.Номер = СокрЛП(НомерДокумента);
	Результат.СписокОшибок = "";
	Результат.ИмяФайла = ИмяФайлаВложенияPDF("Счет", НомерДокумента, СчетНаОплату.Дата);
	
	ТабличныйДокумент_УбратьПодписьИПечать(Результат.Таблица);
	
КонецПроцедуры

Процедура ТабличныйДокумент_УбратьПодписьИПечать(ТабличныйДокумент)
	
	Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл
		Если Рисунок.ТипРисунка = ТипРисункаТабличногоДокумента.Картинка
			И Найти(Рисунок.Имя, "_Документ_") > 0 Тогда
			Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Включает автоматическое масштабирование и устанавливает поля табличного документа.
//
// Параметры:
//  ТабДокумент - ТабличныйДокумент - печатная форма документа.
//
Процедура ТабличныйДокумент_УстановитьМасштабИПоля(ТабДокумент)
	
	Если ТипЗнч(ТабДокумент) <> Тип("ТабличныйДокумент") Тогда
		Возврат;
	КонецЕсли;
	
	ШиринаПолей = 5;
	ТабДокумент.ПолеСверху = ШиринаПолей;
	ТабДокумент.ПолеСлева = ШиринаПолей;
	ТабДокумент.ПолеСнизу = ШиринаПолей;
	ТабДокумент.ПолеСправа = ШиринаПолей;
	
	ТабДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры

// Возвращает структуру, в которой Ключ - наименование параметра типового метода печати, 
// а Значение - значение параметра типового метода печати
//
// Возвращаемое значение:
//   Структура
//
Функция НовыйПараметрыТиповогоМетодаПечати()
	
	Результат = Новый Структура();
	
	Результат.Вставить("МассивОбъектов"			, Новый Массив);
	Результат.Вставить("ПараметрыПечати"		, Новый Структура);
	Результат.Вставить("КоллекцияПечатныхФорм"	, НовыйКоллекцияПечатныхФормДляПечатиДокумента());
	Результат.Вставить("ОбъектыПечати"			, Новый СписокЗначений);
	Результат.Вставить("ПараметрыВывода"		, НовыйПараметрыВывода());
	
	Возврат Результат;
	
КонецФункции

