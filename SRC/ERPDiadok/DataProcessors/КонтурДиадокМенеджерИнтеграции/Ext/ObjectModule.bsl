// Получает сведения для заполнения меты неформализованных накладных и актов
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - основание электронного документа.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - мета накладной/акта:
//    * Дата - Дата - дата электронного документа
//    * Номер - Строка - Номер электронного документа
//    * Сумма - Число - сумма электронного документа
//    * СуммаНДС - Число - сумма НДС
//    * ДокументБезНДС - Булево - Истина, если документ без НДС (только для счетов на оплату)
//    * КодВалюты - Строка - код валюты по ОКВ или пустая строка
//    * Основание - Строка - представление основания документа передачи
//
Функция ПередаточныеДокументы_Метаданные(СсылкаНаОбъект) Экспорт
	
	Данные = Новый Структура;
	Данные.Вставить("Дата", Дата(1, 1, 1));
	Данные.Вставить("Номер", "");
	Данные.Вставить("Сумма", 0);
	Данные.Вставить("СуммаНДС", 0);
	Данные.Вставить("ДокументБезНДС", Ложь);
	Данные.Вставить("Основание", "");
	Данные.Вставить("КодВалюты", "");
	
	СтандартнаяОбработка = Истина;
	ИнтеграционныйМодуль.ПередаточныеДокументы_ЗаполнитьМету(Данные, СсылкаНаОбъект, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		
		ЗначенияРеквизитов = Новый Структура;
		ЗначенияРеквизитов.Вставить("Номер");
		ЗначенияРеквизитов.Вставить("Дата");
		
		ЕстьСуммаДокумента = (СсылкаНаОбъект.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено);
		Если ЕстьСуммаДокумента Тогда
			ЗначенияРеквизитов.Вставить("СуммаДокумента");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, СсылкаНаОбъект);
		
		Данные.Дата = ЗначенияРеквизитов.Дата;
		Данные.Номер = ПредставлениеНомераДокументаУчета(СсылкаНаОбъект);
		Если ЕстьСуммаДокумента Тогда
			Данные.Сумма = ЗначенияРеквизитов.СуммаДокумента;
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = ФиксированныеДанные(Данные);
	
	Возврат Результат;
	
КонецФункции

// Контракт шапки неформализованного счета на оплату по форме ДД
