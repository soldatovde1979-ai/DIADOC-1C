// Возвращает свойства набора номенклатур информационной базы.
// Определяет обязательность использования характеристики и упаковки.
//
// Параметры:
//  СсылкаИлиМассив - Массив - ссылки на номенклатуру ИБ, для которой требуется определить свойства.
//                             Если передается ссылка, преобразуется в массив.
//
// Возвращаемое значение:
//  - Соответствие:
//     * Ключ - ОпределяемыйТип.НоменклатураБЭД - ссылка на номенклатуру ИБ.
//     * Значение - Структура - содержит свойства номенклатуры ИБ:
//        * ИспользоватьХарактеристики - Булево - Истина, если ведется учет по характеристикам.
//        * ИспользоватьУпаковки - Булево - Истина, если используются упаковки.
//        * ОбязательноеЗаполнениеХарактеристики - Булево - Истина, если требуется обязательно указывать характеристику
//  - Неопределено - если типовой не подключен или не указана номенклатура
//
Функция Номенклатура_СвойстваНоменклатурыИнформационнойБазы(СсылкаИлиМассив) Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("Номенклатура_СвойстваНоменклатурыИнформационнойБазы");
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ТиповойМодуль.СвойстваНоменклатурыИнформационнойБазы(СсылкаИлиМассив);
	
	Возврат Результат;
	
КонецФункции

// Ищет варианты сопоставления номенклатуры по номенклатуре электронного документа.
//
// Параметры:
//  НоменклатураЭД - Структура - Номенклатура электронного документа
// 
// Возвращаемое значение:
//  Массив из Структура - см. Контракт_НоменклатураИнформационнойБазы
//
Функция Номенклатура_ВариантыСопоставленияНоменклатуры(Знач НоменклатураЭД) Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("Номенклатура_ВариантыСопоставленияНоменклатуры");
		Возврат Новый Массив;
	КонецЕсли;
	
	ПустаяСтрока = "";
	
	// Подготовка контракта, используемого в типовом модуле
	НоменклатураКонтрагента = Новый Структура;
	НоменклатураКонтрагента.Вставить("Владелец", Неопределено);
	НоменклатураКонтрагента.Вставить("Идентификатор", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("Код", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("Артикул", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("Сорт", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("Наименование", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("Характеристика", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("СтавкаНДС", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("ЕдиницаИзмерения", ПустаяСтрока);
	НоменклатураКонтрагента.Вставить("ЕдиницаИзмеренияКод", ПустаяСтрока);
	
	ЗаполнитьЗначенияСвойств(НоменклатураКонтрагента, НоменклатураЭД);
	
	Результат = ТиповойМодуль.ВариантыСопоставленияНоменклатуры(НоменклатураКонтрагента);
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание и взаимосвязь объектов, составляющих номенклатуру информационной базы.
// Используется для типизации полей в мастере сопоставления номенклатуры и установки
// связей праметров выбора.
//
// Возвращаемое значение:
//  - Структура - данные о структуре номенклатуры информационной базы:
//     * ВладелецНоменклатурыПредставлениеОбъекта - Строка - представление единичного объекта владельца номенклатуры.
//     * НоменклатураПредставлениеОбъекта - Строка - представление единичного объекта номенклатуры.
//     * ХарактеристикаПредставлениеОбъекта - Строка - представление единичного объекта характеристики.
//     * УпаковкаПредставлениеОбъекта - Строка - представление единичного объекта упаковки.
//     * ИмяПараметраСвязиХарактеристики - Строка - имя параметра связи характеристики от номенклатуры.
//     * ИмяПараметраСвязиУпаковки - Строка - имя параметра связи упаковки от номенклатуры.
//  - Неопределено - если типовой модуль не подключен
//
Функция Номенклатура_МетаданныеСопоставленияНоменклатуры() Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("Номенклатура_МетаданныеСопоставленияНоменклатуры");
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = ТиповойМодуль.МетаданныеСопоставленияНоменклатуры();
	
	Возврат Результат;
	
КонецФункции

// Получает номенклатуру информационной базы, соответствующую идентификаторам номенклатуры контрагента.
//
// Параметры:
//  ВладелецНоменклатуры - СправочникСсылка - Владелец номенклатуры (контрагент/партнер).
//  ИдентификаторыНоменклатуры - Строка, Массив из Строка - идентификаторы номенклатуры контрагента.
// 
// Возвращаемое значение:
//  Соответствие - содержит:
//    * Ключ - Строка - идентификатор номенклатуры контрагента.
//    * Значение - Структура - номенклатура информационной базы (см. Контракт_НоменклатураИнформационнойБазы)
//
Функция Номенклатура_СопоставлениеПрочитать(ВладелецНоменклатуры, ИдентификаторыНоменклатуры) Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("Номенклатура_СопоставлениеПрочитать");
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Результат = ТиповойМодуль.ПрочитатьСопоставлениеНоменклатуры(
		ВладелецНоменклатуры,
		ИдентификаторыНоменклатуры
	);
	
	Возврат Результат;
	
КонецФункции

// Записывает сопоставление номенклатуры электронного документа с номенклатурой информационной базы.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - см. Контракт_НоменклатураКонтрагента
//  НоменклатураИБ - Структура - см. Контракт_НоменклатураИнформационнойБазы
//
Процедура Номенклатура_СопоставлениеЗаписать(НоменклатураКонтрагента, НоменклатураИБ) Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("Номенклатура_СопоставлениеЗаписать");
		Возврат;
	КонецЕсли;
	
	ТиповойМодуль.ЗаписатьСопоставлениеНоменклатуры(
		НоменклатураКонтрагента,
		НоменклатураИБ
	);
	
КонецПроцедуры

// Получает список правил обработки (идентификаторов операций) электронных документов указанного типа.
//
// Параметры:
//  ФорматЭД - Структура - описание типа электронного документа (см. Контракт_ФорматЭлектронногоДокумента).
// 
// Возвращаемое значение:
//  СписокЗначений:
//    * Значение - Строка - идентификатор правила обработки электронного документа.
//    * Представление - Строка - пользовательское представление операции.
//
