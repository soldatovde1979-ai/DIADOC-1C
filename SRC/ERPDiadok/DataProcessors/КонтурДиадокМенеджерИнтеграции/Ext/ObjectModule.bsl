// Контракт табличной части неформализованного счета на оплату по форме ДД
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//   * Номенклатура - ЛюбаяСсылка - Ссылка на номенклатуру
//   * Характеристика - ЛюбаяСсылка - Ссылка на характеристику номенклатуры
//   * НоменклатураКод - Строка - Код номенклатуры
//   * НоменклатураАртикул - Строка - Артикул номенклатуры
//   * НоменклатураПредставление - Строка - Представление номенклатуры для печати
//   * Количество - Число - Количество единиц номенклатуры в строке
//   * ЕдиницаИзмерения - ЛюбаяСсылка - Ссылка на единицы измерения номенклатуры
//   * Упаковка - ЛюбаяСсылка - Ссылка на упаковки номенклатуры
//   * СуммаСкидки - Число - Сумма скидки
//   * Цена - Число - Цена номенклатуры
//   * Сумма - Число - Сумма по строке (с учетом скидки)
//   * СуммаНДС - Число - СуммаНДС по строке (с учетом скидки)
//
Функция Новый_ТабличнаяЧастьСчетаНаОплату()
	
	КвалификаторыСуммы = Новый КвалификаторыЧисла(25, 2);
	ТипСумма = Новый ОписаниеТипов("Число", КвалификаторыСуммы);
	
	КвалификаторыКоличества = Новый КвалификаторыЧисла(15, 3);
	ТипКоличество = Новый ОписаниеТипов("Число", КвалификаторыКоличества);
	
	КвалификаторыСтроки = Новый КвалификаторыСтроки(1000, ДопустимаяДлина.Переменная);
	ТипСтрока = Новый ОписаниеТипов("Строка", , КвалификаторыСтроки);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура"); // Ссылка
	Результат.Колонки.Добавить("Характеристика"); // Ссылка
	Результат.Колонки.Добавить("НоменклатураАртикул", ТипСтрока);
	Результат.Колонки.Добавить("НоменклатураПредставление", ТипСтрока); // представление с учетом содержания, характеристик и прочего
	Результат.Колонки.Добавить("Количество", ТипКоличество);
	Результат.Колонки.Добавить("ЕдиницаИзмерения", ТипСтрока);
	Результат.Колонки.Добавить("Упаковка");
	Результат.Колонки.Добавить("Цена", ТипСумма); // как в документе
	Результат.Колонки.Добавить("Сумма", ТипСумма); // зависит от флага ЦенаВключаетНДС
	Результат.Колонки.Добавить("СуммаНДС", ТипСумма);
	Результат.Колонки.Добавить("СуммаСкидки", ТипСумма);
	
	Возврат Результат;
	
КонецФункции

// Получает данные для отправки неформализованных электронных документов
//
// Параметры:
//  СсылкаНаОбъект - ЛюбаяСсылка - ссылка на объект информационной базы, по которому необходимо создать электронный документ;
//  ТипКонтента - Строка - допустимые значения: "АктСверки", "СчетНаОплату";
//  ДополнительныеПараметры - Структура - см. ДополнительныеПараметрыПолученияКонтента.
// 
// Возвращаемое значение:
//  * Структура - табличное представление и значения полей документа.
//  * Неопределено - если типовой модуль не подключен.
//
Функция НеформализованныйКонтент(СсылкаНаОбъект, ТипКонтента, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("НеформализованныйКонтент");
		Возврат Неопределено;
	КонецЕсли;
	
	ТипКонтентаНРег = НРег(ТипКонтента);
	
	Если ТипКонтентаНРег = НРег("АктСверки") Тогда
		
		Результат = ТиповойМодуль.СформироватьПечатнуюФормуАктаСверки(СсылкаНаОбъект, ДополнительныеПараметры);
		
	ИначеЕсли ТипКонтентаНРег = НРег("СчетНаОплату") Тогда
		
		Результат = ТиповойМодуль.СформироватьПечатнуюФормуСчетаНаОплату(СсылкаНаОбъект, ДополнительныеПараметры);
		
	Иначе
		
		Ошибка = ПараметрыВСтроку(
			"Недопустимое значение параметра ""ТипКонтента"" (%1)",
			ТипКонтента
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

