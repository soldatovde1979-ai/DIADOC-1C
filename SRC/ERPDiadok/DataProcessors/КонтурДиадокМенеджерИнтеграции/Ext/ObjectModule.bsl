	ПараметрыИМ.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	ИнтеграционныйМодуль.ОбработатьСобытие("ПодготовитьЭлектронныйДокумент", ПараметрыИМ);
	
КонецПроцедуры

// Типовой обработчик события "ПодготовитьДанныеДляОтправкиВнутреннихДокументов"
//
// Параметры:
//  МенеджерВТ - МенеджерВременныхТаблиц - хранилище временных таблиц
//  ВидПакета - Строка - идентификатор вида пакета
//  Период - СтандартныйПериод - Период выборки данных для отправки
// 
// Возвращаемое значение:
//  Массив из Строка - Имена временных таблиц с данными для отправки
//
Функция ВнутренниеДокументы_ПодготовитьДанныеДляОтправки(МенеджерВТ, Знач ВидПакета, Знач Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Период.ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ВидПакетаID", ВидПакета);
	
	Результат = ИнтеграционныйМодуль.ВнутренниеДокументыСлужебный_ПодготовитьДанныеДляОтправки(ВидПакета, Запрос);
	
	Возврат Результат;
	
КонецФункции

// Конструктор дополнительных параметров создания учетных документов.
//
// Возвращаемое значение:
//  Структура:
//    * СоздаватьСчетаФактуры - Булево - Истина, если требуется создать комплект учетных документов.
//    * ИспользоватьДатуЭлектронногоДокумента - Булево - Истина, если требуется в документе 1С
//      заполнять дату из электронного документа
//
Функция ДополнительныеПараметрыСозданияУчетногоДокумента() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("СоздаватьСчетаФактуры", Ложь);
	Результат.Вставить("ИспользоватьДатуЭлектронногоДокумента", Ложь);
	Результат.Вставить("ОтключитьПроверкуСопоставленияНоменклатуры", Ложь);
	
	Возврат Результат;
	
КонецФункции

// Возвращает коллекцию ссылок на записи информационной базы, сопоставленные с подразделениями организации-отправителя
// и организации-получателя в системе Диадок.
//
// Параметры:
//  Документ1С - ДокументСсылка - Документ учета информационной базы, связанный с текущим пакетом электронных документов
//
// Возвращаемое значение:
//   Структура - Структура из массивов:
//    * Отправитель - Массив - Коллекция ссылок на сопоставленное подразделение-отправитель.
//    * Получатель	- Массив - Коллекция ссылок на сопоставленное подразделение-получатель.
//
Функция ЗначенияПолейМаршрутизацииПоПодразделениям(Документ1С) Экспорт
	
	ПоляОтправителя = Новый Массив;
	ПоляПолучателя = Новый Массив;
	
	ИнтеграционныйМодуль.ЗаполнитьЗначенияПолейМаршрутизацииПоПодразделениям(ПоляОтправителя, ПоляПолучателя, Документ1С);
	
	Результат = Новый Структура;
	Результат.Вставить("Отправитель", ПоляОтправителя);
	Результат.Вставить("Получатель", ПоляПолучателя);
	
	Возврат Результат;
	
КонецФункции

// Собирает контент электронного документа, используя типовые методы текущей конфигурации 
//
// Параметры:
//	ДокументДиадок - Структура - описание электронного документа
//
Функция ПодготовитьЭлектронныйДокументСредствамиКонфигурации(ДокументДиадок) Экспорт
	
	Документ1С = ДокументДиадок.ДокументУчета;
	ИдентификаторВидаДокумента = ДокументДиадок.ИдентификаторВида;
	
	ТребуетсяПФСчета = ЭтоИдентификаторВидаНеформализованныйСчет(ИдентификаторВидаДокумента);
	
	ДанныеПечатнойФормы = Неопределено;
	
	Если ТребуетсяПФСчета Тогда
		
		ДанныеПечатнойФормы = РезультатВизуализацииСчетаНаОплатуСредствамиКонфигурации(Документ1С);
		
	КонецЕсли;
	
	Возврат ДанныеПечатнойФормы;
	
КонецФункции

// Возвращает список доступных оснований для заданного вида электронного документа в рамках используемой конфигурации
//
// Параметры:
//	ВидДокумента - Строка - идентификатор вида документа: "ID_АктФормализованный", "ID_ТОРГ12" и т.д.
//
// Возвращаемое значение:
//	СписокЗначений - список возможных оснований
//
Функция СписокОснованийВидаЭлектронногоДокумента(ВидДокумента) Экспорт
	
	Результат = Новый СписокЗначений;
	
	ЭтоФормализованныйСчет = ЭтоИдентификаторВидаФормализованныйСчет(ВидДокумента);
	ЭтоНеформализованныйСчет = ЭтоИдентификаторВидаНеформализованныйСчет(ВидДокумента);
	
	Если ЭтоФормализованныйСчет ИЛИ ЭтоНеформализованныйСчет Тогда
		
		ИнтеграционныйМодуль.ЗаполнитьСписокОснованийДляЭлектронногоСчетаНаОплату(Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение по умолчанию настройки "ТипОснования" для вида документа
//
// Параметры:
//	ВидДокумента - Строка - идентификатор вида документа: "ID_АктФормализованный", "ID_ТОРГ12" и т.д.
//
// Возвращаемое значение:
//	Строка
Функция ОснованияВидовДокументов_ЗначениеПоУмолчанию(ВидДокумента) Экспорт
	
	Результат = "";
	
	ЭтоФормализованныйСчет = ЭтоИдентификаторВидаФормализованныйСчет(ВидДокумента);
	ЭтоНеформализованныйСчет = ЭтоИдентификаторВидаНеформализованныйСчет(ВидДокумента);
	
	Если ЭтоФормализованныйСчет ИЛИ ЭтоНеформализованныйСчет Тогда
		
		Результат = ТипОснования_СчетНаОплату();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает флаг доступности использования типовой печатной формы
//
// Параметры:
//  ВидДокумента - Строка - идентификатор вида документа: "ID_АктФормализованный", "ID_ТОРГ12" и т.д.
//  ТипОснования - Строка - Типо основания для формирования документа 
// 
// Возвращаемое значение:
//   Булево - Возможность использования типовой ПФ
//
Функция ДоступнаТиповаяПечатнаяФорма(ВидДокумента, ТипОснования) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	Результат = Истина;
	
	ИнтеграционныйМодуль.ПроверитьДоступностьТиповойПечатнойФормы(
		Результат,
		ВидДокумента,
		ТипОснования,
		СтандартнаяОбработка
	);
	
	Если СтандартнаяОбработка Тогда
		
		Результат = ЭтоИдентификаторВидаНеформализованныйСчет(ВидДокумента)
					И (ТипОснования = ТипОснования_СчетНаОплату()
						ИЛИ ТипОснования = ТипОснования_ЗаказКлиента()
						ИЛИ ТипОснования = ТипОснования_ЗаказПокупателя());
		
	КонецЕсли;
	
	Возврат Результат
	
КонецФункции

// Функция - Виды электронных счетов на оплату
// 
// Возвращаемое значение:
//  Массив - коллекция видов идентификаторов электронных счетов
//
Функция ВидыЭлектронныхСчетовНаОплату() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить("ID_Счет");
	Результат.Добавить("ID_СчетФормализованный");
	Результат.Добавить("ID_СчетФормализованныйФНС");
	Результат.Добавить("ID_СчетОфертаФормализованныйФНС");
	
	Возврат Результат;
	
КонецФункции

// Определяет является ли переданный идентификатор вида документа идентификатором формализованного счета
//
// Параметры:
//	ВидДокумента - Строка - идентификатор вида документа: "ID_АктФормализованный", "ID_ТОРГ12" и т.д.
//
// Возвращаемое значение:
//	Булево - Истина, если это ID формализованного счета
Функция ЭтоИдентификаторВидаФормализованныйСчет(ИдентификаторВида) Экспорт
	
	ИдентификаторыВидаФормализованногоСчета = Новый Массив;
	ИдентификаторыВидаФормализованногоСчета.Добавить("ID_СчетФормализованный");
	ИдентификаторыВидаФормализованногоСчета.Добавить("ID_СчетФормализованныйФНС");
	ИдентификаторыВидаФормализованногоСчета.Добавить("ID_СчетОфертаФормализованныйФНС");
	
	Результат = (ИдентификаторыВидаФормализованногоСчета.Найти(ИдентификаторВида) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Определяет является ли переданный идентификатор вида документа идентификатором неформализованного счета
//
// Параметры:
//	ВидДокумента - Строка - идентификатор вида документа: "ID_АктФормализованный", "ID_ТОРГ12" и т.д.
//
// Возвращаемое значение:
//	Булево - Истина, если это ID неформализованного счета
Функция ЭтоИдентификаторВидаНеформализованныйСчет(ИдентификаторВида) Экспорт
	
	Результат = (ИдентификаторВида = "ID_Счет");
	
	Возврат Результат;
	
КонецФункции

