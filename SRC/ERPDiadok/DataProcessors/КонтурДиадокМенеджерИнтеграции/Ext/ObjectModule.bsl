// Типовой обработчик события "ПодготовитьЭлектронныйДокумент"
//
Процедура ПодготовитьЭлектронныйДокумент(Результат, ДанныеСотрудника, ВидДокументаРазвернутый, ДополнительныеПараметры) Экспорт
	
	ПараметрыИМ = Новый Структура;
	ПараметрыИМ.Вставить("Результат", Результат);
