//
// Пример 2:
//  НовыйДокумент = СозданиеДокументов_НовыйДокументИнформационнойБазы("C:\temp\УПД 1.xml", "ПоступлениеТоваровУслуг_Оборудование");
//
// Пример 3:
//  ПараметрыЗаполнения = СозданиеДокументов_ПараметрыЗаполненияДокументаИнформационнойБазы();
//  ПараметрыЗаполнения.ДокументОснование = СсылкаНаПТУ;
//  ФорматЭД = НовоеОписаниеФорматаЭлектронногоДокумента("Invoice", "default", "utd820_05_01_01_hyphen");
//  НовыйДокумент = СозданиеДокументов_НовыйДокументИнформационнойБазы(Utd820SellerContent, "СчетФактураПолученный", ПараметрыСоздания, ФорматЭД);
//
Функция СозданиеДокументов_НовыйДокументИнформационнойБазы(Содержимое, ИдентификаторОперации, ПараметрыЗаполнения, ФорматЭД = Неопределено) Экспорт
	
	Если Не ТиповойМодульПодключен() Тогда
		ЛогироватьТиповойМодульНеПодключен("СозданиеДокументов_НовыйДокументИнформационнойБазы");
		Возврат Неопределено;
	КонецЕсли;
	
	СовместимыеПараметрыСоздания = ТиповойМодуль.ПараметрыСозданияДокументаИнформационнойБазы();
	СовместимыеПараметрыСоздания.Формат = ФорматЭД;
	СовместимыеПараметрыСоздания.Контрагент = ПараметрыЗаполнения.Контрагент;
	СовместимыеПараметрыСоздания.Организация = ПараметрыЗаполнения.Организация;
	СовместимыеПараметрыСоздания.ЦенаВключаетНДС = ПараметрыЗаполнения.ЦенаВключаетНДС;
	СовместимыеПараметрыСоздания.ДокументОснование = ПараметрыЗаполнения.ДокументОснование;
	
	Результат = ТиповойМодуль.НовыйДокументИнформационнойБазы(
		Содержимое,
		ИдентификаторОперации,
		СовместимыеПараметрыСоздания
	);
	
	Возврат Результат;
	
КонецФункции

