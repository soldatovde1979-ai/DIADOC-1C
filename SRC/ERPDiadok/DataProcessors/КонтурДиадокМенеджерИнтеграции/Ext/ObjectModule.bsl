// Определяет менеждер печати и значения параметров метода печати, характерные для конкретной конфигурации 1С
//
// Параметры:
//  МенеджерПечати			 - ДокументМенеджер	- менеджер, из которого будем вызывать типовой метод печати
//  ПараметрыМетодаПечати	 - Структура 		- См. метод "НовыйПараметрыТиповогоМетодаПечати"
//
Процедура ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати)
	
	ИнтеграционныйМодуль.ПередФормированиемПечатнойФормыСчетаНаОплату(МенеджерПечати, ПараметрыМетодаПечати);
			
КонецПроцедуры

// Дозаполняет мету неформализованного счета на оплату по данным интеграционного модуля
//
// Параметры:
//  СчетНаОплату - ДокументСсылка	- документ, на основании которого формируем печатную форму 
//  Мета		 - Структура		- см. метод "НовыйРезультатВизуализацииСчетаНаОплату"
//
Процедура ПриЗаполненииМетыНеформализованногоСчетаНаОплату(СчетНаОплату, Мета)
	
	Данные = СчетаНаОплату_Данные(СчетНаОплату);
	
	Шапка = Данные.Шапка;
	ТабличнаяЧасть = Данные.ТабличнаяЧасть;
	
	Мета.Номер = Шапка.Номер;
	Мета.ДокументБезНДС = Не Шапка.УчитыватьНДС;
	Мета.КодВалюты = Шапка.ВалютаКод;
	Мета.СуммаНДС = ТабличнаяЧасть.Итог("СуммаНДС");
	Мета.Сумма = ТабличнаяЧасть.Итог("Сумма");
	
	Если Не Шапка.ЦенаВключаетНДС Тогда
		Мета.Сумма = Мета.Сумма + Мета.СуммаНДС;
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеНомераДокументаУчета(Документ1С)
	
	Результат = ИнтеграционныйМодуль.ПриПолученииПредставленияНомераДокументаУчета(Документ1С);
		
	Возврат Результат;
	
КонецФункции

// Формирует имя файла в формате PDF по его названию, номеру и дате.
// При этом в имени файла символы, не поддерживаемые файловой системой,
// заменяются на "_"
//
// Параметры:
//  ИмяДокумента - Строка - название документа
//  НомерДокумента - Строка - номер документа
//  ДатаДокумента - Дата - дата документа
// 
// Возвращаемое значение:
//  Строка - имя файла вида "<Название> №<Номер> от <Дата>.pdf"
//
Функция ИмяФайлаВложенияPDF(ИмяДокумента, НомерДокумента, ДатаДокумента)
	
	ДатаСтрокой = Формат(ДатаДокумента, "ДЛФ=Д");
	
	ЧастиИмени = Новый Массив;
	ЧастиИмени.Добавить(ИмяДокумента);
	ЧастиИмени.Добавить(" №");
	ЧастиИмени.Добавить(НомерДокумента);
	ЧастиИмени.Добавить(" от ");
	ЧастиИмени.Добавить(ДатаСтрокой);
	ЧастиИмени.Добавить(".pdf");
	
	ИмяФайла = Общее_СоединитьСтроку(ЧастиИмени, "");
	
	Результат = ФС_ЗаменитьНедопустимыеСимволыВПути(ИмяФайла);
	
	Возврат Результат;
	
КонецФункции

// Заменяет символы, которые не допускаются в путях файловой системы, на "_"
//
// Параметры:
//  ИсходнаяСтрока - Строка - любая строка
// 
// Возвращаемое значение:
//  Строка.
//
Функция ФС_ЗаменитьНедопустимыеСимволыВПути(Знач Путь)
	
	Результат = Путь;
	
	НедопустимыеЗнаки = "\/:*?""<>|";
	
	Пока СтрДлина(НедопустимыеЗнаки) > 0 Цикл
		
		ТекСимвол = Лев(НедопустимыеЗнаки, 1);
		Если Найти(Результат, ТекСимвол) <> 0 Тогда
			Результат = СтрЗаменить(Результат, ТекСимвол, "_");
		КонецЕсли;
		НедопустимыеЗнаки = Сред(НедопустимыеЗнаки, 2);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьРеквизитыНомерИДатаВУчетномДокументе(СоответствиеРеквизитов, СсылкаНаОбъект)
	
	Результат = Истина;
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	РеквизитыМетаданных = МетаданныеОбъекта.Реквизиты;
	
	ИмяРеквизитаНомер = СоответствиеРеквизитов.Номер;
	ИмяРеквизитаДата = СоответствиеРеквизитов.Дата;
	
	Если РеквизитыМетаданных.Найти(ИмяРеквизитаНомер) = Неопределено 
		И РеквизитыМетаданных.Найти(ИмяРеквизитаДата) = Неопределено Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция ЗаполненныеРеквизитыДокументаУчета(СоответствиеРеквизитов, СсылкаНаОбъект)
	
	Результат = Неопределено;
	
	ИмяРеквизитаНомер = СоответствиеРеквизитов.Номер;
	ИмяРеквизитаДата = СоответствиеРеквизитов.Дата;
	
	Если Не ЕстьРеквизитыНомерИДатаВУчетномДокументе(СоответствиеРеквизитов, СсылкаНаОбъект) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураПолучения = Новый Структура;
	СтруктураПолучения.Вставить(ИмяРеквизитаНомер);
	СтруктураПолучения.Вставить(ИмяРеквизитаДата);
	
	ЗаполнитьЗначенияСвойств(СтруктураПолучения, СсылкаНаОбъект);
	
	Результат = Новый Структура;
	Результат.Вставить("Номер", СтруктураПолучения[ИмяРеквизитаНомер]);
	Результат.Вставить("Дата", СтруктураПолучения[ИмяРеквизитаДата]);

	Возврат Результат;

КонецФункции

