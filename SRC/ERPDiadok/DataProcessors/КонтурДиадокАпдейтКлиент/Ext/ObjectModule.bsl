// Парсеры

Функция _РазобратьЭлемент(ТипОбъекта, Данные)
	
	Если ТипОбъекта = ПеречислениеТипыОбъектов.Продукт Тогда
		Возврат _РазобратьПродукт(Данные);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Версия Тогда
		Возврат _РазобратьВерсию(Данные);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Контент Тогда
		Возврат _РазобратьКонтент(Данные);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Настройка Тогда
		Возврат _РазобратьНастройкуИБ(Данные);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Плагин Тогда
		Возврат _РазобратьПлагин(Данные);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Событие Тогда
		Возврат _РазобратьСобытие(Данные);
	Иначе
		ВызватьИсключение "Не поддерживается разбор элементы с типом " + ТипОбъекта;
	КонецЕсли;
	
КонецФункции

Функция _РазобратьПродукт(Данные)
	
	ТипПродукта = СокрЛП(Данные.Получить("product_type"));
	
	Если ТипПродукта = "product" Тогда
		Тип = "Продукт";
	ИначеЕсли ТипПродукта = "common_plugin" Тогда
		Тип = "Плагин";
	ИначеЕсли ТипПродукта = "library" Тогда
		Тип = "Библиотека";
	Иначе
		Тип = Неопределено;
	КонецЕсли;
		
	Результат = Продукт();
	Результат.Имя = СокрЛП(Данные.Получить("name"));
	Результат.Синоним = СокрЛП(Данные.Получить("synonym"));
	Результат.Описание = СокрЛП(Данные.Получить("description"));
	Результат.Родитель = СокрЛП(Данные.Получить("parent_name"));
	Результат.Тип = Тип;
	Результат.АдресДокументации = СокрЛП(Данные.Получить("homepage"));
		
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция _РазобратьВерсию(Данные)
	
	Результат = Версия();
	
	Результат.Имя = СокрЛП(Данные.Получить("version"));
	Результат.Дата = Стр.СтрокаВДатуЛок(Данные.Получить("release_date"));
	Результат.Описание = СокрЛП(Данные.Получить("description"));
	
	МассивКонтента = Новый Массив;
	
	Контент = Данные.Получить("content");
	Если ТипЗнч(Контент) = Тип("Соответствие") Тогда
			
		ТипКонтент = ПеречислениеТипыОбъектов.Контент;
		
		Для Каждого Эл Из Контент Цикл
			МассивКонтента.Добавить(_РазобратьЭлемент(ТипКонтент, Эл.Значение));
		КонецЦикла;
			
	КонецЕсли;
	
	Результат.Контент = Новый ФиксированныйМассив(МассивКонтента);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция _РазобратьКонтент(Данные)
	
	Результат = Контент();
	
	Результат.Имя = СокрЛП(Данные.Получить("name"));
	Результат.ИмяФайла = СокрЛП(Данные.Получить("filename"));
	Результат.Ссылка = СокрЛП(Данные.Получить("drive_public_link"));
	Результат.MD5Хеш = СокрЛП(Данные.Получить("md5hash"));
	Результат.КонтрольнаяСумма = СокрЛП(Данные.Получить("src_checksum"));
		
	Возврат Новый ФиксированнаяСтруктура(Результат);

