Функция СобратьЗапросПроверки(КонтекстВерсии, ДопПараметры)
	
	Предопределенные = Новый Массив;
	Предопределенные.Добавить("version");
	Предопределенные.Добавить("client_id");
	Предопределенные.Добавить("set_experimental");
	
	ДанныеЗапроса = Новый Соответствие;
	ДанныеЗапроса.Вставить("version", КонтекстВерсии.Версия);
	ДанныеЗапроса.Вставить("client_id", КонтекстВерсии.ИдБазы);
	
	Если КонтекстВерсии.ПолучатьБетаВерсии = Ложь Тогда
		ДанныеЗапроса.Вставить("set_experimental", Ложь);
	КонецЕсли;
	
	Для Каждого Элемент Из КонтекстВерсии.ПроизвольныеДанные Цикл
		Если Предопределенные.Найти(Элемент.Ключ) = Неопределено Тогда
			ДанныеЗапроса.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеЗапроса;
	
КонецФункции // СобратьЗапросПроверки

