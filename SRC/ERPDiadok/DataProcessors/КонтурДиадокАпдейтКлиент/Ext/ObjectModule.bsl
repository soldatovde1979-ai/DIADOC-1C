Функция _РазобратьНастройкуИБ(Данные) Экспорт

	ПростыеТипы = Новый Соответствие;
	ПростыеТипы.Вставить(Тип("Строка"), Истина);
	ПростыеТипы.Вставить(Тип("Число"), Истина);
	ПростыеТипы.Вставить(Тип("Булево"), Истина);	
	
	Результат = СохраненнаяНастройкаИБ();
	Результат.ПометкаУдаления = Данные.Получить("deleted") = Истина;
	Результат.КлючНастроек = Строка(Данные.Получить("key"));
	
	Значение = Данные.Получить("value");
	ПростойТип = ПростыеТипы.Получить(ТипЗнч(Значение)) = Истина;
	Если ПростойТип Тогда
		Результат.Настройки = Значение;
	Иначе
		Результат.Настройки = Строка(Значение);
	КонецЕсли;
	
	ДатаИзмененияISO = Данные["updated_at"];
	ДатаСозданияISO = Данные["created_at"];
	
	Результат.ДатаИзменения = ДатаIso8601(ДатаИзмененияISO);
	Результат.ДатаИзмененияЧислом = ЧислоIso8601(ДатаИзмененияISO);
	Результат.ДатаСоздания = ДатаIso8601(ДатаСозданияISO);
	Результат.ДатаСозданияЧислом = ЧислоIso8601(ДатаСозданияISO);
	
	Возврат Результат;
	
