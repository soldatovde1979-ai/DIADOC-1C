Функция ПроверитьОбновлениеСлужебный(ИмяПродукта, КонтекстВерсии, ДопПараметры)
	
	ДанныеЗапроса = СобратьЗапросПроверки(КонтекстВерсии, ДопПараметры);
	Ответ = PostJson("/v3/" + ИмяПродукта + "/check", ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Результат = РазобратьРезультатПроверки(Данные);
	Результат.Продукт = ИмяПродукта;
	
	Возврат Результат;
	
КонецФункции // ПроверитьОбновлениеСлужебный

Функция СкачатьОбновлениеСлужебный(РезультатПроверки, ТипКонтента, ДопПараметры)
	
	Если НЕ РезультатПроверки.ЕстьОбновление Тогда
		// TODO переделать в ошибку значения
		ВызватьИсключение "Результат проверки не содержит обновления";
	КонецЕсли;
	
	Ресурс = "content";
	Ссылка = Неопределено;
	Для Каждого Элемент Из РезультатПроверки.Ссылки Цикл
		Если Элемент.Ресурс = Ресурс
			И Элемент.ТипКонтента = ТипКонтента Тогда
			Ссылка = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Ссылка = Неопределено Тогда
		// TODO переделать в ошибку значения
		ВызватьИсключение "Результат проверки не содержит контента " + ТипКонтента;
	КонецЕсли;
	
	Ответ = Get(Ссылка.АдресРесурса);
	
	ПроверитьСостояниеHTTP(Ответ);
	
	Возврат КоннекторЛок.КакДвоичныеДанные(Ответ);
	
КонецФункции // СкачатьОбновлениеСлужебный

Функция ПолучитьОбъектСлужебный(ТипОбъекта, ПараметрыПути = Неопределено) 
	
	НачалоАдреса = "/v4/products";

	Если ТипОбъекта = ПеречислениеТипыОбъектов.Продукт Тогда
		
		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name;
		
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Версия Тогда
		
		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						+ "/versions/" + ПараметрыПути.version_name;
		
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Контент Тогда
		
		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						+ "/versions/" + ПараметрыПути.version_name
						+ "/contents/" + ПараметрыПути.content_name;
		
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Плагин Тогда
		
		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						+ "/customers/" + ПараметрыПути.customer_id
						+ "/plugins/" + ПараметрыПути.plugin_id;
		
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Событие Тогда
		
		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						+ "/events/" + Формат(ПараметрыПути.event_id, "ЧН=0; ЧГ=");
		
	Иначе
		ВызватьИсключение "Попытка получения данных неизвестного типы объекта: " + ТипОбъекта;
	КонецЕсли;

	Ответ = Get(АдресРесурса);
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьЭлемент(ТипОбъекта, Данные);
	
КонецФункции

Функция СкачатьКонтентСлужебный(ПараметрыПути) 
	
	АдресРесурса = "/v4/products/" + ПараметрыПути.product_name
					+ "/versions/" + ПараметрыПути.version_name
					+ "/contents/" + ПараметрыПути.content_name
					+ "/download";

	Ответ = Get(АдресРесурса);    
	ПроверитьСостояниеHTTP(Ответ);
	
	Возврат КоннекторЛок.КакДвоичныеДанные(Ответ);
	
КонецФункции

Функция ВыбратьЭлементыСлужебный(ТипОбъекта, ПараметрыПути, Отбор, Порядок, Сдвиг = 0)

	ПараметрыЗапроса = СобратьПараметрыЗапроса(ТипОбъекта, Отбор, Порядок, Сдвиг);
	
	НачалоАдреса = "/v4/products";
	
	Если ТипОбъекта = ПеречислениеТипыОбъектов.Продукт Тогда

		АдресРесурса = НачалоАдреса;
		ИмяНабораДанных = "products";

	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Версия Тогда

		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						+ "/versions";
		ИмяНабораДанных = "versions";
		
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Контент Тогда

		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						+ "/versions/" + ПараметрыПути.version_name
						+ "/contents";
		ИмяНабораДанных = "contents";

	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Плагин Тогда

		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						 + "/customers/" + ПараметрыПути.customer_id
						 + "/plugins";
		ИмяНабораДанных = "plugins";

	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Настройка Тогда

		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name
						 + "/customers/" + ПараметрыПути.customer_id
						 + "/settings";
		ИмяНабораДанных = "settings";

	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Событие Тогда

		АдресРесурса = НачалоАдреса + "/" + ПараметрыПути.product_name + "/events";
		ИмяНабораДанных = "events";

	Иначе
		ВызватьИсключение "Попытка получения набора данных неизвестного типы объекта: " + ТипОбъекта;
	КонецЕсли;
	
	Ответ = Get(АдресРесурса, ПараметрыЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	МассивЭлементов = Новый Массив;
	Для Каждого Элемент Из Данные.Получить(ИмяНабораДанных) Цикл
		МассивЭлементов.Добавить(_РазобратьЭлемент(ТипОбъекта, Элемент));
	КонецЦикла;
	
	Выборка = ВыборкаЭлементов();
	
	Выборка.ТекущийЭлемент = Неопределено;
	Выборка.Количество = Данные.Получить("total");

	Выборка._ТипОбъекта = ТипОбъекта;
	Выборка._ПараметрыПути = ПараметрыПути;
	Выборка._Отбор = Отбор;
	Выборка._Порядок = Порядок;
	Выборка._Сдвиг = Данные.Получить("offset");
	Выборка._Буфер = Новый ФиксированныйМассив(МассивЭлементов);
	Выборка._РазмерБуфера = Данные.Получить("count"); 
	Выборка._ИндексБуфера = -1;
	
	Возврат Новый ФиксированнаяСтруктура(Выборка);
	
КонецФункции

Процедура ЗаполнитьПараметрыЗапросаВыборкиПродуктов(ПараметрыЗапроса, Отбор)
	
	Если ЗначениеЗаполнено(Отбор.ТипПродукта) Тогда
		ПараметрыЗапроса.Вставить("product_type", _РазобратьТипПродукта(Отбор.ТипПродукта));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.Родитель) Тогда
		ПараметрыЗапроса.Вставить("parent_name", СокрЛП(Отбор.Родитель)); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ПодстрокаПоиска) Тогда
		ПараметрыЗапроса.Вставить("search", СокрЛП(Отбор.ПодстрокаПоиска));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыЗапросаВыборкиВерсий(ПараметрыЗапроса, Отбор)

	Если ЗначениеЗаполнено(Отбор.ОтВерсии) Тогда
		ПараметрыЗапроса.Вставить("from_version", Отбор.ОтВерсии);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыЗапросаВыборкиНастроек(ПараметрыЗапроса, Отбор)

	Если ЗначениеЗаполнено(Отбор.КлючНастроек) Тогда
		ПараметрыЗапроса.Вставить("key", СокрЛП(Отбор.КлючНастроек));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДатаИзмененияС) Тогда
		ПараметрыЗапроса.Вставить("updated_from", Iso8601(Отбор.ДатаИзмененияС));
	КонецЕсли;
	
	Если Отбор.ПоказыватьУдаленные = Истина Тогда
		ПараметрыЗапроса.Вставить("show_deleted", "True");
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПараметрыЗапросаВыборкиПлагинов(ПараметрыЗапроса, Отбор)
	
	Если ЗначениеЗаполнено(Отбор.Тип) Тогда
		ПараметрыЗапроса.Вставить("plugin_type", СокрЛП(Отбор.Тип));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ХешРодителя) Тогда
		ПараметрыЗапроса.Вставить("parent_md5hash", СокрЛП(Отбор.ХешРодителя));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДатаИзмененияС) Тогда
		ПараметрыЗапроса.Вставить("updated_from", Iso8601(Отбор.ДатаИзмененияС));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДатаИзмененияПо) Тогда
		ПараметрыЗапроса.Вставить("updated_to", Iso8601(Отбор.ДатаИзмененияПо));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДатаСозданияС) Тогда
		ПараметрыЗапроса.Вставить("created_from", Iso8601(Отбор.ДатаСозданияС));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДатаСозданияПо) Тогда
		ПараметрыЗапроса.Вставить("created_to", Iso8601(Отбор.ДатаСозданияПо));
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыЗапросаВыборкиСобытий(ПараметрыЗапроса, Отбор)
	
	Если ЗначениеЗаполнено(Отбор.ИдентификаторИБ) Тогда
		ПараметрыЗапроса.Вставить("client_id", СокрЛП(Отбор.ИдентификаторИБ));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ИдентификаторСобытияС) Тогда
		ПараметрыЗапроса.Вставить("from_event_id", СокрЛП(Отбор.ИдентификаторСобытияС));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДатаСобытияС) Тогда
		ПараметрыЗапроса.Вставить("from_timestamp", Iso8601(Отбор.ДатаСобытияС));
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСоответствиеПорядка(ТипОбъекта)
	
	СоответствиеПорядка = Новый Соответствие;
	
	// BSLLS:Typo-off
	Если ТипОбъекта = ПеречислениеТипыОбъектов.Настройка Тогда
		СоответствиеПорядка.Вставить("датаизменения", "updated_asc");
		СоответствиеПорядка.Вставить("датаизменения возр", "updated_asc");
		СоответствиеПорядка.Вставить("датаизменения убыв", "updated_desc");
		СоответствиеПорядка.Вставить("ключнастроек", "key_asc");
		СоответствиеПорядка.Вставить("ключнастроек возр", "key_asc");
		СоответствиеПорядка.Вставить("ключнастроек убыв", "key_desc");
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Плагин Тогда
		СоответствиеПорядка.Вставить("датаизменения", "updated asc");
		СоответствиеПорядка.Вставить("датаизменения возр", "updated asc");
		СоответствиеПорядка.Вставить("датаизменения убыв", "updated desc");
	Иначе
		СоответствиеПорядка.Вставить("убыв", "desc");
		СоответствиеПорядка.Вставить("возр", "asc");
	КонецЕсли;
	// BSLLS:Typo-on
	
	Возврат СоответствиеПорядка;
	
КонецФункции

Функция СобратьПараметрыЗапроса(ТипОбъекта, Отбор, Порядок, Сдвиг)
	
	ПараметрыЗапроса = Новый Соответствие;
	
	Если ТипОбъекта = ПеречислениеТипыОбъектов.Продукт Тогда
		ЗаполнитьПараметрыЗапросаВыборкиПродуктов(ПараметрыЗапроса, Отбор);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Версия Тогда
		ЗаполнитьПараметрыЗапросаВыборкиВерсий(ПараметрыЗапроса, Отбор);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Плагин Тогда
		ЗаполнитьПараметрыЗапросаВыборкиПлагинов(ПараметрыЗапроса, Отбор);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Настройка Тогда
		ЗаполнитьПараметрыЗапросаВыборкиНастроек(ПараметрыЗапроса, Отбор);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Событие Тогда
		ЗаполнитьПараметрыЗапросаВыборкиСобытий(ПараметрыЗапроса, Отбор);
	ИначеЕсли ТипОбъекта = ПеречислениеТипыОбъектов.Контент Тогда
		
	Иначе
		ВызватьИсключение "В подготовку параметров запроса передан неизвестный тип объекта: " + ТипОбъекта;
	КонецЕсли;
	
	РазмерПорции = Отбор.РазмерПорции;
	
	Если НЕ Порядок = Неопределено Тогда
		
		СоответствиеПорядка = ПолучитьСоответствиеПорядка(ТипОбъекта);
		
		ЗначениеПорядка = СоответствиеПорядка.Получить(НРег(Порядок));
		Если ЗначениеЗаполнено(ЗначениеПорядка) Тогда
			ПараметрыЗапроса.Вставить("order", ЗначениеПорядка);
		Иначе
			ВызватьИсключение "В выборку элементов передан неверный порядок сортировки: " + Порядок;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("count", Формат(РазмерПорции, "ЧН=0; ЧГ="));
	ПараметрыЗапроса.Вставить("offset", Формат(Сдвиг, "ЧН=0; ЧГ="));
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

Функция ПолучитьУведомленияСлужебный(ИмяПродукта, ЗапросУведомлений)
	
	Адрес = "/v4/products/" + ИмяПродукта + "/notifications";
	Ответ = PostJson(Адрес, УведомленияСобратьЗапрос(ЗапросУведомлений));
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Модель = УведомленияРазобратьОтвет(Данные);
	
	Возврат ФиксированныеДанные(Модель);
	
КонецФункции

Функция УведомленияСобратьЗапрос(ЗапросУведомлений)
	
	Запрос = Новый Соответствие;
	Запрос.Вставить("client_id", ЗапросУведомлений.ИдИБ);
	Запрос.Вставить("version", ЗапросУведомлений.Версия);
	
	Если НЕ ЗапросУведомлений.ДопПараметры = Неопределено Тогда
		Для Каждого Элемент Из ЗапросУведомлений.ДопПараметры Цикл
			Запрос.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции // _УведомленияСобратьЗапрос

Функция УведомленияРазобратьОтвет(Данные)
	
	Уведомления = ОтветУведомления();
	
	СписокУведомлений = Данные.Получить("notifications");
	Если СписокУведомлений <> Неопределено Тогда
		Для Каждого Элемент Из СписокУведомлений Цикл
			Уведомление = УведомлениеРазобратьОтвет(Элемент);
			Уведомления.Список.Добавить(Уведомление);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Уведомления;
	
КонецФункции // _УведомленияРазобратьОтвет

Функция УведомлениеРазобратьОтвет(Данные)
	
	Уведомление = ОтветУведомление();
	Уведомление.Ид = Данные.Получить("id");
	Уведомление.Контент = Данные.Получить("content");
	Уведомление.Приоритет = Данные.Получить("priority");
	Уведомление.ДатаНачала = Стр.СтрокаВДатуЛок(Данные.Получить("date_from"));
	Уведомление.ДатаОкончания = Стр.СтрокаВДатуЛок(Данные.Получить("date_to"));
	
	Возврат Уведомление;
	
КонецФункции // _УведомлениеРазобратьОтвет

Функция ЗначениеПростогоТипа(Значение)
	
	ПростыеТипы = Новый Соответствие;
	ПростыеТипы.Вставить(Тип("Строка"), Истина);
	ПростыеТипы.Вставить(Тип("Число"), Истина);
	ПростыеТипы.Вставить(Тип("Булево"), Истина);	
	
	Возврат ПростыеТипы.Получить(ТипЗнч(Значение)) = Истина;
	
КонецФункции

Функция ПроверитьПреобразоватьНастройку(НастройкаИБ)
	
	МаксДлинаКлючаНастройки = 255;
	
	ПроверитьПараметры(НеЗаполнено(НастройкаИБ.КлючНастроек));
	ПроверитьПараметры(НесоответствиеТипов(НастройкаИБ.КлючНастроек, "Строка"));
	
	Если СтрДлина(НастройкаИБ.КлючНастроек) > МаксДлинаКлючаНастройки Тогда
		ВызватьИсключение "Длина ключа настройки не может превышать 255 символов";
	КонецЕсли;
	
	Если НЕ ЗначениеПростогоТипа(НастройкаИБ.Настройки) Тогда
		ВызватьИсключение "Значение сохраняемой настройки может быть только простым (Строка, Число, Булево)";   
	КонецЕсли;
	
	ДанныеНастройки = Новый Соответствие;
	ДанныеНастройки.Вставить("key", НастройкаИБ.КлючНастроек); 
	ДанныеНастройки.Вставить("value", НастройкаИБ.Настройки);
	
	Возврат ДанныеНастройки;

КонецФункции

Функция НастройкиПроверитьИПрочитать(Настройки)
	
	КоллекцияНастроек = Новый Массив;
	
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		КоллекцияНастроек.Добавить(ПроверитьПреобразоватьНастройку(Настройки));
	ИначеЕсли ТипЗнч(Настройки) = Тип("Массив") Тогда
		Для Каждого ЭлементНастройка Из Настройки Цикл
			КоллекцияНастроек.Добавить(ПроверитьПреобразоватьНастройку(ЭлементНастройка));
		КонецЦикла;
	Иначе
		ПроверитьПараметры(
			НесоответствиеТипов(Настройки, "Массив")); 
	КонецЕсли;
		
	Возврат КоллекцияНастроек;
	
КонецФункции

Функция СписокФункциональныхОпцийРазобратьОтвет(Данные)
	
    МассивФО = Новый Массив;
	
	Для Каждого Эл ИЗ Данные Цикл
		ПараметрыФО = РазобратьПараметрыФункциональнойОпции(Эл);
		МассивФО.Добавить(ПараметрыФО);
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(МассивФО);
	
КонецФункции

