// Методы по проверке и скачиванию обновлений (check)

// Проверяет обновления для переденной версии
//
// Параметры:
//   ИмяПродукта - Строка - Имя продукта
//   ИмяВерсии - Структура - см. КонтекстВерсии
//   ДопПараметры - Произвольный - (необязательный)
//
// Возвращаемое значение:
//   Структура - см. РезультатПроверки
//
Функция ПроверитьОбновление(ИмяПродукта, ИмяВерсии, ДопПараметры = Неопределено) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИмяВерсии));
	
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИмяВерсии, "Структура, ФиксированнаяСтруктура"));
	
	Результат = ПроверитьОбновлениеСлужебный(НРег(ИмяПродукта), ИмяВерсии, ДопПараметры);
	
	Возврат ФиксированныеДанные(Результат);
	
КонецФункции // ПроверитьОбновление

// Скачивает контент согласно результату проверки
//
// Параметры:
//   РезультатПроверки - Структура - см. РезультатПроверки
//   ТипКонтента - Строка - Тип контент, например data-processor
//   ДопПараметры - Произвольный - (необязательный)
//
// Возвращаемое значение:
//   ДвоичныеДанные - Контент
//
Функция СкачатьОбновление(РезультатПроверки, ТипКонтента, ДопПараметры = Неопределено) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(РезультатПроверки),
		НеЗаполнено(ТипКонтента));
	
	ПроверитьПараметры(
		НесоответствиеТипов(РезультатПроверки, "Структура, ФиксированнаяСтруктура"),
		НесоответствиеТипов(ТипКонтента, "Строка"));
	
	Возврат СкачатьОбновлениеСлужебный(РезультатПроверки, ТипКонтента, ДопПараметры);
	
КонецФункции // СкачатьОбновление

