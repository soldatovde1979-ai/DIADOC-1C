// Методы по работе с настройками

// Записывает массив настроек ИБ в удаленное хранилище
//
// Параметры:
//  ИмяПродукта - Строка - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор информационной базы 
//  Настройки - Массив - см. НастройкаИБ, может быть Структурой
// 
// Возвращаемое значение:
//  Массив - см. СохраненнаяНастройкаИБ
//
Функция ЗаписатьНастройкиИБ(ИмяПродукта, ИдентификаторИБ, Настройки) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта), 
		НеЗаполнено(ИдентификаторИБ));

	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"), 
		НесоответствиеТипов(ИдентификаторИБ, "Строка"));
		
	КоллекцияНастроек = НастройкиПроверитьИПрочитать(Настройки);

	ДанныеЗапроса = Новый Соответствие;	
	ДанныеЗапроса.Вставить("settings", КоллекцияНастроек); 

	Ответ = PostJson("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/settings", ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьСохраненныеНастройкиИБ(Данные.Получить("settings"));
	
КонецФункции

// Выбирает настройки по заданному отбору
//
// Параметры:
//  ИмяПродукта - Строка - имя продукта
//  ИдентификаторИБ - Строка - идентификатор информационной базы
//  ОтборНастроек - Структура - см. ОтборНастроек - (необязательный)
//  Порядок - Строка - "ДатаИзменения", "ДатаИзменения Убыв", "КлючНастроек", "КлючНастроек Убыв"- (необязательный)
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. ВыборкаЭлементов
//
Функция ВыбратьНастройкиИБ(ИмяПродукта, ИдентификаторИБ, ОтборНастроек = Неопределено, Порядок = Неопределено) Экспорт
	
	ТипОбъекта = ПеречислениеТипыОбъектов.Настройка;
	
	ПараметрыПути = Новый ФиксированнаяСтруктура("product_name, customer_id", ИмяПродукта, ИдентификаторИБ);

	Отбор = ОтборНастроек();
	Если НЕ ОтборНастроек = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Отбор, ОтборНастроек);
	КонецЕсли;
	Отбор = Новый ФиксированнаяСтруктура(Отбор);
	
	Возврат ВыбратьЭлементыСлужебный(ТипОбъекта, ПараметрыПути, Отбор, Порядок);
	
КонецФункции

// Удаляет настройку по ключу, заданному в отборе
//
// Параметры:  
//  ИмяПродукта - Строка - имя продукта
//  ИдентификаторИБ - Строка - идентификатор информационной базы
//  ОтборНастроек - Структура - см. ОтборНастроек
//
// Возвращаемое значение:
//  Отсутствует
//
Функция УдалитьНастройкиИБ(ИмяПродукта, ИдентификаторИБ, ОтборНастроек) Экспорт

	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта), 
		НеЗаполнено(ИдентификаторИБ));

	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"), 
		НесоответствиеТипов(ИдентификаторИБ, "Строка"));
	
	ПараметрыЗапроса = Новый Структура;	
	ПараметрыЗапроса.Вставить("key", СокрЛП(ОтборНастроек.КлючНастроек));

	Ответ = Delete("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/settings", , ПараметрыЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	
	Возврат Неопределено;
	
КонецФункции

// Методы по чтению ленты событий

// Выбирает события по заданному отбору
//
// Параметры:
//  ИмяПродукта - Строка - имя продукта
//  ИдентификаторИБ - Строка - идентификатор информационной базы
//  ОтборСобытий - Структура - см. ОтборСобытий - (необязательный)
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. ВыборкаЭлементов
//
Функция ВыбратьСобытия(ИмяПродукта, ИдентификаторИБ = Неопределено, ОтборСобытий = Неопределено) Экспорт
	
	ТипОбъекта = ПеречислениеТипыОбъектов.Событие;
	
	ПараметрыПути = Новый ФиксированнаяСтруктура("product_name", ИмяПродукта);

	Отбор = ОтборСобытий();
	Если НЕ ОтборСобытий = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Отбор, ОтборСобытий);
	КонецЕсли;
	
	Отбор.Вставить("ИдентификаторИБ", ИдентификаторИБ);
	
	Отбор = Новый ФиксированнаяСтруктура(Отбор);
	
	Возврат ВыбратьЭлементыСлужебный(ТипОбъекта, ПараметрыПути, Отбор, Неопределено);
	
