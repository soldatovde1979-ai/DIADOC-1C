//
// Параметры:
//   ИмяПродукта - Строка - Имя продукта
//   ИмяВерсии - Строка - Имя версии
//   ИмяКонтента - Строка - Имя контента
//
// Возвращаемое значение:
//   ДвоичныеДанные - Контент
//
Функция СкачатьКонтент(ИмяПродукта, ИмяВерсии, ИмяКонтента) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИмяВерсии),
		НеЗаполнено(ИмяКонтента));
	
	ПараметрыПути = Новый ФиксированнаяСтруктура(
							"product_name, version_name, content_name", 
							ИмяПродукта, ИмяВерсии, ИмяКонтента);

	Возврат СкачатьКонтентСлужебный(ПараметрыПути);
	
КонецФункции

// Методы по работе с функциональными опциями (adjustments)

// Возвращает параметры списка функциональных опций продукта
//
// Параметры:
//   ИмяПродукта - Строка - Имя продукта
//   ЗапросФункциональныхОпций - Структура - см. ЗапросФункциональныхОпций
//
// Возвращаемое значение:
//   Массив - массив структур ПараметрФункциональнойОпции
//
Функция ПолучитьСписокФункциональныхОпцийПродукта(ИмяПродукта, ЗапросФункциональныхОпций = Неопределено) Экспорт
	
	ПроверитьПараметры(НеЗаполнено(ИмяПродукта));

	АдресРесурса = "/v4/products/" + ИмяПродукта + "/features";
	
	ПараметрыЗапроса = Новый Соответствие;
	Если НЕ ЗапросФункциональныхОпций = Неопределено Тогда
		ПараметрыЗапроса.Вставить("customer_id", ЗапросФункциональныхОпций.ИдентификаторКлиента);
	КонецЕсли;
	
	Ответ = Get(АдресРесурса, ПараметрыЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат СписокФункциональныхОпцийРазобратьОтвет(Данные);
	
КонецФункции

// Возвращает параметры функциональной опции продукта
//
// Параметры:
//   ИмяПродукта - Строка - Имя продукта
//   ИмяФункциональнойОпции - Строка - Имя функциональной опции
//   ЗапросФункциональныхОпций - Структура - см. ЗапросФункциональныхОпций
//
// Возвращаемое значение:
//   Массив - массив структур ПараметрФункциональнойОпции
//
Функция ПолучитьФункциональнуюОпциюПродукта(ИмяПродукта, 
											ИмяФункциональнойОпции, 
											ЗапросФункциональныхОпций = Неопределено) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИмяФункциональнойОпции));
		
	АдресРесурса = "/v4/products/" + ИмяПродукта + "/features/" + ИмяФункциональнойОпции;
	
	ПараметрыЗапроса = Новый Соответствие;
	Если НЕ ЗапросФункциональныхОпций = Неопределено Тогда
		ПараметрыЗапроса.Вставить("customer_id", ЗапросФункциональныхОпций.ИдентификаторКлиента);
	КонецЕсли;
	
	Ответ = Get(АдресРесурса, ПараметрыЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат РазобратьПараметрыФункциональнойОпции(Данные);
	
КонецФункции

// Вспомогательные методы

// Увеличивает итератор выборки элементов или сообщает об окончании выборки,
// самостоятельно запрашивает следующую порцию данных при необходимости.
//
// Параметры:  
//   Выборка - ФиксированнаяСтруктура - см. ВыборкаЭлементов
//
// Возвращаемое значение:
//   Булево - Истина (если увеличили итератор), Ложь (если выборка закончилась)
//
Функция Следующий(Выборка) Экспорт
	
	Если Выборка._ИндексБуфера >= Выборка._Буфер.ВГраница() Тогда
		Результат = Ложь;
		Если НЕ (Выборка._РазмерБуфера < Выборка._Отбор.РазмерПорции) Тогда // не последняя порция
			
			Выборка = ВыбратьЭлементыСлужебный(Выборка._ТипОбъекта, 
												Выборка._ПараметрыПути, 
												Выборка._Отбор, 
												Выборка._Порядок, 
												Выборка._Сдвиг + Выборка._РазмерБуфера);
			
			Если Выборка._РазмерБуфера > 0 Тогда
				ИндексБуфера = 0;
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИндексБуфера = Выборка._ИндексБуфера + 1;
		Результат = Истина;
	КонецЕсли; 
	
	Если Результат Тогда
		
		ВыборкаСтруктура = ВыборкаЭлементов();
		ЗаполнитьЗначенияСвойств(ВыборкаСтруктура, Выборка);
		
		ВыборкаСтруктура.ТекущийЭлемент = Выборка._Буфер[ИндексБуфера]; 
		ВыборкаСтруктура._ИндексБуфера = ИндексБуфера; 
		
		Выборка = Новый ФиксированнаяСтруктура(ВыборкаСтруктура);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  

