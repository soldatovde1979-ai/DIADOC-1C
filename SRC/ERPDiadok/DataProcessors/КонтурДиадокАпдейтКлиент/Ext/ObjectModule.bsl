	Возврат СессияЛок;
	
КонецФункции // Сессия

Функция URL(Ресурс)
	
	Если Найти(Ресурс, "http") ИЛИ Найти(Ресурс, "https") Тогда
		Возврат Ресурс;
	Иначе
		Возврат Локация + Ресурс;
	КонецЕсли;
	
КонецФункции // URL

Функция PostJson(Ресурс, Json = Неопределено, ПараметрыЗапроса = Неопределено, Заголовки = Неопределено)
	
	АдресРесурса = URL(Ресурс);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Заголовки", Новый Соответствие);
	ДопПараметры.Вставить("Json", Json);
	
	Если ПараметрыЗапроса <> Неопределено Тогда
		ДопПараметры.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	КонецЕсли;
	
	ЗаполнитьЗаголовки(ДопПараметры.Заголовки, Заголовки);
	
	Ответ = КоннекторЛок.Post(
			АдресРесурса,
			Неопределено,
			ДопПараметры,
			Сессия());
	
	Возврат Ответ;
	
КонецФункции // PostJson

