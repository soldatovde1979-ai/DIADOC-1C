// Удаляет плагин
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ 
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//   Отсутствует
//
Функция УдалитьПлагин(ИмяПродукта, ИдентификаторИБ, ИдентификаторПлагина) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ),
		НеЗаполнено(ИдентификаторПлагина));
		
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИдентификаторИБ, "Строка"),
		НесоответствиеТипов(ИдентификаторПлагина, "Строка"));
	
	Ответ = Delete("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/plugins/" + ИдентификаторПлагина);
	
	Возврат Неопределено;

