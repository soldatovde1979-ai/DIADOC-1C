// Дополнительный разбор даты

// Получает строку ISO 8601:2019 из значения
//
// Параметры:
//  Значение - Дата, Число - Число секунд или Дата
//
// Возвращаемое значение:
//  Стррока - Строка формата yyyy-mm-ddThh:mm:ss.fffffffZ
//
Функция Iso8601(Значение) 
	
	Точность = 7;
	Дата = Дата(1, 1, 1);
	Доли = 0;
	Зона = "Z";
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Секунды = Цел(Значение);
		Доли = Окр(Значение - Секунды, Точность);
		Дата = Дата(1, 1, 1) + Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Дата = Значение;
		Доли = 0;
	Иначе
		ВызватьИсключение "Не предполагаемый тип значения";
	КонецЕсли;
	
	Данные = Новый Массив;
	
	Если Дата = Дата(1, 1, 1) Тогда
		Данные.Добавить("0001-01-01T00:00:00");
	Иначе
		Данные.Добавить(Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
	КонецЕсли;
	
	Если Доли > 0 И Доли < 1 Тогда
		НачалоДоли = 2;
		СтрокаДоли = Сред(Формат(Доли, "ЧРД=.; ЧГ=0"), НачалоДоли);
		Пока СтрДлина(СтрокаДоли) < Точность + 1 Цикл
			СтрокаДоли = СтрокаДоли + "0";
		КонецЦикла;
		Данные.Добавить(СтрокаДоли);
	КонецЕсли;
	
	Данные.Добавить(Зона);
	
	Возврат Стр.СтрСоединитьЛок(Данные, "");
	
КонецФункции // Iso8601

// Получает Дату из строки поддерживамого формата
//
// Параметры:
//  Строка - Строка - Форматы "yyyy-mm-ddThh:mm:ss±hh:mm",
//                            "yyyy-mm-ddThh:mm:ssZ",
//                            "yyyy-mm-ddThh:mm:ss.fffffff±hh:mm",
//                            "yyyy-mm-ddThh:mm:ss.fffffffZ"
//
// Возвращаемое значение:
//  Дата - Дата с точностю до yyyy-mm-ddThh:mm:ss
//
Функция ДатаIso8601(Строка) 
	
	МоментВремени = _ОписаниеМоментВремени(Строка);
	
	Возврат _МоментВремениВДату(МоментВремени);
	
КонецФункции // ДатаIso8601

// Получает число секунд из строки
//
// Параметры:
//  Строка - Строка - Форматы см. ДатаIso8601
//
// Возвращаемое значение:
//  Число - Число секунд начиная с 01.01.0001 00:00:00
//
Функция ЧислоIso8601(Строка) Экспорт
	
	МоментВремени = _ОписаниеМоментВремени(Строка);
	
	Возврат _МоментВремениВЧисло(МоментВремени);
	
КонецФункции // ЧислоIso8601

Функция _ОписаниеМоментВремени(Строка = Неопределено) 
	
	Описание = Новый Структура;
	Описание.Вставить("Год", 1);
	Описание.Вставить("Месяц", 1);
	Описание.Вставить("День", 1);
	Описание.Вставить("Час", 0);
	Описание.Вставить("Минута", 0);
	Описание.Вставить("Секунда", 0);
	Описание.Вставить("Доля", 0);
	Описание.Вставить("Зона", "");
	
	Если ПустаяСтрока(Строка) Тогда
		Возврат Описание;
	КонецЕсли;
	
	_Строка = ВРег(Строка);
	
	ИндексВремя = Найти(_Строка, "T");
	Если ИндексВремя = 0 Тогда
		
		ЗаполнитьЗначенияСвойств(Описание, _ОписаниеДата(_Строка));
		
	Иначе
		
		Дата = _ОписаниеДата(Лев(_Строка, ИндексВремя - 1));
		Время = _ОписаниеВремя(Сред(_Строка, ИндексВремя + 1));
		
		ЗаполнитьЗначенияСвойств(Описание, Дата);
		ЗаполнитьЗначенияСвойств(Описание, Время);
		
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции // _ОписаниеМоментВремени

Функция _ОписаниеДата(Строка) 
	
	Описание = Новый Структура;
	Описание.Вставить("Год", 1);
	Описание.Вставить("Месяц", 1);
	Описание.Вставить("День", 1);
	
	Если Строка = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	ДатаXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "date"), Строка);
	
	Описание.Год = Год(ДатаXDTO.Значение);
	Описание.Месяц = Месяц(ДатаXDTO.Значение);
	Описание.День = День(ДатаXDTO.Значение);
	
	Возврат Описание;
	
КонецФункции // _ОписаниеДата

Функция _ОписаниеВремя(Строка) 
	
	Описание = Новый Структура;
	Описание.Вставить("Час", 0);
	Описание.Вставить("Минута", 0);
	Описание.Вставить("Секунда", 0);
	Описание.Вставить("Доля", 0);
	Описание.Вставить("Зона", "");
	
	Если Строка = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	ИндексДоля = Найти(Строка, ".");
	ИндексЗона = Найти(Строка, "+") + Найти(Строка, "-") + Найти(Строка, "Z");
	
	Если ИндексЗона И ИндексДоля > ИндексЗона Тогда
		ВызватьИсключение "Не предполагаемый формат времени: " + Строка;
	КонецЕсли;
	
	Если ИндексДоля И ИндексЗона Тогда
		
		СтрокаВремя = Лев(Строка, ИндексДоля - 1);
		СтрокаДоля = Сред(Строка, ИндексДоля + 1, ИндексЗона - ИндексДоля - 1);
		СтрокаЗона = Сред(Строка, ИндексЗона);
		
	ИначеЕсли ИндексДоля И НЕ ИндексЗона <> 0 Тогда
		
		СтрокаВремя = Лев(Строка, ИндексДоля - 1);
		СтрокаДоля = Сред(Строка, ИндексДоля + 1);
		СтрокаЗона = Неопределено;
		
	ИначеЕсли НЕ ИндексДоля И ИндексЗона <> 0 Тогда
		
		СтрокаВремя = СокрЛП(Строка);
		СтрокаДоля = Неопределено;
		СтрокаЗона = Сред(Строка, ИндексЗона + 1);
		
	Иначе
		
		СтрокаВремя = СокрЛП(Строка);
		СтрокаДоля = Неопределено;
		СтрокаЗона = Неопределено;
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтрокаВремя) Тогда
		
		ДатаXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "time"), СтрокаВремя);
		
		Описание.Час = Час(ДатаXDTO.Значение);
		Описание.Минута = Минута(ДатаXDTO.Значение);
		Описание.Секунда = Секунда(ДатаXDTO.Значение);
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтрокаДоля) Тогда
		Описание.Доля = Число_("0." + СтрокаДоля);
	КонецЕсли;
	
	Описание.Зона = СокрЛП(СтрокаЗона);
	
	Возврат Описание;
	
КонецФункции // _ОписаниеВремя

Функция _МоментВремениВДату(Момент) 
	
	Значение = Дата(Момент.Год, Момент.Месяц, Момент.День, Момент.Час, Момент.Минута, Момент.Секунда);
	
	Если НЕ ПустаяСтрока(Момент.Зона) И Момент.Зона <> "Z" Тогда
		Дата = УниверсальноеВремя(Значение, "GMT" + Момент.Зона);
	Иначе
		Дата = Значение;
	КонецЕсли;
	
	Возврат Дата;
	
КонецФункции // _МоментВремениВДату

Функция _МоментВремениВЧисло(Момент) 
	
	Дата = _МоментВремениВДату(Момент);
	Секунды = (Дата - Дата(1, 1, 1)) + Момент.Доля;
	
	Возврат Секунды;
	
КонецФункции // _МоментВремениВЧисло

