	// Если токен пустой, значит база уже зарегистрирована
	// и вам нужно запросить новый токен, соответствующим методом
	
	Токен = Данные.Получить("token");
	Если ЗначениеЗаполнено(Токен) Тогда
		Результат.Токен = Токен;
	КонецЕсли;
	
