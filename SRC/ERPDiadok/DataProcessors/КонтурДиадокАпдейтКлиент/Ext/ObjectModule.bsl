// Инициализация

Процедура __Инит__(Мета)
	
	Состояние404 = 404;
	СтаршийРазрядОшибокКлиента = "4";
	СтаршийРазрядОшибокСервера = "5";
	
	ЗначенияКатегорий = Новый Структура;
	ЗначенияКатегорий.Вставить("ОшибкаТипа", ОшибкаТипа());
	ЗначенияКатегорий.Вставить("ОшибкаЗначения", ОшибкаЗначения());
	ЗначенияКатегорий.Вставить("ОшибкаСостоянияHTTP", ОшибкаСостоянияHTTP());
	ЗначенияКатегорий.Вставить("ОшибкаСостоянияHTTP404", ОшибкаСостоянияHTTP(Состояние404));
	ЗначенияКатегорий.Вставить("ОшибкаСостоянияHTTPОшибкаКлиента", ОшибкаСостоянияHTTP(СтаршийРазрядОшибокКлиента));
