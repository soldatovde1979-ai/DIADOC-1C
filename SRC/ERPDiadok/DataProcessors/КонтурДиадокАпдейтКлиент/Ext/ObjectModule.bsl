//   ФиксированнаяСтруктура - см. ВыборкаЭлементов
//
Функция ВыбратьВерсии(ИмяПродукта, Отбор = Неопределено, Порядок = Неопределено) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта));

	ТипОбъекта = ПеречислениеТипыОбъектов.Версия;
	
	ПараметрыПути = Новый ФиксированнаяСтруктура("product_name", ИмяПродукта);
	
	ОтборВерсий = ОтборВерсий();
