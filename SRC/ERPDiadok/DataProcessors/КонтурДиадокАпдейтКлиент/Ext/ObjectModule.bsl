Процедура ЗаполнитьПоляКоллекции(Данные, Коллекция, ТипыКоллекций)
	
	Для Каждого КлючИЗначение Из Данные Цикл
		Значение = КлючИЗначение.Значение;
		Если ТипыКоллекций.Получить(ТипЗнч(Значение)) = Неопределено Тогда
			Коллекция.Вставить(КлючИЗначение.Ключ, Значение);
		Иначе
			Коллекция.Вставить(КлючИЗначение.Ключ, ФиксированныеДанные(Значение));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ФиксированныеДанные(Данные)
	
	ТипМассив = "Массив";
	ТипСтруктура = "Структура";
	ТипСоответствие = "Соответствие";
	
	ТипыКоллекций = Новый Соответствие();
	ТипыКоллекций.Вставить(Тип(ТипМассив), ТипМассив);
	ТипыКоллекций.Вставить(Тип(ТипСтруктура), ТипСтруктура);
	ТипыКоллекций.Вставить(Тип(ТипСоответствие), ТипСоответствие);
	
	ТипКоллекции = ТипыКоллекций.Получить(ТипЗнч(Данные));
	
	Если ТипКоллекции = ТипМассив Тогда
		
		Массив = Новый Массив;
		
		Для Каждого Значение Из Данные Цикл
			Если ТипыКоллекций.Получить(ТипЗнч(Значение)) = Неопределено Тогда
				Массив.Добавить(Значение);
			Иначе
				Массив.Добавить(ФиксированныеДанные(Значение));
			КонецЕсли;
		КонецЦикла;
		
		Возврат Новый ФиксированныйМассив(Массив);
		
	ИначеЕсли ТипКоллекции = ТипСтруктура Тогда
		
		Коллекция = Новый Структура;
		
		ЗаполнитьПоляКоллекции(Данные, Коллекция, ТипыКоллекций);
		
		Возврат Новый ФиксированнаяСтруктура(Коллекция);
	
	ИначеЕсли ТипКоллекции = ТипСоответствие Тогда
		
		Коллекция = Новый Соответствие;
		
		ЗаполнитьПоляКоллекции(Данные, Коллекция, ТипыКоллекций);
		
		Возврат Новый ФиксированноеСоответствие(Коллекция);
		
	Иначе
		
		Возврат Данные;
		
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции // ФиксированныеДанные

