// Конструктор

// Инициализирует клиент сервиса обновлений
//
// Параметры:
//   Параметры - Структура - см. АпдейтКлиентПараметры
//
// Возвращаемое значение:
//   ОбработкаОбъект.АпдейтКлиент - Настроенный клиент
//
Функция АпдейтКлиент(Знач Параметры = Неопределено) Экспорт
	
	АпдейтКлиентПараметры = АпдейтКлиентПараметры();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(АпдейтКлиентПараметры, Параметры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АпдейтКлиентПараметры.Локация) Тогда
		Локация = СокрЛП(АпдейтКлиентПараметры.Локация);
		
		Если Прав(Локация, 1) = "/" Тогда
			Локация = Лев(Локация, СтрДлина(Локация) - 1);
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяСессия = Сессия();
	Если ЗначениеЗаполнено(АпдейтКлиентПараметры.КлючАПИ) Тогда
		ТекущаяСессия.Заголовки.Вставить("X-Kontur-Apikey", АпдейтКлиентПараметры.КлючАПИ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АпдейтКлиентПараметры.КлючИБ) Тогда
		ТекущаяСессия.Заголовки.Вставить("X-Customer-Secret-Key", АпдейтКлиентПараметры.КлючИБ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АпдейтКлиентПараметры.Токен) Тогда
		ТекущаяСессия.Заголовки.Вставить("Authorization", АпдейтКлиентПараметры.Токен);
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции // АпдейтКлиент

// Описание параметров конструктора
//
// Возвращаемое значение:
//  Структура - Параметры клиента
//     * Локация - Строка - (необязательный) Локация сервиса
//     * КлючАПИ - Строка - (необязательный) X-Kontur-Apikey
//     * КлючИБ - Строка - (необязательный) X-Kontur-Secret-Key
//     * Токен - Строка - (необязательный) Authorization
//
Функция АпдейтКлиентПараметры() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Локация", "https://update.kontur.ru/1c");
	Модель.Вставить("КлючАПИ");
	Модель.Вставить("КлючИБ");
	Модель.Вставить("Токен");
	
	Возврат Модель;
	
КонецФункции // АпдейтКлиентПараметры

// Определения

// Контекст текущей версии и среды испольнения
//
// Возвращаемое значение:
//   Структура - Определение
//
Функция КонтекстВерсии() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Версия");
	Модель.Вставить("ИдБазы");
	Модель.Вставить("ПолучатьБетаВерсии", Истина);
	Модель.Вставить("ПроизвольныеДанные", Новый Соответствие);
	
	Возврат Модель;
	
КонецФункции // КонтекстВерсии

// Исключения

// Проверяет, что ошибка принадлежит к указанной категории
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке - ИнформацияОбОшибке
//  Категория		   - Строка - Текст ошибки
//
// Возвращаемое значение:
//  Булево - возвращает Истина если описание ошибки начинается на текст категории
//
Функция ЯвляетсяОшибкойКатегории(ИнформацияОбОшибке, Категория) Экспорт
	
	Возврат Найти(ИнформацияОбОшибке.Описание, Категория.Описание) = 1;
	
КонецФункции // ЯвляетсяОшибкойКатегории

// Методы по работе с продуктами (products)

// Выбирает продукты по заданному отбору
//
// Параметры:
//   Отбор - Структура - см. ОтборПродуктов - (необязательный)
//   Порядок - Строка - возможные значения: Убыв, Возр - (необязательный)
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - см. ВыборкаЭлементов
//
Функция ВыбратьПродукты(Отбор = Неопределено, Порядок = Неопределено) Экспорт
	
	ТипОбъекта = ПеречислениеТипыОбъектов.Продукт;
	
	ПараметрыПути = Новый ФиксированнаяСтруктура();
	
	ОтборПродуктов = ОтборПродуктов();  
	Если НЕ Отбор = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ОтборПродуктов, Отбор);
	КонецЕсли;     
	ОтборПродуктов = Новый ФиксированнаяСтруктура(ОтборПродуктов);
	
	Возврат ВыбратьЭлементыСлужебный(ТипОбъекта, ПараметрыПути, ОтборПродуктов, Порядок);
	
КонецФункции

// Возвращает продукт по имени
//
// Параметры:
//   ИмяПродукта - Строка - Имя продукта
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - см. Продукт
//
Функция ПолучитьПродукт(ИмяПродукта) Экспорт

	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта));

	ТипОбъекта = ПеречислениеТипыОбъектов.Продукт;
	
	ПараметрыПути = Новый ФиксированнаяСтруктура("product_name", ИмяПродукта);
	
	Возврат ПолучитьОбъектСлужебный(ТипОбъекта, ПараметрыПути);

КонецФункции

// Методы по работе с информационными базами (customers)

// Регистрирует новую информационную базу
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ЗапросРегистрацииИБ - Структура - см. ЗапросРегистрацииИБ
// 
// Возвращаемое значение:
//  Структура - см. РезультатРегистрацииИБ
//
Функция ЗарегистрироватьИнформационнуюБазу(ИмяПродукта, ЗапросРегистрацииИБ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта));
	
	ДанныеЗапроса = Новый Соответствие;
	ДанныеЗапроса.Вставить("customer_id", ЗапросРегистрацииИБ.Идентификатор);
	
	Ответ = PostJson("/v4/products/" + ИмяПродукта + "/customers", ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьРезультатРегистрацииИБ(Данные);
	
КонецФункции

// Возвращает данные информационной базы по идентификатору
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ
// 
// Возвращаемое значение:
//  Структура - см. ИнформационнаяБаза
//
Функция ПолучитьИнформационнуюБазу(ИмяПродукта, ИдентификаторИБ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ));
	
	Ответ = Get("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ);
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьИБ(Данные);

КонецФункции

// Добавляет права новому пользователю
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ
//  ЗапросИзмененияИБ - Структура - см. ЗапросИзмененияИБ
// 
// Возвращаемое значение:
//  Структура - см. ИнформационнаяБаза
//
Функция ИзменитьИнформационнуюБазу(ИмяПродукта, ИдентификаторИБ, ЗапросИзмененияИБ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ));
		
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИдентификаторИБ, "Строка"),
		НесоответствиеТипов(ЗапросИзмененияИБ, "Структура"));
		
	ДанныеЗапроса = Новый Соответствие;
	ДанныеЗапроса.Вставить("portal_user_id", ЗапросИзмененияИБ.ИдентификаторПользователя);
	
	Ответ = PostJson("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ, ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьИБ(Данные);

КонецФункции

// Методы по работе с ключами АПИ (keys)

// Возвращает список ключей АПИ информационной базы
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ
// 
// Возвращаемое значение:
//  Массив - см. КлючАПИ
//
Функция ПолучитьКлючиАПИ(ИмяПродукта, ИдентификаторИБ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ));
		
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИдентификаторИБ, "Строка"));
	
	Ответ = Get("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/keys");
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	МассивКлючей = Новый Массив;
	Для Каждого Эл Из Данные.Получить("keys") Цикл
		МассивКлючей.Добавить(_РазобратьКлючАПИ(Эл));
	КонецЦикла;
	
	Возврат МассивКлючей;
	
КонецФункции

// Возвращает данные ключа АПИ
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ 
//  ИдентификаторКлючаАПИ - Число - Идентификатор ключа АПИ
// 
// Возвращаемое значение:
//  Массив - см. КлючАПИ
//
Функция ПолучитьКлючАПИ(ИмяПродукта, ИдентификаторИБ, ИдентификаторКлючаАПИ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ),
		НеЗаполнено(ИдентификаторКлючаАПИ));
		
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИдентификаторИБ, "Строка"),
		НесоответствиеТипов(ИдентификаторКлючаАПИ, "Число"));
		
	ИдентификаторСтрокой = Формат(ИдентификаторКлючаАПИ, "ЧН=0; ЧГ=");  
		
	Ответ = Get("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/keys/" + ИдентификаторСтрокой);
	ПроверитьСостояниеHTTP(Ответ);
	
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьКлючАПИ(Данные);
	
КонецФункции

// Создает новый ключ АПИ
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ 
//  ЗапросНовогоКлючаАПИ - Структура - см. ЗапросНовогоКлючаАПИ
// 
// Возвращаемое значение:
//  Структура - см. КлючАПИ
//
Функция СоздатьКлючАПИ(ИмяПродукта, ИдентификаторИБ, ЗапросНовогоКлючаАПИ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ));
		
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИдентификаторИБ, "Строка"));
	
	ДанныеЗапроса = Новый Соответствие;
	ДанныеЗапроса.Вставить("description", ЗапросНовогоКлючаАПИ.Описание);
	
	Ответ = PostJson("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/keys", ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);
	
	Возврат _РазобратьКлючАПИ(Данные);
	
КонецФункции

// Удаляет ключ АПИ
//
// Параметры:
//  ИмяПродукта - Строка    - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор ИБ 
//  ИдентификаторКлючаАПИ - Число - Идентификатор ключа АПИ
// 
// Возвращаемое значение:
//   Отсутствует
//
Функция УдалитьКлючАПИ(ИмяПродукта, ИдентификаторИБ, ИдентификаторКлючаАПИ) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта),
		НеЗаполнено(ИдентификаторИБ),
		НеЗаполнено(ИдентификаторКлючаАПИ));
		
	ПроверитьПараметры(
		НесоответствиеТипов(ИмяПродукта, "Строка"),
		НесоответствиеТипов(ИдентификаторИБ, "Строка"),
		НесоответствиеТипов(ИдентификаторКлючаАПИ, "Число"));
		
	ИдентификаторСтрокой = Формат(ИдентификаторКлючаАПИ, "ЧН=0; ЧГ=");
	
	Ответ = Delete("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/keys/" + ИдентификаторСтрокой);
	
	Возврат Неопределено;

КонецФункции

// Методы по работе с плагинами

Функция ВыбратьПлагины(ИмяПродукта, ИдентификаторИБ, ОтборПлагинов = Неопределено, Порядок = Неопределено) Экспорт

	ТипОбъекта = ПеречислениеТипыОбъектов.Плагин;
	
	ПараметрыПути = Новый ФиксированнаяСтруктура("product_name, customer_id", ИмяПродукта, ИдентификаторИБ);

	Отбор = ОтборПлагинов();
	Если НЕ ОтборПлагинов = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Отбор, ОтборПлагинов);
	КонецЕсли;
	Отбор = Новый ФиксированнаяСтруктура(Отбор);
	
	Возврат ВыбратьЭлементыСлужебный(ТипОбъекта, ПараметрыПути, Отбор, Порядок);
	
КонецФункции

// Создает новый плагин (подключаемый модуль)
//
// Параметры:
//  ИмяПродукта - Строка - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор базы
//  ЗапросСозданияПлагина - Структура - см. ЗапросСозданияПлагина
// 
// Возвращаемое значение:
//  Структура - см. Плагин
//
Функция СоздатьПлагин(ИмяПродукта, ИдентификаторИБ, ЗапросСозданияПлагина) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта), 
		НеЗаполнено(ИдентификаторИБ));
		
	ДанныеПлагина = ЗапросСозданияПлагина.Данные;
	Если ТипЗнч(ДанныеПлагина) = Тип("ДвоичныеДанные") Тогда
		ДанныеПлагина = Base64Строка(ДанныеПлагина);
	КонецЕсли;
		
	ДанныеЗапроса = Новый Соответствие;
	ДанныеЗапроса.Вставить("content_data", ДанныеПлагина);
	ДанныеЗапроса.Вставить("description", ЗапросСозданияПлагина.Описание);
	ДанныеЗапроса.Вставить("filename", ЗапросСозданияПлагина.ИмяФайла);
	ДанныеЗапроса.Вставить("plugin_type", ЗапросСозданияПлагина.Тип);
	ДанныеЗапроса.Вставить("hash_ext", НРег(ЗапросСозданияПлагина.ХешРасширения));
	
	Если ЗначениеЗаполнено(ЗапросСозданияПлагина.ХешРодителя) Тогда
		ДанныеЗапроса.Вставить("parent_md5hash", ЗапросСозданияПлагина.ХешРодителя);
	КонецЕсли;
	
	Ответ = PostJson("/v4/products/" + ИмяПродукта + "/customers/" + ИдентификаторИБ + "/plugins", ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);

	Возврат _РазобратьПлагин(Данные);
	
КонецФункции // СоздатьПлагин

// Изменяет существующий плагин (подключаемый модуль)
//
// Параметры:
//  ИмяПродукта - Строка - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор базы
//  ИдентификаторПлагина - Строка - Идентификатор плагина
//  ЗапросСозданияПлагина - Структура - см. ЗапросСозданияПлагина
// 
// Возвращаемое значение:
//  Структура - см. Плагин
//
Функция ИзменитьПлагин(ИмяПродукта, ИдентификаторИБ, ИдентификаторПлагина, ЗапросСозданияПлагина) Экспорт
	
	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта), 
		НеЗаполнено(ИдентификаторИБ), 
		НеЗаполнено(ИдентификаторПлагина));
		
	ДанныеПлагина = ЗапросСозданияПлагина.Данные;
	Если ТипЗнч(ДанныеПлагина) = Тип("ДвоичныеДанные") Тогда
		ДанныеПлагина = Base64Строка(ДанныеПлагина);
	КонецЕсли;
		
	ДанныеЗапроса = Новый Соответствие;
	ДанныеЗапроса.Вставить("content_data", ДанныеПлагина);
	ДанныеЗапроса.Вставить("description", ЗапросСозданияПлагина.Описание);
	ДанныеЗапроса.Вставить("filename", ЗапросСозданияПлагина.ИмяФайла);
	ДанныеЗапроса.Вставить("plugin_type", ЗапросСозданияПлагина.Тип);
	ДанныеЗапроса.Вставить("hash_ext", НРег(ЗапросСозданияПлагина.ХешРасширения));
	
	Если ЗначениеЗаполнено(ЗапросСозданияПлагина.ХешРодителя) Тогда
		ДанныеЗапроса.Вставить("parent_md5hash", ЗапросСозданияПлагина.ХешРодителя);
	КонецЕсли;
	
	АдресЗапроса = "/v4/products/" + ИмяПродукта 
					+ "/customers/" + ИдентификаторИБ 
					+ "/plugins/" + ИдентификаторПлагина;
	
	Ответ = PostJson(АдресЗапроса, ДанныеЗапроса);
	ПроверитьСостояниеHTTP(Ответ);
	Данные = КоннекторЛок.КакJson(Ответ);

	Возврат _РазобратьПлагин(Данные);
	
КонецФункции // СоздатьПлагин

