КонецПроцедуры // ПроверитьПараметры

Функция НесоответствиеТипов(Значение, ОписаниеТипов, ЗначениеПоУмолчанию = "!?I?*H") // BSLLS:DuplicateStringLiteral-off
	
	ОписаниеТиповСтрокой = ТипЗнч(ОписаниеТипов) = Тип("Строка");
	
	// Проверка умолчания
	
	Если ЗначениеПоУмолчанию = "!?I?*H"
		И ОписаниеТиповСтрокой
		И Найти(ОписаниеТиповСтрокой, "Неопределено") Тогда
		ЗначениеПоУмолчанию_ = Неопределено;
	Иначе
		ЗначениеПоУмолчанию_ = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеПоУмолчанию <> "!?I?*H"
		И Значение = ЗначениеПоУмолчанию Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Проверка типа
	
	Если ТипЗнч(ОписаниеТипов) = Тип("Строка") Тогда
		ТипыСтрокой = Стр.СтрРазделитьЛок(ОписаниеТипов, ",");
		ТипыМассив = Новый Массив;
		Для Каждого Элемент Из ТипыСтрокой Цикл
			ТипыМассив.Добавить(Тип(СокрЛП(Элемент)));
		КонецЦикла;
		ОписаниеТипов_ = Новый ОписаниеТипов(ТипыМассив);
	Иначе
		ОписаниеТипов_ = ОписаниеТипов;
	КонецЕсли;
	
	Если НЕ ОписаниеТипов_.СодержитТип(ТипЗнч(Значение)) Тогда
		Ошибка = ОшибкаТипа();
	Иначе
		Ошибка = Неопределено;
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции // НесоответствиеТипов

