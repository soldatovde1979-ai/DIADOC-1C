// Скачать данные плагина (подключаемого модуля)
//
// Параметры:
//  ИмяПродукта - Строка - Имя продукта
//  ИдентификаторИБ - Строка - Идентификатор базы
//  ИдентификаторПлагина - Строка - Идентификатор плагина
// 
// Возвращаемое значение:
//  ДвоичныеДанные - Данные плагина
//
Функция СкачатьПлагин(ИмяПродукта, ИдентификаторИБ, ИдентификаторПлагина) Экспорт

	ПроверитьПараметры(
		НеЗаполнено(ИмяПродукта), 
		НеЗаполнено(ИдентификаторИБ),
		НеЗаполнено(ИдентификаторПлагина));
		
	АдресРесурса = "/v4/products/" + ИмяПродукта 
					+ "/customers/" + ИдентификаторИБ 
