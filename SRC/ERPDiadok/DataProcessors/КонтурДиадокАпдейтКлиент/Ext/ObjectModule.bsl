Процедура ПроверитьСостояниеHTTP(Ответ)
	
	НегативноеСостояние = Ответ.КодСостояния >= КоннекторЛок.КодыСостоянияHTTP().ПеремещеноНавсегда_301;
	Если НегативноеСостояние Тогда
		Ошибка = ОшибкаСостоянияHTTP(Ответ.КодСостояния, Ответ);
		ВызватьИсключение Ошибка.Описание;
	КонецЕсли;
	
КонецПроцедуры // ПроверитьСостояниеHTTP

Функция ОшибкаСостоянияHTTP(КодСостояния = Неопределено, Ответ = Неопределено)
	
	Ошибка = ОшибкаЛок();
	Ошибка.Описание = НСтр("ru = 'Ошибка состояния'; sys = 'HTTPError'");
	
	Разделитель = Символы.ПС;
	
	Если НЕ КодСостояния = Неопределено Тогда
		
		Шаблон = СтрЗаменить("ru = '%2Код состояния: %1'; sys = '%1'", "%2", Разделитель);
		Ошибка.Описание = Ошибка.Описание + НСтр(СтрЗаменить(Шаблон, "%1", Формат(КодСостояния, "ЧГ=0"))); 
		
	КонецЕсли;
	
	Если НЕ Ответ = Неопределено Тогда
		
		TraceId = ПолучитьTraceId(Ответ);
		Если ЗначениеЗаполнено(TraceId) Тогда
			Шаблон = СтрЗаменить("ru = '%2TraceId: %1'; sys = ''", "%2", Разделитель);
			Ошибка.Описание = Ошибка.Описание + НСтр(СтрЗаменить(Шаблон, "%1", TraceId)); 
		КонецЕсли;
		
		РасширенноеОписание = ПолучитьРасширенноеОписаниеОшибкиHTTP(Ответ);
		Если ЗначениеЗаполнено(РасширенноеОписание) Тогда
			Шаблон = СтрЗаменить("ru = '%2Описание: %1'; sys = ''", "%2", Разделитель);
			Ошибка.Описание = Ошибка.Описание + НСтр(СтрЗаменить(Шаблон, "%1", РасширенноеОписание)); 
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции // ОшибкаСостоянияHTTP

Функция ПолучитьTraceId(Ответ)
	
	TraceId = Ответ.Заголовки.Получить("X-Kontur-Trace-Id");  
	
	Если ЗначениеЗаполнено(TraceId) Тогда  
		Возврат TraceId;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции // ПолучитьTraceIdОшибкиHTTP

Функция ПолучитьРасширенноеОписаниеОшибкиHTTP(Ответ)
	
	РасширенноеОписаниеОшибки = "";
	
	ContentType = Ответ.Заголовки.Получить("Content-Type");
	
	Если ContentType = "application/json" Тогда
		Данные = КоннекторЛок.КакJson(Ответ);
		ТекстОшибки = Данные.Получить("message");
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			РасширенноеОписаниеОшибки = ТекстОшибки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РасширенноеОписаниеОшибки;
	
КонецФункции // ПолучитьРасширенноеОписаниеОшибкиHTTP

Функция Сессия() Экспорт
	
