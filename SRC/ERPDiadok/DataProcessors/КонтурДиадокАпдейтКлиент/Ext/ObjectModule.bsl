Процедура ПроверитьПараметры(Параметр1 = Неопределено, Параметр2 = Неопределено, // BSLLS:NumberOfOptionalParams-off
		Параметр3 = Неопределено, Параметр4 = Неопределено,
		Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено)
	
	Ошибка = ОшибкаПараметра(Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7);
	Если Ошибка <> Неопределено Тогда
		ВызватьИсключение Ошибка.Описание;
