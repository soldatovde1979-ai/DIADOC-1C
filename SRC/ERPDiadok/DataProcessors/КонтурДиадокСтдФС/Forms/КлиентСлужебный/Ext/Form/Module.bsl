// НачатьПомещениеФайлаНаСервер

&НаКлиенте
Процедура НачатьПомещениеФайлаНаСерверЛок(ОписаниеОповещенияОЗавершении = Неопределено, // BSLLS:OrderOfParams-off
		ОписаниеОповещенияОХодеВыполнения = Неопределено, // Соответствует оригинальной сигнатуре
		ОписаниеОповещенияПередНачалом = Неопределено,
		Адрес = Неопределено,
		Знач ПутьКФайлуПараметрыДиалога,
		УникальныйИдентификаторФормы = Неопределено) Экспорт
	
	// 8.2
	Если ТипЗнч(ОписаниеОповещенияОЗавершении) = Тип("ФиксированнаяСтруктура") Тогда
		
		ВыбранноеИмяФайла = Неопределено;
		
		НачатьПомещениеФайлаНаСерверОбработкаИсточникаФайла(ВыбранноеИмяФайла, ПутьКФайлуПараметрыДиалога);
		
		Если ВыбранноеИмяФайла = Неопределено Тогда
			ОтказОтПомещенияФайла = Истина;
		Иначе
			
			СсылкаНаФайл = СсылкаНаФайл(Новый Файл(ВыбранноеИмяФайла));
			
			ОтказОтПомещенияФайла = Ложь;
			
			МассивПараметров = Новый Массив;
			МассивПараметров.Добавить(СсылкаНаФайл);
			МассивПараметров.Добавить(ОтказОтПомещенияФайла);
			
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияСлужебный(
				ОписаниеОповещенияПередНачалом, МассивПараметров);
			
			ОтказОтПомещенияФайла = МассивПараметров[1];
			
		КонецЕсли;
		
		Если НЕ ОтказОтПомещенияФайла = Истина Тогда
			
			Адрес = Неопределено;
			ПоместитьФайл(Адрес, ВыбранноеИмяФайла, , Ложь, УникальныйИдентификаторФормы);
			ПомещаемыйФайл = ОписаниеПомещенногоФайла(Адрес, ОтказОтПомещенияФайла, СсылкаНаФайл);
			
		Иначе
			ПомещаемыйФайл = Неопределено;
		КонецЕсли;
		
		СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, ПомещаемыйФайл);
		
	Иначе
		
		Контекст = Новый Структура;
		Контекст.Вставить("ОписаниеОповещенияОЗавершении", ОписаниеОповещенияОЗавершении);
		Контекст.Вставить("ОписаниеОповещенияОХодеВыполнения", ОписаниеОповещенияОХодеВыполнения);
		Контекст.Вставить("ОписаниеОповещенияПередНачалом", ОписаниеОповещенияПередНачалом);
		Контекст.Вставить("Адрес", Адрес);
		Контекст.Вставить("ПутьКФайлуПараметрыДиалога", ПутьКФайлуПараметрыДиалога);
		Контекст.Вставить("УникальныйИдентификаторФормы", УникальныйИдентификаторФормы);
		
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьПомещениеФайлаНаСерверПослеПроверкиРасширения", ЭтаФорма, Контекст);
		ПодключитьУстановитьРасширениеРаботыСФайлами(Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры // НачатьПомещениеФайлаНаСерверЛок

&НаКлиенте
Процедура НачатьПомещениеФайлаНаСерверПослеПроверкиРасширения(РасширениеПодключено, Контекст) Экспорт
	
	ПутьКФайлуПараметрыДиалога = Контекст.ПутьКФайлуПараметрыДиалога;
	
	Если СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.15") Тогда
		
		СтдФССлужебный8315().НачатьПомещениеФайлаНаСерверЛок(Контекст.ОписаниеОповещенияОЗавершении,
			Контекст.ОписаниеОповещенияОХодеВыполнения,
			Контекст.ОписаниеОповещенияПередНачалом,
			Контекст.Адрес,
			ПутьКФайлуПараметрыДиалога,
			Контекст.УникальныйИдентификаторФормы);
		
	Иначе
		
		КонтекстЗавершения = Новый Структура;
		КонтекстЗавершения.Вставить("ОписаниеОповещенияОЗавершении", Контекст.ОписаниеОповещенияОЗавершении);
		
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьПомещениеФайлаНаСерверПослеПомещенияФайлаДо8_3_15", ЭтаФорма, КонтекстЗавершения);
		
		Если СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.13") Тогда
			
			Если ТипЗнч(ПутьКФайлуПараметрыДиалога) = Тип("ФиксированнаяСтруктура") Тогда
				
				ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
				ДиалогОткрытияФайла.Заголовок = ПутьКФайлуПараметрыДиалога.Заголовок;
				ДиалогОткрытияФайла.МножественныйВыбор = ПутьКФайлуПараметрыДиалога.МножественныйВыбор;
				ДиалогОткрытияФайла.Фильтр = ПутьКФайлуПараметрыДиалога.Фильтр;
				
				ПутьКФайлуПараметрыДиалога = ДиалогОткрытияФайла;
				
				Интерактивно = Истина;
				
			Иначе
				Интерактивно = Ложь;
			КонецЕсли;
			
			СтдФССлужебный83().НачатьПомещениеФайлаЛок(Оповещение,
				Контекст.Адрес,
				ПутьКФайлуПараметрыДиалога,
				Интерактивно,
				Контекст.УникальныйИдентификаторФормы,
				Контекст.ОписаниеОповещенияПередНачалом);
			
			// от 8.3.6
		Иначе
			
			Интерактивно = Ложь;
			
			Если ТипЗнч(ПутьКФайлуПараметрыДиалога) = Тип("ФиксированнаяСтруктура") Тогда
				Интерактивно = Истина;
			КонецЕсли;
			
			СтдФССлужебный83().НачатьПомещениеФайлаЛок(Оповещение,
				Контекст.Адрес,
				ПутьКФайлуПараметрыДиалога,
				Интерактивно,
				Контекст.УникальныйИдентификаторФормы);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // НачатьПомещениеФайлаНаСерверПослеПроверкиРасширения

&НаКлиенте
Процедура НачатьПомещениеФайлаНаСерверПослеПомещенияФайлаДо8_3_15(Результат, Адрес, ПомещаемыйФайл, Контекст) Экспорт
	
	Если Результат = Истина Тогда
		
		СсылкаНаФайл = СсылкаНаФайл(Новый Файл(ПомещаемыйФайл));
		ОтказОтПомещенияФайла = Ложь;
		
		ПомещаемыйФайл = ОписаниеПомещенногоФайла(Адрес, ОтказОтПомещенияФайла, СсылкаНаФайл);
		
	Иначе
		
		ПомещаемыйФайл = Неопределено;
		
	КонецЕсли;
	
	СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(Контекст.ОписаниеОповещенияОЗавершении,
		ПомещаемыйФайл);
	
КонецПроцедуры // НачатьПомещениеФайлаНаСерверПослеПомещенияФайлаДо8_3_15

// НачатьПолучениеФайлаССервераСДиалогом

&НаКлиенте
Процедура НачатьПолучениеФайлаССервераСДиалогомЛок(Адрес, ИмяФайла = Неопределено,
		ПараметрыДиалога = Неопределено) Экспорт
	
	Если НЕ СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.15") Тогда
		
		ПолучитьФайл(Адрес, ИмяФайла, Истина);
		
	Иначе
		
		СтдФССлужебный8315().НачатьПолучениеФайлаССервераСДиалогом(Адрес, ИмяФайла, ПараметрыДиалога);
		
	КонецЕсли;
	
