&НаКлиенте
Функция ПараметрыДиалогаПомещенияФайлов(Заголовок = Неопределено,
		МножественныйВыбор = Ложь,
		Фильтр = Неопределено,
		ИндексФильтра = 0) Экспорт
	
	Попытка
		ПараметрыДиалога = Новый(Тип("ПараметрыДиалогаПомещенияФайлов"));
		ПараметрыДиалога.Заголовок = Заголовок;
		ПараметрыДиалога.МножественныйВыбор = МножественныйВыбор;
		ПараметрыДиалога.Фильтр = Фильтр;
		ПараметрыДиалога.ИндексФильтра = ИндексФильтра;
	Исключение
		ПараметрыДиалога = Новый Структура;
		ПараметрыДиалога.Вставить("Заголовок", Заголовок);
		ПараметрыДиалога.Вставить("МножественныйВыбор", МножественныйВыбор);
		ПараметрыДиалога.Вставить("Фильтр", Фильтр);
		ПараметрыДиалога.Вставить("ИндексФильтра", ИндексФильтра);
		ПараметрыДиалога = Новый ФиксированнаяСтруктура(ПараметрыДиалога);
	КонецПопытки;
	
	Возврат ПараметрыДиалога;
	
КонецФункции // ПараметрыДиалогаПомещенияФайлов

&НаКлиенте
Функция ПараметрыДиалогаПолученияФайлов(Заголовок = Неопределено,
		ВыборКаталога = Неопределено,
		Каталог = Неопределено) Экспорт
	
	Попытка
		ПараметрыДиалога = Новый(Тип("ПараметрыДиалогаПолученияФайлов"));
		ПараметрыДиалога.Заголовок = Заголовок;
		ПараметрыДиалога.ВыборКаталога = ВыборКаталога;
		ПараметрыДиалога.Каталог = Каталог;
	Исключение
		ПараметрыДиалога = Новый Структура(
				"Заголовок, ВыборКаталога, Каталог",
				Заголовок, ВыборКаталога, Каталог);
		ПараметрыДиалога = Новый ФиксированнаяСтруктура(ПараметрыДиалога);
	КонецПопытки;
	
	Возврат ПараметрыДиалога;
	
КонецФункции // ПараметрыДиалогаПолученияФайлов

&НаКлиенте
Функция ОписаниеПомещенногоФайла(Адрес, ПомещениеФайлаОтменено, СсылкаНаФайл) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Адрес", Адрес);
	Результат.Вставить("ПомещениеФайлаОтменено", ПомещениеФайлаОтменено);
	Результат.Вставить("СсылкаНаФайл", СсылкаНаФайл);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции // ОписаниеПомещенногоФайла

&НаКлиенте
Функция ОписаниеПереданногоФайла(ПутьКФайлу, Адрес) Экспорт
	
	Файл = Новый Файл(ПутьКФайлу);
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторФайла", Новый УникальныйИдентификатор);
	Результат.Вставить("Имя", Файл.Имя);
	Результат.Вставить("ПолноеИмя", Файл.ПолноеИмя);
	Результат.Вставить("Хранение", Адрес);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции // ОписаниеПереданногоФайла

&НаКлиенте
Функция СсылкаНаФайл(Файл) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторФайла", Новый УникальныйИдентификатор());
	Результат.Вставить("Имя", Файл.Имя);
	Результат.Вставить("Расширение", Файл.Расширение);
	Результат.Вставить("Файл", Файл);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции // СсылкаНаФайл

// НачатьПолучениеКаталогаВременныхФайлов

&НаКлиенте
Процедура НачатьПолучениеКаталогаВременныхФайловЛок(ИсходноеОповещение) Экспорт
	
	Если ТипЗнч(ИсходноеОповещение) = Тип("ФиксированнаяСтруктура") Тогда
		ИмяКаталогаВременныхФайлов = КаталогВременныхФайлов(); // BSLLS:TempFilesDir-off
		СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ИсходноеОповещение, ИмяКаталогаВременныхФайлов);
	Иначе
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьПолучениеКаталогаВременныхФайловПослеПроверкиРасширения",
				ЭтаФорма, ИсходноеОповещение);
		ПодключитьУстановитьРасширениеРаботыСФайлами(Оповещение);
	КонецЕсли;
	
КонецПроцедуры // НачатьПолучениеКаталогаВременныхФайловЛок

&НаКлиенте
Процедура НачатьПолучениеКаталогаВременныхФайловПослеПроверкиРасширения(РасширениеПодключено,
		ИсходноеОповещение) Экспорт
	
	Если РасширениеПодключено Тогда
		СтдФССлужебный83().НачатьПолучениеКаталогаВременныхФайловЛок(ИсходноеОповещение);
	Иначе
		ОбработатьОтсутствиеРасширенияРаботыСФайлами();
	КонецЕсли;
	
КонецПроцедуры // НачатьПолучениеКаталогаВременныхФайловПослеПроверкиРасширения

// НачатьПолучениеИмениВременногоФайла

&НаКлиенте
Процедура НачатьПолучениеИмениВременногоФайлаЛок(ИсходноеОповещение, Расширение = Неопределено) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("Оповещение", ИсходноеОповещение);
	Контекст.Вставить("Расширение", Расширение);
	
	#Если ВебКлиент Тогда
	Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
			"НачатьПолучениеИмениВременногоФайлаПослеПроверкиРасширения", ЭтаФорма, Контекст);
	ПодключитьУстановитьРасширениеРаботыСФайлами(Оповещение);
	#Иначе
	ИмяВремФайла = ПолучитьИмяВременногоФайла(Расширение); // BSLLS:MissingTemporaryFileDeletion-off файл не создается
	СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ИсходноеОповещение, ИмяВремФайла);
	#КонецЕсли
	
КонецПроцедуры // НачатьПолучениеИмениВременногоФайлаЛок

&НаКлиенте
Процедура НачатьПолучениеИмениВременногоФайлаПослеПроверкиРасширения(РасширениеПодключено, Контекст) Экспорт
	
	Если РасширениеПодключено Тогда
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьПолучениеИмениВременногоФайлаПослеПолученияВременногоКаталога", ЭтаФорма, Контекст);
		НачатьПолучениеКаталогаВременныхФайловЛок(Оповещение);
	Иначе
		ОбработатьОтсутствиеРасширенияРаботыСФайлами();
	КонецЕсли;
	
КонецПроцедуры // НачатьПолучениеИмениВременногоФайлаПослеПроверкиРасширения

&НаКлиенте
Процедура НачатьПолучениеИмениВременногоФайлаПослеПолученияВременногоКаталога(ИмяКаталогаВременныхФайлов,
		Контекст) Экспорт
	
	Оповещение = Контекст.Оповещение;
	Расширение = Контекст.Расширение;
	
	Если НЕ Прав(ИмяКаталогаВременныхФайлов, 1) = "\" Тогда
		ИмяКаталогаВременныхФайлов = ИмяКаталогаВременныхФайлов + "\";
	КонецЕсли;
	
	ИмяВременногоФайла = ИмяКаталогаВременныхФайлов + Строка(Новый УникальныйИдентификатор);
	
	Если НЕ ПустаяСтрока(Расширение) Тогда
		Если НЕ Лев(Расширение, 1) = "." Тогда
			ИмяВременногоФайла = ИмяВременногоФайла + ".";
		КонецЕсли;
		ИмяВременногоФайла = ИмяВременногоФайла + Расширение;
	КонецЕсли;
	
	СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(Оповещение, ИмяВременногоФайла);
	
КонецПроцедуры // НачатьПолучениеИмениВременногоФайлаПослеПолученияВременногоКаталога

// НачатьЗаписьДвоичныхДанных

&НаКлиенте
Процедура НачатьЗаписьДвоичныхДанныхЛок(ДвоичныеДанные, ИсходноеОповещение, ИмяФайла) Экспорт
	
	Если ТипЗнч(ИсходноеОповещение) = Тип("ФиксированнаяСтруктура") Тогда
		ДвоичныеДанные.Записать(ИмяФайла);
		СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ИсходноеОповещение);
	Иначе
		
		Контекст = Новый Структура;
		Контекст.Вставить("Оповещение", ИсходноеОповещение);
		Контекст.Вставить("ДвоичныеДанные", ДвоичныеДанные);
		Контекст.Вставить("ИмяФайла", ИмяФайла);
		
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьЗаписьДвоичныхДанныхПослеПроверкиРасширения", ЭтаФорма, Контекст);
		ПодключитьУстановитьРасширениеРаботыСФайлами(Оповещение);
		
	КонецЕсли;
	
КонецПроцедуры // НачатьЗаписьДвоичныхДанныхЛок

&НаКлиенте
Процедура НачатьЗаписьДвоичныхДанныхПослеПроверкиРасширения(РасширениеПодключено, Контекст) Экспорт
	
	Если РасширениеПодключено Тогда
		Контекст.ДвоичныеДанные.НачатьЗапись(Контекст.Оповещение, Контекст.ИмяФайла);
	Иначе
		ОбработатьОтсутствиеРасширенияРаботыСФайлами();
	КонецЕсли;
	
КонецПроцедуры // НачатьЗаписьДвоичныхДанныхПослеПроверкиРасширения

