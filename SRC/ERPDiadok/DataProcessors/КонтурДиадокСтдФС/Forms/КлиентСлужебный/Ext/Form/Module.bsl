// НачатьПолучениеФайлаССервераБезДиалога

&НаКлиенте
Процедура НачатьПолучениеФайлаССервераБезДиалогаЛок(// Сигнатура соответствует оригиналу
		ОписаниеОповещенияОЗавершении = Неопределено, Адрес, ПутьКФайлу) Экспорт // BSLLS:OrderOfParams-off
	
	Если НЕ СтдКлиентЛок.Стр().ВерсияПлатформыБольшеИлиРавна("8.3.15") Тогда
		
		#Если ВебКлиент Тогда
		ПолучитьФайл(Адрес, ПутьКФайлу, Истина); // В веб клиенте всегда Интерактивно = Истина
		
		#Иначе
		ПолучитьФайл(Адрес, ПутьКФайлу, Ложь);
		#КонецЕсли
		
		Если НЕ ОписаниеОповещенияОЗавершении = Неопределено Тогда
			ОписаниеФайла = ОписаниеПереданногоФайла(ПутьКФайлу, Адрес);
			СтдКлиентЛок.ОбщегоНазначения().ВыполнитьОбработкуОповещенияЛок(ОписаниеОповещенияОЗавершении, ОписаниеФайла);
		КонецЕсли;
		
	Иначе
		
		#Если ВебКлиент Тогда
		Контекст = Новый Структура;
		Контекст.Вставить("ОписаниеОповещенияОЗавершении", ОписаниеОповещенияОЗавершении);
		Контекст.Вставить("Адрес", Адрес);
		Контекст.Вставить("ПутьКФайлу", ПутьКФайлу);
		
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьПолучениеФайлаССервераБезДиалогаПослеПроверкиРасширения", ЭтаФорма, Контекст);
		ПодключитьУстановитьРасширениеРаботыСФайлами(Оповещение);
		#Иначе
		СтдФССлужебный8315().НачатьПолучениеФайлаССервераБезДиалога(ОписаниеОповещенияОЗавершении, Адрес, ПутьКФайлу);
		#КонецЕсли
		
	КонецЕсли;
	
КонецПроцедуры // НачатьПолучениеФайлаССервераБезДиалогаЛок

&НаКлиенте
Процедура НачатьПолучениеФайлаССервераБезДиалогаПослеПроверкиРасширения(РасширениеПодключено, Контекст) Экспорт
	
	Если РасширениеПодключено Тогда
		СтдФССлужебный8315().НачатьПолучениеФайлаССервераБезДиалога(Контекст.ОписаниеОповещенияОЗавершении,
			Контекст.Адрес,
			Контекст.ПутьКФайлу);
	Иначе
		ОбработатьОтсутствиеРасширенияРаботыСФайлами();
	КонецЕсли;
	
