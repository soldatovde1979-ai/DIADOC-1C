		Контекст.Вставить("ИмяФайлаПриемника", ИмяФайлаПриемника);
		
		Оповещение = СтдКлиентЛок.ОбщегоНазначения().ОписаниеОповещения(
				"НачатьКопированиеФайлаПослеПроверкиРасширения", ЭтаФорма, Контекст);
		ПодключитьУстановитьРасширениеРаботыСФайлами(Оповещение);
		
	КонецЕсли;
	
