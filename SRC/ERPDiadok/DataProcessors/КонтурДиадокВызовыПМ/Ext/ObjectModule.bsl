// Приводит описание типа документа к контракту ТипЭлектронногоДокумента.
// Описание типа документа можно передавать в одном из двух форматов:
//  * структура ВидДокументаРазвернутый - как в событии ПодготовитьЭлектронныйДокумент
//  * поле Тип структуры Документ - как в событии ПолучитьЗаполненныйОбъектДокумента1С
//
// Параметры:
//  ОписаниеТипаЭД - Структура, ФиксированнаяСтруктура - 
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. Контракт_ТипЭлектронногоДокумента
//
Функция ФорматыЭД_ТипЭлектронногоДокумента(ОписаниеТипаЭД)
	
	ТипПараметра = ТипЗнч(ОписаниеТипаЭД);
	
	Если ТипПараметра <> Тип("Структура")
		И ТипПараметра <> Тип("ФиксированнаяСтруктура") Тогда
		
		Ошибка = Общее_ПараметрыВСтроку(
			"ФорматыЭД_ТипЭлектронногоДокумента: Параметр ""ОписаниеТипаЭД"" имеет недопустимый тип (%1)
			|Ожидается Структура или ФиксированнаяСтруктура",
			Строка(ТипПараметра)
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Если ФорматыЭД_ЭтоДокументТип(ОписаниеТипаЭД) Тогда
		
		ТипКонтента = ОписаниеТипаЭД.ТипКонтента;
		ТипДокумента = ОписаниеТипаЭД.ТипДокумента;
		ФункцияДокумента = ОписаниеТипаЭД.ФункцияДокумента;
		
	ИначеЕсли ФорматыЭД_ЭтоВидДокументаРазвернутый(ОписаниеТипаЭД) Тогда
		
		ТипКонтента = ОписаниеТипаЭД.FormatVersion;
		ТипДокумента = ОписаниеТипаЭД.TypeNamedId;
		ФункцияДокумента = ОписаниеТипаЭД.FunctionName;
		
	Иначе
		
		Ошибка = Общее_ПараметрыВСтроку(
			"ФорматыЭД_ТипЭлектронногоДокумента: Недопустимое значение параметра ""ОписаниеТипаЭД""
			|Ожидается контракт ВидДокументаРазвернутый или Документ.Тип",
			Строка(ТипПараметра)
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Результат = Новый_ТипЭлектронногоДокумента(
		ТипКонтента,
		ТипДокумента,
		ФункцияДокумента
	);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что переданный параметр соответствует структуре "ВидДокументаРазвернутый"
//
// Параметры:
//  ОписаниеТипаЭД - Структура, ФиксированнаяСтруктура - описание типа электронного документа
// 
// Возвращаемое значение:
//  Булево - Истина, если это ВидДокументаРазвернутый
//
Функция ФорматыЭД_ЭтоВидДокументаРазвернутый(ОписаниеТипаЭД)
	
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("FormatVersion");
	ИменаПолей.Добавить("TypeNamedId");
	ИменаПолей.Добавить("FunctionName");
	
	Результат = Истина;
	
	Для Каждого Ключ Из ИменаПолей Цикл
		
		Если Не ОписаниеТипаЭД.Свойство(Ключ) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, что переданный параметр внутреннему контракту "Документ.Тип"
//
// Параметры:
//  ОписаниеТипаЭД - Структура, ФиксированнаяСтруктура - описание типа электронного документа
// 
// Возвращаемое значение:
//  Булево - Истина, если это ВидДокументаРазвернутый
//
Функция ФорматыЭД_ЭтоДокументТип(ОписаниеТипаЭД)
	
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ТипКонтента");
	ИменаПолей.Добавить("ТипДокумента");
	ИменаПолей.Добавить("ФункцияДокумента");
	
	Результат = Истина;
	
	Для Каждого Ключ Из ИменаПолей Цикл
		
		Если Не ОписаниеТипаЭД.Свойство(Ключ) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Конструктор структуры ТипЭлектронногоДокумента
//
// Параметры:
//  ТипКонтента - Строка - идентификатор базового формата (короткое представление поля Version структуры FullVersion)
//  ТипДокумента - Строка - идентификатор типа документа (TypeNamedId)
//  ФункцияДокумента - Строка - функция документа. Допускается передавать значение функции
//                              как во внутреннем формате (как в системе хранения), так и
//                              в "сыром" виде (как в ответе метода GetDocumentTypes)
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. Контракт_ТипЭлектронногоДокумента
//
Функция Новый_ТипЭлектронногоДокумента(Знач ТипКонтента, Знач ТипДокумента, Знач ФункцияДокумента)
	
	Модель = Контракт_ТипЭлектронногоДокумента();
	Модель.ТипКонтента = НРег(ТипКонтента);
	Модель.ТипДокумента = ТипДокумента;
	Модель.ФункцияДокумента = Ядро.Документы_ФункцияДокументаДляХранения(ФункцияДокумента);
	
	Результат = Новый ФиксированнаяСтруктура(Модель);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, содержит ли электронный документ сведения о маркируемой продукции
//
// Параметры:
//  ИнформацияОДокументе - Строка - Имя файла XML
//                       - Структура - описание электронного документа (см. Контракт_Документ)
// 
// Возвращаемое значение:
//  Булево - Истина, в файле XML передаются коды маркировки
//
Функция Документы_ЕстьМаркируемаяПродукция(ИнформацияОДокументе) Экспорт
	
	ТипПараметра = ТипЗнч(ИнформацияОДокументе);
	
	Если ТипПараметра = Тип("Строка") Тогда
		
		ИмяФайлаВложения = ИнформацияОДокументе;
		
	ИначеЕсли ТипПараметра = Тип("Структура") Тогда
		
		ИмяФайлаВложения = ИнформацияОДокументе.ИмяФайла;
		
	Иначе
		
		Ошибка = НСтр(
			"ru = 'Несоответствие типов: Неожиданный тип параметра ""ИнформацияОДокументе"" (%1)';
			|sys = 'TypeError: Неожиданный тип параметра ""ИнформацияОДокументе"" (%1)'"
		);
		
		Ошибка = ЭДО_Служебные_ПодставитьПараметрыВСтроку(Ошибка, Строка(ТипПараметра));
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	НормализованноеИмяФайла = СокрЛП(ВРег(ИмяФайлаВложения));
	
	Результат = Ложь;
	
	Если Прав(НормализованноеИмяФайла, 4) = ".XML" Тогда
		
		ИдФайл = Лев(НормализованноеИмяФайла, СтрДлина(НормализованноеИмяФайла) - 4);
		Результат = _ЕстьМаркируемаяПродукцияСлужебный(ИдФайл);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбирает идентификатор XML-файла и определяет по нему, содержит ли файл сведения о маркируемой продукции:
// * В форматах 820@ (УПД, СФ, накладная, акт), 736@ (УКД, КСФ) и 423@ (Торг-2) префикс ИдФайл заканчивается на "MARK"
// * В формате 691@ (КС-2, КС-3) ИдФайл содержит префикс ON_AKTREZRABPXX, где XX = "01"
// * В формате 970@ (УПД, СФ, накладная, акт) ИдФайл имеет вид R_T_A_O_GGGGMMDD_N1_N2_N3_N4_N5_N6_N7, где N2 - признак маркировки
//
// Параметры:
//  ИдФайл - Строка - Идентификатор файла
// 
// Возвращаемое значение:
//  Булево.
//
Функция _ЕстьМаркируемаяПродукцияСлужебный(Знач ИдФайл)
	
	ПрефиксМарк820 = "ON_NSCHFDOPPRMARK_";
	ПрефиксМарк736 = "ON_NKORSCHFDOPPRMARK_";
	ПрефиксМарк691 = "ON_AKTREZRABP01_";
	ПрефиксМарк423 = "DP_PRIRASXPRINMARK_";
	
	Префикс970 = "ON_NSCHFDOPPR_";
	
	Если Найти(ИдФайл, ПрефиксМарк820) = 1
		Или Найти(ИдФайл, ПрефиксМарк736) = 1
		Или Найти(ИдФайл, ПрефиксМарк423) = 1
		Или Найти(ИдФайл, ПрефиксМарк691) = 1 Тогда
		
		Результат = Истина;
		
	ИначеЕсли Найти(ИдФайл, Префикс970) = 1 Тогда
		
		Результат = Ложь;
		
		ЧастиИдФайл = ЭДО_Служебные_РазложитьСтрокуВМассивСлов(ИдФайл, "_", Истина);
		
		// В формате 820 может быть такой же префикс, но в отличие от 970 ИдФайл состоит из 6 частей
		Если ЧастиИдФайл.Количество() = 12 Тогда
			
			ПризнакМаркируемаяПродукция = ЧастиИдФайл[7]; // N3
			Результат = (ПризнакМаркируемаяПродукция = "1");
			
		КонецЕсли;
		
	Иначе
		
		Результат = Ложь;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Пакет, 
																Документ1С, 
																ВидДокументаСтрокой, 
																ДополнительныеПараметры = Неопределено) Экспорт
	
	Результат = Ядро.Пакеты_ДобавитьДокументВПакет(Пакет, Документ1С, ВидДокументаСтрокой, ДополнительныеПараметры);
		
	Возврат Результат;	
	
