// Позволяет отправить приглашения контрагентам
//
// Параметры:
//  Организация			 - 	 - Ссылка	 - Ссылка, содержащая данные об организации, от лица которой осуществляется приглашение
//  МассивКонтрагентов	 - 	 - Массив	 - Массив ссылок с данными о приглашаемых контрагентах
//  ТекстПриглашения	 - 	 - Строка	 - Строка с текстом приглашения
//  InvitationDocument	 - 	 - Структура:
//		* FileName					 - Строка - Имя файла приглашения
//		* SignedContent				 - Структура:
//			* Content - ДвоичныеДанные - Двоичные данные файла приглашения
//			* Signature - ДвоичныеДанные - Двоичные данные подписи файла приглашения
//		* ЗапрашиватьОтветнуюПодпись - Булево - параметр, определяющий запрос подписи файла приглашения
//	Статус				 - 	 - Строка	 - Статус контрагентов в сервисе (см. Ядро.Перечисление_СтатусыКонтрагентов)
// 
// Возвращаемое значение:
// Массив приглашенных контрагентов
//
Функция ЭДО_Контрагенты_Пригласить(ОрганизацияСсылка, МассивСсылокКонтрагентов, ТекстПриглашения, InvitationDocument = Неопределено, Статус) Экспорт
	
	Организация = Организации_ЗаполненныеРеквизиты(ОрганизацияСсылка);
	
	МассивКонтрагентов = Новый Массив;
	
	Для Каждого Ссылка Из МассивСсылокКонтрагентов Цикл
		
		Контрагент = Контрагенты_ЗаполненныеРеквизиты(Ссылка);
		
		МассивКонтрагентов.Добавить(Контрагент);
		
	КонецЦикла;
	
	ПараметрыПриглашения = Новый Структура;
	
	ПараметрыПриглашения.Вставить("ТекстПриглашения", ТекстПриглашения);
	
	Если InvitationDocument <> Неопределено Тогда
		
		Если InvitationDocument.Свойство("FileName") Тогда
			ПараметрыПриглашения.Вставить("ИмяФайла", InvitationDocument.FileName);
		КонецЕсли;
		
		Если InvitationDocument.Свойство("SignedContent") Тогда
			ПараметрыПриглашения.Вставить("ДвоичныеДанныеФайла", InvitationDocument.SignedContent.Content);
			ПараметрыПриглашения.Вставить("ДвоичныеДанныеПодписи", InvitationDocument.SignedContent.Signature);
		КонецЕсли;
		
		ПараметрыПриглашения.Вставить("ЗапрашиватьОтветнуюПодпись", InvitationDocument.SignatureRequested);
		
	КонецЕсли;
	
	РезультатОтправкиПриглашений = Ядро.Контрагенты_ОтправитьПриглашение(Организация, МассивКонтрагентов, ПараметрыПриглашения);
	
	Результат = РезультатОтправкиПриглашений.ПриглашенныеКонтрагенты;
	
	Ядро.Контрагенты_ЗаписатьСтатусДляМассиваКонтрагентов(Организация, Результат, Статус);
	
	Возврат Результат;
	
КонецФункции

