Функция ПодписатьДанныеНаСервере(ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера = "") Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	
	ДвоичныеДанныеПодписи = Ядро.ПодписатьДанные(ДвоичныеДанные, ОтпечатокСертификата, ПарольКонтейнера);
	
	Если ДвоичныеДанныеПодписи <> Неопределено Тогда
