// Получает двоичные данные xml-файл отказа в подписании документа или предложения для аннулирования.
//
// Параметры:
//  Идентификаторы	 - Структура	- содержит идентификаторы сущности, для которой генерируется отказ
//  ПричинаОтказа	 - Строка	 	- причина отказа в подписи
//  Отправитель		 - Структура	- данные отправителя (Фамилия, Имя, Отчество)
// 
// Возвращаемое значение:
//   - ДвоичныеДанные
//
Функция ЭДО_СгенерироватьФайлОтказа(Идентификаторы, ПричинаОтказа = Неопределено, Отправитель = Неопределено) Экспорт
	
	BoxId = Идентификаторы.BoxId;
	MessageId = Идентификаторы.MessageId;
	EntityId = Идентификаторы.EntityId;
	
	ФормироватьУС = Ядро.УС_ДоступноФормированиеУниверсальныхСообщений(BoxId);
	
	Если ФормироватьУС = Неопределено Тогда
		
		ОтпечатокСертификата = Идентификаторы.ОтпечатокСертификата;
		Результат = Ядро.Документы_ДанныеОтказаВПодписании(Идентификаторы, ОтпечатокСертификата, ПричинаОтказа);
		
	ИначеЕсли ФормироватьУС = Истина Тогда
		
		ДанныеСообщения = Ядро.Контракт_ДанныеУниверсальногоСообщения();
		
		ДанныеСообщения.Код = Ядро.Перечисление_КодыУниверсальногоСообщения().ОтказВПодписи;
		ДанныеСообщения.ТекстСообщения = ПричинаОтказа;
		
		Если ТипЗнч(Отправитель) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(ДанныеСообщения.Отправитель, Отправитель);
		Иначе
			Ядро.УС_ЗаполнитьДанныеОтправителяПоКонтексту(BoxId, ДанныеСообщения);
		КонецЕсли;
		
		Результат = Ядро.УС_УниверсальноеСообщение(BoxId, MessageId, EntityId, ДанныеСообщения);
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает контракт участника обмена универсальными сообщениями
// 
// Возвращаемое значение:
//   - Структура
//
Функция Контракт_УчастникОбменаУниверсальнымиСообщениями() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Фамилия");
	Результат.Вставить("Имя");
	Результат.Вставить("Отчество");
	Результат.Вставить("Должность");
	
	Возврат Результат;
	
КонецФункции

