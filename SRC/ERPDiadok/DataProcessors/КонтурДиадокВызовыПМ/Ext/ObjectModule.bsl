Процедура ДобавитьДвоичныйКонтентАннулированияОтказаВАннулировании(МассивИдентификаторов, Комментарий, Действие) Экспорт 
	
	Для Каждого Идентификаторы Из МассивИдентификаторов Цикл
		
		Для Каждого СтруктураДокумента Из Идентификаторы.Documents Цикл
			
			Документ1С	= СтруктураДокумента.Документ1С;
			Документ	= Документы_СохраненныйДокумент(Документ1С);
			
			Если Действие = "Отказать"
				ИЛИ Действие = "ОтказатьВАннулировании" Тогда				
				
				Документ.СлужебнаяИнформация.Вставить("КонтентОтвета", Комментарий);
				
				ОтказОтПредложения = Ядро.Документы_ОтказОтПредложенияОбАннулировании(Документ);
				
				EntityId	= ОтказОтПредложения.ЭлементКоллекции.Attachment.ParentEntityId;
				Content		= ОтказОтПредложения.ЭлементКоллекции.Данные;
				
			ИначеЕсли СтруктураДокумента.Статус = "Требуется аннулирование" Тогда
				
				ПредложениеОбАннулировании = Ядро.Документы_ПредложениеОбАннулировании(Документ);
				
				EntityId	= ПредложениеОбАннулировании.Описание;
				Content		= ПредложениеОбАннулировании.Данные;
				
			Иначе
				
				Документ.СлужебнаяИнформация.Вставить("КонтентОтвета", Комментарий);
				
				НовоеПредложениеОбАннулировании = Ядро.Документы_НовоеПредложениеОбАннулировании(Документ);
				
				EntityId	= СтруктураДокумента.DocumentId;
				Content		= НовоеПредложениеОбАннулировании.ЭлементКоллекции.Данные;
				
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(EntityId) Тогда
				ТекстОшибки = НСтр("ru = 'Не удалось найти предложение об аннулировании для документа %1'");
				ТекстОшибки = ЭДО_Служебные_ПодставитьПараметрыВСтроку(ТекстОшибки, Документ1С);
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			Если Content = Неопределено Тогда
				ТекстОшибки = НСтр("ru = 'Не удалось найти предложение об аннулировании для документа %1'");
				ТекстОшибки = ЭДО_Служебные_ПодставитьПараметрыВСтроку(ТекстОшибки, Документ1С);
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
				
			СтруктураДокумента.Вставить("Content",		Base64Строка(Content));
			СтруктураДокумента.Вставить("ТекстОшибки",	ТекстОшибки);
			СтруктураДокумента.Вставить("EntityId",		EntityId);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЭДО_АннулироватьОтказатьВАннулировании(МассивИдентификаторов, Действие) Экспорт 
	
	Для Каждого СтруктураИдентификаторов Из МассивИдентификаторов Цикл
		
		BoxId		 = СтруктураИдентификаторов.BoxId;
		MessageId	 = СтруктураИдентификаторов.LetterId;
		
		ПодготовленныеСтруктуры = Новый Структура;

		Signatures				 = Новый Массив;
		RevocationRequests		 = Новый Массив;
		XmlSignatureRejections	 = Новый Массив;
		
		Для Каждого СтруктураДокумента Из СтруктураИдентификаторов.Documents Цикл
			
			Если ЗначениеЗаполнено(СтруктураДокумента.ТекстОшибки) Тогда
				Продолжить;
			КонецЕсли;
			
			КонтрактМЧД = МЧДСлужебный_ТекущаяДоверенность(BoxId);
			PowerOfAttorney = Ядро.АПИ_Новый_PowerOfAttorneyToPost(КонтрактМЧД);
			
			ДанныеКонтента = Ядро.СвойствоСтруктуры(СтруктураДокумента, "Content", Неопределено);
			ДанныеКонтента = ?(ТипЗнч(ДанныеКонтента) <> Тип("ДвоичныеДанные"), Base64Значение(ДанныеКонтента), ДанныеКонтента);
			
			ДанныеПодписи = Ядро.СвойствоСтруктуры(СтруктураДокумента, "Signature", Неопределено);
			ДанныеПодписи = ?(ТипЗнч(ДанныеПодписи) <> Тип("ДвоичныеДанные"), Base64Значение(ДанныеПодписи), ДанныеПодписи);
			
			Если Действие = "Аннулировать" Тогда
				
				Если СтруктураДокумента.Статус = "Требуется аннулирование" Тогда
					
					DocumentSignature = Ядро.АПИ_Новый_DocumentSignature(СтруктураДокумента.EntityId, СтруктураДокумента.Signature, , , PowerOfAttorney);
					
					Signatures.Добавить(DocumentSignature);
					
				Иначе
					
					
					NameOnShelf = Ядро.АПИ_ЗагрузитьКонтентНаПолку(
						BoxId,
						ДанныеКонтента);
					
					SignatureNameOnShelf = Ядро.АПИ_ЗагрузитьКонтентНаПолку(
						BoxId,
						ДанныеПодписи);
						
					SignedContent = Ядро.АПИ_Новый_SignedContent(, , NameOnShelf, SignatureNameOnShelf, PowerOfAttorney);
					RevocationRequestAttachment = Ядро.АПИ_Новый_RevocationRequestAttachment(СтруктураДокумента.DocumentId, SignedContent);
					
					RevocationRequests.Добавить(RevocationRequestAttachment);
					
				КонецЕсли;
				
			Иначе
				
				NameOnShelf = Ядро.АПИ_ЗагрузитьКонтентНаПолку(
					BoxId,
					ДанныеКонтента);
					
				SignatureNameOnShelf = Ядро.АПИ_ЗагрузитьКонтентНаПолку(
					BoxId,
					ДанныеПодписи);
		
				SignedContent = Ядро.АПИ_Новый_SignedContent(, , NameOnShelf, SignatureNameOnShelf, PowerOfAttorney);
				XmlSignatureRejectionAttachment = Ядро.АПИ_Новый_XmlSignatureRejectionAttachment(СтруктураДокумента.EntityId, SignedContent);
				
				XmlSignatureRejections.Добавить(XmlSignatureRejectionAttachment);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Идентификаторы = Новый_Идентификаторы(, , BoxId, MessageId); 
		
		Если Signatures.Количество() Тогда
			
			ИмяКоллекции = "Signatures";
			ПодготовленныеСтруктуры.Вставить(ИмяКоллекции, Signatures);
			
		КонецЕсли;
		
		Если RevocationRequests.Количество() Тогда
			
			ИмяКоллекции = "RevocationRequests";
			ПодготовленныеСтруктуры.Вставить(ИмяКоллекции, RevocationRequests);
			
		КонецЕсли;
		
		Если XmlSignatureRejections.Количество() Тогда
			
			ИмяКоллекции = "XmlSignatureRejections";
			ПодготовленныеСтруктуры.Вставить(ИмяКоллекции, XmlSignatureRejections);
			
		КонецЕсли;
		
		РезультатОтправки = Ядро.РезультатPostMessagePatch(Идентификаторы, ПодготовленныеСтруктуры);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ВыполнитьДействиеСДокументомЭДО(ДокументЭДО, Действие, Знач ОтпечатокСертификата = "")
	
	Результат = Неопределено;
	
	Идентификаторы = ДокументЭДО;
	Если ТипЗнч(ДокументЭДО) <> Тип("Структура") Тогда
		Идентификаторы = Новый_Идентификаторы(, , ДокументЭДО.BoxId, ДокументЭДО.LetterId, ДокументЭДО.DocumentId);
