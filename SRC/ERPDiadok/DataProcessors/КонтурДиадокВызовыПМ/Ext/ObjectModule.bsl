//{		КОНТУР.ПЛАГИНЫ

// Точка интеграции продукта и библиотеки плагинов.
// Позволяет переопределить стандартное поведение библиотеки плагинов.
//
// Параметры:
//  ИмяСобытия - Строка - идентификатор служебного события.
//  ПараметрыСобытия - Структура - параметры служебного события.
//  СтандартнаяОбработка - Булево - Ложь, чтобы отключить стандартную обработку события в библиотеке.
//
// @СлужебныйПрограммныйИнтерфейс
//
Процедура КонтурПлагины_ОбработатьСлужебноеСобытие(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка) Экспорт
	
	ИмяСобытияНРег = НРег(ИмяСобытия);
	СтандартнаяОбработка = Ложь;
	
	Если ИмяСобытияНРег = НРег("ПриПолученииИдентификатораПроекта") Тогда
		
		ПараметрыСобытия.Результат = КонтурПлагины_ИмяПроекта();
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриВыполненииHTTPЗапроса") Тогда
		
		КонтурПлагины_ПриВыполненииHTTPЗапроса(
			ПараметрыСобытия.ОписаниеОтвета,
			ПараметрыСобытия.ОписаниеЗапроса
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриЧтенииКэша") Тогда
		
		Ключ = ПараметрыСобытия.Ключ;
		
		ПараметрыСобытия.Результат = Ядро.Кэш_Прочитать(Ключ);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПомещенииКэша") Тогда
		
		Ключ = ПараметрыСобытия.Ключ;
		Значение = ПараметрыСобытия.Значение;
		
		Ядро.Кэш_Поместить(Ключ, Значение);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриЗагрузкеПлагина") Тогда
		
		КонтурПлагины_ПриЗагрузкеПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПрочитатьФайлПлагина") Тогда
		
		КонтурПлагины_ПрочитатьФайлПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПолученииСпискаЗагруженныхПлагинов") Тогда
		
		КонтурПлагины_ПриПолученииСпискаЗагруженныхПлагинов(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПроверкеВозможностиНастройки") Тогда
		
		КонтурПлагины_ПриПроверкеВозможностиНастройки(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
		
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриУдаленииПлагина") Тогда
		
		КонтурПлагины_ПриУдаленииПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриВключенииПлагина") Тогда
		
		КонтурПлагины_ПриВключенииПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриОтключенииПлагина") Тогда
		
		КонтурПлагины_ПриОтключенииПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПолученииНастроекПлагина") Тогда
		
		КонтурПлагины_ПриПолученииНастроекПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриСохраненииНастроекПлагина") Тогда
		
		КонтурПлагины_ПриСохраненииНастроекПлагина(
			ПараметрыСобытия,
			СтандартнаяОбработка
		);
		
	ИначеЕсли ИмяСобытияНРег = НРег("ПриПолученииМетрики") Тогда
		
		КонтурПлагины_ПриПолученииМетрики(ПараметрыСобытия);
		
	Иначе
		
		СтандартнаяОбработка = Истина;
		
	КонецЕсли;
	
	КонтурПлагины_ЛогироватьОбработкуСобытия(ИмяСобытия, ПараметрыСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

