//  Комментарий - Строка - комментарий аннулирования
//
Процедура ВыполнитьДействиеПоАннулированию(ДокументЭДО, Действие, Комментарий) Экспорт 
	
	СохраненныйДокумент = Ядро.Документы_СохраненныйДокумент(ДокументЭДО);
	СохраненныйДокумент.СлужебнаяИнформация.Вставить("КонтентОтвета", Комментарий);
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(СохраненныйДокумент);
	
	МассивДокументов = Ядро.Документы_ДоступныеДляАннулированияДокументы(МассивДокументов, Действие);
	Если МассивДокументов.Количество() > 0 Тогда
		Ядро.Документы_ВыполнитьДействиеСДокументами(МассивДокументов, Действие);
	КонецЕсли;
	
КонецПроцедуры

