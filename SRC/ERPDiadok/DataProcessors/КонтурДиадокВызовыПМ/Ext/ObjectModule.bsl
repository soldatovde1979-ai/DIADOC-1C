Процедура ДобавитьИнформационноеПолеВСтруктуру(Контент, Ключ, Значение)
	
	ИмяСпискаИнфоПолей = ИмяСвойства_StructedAdditionalInfos();
	КоллекцияИнфоПолей = Неопределено;
	
	ИмяПоляКлюч = ИмяСвойства_Key();
	ИмяПоляЗначение = ИмяСвойства_Value();
	
	Если Не Контент.Свойство(ИмяСпискаИнфоПолей, КоллекцияИнфоПолей) Тогда
		КоллекцияИнфоПолей = Новый Массив;
		Контент.Вставить(ИмяСпискаИнфоПолей, КоллекцияИнфоПолей);
	КонецЕсли;
	
	Элемент = Новый Структура;
	Элемент.Вставить(ИмяПоляКлюч, Ключ);
	Элемент.Вставить(ИмяПоляЗначение, Значение);
	
	КоллекцияИнфоПолей.Добавить(Элемент);
	
КонецПроцедуры

