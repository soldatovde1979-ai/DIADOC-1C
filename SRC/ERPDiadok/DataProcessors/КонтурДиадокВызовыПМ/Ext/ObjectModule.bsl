Функция ЭДО_СохранитьИОтправитьПакет(Пакет) Экспорт
	
	Если Пакет.Свойство("ИсходныйПакет") Тогда		
		
		ПакетДляОтправки = Пакет.ИсходныйПакет;
		
		Для Каждого Документ Из Пакет.Документы Цикл
			
			Для Каждого ДокументДляОтправки Из ПакетДляОтправки.Документы Цикл
				
				Если Документ.Ключ = ДокументДляОтправки.Ключ 
					И ЗначениеЗаполнено(Документ.ПараметрыСогласования) Тогда
						
						ПараметрыМаршрутизации = ПараметрыМаршрутизации(Документ.ПараметрыСогласования);
						ДокументДляОтправки.СлужебнаяИнформация.Вставить("Маршрутизация", ПараметрыМаршрутизации);
						Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		ПакетДляОтправки = Пакет;
	КонецЕсли;
	
	Результат = Ядро.Пакеты_ОтправитьИСохранить(ПакетДляОтправки);
	
	Возврат Результат;
	
КонецФункции

