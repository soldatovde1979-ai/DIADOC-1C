Функция ЭДО_ПолучитьСохраненныеДанныеДляОтправкиОтвета(ДокументЭДО, ПакетЭДО) Экспорт
	
	Результат = Новый Структура;
	
	СохраненныеДанные = ПолучитьВердиктИСодержимоеОтветаПоДокументу(ДокументЭДО);
	
	Если НЕ ЗначениеЗаполнено(СохраненныеДанные) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторыДокумента = Новый Структура;
	
	ИдентификаторыДокумента.Вставить("boxId",		ЭДО_Служебные_АдресЯщикаКонтрагента(ДокументЭДО.BoxId));
	ИдентификаторыДокумента.Вставить("documentId",	ДокументЭДО.DocumentId);
	ИдентификаторыДокумента.Вставить("letterId",	ДокументЭДО.LetterId);
	
	Результат.Вставить("ДокументДД",			ДокументЭДО);
	Результат.Вставить("ПакетДД",				ПакетЭДО);
	Результат.Вставить("СтруктураОтвета",		СохраненныеДанные.КонтентОтвета);
	Результат.Вставить("Вердикт",				СохраненныеДанные.Вердикт);
	Результат.Вставить("Идентификаторы",		ИдентификаторыДокумента);
		
	Если СохраненныеДанные.Вердикт = ЭДО_Перечисление_ВариантыОтветаПоДокументу().Подписать Тогда
		
		Результат.Вставить("ВидОтвета",	"AcceptDocument");
		Результат.Вставить("НовыйСтатус",	"Подписан");
		
	ИначеЕсли СохраненныеДанные.Вердикт = ЭДО_Перечисление_ВариантыОтветаПоДокументу().ОтказатьВПодписи Тогда
		
		Результат.Вставить("ВидОтвета",	"RejectDocument");
		Результат.Вставить("НовыйСтатус",	"Отказано в подписи контрагенту");
		
	ИначеЕсли СохраненныеДанные.Вердикт = ЭДО_Перечисление_ВариантыОтветаПоДокументу().ЗапроситьУточнение Тогда
		
		Результат.Вставить("ВидОтвета",	"CorrectionRequest");
		Результат.Вставить("НовыйСтатус",	"Ожидается уточнение");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВердиктИСодержимоеОтветаПоДокументу(ДокументЭДО)
	
	СтруктураДанных = ДокументЭДО.ХранилищеОтвета.Получить();
	
	Если ТипЗнч(СтруктураДанных) = Тип("Структура") Тогда
		
		Результат = Новый Структура;
		
		Результат.Вставить("Вердикт",		ДокументЭДО.ТребуемоеДействиеВДД);
		Результат.Вставить("КонтентОтвета",	СтруктураДанных);
		
		// Ответ уже был отправлен и ТребуемоеДействиеВДД было при этом очищено
		Если НЕ ЗначениеЗаполнено(Результат.Вердикт) Тогда 
			СтруктураДанных.Свойство("Вердикт", Результат.Вердикт);
		КонецЕсли;
		
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

