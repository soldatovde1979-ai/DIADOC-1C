Функция ПолучитьКодРегионаДляДиадок(НаименованиеРегиона) Экспорт
	
	Результат = "";
	
	Если СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Адыгея")) > 0 Тогда
		Результат = "01";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Башкортостан")) > 0 Тогда
		Результат = "02";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Алтайский")) > 0 Тогда
		Результат = "22";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Ингушетия")) > 0 Тогда
		Результат = "06";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Кабардино")) > 0 Тогда
		Результат = "07";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Карачаево")) > 0 Тогда
		Результат = "09";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Карелия")) > 0 Тогда
		Результат = "10";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Коми")) > 0 Тогда
		Результат = "11";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Марий")) > 0 Тогда
		Результат = "12";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Мордовия")) > 0 Тогда
		Результат = "13";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Якутия")) > 0 Тогда
		Результат = "14";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Татарстан")) > 0 Тогда
		Результат = "16"; 
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Тыва")) > 0 Тогда
		Результат = "17";
	ИначеЕсли СтрНайтиЛок(ВРег(НаименованиеРегиона), ВРег("Удмуртская")) > 0 Тогда
		Результат = "18";
