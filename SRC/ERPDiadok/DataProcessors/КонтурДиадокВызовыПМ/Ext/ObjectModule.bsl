// Добавляет новый элемент в коллекцию информационных полей контента.
//
// Параметры:
//  Контент - ОбъектXDTO, Структура - контент электронного документа.
//  Ключ - Строка - (Необязательный) имя информационного поля.
//  Значение - Строка - (Необязательный) значение информационного поля.
//
// @ПубличныйПрограммныйИнтерфейс
//
Процедура ДобавитьИнформационноеПоле(Контент, Ключ = "", Значение = "") Экспорт
	
	ИмяМетода = "ВызовыПМ.ДобавитьИнформационноеПоле";
	
	Если ТипЗнч(Ключ) <> Тип("Строка") Тогда
		ВызватьИсключениеНедопустимоеЗначениеПараметра(ИмяМетода, "Ключ");
	КонецЕсли;
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключениеНедопустимоеЗначениеПараметра(ИмяМетода, "Значение");
	КонецЕсли;
	
	ТипПараметраКонтент = ТипЗнч(Контент);
	
	Если ТипПараметраКонтент = Тип("ОбъектXDTO") Тогда
		
		ДобавитьИнформационноеПолеВОбъектXDTO(Контент, Ключ, Значение);
		
	ИначеЕсли ТипПараметраКонтент = Тип("Структура") Тогда
		
		ДобавитьИнформационноеПолеВСтруктуру(Контент, Ключ, Значение);
		
	Иначе
		
		ВызватьИсключениеНедопустимоеЗначениеПараметра(ИмяМетода, "Контент");
		
	КонецЕсли;
	
КонецПроцедуры

// Конструктор сведений об авансовых счетах-фактурах для заполнения графы 5б
// 
// Возвращаемое значение:
