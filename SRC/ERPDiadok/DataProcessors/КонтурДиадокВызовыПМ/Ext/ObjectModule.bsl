Функция ЭДО_ОтправитьОтветНаДокумент(ДанныеОтправки, ДвоичныеДанныеТитула, ДвоичныеДанныеПодписи) Экспорт 
	
	Результат = Истина;
	
	Документ = Ядро.Документы_СохраненныйДокумент(ДанныеОтправки.ДокументДД);
	Документ.СлужебнаяИнформация.Вставить("КонтентОтвета", ДвоичныеДанныеТитула);
	Документ.СлужебнаяИнформация.Вставить("ПодписьОтвета", ДвоичныеДанныеПодписи);
	
	ДокументыДляОбработки = Новый Массив;
	ДокументыДляОбработки.Добавить(Документ);	
	
	ПодготовленныеДанные = Ядро.Документы_ДанныеДляMessagePatchToPost(ДокументыДляОбработки, ДанныеОтправки.Вердикт);
	
	Попытка
		Ядро.Документы_ОтправитьДанныеДляMessagePatchToPost(ПодготовленныеДанные);
	Исключение
		
		ВидОперации		 		= "Отправка ответа на документ";
		ТекстОшибки		 		= ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ПредставлениеДокумента	= Ядро.Документы_ПредставлениеДокумента(Документ);
		ДопИнформация			= "Документ: " + ПредставлениеДокумента;
		ТекстСообщения			= Ядро.Общее_ПодставитьПараметрыВСтроку("Не удалось отправить документ %1", ПредставлениеДокумента);
		Ядро.Ошибка_Обработать(ВидОперации, ТекстОшибки, ДопИнформация, ТекстСообщения);
		
		Результат = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

