Функция ЭДО_ПодключаемыйМодуль_ОбработатьСобытие(ИмяСобытия, Параметры = Неопределено) Экспорт
	
	ЧерныйСписок = Новый Массив;
	ЧерныйСписок.Добавить(НРег("ПолучитьЗаполненныйОбъектДокумента1С"));
	ЧерныйСписок.Добавить(НРег("НайтиСопоставлениеДокумента"));
	ЧерныйСписок.Добавить(НРег("НайтиСопоставлениеНоменклатуры"));
	ЧерныйСписок.Добавить(НРег("СопоставитьНоменклатуруПоставщика"));
	ЧерныйСписок.Добавить(НРег("СписокТиповДокументовДляСоздания"));
	ЧерныйСписок.Добавить(НРег("ПодготовитьЭлектронныйДокумент"));
	ЧерныйСписок.Добавить(НРег("ПодготовитьЭлектронныйДокументПоВнешнейПечатнойФорме"));
	ЧерныйСписок.Добавить(НРег("ОпределитьТипЗначенияОбъекта"));
	ЧерныйСписок.Добавить(НРег("ПолучитьТаблицуИспользуемыхПакетов"));
	ЧерныйСписок.Добавить(НРег("ПолучитьТаблицуИспользуемыхВидовДокументов"));
	
	ВызовСобытияЗапрещен = (ЧерныйСписок.Найти(НРег(ИмяСобытия)) <> Неопределено);
	
	Если ВызовСобытияЗапрещен Тогда
		
		ИмяФункции = "ЭДО_ПодключаемыйМодуль_ОбработатьСобытие";
		
		Ошибка = ЭДО_Служебные_ПодставитьПараметрыВСтроку(
			"%1: Вызов обработчика события запрещен (%2)
			|Рекомендуется отказаться от использования функции %3 или использовать другое имя события",
			ИмяФункции,
			ИмяСобытия,
			ИмяФункции
		);
		
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
	Результат = Ядро.ПодключаемыйМодуль_ОбработатьСобытие(ИмяСобытия, Параметры);
	
	Возврат Результат;
	
КонецФункции

