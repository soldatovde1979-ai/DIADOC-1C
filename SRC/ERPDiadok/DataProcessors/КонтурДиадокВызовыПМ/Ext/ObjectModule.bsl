// Возвращает прикладное значение ставки НДС по его строковому представлению
//
// Параметры:
//  ПредставлениеСтавки - Строка - Значение тега НалСт из XML
//  или значение TaxRate (см. ГенерацияXML.Перечисление_TaxRate)
// 
// Возвращаемое значение:
//  СправочникСсылка, ПеречислениеСсылка, Неопределено - Прикладное значение ставки НДС
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция ЭДО_ЗначениеСтавкиНДС(ПредставлениеСтавки) Экспорт
	
	ЕстьИнтеграционныйМодуль = ИспользуетсяИнтеграционныйМодуль();
	
	ИспользоватьПеречислениеСтавокДиадок = (НЕ ЕстьИнтеграционныйМодуль
		И Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено
		И Метаданные.Справочники.Найти("СтавкиНДС") = Неопределено);
	
	TaxRate = ЗначениеTaxRate(ПредставлениеСтавки);
	
	Если ЗначениеЗаполнено(TaxRate)
		И ЕстьИнтеграционныйМодуль Тогда
		
		Результат = Ядро.МенеджерИнтеграции_ЗначениеСтавкиНДС(TaxRate);
		
	ИначеЕсли ЗначениеЗаполнено(TaxRate)
		И ИспользоватьПеречислениеСтавокДиадок Тогда
		
		Результат = ЗначениеСтавкиНДСИзПеречисления(TaxRate);
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает строковое представление ставки НДС по прикладному значению
//
// Параметры:
//  ЗначениеСтавки - СправочникСсылка, ПеречислениеСсылка - Прикладное значение ставки НДС
// 
// Возвращаемое значение:
//  Строка, Неопределено - Представление ставки НДС (возможные значения см. ГенерацияXML.Перечисление_TaxRate)
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция ЭДО_ПредставлениеСтавкиНДС(ЗначениеСтавки) Экспорт
	
	ЕстьИнтеграционныйМодуль = ИспользуетсяИнтеграционныйМодуль();
	
	ИспользоватьПеречислениеСтавокДиадок = (НЕ ЕстьИнтеграционныйМодуль
		И Метаданные.Перечисления.Найти("СтавкиНДС") <> Неопределено
		И Метаданные.Справочники.Найти("СтавкиНДС") = Неопределено);
	
	Если ЕстьИнтеграционныйМодуль Тогда
		
		Результат = Ядро.МенеджерИнтеграции_ПредставлениеСтавкиНДС(ЗначениеСтавки);
		
	ИначеЕсли ИспользоватьПеречислениеСтавокДиадок Тогда
		
		Результат = ПредставлениеСтавкиНДСИзПеречисления(ЗначениеСтавки);
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЗначениеСтавкиНДСИзПеречисления(ПредставлениеСтавки)
	
	СтавкиНДСДиадок = Новый Соответствие;
	
	СтавкиНДСДиадок.Вставить(НРег("ИсчНалАг"), "НДС исчисляется налоговым агентом");
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС0") Тогда
		СтавкиНДСДиадок.Вставить("0", Перечисления.СтавкиНДС.НДС0);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5") Тогда
		СтавкиНДСДиадок.Вставить("5", Перечисления.СтавкиНДС.НДС5);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7") Тогда
		СтавкиНДСДиадок.Вставить("7", Перечисления.СтавкиНДС.НДС7);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС10") Тогда
		СтавкиНДСДиадок.Вставить("10", Перечисления.СтавкиНДС.НДС10);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС18") Тогда
		СтавкиНДСДиадок.Вставить("18", Перечисления.СтавкиНДС.НДС18);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС20") Тогда
		СтавкиНДСДиадок.Вставить("20", Перечисления.СтавкиНДС.НДС20);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22") Тогда
		СтавкиНДСДиадок.Вставить("22", Перечисления.СтавкиНДС.НДС22);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС5_105") Тогда
		СтавкиНДСДиадок.Вставить("5/105", Перечисления.СтавкиНДС.НДС5_105);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС7_107") Тогда
		СтавкиНДСДиадок.Вставить("7/107", Перечисления.СтавкиНДС.НДС7_107);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС10_110") Тогда
		СтавкиНДСДиадок.Вставить("10/110", Перечисления.СтавкиНДС.НДС10_110);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС18_118") Тогда
		СтавкиНДСДиадок.Вставить("18/118", Перечисления.СтавкиНДС.НДС18_118);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС20_120") Тогда
		СтавкиНДСДиадок.Вставить("20/120", Перечисления.СтавкиНДС.НДС20_120);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("НДС22_122") Тогда
		СтавкиНДСДиадок.Вставить("22/122", Перечисления.СтавкиНДС.НДС22_122);
	КонецЕсли;
	
	Если СуществуетЗначениеПеречисленияСтавкиНДС("БезНДС") Тогда
		СтавкиНДСДиадок.Вставить(НРег("БезНДС"), Перечисления.СтавкиНДС.БезНДС);
	КонецЕсли;
	
	Результат = СтавкиНДСДиадок.Получить(ПредставлениеСтавки);
	
	Возврат Результат;
	
КонецФункции

