Функция ЭДО_СправочникМенеджер_ПолучитьСписокЭлементов(ИмяСправочника, Владелец = Неопределено, ПереченьРеквизитов = Неопределено) Экспорт
	
	Если ИмяСправочника = "ВидыПакетов" Тогда
		
		ВидыПакетов = Ядро.МассивВидовПакетов();
		
		Результат = Новый ТаблицаЗначений;
		
		Результат.Колонки.Добавить("Ссылка");
		Результат.Колонки.Добавить("ID");
		Результат.Колонки.Добавить("Наименование");
		
		Для Каждого СтруктураВидаПакета Из ВидыПакетов Цикл
			
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураВидаПакета);
			
			НоваяСтрока.ID = СтруктураВидаПакета.Идентификатор;		
			
		КонецЦикла;	
	
	ИначеЕсли ИмяСправочника = "ВидыДокументов" Тогда
		
		ВидыПакетов = Ядро.МассивВидовДокументов();
		
		Результат = Новый ТаблицаЗначений;
		
		Результат.Колонки.Добавить("Ссылка");
		Результат.Колонки.Добавить("ID");
		Результат.Колонки.Добавить("Наименование");
		
		Для Каждого Элемент Из ВидыПакетов Цикл
			
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
			
			НоваяСтрока.ID = Элемент.Идентификатор;
			
		КонецЦикла;
	
	ИначеЕсли ИмяСправочника = "ПодразделенияОрганизаций" Тогда
		
		ИдентификаторВладельца = Новый Структура("ID, Ссылка", Владелец, Новый Структура("ИмяСправочника", "Организации"));
		Результат = Ядро.ХранениеДанных_ПодразделенияВладельца(ИдентификаторВладельца);
		
	Иначе
		Результат = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Возврат Результат;
	
