			Для Каждого КлючИЗначение Из ВидыПакета Цикл
				
				ВидПакета = КлючИЗначение.Значение;
				
				Если ВидПакета.Наименование = ИдентификаторЭлемента.Наименование Тогда
					Результат = ВидПакета;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если Результат = Неопределено Тогда
			Результат = Новый Структура("ID, Наименование, СоставПакета, КатегорияПакета, Шаблон, УПД");
