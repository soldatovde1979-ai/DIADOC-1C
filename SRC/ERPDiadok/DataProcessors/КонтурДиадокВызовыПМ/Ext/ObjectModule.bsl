Процедура КонтурПлагины_ПриПроверкеВозможностиНастройки(ПараметрыСобытия, СтандартнаяОбработка)
	
	Если ИспользуетсяСтандартноеХранилищеПлагинов() Тогда
		
		СтандартнаяОбработка = Истина;
		Возврат;
		
	КонецЕсли;
	
	Результат = Новый_ОписаниеПроверкиСохраненияНастроек();
	
	РезультатИнициализации = Ядро.РезультатИнициализацииОсновногоМодуля();
	
	Если НЕ РезультатИнициализации.УстановленаПодсистемаДиадока Тогда
		
		ТекстОшибки = НСтр(
			"ru = 'В составе конфигурации не найдена подсистема Диадок.
			|Для использования функциональности плагинов нужно добавить подсистему Диадок в состав объектов конфигурацийй.'"
		);
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = ТекстОшибки;
		
	ИначеЕсли РезультатИнициализации.СписокОшибокДоступа.Количество() > 0 Тогда
		
		СписокОшибокСтрокой = "";
		
		Для Каждого Элемент Из РезультатИнициализации.СписокОшибокДоступа Цикл
			СписокОшибокСтрокой = СписокОшибокСтрокой + "- " + Элемент.Значение + Символы.ПС;
		КонецЦикла;
		
		ШаблонТекстаОшибки = НСтр(
			"ru = 'При обращении к системе харанения Диадок возникли следующие ошибки: 
			|
			|%1
			|Устраните ошибки и попробуйте использовать функциональность плагинов снова.'"
		);
		
		ТекстОшибки = ЭДО_Служебные_ПодставитьПараметрыВСтроку(
			ШаблонТекстаОшибки,
			СписокОшибокСтрокой
		);
		
		Результат.Успешно = Ложь;
		Результат.ОписаниеОшибки = ТекстОшибки;
		
	Иначе
		
		Результат.Успешно = Истина;
		Результат.ОписаниеОшибки = "";
		
	КонецЕсли;
	
	ПараметрыСобытия.Вставить("Результат", Результат);
	
КонецПроцедуры

