Процедура ДобавитьИнформационноеПолеВОбъектXDTO(Контент, Ключ, Значение)
	
	ИмяСпискаИнфоПолей = ИмяСвойства_StructedAdditionalInfos();
	КоллекцияИнфоПолей = Контент[ИмяСпискаИнфоПолей];
	
	Элемент = НовыйЭлементСпискаXDTO(КоллекцияИнфоПолей);
	
	ИмяПоляКлюч = ИмяСвойства_Key();
	ИмяПоляЗначение = ИмяСвойства_Value();
	
	УстановитьЗначениеXDTO(Элемент, ИмяПоляКлюч, Ключ);
	УстановитьЗначениеXDTO(Элемент, ИмяПоляЗначение, Значение);
	
