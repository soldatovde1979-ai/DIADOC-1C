// Проверяет, что тип или вид электронного документа используется
// для отправки документов в формате приказа 970@, 820@ или 155@
//
// Параметры:
//  ОписаниеТипаЭД - Структура - см. Контракт_ТипЭлектронногоДокумента или Контракт_ВидЭлектронногоДокумента
// 
// Возвращаемое значение:
//  Булево - Истина, тип документа связан с контентом типа "utd970", "utd820" или "utd"
//
Функция ТипСоответствуетКонтентуУПД(ОписаниеТипаЭД) Экспорт
	
	ТипЭД = ФорматыЭД_ТипЭлектронногоДокумента(ОписаниеТипаЭД);
	
	ТипыКонтента = Ядро.Перечисление_ТипыКонтентов();
	
	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить(ТипыКонтента.utd970);
	ДопустимыеЗначения.Добавить(ТипыКонтента.utd820);
	ДопустимыеЗначения.Добавить(ТипыКонтента.utd);
	
	Результат = (ДопустимыеЗначения.Найти(ТипЭД.ТипКонтента) <> Неопределено);
	
	Возврат Результат;
	
КонецФункции

