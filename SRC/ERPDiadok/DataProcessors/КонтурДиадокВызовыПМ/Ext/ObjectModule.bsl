Функция ЭДО_ОписаниеТипаДокумента_V2(ТипДокумента, ТипКонтента) Экспорт
	
	ВиртуальныйТипДокумента = "";
	
	Если ЗначениеЗаполнено(ТипКонтента) Тогда
		
		СоответствиеТипов = Новый Соответствие;
		СоответствиеТипов.Вставить("Invoice",						"UtdInvoice");
		СоответствиеТипов.Вставить("InvoiceRevision",				"UtdInvoiceRevision");
		СоответствиеТипов.Вставить("XmlAcceptanceCertificate",		"UtdAcceptanceCertificate");
		СоответствиеТипов.Вставить("XmlTorg12",						"UtdTorg12");
		СоответствиеТипов.Вставить("UniversalTransferDocument",		"UniversalTransferDocument");
		СоответствиеТипов.Вставить("InvoiceCorrection",				"UcdInvoiceCorrection");
		СоответствиеТипов.Вставить("InvoiceCorrectionRevision",		"UcdInvoiceCorrectionRevision");
		СоответствиеТипов.Вставить("UniversalCorrectionDocument",	"UniversalCorrectionDocument");
		СоответствиеТипов.Вставить("TovTorg",						"TovTorg");
		СоответствиеТипов.Вставить("XmlAcceptanceCertificate552",	"XmlAcceptanceCertificate552");
		
		ВиртуальныйТипДокумента = СоответствиеТипов[ТипДокумента];
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВиртуальныйТипДокумента) Тогда
		ВиртуальныйТипДокумента = ТипДокумента;
	КонецЕсли;
	
	Результат = ЭДО_ОписаниеТипаДокумента(ВиртуальныйТипДокумента);
	
	Возврат Результат;
	
