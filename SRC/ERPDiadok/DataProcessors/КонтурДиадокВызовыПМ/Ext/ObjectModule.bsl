Процедура ЭДО_Модуль_ОбновитьСписокДокументов(ПараметрыОбновленияСписка) Экспорт
	
	СписокДокументов.Очистить();
	
	ДокументыДляСписка = Ядро.СписокДокументов_Документы(ПараметрыОбновленияСписка);
	
	Ядро.СписокДокументов_ПоместитьВЛокальныйКэш(ДокументыДляСписка);
	
	НомерСтроки = 1;
	
	РежимыПостроенияСписка = Ядро.Перечисление_РежимыПостроенияСпискаДокументов();
	ЭтоСписокДокументовНаОтправку = (ПараметрыОбновленияСписка.Режим = РежимыПостроенияСписка.ОтправкаПакетов);
	
	Для Каждого СтрокаСписка Из ДокументыДляСписка Цикл
		
		Если ЭтоСписокДокументовНаОтправку
			И Ядро.СписокДокументов_ЭтоСтрокаВложенногоПакета(СтрокаСписка) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = СписокДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСписка);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	ПараметрыПМ = Новый Структура;
	ПараметрыПМ.Вставить("СписокДокументов",	СписокДокументов);
	ПараметрыПМ.Вставить("Режим",				ПараметрыОбновленияСписка.Режим);
	
	Ядро.ПодключаемыйМодуль_ОбработатьСобытие("ПослеОбновленияСпискаДокументов", ПараметрыПМ);
	
КонецПроцедуры

