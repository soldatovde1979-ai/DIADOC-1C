Функция ЭДО_Транспорт_ВызватьМетодAPI(АдресМетода,
										Метод,
										ТелоЗапроса = "",
										ОтветВДвоичныхДанных = Ложь,
										boxId = "",
										ТолькоРезультатОтвета = Истина,
										Параметры = Неопределено) Экспорт
	
	Модуль_ВнешниеСервисы = Ядро.Модуль_ВнешниеСервисы(Ядро);
	ПараметрыЗапроса = Модуль_ВнешниеСервисы.ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод = Метод;
	ПараметрыЗапроса.АдресМетода = АдресМетода;
	ПараметрыЗапроса.ТелоЗапроса = ТелоЗапроса;
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные = ОтветВДвоичныхДанных;
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		Для Каждого Параметр Из Параметры Цикл
			ПараметрыЗапроса.Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ПараметрыСервиса = Ядро.ПараметрыСервиса_Диадок(BoxId);
	ТекстЗаголовка = Ядро.Модуль_МетодыAPI(ЭтотОбъект).ЗаголовокАвторизацииДиадок(ПараметрыСервиса);
	ПараметрыЗапроса.Заголовки.Вставить("Authorization", ТекстЗаголовка);
	
	ОтветHTTP = Модуль_ВнешниеСервисы.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если ТипЗнч(ОтветHTTP) = Тип("Структура")
		И ОтветHTTP.Свойство("ТелоОтвета") Тогда
		Результат = ОтветHTTP.ТелоОтвета;
	Иначе
		Результат = ОтветHTTP;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ЭДО_Транспорт_РазобратьОтветAPI(ОтветHTTP) Экспорт
	
	Модуль_ПарсерJSON = Ядро.Модуль_ПарсерJSON(Ядро);
	Результат = Модуль_ПарсерJSON.Прочитать(ОтветHTTP);
	
	Если ТипЗнч(Результат) <> Тип("Строка")
		И ТипЗнч(Результат) <> Тип("Структура") Тогда
		Результат = ОтветHTTP;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

