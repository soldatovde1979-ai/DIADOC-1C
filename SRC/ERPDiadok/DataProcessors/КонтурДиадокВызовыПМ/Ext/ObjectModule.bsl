// Формирует квитанцию об отмене фиксации кодов маркировки.
// Перед вызовом метода следует указать ящик (см. ЭДО_УстановитьТекущийЯщик)
//
// @ПубличныйПрограммныйИнтерфейс
//
// Параметры:
//  ЭлектронныйДокумент - СправочникСсылка.Диадок_Документы - электронный документ, по которому требуется сформировать
//                                                            квитанцию об отмене фиксации кодов маркировки
// 
// Возвращаемое значение:
//  ДвоичныеДанные - файл квитанции об отмене фиксации
//
Функция ЭДО_ОтменаФиксации_СформироватьКвитанцию(Знач ЭлектронныйДокумент) Экспорт
	
	_ПроверитьКонтекстТекущегоЯщика();
	_ПроверитьПодсистемуХраненияКонтурДиадок();
	
	ИмяМетода = "КонтурДиадокВызовыПМ.ЭДО_ОтменаФиксации_СформироватьКвитанцию";
	_ПроверитьПараметр(ИмяМетода, "ЭлектронныйДокумент", ЭлектронныйДокумент, Тип("СправочникСсылка.Диадок_Документы"));
	
	ДокументИнфо = Документы_СохраненныйДокумент(ЭлектронныйДокумент);
	
	ИмяФайлаВложения = ДокументИнфо.Метаданные.FileName;
	ОрганизацияИНН = _ТекущаяСтрокаКонтекста.Ящик.Организация.ИНН;
	Результат = Ядро.Новый_ДвоичныйКонтентОтменыФиксации(ИмяФайлаВложения, ОрганизацияИНН);
	
	Возврат Результат;
	
КонецФункции // ЭДО_ОтменаФиксации_СформироватьКвитанцию

// Отправляет квитанцию об отмене фиксации кодов маркировки
// Перед вызовом метода следует указать ящик (см. ЭДО_УстановитьТекущийЯщик)
//
// @ПубличныйПрограммныйИнтерфейс
//
// Параметры:
//  ЭлектронныйДокумент - СправочникСсылка.Диадок_Документы - электронный документ, по которому требуется отправить
//                                                            квитанцию об отмене фиксации кодов маркировки
//  ОтменаФиксации - ДвоичныеДанные - файл квитанции об отмене фиксации
//  Подпись - ДвоичныеДанные - файл подписи к квитанции об отмене фиксации
//
Процедура ЭДО_ОтменаФиксации_ОтправитьКвитанцию(ЭлектронныйДокумент, ОтменаФиксации, Подпись) Экспорт
	
	_ПроверитьКонтекстТекущегоЯщика();
	_ПроверитьПодсистемуХраненияКонтурДиадок();
	
	ИмяМетода = "КонтурДиадокВызовыПМ.ЭДО_ОтменаФиксации_ОтправитьКвитанцию";
	_ПроверитьПараметр(ИмяМетода, "ЭлектронныйДокумент", ЭлектронныйДокумент, Тип("СправочникСсылка.Диадок_Документы"));
	_ПроверитьПараметр(ИмяМетода, "ОтменаФиксации", ОтменаФиксации, Тип("ДвоичныеДанные"));
	_ПроверитьПараметр(ИмяМетода, "Подпись", Подпись, Тип("ДвоичныеДанные"));
	
	BoxId = _ТекущаяСтрокаКонтекста.Ящик.Идентификатор;
	МЧД = МЧДСлужебный_ТекущаяДоверенность(BoxId);
	PowerOfAttorney = Ядро.АПИ_Новый_PowerOfAttorneyToPost(МЧД);
	
	ТребуемыеРеквизиты = Новый Структура;
	ТребуемыеРеквизиты.Вставить("MessageId", "LetterId");
	ТребуемыеРеквизиты.Вставить("EntityId", "DocumentId");
	ИдентификаторыЭД = Общее_ЗначенияРеквизитовОбъекта(ЭлектронныйДокумент, ТребуемыеРеквизиты);
	
	SignedContent = Ядро.АПИ_Новый_SignedContent(ОтменаФиксации, Подпись, , , PowerOfAttorney);
	Вложение = Ядро.АПИ_Новый_TtGisFixationCancellationRequestAttachment(
		ИдентификаторыЭД.EntityId,
		SignedContent
	);
	
	ДанныеДляОтправки = Новый Структура;
	ДанныеДляОтправки.Вставить("TtGisFixationCancellationRequests", Новый Массив);
	ДанныеДляОтправки.TtGisFixationCancellationRequests.Добавить(Вложение);
	
	Идентификаторы = Новый_Идентификаторы(, , BoxId, ИдентификаторыЭД.MessageId);
	РезультатОтправки = Ядро.РезультатPostMessagePatch(Идентификаторы, ДанныеДляОтправки);
	
КонецПроцедуры // ЭДО_ОтменаФиксации_ОтправитьКвитанцию

