Процедура КонтурПлагины_ПриВыполненииHTTPЗапроса(ОписаниеОтвета, ОписаниеЗапроса)
	
	ВнешниеСервисы = Ядро.Модуль_ВнешниеСервисы(Ядро);
	
	ПараметрыЗапроса = ВнешниеСервисы.ПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Метод		 = ОписаниеЗапроса.Метод;
	ПараметрыЗапроса.АдресМетода = ОписаниеЗапроса.ПутьНаСервере;
	ПараметрыЗапроса.ТелоЗапроса = ОписаниеЗапроса.ТелоЗапроса;
	ПараметрыЗапроса.Заголовки	 = ОписаниеЗапроса.Заголовки;
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные = ОписаниеЗапроса.ТелоОтветаКакДвоичныеДанные;
	
	Для Каждого Параметр Из ОписаниеЗапроса.Параметры Цикл
