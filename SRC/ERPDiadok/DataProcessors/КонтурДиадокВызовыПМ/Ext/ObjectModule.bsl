// История событий по документу
//
// Параметры:
//  РеквизитыДокумента	 - Структура - см. Контракт_Документ() - реквизиты
//
// Возвращаемое значение:
//   Массив - Коллекция элементов см. Контракт_ЭлементИсторииДО()
//
Функция ЭДО_ИсторияПоДокументу(РеквизитыДокумента) Экспорт
	
	Результат = Новый Массив;
	
	Идентификаторы = Новый_Идентификаторы(
			,
			,
			РеквизитыДокумента.BoxId,
			РеквизитыДокумента.LetterId,
			РеквизитыДокумента.DocumentId);
	
	Документы_ИсторияДО = Ядро.Документы_ИсторияДО(Идентификаторы);
	
	Для Каждого ЭлементИсторииДО Из Документы_ИсторияДО Цикл
		
		Модель = Контракт_ЭлементИсторииДО();
		ЗаполнитьЗначенияСвойств(Модель, ЭлементИсторииДО);
		
		Результат.Добавить(Модель);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция Контракт_ЭлементИсторииДО()
	
	Результат = Новый Структура;
	Результат.Вставить("Дата", '00010101');
	Результат.Вставить("BoxId", "");
	Результат.Вставить("Организация", "");
	Результат.Вставить("Подписант", "");
	Результат.Вставить("Должность", "");
	Результат.Вставить("Описание", "");
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("Тип", "");
	Результат.Вставить("ДокументURL", "");
	Результат.Вставить("ШаблонДокументаURL", "");
	Результат.Вставить("ИнструкцияURL", "");
	Результат.Вставить("ДанныеПодписи", "");
	Результат.Вставить("ПараметрыСохранения");
	Результат.Вставить("DocflowNamedId", "");
	Результат.Вставить("Детализация", "");
	
	Возврат Результат;
	
КонецФункции

