// Формирует сведения для отправки неформализованного документа
//
// Параметры:
//  НеИспользуется_ТиповойМодуль - Произвольный - не используется (для обратной совместимости)
//  НеИспользуется_РежимУправляемыхФорм - Произвольный - не используется (для обратной совместимости)
//  Документ1С - ЛюбаяСсылка - ссылка на учетный документ, на основании которого формируется электронный документ
//  ИмяПечатнойФормы - Строка - идентификатор вида печатной формы (принимает значения: "СчетНаОплату", "АктСверки")
//  НеИспользуется_ДополнительныеПараметры - Структура - не используется (для обратной совместимости)
// 
// Возвращаемое значение:
//  Структура - Контракт_НеформализованныйСчетНаОплату, если ИмяПечатнойФормы = "СчетНаОплату"
//            - Контракт_НеформализованныйАктСверки, , если ИмяПечатнойФормы = "АктСверки"
//
Функция ТиповойМодуль_СформироватьПечатнуюФорму(НеИспользуется_ТиповойМодуль = Неопределено,
												НеИспользуется_РежимУправляемыхФорм = Неопределено,
												Документ1С,
												ИмяПечатнойФормы,
												НеИспользуется_ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Не ИспользуетсяИнтеграционныйМодуль() Тогда
		
		Контекст = Новый Структура;
		Контекст.Вставить("ИмяПечатнойФормы", ИмяПечатнойФормы);
		Контекст.Вставить("ТипУчетногоДокумента", Документ1С.Метаданные().ПолноеИмя());
		
		ОбработатьОшибку_ОтсутствуетИнтеграционныйМодуль(
			"ТиповойМодуль_СформироватьПечатнуюФорму",
			Контекст
		);
		
	КонецЕсли;
	
	Если НРег(ИмяПечатнойФормы) = НРег("СчетНаОплату")
		И Ядро.ФормироватьСчетаНаОплатуСредствамиУМ() Тогда
		
		// BSLLS:MissingTemporaryFileDeletion-off
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
		// BSLLS:MissingTemporaryFileDeletion-on
		
		ТабличныйДокумент = Ядро.СчетаНаОплату_ПечатнаяФорма(Документ1С);
		ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
		
		Мета = Ядро.СчетаНаОплату_Метаданные(Документ1С);
		
		Результат = Контракт_НеформализованныйСчетНаОплату();
		Результат.Таблица = ТабличныйДокумент;
		Результат.ИмяВременногоФайла = ИмяВременногоФайла;
		Результат.ИмяФайла = Мета.ИмяФайлаВложения;
		Результат.Дата = Мета.Дата;
		Результат.Номер = Мета.Номер;
		Результат.Сумма = Мета.Сумма;
		Результат.СуммаНДС = Мета.СуммаНДС;
		Результат.ДокументБезНДС = Мета.ДокументБезНДС;
		Результат.КодВалюты = Мета.КодВалюты;
		
	ИначеЕсли НРег(ИмяПечатнойФормы) = НРег("АктСверки") Тогда
		
		// BSLLS:MissingTemporaryFileDeletion-off
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
		// BSLLS:MissingTemporaryFileDeletion-on
		
		ТабличныйДокумент = Ядро.АктыСверок_ПечатнаяФорма(Документ1С);
		ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
		
		Мета = Ядро.АктыСверок_Метаданные(Документ1С);
		
		Результат = Контракт_НеформализованныйАктСверки();
		Результат.Таблица = ТабличныйДокумент;
		Результат.ИмяВременногоФайла = ИмяВременногоФайла;
		Результат.ИмяФайла = Мета.ИмяФайлаВложения;
		Результат.Дата = Мета.Дата;
		Результат.Номер = Мета.Номер;
		
	Иначе
		
		Результат = Ядро.ТиповойМодуль_СформироватьПечатнуюФорму(
			Документ1С,
			ИмяПечатнойФормы,
			НеИспользуется_ДополнительныеПараметры
		);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

