Функция ЭДО_ПолучитьДокументыДляМассиваПакетов(ПакетыЭДО) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	ИменаКолонок = "Ссылка, Документ, Пакет, Организация, DocumentId, LetterId, BoxId, Статус, ЗаблокированныйПакет";
	Ядро.ДобавитьКолонкиВТаблицуЗначений(Результат, ИменаКолонок);
	
	ИдентификаторыПакетов = Новый Массив;
	
	Для Каждого ПакетЭДО Из ПакетыЭДО Цикл
		
		ИдентификаторыПакета = Новый Структура("ПакетЭДО", ПакетЭДО);
		ИдентификаторыПакетов.Добавить(ИдентификаторыПакета);
		
	КонецЦикла;
	
	ДокументыПакета = Ядро.Пакеты_ДокументыПакетов(ИдентификаторыПакетов);
	
	Для Каждого ДокументПакета Из ДокументыПакета Цикл
		
		Идентификаторы = ДокументПакета.Идентификаторы;
		
		СтрокаТЗ = Результат.Добавить();
		
		СтрокаТЗ.Ссылка					= Идентификаторы.ДокументЭДО;
		СтрокаТЗ.Документ				= Идентификаторы.ДокументЭДО;
		СтрокаТЗ.Пакет					= Идентификаторы.ПакетЭДО;
		СтрокаТЗ.DocumentId				= Идентификаторы.DocumentId;
		СтрокаТЗ.LetterId				= Идентификаторы.LetterId;
		СтрокаТЗ.BoxId					= Идентификаторы.BoxId;
		СтрокаТЗ.Статус					= ДокументПакета.Статусы.Статус;
		СтрокаТЗ.ЗаблокированныйПакет	= ДокументПакета.Заблокирован;
		
		Если ДокументПакета.Направление = ЭДО_Перечисление_Направления().Исходящее Тогда
			
			СтрокаТЗ.Организация = ДокументПакета.Отправитель.Организация;
			
		ИначеЕсли ДокументПакета.Направление = ЭДО_Перечисление_Направления().Входящее Тогда
			
			СтрокаТЗ.Организация = ДокументПакета.Получатель.Организация;
			
		Иначе
			СтрокаТЗ.Организация = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

