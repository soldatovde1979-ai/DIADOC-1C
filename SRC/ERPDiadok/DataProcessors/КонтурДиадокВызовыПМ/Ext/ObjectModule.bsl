Процедура ЭДО_ПереместитьМассивДокументовВПодразделение(BoxId, ToDepartmentId, МассивДокументов) Экспорт
	
	БуферныйМассив = Новый Массив;
	
	Ключ = "ДокументДД";
		
	Для Каждого ЭлементМассива Из МассивДокументов Цикл
		
		// Для обеспечения совместимости с ПМ предыдущих версий приведем
		// элементы коллекции МассивДокументов к виду контракта "Контракт_Документ".
		// Сам МассивДокументов не преобразуем для возможности дальнейшего использования его первоначальных данных в ПМ. 
		
		ЭлементБуфера = ЭлементМассива;
		
		Если ЭлементБуфера.Свойство(Ключ) Тогда
			ДокументДД = ЭлементБуфера[Ключ];
			ЭлементБуфера = Ядро.Документы_СохраненныйДокумент(ДокументДД);
		КонецЕсли;
		
		БуферныйМассив.Добавить(ЭлементБуфера);
				
	КонецЦикла;
	
	Ядро.Документы_ПереместитьМассивДокументовВПодразделение(BoxId, ToDepartmentId, БуферныйМассив);
	
	БуферныйМассив = Неопределено;
	
