Функция ПолучитьМассивИдентификаторовПоМассивуДокументов(МассивДокументов) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документы", МассивДокументов);
	
	//TODO: убрать прямое обращение к подсистеме хранения
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Диадок_Документы.BoxId КАК BoxId,
		|	Диадок_Документы.LetterId КАК LetterId,
		|	Диадок_Документы.DocumentId КАК DocumentId,
		|	Диадок_Документы.Ссылка КАК Документ1С,
		|	Диадок_Документы.Статус
		|ИЗ
		|	Справочник.Диадок_Документы КАК Диадок_Документы
		|ГДЕ
		|	Диадок_Документы.Ссылка В(&Документы)
		|ИТОГИ ПО
		|	BoxId,
		|	LetterId";
	
	Результат = Новый Массив;
	ВыборкаПоBox = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоBox.Следующий() Цикл
		
		ВыборкаПоLetter = ВыборкаПоBox.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоLetter.Следующий() Цикл
			
			Идентификаторы = Новый Структура("BoxId, LetterId, АдресЯщика");
			ЗаполнитьЗначенияСвойств(Идентификаторы, ВыборкаПоLetter);
			Идентификаторы.Вставить("АдресЯщика", ЭДО_Служебные_АдресЯщикаКонтрагента(Идентификаторы.BoxId));
			Идентификаторы.Вставить("Documents", Новый Массив);
			
			ВыборкаПоDocument = ВыборкаПоLetter.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоDocument.Следующий() Цикл
				СтруктураДокумента = Новый Структура("DocumentId, Документ1С, Статус");
				ЗаполнитьЗначенияСвойств(СтруктураДокумента, ВыборкаПоDocument);
				Идентификаторы.Documents.Добавить(СтруктураДокумента);
			КонецЦикла;
			Результат.Добавить(Идентификаторы);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

