// Авторизуется по логину и паролю служебной учетной записи, указанными в
// настройках модуля, и заполняет контекст сеанса. Заполненный контекст
// можно получить методом ЭДО_КонтекстСеансаКлиентСервер.
// 
// Возвращаемое значение:
//  Булево - Истина, если в контекст сеанса добавлен хотя бы один ящик.
//           Ложь, если контекст не заполнен (у служебной учетки нет доступа ни в один ящик).
//
Функция ЭДО_ЗаполнитьКонтекстСеансаДляСлужебнойУчетнойЗаписи() Экспорт
	
	ОбщиеНастройки = Ядро.ХранениеДанных_ОбщиеНастройки();
	
	Логин = ОбщиеНастройки.СлужебнаяУчетнаяЗаписьЛогин;
	Пароль = ОбщиеНастройки.СлужебнаяУчетнаяЗаписьПароль;
	
	Токен = Ядро.Авторизация_ПоПаролю(Логин, Пароль);
	
	ОбработатьСобытияПослеАвторизации();
	
	КонтекстЗаполнен = Ядро.КонтекстСеанса_ДляСлужебнойУчетнойЗаписи();
	
	Возврат КонтекстЗаполнен;
	
КонецФункции

// Получает информацию о ящиках из контекста сеанса пользователя.
//
// Параметры:
//  ДобавитьНеоплаченные - Булево - Истина, если следует добавить сведения о ящиках без оплаченного тарифа.
// 
// Возвращаемое значение:
//  ФиксированноеСоответствие - контекст сеанса:
//    * Ключ - Строка - адрес ящика (в формате <...@diadoc.ru>)
//    * Значение - ФиксированнаяСтруктура - см. Контракт_СтрокаКонтекстаСеанса
//
Функция ЭДО_КонтекстСеансаКлиентСервер(ДобавитьНеоплаченные = Ложь) Экспорт
	
	СлужебныйКонтекст = Ядро.КонтекстСеанса_СтрокиКонтекста(ДобавитьНеоплаченные);
	КонтекстСеанса = Новый Соответствие;
	
	Для Каждого КлючЗначение Из СлужебныйКонтекст Цикл
		
		Модель = Новый_СтрокаКонтекстаСеанса(КлючЗначение.Значение);
		АдресЯщика = ЭДО_Служебные_АдресЯщикаКонтрагента(КлючЗначение.Ключ);
		КонтекстСеанса.Вставить(АдресЯщика, Модель);
		
	КонецЦикла;
	
	Результат = ФиксированныеДанныеЛок(КонтекстСеанса);
	
	Возврат Результат;
	
