//#Область ПрограммныйИнтерфейс_КонтекстСеанса

// Выбирает для обработки указанный ящик. Перед вызовом метода необходимо авторизоваться
// и заполнить контекст сеанса. Если в контексте сеанса отсутствуют сведения о ящике с
// указанным идентификатором, будет вызвано исключение.
//
// @ПубличныйПрограммныйИнтерфейс
//
// Параметры:
//  Ящик - Строка - адрес или идентификатор ящика
//
Процедура ЭДО_УстановитьТекущийЯщик(Знач Ящик) Экспорт
	
	ИмяМетода = "КонтурДиадокВызовыПМ.ЭДО_УстановитьКонтекст";
	_ПроверитьПараметр(ИмяМетода, "Ящик", Ящик, Тип("Строка"));
	
	ИдентификаторЯщика = НРег(Ядро.АдресЯщикаВИдентификатор(Ящик));
	ВызыватьИсключение = Ложь;
	_ТекущаяСтрокаКонтекста = Ядро.КонтекстСеанса_СтрокаКонтекста(ИдентификаторЯщика, ВызыватьИсключение);
	
	Если _ТекущаяСтрокаКонтекста = Неопределено Тогда
		Ошибка = ЭДО_Служебные_ПодставитьПараметрыВСтроку(
			"НеАвторизован: В контексте сеанса нет данных организации из Диадока (BoxId = %1)",
			ИдентификаторЯщика
		);
		ЖурналРегистрации_ЗаписатьОшибку("КонтекстСеанса", Ошибка);
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
КонецПроцедуры

//#КонецОбласти ПрограммныйИнтерфейс_КонтекстСеанса


//#Область СлужебныеПроцедурыИФункции_КонтекстСеанса

Процедура _ПроверитьКонтекстТекущегоЯщика()
	
	Если _ТекущаяСтрокаКонтекста = Неопределено Тогда
		
		Ошибка = "Требуется установить контекст текущего ящика (см. 'ЭДО_УстановитьКонтекст')";
		ЖурналРегистрации_ЗаписатьОшибку("КонтекстСеанса", Ошибка);
		ВызватьИсключение Ошибка;
		
	КонецЕсли;
	
КонецПроцедуры

//#КонецОбласти СлужебныеПроцедурыИФункции_КонтекстСеанса


//#Область ПрограммныйИнтерфейс_СопоставлениеНоменклатуры

// Добавляет вариант сопоставления номенклатуры
//
// Параметры:
//  ВариантыСопоставления	 - Массив - Массив уже найденных вариантов или пустой массив
//  Номенклатура			 - СправочникСсылка - Найденная номенклатура информационной базы
//  Характеристика			 - СправочникСсылка - Найденная Характеристика информационной базы
//  Упаковка				 - СправочникСсылка - Найденная Упаковка информационной базы
//
Процедура ДобавитьВариантСопоставленияНоменклатуры(ВариантыСопоставления, Номенклатура, Характеристика = Неопределено, Упаковка = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураИБ = Новый_НоменклатураИнформационнойБазы(Номенклатура, Характеристика, Упаковка);
	
	ВариантыСопоставления.Добавить(НоменклатураИБ);
	
КонецПроцедуры

// Конструктор описания номенклатуры информационной базы.
//
// Параметры:
//  Номенклатура - ОпределяемыйТип.НоменклатураБЭД, СправочникСсылка.Номенклатура - (необязательный) номенклатура.
//  Характеристика - ОпределяемыйТип.ХарактеристикаНоменклатурыБЭД, СправочникСсылка.ХарактеристикиНоменклатуры - (необязательный) характеристика номенклатуры
//  Упаковка - ОпределяемыйТип.УпаковкаНоменклатурыБЭД, СправочникСсылка.КлассификаторЕдиницИзмерения - (необязательный) упаковка / единица измерения номенклатуры
// 
// Возвращаемое значение:
//  Структура - см. Контракт_НоменклатураИнформационнойБазы.
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция Новый_НоменклатураИнформационнойБазы(Номенклатура = Неопределено, Характеристика = Неопределено, Упаковка = Неопределено) Экспорт
	
	Результат = Контракт_НоменклатураИнформационнойБазы();
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Результат.Номенклатура = Номенклатура;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Характеристика) Тогда
		Результат.Характеристика = Характеристика;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Упаковка) Тогда
		Результат.Упаковка = Упаковка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает номенклатуру информационной базы, сопоставленную с номенклатурой электронного документа.
//
// Параметры:
//  Документ - Структура - описание электронного документа (см. Контракт_Документ).
// 
// Возвращаемое значение:
//  Соответствие - Ключ - идентификатор номенклатуры ЭД,
//                 Значение - сопоставленная номенклатура (см. Новый_НоменклатураИнформационнойБазы).
//
// @ПубличныйПрограммныйИнтерфейс
//
Функция СопоставленнаяНоменклатураЭлектронногоДокумента(Документ) Экспорт
	
	Результат = Новый Соответствие; // Ключ - идентификатор, значение - НоменклатураИБ
	
	ТаблицаСопоставления = Ядро.Номенклатура_ТаблицаСопоставленияНоменклатуры(Документ);
	ДополнитьКолонкиТаблицыСопоставленияНоменклатуры(ТаблицаСопоставления);
	
	Для Каждого Строка Из ТаблицаСопоставления Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		НоменклатураИБ = Новый_НоменклатураИнформационнойБазы(
			Строка.Номенклатура,
			Строка.Характеристика,
			Строка.Упаковка
		);
		
		Идентификатор = Строка.НоменклатураКонтрагента.Идентификатор;
		
		Результат.Вставить(Идентификатор, НоменклатураИБ);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Записывает сопоставление номенклатуры электронного документа с номенклатурой информационной базы.
//
// Параметры:
//  ВладелецНоменклатуры - ОпределяемыйТип.ВладелецНоменклатурыБЭД, СправочникСсылка.Контрагенты - Контрагент или Партнер
//  НоменклатураЭД - Структура - см. Контракт_НоменклатураЭлектронногоДокумента
//  НоменклатураИБ - Структура - см. Контракт_НоменклатураИнформационнойБазы
//  НеИспользуется_ТиповойМодуль - ОбработкаОбъект - (Устарел, не используется) стандартная библиотека интеграции.
//
// @ПубличныйПрограммныйИнтерфейс
//
Процедура ТиповойМодуль_ЗаписатьСопоставлениеНоменклатуры(ВладелецНоменклатуры, НоменклатураЭД, НоменклатураИБ, НеИспользуется_ТиповойМодуль = Неопределено) Экспорт
	
	Если Не ИспользуетсяИнтеграционныйМодуль() Тогда
		
		Контекст = Новый Структура;
		
		ОбработатьОшибку_ОтсутствуетИнтеграционныйМодуль(
			"ТиповойМодуль_ЗаписатьСопоставлениеНоменклатуры",
			Контекст
		);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВладелецНоменклатуры) Тогда
		ВызватьИсключение "Не указан владелец номенклатуры электронного документа!";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоменклатураЭД.Идентификатор) Тогда
		ВызватьИсключение "Не указан идентификатор номенклатуры электронного документа!";
	КонецЕсли;
	
	НоменклатураКонтрагента = Ядро.Новый_НоменклатураКонтрагента(
		ВладелецНоменклатуры,
		НоменклатураЭД.Идентификатор
	); // Внутренний контракт
	
	НоменклатураКонтрагента.Код = НоменклатураЭД.Код;
	НоменклатураКонтрагента.Артикул = НоменклатураЭД.Артикул;
	НоменклатураКонтрагента.Наименование = НоменклатураЭД.Наименование;
	НоменклатураКонтрагента.Характеристика = НоменклатураЭД.Характеристика;
	НоменклатураКонтрагента.СтавкаНДС = НоменклатураЭД.СтавкаНДС;
	НоменклатураКонтрагента.ЕдиницаИзмерения = НоменклатураЭД.ЕдиницаИзмерения;
	НоменклатураКонтрагента.ЕдиницаИзмеренияКод = НоменклатураЭД.ЕдиницаИзмеренияКод;
	
	Попытка
		
		Ядро.МенеджерИнтеграции_СопоставлениеНоменклатурыЗаписать(
			НоменклатураКонтрагента,
			НоменклатураИБ
		);
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		
		ВидОперации = "Запись сопоставления номенклатуры";
		ТекстОшибки = ПодробноеПредставлениеОшибки(Ошибка);
		ДопИнформация = Новый Массив;
		ТекстСообщения = КраткоеПредставлениеОшибки(Ошибка);
		
		Ядро.Ошибка_Обработать(
			ВидОперации,
			ТекстОшибки,
			ДопИнформация,
			ТекстСообщения
		);
		
	КонецПопытки;
	
КонецПроцедуры

