// Получает описание сессии текущего пользователя в указанном ящике.
// Если адрес ящика не указан, возвращается описание сессии служебной учетной записи.
//
// Параметры:
//  BoxId - Строка - идентификатор ящика или пустая строка для служебной учетной записи.
//  ВызыватьИсключение - Булево - Истина, если при отсутствии информации о сессии следует сгенерировать исключение.
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - см. Контракт_СтрокаКонтекстаСеанса
//
Функция ЭДО_СтрокаКонтекстаСеанса(Знач BoxId, Знач ВызыватьИсключение = Ложь) Экспорт
	
	Данные = Ядро.КонтекстСеанса_СтрокаКонтекста(BoxId, ВызыватьИсключение);
	Модель = Новый_СтрокаКонтекстаСеанса(Данные);
	Результат = ФиксированныеДанныеЛок(Модель);
	
	Возврат Результат;
	
КонецФункции

// Формирует публичный контракт строки контекста сеанса
//
// Параметры:
//  Данные - Структура - см. Ядро.МодельСтрокаКонтекстаСеанса
// 
// Возвращаемое значение:
//  Структура - см. Контракт_СтрокаКонтекстаСеанса
//
Функция Новый_СтрокаКонтекстаСеанса(Данные)
	
	ИменаВложенныхСтруктур = Новый Массив;
	ИменаВложенныхСтруктур.Добавить("Box");
	ИменаВложенныхСтруктур.Добавить("Сертификат");
	ИменаВложенныхСтруктур.Добавить("ОписаниеПользователя");
	ИменаВложенныхСтруктур.Добавить("ДополнительныеФункции");
	ИменаВложенныхСтруктур.Добавить("СервисПодпискиНаМодуль");
	ИменаВложенныхСтруктур.Добавить("ЛицевыеСчета");
	
	ИсключаемыеСвойства = Общее_СоединитьСтроку(ИменаВложенныхСтруктур, ",");
	
	Модель = Контракт_СтрокаКонтекстаСеанса();
	ЗаполнитьЗначенияСвойств(Модель, Данные, , ИсключаемыеСвойства);
	
	Если ЗначениеЗаполнено(Данные.Box) Тогда
		Модель.Box = Контракт_ЯщикДиадока();
		ЗаполнитьЗначенияСвойств(Модель.Box, Данные.Box);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.Сертификат) Тогда
		Модель.Сертификат = Контракт_ОписаниеСертификата();
		ЗаполнитьЗначенияСвойств(Модель.Сертификат, Данные.Сертификат);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.ОписаниеПользователя) Тогда
		Модель.ОписаниеПользователя = Контракт_ОписаниеПользователяДиадока();
		ЗаполнитьЗначенияСвойств(Модель.ОписаниеПользователя, Данные.ОписаниеПользователя);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.ДополнительныеФункции) Тогда
		Модель.ДополнительныеФункции = Контракт_НастройкиЯщикаДиадока();
		ЗаполнитьЗначенияСвойств(Модель.ДополнительныеФункции, Данные.ДополнительныеФункции);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.СервисПодпискиНаМодуль) Тогда
		Модель.СервисПодпискиНаМодуль = Новый_ДоступныйСервис(Данные.СервисПодпискиНаМодуль);
	КонецЕсли;
	
	ДанныеЛицевыхСчетов = Неопределено;
	Данные.Свойство("ЛицевыеСчета", ДанныеЛицевыхСчетов);
	
	Если ЗначениеЗаполнено(ДанныеЛицевыхСчетов) Тогда
		
		Для Каждого ДанныеЛицевогоСчета Из ДанныеЛицевыхСчетов Цикл
			
			НовыйЛицевойСчет = Контракт_ЛицевойСчет();
			
			НовыйЛицевойСчет.ЛицевойСчет = ДанныеЛицевогоСчета.ЛицевойСчет;
			НовыйЛицевойСчет.КодПродукта = ДанныеЛицевогоСчета.КодПродукта;
			
			Для Каждого ДанныеДоступногоСервиса Из ДанныеЛицевогоСчета.ДоступныеСервисы Цикл
				
				ДоступныйСервис = Новый_ДоступныйСервис(ДанныеДоступногоСервиса);
				НовыйЛицевойСчет.ДоступныеСервисы.Добавить(ДоступныйСервис);
				
			КонецЦикла;
			
			Модель.ЛицевыеСчета.Добавить(НовыйЛицевойСчет);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Модель;
	
КонецФункции

// Инициализирует описание сессии в ящике организации и добавляет его в контекст сеанса.
// Имена ключей структуры СтрокаКонтекстаСеанса должны соответствовать именам ключей
// публичной модели строки контекста сеанса (см .Контракт_СтрокаКонтекстаСеанса).
// Используемые ключи перечислены в описании параметров метода.
// Остальные ключи игнорируются.
//
// Параметры:
//  АдресЯщика - Строка - Адрес ящика в формате <...@diadoc.ru>.
//                        Для служебной учетной записи допускается пустая строка.
//  СтрокаКонтекстаСеанса - Структура, ФиксированнаяСтруктура - Параметры инициализации контекста
//   * Токен - Строка - Авторизационный токен (поддерживаются только токены DiadocAuth)
//   * Сертификат - Структура - (Необязательный) см. Контракт_ОписаниеСертификата
//
Процедура ЭДО_КонтекстСеансаКлиентСервер_Добавить(АдресЯщика, СтрокаКонтекстаСеанса) Экспорт
	
	Перем ТокенДоступа;
	Перем Сертификат;
	
	Если ТипЗнч(АдресЯщика) <> Тип("Строка") Тогда
		Ошибка =
		"Несоответствие типов: Параметр 'АдресЯщика' должен быть строкой!
		|Адрес ящика должен быть в формате <...@diadoc.ru> или пустой строкой (для служебной учетной записи)";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Если ТипЗнч(СтрокаКонтекстаСеанса) <> Тип("Структура")
		И ТипЗнч(СтрокаКонтекстаСеанса) <> Тип("ФиксированнаяСтруктура") Тогда
		Ошибка = "Несоответствие типов: Параметр 'СтрокаКонтекстаСеанса' должен быть структурой";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Если Не СтрокаКонтекстаСеанса.Свойство("Токен", ТокенДоступа) Тогда
		Ошибка = "Отсутствует обязательное поле 'СтрокаКонтекстаСеанса.Токен'";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТокенДоступа) Тогда
		Ошибка = "Не указан авторизационный токен (СтрокаКонтекстаСеанса.Токен)";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	СтрокаКонтекстаСеанса.Свойство("Сертификат", Сертификат);
	
	Сессия = Ядро.Новый_СессияДиадокНеизвестнаяСхема(ТокенДоступа);
	
	КонтекстЯщика = Ядро.СоздатьСтрокуКонтекстаСеанса(АдресЯщика, Сессия, Сертификат);
	
	Ядро.КонтекстСеанса_ДобавитьСтроку(АдресЯщика, КонтекстЯщика);
	
КонецПроцедуры

// Получает сведения о пользователях Диадока в указанном ящике
//
// Параметры:
//  BoxId - Строка - адрес или идентификатор ящика
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - содержит ключи:
//    * CurrentUserId - Строка - идентификатор текущего пользователя
//    * Users - ФиксированныйМассив из ФиксированнаяСтруктура - список пользователей:
//      ** Id - Строка - идентификатор пользователя
//      ** Name - Строка - ФИО пользователя
//      ** Position - Строка - должность пользователя
//      ** Permissions - ФиксированнаяСтруктура - права пользователя (см. OrganizationUserPermissions)
//
Функция ЭДО_СписокПользователейДиадока(BoxId) Экспорт
	
	// Устаревший метод GetOrganizationUsers (в сыром виде)
	Данные = Ядро.ПользователиОрганизации(BoxId);
	
	СписокПользователей = Новый Массив;
	
	Для Каждого Элемент Из Данные.Users Цикл
		
		Модель = Новый Структура;
		Модель.Вставить("Id", Элемент.Id);
		Модель.Вставить("Name", Элемент.Name);
		Модель.Вставить("Position", Элемент.Position);
		Модель.Вставить("Permissions", Элемент.Permissions); // OrganizationUserPermissions
		
		СписокПользователей.Добавить(Модель);
		
	КонецЦикла;
	
	Ответ = Новый Структура;
	Ответ.Вставить("CurrentUserId", Данные.CurrentUserId);
	Ответ.Вставить("Users", СписокПользователей);
	
	Результат = ФиксированныеДанныеЛок(Ответ);
	
	Возврат Результат;
	
КонецФункции

// (Устарела) Получает авторизационный токен по отпечатку сертификата и возвращает сведения о соединении.
// Сертификат должен быть установлен на сервере приложений и быть доступен пользователю ОС,
// от имени которого запущен рабочий процесс сервера приложений.
//
// Параметры:
//  ОтпечатокСертификата - Строка - отпечаток сертификата
//  НаименованиеОрганизации - Строка - (Необязательный) представление организации, в ящик которой предоставляется доступ
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - содержит ключи:
//   * Токен - Строка - токен доступа
//   * ТипАвторизации - Строка - значение "Сертификат"
//   * ОтпечатокСертификата - Строка - отпечаток сертификата
//   * Сертификат - ФиксированнаяСтруктура - см. Контракт_ОписаниеСертификата
//   * СертификатBase64 - Строка - двоичные данные сертификата в формате Base64
//   * Логин - Строка - всегда пустая строка (для совместимости)
//
Функция ЭДО_СоздатьОбъектСоединенияПоСертификату(Знач ОтпечатокСертификата, Знач НаименованиеОрганизации = "") Экспорт
	
	ОтпечатокСертификата = ВРег(ОтпечатокСертификата);
	
	Токен = Ядро.Авторизация_СоединенияПоСертификату(ОтпечатокСертификата, НаименованиеОрганизации);
	
	ДанныеСертификата = Ядро.Сертификаты_ДанныеСертификата(ОтпечатокСертификата);
	
	ОписаниеСертификата = Ядро.Сертификаты_ОписаниеСертификата(ДанныеСертификата);
	Сертификат = Контракт_ОписаниеСертификата();
	ЗаполнитьЗначенияСвойств(Сертификат, ОписаниеСертификата);
	
	Модель = Новый Структура;
	Модель.Вставить("Токен", Токен);
	Модель.Вставить("ТипАвторизации", "Сертификат");
	Модель.Вставить("ОтпечатокСертификата", ОтпечатокСертификата);
	Модель.Вставить("Сертификат", Сертификат);
	Модель.Вставить("СертификатBase64", Base64Строка(ДанныеСертификата.ДвоичныеДанные));
	Модель.Вставить("Логин", "");
	
	Результат = ФиксированныеДанныеЛок(Модель);
	
	Возврат Результат;
	
КонецФункции

