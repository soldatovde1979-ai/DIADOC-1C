// Возвращает список доступных пользователю организаций.
// Если токен доступа не передан явно, используется сессия
// текущего пользователя в указанном ящике.
//
// Параметры:
//  BoxId - Строка - адрес или идентификатор ящика
//  ТокенДоступа - Строка - авторизационный токен (только для схемы DiadocAuth)
// 
// Возвращаемое значение:
//  Массив из Контракт_Организация - список организаций.
//
Функция ЭДО_ПолучитьСписокОрганизацийДиадока(BoxId = Неопределено, ТокенДоступа = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ТокенДоступа) Тогда
		Сессия = Ядро.Новый_СессияДиадокНеизвестнаяСхема(ТокенДоступа);
	Иначе
		
		ВызыватьИсключение = Ложь;
		СтрокаКонтекста = Ядро.КонтекстСеанса_СтрокаКонтекста(BoxId, ВызыватьИсключение);
		
		Если СтрокаКонтекста = Неопределено
			И ЗначениеЗаполнено(BoxId) Тогда
			СтрокаКонтекста = Ядро.КонтекстСеанса_СтрокаКонтекста("", ВызыватьИсключение);
		КонецЕсли;
		
		Если СтрокаКонтекста = Неопределено Тогда
			Ошибка = ЭДО_Служебные_ПодставитьПараметрыВСтроку("Не удалось определить параметры соединения (BoxId = %1)", BoxId);
			ВызватьИсключение Ошибка;
		КонецЕсли;
		
		Сессия = СтрокаКонтекста.Сессия;
		
	КонецЕсли;
	
	Результат = Ядро.Организации_ДоступныеОрганизации(Сессия);
	
	Возврат Результат;
	
КонецФункции

// Выполняет групповое сопоставление контрагентов.
// При использовании альтернативной системы хранения необходимо
// передавать сведения об организации сервиса.
//
// Параметры:
//  Организация - Структура - данные организации сервиса (см. Организации_ЗаполненныеРеквизиты).
// 
// Возвращаемое значение:
//  Структура - результат сопоставления:
//   * КоличествоСопоставленных - Число - количество успешно сопоставленных контрагентов.
//   * МассивОшибокДублей - Массив из Строка - коллекция ошибок сопоставления, связанных с дублями контрагентов.
//   * МассивОшибокСопоставления - Массив из Строка - коллекция прочих ошибок сопоставления.
//
Функция ЭДО_ВыполнитьГрупповоеСопоставлениеКонтрагентов(Организация = Неопределено) Экспорт
	
	Если Не ИспользоватьПодсистемуДиадока()
