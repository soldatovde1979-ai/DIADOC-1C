//
// Пример:
//  АвансИнфо = ОсновнойМодуль.Новый_АвансИнфо();
//  АвансИнфо.Номер = НомерАСФ;
//  АвансИнфо.Дата = ДатаАСФ;
//
Функция Новый_АвансИнфо() Экспорт
	Результат = Контракт_АвансИнфо();
	Возврат Результат;
КонецФункции

// Добавляет сведения для заполнения графы 5б счета-фактуры
//
// Параметры:
//  Контент - ОбъектXDTO, Структура - контент электронного документа (UTD970SellerContent)
//  АвансИнфо - Структура - сведения об авансовом счете-фактуре (см. Контракт_АвансИнфо)
//
// Пример:
//  Контент = ПараметрыСобытия.Результат.Content;
//  Выборка = Запрос.Выполнить().Выбрать();
//  Пока Выборка.Следующий() Цикл
//      АвансИнфо = ОсновнойМодуль.Новый_АвансИнфо();
//      АвансИнфо.Номер = Выборка.НомерАСФ;
//      АвансИнфо.Дата = Выборка.ДатаАСФ;
//      ОсновнойМодуль.Авансы_Добавить(Контент, АвансИнфо);
//  КонецЦикла;
//
// @ПубличныйПрограммныйИнтерфейс
//
Процедура Авансы_Добавить(Контент, АвансИнфо) Экспорт
	
	ИмяМетода = "КонтурДиадокВызовыПМ.УПД_ДобавитьАванс";
	
	ДопустимыеТипыКонтента = Новый Массив;
	ДопустимыеТипыКонтента.Добавить(Тип("ОбъектXDTO"));
	ДопустимыеТипыКонтента.Добавить(Тип("Структура"));
	
	_ПроверитьПараметр(ИмяМетода, "Контент", Контент, ДопустимыеТипыКонтента);
	
	ОжидаемыеТипыСвойствАванса = Новый_АвансИнфо();
	ОжидаемыеТипыСвойствАванса.Дата = Тип("Дата");
	ОжидаемыеТипыСвойствАванса.Номер = Тип("Строка");
	ОжидаемыеТипыСвойствАванса.ИсправлениеДата = Тип("Дата");
	ОжидаемыеТипыСвойствАванса.ИсправлениеНомер = Тип("Число");
	
	_ПроверитьПараметр(ИмяМетода, "АвансИнфо", АвансИнфо, Тип("Структура"), ОжидаемыеТипыСвойствАванса);
	_Проверить(ЗначениеЗаполнено(АвансИнфо.Дата), "Не заполнено поле 'АвансИнфо.Дата'", ИмяМетода);
	_Проверить(ЗначениеЗаполнено(АвансИнфо.Номер), "Не заполнено поле 'АвансИнфо.Номер'", ИмяМетода);
	
	ЕстьНомерИсправления = ЗначениеЗаполнено(АвансИнфо.ИсправлениеНомер);
	ЕстьДатаИсправления = ЗначениеЗаполнено(АвансИнфо.ИсправлениеДата);
	ЭтоИсправление = ЕстьНомерИсправления Или ЕстьДатаИсправления;
	
	Если ЭтоИсправление Тогда
		
		_Проверить(ЕстьНомерИсправления, "Не заполнено поле 'АвансИнфо.ИсправлениеНомер'", ИмяМетода);
		_Проверить(ЕстьДатаИсправления, "Не заполнено поле 'АвансИнфо.ИсправлениеДата'", ИмяМетода);
		_Проверить(
			АвансИнфо.ИсправлениеДата >= АвансИнфо.Дата,
			"'АвансИнфо.ИсправлениеДата' не может быть меньше 'АвансИнфо.Дата'",
			ИмяМетода
		);
		
		// BSLLS:NestedFunctionInParameters-off
		AdditionalInfo = Общее_ПараметрыВСтроку(
			"%1 № %2 от %3",
			Конст_ИмяДокументаИспАСЧФ(),
			XMLСтрока(АвансИнфо.ИсправлениеНомер),
			Формат(АвансИнфо.ИсправлениеДата, "ДФ=dd.MM.yyyy")
		);
		// BSLLS:NestedFunctionInParameters-on
		
	КонецЕсли;
	
	ТипПараметраКонтент = ТипЗнч(Контент);
	
	Если ТипПараметраКонтент = Тип("ОбъектXDTO") Тогда
		
		Элемент = НовыйЭлементСпискаXDTO(Контент.AccompanyingDocuments);
		
		УстановитьЗначениеXDTO(Элемент, "Name", Конст_ИмяДокументаАСЧФ());
		УстановитьЗначениеXDTO(Элемент, "Date", АвансИнфо.Дата);
		УстановитьЗначениеXDTO(Элемент, "Number", АвансИнфо.Номер);
		
		Если ЭтоИсправление Тогда
			УстановитьЗначениеXDTO(Элемент, "AdditionalInfo", AdditionalInfo);
		КонецЕсли;
		
	ИначеЕсли ТипПараметраКонтент = Тип("Структура") Тогда
		
		Коллекция = Неопределено;
		Если Не Контент.Свойство("AccompanyingDocuments", Коллекция) Тогда
			Коллекция = Новый Массив;
			Контент.Вставить("AccompanyingDocuments", Коллекция);
		КонецЕсли;
		
		Элемент = Новый Структура;
		Элемент.Вставить("Name", Конст_ИмяДокументаАСЧФ());
		Элемент.Вставить("Date", АвансИнфо.Дата);
		Элемент.Вставить("Number", АвансИнфо.Номер);
		Если ЭтоИсправление Тогда
			Элемент.Вставить("AdditionalInfo", AdditionalInfo);
		КонецЕсли;
		
		Коллекция.Добавить(Элемент);
		
	Иначе
		
		ВызватьИсключениеНедопустимоеЗначениеПараметра(ИмяМетода, "Контент");
		
	КонецЕсли;
	
КонецПроцедуры

// Очищает сведения об авансах (графа 5б счета-фактуры)
//
// Параметры:
//  Контент - ОбъектXDTO, Структура - контент электронного документа (UTD970SellerContent)
//
// Пример:
//  Контент = ПараметрыСобытия.Результат.Content;
//  ОсновнойМодуль.Авансы_Очистить(Контент);
//
// @ПубличныйПрограммныйИнтерфейс
//
Процедура Авансы_Очистить(Контент) Экспорт
	
	ИмяМетода = "КонтурДиадокВызовыПМ.УПД_ДобавитьАванс";
	
	ДопустимыеТипыКонтента = Новый Массив;
	ДопустимыеТипыКонтента.Добавить(Тип("ОбъектXDTO"));
	ДопустимыеТипыКонтента.Добавить(Тип("Структура"));
	
	_ПроверитьПараметр(ИмяМетода, "Контент", Контент, ДопустимыеТипыКонтента);
	
	Коллекция = Контент.AccompanyingDocuments;
	ОбратныйИндекс = Коллекция.Количество() - 1;
	
	Пока ОбратныйИндекс >= 0 Цикл
		
		Элемент = Коллекция[ОбратныйИндекс];
		Если Элемент.Name = Конст_ИмяДокументаАСЧФ() Тогда
			Коллекция.Удалить(ОбратныйИндекс);
		КонецЕсли;
		
		ОбратныйИндекс = ОбратныйИндекс - 1;
		
	КонецЦикла;
	
КонецПроцедуры

