Функция ЭДО_ПолучитьДанныеДляСохраненияДокументооборота(ДокументДД) Экспорт 
	
	МассивИменАннулирования = ЭДО_Служебные_РазложитьСтрокуВМассивСлов("ПредложениеОбАннулированииПокупателя,
																	   |ПредложениеОбАннулированииПродавца,
																	   |ОтказВПодписанииАннулированияПокупателя,
																	   |ОтказВПодписанииАннулированияПродавца,
																	   |ПодписьАннулированияПокупателя,
																	   |ПодписьАннулированияПродавца");
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", ДокументДД);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Диадок_ХранениеДанных.Ссылка,
	|	Диадок_ХранениеДанных.Наименование КАК ИмяХранилища,
	|	Диадок_ХранениеДанных.ИмяФайла
	|ИЗ
	|	Справочник.Диадок_ХранениеДанных КАК Диадок_ХранениеДанных
	|ГДЕ
	|	Диадок_ХранениеДанных.Владелец = &Владелец";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИндексПодписи = 0;
	
	Пока Выборка.Следующий() Цикл
		
		ЭтоАннулирование = Не МассивИменАннулирования.Найти(Выборка.ИмяХранилища) = Неопределено;
		
		ДвоичныеДанные = ЭДО_ПолучитьДанныеХранилища(ДокументДД, Выборка.ИмяХранилища);
		Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") И ЗначениеЗаполнено(Выборка.ИмяФайла) Тогда
			Результат.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные, ЭтоАннулирование", Выборка.ИмяФайла, ДвоичныеДанные, ЭтоАннулирование));
		КонецЕсли;
		
		// Пока что будем сохранять только основную подпись, поскольку хранение согласующей подписи не реализовано
		
		ДвоичныеДанныеПодписи = ЭДО_ПолучитьХранилищеПодписи(ДокументДД, Выборка.ИмяХранилища);
		Если ТипЗнч(ДвоичныеДанныеПодписи) = Тип("ДвоичныеДанные") И ЗначениеЗаполнено(Выборка.ИмяФайла) Тогда
			
			ИндексПодписи = ИндексПодписи + 1;
			ИмяФайлаДокумента = ЭДО_РеквизитыИмениФайла(Выборка.ИмяФайла).ИмяБезРасширения;
			ИмяФайлаПодписи = ИмяФайлаДокумента + "_SGN_" + Формат(ИндексПодписи, "ЧГ=0") + ".sgn";
			
			Результат.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанные, ЭтоАннулирование", ИмяФайлаПодписи, ДвоичныеДанныеПодписи, ЭтоАннулирование));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭДО_РеквизитыИмениФайла(Знач ИмяФайла)
	
