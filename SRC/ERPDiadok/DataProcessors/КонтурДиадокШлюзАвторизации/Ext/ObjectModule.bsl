// Обработка данных предложений для покупки из KStore

Функция ША_ПредложенияДляПокупки(Продукт, ЛицевойСчет)
	
	Адрес = "/offers";
	Ответ = ША_PostJson(Адрес, ША_ЗапросПредложений(Продукт, ЛицевойСчет));
	
	Если НЕ ША_ПроверитьСостояние(Ответ) Тогда
		ВызватьИсключение ША_ТелоОписаниеОшибки(Ответ);
	КонецЕсли;
	
	Данные = ША_ТелоJson(Ответ);
	Модель = ША_РазобратьОтветПредложений(Данные);
	
	Результат = ША_ФиксированныеДанные(Модель);
	
	Возврат Результат;
	
КонецФункции

Функция ША_ЗапросПредложений(Продукт, ЛицевойСчет)
	
	ДанныеДляЗапроса = Новый Соответствие;
	ДанныеДляЗапроса.Вставить("productId", Продукт);
	ДанныеДляЗапроса.Вставить("accountId", ЛицевойСчет);
	
	Запрос = Новый Соответствие;
	Запрос.Вставить("clientAttributes", ДанныеДляЗапроса);
	
	Возврат Запрос;
	
КонецФункции

Функция ША_РазобратьОтветПредложений(Данные)
	
	Результат = Контракт_ПредложенияДляПокупки();
	
	Для Каждого ТекущееПредложение Из Данные Цикл
		
		ПредложениеДляПокупки = Контракт_ПредложениеДляПокупкиИзСервиса();
		
		ДопИнформация = ТекущееПредложение.Получить("creationInfo");
		ПредложениеДляПокупки.ДопИнформация = ДопИнформация;
		
		СсылкаНаПредложение = ТекущееПредложение.Получить("link");
		
		ПредложениеДляПокупки.Ссылка = СсылкаНаПредложение;
		ПредложениеДляПокупки.Сценарий = ДопИнформация.Получить("scenarioId");
		ПредложениеДляПокупки.ПодпискаПродления = ША_ЗначениеПараметраСсылки(СсылкаНаПредложение, "entityId");
		ПредложениеДляПокупки.Тариф = ША_ЗначениеПараметраСсылки(СсылкаНаПредложение, "tariffId");
		ПредложениеДляПокупки.Тип = ДопИнформация.Получить("activity");
		
		Если НЕ ЗначениеЗаполнено(ПредложениеДляПокупки.Тип) Тогда
			ПредложениеДляПокупки.Тип = "";
		КонецЕсли;
		
		ОстатокТрафика = ДопИнформация.Получить("remainingTraffic");
		
		Если ЗначениеЗаполнено(ОстатокТрафика)
			И НРег(ОстатокТрафика) <> "null" Тогда
			ПредложениеДляПокупки.ОстатокТрафика = Число(ОстатокТрафика);
		Иначе
			ПредложениеДляПокупки.ОстатокТрафика = Неопределено;
		КонецЕсли;
		
		ДатаОкончания = ША_ПриведеннаяДатаИзСтроки(ДопИнформация.Получить("endDate"));
		ПредложениеДляПокупки.ДатаОкончания = ДатаОкончания;
		
		Если ЗначениеЗаполнено(ДатаОкончания) Тогда
			
			ЧасовойПоясМосквы = "Europe/Moscow";
			УниверсальнаяДатаОкончания = УниверсальноеВремя(ДатаОкончания, ЧасовойПоясМосквы);
			
			ПредложениеДляПокупки.ДатаОкончания = ША_ПриведеннаяЛокальнаяДата(УниверсальнаяДатаОкончания);
			
			Если УниверсальнаяДатаОкончания <= ТекущаяУниверсальнаяДата() Тогда
				ПредложениеДляПокупки.СрокДействияИстек = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Результат.Добавить(ПредложениеДляПокупки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ЗначениеПараметраСсылки(Ссылка, ИмяПараметра)
	
	Результат = "";
	
	МеткаДляПоиска = ИмяПараметра + "=";
	
	ДлинаМеткиДляПоиска = СтрДлина(МеткаДляПоиска);
	
	// BSLLS:DeprecatedFind-off
	ПозицияНачалаСтрокиПараметров = Найти(Ссылка, "?") + 1;
	// BSLLS:DeprecatedFind-on
	
	СтрокаПараметровСсылки = Сред(Ссылка, ПозицияНачалаСтрокиПараметров);
	
	КоллекцияПараметров = ША_СтрРазделить(СтрокаПараметровСсылки, "&");
	
	Для Каждого ЧастьСсылки Из КоллекцияПараметров Цикл
		
		Если Лев(ЧастьСсылки, ДлинаМеткиДляПоиска) = МеткаДляПоиска Тогда
			
			Результат = СтрЗаменить(ЧастьСсылки, МеткаДляПоиска, "");
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Конвертирует значение из строкового представления даты 
//
// Параметры:
//   ДатаСтрокой - Строка - Представление даты в формате "MM/DD/YYYY hh:mm:ss AM/PM"
//
// Возвращаемое значение:
//   Дата, Неопределено - Сконвертированная дата. Если дата не заполнена, то возвращается Неопределено.
//
Функция ША_ПриведеннаяДатаИзСтроки(ДатаСтрокой)    
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(ДатаСтрокой) Тогда
		
		СоставПолнойДаты = ША_СтрРазделить(ДатаСтрокой, " ");
		
		Если СоставПолнойДаты.Количество() > 1 Тогда
			
			СоставДаты = ША_СтрРазделить(СоставПолнойДаты[0], "/");
			СоставВремени = ША_СтрРазделить(СоставПолнойДаты[1], ":");
			
			Если СоставДаты.Количество() = 3
				И СоставВремени.Количество() = 3 Тогда
				
				Если СоставПолнойДаты.Количество() = 3
					И СоставПолнойДаты[2] = "PM"
					И Число(СоставВремени[0]) < 12 Тогда
					СоставВремени[0] = 12 + СоставВремени[0];
				КонецЕсли;
				
				Результат = Дата(СоставДаты[2], СоставДаты[0], СоставДаты[1], СоставВремени[0], СоставВремени[1], СоставВремени[2]);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

Функция ША_ПриведеннаяЛокальнаяДата(УниверсальнаяДатаДляПриведения)
	
	Если ЗначениеЗаполнено(УниверсальнаяДатаДляПриведения) Тогда
		
		ПоправкаДляЛокальногоВремени = ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата();
		Результат = УниверсальнаяДатаДляПриведения + ПоправкаДляЛокальногоВремени;
		
	Иначе
		Результат = УниверсальнаяДатаДляПриведения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ПриведенноеЧислоИзСтроки(Знач Строка)
	
	Результат = Неопределено;
	
	ПредставлениеЗначенияNULL = "null";
	
	Если ЗначениеЗаполнено(Строка)
		И Нрег(Строка) <> ПредставлениеЗначенияNULL Тогда
		
		ОписаниеТипа = Новый ОписаниеТипов("Число");
		Результат = ОписаниеТипа.ПривестиЗначение(Строка);

		Если НЕ ЗначениеЗаполнено(Результат) Тогда	
			
			Строка = СтрЗаменить(Строка, ",", ".");
			Строка = СтрЗаменить(Строка, " ", "");
			Строка = СтрЗаменить(Строка, Символы.НПП, "");
			
			Если ЗначениеЗаполнено(Строка) Тогда
				Результат = Число(Строка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контракт_ПредложениеДляПокупкиИзСервиса()
	
	Результат = Новый Структура;
	
