////////////////////////////////////////////////////////////////////////////////
// Шлюз авторизации: Получение данных Биллинга и предложений для покупки из KStore
//
////////////////////////////////////////////////////////////////////////////////

// BSLLS:UnusedLocalVariable-off

// Коллекция категорий ошибок
Перем КатегорииОшибок;

// Служебный конекст
Перем _Сессия, _Локация, _Коннектор;

// BSLLS:UnusedLocalVariable-on

////////////////////////////////////////////////////////////////////////////////
// Программный интерфейс

// Инициализирует объект библиотеки
//
// Параметры:
//   Параметры - Структура - см. ПараметрыИнициализации
//
// Возвращаемое значение:
//   ОбработкаОбъект - Инициализированный объект библиотеки
//
Функция Инит(Параметры = Неопределено) Экспорт
	
	ПараметрыИнициализации = ПараметрыИнициализации();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыИнициализации, Параметры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыИнициализации.Локация) Тогда
		_Локация = ПараметрыИнициализации.Локация;
	КонецЕсли;
	
	Если ПараметрыИнициализации.HTTP = Неопределено Тогда
		_Коннектор = Новый(___HTTP);
	Иначе
		_Коннектор = ПараметрыИнициализации.HTTP;
	КонецЕсли;
	
	Сессия = ША_Сессия();
	
	Если ЗначениеЗаполнено(ПараметрыИнициализации.ЗаголовокАвторизации) Тогда
		Сессия.Заголовки.Вставить("Authorization", ПараметрыИнициализации.ЗаголовокАвторизации);
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции

// Описание параметров инициализации библиотеки
//
// Возвращаемое значение:
//  Структура - Параметры клиента
//     * Локация - Строка - (необязательный) Локация сервиса
//     * ЗаголовокАвторизации - Строка - (необязательный) Authorization
//
Функция ПараметрыИнициализации() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Локация", "https://api.kontur.ru/1c/auth-proxy");
	Модель.Вставить("ЗаголовокАвторизации");
	Модель.Вставить("HTTP");
	
	Возврат Модель;
	
КонецФункции

// Запрашивает авторизацию на текущий момент времени
//
// Параметры:
//  Продукт - Строка - Имя продукта в сервисе Шлюза авторизации
//
// Возвращаемое значение:
//  Структура - см. Контракт_ДанныеБиллинга
//
Функция АвторизацияБиллинга(Продукт) Экспорт
	
	АдресМетода = "/subscriptions";
		
	Возврат ША_ДанныеБиллинга(АдресМетода, Продукт);
	
КонецФункции

// Запрашивает все активированные подписки
//
// Параметры:
//  Продукт - Строка - Имя продукта в сервисе Шлюза авторизации
//
// Возвращаемое значение:
//  Структура - см. Контракт_ДанныеБиллинга
//
Функция АктивныеПодпискиБиллинга(Продукт) Экспорт
	
	АдресМетода = "/subscriptions-search";	
		
	Возврат ША_ДанныеБиллинга(АдресМетода, Продукт);
	
КонецФункции

// Запрашивает доступные предложения KStore для покупки
//
// Параметры:
//  Продукт - Строка - Имя продукта в сервисе Шлюза авторизации
//  ЛицевойСчет - Строка - Идентификатор лицевого счета
//
// Возвращаемое значение:
//  Структура - см. Контракт_ПредложенияДляПокупки
//
Функция ПредложенияДляПокупки(Продукт, ЛицевойСчет) Экспорт
	
	ША_ПроверитьПараметры(ША_НесоответствиеТипов(Продукт, "Строка"));
	
	ША_ПроверитьПараметры(ША_НеЗаполнено(Продукт));
	
	Возврат ША_ПредложенияДляПокупки(Продукт, ЛицевойСчет);
	
КонецФункции

// Возвращает контракт результа функции АвторизацияБиллинга().
// Может использоваться для обработки исключений в других библиотеках.
//
// Возвращаемое значение:
//  Соответствие - Контейнер для данных Билинга
//
Функция Контракт_ДанныеБиллинга() Экспорт
	
	Результат = Новый Соответствие;
	
	Возврат Результат;
	
КонецФункции

// Возвращает контракт результа функции ПредложенияДляПокупки().
// Может использоваться для обработки исключений в других библиотеках.
//
// Возвращаемое значение:
//  Массив - Контейнер для предложений для покупки от KStore
//
Функция Контракт_ПредложенияДляПокупки() Экспорт
	
	Результат = Новый Массив;
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции

// Обработка данных Биллинга

Функция ША_ДанныеБиллинга(АдресМетода, Продукт)
	
	ОшибкаОтсутствияЗначения = ША_НеЗаполнено(Продукт);
	ОшибкаНесоответствияТипов = ША_НесоответствиеТипов(Продукт, "Строка");
	
	ША_ПроверитьПараметры(ОшибкаОтсутствияЗначения, ОшибкаНесоответствияТипов);
		
	Ответ = ША_PostJson(АдресМетода, ША_ТелоЗапросаДанныхБиллинга(Продукт));
	
	Если НЕ ША_ПроверитьСостояние(Ответ) Тогда
		ВызватьИсключение ША_ТелоОписаниеОшибки(Ответ);
	КонецЕсли;
	
	Данные = ША_ТелоJson(Ответ);
	Модель = ША_РазобратьОтветДанныхБиллинга(Данные);
	
	Результат = ША_ФиксированныеДанные(Модель);
	
	Возврат Результат;
	
КонецФункции

Функция ША_ТелоЗапросаДанныхБиллинга(Продукт)
	
	Запрос = Новый Соответствие;
	Запрос.Вставить("product-id", Продукт);
	
	Возврат Запрос;
	
КонецФункции

Функция ША_РазобратьОтветДанныхБиллинга(Данные)
	
	Результат = Контракт_ДанныеБиллинга();
	
	Accounts = Данные.Получить("accounts");
	
	НастройкиОплатПлательщикомДляЛС = ША_НастройкиОплатПлательщикомДляЛС(Accounts);
	
	Для Каждого Account_data Из Accounts Цикл
		
		Account = Account_data.Получить("account");
		
		ИдентификаторЛС = Account.Получить("recipient-id");
		КодПродуктаЛС = Account.Получить("product-code");
		
		Subscriptions = Account_data.Получить("subscriptions");
		ПодпискиЛС = ША_ДанныеПодпискиБиллинга(Subscriptions);
		
		Client_ids = Account_data.Получить("client-ids");
		
		Для Каждого Client_id Из Client_ids Цикл
			
			ЛицевыеСчетаКлиента = Результат.Получить(Client_id);
			
			Если ЛицевыеСчетаКлиента = Неопределено Тогда
				
				ЛицевыеСчетаКлиента = Новый Массив;
				Результат.Вставить(Client_id, ЛицевыеСчетаКлиента);
				
			КонецЕсли;
			
			НастройкаОплатыДляЛС = НастройкиОплатПлательщикомДляЛС.Получить(Client_id);
			
			ЛицевойСчет = Контракт_ЛицевойСчетИзСервиса();
			
			ЛицевойСчет.Идентификатор = ИдентификаторЛС;
			ЛицевойСчет.КодПродукта = КодПродуктаЛС;
			ЛицевойСчет.ОплатаПлательщиком = ША_ПризнакОплатыПлательщикомЗаКлиента(ИдентификаторЛС, НастройкаОплатыДляЛС);
			ЛицевойСчет.Подписки = ША_ПодпискиЛицевогоСчетаКлиента(ИдентификаторЛС, ПодпискиЛС, НастройкаОплатыДляЛС);
			
			ЛицевыеСчетаКлиента.Добавить(ЛицевойСчет);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ША_НастройкиОплатПлательщикомДляЛС(Accounts)
	
	Результат = Новый Соответствие;
	
	Для Каждого Account_data Из Accounts Цикл
		
		Account = Account_data.Получить("account");
		
		Clients = Account.Получить("clients");
		
		Если Clients = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИдентификаторЛС = Account.Получить("recipient-id");
		
		Для Каждого Client Из Clients Цикл
			
			Client_id = Client.Получить("id");
			
			Если Client_id = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ОплатаДокументовПлательщиком = Ложь;
			ОплатаМаршрутовПлательщиком = Ложь;
			
			Client_paid_functionality = Client.Получить("paid-functionality");
			
			Если ЗначениеЗаполнено(Client_paid_functionality) Тогда
				
				Client_paid_documents = Client_paid_functionality.Получить("documents");
				Client_paid_routes = Client_paid_functionality.Получить("routes");
				
				ОплатаДокументовПлательщиком = (Client_paid_documents = Истина);
				ОплатаМаршрутовПлательщиком = (Client_paid_routes = Истина);
				
			КонецЕсли;
			
			ОплатаПлательщиком = (ОплатаДокументовПлательщиком ИЛИ ОплатаМаршрутовПлательщиком);
			
			Если ОплатаПлательщиком Тогда
				
				НастройкаЛицевогоСчета = Новый Структура;
				
				НастройкаЛицевогоСчета.Вставить("ИдентификаторЛС", ИдентификаторЛС);
				НастройкаЛицевогоСчета.Вставить("ОплатаДокументовПлательщиком", ОплатаДокументовПлательщиком);
				НастройкаЛицевогоСчета.Вставить("ОплатаМаршрутовПлательщиком", ОплатаМаршрутовПлательщиком);
				
				Результат.Вставить(Client_id, НастройкаЛицевогоСчета);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ДанныеПодпискиБиллинга(Subscriptions)
	
	Результат = Новый Массив;
	
	Для Каждого Subscription_data Из Subscriptions Цикл
		
		ДанныеПодписки = Контракт_Подписка();
		
		ТипыПодписки = ША_ТипыПодписки();
		
		ДанныеПодписки.Идентификатор = Subscription_data.Получить("id");
		ДанныеПодписки.ИдентификаторОсновнойПодписки = Subscription_data.Получить("parent-id");
		ДанныеПодписки.КодПродукта = Subscription_data.Получить("product-code");
		ДанныеПодписки.Тип = ТипыПодписки.Получить(Subscription_data.Получить("type"));
		ДанныеПодписки.Активна = ША_ПодпискаАктивна(Subscription_data.Получить("state"));
		
		ДатаНачала = ША_ПриведеннаяДатаИзТиков(Subscription_data.Получить("begin-utc-date-ticks"));
		ДатаОкончания = ША_ПриведеннаяДатаИзТиков(Subscription_data.Получить("end-utc-date-ticks"));
		
		ДанныеПодписки.ДатаНачала = ША_ПриведеннаяЛокальнаяДата(ДатаНачала);
		ДанныеПодписки.ДатаОкончания = ША_ПриведеннаяЛокальнаяДата(ДатаОкончания);
		
		Services = Subscription_data.Получить("services");
		ДанныеПодписки.Сервисы = ША_ДоступныеСервисыБиллинга(Services);
		
		Результат.Добавить(ДанныеПодписки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ДоступныеСервисыБиллинга(Services)
	
	Результат = Новый Массив;
	
	ТипыТрафикаРесурса = ША_ТипыТрафикаРесурса();
	ТипыОграниченийРесурса = ША_ТипыОграниченийРесурса();
	
	Для Каждого Service_data Из Services Цикл
		
		ДанныеСервиса = Контракт_Сервис();
		
		ДанныеСервиса.Имя = Service_data.Получить("named-id");
		ДанныеСервиса.Представление = Service_data.Получить("name");
		
		Resources = Service_data.Получить("resources");
		
		Для Каждого Resource_data Из Resources Цикл
			
			ДанныеРесурса = Контракт_Ресурс();
			
			ДанныеРесурса.Имя = Resource_data.Получить("named-id");
			ДанныеРесурса.Представление = Resource_data.Получить("name");
			ДанныеРесурса.ТипТрафика = ТипыТрафикаРесурса.Получить(Resource_data.Получить("traffic-type"));
			ДанныеРесурса.Ограничение = ТипыОграниченийРесурса.Получить(Resource_data.Получить("limitation"));
			ДанныеРесурса.Количество = ША_ПриведенноеЧислоИзСтроки(Resource_data.Получить("count"));
			ДанныеРесурса.Использовано = ША_ПриведенноеЧислоИзСтроки(Resource_data.Получить("spent-count"));
			
			ДанныеСервиса.Ресурсы.Добавить(ДанныеРесурса);
			
		КонецЦикла;
		
		Результат.Добавить(ДанныеСервиса);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ПризнакОплатыПлательщикомЗаКлиента(ИдентификаторЛС, НастройкаОплатыДляЛС)
	
	Результат = Ложь;
	
	Если НастройкаОплатыДляЛС <> Неопределено
		И НастройкаОплатыДляЛС.ИдентификаторЛС = ИдентификаторЛС Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ПодпискиЛицевогоСчетаКлиента(ИдентификаторЛС, ПодпискиЛС, НастройкаОплатыДляЛС)
	
	Результат = Новый Массив;
	
	Если НастройкаОплатыДляЛС = Неопределено Тогда
		Возврат ПодпискиЛС;
	КонецЕсли;
	
	Для Каждого ПодпискаЛС Из ПодпискиЛС Цикл
		
		ДобавитьПодписку = Ложь;
		
		Для Каждого ДоступныйСервис Из ПодпискаЛС.Сервисы Цикл
			
			ДобавитьПодписку = ША_ТребуетсяДобавитьПодпискуПоСервису(ИдентификаторЛС, ДоступныйСервис, НастройкаОплатыДляЛС);
			
			Если ДобавитьПодписку Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДобавитьПодписку Тогда
			Результат.Добавить(ПодпискаЛС);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ТребуетсяДобавитьПодпискуПоСервису(ИдентификаторЛС, ДоступныйСервис, НастройкаОплатыДляЛС)
	
	Результат = Ложь;
	
	ЭтоЛицевойСчетПлательщика = (ИдентификаторЛС = НастройкаОплатыДляЛС.ИдентификаторЛС);
	ОплатаДокументовПлательщиком = НастройкаОплатыДляЛС.ОплатаДокументовПлательщиком;
	ОплатаМаршрутовПлательщиком = НастройкаОплатыДляЛС.ОплатаМаршрутовПлательщиком;
	
	Сервис_Документы = "exchange";
	Сервис_Маршруты = "route";
	
	ИмяСервиса = НРег(ДоступныйСервис.Имя);
	ЭтоПодпискаНаДокументы = (ИмяСервиса = Сервис_Документы);
	ЭтоПодпискаНаМаршруты = (ИмяСервиса = Сервис_Маршруты);
	
	Если ЭтоЛицевойСчетПлательщика Тогда
		
		ЭтоПодпискаПлательщика = ЭтоПодпискаНаДокументы И ОплатаДокументовПлательщиком
							ИЛИ ЭтоПодпискаНаМаршруты И ОплатаМаршрутовПлательщиком;
		
		Если ЭтоПодпискаПлательщика Тогда
			Результат = Истина;
		КонецЕсли;
		
	Иначе
		
		ЭтоПерсональнаяПодписка = НЕ ЭтоПодпискаНаДокументы И НЕ ЭтоПодпискаНаМаршруты
								ИЛИ ЭтоПодпискаНаДокументы И НЕ ОплатаДокументовПлательщиком
								ИЛИ ЭтоПодпискаНаМаршруты И НЕ ОплатаМаршрутовПлательщиком;
		
		Если ЭтоПерсональнаяПодписка Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ША_ПодпискаАктивна(state)
	
	Результат = (state = 1);
	
	Возврат Результат;
	
КонецФункции

Функция ША_ТипыПодписки()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(0, "Demo");
	Результат.Вставить(1, "Promo");
	Результат.Вставить(2, "Normal");
	
	Возврат Результат;
	
КонецФункции

Функция ША_ТипыТрафикаРесурса()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(0, "Unknown");
	Результат.Вставить(1, "Outgoing");
	Результат.Вставить(2, "Incoming");
	Результат.Вставить(3, "Any");
	
	Возврат Результат;
	
КонецФункции

Функция ША_ТипыОграниченийРесурса()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(0, "Unknown");
	Результат.Вставить(1, "Limit");
	Результат.Вставить(2, "Unlimit");
	
	Возврат Результат;
	
КонецФункции

Функция ША_ПриведеннаяДатаИзТиков(Ticks)
	
	Если ЗначениеЗаполнено(Ticks) Тогда
		Результат = XMLЗначение(Тип("Дата"), XMLСтрока('00010101' + Ticks / 1000 / 1000 / 10));
	Иначе
		Результат = Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Контракт_ЛицевойСчетИзСервиса()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Идентификатор");
	Результат.Вставить("КодПродукта");
	Результат.Вставить("ОплатаПлательщиком", Ложь);
	Результат.Вставить("Подписки", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

