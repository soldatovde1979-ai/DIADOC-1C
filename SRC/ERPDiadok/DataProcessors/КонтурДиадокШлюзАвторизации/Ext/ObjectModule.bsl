// HTTP

Процедура ША_УдалитьНедопустимыеСимволыXML(Строка)
	
	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	Сдвиг = 1;
	НедопустимыйСимвол = НайтиНедопустимыеСимволыXML(Строка, Сдвиг);
	
	Пока НедопустимыйСимвол <> 0 Цикл
		
		Символ = Сред(Строка, НедопустимыйСимвол, 1);
		Строка = СтрЗаменить(Строка, Символ, "");
		Сдвиг = НедопустимыйСимвол - 1;
		НедопустимыйСимвол = НайтиНедопустимыеСимволыXML(Строка, Сдвиг);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ША_URL(URL)
	
	Если Найти(URL, "http") ИЛИ Найти(URL, "https") Тогда
		Возврат URL;
	Иначе
		Возврат _Локация + URL;
	КонецЕсли;
	
КонецФункции

Функция ША_PostJson(Ресурс, Json, ПараметрыЗапроса = Неопределено, ЗаголовкиЗапроса = Неопределено)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Заголовки", Новый Соответствие);
	ДопПараметры.Вставить("Json", Json);
	
	Если ПараметрыЗапроса <> Неопределено Тогда
		ДопПараметры.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	КонецЕсли;
	
	Ответ = _Коннектор.Post(ША_URL(Ресурс), Неопределено, ДопПараметры, ША_Сессия());
	
	Возврат Ответ;
	
КонецФункции

Функция ША_ТелоJson(Ответ)
	
	Возврат _Коннектор.КакJson(Ответ);
	
КонецФункции

Функция ША_ТелоОписаниеОшибки(Ответ, ПодробныеИсключения = Истина)
	
	КраткоеОписание = КатегорииОшибок.ОшибкаСостояния + " "
		+ Строка(Ответ.КодСостояния) + " "
		+ Строка(Ответ.URL);
	Если ПодробныеИсключения = Ложь Тогда
		Возврат КраткоеОписание;
	КонецЕсли;
	
	Подробно = Новый Массив;
	Подробно.Добавить(КраткоеОписание);
	
	Для Каждого Элемент Из Ответ.Заголовки Цикл
		Подробно.Добавить(Строка(Элемент.Ключ) + ": " + Строка(Элемент.Значение));
	КонецЦикла;
	
	Если ТипЗнч(Ответ.Тело) = Тип("ДвоичныеДанные") И Ответ.Тело.Размер() Тогда
		Подробно.Добавить(_Коннектор.КакТекст(Ответ, "utf-8"));
	КонецЕсли;
	
	Результат = ША_СтрСоединить(Подробно, Символы.ПС);
	
	ША_УдалитьНедопустимыеСимволыXML(Результат);
	
	Возврат Результат;
	
КонецФункции

Функция ША_ПроверитьСостояние(Ответ)
	
	НегативноеСостояние = Ответ.КодСостояния >= _Коннектор.КодыСостоянияHTTP().ПеремещеноНавсегда_301;
	
	Результат = НЕ НегативноеСостояние;
	
	Возврат Результат;
	
КонецФункции

Функция ША_Сессия()
	
	Если _Сессия = Неопределено Тогда
		_Сессия = _Коннектор.СоздатьСессию();
	КонецЕсли;
	
	Результат = _Сессия;
	
	Возврат Результат;
	
КонецФункции

// Проверка параметров

Процедура ША_ПроверитьПараметры(Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено)
	
