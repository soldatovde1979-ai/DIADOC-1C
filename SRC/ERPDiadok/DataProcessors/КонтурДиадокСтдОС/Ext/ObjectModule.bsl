// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция РазделительПутиWindows()
	
	Возврат "\";
	
КонецФункции // РазделительПутиWindows

Функция РазделительПутиUnix()
	
	Возврат "/";
	
КонецФункции // РазделительПутиUnix

Функция СтдСтр()
	
	Если СтдСтрЛок = Неопределено Тогда
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
		Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
			СтдСтрЛок = Новый("DataProcessorObject.КонтурДиадокСтдСтр");
		Иначе
			СтдСтрЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтдСтрЛок;
	
КонецФункции // СтдСтр