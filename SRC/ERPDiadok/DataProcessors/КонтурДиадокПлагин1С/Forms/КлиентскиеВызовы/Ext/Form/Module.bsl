	&НаКлиенте
	Функция НоваяКоманда_ПреобразоватьКонтент(Контент, НовыйКонтент, Кодировка)
		
		source = Контент_В_Content(Контент	   , Кодировка);
		sink   = Контент_В_Content(НовыйКонтент, Кодировка);
		
		Результат = Команда_io_transfer(source, sink);
		
		Если ТипКонтента(НовыйКонтент) = "ДвоичныеДанные" Тогда
			Результат.command.custom_data.Вставить("ResultBinaryData")
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ПреобразоватьКонтент(Ответ)
		
		Результат = Content_В_Контент(Ответ.response);
		
		Если Ответ.ДополнительныеПараметры.Свойство("ResultBinaryData") И ЗначениеЗаполнено(Результат) Тогда
			Результат = Base64Значение(Результат);
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_ПолучитьСписокСертификатов(ПараметрыФильтра, СвойстваСертификата)
		
		filter	   = Новый_cert_filter(ПараметрыФильтра);
		properties = Новый_certificateProperties(СвойстваСертификата);
		
		Результат = Команда_cert_search(filter, properties);
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ПолучитьСписокСертификатов(Ответ)
		
		Результат = Новый Массив;
		
		response = Ответ.response;
		
		Если ЗначениеЗаполнено(response) Тогда
			
			Если ТипЗнч(response) = Тип("Массив") Тогда
				
				Для Каждого item ИЗ response Цикл
					Результат.Добавить(Новый_ОписаниеСертификата(item.certificate_info));
				КонецЦикла;
				
			Иначе
				Результат.Добавить(Новый_ОписаниеСертификата(response.certificate_info));
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_ПолучитьДанныеСертификата(Сертификат, СвойстваСертификата)
		
		cert	   = Новый_certificate(Сертификат);
		properties = Новый_certificateProperties(СвойстваСертификата);
		
		Результат = Команда_cert_parse(cert, properties);
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ПолучитьДанныеСертификата(Ответ)
		
		Результат = Неопределено;
		
		Если ЗначениеЗаполнено(Ответ.response) Тогда
			Результат = Новый_ОписаниеСертификата(Ответ.response);
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_ПроверитьПодпись(Контент, Подпись)
		
		source 	  = Контент_В_Content(Контент);
		signature = Контент_В_Content(Подпись);
		
		Результат = Команда_crypto_verify(source, signature);
		
		Возврат Результат;
		
	КонецФункции

