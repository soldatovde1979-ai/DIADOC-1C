&НаКлиенте
Функция СоздатьОбъектПлагина()
	
	Попытка
		
		Результат = Новый("AddIn.KonturPlugin.Kontur.1C.Plugin.SA");
		
	Исключение
		
		Ошибка = ИнформацияОбОшибке();
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПодключитьПлагин() Экспорт
	
	ВерсияПлагина		= ВерсияПлагина();
	
	АдресКомпоненты 	= ПолучитьПолныйПутьКомпоненты();
	
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту(АдресКомпоненты, ИмяВнешнейКомпоненты(), ТипВнешнейКомпоненты.Native);
	
	Если Не КомпонентаПодключена Тогда 
		
		ОписаниеОш = НСтр("ru = 'Не удалось подключить внешнюю компоненту %ИмяВК% (%ИмяФайлаВК%)'");
		ОписаниеОш = СтрЗаменить(ОписаниеОш
						, "%ИмяВК%"
						, ИмяВнешнейКомпоненты());
		ОписаниеОш = СтрЗаменить(ОписаниеОш
						, "%ИмяФайлаВК%"
						, АдресКомпоненты);
		
		ВызватьИсключение ОписаниеОш;
		
	КонецЕсли;
	
	Результат = СоздатьОбъектПлагина();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПолныйПутьКомпоненты()
	
	ВерсияПлагина = ВерсияПлагина();
	ТипПлатформыОС = ПолучитьТипПлатформы();
	ВремКаталог = КаталогВременныхФайлов();
	
	ИмяФайлаСохранения = "";
	
	Если ТипПлатформыОС = ТипПлатформы.Linux_x86_64 Тогда
		
		ИмяЭлементаАрхива	 = "kontur.1c.plugin.napi64." + ВерсияПлагина +".so";
		ИмяФайлаСохранения	 = ВремКаталог + ИмяЭлементаАрхива;
		
	ИначеЕсли ТипПлатформыОС = ТипПлатформы.Windows_x86_64 Тогда	
		
		ИмяЭлементаАрхива	 = "kontur.1c.plugin.napi64." + ВерсияПлагина +".dll";
		ИмяФайлаСохранения	 = ВремКаталог + ИмяЭлементаАрхива;
		
	Иначе
		
		ИмяЭлементаАрхива	 = "kontur.1c.plugin.napi32." + ВерсияПлагина +".dll";
		ИмяФайлаСохранения	 = ВремКаталог + ИмяЭлементаАрхива;
		
	КонецЕсли;
	
	ФайлВК		 = Новый Файл(ИмяФайлаСохранения);
	Если НЕ ФайлВК.Существует() Тогда
		РазархивироватьКомпоненту(ИмяЭлементаАрхива);
	КонецЕсли;
	
	Возврат ИмяФайлаСохранения;
	
КонецФункции

&НаКлиенте
Процедура РазархивироватьКомпоненту(ИмяЭлементаАрхива)
	
	ВремКаталог 	= КаталогВременныхФайлов();
	ИмяZIP 			= "Plugin.zip";
	ПолныйПутьZip 	= ВремКаталог + ИмяZIP;
	
	Макет = ПолучитьМакетОбработки("Plugin");
	Макет.Записать(ПолныйПутьZip);
	
	ЧтениеЗип = Новый ЧтениеZipФайла(ПолныйПутьZip);
	
	ЭлементФайла = ЧтениеЗип.Элементы.Найти(ИмяЭлементаАрхива);
	Если Не ЭлементФайла = Неопределено Тогда
		
		ЧтениеЗип.Извлечь(ЭлементФайла, ВремКаталог);
		
	КонецЕсли;
	
	ЧтениеЗип.Закрыть();
	
	УдалитьФайлы(ПолныйПутьZip);
	
КонецПроцедуры

&наКлиенте
Функция ПроверитьВозможностьПереустановки(АдресКомпоненты, ИмяКомпоненты, ТипКомпоненты)
	
	Результат = Истина;
	
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту(
	АдресКомпоненты,
	ИмяКомпоненты,
	ТипКомпоненты);
	
	Если КомпонентаПодключена Тогда
		
		plugin = СоздатьОбъектПлагина();
		Если СокрЛП(plugin.Version) = ВерсияПлагина() Тогда
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

