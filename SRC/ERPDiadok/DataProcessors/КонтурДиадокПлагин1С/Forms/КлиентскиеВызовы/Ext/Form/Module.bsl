&НаКлиенте
Функция DD_API_Authenticate(КлючРазработчика, Сертификат = "", Логин = "", Пароль = "") Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(Сертификат) Тогда
		
		ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
		ПараметрыЗапроса.ТелоЗапроса = Новый Структура("base64", Сертификат);
		ПараметрыЗапроса.ТелоОтвета  = Новый Структура("base64");
		
		Ответ = ВыполнитьHTTPЗапросДиадок("POST", "/Authenticate", ПараметрыЗапроса, КлючРазработчика);
		
		ПроверитьHTTPКодСостояния200(Ответ);
		
		Результат = РасшифроватьКонтент(Новый Структура("base64", Ответ.ТелоОтвета));
		
	Иначе
		
		ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
		ПараметрыЗапроса.Параметры.ВставитЬ("login"   , Логин);
		ПараметрыЗапроса.Параметры.ВставитЬ("password", Пароль);
		ПараметрыЗапроса.Параметры.ВставитЬ("КодировкаОтвета", "utf-8");
		
		Ответ = ВыполнитьHTTPЗапросДиадок("POST", "/Authenticate", ПараметрыЗапроса, КлючРазработчика);
		
		ПроверитьHTTPКодСостояния200(Ответ);
		
		Результат = Ответ.ТелоОтвета;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция DD_API_GetBox(КлючРазработчика, boxId) Экспорт
	
	ПараметрыЗапроса = НовыеПараметрыHTTPЗапроса();
	ПараметрыЗапроса.Параметры.Вставить("boxId", boxId);
	ПараметрыЗапроса.Вставить("КодировкаОтвета", "utf-8");
	
	Ответ = ВыполнитьHTTPЗапросДиадок("GET", "/GetBox", ПараметрыЗапроса, КлючРазработчика);
	
	ПроверитьHTTPКодСостояния200(Ответ);
	
	Возврат Ответ.ТелоОтвета;
	
КонецФункции

