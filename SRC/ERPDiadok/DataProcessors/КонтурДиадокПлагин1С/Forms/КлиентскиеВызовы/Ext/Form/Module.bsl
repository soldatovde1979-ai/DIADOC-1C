	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СтрокаXML_В_Значение(ЧтениеXML, ДополнительныеПараметры)
	
	#Если Не ВебКлиент Тогда
		
	Результат = Новый Структура;
	
	Если ЧтениеXML.Прочитать() Тогда
		
		Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
			
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				
				Ключ 	 = СтрЗаменить(ЧтениеXML.Имя, ".", "_");
				Значение = СтрокаXML_В_Значение(ЧтениеXML, ДополнительныеПараметры);
				
				Если Ключ = "custom_data" Тогда
					
					ДополнительныеПараметры = Значение;
					
				Иначе
					
					Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство(Ключ) Тогда
						
						НовыйМассив = Новый Массив;
						НовыйМассив.Добавить(Результат);
						Результат = НовыйМассив;
						
					КонецЕсли;
					
					Если ТипЗнч(Результат) = Тип("Структура") Тогда
						
						Результат.Вставить(Ключ, Значение);
						
					ИначеЕсли ТипЗнч(Результат) = Тип("Массив") Тогда
						
						Результат.Добавить(Новый Структура(Ключ, Значение));
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
				
				Результат = ЧтениеXML.Значение;
				
			КонецЕсли;
			
			Если НЕ ЧтениеXML.Прочитать() Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
	#КонецЕсли
	
КонецФункции


&НаСервереБезКонтекста
Функция СтрокаXML_В_Значение_НаСервереБезКонтекста(ЧтениеXML, ДополнительныеПараметры)
	
		Результат = Новый Структура;
		
		Если ЧтениеXML.Прочитать() Тогда
			
			Пока ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					
					Ключ 	 = СтрЗаменить(ЧтениеXML.Имя, ".", "_");
					Значение = СтрокаXML_В_Значение_НаСервереБезКонтекста(ЧтениеXML, ДополнительныеПараметры);
					
					Если Ключ = "custom_data" Тогда
						
						ДополнительныеПараметры = Значение;
						
					Иначе
						
						Если ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство(Ключ) Тогда
							
							НовыйМассив = Новый Массив;
							НовыйМассив.Добавить(Результат);
							Результат = НовыйМассив;
							
						КонецЕсли;
						
						Если ТипЗнч(Результат) = Тип("Структура") Тогда
							
							Результат.Вставить(Ключ, Значение);
							
						ИначеЕсли ТипЗнч(Результат) = Тип("Массив") Тогда
							
							Результат.Добавить(Новый Структура(Ключ, Значение));
							
						КонецЕсли;
						
					КонецЕсли;
					
				ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
					
					Результат = ЧтениеXML.Значение;
					
				КонецЕсли;
				
				Если НЕ ЧтениеXML.Прочитать() Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат Результат;
		
КонецФункции

&НаКлиенте
Функция XMLСтрока_Обертка(Значение)
	
	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		
		// Удаляем символы перевода строки и возврата каретки, которые платформа добавляет в base64 строку.
		Результат = СтрЗаменить(СтрЗаменить(XMLСтрока(Значение), Символы.ПС, ""), Символы.ВК, "");
		
	Иначе
		
		Результат = XMLСтрока(Значение);
		
	КонецЕсли;
	
	Возврат Результат;
	
