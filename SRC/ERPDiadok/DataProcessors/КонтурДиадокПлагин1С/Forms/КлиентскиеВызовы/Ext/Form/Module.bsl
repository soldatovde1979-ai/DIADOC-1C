&НаКлиенте
Функция XMLЗначение(Тип, Значение)
	
	Если Тип = Тип("Дата") Тогда
		// 2017-08-04T08:44:35Z
		Результат = Сред(Значение, 1, 19);
		Результат = СтрЗаменить(Результат, "-", "");
		Результат = СтрЗаменить(Результат, "T", "");
		Результат = СтрЗаменить(Результат, ":", "");
		Возврат Дата(Результат);
		
	ИначеЕсли Тип = Тип("Булево") Тогда
		
		Возврат (Значение = "true");
		
	Иначе
		
		ВызватьИсключение "Не реализовано";
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция XMLСтрока(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		
		Возврат Формат(Значение, "БЛ=true; БИ=false");
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка")  Тогда
		
		Возврат Значение;
		
	ИначеЕсли Значение = Неопределено  Тогда
		
		Возврат "";
		
	Иначе
		
		Возврат XmlСтрокаНаСервереБезКонтекста(Значение);
		//ВызватьИсключение "Не реализовано";
		
	КонецЕсли;
	
