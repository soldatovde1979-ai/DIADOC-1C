&НаКлиенте
Процедура ПроверитьHTTPКодСостояния200(Ответ)
	
	Если Ответ.КодСостояния <> "200" Тогда
		
		ОписаниеОшибки = "Ошибка HTTP запроса"
		+ ?(ЗначениеЗаполнено(Ответ.КодСостояния), Символы.ПС + Ответ.КодСостояния, "")
		+ ?(ЗначениеЗаполнено(Ответ.ТелоОтвета)  , Символы.ПС + Ответ.ТелоОтвета  , "");

	Иначе
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение ОписаниеОшибки;
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьPluginError(Ответ)
	
	Если Не Ответ.Свойство("error") Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОшибки = "Ошибка Kontur.1C.Plugin.Host";
	
	Для Каждого КлючИЗначение Из Ответ.error Цикл
		ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + КлючИЗначение.Ключ + " : " + КлючИЗначение.Значение;
	КонецЦикла;
	
	ВызватьИсключение ОписаниеОшибки;
	
КонецПроцедуры

&НаКлиенте
Функция ТипКонтента(Контент)
	
	Результат = Неопределено;
	
	КонтентТип = ТипЗнч(Контент);
	
	Если КонтентТип = Тип("ДвоичныеДанные") Тогда
		
		Результат = "ДвоичныеДанные";
		
	ИначеЕсли КонтентТип = Тип("Строка") Тогда
		
		Результат = "string";
		
	ИначеЕсли КонтентТип = Тип("Структура") Тогда
		
		ТипыКонтента = Новый Структура;
		
		ТипыКонтента.Вставить("ДвоичныеДанные", "ДвоичныеДанные");
		ТипыКонтента.Вставить("Строка"		  ,	"string");
		ТипыКонтента.Вставить("Файл"		  ,	"file");
		
		ТипыКонтента.Вставить("string"		  ,	"string");
		ТипыКонтента.Вставить("base64"		  ,	"base64");
		ТипыКонтента.Вставить("hex"			  ,	"hex");
		ТипыКонтента.Вставить("file"		  , "file");
		
		Для Каждого КлючИЗначение ИЗ Контент Цикл
			
			Если НЕ ТипыКонтента.Свойство(КлючИЗначение.Ключ, Результат) Тогда
				ВызватьИсключение "Недопустимый тип контента" + Символы.ПС + КлючИЗначение.Ключ;
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Content_В_Контент(content)
	
	Результат = Неопределено;
	
	Если content.type = "file" Тогда
		Результат = content.path;
	Иначе
		Результат = content.data;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Контент_В_Content(Контент, Кодировка = "")
	
	Результат = Неопределено;
	
	ТипКонтента = ТипКонтента(Контент);
	
	Если ТипЗнч(Контент) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение ИЗ Контент Цикл
			Данные = КлючИЗначение.Значение;
			Прервать;
		КонецЦикла;
	Иначе
		Данные = Контент;
	КонецЕсли;
	
	Результат = Новый_content(ТипКонтента, Данные, Кодировка);
	
	Возврат Результат;
		
КонецФункции

&НаКлиенте
Функция Соответствие_В_NameValueCollection(Коллекция)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(Коллекция) Тогда
		
		Для Каждого КлючИЗначение ИЗ Коллекция Цикл
			
			НовыйЭлемент = Новый Структура("item", Новый Структура);
			НовыйЭлемент.item.Вставить("name" , КлючИЗначение.Ключ);
			НовыйЭлемент.item.Вставить("value", КлючИЗначение.Значение);
			
			Результат.Добавить(НовыйЭлемент);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция NameValueCollection_В_Соответствие(NameValueCollection)
	
	Результат = Новый Соответствие;
	
	Если ЗначениеЗаполнено(NameValueCollection) Тогда
		
		Для Каждого NameValue ИЗ NameValueCollection Цикл
			
			Результат.Вставить(NameValue.item.name, NameValue.item.value);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция КодировкаHTTPЗаголовка(Заголовки)
	
	Результат = "";
	
	ЗначениеЗаголовка = Заголовки["Content-Type"];
	
	Если ЗначениеЗаголовка = Неопределено Тогда
		ЗначениеЗаголовка = Заголовки["content-type"];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеЗаголовка) Тогда
		
		Позиция = Найти(ЗначениеЗаголовка, "charset=");
		Позиция = ?(Позиция > 0, Позиция + 8, 0);
		
		Если Позиция > 0 Тогда
			Результат = Сред(ЗначениеЗаголовка, Позиция);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_ОписаниеСертификата(certificate_info)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Отпечаток", Content_В_Контент(certificate_info.hash));
	
	Если certificate_info.Свойство("serialNumber") Тогда
		Результат.Вставить("СерийныйНомер", Content_В_Контент(certificate_info.serialNumber));
	КонецЕсли;
	
	Если certificate_info.Свойство("issuer") Тогда
		Результат.Вставить("Издатель", certificate_info.issuer);
	КонецЕсли;
	
	Если certificate_info.Свойство("subject") Тогда
		Результат.Вставить("Субъект", certificate_info.subject);
	КонецЕсли;
	
	Если certificate_info.Свойство("content") Тогда
		Результат.Вставить("ДвоичныеДанные", Base64Значение(certificate_info.content.data));
	КонецЕсли;
	
	Если certificate_info.Свойство("validFrom") Тогда
		Результат.Вставить("ДатаНачала", XMLЗначение(Тип("Дата"), certificate_info.validFrom));
	КонецЕсли;
	
	Если certificate_info.Свойство("validTo") Тогда
		Результат.Вставить("ДатаОкончания", XMLЗначение(Тип("Дата"), certificate_info.validTo));
	КонецЕсли;
	
	Если certificate_info.Свойство("hasPrivateKey") Тогда
		Результат.Вставить("ЕстьЗакрытыйКлюч", XMLЗначение(Тип("Булево"), certificate_info.hasPrivateKey));
	КонецЕсли;
	
	Если certificate_info.Свойство("extensions") Тогда
		Результат.Вставить("РасширенныеСвойства", certificate_info.extensions);
	КонецЕсли;
	
	Если certificate_info.Свойство("keyAlgorithm") Тогда
		Результат.Вставить("АлгоритмКлюча", certificate_info.keyAlgorithm);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

