&НаКлиенте
Функция Новый_content(ТипДанных, Данные = Неопределено, Кодировка = "")
	
	Результат = Новый Структура;
	Результат.Вставить("type", нрег(ТипДанных));
	
	Если Результат.type = "двоичныеданные" Тогда
		Результат.type = "base64";
	ИначеЕсли Результат.type = "строка" Тогда
		Результат.type = "string";
	ИначеЕсли Результат.type = "файл" Тогда
		Результат.type = "file";
	КонецЕсли;
	
	Если Результат.type = "string" И ЗначениеЗаполнено(Кодировка) Тогда
		Результат.Вставить("encoding", Кодировка);
	КонецЕсли;
	
	Если Данные <> Неопределено Тогда
		
		Если Результат.type = "file" Тогда
			Результат.Вставить("path", XMLСтрока_Обертка(Данные));
		Иначе
			Результат.Вставить("data", XMLСтрока_Обертка(Данные));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

