&НаКлиенте
Функция Команда_http_request(method, uri, query = Неопределено, headers = Неопределено,
		requestBody = Неопределено, responseBody = Неопределено, timeout = Неопределено)
	
	Результат = Новый_command("http.request");
	
	Результат.command.Вставить("uri"   , uri);
	Результат.command.Вставить("method", method);
	
	Если ЗначениеЗаполнено(query) Тогда
		Результат.command.Вставить("query", query);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(headers) Тогда
		Результат.command.Вставить("headers", headers);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(requestBody) Тогда
		Результат.command.Вставить("requestBody", requestBody);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(timeout) Тогда
		Результат.command.Вставить("timeout", timeout);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(responseBody) Тогда
		Результат.command.Вставить("responseBody", responseBody);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

