&НаКлиенте
Функция plugin()
	
	// В веб-клиенте подключение выполняется асинхронно,
	// с помощью метода НачатьУстановкуПлагинаВебКлиент
	
	Результат = Неопределено;
	
	КэшПлагинаОтключен = Кэш_Прочитать("КэшПлагинаОтключен");
	
	Если КэшПлагинаОтключен = Истина Тогда
		
		Результат = ПодключитьПлагин();
		
	Иначе
		
		Результат = Кэш_Прочитать("plugin");
		
		Если Результат = Неопределено Тогда
			
			Результат = ПодключитьПлагин();
			
			Кэш_Поместить("plugin", Результат);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

