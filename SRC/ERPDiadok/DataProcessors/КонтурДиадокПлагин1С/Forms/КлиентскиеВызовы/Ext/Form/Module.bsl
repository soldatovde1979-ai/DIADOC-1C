	&НаКлиенте
	Функция НоваяКоманда_ПолучитьСертификатИзПодписи(Подпись, СвойстваСертификата = Неопределено)
		
		Перем content;
		
		source = Контент_В_Content(Подпись);
		certificateProperties = Новый_certificateProperties(СвойстваСертификата);
		signerInfoProperties = Новый_signerInfoProperties();
		
		Результат = Команда_crypto_signature_parse(source, certificateProperties, signerInfoProperties);
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ПолучитьСертификатИзПодписи(Ответ)
		
		Результат = Неопределено;
		
		response = Ответ.response;
		
		Если ЗначениеЗаполнено(response.certs) Тогда
			
			Если ТипЗнч(response.certs) = Тип("Массив") Тогда
				
				СерийныйНомер = СерийныйНомерСертификатаПодписанта(response.signer_infos);
				Для Каждого cert Из response.certs Цикл
					
					Если cert.certificate_info.serialNumber.data = СерийныйНомер Тогда
						Результат = Новый_ОписаниеСертификата(cert.certificate_info);
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Результат = Неопределено Тогда
					Результат = Новый_ОписаниеСертификата(response.certs[0].certificate_info);
				КонецЕсли;
				
			Иначе
				Результат = Новый_ОписаниеСертификата(response.certs.certificate_info);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Результат;
	 	
	КонецФункции

	&НаКлиенте
	Функция СерийныйНомерСертификатаПодписанта(SignerInfos)
		
		Результат = Неопределено;
		
		Если ТипЗнч(SignerInfos) = Тип("Массив") Тогда
			Результат = SignerInfos[0].signer_info.serialNumber.data;
		Иначе
			Результат = SignerInfos.signer_info.serialNumber.data;
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_ПодписатьКонтент(Контент, Сертификаты, НовыйКонтент)
		
		source = Контент_В_Content(Контент);
		
		Если НовыйКонтент = Неопределено Тогда
			sink = Новый_content(source.type);
			ВернутьДвоичныеДанные = ТипКонтента(Контент) = "ДвоичныеДанные";
		Иначе
			sink = Контент_В_Content(НовыйКонтент);
			ВернутьДвоичныеДанные = ТипКонтента(НовыйКонтент) = "ДвоичныеДанные";
		КонецЕсли;
		
		certs = Новый_certs(Сертификаты);
		
		Результат = Команда_crypto_sign(source, sink, certs);
		
		Если ВернутьДвоичныеДанные Тогда
			Результат.command.custom_data.Вставить("ResultBinaryData");
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ПодписатьКонтент(Ответ)
		
		Возврат РазобратьОтвет_ПреобразоватьКонтент(Ответ);
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_ЗашифроватьКонтент(Контент, Сертификаты, НовыйКонтент)
		
		source = Контент_В_Content(Контент);
		
		Если НовыйКонтент = Неопределено Тогда
			sink = Новый_content(source.type);
			ВернутьДвоичныеДанные = ТипКонтента(Контент) = "ДвоичныеДанные";
		Иначе
			sink = Контент_В_Content(НовыйКонтент);
			ВернутьДвоичныеДанные = ТипКонтента(НовыйКонтент) = "ДвоичныеДанные";
		КонецЕсли;

		certs = Новый_certs(Сертификаты);
		
		Результат = Команда_crypto_encrypt(source, sink, certs);
		
		Если ВернутьДвоичныеДанные Тогда
			Результат.command.custom_data.Вставить("ResultBinaryData");
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ЗашифроватьКонтент(Ответ)
		
		Возврат РазобратьОтвет_ПреобразоватьКонтент(Ответ);
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_РасшифроватьКонтент(Контент, НовыйКонтент)
		
		source = Контент_В_Content(Контент);
		
		Если НовыйКонтент = Неопределено Тогда
			sink = Новый_content(source.type);
			ВернутьДвоичныеДанные = ТипКонтента(Контент) = "ДвоичныеДанные";
		Иначе
			sink = Контент_В_Content(НовыйКонтент);
			ВернутьДвоичныеДанные = ТипКонтента(НовыйКонтент) = "ДвоичныеДанные";
		КонецЕсли;

		Результат = Команда_crypto_decrypt(source, sink);
		
		Если ВернутьДвоичныеДанные Тогда
			Результат.command.custom_data.Вставить("ResultBinaryData");
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_РасшифроватьКонтент(Ответ)
		
		Возврат РазобратьОтвет_ПреобразоватьКонтент(Ответ);
		
	КонецФункции


	&НаКлиенте
	Функция НоваяКоманда_ВыполнитьHTTPЗапрос(Метод, АдресРесурса, ПараметрыЗапроса)
		
		Перем query, headers, requestBody, responseBody, timeout;
		
		// Кодировка запроса
		Кодировка = "utf-8";
		Если ПараметрыЗапроса.Свойство("Кодировка") Тогда
			Кодировка = ПараметрыЗапроса.Кодировка;
		КонецЕсли;
		
		// Имеет смысл только для тела ответа в виде строки.
		// Позволяет получить текст ответа без дополнительного преобразования контента в строку
		// после расчета кодировки из заголовка ответа.
		КодировкаОтвета = "";
		Если ПараметрыЗапроса.Свойство("КодировкаОтвета") Тогда
			КодировкаОтвета = ПараметрыЗапроса.КодировкаОтвета;
		КонецЕсли;
		
		// Параметры, автоматически добавляются плагином в URI запроса.
		// Нельзя использовать совместно с параметрами в адресе ресурса.
		Если ПараметрыЗапроса.Свойство("Параметры") Тогда
			query = Соответствие_В_NameValueCollection(ПараметрыЗапроса.Параметры);
		КонецЕсли;
		
		// Заголовки запроса
		Если ПараметрыЗапроса.Свойство("Заголовки") Тогда
			headers = Соответствие_В_NameValueCollection(ПараметрыЗапроса.Заголовки);
		КонецЕсли;
		
		// Тело запроса
		Если ПараметрыЗапроса.Свойство("ТелоЗапроса") Тогда
			requestBody = Контент_В_Content(ПараметрыЗапроса.ТелоЗапроса, Кодировка);
		КонецЕсли;
		
		ДопОбработкаОтвета = "";
		
		// Тело ответа
		Если ПараметрыЗапроса.Свойство("ТелоОтвета") Тогда
			
			responseBody = Контент_В_Content(ПараметрыЗапроса.ТелоОтвета, КодировкаОтвета);
			
			Если responseBody.type = "string" И НЕ ЗначениеЗаполнено(КодировкаОтвета) Тогда
				
				responseBody = Новый_content("base64");
				
				ДопОбработкаОтвета = "AutoEncoding";
				
			ИначеЕсли responseBody.type = "base64" И ТипКонтента(ПараметрыЗапроса.ТелоОтвета) = "ДвоичныеДанные" Тогда
				
				ДопОбработкаОтвета = "ResultBinaryData";
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Время ожидания ответа
		ПараметрыЗапроса.Свойство("Таймаут", timeout);
		
		Результат = Команда_http_request(Метод, АдресРесурса, query, headers, requestBody, responseBody, timeout);
		
		Если ЗначениеЗаполнено(ДопОбработкаОтвета) Тогда
			Результат.command.custom_data.Вставить(ДопОбработкаОтвета);
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция НоваяКоманда_ВыполнитьHTTPЗапросДиадок(Метод, ИмяРесурса, ПараметрыЗапроса, КлючРазработчика = "", Токен = "", Агент = "")
		
		АдресРесурса = "https://diadoc-api.kontur.ru" + ИмяРесурса;
		
		// Кодировка для заголовка
		Кодировка = "utf-8";
		Если ПараметрыЗапроса.Свойство("Кодировка") Тогда
			Кодировка = ПараметрыЗапроса.Кодировка;
		КонецЕсли;
		
		// Добавляем обязательные заголовки
		Если НЕ ПараметрыЗапроса.Свойство("Заголовки") Тогда
			ПараметрыЗапроса.Вставить("Заголовки", Новый Соответствие);
		КонецЕсли;
		
		ПараметрыЗапроса.Заголовки.Вставить("Accept"	  , "application/json");
		ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/json" + ?(ЗначениеЗаполнено(Кодировка), ";charset=" + Кодировка, ""));
		
		Если ЗначениеЗаполнено(Агент) Тогда
			UserAgent = "Plugin1C v" + ВерсияПлагина() + " 1C v" + ОписаниеПриложения().ВерсияПриложения + "/" + Агент;
		Иначе
			UserAgent = "Plugin1C v" + ВерсияПлагина() + " 1C v" + ОписаниеПриложения().ВерсияПриложения + "/" + ОписаниеПриложения().СинонимКонфигурации;
		КонецЕсли;
		ПараметрыЗапроса.Заголовки.Вставить("User-Agent",  UserAgent);
		
		Если ЗначениеЗаполнено(КлючРазработчика) Тогда
			ПараметрыЗапроса.Заголовки.Вставить("Authorization", "DiadocAuth ddauth_api_client_id=" + КлючРазработчика + ?(ЗначениеЗаполнено(Токен), ",ddauth_token=" + Токен, ""));
		КонецЕсли;
		
		Возврат НоваяКоманда_ВыполнитьHTTPЗапрос(Метод, АдресРесурса, ПараметрыЗапроса);
		
	КонецФункции

	&НаКлиенте
	Функция РазобратьОтвет_ВыполнитьHTTPЗапрос(Ответ)
		
		Результат = Новый Структура("КодСостояния, ТелоОтвета, Заголовки", "", Неопределено, Новый Соответствие);
		
		response = Ответ.response;
		
		Если response.Свойство("statusCode") Тогда
			Результат.КодСостояния = response.statusCode;
		КонецЕсли;
		
		Если response.Свойство("headers") Тогда
			Результат.Вставить("Заголовки", NameValueCollection_В_Соответствие(response.headers));
		КонецЕсли;
		
		Если response.Свойство("Content") Тогда
			
			Результат.ТелоОтвета = Content_В_Контент(response.Content);
			
			Если ЗначениеЗаполнено(Результат.ТелоОтвета) Тогда
				
				Если Ответ.ДополнительныеПараметры.Свойство("ResultBinaryData") Тогда
					
					Результат.ТелоОтвета = Base64Значение(Результат.ТелоОтвета);
					
				ИначеЕсли Ответ.ДополнительныеПараметры.Свойство("AutoEncoding") Тогда
					
					Кодировка = КодировкаHTTPЗаголовка(Результат.Заголовки);
					Если НЕ ЗначениеЗаполнено(Кодировка) Тогда
						Кодировка = "utf-8"; // Кодировка по умолчанию
					КонецЕсли;
					
					Результат.ТелоОтвета = ПреобразоватьКонтент(Новый Структура("base64", Результат.ТелоОтвета), Новый Структура("string"), Кодировка);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции
	
	&НаКлиенте
	Функция НоваяКоманда_Таймаут(ВремяОжиданияВСекундах)
		
		ПустаяДата = Дата(1,1,1,0,0,0);
		
		ВремяОжидания = ПустаяДата + ВремяОжиданияВСекундах;
		
		СтрокаВремениISO = Формат(ВремяОжидания,"ДФ=HH:mm:ss");
		
		Результат = Команда_test_wait(СтрокаВремениISO);
		
		Возврат Результат;
		
	КонецФункции

