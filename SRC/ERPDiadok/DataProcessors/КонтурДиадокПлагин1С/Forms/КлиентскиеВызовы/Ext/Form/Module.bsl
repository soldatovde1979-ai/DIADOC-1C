	// Возвращает результат выполнения асинхронной задачи, запущенной с помощью конструкции НачатьВызов.
	//
	// Параметры:
	//	 ОтветПлагина - Строка - XML строка, которую возвращает плагин в параметр Результат обработчика оповещения.
	//
	// Возвращаемое значение:
	//	 Произвольное значение - Результат асинхронной задачи.
	//
	&НаКлиенте
	Функция РазобратьОтветПлагина(ОтветПлагина) Экспорт
		
		Результат = Неопределено;
		
		СтруктураОтвета = ОтветПлагина_В_Структуру(ОтветПлагина);
		
		ПроверитьPluginError(СтруктураОтвета);
		
		ТипКоманды = СтруктураОтвета.ДополнительныеПараметры.command_type;
		
		Если ТипКоманды = "io.transfer" Тогда
			
			Результат = РазобратьОтвет_ПреобразоватьКонтент(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "cert.search" Тогда
			
			Результат = РазобратьОтвет_ПолучитьСписокСертификатов(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "cert.parse" Тогда
			
			Результат = РазобратьОтвет_ПолучитьДанныеСертификата(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "crypto.verify" Тогда
			
			Результат = РазобратьОтвет_ПроверитьПодпись(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "crypto.signature.parse" Тогда
			
			Результат = РазобратьОтвет_ПолучитьСертификатИзПодписи(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "crypto.sign" Тогда
			
			Результат = РазобратьОтвет_ПодписатьКонтент(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "crypto.encrypt" Тогда
			
			Результат = РазобратьОтвет_ЗашифроватьКонтент(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "crypto.decrypt" Тогда
			
			Результат = РазобратьОтвет_РасшифроватьКонтент(СтруктураОтвета);
			
		ИначеЕсли ТипКоманды = "http.request" Тогда
			
			Результат = РазобратьОтвет_ВыполнитьHTTPЗапрос(СтруктураОтвета);
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции

	// Принудительно удаляет результат асинхронной задачи.
	// Если задача еще не выполнена, то после её выполнения, результат будет немедленно удален из памяти.
	//
	// Параметры:
	//	 TaskId - Строка - Идентификатор асинхронной задачи.
	//
	&НаКлиенте
	Процедура УдалитьАсинхроннуюЗадачу(TaskId) Экспорт
		
		plugin_DeleteResult(TaskId);
		
	КонецПроцедуры


	&НаКлиенте
	Функция НовыеПараметрыHTTPЗапроса() Экспорт
		
		Результат = Новый Структура;
		
		Результат.Вставить("Заголовки", Новый Соответствие);
		Результат.Вставить("Параметры", Новый Соответствие);
		
		Результат.Вставить("ТелоЗапроса", Новый Структура("string", "")); // ТелоЗапроса пустая строка
		Результат.Вставить("ТелоОтвета" , Новый Структура("string", "")); // ТелоОтвета вернуть строкой в кодировке сервера
		
		Возврат Результат;
		
	КонецФункции

	&НаКлиенте
	Функция ВсеСвойстваСертификата(ДобавитьДвоичныеДанные = Ложь) Экспорт
		
		Результат = Новый Структура("СерийныйНомер, Издатель, Субъект, ДатаНачала, ДатаОкончания, ЕстьЗакрытыйКлюч");
		
		Если ДобавитьДвоичныеДанные = Истина Тогда
			Результат.Вставить("ДвоичныеДанные");
		КонецЕсли;
		
		Возврат Результат;
		
	КонецФункции
	
	&НаКлиенте
	Функция НовыйОписаниеОповещения(ИмяПроцедуры = Неопределено, Модуль = Неопределено, ДополнительныеПараметры = Неопределено)
		
		ПараметрыКонструктора = Новый Массив;
		ПараметрыКонструктора.Добавить(ИмяПроцедуры);
		ПараметрыКонструктора.Добавить(Модуль);
		ПараметрыКонструктора.Добавить(ДополнительныеПараметры);
		
		Результат = Новый("ОписаниеОповещения", ПараметрыКонструктора);
		
		Возврат Результат;
		
	КонецФункции
		
