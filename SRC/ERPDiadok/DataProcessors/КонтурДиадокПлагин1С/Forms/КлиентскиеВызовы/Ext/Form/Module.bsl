Функция Новый_certs(Сертификаты)
	
	Результат = Новый Массив;
	
	Если ТипЗнч(Сертификаты) = Тип("Массив") Тогда
		МассивСертификатов = Сертификаты;
	Иначе
		МассивСертификатов = Новый Массив;
		МассивСертификатов.Добавить(Сертификаты);
	КонецЕсли;
	
	Для Каждого Сертификат Из МассивСертификатов Цикл
		Результат.Добавить(Новый Структура("certificate", Новый_certificate(Сертификат)));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_filter(ПараметрыФильтра)
						  
	Результат = Новый Структура;
	
	Если ПараметрыФильтра.Свойство("Отпечаток") Тогда
		Результат.Вставить("hash", Новый_content("hex", ПараметрыФильтра.Отпечаток));
	КонецЕсли;
	
	Если ПараметрыФильтра.Свойство("СерийныйНомер") Тогда
		Результат.Вставить("serialNumber", Новый_content("hex", ПараметрыФильтра.СерийныйНомер));
	КонецЕсли;
	
	Если ПараметрыФильтра.Свойство("ЕстьЗакрытыйКлюч") Тогда
		Результат.Вставить("hasPrivateKey", ПараметрыФильтра.ЕстьЗакрытыйКлюч = Истина);
	КонецЕсли;
	
	Если ПараметрыФильтра.Свойство("ТолькоПервый") Тогда
		Результат.Вставить("firstOnly", Истина);
	КонецЕсли;
	
	Результат.Вставить("store", Новый_cert_store(ПараметрыФильтра));
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_store(ПараметрыФильтра)
	
	Результат = Новый Структура;
	
	Если ТипЗнч(ПараметрыФильтра) = Тип("Структура") Тогда
		
		Если ПараметрыФильтра.Свойство("ТипХранилища") Тогда
			Результат.Вставить("storeName", Новый_cert_storeName(ПараметрыФильтра.ТипХранилища));
		КонецЕсли;
		
		Если ПараметрыФильтра.Свойство("РасположениеХранилища") Тогда
			Результат.Вставить("storeLocation", Новый_cert_storeLocation(ПараметрыФильтра.РасположениеХранилища));
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вставить("storeType", "cryptoApi");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_cert_storeName(ТипХранилища)
	
	ТипыХранилища = Новый Соответствие;
	ТипыХранилища.Вставить(нрег("КорневыеСертификаты"), 			 "Root");
	ТипыХранилища.Вставить(нрег("ПерсональныеСертификаты"), 		 "My");
	ТипыХранилища.Вставить(нрег("СертификатыПолучателей"), 		     "AddressBook");
	ТипыХранилища.Вставить(нрег("СертификатыУдостоверяющихЦентров"), "CA");
	
	Результат = ТипыХранилища[нрег(ТипХранилища)];
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		ВызватьИсключение "Неизвестный тип хранилища сертификатов" + Символы.ПС + ТипХранилища;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
&НаКлиенте
Функция Новый_cert_storeLocation(РасположениеХранилища)
	
	РасположенияХранилища = Новый Соответствие;
	РасположенияХранилища.Вставить(нрег("ДанныеКомпьютера"),	 "machine");
	РасположенияХранилища.Вставить(нрег("ДанныеПользователяОС"), "user");
	
	Результат = РасположенияХранилища[нрег(РасположениеХранилища)];
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		ВызватьИсключение "Неизвестное расположение хранилища сертификатов" + Символы.ПС + РасположениеХранилища;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_certificate(Сертификат)
	
	Результат = Новый Структура;
	
	СертификатТип = ТипЗнч(Сертификат);
	
	Если СертификатТип = Тип("Строка") Тогда // Сертификат из любого хранилища по отпечатку
		
		Результат.Вставить("hash", Новый_content("hex", Сертификат));
		
	ИначеЕсли СертификатТип = Тип("ДвоичныеДанные") Тогда // Файл сертификата
		
		Результат.Вставить("content", Новый_content("base64", Сертификат));
		
	ИначеЕсли СертификатТип = Тип("Структура") Тогда
		
		Если Сертификат.Свойство("Отпечаток") Тогда
			
			 // Сертификат из указанного хранилища по отпечатку
			Результат.Вставить("hash", Новый_content("hex", Сертификат.Отпечаток));
			
			Если Сертификат.Свойство("ТипХранилища") Тогда
				Результат.Вставить("storeName", Новый_cert_storeName(Сертификат.ТипХранилища));
			КонецЕсли;
			
			Если Сертификат.Свойство("РасположениеХранилища") Тогда
				Результат.Вставить("storeLocation", Новый_cert_storeLocation(Сертификат.РасположениеХранилища));
			КонецЕсли;
			
		Иначе
			 // Контент сертификата
			 Результат.Вставить("content", Контент_В_Content(Сертификат));
		КонецЕсли;
		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_certificateProperties(СвойстваСертификата) 
	
	Результат = Новый Структура;
	
	СоответствиеСвойств = Новый Соответствие;
	СоответствиеСвойств.Вставить(нрег("Отпечаток"),	 	  	  	"hash");
	СоответствиеСвойств.Вставить(нрег("СерийныйНомер"),	  	  	"serialNumber");
	СоответствиеСвойств.Вставить(нрег("ДвоичныеДанные"),  	 	"content");
	СоответствиеСвойств.Вставить(нрег("Издатель"),			  	"issuer");
	СоответствиеСвойств.Вставить(нрег("Субъект"),			  	"subject");
	СоответствиеСвойств.Вставить(нрег("ДатаНачала"),	  	  	"validFrom");
	СоответствиеСвойств.Вставить(нрег("ДатаОкончания"),	  	  	"validTo");
	СоответствиеСвойств.Вставить(нрег("ЕстьЗакрытыйКлюч"),	  	"hasPrivateKey");
	СоответствиеСвойств.Вставить(нрег("РасширенныеСвойства"),	"extensions");
	СоответствиеСвойств.Вставить(нрег("АлгоритмКлюча"),			"keyAlgorithm");
	
	Если ЗначениеЗаполнено(СвойстваСертификата) Тогда
		
		Для Каждого КлючИЗначение ИЗ СвойстваСертификата Цикл
			
			ИмяСвойства = КлючИЗначение.Ключ;
			
			Property = СоответствиеСвойств[нрег(ИмяСвойства)];
			
			Если НЕ ЗначениеЗаполнено(Property) Тогда
				ВызватьИсключение "Неизвестное свойство сертификата" + Символы.ПС + ИмяСвойства;
			КонецЕсли;
			
			Результат.Вставить(Property, Истина);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Результат.Свойство("content") Тогда
		Результат.Вставить("content", Новый_content("base64"));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Новый_signerInfoProperties()
	
	Результат = Новый Структура;
	Результат.Вставить("serialNumber", Истина);
	
	Возврат Результат;
	
КонецФункции

