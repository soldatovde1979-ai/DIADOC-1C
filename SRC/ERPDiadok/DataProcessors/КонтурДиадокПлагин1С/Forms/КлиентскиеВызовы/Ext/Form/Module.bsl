&НаКлиенте
Функция НачатьУстановкуПлагинаВебКлиент(ОповещениеОЗавершении) Экспорт
	
	#Если ВебКлиент Тогда
		
		Если Не ПодключитьРасширениеРаботыСФайлами() Тогда
			УстановитьРасширениеРаботыСФайлами();
			ПодключитьРасширениеРаботыСФайлами();
		КонецЕсли;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
		
		ВерсияПлагина	 = ВерсияПлагина();
		
		ОбъектПлагина = СоздатьОбъектПлагина();
		
		Если ОбъектПлагина <> Неопределено Тогда
			
			ДопПараметры.Вставить("ОбъектПлагина", ОбъектПлагина);
			
			ОбработчикЗавершенияУстановкиПлагина(ДопПараметры);
			
		Иначе
			
			ОбработчикЗавершенияЗаписиФайлаХостаНаДиск(ДопПараметры);
			
		КонецЕсли;
		
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура ОбработчикЗавершенияЗаписиФайлаХостаНаДиск(ДопПараметры) Экспорт
	
	#Если ВебКлиент Тогда
		
		АдресФайлаВК = АдресФайлаВКДляВебКлиента();
		
		ВКПодключена = ПодключитьВнешнююКомпоненту(АдресФайлаВК, ИмяВнешнейКомпоненты(), ТипВнешнейКомпоненты.Native);
		
		Если ВКПодключена Тогда
			
			ДопПараметры.Вставить("ВКПодключена", ВКПодключена);
			
			ОбработчикЗавершенияУстановкиПлагина(ДопПараметры);
			
		Иначе
			
			ДопПараметры.Вставить("АдресФайлаВК", АдресФайлаВК);
			
			ОписаниеОповещения = НовыйОписаниеОповещения("ОбработчикЗавершенияУстановкиВК", ЭтаФорма, ДопПараметры);
			
			НачатьУстановкуВнешнейКомпоненты(ОписаниеОповещения, АдресФайлаВК);
			
		КонецЕсли;
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершенияУстановкиВК(ДопПараметры) Экспорт
	
	#Если ВебКлиент Тогда
		
		АдресФайлаВК = ДопПараметры.АдресФайлаВК;
		
		ВКПодключена = ПодключитьВнешнююКомпоненту(АдресФайлаВК, ИмяВнешнейКомпоненты(), ТипВнешнейКомпоненты.Native);
		
		ДопПараметры.Вставить("ВКПодключена", ВКПодключена);
		
		ОбработчикЗавершенияУстановкиПлагина(ДопПараметры);
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикЗавершенияУстановкиПлагина(ДопПараметры) Экспорт
	
	#Если ВебКлиент Тогда
		
		ОбъектПлагина	 = Неопределено;
		ВКПодключена	 = Неопределено;
		
		ДопПараметры.Свойство("ОбъектПлагина"	, ОбъектПлагина);
		ДопПараметры.Свойство("ВКПодключена"	, ВКПодключена);
		
		Если ОбъектПлагина = Неопределено И ВКПодключена = Истина Тогда
			ОбъектПлагина = СоздатьОбъектПлагина();
		КонецЕсли;
		
		Если ОбъектПлагина = Неопределено Тогда
			
			ТекстОшибки = НСтр("ru = 'Не удалось подключить ""Kontur.1C.Plugin""'");
			
			ВызватьИсключение ТекстОшибки;
			
			
		Иначе
			
			Кэш_Поместить("plugin", ОбъектПлагина);
			
			ВыполнитьОбработкуОповещенияПереопределенная(ДопПараметры.ОповещениеОЗавершении);
			
		КонецЕсли;
		
	#КонецЕсли
	
КонецПроцедуры

&НаСервере
Функция АдресФайлаВКДляВебКлиента()
	
	Отладка = Ложь;
	
	Если Отладка Тогда
		
		КаталогПлагина = ".\";
		Файлы = НайтиФайлы(КаталогПлагина + "bundle_web\", "*");
		Запись = Новый ЗаписьZipФайла(КаталогПлагина + "bundle_web.zip");
		
		Для Каждого Файл Из Файлы Цикл
			Запись.Добавить(Файл.ПолноеИмя, РежимСохраненияПутейZIP.НеСохранятьПути);
		КонецЦикла;
		Запись.Записать();
		
		ДвоичныеДанные = Новый ДвоичныеДанные(КаталогПлагина + "bundle_web.zip");
		
	Иначе
		
		ДвоичныеДанные = ПолучитьМакетОбработки("Plugin_web_zip");
		
	КонецЕсли;
	
	Результат = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

