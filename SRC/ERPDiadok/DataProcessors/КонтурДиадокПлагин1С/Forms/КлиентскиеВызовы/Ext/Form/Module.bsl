&НаКлиенте
Функция ВерсияОбработки() Экспорт
	
	Результат = ВерсияОбработкиНаСервере();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВерсияПлагина() Экспорт
	
	Результат = Кэш_Прочитать("ВерсияПлагина");
	
	Если Результат = Неопределено Тогда
		
		Результат = ВерсияПлагинаНаСервере();
		
		Кэш_Поместить("ВерсияПлагина", Результат);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВерсияОбработкиНаСервере()
	
	Результат = ОбработкаОбъект().ВерсияОбработки();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ВерсияПлагинаНаСервере()
	
	Результат = ОбработкаОбъект().ВерсияПлагина();
	
	Возврат Результат;
	
КонецФункции

