&НаКлиенте
Функция Тест_ЗавершитьВызов_cert_search(ОтветПлагина, ПараметрыВызова, ДополнительныеПараметры) Экспорт
	
	Результат = Модуль_КонтурПлагин().РазобратьОтветПлагина(ОтветПлагина);
	
	Сообщить("Тест_cert_search" + Символы.ПС + Результат);
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Функция ВсеСвойстваСертификата()
	
	Результат = Новый Массив;
	Результат.Добавить("СерийныйНомер");
	Результат.Добавить("ДвоичныеДанные");
	Результат.Добавить("Издатель");
	Результат.Добавить("Субъект");
	Результат.Добавить("ДатаНачала");
	Результат.Добавить("ДатаОкончания");
	Результат.Добавить("ЕстьЗакрытыйКлюч");
	
	Возврат Результат;
	
КонецФункции

