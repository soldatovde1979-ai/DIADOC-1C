КонецФункции

&НаКлиенте
Процедура Тест_GetBox(Команда)
	
	КлючРазработчика = "1C-DDPro-v1-2-26113adb-9bda-4547-a8b2-c26caf8d60d3";
	
	Box = Модуль_КонтурПлагин().DD_API_GetBox(КлючРазработчика, BoxId);
	
