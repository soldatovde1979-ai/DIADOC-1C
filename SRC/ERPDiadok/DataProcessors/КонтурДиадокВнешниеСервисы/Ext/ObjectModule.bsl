// Вычисляет адрес ресурса по имени метода API и его параметрам.
//
//&НаКлиенте
Функция АдресРесурсаHTTP(Знач ИмяМетодаВходящее, Параметры = Неопределено)
	
	ИмяМетода = НормализоватьИмяМетода(ИмяМетодаВходящее);
	
	ПараметрыСтрокой = "";
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		
		Если Найти(ИмяМетода, "?") = 0 Тогда
			Разделитель = "?";
		Иначе
			Разделитель = "&";
		КонецЕсли;
		
		Для Каждого Параметр Из Параметры Цикл
			// Метод Общее_ПодставитьПараметрыВСтроку использовать нельзя, в параметрах может быть %n
			ПараметрыСтрокой = ПараметрыСтрокой + Разделитель + Параметр.Ключ + "=" + КодироватьСтрокуURL(Параметр.Значение);
			Разделитель = "&";
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = ИмяМетода + ПараметрыСтрокой;
	
	Возврат Результат;
	
КонецФункции

Функция КодироватьСтрокуURL(Строка)
	
	Результат = "";
	
	Если ПриложениеСтаршеВерсии("8.3") Тогда
		
		Код_А = КодСимвола("А");
		Код_п = КодСимвола("п");
		Код_р = КодСимвола("р");
		Код_я = КодСимвола("я");
		
		ДлинаСтроки = СтрДлина(Строка);
		
		Для Сч = 1 По ДлинаСтроки Цикл
			
			Символ	 = Сред(Строка, Сч, 1);
			Код		 = КодСимвола(Символ);
			
			ДопустимыйСимвол = Ложь
			Или (Символ >= "a" И Символ <= "z")
			Или (Символ >= "A" И Символ <= "Z")
			Или (Символ >= "0" И Символ <= "9");
			
			Если ДопустимыйСимвол Тогда
				
				Результат = Результат + Символ;
				
			ИначеЕсли Код >= Код_А И Код <= Код_п Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(208) + "%" + КодироватьЧислоHEX(144 + Код - Код_А);
				
			ИначеЕсли Код >= Код_р И Код <= Код_я Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(209) + "%" + КодироватьЧислоHEX(128 + Код - Код_р);
				
			ИначеЕсли Символ = "ё" Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(209) + "%" + КодироватьЧислоHEX(145);
				
			ИначеЕсли Символ = "Ё" Тогда
				
				Результат = Результат + "%" + КодироватьЧислоHEX(208) + "%" + КодироватьЧислоHEX(129);
				
			Иначе
				
				Результат = Результат + "%" + КодироватьЧислоHEX(Код);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Результат = Вычислить("КодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL)");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция КодироватьЧислоHEX(Знач Число)
	
	Результат = "";
	
	Если Число <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Словарь = "0123456789ABCDEF";
	
	Пока Истина Цикл
		
		Результат = Сред(Словарь, Число % 16 + 1, 1) + Результат;
		
		Если Число < 16 Тогда
			Прервать;
		КонецЕсли;
		
		Число = Число / 16;
		
	КонецЦикла;
	
	НечетнаяДлина = СтрДлина(Результат) % 2 > 0;
	
	Если НечетнаяДлина Тогда
		Результат = "0" + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьИмяМетода(ИмяМетодаВходящее)
	
	Результат = ИмяМетодаВходящее;
	
	ЗнакСлэш = "/";
	Если ЗначениеЗаполнено(ИмяМетодаВходящее)
		И Лев(ИмяМетодаВходящее, 1) <> ЗнакСлэш Тогда
		
		Результат = ЗнакСлэш + ИмяМетодаВходящее;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ОтправитьHTTPЗапрос_Встроенный(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод		 = ПараметрыЗапроса.Метод;
	АдресМетода	 = ПараметрыЗапроса.АдресМетода;
	ТелоЗапроса	 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры	 = ПараметрыЗапроса.Параметры;
	Заголовки	 = ПараметрыЗапроса.Заголовки;
	
	Соединение	 = HTTPСоединение_Встроенный(ПараметрыСервиса);
	АдресРесурса = АдресРесурсаHTTP(АдресМетода, Параметры);
	HTTPЗапрос	 = НовыйHTTPЗапрос(АдресРесурса, Заголовки);
	
	Если Метод = "GET" Тогда
		
		Результат = Соединение.Получить(HTTPЗапрос);
		
	ИначеЕсли Метод = "POST" Тогда
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			
			Если ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
				
				УстановитьТелоИзСтроки_Встроенный(HTTPЗапрос, ТелоЗапроса);
				
			Иначе
				
				HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
	ИначеЕсли Метод = "PUT" Тогда
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			
			Если ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
				
				УстановитьТелоИзСтроки_Встроенный(HTTPЗапрос, ТелоЗапроса);
				
			Иначе
				
				HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Результат = Соединение.Записать(HTTPЗапрос);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьТелоИзСтроки_Встроенный(HTTPЗапрос, ТелоЗапроса)
	
	Если Не ПриложениеСтаршеВерсии("8.3.6") Тогда
		
		// В версии "8.3.6" HTTPЗапрос получил необходимый нам параметр ИспользоватьBOM.
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8,
		ПредопределенноеЗначение("ИспользованиеByteOrderMark.НеИспользовать"));
		
	Иначе
		
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, "CESU-8");
		
	КонецЕсли;
	
КонецПроцедуры

Функция АдресРесурсаHTTPКоннекторHTTP(ПараметрыСервиса, ПараметрыЗапроса)
	Схема			 = ПараметрыСервиса.Схема;
	АдресВебСервиса	 = ПараметрыСервиса.АдресВебСервиса;
	АдресМетода		 = НормализоватьИмяМетода(ПараметрыЗапроса.АдресМетода);
	
	ШаблонСтроки = "%1://%2%3";
		
	Результат = Общее_ПодставитьПараметрыВСтроку(
		ШаблонСтроки,
			Схема,
			АдресВебСервиса,
			АдресМетода
	);
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьHTTPЗапрос_Коннектор(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод		 = ПараметрыЗапроса.Метод;
	ТелоЗапроса	 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры	 = ПараметрыЗапроса.Параметры;
	Заголовки	 = ПараметрыЗапроса.Заголовки;
	
	Сессия		 = Сессия_КоннекторHTTP(ПараметрыСервиса);
	
	АдресРесурса = АдресРесурсаHTTPКоннекторHTTP(ПараметрыСервиса, ПараметрыЗапроса);
	
	ДополнительныеПараметры = КоннекторЛок().НовыеПараметры();
	ДополнительныеПараметры.Данные = ТелоЗапроса;
	ДополнительныеПараметры.ПараметрыЗапроса = Параметры;
	ДополнительныеПараметры.Заголовки = Заголовки;
	ДополнительныеПараметры.Таймаут = ПараметрыСервиса.Таймаут;

	Результат = КоннекторЛок().ВызватьМетод(Метод, АдресРесурса, ДополнительныеПараметры, Сессия);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ОтправитьHTTPЗапрос_Plugin(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод			 = ПараметрыЗапроса.Метод;
	АдресМетода		 = ПараметрыЗапроса.АдресМетода;
	ТелоЗапроса		 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры		 = ПараметрыЗапроса.Параметры;
	Заголовки		 = ПараметрыЗапроса.Заголовки;
	
	Схема	 = ПараметрыСервиса.Схема;
	Порт	 = ПараметрыСервиса.Порт;
	
	СтрокаЗапроса	 = Схема + "://" + ПараметрыСервиса.АдресВебСервиса +
					   ?(ЗначениеЗаполнено(Порт), ":" + Формат(Порт, "ЧГ=0"), "") + АдресМетода;
	
	ПараметрыЗапросаДляПлагина = Новый Структура;
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		ПараметрыЗапросаДляПлагина.Вставить("Параметры", Параметры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Заголовки) Тогда
		ПараметрыЗапросаДляПлагина.Вставить("Заголовки", Заголовки);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		ПараметрыЗапросаДляПлагина.Вставить("ТелоЗапроса", ТелоЗапроса);
	КонецЕсли;
	
	Если ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные Тогда
		ПараметрыЗапросаДляПлагина.Вставить("ТелоОтвета", Новый Структура("ДвоичныеДанные"));
	Иначе
		ПараметрыЗапросаДляПлагина.Вставить("ТелоОтвета", Новый Структура("Строка"));
	КонецЕсли;
	
	Результат = Плагин_ВыполнитьHTTPЗапрос(Метод, СтрокаЗапроса, ПараметрыЗапросаДляПлагина);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ОтправитьHTTPЗапрос_WinHTTP(ПараметрыСервиса, ПараметрыЗапроса)
	
	Метод		 = ПараметрыЗапроса.Метод;
	АдресМетода	 = ПараметрыЗапроса.АдресМетода;
	ТелоЗапроса	 = ПараметрыЗапроса.ТелоЗапроса;
	Параметры	 = ПараметрыЗапроса.Параметры;
	Заголовки	 = ПараметрыЗапроса.Заголовки;
	
	Схема	 = ПараметрыСервиса.Схема;
	Порт	 = ПараметрыСервиса.Порт;
	
	Соединение		 = HTTPСоединение_WinHTTP(ПараметрыСервиса);
	
	АдресРесурса	 = АдресРесурсаHTTP(АдресМетода, Параметры);
	РежимПрокси		 = ПараметрыСервиса.НастройкиПрокси.РежимПрокси;
	СтрокаЗапроса	 = Схема + "://" + ПараметрыСервиса.АдресВебСервиса +
					   ?(ЗначениеЗаполнено(Порт), ":" + Формат(Порт, "ЧГ=0"), "") + АдресРесурса;
	
	Соединение.Open(Метод, СтрокаЗапроса, 0);
	
	Если РежимПрокси = "UseProxy" Тогда
		ВыполнитьАвторизациюНаПрокси_COM(ПараметрыСервиса, Соединение);
	КонецЕсли;
	
	Для Каждого Элемент Из Заголовки Цикл
		Соединение.SetRequestHeader(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Если ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
		Соединение.Send(ДвоичныеДанныеHTTPЗапроса_COM(ТелоЗапроса));
	Иначе 
		Соединение.Send(ТелоЗапроса);
	КонецЕсли;
	
	Возврат Соединение;
	
КонецФункции

//&НаКлиенте
Функция ЗаголовкиHTTPОтвета_COM(Соединение)
	
	Результат = Новый Соответствие;
	
	ЗаголовкиСтрокой = Соединение.GetAllResponseHeaders();
	МассивЗаголовков = РазделитьСтрокуЛок(ЗаголовкиСтрокой, Символы.ПС, Ложь);
	
	Для Каждого ЗаголовокСтрокой Из МассивЗаголовков Цикл
		
		ЧастиЗаголовка = РазделитьСтрокуЛок(ЗаголовокСтрокой, ":");
		
		Ключ	 = ЧастиЗаголовка[0];
		Значение = ЧастиЗаголовка[1];
		
		Результат.Вставить(Ключ, Значение);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ДвоичныеДанныеHTTPОтвета_COM(Соединение)
	
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла();
	
	Попытка
		Поток = Новый COMОбъект("ADODB.Stream");
	Исключение
		ОписаниеОшибки = "Не удалось инициализировать COM-объект ""ADODB.Stream""";
		ВызватьИсключение ОписаниеОшибки;
	КонецПопытки;
	
	Поток.Type = 1;  // Бинарный
	Поток.Mode = 3; 
	Поток.Open();
	Поток.Write(Соединение.responseBody);
	Поток.SaveToFile(ИмяФайлаОтвета);
	Поток.Close();	
	
	Результат = Новый ДвоичныеДанные(ИмяФайлаОтвета);
	
	УдалитьВременныйФайл(ИмяФайлаОтвета);
	
	Возврат Результат;
	
КонецФункции

