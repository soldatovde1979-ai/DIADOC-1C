// Сравнивает текущую версию приложения с указанной версией.
// 
// Параметры:
//  Версия - Строка - номер версии, с которой нужно сравнить текущую версию приложения.
//
// Возвращаемое значение:
//   Булево - Истина, если текущая версия приложения старше чем версия параметра.
//            Например, 8.2 старше чем 8.3.
//
//&НаКлиенте
Функция ПриложениеСтаршеВерсии(Версия)
	
	Результаты = Кэш_Прочитать("РезультатыФункции_ПриложениеСтаршеВерсии");
	
	Если Результаты = Неопределено Тогда
		Результаты = Новый Соответствие;
	КонецЕсли;
	
	Результат = Результаты[Версия];
	
	Если Результат = Неопределено Тогда
		
		СисИнфо = Новый СистемнаяИнформация;
		
		Результат = (СравнитьВерсии(СисИнфо.ВерсияПриложения, Версия) < 0);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сравнивает текущую версию режима совместимости с указанной версией.
// 
// Параметры:
//  Версия - Строка - номер версии, с которой нужно сравнить текущую версию режима совместимости.
//
// Возвращаемое значение:
//   Булево - Истина, если текущая версия режима совместимости ниже чем версия параметра.
//            Например, 8.3.10 ниже чем 8.3.15.
//
Функция РежимСовместимостиКонфигурацииНижеВерсии(Версия) Экспорт
	
	ВерсияРежимаСовместимости = ВерсияРежимаСовместимостиЛок();
	Результат = СравнитьВерсии(ВерсияРежимаСовместимости, Версия) < 0;
	
	Возврат Результат;
	
КонецФункции

// Возвращает версию режима совместимости конфигурации в формате "РР.ПП.ВВ",
// где РР - номер редакции, ПП - номер подредакции, ВВ - номер версии
// 
// Возвращаемое значение:
//  Строка - режим совместимости конфигурации.
// 
// Пример:
//  ВерсияРежимаСовместимостиЛок() = "8.3.27"
//
Функция ВерсияРежимаСовместимостиЛок()
	
	МаксИндекс = 2;
	
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
		
		Инфо = Новый СистемнаяИнформация;
		Подстроки = РазделитьСтрокуЛок(Инфо.ВерсияПриложения, ".");
		Пока Подстроки.ВГраница() > МаксИндекс Цикл
			Подстроки.Удалить(Подстроки.ВГраница());
		КонецЦикла;
		
	Иначе
		
		НомерРедакции = "8";
		РежимСовместимостиСтрокой = Строка(Метаданные.РежимСовместимости); // строка вида "Версия8_3_25" или "Version8_3_25"
		Подстроки = РазделитьСтрокуЛок(РежимСовместимостиСтрокой, "_");
		Подстроки[0] = НомерРедакции;
		
		Пока Подстроки.ВГраница() < МаксИндекс Цикл
			Подстроки.Добавить("0");
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СоединитьСтроку(Подстроки, ".");
	
КонецФункции

// Сравнить две строки версий. Версии типа "1.0.1b" сравнивать нельзя.
//
// Параметры
//  СтрокаВерсии1 - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС
//  СтрокаВерсии2 - Строка - второй сравниваемый номер версии
//
// Возвращаемое значение:
//   Число - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
//
//&НаКлиенте
Функция СравнитьВерсии(Знач ПерваяВерсия, Знач ВтораяВерсия, Разделитель = ".")
	
	Результат = 0;
	
	Пока НЕ ПустаяСтрока(ПерваяВерсия) ИЛИ НЕ ПустаяСтрока(ВтораяВерсия) Цикл
		
		Поз = Найти(ПерваяВерсия, Разделитель);
		Если Поз > 0 Тогда
			НомерПервойВерсии = Число(Лев(ПерваяВерсия, Поз - 1));
			ПерваяВерсия = Сред(ПерваяВерсия, Поз + 1);
		Иначе
			НомерПервойВерсии = ?(ПустаяСтрока(ПерваяВерсия), 0, Число(ПерваяВерсия));
			ПерваяВерсия = "";
		КонецЕсли;
		
		Поз = Найти(ВтораяВерсия, Разделитель);
		Если Поз > 0 Тогда
			НомерВторойВерсии = Число(Лев(ВтораяВерсия, Поз - 1));
			ВтораяВерсия = Сред(ВтораяВерсия, Поз + 1);
		Иначе
			НомерВторойВерсии = ?(ПустаяСтрока(ВтораяВерсия), 0, Число(ВтораяВерсия));
			ВтораяВерсия = "";
		КонецЕсли;
		
		Результат = НомерПервойВерсии - НомерВторойВерсии;
		Если Результат <> 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение свойства структуры или значение по умолчанию,
// если в структуре нет такого свойства.
// 
// Параметры:
//  Структура           - Структура    - Структура, которая может содержать вложенные структуры.
//  Ключ                - Строка       - Имя ключа структуры,
//  ЗначениеПоУмолчанию - Произвольный - (необязательный) возвращается в случае если в структуре нет указанного свойства.
// 
// Возвращаемое значение:
//   Произвольный - Значение свойства структуры или ЗначениеПоУмолчанию,
//                  если в структуре нет такого свойства.
//
Функция СвойствоСтруктуры(Структура, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Перем Значение;
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ЭтоСтруктура(Структура) И ЗначениеЗаполнено(Ключ) Тогда
		
		Если Структура.Свойство(Ключ, Значение) Тогда
			Результат = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет, является ли переданное значение структурой или фиксированной структурой.
// 
// Параметры:
//  Значение - Произвольный - значение, которое нужно проверить.
// 
// Возвращаемое значение:
//   Булево - Истина, если переданое значение является структрой или фиксированной структурой.
//
//&НаКлиенте
Функция ЭтоСтруктура(Значение)
	
	Результат = Ложь;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разделяет строку на части по указанным символам-разделителям.
// По аналогии с глобальным методом СтрРазделить, добавленным в платформу версии 8.3.6.
//
// Параметры:
//  Строка         - Строка - разделяемая строка;
//  Разделитель    - Строка - строка символов, каждый из которых является индивидуальным разделителем;
//  ВключатьПустые - Булево - Ложь, если пустые части строки включать в результат не нужно.
// 
// Возвращаемое значение:
//  Массив - массив со строками, которые получились в результате разделения исходной строки.
//
//&НаКлиенте
Функция РазделитьСтрокуЛок(Знач Строка, Разделитель = ",", ВключатьПустые = Истина)
	
	Результат = Новый Массив;
	
	МассивРазделителей = Новый Массив;
	
	Для Сч = 1 По СтрДлина(Разделитель) Цикл
		СимволРазделителя = Сред(Разделитель, Сч, 1);
		МассивРазделителей.Добавить(СимволРазделителя);
	КонецЦикла;
	
	Пока Истина Цикл
		
		Поз = 0;
		
		Для Каждого СимволРазделителя Из МассивРазделителей Цикл
			
			Поз = Найти(Строка, СимволРазделителя);
			
			Если Поз > 0 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Поз = 0 Тогда
			Подстрока	 = СокрЛП(Строка);
			Строка		 = "";
		Иначе
			Подстрока	 = СокрЛП(Лев(Строка, Поз - 1));
			Строка		 = Сред(Строка, Поз + 1);
		КонецЕсли;
		
		Если ВключатьПустые ИЛИ ЗначениеЗаполнено(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		
		Если Поз = 0 Тогда
			Прервать; // Нет разделителя, за которым могла бы быть следующая часть строки.
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Соединяет массив переданных строк в одну строку с указанным разделителем.
// По аналогии с глобальным методом СтрСоединить, добавленным в платформу версии 8.3.6.
// 
// Параметры:
//  Строки - Произвольный - значение тип которого нужно определить.
//  Разделитель - ФиксированныйМассив; Массив - значение тип которого нужно определить.
//
// Возвращаемое значение:
//   Строка - строка, содержащая соединенные исходные строки с разделителем между ними.
//
//&НаКлиенте
Функция СоединитьСтроку(Строки, Разделитель = "") Экспорт
	
	// Аналог: ЭДО_Служебные_МассивВСтроку
	// Отличия:
	// По умолчанию Разделитель = "", раньше Разделитель = Символы.ПС;
	// В параметр "Строки" не поддерживает тип "Строка".
	
	Результат		 = "";
	ТекРазделитель	 = "";
	
	Если ЗначениеЗаполнено(Строки) Тогда
		
		Для Каждого Строка Из Строки Цикл
			
			Если ЗначениеЗаполнено(Строка) Тогда
				Результат		 = Результат + ТекРазделитель + Строка;
				ТекРазделитель	 = Разделитель;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подставляет параметры в строку, максимальное число параметров - 5.
//
// Параметры:
//  ШаблонСтроки - Строка - шаблон строки с параметрами;
//  Параметр<n>  - Строка - подставляемый параметр.
//
// Возвращаемое значение:
//   Строка - строка с подставленными параметрами.
//
//&НаКлиенте
Функция Общее_ПодставитьПараметрыВСтроку(ШаблонСтроки,
								   Параметр1,
								   Параметр2 = Неопределено,
								   Параметр3 = Неопределено,
								   Параметр4 = Неопределено,
								   Параметр5 = Неопределено)
	
	Результат = СтрЗаменить(ШаблонСтроки, "%1", Параметр1);
	Результат = СтрЗаменить(Результат	, "%2", Параметр2);
	Результат = СтрЗаменить(Результат	, "%3", Параметр3);
	Результат = СтрЗаменить(Результат	, "%4", Параметр4);
	Результат = СтрЗаменить(Результат	, "%5", Параметр5);
	
	Возврат Результат;
	
КонецФункции

// Преобразует двоичные данные в строку формата Base 16 (Hex).
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - двоичные данные, из которых нужно получить строку.
//
// Возвращаемое значение:
//   Строка - Hex строка.
//
//&НаКлиенте
Функция HexСтрокаИзДвоичныхДанных(ДвоичныеДанные)
	
	Если ПриложениеСтаршеВерсии("8.3.10") Тогда
		
		Результат = ВРег(СтрЗаменить(Строка(ДвоичныеДанные), " ", ""));
		
	Иначе
		
		Результат = Вычислить("ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные)");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Строковое представление объекта ИнтернетПрокси.
//
// Параметры:
//  Прокси 		- ИнтернетПрокси	- объект ИнтернетПрокси.
//  Протокол 	- Строка			- имя протокола (напр. "http" или "https").
//
// Возвращаемое значение:
//   Строка - строковое представление ИнтернетПрокси.
//
//&НаКлиенте
Функция ПредставлениеИнтернетПрокси(Прокси, Протокол = Неопределено)
	
	Журнал = Новый Массив;
	
	Если ЗначениеЗаполнено(Протокол) Тогда
		
		СтрокаЖурнала = ПредставлениеАдресаПроксиПоИмениПротокола(Прокси, Протокол);
		Журнал.Добавить(СтрокаЖурнала);
		
	Иначе
		
		ПредставлениеАдреса = ПредставлениеАдресаПроксиПоИмениПротокола(Прокси);
		Журнал.Добавить(ПредставлениеАдреса);
		
		ПредставлениеАдреса = ПредставлениеАдресаПроксиПоИмениПротокола(Прокси, "http");
		Журнал.Добавить(ПредставлениеАдреса);

		ПредставлениеАдреса = ПредставлениеАдресаПроксиПоИмениПротокола(Прокси, "https");
		Журнал.Добавить(ПредставлениеАдреса);

		ПредставлениеАдреса = ПредставлениеАдресаПроксиПоИмениПротокола(Прокси, "ftp");
		Журнал.Добавить(ПредставлениеАдреса);
		
	КонецЕсли;
	
	НастройкиАвторизации = НастройкиАвторизацииИнтернетПрокси(Прокси, "");
	
	Если НастройкиАвторизации.ИспользоватьАутентификациюОС Тогда 
		
		СтрокаЖурнала = НСтр("ru = 'Используется аутентификация операционной системы'");
		
	Иначе 
		
		Пользователь = НастройкиАвторизации.Пользователь;
		Пароль 		 = НастройкиАвторизации.Пароль;
		
		Если ПустаяСтрока(Пароль) Тогда
			СостояниеПароля = НСтр("ru = '<не указан>'");
		Иначе
			СостояниеПароля = НСтр("ru = '********'");
		КонецЕсли;
		
		СтрокаЖурнала = НСтр("ru = 'Используется аутентификация по имени пользователя и паролю'");
		Журнал.Добавить(СтрокаЖурнала);
		
		ШаблонСтрокиЖурнала = НСтр("ru = 'Пользователь: %1
			           					 |Пароль: %2'");
										 
		СтрокаЖурнала = Общее_ПодставитьПараметрыВСтроку(
			ШаблонСтрокиЖурнала,
			Пользователь,
			СостояниеПароля);
			
	КонецЕсли;
	
	Журнал.Добавить(СтрокаЖурнала);
	
	Если Прокси.НеИспользоватьПроксиДляЛокальныхАдресов Тогда 
		
		СтрокаЖурнала = НСтр("ru = 'Не использовать прокси для локальных адресов'");
		Журнал.Добавить(СтрокаЖурнала);
		
	КонецЕсли;
	
	Если Прокси.НеИспользоватьПроксиДляАдресов.Количество() > 0 Тогда 
		
		СтрокаЖурнала = НСтр("ru = 'Не использовать для следующих адресов:'"); 
		Журнал.Добавить(СтрокаЖурнала);
		
		Для Каждого ИсключаемыйАдрес Из Прокси.НеИспользоватьПроксиДляАдресов Цикл
			Журнал.Добавить(ИсключаемыйАдрес);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СоединитьСтроку(Журнал, Символы.ПС);
	
КонецФункции

// Возвращает строковое представление сервера и порта прокси для указанного протокола.
//
// Параметры:
//  Прокси 		- ИнтернетПрокси	- объект ИнтернетПрокси.
//  Протокол 	- Строка			- имя протокола (напр. "http" или "https").
//
// Возвращаемое значение:
//   Строка - строковое представление сервера и порта.
//
// Пример:
//	// для протокола http
//	Результат = ПредставлениеАдресаПрокси(ИнтернетПрокси, "http");
//	
//	возвращаемая строка "HTTP: kontur.proxy.ru:8080"
//
//&НаКлиенте
Функция ПредставлениеАдресаПроксиПоИмениПротокола(Прокси, Протокол = Неопределено)

	Если ЗначениеЗаполнено(Протокол) Тогда
		Сервер 	= Прокси.Сервер(Протокол);
		Порт 	= Прокси.Порт(Протокол);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сервер) Тогда
		Сервер 	= Прокси.Сервер();
		Порт 	= Прокси.Порт();
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Сервер)
		И Не ЗначениеЗаполнено(Порт) Тогда
		Порт = ПортПоУмолчанию(Протокол);
	КонецЕсли;
		
	ПортСтрокой = Формат(Порт, "ЧГ=");
	
	Если Протокол = Неопределено Тогда
		ПредставлениеПротокола = "Адрес";
	Иначе
		ПредставлениеПротокола = ВРег(Протокол);
	КонецЕсли;
	
	ШаблонСтроки = НСтр("ru = '%1: %2:%3'");
	
	Результат = Общее_ПодставитьПараметрыВСтроку(
		ШаблонСтроки,
		ПредставлениеПротокола,
		Сервер,
		ПортСтрокой);
		
	Возврат Результат;
	
КонецФункции

// Возвращает настройки авторизации объекта ИнтернетПрокси.
// Функция является "оберткой" для старых платформ.
//
// Параметры:
//  Прокси 		- ИнтернетПрокси	- объект ИнтернетПрокси.
//  Протокол 	- Строка			- имя протокола (напр. "http" или "https").
//
// Возвращаемое значение:
//   Структура - настройки авторизации ИнтернетПрокси.
//
//&НаКлиенте
Функция НастройкиАвторизацииИнтернетПрокси(Прокси, Протокол = Неопределено)
	
	Результат = Новый Структура;
	
	Если ПриложениеСтаршеВерсии("8.3.7") Тогда
		ИспользоватьАутентификациюОС = Истина;
	Иначе
		ИспользоватьАутентификациюОС = Вычислить("Прокси.ИспользоватьАутентификациюОС(Протокол)");
	КонецЕсли;
		
	Результат.Вставить("ИспользоватьАутентификациюОС", ИспользоватьАутентификациюОС);
	
	Если ПриложениеСтаршеВерсии("8.3.6") Тогда
		Пользователь 	= "";
		Пароль 			= "";
	Иначе
		Пользователь 	= Вычислить("Прокси.Пользователь(Протокол)");
		Пароль 			= Вычислить("Прокси.Пароль(Протокол)");
	КонецЕсли;
	
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Пароль", Пароль);
	
	Возврат Результат;
	
КонецФункции

// Возвращает Истина, если текущий сеанс выполняется на сервере, работающем под управлением ОС Windows.
//
// Возвращаемое значение:
//  Булево - Истина, если сервер работает под управлением ОС Windows.
//
//&НаКлиенте
Функция ЭтоWindowsСервер()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 
		Или СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64;
	
КонецФункции

// Возвращает Истина, если текущий сеанс выполняется на сервере, работающем под управлением ОС Linux.
//
// Возвращаемое значение:
//  Булево - Истина, если сервер работает под управлением ОС Linux.
//
//&НаКлиенте
Функция ЭтоLinuxСервер()
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Возврат СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 
		Или СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64;
	
КонецФункции

Процедура Логирование_ЗаписатьЗначение(ВидОперации, ЗначениеДляЛогирования)
	
	Если Ядро = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Ядро.РежимЛогированияВключен() Тогда
		ЗначениеДляЛогированияXML = Ядро.Логирование_СтруктураВXML(ЗначениеДляЛогирования);
		Ядро.Ошибка_Обработать(ВидОперации, ЗначениеДляЛогированияXML);
	КонецЕсли;
	
КонецПроцедуры

