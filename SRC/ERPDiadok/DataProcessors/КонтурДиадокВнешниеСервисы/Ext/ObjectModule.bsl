	ПараметрыКонструктора.Добавить(Прокси);
	ПараметрыКонструктора.Добавить(Таймаут);
	
	Если Схема = "https" Тогда
		ПараметрыКонструктора.Добавить(ЗащищенноеСоединение);
	КонецЕсли;
	
	Результат = Новый("HTTPСоединение", ПараметрыКонструктора);
	
