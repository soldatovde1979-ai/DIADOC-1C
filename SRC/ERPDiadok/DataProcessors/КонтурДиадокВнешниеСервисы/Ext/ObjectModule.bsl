	ЗащищенноеСоединение = ЗащищенноеСоединениеOpenSSL();
	
	ПараметрыКонструктора = Новый Массив;
	ПараметрыКонструктора.Добавить(АдресВебСервиса);
	ПараметрыКонструктора.Добавить(Порт);
	ПараметрыКонструктора.Добавить(ИмяПользователя);
