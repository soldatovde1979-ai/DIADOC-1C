Процедура ИнициализироватьМодуль(Модуль_Ядро, ТранспортHTTP) Экспорт
	
	Ядро = Модуль_Ядро;
	// BSLLS:UnusedLocalVariable-off
	Настройка_ТранспортHTTP = ТранспортHTTP;
	// BSLLS:UnusedLocalVariable-on
	
КонецПроцедуры

Функция КоннекторЛок()
	
	Если КоннекторЛок = Неопределено Тогда
		Если ЭтоВнешняяОбработка() Тогда
			КоннекторЛок = Новый("ExternalDataProcessorObject.КонтурДиадокКоннекторHTTP");
		Иначе
			КоннекторЛок = Новый("DataProcessorObject.КонтурДиадокКоннекторHTTP");
		КонецЕсли;
	КонецЕсли;
	
	Возврат КоннекторЛок;
	
КонецФункции

Функция ЭтоВнешняяОбработка() Экспорт
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
	Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
		ЭтоВнешняяОбработка = Ложь;
	Иначе
		ЭтоВнешняяОбработка = Истина;
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработка;
	
КонецФункции

