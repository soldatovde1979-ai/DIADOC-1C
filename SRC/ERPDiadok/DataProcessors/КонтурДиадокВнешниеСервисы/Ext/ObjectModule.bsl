// Определяет какой транспорт нужно использовать
// в зависимости от настройки транспорта.
//
// Возвращаемое значение:
//   Булево - Истина, транспорт WinHTTP.
//
//&НаКлиенте
Функция ИспользоватьВнешнийHTTP() Экспорт
	
	ИспользоватьВнешнийHTTP = Настройка_ТранспортHTTP = Перечисление_ТранспортHTTP().WinHTTP;
	
	Возврат ИспользоватьВнешнийHTTP;
	
КонецФункции

// Определяет какой транспорт использовать с учетом
//  настройки см. ИспользоватьВнешнийHTTP()
//  настройки ПринудительноИспользоватьNative в запросе
//
// Параметры:
//  ПринудительноИспользоватьNative	 - Булево	 - Принудительное использование платформенного транспорта
//   используется при отправке файла в центр поддержки
// 
// Возвращаемое значение:
//  Строка - значение из перечисления Перечисление_ТранспортHTTP
//
Функция ТранспортHTTPЗапроса(ПринудительноИспользоватьNative)
	
	Если ИспользоватьВнешнийHTTP()
		И НЕ ПринудительноИспользоватьNative Тогда
		
		ТранспортHTTPЗапроса = Перечисление_ТранспортHTTP().WinHTTP;
		
	ИначеЕсли ПринудительноИспользоватьNative Тогда
		
		ТранспортHTTPЗапроса = Перечисление_ТранспортHTTP().Встроенный;
		
	Иначе
		
		ТранспортHTTPЗапроса = Настройка_ТранспортHTTP;
		
	КонецЕсли;
	
	Возврат ТранспортHTTPЗапроса;
КонецФункции

Функция HTTPСоединение_WinHTTP(ПараметрыСервиса)
	
	Результат = Неопределено;
	
	ИмяСоединенияВКэш = "HTTPСоединения";
	
	АдресВебСервиса				 = ПараметрыСервиса.АдресВебСервиса;
	ИспользоватьНовоеСоединение	 = ПараметрыСервиса.ИспользоватьНовоеСоединение;
	
	Если ИспользоватьНовоеСоединение Тогда
		Кэш_Поместить(ИмяСоединенияВКэш, Неопределено);
	КонецЕсли;
	
	HTTPСоединения = Кэш_Прочитать(ИмяСоединенияВКэш);
	
	Если HTTPСоединения = Неопределено Тогда
		HTTPСоединения = Новый Соответствие;
		Кэш_Поместить(ИмяСоединенияВКэш, HTTPСоединения);
	КонецЕсли;
	
	Результат = HTTPСоединения.Получить(АдресВебСервиса);
	
	Если Результат = Неопределено Тогда
		
		Результат = ПолучитьCOMОбъект("", "WinHttp.WinHttpRequest.5.1");
		УстановитьПараметрыПрокси_COM(ПараметрыСервиса, Результат);
		
		Если НЕ ИспользоватьНовоеСоединение Тогда
			HTTPСоединения.Вставить(АдресВебСервиса, Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция HTTPСоединение_Встроенный(ПараметрыСервиса)
	
	Результат = Неопределено;
	
	ИмяСоединенияВКэш = "HTTPСоединения";

	АдресВебСервиса				 = ПараметрыСервиса.АдресВебСервиса;
	ИспользоватьНовоеСоединение	 = ПараметрыСервиса.ИспользоватьНовоеСоединение;
	
	Если ИспользоватьНовоеСоединение Тогда
		Кэш_Поместить(ИмяСоединенияВКэш, Неопределено);
	КонецЕсли;
	
	HTTPСоединения = Кэш_Прочитать(ИмяСоединенияВКэш);
	
	Если HTTPСоединения = Неопределено Тогда
		HTTPСоединения = Новый Соответствие;
		Кэш_Поместить(ИмяСоединенияВКэш, HTTPСоединения);
	КонецЕсли;
	
	Результат = HTTPСоединения.Получить(АдресВебСервиса);
	
	Если Результат = Неопределено Тогда
		
		Прокси		 = НовыйИнтернетПрокси(ПараметрыСервиса.НастройкиПрокси);
		Результат	 = НовоеHTTPСоединение(ПараметрыСервиса, Прокси);
		
		Если НЕ ИспользоватьНовоеСоединение Тогда
			HTTPСоединения.Вставить(АдресВебСервиса, Результат);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция Сессия_КоннекторHTTP(ПараметрыСервиса)
	
	СессияКоннекторHTTP = Неопределено;
	
	ИмяСессииВКэш = "СессияКоннекторHTTP";
	
	ИспользоватьНовоеСоединение	 = ПараметрыСервиса.ИспользоватьНовоеСоединение;
	
	Если ИспользоватьНовоеСоединение Тогда
		Кэш_Поместить(ИмяСессииВКэш, Неопределено);
	КонецЕсли;
	
	СессияКоннекторHTTP = Кэш_Прочитать(ИмяСессииВКэш);
	
	Если СессияКоннекторHTTP = Неопределено Тогда
		
		СессияКоннекторHTTP = КоннекторЛок().СоздатьСессию();
		СессияКоннекторHTTP.Прокси = НовыйИнтернетПрокси(ПараметрыСервиса.НастройкиПрокси);
		
		Кэш_Поместить(ИмяСессииВКэш, СессияКоннекторHTTP);
		
	КонецЕсли;
	
	Возврат СессияКоннекторHTTP;
	
КонецФункции

