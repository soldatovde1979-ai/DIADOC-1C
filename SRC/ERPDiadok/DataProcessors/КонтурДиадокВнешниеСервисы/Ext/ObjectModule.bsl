Функция ПолучитьСписокЛокальныхСертификатов() Экспорт
	
	ПараметрыПоиска		 = ПараметрыПоискаСертификатов();
	СвойстваСертификата	 = ВсеСвойстваСертификата();
	
	ПараметрыПоиска.Вставить("ЕстьЗакрытыйКлюч", Истина);
	СписокСертификатов = Плагин_ПолучитьСписокСертификатов(ПараметрыПоиска, СвойстваСертификата);
	
	Результат = ПолучитьСписокЛокальныхСертификатов_ПодготовитьРезультат(СписокСертификатов);
	
	Возврат Результат;
	
КонецФункции

