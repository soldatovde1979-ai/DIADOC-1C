	Если ТипЗнч(ДвоичныеДанныеИмяФайла) = Тип("ДвоичныеДанные") Тогда
		Контент = ДвоичныеДанныеИмяФайла;
	Иначе
		Контент = Новый Структура("file", ДвоичныеДанныеИмяФайла);
	КонецЕсли;
	
	ТипНовогоКонтента = Новый Структура("hex");
	
	МодульПлагин = Модуль_Плагин();
	ХэшСумма = МодульПлагин.РассчитатьХэш(Контент, ТипНовогоКонтента, , НаименованиеХешФункции);
	
	Результат = ВРег(ХэшСумма);
	
	Возврат Результат;
	
КонецФункции

