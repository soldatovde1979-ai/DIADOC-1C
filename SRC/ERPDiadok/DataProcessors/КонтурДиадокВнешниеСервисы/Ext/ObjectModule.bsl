//{		ДИАГНОСТИКА СОЕДИНЕНИЯ СЛУЖЕБНЫЕ

// Возвращает структуру с описанием состояния настроек прокси
//
// Параметры:
//  НастройкиПрокси - Структура - состав см. Модуль_API.НовыйНастройкиПрокси.
//  Протокол 		- Строка 	- имя протокола (напр. "http" или "https").
//
// Возвращаемое значение:
//  Структура - описание состояния настроек прокси
//   * СоединениеЧерезПрокси	 			- Булево - признак использования прокси. Истина - прокси используется.
//   * Представление 						- Строка - строковое представление настроек прокси.
//   * ИспользуютсяСистемныеНастройкиПрокси	- Булево - признак использования системных настроек прокси.
//
//&НаКлиенте
Функция СостояниеНастроекПрокси(НастройкиПрокси = Неопределено, Знач Протокол = Неопределено)
	
	Если НастройкиПрокси = Неопределено Тогда
		НастройкиПрокси	= Ядро.ОбщиеНастройки_НастройкиПрокси();
	КонецЕсли;
	
	РежимыПрокси = Ядро.АПИ_РежимыИспользованияПрокси();
	
	Прокси = НовыйИнтернетПрокси(НастройкиПрокси);
	
	Журнал = Новый Массив;
	
	Если НастройкиПрокси = Неопределено Тогда 
		СтрокаЖурнала = НСтр("ru = 'Параметры прокси-сервера в ИБ не указаны (используются системные настройки прокси).'"); 
	ИначеЕсли НастройкиПрокси.РежимПрокси = РежимыПрокси.БезПрокси Тогда
		СтрокаЖурнала = НСтр("ru = 'Параметры прокси-сервера в ИБ: Не использовать прокси-сервер.'");
	ИначеЕсли НастройкиПрокси.РежимПрокси = РежимыПрокси.ИспользоватьСистемныеНастройки Тогда
		СтрокаЖурнала = НСтр("ru = 'Параметры прокси-сервера в ИБ: Использовать системные настройки прокси-сервера.'");
	Иначе
		СтрокаЖурнала = НСтр("ru = 'Параметры прокси-сервера в ИБ: Использовать другие настройки прокси-сервера.'");
	КонецЕсли;
	
	Журнал.Добавить(СтрокаЖурнала);
	
	СоединениеЧерезПрокси = Не ПустаяСтрока(Прокси.Сервер(Протокол)) Или Не ПустаяСтрока(Прокси.Сервер());
	
	Если СоединениеЧерезПрокси Тогда 
		
		СтрокаЖурнала = НСтр("ru = 'Соединение выполняется через прокси-сервер:'");
		Журнал.Добавить(СтрокаЖурнала);
		
		ПредставлениеПрокси = ПредставлениеИнтернетПрокси(Прокси, Протокол);
		Журнал.Добавить(ПредставлениеПрокси);
		
	КонецЕсли;
	
	ИспользуютсяСистемныеНастройкиПрокси = (НастройкиПрокси.РежимПрокси = РежимыПрокси.ИспользоватьСистемныеНастройки);
	
	ЖурналСтрокой = СоединитьСтроку(Журнал, Символы.ПС);
	
	Результат = Новый Структура;
	Результат.Вставить("СоединениеЧерезПрокси"				 , СоединениеЧерезПрокси);
	Результат.Вставить("Представление"						 , ЖурналСтрокой);
	Результат.Вставить("ИспользуютсяСистемныеНастройкиПрокси", ИспользуютсяСистемныеНастройкиПрокси);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ПредставлениеМестаДиагностики()
	
	ИмяКомпьютера = ИмяКомпьютера();
	
	Если Ядро.ОбщийКонтекстКлиентСервер.ФайловыйРежимРаботы Тогда
		
		ШаблонСтроки = НСтр("ru = 'Подключение проводится из файловой информационной базы на компьютере <%1>.'");
		
		Результат = Общее_ПодставитьПараметрыВСтроку(
			ШаблонСтроки,
			ИмяКомпьютера);
			
		Возврат Результат;
		
	Иначе
		
		ШаблонСтроки = НСтр("ru = 'Подключение проводится на сервере 1С:Предприятие <%1>.'");
		
		Результат = Общее_ПодставитьПараметрыВСтроку(
			ШаблонСтроки,
			ИмяКомпьютера);
			
		Возврат Результат; 
		
	КонецЕсли;
	
КонецФункции

//&НаКлиенте
Функция ПроверитьДоступностьСервера(АдресСервера)
	
	ПараметрыЗапускаПрограммы = ПараметрыЗапускаПрограммы();
	ПараметрыЗапускаПрограммы.ДождатьсяЗавершения = Истина;
	ПараметрыЗапускаПрограммы.ПолучитьПотокВывода = Истина;
	ПараметрыЗапускаПрограммы.ПолучитьПотокОшибок = Истина;
	ПараметрыЗапускаПрограммы.КодировкаИсполнения = "OEM";
	
	Если ЭтоWindowsСервер() Тогда
		ШаблонКоманды = "ping %1 -n 4 -w 1000";
	Иначе
		ШаблонКоманды = "ping -c 4 -W 1 %1";
	КонецЕсли;
	
	СтрокаКоманды = Общее_ПодставитьПараметрыВСтроку(ШаблонКоманды, АдресСервера);
	
	Результат = ЗапуститьПрограмму(СтрокаКоманды, ПараметрыЗапускаПрограммы);
	
	// Разные операционные системы могут выводить ошибки в разные потоки:
	// - для Windows все всегда в потоке вывода;
	// - для Debian или RHEL ошибки падают в поток ошибок.
	ЖурналДоступности = Результат.ПотокВывода + Результат.ПотокОшибок;
	
	Если ЭтоWindowsСервер() Тогда
		Доступен = Найти(ЖурналДоступности, "Destination host unreachable") = 0 // Не локализуется.
			И (Найти(ЖурналДоступности, "(0% loss)") > 0 // Не локализуется.
			Или Найти(ЖурналДоступности, "(25% loss)") > 0); // Не локализуется.
	Иначе 
		Доступен = Найти(ЖурналДоступности, "Destination Host Unreachable") = 0 // Не локализуется.
			И (Найти(ЖурналДоступности, "(0% packet loss)") > 0 // Не локализуется.
			Или Найти(ЖурналДоступности, "(25% packet loss)") > 0); // Не локализуется.
	КонецЕсли;
	
	Журнал = Новый Массив;
	
	Если Доступен Тогда
		
		ШаблонСтрокиЖурнала = НСтр("ru = 'Удаленный сервер %1 доступен:'");
		
		СтрокаЖурнала = Общее_ПодставитьПараметрыВСтроку(
			ШаблонСтрокиЖурнала, 
			АдресСервера);
			
	Иначе
		
		ШаблонСтрокиЖурнала = НСтр("ru = 'Удаленный сервер %1 не доступен:'");
		
		СтрокаЖурнала = Общее_ПодставитьПараметрыВСтроку(
			ШаблонСтрокиЖурнала, 
			АдресСервера);
			
	КонецЕсли;
	
	Журнал.Добавить(СтрокаЖурнала);
	
	Журнал.Добавить("> " + СтрокаКоманды);
	Журнал.Добавить(ЖурналДоступности);
	
	ЖурналСтрокой = СоединитьСтроку(Журнал, Символы.ПС);
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("Доступен"			, Доступен);
	РезультатПроверки.Вставить("ЖурналДиагностики"	, ЖурналСтрокой); 
	
	Возврат РезультатПроверки;
	
КонецФункции

//&НаКлиенте
Функция ЖурналТрассировкиМаршрутаСервера(АдресСервера)
	
	ПараметрыЗапускаПрограммы = ПараметрыЗапускаПрограммы();
	ПараметрыЗапускаПрограммы.ДождатьсяЗавершения = Истина;
	ПараметрыЗапускаПрограммы.ПолучитьПотокВывода = Истина;
	ПараметрыЗапускаПрограммы.ПолучитьПотокОшибок = Истина;
	ПараметрыЗапускаПрограммы.КодировкаИсполнения = "OEM";
	
	Если ЭтоWindowsСервер() Тогда
		ШаблонКоманды = "tracert -w 100 -h 15 %1";
	Иначе 
		// Если вдруг пакет traceroute не установлен - в потоке вывода будет ошибка.
		// Т.к. результат все равно не разбирается, на поток вывода можно не обращать внимания.
		// По нему администратор поймет что ему надо доставить.
		ШаблонКоманды = "traceroute -w 100 -m 100 %1";
	КонецЕсли;
	
	СтрокаКоманды = Общее_ПодставитьПараметрыВСтроку(ШаблонКоманды, АдресСервера);
	
	Результат = ЗапуститьПрограмму(СтрокаКоманды, ПараметрыЗапускаПрограммы);
	
	Журнал = Новый Массив;
	
	ШаблонСтрокиЖурнала = НСтр("ru = 'Трассировка маршрута к удаленному серверу %1:'");
	СтрокаЖурнала 		= Общее_ПодставитьПараметрыВСтроку(
		ШаблонСтрокиЖурнала,
		АдресСервера);
		
	Журнал.Добавить(СтрокаЖурнала);
	Журнал.Добавить("> " + СтрокаКоманды);
	Журнал.Добавить(Результат.ПотокВывода);
	Журнал.Добавить(Результат.ПотокОшибок);
	
	Возврат СоединитьСтроку(Журнал, Символы.ПС);
	
КонецФункции

//&НаКлиенте
Функция ПортПоУмолчанию(Протокол)
	
	ПортыПоУмолчанию = Новый Соответствие;
	ПортыПоУмолчанию.Вставить("http", 80);
	ПортыПоУмолчанию.Вставить("https", 443);
	ПортыПоУмолчанию.Вставить("ftp", 21);
	ПортыПоУмолчанию.Вставить("ftps", 990);
	
	Возврат ПортыПоУмолчанию[НРег(Протокол)];
	
КонецФункции

