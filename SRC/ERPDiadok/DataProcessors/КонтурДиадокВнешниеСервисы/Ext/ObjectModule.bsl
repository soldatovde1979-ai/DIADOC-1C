//&НаКлиенте
Функция ИННСубъекта(Субъект)
	
	Если Субъект.Свойство("ИННЮЛ") Тогда
		Результат = Субъект.ИННЮЛ;
	ИначеЕсли Субъект.Свойство("ИНН") Тогда
		Результат = Субъект.ИНН;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Если Лев(Результат, 2) = "00" Тогда 
		Результат = Сред(Результат, 3);
	КонецЕсли;
	
	Возврат Результат;
	
