//&НаКлиенте
Функция ПараметрыHTTPЗапроса() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Метод");
	Результат.Вставить("АдресМетода");
	Результат.Вставить("ТелоЗапроса");
	Результат.Вставить("Параметры"					, Новый Структура);
	Результат.Вставить("Заголовки"					, Новый Соответствие);
	Результат.Вставить("ДопустимыеКодыОтвета"		, Новый Массив);
	Результат.Вставить("ТелоОтветаКакДвоичныеДанные", Ложь);
	Результат.Вставить("ПринудительноИспользоватьNative", Ложь);
	
	Результат.Метод = "GET";
	
	Результат.Заголовки.Вставить("Accept"		, "application/json");
	Результат.Заголовки.Вставить("Content-Type"	, "application/json;charset=utf-8");
	
	Результат.ДопустимыеКодыОтвета.Добавить(200);
	
	Возврат Результат;
	
КонецФункции

//&НаКлиенте
Функция ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса) Экспорт
	
	Логирование_ЗаписатьЗначение("Диадок.ВыполнитьHTTPЗапрос.ПараметрыСервиса", ПараметрыСервиса);
	Логирование_ЗаписатьЗначение("Диадок.ВыполнитьHTTPЗапрос.ПараметрыЗапроса", ПараметрыЗапроса);
	
	Попытка
		
		Результат = _ВыполнитьHTTPЗапросСлужебный(
			ПараметрыСервиса,
			ПараметрыЗапроса
		);
		
		Логирование_ЗаписатьЗначение("Диадок.ВыполнитьHTTPЗапрос.Результат", Результат);
		
	Исключение
		
		ОписаниеЗапросаHTTP = ОписаниеВыполняемогоЗапросаHTTP(ПараметрыСервиса, ПараметрыЗапроса);
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстОшибки = ТекстОшибкиЗапросаHTTP(ОписаниеЗапросаHTTP, ТекстОшибки);
		
		Логирование_ЗаписатьЗначение("Диадок.ВыполнитьHTTPЗапрос.Результат.Ошибка", ТекстОшибки);
		
		ОбработатьОшибкуHTTP(ОписаниеЗапросаHTTP.ВидОперации, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	Если НЕ Результат.КодОтветаДопустимый Тогда
		
		ОписаниеЗапросаHTTP = ОписаниеВыполняемогоЗапросаHTTP(ПараметрыСервиса, ПараметрыЗапроса, Результат);
		
		КодОтвета = Результат.КодОтвета;
		ТелоОтветаСтрокой = "";
		
		Если ТипЗнч(Результат.ТелоОтвета) = Тип("Строка") Тогда
			ТелоОтветаСтрокой = НРег(Результат.ТелоОтвета);
		КонецЕсли;
		
		Если ЭтоОшибкаАвторизации(КодОтвета, ТелоОтветаСтрокой) Тогда
			
			ОчиститьКонтекстСеанса();
			
			ТекстОшибки = НСтр("ru = 'Прошло слишком много времени с последней авторизации.
					|Для продолжения работы необходимо перезапустить модуль Диадока.'");
			
		Иначе
			ТекстОшибки = ТекстОшибкиЗапросаHTTP(ОписаниеЗапросаHTTP, ТелоОтветаСтрокой);
		КонецЕсли;
		
		ОбработатьОшибкуHTTP(ОписаниеЗапросаHTTP.ВидОперации, ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОписаниеВыполняемогоЗапросаHTTP(ПараметрыСервиса, ПараметрыЗапроса, РезультатЗапроса = Неопределено)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВидОперации");
	Результат.Вставить("ДопИнформация");
	
	Метод = ПараметрыЗапроса.Метод;
	
	ПринудительноИспользоватьNative = ПараметрыЗапроса.ПринудительноИспользоватьNative;
	ТранспортHTTPЗапроса = ТранспортHTTPЗапроса(ПринудительноИспользоватьNative);
	
	АдресВебСервиса = ПараметрыСервиса.АдресВебСервиса;
	АдресМетода = НормализоватьИмяМетода(ПараметрыЗапроса.АдресМетода);
	ПолныйАдресЗапроса = ПараметрыСервиса.Схема + "://" + АдресВебСервиса + АдресМетода;
	
	ДопИнформация = Новый Массив;
	
	Если РезультатЗапроса <> Неопределено Тогда
		ДопИнформация.Добавить(НСтр("ru = 'Код ответа: '") + РезультатЗапроса.КодОтвета);
	КонецЕсли;
	
	ДопИнформация.Добавить(НСтр("ru = 'Метод: '") + Метод);
	ДопИнформация.Добавить(НСтр("ru = 'Адрес: '") + ПолныйАдресЗапроса);
	
	Если РезультатЗапроса <> Неопределено
		И РезультатЗапроса.Заголовки <> Неопределено Тогда
		
		ЗаголовокTraceId = "X-Kontur-Trace-Id";
		ЗначениеTraceId = РезультатЗапроса.Заголовки.Получить(ЗаголовокTraceId);
		
		Если ЗначениеTraceId <> Неопределено Тогда
			ДопИнформация.Добавить(ЗаголовокTraceId + ": " + ЗначениеTraceId);
		КонецЕсли;
		
	КонецЕсли;
	
	ДопИнформация.Добавить(НСтр("ru = 'Использован транспорт: '") + ТранспортHTTPЗапроса);
	
	Результат.ВидОперации = НСтр("ru = 'HTTP запрос в сервис: '") + АдресВебСервиса;
	Результат.ДопИнформация = ДопИнформация;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстОшибкиЗапросаHTTP(ОписаниеЗапросаHTTP, ТекстОшибки)
	
	ШаблонОшибкиHTTP = НСтр("ru = 'Ошибка HTTP запроса
							|%1
							|
							|%2'");
	
	ТекстДопИнформации = СоединитьСтроку(ОписаниеЗапросаHTTP.ДопИнформация, Символы.ПС);
	
	Результат = Общее_ПодставитьПараметрыВСтроку(ШаблонОшибкиHTTP, ТекстДопИнформации, ТекстОшибки);
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьОшибкуHTTP(ВидОперации, ТекстОшибки)
	
	Ядро.Ошибка_Обработать(ВидОперации, ТекстОшибки);
	
КонецПроцедуры

Функция _ВыполнитьHTTPЗапросСлужебный(ПараметрыСервиса, ПараметрыЗапроса)
	
	ПринудительноИспользоватьNative = ПараметрыЗапроса.ПринудительноИспользоватьNative;
	
	ТранспортHTTPЗапроса = ТранспортHTTPЗапроса(ПринудительноИспользоватьNative);
	
	КоличествоПопыток = 3;
	
	Для НомерПопытки = 1 По КоличествоПопыток Цикл
		
		Попытка
			
			Если ТранспортHTTPЗапроса = Перечисление_ТранспортHTTP().WinHTTP Тогда
				
				Результат = ВыполнитьHTTPЗапрос_WinHTTP(ПараметрыСервиса, ПараметрыЗапроса);
				
			ИначеЕсли ТранспортHTTPЗапроса = Перечисление_ТранспортHTTP().КоннекторHTTP Тогда
				
				Результат = ВыполнитьHTTPЗапрос_КоннекторHTTP(ПараметрыСервиса, ПараметрыЗапроса);
				
			Иначе
				
				Результат = ВыполнитьHTTPЗапрос_Встроенный(ПараметрыСервиса, ПараметрыЗапроса);
				
			КонецЕсли;
			
			Прервать;
			
		Исключение
			
			Ошибка = ИнформацияОбОшибке();
			
			Если НомерПопытки < КоличествоПопыток
				И ЭтоОшибкаИнициализацииСоединенияSSL(Ошибка) Тогда
				
				ПолныйАдрес = ПолныйURL(ПараметрыСервиса, ПараметрыЗапроса);
				
				ЧастиКомментария = Новый Массив;
				ЧастиКомментария.Добавить(ПараметрыЗапроса.Метод + " " + ПолныйАдрес);
				ЧастиКомментария.Добавить("Попытка " + XMLСтрока(НомерПопытки) + " из " + XMLСтрока(КоличествоПопыток));
				ЧастиКомментария.Добавить("Транспорт = " + ТранспортHTTPЗапроса);
				ЧастиКомментария.Добавить("");
				ЧастиКомментария.Добавить(ПодробноеПредставлениеОшибки(Ошибка));
				
				КомментарийЖР = СоединитьСтроку(ЧастиКомментария, Символы.ПС);
				
				ЗаписьЖурналаРегистрации(
					"Диадок.ЗапросHTTP",
					УровеньЖурналаРегистрации.Предупреждение,
					Неопределено,
					Неопределено,
					КомментарийЖР
				);
				
			Иначе
				
				ВызватьИсключение;
				
			КонецЕсли;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолныйURL(ПараметрыСервиса, ПараметрыЗапроса)
	
	АдресВебСервиса = ПараметрыСервиса.АдресВебСервиса;
	АдресМетода = НормализоватьИмяМетода(ПараметрыЗапроса.АдресМетода);
	Результат = ПараметрыСервиса.Схема + "://" + АдресВебСервиса + АдресМетода;
	
	Возврат Результат;
	
КонецФункции

Функция ОшибкаИнициализацииСоединения1С_ru()
	Возврат "Ошибка инициализации SSL-соединения";
КонецФункции

Функция ОшибкаИнициализацииСоединения1С_en()
	Возврат "SSL connect error";
КонецФункции

Функция ОшибкаИнициализацииСоединенияWinHTTP_ru()
	Возврат "Соединение с сервером было неожиданно прервано";
КонецФункции

Функция ЭтоОшибкаИнициализацииСоединенияSSL(Ошибка)
	
	ВариантыОшибок = Новый Массив;
	ВариантыОшибок.Добавить(ОшибкаИнициализацииСоединения1С_ru());
	ВариантыОшибок.Добавить(ОшибкаИнициализацииСоединения1С_en());
	ВариантыОшибок.Добавить(ОшибкаИнициализацииСоединенияWinHTTP_ru());
	
	Результат = Ложь;
	
	ПодробныйТекстОшибкиНРег = НРег(ПодробноеПредставлениеОшибки(Ошибка));
	
	Для Каждого Подстрока Из ВариантыОшибок Цикл
		
		Если Найти(ПодробныйТекстОшибкиНРег, НРег(Подстрока)) Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

