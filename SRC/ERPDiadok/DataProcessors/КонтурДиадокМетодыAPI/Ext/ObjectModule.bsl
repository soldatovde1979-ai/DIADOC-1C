Функция DD_API_Delete(ПараметрыСервиса, boxId, messageId, documentId = Неопределено) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/http/Delete.html
	
	// Если параметр documentId не задан, то сообщение messageId удаляется целиком,
	// и все документы в нем автоматически помечаются как удаленные.
	// Когда из сообщения удаляется последний документ,
	// само сообщение также помечается как удаленное.
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/Delete";
	
	ПараметрыЗапроса.Параметры.Вставить("boxId"		, boxId);
	ПараметрыЗапроса.Параметры.Вставить("messageId"	, messageId);
	
	Если ЗначениеЗаполнено(documentId) Тогда
		ПараметрыЗапроса.Параметры.Вставить("documentId", documentId);
	КонецЕсли;
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
