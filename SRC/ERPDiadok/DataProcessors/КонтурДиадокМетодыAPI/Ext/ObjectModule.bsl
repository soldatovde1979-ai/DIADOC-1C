// Проверяет наличие новой версии и возвращает её описание
//   
// Параметры:
//  ПараметрыСервиса 			- Структура - см. функцию ПараметрыСервиса();
//  ПараметрыОкруженияМодуля	- Структура - см. функцию ПараметрыОкруженияМодуля() модуля объекта Ядро.epf
// 
// Возвращаемое значение:
//  Строка - описание новой версии в формате JSON
//
Функция UpdateServise_API_Check(ПараметрыСервиса, ПараметрыОкруженияМодуля) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод = "POST";
	ПараметрыЗапроса.АдресМетода = "/1c/v3/diadoc_um/check";
	ПараметрыЗапроса.ТелоЗапроса = ПарсерJSON_Записать(ПараметрыОкруженияМодуля);
	
	РезультатВыполнения = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = РезультатВыполнения.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

// Скачивает и возвращает файл новой версии модуля
//
// Параметры:
//  ПараметрыСервиса 	- Структура - см. функцию ПараметрыСервиса();
//  ПутьКФайлуНаСервере	- Строка 	- имя ресурса файла на сервере
// 
// Возвращаемое значение:
//  ДвоичныеДанные - файл новой версии модуля
//
Функция UpdateServise_API_DownloadFile(ПараметрыСервиса, ПутьКФайлуНаСервере) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод = "GET";
	ПараметрыЗапроса.АдресМетода = ПутьКФайлуНаСервере;
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	РезультатВыполнения = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = РезультатВыполнения.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

// Возвращает описание контента из сервиса обновлений
//
// Параметры:
//  ПараметрыСервиса - Структура - см. Модуль_Ядро.ПараметрыСервиса_СервисОбновлений
//  ProductVersion	 - Строка	 - версия модуля в формате РР.{П|ПП}.ЗЗ
//  ContentType		 - Строка	 - тип контента (программное перечисление, см. метод UpdateServiсe_API_ENUM_ContentsType)
// 
// Возвращаемое значение:
//  Строка - описание контента или ошибки в формате JSON
//		Поля описания контента:
//          name - Строка - тип контента (Например: extension, data-processor) см. UpdateServiсe_API_ENUM_ContentsType 
//          filename - Строка - исходное имя загруженного файла
//			md4hash - Строка - хеш-сумма загруженного файла
//		Поля описания ошибки:
//			status-code - Число - код HTTP ошибки
//			message		- Строка - текст ошибки
//
Функция UpdateServiсe_API_Content(ПараметрыСервиса, ProductVersion, ContentType) Экспорт
	
	Результат = Неопределено;
	
	ШаблонАдресаМетода = "/1c/v4/products/diadoc_um/versions/%1/contents/%2";
	
	АдресМетода = СтрШаблонЛок(ШаблонАдресаМетода, ProductVersion, ContentType);
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод = "GET";
	ПараметрыЗапроса.АдресМетода = АдресМетода;
	
	РезультатВыполнения = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = РезультатВыполнения.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

// Программное перечисление типов контента сервиса обновлений
