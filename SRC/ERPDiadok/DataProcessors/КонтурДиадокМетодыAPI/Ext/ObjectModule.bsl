//  AccountId		 - Строка - Идентификатор лицевого счета Диадок
// 
// Возвращаемое значение:
//  Строка - не сериализованый JSON
//
Функция Kontur_API_GetPortalBills(ПараметрыСервиса, AccountId) Экспорт
	
	Результат = "[]";

	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/relevant-offers/v1/sources/diadoc/accounts/" + AccountId;

	ДобавитьЗаголовокАвторизацииКонтурАпи(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 200 Тогда
		Результат = Ответ.ТелоОтвета;
	КонецЕсли;

	Возврат Результат;
КонецФункции

