// Обнолвяет сведения о плагине в сервисе
//
// Параметры:
//  ПараметрыСервиса - Структура - см. Ядро.ПараметрыСервиса_СервисУправленияПМ 
//  ТелоЗапроса		 - Строка	 - 
//  customer_id		 - Строка	 - идентификатор ИБ в виде GUID 
//  plugin_id		 - Строка	 - идентификатор плагина в сервисе
// 
// Возвращаемое значение:
//  Структура - сведения о плагине (см. Plugins_ПолучитьСведения)
//
Функция Plugins_ОбновитьВСервисе(ПараметрыСервиса, ТелоЗапроса, customer_id, plugin_id) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.ТелоЗапроса = ТелоЗапроса;
	
	АдресМетода = Plugins_АдресМетода(customer_id);
	АдресМетода = АдресМетода + "/" + plugin_id;
	
	ПараметрыЗапроса.Метод 			= "POST";
	ПараметрыЗапроса.АдресМетода	= АдресМетода;
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Возврат Ответ.ТелоОтвета;
	
КонецФункции

// Возвращает сведения о выгруженных в сервис ПМ
//
// Параметры:
//  ПараметрыСервиса - Структура - см. Ядро.ПараметрыСервиса_СервисУправленияПМ
//  plugin_type		 - Строка	 - см. Plugins_API_ENUM_ТипыПлагинов
//  customer_id		 - Строка	 - идентификатор ИБ в виде GUID
// 
// Возвращаемое значение:
//  Структура - сведения о ПМ из сервиса (все значения полей строковые)
//		id				- идентификатор плагина в сервисе
//		plugin_type 	- тип плагина
//		filename 		- имя файла
//		description 	- описание
//		hash_md5 		- хэш сумма файла
//		parent_md5hash 	- хэш сумма файла (для обновлений)
//		update 			- последняя дата изменения
//		create 			- дата создания
//
Функция Plugins_ПолучитьСведения(ПараметрыСервиса, customer_id, plugin_type, count = 1, parent_md5hash = Неопределено) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Параметры.Вставить("order"			, "updated desc");
	ПараметрыЗапроса.Параметры.Вставить("plugin_type"	, plugin_type);
	ПараметрыЗапроса.Параметры.Вставить("count"			, count);
	
	Если ЗначениеЗаполнено(parent_md5hash) Тогда
		ПараметрыЗапроса.Параметры.Вставить("parent_md5hash", parent_md5hash);
	КонецЕсли;
	
	АдресМетода = Plugins_АдресМетода(customer_id);
	
	ПараметрыЗапроса.Метод 							= "GET";
	ПараметрыЗапроса.АдресМетода					= АдресМетода;
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные 	= Ложь;

	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Возврат Ответ.ТелоОтвета;
	
КонецФункции

// Загружает из сервиса файл
//
// Параметры:
//  ПараметрыСервиса - Структура - см. Ядро.ПараметрыСервиса_СервисУправленияПМ
//  customer_id		 - Строка	 - идентификатор информационной базы
//  plugin_id		 - Строка	 - идентификатор плагина в сервисе
// 
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - двоичные данные файла
//
Функция Plugins_ЗагрузитьФайл(ПараметрыСервиса, customer_id, plugin_id) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	АдресМетода = Plugins_АдресМетода(customer_id);
	АдресМетода = АдресМетода + "/" + plugin_id + "/download";
	
	ПараметрыЗапроса.Метод 							= "GET";
	ПараметрыЗапроса.АдресМетода					= АдресМетода;
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные 	= Истина;

	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Возврат Ответ.ТелоОтвета;
	
КонецФункции

// Возвращает сведения о файле ПМ обновления
//
// Параметры:
//  ПараметрыСервиса - Структура - см. Ядро.ПараметрыСервиса_СервисУправленияПМ
//  customer_id		 - Строка	 - идентификатор информационной базы
//  plugin_type		 - Строка	 - тип плагина (см. Plugins_API_DS_ТипПлагинаОбновлений)
//  parent_md5hash	 - Строка	 - хэш-сумма файла ПМ, для которого необходимо получить сведения об обновлении
// 
// Возвращаемое значение:
//  Структура - описание полей см. Plugins_ПолучитьСведения
//
Функция Plugins_ПолучитьОбновление(ПараметрыСервиса, customer_id, plugin_type, parent_md5hash) Экспорт
	
	update_plugin_type 	= Plugins_API_DS_ТипПлагинаОбновлений(plugin_type);
	count 				= 1;

	Результат = Plugins_ПолучитьСведения(ПараметрыСервиса, customer_id, update_plugin_type, count, parent_md5hash);
	
	Возврат Результат;
	
КонецФункции

// Маппинг типов плагинов. Возвращает тип плагина-обновление.
// Плагины для обновления имеют отличный от выгружаемых типы. 
// Нельзя добавлять или изменять плагины с такими типами без авторизации
//
// Параметры:
//  plugin_type	 - Строка - тип плагина, используемый для выгрузки и чтения без авторизации
// 
// Возвращаемое значение:
//  Строка - тип плагина обновлений
//
Функция Plugins_API_DS_ТипПлагинаОбновлений(plugin_type)
	
	ТипыПлагинов = Plugins_API_ENUM_ТипыПлагинов();
	
	Если plugin_type = ТипыПлагинов.ПМСтандарта Тогда
		Результат = "plugin-dd-standard";	
	Иначе
		Результат = "plugin-dd";	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

