Функция DD_API_GenerateRevocationRequestXml(ПараметрыСервиса, boxId, messageId, attachmentId, RevocationRequestInfo) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/http/GenerateRevocationRequestXml.html
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		= "POST";
	ПараметрыЗапроса.АдресМетода 	= "/V2/GenerateRevocationRequestXml";
	
	ПараметрыЗапроса.Параметры.Вставить("boxId"			, boxId);
	ПараметрыЗапроса.Параметры.Вставить("messageId"		, messageId);
	ПараметрыЗапроса.Параметры.Вставить("attachmentId"	, attachmentId);
	
	ПараметрыЗапроса.ТелоЗапроса = ПарсерJSON_Записать(RevocationRequestInfo);
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;

	// Api.RevocationRequestNotAvailableForRoamingOperator: 
	// - Оператор контрагента не поддерживает аннулирование;
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(400);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета <> 200 Тогда
		
		ТекстОшибки = "";
		
		КодОшибки = Ответ.Заголовки.Получить("X-Diadoc-ErrorCode");
		Если ЗначениеЗаполнено(КодОшибки) И Найти(КодОшибки, "RevocationRequestNotAvailableForRoamingOperator") > 0 Тогда
			ТекстОшибки = "Оператор контрагента не поддерживает аннулирование";
		КонецЕсли;
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Результат = Ответ.ТелоОтвета;
	
	Возврат Результат;
	
КонецФункции

