Процедура ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса)
	
	Заголовки = ПараметрыЗапроса.Заголовки;
	
	ЗаголовокАвторизации = ЗаголовокАвторизацииДиадок(ПараметрыСервиса);
	
	Заголовки.Вставить("Authorization", ЗаголовокАвторизации);
	
КонецПроцедуры

Функция ЗаголовокАвторизацииДиадок(ПараметрыСервиса) Экспорт
	
	Токен			 = ПараметрыСервиса.Токен;
	КлючРазработчика = ПараметрыСервиса.КлючРазработчика;
	
	Если ПараметрыСервиса.ИспользоватьПротоколOIDC Тогда
		Результат = _ЗаголовокАвторизацииBearer(Токен);
	Иначе
		Результат = _ЗаголовокАвторизацииDiadocAuth(КлючРазработчика, Токен);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция _ЗаголовокАвторизацииBearer(Знач access_token)
	
	Если Не ЗначениеЗаполнено(access_token) Тогда
		Ошибка = "ValueError: Не указан access_token";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Результат = "Bearer " + access_token;
	Возврат Результат;
	
КонецФункции

Функция _ЗаголовокАвторизацииDiadocAuth(Знач ddauth_api_client_id, Знач ddauth_token)
	
	Если Не ЗначениеЗаполнено(ddauth_api_client_id) Тогда
		Ошибка = "ValueError: Не указан ddauth_api_client_id";
		ВызватьИсключение Ошибка;
	КонецЕсли;
	
	Результат = "DiadocAuth ddauth_api_client_id=" + ddauth_api_client_id;
	
	Если ЗначениеЗаполнено(ddauth_token) Тогда
		Результат = Результат + ",ddauth_token=" + ddauth_token;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // _ЗаголовокАвторизацииДиадок

Процедура ДобавитьЗаголовокАвторизацииКонтурАпи(ПараметрыСервиса, ПараметрыЗапроса)
	
	Токен		 = ПараметрыСервиса.Токен;
	Заголовки	 = ПараметрыЗапроса.Заголовки;
	
	Заголовки.Вставить("x-Auth-ddToken", Токен);
	
КонецПроцедуры

Процедура ДобавитьИдентификаторОперации(ПараметрыЗапроса, OperationId)
	
	Если Не ЗначениеЗаполнено(OperationId) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапроса.Параметры.Вставить("OperationId", OperationId);
	
КонецПроцедуры

Процедура ДобавитьТелоЗапроса(ПараметрыЗапроса, ТелоЗапроса, МедиаТип)
	
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", МедиаТип);
	ПараметрыЗапроса.ТелоЗапроса = ТелоЗапроса;
	
КонецПроцедуры

