	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	// BSLLS:MagicNumber-off
	Если Ответ.КодОтвета = 200 Тогда
	// BSLLS:MagicNumber-on
	
		РезультатОтвета = ПарсерJSON_Прочитать(Ответ.ТелоОтвета);
		
		ЗаполнитьЗначенияСвойств(Результат, РезультатОтвета);
	
	КонецЕсли;
	
	Возврат Результат;

