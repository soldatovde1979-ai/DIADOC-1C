Функция DD_API_GetEntityContent(ПараметрыСервиса, boxId, messageId, entityId) Экспорт
	
	//http://api-docs.diadoc.ru/ru/latest/http/GetEntityContent.html
	
	ПараметрыСервиса.Таймаут = 150;
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/V4/GetEntityContent";
	
	ПараметрыЗапроса.Параметры.Вставить("boxId", boxId);
	ПараметрыЗапроса.Параметры.Вставить("entityId", entityId);
	ПараметрыЗапроса.Параметры.Вставить("messageId", messageId);
	
	// "Entity ID not found in message" - если сущность невалидна, то она тоже не будет найдена.
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(404);
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	ПараметрыЗапроса.ТелоОтветаКакДвоичныеДанные = Истина;
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 404 Тогда
		Результат = Неопределено;
	Иначе
		Результат = Ответ.ТелоОтвета;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает данные сообщения по указанному идентификатору.
//
// Параметры:
//  ПараметрыСервиса	 - Структура - см. ПараметрыСервиса
//  boxId				 - Строка - идентификатор ящика
//  messageId			 - Строка - идентификатор сообщения
//  entityId			 - Строка - идентификатор документа в сообщении (необезательный)
//  originalSignature	 - Булево - если Истина, то возвращается оригинальная подпись, иначе подпись в формате CADES-T
//  injectEntityContent	 - Булево - если Истина, то в результат включается содержимое документа в поле Content.Data,
// 
// Возвращаемое значение:
//  Структура - данные сообщения
//
Функция DD_API_GetMessage(
	ПараметрыСервиса,
	boxId,
	messageId,
	entityId = Неопределено,
	originalSignature = Неопределено,
	injectEntityContent = Неопределено) Экспорт
	
	// https://developer.kontur.ru/docs/diadoc-api/ru/latest/http/GetMessage_V6.html
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/V6/GetMessage";
	
	ПараметрыЗапроса.Параметры.Вставить("boxId", boxId);
	ПараметрыЗапроса.Параметры.Вставить("messageId", messageId);
	
	Если ЗначениеЗаполнено(entityId) Тогда
		ПараметрыЗапроса.Параметры.Вставить("entityId", entityId);
	КонецЕсли;
	
	Если Не originalSignature = Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("originalSignature", XMLСтрока(originalSignature));
	КонецЕсли;
	
	Если Не injectEntityContent = Неопределено Тогда
		ПараметрыЗапроса.Параметры.Вставить("injectEntityContent", XMLСтрока(injectEntityContent));
	КонецЕсли;
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Результат = ПарсерJSON_Прочитать(Ответ.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

