Функция ВнешниеСервисы_ПараметрыHTTPЗапроса()
	
	Модуль = Ядро.Модуль_ВнешниеСервисы(ЭтотОбъект);
	Результат = Модуль.ПараметрыHTTPЗапроса();
	Возврат Результат;
	
КонецФункции

Функция ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса)
	
	СессияЛок = Сессия();
	Если ЗначениеЗаполнено(СессияЛок.Заголовки) Тогда
		Для Каждого КлючЗначение Из СессияЛок.Заголовки Цикл
			ПараметрыЗапроса.Заголовки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Модуль = Ядро.Модуль_ВнешниеСервисы(ЭтотОбъект);
	Результат = Модуль.ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Возврат Результат;
	
КонецФункции

Функция Сессия() Экспорт
	
	Если _СессияЛок = Неопределено Тогда
		_СессияЛок = Новый Структура;
		_СессияЛок.Вставить("Заголовки", Новый Соответствие);
	КонецЕсли;
	
	Возврат _СессияЛок;
	
КонецФункции

