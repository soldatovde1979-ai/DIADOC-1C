// Выполняет проверку сертификата на КЭП
//
// Параметры:
//  ПараметрыСервиса 	- Структура - Контракт ПараметрыСервиса_Контур
//  BoxId				- Строка	- Идентификатор ящика организации
//  CertificateVerificationRequest	- Структура - см. DD_API_DS_CertificateVerificationRequest()
// 
// Возвращаемое значение:
//  Структура - результат проверки, Строка - если при вызове метода произошла ошибка (содержит текст ошибки)
//
Функция DD_API_VerifyCertificate(ПараметрыСервиса, BoxId, CertificateVerificationRequest) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/VerifyCertificate";
	
	ПараметрыЗапроса.Параметры.Вставить("BoxId", BoxId);
	
	ПараметрыЗапроса.ТелоЗапроса = ПарсерJSON_Записать(CertificateVerificationRequest);
	
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(400);
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(401);
