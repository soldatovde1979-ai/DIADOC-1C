Функция ПроверитьРегистрациюСертификатаВФНСЧерезДиадок(ПараметрыСервиса, BoxId, Сертификат) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/http/CanSendInvoice.html
	
	Результат = Истина;
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.Метод		 = "POST";
	ПараметрыЗапроса.АдресМетода = "/CanSendInvoice";
	
	ПараметрыЗапроса.Параметры.Вставить("boxId", boxId);
	
	// 403 - Сертификат не может использоваться для подписания ЭСФ
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(403);
	
	ПараметрыЗапроса.ТелоЗапроса = Сертификат;
	
	ДобавитьЗаголовокАвторизацииДиадок(ПараметрыСервиса, ПараметрыЗапроса);
	
	Ответ = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Если Ответ.КодОтвета = 403 Тогда
		
		ТекстОшибки = Ответ.ТелоОтвета;
		
		ЭтоОшибкаРегистрацииСертификатаВФНС = Ложь
		Или Найти(ТекстОшибки, "FNS reg message was not sent for box") > 0
		Или Найти(ТекстОшибки, "is not registered in FNS for box") > 0
		Или Найти(ТекстОшибки, "No registration message to FNS found for boxId") > 0
		Или Найти(ТекстОшибки, "Unknown FnsRegStatus") > 0;
		
		Если ЭтоОшибкаРегистрацииСертификатаВФНС Тогда
			
			Результат = Ложь;
			
		ИначеЕсли Найти(ТекстОшибки, "Сертификат подписанта не является квалифицированным") = 0 Тогда
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьСоединение(ПараметрыСервиса) Экспорт
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
	ПараметрыЗапроса.АдресМетода = "/GetBox";
	
	// 401 - нет заголовка авторизации в Диадоке. 
	// Этого кода достаточно для проверки соединения с API.
	ПараметрыЗапроса.ДопустимыеКодыОтвета.Добавить(401);
	
	Результат = ВнешниеСервисы_ВыполнитьHTTPЗапрос(ПараметрыСервиса, ПараметрыЗапроса);
	
	Возврат Результат;
	
КонецФункции

// Конструктор настроек прокси сервера
//
// Параметры:
//  Режим		 - Строка	 		- См. РежимыИспользованияПрокси()
//  Сервер		 - Строка	 		- Адрес прокси-сервера.
//  Порт		 - Строка, Число	- Порт прокси-сервера.
//  Логин		 - Строка	 		- Логин для авторизации на прокси-сервере.
//  Пароль		 - Строка	 		- Пароль для авторизации на прокси-сервере.
// 
// Возвращаемое значение:
//  Структура - настройки прокси
//   * РежимПрокси	 		- Строка - См. РежимыИспользованияПрокси(). Значение по умолчанию - "NoProxy"
//   * АдресПроксиСервера 	- Строка - Адрес прокси-сервера. Значение по умолчанию - пустая строка.
//   * ЛогинПроксиСервера	- Строка - Логин для авторизации на прокси-сервере. Значение по умолчанию - пустая строка.
//   * ПарольПроксиСервера	- Строка - Пароль для авторизации на прокси-сервере. Значение по умолчанию - пустая строка.
//   * ПортПроксиСервера	- Число	 - Порт прокси-сервера. Значение по умолчанию - 0.
//
//&НаКлиенте
Функция НовыйНастройкиПрокси(Режим = "",
							 Сервер = "",
							 Порт = 0,
							 Логин = "",
							 Пароль = "") Экспорт
		
	Если Не ЗначениеЗаполнено(Режим) Тогда
		Режим = РежимыИспользованияПрокси().БезПрокси;
	КонецЕсли;
	
	ОписаниеТипов = Новый ОписаниеТипов("Число");
	ПортЧислом = ОписаниеТипов.ПривестиЗначение(Порт);
	
	НастройкиПрокси = Новый Структура;
	НастройкиПрокси.Вставить("РежимПрокси"			, Режим);
	НастройкиПрокси.Вставить("АдресПроксиСервера"	, Сервер);
	НастройкиПрокси.Вставить("ЛогинПроксиСервера"	, Логин);
	НастройкиПрокси.Вставить("ПарольПроксиСервера"	, Пароль);
	НастройкиПрокси.Вставить("ПортПроксиСервера"	, ПортЧислом);
	
	Возврат НастройкиПрокси;
	
КонецФункции

// Режимы использования прокси сервера
// 
// Возвращаемое значение:
//  ФиксированнаяСтруктура - перечень режимов
//	 * БезПрокси 						- Строка - NoProxy
//	 * ИспользоватьНастройкиМодуля 		- Строка - UseProxy
//	 * ИспользоватьСистемныеНастройки 	- Строка - UseDefaultProxy
//
//&НаКлиенте
Функция РежимыИспользованияПрокси() Экспорт

	РежимыПрокси = Новый Структура;
	РежимыПрокси.Вставить("БезПрокси"						, "NoProxy");
	РежимыПрокси.Вставить("ИспользоватьНастройкиМодуля"		, "UseProxy");
	РежимыПрокси.Вставить("ИспользоватьСистемныеНастройки"	, "UseDefaultProxy");
	
	Возврат Новый ФиксированнаяСтруктура(РежимыПрокси);
	
КонецФункции

