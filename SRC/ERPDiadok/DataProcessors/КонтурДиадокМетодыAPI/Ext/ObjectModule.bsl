// https://diadoc-sdk.readthedocs.io/ru/workflow/proto/DocumentWorkflowSettings.html
//
// Возвращаемое значение:
//  Структура - содержит свойства, которые соответствуют значениям перечисления
//
Функция DD_API_ENUM_ParticipantType() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Sender",	"Sender");		// Отправитель
    Результат.Вставить("Proxy",		"Proxy"); 		// Промежуточный получатель
    Результат.Вставить("Recipient",	"Recipient");	// Конечный получатель
		
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру с перечислением значений ParticipantAction
// https://diadoc-sdk.readthedocs.io/ru/workflow/proto/DocumentWorkflowSettings.html
//
// Возвращаемое значение:
//  Структура - содержит свойства, которые соответствуют значениям перечисления
//
Функция DD_API_ENUM_ParticipantAction() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Title",				"Title");				// Титул
    Результат.Вставить("Signature",			"Signature");			// Подпись
    Результат.Вставить("OptionalSignature",	"OptionalSignature");	// Подпись по запросу
		
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
