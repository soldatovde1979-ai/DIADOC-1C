Функция ТелоЗапросаЛогинПароль(Логин, Пароль)
	
	Объект = Новый Структура;
	Объект.Вставить("login", Строка(Логин));
	Объект.Вставить("password", Строка(Пароль));
	
	Результат = ПарсерJSON_Записать(Объект);
	
	Возврат Результат;
	
КонецФункции

// Формирует текстовое описание HTTP-ошибки, включая в него код состояния и служебные данные.
//
// Параметры:
//  КодСостояния - Число - Код ответа HTTP
//  Ответ - Структура - см. ВнешниеСервисы.ВыполнитьHTTPЗапрос
// 
// Возвращаемое значение:
//  Строка - описание HTTP-ошибки.
//
Функция ОшибкаСостоянияHTTP(Знач КодСостояния, Знач Ответ = Неопределено)
	
	Подстроки = Новый Массив;
	Подстроки.Добавить(СтрШаблонЛок("Код состояния: %1", XMLСтрока(КодСостояния)));
	
	Если Ответ <> Неопределено Тогда
		
		TraceId = Ответ.Заголовки.Получить("X-Kontur-Trace-Id");
		Если ЗначениеЗаполнено(TraceId) Тогда
			Подстроки.Добавить(СтрШаблонЛок("TraceId: %1", TraceId));
		КонецЕсли;
		
		DiadocErrorCode = Ответ.Заголовки.Получить("X-Diadoc-ErrorCode");
		Если ЗначениеЗаполнено(DiadocErrorCode) Тогда
			Подстроки.Добавить(СтрШаблонЛок("DiadocErrorCode: %1", DiadocErrorCode));
		КонецЕсли;
		
		ТипДанных = Ответ.Заголовки.Получить("Content-Type");
		ТелоОтвета = Ответ.ТелоОтвета;
		
		Если ТипДанных = МедиаТипТекстUTF8() Тогда
			
			Если ТипЗнч(ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
				Описание = СтрокаИзДвоичныхДанных(ТелоОтвета);
			Иначе
				Описание = ТелоОтвета;
			КонецЕсли;
			
			Подстроки.Добавить(СтрШаблонЛок("Описание: %1", Описание));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = СтрСоединитьЛок(Подстроки, Символы.ПС);
	
	Возврат Результат;
	
КонецФункции

