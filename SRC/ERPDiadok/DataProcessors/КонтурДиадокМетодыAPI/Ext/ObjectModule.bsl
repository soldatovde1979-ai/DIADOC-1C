// Контракт с описанием плагина для выгрузки в сервис
//
// Параметры:
//  content_data - ДвоичныеДанные  	- двоичные данные выгружаемого файла 
//  plugin_type	 - Строка	 		- тип плагина API (см. Plugins_API_ENUM_ТипыПлагинов)
//  filename	 - Строка			- произвольное имя файла
//  description	 - Строка			- произвольный текст
// 
// Возвращаемое значение:
//  Структура - контракт
//  	- content_data 	- Строка - данные выгружаемого файла строкой в base64
//  	- plugin_type	- Строка - тип плагина API (см. Plugins_API_ENUM_ТипыПлагинов)
//  	- filename		- Строка - имя файла
//  	- description	- Строка - произвольный текст
//
Функция Plugins_API_DS_ContentToPost(content_data, plugin_type, filename, description) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("content_data"	, Base64Строка(content_data));
	Результат.Вставить("plugin_type"	, plugin_type);
	Результат.Вставить("filename"		, filename);
	Результат.Вставить("description"	, description);
	
	Возврат Результат;	
	
КонецФункции

