// Возвращает структуру ЭП к данным в отправляемом сообщении
//
// Параметры
//  ParentEntityId	 - Строка	 - Идентификатор подписываемых данных
//
Функция DD_API_DS_DocumentSignature(ParentEntityId, 
									Signature = Неопределено, 
									PatchedContentId = Неопределено, 
									IsApprovementSignature = Ложь,
									PowerOfAttorney = Неопределено) Экспорт 
	
	// http://api-docs.diadoc.ru/ru/latest/proto/DocumentSignature.html
	
	Результат = Новый Структура;
	Результат.Вставить("ParentEntityId",	 ParentEntityId);
	Результат.Вставить("Labels",			 Новый Массив); // для коллекции строк, см. http://api-docs.diadoc.ru/ru/latest/proto/Labels.html
	
	Если Signature <> Неопределено Тогда
		
		Если ТипЗнч(Signature) = Тип("ДвоичныеДанные") Тогда
			SignatureBase64 = Base64Строка(Signature);
		Иначе
			SignatureBase64 = Signature;
		КонецЕсли;
		
		Результат.Вставить("Signature",	SignatureBase64);
		
	КонецЕсли;
	
	Если PatchedContentId <> Неопределено Тогда
		Результат.Вставить("PatchedContentId", PatchedContentId);
	КонецЕсли;
	
	Если IsApprovementSignature Тогда
		Результат.Вставить("IsApprovementSignature", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(PowerOfAttorney) Тогда
		Результат.Вставить("PowerOfAttorney", PowerOfAttorney);
	КонецЕсли;
	
	Возврат Результат;

