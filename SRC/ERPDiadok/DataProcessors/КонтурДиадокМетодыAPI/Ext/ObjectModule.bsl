	Результат.Вставить("OperationStatus");
	Результат.Вставить("FileSigningResults");
	Результат.Вставить("ConfirmType");
	Результат.Вставить("DssOperator");
	Результат.Вставить("PhoneLastNumbers");
	
	ПараметрыЗапроса = ВнешниеСервисы_ПараметрыHTTPЗапроса();
	
