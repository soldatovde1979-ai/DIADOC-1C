// Возвращает структуру с перечислением значений PowerOfAttorneyRepresentativeType
// https://developer.kontur.ru/Docs/diadoc-api/proto/PowerOfAttorney.html#powerofattorneyrepresentativetype
//
// Возвращаемое значение:
//  Структура - содержит свойства, которые соответствуют значениям перечисления
//
Функция DD_API_ENUM_PowerOfAttorneyRepresentativeType() Экспорт
	
	Результат = Новый Структура;
	
	// Зарезервированное значение
	Результат.Вставить("UnknownRepresentativeType", "UnknownRepresentativeType");
	// Юридическое лицо
	Результат.Вставить("RepresentativeLegalEntity", "RepresentativeLegalEntity");
	// Индивидуальный предприниматель
	Результат.Вставить("RepresentativeIndividualEntity", "RepresentativeIndividualEntity");
	// Физическое лицо
	Результат.Вставить("RepresentativePhysicalEntity", "RepresentativePhysicalEntity");
	// Филиал юридического лица (обособленное подразделение)
	Результат.Вставить("RepresentativeLegalSubsidiaryEntity", "RepresentativeLegalSubsidiaryEntity");
	// Филиал иностранного юридического лица (аккредитованное представительство)
	Результат.Вставить("RepresentativeForeignLegalSubsidiaryEntity", "RepresentativeForeignLegalSubsidiaryEntity");
	
	Результат = Новый ФиксированнаяСтруктура(Результат);
	
	Возврат Результат;
	
КонецФункции

