// Возвращает структуру данных для подписания файлов сертификатом без носителя
//
// Параметры:
//  Files			 - Массив					 - из Структура см. DD_API_DS_DssSignFile список файлов для подписания
//  SignDataSource	 - Строка					 - параметр, указывающий, какими данными должен быть подписан файл
//  CertificateData	 - Структура, Неопределено	 - см. DD_API_DS_CertificateData. Данные для подписания файла
//  	с помощью сертификата без носителя
//  GosKeyData		 - Структура, Неопределено	 - см. DD_API_DS_GosKeyData. Данные для подписания файла
//  	с помощью Госключа
// 
// Возвращаемое значение:
//  Структура - содержит поля:
//  * DssSignFile		- Массив из Структура - см. DD_API_DS_DssSignFile список файлов для подписания
//  * SignDataSource	- Строка	- параметр, указывающий, какими данными должен быть подписан файл.
//  если CertificateSign то подписание сертификатом без носителя; если выбран этот параметр,
//  для подписания используется значение поля CertificateData;
//  если GosKeySign то подписание с помощью Госключа; если выбран этот параметр,
//  для подписания используется значение поля GosKeyData.
//  * CertificateData	- Структура, Неопределено -данные для подписания файла с помощью сертификата
//  * GosKeyData		- Структура, Неопределено -данные для подписания файла с помощью Госключа
//
Функция DD_API_DS_DssSignRequestV2(Files, SignDataSource, CertificateData = Неопределено,
	GosKeyData = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Files", Files);
	Результат.Вставить("SignDataSource", SignDataSource);
	Если SignDataSource = "CertificateSign" Тогда
		
		Если ЗначениеЗаполнено(CertificateData) Тогда
			Результат.Вставить("CertificateData", CertificateData);
		Иначе
			ВызватьИсключение "ru = 'Указаны неверные параметры CertificateData при инициализации структуры DssSignRequestV2'";
		КонецЕсли;
		
	ИначеЕсли SignDataSource = "GosKeySign" Тогда
		
		Если ЗначениеЗаполнено(GosKeyData) Тогда
			Результат.Вставить("GosKeyData", GosKeyData);
		Иначе
			ВызватьИсключение "ru = 'Указаны неверные параметры GosKeyData при инициализации структуры DssSignRequestV2'";
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "ru = 'Указаны неверные параметры при инициализации структуры DssSignRequestV2'";
		
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

