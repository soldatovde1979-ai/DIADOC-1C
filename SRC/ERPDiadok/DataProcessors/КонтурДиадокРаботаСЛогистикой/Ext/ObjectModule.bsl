// Возвращает версию подсистемы Контур.Логистика
// 
// Возвращаемое значение:
//  Строка, Неопределено - Версия подсистемы Контур Логистики.
//                         Если подсистема установлена, но нельзя получить версию, то вернется 0.0.0.
//                         Если подсистема не найдена то возвращается Неопределено
//
Функция ВерсияПодсистемыКонтурЛогистика() Экспорт
	
	Результат = Неопределено;
	
	ОбщийМодульКонтурЛогистики = ОбщийМодульКонтурЛогистикиСервер();
	
	Если ОбщийМодульКонтурЛогистики <> Неопределено Тогда
		
		Попытка
			
			Результат = ОбщийМодульКонтурЛогистики.ТекущаяВерсияПодсистемыКонтурЛогистика();
			
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЖурналРегистрации_ЗаписатьОшибку("ТекущаяВерсияПодсистемыКонтурЛогистика", ТекстОшибки);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

