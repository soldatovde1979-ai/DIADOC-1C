Процедура ЖурналРегистрации_ЗаписатьОшибку(Знач ИмяСобытия, Знач Комментарий)
	
	ИдентификаторСобытия = "Диадок.ИнтеграцияСЛогистикой." + ИмяСобытия;
	
	ЗаписьЖурналаРегистрации(
		ИдентификаторСобытия,
		УровеньЖурналаРегистрации.Ошибка,
		Неопределено,
		Неопределено,
		Комментарий
	);
	
КонецПроцедуры
