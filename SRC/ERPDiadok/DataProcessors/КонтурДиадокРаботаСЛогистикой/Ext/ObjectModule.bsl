Функция ОбщийМодульКонтурЛогистикиСервер()
	
	ИмяМодуля = ИмяМодуляИнтеграцииСервер();
	
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		Результат = Неопределено;
	Иначе
		Результат = Вычислить(ИмяМодуля);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

