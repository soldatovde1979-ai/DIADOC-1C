// Возвращает сводную информацию о перевозочных документах для коллекции учетных документов пакета
//
// Параметры:
//  ДокументыУчета	 - Массив	 - Коллекция ссылок на учетные документы пакета
// 
// Возвращаемое значение:
//  Структура - Сводная информация о перевозочных документах
//
Функция СостояниеПеревозочныхДокументов(ДокументыУчета) Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ВидимостьКоманды", Ложь);
	Результат.Вставить("Заголовок");
	Результат.Вставить("ВведеноЭПД");
	Результат.Вставить("Незавершенных");
	Результат.Вставить("Задач");
	Результат.Вставить("Вводов");
	Результат.Вставить("Картинка");
	Результат.Вставить("Подсказка");
	Результат.Вставить("ТекстОшибки");
	
	ОбщийМодульКонтурЛогистики = ОбщийМодульКонтурЛогистикиСервер();
	
	Если ОбщийМодульКонтурЛогистики <> Неопределено Тогда
		
		Попытка
			
			ДанныеЭПД = ОбщийМодульКонтурЛогистики.СостояниеЭПД(ДокументыУчета);
			
		Исключение
			
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЖурналРегистрации_ЗаписатьОшибку("СостояниеЭПД", ТекстОшибки);
			
			Результат.ТекстОшибки = ТекстОшибки;
			
		КонецПопытки;
		
		Если ТипЗнч(ДанныеЭПД) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(Результат, ДанныеЭПД);
			
			Если НЕ ЗначениеЗаполнено(Результат.Заголовок) Тогда
				Результат.ВидимостьКоманды = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

