//  Пакет  - Структура - Формируемыйпакет
//  Документ1С  - ДокументСсылка - Основание пакета
//  Состав  - Строка - ИД документов через запятую
Процедура Автопакет(Пакет, Документ1С, Состав, Индекс = Неопределено)
	мИД = СтрРазделить(Состав, ",", Ложь);
	Если Индекс = Неопределено Тогда
		Для каждого ИД_Документа Из мИД Цикл
			ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Пакет, Документ1С, СокрЛП(ИД_Документа));
		КонецЦикла;
	Иначе
		ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Пакет, Документ1С, СокрЛП(мИД[Индекс]));
	КонецЕсли;
КонецПроцедуры // Автопакет

Функция ДокументОснованиеИзМассиваДокументов(МассивДокументов)
	
	Результат = Неопределено;
	
