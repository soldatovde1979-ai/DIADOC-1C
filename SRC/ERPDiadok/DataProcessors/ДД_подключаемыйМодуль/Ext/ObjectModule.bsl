			ИЛИ ТипЗнч(МассивДокументов[0]) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивДокументов[0], "т1кОснование");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

