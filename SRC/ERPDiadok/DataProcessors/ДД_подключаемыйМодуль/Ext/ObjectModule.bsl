				ЗапросДоработокПечаток.УстановитьПараметр("АгентскоеВознаграждение", УслугиАгентскогоВознаграждения);
				ЗапросДоработокПечаток.УстановитьПараметр("ОбъектыПечати", Документ1С);
			КонецПопытки;
			ДанныеЗапроса = ЗапросДоработокПечаток.ВыполнитьПакет(); 
			ВыборкаСверок = ДанныеЗапроса[ДанныеЗапроса.ВГраница() - 1].Выбрать();
			ПолученыДанныеДоработок = ВыборкаСверок.Следующий();
			Если ПолученыДанныеДоработок Тогда
				Графа12 = т1кУправлениеПечатью.Графа12УПД(ВыборкаСверок);
				ПозДвоеточия = СтрНайти(Графа12, ":");
				Если ПозДвоеточия > 0 Тогда
					Если ЭтоУПД820 или ЭтоУПД970 Тогда // Добавлен ЭтоУПД970 // шх Красавин А.А. 13.03.2025 (00-00012906) Изменение формата счета-фактуры, УПД в соответствии с приказом № ЕД-7-26/970@: e1cib/data/Справочник.Карточка?ref=b933005056bcf87311eeecfe9d671e15
						КлючПараметра = Лев(Графа12, ПозДвоеточия - 1);
						Графа12 = Сред(Графа12, ПозДвоеточия + 1);
						ОсновнойМодуль.ДобавитьИнформационноеПоле(Content.AdditionalInfoId, КлючПараметра, Графа12);
					ИначеЕсли ЭтоУКД820 Тогда
						Content.EventContent.CostChangeInfo = Графа12;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
