Перем ОсновнойМодуль Экспорт;

Функция ОбработатьСобытие(ИмяСобытия, Параметры) Экспорт

	Если ИмяСобытия = "ПолучитьТекстЗапросаДляСпискаПакетовНаОтправкуПоМассивуВидовПакетов" Тогда

		Возврат ПолучитьТекстЗапросаДляСпискаПакетовНаОтправкуПоМассивуВидовПакетов(Параметры);

	ИначеЕсли ИмяСобытия = "ПолучитьТаблицуИспользуемыхПакетов" Тогда

		Возврат ПолучитьТаблицуИспользуемыхПакетов(Параметры);

	ИначеЕсли ИмяСобытия = "ПодготовитьПакет" Тогда

		Возврат ПодготовитьПакет(Параметры);

	ИначеЕсли ИмяСобытия = "ПодготовитьЭлектронныйДокумент" Тогда

		Возврат ПодготовитьЭлектронныйДокумент(Параметры);

	ИначеЕсли ИмяСобытия = "ПолучитьТаблицуИспользуемыхВидовДокументов" Тогда

		Возврат ПолучитьТаблицуИспользуемыхВидовДокументов(Параметры);
	ИначеЕсли ИмяСобытия = "ПодготовитьЭлектронныйДокументПоВнешнейПечатнойФорме" Тогда
		
		// ШХ
		// т1к Гирфанов Р.Э., 2023.07.17 Доработка по обработке Контур Диадок: e1cib/data/Справочник.Карточка?ref=861a005056b60a3c11ee20d6073ba6b3 {
		
		Если ТипЗнч(Параметры.ВнешняяПечатнаяФорма) = Тип("Строка") Тогда
			
			ИмяПечатнойФормы = Параметры.ВнешняяПечатнаяФорма;
			
			ИменаПечатнойФормы = СтрРазделить(ИмяПечатнойФормы,"[]", Ложь);
			
			Если ИменаПечатнойФормы.Количество() <> 3 Тогда
				Параметры.Документ.ИмяФайла = "Неверные параметры печатной формы: " + Параметры.ВнешняяПечатнаяФорма;
				Возврат Истина;
			КонецЕсли;
			
			// ШХ
			// Настроить в пакете документов на отправку по эдо статус запрашивать подпись контрагента : e1cib/data/Справочник.Карточка?ref=8c95005056bcd6f011ee3dc600931b8f
			// Флаг требования подписи
			
			Попытка
				ТекДоговор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Документ.ДокументУчета, "Договор");
			Исключение
				ТекДоговор = Неопределено;
			КонецПопытки;
			ИтоговыйИД = ПолучитьИДСУчетомБазового(Параметры.Документ.ИдентификаторВида);
			НастройкаПодписания =
					т1кДиадокСервер.НастройкаПодписания(
						ИтоговыйИД,
						Параметры.ВнешняяПечатнаяФорма,
						Параметры.Документ.Отправитель.ОрганизацияЭДО,
						Параметры.Документ.Получатель.ОрганизацияЭДО,
						ТекДоговор);
			Если НастройкаПодписания = Истина ИЛИ НастройкаПодписания = Ложь Тогда
				Параметры.Документ.СлужебнаяИнформация.ПараметрыОтправки.ЗапрашиватьОтветнуюПодпись = НастройкаПодписания;
			Иначе
				Параметры.Документ.СлужебнаяИнформация.ПараметрыОтправки.ЗапрашиватьОтветнуюПодпись = НЕ т1кДиадокСервер.ЭтоВидДокументаБезЗапросаПодписиПоУмолчанию(
						Новый Структура("ИдентификаторВида,ТипДокумента,ТипКонтента,Формлизованный,ФункцияДокумента",
							Параметры.Документ.ИдентификаторВида,
							Параметры.Документ.Тип.ТипДокумента,
							Параметры.Документ.Тип.ТипКонтента,
							Параметры.Документ.Тип.Формализованный,
							Параметры.Документ.Тип.ФункцияДокумента));
			КонецЕсли;
			// --
			// Настроить в пакете документов на отправку по эдо статус запрашивать подпись контрагента : e1cib/data/Справочник.Карточка?ref=8c95005056bcd6f011ee3dc600931b8f
		
			ИмяПечатнойФормы = СокрЛП(ИменаПечатнойФормы[0]);
			
			мСсылкиДляОбработки = Новый Массив;
			мСсылкиДляОбработки.Добавить(Параметры.Документ.ДокументУчета);
			Если ТипЗнч(Параметры.Документ.ДокументУчета) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				мСсылкиДляОбработки.Добавить(Параметры.Документ.ДокументУчета.ДокументОснование);
			КонецЕсли;
			
			// Как в форме НастройкаПечатныхФормУправляемая
			#Область ОбщиеКомандыПечати
			
			ОбщиеКомандыПечати = Неопределено;
			Для каждого Документ1ССсылка Из мСсылкиДляОбработки Цикл
				МетаданныеДОК = Документ1ССсылка.Метаданные();
				КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(МетаданныеДОК, Ложь);
				
				Объекты = Новый СписокЗначений;
				Объекты.Добавить(Документ1ССсылка);
				
				КомандыПечати.Колонки.Добавить("Имя");
				КомандыПечати.ЗагрузитьКолонку(КомандыПечати.ВыгрузитьКолонку("Идентификатор"), "Имя");
				КомандыПечати.Колонки.Добавить("Документ1ССсылка");
				КомандыПечати.ЗаполнитьЗначения(Документ1ССсылка, "Документ1ССсылка");
				//РегистрыСведений.НастройкиПечатиОбъектов.т1кИсправитьСоставКомплектаПоКонтекстуСсылок(КомандыПечати, Объекты);
				
				Если ОбщиеКомандыПечати = Неопределено Тогда
					
					ОбщиеКомандыПечати = КомандыПечати.Скопировать();
					
				Иначе
					
					Для каждого КП Из КомандыПечати Цикл
						
						ПараметрыОтбора = Новый Структура;
						ПараметрыОтбора.Вставить("Идентификатор", КП.Идентификатор);
						ПараметрыОтбора.Вставить("МенеджерПечати", КП.МенеджерПечати);
						ПараметрыОтбора.Вставить("Представление", КП.Представление);
						ПараметрыОтбора.Вставить("УникальныйИдентификатор", КП.УникальныйИдентификатор);
						НайденныеСтроки = ОбщиеКомандыПечати.НайтиСтроки(ПараметрыОтбора);
						
						Если НайденныеСтроки.Количество() = 0 Тогда
							
							ЗаполнитьЗначенияСвойств(ОбщиеКомандыПечати.Добавить(), КП);
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
			СтрокиНаУдаление = Новый Массив;
			Для каждого А Из ОбщиеКомандыПечати Цикл
				Если ПустаяСтрока(А.МенеджерПечати)
					ИЛИ А.МенеджерПечати = "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
					
					СтрокиНаУдаление.Добавить(А);
					
				КонецЕсли;
			КонецЦикла;
			Для каждого СтрокаНаУдаление Из СтрокиНаУдаление Цикл
				ОбщиеКомандыПечати.Удалить(СтрокаНаУдаление);
			КонецЦикла;
			
			ОбщиеКомандыПечати.Колонки.Вставить(0,"ПредставлениеВРЕГ");
			ОбщиеКомандыПечати.Колонки.Вставить(1,"ИдентификаторВРЕГ");
			ОбщиеКомандыПечати.Колонки.Вставить(2,"УникальныйИдентификаторВРЕГ");
			Для каждого Строка_ТЗ Из ОбщиеКомандыПечати Цикл
				Строка_ТЗ.ПредставлениеВРЕГ = ВРег(Строка_ТЗ.Представление);
				Строка_ТЗ.ИдентификаторВРЕГ = ВРег(Строка_ТЗ.Идентификатор);
				Строка_ТЗ.УникальныйИдентификаторВРЕГ= ВРег(Строка_ТЗ.УникальныйИдентификатор);
			КонецЦикла;
			
			#КонецОбласти
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ПредставлениеВРЕГ", ВРег(СокрЛП(ИменаПечатнойФормы[0])));
			ПараметрыОтбора.Вставить("ИдентификаторВРЕГ", ВРег(ИменаПечатнойФормы[1]));
			ПараметрыОтбора.Вставить("УникальныйИдентификаторВРЕГ", ВРег(ИменаПечатнойФормы[2]));
			СтрокаКомандыПечати = ОбщиеКомандыПечати.НайтиСтроки(ПараметрыОтбора);
			
			Если СтрокаКомандыПечати.Количество() = 0 Тогда 
				Параметры.Документ.ИмяФайла = "Нет данных для печати: " + ИмяПечатнойФормы;
				Возврат Истина;
			КонецЕсли; 
			
			КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(СтрокаКомандыПечати[0].Идентификатор);
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("ПечатьВВалюте", Ложь);
			Если ВРег(ИменаПечатнойФормы[1])= "ТОРГ12БЕЗУСЛУГ" Тогда
				ПараметрыПечати.Вставить("ВыводитьУслуги", Ложь);
			// + шх Калашников АН, 12.01.2024 - Не формируется печатная форма ТОРГ12 в пакете в ДИАДОК: e1cib/data/Справочник.Карточка?ref=b923005056bcf87311eeb07bb93d8bb8
			Иначе
				ПараметрыПечати.Вставить("ВыводитьУслуги", Истина);
			// - шх Калашников АН, 12.01.2024 - Не формируется печатная форма ТОРГ12 в пакете в ДИАДОК: e1cib/data/Справочник.Карточка?ref=b923005056bcf87311eeb07bb93d8bb8
			КонецЕсли;
			ОбъектыПечати = Новый СписокЗначений;
			ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
			
			МассивДокументов = Новый Массив;
			МассивДокументов.Добавить(СтрокаКомандыПечати[0].Документ1ССсылка);
			МенеждерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СтрокаКомандыПечати[0].МенеджерПечати); 
			МенеждерПечати.Печать(МассивДокументов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
			// {т1к Персианов М.С. 10.08.2023 14:06:01
			// Некорректная форма УПД1 при выгрузке в ЭДО: e1cib/data/Справочник.Карточка?ref=8c8f005056bcd6f011ee35e3cfac325d
			// Выполнение обработчиков подсистемы Печать
			ИнтеграцияПодсистемБСП.ПриПечати(МассивДокументов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
			УправлениеПечатьюПереопределяемый.ПриПечати(МассивДокументов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
			// } Персианов - 10.08.2023 14:06:01

			ТабличныйДокумент = КоллекцияПечатныхФорм[0].ТабличныйДокумент;
			
			Если НЕ ТипЗнч(ТабличныйДокумент) = Тип("ТабличныйДокумент")
				ИЛИ ТабличныйДокумент.ВысотаТаблицы = 0
				ИЛИ ТабличныйДокумент.Области.Количество()= 0 Тогда
				
				Параметры.Документ.ИмяФайла = "Нет данных для печати: " + ИмяПечатнойФормы;
				Возврат Истина;
				
			КонецЕсли;
			
			// Добавил Excel
			ИмяВремФайла = ПолучитьИмяВременногоФайла();
			Параметры.Документ.ДокументУчета = СтрокаКомандыПечати[0].Документ1ССсылка;
			Если НЕ СтрНайти(ВРег(СокрЛП(ИменаПечатнойФормы[0])), "РЕЕСТР ДЛЯ ЭДО") > 0 Тогда 
				ТабличныйДокумент.Записать(ИмяВремФайла, ТипФайлаТабличногоДокумента.PDF);
				ИмяФайла = ИмяПечатнойФормы + ".pdf";
			Иначе
				// т1к Островский Р. 2023.08.13. Некорректная форма УПД1 при выгрузке в ЭДО: e1cib/data/Справочник.Карточка?ref=8c8f005056bcd6f011ee35e3cfac325d{
				ДокументОснованиеСверка = ДокументОснованиеИзМассиваДокументов(МассивДокументов);
				Если ТипЗнч(ДокументОснованиеСверка) = Тип("ДокументСсылка.т1кСверкаОказанныхУслуг") 
						И ЗначениеЗаполнено(ДокументОснованиеСверка)Тогда
					ИмяФайлаПоНомеруСверки = ИмяФайлаПоНомеруСверки(ДокументОснованиеСверка);
					ИмяФайла = ?(ПустаяСтрока(ИмяФайлаПоНомеруСверки), ИмяПечатнойФормы, ИмяФайлаПоНомеруСверки) + ".xlsx";
				Иначе
					ИмяФайла = ИмяПечатнойФормы + ".xlsx";
				КонецЕсли;
				
				Если ПараметрыПечати.Свойство("ДанныеДляПакетаОтображаемыхДокументов") Тогда
					СтруктураТабличногоДокумента = ПараметрыПечати.ДанныеДляПакетаОтображаемыхДокументов;
					ФайлExcel = Новый ПакетОтображаемыхДокументов;
					Для Каждого КиЗ Из СтруктураТабличногоДокумента Цикл
						Если КиЗ.Ключ = "ДокументРезультат" Тогда
							Продолжить;
						КонецЕсли;	
						ЛистФайла = ФайлExcel.Состав.Добавить();
						ЛистФайла.Данные = ПоместитьВоВременноеХранилище(КиЗ.Значение);
						ЛистФайла.Наименование = Киз.Ключ;
					КонецЦикла;	
					ФайлExcel.Записать(ИмяВремФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
					
				Иначе
					ТабличныйДокумент.Записать(ИмяВремФайла, ТипФайлаТабличногоДокумента.XLSX);
				КонецЕсли;
				// }т1к Островский Р. 2023.08.13. Некорректная форма УПД1 при выгрузке в ЭДО: e1cib/data/Справочник.Карточка?ref=8c8f005056bcd6f011ee35e3cfac325d			
			КонецЕсли;			
			
			Документ				= Параметры.Документ;
			//РеквизитыДокумента		= Документ.Реквизиты;
			//ВнешняяПечатнаяФорма	= Параметры.ВнешняяПечатнаяФорма;
			ИдентификаторКоманды	= Параметры.ИдентификаторКоманды;
			
			Документ.ИмяФайла = ИмяФайла;
			
			Документ.Метаданные.FileName		= ИмяФайла;
			Документ.Метаданные.DocumentDate	= СтрокаКомандыПечати[0].Документ1ССсылка.Дата;
			Документ.Метаданные.DocumentNumber	= СтрокаКомандыПечати[0].Документ1ССсылка.Номер;
			
			ХранилищеКонтента = Документ.Документооборот.ХранилищеКонтента;
			ХранилищеКонтента.Данные = Новый ДвоичныеДанные(ИмяВремФайла);
			ХранилищеКонтента.ИмяФайла = ИмяФайла;
			
			//СлужебнаяИнформация = Документ.СлужебнаяИнформация;
			//СлужебнаяИнформация.ПараметрыОтправки.ЗапрашиватьОтветнуюПодпись = Истина;
			//
			УдалитьФайлы(ИмяВремФайла);
			
			Возврат Истина;
			
		КонецЕсли;
		
		// }т1к Гирфанов Р.Э., 2023.07.17 Доработка по обработке Контур Диадок: e1cib/data/Справочник.Карточка?ref=861a005056b60a3c11ee20d6073ba6b3
		// - ШХ
		
	ИначеЕсли ИмяСобытия = "ЗаполнитьРеквизитыДокумента" Тогда
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ПослеПодготовкиПакета" Тогда
		Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда
		КонецЕсли; 
		
	// + ШХ
	// т1к О.Н.Кошелев, 2023-11-03{ Автоматизация ЭДО: e1cib/data/Справочник.Карточка?ref=b90f005056bc8d5011ee78923fc51ecb 
	ИначеЕсли ИмяСобытия = "ВыполнитьРегламентныеДействия" Тогда
    	//ВыполнитьРегламентныеДействия(Параметры);
		Возврат Неопределено; // Выполняем стандартные действия "обновления ленты сообщений"
		
	ИначеЕсли ИмяСобытия = "ВыполнитьФормированиеДокументов" Тогда
    	ВыполнитьСозданиеДокументов(Параметры);
		Возврат Истина; 
		
	ИначеЕсли ИмяСобытия = "СопоставитьНоменклатуруПоставщика" Тогда
		
		Возврат СопоставитьНоменклатуруПоставщика(Параметры);
	
	// }т1к О.Н.Кошелев, 2023-11-03
	// - ШХ
	
	КонецЕсли;
	
КонецФункции

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ПОДКЛЮЧАЕМОГО_МОДУЛЯ
	
Функция ПолучитьТекстЗапросаДляСпискаПакетовНаОтправкуПоМассивуВидовПакетов(Параметры)
	
	// Текст запроса построения списка пакетов на отправку (УТ 11)
	Возврат ТекстЗапросаПостроенияСпискаПакетовНаОтправку(Параметры);

КонецФункции

Функция ПолучитьТаблицуИспользуемыхПакетов(Параметры)

	// Удаление типовых пакетов и добавление нового пакета
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Результат_ИМ") Тогда

		ТЗ = Параметры.Результат_ИМ;
		
//{т1к Персианов М.С. 02.09.2023 15:55:27
//Карточка: e1cib/list/Справочник.Карточка
