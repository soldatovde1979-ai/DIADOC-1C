Процедура Удалить_УдалитьЛишниеПакеты(ТЗ)
	
	ИндексСтроки = ТЗ.Количество() - 1;
	
	НужныеID = Новый Массив;
	НужныеID.Добавить("ID_УПД");
	НужныеID.Добавить("ID_ОсновнойПакет");
	
	НужныеID.Добавить("ID_УКД");
	НужныеID.Добавить("ID_КСФ");
	НужныеID.Добавить("ID_ИУПД");
	НужныеID.Добавить("ID_ИСФ");
	
	НужныеID.Добавить("ID_Счет");
	НужныеID.Добавить("ID_АктСверки");

//{т1к Персианов М.С. 02.09.2023 15:55:27
//Карточка: e1cib/list/Справочник.Карточка
//Исправительные нужны. И УПД тоже.
	//НужныеID.Добавить("ID_УПД_раздельно");
	//НужныеID.Добавить("ID_УКД_раздельно");
	//НужныеID.Добавить("ID_ИУПД_раздельно");
	//НужныеID.Добавить("ID_ИУКД_раздельно");
	//НужныеID.Добавить("ID_ИКСФ");
	//НужныеID.Добавить("ID_ИСФ");
	//НужныеID.Добавить("ID_ИУКД");
	//НужныеID.Добавить("ID_УПД_БезНДС");
	//НужныеID.Добавить("ID_ИУПД_БезНДС");
	//НужныеID.Добавить("ID_УКД_БезНДС");
	
	// Получается, что не нужны только  ID_УПД_НаАванс, ID_СчетФормализованный, ID_ИУПД_НаАванс, ID_ИСФ_НаАванс и ID_ТОРГ12_Акт_БезНДС.
	//И плюс добавляемые в обновлениях будут удаляться. Поэтому убираю эту процедуру
//} Персианов - 02.09.2023 15:55:27",
//Карточка: e1cib/list/Справочник.Карточка
	Пока ИндексСтроки >= 0 Цикл
		
		СтрокаТЗ = ТЗ.Получить(ИндексСтроки);
		
		Если НужныеID.Найти(СтрокаТЗ.ID) = Неопределено Тогда
			ТЗ.Удалить(ИндексСтроки);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки - 1;
		
	КонецЦикла;
	
