Процедура ВыполнитьСозданиеДокументов(Параметры)
	
	АвтоматическоеСозданиеСвязывание = РегистрыСведений.т1кЗначенияПроизвольныхПараметров.ПолучитьЗначенияПараметров(ПланыВидовХарактеристик.т1кПроизвольныеПараметры.ДиадокАвтоматическоеСозданиеСвязываниеДокументов, Ложь);
	Если Не АвтоматическоеСозданиеСвязывание.ДиадокАвтоматическоеСозданиеСвязываниеДокументов Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыДляСоздания = ОбщегоНазначенияКлиентСервер.МассивЗначений( Метаданные.Документы.ПриобретениеТоваровУслуг.имя);
	метаДокументыДляСоздания = ОбщегоНазначенияКлиентСервер.МассивЗначений( Метаданные.Документы.ПриобретениеТоваровУслуг);

	
	Ядро = Ядро();
	ВидыДокументов = Ядро.ПодключаемыйМодуль_ОбработатьСобытие("ПолучитьТаблицуИспользуемыхВидовДокументов", Новый Структура("")).ВыгрузитьКолонку("ТипДокументаAPI");
	ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВидыДокументов);
	ВидыДокументов = ОбщегоНазначенияКлиентСервер.СократитьМассив(ВидыДокументов, ОбщегоНазначенияКлиентСервер.МассивЗначений("Nonformalized"));
	
    Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	т1кДиадокДоговора.Контрагент КАК Контрагент,
	               |	т1кДиадокДоговора.Организация КАК Организация,
	               |	т1кДиадокДоговора.Договор КАК Договор,
	               |	т1кДиадокДоговора.Договор.Номер КАК Номер,
	               |	т1кДиадокДоговора.Договор.Дата КАК Дата,
	               |	т1кДиадокДоговора.Склад КАК Склад,
	               |	т1кДиадокДоговора.Договор.Подразделение КАК ДоговорПодразделение,
	               |	т1кДиадокДоговора.ПериодАнализа КАК ПериодАнализа,
	               |	т1кДиадокДоговора.СоздаватьАвтоматически КАК СоздаватьАвтоматически,
	               |	т1кДиадокДоговора.НомерДоговора КАК НомерДоговораДиадок
	               |ПОМЕСТИТЬ втДоговора
	               |ИЗ
	               |	РегистрСведений.т1кДиадокДоговора КАК т1кДиадокДоговора
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДоговора.Контрагент КАК Контрагент,
	               |	втДоговора.Организация КАК Организация,
	               |	МАКСИМУМ(втДоговора.ПериодАнализа) КАК ПериодАнализа
	               |ПОМЕСТИТЬ втПериодАнализа
	               |ИЗ
	               |	втДоговора КАК втДоговора
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втДоговора.Контрагент,
	               |	втДоговора.Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДоговора.Контрагент КАК Контрагент,
	               |	втДоговора.Организация КАК Организация,
	               |	втДоговора.Договор КАК Договор,
	               |	втДоговора.Номер КАК Номер,
	               |	втДоговора.Дата КАК Дата,
	               |	втДоговора.Склад КАК Склад,
	               |	втДоговора.НомерДоговораДиадок КАК НомерДоговораДиадок,
	               |	втДоговора.СоздаватьАвтоматически КАК СоздаватьАвтоматически,
	               |	втДоговора.ПериодАнализа КАК ПериодАнализа
	               |ИЗ
	               |	втДоговора КАК втДоговора";
	РезультатЗапроса = Запрос.Выполнить();
	Договора = РезультатЗапроса.Выгрузить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Диадок_Документы.Ссылка КАК Ссылка,
				   |	Диадок_Документы.ДатаЗагрузки КАК ДатаЗагрузки,
	               |	Диадок_Документы.Организация КАК Организация,
	               |	Диадок_Документы.Контрагент КАК Контрагент
	               |ИЗ
	               |	Справочник.Диадок_Документы КАК Диадок_Документы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПериодАнализа КАК втПериодАнализа
	               |		ПО Диадок_Документы.Контрагент = втПериодАнализа.Контрагент
	               |			И Диадок_Документы.Организация = втПериодАнализа.Организация
	               |ГДЕ
	               |	НЕ Диадок_Документы.ПометкаУдаления
	               |	И Диадок_Документы.Направление = &Направление
	               |	И Диадок_Документы.Документ = &Документ
	               |	И Диадок_Документы.ТипДокумента В(&ВидыДокументов)
	               |	И Диадок_Документы.ДатаЗагрузки >= НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -втПериодАнализа.ПериодАнализа), ДЕНЬ)
				   |";
				   
	Запрос.УстановитьПараметр("Направление", "Входящее");
	Запрос.УстановитьПараметр("Документ", Неопределено);
	Запрос.УстановитьПараметр("ВидыДокументов", ВидыДокументов);
	Запрос.УстановитьПараметр("ТипДокумента", Неопределено);
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(); 
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	Сутки = 3600*24;
		
	Пока Выборка.Следующий() Цикл
		
		Документ = Выборка.Ссылка;
		ДокументДД = Ядро.Документ_ДокументИзДанныхСтрокиСписка(Новый Структура("ДокументЭДО", Выборка.Ссылка));
		
		Если НЕ ПроверитьПоТипамДокуметовДиадок(ДокументДД,ДокументыДляСоздания)  ТОгда
			Продолжить;
		КонецЕсли;
		
		ДоговорРеквизиты = РеквизитыДоговораДиадок(ДокументДД);
		Если ДоговорРеквизиты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыНастройкиПоДоговор = ПолучитьПараметрыНастройкиПоДоговору(Договора, ДоговорРеквизиты, Выборка.Организация, Выборка.Контрагент, Выборка.Ссылка);
		Если ПараметрыНастройкиПоДоговор = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыНастройкиПоДоговор.СоздаватьАвтоматически Тогда 
			
			Если Выборка.ДатаЗагрузки < ТекущаяДата - Сутки * ПараметрыНастройкиПоДоговор.ПериодАнализа Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыПМ = Новый Структура;
			ПараметрыПМ.Вставить("Документ", ДокументДД);
			ПараметрыПМ.Вставить("ИдентификаторОперации", Неопределено);
			ПараметрыПМ.Вставить("ДополнительныеПараметры", Новый Структура("т1кПараметры", ПараметрыНастройкиПоДоговор));
			ПараметрыПМ.Вставить("СоздаватьСчетаФактуры", Ложь);
			РезультатПМ = Ядро.ПодключаемыйМодуль_ОбработатьСобытие("ПолучитьЗаполненныйОбъектДокумента1С", ПараметрыПМ); 
			Если РезультатПМ.ОсновнойОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли; 				
			Если метаДокументыДляСоздания.Найти(РезультатПМ.ОсновнойОбъект.Метаданные()) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РезультатПМ.ОсновнойОбъект.ДополнительныеСвойства, "т1кЕстьОшибкиЗаполнения", Ложь);
			
			Если ЕстьОшибки Тогда
				Успех = Истина;
				Попытка
					РезультатПМ.ОсновнойОбъект.Записать(РежимЗаписиДокумента.Запись); 
				Исключение
					Успех = Ложь;
				КонецПопытки;
				
				Если Успех Тогда
					ДиадокДокумент = Выборка.Ссылка.ПолучитьОбъект();			
					ДиадокДокумент.Документ = РезультатПМ.ОсновнойОбъект.ссылка;
					ДиадокДокумент.Записать();
				КонецЕсли;
				
				Продолжить;
				
			КонецЕсли;
			
			ДокументДД.ДокументУчета = Неопределено;
			
			РезультатСоздания = РезультатСозданияДокументаИБ(ДокументДД, ПараметрыПМ.ДополнительныеПараметры);
			
			Если РезультатСоздания.Ошибка Тогда
				Продолжить;		
			КонецЕсли;
			
			ДокументУчета = РезультатСоздания.Ссылка;
			
		Иначе
			ДокументУчета = РезультатСопоставленияИБ(ДокументДД);
		КонецЕсли;
							
		Если ЗначениеЗаполнено(ДокументУчета) Тогда 
			СтартПроцессовСогласованияУХ(ДокументУчета);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РезультатСопоставленияИБ(ДокументДД)
	
	Ядро = ОсновнойМодуль.Ядро;
	ДокументУчета = Ядро.Документы_СопоставитьДокумент(ДокументДД);
	
	Возврат ДокументУчета;
	
КонецФункции 

Функция РезультатСозданияДокументаИБ(ДокументДД, ДополнительныеПараметры)
	
	Ядро = Ядро(); 
			
	Результат = Новый Структура("Ошибка,Ссылка", Ложь);
	
	ДокументыДД = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументДД);
	Попытка
		Ядро.Документы_СоздатьДокументы(ДокументыДД, Неопределено, ДополнительныеПараметры);
	Исключение
	КонецПопытки;
	Результат.Ошибка = Не ЗначениеЗаполнено(ДокументыДД[0].ДокументУчета);
	Результат.Ссылка = ДокументыДД[0].ДокументУчета;
	
	Возврат Результат;
	
КонецФункции

Процедура СтартПроцессовСогласованияУХ(Ссылка)

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		
		Проведен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен");
		
		Если Не Проведен Тогда
			Проведен = ПроведениеДокумента(Ссылка);
		КонецЕсли;
		
		Если Проведен Тогда
		
			СостояниеЗаявки = МодульУправленияПроцессамиУХ.ПолучитьОбщийСтатусДляСогласования(Ссылка);
			Если (НЕ СостояниеЗаявки = "Утвержден") И (НЕ СостояниеЗаявки = "НаУтверждении") Тогда
				ИмяСобытия = МодульУправленияПроцессамиУХ.ПринятьКОбработке(, Ссылка);
				Если ИмяСобытия = "ОшибкаИнициализацииМаршрута" Тогда
					Ядро = Ядро();
					ИнформацияОбОшибке = "Ошибка инициализации маршрута согласования";
					//Ядро.Документы_ОшибкаПриСоздании(Ссылка, ИнформацияОбОшибке);
					Ядро.Ошибка_Обработать("Регламентное создание документов Диадок", ИнформацияОбОшибке,, "Ошибка при старте процесса согласования документа " + Ссылка);	
				КонецЕсли;
			Иначе
				// Согласование уже запущено.
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры 

Функция РеквизитыДоговораДиадок(ДокументДД)
	
	Ядро = Ядро();
	ДанныеДокументаЯдро = Ядро.ХранениеДанных_ДанныеХранилища(ДокументДД.Идентификаторы, "ХранилищеКонтента");
	ДанныеДокументаДиадок = Ядро.ГенерацияXML_XML_В_ОбъектXDTO(ДанныеДокументаЯдро.Данные);
	
	////СвПродПер.СвПер.ОснПер.ДатаОсн
	Если СвойствоXDTO(ДанныеДокументаДиадок,"Документ") и СвойствоXDTO(ДанныеДокументаДиадок.Документ,"СвПродПер") и СвойствоXDTO(ДанныеДокументаДиадок.Документ.СвПродПер,"СвПер") и СвойствоXDTO(ДанныеДокументаДиадок.Документ.СвПродПер.СвПер, "ОснПер") Тогда
		
		ДанныеДоговора = ДанныеДокументаДиадок.Документ.СвПродПер.СвПер.ОснПер; 
		Данные = Новый Структура("ДатаОсн, НомОсн, НаимОсн");
		ЗаполнитьЗначенияСвойств(Данные, ДанныеДоговора);
		Результат = Новый Структура("Дата,Номер,Наименование" , Данные.ДатаОсн, Данные.НомОсн, Данные.НаимОсн);
		Если ЗначениеЗаполнено(Результат.Дата) ТОгда
			Результат.Дата = ОбщегоНазначенияКлиентСервер.СтрокаВДату(Результат.Дата);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПараметрыНастройкиПоДоговору(Договора, ДоговорРеквизиты, Организация, Контрагент, ДокументДиадок)
	
	СтруктураПоиска = Новый Структура("Организация,Контрагент,НомерДоговораДиадок,Дата", Организация, Контрагент, СокрЛП(ДоговорРеквизиты.Номер), ДоговорРеквизиты.Дата);
	НайденныеДоговора = Договора.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеДоговора.Количество() = 1 Тогда
		Результат = Новый Структура("т1кЭтоРегламентноеСоздание, Договор, Склад, СоздаватьАвтоматически, ПериодАнализа", Истина);
		ЗаполнитьЗначенияСвойств(Результат, НайденныеДоговора[0]);
		Возврат Результат;
	ИначеЕсли НайденныеДоговора.Количество() > 1 Тогда
		ТекстСообщения = СтрШаблон("По документу %1 неоднозначно заведены настройки договора", ДокументДиадок);
		Ядро().Ошибка_Обработать("Регламентное создание документов Диадок", ТекстСообщения,, "Ошибка при определении настройки по документу" + ДокументДиадок);
	КонецЕсли;
	
КонецФункции 

Функция СвойствоXDTO(ДанныеДокументаДиадок,Имя)
	
	Свойство = Новый Структура(Имя);
	ЗаполнитьЗначенияСвойств(Свойство, ДанныеДокументаДиадок);
	Возврат Свойство[Имя] <> Неопределено
КонецФункции

Функция ПроведениеДокумента(Ссылка)
	
	ДокОбъект = Ссылка.ПолучитьОбъект();
	
	Если Не ДокОбъект.ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ДокОбъект.Заблокировать();
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ИнформацияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Ядро = Ядро();
		Ядро.Ошибка_Обработать("Регламентное создание документов Диадок", ИнформацияОбОшибке,, "Ошибка при проведении документа " + Ссылка);
		//Ядро.Документы_ОшибкаПриСоздании(ДокОбъект, ИнформацияОбОшибке);	
	КонецПопытки;
	
	ДокОбъект.Разблокировать();
	Возврат ДокОбъект.Проведен;
	
КонецФункции 

Функция ПроверитьПоТипамДокуметовДиадок(ДокументДД, ДокументыДляСоздания)

	ПродолжитьАнализ = Ложь;
	Ядро = Ядро();
	СписокТиповДокумента = Ядро.ПодключаемыйМодуль_ОбработатьСобытие("СписокТиповДокументовДляСоздания", Новый Структура("Документ",ДокументДД));
	Для Каждого Док из ДокументыДляСоздания Цикл
		Если СписокТиповДокумента.НайтиПозначению(Док) <> Неопределено Тогда
			ПродолжитьАнализ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПродолжитьАнализ;
	
КонецФункции

Функция Ядро()
	Возврат ОсновнойМодуль.Ядро;
КонецФункции

