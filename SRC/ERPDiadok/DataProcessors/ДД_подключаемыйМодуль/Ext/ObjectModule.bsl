Функция ПечатьДобавленаВПакетДокументов(Договор)
	Результат = Ложь;
	ТипОбъекта = "Документ.РеализацияТоваровУслуг";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПечатиОбъектов.Настройки КАК Настройки
		|ИЗ
		|	РегистрСведений.НастройкиПечатиОбъектов КАК НастройкиПечатиОбъектов
		|ГДЕ
		|	НастройкиПечатиОбъектов.ТипОбъекта = &ТипОбъекта
		|	И НастройкиПечатиОбъектов.Организация = &Организация
		|	И НастройкиПечатиОбъектов.Партнер = &Партнер
		|	И НастройкиПечатиОбъектов.т1кДоговор = &т1кДоговор";
	
	Запрос.УстановитьПараметр("Организация", Договор.Организация);
	Запрос.УстановитьПараметр("Партнер", Договор.Партнер);
	Запрос.УстановитьПараметр("т1кДоговор", Договор);
	Запрос.УстановитьПараметр("ТипОбъекта", ТипОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Результат = Выборка.Следующий();
	
	Если Результат Тогда
		ПечатныеФормы = Выборка.Настройки.Получить();
		
		Отбор = Новый Структура;
		Отбор.Вставить("Имя", "ВнешняяПечатнаяФорма.т1кПечатьСверкиДиадок");
		Отбор.Вставить("Печатать", Истина);
		
		НайденныеСтроки = ПечатныеФормы.НайтиСтроки(Отбор);
		Результат = НайденныеСтроки.Количество() <> 0;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ПодготовитьОтчетАгента(Параметры)
	
	Результат = Параметры.Результат;
	
	Документ1С					= Результат.Документ1С;
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла();
		
	ПараметрыПечати = Новый Структура("ДополнитьКомплектВнешнимиПечатнымиФормами");
	ПараметрыПечати.ДополнитьКомплектВнешнимиПечатнымиФормами = Ложь;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Документ1С);
	
	ОбъектыПечати = Новый СписокЗначений;
	
	ПараметрыВывода = Новый Структура("ДоступнаПечатьПоКомплектно, ЗаголовокФормы, КодЯзыка, ПараметрыОтправки");
	ПараметрыВывода.ДоступнаПечатьПоКомплектно 	= Ложь;
	ПараметрыВывода.ЗаголовокФормы 				= "";
	ПараметрыВывода.КодЯзыка					= "ru";
	ПараметрыВывода.ПараметрыОтправки 			= Новый Структура("Получатель, Текст, Тема");
	
	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("ОтчетКомиссионера");
	
	Обработки.ПечатьОтчетовПоКомиссии.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
	ТабличныйДокумент = КоллекцияПечатныхФорм[0].ТабличныйДокумент;
					
	ТабличныйДокумент.Записать(ИмяВремФайла,ТипФайлаТабличногоДокумента.PDF);
		
	Результат.Content.Date		= Документ1С.Дата;
	Результат.Content.Number	= Документ1С.Номер;
	Результат.ИмяФайла			= "Отчет Агента №" + Документ1С.Номер + " от " + Формат(Документ1С.Дата, "ДЛФ=Д") + ".pdf";
    
	Результат.ДвоичныеДанные	= Новый ДвоичныеДанные(ИмяВремФайла);
		
	УдалитьФайлы(ИмяВремФайла);
		
КонецПроцедуры	

Процедура ПодготовитьСверкаОказанныхУслуг(Параметры)
	
	Результат = Параметры.Результат;
	
	Документ1С					= Результат.Документ1С;
	
	АдресДвоичныеДанные = Документы.т1кСверкаОказанныхУслуг.СформироватьXML(Документ1С);
	
	Результат.Content.Date		= Документ1С.Дата;
	Результат.Content.Number	= Документ1С.Номер;
	Результат.ИмяФайла			= "Сверка №" + Документ1С.Номер + " от " + Формат(Документ1С.Дата, "ДЛФ=Д") + ".xml";
    
	Результат.ДвоичныеДанные	= ПолучитьИзВременногоХранилища(АдресДвоичныеДанные);
		
	УдалитьФайлы(АдресДвоичныеДанные);
		
КонецПроцедуры

// Возвращает ИД документа для получения настроек с учётом базового документа
// Параметры:
//  ИсходныйИД  - Строка - Исходный ИД документа
// Возвращаемое значение:
//   Строка   - ИД с учётом базового
Функция ПолучитьИДСУчетомБазового(ИсходныйИД)
	ВидДокумента = ОсновнойМодуль.Ядро.Списки_ОписаниеВидаДокумента(ИсходныйИД);
	ЕстьБазовыйВидДокумента = ЗначениеЗаполнено(ВидДокумента.БазовыйВидДокумента);
	Если ЕстьБазовыйВидДокумента Тогда
        Результат = ВидДокумента.БазовыйВидДокумента;
    Иначе
        Результат = ИсходныйИД;
    КонецЕсли;
	Возврат Результат
КонецФункции // ПолучитьИДСУчетомБазового

Функция  т1кТребуетсяДобавитьКОтправкеСверку(ДокументОснование)
	ТипОснования = ТипЗнч(ДокументОснование);
	Если Не ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			и Не ТипОснования = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснование.т1кОснование) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПечатьДобавленаВПакетДокументов(ДокументОснование.Договор) Тогда 
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

