Функция ПодготовитьПакет(Параметры)

	// Формирование своего пакета
	// {т1к Персианов М.С. 11.08.2023 11:43:40
	// Некорректная форма УПД1 при выгрузке в ЭДО: e1cib/data/Справочник.Карточка?ref=8c8f005056bcd6f011ee35e3cfac325d
	// Добавляю УПД 1 и 2, исправление неоптимальностей и непредусмотренных типов
	
	Если ТипЗнч(Параметры) = Тип("Структура") И (Параметры.Свойство("Результат_ИМ") ИЛИ (Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_раздельно")) Тогда
		
		Если Параметры.ВидПакетаРазвернутый.ID = "ID_ПакетДляАгента" Тогда
			#Область ПАКЕТ
				Документ1С = Параметры.СтрокаСписка.Документ;
				// ???Надо проверять тип или в этом пакете только сф???
				Д_О = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ1С, "ДокументОснование");
				
				ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Параметры.Пакет, Документ1С, "ID_СчетФактура");
				
				ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Параметры.Пакет, Д_О, "ID_ОтчётАгента");
			#КонецОбласти
		ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = "ID_УПД_1"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_УПД_2"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_раздельно"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_1"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_2" Тогда
			#Область УПД12
				Документ1С = Параметры.СтрокаСписка.Документ;
				// а здесь вроде д.б. только сф
				Если Параметры.ВидПакетаРазвернутый.ID = "ID_УПД_1"
						ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_раздельно"
						ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_1" Тогда
					Автопакет(Параметры.Пакет, Документ1С, Параметры.ВидПакетаРазвернутый.СоставПакета, 0);
				КонецЕсли;
				// В типовом было так, т1 сделано иначе, почему - не знаю. Вернул вариант типовой, но без условия
				// ДобавлятьВПакетНакладныеПоДокументу(Документ1С), т.к. ни в т1, ни в типовом ИУПД этого условия нет
				// Д_О = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ1С, "ДокументОснование");
				// ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Параметры.Пакет, Д_О, "ID_УПД_ДОП");
				// КонецЕсли;
				Если Параметры.ВидПакетаРазвернутый.ID = "ID_УПД_2"
						ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_раздельно"
						ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_2" Тогда
					Индекс = ?(Параметры.ВидПакетаРазвернутый.ID = "ID_ИУПД_раздельно", 1, Неопределено);
					ДокументыОснования = ОсновнойМодуль.Общее_ВыборкаДанныхОбъекта(Документ1С, "ДокументыОснования", "ДокументОснование");
					Пока ДокументыОснования.Следующий() Цикл
						Автопакет(Параметры.Пакет, ДокументыОснования.ДокументОснование, Параметры.ВидПакетаРазвернутый.СоставПакета, Индекс);
					КонецЦикла;
				КонецЕсли;
			#КонецОбласти
		ИначеЕсли Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_1"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_2"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_раздельно"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_1"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_2"
				ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_раздельно" Тогда
			#Область УКД12
				// Док = только СФ
				Документ1С = Параметры.СтрокаСписка.Документ;
				// В эти пакеты добавляет типовой - совсем типовой
				// ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_раздельно"
				// ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_раздельно" 
				Если Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_1"
						Или Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_1" Тогда
					Автопакет(Параметры.Пакет, Документ1С, Параметры.ВидПакетаРазвернутый.СоставПакета);
				КонецЕсли;
				// В типовом было так, т1 сделано иначе, почему - не знаю. Вернул вариант типовой, но без условия
				// ДобавлятьВПакетНакладныеПоДокументу(Документ1С), т.к. ни в т1, ни в типовом ИУПД этого условия нет
				// Д_О = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ1С, "ДокументОснование");
				// ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Параметры.Пакет, Д_О, "ID_УПД_ДОП");
				// КонецЕсли;
				
				// В эти добавляет типовой - с помощью изменения пакета
				// ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_раздельно"
				// ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_раздельно"
				Если Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_2"
						ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_ИУКД_2" Тогда
					ДокументыОснования = ОсновнойМодуль.Общее_ВыборкаДанныхОбъекта(Документ1С, "ДокументыОснования", "ДокументОснование");
					ИД_Дока = ?(Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_2"
							ИЛИ Параметры.ВидПакетаРазвернутый.ID = "ID_УКД_раздельно", "ID_УКД_ДИС", "ID_ИУКД_ДИС");
					Пока ДокументыОснования.Следующий() Цикл
						ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Параметры.Пакет, ДокументыОснования.ДокументОснование, ИД_Дока);
					КонецЦикла;
				КонецЕсли;
			#КонецОбласти
		ИначеЕсли ТипЗнч(Параметры.СтрокаСписка.Документ) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			#Область СФ
				// Сделано так, поскольку стандартный печатный механизм умеет готовить только PDF
				Документ1С = Параметры.СтрокаСписка.Документ;
				Д_О = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ1С, "ДокументОснование");
				т1кТребуетсяДобавитьСверку = т1кТребуетсяДобавитьКОтправкеСверку(Д_О);
				ТипДО = ТипЗнч(Д_О);
				Д_О = ?(ТипДО = Тип("ДокументСсылка.РеализацияТоваровУслуг") ИЛИ ТипДО = Тип("ДокументСсылка.КорректировкаРеализации"),
						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Д_О, "т1кОснование"), Документы.т1кСверкаОказанныхУслуг.ПустаяСсылка());
				
				Если т1кТребуетсяДобавитьСверку Тогда
					ОсновнойМодуль.ЭДО_ДокументМенеджер_ПодготовитьИДобавитьДокументВПакет(Параметры.Пакет, Д_О, "ID_т1кСверка");
				КонецЕсли;
