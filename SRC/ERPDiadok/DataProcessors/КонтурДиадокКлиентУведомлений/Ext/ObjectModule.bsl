Функция _Уведомления(Продукт, Запрос) Экспорт
	
	Адрес = "/products/" + Продукт + "/notifications";
	Ответ = _PostJson(Адрес, _УведомленияСобратьЗапрос(Запрос));
	Если НЕ _ПроверитьСостояние(Ответ) Тогда
		ВызватьИсключение _ТелоОписаниеОшибки(Ответ);
	КонецЕсли;
	
	Данные = _ТелоJson(Ответ);
	Модель = _УведомленияРазобратьОтвет(Данные);
	
	Возврат _ФиксированныеДанные(Модель);
	
КонецФункции // _Уведомления

Функция _УведомленияСобратьЗапрос(ЗапросУведомлений) Экспорт
	
	Запрос = Новый Соответствие;
	Запрос.Вставить("client_id", ЗапросУведомлений.ИдИБ);
	Запрос.Вставить("version", ЗапросУведомлений.Версия);
	
	Если ЗапросУведомлений.ДопПараметры <> Неопределено Тогда
		Для Каждого Элемент Из ЗапросУведомлений.ДопПараметры Цикл
			Запрос.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции // _УведомленияСобратьЗапрос

Функция _УведомленияРазобратьОтвет(Данные) Экспорт
	
	Уведомления = ОтветУведомления();
	
	СписокУведомлений = Данные.Получить("notifications");
	Если СписокУведомлений <> Неопределено Тогда
		Для Каждого Элемент Из СписокУведомлений Цикл
			Уведомление = _УведомлениеРазобратьОтвет(Элемент);
			Уведомления.Список.Добавить(Уведомление);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Уведомления;
	
КонецФункции // _УведомленияРазобратьОтвет

Функция _УведомлениеРазобратьОтвет(Данные) Экспорт
	
	Уведомление = ОтветУведомление();
	Уведомление.Ид = Данные.Получить("id");
	Уведомление.Контент = Данные.Получить("content");
	Уведомление.Приоритет = Данные.Получить("priority");
	Уведомление.ДатаНачала = _РазобратьДату(Данные.Получить("date_from"));
	Уведомление.ДатаОкончания = _РазобратьДату(Данные.Получить("date_to"));
	
	Возврат Уведомление;
	
КонецФункции // _УведомлениеРазобратьОтвет

// HTTP

Процедура _УдалитьНедопустимыеСимволыXML(Строка) Экспорт
	
	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	Сдвиг = 1;
	НедопустимыйСимвол = НайтиНедопустимыеСимволыXML(Строка, Сдвиг);
	Пока НедопустимыйСимвол <> 0 Цикл
		Символ = Сред(Строка, НедопустимыйСимвол, 1);
		Строка = СтрЗаменить(Строка, Символ, "");
		Сдвиг = НедопустимыйСимвол - 1;
		НедопустимыйСимвол = НайтиНедопустимыеСимволыXML(Строка, Сдвиг);
	КонецЦикла;
	
КонецПроцедуры // _УдалитьНедопустимыеСимволыXML

Функция _URL(URL) Экспорт
	
	Если Найти(URL, "http") ИЛИ Найти(URL, "https") Тогда
		Возврат URL;
	Иначе
		Возврат _Локация + URL;
	КонецЕсли;
	
КонецФункции // _URL

Функция _PostJson(Ресурс, Json, ПараметрыЗапроса = Неопределено, ЗаголовкиЗапроса = Неопределено) Экспорт
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Заголовки", Новый Соответствие);
	ДопПараметры.Вставить("Json", Json);
	
	Если ПараметрыЗапроса <> Неопределено Тогда
		ДопПараметры.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	КонецЕсли;
	
	Ответ = _Коннектор.Post(_URL(Ресурс), Неопределено, ДопПараметры, _Сессия());
	Возврат Ответ;
	
КонецФункции // _PostJson

Функция _ТелоJson(Ответ) Экспорт
	
	Возврат _Коннектор.КакJson(Ответ);
	
КонецФункции // _ТелоJson

Функция _ТелоОписаниеОшибки(Ответ, ПодробныеИсключения = Истина) Экспорт
	
	КраткоеОписание = КатегорииОшибок.ОшибкаСостояния + " "
		+ Строка(Ответ.КодСостояния) + " "
		+ Строка(Ответ.URL);
	Если ПодробныеИсключения = Ложь Тогда
		Возврат КраткоеОписание;
	КонецЕсли;
	
	Подробно = Новый Массив;
	Подробно.Добавить(КраткоеОписание);
	
	Для Каждого Элемент Из Ответ.Заголовки Цикл
		Подробно.Добавить(Строка(Элемент.Ключ) + ": " + Строка(Элемент.Значение));
	КонецЦикла;
	
	Если ТипЗнч(Ответ.Тело) = Тип("ДвоичныеДанные") И Ответ.Тело.Размер() Тогда
		Подробно.Добавить(_Коннектор.КакТекст(Ответ, "utf-8"));
	КонецЕсли;
	
	ПодробноеОписание = СтрСоединитьЛок(Подробно, Символы.ПС);
	
	_УдалитьНедопустимыеСимволыXML(ПодробноеОписание);
	
	Возврат ПодробноеОписание;
	
КонецФункции // _ТелоОписаниеОшибки

Функция _ПроверитьСостояние(Ответ) Экспорт
	
	НегативноеСостояние = Ответ.КодСостояния >= _Коннектор.КодыСостоянияHTTP().ПеремещеноНавсегда_301;
	Возврат НЕ НегативноеСостояние;
	
КонецФункции // _ПроверитьСостояние

Функция _Сессия() Экспорт
	
	Если _Сессия = Неопределено Тогда
		_Сессия = _Коннектор.СоздатьСессию();
	КонецЕсли;
	
	Возврат _Сессия;
	
КонецФункции // _Сессия

// Проверка параметров

Процедура _ПроверитьПараметры(Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено,
		Параметр4 = Неопределено, Параметр5 = Неопределено, Параметр6 = Неопределено, Параметр7 = Неопределено) Экспорт
	
	Ошибка = _ОшибкаПараметра(Параметр1, Параметр2, Параметр3, Параметр4, Параметр5, Параметр6, Параметр7);
	Если Ошибка <> Неопределено Тогда
		ВызватьИсключение Ошибка.Описание;
	КонецЕсли;
	
КонецПроцедуры // _ПроверитьПараметры

Функция _НесоответствиеТипов(Значение, ОписаниеТипов, ЗначениеПоУмолчанию = "!?I?*H") Экспорт
	
	ОписаниеТиповСтрокой = ТипЗнч(ОписаниеТипов) = Тип("Строка");
	
	// Проверка умолчания
	
	Если ЗначениеПоУмолчанию = "!?I?*H"
		И ОписаниеТиповСтрокой
		И Найти(ОписаниеТиповСтрокой, "Неопределено") Тогда
		ЗначениеПоУмолчанию_ = Неопределено;
	Иначе
		ЗначениеПоУмолчанию_ = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеПоУмолчанию <> "!?I?*H"
		И Значение = ЗначениеПоУмолчанию Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Проверка типа
	
	Если ТипЗнч(ОписаниеТипов) = Тип("Строка") Тогда
		ОписаниеТипов_ = Новый ОписаниеТипов(ОписаниеТипов);
	Иначе
		ОписаниеТипов_ = ОписаниеТипов;
	КонецЕсли;
	
	Если НЕ ОписаниеТипов_.СодержитТип(ТипЗнч(Значение)) Тогда
		Ошибка = _ОшибкаТипа();
	Иначе
		Ошибка = Неопределено;
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции // _НесоответствиеТипов

