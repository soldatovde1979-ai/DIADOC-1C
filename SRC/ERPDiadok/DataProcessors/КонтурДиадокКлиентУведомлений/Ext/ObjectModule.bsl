Процедура __Инит__(Мета) Экспорт
	
	КатегорииОшибок = Новый Структура;
	КатегорииОшибок.Вставить("ОшибкаСостояния", "Ошибка состояния HTTP:");
	КатегорииОшибок.Вставить("ОшибкаСостояния404", КатегорииОшибок.ОшибкаСостояния + " 404");
	
	Приоритет = Новый Структура;
	Приоритет.Вставить("Низкий", "low");
	Приоритет.Вставить("Средний", "medium");
	Приоритет.Вставить("Высокий", "high");
	
	Имя = "КлиентУведомлений";
	Если Имя <> Мета.Имя Тогда
		ПространствоИмен = Лев(Мета.Имя, СтрДлина(Мета.Имя) - СтрДлина(Имя));
	Иначе
		ПространствоИмен = Имя;	
	КонецЕсли;
	
	___Коннектор = СтрЗаменить(Мета.Реквизиты.___Коннектор.Комментарий, ".", "." + ПространствоИмен);
	
КонецПроцедуры // __Инит__

__Инит__(Метаданные());
