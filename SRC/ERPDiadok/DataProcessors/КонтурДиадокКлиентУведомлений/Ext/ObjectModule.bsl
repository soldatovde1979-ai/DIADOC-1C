//  Запрос - Строка - см. ЗапросУведомлений
//
// Возвращаемое значение:
//  Структура - см. ОтветУведомления
//
Функция Уведомления(Продукт, Запрос) Экспорт
	
	_ПроверитьПараметры(
		_НесоответствиеТипов(Продукт, "Строка"),
		_НесоответствиеТипов(Запрос, "Структура"));
	
	_ПроверитьПараметры(
		_НеЗаполнено(Продукт));
	
	Возврат _Уведомления(Продукт, Запрос);
	
КонецФункции // Уведомления

