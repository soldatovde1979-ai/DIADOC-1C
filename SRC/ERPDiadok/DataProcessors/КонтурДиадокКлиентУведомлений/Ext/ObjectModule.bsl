// Инициализирует клиент уведомлений
//
// Параметры:
//   Параметры - Структура - см. ПараметрыКлиента
//
// Возвращаемое значение:
//   ОбработкаОбъект.КлиентУведомлений - Настроенный клиент
//
Функция Инит(Параметры = Неопределено) Экспорт
	
	ПараметрыКлиента = ПараметрыКлиента();
	Если Параметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыКлиента, Параметры);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКлиента.Локация) Тогда
		_Локация = ПараметрыКлиента.Локация;
	КонецЕсли;
	
	Если ПараметрыКлиента.HTTP = Неопределено Тогда
		_Коннектор = Новый(___Коннектор);
	Иначе
		_Коннектор = ПараметрыКлиента.HTTP;
	КонецЕсли;
	
	Сессия = _Сессия();
	Если ЗначениеЗаполнено(ПараметрыКлиента.КлючАПИ) Тогда
		Сессия.Заголовки.Вставить("X-Kontur-Apikey", ПараметрыКлиента.КлючАПИ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКлиента.КлючИБ) Тогда
		Сессия.Заголовки.Вставить("X-Kontur-Secret-Key", ПараметрыКлиента.КлючАПИ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыКлиента.Токен) Тогда
		Сессия.Заголовки.Вставить("Authorization", ПараметрыКлиента.Токен);
	КонецЕсли;
	
	Возврат ЭтотОбъект;
	
КонецФункции // Инит

// Определения

// Описание параметров клиента уведомлений
//
// Возвращаемое значение:
//  Структура - Параметры клиента
//     * Локация - Строка - (необязательный) Локация сервиса
//     * КлючАПИ - Строка - (необязательный) X-Kontur-Apikey
//     * КлючИБ - Строка - (необязательный) X-Kontur-Secret-Key
//     * Токен - Строка - (необязательный) Authorization
//
Функция ПараметрыКлиента() Экспорт
	
	Модель = Новый Структура;
	Модель.Вставить("Локация", "https://update.kontur.ru/1c/v4");
	Модель.Вставить("КлючАПИ");
	Модель.Вставить("КлючИБ");
	Модель.Вставить("Токен");
	Модель.Вставить("HTTP");
	
	Возврат Модель;
	
КонецФункции // ПараметрыКлиента

