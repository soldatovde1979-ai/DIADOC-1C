	D1 = КоннекторHTTPДвоичныеДанные82СлужебныйЛок().ПолучитьПустойМассивБулево(32);

	Для i = 0 По 31 Цикл
		
		A1[i] = СтруктураПеременных.A_[i];
		B1[i] = СтруктураПеременных.B_[i];
