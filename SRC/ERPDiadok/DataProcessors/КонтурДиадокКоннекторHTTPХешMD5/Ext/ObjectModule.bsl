// Программный интерфейс

// Расчитать хеш MD5.
// 
// Параметры:
//  ДанныеДляХеширования - ДвоичныеДанные, Строка - Двоичные данные для хеш
// 
// Возвращаемое значение:
//  Строка - хеш MD5
Функция MD5Лок(Знач ДанныеДляХеширования) Экспорт
	
	СтруктураПеременных = ИнициализацияСтруктурыПеременных();

	Если ТипЗнч(ДанныеДляХеширования) = Тип("Строка") Тогда
		
		ДанныеДляХеширования = КоннекторHTTPДвоичныеДанные82СлужебныйЛок().ПолучитьДвоичныеДанныеИзСтрокиЛок(ДанныеДляХеширования);
		
	КонецЕсли;

	СтруктураЧтениеДанных = КоннекторHTTPДвоичныеДанные82СлужебныйЛок().ЧтениеДанных(ДанныеДляХеширования);

	Расчет(СтруктураПеременных, СтруктураЧтениеДанных);
	СтруктураПеременных.A = 0;
	СтруктураПеременных.B = 0;
	СтруктураПеременных.C = 0;
	СтруктураПеременных.D = 0;

	Для i = 0 По 31 Цикл
		
		Степ = СтруктураПеременных.Степень[i];
		
		Если СтруктураПеременных.A_[i] Тогда
			
			СтруктураПеременных.A = СтруктураПеременных.A + Степ;
			
		КонецЕсли;

		Если СтруктураПеременных.B_[i] Тогда
			
			СтруктураПеременных.B = СтруктураПеременных.B + Степ;
			
		КонецЕсли;

		Если СтруктураПеременных.C_[i] Тогда
			
			СтруктураПеременных.C = СтруктураПеременных.C + Степ;
			
		КонецЕсли;

		Если СтруктураПеременных.D_[i] Тогда
			
			СтруктураПеременных.D = СтруктураПеременных.D + Степ;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат НРег(
		КоннекторHTTPДвоичныеДанные82СлужебныйЛок().Dec2Hex(СтруктураПеременных.A, 8, Истина)
			+ КоннекторHTTPДвоичныеДанные82СлужебныйЛок().Dec2Hex(СтруктураПеременных.B, 8, Истина)
			+ КоннекторHTTPДвоичныеДанные82СлужебныйЛок().Dec2Hex(СтруктураПеременных.C, 8, Истина)
			+ КоннекторHTTPДвоичныеДанные82СлужебныйЛок().Dec2Hex(СтруктураПеременных.D, 8, Истина)
		);
		
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции

Процедура FF(a, b, c, d, X, s, t, СтруктураПеременных)
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._AND(b, c, СтруктураПеременных.EAX);
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._NOT(b, СтруктураПеременных.EBX);
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._AND(СтруктураПеременных.EBX, d, СтруктураПеременных.ECX);
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._OR(СтруктураПеременных.EAX, СтруктураПеременных.ECX, СтруктураПеременных.EBX);

	X1 = X + t;
	
	Если X1 >= СтруктураПеременных.Stepen32 Тогда
		
		X1 = X1 - СтруктураПеременных.Stepen32;
		
	КонецЕсли;
	
	Для инд = 0 По 31 Цикл
		
		инд1 = 31 - инд;
		Степ = СтруктураПеременных.Степень[инд1];
		
		Если X1 >= Степ Тогда
			
			X1 = X1 - Степ;
			СтруктураПеременных.EDX[инд1] = Истина;
			
		Иначе
			
			СтруктураПеременных.EDX[инд1] = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._ADD(СтруктураПеременных.EBX, a, СтруктураПеременных.ECX);
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._ADD(СтруктураПеременных.ECX, СтруктураПеременных.EDX, СтруктураПеременных.EAX);
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._ROL(СтруктураПеременных.EAX, s, СтруктураПеременных.ECX);
	
	КоннекторHTTPДвоичныеДанные82СлужебныйЛок()._ADD(СтруктураПеременных.ECX, b, a);
	
КонецПроцедуры

Процедура GG(a, b, c, d, X, s, t, СтруктураПеременных)
	
