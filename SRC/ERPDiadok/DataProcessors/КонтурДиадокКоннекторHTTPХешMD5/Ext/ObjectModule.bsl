Процедура Расчет(СтруктураПеременных, СтруктураЧтениеДанных)
	
	Мас = ПолучитьПустойМассивЧисло(64);
	Длина = КоннекторHTTPДвоичныеДанные82СлужебныйЛок().РазмерПотока(
		КоннекторHTTPДвоичныеДанные82СлужебныйЛок().ИсходныйПотокЧтениеДанных(СтруктураЧтениеДанных)
	);

	// Определение Хэш кодов 64 байтных блоков
	ДлСтр = Длина;
	
	Пока ДлСтр >= 64 Цикл
		
		Для i = 0 По 15 Цикл
			
			СтруктураПеременных.X[i] = КоннекторHTTPДвоичныеДанные82СлужебныйЛок().ПрочитатьЦелое32ЧтениеДанных(СтруктураЧтениеДанных);
			
		КонецЦикла;

		MD5Hash(СтруктураПеременных);

		ДлСтр = ДлСтр - 64;
		
	КонецЦикла;
 
	// Финал - определение Хэш кода последнего блока
	
	Если Длина <> -1 Тогда  // Если Длина = -1 то значит это не последний блок
	
		ДлинаБит = Длина * 8;
		
		Для i = 0 По ДлСтр - 1 Цикл
			
			Мас[i] = КоннекторHTTPДвоичныеДанные82СлужебныйЛок().ПрочитатьБайтЧтениеДанных(СтруктураЧтениеДанных);
			
		КонецЦикла;
		
		Мас[ДлСтр] = 128;
		Длина = ДлСтр + 1;
		
		// В последнем блоке нет свободных 8 байт для длины
		// Дополняем блок до 64 байт
		
		Если Длина > 56 Тогда
			
			Для i = Длина По 63 Цикл
				
				Мас[i] = 0;
				
			КонецЦикла;
			
			i1 = 0;
			
			Для i = 0 По 15 Цикл
				
				СтруктураПеременных.X[i] = Мас[i1] + Мас[i1 + 1] * 256 + Мас[i1 + 2] * 65536 + Мас[i1 + 3] * 16777216;
				i1 = i1 + 4;
				
			КонецЦикла;
			
			MD5Hash(СтруктураПеременных);
			Длина = 0;
			
		КонецЕсли;
		
		// Дополняем блок до 56 байт и заносим длину в битах
		
		Для i = Длина По 55 Цикл
			
			Мас[i] = 0;
			
		КонецЦикла;
		
		i1 = 0;
		
		Для i = 0 По 13 Цикл
			
			СтруктураПеременных.X[i] = Мас[i1] + Мас[i1 + 1] * 256 + Мас[i1 + 2] * 65536 + Мас[i1 + 3] * 16777216;
			i1 = i1 + 4;
			
		КонецЦикла;
		
		СтруктураПеременных.X[14] = ДлинаБит % СтруктураПеременных.Stepen32;
		СтруктураПеременных.X[15] = Цел(ДлинаБит / СтруктураПеременных.Stepen32);

		MD5Hash(СтруктураПеременных);
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПустойМассивЧисло(Р)
	
	Массив = Новый Массив; // Массив из Число
	
	Для Сч = 0 По Р - 1 Цикл
		
		Массив.Добавить(0);
		
	КонецЦикла;

	Возврат Массив;
	
