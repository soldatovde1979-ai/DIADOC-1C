// Есть неопределено. Аналог ЕстьNull .
//
// Параметры:
//  Значение				 - Произвольный	 - Значение
//  ЗначениеЕслиНеопределено - Произвольный	 - Значение если неопределено
// 
// Возвращаемое значение:
//  Произвольный - Возвращаемое значение
//
Функция ЕстьНеопределено(Значение, ЗначениеЕслиНеопределено)
	
	Если Значение = Неопределено Тогда
		
		Возврат ЗначениеЕслиНеопределено;
		
	Иначе
		
		Возврат Значение;
		
	КонецЕсли;
	
КонецФункции

