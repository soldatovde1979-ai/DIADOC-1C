// Коннектор Стд Стр.
// 
// Возвращаемое значение:
//  ОбработкаОбъект.КоннекторСтдСтр, ВнешняяОбработка - КоннекторСтдСтрЛок
Функция КоннекторСтдСтрЛок()

	Если КоннекторСтдСтрЛок = Неопределено Тогда
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
		ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
	
		Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
			
			КоннекторСтдСтрЛок = Новый ("DataProcessorObject.КонтурДиадокСтдСтр");
			
		Иначе
			
			КоннекторСтдСтрЛок = Новый("ExternalDataProcessorObject.КонтурДиадокСтдСтр");
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат КоннекторСтдСтрЛок;
	
КонецФункции

