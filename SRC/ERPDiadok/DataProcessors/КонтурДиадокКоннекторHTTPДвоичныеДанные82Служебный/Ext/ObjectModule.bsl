////////////////////////////////////////////////////////////////////////////////
// ЧтениеДанных

// Конструктор ЧтениеДанных.
//  На основании двоичных данных, имени файла или потока (структура типа Поток).
//
// Параметры:
//  ДвоичныеДанныеИмяФайлаСтруктураПоток - ДвоичныеДанные, Строка, Структура: см. СтруктураПоток - Структура типа Поток
//  Двоичные данные или Путь к файлу.
//  Кодировка							 - Строка, КодировкаТекста, Неопределено - Кодировка текста
//  ПорядокБайтов						 - Строка, Неопределено					 - Порядок байтов. BigEndian или LittleEndian
//  РазделительСтрок					 - Строка, Неопределено					 - Разделитель строк
//  КонвертируемыйРазделительСтрок		 - Строка, Неопределено					 - Конвертируемый разделитель строк
// 
// Возвращаемое значение:
//  Структура: См. СтруктураЧтениеДанных - Новый чтение данных
//
Функция ЧтениеДанных(Знач ДвоичныеДанныеИмяФайлаСтруктураПоток, Кодировка = Неопределено,
	ПорядокБайтов = Неопределено, РазделительСтрок = Неопределено, КонвертируемыйРазделительСтрок = Неопределено) Экспорт
	
	Если ТипЗнч(ДвоичныеДанныеИмяФайлаСтруктураПоток) = Тип("ДвоичныеДанные") Тогда
		
		// двоичные данные
		_ИсходныйПоток = СтруктураПоток();
		_ИсходныйПоток._ПредставлениеДвоичныхДанных = ПолучитьПредставлениеДвоичныхДанных(
			ДвоичныеДанныеИмяФайлаСтруктураПоток);
			
	ИначеЕсли ТипЗнч(ДвоичныеДанныеИмяФайлаСтруктураПоток) = Тип("Строка") Тогда
		
		// имя файла
		Попытка
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ДвоичныеДанныеИмяФайлаСтруктураПоток);
			
		Исключение ВызватьИсключение
			КоннекторСтдСтрЛок().ПодставитьПараметрыВСтрокуЛок(
				НСтр("ru = 'Ошибка отрытия файла %1 %2'"),
				ДвоичныеДанныеИмяФайлаСтруктураПоток,
				ОписаниеОшибки()
			);
			
		КонецПопытки;
		
		_ИсходныйПоток = СтруктураПоток();
		_ИсходныйПоток._ПредставлениеДвоичныхДанных = ПолучитьПредставлениеДвоичныхДанных(ДвоичныеДанные);
			
	ИначеЕсли ТипЗнч(ДвоичныеДанныеИмяФайлаСтруктураПоток) = Тип("Структура")
		И ДвоичныеДанныеИмяФайлаСтруктураПоток.Свойство("ТипЗнч")
		И ДвоичныеДанныеИмяФайлаСтруктураПоток["ТипЗнч"] = "Поток" Тогда
			
		// Структура типа Поток
		_ИсходныйПоток = СтруктураПоток();
		ЗаполнитьЗначенияСвойств(_ИсходныйПоток, ДвоичныеДанныеИмяФайлаСтруктураПоток);
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Несоответствие типа параметра ДвоичныеДанныеИмяФайлаСтруктураПоток'");
		
	КонецЕсли;

	СтруктураЧтениеДанных = СтруктураЧтениеДанных();
	СтруктураЧтениеДанных.КодировкаТекста = ЕстьНеопределено(Кодировка, СтруктураЧтениеДанных.КодировкаТекста);
	СтруктураЧтениеДанных.ПорядокБайтов = ЕстьНеопределено(ПорядокБайтов, СтруктураЧтениеДанных.ПорядокБайтов);
	СтруктураЧтениеДанных.РазделительСтрок = ЕстьНеопределено(РазделительСтрок, СтруктураЧтениеДанных.РазделительСтрок);
	СтруктураЧтениеДанных.КонвертируемыйРазделительСтрок = ЕстьНеопределено(КонвертируемыйРазделительСтрок,
		СтруктураЧтениеДанных.КонвертируемыйРазделительСтрок);
	СтруктураЧтениеДанных._ИсходныйПоток = _ИсходныйПоток;
	
	Возврат СтруктураЧтениеДанных;
	
КонецФункции

// Чтение данных. Прочитать байт.
//  Выполняет чтение одного байта из потока.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
// 
// Возвращаемое значение:
//  Число, Неопределено - Значение байта в десятичном исчислении или Неопределено если конец потока
//
Функция ПрочитатьБайтЧтениеДанных(СтруктураЧтениеДанных) Экспорт
	
	Возврат ПрочитатьЦелоеЧтениеДанных(СтруктураЧтениеДанных, 1);
	
КонецФункции

// Чтение данных. Прочитать целое 16 бит.
//  Считывает 16-битное целое число из потока.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
//  ПорядокБайтов			 - Строка, Неопределено	 - Порядок байтов.
//  	Возможные значения BigEndian или LittleEndian
//  	Если не задан берется из текущего экземпляра СтруктураЧтениеДанных.
// 
// Возвращаемое значение:
//  Число, Неопределено - Значение байта в десятичном исчислении или Неопределено если конец потока
//
Функция ПрочитатьЦелое16ЧтениеДанных(СтруктураЧтениеДанных, ПорядокБайтов = Неопределено) Экспорт
	
	Возврат ПрочитатьЦелоеЧтениеДанных(СтруктураЧтениеДанных, 2, ПорядокБайтов);
	
КонецФункции

// Чтение данных. Прочитать целое 32 бит.
//  Считывает 32-битное целое число из потока.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
//  ПорядокБайтов			 - Строка, Неопределено	 - Порядок байтов.
//  	Возможные значения BigEndian или LittleEndian
//  	Если не задан берется из текущего экземпляра СтруктураЧтениеДанных.
// 
// Возвращаемое значение:
//  Число, Неопределено - Значение байта в десятичном исчислении или Неопределено если конец потока
//
Функция ПрочитатьЦелое32ЧтениеДанных(СтруктураЧтениеДанных, ПорядокБайтов = Неопределено) Экспорт
	
	Возврат ПрочитатьЦелоеЧтениеДанных(СтруктураЧтениеДанных, 4, ПорядокБайтов);
	
КонецФункции

// Чтение данных. Прочитать целое 64 бит.
//  Считывает 64-битное целое число из потока.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
//  ПорядокБайтов			 - Строка, Неопределено	 - Порядок байтов.
//  	Возможные значения BigEndian или LittleEndian
//  	Если не задан берется из текущего экземпляра СтруктураЧтениеДанных.
// 
// Возвращаемое значение:
//  Число, Неопределено - Значение байта в десятичном исчислении или Неопределено если конец потока
//
Функция ПрочитатьЦелое64ЧтениеДанных(СтруктураЧтениеДанных, ПорядокБайтов = Неопределено) Экспорт
	
	Возврат ПрочитатьЦелоеЧтениеДанных(СтруктураЧтениеДанных, 8, ПорядокБайтов);
	
КонецФункции

// Чтение данных. Пропустить.
//  Пропускает при чтении указанное количество байтов в потоке.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
//  Количество				 - Число	 - Количество байтов, которые требуется пропустить.
// 
// Возвращаемое значение:
//  Число - Количество фактически пропущенных данных.
//
Функция ПропуститьЧтениеДанных(СтруктураЧтениеДанных, Количество) Экспорт
	
	ИсходныйПоток = ИсходныйПотокЧтениеДанных(СтруктураЧтениеДанных);
	
	Возврат ПерейтиПоток(ИсходныйПоток, Количество);
	
КонецФункции

// Чтение данных. Исходный поток.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
// 
// Возвращаемое значение:
//  Структура: См. СтруктураПоток - Структура типа Поток
//
Функция ИсходныйПотокЧтениеДанных(СтруктураЧтениеДанных) Экспорт
	
	Возврат СтруктураЧтениеДанных._ИсходныйПоток;
	
КонецФункции

// Чтение данных. КопироватьВ.
//
// Параметры:
//  СтруктураЧтениеДанных	 - Структура: См. СтруктураЧтениеДанных - 
//  ПотокЗаписьДанных		 - Структура: См. СтруктураПоток - ПотокЗаписьДанных или ЗаписьДанных.
//  Количество				 - Число, Неопределено	 - Количество байтов, которые необходимо скопировать
//  	Если не задано, будут скопированы все данные до конца потока.
// 
// Возвращаемое значение:
//  Число - Фактически записанное количество байтов.
//
Функция КопироватьВЧтениеДанных(СтруктураЧтениеДанных, ПотокЗаписьДанных, Знач Количество = Неопределено) Экспорт
	
	БайтСкопировано = Неопределено;
	
	Если ТипЗнч(ПотокЗаписьДанных) = Тип("Структура") И ПотокЗаписьДанных.Свойство("ТипЗнч") Тогда
		
		Если ПотокЗаписьДанных["ТипЗнч"] = "Поток" Или ПотокЗаписьДанных["ТипЗнч"] = "ЗаписьДанных" Тогда
			
			Если ПотокЗаписьДанных["ТипЗнч"] = "Поток" Тогда
				
				// Структура типа Поток
				ПотокДляИзменения = ПотокЗаписьДанных;
				
			ИначеЕсли ПотокЗаписьДанных["ТипЗнч"] = "ЗаписьДанных" Тогда
				
				// Структура типа ЗаписьДанных
				ПотокДляИзменения = ЦелевойПотокЗаписьДанных(ПотокЗаписьДанных);
				
			КонецЕсли;
			
			ИсходныйПотокЧтенияДанных = ИсходныйПотокЧтениеДанных(СтруктураЧтениеДанных);
			
			Если Количество = Неопределено Тогда
				
				ПотокДляИзменения._ПредставлениеДвоичныхДанных = ПотокДляИзменения._ПредставлениеДвоичныхДанных
					+ Сред(ИсходныйПотокЧтенияДанных._ПредставлениеДвоичныхДанных,
						ТекущаяПозицияПоток(ИсходныйПотокЧтенияДанных) * 2 + 1
				);
				
				ПерейтиПоток(ИсходныйПотокЧтенияДанных, РазмерПотока(ИсходныйПотокЧтенияДанных));
				ПерейтиПоток(ПотокДляИзменения, РазмерПотока(ПотокДляИзменения));
				
			Иначе
				
				ПотокДляИзменения._ПредставлениеДвоичныхДанных = ПотокДляИзменения._ПредставлениеДвоичныхДанных
					+ Сред(ИсходныйПотокЧтенияДанных._ПредставлениеДвоичныхДанных,
						ТекущаяПозицияПоток(ИсходныйПотокЧтенияДанных) * 2 + 1, Количество * 2);
					
				ПерейтиПоток(ИсходныйПотокЧтенияДанных, Количество);
				ПерейтиПоток(ПотокДляИзменения, Количество);
				
			КонецЕсли;
			
			БайтСкопировано = РазмерПотока(ПотокДляИзменения);
			
		Иначе
			
			ВызватьИсключение НСтр("ru = 'Несоответствие типа параметра ПотокЗаписьДанных'");
			
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Несоответствие типа параметра ПотокЗаписьДанных'");
		
	КонецЕсли;

	Возврат БайтСкопировано;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ЗаписьДанных

// Конструктор ЗаписьДанных.
//  На основании двоичных данных или имени файла.
//
// Параметры:
//  ИмяФайлаСтруктураПоток			 - Строка, Структура: См. СтруктураПоток- Путь к файлу или Структура типа Поток.
//  Кодировка						 - Строка, КодировкаТекста, Неопределено - Кодировка текста
//  ПорядокБайтов					 - Строка, Неопределено					 - Порядок байтов. BigEndian или LittleEndian
//  РазделительСтрок				 - Строка, Неопределено					 - Разделитель строк
//  КонвертируемыйРазделительСтрок	 - Строка, Неопределено					 - Конвертируемый разделитель строк
//  ЗаписатьBOM						 - Булево								 - Записать BOM
// 
// Возвращаемое значение:
//  Структура: См. СтруктураЗаписьДанных - Новый запись данных
//
Функция ЗаписьДанных(Знач ИмяФайлаСтруктураПоток, Кодировка = Неопределено, ПорядокБайтов = Неопределено,
	РазделительСтрок = Неопределено, КонвертируемыйРазделительСтрок = Неопределено, ЗаписатьBOM = Ложь) Экспорт

	_ИмяФайла = "";
	
	Если ТипЗнч(ИмяФайлаСтруктураПоток) = Тип("Строка") Тогда
		
		// имя файла
		Попытка
			
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайлаСтруктураПоток);
			
		Исключение
			
			ВызватьИсключение КоннекторСтдСтрЛок().ПодставитьПараметрыВСтрокуЛок(
				НСтр("ru = 'Ошибка отрытия файла %1 %2'"),
				ИмяФайлаСтруктураПоток,
				ОписаниеОшибки()
			);
			
		КонецПопытки;
		
		_ИмяФайла = ИмяФайлаСтруктураПоток;
		_ЦелевойПоток = СтруктураПоток();
		_ЦелевойПоток._ПредставлениеДвоичныхДанных = ПолучитьПредставлениеДвоичныхДанных(ДвоичныеДанные);
		
	ИначеЕсли ТипЗнч(ИмяФайлаСтруктураПоток) = Тип("Структура")
		И ИмяФайлаСтруктураПоток.Свойство("ТипЗнч")
		И ИмяФайлаСтруктураПоток["ТипЗнч"] = "Поток" Тогда
			
		// Структура типа Поток
		_ЦелевойПоток = ИмяФайлаСтруктураПоток;
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Несоответствие типа параметра ИмяФайлаСтруктураПоток'");
		
	КонецЕсли;

	СтруктураЗаписьДанных = СтруктураЗаписьДанных();
	СтруктураЗаписьДанных.КодировкаТекста = ЕстьНеопределено(Кодировка, СтруктураЗаписьДанных.КодировкаТекста);
	СтруктураЗаписьДанных.ПорядокБайтов = ЕстьНеопределено(ПорядокБайтов, СтруктураЗаписьДанных.ПорядокБайтов);
	СтруктураЗаписьДанных.РазделительСтрок = ЕстьНеопределено(РазделительСтрок, СтруктураЗаписьДанных.РазделительСтрок);
	СтруктураЗаписьДанных.КонвертируемыйРазделительСтрок = ЕстьНеопределено(КонвертируемыйРазделительСтрок,
		СтруктураЗаписьДанных.КонвертируемыйРазделительСтрок);
	СтруктураЗаписьДанных.ЗаписатьBOM = ЕстьНеопределено(ЗаписатьBOM, СтруктураЗаписьДанных.ЗаписатьBOM);

	СтруктураЗаписьДанных._ИмяФайла= _ИмяФайла;
	СтруктураЗаписьДанных._ЦелевойПоток = _ЦелевойПоток;

	Возврат СтруктураЗаписьДанных;
	
КонецФункции

// Запись данных. Целевой поток.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных -
// 
// Возвращаемое значение:
//  Структура: См. СтруктураПоток - Структура типа Поток
//
Функция ЦелевойПотокЗаписьДанных(СтруктураЗаписьДанных) Экспорт
	
	Возврат СтруктураЗаписьДанных._ЦелевойПоток;
	
КонецФункции

// Запись данных. Записать байт.
//  Выполняет запись одного байта в поток.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  Байт					 - Число	 - Целое число, которое будет записано в целевой поток.
//  	Значение числа должно находиться в диапазоне от 0 до 255.
//
Процедура ЗаписатьБайтЗаписьДанных(СтруктураЗаписьДанных, Байт) Экспорт
	
	ЗаписатьЦелоеЗаписьДанных(СтруктураЗаписьДанных, Байт, 1);
	
КонецПроцедуры

// Запись данных. Записать Целое16.
//  Выполняет запись Целое16 в поток.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  Целое16					 - Число	 - Целое число, которое будет записано в целевой поток.
//  ПорядокБайтов			 - Строка, Неопределено	 - Порядок байтов.
//  	Возможные значения BigEndian или LittleEndian
//  	Если не задан берется из текущего экземпляра СтруктураЗаписьДанных.
//
Процедура ЗаписатьЦелое16ЗаписьДанных(СтруктураЗаписьДанных, Целое16, ПорядокБайтов = Неопределено) Экспорт
	
	ЗаписатьЦелоеЗаписьДанных(СтруктураЗаписьДанных, Целое16, 2, ПорядокБайтов);
	
КонецПроцедуры

// Запись данных. Записать Целое32.
//  Выполняет запись Целое32 в поток.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  Целое32					 - Число	 - Целое число, которое будет записано в целевой поток.
//  ПорядокБайтов			 - Строка, Неопределено	 - Порядок байтов.
//  	Возможные значения BigEndian или LittleEndian
//  	Если не задан берется из текущего экземпляра СтруктураЗаписьДанных.
//
Процедура ЗаписатьЦелое32ЗаписьДанных(СтруктураЗаписьДанных, Целое32, ПорядокБайтов = Неопределено) Экспорт
	
	ЗаписатьЦелоеЗаписьДанных(СтруктураЗаписьДанных, Целое32, 4, ПорядокБайтов);
	
КонецПроцедуры

// Запись данных. Записать Целое64.
//  Выполняет запись одного байта в поток.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  Целое64					 - Число	 - Целое число, которое будет записано в целевой поток.
//  ПорядокБайтов			 - Строка, Неопределено	 - Порядок байтов.
//  	Возможные значения BigEndian или LittleEndian
//  	Если не задан берется из текущего экземпляра СтруктураЗаписьДанных.
//
Процедура ЗаписатьЦелое64ЗаписьДанных(СтруктураЗаписьДанных, Целое64, ПорядокБайтов = Неопределено) Экспорт
	
	ЗаписатьЦелоеЗаписьДанных(СтруктураЗаписьДанных, Целое64, 8, ПорядокБайтов);
	
КонецПроцедуры

// Запись данных. Записать строку.
//  Записывает строку в целевой поток.
//  Сначала записываются все символы строки, затем - разделитель строк.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  СтрокаДляЗаписи			 - Строка						 - Строка, которая будет записана в поток.
//  КодировкаТекста			 - Строка, КодировкаТекста, Неопределено - Определяет кодировку текста для записи строки.
//  Если не установлена, используется кодировка, заданная для данного объекта ЗаписьДанных.
//  РазделительСтрок		 - Строка, Неопределено					 - Указывает строку, являющуюся разделителем строк в потоке после записи
//  					символов строк. Если параметр не указан, используется разделитель строк, указанный для текущего экземпляра объекта
//  					ЗаписьДанных.
//
Процедура ЗаписатьСтрокуЗаписьДанных(СтруктураЗаписьДанных, Знач СтрокаДляЗаписи, Знач КодировкаТекста = Неопределено,
	Знач РазделительСтрок = Неопределено) Экспорт

	КодировкаТекста = ЕстьНеопределено(КодировкаТекста, СтруктураЗаписьДанных.КодировкаТекста);
	РазделительСтрок = ЕстьНеопределено(РазделительСтрок, СтруктураЗаписьДанных.РазделительСтрок);

	СтрокаДляЗаписи = СтрокаДляЗаписи + РазделительСтрок;
	
	Если Не СтруктураЗаписьДанных.КонвертируемыйРазделительСтрок = "" Тогда
		
		СтрокаДляЗаписи = СтрЗаменить(СтрокаДляЗаписи, Символы.ПС, СтруктураЗаписьДанных.КонвертируемыйРазделительСтрок);
		
	КонецЕсли;

	ЦелевойПоток = ЦелевойПотокЗаписьДанных(СтруктураЗаписьДанных);

	ЦелевойПоток._ПредставлениеДвоичныхДанных = ЦелевойПоток._ПредставлениеДвоичныхДанных
		+ ПолучитьПредставлениеДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтрокиЛок(СтрокаДляЗаписи, КодировкаТекста, Ложь));
	ПерейтиПоток(ЦелевойПоток, РазмерПотока(ЦелевойПоток));
	
КонецПроцедуры

// Запись данных. Записать Символы.
//  Записывает символы заданной строки в целевой поток.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  СтрокаДляЗаписи			 - Строка						 - Строка, которая будет записана в поток.
//  КодировкаТекста			 - Строка, КодировкаТекста, Неопределено - Определяет кодировку текста для записи строки.
//  Если не установлена, используется кодировка, заданная для данного объекта ЗаписьДанных.
//
Процедура ЗаписатьСимволыЗаписьДанных(СтруктураЗаписьДанных, СтрокаДляЗаписи, Знач КодировкаТекста = Неопределено) Экспорт
	
	ЗаписатьСтрокуЗаписьДанных(СтруктураЗаписьДанных, СтрокаДляЗаписи, КодировкаТекста, "");
	
КонецПроцедуры

// Запись данных. Записать.
//  Записывает в поток данные из объекта типа ДвоичныеДанные.
//
// Параметры:
//  СтруктураЗаписьДанных	 - Структура: См. СтруктураЗаписьДанных - 
//  ДвоичныеДанные			 - ДвоичныеДанные	 - ДвоичныеДанные, которые будет записаны в поток.
//
Процедура ЗаписатьЗаписьДанных(СтруктураЗаписьДанных, Знач ДвоичныеДанные) Экспорт

	ЦелевойПоток = ЦелевойПотокЗаписьДанных(СтруктураЗаписьДанных);

	ЦелевойПоток._ПредставлениеДвоичныхДанных = ЦелевойПоток._ПредставлениеДвоичныхДанных
		+ ПолучитьПредставлениеДвоичныхДанных(ДвоичныеДанные);
		
КонецПроцедуры

