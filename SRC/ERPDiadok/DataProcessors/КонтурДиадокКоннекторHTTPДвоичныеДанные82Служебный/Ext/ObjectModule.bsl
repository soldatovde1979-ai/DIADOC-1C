// 
// Возвращаемое значение:
//  Структура: См. СтруктураПоток- Структура типа Поток
//
Функция Поток() Экспорт

	СтруктураПоток = СтруктураПоток();
//	Если НачальнаяЕмкость > 0 Тогда
//		СтруктураПоток._ПредставлениеДвоичныхДанных = ПолучитьСтрокуНулевыхБайт(НачальнаяЕмкость);
//	Иначе
	СтруктураПоток._ПредставлениеДвоичныхДанных = "";
//	КонецЕсли;

	Возврат СтруктураПоток;
	
КонецФункции

// Поток. Получить размер потока.
//  Получает размер данных в байтах.
//
// Параметры:
//  СтруктураПоток	 - Структура: См. СтруктураПоток- Структура типа Поток
// 
// Возвращаемое значение:
//  Число - Размер данных байт.
//
Функция РазмерПотока(СтруктураПоток) Экспорт
	
	Возврат СтрДлина(СтруктураПоток._ПредставлениеДвоичныхДанных) / 2;
	
КонецФункции

//// Поток. Установить размер потока.
//// Устанавливает размер потока.
//// Если текущий размер превышает заданный, поток будет сокращен
//// до заданного размера, а информация, превышающая заданный размер, будет потеряна.
//// Если текущий размер потока меньше заданного, то содержимое потока между старым и новым размером не определено.
//// 
//// Параметры:
////  СтруктураПоток - Структура: См. СтруктураПоток - Структура типа Поток
////  Размер - Число - Новый размер потока
//Процедура УстановитьРазмерПотока(СтруктураПоток, Размер) Экспорт
//	РазмерПотока = РазмерПотока(СтруктураПоток);
