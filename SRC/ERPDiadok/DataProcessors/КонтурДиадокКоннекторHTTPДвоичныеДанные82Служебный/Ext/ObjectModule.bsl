//			+ ПолучитьСтрокуНулевыхБайт(Размер - РазмерПотока);
//	Иначе
//		СтруктураПоток._ПредставлениеДвоичныхДанных = Сред(СтруктураПоток._ПредставлениеДвоичныхДанных, 1, Размер * 2);
//	КонецЕсли;
//КонецПроцедуры

// Поток. Текущая позиция.
//  Возвращает текущую позицию в потоке.
//
// Параметры:
//  СтруктураПоток	 - Структура: См. СтруктураПоток- Структура типа Поток
// 
// Возвращаемое значение:
//  Число - текущая позиция в потоке.
//
Функция ТекущаяПозицияПоток(СтруктураПоток) Экспорт
	
	Возврат СтруктураПоток.ТекущаяПозиция;
	
КонецФункции

// Поток. Закрыть и получить двоичные данные потока.
//  Возвращает экземпляр объекта ДвоичныеДанные, содержащего данные, записанные в поток.
//
// Параметры:
//  СтруктураПоток	 - Структура: См. СтруктураПоток - Структура типа Поток
// 
// Возвращаемое значение:
//  ДвоичныеДанные - экземпляр объекта ДвоичныеДанные, содержащего данные, записанные в поток.
//
Функция ЗакрытьИПолучитьДвоичныеДанныеПоток(СтруктураПоток) Экспорт
	
	ДвоичныеДанныеПотока = ПолучитьЗначениеДвоичныхДанных(СтруктураПоток._ПредставлениеДвоичныхДанных);
	СтруктураПоток = Неопределено;
	
	Возврат ДвоичныеДанныеПотока;
	
КонецФункции

// Поток. Перейти.
//  Возвращает текущую позицию в потоке.
//
// Параметры:
//  СтруктураПоток	 - Структура: См. СтруктураПоток - Структура типа Поток
//  Смещение		 - Число				 - Количество байтов, на которое нужно передвинуть позицию в потоке.
//  НачальнаяПозиция - Число, Неопределено	 - Начальная позиция, от которой отсчитывается смещение.
// 
// Возвращаемое значение:
//  Число - Новая позиция в потоке.
//
Функция ПерейтиПоток(СтруктураПоток, Смещение, НачальнаяПозиция = Неопределено) Экспорт
	
	// TODO: реализовать НачальнаяПозиция, отрицательное смещение, проверку на выход за пределы потока
	РазмерПотока = РазмерПотока(СтруктураПоток);
	ТекущаяПозицияПотока = ТекущаяПозицияПоток(СтруктураПоток);
	ОсталосьБайтов = РазмерПотока - ТекущаяПозицияПотока;
	
	Если Смещение > ОсталосьБайтов Тогда
		
		СтруктураПоток.ТекущаяПозиция = РазмерПотока;
		
	Иначе
		
		СтруктураПоток.ТекущаяПозиция = СтруктураПоток.ТекущаяПозиция + Смещение;
		
	КонецЕсли;

	Возврат СтруктураПоток.ТекущаяПозиция;
	
КонецФункции

