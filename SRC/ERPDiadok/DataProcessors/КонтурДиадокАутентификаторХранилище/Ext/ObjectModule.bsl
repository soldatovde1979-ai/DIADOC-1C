// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ТаблицаЗначенийСессии()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ТокенДоступа", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТокенОбновления", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ВремяЖизни", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("УниверсальнаяДатаОкончания", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("УниверсальнаяДатаОкончанияМС", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПортальныйИд", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Фамилия", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Отчество", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ФИО", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Телефон", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Почта", Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;

КонецФункции

Функция ТекстЗапросаВыбратьСессии()

	Возврат "ВЫБРАТЬ
	|	ВременнаяТаблица.ТокенДоступа КАК ТокенДоступа,
	|	ВременнаяТаблица.ТокенОбновления КАК ТокенОбновления,
	|	ВременнаяТаблица.ВремяЖизни КАК ВремяЖизни,
	|	ВременнаяТаблица.УниверсальнаяДатаОкончания КАК УниверсальнаяДатаОкончания,
	|	ВременнаяТаблица.УниверсальнаяДатаОкончанияМС КАК УниверсальнаяДатаОкончанияМС,
	|	ВременнаяТаблица.Тип КАК Тип,
	|	ВременнаяТаблица.ПортальныйИд КАК ПортальныйИд,
	|	ВременнаяТаблица.Имя КАК Имя,
	|	ВременнаяТаблица.Фамилия КАК Фамилия,
	|	ВременнаяТаблица.Отчество КАК Отчество,
	|	ВременнаяТаблица.ФИО КАК ФИО,
	|	ВременнаяТаблица.Телефон КАК Телефон,
	|	ВременнаяТаблица.Почта КАК Почта
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВременнаяТаблица КАК ВременнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ТокенДоступа КАК ТокенДоступа,
	|	ВТ.ТокенОбновления КАК ТокенОбновления,
	|	ВТ.ВремяЖизни КАК ВремяЖизни,
	|	ВТ.УниверсальнаяДатаОкончания КАК УниверсальнаяДатаОкончания,
	|	ВТ.УниверсальнаяДатаОкончанияМС КАК УниверсальнаяДатаОкончанияМС,
	|	ВТ.Тип КАК Тип,
	|	ВТ.ПортальныйИд КАК ПортальныйИд,
	|	ВТ.Имя КАК Имя,
	|	ВТ.Фамилия КАК Фамилия,
	|	ВТ.Отчество КАК Отчество,
	|	ВТ.ФИО КАК ФИО,
	|	ВТ.Телефон КАК Телефон,
	|	ВТ.Почта КАК Почта
	|ИЗ
	|	ВТ КАК ВТ";
	
КонецФункции