	ИменаКоллекций.Вставить(ВРег("ВнешниеИсточникиДанных"), "ВнешнийИсточникДанных");
	
	Возврат Новый ФиксированноеСоответствие(ИменаКоллекций);
	
КонецФункции // ИменаКоллекцийПоИменамБазовыхТиповЛок

Функция ИменаПодсистемЛок()
	
	Имена = Новый Соответствие;
	ВставитьИменаПодчиненныхПодсистемЛок(Имена, Метаданные);
	
	Возврат Новый ФиксированноеСоответствие(Имена);
	
КонецФункции // ИменаПодсистемЛок

Функция СообщениеПользователюЛок(
		Знач ТекстСообщенияПользователю,
		Знач КлючДанных,
		Знач Поле,
		Знач ПутьКДанным = "",
		Отказ = Ложь,
		ЭтоОбъект = Ложь)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщенияПользователю;
	Сообщение.Поле = Поле;
	
	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
	
	Отказ = Истина;
	
	Возврат Сообщение;
	
КонецФункции // СообщениеПользователюЛок

Функция ПолеИсточникаСхемыЗапросаДоступноЛок(КомпоновщикНастроекСКДНастройки, ПроверяемоеВыражение)
	
	ЧастиИмениПоля = СтдСтр().СтрРазделитьЛок(ПроверяемоеВыражение, ".");
	ДоступныеПоля = КомпоновщикНастроекСКДНастройки.ДоступныеПоляВыбора.Элементы;
	
	ИмяПоля = "";
	ТекущаяЧастьИмениПоля = 0;
	Пока ТекущаяЧастьИмениПоля < ЧастиИмениПоля.Количество() Цикл
		
		Если НЕ ЗначениеЗаполнено(ИмяПоля) Тогда
			ИмяПоля = ИмяПоля + ЧастиИмениПоля.Получить(ТекущаяЧастьИмениПоля);
		Иначе
			ИмяПоля = ИмяПоля + "." + ЧастиИмениПоля.Получить(ТекущаяЧастьИмениПоля);
		КонецЕсли;
		
		ТекущееПоле = ДоступныеПоля.Найти(Новый ПолеКомпоновкиДанных(ИмяПоля));
		
		Если ТекущееПоле = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Инкрементация следующей части имени поля и соответствующего списка доступности полей.
		ТекущаяЧастьИмениПоля = ТекущаяЧастьИмениПоля + 1;
		ДоступныеПоля = ТекущееПоле.Элементы;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // ПолеИсточникаСхемыЗапросаДоступноЛок

Функция СерверныйМодульМенеджераЛок(Имя)
	
	ОбъектНайден = Ложь;
	КоличествоЧастейИмен = 2;
	ЧастиИмени = СтдСтр().СтрРазделитьЛок(Имя, ".");
	Если ЧастиИмени.Количество() = КоличествоЧастейИмен Тогда
		ОбъектНайден = Метаданные[ЧастиИмени[0]].Найти(ЧастиИмени[1]) <> Неопределено;
	КонецЕсли;
	
	Если НЕ ОбъектНайден Тогда
		ВызватьИсключение СтдСтр().ПодставитьПараметрыВСтрокуЛок(
			НСтр("ru = 'Объект метаданных ""%1"" не существует.'"), Имя);
	КонецЕсли;
	
	// BSLLS:ExecuteExternalCodeInCommonModule-off
	// BSLLS:ExecuteExternalCode-off
	// перед вычислением алгоритма выполняется проверка, что значение переменной
	// является объектом метаданных
	УстановитьБезопасныйРежим(Истина);
	Модуль = Вычислить(Имя);
	// BSLLS:ExecuteExternalCodeInCommonModule-on
	// BSLLS:ExecuteExternalCode-on
	
	Возврат Модуль;
	
КонецФункции // СерверныйМодульМенеджераЛок

// ПРОЧЕЕ

Процедура ЗаполнитьПолноеИмяОбъектаМетаданныхЗначенияРеквизитовОбъекта(ПолноеИмяОбъектаМетаданных, Ссылка)
	
	// Если передано имя предопределенного
	
	Если ТипЗнч(Ссылка) = Тип("Строка") Тогда
		
		ПолноеИмяПредопределенногоЭлемента = Ссылка;
		
		// Вычисление ссылки по имени предопределенного.
		// - дополнительно выполняет проверку метаданных предопределенного, выполняется предварительно.
		Попытка
			Ссылка = ПредопределенноеЗначение(ПолноеИмяПредопределенногоЭлемента);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			КраткоеПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			ТекстОшибки = СтдСтр().ПодставитьПараметрыВСтрокуЛок(
					НСтр("ru = 'Неверный первый параметр Ссылка в функции ЗначенияРеквизитовОбъектаЛок:
						|%1'"),
					КраткоеПредставлениеОшибки);
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
		
		// Разбор полного имени предопределенного.
		ЧастиПолногоИмени = СтдСтр().СтрРазделитьЛок(
				ПолноеИмяПредопределенногоЭлемента,
				".");
		ПолноеИмяОбъектаМетаданных = ЧастиПолногоИмени[0]
			+ "."
			+ ЧастиПолногоИмени[1];
		
		// Если предопределенный не создан в ИБ, то требуется выполнить проверку доступа к объекту.
		// В других сценариях проверка доступа выполняется в момент исполнения запроса.
		Если Ссылка = Неопределено Тогда
			МетаданныеОбъекта = ОбъектМетаданныхПоПолномуИмениЛок(ПолноеИмяОбъектаМетаданных);
			Если НЕ ПравоДоступа("Чтение", МетаданныеОбъекта) Тогда
				ВызватьИсключение СтдСтр().ПодставитьПараметрыВСтрокуЛок(
					НСтр("ru = 'Недостаточно прав для работы с таблицей ""%1""'"),
					ПолноеИмяОбъектаМетаданных);
			КонецЕсли;
		КонецЕсли;
		
	Иначе // Если передана ссылка.
		
		Попытка
			ПолноеИмяОбъектаМетаданных = Ссылка.Метаданные().ПолноеИмя();
		Исключение
			ВызватьИсключение СтдСтр().ПодставитьПараметрыВСтрокуЛок(
				НСтр("ru = 'Неверный первый параметр %1 в функции ЗначенияРеквизитовОбъектаЛок: 
					|Значение должно быть ссылкой или именем предопределенного элемента.'"),
				"Ссылка");
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПолноеИмяОбъектаМетаданныхЗначенияРеквизитовОбъекта

Процедура ЗаполнитьСтруктуруПолейЗначенияРеквизитовОбъекта(СтруктураПолей, Реквизиты)
	
	// Разбор реквизитов, если второй параметр Строка.
	Если ТипЗнч(Реквизиты) = Тип("Строка") Тогда
		Если ПустаяСтрока(Реквизиты) Тогда
			СтруктураПолей = Новый Структура;
		КонецЕсли;
		
		Реквизиты = СтдСтр().СтрРазделитьЛок(Реквизиты, ",", Ложь);
		Для Индекс = 0 По Реквизиты.ВГраница() Цикл
			Реквизиты[Индекс] = СокрЛП(Реквизиты[Индекс]);
		КонецЦикла;
	КонецЕсли;
	
	// Приведение реквизитов к единому формату.
	СтруктураПолей = Новый Структура;
	Если ТипЗнч(Реквизиты) = Тип("Структура")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированнаяСтруктура") Тогда
		
		Для Каждого КлючИЗначение Из Реквизиты Цикл
			СтруктураПолей.Вставить(КлючИЗначение.Ключ, СокрЛП(КлючИЗначение.Значение));
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Реквизиты) = Тип("Массив")
		ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		
		ЗаполнитьСтруктуруПолейИзМассиваЗначенияРеквизитовОбъекта(СтруктураПолей, Реквизиты);
		
	Иначе
		ВызватьИсключение СтдСтр().ПодставитьПараметрыВСтрокуЛок(
			НСтр("ru = 'Неверный тип второго параметра %1 в функции ЗначенияРеквизитовОбъектаЛок: %2.'"),
			"Реквизиты", Строка(ТипЗнч(Реквизиты)));
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьСтруктуруПолейЗначенияРеквизитовОбъекта

Процедура ЗаполнитьСтруктуруПолейИзМассиваЗначенияРеквизитовОбъекта(СтруктураПолей, Реквизиты)
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Реквизит = СокрЛП(Реквизит);
		Попытка
			ПсевдонимПоля = СтрЗаменить(Реквизит, ".", "");
			СтруктураПолей.Вставить(ПсевдонимПоля, Реквизит);
		Исключение
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСтруктуруПолейИзМассиваЗначенияРеквизитовОбъекта

Процедура ОбработатьПараметрыЗначенияРеквизитовОбъектов(Реквизиты, КодЯзыка)
	
	Если ТипЗнч(Реквизиты) = Тип("Массив") ИЛИ ТипЗнч(Реквизиты) = Тип("ФиксированныйМассив") Тогда
		Реквизиты = СтдСтр().СтрСоединитьЛок(Реквизиты, ",");
	КонецЕсли;
	
	Если ПустаяСтрока(Реквизиты) Тогда
		ВызватьИсключение НСтр("ru = 'Неверный второй параметр Реквизиты в функции ЗначенияРеквизитовОбъектовЛок: 
			|Поле объекта должно быть указано.'");
	КонецЕсли;
	
	Если СтдСтр().СтрНайтиЛок(Реквизиты, ".") <> 0 Тогда
		ВызватьИсключение НСтр("ru = 'Неверный второй параметр Реквизиты в функции ЗначенияРеквизитовОбъектовЛок: 
			|Обращение через точку не поддерживается.'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодЯзыка) Тогда
		КодЯзыка = СтдСтр().СтрРазделитьЛок(КодЯзыка, "_", Истина)[0];
	КонецЕсли;
	
КонецПроцедуры // ОбработатьПараметрыЗначенияРеквизитовОбъектов

Функция ЭтоВнешняяОбработка()
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ИспользуемоеИмяФайла");
	ЗаполнитьЗначенияСвойств(ПараметрыПроверки, ЭтотОбъект);
	Если ПараметрыПроверки.ИспользуемоеИмяФайла = Неопределено Тогда
		ЭтоВнешняяОбработка = Ложь;
	Иначе
		ЭтоВнешняяОбработка = Истина;
	КонецЕсли;
	
	Возврат ЭтоВнешняяОбработка;
	
КонецФункции // ЭтоВнешняяОбработка

