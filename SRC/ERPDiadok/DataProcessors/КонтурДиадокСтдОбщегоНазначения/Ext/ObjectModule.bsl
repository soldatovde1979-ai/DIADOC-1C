// Возвращает версию режима совместимости в формате нумерации редакций и версий, например, 8.3.14.0.
//
// Возвращаемое значение:
//   Строка - версия режима совместимости в формате нумерации редакций и версий.
//
Функция ВерсияРежимаСовместимостиЛок() Экспорт
	
	Если Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
		
		Инфо = Новый СистемнаяИнформация;
		Возврат Инфо.ВерсияПриложения;
		
	КонецЕсли;
	
	НомерРедакции = "8";
	
	Подстроки = СтдСтр().СтрРазделитьЛок(Метаданные.РежимСовместимости, "_");
	Подстроки[0] = НомерРедакции;
	
	МаксИндекс = 3;
	Пока Подстроки.ВГраница() < МаксИндекс Цикл
		Подстроки.Добавить("0");
	КонецЦикла;
	
	Возврат СтдСтр().СтрСоединитьЛок(Подстроки, ".");
	
КонецФункции // ВерсияРежимаСовместимостиЛок

