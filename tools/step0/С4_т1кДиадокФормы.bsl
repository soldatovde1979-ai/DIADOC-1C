// Шаг 0, сценарий С4 (Г4): форма вендора достраивается кодом из основной конфигурации.
// Версия: 1.0 · 07.10.2026 · ТОЛЬКО ДЛЯ ТЕСТОВОЙ БАЗЫ, после проверки удалить.
// Куда: основная конфигурация → общий модуль «т1кДиадокФормы» (из С2, флаг «Сервер») — заменить текст целиком на этот.
// Пара к нему — С4_ФормаУправляемая_вставка.bsl (в модуль формы вендора).
//
// Что проверяем (по пунктам таблицы результатов С4 в README):
//  а) реквизит формы добавляется кодом (ИзменитьРеквизиты);
//  б) элемент встаёт в существующую группу вендора «ГруппаФильтров» (там сейчас наш шхРежимПодписания);
//  в) обработчик элемента назначается кодом и находится в модуле формы (Подключаемый_ШхСобытие);
//  г) событие самой формы назначается кодом («ПриПовторномОткрытии»);
//  д) команда и кнопка создаются кодом;
//  е) значение реквизита не теряется после серверного вызова.

Процедура Тест() Экспорт
	ОбщегоНазначения.СообщитьПользователю("С2: общий модуль основной конфигурации вызван из расширения");
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Отказ = Ложь, СтандартнаяОбработка = Истина) Экспорт

	// а) реквизит
	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("шхТест", Новый ОписаниеТипов("Булево"), , "Тест ШХ (С4)"));
	Форма.ИзменитьРеквизиты(Добавляемые);

	// б) элемент рядом с элементом вендора; нет опорной группы — в корень формы (запасное место)
	Родитель = Форма.Элементы.Найти("ГруппаФильтров");
	Если Родитель = Неопределено Тогда
		Родитель = Форма;
		ЗаписьЖурналаРегистрации("Диадок.ШХ.ОпорныйЭлементНеНайден", УровеньЖурналаРегистрации.Предупреждение, , , "С4: ГруппаФильтров");
	КонецЕсли;
	Элемент = Форма.Элементы.Добавить("шхТест", Тип("ПолеФормы"), Родитель);
	Элемент.Вид = ВидПоляФормы.ПолеФлажка;
	Элемент.ПутьКДанным = "шхТест";
	Элемент.Заголовок = "Тест ШХ (С4)";

	// в) обработчик элемента — процедура в модуле формы вендора
	Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_ШхСобытие");

	// г) событие формы
	Форма.УстановитьДействие("ПриПовторномОткрытии", "Подключаемый_ШхПриПовторномОткрытии");

	// д) команда и кнопка в командной панели формы
	Команда = Форма.Команды.Добавить("шхТестКоманда");
	Команда.Заголовок = "Тест ШХ (С4)";
	Команда.Действие = "Подключаемый_ШхКоманда";
	Кнопка = Форма.Элементы.Добавить("шхТестКнопка", Тип("КнопкаФормы"), Форма.КоманднаяПанель);
	Кнопка.ИмяКоманды = "шхТестКоманда";

КонецПроцедуры

// е) серверный вызов из клиентской процедуры формы: значение реквизита должно вернуться неизменным.
Функция ВыполнитьДействие(Форма, ИмяДействия, Параметры = Неопределено) Экспорт
	Если ИмяДействия = "ПрочитатьФлажок" Тогда
		Возврат Форма.шхТест;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
